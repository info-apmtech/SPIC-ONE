{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "envName": { "value": "prod" },
    "apiMinReplicas": { "value": 2 },
    "apiMaxReplicas": { "value": 4 },
    "webMinReplicas": { "value": 2 },
    "webMaxReplicas": { "value": 4 },
    "apiCpu": { "value": "1" },
    "apiMemory": { "value": "2Gi" },
    "webCpu": { "value": "1" },
    "webMemory": { "value": "2Gi" },
    "postgresSku": { "value": "Standard_D2ds_v4" },
    "postgresTier": { "value": "GeneralPurpose" },
    "postgresStorageGb": { "value": 128 },
    "postgresHaMode": { "value": "Disabled" },
    "postgresBackupRetentionDays": { "value": 14 },
    "zoneRedundant": { "value": true },
    "logRetentionDays": { "value": 30 },
    "keyVaultPurgeProtection": { "value": true }
  }
}
