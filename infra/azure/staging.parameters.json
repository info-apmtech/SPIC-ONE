{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "envName": { "value": "staging" },
    "apiMinReplicas": { "value": 1 },
    "apiMaxReplicas": { "value": 2 },
    "webMinReplicas": { "value": 1 },
    "webMaxReplicas": { "value": 2 },
    "apiCpu": { "value": "0.5" },
    "apiMemory": { "value": "1Gi" },
    "webCpu": { "value": "0.5" },
    "webMemory": { "value": "1Gi" },
    "postgresSku": { "value": "Standard_B1ms" },
    "postgresTier": { "value": "Burstable" },
    "postgresStorageGb": { "value": 32 },
    "postgresHaMode": { "value": "Disabled" },
    "postgresBackupRetentionDays": { "value": 7 },
    "zoneRedundant": { "value": false },
    "logRetentionDays": { "value": 30 },
    "keyVaultPurgeProtection": { "value": false }
  }
}
