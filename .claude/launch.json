    {
      "name": "spicone-web-local",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "SPIC.MauiBlazorApp/SPIC.MauiBlazorApp.Web",
        "--launch-profile",
        "http",
        "--no-build",
        "--",
        "--ApiBaseUrl=http://localhost:5131/"
      ],
      "port": 5027
    }
  ]
}