[Unit]
Description=SPIC IFMS nightly report automation
Documentation=https://github.com/info-apmtech/SPIC-ONE
After=network-online.target
Wants=network-online.target

# These two belong in [Unit], not [Service]. systemd ignores them in [Service]
# with only a log line, so the crash-loop guard silently did nothing:
#   "Unknown key name 'StartLimitIntervalSec' in section 'Service', ignoring"
#
# The service idles until 04:05, so without this a crash loop would restart
# every 30 seconds for ever and look like nothing at all. Three failures inside
# ten minutes now leaves a failed unit you can actually see.
StartLimitBurst=3
StartLimitIntervalSec=600

[Service]
Type=simple
WorkingDirectory=/opt/spic-ifms
ExecStart=/usr/bin/dotnet /opt/spic-ifms/SPIC.Ifms.Automation.dll

# Secrets live here, not in appsettings.json. Mode 0600, never in git.
EnvironmentFile=-/opt/spic-ifms/secrets.env

Restart=always
RestartSec=30

# This box also runs the JT1078 video gateways and Postgres. A stuck Chromium
# must never be able to starve them, so the browser gets a hard ceiling rather
# than the benefit of the doubt.
MemoryMax=2G
CPUQuota=150%

# Chromium wants more file descriptors than the default 1024.
LimitNOFILE=65535

# Ordinary hardening. The service needs to write only its own folder.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/spic-ifms

StandardOutput=journal
StandardError=journal
SyslogIdentifier=spic-ifms

[Install]
WantedBy=multi-user.target
