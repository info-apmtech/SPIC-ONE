    "Jobs": [
      {
        "Key": "retail-stocks-spic",
        "Title": "Retail Stocks (DPT)",
        "AccountKey": "spic",
        "CategoryId": "One",
        "Enabled": false,
        "Order": 10,
        "ExpectedExtension": ".xlsx",
        "MinimumBytes": 2048,
        "MaxAttempts": 2,
        // Shape of a filled-in job. Copy this once one report works.
        "Steps": [
          { "Action": "goto", "Value": "/mFMS/REPLACE-REPORT-PAGE.action", "Description": "open the report" },
          { "Action": "selectText", "Selector": "#REPLACE", "Value": "SPIC", "Description": "company parameter" },
          { "Action": "fill", "Selector": "#REPLACE", "Value": "{{reportDate}}", "Description": "report date" },
          { "Action": "click", "Selector": "#REPLACE", "Description": "search" },
          { "Action": "waitHidden", "Selector": ".loading", "Optional": true, "Description": "wait for the grid" }
