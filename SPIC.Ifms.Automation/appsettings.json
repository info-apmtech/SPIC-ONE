{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "SPIC.Ifms.Automation": "Information"
    }
  },

  // Where the encryption keys for the stored portal passwords live.
  // BACK THIS DIRECTORY UP. Lose it and every stored password must be re-entered.
  // On the Linux service point it at something outside the deploy folder, e.g.
  // /var/lib/spic-ifms/keys, so a redeploy cannot wipe it.
  "DataProtection": {
    "KeyPath": ""
  },

  "ConnectionStrings": {
    "DefaultConnection": "Host=103.14.121.144;Port=30001;Database=spicone;Username=postgres;Password=payload123;Include Error Detail=true"
  },

  "Ifms": {
    "BaseUrl": "https://dbtfert.nic.in",
    "LoginPath": "/mFMS/loginNew.action",
    "HealthCheckPath": "/mFMS/loginNew.action",

    // Logins are NOT here. Both companies live in the IfmsPortalAccounts table
    // with the password encrypted, because the portal expires passwords every 80
    // days and they must be changeable without a redeploy. Add them with:
    //
    //   dotnet run -- set-credentials greenstar 1000249825 "<password>" Greenstar
    //   dotnet run -- set-credentials spic      <username>  "<password>" SPIC
    //   dotnet run -- list-credentials
    //
    // or from the IFMS Logins page in the portal.
    //
    // 1000249825 is the GREENSTAR login. The portal welcome bar reads
    // "1000249825 (CDataV ::GFL)" - GFL being Greenstar Fertilizers. Getting this
    // backwards would file every report against the wrong company.

    "ReuseStoredSession": true,
    "DownloadRoot": "downloads",

    // 30 rather than 120: the target host also stores JT1078 video recordings
    // and its disk is already at 67%. Long enough to settle an argument about a
    // number, short enough not to compete with the video stack.
    "ArchiveRetentionDays": 30,

    // Read off the live login page at https://dbtfert.nic.in/mFMS/loginNew.action.
    // The form is <form id="userInfo"> posting to loginNew.action.
    "Selectors": {
      "UserNameInput": "#user",
      "PasswordInput": "#pass",
      "CaptchaInput": "#captcha",
      "LoginSubmit": "#button",

      // The CAPTCHA image carries no id, so it is matched by its source.
      "CaptchaImage": "img[src*='captcha.jsp']",

      // The page has no refresh link — a new CAPTCHA only comes from reloading
      // the login page, which is exactly what each retry does.
      "CaptchaRefresh": null,
      "CaptchaText": null,

      // Seen on the real OTP page: "Enter OTP:" with Verify OTP / Regenerate OTP
      // / Cancel buttons. The buttons are matched by their visible text, which is
      // stable; the input's id is still unknown, so it is left to auto-detection
      // and the run logs what it found.
      "OtpInput": null,
      "OtpSubmit": "input[value='Verify OTP'], button:has-text('Verify OTP')",
      "OtpResend": "input[value='Regenerate OTP'], button:has-text('Regenerate OTP')",

      // VERIFY THIS ONE against the real post-login page. Everything depends on
      // it: if it never matches, every login looks like a failure.
      "LoggedIn": "a[href*='logout'], a:has-text('Logout')",

      "LoginError": ".errorMessage, .error, #errorMsg, span.error, .alert-danger",

      "CaptchaErrorMarkers": [
        "captcha",
        "verification code",
        "security code",
        "code does not match",
        "invalid image"
      ],

      "SessionExpiredMarkers": [
        "session expired",
        "please login",
        "your session has timed out"
      ]
    },

    "Browser": {
      "Headless": true,
      "SlowMoMs": 0,
      "NavigationTimeoutMs": 60000,
      "ActionTimeoutMs": 30000,
      "DownloadTimeoutMs": 180000,
      "IgnoreHttpsErrors": true,
      "ScreenshotOnFailure": true,
      "DiagnosticsRoot": "diagnostics"
    },

    // Tuned against 25 live samples: six saturated orange characters, 150x50, on
    // a dark grey gradient, at staggered heights. Measured 44% correct per
    // attempt, which five attempts turns into about 95%.
    //
    // Re-measure after any change here with:
    //   dotnet run -- test-captcha 25
    //   dotnet run -- test-captcha replay <folder>
    "Captcha": {
      "Strategies": [ "HtmlText", "Ocr" ],
      "MaxAttempts": 5,
      "TessDataPath": "tessdata",
      "TessLanguage": "eng",
      // The mFMS CAPTCHA is uppercase and digits only. Leaving lowercase in the
      // whitelist cost real accuracy: every glyph gained a case-confusable twin.
      "CharacterWhitelist": "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789",

      // Confirmed by inspection: it is always six characters. This throws away
      // short misreads instead of wasting a login attempt on them.
      "ExpectedLength": 6,

      "PreprocessImage": true,
      "SegmentCharacters": true,
      "UpscaleFactor": 4,
      "IsolateColouredText": true,
      "SaturationThreshold": 40,
      "InvertImage": true,
      "BinarizeThreshold": 140,

      // After the five automatic attempts, the CAPTCHA goes to the Android app.
      "OperatorFallbackEnabled": true,
      "OperatorFirstWaitMinutes": 300,
      "OperatorFollowUpWaitMinutes": 10,
      "OperatorMaxRounds": 5
    },

    "Otp": {
      // Confirmed: the portal asks for an OTP on every fresh login, after the
      // username, password and CAPTCHA. The paired Android phone forwards the SMS
      // so nobody has to be awake for it.
      "Strategy": "SmsRelay",
      "Required": true,
      "StepTimeoutMs": 20000,

      // The code itself is good for about five minutes. The 60-second countdown
      // on the page is only how long until Regenerate OTP becomes clickable - not
      // the life of the code. Worth knowing: 45 seconds would have made the run
      // throw away perfectly good codes on a slow night.
      //
      // 120 leaves a wide margin for SMS delivery, and by the time it gives up,
      // Regenerate has long since become available for a second try.
      "WaitSeconds": 120,
      "PollIntervalSeconds": 2,
      "MaxMessageAgeSeconds": 300,
      "AcceptedSenders": [ "IFMS", "URVRK", "NICSMS", "DBTFMS", "FERT" ],
      "OtpPattern": "\\b(\\d{4,8})\\b",
      "AllowResend": true
    }
  },

  "Schedule": {
    "Enabled": true,
    "RunAt": "04:05",
    "TimeZone": "Asia/Kolkata",
    "RunOnStartup": false,
    "CatchUpMissedRuns": true,
    "CatchUpWindowHours": 6,
    "MaxAttempts": 3,
    "RetryDelayMinutes": 15,
    "SiteProbeMaxWaitMinutes": 60,
    "SiteProbeIntervalSeconds": 60,
    "SiteProbeTimeoutSeconds": 30,
    "ReportDateOffsetDays": -1
  },

  // ---------------------------------------------------------------------------
  // The seven reports, matching the categories on the Excel Upload page.
  //
  // Steps are DISABLED until the menu path and filter controls behind the login
  // are recorded. Capture them once with Playwright's recorder:
  //
  //     cd SPIC.Ifms.Automation
  //     pwsh bin/Debug/net10.0/playwright.ps1 codegen https://dbtfert.nic.in/mFMS/loginNew.action
  //
  // Sign in by hand in the window that opens, click through to a report, apply
  // its filters and export. The recorder prints the selector for every click;
  // copy them into Steps below, replace the typed dates with {{reportDate}},
  // then set Enabled to true for that job.
  // ---------------------------------------------------------------------------
  // ---------------------------------------------------------------------------
  // The reports, one entry per report PER COMPANY.
  //
  // AccountKey says which login pulls it. The same report exists under both
  // logins with different parameters selected inside the report page, so it is
  // two jobs sharing a CategoryId — that is why they are listed twice.
  //
  // All disabled until the menu path and filters are recorded. Capture them once:
  //
  //     pwsh bin/Debug/net10.0/playwright.ps1 codegen https://dbtfert.nic.in/mFMS/loginNew.action
  //
  // Sign in by hand, click through to a report, apply its filters and export.
  // The recorder prints a selector for every action. Paste them into Steps,
  // replace the typed date with {{reportDate}}, then set Enabled to true.
  // ---------------------------------------------------------------------------
  "ReportJobs": {
    "Jobs": [
      // ---------------------------------------------------------------------
      // RETAIL STOCKS - the first report captured from the real portal.
      //
      //   View Reports > DBT Report > Retailer Stock Report
      //   Period From = 1st of the current month, Period To = today
      //   Company = GFL, then State one at a time, then Export To Excel
      //
      // The State filter is mandatory and takes one value, so this is not one
      // download but one per state - hence ForEach. Leave Values empty to fetch
      // every state the portal offers; list them to fetch only the ones that
      // matter, which is both faster and more predictable.
      //
      // ReportDateOffsetDays is 0, not -1: the range is month-to-date, so
      // {{monthStart}} and {{today}} have to be in the same month. At 04:05 on
      // the 1st, an offset of -1 would ask for 01 Aug to 01 Sep.
      //
      // The export is a CSV despite the button saying Excel.
      // ---------------------------------------------------------------------
      {
        "Key": "retail-stocks-greenstar",
        "Title": "Retail Stocks",
        "AccountKey": "greenstar",
        "CategoryId": "One",
        "Enabled": false,
        "Order": 10,
        "ReportDateOffsetDays": 0,
        "ExpectedExtension": ".csv",
        "MinimumBytes": 512,
        "MaxAttempts": 2,
        "FileNameTemplate": "{{company}}_{{state}}_retailerstock",

        "ForEach": {
          "TokenName": "state",
          "Values": [],
          "DiscoverFromSelector": "select[name='stateCode'], select[id*='state' i]",
          "ExcludeLabels": [ "Select" ],
          "ContinueOnFailure": true,
          "AllowEmptyPerValue": true
        },

        // SELECTORS BELOW ARE UNCONFIRMED. The report page was seen but its field
        // ids were not, so these match on name/id patterns and visible text. Run
        // once, read the failure screenshot in diagnostics/, and pin them down.
        "Steps": [
          {
            "Action": "goto",
            "Value": "/mFMS/viewRetailerWeeklyStock.action?saleType=1",
            "Description": "open Retailer Stock Report"
          },
          {
            "Action": "fill",
            "Selector": "input[name*='fromDate' i], input[id*='fromDate' i]",
            "Value": "{{monthStart}}",
            "Description": "period from = 1st of the month"
          },
          {
            "Action": "fill",
            "Selector": "input[name*='toDate' i], input[id*='toDate' i]",
            "Value": "{{today}}",
            "Description": "period to = today"
          },
          {
            "Action": "selectText",
            "Selector": "select[name*='company' i], select[id*='company' i]",
            "Value": "GFL",
            "Description": "company"
          },
          {
            "Action": "selectText",
            "Selector": "select[name='stateCode'], select[id*='state' i]",
            "Value": "{{state}}",
            "Description": "state"
          },
          {
            "Action": "wait",
            "TimeoutMs": 500,
            "Description": "let the district dropdown reload after the state changes"
          }
        ],

        "DownloadStep": {
          "Action": "click",
          "Selector": "input[value='Export To Excel'], button:has-text('Export To Excel')",
          "Description": "Export To Excel"
        }
      },
      // ---------------------------------------------------------------------
      // COMPANY SALES and WHOLESALER SALES - same page shape, same steps.
      //
      //   View Reports > Sales > Company Sale     (companyTransactionViewEdit)
      //   View Reports > Sales > WholeSalers Sales
      //
      //   Period From = {{quarterStart}}, Period To = today, Company = GFL,
      //   click View, wait for the grid, then Export to Excel.
      //
      // {{quarterStart}} is the first month of the current quarter, except in the
      // first month of a quarter when it steps back to the previous one - so the
      // window is never shorter than a month.
      //
      // State is deliberately left unset: these export every state at once, which
      // is why they need no ForEach.
      // ---------------------------------------------------------------------
      {
        "Key": "company-sales-greenstar",
        "Title": "Company Sales",
        "AccountKey": "greenstar",
        "CategoryId": "Two",
        "Enabled": false,
        "Order": 20,
        "ReportDateOffsetDays": 0,
        "ExpectedExtension": ".csv",
        "MinimumBytes": 512,
        "MaxAttempts": 2,
        "FileNameTemplate": "{{company}}_companysales",

        // SELECTORS UNCONFIRMED - matched on name/id patterns and button text
        // until the first real run shows the actual ids.
        "Steps": [
          {
            "Action": "goto",
            "Value": "/mFMS/companyTransactionViewEdit.action",
            "Description": "open View Company Sales Transaction"
          },
          {
            "Action": "fill",
            "Selector": "input[name*='fromDate' i], input[id*='fromDate' i]",
            "Value": "{{quarterStart}}",
            "Description": "period from = quarter start"
          },
          {
            "Action": "fill",
            "Selector": "input[name*='toDate' i], input[id*='toDate' i]",
            "Value": "{{today}}",
            "Description": "period to = today"
          },
          {
            "Action": "selectText",
            "Selector": "select[name*='company' i], select[id*='company' i]",
            "Value": "GFL",
            "Description": "company"
          },
          {
            "Action": "click",
            "Selector": "input[value='View' i], button:has-text('View')",
            "Description": "run the search"
          },
          {
            "Action": "waitFor",
            "Selector": "input[value='Export to Excel' i], button:has-text('Export to Excel')",
            "TimeoutMs": 180000,
            "Description": "wait for the grid to load"
          }
        ],

        "DownloadStep": {
          "Action": "click",
          "Selector": "input[value='Export to Excel' i], button:has-text('Export to Excel')",
          "Description": "Export to Excel"
        }
      },
      {
        "Key": "wholesale-sales-greenstar",
        "Title": "Wholesale Sales",
        "AccountKey": "greenstar",
        "CategoryId": "Four",
        "Enabled": false,
        "Order": 40,
        "ReportDateOffsetDays": 0,
        "ExpectedExtension": ".csv",
        "MinimumBytes": 512,
        "MaxAttempts": 2,
        "FileNameTemplate": "{{company}}_wholesalersales",

        // CONFIRM THIS URL. The menu item is WholeSalers Sales under Sales; the
        // action name is a guess by analogy with the company sales page.
        "Steps": [
          {
            "Action": "goto",
            "Value": "/mFMS/wholesalerTransactionViewEdit.action",
            "Description": "open View Wholesaler Sales Transaction"
          },
          {
            "Action": "fill",
            "Selector": "input[name*='fromDate' i], input[id*='fromDate' i]",
            "Value": "{{quarterStart}}",
            "Description": "period from = quarter start"
          },
          {
            "Action": "fill",
            "Selector": "input[name*='toDate' i], input[id*='toDate' i]",
            "Value": "{{today}}",
            "Description": "period to = today"
          },
          {
            "Action": "selectText",
            "Selector": "select[name*='company' i], select[id*='company' i]",
            "Value": "GFL",
            "Optional": true,
            "Description": "company, if this page offers it"
          },
          {
            "Action": "click",
            "Selector": "input[value='View' i], button:has-text('View')",
            "Description": "run the search"
          },
          {
            "Action": "waitFor",
            "Selector": "input[value='Export to Excel' i], button:has-text('Export to Excel')",
            "TimeoutMs": 180000,
            "Description": "wait for the grid to load"
          }
        ],

        "DownloadStep": {
          "Action": "click",
          "Selector": "input[value='Export to Excel' i], button:has-text('Export to Excel')",
          "Description": "Export to Excel"
        }
      },
      // ---------------------------------------------------------------------
      // SALES AND RECEIPT
      //
      //   View Reports > Sales > Sales and Receipts
      //   That opens a page of report tiles; click "CompanyDealer Wise Report",
      //   then Export to Excel. No filters.
      //
      // The tile is matched on its exact caption, not a substring, because there
      // is a "CompanyDealerWise Report 2" tile alongside it that a loose match
      // would happily click instead.
      // ---------------------------------------------------------------------
      {
        "Key": "sales-and-receipt-greenstar",
        "Title": "Sales and Receipt",
        "AccountKey": "greenstar",
        "CategoryId": "Three",
        "Enabled": false,
        "Order": 30,
        "ReportDateOffsetDays": 0,
        "ExpectedExtension": ".csv",
        "MinimumBytes": 512,
        "MaxAttempts": 2,
        "FileNameTemplate": "{{company}}_salesandreceipt",

        "Steps": [
          {
            "Action": "goto",
            "Value": "/mFMS/salesAndReceiptReportsView.action",
            "Description": "open the Sales and Receipt report tiles"
          },
          {
            "Action": "click",
            "Selector": ":text-is('Click here to view CompanyDealerWise Report')",
            "Description": "CompanyDealer Wise Report tile"
          },
          {
            "Action": "waitFor",
            "Selector": "input[value='Export to Excel' i], button:has-text('Export to Excel'), input[value='Export To Excel' i]",
            "TimeoutMs": 180000,
            "Description": "wait for the report to render"
          }
        ],

        "DownloadStep": {
          "Action": "click",
          "Selector": "input[value='Export to Excel' i], button:has-text('Export to Excel'), input[value='Export To Excel' i]",
          "Description": "Export to Excel"
        }
      },
      // ---------------------------------------------------------------------
      // WHOLESALE STOCK AS ON TODAY
      //
      //   View Reports > Stock > Wholesaler Stock As On Today
      //   State (required) one at a time, Company = GFL (required), View, then
      //   Export to Excel at the foot of the results.
      //
      // No date filters at all - it is a snapshot of right now, which is why
      // ReportDateOffsetDays is 0 and no date tokens appear below.
      // ---------------------------------------------------------------------
      {
        "Key": "wholesale-stock-today-greenstar",
        "Title": "Wholesale Stock As On Today",
        "AccountKey": "greenstar",
        "CategoryId": "Five",
        "Enabled": false,
        "Order": 50,
        "ReportDateOffsetDays": 0,
        "ExpectedExtension": ".csv",
        "MinimumBytes": 512,
        "MaxAttempts": 2,
        "FileNameTemplate": "{{company}}_{{state}}_wholesalerstock",

        "ForEach": {
          "TokenName": "state",
          "Values": [],
          "DiscoverFromSelector": "select[name*='state' i], select[id*='state' i]",
          "ExcludeLabels": [ "Select" ],
          "ContinueOnFailure": true,
          "AllowEmptyPerValue": true
        },

        "Steps": [
          {
            "Action": "goto",
            "Value": "/mFMS/getWholesalerStockAsOnToday.action?saleType=1",
            "Description": "open Wholesaler Stock As On Today"
          },
          {
            "Action": "selectText",
            "Selector": "select[name*='state' i], select[id*='state' i]",
            "Value": "{{state}}",
            "Description": "state"
          },
          {
            "Action": "wait",
            "TimeoutMs": 500,
            "Description": "let the district list reload after the state changes"
          },
          {
            "Action": "selectText",
            "Selector": "select[name*='company' i], select[id*='company' i]",
            "Value": "GFL",
            "Description": "company"
          },
          {
            "Action": "click",
            "Selector": "input[value='View' i], button:has-text('View')",
            "Description": "run the search"
          },
          {
            "Action": "waitFor",
            "Selector": "input[value='Export to Excel' i], button:has-text('Export to Excel'), input[value='Export To Excel' i]",
            "TimeoutMs": 180000,
            "Description": "wait for the results table"
          }
        ],

        "DownloadStep": {
          "Action": "click",
          "Selector": "input[value='Export to Excel' i], button:has-text('Export to Excel'), input[value='Export To Excel' i]",
          "Description": "Export to Excel"
        }
      },
      {
        "Key": "state-global-stock-spic",
        "Title": "State Wise Global Stock Reconciliation",
        "AccountKey": "spic",
        "CategoryId": "Six",
        "Enabled": false,
        "Order": 60,
        "ExpectedExtension": ".csv",
        "MinimumBytes": 2048,
        "MaxAttempts": 2,
        "Steps": [],
        "DownloadStep": null
      },
      {
        "Key": "warehouse-global-stock-spic",
        "Title": "Warehouse and RakePoint Global Stock",
        "AccountKey": "spic",
        "CategoryId": "Seven",
        "Enabled": false,
        "Order": 70,
        "ExpectedExtension": ".csv",
        "MinimumBytes": 2048,
        "MaxAttempts": 2,
        "Steps": [],
        "DownloadStep": null
      },
      {
        "Key": "state-global-stock-greenstar",
        "Title": "State Wise Global Stock Reconciliation",
        "AccountKey": "greenstar",
        "CategoryId": "Six",
        "Enabled": false,
        "Order": 160,
        "ExpectedExtension": ".csv",
        "MinimumBytes": 2048,
        "MaxAttempts": 2,
        "Steps": [],
        "DownloadStep": null
      },
      {
        "Key": "warehouse-global-stock-greenstar",
        "Title": "Warehouse and RakePoint Global Stock",
        "AccountKey": "greenstar",
        "CategoryId": "Seven",
        "Enabled": false,
        "Order": 170,
        "ExpectedExtension": ".csv",
        "MinimumBytes": 2048,
        "MaxAttempts": 2,
        "Steps": [],
        "DownloadStep": null
      }
    ]
  },

  "Alerts": {
    "NotifyOnSuccess": true,
    "NotifyOnFailure": true,

    "Email": {
      "Enabled": false,
      "Host": "",
      "Port": 587,
      "UseStartTls": true,
      "UserName": "",
      "Password": "",
      "FromAddress": "",
      "FromName": "SPIC IFMS Automation",
      "To": [],
      "Cc": [],
      "FailuresOnly": false,
      "AttachReports": false
    },

    "Push": {
      "Enabled": false,
      "ApiBaseUrl": "",
