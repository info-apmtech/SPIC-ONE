@using SPIC.MauiBlazorApp.Shared.Services
@using SPIC.MauiBlazorApp.Shared.Services.Telemetry
@inject ClientTelemetry Telemetry
@inject IJSRuntime JS
@inject NavigationManager Nav

@* Route discovery remains assembly-based, so page moves under Pages/Sas/farm keep their @page URLs unchanged. *@
<Router AppAssembly="typeof(Layout.MainLayout).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>

@* Page views and client errors for every page, both layouts, both hosts (Services/Telemetry). *@
@code {
    protected override void OnInitialized() => Telemetry.Start();

    // Signals MainPage.xaml's native BootOverlay (icon+spinner shown from app launch) that it can
    // come down - this is the earliest point any real content has actually rendered, on either
    // host. window.notifyAppReady only exists on the native host (maui-interop.js); on the Web host
    // it's simply undefined, which throws a JSException that's swallowed here rather than guarded
    // with a platform check, so this stays a one-line, host-agnostic call.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try { await JS.InvokeVoidAsync("notifyAppReady"); }
        catch (JSException) { }

        // Cold-start deep link (e.g. the JMDO tracking notification, tapped while the app process
        // was dead) - MainActivity.OnCreate set this before any circuit existed to hand it to. The
        // warm case (process already alive) never touches this; it navigates directly via
        // NavHistoryService.Current instead. One-shot: clear it so a later in-app reload of this
        // same page doesn't replay a stale navigation.
        if (PendingDeepLink.Route is { } route)
        {
            PendingDeepLink.Route = null;
            Nav.NavigateTo(route);
        }
    }
}
