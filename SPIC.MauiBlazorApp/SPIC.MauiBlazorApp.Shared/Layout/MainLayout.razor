        position: absolute;
        top: calc(100% + 12px);
        right: 0;
        z-index: 1100;
        width: 235px;
        padding: 8px;
        border: 1px solid #e9edf0;
        border-radius: 14px;
        background: #ffffff;
        box-shadow: 0 14px 38px rgba(20, 34, 28, 0.13);
    }

    .user-dropdown-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 9px;
    }

    .dropdown-user-avatar {
        width: 42px;
        height: 42px;
        min-width: 42px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eaf7ef;
        color: #198754;
        font-size: 15px;
        font-weight: 700;
        text-transform: uppercase;
        user-select: none;
    }

    .dropdown-user-info {
        min-width: 0;
        flex: 1;
    }

    .dropdown-user-name {
        max-width: 155px;
        color: #172033;
        font-size: 14px;
        font-weight: 600;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .dropdown-user-role {
        max-width: 155px;
        margin-top: 3px;
        color: #7b8492;
        font-size: 12px;
        font-weight: 500;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .user-dropdown-divider {
        height: 1px;
        margin: 4px 2px 6px;
        background: #edf0f2;
    }

    .user-logout-item {
        width: 100%;
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 9px 10px;
        border: 0;
        border-radius: 9px;
        background: transparent;
        color: #4f5968;
        font-size: 13px;
        font-weight: 500;
        text-align: left;
        cursor: pointer;
    }

