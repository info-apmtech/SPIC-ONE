@code {
    private ErrorBoundary? _pageErrorBoundary;

    // A page that threw is given a fresh start on the next navigation.
    protected override void OnParametersSet() => _pageErrorBoundary?.Recover();


    /* =========================================================
       VARIABLES
       ========================================================= */

    private bool _isReady;

    private bool isSettingsOpen = false;

    private bool isSdwaOpen = false;

    private bool isSubsidyOpen = false;

    private bool isMdPortalOpen = false;

    private bool _showUserMenu = false;

    private Timer? _tokenExpiryTimer;


    // Logged user details

    private string _userName = "User";

    private string _userRole = "";

    // Optional profile photo from JWT. If unavailable, the user's initial is shown.
    private string? _profileImageUrl;


    /* =========================================================
       INITIALIZE
       ========================================================= */

    protected override void OnInitialized()
    {
        isSettingsOpen = IsSettingsSectionActive();
        isSdwaOpen = IsSdwaSectionActive();
        isSubsidyOpen = IsSubsidySectionActive();
        isMdPortalOpen = IsMdPortalSectionActive();

        StartExpiryCheck();


        /*
         * Token already available
         */

        if (Http.DefaultRequestHeaders.Authorization != null)
        {
            var token =
                LoginState.Token
                ?? Http.DefaultRequestHeaders.Authorization.Parameter;

            LoadLoggedInUser(token);

            _isReady = true;
        }

        /*
         * LoginState token available
         */

        else if (!string.IsNullOrWhiteSpace(LoginState.Token))
        {
            Http.DefaultRequestHeaders.Authorization =
                new AuthenticationHeaderValue(
                    "Bearer",
                    LoginState.Token
                );

            LoadLoggedInUser(LoginState.Token);

            _isReady = true;
        }
    }


    /* =========================================================
       GLOBAL SEARCH
       ========================================================= */

    private void OnGlobalSearchInput(ChangeEventArgs e)
    {
        SearchState.Query =
            e.Value?.ToString() ?? "";
    }


    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            try
            {
                await JS.InvokeVoidAsync(
                    "navSearch.clickMatch"
                );
            }
            catch
            {
                // Ignore JS errors
            }
        }
    }


    /* =========================================================
       SETTINGS MENU
       ========================================================= */

    private void ToggleSettingsMenu()
    {
        if (!isSettingsOpen) { isSettingsOpen = true; isSdwaOpen = false; isSubsidyOpen = false; isMdPortalOpen = false; }
        else isSettingsOpen = false;
    }


    private void ToggleSdwaMenu()
    {
        if (!isSdwaOpen) { isSdwaOpen = true; isSettingsOpen = false; isSubsidyOpen = false; isMdPortalOpen = false; }
        else isSdwaOpen = false;
    }


    private void ToggleSubsidyMenu()
    {
        if (!isSubsidyOpen) { isSubsidyOpen = true; isSettingsOpen = false; isSdwaOpen = false; isMdPortalOpen = false; }
        else isSubsidyOpen = false;
    }


    private void ToggleMdPortalMenu()
    {
        if (!isMdPortalOpen) { isMdPortalOpen = true; isSettingsOpen = false; isSdwaOpen = false; isSubsidyOpen = false; }
        else isMdPortalOpen = false;
    }


    private async Task ToggleUserMenu()
    {
        _showUserMenu = !_showUserMenu;

        try
        {
            await JS.InvokeVoidAsync("spic.reparentUserMenu", "userProfileMenu", _showUserMenu);
        }
        catch
        {
            // ignore JS errors - fallback to CSS-only behavior
        }
    }


    private async Task CloseUserMenu()
    {
        _showUserMenu = false;

        try
        {
