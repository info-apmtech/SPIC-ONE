<style>

    /* ================= SEARCH ================= */

    .search-box {
        position: relative;
    }

    .global-search-clear {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: #9CA3AF;
        cursor: pointer;
        font-size: 0.95rem;
        transition: color 0.15s;
    }

        .global-search-clear:hover {
            color: #EF4444;
        }


    /* ================= USER PROFILE - TOPBAR SAFE ================= */

    /*
           Important:
           This wrapper does not set topbar height, width or background.
           The popup is absolute, so opening it cannot push/stretch the topbar.
        */
    .user-profile-wrapper {
        position: relative;
        display: flex;
        align-items: center;
        flex: 0 0 auto;
        background: transparent;
    }

    .user-profile-trigger {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin: 0;
        padding: 0;
        border: 0;
        outline: 0;
        background: transparent !important;
        box-shadow: none !important;
        cursor: pointer;
        font: inherit;
        color: inherit;
    }

        .user-profile-trigger:hover,
        .user-profile-trigger:focus,
        .user-profile-trigger:active,
        .user-profile-trigger.open {
            border: 0;
            outline: 0;
            background: transparent !important;
            box-shadow: none !important;
        }


    /* Avatar */
    .user-avatar {
        width: 38px;
        height: 38px;
        min-width: 38px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #198754;
        color: #ffffff;
        font-size: 15px;
        font-weight: 600;
        text-transform: uppercase;
        user-select: none;
    }


    /* Name + Role */
    .user-profile-text {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: center;
        min-width: 78px;
        max-width: 170px;
        line-height: 1.2;
        text-align: left;
    }

    .user-name {
        max-width: 170px;
        color: #172033;
        font-size: 14px;
        font-weight: 600;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .user-role {
        max-width: 170px;
        margin-top: 3px;
        color: #198754;
        font-size: 11px;
        font-weight: 500;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .user-chevron {
        margin-left: 2px;
        color: #8a94a3;
        font-size: 11px;
        transition: transform 0.18s ease;
    }

    .user-profile-trigger.open .user-chevron {
        transform: rotate(180deg);
    }


    /* Popup menu - absolute overlay, DOES NOT participate in topbar layout */
