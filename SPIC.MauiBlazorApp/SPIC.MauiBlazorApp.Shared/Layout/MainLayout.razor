@inherits LayoutComponentBase
@implements IDisposable

@using System.Net.Http.Headers
@using SPIC.Core.Entities
@using SPIC.MauiBlazorApp.Shared.Components.Shell

@inject HttpClient Http
@inject ISessionStore SessionStore
@inject SPIC.MauiBlazorApp.Shared.Services.LoginState LoginState
@inject SPIC.MauiBlazorApp.Shared.Services.ShellSession Shell
@inject NavigationManager Navigation

<PageGuard />

@* The fully authenticated shell (sidebar, topbar/profile, page body) is gated by
   a single readiness flag. During login/refresh it becomes true only after
   LoginState is fully populated; during logout it flips off immediately so the
   whole authenticated UI (menu + profile icon + content) is hidden as ONE
   consistent state. No part of the shell is ever rendered from partial state. *@
@if (_isReady)
{
    <div class="app-shell">

        <LoadingOverlay />
        <ToastHost />
        <ConfirmDialog />
        <OfflineBanner />
        <SessionExpiryDialog />

    @* Desktop (>= 1200px): full sidebar. Hidden on phone + tablet by Layout.css. *@
    <aside class="sidebar">
        <NavMenu />
    </aside>

    @* Tablet (768 .. 1199.98px): 72px icon rail (Components/Shell/NavRail). Self-hides elsewhere. *@
    <NavRail />

    <main class="content-wrap">

        @* ================= TOP BAR =================
           Desktop: search + actions, exactly as before.
           Phone (<= 767.98px, Layout.css): becomes the compact sticky bar
           logo + notification + avatar; the search box is hidden and the
           brand in .shell-topbar-lead is shown. *@
        <div class="topbar">

            @* Brand - display:none on desktop/tablet (Layout.css) *@
            <div class="shell-topbar-lead">
                <a class="brand shell-topbar-brand"
                   href="@LoginState.LandingPage"
                   aria-label="SPIC home">
                    <img src="_content/SPIC.MauiBlazorApp.Shared/Images/LoginImages/logo.png"
                         alt="SPIC"
                         class="shell-topbar-logo" />
                </a>
            </div>

            @* Search (Components/Shell/TopbarSearch): its own component so that a
               keystroke no longer re-renders this layout. *@
            <TopbarSearch />


            @* ================= TOP RIGHT ACTIONS ================= *@
            <div class="top-actions">

                @* Phone + tablet quick actions (<= 1199.98px). Both are plain links so
                   they work in Blazor Server and in the MAUI BlazorWebView without any
                   handler. Layout.css hides them at >= 1200px, where the existing
                   desktop notification button below is shown instead - the desktop bar
                   stays pixel-identical. *@
                @if (LoginState.IsLoggedIn)
                {
                    <a class="icon-btn shell-topbar-quick shell-topbar-ai"
                       href="/DigitalLibrary/chat"
                       aria-label="Ask SPIC AI"
                       title="Ask SPIC AI">

                        <i class="bi bi-stars"></i>

                    </a>

                    <a class="icon-btn shell-topbar-quick shell-topbar-alerts"
                       href="/Alerts"
                       aria-label="Alerts"
                       title="Alerts">

                        <img src="_content/SPIC.MauiBlazorApp.Shared/Images/LayoutImages/NotificationBell.svg"
                             alt=""
                             class="iconimg" />

                    </a>
                }

                @* Notification - existing topbar flow unchanged (desktop >= 1200px) *@
                <button class="icon-btn shell-topbar-bell-desktop"
                        type="button"
                        title="Notifications">

                    <img src="_content/SPIC.MauiBlazorApp.Shared/Images/LayoutImages/NotificationBell.svg"
                         alt="Notification"
                         class="iconimg" />

                </button>


                @* User profile + account card (Components/Shell/TopbarUserMenu).
                   Parameterless: opening it no longer re-renders this layout, and
                   this layout re-rendering no longer re-renders it. It reads the
                   user and the logout action from the scoped ShellSession. *@
                <TopbarUserMenu />

            </div>
        </div>


        @* ================= MAIN CONTENT ================= *@
        <div class="main-content">

            <ErrorBoundary @ref="_pageErrorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent Context="pageError">
                    <div class="page-error" role="alert">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <h5>This page hit a problem</h5>
                        <p>Something went wrong while loading this screen. You can try again or go back to the dashboard.</p>
                        <div class="page-error-actions">
                            <button type="button" class="btn btn-success btn-sm" @onclick="() => _pageErrorBoundary?.Recover()">Try again</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="@(() => Navigation.NavigateTo(LoginState.LandingPage))">Go to dashboard</button>
                        </div>
                    </div>
                </ErrorContent>
            </ErrorBoundary>

        </div>

    </main>

    @* Phone (<= 767.98px): fixed bottom tab bar + "More" sheet (Components/Shell).
       Self-hides on tablet/desktop. Logout is owned by this layout. *@
    <BottomTabBar OnLogout="Logout" />

</div>


@* =========================================================
   FULL MENU OFFCANVAS (phone + tablet)
   Opened from MoreSheet "Full menu" and the NavRail menu button.
   Lives in Components/Shell/MobileSidebar.razor and takes no parameters, so a
   re-render of this layout never diffs its ~1,000 lines of markup again.
   ========================================================= *@

<MobileSidebar />

}
else
{
    <div class="auth-transition">

        <LoadingOverlay />

        <div class="auth-transition-inner">

            <div class="spinner-border text-success"
                 role="status">

                <span class="visually-hidden">
                    Loading...
                </span>

            </div>

        </div>

    </div>
}

<style>

    /* ================= AUTH TRANSITION ================= */

    .auth-transition {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f3f5f7;
    }

    .auth-transition-inner {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* The global search and the account menu card keep their own CSS in
       Components/Shell/TopbarSearch.razor and Components/Shell/TopbarUserMenu.razor. */

</style>


@code {
    private ErrorBoundary? _pageErrorBoundary;

    // A page that threw is given a fresh start on the next navigation.
    protected override void OnParametersSet() => _pageErrorBoundary?.Recover();


    /* =========================================================
       VARIABLES

       The full menu's submenu flags now live in Components/Shell/MobileSidebar,
       the account card's state in Components/Shell/TopbarUserMenu, and the
       signed-in user's name / role / photo in the scoped ShellSession - so that
       none of them can drag this layout into a re-render (or be dragged into one).
       ========================================================= */

    private bool _isReady;

    private Timer? _tokenExpiryTimer;

    // Kept so Dispose only detaches the handler if it is still ours.
    private Func<Task>? _logoutHandler;


    /* =========================================================
       INITIALIZE
       ========================================================= */

    protected override void OnInitialized()
    {
        // The account card and the More sheet both trigger logout, but only this
        // layout can hide the whole authenticated shell as one state, so it keeps
        // owning the flow and publishes it through ShellSession.
        _logoutHandler = Logout;
        Shell.LogoutHandler = _logoutHandler;

        StartExpiryCheck();


        /*
         * Token already available
         */

        if (Http.DefaultRequestHeaders.Authorization != null)
        {
            var token =
                LoginState.Token
                ?? Http.DefaultRequestHeaders.Authorization.Parameter;

            Shell.LoadFromToken(token);

            _isReady = true;
        }

        /*
         * LoginState token available
         */

        else if (!string.IsNullOrWhiteSpace(LoginState.Token))
        {
            Http.DefaultRequestHeaders.Authorization =
                new AuthenticationHeaderValue(
                    "Bearer",
                    LoginState.Token
                );

            Shell.LoadFromToken(LoginState.Token);

            _isReady = true;
        }
    }


    /* =========================================================
       PAGE REFRESH
       ========================================================= */

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (firstRender && !_isReady)
        {

            /*
             * Page refresh:
             *
             * Restore:
             * 1. JWT Token
             * 2. Logged User
             * 3. Page Permissions
             * 4. Token Expiration
             */

            var token =
                await SessionStore.GetAsync(SessionKeys.Token);


            if (!string.IsNullOrWhiteSpace(token))
            {

                /*
                 * Restore Authorization Header
                 */

                Http.DefaultRequestHeaders.Authorization =
                    new AuthenticationHeaderValue(
                        "Bearer",
                        token
                    );


                /*
                 * Restore LoginState Token
                 */

                LoginState.Token = token;


                /*
                 * Load logged user's Name + Role
                 */

                Shell.LoadFromToken(token);


                /*
                 * Restore Page Permissions
                 */

                var roleAccess =
                    await SessionStore.GetAsync(SessionKeys.RoleAccess);

                LoginState.SetAllowedPages(
                    roleAccess
                );


                /*
                 * Restore Designation (separate from AppRole)
                 */

                var designationName =
                    await SessionStore.GetAsync(SessionKeys.DesignationName);

                LoginState.SetDesignationName(
                    designationName
                );


                /*
                 * Restore Expiration
                 */

                var expStr =
                    await SessionStore.GetAsync(SessionKeys.Expiration);


                if (
                    !string.IsNullOrWhiteSpace(expStr)
                    && DateTime.TryParse(
                        expStr,
                        out var exp)
                )
                {
                    LoginState.Expiration = exp;
                }


                _isReady = true;

                StateHasChanged();
            }
            else
            {
                Navigation.NavigateTo(
                    "/login"
                );
            }
        }
    }


    /* =========================================================
       MANUAL LOGOUT
       ========================================================= */

    private async Task Logout()
    {
        // Enter the single logout transition FIRST: hide the entire
        // authenticated shell (menu, profile icon, page content) as one state
        // BEFORE any authentication state is cleared, so no intermediate
        // authenticated/unauthenticated UI can ever be rendered.
        _isReady = false;
        StateHasChanged();

        try
        {
            await Http.PostAsync(
                "api/authentication/logout",
                null
            );
        }
        catch
        {
            // Even if API logout fails,
            // clear client-side login information.
        }


        _tokenExpiryTimer?.Dispose();

        _tokenExpiryTimer = null;


        LoginState.Token = null;

        LoginState.Expiration = default;

        LoginState.ClearAllowedPages();

        LoginState.SetDesignationName(null);


        Http.DefaultRequestHeaders.Authorization =
            null;


        /*
         * Clear current user values
         */

        Shell.ClearUser();


        try
        {
            await SessionStore.RemoveAsync(SessionKeys.Token);

            await SessionStore.RemoveAsync(SessionKeys.Expiration);

            await SessionStore.RemoveAsync(SessionKeys.RoleAccess);

            await SessionStore.RemoveAsync(SessionKeys.DesignationName);
        }
        catch
        {
            // Ignore session store cleanup errors
        }


        Navigation.NavigateTo(
            "/login"
        );
    }

    /* =========================================================
       TOKEN EXPIRY CHECK
       ========================================================= */

    private void StartExpiryCheck()
    {
        _tokenExpiryTimer?.Dispose();


        _tokenExpiryTimer =
            new Timer(
                async _ =>
                {
                    if (LoginState.IsTokenExpired)
                    {
                        await InvokeAsync(
                            async () =>
                                await AutoLogout()
                        );
                    }
                },
                null,
                TimeSpan.FromSeconds(5),
                TimeSpan.FromSeconds(5)
            );
    }


    /* =========================================================
       AUTO LOGOUT
       ========================================================= */

    private async Task AutoLogout()
    {
        // Hide the authenticated shell as one state before clearing anything.
        _isReady = false;
        StateHasChanged();

        _tokenExpiryTimer?.Dispose();

        _tokenExpiryTimer = null;


        LoginState.Token = null;

        LoginState.Expiration = default;

        LoginState.ClearAllowedPages();

        LoginState.SetDesignationName(null);


        Http.DefaultRequestHeaders.Authorization =
            null;


        Shell.ClearUser();


        try
        {
            await SessionStore.RemoveAsync(SessionKeys.Token);

            await SessionStore.RemoveAsync(SessionKeys.Expiration);

            await SessionStore.RemoveAsync(SessionKeys.RoleAccess);

            await SessionStore.RemoveAsync(SessionKeys.DesignationName);
        }
        catch
        {
            // Ignore cleanup errors
        }


        Navigation.NavigateTo(
            "/login"
        );
    }


    /* =========================================================
       DISPOSE
       ========================================================= */

    public void Dispose()
    {
        _tokenExpiryTimer?.Dispose();

        if (ReferenceEquals(Shell.LogoutHandler, _logoutHandler))
        {
            Shell.LogoutHandler = null;
        }
    }

}