                    <img src="_content/SPIC.MauiBlazorApp.Shared/Images/LayoutImages/DiseaseDetectionIcon.svg"
                         class="SideBariconimg" />

                    Disease Detection

                </NavLink>
            } *@


            @* ================= COMMUNITY (removed - no page) ================= *@
            @* @if (LoginState.CanAccess(PagePermission.Community))
            {
                <NavLink class="nav-link"
                         href="/Community">

                    <img src="_content/SPIC.MauiBlazorApp.Shared/Images/LayoutImages/Community.svg"
                         class="SideBariconimg" />

                    Community

                </NavLink>
            } *@


            @* ================= NOTIFICATIONS (removed - no page) ================= *@
            @* @if (LoginState.CanAccess(PagePermission.Notifications))
            {
                <NavLink class="nav-link"
                         href="/Notifications">

                    <img src="_content/SPIC.MauiBlazorApp.Shared/Images/LayoutImages/NotificationsIcon.svg"
                         class="SideBariconimg" />

                    Notifications

                </NavLink>
            } *@


            @* ================= PROFILE ================= *@
            @if (LoginState.CanAccess(PagePermission.Profile))
            {
                <NavLink class="nav-link"
                         href="/Profile">

                    <img src="_content/SPIC.MauiBlazorApp.Shared/Images/LayoutImages/ProfileIcon.svg"
                         class="SideBariconimg" />

                    Profile

                </NavLink>
            }


            @* ================= EMPLOYEE ================= *@
            @if (LoginState.CanAccess(PagePermission.EmployeeManagement))
            {
                <NavLink class="nav-link"
                         href="/EmployeeManagement">

                    <img src="_content/SPIC.MauiBlazorApp.Shared/Images/LayoutImages/ProfileIcon.svg"
                         class="SideBariconimg" />

                    Employee

                </NavLink>
            }


            @* ================= DEALER APPLICATION REVIEW ================= *@
            @if (LoginState.CanAccess(PagePermission.dealerreviewlist))
            {
                <NavLink class="nav-link"
                         href="/DealerReviewList">

                    <img src="_content/SPIC.MauiBlazorApp.Shared/Images/LayoutImages/ProfileIcon.svg"
                         class="SideBariconimg" />

                    Dealer Application Review

                </NavLink>
            }


            @* ================= FINANCIAL YEAR SALES DATA ================= *@
            @if (LoginState.CanAccess(PagePermission.CreditLimitSales))
            {
                <NavLink class="nav-link"
                         href="/CreditLimitSales">

                    <img src="_content/SPIC.MauiBlazorApp.Shared/Images/LayoutImages/ProfileIcon.svg"
                         class="SideBariconimg" />

                    Financial Year Sales Data

                </NavLink>
            }


            @* ================= IFMS AUTOMATION (phone) ================= *@
            @* IFMS OTP Relay is a dynamically registered page (ApplicationPage
               Key must equal this page's URL segment "IfmsRelaySetup", registered
               by Admin in Page Management). Generic CanAccess string check. *@
            @if (LoginState.CanAccess("IfmsRelaySetup"))
            {
                <NavLink class="nav-link"
                         href="/IfmsRelaySetup">

                    <img src="_content/SPIC.MauiBlazorApp.Shared/Images/LayoutImages/FileUploade.svg"
                         class="SideBariconimg" />

                    IFMS OTP Relay

                </NavLink>
            }

            @* IsAdmin = Admin, CorporateAdmin, Director, AVP: the people who hold the
               IFMS SIM are senior staff, not necessarily the admin login. *@
            @if (LoginState.IsAdmin)
            {
                <NavLink class="nav-link"
                         href="/IfmsAutoImport">

                    <img src="_content/SPIC.MauiBlazorApp.Shared/Images/LayoutImages/FileUploade.svg"
                         class="SideBariconimg" />

                    IFMS Auto Import

                </NavLink>
            }

            @if (LoginState.UserRole == AppRole.Admin)
            {
                <NavLink class="nav-link"
                         href="/IfmsLogins">

                    <img src="_content/SPIC.MauiBlazorApp.Shared/Images/LayoutImages/FileUploade.svg"
                         class="SideBariconimg" />

                    IFMS Logins

                </NavLink>
            }


            @* ================= SUBSIDY MANAGEMENT SYSTEM ================= *@
            @if (AnySubsidyAccessible)
            {

                <div class="settings-menu-wrapper">

                    <a href="javascript:void(0);"
                       class="nav-link mt-2 @(isSubsidyOpen ? "active" : "")"
                       @onclick="ToggleSubsidyMenu">

                        <img src="_content/SPIC.MauiBlazorApp.Shared/Images/LayoutImages/StockReport.svg"
                             class="SideBariconimg" />

                        Subsidy Management System

                        <i class="bi @(isSubsidyOpen
                                                                                                                                                                              ? "bi-chevron-up"
                                                                                                                                                                              : "bi-chevron-down") chevron-icon">
                        </i>

                    </a>


                    @if (isSubsidyOpen)
                    {

                        <ul class="submenu-list">

                            @if (LoginState.CanAccess(PagePermission.SalesReport))
                            {
                                <li class="submenu-item">

                                    <NavLink href="/StockReport"
                                             class="submenu-link"
                                             Match="NavLinkMatch.All">

                                        Stock Report

                                    </NavLink>

                                </li>
                            }

                            @if (LoginState.CanAccess(PagePermission.CompanySales))
                            {
                                <li class="submenu-item">

                                    <NavLink href="/CompanySales"
                                             class="submenu-link"
                                             Match="NavLinkMatch.All">

                                        Pending Acknowledgement

                                    </NavLink>

                                </li>
                            }

                            @if (LoginState.CanAccess(PagePermission.AgeingReport))
                            {
                                <li class="submenu-item">

                                    <NavLink href="/AgeingReport"
                                             class="submenu-link"
                                             Match="NavLinkMatch.All">

                                        Ageing Report

                                    </NavLink>

                                </li>
                            }

                            @if (LoginState.CanAccess(PagePermission.Acknowledgement))
                            {
                                <li class="submenu-item">

                                    <NavLink href="/Acknowledgement"
                                             class="submenu-link"
                                             Match="NavLinkMatch.All">

                                        Acknowledgement

                                    </NavLink>

                                </li>
                            }

                            @if (LoginState.CanAccess(PagePermission.LiquidationCycle))
                            {
                                <li class="submenu-item">

                                    <NavLink href="/LiquidationCycle"
                                             class="submenu-link"
                                             Match="NavLinkMatch.All">

                                        Liquidation Cycle

                                    </NavLink>

                                </li>
                            }

                            @if (LoginState.CanAccess(PagePermission.TopRankingDistrict))
                            {
                                <li class="submenu-item">

                                    <NavLink href="/TopRankingDistrict"
                                             class="submenu-link"
                                             Match="NavLinkMatch.All">

                                        Top Ranking District

                                    </NavLink>

                                </li>
                            }

                            @if (LoginState.CanAccess(PagePermission.TopRankingWholesalers))
                            {
                                <li class="submenu-item">

                                    <NavLink href="/TopRankingWholesalers"
                                             class="submenu-link"
                                             Match="NavLinkMatch.All">

                                        Top Ranking Wholesaler

                                    </NavLink>

                                </li>
                            }

                            @if (LoginState.CanAccess(PagePermission.TopRankingRetailers))
                            {
                                <li class="submenu-item">

                                    <NavLink href="/TopRankingRetailers"
                                             class="submenu-link"
                                             Match="NavLinkMatch.All">

                                        Top Ranking Retailers

                                    </NavLink>

                                </li>
                            }

                            @if (LoginState.CanAccess(PagePermission.ProductWiseStockAvailability))
                            {
                                <li class="submenu-item">

                                    <NavLink href="/ProductWiseStockAvailability"
                                             class="submenu-link"
                                             Match="NavLinkMatch.All">

                                        Productwise Stock Availability

                                    </NavLink>

                                </li>
                            }

                            @if (LoginState.CanAccess(PagePermission.StockDetails))
                            {
                                <li class="submenu-item">

                                    <NavLink href="/StockDetails"
                                             class="submenu-link"
                                             Match="NavLinkMatch.All">

                                        Stock Details

                                    </NavLink>

                                </li>
                            }

                            @if (LoginState.UserRole == AppRole.Admin)
                            {
                                <li class="submenu-item">

                                    <NavLink href="/ExcelFormatFileUpload"
                                             class="submenu-link"
                                             Match="NavLinkMatch.All">

                                        File Upload

                                    </NavLink>

                                </li>
                            }

                        </ul>

                    }

                </div>

            }


            @* ================= MD PORTAL ================= *@
            @if (AnyMdPortalAccessible)
            {

                <div class="settings-menu-wrapper">

                    <a href="javascript:void(0);"
                       class="nav-link mt-2 @(isMdPortalOpen ? "active" : "")"
                       @onclick="ToggleMdPortalMenu">

                        <img src="_content/SPIC.MauiBlazorApp.Shared/Images/LayoutImages/MDportal.png"
                             class="SideBariconimg" />

                        MD Portal

                        <i class="bi @(isMdPortalOpen
                                                                                ? "bi-chevron-up"
                                                                                : "bi-chevron-down") chevron-icon">
                        </i>

                    </a>


                    @if (isMdPortalOpen)
                    {

                        <ul class="submenu-list">

                            @if (LoginState.CanAccess("BudgetOverview"))
                            {
                                <li class="submenu-item">

                                    <NavLink href="/BudgetOverview"
                                             class="submenu-link"
                                             Match="NavLinkMatch.All">

                                        Budget Overview

                                    </NavLink>

                                </li>
                            }


                            @if (LoginState.CanAccess("BudgetingManagements"))
                            {
                                <li class="submenu-item">

                                    <NavLink href="/BudgetingManagements"
                                             class="submenu-link"
                                             Match="NavLinkMatch.All">

                                        Budgeting Management

                                    </NavLink>

                                </li>
                            }


                            @if (LoginState.CanAccess(PagePermission.BudgetSubmissions))
                            {
                                <li class="submenu-item">

                                    <NavLink href="/BudgetSubmissions"
                                             class="submenu-link"
                                             Match="NavLinkMatch.All">

                                        Budget Submissions

                                    </NavLink>

                                </li>
                            }


                            @if (LoginState.CanAccess(PagePermission.CSR1Create))
                            {
                                <li class="submenu-item">

                                    <NavLink href="/CREATE-CSR-1Management"
                                             class="submenu-link"
                                             Match="NavLinkMatch.All">

                                        CSR-1 Create

