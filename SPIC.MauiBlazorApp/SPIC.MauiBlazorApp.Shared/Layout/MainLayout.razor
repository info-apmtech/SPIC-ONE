@inherits LayoutComponentBase

<div class="app-shell">
    <aside class="sidebar">
        <NavMenu />
    </aside>

    <main class="content-wrap">
        <div class="mobile-topbar">
            <div class="brand p-0 m-0" style="font-size: 1.7rem;">SPIC</div>
            <button class="btn btn-outline-secondary"
                    type="button"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#mobileSidebar"
                    aria-controls="mobileSidebar">
                <i class="bi bi-list"></i>
            </button>
        </div>

        <div class="topbar">
            <div class="search-box">
                <i class="bi bi-search"></i>
                <input type="text" class="form-control" placeholder="Search something here">
            </div>

            <div class="top-actions">
                @* <button class="icon-btn"><i class="bi bi-bell"></i></button> *@
                <button class="icon-btn"><img src="_content/SPIC.MauiBlazorApp.Shared/images/LayoutImages/NotificationBell.svg" alt="Notification"class="iconimg" /></button>
                <div class="profile">A</div>
                <i class="bi bi-chevron-down text-secondary"></i>
            </div>
        </div>

        <div class="main-content">
            @Body
        </div>
    </main>
</div>

<div class="offcanvas offcanvas-start" tabindex="-1" id="mobileSidebar" aria-labelledby="mobileSidebarLabel">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title brand p-0 m-0" id="mobileSidebarLabel" style="font-size:1.6rem;">SPIC</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <nav class="nav nav-pills flex-column nav-section">
            <a class="nav-link" href="#"><i class="bi bi-grid"></i> Dashboard</a>
            <a class="nav-link active" href="#"><i class="bi bi-bag"></i> Purchases</a>
            <a class="nav-link" href="#"><i class="bi bi-gift"></i> Rewards</a>
            <a class="nav-link" href="#"><i class="bi bi-tree"></i> Crop Advice</a>
            <a class="nav-link" href="#"><i class="bi bi-graph-up-arrow"></i> Yield Prediction</a>
            <a class="nav-link" href="#"><i class="bi bi-virus"></i> Disease Detection</a>
            <a class="nav-link" href="#"><i class="bi bi-people"></i> Community</a>
            <a class="nav-link" href="#"><i class="bi bi-bell"></i> Notifications</a>
            <a class="nav-link" href="#"><i class="bi bi-person"></i> Profile</a>
            <a class="nav-link" href="#"><i class="bi bi-gear"></i> Settings</a>
        </nav>
    </div>
</div>