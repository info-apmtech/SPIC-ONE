        .user-logout-item:focus {
            outline: none;
            background: #fff2f2;
            color: #dc3545;
        }


    /* ================= RESPONSIVE ================= */
    @@media (max-width: 768px) {

        .user-profile-text,
        .user-chevron {
            display: none;
        }

        .user-avatar {
            width: 34px;
            height: 34px;
            min-width: 34px;
            font-size: 13px;
        }

        .user-profile-menu {
            width: 220px;
            top: calc(100% + 10px);
        }
    }

</style>


@code {

    /* =========================================================
       VARIABLES
       ========================================================= */

    private bool _isReady;

    private bool isSettingsOpen = false;

    private bool _showUserMenu = false;

    private Timer? _tokenExpiryTimer;


    // Logged user details

    private string _userName = "User";

    private string _userRole = "";


    /* =========================================================
       INITIALIZE
       ========================================================= */

    protected override void OnInitialized()
    {
        isSettingsOpen = IsSettingsSectionActive();

        StartExpiryCheck();


        /*
         * Token already available
         */

        if (Http.DefaultRequestHeaders.Authorization != null)
        {
            var token =
                LoginState.Token
                ?? Http.DefaultRequestHeaders.Authorization.Parameter;

            LoadLoggedInUser(token);

            _isReady = true;
        }

        /*
         * LoginState token available
         */

        else if (!string.IsNullOrWhiteSpace(LoginState.Token))
        {
            Http.DefaultRequestHeaders.Authorization =
                new AuthenticationHeaderValue(
                    "Bearer",
                    LoginState.Token
                );

            LoadLoggedInUser(LoginState.Token);

            _isReady = true;
        }
    }


    /* =========================================================
       GLOBAL SEARCH
       ========================================================= */

    private void OnGlobalSearchInput(ChangeEventArgs e)
    {
        SearchState.Query =
            e.Value?.ToString() ?? "";
    }


    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            try
            {
                await JS.InvokeVoidAsync(
                    "navSearch.clickMatch"
                );
            }
            catch
            {
                // Ignore JS errors
            }
        }
    }


    /* =========================================================
       SETTINGS MENU
       ========================================================= */

    private void ToggleSettingsMenu()
    {
        isSettingsOpen = !isSettingsOpen;
    }


    private void ToggleUserMenu()
    {
        _showUserMenu = !_showUserMenu;
    }


    private bool IsSettingsSectionActive()
    {
        var uri =
            Navigation
                .ToBaseRelativePath(Navigation.Uri)
                .ToLower();

        return uri == "locationmaster"
            || uri == "agriculture"
            || uri == "logistics"
            || uri == "financial"
            || uri == "relationship";
    }


    /* =========================================================
       LOAD USER NAME + ROLE FROM JWT
       ========================================================= */

    private void LoadLoggedInUser(string? token)
    {
        if (string.IsNullOrWhiteSpace(token))
        {
            return;
        }

        try
        {
            /*
             * JWT Structure:
             *
             * Header.Payload.Signature
             */

            var tokenParts = token.Split('.');

            if (tokenParts.Length < 2)
            {
                return;
            }


            var payload = tokenParts[1];


            /*
             * Convert Base64 URL to normal Base64
             */

            payload = payload
                .Replace('-', '+')
                .Replace('_', '/');


            /*
             * Add Base64 padding
             */

            switch (payload.Length % 4)
            {
                case 2:
                    payload += "==";
                    break;

                case 3:
                    payload += "=";
                    break;
            }


            var jsonBytes =
                Convert.FromBase64String(payload);

            var json =
                Encoding.UTF8.GetString(jsonBytes);


            using var document =
                JsonDocument.Parse(json);

            var root =
                document.RootElement;


            /*
             * USER NAME
             *
             * Supports common JWT claim names.
             */

            _userName =
                GetJwtClaim(
                    root,

                    "name",
                    "Name",

                    "unique_name",

                    "username",
                    "Username",
                    "UserName",

                    "preferred_username",

                    "given_name",

                    "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name"
                )
                ?? "User";


            /*
             * ROLE
             *
             * Supports normal role claim
             * and ASP.NET Identity role claim.
             */

            _userRole =
                GetJwtClaim(
                    root,

                    "role",
                    "Role",
                    "roles",
                    "Roles",

                    "http://schemas.microsoft.com/ws/2008/06/identity/claims/role"
                )
                ?? "";
        }
        catch
        {
            /*
             * If JWT parsing fails,
             * don't break MainLayout.
             */

            _userName = "User";

            _userRole = "";
        }
    }


    /* =========================================================
       GET JWT CLAIM
       ========================================================= */

    private static string? GetJwtClaim(
        JsonElement root,
        params string[] claimNames)
    {
        foreach (var claimName in claimNames)
        {
            if (!root.TryGetProperty(
                    claimName,
                    out var claim))
            {
                continue;
            }


            /*
             * Normal string claim
             */

            if (claim.ValueKind ==
                JsonValueKind.String)
            {
                var value =
                    claim.GetString();

                if (!string.IsNullOrWhiteSpace(value))
                {
                    return value;
                }
            }


            /*
             * Role can sometimes be array
             *
             * Example:
             *
             * "roles": [
             *     "Admin",
             *     "Manager"
             * ]
             */

            if (claim.ValueKind ==
                JsonValueKind.Array)
            {
                var values =
                    new List<string>();

                foreach (var item
                         in claim.EnumerateArray())
                {
                    if (item.ValueKind ==
                        JsonValueKind.String)
                    {
                        var value =
                            item.GetString();

                        if (!string.IsNullOrWhiteSpace(value))
                        {
                            values.Add(value);
                        }
                    }
                }


                if (values.Count > 0)
                {
                    return string.Join(", ", values);
                }
            }
        }


        return null;
    }


    /* =========================================================
       USER INITIAL
       ========================================================= */

    private string GetUserInitial()
    {
        if (string.IsNullOrWhiteSpace(_userName))
        {
            return "U";
        }

        return _userName
            .Trim()
            .Substring(0, 1)
            .ToUpper();
    }


    /* =========================================================
       PAGE REFRESH
       ========================================================= */

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (firstRender && !_isReady)
        {

            /*
             * Page refresh:
             *
             * Restore:
             * 1. JWT Token
             * 2. Logged User
             * 3. Page Permissions
             * 4. Token Expiration
             */

            var token =
                await JS.InvokeAsync<string?>(
                    "sessionStorage.getItem",
                    "jwt_token"
                );


            if (!string.IsNullOrWhiteSpace(token))
            {

                /*
                 * Restore Authorization Header
                 */

                Http.DefaultRequestHeaders.Authorization =
                    new AuthenticationHeaderValue(
                        "Bearer",
                        token
                    );


                /*
                 * Restore LoginState Token
                 */

                LoginState.Token = token;


                /*
                 * Load logged user's Name + Role
                 */

                LoadLoggedInUser(token);


                /*
                 * Restore Page Permissions
                 */

                var roleAccess =
                    await JS.InvokeAsync<string?>(
                        "sessionStorage.getItem",
                        "spic_role_access"
                    );

                LoginState.SetAllowedPages(
                    roleAccess
                );


                /*
                 * Restore Expiration
                 */

                var expStr =
                    await JS.InvokeAsync<string?>(
                        "sessionStorage.getItem",
                        "jwt_expiration"
                    );


                if (
                    !string.IsNullOrWhiteSpace(expStr)
                    && DateTime.TryParse(
                        expStr,
                        out var exp)
                )
                {
                    LoginState.Expiration = exp;
                }


                _isReady = true;

                StateHasChanged();
            }
            else
            {
                Navigation.NavigateTo(
                    "/login"
                );
            }
        }
    }


    /* =========================================================
       MANUAL LOGOUT
       ========================================================= */

    private async Task Logout()
    {
        _showUserMenu = false;

        try
        {
            await Http.PostAsync(
                "api/authentication/logout",
                null
            );
        }
        catch
        {
            // Even if API logout fails,
            // clear client-side login information.
        }


        _tokenExpiryTimer?.Dispose();

        _tokenExpiryTimer = null;


        LoginState.Token = null;

        LoginState.Expiration = default;

        LoginState.ClearAllowedPages();


        Http.DefaultRequestHeaders.Authorization =
            null;


        /*
         * Clear current user values
         */

        _userName = "User";

        _userRole = "";


        try
        {
            await JS.InvokeVoidAsync(
                "sessionStorage.removeItem",
                "jwt_token"
            );

            await JS.InvokeVoidAsync(
                "sessionStorage.removeItem",
                "jwt_expiration"
            );

            await JS.InvokeVoidAsync(
                "sessionStorage.removeItem",
                "spic_role_access"
            );
        }
        catch
        {
            // Ignore sessionStorage cleanup errors
        }


        Navigation.NavigateTo(
            "/login",
            forceLoad: true
        );
    }


    /* =========================================================
       TOKEN EXPIRY CHECK
       ========================================================= */

    private void StartExpiryCheck()
    {
        _tokenExpiryTimer?.Dispose();


        _tokenExpiryTimer =
            new Timer(
                async _ =>
                {
                    if (LoginState.IsTokenExpired)
                    {
                        await InvokeAsync(
                            async () =>
                                await AutoLogout()
                        );
                    }
                },
                null,
                TimeSpan.FromSeconds(5),
                TimeSpan.FromSeconds(5)
            );
    }


    /* =========================================================
       AUTO LOGOUT
       ========================================================= */

    private async Task AutoLogout()
    {
        _tokenExpiryTimer?.Dispose();

        _tokenExpiryTimer = null;


        LoginState.Token = null;

        LoginState.Expiration = default;

        LoginState.ClearAllowedPages();


        Http.DefaultRequestHeaders.Authorization =
            null;


        _userName = "User";

        _userRole = "";


        try
        {
            await JS.InvokeVoidAsync(
                "sessionStorage.removeItem",
                "jwt_token"
            );

            await JS.InvokeVoidAsync(
                "sessionStorage.removeItem",
                "jwt_expiration"
            );

            await JS.InvokeVoidAsync(
                "sessionStorage.removeItem",
                "spic_role_access"
            );
        }
        catch
        {
            // Ignore cleanup errors
        }


        Navigation.NavigateTo(
            "/login",
            forceLoad: true
        );
    }


    /* =========================================================
       DISPOSE
       ========================================================= */

    public void Dispose()
    {
        _tokenExpiryTimer?.Dispose();
    }

}