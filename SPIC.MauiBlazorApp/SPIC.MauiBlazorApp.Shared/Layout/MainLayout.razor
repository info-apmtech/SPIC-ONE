                                             class="submenu-link"
                                             Match="NavLinkMatch.All">

                                        CSR-2

                                    </NavLink>

                                </li>
                            }


                            @if (LoginState.CanAccess("FinalReportCSRView"))
                            {
                                <li class="submenu-item">

                                    <NavLink href="/FinalReportCSRView"
                                             class="submenu-link"
                                             Match="NavLinkMatch.All">

                                        Final Report CSR

                                    </NavLink>

                                </li>
                            }


                            @if (LoginState.CanAccess("RMDValidationQueue"))
                            {
                                <li class="submenu-item">

                                    <NavLink href="/RMDValidationQueue"
                                             class="submenu-link"
                                             Match="NavLinkMatch.All">

                                        RMD Validation Queue

                                    </NavLink>

                                </li>
                            }


                            @if (LoginState.CanAccess("MOSubmissionValidation"))
                            {
                                <li class="submenu-item">

                                    <NavLink href="/MOSubmissionValidation"
