@inherits LayoutComponentBase
@implements IDisposable

@using System.Net.Http.Headers
@using System.Text
@using System.Text.Json
@using SPIC.Core.Entities

@inject HttpClient Http
@inject SPIC.MauiBlazorApp.Shared.Services.LoginState LoginState
@inject SPIC.MauiBlazorApp.Shared.Services.AppSearchState SearchState
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageGuard />

<div class="app-shell">

    <LoadingOverlay />

    <aside class="sidebar">
        <NavMenu />
    </aside>

    <main class="content-wrap">

        @* ================= MOBILE TOP BAR ================= *@
        <div class="mobile-topbar">

            <div class="brand p-0 m-0"
                 style="font-size: 1.7rem;">
                SPIC
            </div>

            <button class="btn btn-outline-secondary"
                    type="button"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#mobileSidebar"
                    aria-controls="mobileSidebar">

                <i class="bi bi-list"></i>

            </button>

        </div>


        @* ================= DESKTOP TOP BAR ================= *@
        <div class="topbar">

            @* Search *@
            <div class="search-box">

                <i class="bi bi-search"></i>

                <input type="text"
                       class="form-control"
                       placeholder="Search something here"
                       value="@SearchState.Query"
                       @oninput="OnGlobalSearchInput"
                       @onkeydown="HandleSearchKeyDown" />

                @if (SearchState.HasQuery)
                {
                    <i class="bi bi-x-circle-fill global-search-clear"
                           title="Clear search"
                           @onclick="() => SearchState.Clear()">
                    </i>
                }

            </div>


            @* ================= TOP RIGHT ACTIONS ================= *@
            <div class="top-actions">

                @* Notification - existing topbar flow unchanged *@
                <button class="icon-btn"
                        type="button"
                        title="Notifications">

                    <img src="_content/SPIC.MauiBlazorApp.Shared/images/LayoutImages/NotificationBell.svg"
                         alt="Notification"
                         class="iconimg" />

                </button>


                @* User profile - custom overlay so it never changes topbar size/background *@
                <div class="user-profile-wrapper">

                    <button class="user-menu-toggle @(_showUserMenu ? "open" : "")"
                            type="button"
                            title="@_userName"
                            aria-label="Account menu"
                            aria-expanded="@_showUserMenu"
                            @onclick="ToggleUserMenu">

                        <div class="topbar-avatar-only">
                            @GetUserInitial()
                        </div>

                        <i class="bi bi-chevron-down topbar-user-chevron"></i>

                    </button>


                    @if (_showUserMenu)
                    {
                        <div class="user-menu-backdrop"
                             @onclick="CloseUserMenu">
                        </div>

                        <div class="user-profile-menu">

                            @* ===== Reference-style green profile header ===== *@
                            <div class="reference-profile-header">

                                <div class="reference-header-wave"></div>

                                @* Tree Pattern *@
                                <svg class="reference-leaf-pattern"
                                     viewBox="0 0 190 130"
                                     aria-hidden="true">
                                    <g fill="none"
                                       stroke="currentColor"
                                       stroke-width="5"
                                       stroke-linecap="round"
                                       stroke-linejoin="round">

                                        <!-- Trunk and Branches -->
                                        <path d="M 105,140 Q 105,80 150,45" />
                                        <path d="M 108,95 Q 85,80 80,45" />
                                        <path d="M 120,70 Q 135,55 140,40" />

                                        <!-- Leaves -->
                                        <path d="M 55,30 Q 75,20 75,45 Q 55,45 55,30 Z" />
                                        <path d="M 25,65 Q 50,50 45,75 Q 20,75 25,65 Z" />
                                        <path d="M 50,95 Q 70,85 65,110 Q 45,105 50,95 Z" />
                                        <path d="M 85,15 Q 105,5 105,30 Q 85,30 85,15 Z" />
                                        <path d="M 105,45 Q 120,35 115,55 Q 100,55 105,45 Z" />
                                        <path d="M 135,10 Q 160,0 155,25 Q 130,25 135,10 Z" />
                                        <path d="M 150,45 Q 175,35 165,60 Q 145,60 150,45 Z" />
                                        <path d="M 130,85 Q 155,75 150,100 Q 125,100 130,85 Z" />
                                    </g>
                                </svg>


                                <div class="reference-profile-user">

                                    <div class="reference-avatar-wrap">

                                        <div class="reference-avatar">
                                            @if (!string.IsNullOrWhiteSpace(_profileImageUrl))
                                            {
                                                <img src="@_profileImageUrl"
                                                     alt="@_userName"
                                                     class="reference-avatar-image" />
                                            }
                                            else
                                            {
                                                <span>@GetUserInitial()</span>
                                            }
                                        </div>

                                        @if (LoginState.CanAccess(PagePermission.Profile))
                                        {
                                            <button type="button"
                                                    class="reference-edit-button"
                                                    title="Profile"
                                                    @onclick="GoToProfile">
                                                
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                                </svg>

                                            </button>
                                        }

                                    </div>


                                    <div class="reference-user-info">

                                        <div class="reference-user-name">
                                            @_userName
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(_userRole))
                                        {
                                            <div class="reference-user-role">
                                                @_userRole
                                            </div>
                                        }

                                    </div>

                                </div>

                            </div>


                            @* ===== Reference-style action area ===== *@
                            <div class="reference-profile-body">

                                @if (LoginState.CanAccess(PagePermission.Notifications))
                                {
                                    <button type="button"
                                            class="reference-menu-action reference-notification"
                                            @onclick="GoToNotifications">

                                        <span class="reference-action-icon">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                                                <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                                            </svg>
                                        </span>

                                        <span class="reference-action-label">
                                            Notification
                                        </span>

                                    </button>
                                }


                                <button type="button"
                                        class="reference-menu-action reference-logout"
                                        @onclick="Logout">

                                    <span class="reference-action-icon">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                            <polyline points="16 17 21 12 16 7"></polyline>
                                            <line x1="21" y1="12" x2="9" y2="12"></line>
                                        </svg>
                                    </span>

                                    <span class="reference-action-label">
                                        Log Out
                                    </span>

                                </button>

                            </div>

                        </div>
                    }

                </div>

            </div>
        </div>


        @* ================= MAIN CONTENT ================= *@
        <div class="main-content">

            @if (_isReady)
            {
                @Body
            }
            else
            {
                <div class="d-flex justify-content-center align-items-center"
                     style="height: 60vh;">

                    <div class="spinner-border text-success"
                         role="status">

                        <span class="visually-hidden">
                            Loading...
                        </span>

                    </div>

                </div>
            }

        </div>

    </main>

</div>


@* =========================================================
   MOBILE SIDEBAR
   ========================================================= *@

<div class="offcanvas offcanvas-start"
     tabindex="-1"
     id="mobileSidebar"
     aria-labelledby="mobileSidebarLabel">

    <div class="offcanvas-header">

        <h5 class="offcanvas-title brand p-0 m-0"
            id="mobileSidebarLabel"
            style="font-size:1.6rem;">

            SPIC

        </h5>

        <button type="button"
                class="btn-close"
                data-bs-dismiss="offcanvas"
                aria-label="Close">
        </button>

    </div>


    <div class="offcanvas-body">

        <nav class="nav nav-pills flex-column nav-section">


            @* ================= DASHBOARD ================= *@
            @if (LoginState.CanAccess(PagePermission.Dashboard))
            {
                <NavLink class="nav-link"
                         href="/Dashboard"
                         Match="NavLinkMatch.All">

                    <img src="_content/SPIC.MauiBlazorApp.Shared/images/LayoutImages/DashboardIcon.svg"
                         class="SideBariconimg" />

                    Register

                </NavLink>
            }


            @* ================= PURCHASES ================= *@
            @if (LoginState.CanAccess(PagePermission.Purchases))
            {
                <NavLink class="nav-link"
                         href="/Purchases">

                    <img src="_content/SPIC.MauiBlazorApp.Shared/images/LayoutImages/PurchaseIcon.svg"
                         class="SideBariconimg" />

                    Purchases

                </NavLink>
            }


            @* ================= REWARDS ================= *@
            @if (LoginState.CanAccess(PagePermission.Rewards))
            {
                <NavLink class="nav-link"
                         href="/Rewards">

                    <img src="_content/SPIC.MauiBlazorApp.Shared/images/LayoutImages/RewardIcon.svg"
                         class="SideBariconimg" />

                    Rewards

                </NavLink>
            }


            @* ================= CROP ADVICE ================= *@
            @if (LoginState.CanAccess(PagePermission.CropAdvice))
            {
                <NavLink class="nav-link"
                         href="/CropAdvice">

                    <img src="_content/SPIC.MauiBlazorApp.Shared/images/LayoutImages/CropAdviceIcon.svg"
                         class="SideBariconimg" />

                    Crop Advice

                </NavLink>
            }


            @* ================= YIELD PREDICTION ================= *@
            @if (LoginState.CanAccess(PagePermission.YieldPrediction))
            {
                <NavLink class="nav-link"
                         href="/YieldPrediction">

                    <img src="_content/SPIC.MauiBlazorApp.Shared/images/LayoutImages/YieldPredictionIcon.svg"
                         class="SideBariconimg" />

                    Yield Prediction

                </NavLink>
            }


            @* ================= DISEASE DETECTION ================= *@
            @if (LoginState.CanAccess(PagePermission.DiseaseDetection))
            {
                <NavLink class="nav-link"
                         href="/DiseaseDetection">

                    <img src="_content/SPIC.MauiBlazorApp.Shared/images/LayoutImages/DiseaseDetectionIcon.svg"
                         class="SideBariconimg" />

                    Disease Detection

                </NavLink>
            }


            @* ================= COMMUNITY ================= *@
            @if (LoginState.CanAccess(PagePermission.Community))
            {
                <NavLink class="nav-link"
                         href="/Community">

                    <img src="_content/SPIC.MauiBlazorApp.Shared/images/LayoutImages/Community.svg"
                         class="SideBariconimg" />

                    Community

                </NavLink>
            }


            @* ================= NOTIFICATIONS ================= *@
            @if (LoginState.CanAccess(PagePermission.Notifications))
            {
                <NavLink class="nav-link"
                         href="/Notifications">

                    <img src="_content/SPIC.MauiBlazorApp.Shared/images/LayoutImages/NotificationsIcon.svg"
                         class="SideBariconimg" />

                    Notifications

                </NavLink>
            }


            @* ================= PROFILE ================= *@
            @if (LoginState.CanAccess(PagePermission.Profile))
            {
                <NavLink class="nav-link"
                         href="/Profile">

                    <img src="_content/SPIC.MauiBlazorApp.Shared/images/LayoutImages/ProfileIcon.svg"
                         class="SideBariconimg" />

                    Profile

                </NavLink>
            }


            @* ================= EMPLOYEE ================= *@
            @if (LoginState.CanAccess(PagePermission.EmployeeManagement))
            {
                <NavLink class="nav-link"
                         href="/EmployeeManagement">

                    <img src="_content/SPIC.MauiBlazorApp.Shared/images/LayoutImages/ProfileIcon.svg"
                         class="SideBariconimg" />

                    Employee

                </NavLink>
            }


            @* ================= SDWA DASHBOARD (Dealer only) ================= *@
            @if (LoginState.UserRole == AppRole.Dealer)
            {
                <NavLink class="nav-link"
                         href="/SDWADashboard">

                    <img src="_content/SPIC.MauiBlazorApp.Shared/images/LayoutImages/DashboardIcon.svg"
                         class="SideBariconimg" />

                    SDWA Dashboard

                </NavLink>
            }


            @* ================= DEALER APPLICATION REVIEW ================= *@
            @if (LoginState.CanAccess(PagePermission.dealerreviewlist))
            {
                <NavLink class="nav-link"
                         href="/DealerApplicationReview">

                    <img src="_content/SPIC.MauiBlazorApp.Shared/images/LayoutImages/ProfileIcon.svg"
                         class="SideBariconimg" />

                    Dealer Application Review

                </NavLink>
            }


            @* ================= SETTINGS ================= *@
            @if (
                                                    LoginState.CanAccess(PagePermission.LocationMaster)
                                                    || LoginState.CanAccess(PagePermission.Agriculture)
                                                    || LoginState.CanAccess(PagePermission.Logistics)
                                                    || LoginState.CanAccess(PagePermission.Financial)
                                                    || LoginState.CanAccess(PagePermission.Relationship)
                                                    || LoginState.UserRole is AppRole.Admin or AppRole.CorporateAdmin
                                                )
            {

                <div class="settings-menu-wrapper">

                    <a href="javascript:void(0);"
                       class="nav-link mt-2 @(isSettingsOpen ? "active" : "")"
                       @onclick="ToggleSettingsMenu">

                        <img src="_content/SPIC.MauiBlazorApp.Shared/images/LayoutImages/SettingsIcon.svg"
                             class="SideBariconimg" />

                        Settings

                        <i class="bi @(isSettingsOpen
                                                                                                                                                                             ? "bi-chevron-up"
                                                                                                                                                                             : "bi-chevron-down") chevron-icon">
                        </i>

                    </a>


                    @if (isSettingsOpen)
                    {

                        <ul class="submenu-list">


                            @if (LoginState.CanAccess(PagePermission.LocationMaster))
                            {
                                <li class="submenu-item">

                                    <NavLink href="/LocationMaster"
                                             class="submenu-link"
                                             Match="NavLinkMatch.All">

                                        Location Master

                                    </NavLink>

                                </li>
                            }


                            @if (LoginState.CanAccess(PagePermission.Agriculture))
                            {
                                <li class="submenu-item">

                                    <NavLink href="/Agriculture"
                                             class="submenu-link"
                                             Match="NavLinkMatch.All">

                                        Agriculture & Prod...

                                    </NavLink>

                                </li>
                            }


                            @if (LoginState.CanAccess(PagePermission.Logistics))
                            {
                                <li class="submenu-item">

                                    <NavLink href="/Logistics"
                                             class="submenu-link"
                                             Match="NavLinkMatch.All">

                                        Logistics Master

                                    </NavLink>

                                </li>
                            }


                            @if (LoginState.CanAccess(PagePermission.Financial))
                            {
                                <li class="submenu-item">

                                    <NavLink href="/Financial"
                                             class="submenu-link"
                                             Match="NavLinkMatch.All">

                                        Financial Master

                                    </NavLink>

                                </li>
                            }


                            @if (LoginState.CanAccess(PagePermission.Relationship))
                            {
                                <li class="submenu-item">

                                    <NavLink href="/Relationship"
                                             class="submenu-link"
                                             Match="NavLinkMatch.All">

                                        Relationship Master

                                    </NavLink>

                                </li>
                            }


                            @if (LoginState.UserRole is AppRole.Admin or AppRole.CorporateAdmin)
                            {
                                <li class="submenu-item">

                                    <NavLink href="/SubDealerEmployeeMaster"
                                             class="submenu-link"
                                             Match="NavLinkMatch.All">

                                        Sub Dealer &amp; Employee

                                    </NavLink>

                                </li>
                            }


                        </ul>

                    }

                </div>

            }

        </nav>

    </div>

</div>


<style>

    /* ================= SEARCH ================= */

    .search-box {
        position: relative;
    }

    .global-search-clear {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: #9CA3AF;
        cursor: pointer;
        font-size: 0.95rem;
        transition: color 0.15s;
    }

        .global-search-clear:hover {
            color: #EF4444;
        }


    /* ================= ACCOUNT MENU TRIGGER ================= */

    .user-profile-wrapper {
        position: relative;
        display: flex;
        align-items: center;
        flex: 0 0 auto;
        background: transparent;
    }

    .user-menu-toggle {
        position: relative;
        z-index: 1103;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        margin: 0;
        padding: 0;
        border: 0;
        outline: 0;
        background: transparent;
        box-shadow: none;
        cursor: pointer;
    }

    .topbar-avatar-only {
        width: 38px;
        height: 38px;
        min-width: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #168a57;
        color: #ffffff;
        font-size: 15px;
        font-weight: 700;
        text-transform: uppercase;
        user-select: none;
        transition: transform 0.16s ease, box-shadow 0.16s ease, background-color 0.16s ease;
    }

    .topbar-user-chevron {
        color: #8a94a3;
        font-size: 11px;
        line-height: 1;
        transition: transform 0.18s ease, color 0.18s ease;
    }

    .user-menu-toggle:hover .topbar-user-chevron,
    .user-menu-toggle:focus .topbar-user-chevron {
        color: #08794a;
    }

    .user-menu-toggle.open .topbar-user-chevron {
        color: #08794a;
        transform: rotate(180deg);
    }

    .user-menu-toggle:hover,
    .user-menu-toggle:focus {
        outline: none;
        background: transparent;
        box-shadow: none;
    }

        .user-menu-toggle:hover .topbar-avatar-only,
        .user-menu-toggle:focus .topbar-avatar-only {
            background: #0f7c4c;
            box-shadow: 0 4px 12px rgba(15, 124, 76, 0.20);
            transform: translateY(-1px);
        }

    .user-menu-toggle.open .topbar-avatar-only {
        background: #0d7145;
        box-shadow: 0 0 0 3px rgba(13, 113, 69, 0.12);
    }

    .user-menu-backdrop {
        position: fixed;
        inset: 0;
        z-index: 1099;
        background: transparent;
        cursor: default;
    }


    /* ================= PROFESSIONAL PROFILE CARD ================= */

    .user-profile-menu {
        position: absolute;
        top: calc(100% + 12px);
        right: 0;
        z-index: 1102;
        width: 350px; /* Widened slightly to match figma proportions */
        padding: 0;
        border: none;
        border-radius: 20px; /* Softer rounded corners */
        background: #ffffff;
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.12);
        animation: userMenuIn 0.16s ease-out;
    }

    @@keyframes userMenuIn {
        from {
            opacity: 0;
            transform: translateY(-5px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }


    /* Green header */
    .reference-profile-header {
        position: relative;
        min-height: 145px;
        overflow: hidden;
        background: #0B7542; /* Updated to exact Figma tone */
        border-top-left-radius: 20px;
        border-top-right-radius: 20px;
    }

    /* Large overlay circle on the left */
    .reference-header-wave {
        position: absolute;
        left: -50px;
        top: -60px;
        width: 220px;
        height: 220px;
        border-radius: 50%;
        background: #148351;
        pointer-events: none;
    }

    /* Tree pattern styling */
    .reference-leaf-pattern {
        position: absolute;
        right: -10px;
        top: 0px;
        width: 170px;
        height: 145px;
        color: rgba(255, 255, 255, 0.12);
        pointer-events: none;
    }


    /* Header user info positioning */
    .reference-profile-user {
        position: relative;
        z-index: 2;
        min-height: 145px;
        display: flex;
        align-items: center;
        gap: 18px;
        padding: 28px 24px;
    }

    .reference-avatar-wrap {
        position: relative;
        flex: 0 0 auto;
    }

    /* Circular avatar */
    .reference-avatar {
        width: 76px;
        height: 76px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        border: 4px solid #ffffff; 
        border-radius: 50%;
        background: #ffffff;
        color: #0d7042;
        font-size: 26px;
        font-weight: 700;
        text-transform: uppercase;
        user-select: none;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

    .reference-avatar-image {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
    }

    /* Small overlapping edit button */
    .reference-edit-button {
        position: absolute;
        right: -2px;
        bottom: -2px;
        width: 28px;
        height: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        border: none;
        border-radius: 8px; 
        background: #ffffff;
        color: #0b7542;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
        cursor: pointer;
    }

        .reference-edit-button:hover,
        .reference-edit-button:focus {
            outline: none;
            background: #f0fdf4;
        }

        .reference-edit-button svg {
            width: 15px;
            height: 15px;
            stroke-width: 2.2;
        }

    .reference-user-info {
        min-width: 0;
        flex: 1;
    }

    /* Text styling */
    .reference-user-name {
        max-width: 200px;
        color: #ffffff;
        font-size: 18px;
        font-weight: 600;
        line-height: 1.2;
        margin-bottom: 4px;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow-wrap: anywhere;
        letter-spacing: 0.3px;
    }

    .reference-user-role {
        max-width: 200px;
        color: #E2F2EA;
        font-size: 15px;
        font-weight: 400;
        line-height: 1.2;
        white-space: normal;
        overflow-wrap: anywhere;
    }


    /* White action body with buttons */
    .reference-profile-body {
        display: flex;
        flex-direction: column;
        gap: 16px;
        padding: 24px;
        background: #ffffff;
        border-bottom-left-radius: 20px;
        border-bottom-right-radius: 20px;
    }

    /* Base button styling */
    .reference-menu-action {
        width: 100%;
        height: 56px;
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 0 20px;
        border: none;
        border-radius: 12px;
        cursor: pointer;
        text-align: left;
        transition: transform 0.1s ease, filter 0.1s ease;
    }

        .reference-menu-action:hover,
        .reference-menu-action:focus {
            outline: none;
            transform: scale(0.99);
            filter: brightness(0.97);
        }

    .reference-action-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .reference-action-icon svg {
        width: 24px;
        height: 24px;
    }

    .reference-action-label {
        font-size: 17px;
        font-weight: 500;
        line-height: 1;
    }

    /* Notification Button Colors */
    .reference-notification {
        background: #ECFCF3;
        color: #107445;
    }

    /* Log Out Button Card Design - Full Override */
    .reference-logout {
        height: auto !important;
        padding: 20px !important;
        gap: 16px !important;
        background: #FEEFEA !important;
        color: #D84C4B !important;
        border-radius: 16px !important;
        border: none !important;
        display: flex !important;
        align-items: center !important;
        cursor: pointer !important;
        transition: all 0.2s ease !important;
    }

    .reference-logout:hover,
    .reference-logout:focus {
        outline: none;
        background: #FCDCDA !important;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(216, 76, 75, 0.15);
    }

    .reference-logout:active {
        transform: translateY(0);
    }

    .reference-logout .reference-action-label {
