@inherits LayoutComponentBase
@using System.Net.Http.Headers
@inject HttpClient Http
@inject SPIC.MauiBlazorApp.Shared.Services.LoginState LoginState
@inject IJSRuntime JS
@inject NavigationManager Navigation

<div class="app-shell">
	<aside class="sidebar">
		<NavMenu />
	</aside>

	<main class="content-wrap">
		<div class="mobile-topbar">
			<div class="brand p-0 m-0" style="font-size: 1.7rem;">SPIC</div>
			<button class="btn btn-outline-secondary"
					type="button"
					data-bs-toggle="offcanvas"
					data-bs-target="#mobileSidebar"
					aria-controls="mobileSidebar">
				<i class="bi bi-list"></i>
			</button>
		</div>

		<div class="topbar">
			<div class="search-box">
				<i class="bi bi-search"></i>
				<input type="text" class="form-control" placeholder="Search something here">
			</div>

			<div class="top-actions">
				@* <button class="icon-btn"><i class="bi bi-bell"></i></button> *@
				<button class="icon-btn"><img src="_content/SPIC.MauiBlazorApp.Shared/images/LayoutImages/NotificationBell.svg" alt="Notification" class="iconimg" /></button>
				<div class="profile">A</div>
				<i class="bi bi-chevron-down text-secondary"></i>
			</div>
		</div>

		<div class="main-content">
			@if (_isReady)
			{
				@Body
			}
			else
			{
				<div class="d-flex justify-content-center align-items-center" style="height: 60vh;">
					<div class="spinner-border text-success" role="status">
						<span class="visually-hidden">Loading...</span>
					</div>
				</div>
			}
		</div>
	</main>
</div>

<div class="offcanvas offcanvas-start" tabindex="-1" id="mobileSidebar" aria-labelledby="mobileSidebarLabel">
	<div class="offcanvas-header">
		<h5 class="offcanvas-title brand p-0 m-0" id="mobileSidebarLabel" style="font-size:1.6rem;">SPIC</h5>
		<button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
	</div>
	<div class="offcanvas-body">
		<nav class="nav nav-pills flex-column nav-section">
			<a class="nav-link" href="#"><img src="_content/SPIC.MauiBlazorApp.Shared/images/LayoutImages/DashboardIcon.svg" alt="Dashboard" class="SideBariconimg"style="width:8%;"/>Dashboard</a>
			<a class="nav-link active" href="#"><img src="_content/SPIC.MauiBlazorApp.Shared/images/LayoutImages/PurchaseIcon.svg" alt="Purchase" class="SideBariconimg" style="width:8%;" />Purchases</a>
			<a class="nav-link" href="#"><img src="_content/SPIC.MauiBlazorApp.Shared/images/LayoutImages/RewardIcon.svg" alt="Reward" class="SideBariconimg" style="width:8%;" />Rewards</a>
			<a class="nav-link" href="#"><img src="_content/SPIC.MauiBlazorApp.Shared/images/LayoutImages/CropAdviceIcon.svg" alt="CropAdvice" class="SideBariconimg" style="width:8%;" />Crop Advice</a>
			<a class="nav-link" href="#"><img src="_content/SPIC.MauiBlazorApp.Shared/images/LayoutImages/YieldPredictionIcon.svg" alt="YieldPrediction" class="SideBariconimg" style="width:8%;" />Yield Prediction</a>
			<a class="nav-link" href="#"><img src="_content/SPIC.MauiBlazorApp.Shared/images/LayoutImages/DiseaseDetectionIcon.svg" alt="DiseaseDetection" class="SideBariconimg" style="width:8%;" />Disease Detection</a>
			<a class="nav-link" href="#"><img src="_content/SPIC.MauiBlazorApp.Shared/images/LayoutImages/Community.svg" alt="Notifications" class="SideBariconimg" style="width:8%;" />Community</a>
			<a class="nav-link" href="#"><img src="_content/SPIC.MauiBlazorApp.Shared/images/LayoutImages/NotificationsIcon.svg" alt="Notification" class="SideBariconimg" style="width:8%;" />Notifications</a>
			<a class="nav-link" href="#"><img src="_content/SPIC.MauiBlazorApp.Shared/images/LayoutImages/ProfileIcon.svg" alt="Profile" class="SideBariconimg" style="width:8%;" />Profile</a>
			<a class="nav-link" href="#"><img src="_content/SPIC.MauiBlazorApp.Shared/images/LayoutImages/SettingsIcon.svg" alt="Settings" class="SideBariconimg" style="width:8%;" />Settings</a>
		</nav>
	</div>
</div>

@code {
	private bool _isReady;

	protected override void OnInitialized()
	{
		// In-circuit navigation (e.g. after login): token is already in memory
		if (Http.DefaultRequestHeaders.Authorization != null)
		{
			_isReady = true;
		}
		else if (!string.IsNullOrWhiteSpace(LoginState.Token))
		{
			Http.DefaultRequestHeaders.Authorization =
				new AuthenticationHeaderValue("Bearer", LoginState.Token);
			_isReady = true;
		}
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender && !_isReady)
		{
			// Page refresh: restore token from sessionStorage via JS interop
			var token = await JS.InvokeAsync<string?>("sessionStorage.getItem", "jwt_token");

			if (!string.IsNullOrWhiteSpace(token))
			{
				Http.DefaultRequestHeaders.Authorization =
					new AuthenticationHeaderValue("Bearer", token);
				LoginState.Token = token;
				_isReady = true;
				StateHasChanged(); // Re-render to show @Body — child pages now initialize with token
			}
			else
			{
				Navigation.NavigateTo("/login");
			}
		}
	}
}