                            @if (LoginState.CanAccess("RMApprovalStatus"))
                            {
                                <li class="submenu-item">

                                    <NavLink href="/RMApprovalStatus"
                                             class="submenu-link"
                                             Match="NavLinkMatch.All">

                                        RM Approval Status

                                    </NavLink>

                                </li>
                            }

                        </ul>

                    }

                </div>

            }


            @* ================= SETTINGS ================= *@
@if (
                                        LoginState.CanAccess(PagePermission.LocationMaster)
                                        || LoginState.CanAccess(PagePermission.Agriculture)
                                        || LoginState.CanAccess(PagePermission.Logistics)
                                        || LoginState.CanAccess(PagePermission.Financial)
                                        || LoginState.CanAccess(PagePermission.Relationship)
                                        || LoginState.CanAccess(PagePermission.Designation)
                                        || LoginState.UserRole is AppRole.Admin or AppRole.CorporateAdmin
                                    )
            {

                <div class="settings-menu-wrapper">

                    <a href="javascript:void(0);"
                       class="nav-link mt-2 @(isSettingsOpen ? "active" : "")"
                       @onclick="ToggleSettingsMenu">

                        <img src="_content/SPIC.MauiBlazorApp.Shared/Images/LayoutImages/SettingsIcon.svg"
                             class="SideBariconimg" />

                        Settings

                        <i class="bi @(isSettingsOpen
                                                                                                                                                                             ? "bi-chevron-up"
                                                                                                                                                                             : "bi-chevron-down") chevron-icon">
                        </i>

                    </a>


                    @if (isSettingsOpen)
                    {

                        <ul class="submenu-list">


                            @if (LoginState.CanAccess(PagePermission.LocationMaster))
                            {
                                <li class="submenu-item">

                                    <NavLink href="/LocationMaster"
                                             class="submenu-link"
                                             Match="NavLinkMatch.All">

                                        Location Master

                                    </NavLink>

                                </li>
                            }


                            @if (LoginState.CanAccess(PagePermission.Agriculture))
                            {
                                <li class="submenu-item">

                                    <NavLink href="/Agriculture"
                                             class="submenu-link"
