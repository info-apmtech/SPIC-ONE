@inherits LayoutComponentBase
@implements IDisposable

@using System.Net.Http.Headers
@using System.Net.Http.Json
@using SPIC.Core.Entities
@using SPIC.MauiBlazorApp.Shared.Components.Shell

@inject HttpClient Http
@inject ISessionStore SessionStore
@inject SPIC.MauiBlazorApp.Shared.Services.LoginState LoginState
@inject SPIC.MauiBlazorApp.Shared.Services.ShellSession Shell
@inject NavigationManager Navigation
@inject IJSRuntime JS
@* Unused directly here - injecting it is what forces DI to construct it (and so subscribe to
   LocationChanged) as soon as the shell renders. See the class doc comment for why this exists. *@
@inject SPIC.MauiBlazorApp.Shared.Services.NavHistoryService NavHistory
@inject SPIC.MauiBlazorApp.Shared.Services.PublicityApi PubApi
@inject SPIC.MauiBlazorApp.Shared.Services.PublicityNotificationState PubNotify

<PageGuard />

@* The fully authenticated shell (sidebar, topbar/profile, page body) is gated by
   a single readiness flag. During login/refresh it becomes true only after
   LoginState is fully populated; during logout it flips off immediately so the
   whole authenticated UI (menu + profile icon + content) is hidden as ONE
   consistent state. No part of the shell is ever rendered from partial state. *@
@if (_isReady)
{
    <div class="app-shell">

        <LoadingOverlay />
        <ToastHost />
        <ConfirmDialog />
        <OfflineBanner />
        <SessionExpiryDialog LoginPath="@SessionPersistence.LoginPathFor(LoginState.UserRole)" />

    @* Desktop (>= 1200px): full sidebar. Hidden on phone + tablet by Layout.css. *@
    <aside class="sidebar">
        <NavMenu />
    </aside>

    @* Tablet (768 .. 1199.98px): 72px icon rail (Components/Shell/NavRail). Self-hides elsewhere. *@
    <NavRail />

    <main class="content-wrap">

        @* ================= TOP BAR =================
           Desktop: search + actions, exactly as before.
           Phone (<= 767.98px, Layout.css): becomes the compact sticky bar
           logo + notification + avatar; the search box is hidden and the
           brand in .shell-topbar-lead is shown. *@
        <div class="topbar">

            @* Brand - display:none on desktop/tablet (Layout.css) *@
            <div class="shell-topbar-lead">
                <a class="brand shell-topbar-brand"
                   href="@LoginState.LandingPage"
                   aria-label="SPIC home">
                    <img src="_content/SPIC.MauiBlazorApp.Shared/Images/LoginImages/logo.png"
                         alt="SPIC"
                         class="shell-topbar-logo" />
                </a>
            </div>

            @* Search (Components/Shell/TopbarSearch): its own component so that a
               keystroke no longer re-renders this layout. *@
            <TopbarSearch />


            @* ================= TOP RIGHT ACTIONS ================= *@
            <div class="top-actions">

                @* Phone + tablet quick actions (<= 1199.98px). Both are plain links so
                   they work in Blazor Server and in the MAUI BlazorWebView without any
                   handler. Layout.css hides them at >= 1200px, where the existing
                   desktop notification button below is shown instead - the desktop bar
                   stays pixel-identical. *@
                @if (LoginState.IsLoggedIn)
                {
                    @* Each quick action uses the SAME decision as the menu entry for that
                       destination: LoginState.CanSeeMenu, which lets the Designation switch the
                       entry off even though PageAuthorization opens the route for every signed-in
                       user (Ask AI / Library -> DigitalLibrary, bell -> PagePermission.Alerts).
                       Admin / SuperAdmin pass both through the role bypass exactly as before; a
                       user who may not open the page no longer sees a link that would only bounce
                       them off it. Pages, routes and APIs are untouched. *@
                    @if (LoginState.CanSeeMenu(PagePermission.DigitalLibrary))
                    {
                        <a class="icon-btn shell-topbar-quick shell-topbar-ai"
                           href="/DigitalLibrary/chat"
                           aria-label="Ask SPIC AI"
                           title="Ask SPIC AI">

                            <i class="bi bi-stars"></i>

                        </a>
                    }

                    @if (LoginState.CanSeeMenu(PagePermission.Alerts))
                    {
                        <a class="icon-btn shell-topbar-quick shell-topbar-alerts"
                           href="/Alerts"
                           aria-label="Alerts"
                           title="Alerts">

                            <img src="_content/SPIC.MauiBlazorApp.Shared/Images/LayoutImages/NotificationBell.svg"
                                 alt=""
                                 class="iconimg" />
                            @if (HasPublicityAccess && PubNotify.UnreadCount > 0)
                            {
                                <span class="icon-btn__badge">@UnreadBadgeText</span>
                            }

                        </a>
                    }
                }

                @* Notification - existing topbar flow unchanged (desktop >= 1200px), now also the
                   Publicity live unread badge/click target when the signed-in user has Publicity
                   access (RM/SMD/SMM/ADMIN-MD CS/DGM-MD CS/dispatch/creator roles) - everyone else
                   sees exactly the same inert bell as before. *@
                <button class="icon-btn shell-topbar-bell-desktop"
                        type="button"
                        title="Notifications"
                        @onclick="OpenPublicityNotifications">

                    <img src="_content/SPIC.MauiBlazorApp.Shared/Images/LayoutImages/NotificationBell.svg"
                         alt="Notification"
                         class="iconimg" />
                    @if (HasPublicityAccess && PubNotify.UnreadCount > 0)
                    {
                        <span class="icon-btn__badge">@UnreadBadgeText</span>
                    }

                </button>


                @* User profile + account card (Components/Shell/TopbarUserMenu).
                   Parameterless: opening it no longer re-renders this layout, and
                   this layout re-rendering no longer re-renders it. It reads the
                   user and the logout action from the scoped ShellSession. *@
                @* Help Desk "?" (Components/Help/HelpButton): the guide for the current screen. *@
                @if (LoginState.IsLoggedIn && RouteAccess.CanOpen(LoginState, "/Help", null))
                {
                    <HelpButton />
                }
                <TopbarUserMenu />

            </div>
        </div>


        @* ================= MAIN CONTENT ================= *@
        <div class="main-content">

            <TelemetryErrorBoundary @ref="_pageErrorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent Context="pageError">
                    <div class="page-error" role="alert">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <h5>This page hit a problem</h5>
                        <p>Something went wrong while loading this screen. You can try again or go back to the dashboard.</p>
                        <div class="page-error-actions">
                            <button type="button" class="btn btn-success btn-sm" @onclick="() => _pageErrorBoundary?.Recover()">Try again</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="@(() => Navigation.NavigateTo(LoginState.LandingPage))">Go to dashboard</button>
                        </div>
                    </div>
                </ErrorContent>
            </TelemetryErrorBoundary>

        </div>

    </main>

    @* Phone (<= 767.98px): fixed bottom tab bar + "More" sheet (Components/Shell).
       Self-hides on tablet/desktop. Logout is owned by this layout. *@
    <BottomTabBar />

    @* Help Desk "?" panel, rendered here (outside the sticky top bar's stacking layer) so it
       covers the phone tab bar. Opened by HelpButton in the top bar. *@
    @if (LoginState.IsLoggedIn)
    {
        <HelpPanelHost />
        @* Guided tour overlay (Components/Help/HelpTourHost), started from the guides or "?". *@
        <HelpTourHost />
    }

</div>


@* =========================================================
   FULL MENU OFFCANVAS (phone + tablet)
   Opened from MoreSheet "Full menu" and the NavRail menu button.
   Lives in Components/Shell/MobileSidebar.razor and takes no parameters, so a
   re-render of this layout never diffs its ~1,000 lines of markup again.
   ========================================================= *@

<MobileSidebar />

}
else
{
    <div class="auth-transition">

        <LoadingOverlay />

        <div class="auth-transition-inner">

            <div class="spinner-border text-success"
                 role="status">

                <span class="visually-hidden">
                    Loading...
                </span>

            </div>

        </div>

    </div>
}

<style>

    /* ================= AUTH TRANSITION ================= */

    .auth-transition {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f3f5f7;
    }

    .auth-transition-inner {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* The global search and the account menu card keep their own CSS in
       Components/Shell/TopbarSearch.razor and Components/Shell/TopbarUserMenu.razor. */

</style>


@code {
    private TelemetryErrorBoundary? _pageErrorBoundary;

    // A page that threw is given a fresh start on the next navigation.
    protected override void OnParametersSet() => _pageErrorBoundary?.Recover();


    /* =========================================================
       VARIABLES

       The full menu's submenu flags now live in Components/Shell/MobileSidebar,
       the account card's state in Components/Shell/TopbarUserMenu, and the
       signed-in user's name / role / photo in the scoped ShellSession - so that
       none of them can drag this layout into a re-render (or be dragged into one).
       ========================================================= */

    private bool _isReady;

    private Timer? _tokenExpiryTimer;

    // Kept so Dispose only detaches the handler if it is still ours.
    private Func<Task>? _logoutHandler;


    /* =========================================================
       PUBLICITY LIVE NOTIFICATION BADGE (header bell)
       ========================================================= */

    // Scoped to users who could plausibly receive a Publicity notification at all (reviewers,
    // dispatchers, request creators) - everyone else never starts polling and the bell stays exactly
    // as inert as it already was for them.
    private bool HasPublicityAccess => PubApi.IsApprover || PubApi.IsDispatcher || PubApi.CanCreate;
    private string UnreadBadgeText => PubNotify.UnreadCount > 99 ? "99+" : PubNotify.UnreadCount.ToString();

    private void HandlePubNotifyChanged() => InvokeAsync(StateHasChanged);

    private async void HandleNewPublicityNotification()
    {
        if (PubNotify.Muted) return;
        try { await JS.InvokeVoidAsync("pubNotifySound.play"); }
        catch (Exception) { /* autoplay blocked/unsupported - the visual badge already updated */ }
    }

    private void OpenPublicityNotifications()
    {
        if (HasPublicityAccess) Navigation.NavigateTo($"{PubApi.Home}/notifications");
    }

    protected override async Task OnInitializedAsync()
    {
        PubNotify.OnChange += HandlePubNotifyChanged;
        PubNotify.OnNewNotification += HandleNewPublicityNotification;
        if (HasPublicityAccess)
        {
            try { PubNotify.SetMuted(await JS.InvokeAsync<bool>("pubNotifySound.isMuted")); }
            catch (Exception) { /* JS interop not ready yet during prerender - defaults to unmuted */ }
            PubNotify.EnsurePolling();
        }
    }

    /* =========================================================
       INITIALIZE
       ========================================================= */

    protected override void OnInitialized()
    {
        // The account card and the More sheet both trigger logout, but only this
        // layout can hide the whole authenticated shell as one state, so it keeps
        // owning the flow and publishes it through ShellSession.
        _logoutHandler = Logout;
        Shell.LogoutHandler = _logoutHandler;

        StartExpiryCheck();

        // .main-content (or, on phone, <body>) is the actual scroll container, so
        // the browser's own scroll restoration never resets it on navigation -
        // every in-app page change would otherwise open at the old scroll offset.
        Navigation.LocationChanged += OnLocationChanged;


        /*
         * Token already available
         */

        if (Http.DefaultRequestHeaders.Authorization != null)
        {
            var token =
                LoginState.Token
                ?? Http.DefaultRequestHeaders.Authorization.Parameter;

            Shell.LoadFromToken(token);

            _isReady = true;
        }

        /*
         * LoginState token available
         */

        else if (!string.IsNullOrWhiteSpace(LoginState.Token))
        {
            Http.DefaultRequestHeaders.Authorization =
                new AuthenticationHeaderValue(
                    "Bearer",
                    LoginState.Token
                );

            Shell.LoadFromToken(LoginState.Token);

            _isReady = true;
        }
    }


    /* =========================================================
       PAGE REFRESH
       ========================================================= */

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (firstRender && !_isReady)
        {

            /*
             * Page refresh:
             *
             * Restore:
             * 1. JWT Token
             * 2. Logged User
             * 3. Page Permissions
             * 4. Token Expiration
             */

            var token =
                await SessionStore.GetAsync(SessionKeys.Token);


            if (!string.IsNullOrWhiteSpace(token))
            {
                if (!LoginState.IsLoggedIn)
                    LoginState.Clock.Restore(await SessionStore.GetAsync(SessionKeys.ServerClockOffset));

                /*
                 * Recheck fix U1 (Farmer role only): an expired (or nearly expired) farmer JWT is
                 * traded for a fresh one with the stored refresh token before anything uses it.
                 * The refresh token is forgotten only when that attempt fails.
                 */
                var storedExpText = await SessionStore.GetAsync(SessionKeys.Expiration);
                DateTime? storedExpiry = DateTime.TryParse(storedExpText, System.Globalization.CultureInfo.InvariantCulture,
                    System.Globalization.DateTimeStyles.RoundtripKind, out var storedExp) ? storedExp : null;
                if (SessionPersistence.NeedsFarmerRefresh(SessionPersistence.RoleOf(token), storedExpiry, LoginState.Clock.UtcNow))
                {
                    LoginState.SetAllowedPages(await SessionStore.GetAsync(SessionKeys.RoleAccess));
                    if (await SessionPersistence.TryRefreshAsync(Http, SessionStore, LoginState))
                        token = LoginState.Token ?? token;
                    else
                        await SessionPersistence.ForgetRefreshTokenAsync(SessionStore);
                }

                /*
                 * Restore Authorization Header
                 */

                Http.DefaultRequestHeaders.Authorization =
                    new AuthenticationHeaderValue(
                        "Bearer",
                        token
                    );


                /*
                 * RE-READ PAGE PERMISSIONS FROM THE SERVER
                 *
                 * The RoleAccess snapshot taken at login is otherwise authoritative for the
                 * whole session, so a Designation edited by an administrator would never reach
                 * a user who is already signed in. One call per app load - no polling, no
                 * refresh loop - and it runs BEFORE LoginState.Token is restored, so
                 * PageGuard's first successful check already sees the fresh set. The result is
                 * written back to the session store so PageGuard / Login.razor restore the same
                 * value. Any failure (offline, 401, server error) keeps the session snapshot
                 * exactly as it was, so login and session behaviour are unchanged.
                 */

                try
                {
                    var freshRoleAccess = await Http.GetFromJsonAsync<string>(
                        "api/Authentication/permissions");

                    if (freshRoleAccess is not null)
                    {
                        await SessionStore.SetAsync(
                            SessionKeys.RoleAccess,
                            freshRoleAccess
                        );
                        await SessionStore.SetAsync(SessionKeys.ServerClockOffset, LoginState.Clock.SavedOffset);
                    }
                }
                catch { /* keep the session snapshot */ }


                /*
                 * Restore LoginState Token
                 */

                LoginState.Token = token;


                /*
                 * Load logged user's Name + Role
                 */

                Shell.LoadFromToken(token);


                /*
                 * Restore Page Permissions
                 */

                var roleAccess =
                    await SessionStore.GetAsync(SessionKeys.RoleAccess);

                LoginState.SetAllowedPages(
                    roleAccess
                );


                /*
                 * Restore Designation (separate from AppRole)
                 */

                var designationName =
                    await SessionStore.GetAsync(SessionKeys.DesignationName);

                LoginState.SetDesignationName(
                    designationName
                );


                /*
                 * Restore Expiration
                 */

                var expStr =
                    await SessionStore.GetAsync(SessionKeys.Expiration);


                if (
                    !string.IsNullOrWhiteSpace(expStr)
                    && DateTime.TryParse(
                        expStr,
                        out var exp)
                )
                {
                    LoginState.Expiration = exp;
                }


                /*
                 * Restore Refresh Token
                 */

                LoginState.RefreshToken =
                    await SessionStore.GetAsync(SessionKeys.RefreshToken);


                _isReady = true;

                StateHasChanged();
            }
            else
            {
                // Recheck U5: a /farmer/* link, or a device whose last sign-in was a farmer, opens the farmer sign-in.
                Navigation.NavigateTo(
                    SessionPersistence.SignedOutLoginPath(
                        Navigation.ToBaseRelativePath(Navigation.Uri),
                        await SessionPersistence.LastSignInWasFarmerAsync(SessionStore))
                );
            }
        }
    }


    /* =========================================================
       SCROLL TO TOP ON NAVIGATION
       ========================================================= */

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        try { await JS.InvokeVoidAsync("scrollPageToTop"); } catch { }
    }


    /* =========================================================
       MANUAL LOGOUT
       ========================================================= */

    private async Task Logout()
    {
        // Recheck U5: the sign-in page for this role, read before anything is cleared.
        var loginPath = SessionPersistence.LoginPathFor(LoginState.UserRole);

        // Enter the single logout transition FIRST: hide the entire
        // authenticated shell (menu, profile icon, page content) as one state
        // BEFORE any authentication state is cleared, so no intermediate
        // authenticated/unauthenticated UI can ever be rendered.
        _isReady = false;
        StateHasChanged();

        try
        {
            await Http.PostAsync(
                "api/authentication/logout",
                null
            );
        }
        catch
        {
            // Even if API logout fails,
            // clear client-side login information.
        }


        _tokenExpiryTimer?.Dispose();

        _tokenExpiryTimer = null;


        LoginState.Token = null;

        LoginState.Expiration = default;

        LoginState.ClearAllowedPages();

        LoginState.SetDesignationName(null);


        Http.DefaultRequestHeaders.Authorization =
            null;


        /*
         * Clear current user values
         */

        Shell.ClearUser();


        try
        {
            await SessionStore.ClearAsync();
        }
        catch
        {
            // Ignore session store cleanup errors
        }


        Navigation.NavigateTo(
            loginPath
        );
    }

    /* =========================================================
       TOKEN EXPIRY CHECK
       ========================================================= */

    private void StartExpiryCheck()
    {
        _tokenExpiryTimer?.Dispose();


        _tokenExpiryTimer =
            new Timer(
                async _ =>
                {
                    try
                    {
                        await InvokeAsync(ExpiryTickAsync);
                    }
                    catch (ObjectDisposedException) { }
                    catch (InvalidOperationException) { }
                    catch (TaskCanceledException) { }
                },
                null,
                TimeSpan.FromSeconds(5),
                TimeSpan.FromSeconds(5)
            );
    }


    /* =========================================================
       AUTO LOGOUT
       ========================================================= */

    /// <summary>Last expiry-tick refresh attempt ("expiration|expired"), so each farmer token is refreshed at most once
    /// ahead of the warning and once more at expiry.</summary>
    private string? _farmerRefreshTried;
    private DateTime _farmerRefreshedAtUtc;
    private bool _expiryTickBusy;

    /// <summary>
    /// One expiry check (every 5 s). Recheck fix U1, Farmer role only: a farmer session is refreshed silently
    /// <see cref="SessionPersistence.FarmerRefreshAhead"/> before expiry (so the warning dialog does not appear) and
    /// tried once more at expiry; AutoLogout (which clears the stored refresh token) runs only after that fails.
    /// Staff keep the old rule: AutoLogout at expiry.
    /// </summary>
    private async Task ExpiryTickAsync()
    {
        if (_expiryTickBusy) return;
        _expiryTickBusy = true;
        try
        {
            var expiration = LoginState.Expiration;
            if (LoginState.UserRole == AppRole.Farmer && expiration != default
                && expiration.ToUniversalTime() - LoginState.Clock.UtcNow <= SessionPersistence.FarmerRefreshAhead)
            {
                var key = expiration.ToString("O") + "|" + LoginState.IsTokenExpired;
                // At most one refresh a minute ahead of expiry, so a short Jwt:ExpiryMinutes cannot loop; at expiry
                // the one last try always runs.
                var due = LoginState.IsTokenExpired || DateTime.UtcNow - _farmerRefreshedAtUtc >= TimeSpan.FromMinutes(1);
                if (_farmerRefreshTried != key && due)
                {
                    _farmerRefreshTried = key;
                    if (await SessionPersistence.TryRefreshAsync(Http, SessionStore, LoginState))
                    {
                        _farmerRefreshedAtUtc = DateTime.UtcNow;
                        return;
                    }
                }
            }

            if (LoginState.IsTokenExpired)
                await AutoLogout();
        }
        finally
        {
            _expiryTickBusy = false;
        }
    }

    private async Task AutoLogout()
    {
        // Recheck U5: the sign-in page for this role, read before anything is cleared.
        var loginPath = SessionPersistence.LoginPathFor(LoginState.UserRole);

        // Hide the authenticated shell as one state before clearing anything.
        _isReady = false;
        StateHasChanged();

        _tokenExpiryTimer?.Dispose();

        _tokenExpiryTimer = null;


        LoginState.Token = null;

        LoginState.Expiration = default;

        LoginState.ClearAllowedPages();

        LoginState.SetDesignationName(null);


        Http.DefaultRequestHeaders.Authorization =
            null;


        Shell.ClearUser();


        try
        {
            await SessionStore.ClearAsync();
        }
        catch
        {
            // Ignore cleanup errors
        }


        Navigation.NavigateTo(
            loginPath
        );
    }


    /* =========================================================
       DISPOSE
       ========================================================= */

    public void Dispose()
    {
        _tokenExpiryTimer?.Dispose();

        Navigation.LocationChanged -= OnLocationChanged;
        PubNotify.OnChange -= HandlePubNotifyChanged;
        PubNotify.OnNewNotification -= HandleNewPublicityNotification;

        if (ReferenceEquals(Shell.LogoutHandler, _logoutHandler))
        {
            Shell.LogoutHandler = null;
        }
    }

}
