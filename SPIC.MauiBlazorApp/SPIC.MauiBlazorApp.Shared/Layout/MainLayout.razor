                </NavLink>
            } *@


            @* ================= CROP ADVICE (removed - no page) ================= *@
            @* @if (LoginState.CanAccess(PagePermission.CropAdvice))
            {
                <NavLink class="nav-link"
                         href="/CropAdvice">

                    <img src="_content/SPIC.MauiBlazorApp.Shared/Images/LayoutImages/CropAdviceIcon.svg"
