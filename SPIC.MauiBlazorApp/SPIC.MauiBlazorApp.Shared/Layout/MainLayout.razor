@inherits LayoutComponentBase
@implements IDisposable

@using System.Net.Http.Headers
@using System.Text
@using System.Text.Json
@using SPIC.Core.Entities
@using SPIC.MauiBlazorApp.Shared.Components.Shell

@inject HttpClient Http
@inject ISessionStore SessionStore
@inject SPIC.MauiBlazorApp.Shared.Services.LoginState LoginState
@inject SPIC.MauiBlazorApp.Shared.Services.AppSearchState SearchState
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageGuard />

@* The fully authenticated shell (sidebar, topbar/profile, page body) is gated by
   a single readiness flag. During login/refresh it becomes true only after
   LoginState is fully populated; during logout it flips off immediately so the
   whole authenticated UI (menu + profile icon + content) is hidden as ONE
   consistent state. No part of the shell is ever rendered from partial state. *@
@if (_isReady)
{
    <div class="app-shell">

        <LoadingOverlay />

    @* Desktop (>= 1200px): full sidebar. Hidden on phone + tablet by Layout.css. *@
    <aside class="sidebar">
        <NavMenu />
    </aside>

    @* Tablet (768 .. 1199.98px): 72px icon rail (Components/Shell/NavRail). Self-hides elsewhere. *@
    <NavRail />

    <main class="content-wrap">

        @* ================= TOP BAR =================
           Desktop: search + actions, exactly as before.
           Phone (<= 767.98px, Layout.css): becomes the compact sticky bar
           logo + notification + avatar; the search box is hidden and the
           brand in .shell-topbar-lead is shown. *@
        <div class="topbar">

            @* Brand - display:none on desktop/tablet (Layout.css) *@
            <div class="shell-topbar-lead">
                <a class="brand shell-topbar-brand"
                   href="@LoginState.LandingPage"
                   aria-label="SPIC home">
                    SPIC
                </a>
            </div>

            @* Search *@
            <div class="search-box">

                <i class="bi bi-search"></i>

                <input type="text"
                       class="form-control"
                       placeholder="Search something here"
                       value="@SearchState.Query"
                       @oninput="OnGlobalSearchInput"
                       @onkeydown="HandleSearchKeyDown" />

                @if (SearchState.HasQuery)
                {
                    <i class="bi bi-x-circle-fill global-search-clear"
                           title="Clear search"
                           @onclick="() => SearchState.Clear()">
                    </i>
                }

            </div>


            @* ================= TOP RIGHT ACTIONS ================= *@
            <div class="top-actions">

                @* Notification - existing topbar flow unchanged *@
                <button class="icon-btn"
                        type="button"
                        title="Notifications">

                    <img src="_content/SPIC.MauiBlazorApp.Shared/Images/LayoutImages/NotificationBell.svg"
                         alt="Notification"
                         class="iconimg" />

                </button>


                @* User profile - custom overlay so it never changes topbar size/background *@
                <div class="user-profile-wrapper">

                    <button class="user-menu-toggle @(_showUserMenu ? "open" : "")"
                            type="button"
                            title="@_userName"
                            aria-label="Account menu"
                            aria-expanded="@_showUserMenu"
                            @onclick="ToggleUserMenu">

                        <div class="topbar-avatar-only">
                            @GetUserInitial()
                        </div>

                        <i class="bi bi-chevron-down topbar-user-chevron"></i>

                    </button>


                    @if (_showUserMenu)
                    {
                        <div class="user-menu-backdrop"
                             @onclick="CloseUserMenu">
                        </div>

                        <div id="userProfileMenu" class="user-profile-menu">

                            @* ===== Reference-style green profile header ===== *@
                            <div class="reference-profile-header">

                                <div class="reference-header-wave"></div>

                                @* Tree Pattern *@
                                   <img src="_content/SPIC.MauiBlazorApp.Shared/Images/LayoutImages/logouttreeimg.svg" class="reference-leaf-pattern-img" alt="logout" />


                                <div class="reference-profile-user">

                                    <div class="reference-avatar-wrap">

                                        <div class="reference-avatar">
                                            @if (!string.IsNullOrWhiteSpace(_profileImageUrl))
                                            {
                                                <img src="@_profileImageUrl"
                                                     alt="@_userName"
                                                     class="reference-avatar-image" />
                                            }
                                            else
                                            {
                                                <span>@GetUserInitial()</span>
                                            }
                                        </div>

                                        @if (LoginState.CanAccess(PagePermission.Profile))
                                        {
                                            <button type="button"
                                                    class="reference-edit-button"
                                                    title="Profile"
                                                    @onclick="GoToProfile">
                                                
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                                </svg>

                                            </button>
                                        }

                                    </div>


                                    <div class="reference-user-info">

                                        <div class="reference-user-name">
                                            @_userName
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(_userRole))
                                        {
                                            <div class="reference-user-role">
                                                @_userRole
                                            </div>
                                        }

                                    </div>

                                </div>

                            </div>


                            @* ===== Reference-style action area ===== *@
                            <div class="reference-profile-body">

                                @if (LoginState.CanAccess(PagePermission.Notifications))
                                {
                                    <button type="button"
                                            class="reference-menu-action reference-notification"
                                            @onclick="GoToNotifications">

                                        <span class="reference-action-icon">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                                                <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                                            </svg>
                                        </span>

                                        <span class="reference-action-label">
                                            Notification
                                        </span>

                                    </button>
                                }


                                <button type="button"
                                        class="reference-menu-action reference-logout"
                                        @onclick="Logout">

                                    <span class="reference-action-icon">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                            <polyline points="16 17 21 12 16 7"></polyline>
                                            <line x1="21" y1="12" x2="9" y2="12"></line>
                                        </svg>
                                    </span>

                                    <span class="reference-action-label">
                                        Log Out
                                    </span>

                                </button>

                            </div>

                        </div>
                    }

                </div>

            </div>
        </div>


        @* ================= MAIN CONTENT ================= *@
        <div class="main-content">

            <ErrorBoundary @ref="_pageErrorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent Context="pageError">
                    <div class="page-error" role="alert">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <h5>This page hit a problem</h5>
                        <p>Something went wrong while loading this screen. You can try again or go back to the dashboard.</p>
                        <div class="page-error-actions">
                            <button type="button" class="btn btn-success btn-sm" @onclick="() => _pageErrorBoundary?.Recover()">Try again</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="@(() => Navigation.NavigateTo(LoginState.LandingPage))">Go to dashboard</button>
                        </div>
                    </div>
                </ErrorContent>
            </ErrorBoundary>

        </div>

    </main>

    @* Phone (<= 767.98px): fixed bottom tab bar + "More" sheet (Components/Shell).
       Self-hides on tablet/desktop. Logout is owned by this layout. *@
    <BottomTabBar OnLogout="Logout" />

</div>


@* =========================================================
   FULL MENU OFFCANVAS (phone + tablet)
   Opened from MoreSheet "Full menu" and the NavRail menu button.
   ========================================================= *@

<div class="offcanvas offcanvas-start"
     tabindex="-1"
     id="mobileSidebar"
     aria-labelledby="mobileSidebarLabel">

    <div class="offcanvas-header">

        <h5 class="offcanvas-title brand p-0 m-0"
            id="mobileSidebarLabel"
            style="font-size:1.6rem;">

            SPIC

        </h5>

        <button type="button"
                class="btn-close"
                data-bs-dismiss="offcanvas"
                aria-label="Close">
        </button>

    </div>


    <div class="offcanvas-body">

        <nav class="nav nav-pills flex-column nav-section">


            @* ================= DASHBOARD ================= *@
            @if (LoginState.UserRole != AppRole.Dealer && LoginState.CanAccess(PagePermission.Dashboard))
            {
                <NavLink class="nav-link"
                         href="/Dashboard"
                         Match="NavLinkMatch.All">

                    <img src="_content/SPIC.MauiBlazorApp.Shared/Images/LayoutImages/DashboardIcon.svg"
                         class="SideBariconimg" />

                    Register

                </NavLink>
            }


            @* ================= SUB DEALER MASTER ================= *@
            @if (LoginState.CanAccess(PagePermission.SubDealerList))
            {
                <NavLink class="nav-link"
                         href="/SubDealerList"
                         Match="NavLinkMatch.All">

                    <img src="_content/SPIC.MauiBlazorApp.Shared/Images/LayoutImages/DashboardIcon.svg"
                         class="SideBariconimg" />

                    Sub Dealer Master

                </NavLink>
            }


            @* ================= PURCHASES (removed - no page) ================= *@
            @* @if (LoginState.CanAccess(PagePermission.Purchases))
            {
                <NavLink class="nav-link"
                         href="/Purchases">

                    <img src="_content/SPIC.MauiBlazorApp.Shared/Images/LayoutImages/PurchaseIcon.svg"
                         class="SideBariconimg" />

                    Purchases

                </NavLink>
            } *@


            @* ================= REWARDS (removed - no page) ================= *@
            @* @if (LoginState.CanAccess(PagePermission.Rewards))
            {
                <NavLink class="nav-link"
                         href="/Rewards">

                    <img src="_content/SPIC.MauiBlazorApp.Shared/Images/LayoutImages/RewardIcon.svg"
                         class="SideBariconimg" />

