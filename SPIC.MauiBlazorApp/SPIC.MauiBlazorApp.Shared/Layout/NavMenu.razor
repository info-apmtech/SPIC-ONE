<div class="brand">SPIC</div>

<nav class="nav nav-pills flex-column nav-section">

    @* Designation decides the entry. The old `UserRole != Dealer` term was MENU-only: PageGuard
       has no Dealer rule for /Dashboard, so a Dealer granted PagePermission.Dashboard could always
       open the route. Dropping it makes the entry obey business rule 3 with no route change. *@
    @if (loginState.CanSeeMenu(PagePermission.Dashboard))
    {
        <NavLink class="@NavLinkClass("Dashboard")" href="/Dashboard" Match="NavLinkMatch.All">
            <img src="_content/SPIC.MauiBlazorApp.Shared/Images/LayoutImages/DashboardIcon.svg" class="SideBariconimg" />
            Register
        </NavLink>
    }

     @if (loginState.CanSeeMenu(PagePermission.SubDealerList))
    {
        <NavLink class="@NavLinkClass("Sub Dealer Master")" href="/SubDealerList" Match="NavLinkMatch.All">
            <img src="_content/SPIC.MauiBlazorApp.Shared/Images/LayoutImages/DashboardIcon.svg" class="SideBariconimg" />
            Sub Dealer Master
        </NavLink>
    }

    @* Digital Library: the route is open to every signed-in user (PageAuthorization.OpenAccessPages),
       but the MENU entry follows the designation, so an administrator can switch it off. A
       designation-driven role (DesignationOnly: CommonRole, SpecialAdmin) sees it only when its
       designation grants DigitalLibrary. Adding/editing content and the category master need that
       same page. Resolved by LoginState.CanSeeMenu; PageGuard still uses CanAccess for the route. *@
    @if (loginState.CanSeeMenu(PagePermission.DigitalLibrary))
    {
        <NavLink class="@NavLinkClass("Digital Library")" href="/DigitalLibrary">
            <i class="bi bi-collection-play SideBariconimg" style="font-size:18px;display:inline-flex;align-items:center;justify-content:center;"></i>
            Digital Library
        </NavLink>
    }
    @* Library Categories: the category master behind the content forms (DigitalLibrary page). *@
    @if (loginState.CanSeeMenu(PagePermission.DigitalLibrary))
    {
        <NavLink class="@NavLinkClass("Library Categories")" href="/DigitalLibrary/categories">
            <i class="bi bi-tags SideBariconimg" style="font-size:18px;display:inline-flex;align-items:center;justify-content:center;"></i>
            Library Categories
        </NavLink>
    }

    @* Knowledge Community: the route is open to every signed-in user (product decision 2026-09-20),
       but the MENU entry follows the Community designation so it can be switched off. The older
       entry further down this file sits inside a commented-out farmer-portal block. *@
