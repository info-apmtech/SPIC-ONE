@code {
    private bool isJmdoOpen = false;
    private bool isSettingsOpen = false;
    private bool isSubsidyOpen = false;
    private bool isSdwaOpen = false;
    private bool isMdPortalOpen = false;
    private bool isSchemesOpen = false;
    private bool ShowDemoDocumentationExpanded { get; set; }
    protected override void OnInitialized()
    {
        isJmdoOpen = IsJmdoSectionActive();
        isSettingsOpen = IsSettingsSectionActive();
        isSubsidyOpen = IsSubsidySectionActive();
        isSdwaOpen = IsSdwaSectionActive();
        isMdPortalOpen = IsMdPortalSectionActive();
        isSchemesOpen = IsSchemesSectionActive();
        loginState.OnChange += HandleLoginStateChanged;
        SearchState.OnChange += HandleSearchChanged;
    }

    private void HandleLoginStateChanged() => InvokeAsync(StateHasChanged);

    private async void HandleSearchChanged()
    {
        await InvokeAsync(StateHasChanged);
        await Task.Delay(50);
        try { await JSRuntime.InvokeVoidAsync("navSearch.scrollToMatch"); } catch { }
    }

    public void Dispose()
    {
        loginState.OnChange -= HandleLoginStateChanged;
        SearchState.OnChange -= HandleSearchChanged;
    }

    private string MatchClass(string label) => SearchState.Matches(label) ? "search-match" : "";

    private string NavLinkClass(string label)
    {
        var match = MatchClass(label);
        return string.IsNullOrEmpty(match) ? "nav-link" : $"nav-link {match}";
    }

    private string SubmenuLinkClass(string label)
    {
        var match = MatchClass(label);
        return string.IsNullOrEmpty(match) ? "submenu-link" : $"submenu-link {match}";
    }

    private bool AnyJmdoAccessible =>
        loginState.CanSeeMenu(PagePermission.FieldDashboard)
        || loginState.CanSeeMenu(PagePermission.FieldReports)
        || loginState.CanSeeMenu(PagePermission.MdoDashboard)
        || loginState.CanSeeMenu(PagePermission.AllocationRequests)
        || loginState.CanSeeMenu(PagePermission.TaskMonitoring)
        || loginState.CanSeeMenu(PagePermission.PerformanceTracker)
        || loginState.CanSeeMenu(PagePermission.TargetAchievement)
        || loginState.CanSeeMenu(PagePermission.FarmerData)
        || loginState.CanSeeMenu(PagePermission.MdoReports);

    private bool AnyJmdoItemMatches =>
        SearchState.Matches("My Dashboard")
        || SearchState.Matches("My Reports")
        || SearchState.Matches("Team Dashboard")
        || SearchState.Matches("Allocation Requests")
        || SearchState.Matches("Task Monitoring")
        || SearchState.Matches("Performance Tracker")
        || SearchState.Matches("Target / Achievement")
        || SearchState.Matches("Farmer Data")
        || SearchState.Matches("Reports")
        || SearchState.Matches("JMDO");

    private bool ShowJmdoExpanded => isJmdoOpen || AnyJmdoItemMatches;

    private void ToggleJmdoMenu()
    {
        if (!isJmdoOpen) { isJmdoOpen = true; isSettingsOpen = false; isSubsidyOpen = false; isSdwaOpen = false; isMdPortalOpen = false; isSchemesOpen = false; }
        else isJmdoOpen = false;
    }

    private bool IsJmdoSectionActive()
    {
        var uri = NavManager.ToBaseRelativePath(NavManager.Uri).ToLower();
        return uri == "fielddashboard" || uri == "fieldreports" || uri == "mdodashboard" || uri == "allocationrequests"
            || uri == "taskmonitoring" || uri == "performancetracker" || uri == "targetachievement"
            || uri == "farmerdata" || uri == "mdoreports";
    }

    private bool AnySettingsAccessible =>
        loginState.CanSeeMenu(PagePermission.LocationMaster)
        || loginState.CanSeeMenu(PagePermission.Agriculture)
        || loginState.CanSeeMenu(PagePermission.Logistics)
        || loginState.CanSeeMenu(PagePermission.Financial)
        || loginState.CanSeeMenu(PagePermission.Relationship)
        || loginState.CanSeeMenu(PagePermission.Designation)
        || loginState.CanSeeMenu(PagePermission.Metrics);


    private bool AnySettingsItemMatches =>
        SearchState.Matches("Location Master")
        || SearchState.Matches("Agriculture")
        || SearchState.Matches("Logistics Master")
        || SearchState.Matches("Financial Master")
        || SearchState.Matches("Relationship Master")
        || SearchState.Matches("Designation")
        || SearchState.Matches("Metrics")
        || SearchState.Matches("Settings");

    private bool ShowSettingsExpanded => isSettingsOpen || AnySettingsItemMatches;

    private void ToggleSettingsMenu()
    {
        if (!isSettingsOpen) { isSettingsOpen = true; isJmdoOpen = false; isSubsidyOpen = false; isSdwaOpen = false; isMdPortalOpen = false; isSchemesOpen = false; }
        else isSettingsOpen = false;
    }

    private bool IsSettingsSectionActive()
    {
        var uri = NavManager.ToBaseRelativePath(NavManager.Uri).ToLower();
        return uri == "locationmaster" || uri == "agriculture" || uri == "logistics" || uri == "financial" || uri == "relationship" || uri == "designation"
            || uri == "metrics" || uri.StartsWith("metrics?");
    }

    private bool AnySubsidyAccessible =>
        loginState.CanSeeMenu(PagePermission.SalesReport)
        || loginState.CanSeeMenu(PagePermission.CompanySales)
        || loginState.CanSeeMenu(PagePermission.AgeingReport)
        || loginState.CanSeeMenu(PagePermission.Acknowledgement)
        || loginState.CanSeeMenu(PagePermission.LiquidationCycle)
        || loginState.CanSeeMenu(PagePermission.TopRankingDistrict)
        || loginState.CanSeeMenu(PagePermission.TopRankingWholesalers)
        || loginState.CanSeeMenu(PagePermission.TopRankingRetailers)
        || loginState.CanSeeMenu(PagePermission.ProductWiseStockAvailability)
        || loginState.CanSeeMenu(PagePermission.StockDetails);

    private bool AnySubsidyItemMatches =>
        SearchState.Matches("Stock Report")
        || SearchState.Matches("Pending Acknowledgement")
        || SearchState.Matches("Ageing Report")
        || SearchState.Matches("Acknowledgement")
        || SearchState.Matches("Liquidation Cycle")
        || SearchState.Matches("Top Ranking District")
        || SearchState.Matches("Top Ranking Wholesaler")
        || SearchState.Matches("Top Ranking Retailers")
        || SearchState.Matches("Productwise Stock Availability")
        || SearchState.Matches("Stock Details")
        // Same condition as the File Upload child above: it only renders for Admin, so searching
        // for it must not expand the group for a user who will never see it.
        || (loginState.UserRole == AppRole.Admin && SearchState.Matches("File Upload"))
        || SearchState.Matches("Subsidy Management System");

    private bool ShowSubsidyExpanded => isSubsidyOpen || AnySubsidyItemMatches;

    private void ToggleSubsidyMenu()
    {
        if (!isSubsidyOpen) { isSubsidyOpen = true; isJmdoOpen = false; isSettingsOpen = false; isSdwaOpen = false; isMdPortalOpen = false; isSchemesOpen = false; }
        else isSubsidyOpen = false;
    }

    private bool IsSubsidySectionActive()
    {
        var uri = NavManager.ToBaseRelativePath(NavManager.Uri).ToLower();
        return uri == "stockreport" || uri == "companysales" || uri == "ageingreport"
            || uri == "acknowledgement" || uri == "liquidationcycle"
            || uri == "toprankingdistrict" || uri == "toprankingwholesalers"
            || uri == "toprankingretailers" || uri == "productwisestockavailability"
            || uri == "stockdetails" || uri == "excelformatfileupload";
    }

    // SDWA group: pure union of its children's CanSeeMenu. The former `|| UserRole == AppRole.Dealer`
    // fallback is gone - it existed only because SDWADashboard / WelfareSchemes used a Dealer role
    // bypass; those two now go through the PagePermission grant (Dealer designation backfill ships
    // first), so the group opens exactly when its children do.
    private bool AnySdwaAccessible =>
        loginState.CanSeeMenu(PagePermission.ReportDashboard)
        || loginState.CanSeeMenu(PagePermission.SDWADashboard)
        || (loginState.UserRole != AppRole.Dealer && loginState.CanSeeMenu(PagePermission.SchemeApproval))
        || loginState.CanSeeMenu(PagePermission.WelfareSchemes)
        || loginState.CanSeeMenu(PagePermission.SubDealerEmployeeMaster)
        || loginState.CanSeeMenu(PagePermission.GuestHouse)
        || loginState.CanSeeMenu(PagePermission.SdwaCompanyMaster)
        || loginState.CanSeeMenu(PagePermission.GuestHouseCancellations)
        || loginState.CanSeeMenu(PagePermission.FrontOffice)
