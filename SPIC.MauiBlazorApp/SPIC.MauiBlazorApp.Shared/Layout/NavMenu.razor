<style>
    .nav-section::-webkit-scrollbar { width: 5px; }
    .nav-section::-webkit-scrollbar-track { background: transparent; }
    .nav-section::-webkit-scrollbar-thumb { background: #c4c4c4; border-radius: 4px; }
    .nav-section::-webkit-scrollbar-thumb:hover { background: #a8a8a8; }
    .nav-section { scrollbar-width: thin; scrollbar-color: #c4c4c4 transparent; overflow-y: auto; }

    .nav-link.search-match,
    .submenu-link.search-match {
        background-color: #FEF3C7 !important;
        border-left: 3px solid #F59E0B !important;
        color: #92400E !important;
        font-weight: 600;
        animation: nav-search-pulse 1.5s ease-in-out infinite;
    }

    .nav-link.search-match img,
    .submenu-link.search-match img {
        filter: brightness(0) saturate(100%) invert(45%) sepia(85%) saturate(800%) hue-rotate(15deg);
    }

    @@keyframes nav-search-pulse {
        0%, 100% { background-color: #FEF3C7; }
        50%      { background-color: #FDE68A; }
    }
</style>

@code {
    private bool isSettingsOpen = false;
    private bool isSubsidyOpen = false;
    private bool isSdwaOpen = false;

    protected override void OnInitialized()
    {
        isSettingsOpen = IsSettingsSectionActive();
        isSubsidyOpen = IsSubsidySectionActive();
        isSdwaOpen = IsSdwaSectionActive();
        loginState.OnChange += HandleLoginStateChanged;
        SearchState.OnChange += HandleSearchChanged;
    }

    private void HandleLoginStateChanged() => InvokeAsync(StateHasChanged);

    private async void HandleSearchChanged()
    {
        await InvokeAsync(StateHasChanged);
        await Task.Delay(50);
        try { await JSRuntime.InvokeVoidAsync("navSearch.scrollToMatch"); } catch { }
    }

    public void Dispose()
    {
        loginState.OnChange -= HandleLoginStateChanged;
        SearchState.OnChange -= HandleSearchChanged;
    }

    private string MatchClass(string label) => SearchState.Matches(label) ? "search-match" : "";

    private string NavLinkClass(string label)
    {
        var match = MatchClass(label);
        return string.IsNullOrEmpty(match) ? "nav-link" : $"nav-link {match}";
    }

    private string SubmenuLinkClass(string label)
    {
        var match = MatchClass(label);
        return string.IsNullOrEmpty(match) ? "submenu-link" : $"submenu-link {match}";
    }

    private bool AnySettingsAccessible =>
        loginState.CanAccess(PagePermission.LocationMaster)
        || loginState.CanAccess(PagePermission.Agriculture)
        || loginState.CanAccess(PagePermission.Logistics)
        || loginState.CanAccess(PagePermission.Financial)
        || loginState.CanAccess(PagePermission.Relationship)
        || loginState.CanAccess(PagePermission.Designation)
        || loginState.UserRole is AppRole.Admin or AppRole.CorporateAdmin;


    private bool AnySettingsItemMatches =>
        SearchState.Matches("Location Master")
        || SearchState.Matches("Agriculture")
        || SearchState.Matches("Logistics Master")
        || SearchState.Matches("Financial Master")
        || SearchState.Matches("Relationship Master")
        || SearchState.Matches("Designation")
        || SearchState.Matches("Page Management")
        || SearchState.Matches("Settings");

    private bool ShowSettingsExpanded => isSettingsOpen || AnySettingsItemMatches;

    private void ToggleSettingsMenu()
    {
        if (!isSettingsOpen) { isSettingsOpen = true; isSubsidyOpen = false; isSdwaOpen = false; }
        else isSettingsOpen = false;
    }

    private bool IsSettingsSectionActive()
    {
        var uri = NavManager.ToBaseRelativePath(NavManager.Uri).ToLower();
        return uri == "locationmaster" || uri == "agriculture" || uri == "logistics" || uri == "financial" || uri == "relationship" || uri == "designation" || uri == "pagemanagement";
    }

    private bool AnySubsidyAccessible =>
        loginState.CanAccess(PagePermission.SalesReport)
        || loginState.CanAccess(PagePermission.CompanySales)
        || loginState.CanAccess(PagePermission.AgeingReport)
        || loginState.CanAccess(PagePermission.Acknowledgement)
        || loginState.CanAccess(PagePermission.LiquidationCycle)
        || loginState.CanAccess(PagePermission.TopRankingDistrict)
        || loginState.CanAccess(PagePermission.TopRankingWholesalers)
        || loginState.CanAccess(PagePermission.TopRankingRetailers)
        || loginState.CanAccess(PagePermission.ProductWiseStockAvailability)
        || loginState.CanAccess(PagePermission.StockDetails);

    private bool AnySubsidyItemMatches =>
        SearchState.Matches("Stock Report")
        || SearchState.Matches("Pending Acknowledgement")
        || SearchState.Matches("Ageing Report")
        || SearchState.Matches("Acknowledgement")
        || SearchState.Matches("Liquidation Cycle")
        || SearchState.Matches("Top Ranking District")
        || SearchState.Matches("Top Ranking Wholesaler")
        || SearchState.Matches("Top Ranking Retailers")
        || SearchState.Matches("Productwise Stock Availability")
        || SearchState.Matches("Stock Details")
        || SearchState.Matches("File Upload")
        || SearchState.Matches("Subsidy Management System");

    private bool ShowSubsidyExpanded => isSubsidyOpen || AnySubsidyItemMatches;

    private void ToggleSubsidyMenu()
    {
        if (!isSubsidyOpen) { isSubsidyOpen = true; isSettingsOpen = false; isSdwaOpen = false; }
        else isSubsidyOpen = false;
    }

    private bool IsSubsidySectionActive()
    {
        var uri = NavManager.ToBaseRelativePath(NavManager.Uri).ToLower();
        return uri == "stockreport" || uri == "companysales" || uri == "ageingreport"
            || uri == "acknowledgement" || uri == "liquidationcycle"
            || uri == "toprankingdistrict" || uri == "toprankingwholesalers"
            || uri == "toprankingretailers" || uri == "productwisestockavailability"
            || uri == "stockdetails" || uri == "excelformatfileupload";
    }

    private bool AnySdwaAccessible =>
        loginState.CanAccess(PagePermission.SDWADashboard)
        || (loginState.UserRole != AppRole.Dealer && (loginState.CanAccess(PagePermission.SchemeApproval) || loginState.UserRole == AppRole.Director))
        || loginState.CanAccess(PagePermission.WelfareSchemes)
        || loginState.CanAccess(PagePermission.SubDealerEmployeeMaster)
        || loginState.UserRole is AppRole.Admin or AppRole.CorporateAdmin
        || loginState.CanAccess(PagePermission.FrontOffice)
        || loginState.CanAccess(PagePermission.GenerateBill);

    private bool AnySdwaItemMatches =>
        SearchState.Matches("SDWA Dashboard")
        || SearchState.Matches("Scheme Approval")
        || SearchState.Matches("Welfare Schemes")
        || SearchState.Matches("Sub Dealer & Employee")
        || SearchState.Matches("Guest House")
        || SearchState.Matches("Front Office")
        || SearchState.Matches("Generate Bill")
        || SearchState.Matches("SDWA");

    private bool ShowSdwaExpanded => isSdwaOpen || AnySdwaItemMatches;

    private void ToggleSdwaMenu()
    {
        if (!isSdwaOpen) { isSdwaOpen = true; isSettingsOpen = false; isSubsidyOpen = false; }
        else isSdwaOpen = false;
    }

    private bool IsSdwaSectionActive()
    {
        var uri = NavManager.ToBaseRelativePath(NavManager.Uri).ToLower();
        return uri == "sdwadashboard" || uri == "schemeapproval"
            || uri == "welfareschemes"
            || uri == "subdealeremployeemaster" || uri == "guesthousemaster"
            || uri == "frontoffice" || uri == "generatebill";
    }
}
<script>
    window.navSearch = {
        scrollToMatch: function () {
            var match = document.querySelector('.search-match');
            if (match) match.scrollIntoView({ behavior: 'smooth', block: 'center' });
        },
        clickMatch: function () {
            var match = document.querySelector('.search-match');
            if (match) match.click();
        }
    };
</script>