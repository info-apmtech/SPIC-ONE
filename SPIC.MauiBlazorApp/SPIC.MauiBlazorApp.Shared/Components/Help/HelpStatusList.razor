@* Every status a module's screens show, as its coloured tag with a one-line meaning. *@
@using SPIC.Core.Help

<div class="hc-stats">
    @foreach (var t in HelpBlocks.Statuses(Section, new List<string>()))
    {
        <div class="hc-sx"><span class="hc-tag" style="--c:@t.Color">@t.Label</span><span>@t.Text</span></div>
    }
</div>

@code {
    [Parameter, EditorRequired] public HelpSection Section { get; set; } = default!;
}
