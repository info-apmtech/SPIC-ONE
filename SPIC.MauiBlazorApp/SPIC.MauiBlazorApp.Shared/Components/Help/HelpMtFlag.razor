@* The translation note on a guide block: machine translated, or shown in English. *@
@if (View.MachineTranslated)
{
    <span class="hc-mt"><i class="bi bi-robot" aria-hidden="true"></i> Machine translated — a reviewer has not checked this yet</span>
}
else if (View.IsFallbackEnglish)
{
    <span class="hc-mt"><i class="bi bi-translate" aria-hidden="true"></i> Not yet translated — shown in English</span>
}

@code {
    [Parameter, EditorRequired] public HelpSectionView View { get; set; } = default!;
}
