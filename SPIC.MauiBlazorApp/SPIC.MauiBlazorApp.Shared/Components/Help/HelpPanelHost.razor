@* Renders the "?" help panel at the layout root, outside the top bar's stacking layer, so it sits
   above the phone tab bar. Opened and closed through HelpPanelState. *@
@implements IDisposable
@inject HelpPanelState Panel

@if (Panel.IsOpen)
{
    <HelpPanel OnClose="Panel.Close" />
}

@code {
    protected override void OnInitialized() => Panel.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Panel.Changed -= OnChanged;
}
