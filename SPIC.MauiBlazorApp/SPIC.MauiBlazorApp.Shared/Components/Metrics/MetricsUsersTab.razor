@namespace SPIC.MauiBlazorApp.Shared.Components.Metrics
@using SPIC.Core.DTOs
@using SPIC.Core.Entities
@implements IDisposable
@inject MetricsApi Metrics

@* Users tab: everyone seen in the period, last seen first (api/Metrics/users). Search + role filter. *@
<section class="mx-filters @(_filtersOpen ? "is-open" : "")">
    <button type="button" class="mx-filters-head" aria-controls="mx-user-filters" aria-expanded="@(_filtersOpen ? "true" : "false")"
            @onclick="() => _filtersOpen = !_filtersOpen">
        <span class="mx-filters-title"><i class="bi bi-funnel" aria-hidden="true"></i> Filters
            @if (FilterCount > 0)
            {
                <span class="mx-filters-badge">@FilterCount</span>
            }
        </span>
        <i class="bi bi-chevron-down mx-filters-chevron" aria-hidden="true"></i>
    </button>
    <div class="mx-filter-body" id="mx-user-filters">
        <div class="mx-field mx-field--grow">
            <label class="mx-label" for="mx-user-q">Search</label>
            <div class="mx-search">
                <i class="bi bi-search" aria-hidden="true"></i>
                <input id="mx-user-q" type="search" class="mx-search-input" placeholder="Name or user name"
                       value="@_q" @oninput="OnSearchInput" />
            </div>
        </div>
        <div class="mx-field">
            <label class="mx-label" for="mx-user-role">Role</label>
            <select id="mx-user-role" class="mx-input" value="@_role" @onchange="OnRoleChanged">
                <option value="">All roles</option>
                @foreach (var r in Roles)
                {
                    <option value="@r">@r</option>
                }
            </select>
        </div>
    </div>
</section>

<section class="mx-card" aria-labelledby="mx-users-title">
    <div class="mx-card-head">
        <h2 class="mx-card-title" id="mx-users-title">Users</h2>
        @if (_result is not null)
        {
            <span class="mx-muted">@MetricsText.Num(_result.Total) in the last @Days days</span>
        }
    </div>

    @if (_loading && _result is null)
    {
        <Skeleton Variant="table" Rows="6" />
    }
    else if (_result is null)
    {
        <EmptyState Icon="bi-cloud-slash" Title="The users could not be loaded" Message="Check the connection and try again." Compact="true">
            <button type="button" class="mx-btn mx-btn-outline" @onclick="LoadAsync">Try again</button>
        </EmptyState>
    }
    else if (_result.Items.Count == 0)
    {
        <EmptyState Icon="bi-people" Title="No users found"
                    Message="@(FilterCount > 0 ? "Nobody matches these filters." : "Nobody has used the apps in this period.")" Compact="true" />
    }
    else
    {
        <div class="mx-table-wrap tablet-up @(_loading ? "is-busy" : "")">
            <table class="mx-table">
                <thead>
                    <tr>
                        <th scope="col">User</th>
                        <th scope="col">Role</th>
                        <th scope="col">Last app</th>
                        <th scope="col">Last seen</th>
                        <th scope="col">Last page</th>
                        <th scope="col" class="num">Requests</th>
                        <th scope="col" class="num">Page views</th>
                        <th scope="col" class="num">Errors</th>
                        <th scope="col" class="num">Active days</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in _result.Items)
                    {
                        <tr>
                            <td class="wrap">
                                <span class="mx-strong">@(string.IsNullOrWhiteSpace(u.Name) ? u.UserName : u.Name)</span>
                                <span class="mx-sub">@u.UserName</span>
                            </td>
                            <td class="wrap">
                                <span>@MetricsText.Dash(u.Role)</span>
                                @if (!string.IsNullOrWhiteSpace(u.Designation))
                                {
                                    <span class="mx-sub">@u.Designation</span>
                                }
                            </td>
                            <td>
                                <LabPill Text="@MetricsText.AppName(u.LastApp)" Tone="@MetricsText.AppTone(u.LastApp)" />
                                @if (!string.IsNullOrWhiteSpace(u.LastAppVersion))
                                {
                                    <span class="mx-sub">v@(u.LastAppVersion)</span>
                                }
                            </td>
                            <td title="@MetricsText.Stamp(u.LastSeen)">@MetricsText.Ago(u.LastSeen)</td>
                            <td class="wrap mx-route">@MetricsText.Dash(u.LastRoute)</td>
                            <td class="num">@MetricsText.Num(u.Requests)</td>
                            <td class="num">@MetricsText.Num(u.PageViews)</td>
                            <td class="num @(u.Errors > 0 ? "mx-bad" : "")">@MetricsText.Num(u.Errors)</td>
                            <td class="num">@MetricsText.Num(u.ActiveDays)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mx-mcards phone-only">
            @foreach (var u in _result.Items)
            {
                <article class="mx-mcard">
                    <header class="mx-mcard-head">
                        <span class="mx-strong">@(string.IsNullOrWhiteSpace(u.Name) ? u.UserName : u.Name)</span>
                        <LabPill Text="@MetricsText.AppName(u.LastApp)" Tone="@MetricsText.AppTone(u.LastApp)" />
                    </header>
                    <p class="mx-mcard-sub">
                        <span>@u.UserName</span>
                        <span aria-hidden="true">&middot;</span>
                        <span>@MetricsText.Dash(u.Role)</span>
                        @if (!string.IsNullOrWhiteSpace(u.Designation))
                        {
                            <span aria-hidden="true">&middot;</span>
                            <span>@u.Designation</span>
                        }
                    </p>
                    <dl class="mx-mcard-nums">
                        <div><dt>Requests</dt><dd>@MetricsText.Num(u.Requests)</dd></div>
                        <div><dt>Views</dt><dd>@MetricsText.Num(u.PageViews)</dd></div>
                        <div><dt>Errors</dt><dd class="@(u.Errors > 0 ? "mx-bad" : "")">@MetricsText.Num(u.Errors)</dd></div>
                        <div><dt>Days</dt><dd>@MetricsText.Num(u.ActiveDays)</dd></div>
                    </dl>
                    <footer class="mx-mcard-foot">
                        <span>Seen @MetricsText.Ago(u.LastSeen)@(string.IsNullOrWhiteSpace(u.LastAppVersion) ? "" : $" · v{u.LastAppVersion}")</span>
                        <span class="mx-route">@MetricsText.Dash(u.LastRoute)</span>
                    </footer>
                </article>
            }
        </div>

        <LabPager Page="_page" PageSize="_pageSize" Total="_result.Total" Sizes="PageSizes"
                  PageChanged="GoToPageAsync" PageSizeChanged="ChangePageSizeAsync" />
    }
</section>

@code {
    private static readonly int[] PageSizes = { 20, 50, 100 };
    private static readonly string[] Roles = Enum.GetNames<AppRole>().OrderBy(r => r).ToArray();

    [Parameter] public int Days { get; set; } = 7;
    [Parameter] public TelemetryApp? App { get; set; }

    private PageResult<MetricsUserRowDto>? _result;
    private string _q = "";
    private string _role = "";
    private int _page = 1;
    private int _pageSize = 20;
    private bool _loading = true;
    private bool _filtersOpen;
    private int _version;
    private (int, TelemetryApp?)? _loadedFor;
    private System.Threading.Timer? _debounce;
    private readonly CancellationTokenSource _cts = new();

    private int FilterCount => (string.IsNullOrWhiteSpace(_q) ? 0 : 1) + (string.IsNullOrWhiteSpace(_role) ? 0 : 1);

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor == (Days, App)) return;
        _loadedFor = (Days, App);
        _page = 1;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var version = ++_version;
        _loading = true;
        StateHasChanged();

        var result = await Metrics.GetUsersAsync(Days, _q, _role, App, _page, _pageSize, _cts.Token);
        if (version != _version) return;
        _result = result;
        _loading = false;
        StateHasChanged();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _q = e.Value?.ToString() ?? "";
        _debounce?.Dispose();
        _debounce = new System.Threading.Timer(_ => InvokeAsync(async () =>
        {
            _page = 1;
            await LoadAsync();
        }), null, 350, Timeout.Infinite);
    }

    private async Task OnRoleChanged(ChangeEventArgs e)
    {
        _role = e.Value?.ToString() ?? "";
        _page = 1;
        await LoadAsync();
    }

    private async Task GoToPageAsync(int page)
    {
        _page = page;
        await LoadAsync();
    }

    private async Task ChangePageSizeAsync(int size)
    {
        _pageSize = size;
        _page = 1;
        await LoadAsync();
    }

    public void Dispose()
    {
        _debounce?.Dispose();
        _cts.Cancel();
    }
}
