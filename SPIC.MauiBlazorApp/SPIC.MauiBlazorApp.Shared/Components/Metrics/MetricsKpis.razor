@namespace SPIC.MauiBlazorApp.Shared.Components.Metrics
@using SPIC.Core.DTOs

@* The six Overview KPI cards (api/Metrics/summary). "–" while loading. *@
<div class="mx-kpis">
    <LabKpiCard Label="Active users today" Value="@MetricsText.Num(S?.ActiveUsersToday)"
                Caption="@($"{MetricsText.Num(S?.ActiveUsersPeriod)} in the last {Days} days")" Icon="bi-people" Tone="violet" />
    <LabKpiCard Label="Registered users" Value="@MetricsText.Num(S?.TotalUsers)"
                Caption="Active accounts" Icon="bi-person-check" Tone="green" />
    <LabKpiCard Label="API requests" Value="@MetricsText.Num(S?.RequestsPeriod)"
                Caption="@($"{MetricsText.Num(S?.RequestsToday)} today")" Icon="bi-arrow-left-right" Tone="blue" />
    <LabKpiCard Label="Page views" Value="@MetricsText.Num(S?.PageViewsPeriod)"
                Caption="@($"{MetricsText.Num(S?.PageViewsToday)} today")" Icon="bi-window-stack" Tone="teal" />
    <LabKpiCard Label="Errors" Value="@MetricsText.Num(S?.ErrorsPeriod)"
                Caption="@($"{MetricsText.Num(S?.OpenErrorGroups)} open groups")" Icon="bi-bug" Tone="red" />
    <LabKpiCard Label="P95 response" Value="@MetricsText.Ms(S?.P95DurationMsPeriod)"
                Caption="@($"Average {MetricsText.Ms(S?.AvgDurationMsPeriod)}")" Icon="bi-speedometer2" Tone="orange" />
</div>

@code {
    [Parameter] public MetricsSummaryDto? Summary { get; set; }
    [Parameter] public int Days { get; set; } = 7;

    private MetricsSummaryDto? S => Summary;
}
