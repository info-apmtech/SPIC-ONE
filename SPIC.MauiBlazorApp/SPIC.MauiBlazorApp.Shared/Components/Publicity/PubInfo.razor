@namespace SPIC.MauiBlazorApp.Shared.Components.Publicity
@* Icon tile + caption + value: the building block of every Publicity detail grid. *@
<div class="pub-info @CssClass">
    <span class="pub-info__icon pub-tint--@Tone"><i class="bi @Icon" aria-hidden="true"></i></span>
    <div class="pub-info__body">
        <span class="pub-info__label">@Label @if (!string.IsNullOrEmpty(Hint)) { <small>(@Hint)</small> }</span>
        @if (ChildContent is not null) { <span class="pub-info__value">@ChildContent</span> }
        else { <span class="pub-info__value">@(string.IsNullOrWhiteSpace(Value) ? "-" : Value) @if (!string.IsNullOrEmpty(Sub)) { <small>@Sub</small> }</span> }
    </div>
</div>
@code {
    [Parameter] public string Icon { get; set; } = "bi-file-earmark-text";
    [Parameter] public string Tone { get; set; } = "blue";
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Hint { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public string? Sub { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? CssClass { get; set; }
}
