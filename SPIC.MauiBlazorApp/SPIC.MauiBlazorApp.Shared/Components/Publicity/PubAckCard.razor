@namespace SPIC.MauiBlazorApp.Shared.Components.Publicity
@using SPIC.Core.DTOs
@* Acknowledgement summary of one dispatch (Figma "Acknowledgment Status"). *@
<section class="pub-card pub-card--flush @(Exception ? "pub-card--warn" : "")">
    <div class="pub-card__band @(Exception ? "pub-band--amber" : "pub-band--green")">
        <div>
            <h3 class="pub-h2 @(Exception ? "pub-text-amber" : "")">Acknowledgment Status @if (A is not null && A.ExceptionType != "None") { <PubPill Text="@A.ExceptionType" Tone="amber" /> }</h3>
            <span class="pub-muted">Received Quantity: @(A?.ReceivedQty.ToString() ?? "-") Nos &nbsp;|&nbsp; Shortage: @(A?.ShortageQty.ToString() ?? "-") Nos</span>
        </div>
        @Actions
    </div>
    <div class="pub-grid pub-grid--4">
        <PubInfo Label="Received Quantity" Value="@Qty(A?.ReceivedQty)" />
        <PubInfo Label="Condition" Tone="amber" Value="@(A is null ? null : A.IsDamaged ? $"Damaged ({A.DamagedQty} Nos)" : "Good")" />
        <PubInfo Label="Damaged Quantity" Value="@Qty(A?.DamagedQty)" />
        <PubInfo Label="@(A?.ExcessQty > 0 ? "Excess Quantity" : "Shortage Quantity")" Value="@Qty(A?.ExcessQty > 0 ? A.ExcessQty : A?.ShortageQty)" />
        <PubInfo Label="Acknowledged By" Tone="violet" Value="@A?.AcknowledgedByName" Sub="@(A is null ? null : "RMDO")" />
        <PubInfo Label="Acknowledged On" Value="@(A?.SubmittedAt is null ? null : PubText.DateTime(A.SubmittedAt))" />
        <div class="pub-grid__wide"><span class="pub-info__label">Remarks</span><b class="pub-info__value pub-info__value--sm">@(A?.Remarks ?? "-")</b></div>
    </div>
    @ChildContent
</section>
@code {
    [Parameter] public PubAckDto? A { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private bool Exception => A is not null && A.ExceptionType != "None";
    private static string? Qty(int? n) => n is null ? null : $"{n} Nos";
}
