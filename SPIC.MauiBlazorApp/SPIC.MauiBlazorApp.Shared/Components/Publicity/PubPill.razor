@namespace SPIC.MauiBlazorApp.Shared.Components.Publicity
@* Status / stage pill. Tone: grey, amber, green, cyan, red, orange, violet, blue. *@
<span class="pub-pill pub-pill--@Tone @CssClass">@Text</span>
@code {
    [Parameter] public string? Text { get; set; }
    [Parameter] public string Tone { get; set; } = "grey";
    [Parameter] public string? CssClass { get; set; }
}
