@namespace SPIC.MauiBlazorApp.Shared.Components.DataDisplay

@*
    EmptyState - centred icon + title + message, with an optional actions slot (ChildContent).

    <EmptyState Icon="bi-inbox" Title="No data found" Message="Add your first record to get started.">
        <button class="btn btn-primary">Add record</button>
    </EmptyState>
*@

<div class="spic-empty @(Compact ? "spic-empty--compact" : "")" role="status">
    @if (!string.IsNullOrWhiteSpace(Icon))
    {
        <div class="spic-empty-icon" aria-hidden="true">
            <i class="bi @Icon"></i>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Title))
    {
        <div class="spic-empty-title">@Title</div>
    }

    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <p class="spic-empty-msg">@Message</p>
    }

    @if (ChildContent != null)
    {
        <div class="spic-empty-actions">
            @ChildContent
        </div>
    }
</div>

@code {
    /// <summary>bootstrap-icons class without the leading "bi", e.g. "bi-inbox". Default "bi-inbox".</summary>
    [Parameter] public string Icon { get; set; } = "bi-inbox";

    [Parameter] public string Title { get; set; } = "Nothing here yet";

    [Parameter] public string? Message { get; set; }

    /// <summary>Optional actions (buttons, links) rendered under the message.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Smaller padding and icon, for use inside table cells or small panels.</summary>
    [Parameter] public bool Compact { get; set; }
}
