@namespace SPIC.MauiBlazorApp.Shared.Components.Shell

@*
    HubSection - a titled group of HubTile destinations on a hub page.

        <HubSection Title="Pending on you" Subtitle="Approvals waiting for your sign-off">
            <HubTile Label="Scheme Approval" ... />
        </HubSection>

    Phone: the body is a single column of full-width tile rows.
    Tablet: 2 columns. Desktop (>= 1200px): 3 columns.
    A HubNotice placed inside a section always spans the full width.
    Hub pages only render a section when it has at least one visible tile.
*@

<section class="hub-section @CssClass">
    <div class="hub-section-head">
        <h2 class="hub-section-title">@Title</h2>
        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <p class="hub-section-sub">@Subtitle</p>
        }
    </div>

    <div class="hub-section-body">
        @ChildContent
    </div>
</section>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    /// <summary>Optional one-line explanation under the section heading.</summary>
    [Parameter] public string? Subtitle { get; set; }

    /// <summary>The tiles (or a notice) belonging to this section.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Extra CSS classes for the section element.</summary>
    [Parameter] public string? CssClass { get; set; }
}
