@namespace SPIC.MauiBlazorApp.Shared.Components.Shell

@*
    HubNotice - an informational "coming soon" panel on a hub page: icon, title,
    message and an optional list of what the module will cover. It never links
    anywhere; it explains why a section has no destinations yet.

        <HubNotice Icon="bi-stars"
                   Title="Sales Activity System is on its way"
                   Message="Your field day will be recorded here."
                   Points="@(new[] { "Daily activity log", "Dealer visits" })" />
*@

<div class="hub-notice @CssClass" role="note">
    <div class="hub-notice-icon" aria-hidden="true">
        <i class="bi @Icon"></i>
    </div>

    <div class="hub-notice-body">
        <p class="hub-notice-title">@Title</p>

        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <p class="hub-notice-msg">@Message</p>
        }

        @if (Points is { Count: > 0 })
        {
            <ul class="hub-notice-list">
                @foreach (var point in Points)
                {
                    <li>@point</li>
                }
            </ul>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    /// <summary>Supporting sentence under the title.</summary>
    [Parameter] public string? Message { get; set; }

    /// <summary>Optional bullet points (what the module will cover).</summary>
    [Parameter] public IReadOnlyList<string>? Points { get; set; }

    /// <summary>bootstrap-icons class, e.g. "bi-stars".</summary>
    [Parameter] public string Icon { get; set; } = "bi-info-circle";

    /// <summary>Extra CSS classes for the panel.</summary>
    [Parameter] public string? CssClass { get; set; }
}
