@code {
    /* =========================================================
       SUBMENU OPEN FLAGS
       Seeded once from the current URL exactly as MainLayout did in its
       OnInitialized, then owned by the toggles below.
       ========================================================= */

    private bool isSettingsOpen = false;

    private bool isSdwaOpen = false;

    private bool isSubsidyOpen = false;

    private bool isMdPortalOpen = false;

    private bool isSchemesOpen = false;


    protected override void OnInitialized()
    {
        isSettingsOpen = IsSettingsSectionActive();
        isSdwaOpen = IsSdwaSectionActive();
        isSubsidyOpen = IsSubsidySectionActive();
        isMdPortalOpen = IsMdPortalSectionActive();
        isSchemesOpen = IsSchemesSectionActive();

        // The only outside state this menu reads is LoginState (role + allowed pages).
        // It is repopulated when a stored session is restored after a page refresh, so
        // refresh ourselves on that instead of being re-rendered by the layout.
        LoginState.OnChange += OnLoginStateChanged;
    }


    private void OnLoginStateChanged() => InvokeAsync(StateHasChanged);


    /* =========================================================
       SUBMENU TOGGLES
       ========================================================= */

    private void ToggleSettingsMenu()
    {
        if (!isSettingsOpen) { isSettingsOpen = true; isSdwaOpen = false; isSubsidyOpen = false; isMdPortalOpen = false; isSchemesOpen = false; }
        else isSettingsOpen = false;
    }


    private void ToggleSdwaMenu()
    {
        if (!isSdwaOpen) { isSdwaOpen = true; isSettingsOpen = false; isSubsidyOpen = false; isMdPortalOpen = false; isSchemesOpen = false; }
        else isSdwaOpen = false;
    }


    private void ToggleSubsidyMenu()
    {
        if (!isSubsidyOpen) { isSubsidyOpen = true; isSettingsOpen = false; isSdwaOpen = false; isMdPortalOpen = false; isSchemesOpen = false; }
        else isSubsidyOpen = false;
    }


    private void ToggleMdPortalMenu()
    {
        if (!isMdPortalOpen) { isMdPortalOpen = true; isSettingsOpen = false; isSdwaOpen = false; isSubsidyOpen = false; isSchemesOpen = false; }
        else isMdPortalOpen = false;
    }


    private void ToggleSchemesMenu()
    {
        if (!isSchemesOpen) { isSchemesOpen = true; isSettingsOpen = false; isSdwaOpen = false; isSubsidyOpen = false; isMdPortalOpen = false; }
        else isSchemesOpen = false;
    }


    /* =========================================================
       ACTIVE SECTION DETECTION
       ========================================================= */

    private bool IsSettingsSectionActive()
    {
        var uri =
            Navigation
                .ToBaseRelativePath(Navigation.Uri)
                .ToLower();

        return uri == "locationmaster"
            || uri == "agriculture"
            || uri == "logistics"
            || uri == "financial"
            || uri == "relationship"
            || uri == "designation";
    }


    private bool IsSdwaSectionActive()
    {
        var uri =
            Navigation
                .ToBaseRelativePath(Navigation.Uri)
                .ToLower();

        return uri == "sdwadashboard"
            || uri == "schemeapproval"
            || uri == "welfareschemes"
            || uri == "reportdashboard"
            || uri == "subdealeremployeemaster"
            || uri == "guesthousemaster"
            || uri == "sdwacompanymaster"
            || uri == "frontoffice"
            || uri == "generatebill";
    }


    private bool AnySubsidyAccessible =>
        LoginState.CanAccess(PagePermission.SalesReport)
        || LoginState.CanAccess(PagePermission.CompanySales)
        || LoginState.CanAccess(PagePermission.AgeingReport)
        || LoginState.CanAccess(PagePermission.Acknowledgement)
        || LoginState.CanAccess(PagePermission.LiquidationCycle)
        || LoginState.CanAccess(PagePermission.TopRankingDistrict)
        || LoginState.CanAccess(PagePermission.TopRankingWholesalers)
        || LoginState.CanAccess(PagePermission.TopRankingRetailers)
        || LoginState.CanAccess(PagePermission.ProductWiseStockAvailability)
        || LoginState.CanAccess(PagePermission.StockDetails);


    private bool IsSubsidySectionActive()
    {
        var uri =
            Navigation
                .ToBaseRelativePath(Navigation.Uri)
                .ToLower();

        return uri == "stockreport"
            || uri == "companysales"
            || uri == "ageingreport"
            || uri == "acknowledgement"
            || uri == "liquidationcycle"
            || uri == "toprankingdistrict"
            || uri == "toprankingwholesalers"
            || uri == "toprankingretailers"
            || uri == "productwisestockavailability"
            || uri == "stockdetails"
            || uri == "excelformatfileupload";
    }


    private bool AnyMdPortalAccessible =>
        LoginState.CanAccess(PagePermission.BudgetOverview)
        || LoginState.CanAccess(PagePermission.BudgetingManagements)
        || LoginState.CanAccess(PagePermission.BudgetSubmissions)
        || LoginState.CanAccess(PagePermission.CSR1Create)
        || LoginState.CanAccess(PagePermission.CSR1Management)
        || LoginState.CanAccess(PagePermission.CSR2)
        || LoginState.CanAccess(PagePermission.FinalReportCSRView)
        || LoginState.CanAccess(PagePermission.RMDValidationQueue)
        || LoginState.CanAccess(PagePermission.MOSubmissionValidation)
        || LoginState.CanAccess(PagePermission.RMApprovalStatus);


    private bool IsMdPortalSectionActive()
    {
        var uri =
            Navigation
                .ToBaseRelativePath(Navigation.Uri)
                .ToLower();

        return uri == "budgetoverview"
            || uri == "budgetingmanagements"
            || uri == "budgetsubmissions"
            || uri == "create-csr-1management"
            || uri == "csr-1list"
            || uri == "csr2"
            || uri == "finalreportcsrview"
            || uri == "rmdvalidationqueue"
            || uri == "mosubmissionvalidation"
            || uri == "rmapprovalstatus";
    }


    private bool AnySchemesAccessible =>
        LoginState.CanAccess(PagePermission.SchemeOverview)
        || LoginState.CanAccess(PagePermission.AddScheme)
        || LoginState.CanAccess(PagePermission.Schemes)
        || LoginState.CanAccess(PagePermission.WinnerPopUp)
        || LoginState.CanAccess(PagePermission.WinnerDetails)
        || LoginState.CanAccess(PagePermission.Luckydraw)
        || LoginState.CanAccess(PagePermission.LuckyDrawList)
        || LoginState.CanAccess(PagePermission.SelectPurchasedProducts)
        || LoginState.CanAccess(PagePermission.Scanproduct)
        || LoginState.CanAccess(PagePermission.QRScanner);


    private bool IsSchemesSectionActive()
    {
        var uri =
            Navigation
                .ToBaseRelativePath(Navigation.Uri)
                .ToLower();

        return uri == "schemeoverview"
            || uri == "addscheme"
            || uri == "schemes"
            || uri == "winnerpopup"
            || uri == "winnerdetails"
            || uri == "luckydraw"
            || uri == "luckydrawlist"
            || uri == "selectpurchasedproducts"
            || uri == "scanproduct"
            || uri == "qr-scanner";
    }


    public void Dispose()
    {
        LoginState.OnChange -= OnLoginStateChanged;
    }
}
