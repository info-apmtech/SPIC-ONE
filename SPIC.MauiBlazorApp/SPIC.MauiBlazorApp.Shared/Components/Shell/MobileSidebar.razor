@code {
    /* =========================================================
       SUBMENU OPEN FLAGS
       Seeded once from the current URL exactly as MainLayout did in its
       OnInitialized, then owned by the toggles below.
       ========================================================= */

    private bool isJmdoOpen = false;

    private bool isSettingsOpen = false;

    private bool isSdwaOpen = false;

    private bool isSubsidyOpen = false;

    private bool isMdPortalOpen = false;

    private bool isSchemesOpen = false;

    private bool isDemoDocumentationOpen = false;


    protected override void OnInitialized()
    {
        isJmdoOpen = IsJmdoSectionActive();
        isSettingsOpen = IsSettingsSectionActive();
        isSdwaOpen = IsSdwaSectionActive();
        isSubsidyOpen = IsSubsidySectionActive();
        isMdPortalOpen = IsMdPortalSectionActive();
        isSchemesOpen = IsSchemesSectionActive();

        // The only outside state this menu reads is LoginState (role + allowed pages).
        // It is repopulated when a stored session is restored after a page refresh, so
        // refresh ourselves on that instead of being re-rendered by the layout.
        LoginState.OnChange += OnLoginStateChanged;
    }


    private void OnLoginStateChanged() => InvokeAsync(StateHasChanged);


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Close the offcanvas when a real nav link is clicked, without touching
        // Blazor's own navigation handling at all:
        //   - data-bs-dismiss="offcanvas" on the links was tried first, but
        //     Bootstrap's dismiss handler calls event.preventDefault(), and
        //     Blazor's click-interception bails out of the SPA navigation
        //     whenever event.defaultPrevented is already true - so the sidebar
        //     closed but the page never changed.
        //   - Navigation.LocationChanged + JS interop was tried next, but it
        //     depends on Blazor Server's event-dispatch timing and never
        //     reliably fired the JS call.
        // A plain JS click listener scoped to #mobileSidebar sidesteps both:
        // it never calls preventDefault, so Blazor's own click-interception
        // still runs normally, and it does not depend on any C#/circuit
        // round-trip at all.
        try
        {
            await JS.InvokeVoidAsync("spic.initMobileSidebarAutoClose", "mobileSidebar");
        }
        catch (JSDisconnectedException) { }
    }


    /* =========================================================
       SUBMENU TOGGLES
       ========================================================= */

    private void ToggleJmdoMenu()
    {
        if (!isJmdoOpen) { isJmdoOpen = true; isSettingsOpen = false; isSdwaOpen = false; isSubsidyOpen = false; isMdPortalOpen = false; isSchemesOpen = false; isDemoDocumentationOpen = false; }
        else isJmdoOpen = false;
    }

    private void ToggleSettingsMenu()
    {
        if (!isSettingsOpen) { isSettingsOpen = true; isJmdoOpen = false; isSdwaOpen = false; isSubsidyOpen = false; isMdPortalOpen = false; isSchemesOpen = false; isDemoDocumentationOpen = false; }
        else isSettingsOpen = false;
    }


    private void ToggleSdwaMenu()
    {
        if (!isSdwaOpen) { isSdwaOpen = true; isJmdoOpen = false; isSettingsOpen = false; isSubsidyOpen = false; isMdPortalOpen = false; isSchemesOpen = false; isDemoDocumentationOpen = false; }
        else isSdwaOpen = false;
    }


    private void ToggleSubsidyMenu()
    {
        if (!isSubsidyOpen) { isSubsidyOpen = true; isJmdoOpen = false; isSettingsOpen = false; isSdwaOpen = false; isMdPortalOpen = false; isSchemesOpen = false; isDemoDocumentationOpen = false; }
        else isSubsidyOpen = false;
    }


    private void ToggleMdPortalMenu()
    {
        if (!isMdPortalOpen) { isMdPortalOpen = true; isJmdoOpen = false; isSettingsOpen = false; isSdwaOpen = false; isSubsidyOpen = false; isSchemesOpen = false; isDemoDocumentationOpen = false; }
        else isMdPortalOpen = false;
    }


    private void ToggleSchemesMenu()
    {
        if (!isSchemesOpen) { isSchemesOpen = true; isJmdoOpen = false; isSettingsOpen = false; isSdwaOpen = false; isSubsidyOpen = false; isMdPortalOpen = false; isDemoDocumentationOpen = false; }
        else isSchemesOpen = false;
    }

    private void ToggleDemoDocumentationMenu()
    {
        if (!isDemoDocumentationOpen) { isDemoDocumentationOpen = true; isJmdoOpen = false; isSettingsOpen = false; isSdwaOpen = false; isSubsidyOpen = false; isMdPortalOpen = false; isSchemesOpen = false; }
        else isDemoDocumentationOpen = false;
    }


    /* =========================================================
       ACTIVE SECTION DETECTION
       ========================================================= */

    // Demo documentation group: pure union of its seven children's CanSeeMenu - no role term, no
    // open-route term, nothing that can disagree with the entries rendered below. Route-level
    // access for these destinations stays PageGuard's decision and is not modelled here.
    private bool AnyDemoDocumentationAccessible =>
        LoginState.CanSeeMenu(PagePermission.DemoDocumentation)
        || LoginState.CanSeeMenu(PagePermission.StartDocumentation)
        || LoginState.CanSeeMenu(PagePermission.DemoDetails)
        || LoginState.CanSeeMenu(PagePermission.TreatmentDetails)
        || LoginState.CanSeeMenu(PagePermission.Treatment01)
        || LoginState.CanSeeMenu(PagePermission.TreatmentDemoDetails)
        || LoginState.CanSeeMenu(PagePermission.Treatment02);

    private bool AnyJmdoAccessible =>
        LoginState.CanSeeMenu(PagePermission.FieldDashboard)
        || LoginState.CanSeeMenu(PagePermission.FieldReports)
        || LoginState.CanSeeMenu(PagePermission.MdoDashboard)
        || LoginState.CanSeeMenu(PagePermission.AllocationRequests)
        || LoginState.CanSeeMenu(PagePermission.TaskMonitoring)
        || LoginState.CanSeeMenu(PagePermission.PerformanceTracker)
        || LoginState.CanSeeMenu(PagePermission.TargetAchievement)
        || LoginState.CanSeeMenu(PagePermission.FarmerData)
        || LoginState.CanSeeMenu(PagePermission.MdoReports);

    private bool IsJmdoSectionActive()
    {
        var uri =
            Navigation
                .ToBaseRelativePath(Navigation.Uri)
                .ToLower();

        return uri == "fielddashboard"
            || uri == "fieldreports"
            || uri == "mdodashboard"
            || uri == "allocationrequests"
            || uri == "taskmonitoring"
            || uri == "performancetracker"
            || uri == "targetachievement"
            || uri == "farmerdata"
            || uri == "mdoreports";
    }

    private bool IsSettingsSectionActive()
    {
        var uri =
            Navigation
                .ToBaseRelativePath(Navigation.Uri)
                .ToLower();

        return uri == "locationmaster"
            || uri == "agriculture"
            || uri == "logistics"
            || uri == "financial"
            || uri == "relationship"
            || uri == "designation"
            || uri == "metrics"
            // Same query-string form NavMenu matches, so /Metrics?mode=x lights up Settings here.
            || uri.StartsWith("metrics?");
    }


    private bool IsSdwaSectionActive()
    {
        var uri =
            Navigation
                .ToBaseRelativePath(Navigation.Uri)
                .ToLower();

        return uri == "sdwadashboard"
            || uri == "schemeapproval"
            || uri == "welfareschemes"
            || uri == "reportdashboard"
            || uri == "subdealeremployeemaster"
            || uri == "guesthousemaster"
            || uri == "sdwacompanymaster"
            // Guest House Cancellations is a child of this group but was missing from the
            // active-section list, so /GuestHouseCancellations left the SDWA group closed.
            || uri == "guesthousecancellations"
            || uri == "frontoffice"
            || uri == "generatebill";
