            || uri == "finalreportcsrview"
            || uri == "rmdvalidationqueue"
            || uri == "mosubmissionvalidation"
            || uri == "rmapprovalstatus"
            || uri == "programmaster";
    }


    private bool AnySchemesAccessible =>
        LoginState.CanSeeMenu(PagePermission.SchemeOverview)
        || LoginState.CanSeeMenu(PagePermission.AddScheme)
        || LoginState.CanSeeMenu(PagePermission.Schemes)
        || LoginState.CanSeeMenu(PagePermission.WinnerPopUp)
        || LoginState.CanSeeMenu(PagePermission.WinnerDetails)
        || LoginState.CanSeeMenu(PagePermission.Luckydraw)
        || LoginState.CanSeeMenu(PagePermission.LuckyDrawList)
        || LoginState.CanSeeMenu(PagePermission.SelectPurchasedProducts)
        || LoginState.CanSeeMenu(PagePermission.Scanproduct)
        || LoginState.CanSeeMenu(PagePermission.QRScanner);


    private bool IsSchemesSectionActive()
    {
        var uri =
            Navigation
                .ToBaseRelativePath(Navigation.Uri)
                .ToLower();

        return uri == "schemeoverview"
            || uri == "addscheme"
            || uri == "schemes"
            || uri == "winnerpopup"
            || uri == "winnerdetails"
            || uri == "luckydraw"
            || uri == "luckydrawlist"
            || uri == "selectpurchasedproducts"
            || uri == "scanproduct"
            || uri == "qr-scanner";
    }


    public void Dispose()
    {
        LoginState.OnChange -= OnLoginStateChanged;
    }
}

