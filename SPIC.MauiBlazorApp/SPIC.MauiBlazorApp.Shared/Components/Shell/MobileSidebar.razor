    private bool AnyMdPortalAccessible =>
        LoginState.CanSeeMenu(PagePermission.BudgetOverview)
        || LoginState.CanSeeMenu(PagePermission.BudgetingManagements)
        || LoginState.CanSeeMenu(PagePermission.BudgetSubmissions)
