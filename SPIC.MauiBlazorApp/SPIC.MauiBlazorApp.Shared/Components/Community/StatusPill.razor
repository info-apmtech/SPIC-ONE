@namespace SPIC.MauiBlazorApp.Shared.Components.Community
@using SPIC.MauiBlazorApp.Shared.Services

@* Discussion status pill: Open (blue), Waiting For Reply (amber), Expert Answer (green), Resolved (grey). *@
<span class="cm-status cm-status-@Status.ToString().ToLowerInvariant() @CssClass">@(Label ?? DefaultLabel)</span>

@code {
    [Parameter, EditorRequired] public DiscussionStatus Status { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? CssClass { get; set; }

    private string DefaultLabel => Status switch
    {
        DiscussionStatus.WaitingForReply => "Waiting For Reply",
        DiscussionStatus.ExpertAnswer => "Expert Answer",
        DiscussionStatus.Resolved => "Resolved",
        _ => "Open"
    };
}
