@namespace SPIC.MauiBlazorApp.Shared.Components.Community

@* Hashtag chip ("#Urea"): light blue tint, blue text. Optional remove button for editors. *@
<span class="cm-tag @CssClass">
    @if (ShowHash) { <span aria-hidden="true">#</span> }@Text
    @if (OnRemove.HasDelegate)
    {
        <button type="button" class="cm-tag-remove" aria-label="@($"Remove {Text}")" @onclick="() => OnRemove.InvokeAsync(Text)"><i class="bi bi-x"></i></button>
    }
</span>

@code {
    [Parameter, EditorRequired] public string Text { get; set; } = "";
    [Parameter] public bool ShowHash { get; set; } = true;
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public EventCallback<string> OnRemove { get; set; }
}
