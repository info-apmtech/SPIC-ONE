@namespace SPIC.MauiBlazorApp.Shared.Components.Lab.Entry

@*
    Page frame of the Lab Analyst pages (screens 13-19). Carries the shared look of those pages
    through ::deep rules in LabEntryFrame.razor.css, so each page's own scoped CSS only holds what
    is specific to it:

        la-btn (+ -primary / -outline / -soft / -blue / -icon), la-card (+ -head / -title / -sub),
        la-kpis (--la-kpi-cols), la-field / la-label / la-input / la-dates, la-table-wrap / la-table,
        la-rcards / la-rcard (phone cards), la-tiles / la-tile (label + value tiles), la-person,
        la-sub, la-code, la-note (amber) / la-banner (pink), la-search, la-icon-btn.

    <LabEntryFrame> ...page markup... </LabEntryFrame>
*@
<div class="la-page @CssClass">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? CssClass { get; set; }
}
