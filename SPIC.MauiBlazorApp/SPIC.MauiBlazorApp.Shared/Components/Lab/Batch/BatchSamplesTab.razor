@namespace SPIC.MauiBlazorApp.Shared.Components.Lab.Batch
@using SPIC.Core.DTOs
@using SPIC.Core.Entities
@using SPIC.MauiBlazorApp.Shared.Services
@inject LabApi Api
@inject IJSRuntime JS
@implements IDisposable

@*
    Batch Details, Samples tab (screen 6): three KPI cards (Total, Not Started, Completed with
    their share), the Samples List with search, All Statuses, All Types (Soil / Water / Soil &
    Water / Paid / Free), All Parameters (current parameter), Date Range (collected on) and Export
    (api/Lab/batches/{id}/samples/export in a new tab), progress bars and the pager.
    SampleHref (optional) makes each row open that sample (the analyst entry page).
*@
<div class="lf-kpis bs-kpis">
    <LabKpiCard Label="Total Samples" Value="@((_stats?.Total ?? 0).ToString())" Caption="100%" Icon="bi-eyedropper" Tone="violet" />
    <LabKpiCard Label="Not Started" Value="@((_stats?.NotStarted ?? 0).ToString())" Caption="@Share(_stats?.NotStarted)" Icon="bi-hourglass" Tone="pink" />
    <LabKpiCard Label="Completed" Value="@((_stats?.Completed ?? 0).ToString())" Caption="@Share(_stats?.Completed)" Icon="bi-check2-circle" Tone="green" />
</div>

<section class="lf-card" aria-labelledby="bs-title">
    <div class="lf-card-head">
        <h2 id="bs-title" class="lf-card-title">Samples List</h2>
        <div class="lf-toolbar">
            <LabSearch Value="@_q" ValueChanged="OnSearch" Placeholder="Search sample, farmer, crop..." AriaLabel="Search samples" />
            <select class="lf-select" aria-label="Status" value="@_status" @onchange="e => SetFilter(ref _status, e)">
                <option value="">All Statuses</option>
                @foreach (var s in LabText.SampleStatuses)
                {
                    <option value="@s">@LabText.SampleStatus(s)</option>
                }
            </select>
            <select class="lf-select" aria-label="Type" value="@_type" @onchange="e => SetFilter(ref _type, e)">
                <option value="">All Types</option>
                <option value="Soil">Soil</option>
                <option value="Water">Water</option>
                <option value="SoilAndWater">Soil &amp; Water</option>
                <option value="Paid">Paid</option>
                <option value="Free">Free</option>
            </select>
            <select class="lf-select" aria-label="Parameter" value="@_parameter" @onchange="e => SetFilter(ref _parameter, e)">
                <option value="">All Parameters</option>
                @foreach (var p in _parameterOptions)
                {
                    <option value="@p.Code">@p.Name</option>
                }
            </select>
            <LabDateRange From="_from" To="_to" Changed="OnDates" />
            <button type="button" class="lf-btn lf-btn--outline" @onclick="ExportAsync">
                <i class="bi bi-download" aria-hidden="true"></i> Export
            </button>
        </div>
    </div>

    @if (_loading)
    {
        <Skeleton Variant="table" Rows="6" />
    }
    else if (_rows.Count == 0)
    {
        <EmptyState Icon="bi-eyedropper" Title="No samples found" Message="@(_failed ? "The samples could not be loaded." : "Try another filter or search term.")" />
    }
    else
    {
        <div class="lf-table-wrap tablet-up">
            <table class="lf-table">
                <thead>
                    <tr>
                        <th scope="col">Sample ID</th>
                        <th scope="col">Sample Code</th>
                        <th scope="col">Sample Type</th>
                        <th scope="col">Soil Samples</th>
                        <th scope="col">Water Samples</th>
                        <th scope="col">Farmer</th>
                        <th scope="col">Parameter</th>
                        <th scope="col">Status</th>
                        <th scope="col">Progress</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in _rows)
                    {
                        var href = SampleHref?.Invoke(s);
                        <tr @key="s.SampleItemId">
                            <td>
                                @if (href is not null)
                                {
                                    <a class="lf-link" href="@href">@s.SampleId</a>
                                }
                                else
                                {
                                    <span class="lf-strong">@s.SampleId</span>
                                }
                            </td>
                            <td>@s.SampleCode</td>
                            <td><LabPill Text="@LabText.PaymentType(s.PaymentType)" Tone="@LabText.PaymentTone(s.PaymentType)" /></td>
                            <td>@LabText.SoilCount(s.SampleType)</td>
                            <td>@LabText.WaterCount(s.SampleType)</td>
                            <td>@s.FarmerName<span class="lf-sub">@LabText.Dash(s.Crop) · @LabText.Dash(s.Village)</span></td>
                            <td>@LabText.Dash(s.CurrentParameter)<span class="lf-sub">@s.EnteredCount / @s.ParameterCount entered</span></td>
                            <td><LabPill Text="@LabText.SampleStatus(s.Status)" Tone="@LabPill.ToneFor(s.Status)" /></td>
                            <td><LabProgress Percent="s.ProgressPercent" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="lf-cards phone-only">
            @foreach (var s in _rows)
            {
                var href = SampleHref?.Invoke(s);
                <article class="lf-rowcard" @key="@($"m{s.SampleItemId}")">
                    <div class="lf-rowcard-top">
                        @if (href is not null)
                        {
                            <a class="lf-link" href="@href">@s.SampleId</a>
                        }
                        else
                        {
                            <span class="lf-strong">@s.SampleId</span>
                        }
                        <LabPill Text="@LabText.SampleStatus(s.Status)" Tone="@LabPill.ToneFor(s.Status)" />
                    </div>
                    <dl class="lf-facts">
                        <dt>Sample Code</dt><dd>@s.SampleCode</dd>
                        <dt>Type</dt><dd>@LabText.SampleType(s.SampleType) · @LabText.PaymentType(s.PaymentType)</dd>
                        <dt>Farmer</dt><dd>@s.FarmerName</dd>
                        <dt>Parameter</dt><dd>@LabText.Dash(s.CurrentParameter) (@s.EnteredCount/@s.ParameterCount)</dd>
                    </dl>
                    <div class="bs-progress"><LabProgress Percent="s.ProgressPercent" /></div>
                </article>
            }
        </div>

        <LabPager Page="_page" PageSize="_size" Total="_total" PageChanged="GoToPage" PageSizeChanged="SetSize" />
    }
</section>

@code {
    [Parameter, EditorRequired] public int BatchId { get; set; }
    /// <summary>Optional link for a sample row (e.g. the analyst's entry page); null = plain text.</summary>
    [Parameter] public Func<LabSampleRowDto, string?>? SampleHref { get; set; }

    private LabSampleStatsDto? _stats;
    private List<LabSampleRowDto> _rows = new();
    private List<(string Code, string Name)> _parameterOptions = new();
    private string _status = "";
    private string _type = "";
    private string _parameter = "";
    private string? _q;
    private DateTime? _from;
    private DateTime? _to;
    private int _page = 1;
    private int _size = LabApi.DefaultPageSize;
    private int _total;
    private bool _loading = true;
    private bool _failed;
    private int _loadedFor = -1;
    private CancellationTokenSource? _cts;

    private string Share(int? part) => $"{LabText.Percent(part ?? 0, _stats?.Total ?? 0)}%";

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor == BatchId) return;
        _loadedFor = BatchId;

        var stats = Api.GetSampleStatsAsync(BatchId);
        var options = LoadParameterOptionsAsync();
        await LoadAsync();
        _stats = await stats;
        await options;
    }

    private async Task LoadParameterOptionsAsync()
    {
        var page = await Api.GetParametersAsync(BatchId, pageSize: 50);
        _parameterOptions = (page?.Items ?? new())
            .SelectMany(s => s.Parameters)
            .GroupBy(p => p.Code)
            .Select(g => (g.Key, g.First().Name))
            .OrderBy(p => p.Item2)
            .ToList();
    }

    private async Task LoadAsync()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        var ct = _cts.Token;

        _loading = true;
        StateHasChanged();
        var page = await Api.GetSamplesAsync(BatchId, status: _status, sampleType: _type, parameter: _parameter, q: _q,
            from: _from, to: _to, page: _page, pageSize: _size, ct: ct);
        if (ct.IsCancellationRequested) return;
        _failed = page is null;
        _rows = page?.Items ?? new();
        _total = page?.Total ?? 0;
        _loading = false;
    }

    private Task SetFilter(ref string field, ChangeEventArgs e)
    {
        field = e.Value?.ToString() ?? "";
        _page = 1;
        return LoadAsync();
    }

    private Task OnSearch(string? q)
    {
        _q = q;
        _page = 1;
        return LoadAsync();
    }

    private Task OnDates((DateTime? From, DateTime? To) range)
    {
        (_from, _to) = range;
        _page = 1;
        return LoadAsync();
    }

    private Task GoToPage(int page)
    {
        _page = page;
        return LoadAsync();
    }

    private Task SetSize(int size)
    {
        _size = size;
        _page = 1;
        return LoadAsync();
    }

    private async Task ExportAsync()
    {
        var url = Api.SamplesExportUrl(BatchId, _status, _type, _parameter, _q);
        try { await JS.InvokeVoidAsync("open", url, "_blank"); }
        catch (Exception) { /* pop-up blocked / circuit gone: nothing else to do */ }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
