@namespace SPIC.MauiBlazorApp.Shared.Components.Lab.Batch

@*
    Lab dialog: the shell BottomSheet (swipe, Escape, hardware back, safe areas) on phones, and a
    centred modal on tablet and desktop (the v1 dialog look) instead of the sheet's right drawer.
    Width = the modal width on tablet / desktop (px).

        <LabDialog @bind-IsOpen="_open" Title="Create Batch" Width="640">
            <ChildContent>...</ChildContent>
            <Footer>...</Footer>
        </LabDialog>
*@
<div class="lab-dlg-host" style="--lab-dlg-w:@(Width)px">
    <BottomSheet IsOpen="IsOpen" IsOpenChanged="IsOpenChanged" Title="@Title" Subtitle="@Subtitle"
                 Size="Size" CloseOnBackdrop="CloseOnBackdrop" ShowCloseButton="ShowCloseButton"
                 CssClass="@($"lab-dlg {CssClass}")" Footer="Footer" OnClosed="OnClosed">
        @ChildContent
    </BottomSheet>
</div>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter] public int Width { get; set; } = 560;
    [Parameter] public BottomSheet.SheetSize Size { get; set; } = BottomSheet.SheetSize.Auto;
    [Parameter] public bool CloseOnBackdrop { get; set; } = true;
    [Parameter] public bool ShowCloseButton { get; set; } = true;
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public EventCallback<BottomSheet.CloseReason> OnClosed { get; set; }
}
