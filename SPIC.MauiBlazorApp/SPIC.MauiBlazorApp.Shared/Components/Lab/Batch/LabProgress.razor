@namespace SPIC.MauiBlazorApp.Shared.Components.Lab.Batch

@* Thin progress bar with the percentage on the right (Samples lists). *@
<span class="lf-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@Clamped" aria-label="@($"{Clamped}% complete")">
    <span class="lf-progress-bar"><span style="width:@(Clamped)%;background:@Colour"></span></span>
    <span class="lf-progress-num">@Clamped%</span>
</span>

@code {
    [Parameter] public int Percent { get; set; }

    private int Clamped => Math.Clamp(Percent, 0, 100);

    private string Colour => Clamped >= 100 ? "#1f9d55" : Clamped > 0 ? "#6f5bd6" : "#d0d5dd";
}
