@namespace SPIC.MauiBlazorApp.Shared.Components.Lab.Batch
@using SPIC.Core.DTOs
@using SPIC.Core.Entities
@using SPIC.MauiBlazorApp.Shared.Services
@inject LabApi Api
@inject IJSRuntime JS
@implements IDisposable

@*
    Batch Details, Parameters tab (screen 12 with the product owner's correction): one expandable
    row per SAMPLE, one sample open at a time; the open sample lists its parameter rows (code,
    name, unit, reporting limit, entered value, result word, status). KPI cards count parameter
    rows across the whole batch. Filters: search (sample / farmer), All Statuses and All
    Parameters (applied to the parameter rows), All Types (sample type or Paid / Free); Export
    downloads api/Lab/batches/{id}/parameters/export.
*@
<div class="lf-kpis">
    <LabKpiCard Label="Total Parameters" Value="@((_stats?.TotalParameters ?? 0).ToString())" Caption="Across all samples" Icon="bi-list-check" Tone="violet" />
    <LabKpiCard Label="Completed" Value="@((_stats?.Completed ?? 0).ToString())" Caption="@Share(_stats?.Completed)" Icon="bi-check2-circle" Tone="green" />
    <LabKpiCard Label="Not Started" Value="@((_stats?.NotStarted ?? 0).ToString())" Caption="@Share(_stats?.NotStarted)" Icon="bi-hourglass" Tone="pink" />
</div>

<section class="lf-card" aria-labelledby="bp-title">
    <div class="lf-card-head">
        <div>
            <h2 id="bp-title" class="lf-card-title">Parameters List</h2>
            <p class="lf-card-sub">Parameters are listed per sample; open a sample to see its values.</p>
        </div>
        <div class="lf-toolbar">
            <LabSearch Value="@_q" ValueChanged="OnSearch" Placeholder="Search sample or farmer..." AriaLabel="Search samples" />
            <select class="lf-select" aria-label="Status" value="@_status" @onchange="e => SetFilter(ref _status, e)">
                <option value="">All Statuses</option>
                @foreach (var s in LabText.SampleStatuses)
                {
                    <option value="@s">@LabText.SampleStatus(s)</option>
                }
            </select>
            <select class="lf-select" aria-label="Type" value="@_type" @onchange="e => SetFilter(ref _type, e)">
                <option value="">All Types</option>
                <option value="Soil">Soil</option>
                <option value="Water">Water</option>
                <option value="SoilAndWater">Soil &amp; Water</option>
                <option value="Paid">Paid</option>
                <option value="Free">Free</option>
            </select>
            <select class="lf-select" aria-label="Parameter" value="@_parameter" @onchange="e => SetFilter(ref _parameter, e)">
                <option value="">All Parameters</option>
                @foreach (var p in _parameterOptions)
                {
                    <option value="@p.Code">@p.Name</option>
                }
            </select>
            <button type="button" class="lf-btn lf-btn--outline" @onclick="ExportAsync">
                <i class="bi bi-download" aria-hidden="true"></i> Export
            </button>
        </div>
    </div>

    @if (_loading)
    {
        <Skeleton Variant="table" Rows="6" />
    }
    else if (_rows.Count == 0)
    {
        <EmptyState Icon="bi-list-check" Title="No parameters found" Message="@(_failed ? "The parameters could not be loaded." : "Try another filter or search term.")" />
    }
    else
    {
        <ul class="bp-list" role="list">
            @foreach (var item in _rows)
            {
                var s = item.Sample;
                var open = _open == s.SampleItemId;
                var id = s.SampleItemId;
                <li class="bp-sample @(open ? "is-open" : "")" @key="id">
                    <button type="button" class="bp-head" aria-expanded="@(open ? "true" : "false")" aria-controls="@($"bp-rows-{id}")"
                            @onclick="() => Toggle(id)">
                        <i class="bi @(open ? "bi-chevron-down" : "bi-chevron-right") bp-chevron" aria-hidden="true"></i>
                        <span class="bp-head-main">
                            <span class="bp-id">@s.SampleId <span class="bp-code">@s.SampleCode</span></span>
                            <span class="bp-meta">@LabText.SampleType(s.SampleType) · @LabText.PaymentType(s.PaymentType) · @s.FarmerName</span>
                        </span>
                        <span class="bp-count">@item.Parameters.Count(p => p.RowStatus == SampleAnalysisStatus.Completed)/@item.Parameters.Count</span>
                        <span class="bp-status"><LabPill Text="@LabText.SampleStatus(s.Status)" Tone="@LabPill.ToneFor(s.Status)" /></span>
                        <span class="bp-bar tablet-up"><LabProgress Percent="s.ProgressPercent" /></span>
                    </button>

                    @if (open)
                    {
                        <div id="@($"bp-rows-{id}")" class="bp-rows">
                            <div class="lf-table-wrap tablet-up">
                                <table class="lf-table bp-table">
                                    <thead>
                                        <tr>
                                            <th scope="col">Parameter Code</th>
                                            <th scope="col">Parameter Name</th>
                                            <th scope="col">Unit</th>
                                            <th scope="col">Reporting Limit</th>
                                            <th scope="col">Normal Range</th>
                                            <th scope="col">Entered Value</th>
                                            <th scope="col">Result</th>
                                            <th scope="col">Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var p in item.Parameters)
                                        {
                                            <tr @key="p.LabParameterId">
                                                <td class="lf-strong">@p.Code</td>
                                                <td>@p.Name</td>
                                                <td>@LabText.Dash(p.Unit)</td>
                                                <td>@LabText.Dash(p.ReportingLimit)</td>
                                                <td>@LabText.Dash(p.NormalRange)</td>
                                                <td>@LabText.Dash(p.EnteredValue)</td>
                                                <td>
                                                    @if (p.Status is { } rs)
                                                    {
                                                        <LabPill Text="@(p.ResultLabel ?? rs.ToString())" Tone="@LabPill.ToneFor(rs)" />
                                                    }
                                                    else
                                                    {
                                                        @LabText.Dash(p.ResultLabel)
                                                    }
                                                </td>
                                                <td><LabPill Text="@LabText.SampleStatus(p.RowStatus)" Tone="@LabPill.ToneFor(p.RowStatus)" /></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <div class="bp-cards phone-only">
                                @foreach (var p in item.Parameters)
                                {
                                    <div class="bp-param" @key="@($"m{p.LabParameterId}")">
                                        <div class="bp-param-top">
                                            <span><span class="lf-strong">@p.Name</span> <span class="lf-muted">@p.Code</span></span>
                                            <LabPill Text="@LabText.SampleStatus(p.RowStatus)" Tone="@LabPill.ToneFor(p.RowStatus)" />
                                        </div>
                                        <div class="bp-param-values">
                                            <span>Value: <strong>@LabText.Dash(p.EnteredValue)</strong> @p.Unit</span>
                                            @if (p.Status is { } rs)
                                            {
                                                <LabPill Text="@(p.ResultLabel ?? rs.ToString())" Tone="@LabPill.ToneFor(rs)" />
                                            }
                                        </div>
                                        <span class="lf-sub">Limit @LabText.Dash(p.ReportingLimit) · Range @LabText.Dash(p.NormalRange)</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </li>
            }
        </ul>

        <LabPager Page="_page" PageSize="_size" Total="_total" PageChanged="GoToPage" PageSizeChanged="SetSize" />
    }
</section>

@code {
    [Parameter, EditorRequired] public int BatchId { get; set; }

    private LabParameterStatsDto? _stats;
    private List<LabSampleParametersDto> _rows = new();
    private List<(string Code, string Name)> _parameterOptions = new();
    private string _status = "";
    private string _type = "";
    private string _parameter = "";
    private string? _q;
    private int _page = 1;
    private int _size = 8;
    private int _total;
    private int? _open;
    private bool _loading = true;
    private bool _failed;
    private bool _optionsLoaded;
    private int _loadedFor = -1;
    private CancellationTokenSource? _cts;

    private string Share(int? part) => $"{LabText.Percent(part ?? 0, _stats?.TotalParameters ?? 0)}%";

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor == BatchId) return;
        _loadedFor = BatchId;
        _optionsLoaded = false;

        var stats = Api.GetParameterStatsAsync(BatchId);
        await LoadAsync();
        _stats = await stats;
    }

    private async Task LoadAsync()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        var ct = _cts.Token;

        _loading = true;
        StateHasChanged();
        var page = await Api.GetParametersAsync(BatchId, status: _status, sampleType: _type, parameter: _parameter, q: _q,
            page: _page, pageSize: _size, ct: ct);
        if (ct.IsCancellationRequested) return;

        _failed = page is null;
        _rows = page?.Items ?? new();
        _total = page?.Total ?? 0;
        if (_open is null || _rows.All(r => r.Sample.SampleItemId != _open)) _open = _rows.FirstOrDefault()?.Sample.SampleItemId;
        _loading = false;

        if (!_optionsLoaded && page is not null)
        {
            // The unfiltered first page names the parameters in use (all samples of one type share them).
            _optionsLoaded = true;
            var all = _rows.Count == _total ? _rows : (await Api.GetParametersAsync(BatchId, pageSize: 50))?.Items ?? _rows;
            _parameterOptions = all.SelectMany(s => s.Parameters)
                .GroupBy(p => p.Code)
                .Select(g => (g.Key, g.First().Name))
                .OrderBy(p => p.Item2)
                .ToList();
        }
    }

    private void Toggle(int id) => _open = _open == id ? null : id;

    private Task SetFilter(ref string field, ChangeEventArgs e)
    {
        field = e.Value?.ToString() ?? "";
        _page = 1;
        return LoadAsync();
    }

    private Task OnSearch(string? q)
    {
        _q = q;
        _page = 1;
        return LoadAsync();
    }

    private Task GoToPage(int page)
    {
        _page = page;
        _open = null;
        return LoadAsync();
    }

    private Task SetSize(int size)
    {
        _size = size;
        _page = 1;
        return LoadAsync();
    }

    private async Task ExportAsync()
    {
        try { await JS.InvokeVoidAsync("open", Api.ParametersExportUrl(BatchId), "_blank"); }
        catch (Exception) { /* pop-up blocked / circuit gone */ }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
