@namespace SPIC.MauiBlazorApp.Shared.Components.Lab.Batch

@*
    Page frame for the lab portal pages. It carries the shared lab look (cards, toolbars, tables,
    phone row cards, tabs, forms, buttons) as ::deep rules in LabFrame.razor.css, so every lab
    page and dialog rendered inside it uses the same class vocabulary (lf-*) without repeating
    the CSS per page. Page-specific rules stay in each page's own scoped stylesheet.

        <LabFrame>
            <PageHeader Title="..." />
            <section class="lf-card">...</section>
        </LabFrame>
*@
<div class="lf @CssClass">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? CssClass { get; set; }
}
