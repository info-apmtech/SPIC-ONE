@namespace SPIC.MauiBlazorApp.Shared.Components.Lab

@* Rounded status pill. Tone: green | orange | red | violet | blue | teal | pink | yellow | grey *@
<span class="lab-pill lab-pill--@Tone @CssClass">@Text</span>

@code {
    [Parameter, EditorRequired] public string Text { get; set; } = "";
    [Parameter] public string Tone { get; set; } = "grey";
    [Parameter] public string? CssClass { get; set; }

    /// <summary>Tone for a batch status (coordinator and analyst wording share the colours).</summary>
    public static string ToneFor(SPIC.Core.Entities.SampleBatchStatus s) => s switch
    {
        SPIC.Core.Entities.SampleBatchStatus.Created => "green",
        SPIC.Core.Entities.SampleBatchStatus.TakenForAnalysis => "orange",
        SPIC.Core.Entities.SampleBatchStatus.InProgress => "violet",
        SPIC.Core.Entities.SampleBatchStatus.AnalysisCompleted => "blue",
        SPIC.Core.Entities.SampleBatchStatus.Completed => "teal",
        _ => "grey"
    };

    public static string ToneFor(SPIC.Core.Entities.SampleAnalysisStatus s) => s switch
    {
        SPIC.Core.Entities.SampleAnalysisStatus.NotStarted => "pink",
        SPIC.Core.Entities.SampleAnalysisStatus.InProgress => "violet",
        SPIC.Core.Entities.SampleAnalysisStatus.Completed => "green",
        _ => "grey"
    };

    public static string ToneFor(SPIC.Core.Entities.SampleBatchPriority p) => p switch
    {
        SPIC.Core.Entities.SampleBatchPriority.High => "red",
        SPIC.Core.Entities.SampleBatchPriority.Medium => "orange",
        _ => "green"
    };

    public static string ToneFor(SPIC.Core.Entities.LabResultStatus s) => s switch
    {
        SPIC.Core.Entities.LabResultStatus.Normal => "green",
        SPIC.Core.Entities.LabResultStatus.Deficient => "red",
        SPIC.Core.Entities.LabResultStatus.Moderate => "blue",
        SPIC.Core.Entities.LabResultStatus.Excess => "pink",
        _ => "grey"
    };
}
