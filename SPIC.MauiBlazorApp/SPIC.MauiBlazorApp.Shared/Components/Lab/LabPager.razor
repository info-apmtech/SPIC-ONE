@namespace SPIC.MauiBlazorApp.Shared.Components.Lab

@*
    "Items Per Page [16 v]" on the left, "< 1 2 3 .. 8 9 10 >" on the right (Figma). Emits the
    new page / page size; the parent reloads. On phones the two groups stack.
*@
<div class="lab-pager @CssClass">
    <label class="lab-pager-size">
        <span>Items Per Page</span>
        <select class="form-select" value="@PageSize" @onchange="OnSizeChanged" aria-label="Items per page">
            @foreach (var s in Sizes)
            {
                <option value="@s">@s</option>
            }
        </select>
    </label>

    <nav class="lab-pager-pages" aria-label="Pages">
        <button type="button" class="lab-pager-btn" disabled="@(Page <= 1)" @onclick="() => Go(Page - 1)" aria-label="Previous page">
            <i class="bi bi-chevron-left" aria-hidden="true"></i>
        </button>
        @foreach (var p in Visible())
        {
            @if (p == 0)
            {
                <span class="lab-pager-gap">..</span>
            }
            else
            {
                <button type="button" class="lab-pager-btn @(p == Page ? "is-active" : "")" @onclick="() => Go(p)" aria-current="@(p == Page ? "page" : null)">@p</button>
            }
        }
        <button type="button" class="lab-pager-btn" disabled="@(Page >= TotalPages)" @onclick="() => Go(Page + 1)" aria-label="Next page">
            <i class="bi bi-chevron-right" aria-hidden="true"></i>
        </button>
    </nav>
</div>

@code {
    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public int PageSize { get; set; } = 16;
    [Parameter] public int Total { get; set; }
    [Parameter] public int[] Sizes { get; set; } = new[] { 8, 16, 32, 50 };
    [Parameter] public EventCallback<int> PageChanged { get; set; }
    [Parameter] public EventCallback<int> PageSizeChanged { get; set; }
    [Parameter] public string? CssClass { get; set; }

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(Total / (double)Math.Max(1, PageSize)));

    private IEnumerable<int> Visible()
    {
        var n = TotalPages;
        if (n <= 7)
        {
            for (var i = 1; i <= n; i++) yield return i;
            yield break;
        }
        // first three, gap, last three, with the current page always shown
        var set = new SortedSet<int> { 1, 2, 3, n - 2, n - 1, n, Page };
        if (Page > 1) set.Add(Page - 1);
        if (Page < n) set.Add(Page + 1);
        var prev = 0;
        foreach (var p in set)
        {
            if (p < 1 || p > n) continue;
            if (prev != 0 && p > prev + 1) yield return 0;
            yield return p;
            prev = p;
        }
    }

    private Task Go(int p)
    {
        if (p < 1 || p > TotalPages || p == Page) return Task.CompletedTask;
        return PageChanged.InvokeAsync(p);
    }

    private async Task OnSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size) && size > 0 && size != PageSize)
        {
            await PageSizeChanged.InvokeAsync(size);
        }
    }
}
