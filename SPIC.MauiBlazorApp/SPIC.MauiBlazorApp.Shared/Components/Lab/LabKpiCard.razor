@namespace SPIC.MauiBlazorApp.Shared.Components.Lab

@*
    KPI card used across the lab portal (Figma: tinted card, coloured left border, label, big
    number, optional caption, icon in a white square on the right; the "icon above" variant is
    IconAbove=true). Tone picks the tint: violet, orange, green, pink, blue, yellow, red, teal.
*@
<div class="lab-kpi lab-kpi--@Tone @(IconAbove ? "lab-kpi--stacked" : "") @CssClass" role="group" aria-label="@Label">
    @if (IconAbove)
    {
        <span class="lab-kpi-icon" aria-hidden="true"><i class="bi @Icon"></i></span>
        <span class="lab-kpi-label">@Label</span>
        <span class="lab-kpi-value">@Value</span>
    }
    else
    {
        <div class="lab-kpi-text">
            <span class="lab-kpi-label">@Label</span>
            <span class="lab-kpi-value">@Value</span>
            @if (!string.IsNullOrWhiteSpace(Caption))
            {
                <span class="lab-kpi-caption">@Caption</span>
            }
        </div>
        <span class="lab-kpi-icon" aria-hidden="true"><i class="bi @Icon"></i></span>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string Value { get; set; } = "0";
    [Parameter] public string? Caption { get; set; }
    [Parameter] public string Icon { get; set; } = "bi-clipboard-data";
    /// <summary>violet | orange | green | pink | blue | yellow | red | teal</summary>
    [Parameter] public string Tone { get; set; } = "violet";
    [Parameter] public bool IconAbove { get; set; }
    [Parameter] public string? CssClass { get; set; }
}
