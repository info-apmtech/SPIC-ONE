@namespace SPIC.MauiBlazorApp.Shared.Components.FarmerPortal

@*
    FpStatus - nutrient / value status pill: Low (red), Medium (green), High (violet), grey "Not set".
        <FpStatus Level="FpLevel.Low" />   <FpStatus Level="@level" Text="Deficient" Large="true" />
*@

<span class="fp-status fp-status--@FpUi.LevelCss(Level) @(Large ? "fp-status--lg" : null) @CssClass">@(Text ?? FpUi.LevelLabel(Level))</span>

@code {
    [Parameter] public FpLevel Level { get; set; }

    /// <summary>Overrides the default "Low" / "Medium" / "High" / "Not set".</summary>
    [Parameter] public string? Text { get; set; }

    [Parameter] public bool Large { get; set; }

    [Parameter] public string? CssClass { get; set; }
}
