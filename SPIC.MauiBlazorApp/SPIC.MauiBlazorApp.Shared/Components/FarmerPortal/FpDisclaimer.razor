@namespace SPIC.MauiBlazorApp.Shared.Components.FarmerPortal

@*
    FpDisclaimer - small info strip under every estimate or AI answer.
        <FpDisclaimer Text="This is an estimate. Check with your SPIC field officer before you buy." />
*@

<p class="fp-disclaimer @CssClass" role="note">
    <i class="bi @Icon" aria-hidden="true"></i>
    <span>@(ChildContent ?? (b => b.AddContent(0, Text)))</span>
</p>

@code {
    [Parameter] public string? Text { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public string Icon { get; set; } = "bi-info-circle";

    [Parameter] public string? CssClass { get; set; }
}
