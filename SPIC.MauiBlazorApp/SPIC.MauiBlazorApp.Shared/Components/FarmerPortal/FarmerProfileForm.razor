@namespace SPIC.MauiBlazorApp.Shared.Components.FarmerPortal
@using System.Globalization
@using SPIC.Core.DTOs
@using SPIC.Core.Entities
@using SPIC.Core.FarmerPortal
@inject FarmerApi Api
@inject IJSRuntime JS

@*
    The farmer profile form, shared by /farmer/onboarding (first time) and /farmer/profile (edit).

        <FarmerProfileForm Initial="@Session.Profile" Phone="@Session.Phone" SubmitLabel="Save" OnSaved="Saved" />
        <FarmerProfileForm Stepped="true" ... />   one group per step (About you, Your farm, Your village)

    Required: name, state, district, village, pincode. Everything else is optional. Rules come from
    SPIC.Core.FarmerPortal.FarmerProfileRules (the API checks the same rules, plus that the
    district belongs to the state). The pincode fills state / district when they are still empty.
    Stepped: "Next" checks only that step's fields; nothing is saved until the last step's submit;
    a server error on an earlier step's field jumps back to that step.
*@

<form class="fpf" @onsubmit="SubmitAsync" @onsubmit:preventDefault novalidate>

    @if (Stepped)
    {
        <FpSteps Steps="@StepTitles" Current="@_step" OnSelect="GoToStepAsync" AriaLabel="Profile steps" CssClass="fpf-steps" />
    }

    @if (Show(0))
    {
        <FpCard @ref="_cards[0]" Title="About you" Subtitle="@(Stepped ? "So your SPIC team knows who you are." : null)" Icon="bi-person" Hue="FpHue.Green">
            <div class="fp-field">
                <label for="fpf-name" class="fp-label">Your name <span class="fp-req">*</span></label>
                <input id="fpf-name" class="fp-input @Invalid("name")" @bind="_name" maxlength="@FarmerProfileRules.NameMax"
                       autocomplete="name" placeholder="For example: Murugan K" aria-invalid="@Aria("name")" />
                <FpFieldError Text="@ErrorFor("name")" />
            </div>

            <div class="fp-form-row">
                @if (!string.IsNullOrWhiteSpace(Phone))
                {
                    <div class="fp-field">
                        <label for="fpf-phone" class="fp-label">Mobile number</label>
                        <div class="fp-input-group">
                            <span class="fp-input-addon" aria-hidden="true"><i class="bi bi-patch-check-fill"></i></span>
                            <input id="fpf-phone" class="fp-input fp-num" value="@($"+91 {Phone}")" readonly aria-readonly="true" aria-describedby="fpf-phone-hint" />
                        </div>
                        <p id="fpf-phone-hint" class="fp-hint">Verified. This is the number you signed in with.</p>
                    </div>
                }

                <div class="fp-field">
                    <label for="fpf-email" class="fp-label">Email <span class="fp-optional">(optional)</span></label>
                    <input id="fpf-email" type="email" inputmode="email" class="fp-input @Invalid("email")" @bind="_email"
                           maxlength="@FarmerProfileRules.EmailMax" autocomplete="email" aria-invalid="@Aria("email")" />
                    <FpFieldError Text="@ErrorFor("email")" />
                </div>
            </div>

            <div class="fp-field">
                <label for="fpf-lang" class="fp-label">Language for SPIC AI answers</label>
                <select id="fpf-lang" class="fp-input @Invalid("preferredLanguage")" @bind="_language">
                    @foreach (var (langCode, langName) in FarmerProfileRules.Languages)
                    {
                        <option value="@langCode">@langName</option>
                    }
                </select>
                <FpFieldError Text="@ErrorFor("preferredLanguage")" />
            </div>
        </FpCard>
    }

    @if (Show(1))
    {
        <FpCard @ref="_cards[1]" Title="Your farm" Subtitle="@(Stepped ? "Helps us give advice for your crops. You can skip this." : null)" Icon="bi-flower1" Hue="FpHue.Gold">
            <div class="fp-field">
                <span class="fp-label" id="fpf-crops-label">Main crops <span class="fp-optional">(tap all that you grow)</span></span>
                <div class="fp-chips" role="group" aria-labelledby="fpf-crops-label">
                    @foreach (var crop in CropChoices)
                    {
                        var c = crop;
                        <FpChip Text="@c" Emoji="@FpUi.CropEmoji(c)" Selected="@IsSelected(c)" OnClick="() => ToggleCrop(c)" CssClass="fp-crop-chip" />
                    }
                </div>
                <div class="fpf-addcrop">
                    @* form="..." takes this box out of the profile form, so Enter adds the crop instead of saving. *@
                    <input class="fp-input" form="fpf-crop-entry" @bind="_otherCrop" @bind:event="oninput" maxlength="@FarmerProfileRules.CropMax"
                           placeholder="Another crop" aria-label="Another crop" @onkeydown="OnOtherCropKey" />
                    <button type="button" class="fp-btn fp-btn--secondary" @onclick="AddOtherCrop" disabled="@string.IsNullOrWhiteSpace(_otherCrop)">
                        <i class="bi bi-plus-lg" aria-hidden="true"></i> Add
                    </button>
                </div>
                <FpFieldError Text="@ErrorFor("primaryCrops")" />
            </div>

            <div class="fp-form-row">
                <div class="fp-field">
                    <label for="fpf-land" class="fp-label">Land <span class="fp-optional">(acres, optional)</span></label>
                    <input id="fpf-land" class="fp-input @Invalid("landAcres")" @bind="_land" inputmode="decimal" placeholder="e.g. 2.5" aria-invalid="@Aria("landAcres")" />
                    <FpFieldError Text="@ErrorFor("landAcres")" />
                </div>
                <div class="fp-field">
                    <label for="fpf-water" class="fp-label">Water source <span class="fp-optional">(optional)</span></label>
                    <select id="fpf-water" class="fp-input @Invalid("irrigationType")" @bind="_irrigation">
                        <option value="">Choose</option>
                        @foreach (var (value, label) in IrrigationChoices)
                        {
                            <option value="@value">@label</option>
                        }
                    </select>
                    <FpFieldError Text="@ErrorFor("irrigationType")" />
                </div>
            </div>
        </FpCard>
    }

    @if (Show(2))
    {
        <FpCard @ref="_cards[2]" Title="Your village" Subtitle="@(Stepped ? "For dealers, weather and your SPIC team near you." : null)" Icon="bi-geo-alt" Hue="FpHue.Sky">
            <div class="fp-field">
                <label for="fpf-pin" class="fp-label">Pincode <span class="fp-req">*</span></label>
                <input id="fpf-pin" class="fp-input fp-input--short fp-num @Invalid("pinCode")" value="@_pinCode"
                       @oninput="OnPinInputAsync" inputmode="numeric" maxlength="6" autocomplete="postal-code" placeholder="6 digits"
                       aria-invalid="@Aria("pinCode")" />
                @if (_pinHint is not null)
                {
                    <p class="fp-hint fp-hint--ok"><i class="bi bi-check-circle-fill" aria-hidden="true"></i> @_pinHint</p>
                }
                <FpFieldError Text="@ErrorFor("pinCode")" />
            </div>

            <div class="fp-form-row">
                <div class="fp-field">
                    <label for="fpf-state" class="fp-label">State <span class="fp-req">*</span></label>
                    <select id="fpf-state" class="fp-input @Invalid("stateId")" value="@_stateId" @onchange="OnStateChangedAsync"
                            disabled="@(_states is null)" aria-invalid="@Aria("stateId")">
                        <option value="0">@(_states is null ? "Loading..." : "Choose your state")</option>
                        @foreach (var s in _states ?? new())
                        {
                            <option value="@s.Id">@s.Name</option>
                        }
                    </select>
                    <FpFieldError Text="@(ErrorFor("stateId") ?? _listError)" />
                </div>

                <div class="fp-field">
                    <label for="fpf-district" class="fp-label">District <span class="fp-req">*</span></label>
                    <select id="fpf-district" class="fp-input @Invalid("districtId")" @bind="_districtId"
                            disabled="@(_stateId == 0 || _districts is null)" aria-invalid="@Aria("districtId")">
                        <option value="0">@(_stateId == 0 ? "Choose the state first" : _districts is null ? "Loading..." : "Choose your district")</option>
                        @foreach (var d in _districts ?? new())
                        {
                            <option value="@d.Id">@d.Name</option>
                        }
                    </select>
                    <FpFieldError Text="@ErrorFor("districtId")" />
                </div>
            </div>

            <div class="fp-form-row">
                <div class="fp-field">
                    <label for="fpf-villagename" class="fp-label">Village <span class="fp-req">*</span></label>
                    <input id="fpf-villagename" class="fp-input @Invalid("village")" @bind="_village" maxlength="@FarmerProfileRules.VillageMax" aria-invalid="@Aria("village")" />
                    <FpFieldError Text="@ErrorFor("village")" />
                </div>
                <div class="fp-field">
                    <label for="fpf-taluk" class="fp-label">Taluk <span class="fp-optional">(optional)</span></label>
                    <input id="fpf-taluk" class="fp-input @Invalid("taluk")" @bind="_taluk" maxlength="@FarmerProfileRules.TalukMax" />
                    <FpFieldError Text="@ErrorFor("taluk")" />
                </div>
            </div>

            <div class="fp-field" id="fpf-location">
                <span class="fp-label">Farm location <span class="fp-optional">(optional)</span></span>
                <div class="fpf-location @(_latitude is not null ? "is-set" : null)">
                    <span class="fp-icon-circle fp-icon-circle--sm fp-hue-sky" aria-hidden="true">
                        <i class="bi @(_latitude is not null ? "bi-geo-alt-fill" : "bi-crosshair")"></i>
                    </span>
                    <span class="fpf-location-status" aria-live="polite">
                        @if (_latitude is not null && _longitude is not null)
                        {
                            <strong>Location saved</strong>
                            <span class="fp-num">@_latitude.Value.ToString("0.0000", CultureInfo.InvariantCulture), @_longitude.Value.ToString("0.0000", CultureInfo.InvariantCulture)</span>
                        }
                        else if (_locationMessage is not null)
                        {
                            <strong>Not found</strong>
                            <span>@_locationMessage</span>
                        }
                        else
                        {
                            <strong>Not added</strong>
                            <span>Helps us show dealers and weather near your farm.</span>
                        }
                    </span>
                    @if (_latitude is not null)
                    {
                        <button type="button" class="fp-btn fp-btn--ghost fp-btn--sm" @onclick="ClearLocation">Remove</button>
                    }
                    else
                    {
                        <button type="button" class="fp-btn fp-btn--secondary fp-btn--sm" @onclick="UseMyLocationAsync" disabled="@_locating">
                            @if (_locating)
                            {
                                <span class="fp-spinner" aria-hidden="true"></span>
                                <span>Finding you...</span>
                            }
                            else
                            {
                                <i class="bi bi-crosshair" aria-hidden="true"></i>
                                <span>Use my location</span>
                            }
                        </button>
                    }
                </div>
                <FpFieldError Text="@ErrorFor("latitude")" />
            </div>
        </FpCard>
    }

    @if (_formError is not null)
    {
        <div class="fp-alert fp-alert--error" role="alert"><i class="bi bi-exclamation-circle-fill" aria-hidden="true"></i> @_formError</div>
    }

    @if (!Stepped || _step == LastStep)
    {
        @* Final fix wave (review I4): saving the profile records the privacy notice acceptance. *@
        <p class="fp-caption fpf-privacy">
            <i class="bi bi-shield-check" aria-hidden="true"></i>
            <span>SPIC uses these details as the <a href="@SPIC.Core.FarmerPortal.FarmerPrivacyRules.PrivacyPath">Privacy notice</a> says.</span>
        </p>
    }

    <div class="fp-actionbar fpf-actions">
        @if (Stepped && _step > 0)
        {
            <button type="button" class="fp-btn fp-btn--secondary fpf-back" @onclick="BackAsync" disabled="@_saving">
                <i class="bi bi-arrow-left" aria-hidden="true"></i> Back
            </button>
        }
        @if (Stepped && _step < LastStep)
        {
            <button type="submit" class="fp-btn fp-btn--primary fpf-submit" data-fp-next>
                Next <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </button>
        }
        else
        {
            <button type="submit" class="fp-btn fp-btn--primary fpf-submit" disabled="@_saving">
                @if (_saving)
                {
                    <span class="fp-spinner" aria-hidden="true"></span>
                    <span>Saving...</span>
                }
                else
                {
                    <i class="bi bi-check2-circle" aria-hidden="true"></i>
                    <span>@SubmitLabel</span>
                }
            </button>
        }
    </div>
</form>

@code {
    /// <summary>The saved profile to edit; null on first onboarding.</summary>
    [Parameter] public FarmerProfileDto? Initial { get; set; }

    /// <summary>The verified mobile, shown read-only.</summary>
    [Parameter] public string? Phone { get; set; }

    [Parameter] public string SubmitLabel { get; set; } = "Save";

    /// <summary>One group per step with FpSteps, Back and Next (onboarding).</summary>
    [Parameter] public bool Stepped { get; set; }

    /// <summary>Raised with the saved profile from the API.</summary>
    [Parameter] public EventCallback<FarmerProfileDto> OnSaved { get; set; }

    /// <summary>Scroll to "Farm location" once it is on screen (Task 3: "Add your location to see weather").</summary>
    [Parameter] public bool FocusLocation { get; set; }

    private bool _locationFocused;

    private static readonly string[] StepTitles = { "About you", "Your farm", "Your village" };
    private const int LastStep = 2;

    // Which step each field (camelCase DTO key) lives on.
    private static readonly Dictionary<string, int> FieldStep = new(StringComparer.OrdinalIgnoreCase)
    {
        ["name"] = 0, ["email"] = 0, ["preferredLanguage"] = 0,
        ["primaryCrops"] = 1, ["landAcres"] = 1, ["irrigationType"] = 1,
        ["pinCode"] = 2, ["stateId"] = 2, ["districtId"] = 2, ["village"] = 2, ["taluk"] = 2,
        ["latitude"] = 2, ["longitude"] = 2
    };

    private static readonly (FarmerIrrigationType Value, string Label)[] IrrigationChoices =
    {
        (FarmerIrrigationType.Rainfed, "Rain only (rainfed)"),
        (FarmerIrrigationType.Canal, "Canal / tank"),
        (FarmerIrrigationType.Borewell, "Borewell / well"),
        (FarmerIrrigationType.Drip, "Drip"),
        (FarmerIrrigationType.Sprinkler, "Sprinkler"),
        (FarmerIrrigationType.Mixed, "More than one")
    };

    private readonly FpCard?[] _cards = new FpCard?[3];
    private int _step;
    private bool _focusStep;

    private string _name = "";
    private string _email = "";
    private string _language = FarmerProfileRules.DefaultLanguage;
    private string _pinCode = "";
    private int _stateId;
    private int _districtId;
    private string _village = "";
    private string _taluk = "";
    private double? _latitude;
    private double? _longitude;
    private readonly List<string> _crops = new();
    private readonly List<string> _extraCrops = new();
    private string _otherCrop = "";
    private string _land = "";
    private string _irrigation = "";

    private List<FarmerApi.LocationOption>? _states;
    private List<FarmerApi.LocationOption>? _districts;
    private string? _listError;
    private string? _pinHint;
    private bool _locating;
    private string? _locationMessage;
    private bool _saving;
    private string? _formError;
    private Dictionary<string, string> _errors = new();
    private FarmerProfileDto? _appliedInitial;

    private IEnumerable<string> CropChoices => FarmerProfileRules.CommonCrops.Concat(_extraCrops);

    private bool Show(int step) => !Stepped || _step == step;

    protected override async Task OnParametersSetAsync()
    {
        if (!ReferenceEquals(Initial, _appliedInitial))
        {
            _appliedInitial = Initial;
            Apply(Initial);
        }

        if (_states is null)
        {
            _states = await Api.StatesAsync();
            if (_states is null)
            {
                _states = new();
                _listError = "We could not load the list of states. Please check your connection and open this page again.";
            }
        }

        if (_stateId > 0 && _districts is null)
            await LoadDistrictsAsync(_stateId);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (FocusLocation && !_locationFocused && !Stepped && _states is not null)
        {
            _locationFocused = true;
            try { await JS.InvokeVoidAsync("scrollToElementId", "fpf-location"); }
            catch (Exception) { /* prerender / disconnected circuit: the page simply stays at the top */ }
        }
        if (!_focusStep) return;
        _focusStep = false;
        if (_cards[_step] is { } card) await card.FocusTitleAsync();
    }

    private void Apply(FarmerProfileDto? p)
    {
        if (p is null) return;
        _name = p.Name;
        _email = p.Email ?? "";
        _language = FarmerProfileRules.IsKnownLanguage(p.PreferredLanguage) ? p.PreferredLanguage : FarmerProfileRules.DefaultLanguage;
        _pinCode = p.PinCode;
        _stateId = p.StateId;
        _districtId = p.DistrictId;
        _districts = null;
        _village = p.Village;
        _taluk = p.Taluk ?? "";
        _latitude = p.Latitude;
        _longitude = p.Longitude;
        _crops.Clear();
        _crops.AddRange(p.PrimaryCrops);
        _extraCrops.Clear();
        _extraCrops.AddRange(p.PrimaryCrops.Where(c => !FarmerProfileRules.CommonCrops.Contains(c, StringComparer.OrdinalIgnoreCase)));
        _land = p.LandAcres?.ToString("0.##", CultureInfo.InvariantCulture) ?? "";
        _irrigation = p.IrrigationType?.ToString() ?? "";
    }

    private async Task LoadDistrictsAsync(int stateId)
    {
        _districts = null;
        var list = await Api.DistrictsAsync(stateId);
        if (stateId != _stateId) return; // the farmer picked another state meanwhile
        _districts = list ?? new();
        if (list is null) _listError = "We could not load the districts. Please check your connection and try again.";
        if (_districtId > 0 && _districts.All(d => d.Id != _districtId)) _districtId = 0;
    }

    private async Task OnStateChangedAsync(ChangeEventArgs e)
    {
        _stateId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;
        _districtId = 0;
        _districts = null;
        _pinHint = null;
        _errors.Remove("stateId");
        if (_stateId > 0) await LoadDistrictsAsync(_stateId);
    }

    /// <summary>Six digits typed: fill state / district (and taluk) from the pincode when still empty.</summary>
    private async Task OnPinInputAsync(ChangeEventArgs e)
    {
        _pinCode = new string((e.Value?.ToString() ?? "").Where(char.IsAsciiDigit).Take(6).ToArray());
        _pinHint = null;
        if (_pinCode.Length != 6 || (_stateId > 0 && _districtId > 0) || _states is not { Count: > 0 }) return;

        var pin = _pinCode;
        var place = await Api.LookupPincodeAsync(pin);
        if (place is null || pin != _pinCode) return;

        var state = _states.FirstOrDefault(s => SameName(s.Name, place.State));
        if (state is null) return;

        if (_stateId != state.Id)
        {
            _stateId = state.Id;
            _districtId = 0;
            await LoadDistrictsAsync(state.Id);
            if (pin != _pinCode || _stateId != state.Id) return;
        }
        else if (_districts is null)
        {
            await LoadDistrictsAsync(state.Id);
            if (pin != _pinCode) return;
        }

        var district = _districts?.FirstOrDefault(d => SameName(d.Name, place.District));
        if (district is not null && _districtId == 0) _districtId = district.Id;
        if (string.IsNullOrWhiteSpace(_taluk) && !string.IsNullOrWhiteSpace(place.Block) && place.Block != "NA") _taluk = place.Block;

        _pinHint = district is not null
            ? $"Filled from your pincode: {district.Name}, {state.Name}. Please check."
            : $"Filled your state from the pincode: {state.Name}. Please choose the district.";
    }

    private static bool SameName(string? a, string? b) =>
        !string.IsNullOrWhiteSpace(a) && !string.IsNullOrWhiteSpace(b) &&
        string.Equals(Simplify(a), Simplify(b), StringComparison.OrdinalIgnoreCase);

    private static string Simplify(string s) => new(s.Where(char.IsLetterOrDigit).ToArray());

    private sealed class GeoResult
    {
        public double Latitude { get; set; }
        public double Longitude { get; set; }
        public string? Error { get; set; }
    }

    /// <summary>window.getCurrentPosition (js/location.js on the Web; the MAUI host bridges the same name).</summary>
    private async Task UseMyLocationAsync()
    {
        _locating = true;
        _locationMessage = null;
        try
        {
            var position = await JS.InvokeAsync<GeoResult?>("getCurrentPosition");
            if (position is null || !string.IsNullOrWhiteSpace(position.Error) || (position.Latitude == 0 && position.Longitude == 0))
            {
                _locationMessage = "Please allow location access, or skip this.";
                return;
            }
            _latitude = Math.Round(position.Latitude, 6);
            _longitude = Math.Round(position.Longitude, 6);
            _errors.Remove("latitude");
        }
        catch (Exception)
        {
            _locationMessage = "Location is not available on this device. You can skip this.";
        }
        finally
        {
            _locating = false;
        }
    }

    private void ClearLocation()
    {
        _latitude = null;
        _longitude = null;
        _locationMessage = null;
    }

    private bool IsSelected(string crop) => _crops.Contains(crop, StringComparer.OrdinalIgnoreCase);

    private void ToggleCrop(string crop)
    {
        var existing = _crops.FirstOrDefault(c => string.Equals(c, crop, StringComparison.OrdinalIgnoreCase));
        if (existing is not null) _crops.Remove(existing);
        else _crops.Add(crop);
        _errors.Remove("primaryCrops");
    }

    private void AddOtherCrop()
    {
        var crop = FarmerProfileRules.CleanCrops(new[] { _otherCrop }).FirstOrDefault();
        _otherCrop = "";
        if (crop is null) return;
        if (!CropChoices.Contains(crop, StringComparer.OrdinalIgnoreCase)) _extraCrops.Add(crop);
        if (!IsSelected(crop)) _crops.Add(crop);
    }

    private void OnOtherCropKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AddOtherCrop();
    }

    private FarmerProfileUpsertDto BuildDto()
    {
        decimal? land = decimal.TryParse(_land.Trim().Replace(',', '.'), NumberStyles.Number, CultureInfo.InvariantCulture, out var acres)
            ? acres : null;
        return new FarmerProfileUpsertDto
        {
            Name = _name,
            Email = _email,
            StateId = _stateId,
            DistrictId = _districtId,
            Village = _village,
            Taluk = _taluk,
            PinCode = _pinCode,
            Latitude = _latitude,
            Longitude = _longitude,
            PrimaryCrops = _crops.ToList(),
            LandAcres = land,
            IrrigationType = Enum.TryParse<FarmerIrrigationType>(_irrigation, out var irrigation) ? irrigation : null,
            PreferredLanguage = _language
        };
    }

    /// <summary>All client-side errors (FarmerProfileRules + the land number check).</summary>
    private Dictionary<string, string> ValidateAll(FarmerProfileUpsertDto dto)
    {
        var errors = FarmerProfileRules.Validate(dto);
        if (!string.IsNullOrWhiteSpace(_land) && dto.LandAcres is null)
            errors["landAcres"] = "Please write the land in numbers, for example 2.5.";
        return errors;
    }

    private static int StepOf(string field) => FieldStep.TryGetValue(field, out var step) ? step : LastStep;

    private void ShowStep(int step)
    {
        _step = Math.Clamp(step, 0, LastStep);
        _focusStep = true;
    }

    private Task GoToStepAsync(int step)
    {
        if (step < _step)
        {
            _formError = null;
            ShowStep(step);
        }
        return Task.CompletedTask;
    }

    private Task BackAsync()
    {
        _formError = null;
        ShowStep(_step - 1);
        return Task.CompletedTask;
    }

    private async Task SubmitAsync()
    {
        if (_saving) return;
        _formError = null;

        var dto = BuildDto();
        var errors = ValidateAll(dto);

        // Stepped and not on the last step: "Next" checks only this step's fields.
        if (Stepped && _step < LastStep)
        {
            _errors = errors.Where(kv => StepOf(kv.Key) == _step).ToDictionary(kv => kv.Key, kv => kv.Value);
            if (_errors.Count > 0)
            {
                _formError = "Please check the fields marked in red.";
                return;
            }
            ShowStep(_step + 1);
            return;
        }

        _errors = errors;
        if (_errors.Count > 0)
        {
            _formError = "Please check the fields marked in red.";
            if (Stepped) ShowStep(_errors.Keys.Min(StepOf));
            return;
        }

        _saving = true;
        try
        {
            var result = await Api.SaveProfileAsync(dto);
            if (result.Profile is null)
            {
                _errors = result.Errors.ToDictionary(kv => kv.Key, kv => kv.Value);
                _formError = result.Message ?? "We could not save your profile. Please try again.";
                if (Stepped && _errors.Count > 0) ShowStep(_errors.Keys.Min(StepOf));
                return;
            }
            _appliedInitial = result.Profile;
            await OnSaved.InvokeAsync(result.Profile);
        }
        finally
        {
            _saving = false;
        }
    }

    private string? ErrorFor(string field) => _errors.TryGetValue(field, out var message) ? message : null;

    private string? Invalid(string field) => _errors.ContainsKey(field) ? "is-invalid" : null;

    private string Aria(string field) => _errors.ContainsKey(field) ? "true" : "false";
}
