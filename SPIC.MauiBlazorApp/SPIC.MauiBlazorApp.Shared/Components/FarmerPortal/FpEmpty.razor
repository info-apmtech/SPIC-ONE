@namespace SPIC.MauiBlazorApp.Shared.Components.FarmerPortal

@*
    FpEmpty - friendly empty state: illustration, title, one line, actions.

        <FpEmpty Art="FpArtKind.Search" Title="No dealers within 25 km" Message="Try a wider distance.">
            <button class="fp-btn fp-btn--secondary" @onclick="Widen">Show 50 km</button>
        </FpEmpty>

    Card="true" draws it as a card; Compact="true" puts the picture beside the text (desktop).
    Tone="error" is used by FpError.
*@

<div class="fp-empty @(Card ? "fp-empty--card" : null) @(Compact ? "fp-empty--compact" : null) @(Tone == "error" ? "fp-empty--error" : null) fp-fade-up @CssClass"
     role="@(Tone == "error" ? "alert" : null)">
    <FpArt Kind="@Art" />
    <div class="fp-empty__content">
        <h2 class="fp-empty__title">@Title</h2>
        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <p class="fp-empty__text">@Message</p>
        }
        @if (ChildContent is not null)
        {
            <div class="fp-empty__actions">@ChildContent</div>
        }
    </div>
</div>

@code {
    [Parameter] public FpArtKind Art { get; set; } = FpArtKind.Sprout;

    [Parameter, EditorRequired] public string Title { get; set; } = "";

    [Parameter] public string? Message { get; set; }

    /// <summary>Action buttons (fp-btn classes).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public bool Card { get; set; } = true;

    [Parameter] public bool Compact { get; set; }

    /// <summary>"empty" (default) or "error".</summary>
    [Parameter] public string Tone { get; set; } = "empty";

    [Parameter] public string? CssClass { get; set; }
}
