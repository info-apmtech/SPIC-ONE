@namespace SPIC.MauiBlazorApp.Shared.Components.FarmerPortal

@* A small "this card shows the state instead of the district" note (farmer portal Task 3). Renders nothing without Text. *@

@if (!string.IsNullOrWhiteSpace(Text))
{
    <p class="fp-caption fptn" role="note"><i class="bi bi-info-circle" aria-hidden="true"></i> @Text</p>
}

@code {
    [Parameter] public string? Text { get; set; }
}
