@namespace SPIC.MauiBlazorApp.Shared.Components.FarmerPortal

@* Inline field error in plain words: <FpFieldError Text="@ErrorFor("name")" />. Renders nothing when Text is empty. *@
@if (!string.IsNullOrWhiteSpace(Text))
{
    <p class="fp-field-error" role="alert"><i class="bi bi-exclamation-circle" aria-hidden="true"></i> @Text</p>
}

@code {
    [Parameter] public string? Text { get; set; }
}
