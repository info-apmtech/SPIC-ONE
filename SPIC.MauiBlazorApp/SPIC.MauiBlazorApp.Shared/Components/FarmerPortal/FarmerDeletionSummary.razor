@namespace SPIC.MauiBlazorApp.Shared.Components.FarmerPortal
@using SPIC.Core.FarmerPortal

@*
    What "Delete my account" removes and what stays (final fix wave). One list for the profile's confirm sheet
    and the public /farmer/delete-account page, from SPIC.Core FarmerPrivacyRules (the API removes the same).
*@

<div class="fpds @CssClass">
    <h3 class="fpds-title"><i class="bi bi-trash3" aria-hidden="true"></i> What is removed</h3>
    <ul class="fpds-list">
        @foreach (var item in FarmerPrivacyRules.RemovedItems)
        {
            <li><i class="bi bi-x-circle" aria-hidden="true"></i><span>@item</span></li>
        }
    </ul>

    <h3 class="fpds-title"><i class="bi bi-archive" aria-hidden="true"></i> What stays</h3>
    <ul class="fpds-list fpds-list--kept">
        @foreach (var item in FarmerPrivacyRules.KeptItems)
        {
            <li><i class="bi bi-dash-circle" aria-hidden="true"></i><span>@item</span></li>
        }
    </ul>

    <p class="fpds-undo" role="note">
        <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
        <span>@FarmerPrivacyRules.CannotUndo</span>
    </p>
</div>

@code {
    [Parameter] public string? CssClass { get; set; }
}
