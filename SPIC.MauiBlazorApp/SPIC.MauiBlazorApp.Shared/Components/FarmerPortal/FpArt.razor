@namespace SPIC.MauiBlazorApp.Shared.Components.FarmerPortal

@*
    FpArt - small inline SVG illustrations in the portal palette (no image files, works offline).
        <FpArt Kind="FpArtKind.Sprout" />    Kinds: Sprout, Field, Offline, Search, Team.
    Decorative (aria-hidden); the surrounding text carries the meaning.
*@

<svg class="fp-art @CssClass" viewBox="0 0 168 126" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
    @switch (Kind)
    {
        case FpArtKind.Field:
            <circle class="fp-art__bg" cx="84" cy="62" r="56" fill="#e8f5ee" />
            <circle cx="122" cy="34" r="12" fill="#f6c453" />
            <circle cx="122" cy="34" r="18" fill="#f6c453" opacity=".25" />
            <path d="M44 30c4-7 15-7 18 0 6-1 9 4 7 8H40c-3-4 0-8 4-8z" fill="#fff" />
            <path d="M14 92c26-22 56-26 86-16 18 6 36 4 54-6v40H14z" fill="#9fd4b4" />
            <path d="M14 100c30-14 62-14 92-4 18 6 34 4 48-2v32H14z" fill="#14935a" />
            <path d="M14 112c34-10 70-8 104 0 14 3 26 2 36-2v16H14z" fill="#0b6b3a" />
            <g stroke="#cfeadb" stroke-width="2" stroke-linecap="round" opacity=".7">
                <path d="M40 104l-10 18M60 101l-6 21M80 100l-2 22M100 101l2 21M120 104l6 18" />
            </g>
            <g fill="#e8a317">
                <circle cx="62" cy="84" r="2.5" />
                <circle cx="92" cy="80" r="2.5" />
                <circle cx="118" cy="86" r="2.5" />
            </g>
            break;

        case FpArtKind.Offline:
            <circle class="fp-art__bg" cx="84" cy="62" r="56" fill="#e8f5ee" />
            <rect x="58" y="18" width="52" height="92" rx="10" fill="#0f1f17" />
            <rect x="62" y="26" width="44" height="74" rx="4" fill="#fff" />
            <rect x="77" y="21" width="14" height="2.5" rx="1.25" fill="#4b5b52" />
            <path d="M70 60c8-8 20-8 28 0" stroke="#7d8b83" stroke-width="4" fill="none" stroke-linecap="round" />
            <path d="M75 67c5-5 13-5 18 0" stroke="#7d8b83" stroke-width="4" fill="none" stroke-linecap="round" />
            <circle cx="84" cy="74" r="3.5" fill="#7d8b83" />
            <path d="M68 48l32 34" stroke="#d64545" stroke-width="4.5" stroke-linecap="round" />
            <path d="M122 92c6-9 16-10 22-6-2 9-12 15-22 6z" fill="#14935a" />
            <path d="M120 100c1-4 2-7 3-9" stroke="#0b6b3a" stroke-width="2.5" stroke-linecap="round" />
            <ellipse cx="84" cy="114" rx="40" ry="4" fill="#0b6b3a" opacity=".12" />
            break;

        case FpArtKind.Search:
            <circle class="fp-art__bg" cx="84" cy="62" r="56" fill="#e8f5ee" />
            <path d="M24 98c22-10 46-12 70-6 20 5 38 4 52-2v18H24z" fill="#9fd4b4" />
            <path d="M24 106c26-8 54-8 80-2 16 4 30 3 42-1v13H24z" fill="#14935a" />
            <circle cx="76" cy="54" r="26" fill="#fff" stroke="#0b6b3a" stroke-width="6" />
            <path d="M95 73l20 20" stroke="#0b6b3a" stroke-width="9" stroke-linecap="round" />
            <path d="M76 66V50" stroke="#14935a" stroke-width="3" stroke-linecap="round" />
            <path d="M76 54c-1-8-8-11-13-10 0 6 5 11 13 10z" fill="#14935a" />
            <path d="M76 50c1-8 8-11 13-10 0 6-5 11-13 10z" fill="#1e9e5a" />
            <circle cx="132" cy="30" r="3" fill="#e8a317" />
            <circle cx="40" cy="38" r="2.5" fill="#e8a317" />
            break;

        case FpArtKind.Team:
            <circle class="fp-art__bg" cx="84" cy="62" r="56" fill="#e8f5ee" />
            <circle cx="62" cy="48" r="14" fill="#8a5a2b" />
            <path d="M36 102c0-17 12-28 26-28s26 11 26 28z" fill="#0b6b3a" />
            <circle cx="106" cy="52" r="13" fill="#c98a4b" />
            <path d="M82 104c0-16 11-26 24-26s24 10 24 26z" fill="#14935a" />
            <circle cx="124" cy="30" r="12" fill="#e8a317" />
            <path d="M119 30l4 4 7-8" stroke="#fff" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round" />
            <ellipse cx="84" cy="108" rx="52" ry="4" fill="#0b6b3a" opacity=".12" />
            break;

        default: // Sprout
            <circle class="fp-art__bg" cx="84" cy="62" r="56" fill="#e8f5ee" />
            <circle cx="126" cy="30" r="10" fill="#f6c453" />
            <circle cx="126" cy="30" r="16" fill="#f6c453" opacity=".25" />
            <path d="M84 96V60" stroke="#0b6b3a" stroke-width="5" stroke-linecap="round" />
            <path d="M84 70c-3-17-18-24-30-21 0 14 13 25 30 21z" fill="#14935a" />
            <path d="M84 62c3-18 19-26 32-22 0 15-14 27-32 22z" fill="#1e9e5a" />
            <path d="M84 62c6-6 14-12 24-16" stroke="#0b6b3a" stroke-width="2" stroke-linecap="round" opacity=".5" />
            <path d="M40 104c8-12 26-16 44-16s36 4 44 16z" fill="#8a5a2b" />
            <path d="M40 104h88" stroke="#6d4520" stroke-width="3" stroke-linecap="round" />
            <g fill="#b07a45">
                <circle cx="62" cy="99" r="2" />
                <circle cx="96" cy="97" r="2" />
                <circle cx="110" cy="101" r="1.8" />
            </g>
            <circle cx="44" cy="44" r="3" fill="#e8a317" />
            <circle cx="36" cy="62" r="2" fill="#14935a" />
            break;
    }
</svg>

@code {
    [Parameter] public FpArtKind Kind { get; set; } = FpArtKind.Sprout;

    [Parameter] public string? CssClass { get; set; }
}
