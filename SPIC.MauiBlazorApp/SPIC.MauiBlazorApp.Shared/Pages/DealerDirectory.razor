@page "/DealerDirectory"

<div class="container-fluid py-4 px-0">
        
        <div class="dd-header-container">
            <div class="dd-header-text">
                <h1>Dealer Directory</h1>
                <p>Search and access dealer information across SDWA regions.</p>
            </div>
            
            <div class="dd-header-actions">
                <button class="dd-action-btn">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                    </svg>
                    Excel
                </button>
                <button class="dd-action-btn">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m-7.5 11.25v-1.5m-3-1.5h6m-6 3h6m-9-6h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9H5.625a9 9 0 00-9 9v3.375c0 .621.504 1.125 1.125 1.125z" />
                    </svg>
                    PDF
                </button>
                <button class="dd-action-btn">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6.72 13.829c-.24.03-.48.062-.72.096m.72-.096a42.415 42.415 0 0110.56 0m-10.56 0L6.34 18m10.94-4.171c.24.03.48.062.72.096m-.72-.096L17.66 18m0 0l.229 2.523a1.125 1.125 0 01-1.12 1.227H7.231c-.662 0-1.18-.568-1.12-1.227L6.34 18m11.318 0h1.091A2.25 2.25 0 0021 15.75V9.456c0-1.081-.768-2.015-1.837-2.175a48.055 48.055 0 00-1.913-.247M6.34 18H5.25A2.25 2.25 0 013 15.75V9.456c0-1.081.768-2.015 1.837-2.175a48.041 48.041 0 011.913-.247m10.5 0a48.536 48.536 0 00-10.5 0m10.5 0V3.375c0-.621-.504-1.125-1.125-1.125h-8.25c-.621 0-1.125.504-1.125 1.125v3.659M18 10.5h.008v.008H18V10.5zm-3 0h.008v.008H15V10.5z" />
                    </svg>
                    Print
                </button>
            </div>
        </div>

        <div class="dd-stats-grid">
            
            <div class="dd-stat-card dd-card-total">
                <div class="dd-card-content">
                    <div class="dd-card-title">Total Dealers</div>
                    <div class="dd-card-value">156</div>
                </div>
                <div class="dd-card-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                    </svg>
                </div>
            </div>

            <div class="dd-stat-card dd-card-active">
                <div class="dd-card-content">
                    <div class="dd-card-title">Active Dealers</div>
                    <div class="dd-card-value">142</div>
                </div>
                <div class="dd-card-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="8.5" cy="7" r="4"></circle>
                        <polyline points="17 11 19 13 23 9"></polyline>
                    </svg>
                </div>
            </div>

            <div class="dd-stat-card dd-card-regions">
                <div class="dd-card-content">
                    <div class="dd-card-title">Regions Covered</div>
                    <div class="dd-card-value">28</div>
                </div>
                <div class="dd-card-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                        <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon>
                        <line x1="8" y1="2" x2="8" y2="18"></line>
                        <line x1="16" y1="6" x2="16" y2="22"></line>
                        <circle cx="12" cy="11" r="3"></circle>
                    </svg>
                </div>
            </div>

            <div class="dd-stat-card dd-card-recent">
                <div class="dd-card-content">
                    <div class="dd-card-title">Recently Added</div>
                    <div class="dd-card-value">8</div>
                </div>
                <div class="dd-card-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="8.5" cy="7" r="4"></circle>
                        <line x1="20" y1="8" x2="20" y2="14"></line>
                        <line x1="23" y1="11" x2="17" y2="11"></line>
                    </svg>
                </div>
            </div>

        </div>
    <div class="dd-filters-card">
        <div class="dd-filters-header">
            <div class="dd-filters-title">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h12M4 18h6" />
                </svg>
                Filters
            </div>
            <div class="dd-filters-toggle">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
            </div>
        </div>

        <div class="dd-filters-body">
            <div class="dd-filters-grid">
                <div class="dd-input-group">
                    <label>State</label>
                    <select class="dd-select">
                        <option value="" disabled selected hidden>All State</option>
                        <option value="tn">Tamil Nadu</option>
                        <option value="kl">Kerala</option>
                    </select>
                </div>
                <div class="dd-input-group">
                    <label>Region</label>
                    <select class="dd-select">
                        <option value="" disabled selected hidden>All Region</option>
                        <option value="north">North</option>
                        <option value="south">South</option>
                    </select>
                </div>
                <div class="dd-input-group">
                    <label>Head Quarters</label>
                    <select class="dd-select">
                        <option value="" disabled selected hidden>All Head Quarters</option>
                        <option value="chennai">Chennai</option>
                        <option value="madurai">Madurai</option>
                    </select>
                </div>
                <div class="dd-input-group">
                    <label>Status</label>
                    <select class="dd-select">
                        <option value="" disabled selected hidden>Select Statuses</option>
                        <option value="active">Active</option>
                        <option value="inactive">Inactive</option>
                    </select>
                </div>
            </div>

            <div class="dd-filters-actions">
                <button class="dd-btn-clear">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                    Clear All
                </button>
                <button class="dd-btn-apply">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h12M4 18h6" />
                    </svg>
                    Apply Filters
                </button>
            </div>
        </div>
    </div>
    <div class="dd-table-card">
        <div class="dd-table-header">
            <h2>Dealer List</h2>
            <div class="dd-search-box">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
                <input type="text" placeholder="Search zones..." />
            </div>
        </div>

        <div class="dd-table-wrapper">
            <table class="dd-table">
                <thead>
                    <tr>
                        <th>Dealer Code</th>
                        <th>Firm Name</th>
                        <th>State</th>
                        <th>Head Quarters</th>
                        <th>Mobile No.</th>
                        <th>Email</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>45707742</td>
                        <td>Roja Enterprises</td>
                        <td>Tamil Nadu</td>
                        <td>Chennai</td>
                        <td>9876543210</td>
                        <td>hello@gmail.com</td>
                        <td><span class="dd-badge dd-badge-active">Active</span></td>
                    </tr>
                    <tr>
                        <td>45707742</td>
                        <td>Roja Enterprises</td>
                        <td>Tamil Nadu</td>
                        <td>Chennai</td>
                        <td>9876543210</td>
                        <td>hello@gmail.com</td>
                        <td><span class="dd-badge dd-badge-active">Active</span></td>
                    </tr>
                    <tr>
                        <td>45707742</td>
                        <td>Roja Enterprises</td>
                        <td>Tamil Nadu</td>
                        <td>Chennai</td>
                        <td>9876543210</td>
                        <td>hello@gmail.com</td>
                        <td><span class="dd-badge dd-badge-inactive">Inactive</span></td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="dd-table-footer">
            <div class="dd-items-per-page">
                Items Per Page
                <select class="dd-select" style="width: auto;">
                    <option value="16">16</option>
                    <option value="32">32</option>
                    <option value="64">64</option>
                </select>
            </div>
                
            <div class="dd-pagination">
                <button class="dd-page-btn disabled">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                    </svg>
                </button>
                <button class="dd-page-btn active">1</button>
                <button class="dd-page-btn">2</button>
                <button class="dd-page-btn">3</button>
                <button class="dd-page-btn" style="border: none; background: transparent; cursor: default;">..</button>
                <button class="dd-page-btn">8</button>
                <button class="dd-page-btn">9</button>
                <button class="dd-page-btn">10</button>
                <button class="dd-page-btn">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                </button>
            </div>
        </div>
    </div>
</div>