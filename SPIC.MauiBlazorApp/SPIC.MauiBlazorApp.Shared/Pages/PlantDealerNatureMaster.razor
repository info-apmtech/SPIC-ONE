@page "/PlantDealerNatureMaster"
@using System.Net.Http.Json
@inject HttpClient Http
@inject ISessionStore SessionStore
@inject SPIC.MauiBlazorApp.Shared.Services.LoginState LoginState

<div class="container-fluid mf-page">

	<PageHeader Title="Plant & Dealer Nature Master" Subtitle="Plants and dealer natures used across Excel uploads and dealer records" />

	@if (!string.IsNullOrEmpty(_message))
	{
		<div class="alert @(_isError ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
			@_message
			<button type="button" class="btn-close" @onclick="() => _message = null"></button>
		</div>
	}

	<div class="tabs-wrapper">
		<div class="tabs-container">
			@foreach (var tab in TabOptions)
			{
				<div class="tab-item @(ActiveTab == tab ? "active" : "")" @onclick="() => SetActiveTab(tab)">
					@tab
				</div>
			}
		</div>
	</div>

	<div class="main-card mf-form-card">
		<div class="section-header">
			<h3 class="section-title">@(_isEditing ? $"Edit {GetSingularName(ActiveTab)}" : $"Add New {GetSingularName(ActiveTab)}")</h3>
		</div>

		<div class="row g-3 mb-4 mf-form-row">
			<div class="col-md-6 col-lg-5">
				<label class="form-label-custom">@GetSingularName(ActiveTab) Name</label>
				<input type="text" class="form-control-custom w-100" placeholder="Enter @GetSingularName(ActiveTab) Name"
					   @bind="_formModel.Name" @ref="_firstInputRef" />
			</div>

			<div class="col-md-6 col-lg-2">
				<label class="form-label-custom d-block mf-align-label">&nbsp;</label>
				<div class="status-toggle-box @(_formModel.IsActive ? "" : "status-toggle-inactive")">
					<span>@(_formModel.IsActive ? "Active" : "Inactive")</span>
					<label class="switch">
						<input type="checkbox" @bind="_formModel.IsActive">
						<span class="slider"></span>
					</label>
				</div>
			</div>
		</div>

		<div class="d-flex justify-content-end pt-2 mt-4 mf-form-actions">
			<button class="btn-cancel mt-3" @onclick="ResetForm"><i class="bi bi-x"></i> Cancel</button>
			@if ((!_isEditing && LoginState.Can(SPIC.Core.Entities.PagePermission.PlantDealerNatureMaster, "Entry")) || (_isEditing && LoginState.Can(SPIC.Core.Entities.PagePermission.PlantDealerNatureMaster, "Update")))
			{
				<button class="btn-save mt-3" @onclick="HandleSave" disabled="@_isSaving">
					<i class="bi bi-save"></i> @(_isSaving ? "Saving..." : "Save")
				</button>
			}
		</div>
	</div>

	<div class="row g-3 mb-4">
		<div class="col-md-4">
			<div class="metric-card bg-blue-light">
				<div class="metric-header">
					<h4 class="metric-title">Total @ActiveTab</h4>
				</div>
				<div class="metric-val">@CurrentAllItems.Count</div>
			</div>
		</div>
		<div class="col-md-4">
			<div class="metric-card bg-mint-light">
				<div class="metric-header">
					<h4 class="metric-title">Active</h4>
				</div>
				<div class="metric-val">@CurrentAllItems.Count(x => x.IsActive)</div>
			</div>
		</div>
		<div class="col-md-4">
			<div class="metric-card bg-gray-light">
				<div class="metric-header">
					<h4 class="metric-title">Inactive</h4>
				</div>
				<div class="metric-val">@CurrentAllItems.Count(x => !x.IsActive)</div>
			</div>
		</div>
	</div>

	<SpicDataTable Items="_filteredItems"
				   IsLoading="_isLoading"
				   Title="@($"Existing {ActiveTab}")"
				   FileName="@ActiveTab"
				   ExportColumns="GetExportColumns()"
				   SearchText="@_searchText">

		<FilterControls>
			<div class="search-box">
				<i class="bi bi-search"></i>
				<input type="text" placeholder="Search @ActiveTab.ToLower()..."
					   @bind="_searchText" @bind:event="oninput" @bind:after="StateHasChanged" />
			</div>
			<select class="filter-select" @bind="_statusFilter" @bind:after="ApplyFilter">
				<option value="All">All Status</option>
				<option value="Active">Active</option>
				<option value="Inactive">Inactive</option>
			</select>
		</FilterControls>

		<TableHeader>
			<th>@GetSingularName(ActiveTab) Name</th>
			<th>Status</th>
			<th>Created At</th>
			@if (LoginState.Can(SPIC.Core.Entities.PagePermission.PlantDealerNatureMaster, "Update") || LoginState.Can(SPIC.Core.Entities.PagePermission.PlantDealerNatureMaster, "Delete"))
			{
				<th>Action</th>
			}
		</TableHeader>

		<TableRow Context="item">
			<td>@item.Name</td>
			<td>
				@if (LoginState.Can(SPIC.Core.Entities.PagePermission.PlantDealerNatureMaster, "Update"))
				{
					<span class="status-pill @(item.IsActive ? "status-active" : "status-inactive")"
						  style="cursor:pointer"
						  @onclick="() => ToggleStatus(item)">
						@(item.IsActive ? "Active" : "Inactive")
					</span>
				}
				else
				{
					<span class="status-pill @(item.IsActive ? "status-active" : "status-inactive")">
						@(item.IsActive ? "Active" : "Inactive")
					</span>
				}
			</td>
			<td>@item.CreatedAt.ToString("yyyy-MM-dd")</td>
			@if (LoginState.Can(SPIC.Core.Entities.PagePermission.PlantDealerNatureMaster, "Update") || LoginState.Can(SPIC.Core.Entities.PagePermission.PlantDealerNatureMaster, "Delete"))
			{
				<td>
					<div class="action-icons">
						@if (LoginState.Can(SPIC.Core.Entities.PagePermission.PlantDealerNatureMaster, "Delete"))
						{
							<i class="bi bi-trash icon-del" @onclick="() => DeleteItem(item)"></i>
						}
						@if (LoginState.Can(SPIC.Core.Entities.PagePermission.PlantDealerNatureMaster, "Update"))
						{
							<i class="bi bi-pencil-square icon-edit" @onclick="() => EditItem(item)"></i>
						}
					</div>
				</td>
			}
		</TableRow>

		<CardActions Context="item">
			@if (LoginState.Can(SPIC.Core.Entities.PagePermission.PlantDealerNatureMaster, "Update"))
			{
				<button type="button" class="btn btn-sm @(item.IsActive ? "btn-outline-success" : "btn-outline-secondary")" @onclick="() => ToggleStatus(item)">
					<i class="bi @(item.IsActive ? "bi-toggle-on" : "bi-toggle-off")"></i> @(item.IsActive ? "Active" : "Inactive")
				</button>
				<button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => EditItem(item)"><i class="bi bi-pencil-square"></i> Edit</button>
			}
			@if (LoginState.Can(SPIC.Core.Entities.PagePermission.PlantDealerNatureMaster, "Delete"))
			{
				<button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeleteItem(item)"><i class="bi bi-trash"></i> Delete</button>
			}
		</CardActions>
	</SpicDataTable>

</div>

@if (_showDeleteConfirm)
{
	<div class="modal-backdrop fade show"></div>
	<div class="modal fade show d-block" tabindex="-1" role="dialog">
		<div class="modal-dialog modal-dialog-centered" role="document">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title">Confirm Delete</h5>
					<button type="button" class="btn-close" @onclick="CancelDelete"></button>
				</div>
				<div class="modal-body">
					<p>Are you sure you want to delete <strong>@_deleteTarget?.Name</strong>?</p>
					<p class="text-muted mb-0">This action cannot be undone.</p>
				</div>
				<div class="modal-footer">
					<button class="btn btn-secondary" @onclick="CancelDelete">Cancel</button>
					<button class="btn btn-danger" @onclick="ConfirmDelete" disabled="@_isDeleting">
						@(_isDeleting ? "Deleting..." : "Delete")
					</button>
				</div>
			</div>
		</div>
	</div>
}

@code {
	private readonly List<string> TabOptions = ["Plants", "Dealer Natures"];

	private ElementReference _firstInputRef;

	private string ActiveTab { get; set; } = "Plants";
	private string CurrentApiBase => ActiveTab switch
	{
		"Plants" => "api/Plant",
		"Dealer Natures" => "api/DealershipNature",
		_ => ""
	};

	// Data per tab
	private List<MasterItemDto> _plantsAll = new();
	private List<MasterItemDto> _dealerNaturesAll = new();
	private List<MasterItemDto> _filteredItems = new();

	private List<MasterItemDto> CurrentAllItems => ActiveTab switch
	{
		"Plants" => _plantsAll,
		"Dealer Natures" => _dealerNaturesAll,
		_ => new()
	};

	private MasterFormModel _formModel = new();
	private bool _isEditing;
	private int? _editingId;

	private bool _isLoading = true;
	private bool _isSaving;
	private string? _message;
	private bool _isError;

	private bool _showDeleteConfirm;
	private bool _isDeleting;
	private MasterItemDto? _deleteTarget;
	private string? _deleteApiBase;

	private string _searchText = "";
	private string _statusFilter = "All";

	private string? _currentUserId;

	protected override async Task OnInitializedAsync()
	{
		try
		{
			var token = await SessionStore.GetAsync(SessionKeys.Token);
			if (!string.IsNullOrEmpty(token))
			{
				_currentUserId = GetUserIdFromToken(token);
			}
		}
		catch { }

		await LoadAllLookups();
		ApplyFilter();
		_isLoading = false;
	}

	private async Task LoadAllLookups()
	{
		try
		{
			_isLoading = true;
			_plantsAll = await Http.GetFromJsonAsync<List<MasterItemDto>>("api/Plant/all") ?? new();
			_dealerNaturesAll = await Http.GetFromJsonAsync<List<MasterItemDto>>("api/DealershipNature/all") ?? new();
		}
		catch (Exception ex)
		{
			ShowMessage($"Failed to load: {ex.Message}", true);
		}
	}

	private async Task LoadTabData()
	{
		try
		{
			_isLoading = true;
			var items = await Http.GetFromJsonAsync<List<MasterItemDto>>($"{CurrentApiBase}/all") ?? new();

			switch (ActiveTab)
			{
				case "Plants": _plantsAll = items; break;
				case "Dealer Natures": _dealerNaturesAll = items; break;
			}

			ApplyFilter();
		}
		catch (Exception ex)
		{
			ShowMessage($"Failed to load: {ex.Message}", true);
		}
		finally
		{
			_isLoading = false;
		}
	}

	private void SetActiveTab(string tabName)
	{
		if (ActiveTab == tabName) return;
		ActiveTab = tabName;
		CancelDelete();
		_searchText = "";
		_statusFilter = "All";
		ResetForm();
		ApplyFilter();
	}

	private List<ExportColumn<MasterItemDto>> GetExportColumns()
	{
		return new List<ExportColumn<MasterItemDto>>
		{
			new ExportColumn<MasterItemDto> { Header = "S:No", ValueSelector = item => (_filteredItems.IndexOf(item) + 1).ToString() },
			new ExportColumn<MasterItemDto> { Header = $"{GetSingularName(ActiveTab)} Name", ValueSelector = item => item.Name },
			new ExportColumn<MasterItemDto> { Header = "Status", ValueSelector = item => item.IsActive ? "Active" : "Inactive" },
			new ExportColumn<MasterItemDto> { Header = "Created At", ValueSelector = item => item.CreatedAt.ToString("yyyy-MM-dd") }
		};
	}

	private void ApplyFilter()
	{
		_filteredItems = CurrentAllItems
			.Where(x => _statusFilter switch
			{
				"Active" => x.IsActive,
				"Inactive" => !x.IsActive,
				_ => true
			})
			.OrderByDescending(x => x.CreatedAt)
			.ToList();
	}

	private async Task HandleSave()
	{
		if (string.IsNullOrWhiteSpace(_formModel.Name))
		{
			ShowMessage($"{GetSingularName(ActiveTab)} name is required.", true);
			return;
		}

		try
		{
			_isSaving = true;

			HttpResponseMessage response;
			if (_isEditing && _editingId.HasValue)
			{
				response = await Http.PutAsJsonAsync($"{CurrentApiBase}/{_editingId.Value}", new
				{
					Id = _editingId.Value,
					Name = _formModel.Name,
					IsActive = _formModel.IsActive,
					UpdatedBy = (_currentUserId ?? "current-user")
				});

				if (!response.IsSuccessStatusCode)
				{
					var error = await response.Content.ReadAsStringAsync();
					ShowMessage($"Update failed: {error}", true);
					return;
				}
				ShowMessage($"{GetSingularName(ActiveTab)} updated successfully.", false);
			}
			else
			{
				response = await Http.PostAsJsonAsync(CurrentApiBase, new
				{
					Name = _formModel.Name,
					IsActive = _formModel.IsActive,
					CreatedAt = DateTime.Now,
					UpdatedAt = DateTime.Now,
					CreatedBy = (_currentUserId ?? "current-user"),
					UpdatedBy = (_currentUserId ?? "current-user")
				});

				if (!response.IsSuccessStatusCode)
				{
					var error = await response.Content.ReadAsStringAsync();
					ShowMessage($"Create failed: {error}", true);
					return;
				}
				ShowMessage($"{GetSingularName(ActiveTab)} created successfully.", false);
			}

			ResetForm();
			await LoadTabData();
		}
		catch (Exception ex)
		{
			ShowMessage($"Error: {ex.Message}", true);
		}
		finally
		{
			_isSaving = false;
		}
	}

	private async Task EditItem(MasterItemDto item)
	{
		_isEditing = true;
		_editingId = item.Id;
		_formModel = new MasterFormModel
		{
			Name = item.Name,
			IsActive = item.IsActive
		};

		try
		{
			await _firstInputRef.FocusAsync();
		}
		catch { }
	}

	private void DeleteItem(MasterItemDto item)
	{
		_deleteTarget = item;
		_deleteApiBase = CurrentApiBase;
		_showDeleteConfirm = true;
	}

	private async Task ConfirmDelete()
	{
		if (_deleteTarget is null || string.IsNullOrWhiteSpace(_deleteApiBase)) return;
		var target = _deleteTarget;
		var apiBase = _deleteApiBase;

		try
		{
			_isDeleting = true;
			var response = await Http.DeleteAsync($"{apiBase}/{target.Id}");
			if (response.IsSuccessStatusCode)
			{
				ShowMessage($"'{target.Name}' deleted successfully.", false);
				await LoadTabData();
			}
			else
			{
				var error = await response.Content.ReadAsStringAsync();
				ShowMessage($"Delete failed: {error}", true);
			}
		}
		catch (Exception ex)
		{
			ShowMessage($"Error: {ex.Message}", true);
		}
		finally
		{
			_isDeleting = false;
			CancelDelete();
		}
	}

	private void CancelDelete()
	{
		_showDeleteConfirm = false;
		_deleteTarget = null;
		_deleteApiBase = null;
	}

	private async Task ToggleStatus(MasterItemDto item)
	{
		try
		{
			var newStatus = !item.IsActive;
			var response = await Http.PatchAsync($"{CurrentApiBase}/{item.Id}/status?isActive={newStatus}", null);

			if (response.IsSuccessStatusCode)
			{
				item.IsActive = newStatus;
				ApplyFilter();
			}
			else
			{
				var error = await response.Content.ReadAsStringAsync();
				ShowMessage($"Status change failed: {error}", true);
			}
		}
		catch (Exception ex)
		{
			ShowMessage($"Error: {ex.Message}", true);
		}
	}

	private void ResetForm()
	{
		_formModel = new MasterFormModel();
		_isEditing = false;
		_editingId = null;
	}

	private string GetSingularName(string pluralName) => pluralName switch
	{
		"Plants" => "Plant",
		"Dealer Natures" => "Dealer Nature",
		_ => pluralName.TrimEnd('s')
	};

	private void ShowMessage(string message, bool isError)
	{
		_message = message;
		_isError = isError;
	}

	private string? GetUserIdFromToken(string token)
	{
		try
		{
			if (string.IsNullOrWhiteSpace(token)) return null;
			var raw = token.StartsWith("Bearer ") ? token.Substring("Bearer ".Length) : token;
			var parts = raw.Split('.');
			if (parts.Length < 2) return null;
			var payload = parts[1];
			switch (payload.Length % 4)
			{
				case 2: payload += "=="; break;
				case 3: payload += "="; break;
			}
			payload = payload.Replace('-', '+').Replace('_', '/');
			var json = System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(payload));
			using var doc = System.Text.Json.JsonDocument.Parse(json);
			var root = doc.RootElement;
			if (root.TryGetProperty("sub", out var sub)) return sub.GetString();
			if (root.TryGetProperty("nameid", out var nid)) return nid.GetString();
			if (root.TryGetProperty("http://schemas.xmlsoap.org/ws/2005/05/identity/claims/nameidentifier", out var id2)) return id2.GetString();
			if (root.TryGetProperty("spic:user_id", out var sup)) return sup.GetString();
		}
		catch { }
		return null;
	}

	public class MasterItemDto
	{
		public int Id { get; set; }
		public string Name { get; set; } = "";
		public bool IsActive { get; set; }
		public DateTime CreatedAt { get; set; }
		public DateTime UpdatedAt { get; set; }
		public string UpdatedBy { get; set; } = "";
	}

	public class MasterFormModel
	{
		public string Name { get; set; } = "";
		public bool IsActive { get; set; } = true;
	}
}
