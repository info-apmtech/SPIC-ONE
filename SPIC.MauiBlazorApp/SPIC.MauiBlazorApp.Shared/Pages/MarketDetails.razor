@page "/MarketDetails" 
@using System.Net.Http.Json
@inject HttpClient Http
   
<div class="container-fluid py-4 px-0">
	<FormLoader />
	<div class="company-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
		<h3 class="fw-bold m-0 company-title">Market Details</h3>
	</div>

	<div class="form-card">
		<!-- Header -->
		<div class="d-flex justify-content-between align-items-center py-3 flex-wrap gap-2">
			<div class="card-header-title mb-0">
				<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/WarehouseHeader.svg"
					 class="formicon" />
				Regional Blocks
			</div>

			<button class="btn-verified">
				<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/Verifiedicon.svg"
					 class="verifyicon" />
				Active Entry
			</button>
		</div>

		<div class="row g-3 mb-4">
			<div class="col-md-3">
				<label class="form-label-custom">Name Of Block</label>
				<select class="form-select-custom w-100">
					<option>Select Name Of Block</option>
				</select>
			</div>
			<div class="col-md-3">
				<label class="form-label-custom">Major Crops</label>
				<select class="form-select-custom w-100" @bind="_cropsForm.CropId">
					<option>Select Major Crops</option>
					@foreach (var crop in _cropsAll)
					{
						<option value="@crop.Id">@crop.CropName</option>
					}
				</select>
			</div>
			<div class="col-md-3">
				<label class="form-label-custom">No of Dealer</label>
				<input type="text" class="form-control-custom w-100" placeholder="Enter No of Dealer">
			</div>
			<div class="col-md-3">
				<label class="form-label-custom">No of Farmer</label>
				<input type="text" class="form-control-custom w-100" placeholder="Enter No of Farmer">
			</div>
		</div>

		<div class="row g-3 align-items-end">
			<div class="col-md-6">
				<label class="form-label-custom">Season From & To Month</label>
				<div class="row g-2">
					<div class="col-6">
						<select class="form-select-custom w-100">
							<option>From Month</option>
						</select>
					</div>
					<div class="col-6">
						<select class="form-select-custom w-100">
							<option>To Month</option>
						</select>
					</div>
				</div>
			</div>

			<div class="col-md-6">
				<label class="form-label-custom">Irrigation Type</label>
				<div class="d-flex justify-content-between align-items-center">
					<div class="irrigation-toggles">
						@foreach (var item in IrrigationOptions)
						{
							<label class="toggle-btn @(item.IsSelected ? "active" : "")"
								   @onclick="() => ToggleIrrigation(item)">
								<input type="checkbox" checked="@item.IsSelected" />
								<i class="bi @(item.IsSelected ? "bi-check-square-fill" : "bi-square")"></i>
								@item.Name
							</label>
						}
					</div>
				</div>
			</div>
			<div class="d-flex justify-content-end mt-3">
				<button class="btn btn-add" id="addExperienceBtn">
					<i class="bi bi-plus-lg"></i>
					Add Regional Blocks
				</button>
			</div>
		</div>
	</div>

	<div class="form-card">
		<div class="d-flex justify-content-between align-items-center mb-4">
			<div class="card-header-title mb-0">
				<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/Active .svg"
					 class="formicon" /> Added Market Details
			</div>
		</div>

		<div class="row g-4">
                
			<div class="col-md-6">
				<div class="block-card theme-yellow">
					<!-- ✅ Background image -->
					<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/CropBg.svg" class="block-card-bg" alt="bg" />

					<div class="block-card-header">
						<h3 class="block-title">
							<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/BlockImage.svg" alt="BlockImage" class="formicon" /> Block 1
						</h3>
						<div class="action-icons">
							<i class="bi bi-pencil-square icon-edit"></i>
							<i class="bi bi-trash icon-delete"></i>
						</div>
					</div>

					<div class="info-pill-container mb-3">
						<div class="info-pill">
							<div class="pill-label">Crops</div>
							<div class="pill-value">Wheat</div>
						</div>
						<div class="info-pill">
							<div class="pill-label">Irrigation</div>
							<div class="pill-value">Canal, Well/Borewell</div>
						</div>
						<div class="info-pill">
							<div class="pill-label">Season</div>
							<div class="pill-value">Mar - APR</div>
						</div>
					</div>
					<div class="info-pill-container">
						<div class="info-pill">
							<div class="pill-label">No of Dealer</div>
							<div class="pill-value">3</div>
						</div>
						<div class="info-pill">
							<div class="pill-label">No of Farmer</div>
							<div class="pill-value">5</div>
						</div>
					</div>
				</div>
			</div>

			<div class="col-md-6">
				<div class="block-card theme-green">
					<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/CropBg.svg" class="block-card-bg" alt="bg" />
					<div class="block-card-header">
						<h3 class="block-title">
							<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/BlockImage.svg" alt="BlockImage" class="formicon" /> Block 2
						</h3>
						<div class="action-icons">
							<i class="bi bi-pencil-square icon-edit"></i>
							<i class="bi bi-trash icon-delete"></i>
						</div>
					</div>

					<div class="info-pill-container mb-3">
						<div class="info-pill">
							<div class="pill-label">Crops</div>
							<div class="pill-value">Paddy</div>
						</div>
						<div class="info-pill">
							<div class="pill-label">Irrigation</div>
							<div class="pill-value">Canal, Well/Borewell</div>
						</div>
						<div class="info-pill">
							<div class="pill-label">Season</div>
							<div class="pill-value">Mar - 2026, APR - 2026</div>
						</div>
					</div>
					<div class="info-pill-container">
						<div class="info-pill">
							<div class="pill-label">No of Dealer</div>
							<div class="pill-value">3</div>
						</div>
						<div class="info-pill">
							<div class="pill-label">No of Farmer</div>
							<div class="pill-value">6</div>
						</div>
					</div>
				</div>
			</div>

		</div>
	</div>
	<CommanFooter />
</div>

@code {
	private List<IrrigationOption> IrrigationOptions = new()
	{
		new IrrigationOption { Name = "CANAL", IsSelected = true },
		new IrrigationOption { Name = "TANK", IsSelected = false },
		new IrrigationOption { Name = "WELL", IsSelected = false }
	};

	private void ToggleIrrigation(IrrigationOption item)
	{
		item.IsSelected = !item.IsSelected;
	}

	public class IrrigationOption
	{
		public string Name { get; set; } = string.Empty;
		public bool IsSelected { get; set; }
	}
	// Load DropDown
	private List<MarketDetailsItemDto> _cropsAll = new();
	private string CurrentApiBase => "api/Crop";

	private CropsFormModel _cropsForm = new();
	private string? _message;
	private bool _isError;

	protected override async Task OnInitializedAsync()
	{
		await LoadCrop();
	}

	private async Task LoadCrop()
	{
		try
		{
			_cropsAll = await Http.GetFromJsonAsync<List<MarketDetailsItemDto>>($"{CurrentApiBase}/all") ?? new();
		}
		catch (Exception ex)
		{
			ShowMessage($"Failed to load : {ex.Message}", true);
		}
	}

	private void ShowMessage(string message, bool isError)
	{
		_message = message;
		_isError = isError;
	}
	public class MarketDetailsItemDto
	{
		public int Id { get; set; }
		public string CropName { get; set; } = "";
	}
	public class CropsFormModel
	{
		public int CropId { get; set; }
	}
}
