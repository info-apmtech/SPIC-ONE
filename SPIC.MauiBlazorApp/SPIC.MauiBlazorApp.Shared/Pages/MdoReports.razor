@page "/MdoReports"
@using System.Net.Http.Json
@using SPIC.Core.DTOs
@inject SPIC.MauiBlazorApp.Shared.Services.ToastService Toast
@inject HttpClient Http

<div class="container-fluid py-4 px-0 mdr-page">

    <div class="mdr-header-row">
        <div>
            <h2 class="mdr-title">Reports</h2>
            <p class="mdr-subtitle">Region performance across tasks, soil samples, farmer coverage and sales.</p>
        </div>

        <div class="mdr-header-actions">
            <button type="button" class="mdr-btn mdr-btn-outline" @onclick="Refresh" disabled="@_isLoading">
                <i class="bi bi-arrow-clockwise"></i> Refresh
            </button>
        </div>
    </div>

    <div class="mdr-filter-card">
        <div class="mdr-filter-title"><i class="bi bi-funnel"></i> Report Filters</div>

        <div class="mdr-filter-grid">
            <div class="mdr-filter-field">
                <label class="mdr-field-label" for="mdr-report-type">Report Type</label>
                <select id="mdr-report-type" class="mdr-select" @bind="reportType">
                    <option>Task Summary</option>
                    <option>Soil Sample Report</option>
                    <option>Farmer Coverage</option>
                    <option>Sales Report</option>
                </select>
            </div>
            <div class="mdr-filter-field">
                <label class="mdr-field-label" for="mdr-jmdo">JMDO</label>
                <select id="mdr-jmdo" class="mdr-select" @bind="jmdoFilter">
                    <option>All JMDOs</option>
                    @foreach (var jmdo in JmdoNames)
                    {
                        <option>@jmdo</option>
                    }
                </select>
            </div>
            <div class="mdr-filter-field">
                <label class="mdr-field-label" for="mdr-date-range">On or after</label>
                <input id="mdr-date-range" type="date" class="mdr-select" @bind="dateRange" />
            </div>
        </div>

        <div class="mdr-filter-footer">
            <button type="button" class="mdr-btn mdr-btn-primary" @onclick="GenerateReport">
                Generate Report
            </button>
        </div>
    </div>

    <div class="mdr-stats-grid">
        <div class="mdr-stat-card mdr-stat-tasks">
            <div class="mdr-stat-top">
                <span class="mdr-stat-label">Tasks Closed</span>
                <span class="mdr-stat-icon"><i class="bi bi-clipboard"></i></span>
            </div>
            <div class="mdr-stat-number">@(_report?.TasksClosedThisMonth ?? 0)</div>
            <div class="mdr-stat-desc">This month</div>
        </div>

        <div class="mdr-stat-card mdr-stat-turnaround">
            <div class="mdr-stat-top">
                <span class="mdr-stat-label">Avg. Turnaround</span>
                <span class="mdr-stat-icon"><i class="bi bi-clock"></i></span>
            </div>
            <div class="mdr-stat-number">@AvgTurnaroundText</div>
            <div class="mdr-stat-desc">Assign to close</div>
        </div>

        <div class="mdr-stat-card mdr-stat-soil">
            <div class="mdr-stat-top">
                <span class="mdr-stat-label">Soil Samples</span>
                <span class="mdr-stat-icon"><i class="bi bi-eyedropper"></i></span>
            </div>
            <div class="mdr-stat-number">@(_report?.SoilSamplesThisMonth ?? 0)</div>
            <div class="mdr-stat-desc">Free + paid, this month</div>
        </div>

        <div class="mdr-stat-card mdr-stat-farmers">
            <div class="mdr-stat-top">
                <span class="mdr-stat-label">Farmers Covered</span>
                <span class="mdr-stat-icon"><i class="bi bi-person-plus"></i></span>
            </div>
            <div class="mdr-stat-number">@(_report?.FarmersCoveredAllTime ?? 0)</div>
            <div class="mdr-stat-desc">Region-wide</div>
        </div>
    </div>

    <SpicDataTable Items="FilteredJmdoSummaries"
                   IsLoading="_isLoading"
                   Title="JMDO-wise summary"
                   FileName="JmdoSummary"
                   ExportColumns="GetSummaryExportColumns()"
                   SearchText="@_summarySearchText"
                   EmptyTitle="@(AllJmdoSummaries.Count == 0 ? "No JMDOs found for your headquarters" : null)">
        <FilterControls>
            <input type="text" class="mdr-select mdr-quick-search"
                   placeholder="Search..."
                   @bind="_summarySearchText" @bind:event="oninput" @bind:after="StateHasChanged" />
        </FilterControls>
        <TableHeader>
            <th>JMDO</th>
            <th>Tasks Closed</th>
            <th>On-time %</th>
            <th>Soil Samples</th>
            <th>Farmers Added</th>
        </TableHeader>
        <TableRow Context="row">
            <td class="mdr-jmdo-name mdr-cell-header">@row.JmdoName</td>
            <td data-label="Tasks Closed">@row.TasksClosedThisMonth</td>
            <td data-label="On-time %">@(row.OnTimePercent is { } pct ? $"{pct:0}%" : "—")</td>
            <td data-label="Soil Samples">@row.SoilSamplesThisMonth</td>
            <td data-label="Farmers Added">@row.FarmersAddedThisMonth</td>
        </TableRow>
    </SpicDataTable>

    @if (reportType is "Farmer Coverage" or "Sales Report")
    {
        <div class="mdr-table-card">
            <h3 class="mdr-table-title">Detailed Task Report</h3>
            <p class="mdr-table-subtitle">
                @(reportType == "Farmer Coverage"
                    ? "Farmer coverage is summarized above (Farmers Covered / Farmers Added) - there's no per-task breakdown to show here."
                    : "Sales data isn't part of the JMDO task system yet, so there's nothing to show here.")
            </p>
        </div>
    }
    else
    {
        <SpicDataTable Items="FilteredDetailedTasks"
                       IsLoading="_isLoading"
                       Title="Detailed Task Report"
                       FileName="DetailedTaskReport"
                       ExportColumns="GetDetailExportColumns()"
                       SearchText="@_detailSearchText"
                       EmptyTitle="@(AllDetailedTasks.Count == 0 ? "No tasks closed out this month yet" : null)">
            <FilterControls>
                <input type="text" class="mdr-select mdr-quick-search"
                       placeholder="Search..."
                       @bind="_detailSearchText" @bind:event="oninput" @bind:after="StateHasChanged" />
            </FilterControls>
            <TableHeader>
                <th>JMDO</th>
                <th>Type</th>
                <th>Task Summary</th>
                <th>Resolution</th>
                <th>Status</th>
                <th>Hours Taken</th>
            </TableHeader>
            <TableRow Context="row">
                <td class="mdr-jmdo-name mdr-cell-header">@row.JmdoName</td>
                <td data-label="Type"><span class="mdr-type-pill @TypeClassFor(row.Type)">@row.Type</span></td>
                <td data-label="Task Summary">@row.Summary</td>
                <td class="mdr-resolution" data-label="Resolution">@row.Resolution</td>
                <td data-label="Status"><span class="mdr-status @StatusClassFor(row.Status)"><span class="mdr-status-dot"></span>@row.Status</span></td>
                <td data-label="Hours Taken">@(row.HoursTaken is { } h ? h.ToString("0.#") : "—")</td>
            </TableRow>
        </SpicDataTable>
    }

</div>

@code {
    private bool _isLoading = true;
    private MdoTeamReportsDto? _report;

    // ---- Filters: staged values bound to the inputs, only applied to the tables when
    // "Generate Report" is clicked - same "edit freely, only apply on demand" convention
    // TasksAllocation/TaskMonitoring's own filter bars use. ----
    private string reportType = "Task Summary";
    private string jmdoFilter = "All JMDOs";
    private DateTime? dateRange;

    private string appliedJmdo = "All JMDOs";
    private DateTime? appliedDateRange;

    private string _summarySearchText = "";
    private string _detailSearchText = "";

    private List<MdoReportJmdoSummaryRowDto> AllJmdoSummaries => _report?.JmdoSummaries ?? new();
    private List<MdoReportDetailRowDto> AllDetailedTasks => _report?.DetailedTasks ?? new();

    private IEnumerable<string> JmdoNames =>
        AllJmdoSummaries.Select(s => s.JmdoName).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(n => n);

    private string AvgTurnaroundText => _report?.AvgTurnaroundDays is { } d ? $"{d:0.#} days" : "—";

    private List<MdoReportJmdoSummaryRowDto> FilteredJmdoSummaries =>
        AllJmdoSummaries.Where(r => appliedJmdo == "All JMDOs" || string.Equals(r.JmdoName, appliedJmdo, StringComparison.OrdinalIgnoreCase)).ToList();

    // Report Type narrows the detailed table by task Type - "Task Summary" (the default) shows
    // every kind; Farmer Coverage/Sales Report have no per-task breakdown at all (see the markup
    // above, which skips this table entirely for those two).
    private List<MdoReportDetailRowDto> FilteredDetailedTasks =>
        AllDetailedTasks.Where(r =>
            (appliedJmdo == "All JMDOs" || string.Equals(r.JmdoName, appliedJmdo, StringComparison.OrdinalIgnoreCase)) &&
            (appliedDateRange == null || r.TaskDate.Date >= appliedDateRange.Value.Date) &&
            (reportType != "Soil Sample Report" || r.Type == "Soil Sample"))
        .ToList();

    private static string TypeClassFor(string type) => type switch
    {
        "Dealer" => "mdr-type-green",
        "SPCM" => "mdr-type-blue",
        "MD Program" => "mdr-type-blue",
        "Soil Sample" => "mdr-type-orange",
        "PoS Liquidation" => "mdr-type-grey",
        _ => "mdr-type-blue"
    };

    private static string StatusClassFor(string status) => status switch
    {
        "In Progress" => "mdr-status-progress",
        "Not Started" => "mdr-status-notstarted",
        _ when status.Contains("Partially", StringComparison.OrdinalIgnoreCase) => "mdr-status-partial",
        _ when status.Contains("Not Completed", StringComparison.OrdinalIgnoreCase) => "mdr-status-partial",
        _ => "mdr-status-completed"
    };

    private List<ExportColumn<MdoReportJmdoSummaryRowDto>> GetSummaryExportColumns() => new()
    {
        new() { Header = "JMDO", ValueSelector = r => r.JmdoName },
        new() { Header = "Tasks Closed", ValueSelector = r => r.TasksClosedThisMonth.ToString() },
        new() { Header = "On-time %", ValueSelector = r => r.OnTimePercent is { } pct ? $"{pct:0}%" : "" },
        new() { Header = "Soil Samples", ValueSelector = r => r.SoilSamplesThisMonth.ToString() },
        new() { Header = "Farmers Added", ValueSelector = r => r.FarmersAddedThisMonth.ToString() }
    };

    private List<ExportColumn<MdoReportDetailRowDto>> GetDetailExportColumns() => new()
    {
        new() { Header = "JMDO", ValueSelector = r => r.JmdoName },
        new() { Header = "Type", ValueSelector = r => r.Type },
        new() { Header = "Task Summary", ValueSelector = r => r.Summary },
        new() { Header = "Resolution", ValueSelector = r => r.Resolution },
        new() { Header = "Status", ValueSelector = r => r.Status },
        new() { Header = "Hours Taken", ValueSelector = r => r.HoursTaken is { } h ? h.ToString("0.#") : "" }
    };

    private void Refresh() => _ = LoadReportAsync();

    private void GenerateReport()
    {
        appliedJmdo = jmdoFilter;
        appliedDateRange = dateRange;

        if (reportType == "Sales Report")
            Toast.Info("Sales data isn't part of the JMDO task system yet - showing the other reports only.");
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadReportAsync();
    }

    private async Task LoadReportAsync()
    {
        _isLoading = true;
        try
        {
            _report = await Http.GetFromJsonAsync<MdoTeamReportsDto>("api/Team/reports");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"MdoReports load failed: {ex.Message}");
            Toast.Error("Could not load reports. Please try again.");
        }
        finally
        {
            _isLoading = false;
        }
    }
}
