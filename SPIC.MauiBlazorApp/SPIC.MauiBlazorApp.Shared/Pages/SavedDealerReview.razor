    private string GetCurrentStageTarget()
    {
        if (LoginState == null) return "Review";
        if (LoginState.IsRMGroup) return "RM Review";
        if (LoginState.IsSMGroup) return "SM Review";
        if (LoginState.IsDirectorOrAVP || LoginState.IsAdmin) return "AVP Review";
        return "Review";
    }

    private string GetNextStageTarget()
    {
        if (LoginState == null) return "Next Stage";
        if (LoginState.IsRMGroup) return "State Manager (SM) Review";
        if (LoginState.IsSMGroup) return "AVP Review";
        if (LoginState.IsDirectorOrAVP || LoginState.IsAdmin) return "Final Approval";
        return "Next Stage";
    }

    private async Task ApproveDealer()
    {
        if (_dealer == null) return;

        _isApproving = true;
        StateHasChanged(); 

        try
        {
            if (LoginState.IsRMGroup)
            {
                // RM approves -> mark RM approved and reset downstream approvals so it moves to SM queue
                _dealer.RMApproved = true;
                _dealer.SMApproved = null;
            }
            else if (LoginState.IsSMGroup)
            {
                // SM approves -> mark SM approved and reset AVP approval so it moves to AVP queue
                _dealer.SMApproved = true;
                _dealer.AVPApproved = null;
            }
            else if (LoginState.IsDirectorOrAVP || LoginState.IsAdmin)
            {
                _dealer.AVPApproved = true;
                _dealer.Status = DR.DealerStatus.Active;
            }

            var response = await Http.PutAsJsonAsync($"api/DealerRegistration/{_dealer.Id}", _dealer);

            if (response.IsSuccessStatusCode)
            {
                IsConfirmProceedPopupVisible = false;
                Nav.NavigateTo("/Dashboard");
            }
        }
        finally
        {
            _isApproving = false;
            StateHasChanged();
        }
    }


