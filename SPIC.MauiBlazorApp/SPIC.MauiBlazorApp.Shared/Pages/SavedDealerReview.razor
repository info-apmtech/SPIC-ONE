                        <div class="detail-card-header">
                            <h4 class="detail-card-title"><i class="bi bi-buildings"></i> Infrastructure</h4>
                            <i class="bi bi-pencil-square edit-icon"></i>
                        </div>
                        <div class="detail-card-body">
                            <div class="data-row"><div class="data-label">Own Godown Capacity:</div><div class="data-value">@(_dealer?.OwnGodownCapacity ?? 0) MT</div></div>
                            <div class="data-row"><div class="data-label">Rent Godown Capacity:</div><div class="data-value">@(_dealer?.RentGodownCapacity ?? 0) MT</div></div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="detail-card">
                        <div class="detail-card-header">
                            <h4 class="detail-card-title"><i class="bi bi-bank"></i> Loan Liabilities</h4>
                            <i class="bi bi-pencil-square edit-icon"></i>
                        </div>
                        <div class="detail-card-body">
                            @if (_loans != null && _loans.Any())
                            {
                                foreach (var ln in _loans)
                                {
                                    <div class="data-row"><div class="data-label">Loan Source / Institution:</div><div class="data-value">@ln.LoanSource</div></div>
                                    <div class="data-row"><div class="data-label">Loan Value:</div><div class="data-value">@ln.LoanValue</div></div>
                                    <div class="data-row"><div class="data-label">Remarks:</div><div class="data-value">@ln.Remarks</div></div>
                                    <div class="mb-2"></div>
                                }
                            }
                            else
                            {
                                <div class="data-row"><div class="data-label">Loans</div><div class="data-value">None</div></div>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="detail-card">
                        <div class="detail-card-header">
                            <h4 class="detail-card-title"><i class="bi bi-bar-chart"></i> Net Financial Position</h4>
                            <i class="bi bi-pencil-square edit-icon"></i>
                        </div>
                        <div class="detail-card-body">
                            <div class="data-row"><div class="data-label">Capital Position:</div><div class="data-value">@($"₹{GetCapitalPosition():N0}")</div></div>
                            <div class="data-row"><div class="data-label">Assets:</div><div class="data-value">@($"₹{GetTotalAssets():N0}")</div></div>
                            <div class="data-row"><div class="data-label">Loans:</div><div class="data-value">@($"₹{GetTotalLoans():N0}")</div></div>
                            <div class="data-row"><div class="data-label">Net Value:</div><div class="data-value">@($"₹{GetNetValue():N0}")</div></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="custom-accordion @(IsCreditLimitOpen ? "active" : "")">
        <div class="accordion-header" @onclick="() => IsCreditLimitOpen = !IsCreditLimitOpen">
            Credit Limit Proposal
            <i class="bi bi-chevron-down"></i>
        </div>
        <div class="accordion-body">
            <div class="row g-4">
                @if (_creditProposal != null)
                {
                    <div class="col-md-6">
                        <div class="detail-card">
                            <div class="detail-card-header">
                                <h4 class="detail-card-title"><i class="bi bi-credit-card"></i> Existing Credit Limit</h4>
                                <i class="bi bi-pencil-square edit-icon"></i>
                            </div>
                            <div class="detail-card-body">
                                <div class="data-row"><div class="data-label">Amount:</div><div class="data-value">₹@_creditProposal.ExistingCreditLimitAmount.ToString("N2")</div></div>
                                <div class="data-row"><div class="data-label">From:</div><div class="data-value">@_creditProposal.ExistingCreditLimitFrom.ToString("dd MMM yyyy")</div></div>
                                <div class="data-row"><div class="data-label">To:</div><div class="data-value">@_creditProposal.ExistingCreditLimitTo.ToString("dd MMM yyyy")</div></div>
                                <div class="data-row"><div class="data-label">Additional Credit Limit:</div><div class="data-value">₹@_creditProposal.AdditionalCreditLimit.ToString("N2")</div></div>
                                <div class="data-row"><div class="data-label">Greenstar Additional:</div><div class="data-value">₹@_creditProposal.GreenstarAdditionalCreditLimit.ToString("N2")</div></div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="detail-card">
                            <div class="detail-card-header">
                                <h4 class="detail-card-title"><i class="bi bi-calendar-week"></i> Fiscal Years</h4>
                                <i class="bi bi-pencil-square edit-icon"></i>
                            </div>
                            <div class="detail-card-body">
                                <div class="data-row"><div class="data-label">FY1:</div><div class="data-value">@_creditProposal.FY1</div></div>
                                <div class="data-row"><div class="data-label">FY2:</div><div class="data-value">@_creditProposal.FY2</div></div>
                                <div class="data-row"><div class="data-label">FY3:</div><div class="data-value">@_creditProposal.FY3</div></div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="detail-card">
                            <div class="detail-card-header">
                                <h4 class="detail-card-title"><i class="bi bi-clipboard-data"></i> Performance Marks (Q1-Q11)</h4>
                                <i class="bi bi-pencil-square edit-icon"></i>
                            </div>
                            <div class="table-responsive">
                                <table class="sales-table">
                                    <thead>
                                        <tr>
                                            <th>Parameter</th>
                                            <th>Q1</th><th>Q2</th><th>Q3</th><th>Q4</th><th>Q5</th><th>Q6</th>
                                            <th>Q7</th><th>Q8</th><th>Q9</th><th>Q10</th><th>Q11</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td>Product Marks</td>
                                            <td>@_creditProposal.Q1Mark</td><td>@_creditProposal.Q2Mark</td>
                                            <td>@_creditProposal.Q3Mark</td><td>@_creditProposal.Q4Mark</td>
                                            <td>@_creditProposal.Q5Mark</td><td>@_creditProposal.Q6Mark</td>
                                            <td>@_creditProposal.Q7Mark</td><td>@_creditProposal.Q8Mark</td>
                                            <td>@_creditProposal.Q9Mark</td><td>@_creditProposal.Q10Mark</td>
                                            <td>@_creditProposal.Q11Mark</td>
                                        </tr>
                                        <tr>
                                            <td>Group Marks</td>
                                            <td>@_creditProposal.GQ1Mark</td><td>@_creditProposal.GQ2Mark</td>
                                            <td>@_creditProposal.GQ3Mark</td><td>@_creditProposal.GQ4Mark</td>
                                            <td>@_creditProposal.GQ5Mark</td><td>@_creditProposal.GQ6Mark</td>
                                            <td>@_creditProposal.GQ7Mark</td><td>@_creditProposal.GQ8Mark</td>
                                            <td>@_creditProposal.GQ9Mark</td><td>@_creditProposal.GQ10Mark</td>
                                            <td>@_creditProposal.GQ11Mark</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="detail-card">
                            <div class="detail-card-header">
                                <h4 class="detail-card-title"><i class="bi bi-bank2"></i> SPIC Securities</h4>
                                <i class="bi bi-pencil-square edit-icon"></i>
                            </div>
                            <div class="detail-card-body">
                                <div class="data-row"><div class="data-label">FD Number:</div><div class="data-value">@(_creditProposal.SpicFDNumber ?? "-")</div></div>
                                <div class="data-row"><div class="data-label">FD Details:</div><div class="data-value">@(_creditProposal.SpicFDOtherDetails ?? "-")</div></div>
                                <div class="data-row"><div class="data-label">FD Amount:</div><div class="data-value">₹@_creditProposal.SpicFDAmount.ToString("N2")</div></div>
                                <div class="data-row"><div class="data-label">BG Number:</div><div class="data-value">@(_creditProposal.SpicBGNumber ?? "-")</div></div>
                                <div class="data-row"><div class="data-label">BG Details:</div><div class="data-value">@(_creditProposal.SpicBGOtherDetails ?? "-")</div></div>
                                <div class="data-row"><div class="data-label">BG Amount:</div><div class="data-value">₹@_creditProposal.SpicBGAmount.ToString("N2")</div></div>
                                <div class="data-row"><div class="data-label">Collateral Number:</div><div class="data-value">@(_creditProposal.SpicCollateralNumber ?? "-")</div></div>
                                <div class="data-row"><div class="data-label">Collateral Details:</div><div class="data-value">@(_creditProposal.SpicCollateralOtherDetails ?? "-")</div></div>
                                <div class="data-row"><div class="data-label">Collateral Amount:</div><div class="data-value">₹@_creditProposal.SpicCollateralAmount.ToString("N2")</div></div>
                                <div class="data-row"><div class="data-label">Trade Deposit Number:</div><div class="data-value">@(_creditProposal.SpicTradeDepositNumber ?? "-")</div></div>
                                <div class="data-row"><div class="data-label">Trade Deposit Details:</div><div class="data-value">@(_creditProposal.SpicTradeDepositOtherDetails ?? "-")</div></div>
                                <div class="data-row"><div class="data-label">Trade Deposit Amount:</div><div class="data-value">₹@_creditProposal.SpicTradeDepositAmount.ToString("N2")</div></div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="detail-card">
                            <div class="detail-card-header">
                                <h4 class="detail-card-title"><i class="bi bi-bank2"></i> Greenstar Securities</h4>
                                <i class="bi bi-pencil-square edit-icon"></i>
                            </div>
                            <div class="detail-card-body">
                                <div class="data-row"><div class="data-label">FD Number:</div><div class="data-value">@(_creditProposal.GreenstarFDNumber ?? "-")</div></div>
                                <div class="data-row"><div class="data-label">FD Details:</div><div class="data-value">@(_creditProposal.GreenstarFDOtherDetails ?? "-")</div></div>
                                <div class="data-row"><div class="data-label">FD Amount:</div><div class="data-value">₹@_creditProposal.GreenstarFDAmount.ToString("N2")</div></div>
                                <div class="data-row"><div class="data-label">BG Number:</div><div class="data-value">@(_creditProposal.GreenstarBGNumber ?? "-")</div></div>
                                <div class="data-row"><div class="data-label">BG Details:</div><div class="data-value">@(_creditProposal.GreenstarBGOtherDetails ?? "-")</div></div>
                                <div class="data-row"><div class="data-label">BG Amount:</div><div class="data-value">₹@_creditProposal.GreenstarBGAmount.ToString("N2")</div></div>
                                <div class="data-row"><div class="data-label">Collateral Number:</div><div class="data-value">@(_creditProposal.GreenstarCollateralNumber ?? "-")</div></div>
                                <div class="data-row"><div class="data-label">Collateral Details:</div><div class="data-value">@(_creditProposal.GreenstarCollateralOtherDetails ?? "-")</div></div>
                                <div class="data-row"><div class="data-label">Collateral Amount:</div><div class="data-value">₹@_creditProposal.GreenstarCollateralAmount.ToString("N2")</div></div>
                                <div class="data-row"><div class="data-label">Trade Deposit Number:</div><div class="data-value">@(_creditProposal.GreenstarTradeDepositNumber ?? "-")</div></div>
                                <div class="data-row"><div class="data-label">Trade Deposit Details:</div><div class="data-value">@(_creditProposal.GreenstarTradeDepositOtherDetails ?? "-")</div></div>
                                <div class="data-row"><div class="data-label">Trade Deposit Amount:</div><div class="data-value">₹@_creditProposal.GreenstarTradeDepositAmount.ToString("N2")</div></div>
                            </div>
                        </div>
                    </div>

                    @if (_creditSales != null && _creditSales.Any())
                    {
                        <div class="col-12">
                            <div class="detail-card">
                                <div class="detail-card-header">
                                    <h4 class="detail-card-title"><i class="bi bi-graph-up"></i> Sales Performance</h4>
                                    <i class="bi bi-pencil-square edit-icon"></i>
                                </div>
                                <div class="table-responsive">
                                    <table class="sales-table">
                                        <thead>
                                            <tr>
                                                <th>Product</th>
                                                <th>Category</th>
                                                <th>FY1 Qty</th>
                                                <th>FY1 Amount</th>
                                                <th>FY2 Qty</th>
                                                <th>FY2 Amount</th>
                                                <th>FY3 Qty</th>
                                                <th>FY3 Amount</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var s in _creditSales)
                                            {
                                                var pName = _productNames.ContainsKey(s.ProductId) ? _productNames[s.ProductId] : s.ProductId.ToString();
                                                var catName = _categories.FirstOrDefault(c => c.Id == s.CategoryId)?.Name ?? s.CategoryId.ToString();
                                                <tr>
                                                    <td>@pName</td>
                                                    <td>@catName</td>
                                                    <td>@s.FY1Qty.ToString("N2")</td>
                                                    <td>₹@s.FY1Amount.ToString("N2")</td>
                                                    <td>@s.FY2Qty.ToString("N2")</td>
                                                    <td>₹@s.FY2Amount.ToString("N2")</td>
                                                    <td>@s.FY3Qty.ToString("N2")</td>
                                                    <td>₹@s.FY3Amount.ToString("N2")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12">
                        <div class="detail-card">
                            <div class="detail-card-body">
                                <div class="data-row"><div class="data-label">Credit Limit Proposal</div><div class="data-value">No proposal data available</div></div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="custom-accordion @(IsEnclosuresOpen ? "active" : "")">
        <div class="accordion-header" @onclick="() => IsEnclosuresOpen = !IsEnclosuresOpen">
            Enclosures 
            <i class="bi bi-chevron-down"></i>
        </div>
        <div class="accordion-body">
            <div class="detail-card">
                <div class="detail-card-header">
                    <h4 class="detail-card-title"><i class="bi bi-folder-check"></i> Submitted Documents</h4>
                    <i class="bi bi-pencil-square edit-icon"></i>
                </div>
                <div class="enclosure-grid">
                    @if (_documents != null)
                    {
                        @((MarkupString)GetEnclosureHtml())
                    }
                    else
                    {
                        <div class="enclosure-btn">No documents submitted</div>
                    }
                </div>
            </div>
        </div>
    </div>



@if (CanShowApprovalButton())
{
    <div class="d-flex justify-content-end gap-2 mt-3 mb-5 px-4">

      <button type="button"
            class="btn btn-outline-warning px-3"
            @onclick="@ShowSendBackPopup">
        <i class="bi bi-arrow-counterclockwise me-1"></i> Send Back
    </button>
        
      <button class="btn-submit px-3" @onclick="ShowConfirmProceedPopup" disabled="@_isApproving">
        @(_isApproving ? "Processing..." : ApprovalButtonText())
    </button>
    </div>
}