        <div class="accordion-body">
            <div class="detail-card">
                <div class="detail-card-header">
                    <h4 class="detail-card-title"><i class="bi bi-file-earmark-spreadsheet"></i> Last Financial Year</h4>
                    <i class="bi bi-pencil-square edit-icon"></i>
                </div>
                <div class="table-responsive">
                    <table class="sales-table">
                        <thead>
                            <tr>
                                <th>S:No</th>
                                <th>Product</th>
                                <th>Own Retail Sales (MT)</th>
                                <th>Sales to Dealers (MT)</th>
                                <th>Total (MT)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_annualSales != null && _annualSales.Any())
                            {
                                var idx = 1;
                                foreach (var a in _annualSales)
                                {
                                    <tr>
                                        <td>@idx</td>
                                        <td>@a.ProductId</td>
                                        <td>@a.OwnRetailsSaleQty</td>
                                        <td>@a.SaleToDealerQty</td>
                                        <td>@(a.OwnRetailsSaleQty + a.SaleToDealerQty)</td>
                                    </tr>
                                    idx++;
                                }
                                <tr class="grand-total-row">
                                    <td colspan="2" style="text-align: right; padding-right: 40px;">GRAND TOTAL</td>
                                    <td>@_annualSales.Sum(x => x.OwnRetailsSaleQty) MT</td>
                                    <td>@_annualSales.Sum(x => x.SaleToDealerQty) MT</td>
                                    <td>@(_annualSales.Sum(x => x.OwnRetailsSaleQty + x.SaleToDealerQty)) MT</td>
                                </tr>
                            }
                            else
                            {
                                <tr><td colspan="5">No annual sales data</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

