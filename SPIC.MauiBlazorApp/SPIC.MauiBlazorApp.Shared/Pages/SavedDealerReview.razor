@page "/SavedDealerReview"
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components
@using DR = SPIC.Core.Entities
@inject HttpClient Http
@inject NavigationManager Nav
@inject LoadingService Loading
@inject LoginState LoginState
@inject IJSRuntime JS
@inject ToastService Toast

@*
    Review screen for one dealer registration.

    This page used to carry every section's markup inline (~4,000 lines), so any state change —
    opening an accordion, typing in the approval popup — re-rendered the whole tree. The sections
    now live in Shared/Pages/DealerReview/ and each one skips rendering while its own parameters
    are unchanged (see DealerReviewSectionBase). The page keeps all of the behaviour: it owns the
    loading order, the accordion flags, the approve / send-back actions and every permission check.

    Two things exist purely so the sections can tell "nothing changed" from "reloaded":
      * _figures  — one DealerReviewFigures instance, rebuilt only when the data behind it changes.
      * _dataVersion — bumped wherever the page mutates already-loaded data in place (approval
        writes the RM/SM/AVP flags onto the existing registration object, and the user-name
        dictionary is filled during load), which reference comparison alone cannot see.
*@

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "dealerId")]
    public int? dealerId { get; set; }

    private DR.DealerRegistration? _dealer;
    private bool _isLoading = false;
    private bool _isTerminatedRestricted =>
        _dealer?.Status == DR.DealerStatus.Terminated ||
        (_dealer?.Status == DR.DealerStatus.InActive && _dealer?.InactiveProposal == DR.FutureBusinessProposal.Terminated && _dealer?.IsDealer != true);

    private bool _isNotTraceableRestricted =>
        _dealer?.Status == DR.DealerStatus.InActive && _dealer?.InactiveProposal == DR.FutureBusinessProposal.NotTraceable;

    private bool _isInactiveTerminatedRestricted =>
        _dealer?.Status == DR.DealerStatus.InActive && _dealer?.InactiveProposal == DR.FutureBusinessProposal.Terminated && _dealer?.IsDealer == true;

    private bool _isDepartmentDealer =>
        _dealer?.DealerType == DR.RegistrationDealerType.Department;

    private bool _showBusinessInfo =>
        !_isTerminatedRestricted && !_isNotTraceableRestricted && !_isInactiveTerminatedRestricted && !_isDepartmentDealer;

    private bool _showProprietorAndInvestment =>
        !_isTerminatedRestricted && !_isNotTraceableRestricted && !_isDepartmentDealer;

    private bool _showEnclosures =>
        !_isTerminatedRestricted && !_isNotTraceableRestricted && !_isInactiveTerminatedRestricted && !_isDepartmentDealer;

    // Only the INITIAL New Dealer approval (before DealerCode allocation) uses the
    // trade-deposit/no-credit-limit review path. After first AVP approval the permanent
    // IsNewDealerRegistration flag remains true, but a record with DealerCode is handled
    // like an Existing Dealer for future maintenance/re-approval so Credit Limit values
    // are reviewed and the DealerCode is never generated again.
    private bool _isNewDealer =>
        _dealer?.IsNewDealerRegistration == true &&
        string.IsNullOrWhiteSpace(_dealer?.DealerCode);

    // Display-only identity for every registration that originated from the New Dealer flow.
    // Keep this separate from _isNewDealer because _isNewDealer intentionally means only the
    // first approval cycle before DealerCode allocation. Approved New Dealers and their later
    // Existing Dealer maintenance/re-approval cycles must still show the originally saved
    // New Dealer application fee / trade-deposit values.
    private bool _showNewDealerSavedDetails =>
        _dealer?.IsNewDealerRegistration == true || DealerReviewFormat.HasNewDealerRegistrationEvidence(_dealer);

    // Credit Limit fields in the Approval popup are shown only for the
    // company/companies the dealer registered with. Dealers with missing or null
    // company info fall back to showing no credit limit fields safely.
    private bool _showSpicCreditLimit =>
        _dealer?.InSpic == true;

    private bool _showGreenstarCreditLimit =>
        _dealer?.InGreenStar == true;

    // Related data
    private List<DR.DealerExperience> _experiences = new();
    private List<DR.AnnualSaleDataLastFYofDealerRegistration> _annualSales = new();
    private List<DR.DealerWarehouseFacilities> _warehouses = new();
    private List<DR.DealerRailFacilities> _rails = new();
    private List<DR.DealerPortFacilities> _ports = new();
    private List<DR.DealerMarketDetail> _marketDetails = new();
    private List<DR.DealerCompaniesOperatingInArea> _companies = new();
    private DR.DealerOwnershipInfo? _ownership;
    private List<DR.DealerOwnershipInfo> _ownershipList = new();
    private List<DR.PartnerFamilyDetails> _partners = new();
    private List<DR.PartnerOccupation> _occupations = new();
    private List<DR.SalesPlanningInDealerRegistration> _salesPlanning = new();
    private List<DR.DealerAssetBank> _assetBanks = new();
    private List<DR.DealerAssetLand> _assetLands = new();
    private List<DR.DealerAssetBuilding> _assetBuildings = new();
    private List<DR.DealerLoanLiabilities> _loans = new();
    private DR.DealerCreditLimitProposal? _creditProposal;
    private List<DR.DealerCreditLimitSalesPerformance> _creditSales = new();
    private DR.DealerRegistrationDocuments? _documents;
    private List<DR.DealerApprovalHistory> _approvalHistory = new();
    private List<DR.DealerCreditLimitSales> _creditLimitSalesData = new();
    private List<DR.Competitor> _competitors = new();
    private Dictionary<string, string> _competitorNames = new();
    private Dictionary<string, string> _warehouseNames = new();
    private Dictionary<string, string> _railFacilitiesNames = new();
    private Dictionary<string, string> _portNames = new();
    private Dictionary<string, string> _cropNames = new();
    private Dictionary<int, string> _financialYearNames = new();

    private string? _submittedByName;
    private string? _submittedByRole;
    private string SubmittedByRoleDisplay => string.IsNullOrWhiteSpace(_submittedByRole) ? "-" : _submittedByRole!;
    private Dictionary<string, string> _userNames = new();
    private List<UserInfoDto> _users = new();

    private decimal? _rmCreditLimitSpic;
    private decimal? _rmCreditLimitGfl;
    private decimal? _smCreditLimitSpic;
    private decimal? _smCreditLimitGfl;
    private decimal? _avpCreditLimitSpic;
    private decimal? _avpCreditLimitGfl;
    private decimal? _previousRmCreditLimitGfl;
