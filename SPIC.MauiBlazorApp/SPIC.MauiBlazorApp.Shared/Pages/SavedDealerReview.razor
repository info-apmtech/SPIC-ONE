    <div class="custom-accordion @(IsSalesPlanningOpen ? "active" : "")">
        <div class="accordion-header" @onclick="() => IsSalesPlanningOpen = !IsSalesPlanningOpen">
            Sales Planning & Forecast
            <i class="bi bi-chevron-down"></i>
        </div>
        <div class="accordion-body">
            @if (_salesPlanning != null && _salesPlanning.Any())
            {
                <div class="detail-card">
                    <div class="detail-card-header">
                        <h4 class="detail-card-title"><i class="bi bi-file-earmark-bar-graph"></i> Sales Planning & Forecast</h4>
                    </div>
                    <div class="table-responsive">
                        <table class="sales-table">
                            <thead>
                                <tr>
                                    <th rowspan="2" style="min-width: 180px; position: sticky; left: 0; background: #fff; z-index: 2;">Product Name</th>
                                    @foreach (var month in _months)
                                    {
                                        <th colspan="2" class="text-center border-start">@month</th>
                                    }
                                </tr>
                                <tr>
                                    @foreach (var month in _months)
                                    {
                                        <th class="text-center text-muted fw-normal border-start">Qty</th>
                                        <th class="text-center text-muted fw-normal">Lakhs</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in _salesPlanning)
                                {
                                    var product = _products.FirstOrDefault(p => p.Id == item.ProductId);
                                    var category = _categories.FirstOrDefault(c => c.Id == item.CategoryId);
                                    var unitName = category != null ? (_units.FirstOrDefault(u => u.Id == category.UnitId)?.Name ?? "MT") : "MT";
                                    <tr>
                                        <td class="fw-medium text-dark" style="position: sticky; left: 0; background: #fff; z-index: 1;">@(product?.Name ?? "Unknown") (@unitName)</td>
                                        @for (int i = 0; i < _months.Length; i++)
                                        {
                                            <td class="border-start">@GetSalesQty(item, i).ToString("N2")</td>
                                            <td>₹@GetSalesAmount(item, i).ToString("N2")</td>
                                        }
                                    </tr>
                                }
                                <tr class="grand-total-row">
                                    <td style="text-align: right; padding-right: 40px; position: sticky; left: 0; background: #fff; z-index: 1;">GRAND TOTAL</td>
                                    @for (int i = 0; i < _months.Length; i++)
                                    {
                                        var monthIndex = i;
                                        <td class="border-start">@(_salesPlanning.Sum(x => GetSalesQty(x, monthIndex)).ToString("N2"))</td>
                                        <td>₹@(_salesPlanning.Sum(x => GetSalesAmount(x, monthIndex)).ToString("N2"))</td>
                                    }
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="detail-card-body pb-3 pt-0">
                        <div style="display: flex; gap: 16px; justify-content: flex-end; margin-top: 16px;">
                            <div class="total-pill">Total Volume: @GetTotalSalesVolume().ToString("N2") @( _salesPlanning.FirstOrDefault() != null ? GetUnitName(_salesPlanning.FirstOrDefault()!) : "Units")</div>
                            <div class="total-pill">Total Forecast Value: ₹@GetTotalForecastValue().ToString("N2") Lakhs</div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="detail-card">
                    <div class="detail-card-body">
                        <div class="data-row"><div class="data-label">Sales Planning</div><div class="data-value">No sales planning data available</div></div>
                    </div>
                </div>
            }
        </div>
    </div>

