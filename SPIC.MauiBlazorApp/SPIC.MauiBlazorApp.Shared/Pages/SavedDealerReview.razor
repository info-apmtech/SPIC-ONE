    private async Task LoadLookups()
    {
        try
        {
            if (_dealer == null) return;
            if (_dealer.StateId > 0)
            {
                var state = await Http.GetFromJsonAsync<DR.State>($"api/State/{_dealer.StateId}");
                _stateName = state?.StateName;
            }
            if (_dealer.Region > 0)
            {
                var region = await Http.GetFromJsonAsync<DR.Region>($"api/Region/{_dealer.Region}");
                _regionName = region?.RegionName;
            }
            if (_dealer.HQ > 0)
            {
                var hq = await Http.GetFromJsonAsync<DR.Headquarter>($"api/Headquarter/{_dealer.HQ}");
                _hqName = hq?.HeadquarterName;
            }
            if (_dealer.DistrictId > 0)
            {
                var district = await Http.GetFromJsonAsync<DR.District>($"api/District/{_dealer.DistrictId}");
                _districtName = district?.DistrictName;
            }
            if ((_dealer.BankId ?? 0) > 0 ||
                _dealer.DealershipApplicationFeeBankId.HasValue ||
                _dealer.SpicTradeDepositDDBankId.HasValue ||
                _dealer.GflTradeDepositDDBankId.HasValue)
            {
                try
                {
                   var banks = await Http.GetFromJsonAsync<List<DR.Bank>>("api/Bank") ?? new();
                    _bankNames = banks.ToDictionary(b => b.Id, b => b.Name);
                }
                catch { }
            }

          _statesAll = await Http.GetFromJsonAsync<List<DR.State>>("api/State/all") ?? new();
            _districtsAll = await Http.GetFromJsonAsync<List<DR.District>>("api/District/all") ?? new();
            _categories = await Http.GetFromJsonAsync<List<DR.Category>>("api/Category") ?? new();
            _units = await Http.GetFromJsonAsync<List<DR.Unit>>("api/Unit") ?? new();
            _products = await Http.GetFromJsonAsync<List<DR.Product>>("api/Product") ?? new();
            _productNames = _products.ToDictionary(p => p.Id, p => p.Name);
            _productGroups = await Http.GetFromJsonAsync<List<DR.ProductGroup>>("api/ProductGroup") ?? new();
            _competitors = await Http.GetFromJsonAsync<List<DR.Competitor>>("api/Competitor") ?? new();
            _competitorNames = _competitors.ToDictionary(c => c.Id.ToString(), c => c.Name);
            var warehouses = await Http.GetFromJsonAsync<List<DR.Warehouse>>("api/Warehouse") ?? new();
            _warehouseNames = warehouses.ToDictionary(w => w.Id.ToString(), w => w.Name);
            var railFacilities = await Http.GetFromJsonAsync<List<DR.RackPoint>>("api/RackPoint") ?? new();
            _railFacilitiesNames = railFacilities.ToDictionary(w => w.Id.ToString(), w => w.Name);
            var portNames = await Http.GetFromJsonAsync<List<DR.Port>>("api/Port") ?? new();
            _portNames = portNames.ToDictionary(w => w.Id.ToString(), w => w.Name);
            var crops = await Http.GetFromJsonAsync<List<DR.Crop>>("api/Crop") ?? new();
            _cropNames = crops.ToDictionary(c => c.Id.ToString(), c => c.Name);
            var fyears = await Http.GetFromJsonAsync<List<DR.FinancialYear>>("api/FinancialYear") ?? new();
            _financialYearNames = fyears.ToDictionary(f => f.Id, f => f.Name);
        }
        catch { }
    }
   private async Task LoadCreditLimitSalesData(int dealerId)
    {
        _creditLimitSalesData = new();
        if (_creditProposal == null || _categories == null || _categories.Count == 0) return;

        var fyIds = new[] { _creditProposal.FY1, _creditProposal.FY2, _creditProposal.FY3 }
            .Where(id => id > 0)
            .Distinct()
            .ToList();
        if (fyIds.Count == 0) return;

        var fyQuery = string.Join(",", fyIds);

        var tasks = _categories.Select(cat =>
        {
            var url = $"api/creditlimitsales/by-filter?customerId={dealerId}&categoryId={cat.Id}&financialYearIds={fyQuery}";
            return SafeGetListAsync<DR.DealerCreditLimitSales>(url);
        });

        var results = await Task.WhenAll(tasks);
        _creditLimitSalesData = results.Where(r => r != null).SelectMany(r => r!).ToList();
    }

    private async Task<List<T>?> SafeGetListAsync<T>(string url)
    {
        try { return await Http.GetFromJsonAsync<List<T>>(url); }
        catch { return null; }
    }

    private async Task LoadSubmittedByName()
    {
        try
        {
            if (_dealer == null) return;

            // The first "Submitted" action belongs to the dealer creator.
            // Do not use UpdatedBy here because later approval actions can change UpdatedBy.
            var id = !string.IsNullOrWhiteSpace(_dealer.CreatedBy)
                ? _dealer.CreatedBy
                : _dealer.UpdatedBy;

            if (string.IsNullOrWhiteSpace(id)) return;

            // Load the same UserInfo list already used by this page.
            // This is display-only; approval permissions/flow are unchanged.
            await LoadAllUsersIfNeeded();

            var cachedUser = _users.FirstOrDefault(u =>
                !string.IsNullOrWhiteSpace(u.Id) &&
                string.Equals(u.Id, id, StringComparison.OrdinalIgnoreCase));

            if (cachedUser?.Role.HasValue == true)
                _submittedByRole = cachedUser.Role.Value.ToString();

            if (_userNames.TryGetValue(id, out var cachedName))
                _submittedByName = cachedName;

            // If the role was not included by UserInfo/all, try the existing per-user endpoint.
            if (string.IsNullOrWhiteSpace(_submittedByName) || string.IsNullOrWhiteSpace(_submittedByRole))
            {
                try
                {
                    var resp = await Http.GetAsync($"api/User/{id}");
                    if (resp.IsSuccessStatusCode)
                    {
                        var json = await resp.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
                        if (json.ValueKind != System.Text.Json.JsonValueKind.Undefined)
                        {
                            if (string.IsNullOrWhiteSpace(_submittedByName) && TryGetJsonProperty(json, "Name", out var nameValue))
                            {
                                var nm = nameValue.ValueKind == System.Text.Json.JsonValueKind.String
                                    ? nameValue.GetString()
                                    : nameValue.ToString();

                                if (!string.IsNullOrWhiteSpace(nm))
                                {
                                    _submittedByName = nm;
                                    _userNames[id] = nm;
                                }
                            }

                            if (string.IsNullOrWhiteSpace(_submittedByRole))
                                _submittedByRole = TryResolveUserRole(json);
                        }
                    }
                }
                catch { }
            }

            // Safe fallback only when the creator is the currently logged-in user.
            // This fixes Admin-created registrations without incorrectly using the viewer's role
            // when another user (RM/SMM/AVP/etc.) opens the same application later.
            if (string.IsNullOrWhiteSpace(_submittedByRole) &&
                !string.IsNullOrWhiteSpace(LoginState.UserId) &&
                string.Equals(id, LoginState.UserId, StringComparison.OrdinalIgnoreCase))
            {
                var currentRole = LoginState.UserRole?.ToString();
                if (!string.IsNullOrWhiteSpace(currentRole))
                    _submittedByRole = currentRole;
            }
        }
        catch { }
    }

    private static bool TryGetJsonProperty(System.Text.Json.JsonElement json, string propertyName, out System.Text.Json.JsonElement value)
    {
        value = default;
        if (json.ValueKind != System.Text.Json.JsonValueKind.Object) return false;

        foreach (var property in json.EnumerateObject())
        {
            if (string.Equals(property.Name, propertyName, StringComparison.OrdinalIgnoreCase))
            {
                value = property.Value;
                return true;
            }
        }

        return false;
    }

    private static string? TryResolveUserRole(System.Text.Json.JsonElement json)
    {
        // Different user endpoints/DTOs may expose the same value under different names.
        // Read only for display; do not use this helper for authorization decisions.
        foreach (var propertyName in new[] { "Role", "UserRole", "RoleName" })
        {
            if (!TryGetJsonProperty(json, propertyName, out var roleValue))
                continue;

            if (roleValue.ValueKind == System.Text.Json.JsonValueKind.String)
            {
                var roleText = roleValue.GetString();
                if (!string.IsNullOrWhiteSpace(roleText))
                    return roleText;
            }

            if (roleValue.ValueKind == System.Text.Json.JsonValueKind.Number &&
                roleValue.TryGetInt32(out var roleNumber) &&
                Enum.IsDefined(typeof(DR.AppRole), roleNumber))
            {
                return ((DR.AppRole)roleNumber).ToString();
            }
        }

        if (TryGetJsonProperty(json, "Roles", out var rolesValue) &&
            rolesValue.ValueKind == System.Text.Json.JsonValueKind.Array)
        {
            foreach (var roleItem in rolesValue.EnumerateArray())
            {
                if (roleItem.ValueKind == System.Text.Json.JsonValueKind.String)
                {
                    var roleText = roleItem.GetString();
                    if (!string.IsNullOrWhiteSpace(roleText))
                        return roleText;
                }
            }
        }

        return null;
    }

    private async Task LoadApprovalUserNames()
    {
        try
        {
            if (_approvalHistory == null || !_approvalHistory.Any()) return;
            var ids = _approvalHistory.Select(h => h.ApprovedBy).Where(x => !string.IsNullOrEmpty(x)).Distinct().ToList();

            // Load full user list first (like EmployeeManagement page) to avoid many per-id calls
            await LoadAllUsersIfNeeded();

            foreach (var id in ids)
            {
                if (string.IsNullOrEmpty(id) || _userNames.ContainsKey(id)) continue;
                // try to get from cached list
                if (_userNames.ContainsKey(id)) continue;
                try
                {
                    var resp = await Http.GetAsync($"api/User/{id}");
                    if (!resp.IsSuccessStatusCode) continue;
                    var json = await resp.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
                    if (json.ValueKind != System.Text.Json.JsonValueKind.Undefined && json.TryGetProperty("Name", out var nameProp))
                    {
                        var nm = nameProp.GetString();
                        if (!string.IsNullOrEmpty(nm)) _userNames[id] = nm;
                    }
                }
                catch { }
            }
        }
        catch { }
    }

    private async Task LoadAllUsersIfNeeded()
    {
        if (_users != null && _users.Any())
            return;
        try
        {
            var users = await Http.GetFromJsonAsync<List<UserInfoDto>>("api/UserInfo/all");
            if (users != null && users.Any())
            {
                _users = users;
                _userNames = _users.Where(u => !string.IsNullOrEmpty(u.Id))
                    .ToDictionary(u => u.Id!, u => !string.IsNullOrEmpty(u.Name) ? u.Name! : (u.UserName ?? u.Id!), StringComparer.OrdinalIgnoreCase);
            }
        }
        catch { }
    }

    private class UserInfoDto
    {
        public string Id { get; set; } = "";
        public string? UserName { get; set; }
        public string? Name { get; set; }
        public string? Email { get; set; }
        public DR.AppRole? Role { get; set; }
    }

    private List<TimelineItem> TimelineItems = new();

    private void BuildTimelineFromHistory()
    {
        // Rebuilt as a NEW list so the timeline section sees the change by reference.
        var items = new List<TimelineItem>();

        if (_dealer == null)
        {
            TimelineItems = items;
            return;
        }

        var submitUser = "System";
        var submitterId = _dealer.UpdatedBy ?? _dealer.CreatedBy;
        if (!string.IsNullOrEmpty(submitterId))
        {
            if (_userNames.ContainsKey(submitterId)) submitUser = _userNames[submitterId];
            else submitUser = submitterId;
        }
        var createdDateText = _dealer.UpdatedAt.Year > 2000 ? _dealer.UpdatedAt.ToString("dd-MMM-yyyy hh:mm tt") : _dealer.CreatedAt.ToString("dd-MMM-yyyy hh:mm tt");

        items.Add(new TimelineItem("Submitted", "Submitted", submitUser, createdDateText, "dot-green", "bi bi-check-lg", "card-green", "badge-green"));

        if (_approvalHistory != null && _approvalHistory.Any())
        {
            foreach (var h in _approvalHistory.OrderBy(h => h.ApprovedAt))
            {
                var roleName = h.Role ?? "Unknown";
                var userName = !string.IsNullOrEmpty(h.ApprovedBy) && _userNames.ContainsKey(h.ApprovedBy)
                    ? _userNames[h.ApprovedBy]
                    : (h.ApprovedBy ?? "-");
                var dateText = h.ApprovedAt.ToString("dd-MMM-yyyy hh:mm tt");
                var status = h.IsApproved ? "Approved" : "Sent Back";

                var dotClass = h.IsApproved ? "dot-green" : "dot-red";
                var icon = h.IsApproved ? "bi bi-check-lg" : "bi bi-arrow-counterclockwise";
                var cardClass = h.IsApproved ? "card-green" : "card-red";
                var badgeClass = h.IsApproved ? "badge-green" : "badge-red";

                items.Add(new TimelineItem($"Under Review by {roleName}", status, userName, dateText, dotClass, icon, cardClass, badgeClass));
            }
        }

        TimelineItems = items;
    }

