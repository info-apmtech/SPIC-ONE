@page "/SavedDealerReview"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components
@using DR = SPIC.Core.Entities
@inject HttpClient Http
@inject NavigationManager Nav
@inject LoadingService Loading
@inject LoginState LoginState
@inject IJSRuntime JS

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "dealerId")]
    public int? dealerId { get; set; }

    private DR.DealerRegistration? _dealer;
    private bool _isLoading = false;

    // Related data
    private List<DR.DealerExperience> _experiences = new();
    private List<DR.AnnualSaleDataLastFYofDealerRegistration> _annualSales = new();
    private List<DR.DealerWarehouseFacilities> _warehouses = new();
    private List<DR.DealerRailFacilities> _rails = new();
    private List<DR.DealerPortFacilities> _ports = new();
    private List<DR.DealerMarketDetail> _marketDetails = new();
    private List<DR.DealerCompaniesOperatingInArea> _companies = new();
    private DR.DealerOwnershipInfo? _ownership;
    private List<DR.PartnerFamilyDetails> _partners = new();
    private List<DR.PartnerOccupation> _occupations = new();
    private List<DR.SalesPlanningInDealerRegistration> _salesPlanning = new();
    private List<DR.DealerAssetBank> _assetBanks = new();
    private List<DR.DealerAssetLand> _assetLands = new();
    private List<DR.DealerAssetBuilding> _assetBuildings = new();
    private List<DR.DealerLoanLiabilities> _loans = new();
    private DR.DealerCreditLimitProposal? _creditProposal;
    private List<DR.DealerCreditLimitSalesPerformance> _creditSales = new();
    private DR.DealerRegistrationDocuments? _documents;
    private List<DR.DealerApprovalHistory> _approvalHistory = new();
    private string? _submittedByName;
    private Dictionary<string, string> _userNames = new();

    // Lookup names
    private string? _stateName;
    private string? _regionName;
    private string? _hqName;
    private string? _districtName;
    private string? _bankName;
    private Dictionary<int, string> _productNames = new();
    private Dictionary<int, string> _bankNames = new();
    private List<DR.Category> _categories = new();
    private List<DR.Product> _products = new();
    private List<DR.Unit> _units = new();
    private static readonly string[] _months = ["April", "May", "June", "July", "August", "September", "October", "November", "December", "January", "February", "March"];
    private decimal _totalSalesQty = 0;

    protected override async Task OnInitializedAsync()
    {
        if (dealerId.HasValue && dealerId.Value > 0)
        {
            Loading.Show();
            _isLoading = true;
            try
            {
                _dealer = await Http.GetFromJsonAsync<DR.DealerRegistration>($"api/DealerRegistration/{dealerId}");
                if (_dealer != null)
                {
                    await FetchRelatedData(_dealer.Id);
                    await LoadLookups();
                }
            }
            catch { }
            finally
            {
                _isLoading = false;
                Loading.Hide();
            }
        }
    }

    private async Task FetchRelatedData(int id)
    {
        try
        {
            var t1 = Http.GetFromJsonAsync<List<DR.DealerExperience>>($"api/DealerExperience/byDealer/{id}").ContinueWith(t => { if (t.Status == TaskStatus.RanToCompletion && t.Result != null) _experiences = t.Result; });
            var t2 = Http.GetFromJsonAsync<List<DR.AnnualSaleDataLastFYofDealerRegistration>>($"api/AnnualSaleDataLastFY/byDealer/{id}").ContinueWith(t => { if (t.Status == TaskStatus.RanToCompletion && t.Result != null) _annualSales = t.Result; });
            var t3 = Http.GetFromJsonAsync<List<DR.DealerWarehouseFacilities>>($"api/DealerWarehouseFacilities/byDealer/{id}").ContinueWith(t => { if (t.Status == TaskStatus.RanToCompletion && t.Result != null) _warehouses = t.Result; });
            var t4 = Http.GetFromJsonAsync<List<DR.DealerRailFacilities>>($"api/DealerRailFacilities/byDealer/{id}").ContinueWith(t => { if (t.Status == TaskStatus.RanToCompletion && t.Result != null) _rails = t.Result; });
            var t5 = Http.GetFromJsonAsync<List<DR.DealerPortFacilities>>($"api/DealerPortFacilities/byDealer/{id}").ContinueWith(t => { if (t.Status == TaskStatus.RanToCompletion && t.Result != null) _ports = t.Result; });
            var t6 = Http.GetFromJsonAsync<List<DR.DealerMarketDetail>>($"api/DealerMarketDetail/byDealer/{id}").ContinueWith(t => { if (t.Status == TaskStatus.RanToCompletion && t.Result != null) _marketDetails = t.Result; });
            var t7 = Http.GetFromJsonAsync<List<DR.DealerCompaniesOperatingInArea>>($"api/DealerCompaniesOperatingInArea/byDealer/{id}").ContinueWith(t => { if (t.Status == TaskStatus.RanToCompletion && t.Result != null) _companies = t.Result; });
            var t8 = Http.GetFromJsonAsync<List<DR.PartnerFamilyDetails>>($"api/PartnerFamilyDetails/byDealer/{id}").ContinueWith(t => { if (t.Status == TaskStatus.RanToCompletion && t.Result != null) _partners = t.Result; });
            var t9 = Http.GetFromJsonAsync<List<DR.PartnerOccupation>>($"api/PartnerOccupation/byDealer/{id}").ContinueWith(t => { if (t.Status == TaskStatus.RanToCompletion && t.Result != null) _occupations = t.Result; });
            var t10 = Http.GetFromJsonAsync<List<DR.SalesPlanningInDealerRegistration>>($"api/SalesPlanning/byDealer/{id}").ContinueWith(t => { if (t.Status == TaskStatus.RanToCompletion && t.Result != null) _salesPlanning = t.Result; });
            var t11 = Http.GetFromJsonAsync<List<DR.DealerAssetBank>>($"api/DealerAssetBank/byDealer/{id}").ContinueWith(t => { if (t.Status == TaskStatus.RanToCompletion && t.Result != null) _assetBanks = t.Result; });
            var t12 = Http.GetFromJsonAsync<List<DR.DealerAssetLand>>($"api/DealerAssetLand/byDealer/{id}").ContinueWith(t => { if (t.Status == TaskStatus.RanToCompletion && t.Result != null) _assetLands = t.Result; });
            var t13 = Http.GetFromJsonAsync<List<DR.DealerAssetBuilding>>($"api/DealerAssetBuilding/byDealer/{id}").ContinueWith(t => { if (t.Status == TaskStatus.RanToCompletion && t.Result != null) _assetBuildings = t.Result; });
            var t14 = Http.GetFromJsonAsync<List<DR.DealerLoanLiabilities>>($"api/DealerLoanLiabilities/byDealer/{id}").ContinueWith(t => { if (t.Status == TaskStatus.RanToCompletion && t.Result != null) _loans = t.Result; });
            var t15 = Http.GetFromJsonAsync<List<DR.DealerCreditLimitSalesPerformance>>($"api/DealerCreditLimitSalesPerformance/byDealer/{id}").ContinueWith(t => { if (t.Status == TaskStatus.RanToCompletion && t.Result != null) _creditSales = t.Result; });
            var t16 = Http.GetFromJsonAsync<List<DR.DealerRegistrationDocuments>>($"api/DealerRegistrationDocuments/byDealer/{id}").ContinueWith(t => { if (t.Status == TaskStatus.RanToCompletion && t.Result != null) _documents = t.Result.FirstOrDefault(); });

            var t17 = Http.GetFromJsonAsync<List<DR.DealerOwnershipInfo>>($"api/DealerOwnershipInfo/byDealer/{id}").ContinueWith(t => { if (t.Status == TaskStatus.RanToCompletion && t.Result != null) _ownership = t.Result.FirstOrDefault(); });
            var t18 = Http.GetFromJsonAsync<List<DR.DealerCreditLimitProposal>>($"api/DealerCreditLimitProposal/byDealer/{id}").ContinueWith(t => { if (t.Status == TaskStatus.RanToCompletion && t.Result != null) _creditProposal = t.Result.FirstOrDefault(); });
            var t19 = Http.GetFromJsonAsync<List<DR.DealerApprovalHistory>>($"api/DealerApprovalHistory/byDealer/{id}").ContinueWith(t => { if (t.Status == TaskStatus.RanToCompletion && t.Result != null) _approvalHistory = t.Result.OrderByDescending(h => h.ApprovedAt).ToList(); });

            await Task.WhenAll(t1, t2, t3, t4, t5, t6, t7, t8, t9, t10, t11, t12, t13, t14, t15, t16, t17, t18, t19);

            await LoadSubmittedByName();
            await LoadApprovalUserNames();
            BuildTimelineFromHistory();
        }
        catch { }
    }

    private async Task LoadLookups()
    {
        try
        {
            if (_dealer == null) return;
            if (_dealer.StateId > 0)
            {
                var state = await Http.GetFromJsonAsync<DR.State>($"api/State/{_dealer.StateId}");
                _stateName = state?.StateName;
            }
            if (_dealer.Region > 0)
            {
                var region = await Http.GetFromJsonAsync<DR.Region>($"api/Region/{_dealer.Region}");
                _regionName = region?.RegionName;
            }
            if (_dealer.HQ > 0)
            {
                var hq = await Http.GetFromJsonAsync<DR.Headquarter>($"api/Headquarter/{_dealer.HQ}");
                _hqName = hq?.HeadquarterName;
            }
            if (_dealer.DistrictId > 0)
            {
                var district = await Http.GetFromJsonAsync<DR.District>($"api/District/{_dealer.DistrictId}");
                _districtName = district?.DistrictName;
            }
            if (_dealer.BankId > 0)
            {
                try
                {
                    var bank = await Http.GetFromJsonAsync<DR.Bank>($"api/Bank/{_dealer.BankId}");
                    _bankName = bank?.Name;
                }
                catch { }
            }

            _categories = await Http.GetFromJsonAsync<List<DR.Category>>("api/Category") ?? new();
            _units = await Http.GetFromJsonAsync<List<DR.Unit>>("api/Unit") ?? new();
            _products = await Http.GetFromJsonAsync<List<DR.Product>>("api/Product") ?? new();
            _productNames = _products.ToDictionary(p => p.Id, p => p.Name);
        }
        catch { }
    }

    private async Task LoadSubmittedByName()
    {
        try
        {
            if (_dealer == null || string.IsNullOrWhiteSpace(_dealer.CreatedBy)) return;
            var id = _dealer.CreatedBy!;
            if (_userNames.ContainsKey(id))
            {
                _submittedByName = _userNames[id];
                return;
            }

            var resp = await Http.GetAsync($"api/User/{id}");
            if (!resp.IsSuccessStatusCode) return;
            var json = await resp.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
            if (json.ValueKind != System.Text.Json.JsonValueKind.Undefined && json.TryGetProperty("Name", out var nameProp))
            {
                var nm = nameProp.GetString();
                if (!string.IsNullOrEmpty(nm))
                {
                    _submittedByName = nm;
                    _userNames[id] = nm;
                }
            }
        }
        catch { }
    }

    private async Task LoadApprovalUserNames()
    {
        try
        {
            if (_approvalHistory == null || !_approvalHistory.Any()) return;
            var ids = _approvalHistory.Select(h => h.ApprovedBy).Where(x => !string.IsNullOrEmpty(x)).Distinct().ToList();
            foreach (var id in ids)
            {
                if (string.IsNullOrEmpty(id) || _userNames.ContainsKey(id)) continue;
                try
                {
                    var resp = await Http.GetAsync($"api/User/{id}");
                    if (!resp.IsSuccessStatusCode) continue;
                    var json = await resp.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
                    if (json.ValueKind != System.Text.Json.JsonValueKind.Undefined && json.TryGetProperty("Name", out var nameProp))
                    {
                        var nm = nameProp.GetString();
                        if (!string.IsNullOrEmpty(nm)) _userNames[id] = nm;
                    }
                }
                catch { }
            }
        }
        catch { }
    }

    private IEnumerable<(string title, string? path)> GetEnclosureItems()
    {
        var list = new List<(string, string?)>();
        list.Add(("GST Certificate", _dealer?.GSTFilePath));
        list.Add(("PAN Copy", _dealer?.PANFilePath));
        list.Add(("Aadhaar Copy", _dealer?.AadhaarFilePath));
        list.Add(("Wholesale License", _dealer?.WholesaleLicenseFilePath));
        list.Add(("Retail License", _dealer?.RetailLicenseFilePath));
        list.Add(("Proprietor Photograph", _ownership?.ProprietorImagePath));
        list.Add(("Proprietor Aadhaar", _ownership?.AadhaarFilePath));
        list.Add(("Proprietor PAN", _ownership?.PANFilePath));

        if (_documents != null)
        {
            list.Add(("Specimen Signature", _documents.SpecimanFilePath));
            list.Add(("Greenstar Specimen", _documents.GreenstarSpecimanFilePath));
            list.Add(("Bank Guarantee Certificate", _documents.BankGauranteeFilePath));
            list.Add(("IT Returns FY1", _documents.FY1ITReturnFilePath));
            list.Add(("IT Returns FY2", _documents.FY2ITReturnFilePath));
            list.Add(("Valuation Certificate", _documents.ValuationCertificateFilePath));
            list.Add(("Retailer List", _documents.RetailerListFilePath));
            list.Add(("Partnership Deed", _documents.PartnershipDeadFilePath));
            list.Add(("Board Resolution", _documents.BoardReasolutionFilePath));
            list.Add(("Affidavit", _documents.AffidavitFilePath));
            list.Add(("Authorization Letter", _documents.AuthorizationLetterFilePath));
            list.Add(("Deed of Guarantee", _documents.DeedOfGuaranteeFilePath));
        }
        return list;
    }

    private string GetEnclosureHtml()
    {
        var sb = new System.Text.StringBuilder();
        foreach (var item in GetEnclosureItems())
        {
            if (!string.IsNullOrEmpty(item.path))
            {
                sb.Append($"<a class=\"enclosure-btn\" href=\"api/DealerFile/view/{System.Uri.EscapeDataString(item.path)}\" target=\"_blank\">{System.Net.WebUtility.HtmlEncode(item.title)}</a>");
            }
            else
            {
                sb.Append($"<div class=\"enclosure-btn\">{System.Net.WebUtility.HtmlEncode(item.title)}</div>");
            }
        }
        return sb.ToString();
    }

    private decimal GetCapitalPosition() => _dealer?.CapitalInvestment ?? 0m;
    private decimal GetTotalAssets()
    {
        decimal banks = _assetBanks?.Sum(x => x.Value) ?? 0m;
        decimal lands = _assetLands?.Sum(x => x.PropertyValue) ?? 0m;
        decimal buildings = _assetBuildings?.Sum(x => x.PropertyValue) ?? 0m;
        decimal movables = _dealer?.AssetValue ?? 0m;
        return banks + lands + buildings + movables;
    }
    private decimal GetTotalLoans() => _loans?.Sum(x => x.LoanValue) ?? 0m;
    private decimal GetNetValue() => GetCapitalPosition() + GetTotalAssets() - GetTotalLoans();

    private static decimal GetSalesQty(DR.SalesPlanningInDealerRegistration row, int monthIndex)
    {
        return monthIndex switch { 0 => row.AprilQty, 1 => row.MayQty, 2 => row.JuneQty, 3 => row.JulyQty, 4 => row.AugustQty, 5 => row.SeptemberQty, 6 => row.OctoberQty, 7 => row.NovemberQty, 8 => row.DecemberQty, 9 => row.JanuaryQty, 10 => row.FebruaryQty, 11 => row.MarchQty, _ => 0 };
    }

    private static decimal GetSalesAmount(DR.SalesPlanningInDealerRegistration row, int monthIndex)
    {
        return monthIndex switch { 0 => row.AprilAmount, 1 => row.MayAmount, 2 => row.JuneAmount, 3 => row.JulyAmount, 4 => row.AugustAmount, 5 => row.SeptemberAmount, 6 => row.OctoberAmount, 7 => row.NovemberAmount, 8 => row.DecemberAmount, 9 => row.JanuaryAmount, 10 => row.FebruaryAmount, 11 => row.MarchAmount, _ => 0 };
    }

    private string GetUnitName(DR.SalesPlanningInDealerRegistration item)
    {
        var category = _categories.FirstOrDefault(c => c.Id == item.CategoryId);
        return _units.FirstOrDefault(u => u.Id == category?.UnitId)?.Name ?? "MT";
    }

    private decimal GetTotalSalesVolume()
    {
        if (_salesPlanning == null) return 0;
        decimal total = 0;
        foreach (var item in _salesPlanning)
            for (int i = 0; i < _months.Length; i++)
                total += GetSalesQty(item, i);
        return total;
    }

    private decimal GetTotalForecastValue()
    {
        if (_salesPlanning == null) return 0;
        decimal total = 0;
        foreach (var item in _salesPlanning)
            for (int i = 0; i < _months.Length; i++)
                total += GetSalesAmount(item, i);
        return total;
    }

    private List<TimelineItem> TimelineItems = new();

    private void BuildTimelineFromHistory()
    {
        TimelineItems.Clear();

        if (_dealer != null)
        {
            // 1. Initial Submit Step
            var submitUser = "System";
            if (!string.IsNullOrEmpty(_dealer.CreatedBy))
            {
                if (_userNames.ContainsKey(_dealer.CreatedBy)) submitUser = _userNames[_dealer.CreatedBy];
                else submitUser = _dealer.CreatedBy;
            }
            var createdDateText = _dealer.CreatedAt.ToString("dd-MMM-yyyy hh:mm tt");
            
            TimelineItems.Add(new TimelineItem("Submitted", "Submitted", submitUser, createdDateText, "dot-green", "bi bi-check-lg", "card-green", "badge-green"));

            // Helper to get latest record per role
            static DR.DealerApprovalHistory? LastForRole(IEnumerable<DR.DealerApprovalHistory> hist, string roleToken)
            {
                return hist?.Where(h => !string.IsNullOrEmpty(h.Role) && h.Role.Contains(roleToken, StringComparison.OrdinalIgnoreCase)).OrderByDescending(h => h.ApprovedAt).FirstOrDefault();
            }

            // 2. RM Step
            var rmStatus = _dealer.RMApproved == true ? "Approved" : (_dealer.RMApproved == false ? "Sent Back" : "Pending");
            var lastRm = LastForRole(_approvalHistory, "RM");
            string rmUser = lastRm != null ? (_userNames.ContainsKey(lastRm.ApprovedBy ?? "") ? _userNames[lastRm.ApprovedBy!] : lastRm.ApprovedBy ?? "-") : "-";
            string rmDateText = lastRm != null ? lastRm.ApprovedAt.ToString("dd-MMM-yyyy hh:mm tt") : "-";
            
            var rmDot = rmStatus == "Sent Back" ? "dot-red" : (rmStatus == "Pending" ? "dot-gray" : "dot-green");
            var rmIcon = rmStatus == "Sent Back" ? "bi bi-arrow-counterclockwise" : "bi bi-clock";
            var rmCard = rmStatus == "Sent Back" ? "card-red" : (rmStatus == "Pending" ? "card-pending" : "card-green");
            var rmBadge = rmStatus == "Sent Back" ? "badge-red" : "badge-blue"; // Blue badge used for both Approved and Pending in image
            
            TimelineItems.Add(new TimelineItem("Under Review by RM", rmStatus, rmUser, rmDateText, rmDot, rmIcon, rmCard, rmBadge));

            // 3. SMM Step
            var smStatus = _dealer.SMApproved == true ? "Approved" : (_dealer.SMApproved == false ? "Sent Back" : "Pending");
            var lastSm = LastForRole(_approvalHistory, "SM");
            string smUser = lastSm != null ? (_userNames.ContainsKey(lastSm.ApprovedBy ?? "") ? _userNames[lastSm.ApprovedBy!] : lastSm.ApprovedBy ?? "-") : "-";
            string smDateText = lastSm != null ? lastSm.ApprovedAt.ToString("dd-MMM-yyyy hh:mm tt") : "-";
            
            var smDot = smStatus == "Sent Back" ? "dot-red" : (smStatus == "Pending" ? "dot-gray" : "dot-green");
            var smIcon = smStatus == "Sent Back" ? "bi bi-arrow-counterclockwise" : "bi bi-clock";
            var smCard = smStatus == "Sent Back" ? "card-red" : (smStatus == "Pending" ? "card-pending" : "card-green");
            var smBadge = smStatus == "Sent Back" ? "badge-red" : "badge-blue";

            TimelineItems.Add(new TimelineItem("Under Review by SMM", smStatus, smUser, smDateText, smDot, smIcon, smCard, smBadge));

            // 4. AVP Step
            var avpStatus = _dealer.AVPApproved == true ? "Approved" : (_dealer.AVPApproved == false ? "Sent Back" : "Pending");
            var lastAvp = LastForRole(_approvalHistory, "AVP");
            string avpUser = lastAvp != null ? (_userNames.ContainsKey(lastAvp.ApprovedBy ?? "") ? _userNames[lastAvp.ApprovedBy!] : lastAvp.ApprovedBy ?? "-") : "-";
            string avpDateText = lastAvp != null ? lastAvp.ApprovedAt.ToString("dd-MMM-yyyy hh:mm tt") : "-";
            
            var avpDot = avpStatus == "Sent Back" ? "dot-red" : (avpStatus == "Pending" ? "dot-gray" : "dot-green");
            var avpIcon = avpStatus == "Sent Back" ? "bi bi-arrow-counterclockwise" : "bi bi-clock";
            var avpCard = avpStatus == "Sent Back" ? "card-red" : (avpStatus == "Pending" ? "card-pending" : "card-green");
            var avpBadge = avpStatus == "Sent Back" ? "badge-red" : "badge-blue";

            TimelineItems.Add(new TimelineItem("Under Review by AVP", avpStatus, avpUser, avpDateText, avpDot, avpIcon, avpCard, avpBadge));
        }
    }

