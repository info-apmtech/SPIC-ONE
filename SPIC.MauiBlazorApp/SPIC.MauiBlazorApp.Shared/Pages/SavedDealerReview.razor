    .completed .step-circle { background: #dcfce7; color: #22c55e; border: 1px solid #86efac; font-size: 24px; }
    .active .step-circle { background: #fff3cd; color: #d97706; border: 1px solid #fde68a; }
    .pending .step-circle { background: #fff3cd; color: #d97706; border: 1px solid #fde68a; }
    .approval-step.rejected .step-circle { background: #fee2e2; color: #dc2626; border: 1px solid #fecaca; }
    .step-title { font-size: 18px; font-weight: 700; color: #374151; }
    .step-status { font-size: 13px; color: #9ca3af; }
    .completed .step-status { color: #059669; }
    .active .step-status { color: #d97706; }
    .pending .step-status { color: #d97706; }
    .approval-step.rejected .step-status { color: #dc2626; }
    .step-line { height: 3px; min-width: 130px; background: #d1d5db; margin: 0 24px; }
    .completed-line { background: #22c55e; }
    .active-line { background: #f97316; }
    .pending-line { background: #f97316; }
    .rejected-line { background: #dc2626; }

    /* ========================================================
       NEW TIMELINE CSS (MATCHING THE SCREENSHOT)
       ======================================================== */
    .timeline-box {
        background: #fff;
        border: 1px solid #e6e9ee;
        border-radius: 14px;
        padding: 24px;
        margin-bottom: 24px;
        box-shadow: 0 1px 3px rgba(0,0,0,.03);
    }
    .timeline-heading {
        font-size: 1.1rem;
        font-weight: 700;
        color: #374151;
        margin-bottom: 24px;
    }

    .timeline-scroll {
        display: flex;
        overflow-x: auto;
        padding-bottom: 12px;
        scrollbar-width: thin; /* For Firefox */
    }
    .timeline-scroll::-webkit-scrollbar { height: 8px; }
    .timeline-scroll::-webkit-scrollbar-thumb { background: #d1d5db; border-radius: 4px; }

    .timeline-col {
        position: relative;
        min-width: 240px;
        width: 240px;
        padding-right: 16px;
        display: flex;
        flex-direction: column;
    }

    /* Horizontal Line drawn perfectly center-to-center */
    .timeline-col::after {
        content: '';
        position: absolute;
        top: 16px; /* Half of the 32px dot */
        left: 48px; /* Offset to start right after the first dot */
        width: calc(100% - 32px); /* Stretch to the next item */
        height: 2px;
        background: #e5e7eb;
        z-index: 1;
    }
    .timeline-col:last-child::after {
        display: none;
    }

    .timeline-dot {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 15px;
        margin-bottom: 16px;
        margin-left: 16px; /* Align dot slightly inward */
        z-index: 2;
        position: relative;
    }

    .dot-green { background: #059669; }
    .dot-red { background: #dc2626; }
    .dot-blue { background: #3b82f6; }
    .dot-gray { background: #cbd5e1; }

    .timeline-small-card {
        width: 100%;
        flex-grow: 1;
        border-radius: 8px;
        border: 1px solid #edf0f5;
        padding: 16px;
        display: flex;
        flex-direction: column;
    }

    .card-green { background: #f0fdf4; border-color: #dcfce7; }
    .card-red { background: #fff1f2; border-color: #fee2e2; }
    .card-pending { background: #f8fafc; border-color: #e2e8f0; } /* Pending matching the screenshot */

    .timeline-title-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 12px;
    }

    .timeline-title {
        font-size: 0.85rem;
        font-weight: 700;
        color: #111827;
        line-height: 1.3;
        margin-right: 8px;
    }

    .timeline-status {
        display: inline-block;
        font-size: 0.7rem;
        padding: 4px 10px;
        border-radius: 4px;
        font-weight: 600;
        width: fit-content;
        margin-bottom: 16px;
    }

    .badge-green { background: #d1fae5; color: #059669; }
    .badge-red { background: #fee2e2; color: #dc2626; }
    .badge-blue { background: #dbeafe; color: #2563eb; }

    .timeline-user {
        font-size: 0.75rem;
        color: #4b5563;
        word-break: break-all; /* Prevents long names/GUIDs from breaking layout */
        margin-bottom: 12px;
        line-height: 1.4;
    }

    .timeline-date {
        font-size: 0.7rem;
        color: #6b7280;
        display: flex;
        align-items: center;
        margin-top: auto; /* Pushes to bottom */
    }
    /* ======================================================== */

    .sent-title { font-size: 20px; font-weight: 700; color: #444; margin-bottom: 18px; }
    .detail-box { background: #fff; border: 1px solid #e6e9ee; border-radius: 12px; padding: 24px; min-height: 225px; }
    .detail-box h5 { font-size: 16px; font-weight: 700; color: #374151; margin-bottom: 20px; }
    .info-row { display: grid; grid-template-columns: 140px 1fr; margin-bottom: 18px; font-size: 13px; }
