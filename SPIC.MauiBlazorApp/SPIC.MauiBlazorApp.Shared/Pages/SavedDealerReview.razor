    // ------------- CONFIRM PROCEED POPUP LOGIC -------------
    private bool IsConfirmProceedPopupVisible { get; set; } = false;
    private string ConfirmRemarks { get; set; } = "";
    private bool _isApproving = false;
    private bool _showSuccessNotification = false;
    private decimal? _previousRmCreditLimit;
    private decimal? _previousSmCreditLimit;

    // New Dealer final AVP approval: the AVP chooses the code prefix and reviews
    // the server-generated Dealer Code before approving. RM/SM and existing-dealer
    // approval flows do not use these fields.
    private static readonly string[] _dealerCodePrefixes = { "D", "N", "Z", "T" };
    private string _selectedDealerCodePrefix = "D";
    private string _avpDealerCode = string.Empty;
    private bool _isDealerCodePreviewLoading;
    private string? _dealerCodePreviewError;

    private bool IsNewDealerFinalApproval =>
        _isNewDealer && (LoginState.IsDirectorOrAVP || LoginState.IsAdmin);

    private sealed class DealerCodePreviewDto
    {
        public int DealerId { get; set; }
        public string Prefix { get; set; } = string.Empty;
        public string DealerCode { get; set; } = string.Empty;
        public string TargetField { get; set; } = string.Empty;
        public string? LegacyField { get; set; }
    }

private async Task ShowConfirmProceedPopup()
{
    ConfirmRemarks = "";
    _approvalError = null;
    _dealerCodePreviewError = null;
    _rmCreditLimitSpic = null;
    _rmCreditLimitGfl = null;
    _smCreditLimitSpic = null;
    _smCreditLimitGfl = null;
    _avpCreditLimitSpic = null;
    _avpCreditLimitGfl = null;

    // Fetch RM approved limits (both SPIC and GFL)
    var rmSpicApproval = _approvalHistory?
        .Where(h => h.IsApproved)
        .OrderByDescending(h => h.ApprovedAt)
        .FirstOrDefault(h => h.RmCreditLimit.HasValue && h.RmCreditLimit > 0);
    _previousRmCreditLimit = rmSpicApproval?.RmCreditLimit;

    var rmGflApproval = _approvalHistory?
        .Where(h => h.IsApproved)
        .OrderByDescending(h => h.ApprovedAt)
        .FirstOrDefault(h => h.RmCreditLimitGfl.HasValue && h.RmCreditLimitGfl > 0);
    _previousRmCreditLimitGfl = rmGflApproval?.RmCreditLimitGfl;

    // Fetch SM approved limits (both SPIC and GFL)
    var smSpicApproval = _approvalHistory?
        .Where(h => h.IsApproved)
        .OrderByDescending(h => h.ApprovedAt)
        .FirstOrDefault(h => h.SmCreditLimit.HasValue && h.SmCreditLimit > 0);
    _previousSmCreditLimit = smSpicApproval?.SmCreditLimit;

    var smGflApproval = _approvalHistory?
        .Where(h => h.IsApproved)
        .OrderByDescending(h => h.ApprovedAt)
        .FirstOrDefault(h => h.SmCreditLimitGfl.HasValue && h.SmCreditLimitGfl > 0);
    _previousSmCreditLimitGfl = smGflApproval?.SmCreditLimitGfl;

    if (IsNewDealerFinalApproval)
    {
        _selectedDealerCodePrefix = GetDefaultDealerCodePrefix();
        _avpDealerCode = string.Empty;
    }

    IsConfirmProceedPopupVisible = true;
    StateHasChanged();

    // Only the final New Dealer AVP/Admin popup needs a Dealer Code preview.
    // Existing Dealer, RM and SM approval popup behaviour stays unchanged.
    if (IsNewDealerFinalApproval)
        await LoadDealerCodePreviewAsync();
}

private string GetDefaultDealerCodePrefix()
{
    if (_dealer == null)
        return "D";

    // If an earlier migration/manual record already contains a company code,
    // prefer its prefix. New Dealer records normally reach AVP with these empty.
    foreach (var code in new[]
    {
        _dealer.SPICCode,
        _dealer.GreenStarCode,
        _dealer.NCode,
        _dealer.TnCode
    })
    {
        if (string.IsNullOrWhiteSpace(code))
            continue;

        var prefix = code.Trim().Substring(0, 1).ToUpperInvariant();
        if (_dealerCodePrefixes.Contains(prefix, StringComparer.OrdinalIgnoreCase))
            return prefix;
    }

    // Preserve the applicant's company selection as the default suggestion.
    // AVP can still choose any allowed prefix in the dropdown.
    if (_dealer.InSpic)
        return "D";

    if (_dealer.InGreenStar)
        return "N";

    return "D";
}

private async Task OnDealerCodePrefixChanged(ChangeEventArgs args)
{
    var prefix = args.Value?.ToString()?.Trim().ToUpperInvariant();
    if (string.IsNullOrWhiteSpace(prefix) ||
        !_dealerCodePrefixes.Contains(prefix, StringComparer.OrdinalIgnoreCase))
    {
        return;
    }

    _selectedDealerCodePrefix = prefix;
    await LoadDealerCodePreviewAsync();
}

private async Task LoadDealerCodePreviewAsync()
{
    if (_dealer == null || !IsNewDealerFinalApproval)
        return;

    _isDealerCodePreviewLoading = true;
    _dealerCodePreviewError = null;
    _avpDealerCode = string.Empty;
    StateHasChanged();

    try
    {
        var prefix = Uri.EscapeDataString(_selectedDealerCodePrefix);
        using var response = await Http.GetAsync(
            $"api/DealerRegistration/{_dealer.Id}/dealer-code-preview?prefix={prefix}");

        if (!response.IsSuccessStatusCode)
        {
            _dealerCodePreviewError = await ReadErrorAsync(response);
            return;
        }

        var preview = await response.Content.ReadFromJsonAsync<DealerCodePreviewDto>();
        if (preview == null || string.IsNullOrWhiteSpace(preview.DealerCode))
        {
            _dealerCodePreviewError = "Dealer Code preview was empty. Please select the prefix again.";
            return;
        }

        _selectedDealerCodePrefix = string.IsNullOrWhiteSpace(preview.Prefix)
            ? _selectedDealerCodePrefix
            : preview.Prefix.Trim().ToUpperInvariant();

        _avpDealerCode = preview.DealerCode.Trim().ToUpperInvariant();
    }
    catch (Exception ex)
    {
        _dealerCodePreviewError = "Could not generate Dealer Code preview. Please try again.";
        Console.WriteLine($"[SavedDealerReview] dealer-code-preview: {ex}");
    }
    finally
    {
        _isDealerCodePreviewLoading = false;
        StateHasChanged();
    }
}

private void HideConfirmProceedPopup()
    {
        IsConfirmProceedPopupVisible = false;
        StateHasChanged();
    }

    private async Task<string?> ReadErrorAsync(HttpResponseMessage response)
    {
        try
        {
            var payload = await response.Content.ReadFromJsonAsync<Dictionary<string, string>>();
            if (payload != null && payload.TryGetValue("message", out var msg) && !string.IsNullOrWhiteSpace(msg))
                return msg;
        }
        catch { }
        return $"Request failed ({(int)response.StatusCode}). Please try again.";
    }

