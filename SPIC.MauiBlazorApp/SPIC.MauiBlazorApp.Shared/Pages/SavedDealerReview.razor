<style>
    /* native: phone */
    /* Review actions render through ActionBar. Tablet/desktop keep the previous inline spacing
       (mt-3 mb-5 px-4) so nothing moves above 768px; on phones the bar is sticky at the bottom. */
    @@media (min-width: 768px) {
        .fb-actionbar.sdr-review-actions { margin: 1rem 0 3rem; padding: 0 1.5rem; }
    }

    @@media (max-width: 767.98px) {
        .fb-actionbar--sticky.sdr-review-actions .btn-submit,
        .fb-actionbar--sticky.sdr-review-actions .btn { min-height: var(--tap-min, 44px); }

        /* Review tables scroll inside their .table-responsive wrapper instead of squeezing. */
        .sdr-review-page .rv-table { table-layout: auto; min-width: 560px; }
        .sdr-review-page .sales-table { min-width: 560px; }

        .sdr-review-page .file-view-btn { min-height: 40px; padding: 6px 12px; font-size: 0.8rem; }
        .sdr-review-page .approved-btn { white-space: normal; }

        /* Approval progress: at 392px the four stages (MO / RM / SM / AVP) plus the
           130px connector lines overflowed .approval-steps-wrapper, so everything
           after MO was cut off at the card edge with no scroll affordance. Lay the
           stages out as a 2x2 grid on phones and drop the connectors. */
        .approval-card { padding: 16px; }

        .approval-steps-wrapper {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 14px 10px;
            align-items: start;
            overflow-x: visible;
