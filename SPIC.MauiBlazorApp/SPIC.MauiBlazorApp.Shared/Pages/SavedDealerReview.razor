    private bool IsDealerSubmitted()
    {
        return _dealer != null;
    }

    private string GetApprovalStage()
    {
        if (_dealer == null) return "-";

        if (_dealer.RMApproved == false || _dealer.SMApproved == false || _dealer.AVPApproved == false)
            return "Rejected";

        if (_dealer.AVPApproved == true)
            return "Approved";

        bool isComplete = _dealer.PinCode != null && _dealer.PinCode.Trim() != "";
        if (!isComplete) return "Submitted";

        if (_dealer.RMApproved == null)
            return "In RM";

        if (_dealer.RMApproved == true && _dealer.SMApproved == null)
            return "In SMM";

        if (_dealer.RMApproved == true && _dealer.SMApproved == true && _dealer.AVPApproved == null)
            return "In AVP";

        return "Submitted";
    }

    private readonly string[] RmRoles = { "RM", "RMD" };
    private readonly string[] SmRoles = { "SMD", "SMM" };
    private readonly string[] FinalApprovalRoles = { "AVP", "CorporateAdmin" };

    private bool CanShowApprovalButton()
    {
        if (_dealer == null)
            return false;

        if (LoginState.IsRMGroup)
            return _dealer.RMApproved == null || (_dealer.RMApproved == true && _dealer.SMApproved == false);

        if (LoginState.IsSMGroup)
            return (_dealer.RMApproved == true && _dealer.SMApproved == null) || (_dealer.RMApproved == true && _dealer.SMApproved == true && _dealer.AVPApproved == false);

        if (LoginState.IsDirectorOrAVP)
            return _dealer.RMApproved == true && _dealer.SMApproved == true && _dealer.AVPApproved == null;

        if (LoginState.IsAdmin)
            return _dealer.RMApproved == true && _dealer.SMApproved == true && _dealer.AVPApproved == null;

        return false;
    }

    private string ApprovalButtonText()
    {
        if (LoginState.IsRMGroup) return "Proceed to SM";
        if (LoginState.IsSMGroup) return "Proceed to AVP";
        if (LoginState.IsDirectorOrAVP || LoginState.IsAdmin) return "Approve";
        return "Approve";
    }
}

