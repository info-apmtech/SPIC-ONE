    <!-- Approval Progress -->
    <div class="approval-card mb-3">
        <div class="approval-step completed">
            <div class="step-circle">
                <i class="bi bi-check-lg"></i>
            </div>
            <div>
                <div class="step-title">MO</div>
                <div class="step-status">Submitted</div>
            </div>
        </div>

        <div class="step-line completed-line"></div>

        <div class="approval-step active">
            <div class="step-circle">RM</div>
            <div>
                <div class="step-title">RM</div>
                <div class="step-status">@( _dealer?.RMApproved == null ? "Under Review" : (_dealer.RMApproved == true ? "Approved" : "Rejected") )</div>
            </div>
        </div>

        <div class="step-line active-line"></div>

        <div class="approval-step pending">
            <div class="step-circle">SM</div>
            <div>
                <div class="step-title">SM</div>
                <div class="step-status">@(_dealer?.SMApproved == null ? "Pending" : (_dealer.SMApproved == true ? "Approved" : "Rejected"))</div>
            </div>
        </div>

        <div class="step-line"></div>

        <div class="approval-step pending">
            <div class="step-circle">AVP</div>
            <div>
                <div class="step-title">AVP</div>
                <div class="step-status">@(_dealer?.AVPApproved == null ? "Pending" : (_dealer.AVPApproved == true ? "Approved" : "Rejected"))</div>
            </div>
        </div>
    </div>
    
    <!-- Redesigned Horizontal Timeline View -->
    <div class="timeline-box">
        <h5 class="timeline-heading">Timeline</h5>

        <div class="timeline-scroll">
            @foreach (var item in TimelineItems)
            {
                <div class="timeline-col">
                    <div class="timeline-dot @item.DotClass">
                        @if (!string.IsNullOrEmpty(item.Icon))
                        {
                            <i class="@item.Icon"></i>
                        }
                    </div>

                    <div class="timeline-small-card @item.CardClass">
                        <div class="timeline-title-row">
                            <div class="timeline-title">@item.Title</div>
                            <i class="bi bi-eye text-primary" style="cursor:pointer;"></i>
                        </div>

                        <span class="timeline-status @item.BadgeClass">@item.Status</span>

                        <div class="timeline-user">@item.UserName</div>

                        <div class="timeline-date">
                            <i class="bi bi-calendar-event me-1"></i>
                            @item.DateText
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <h4 class="sent-title">Recent Actions</h4>

