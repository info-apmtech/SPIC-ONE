    <div class="custom-accordion @(IsAnnualSalesOpen ? "active" : "")">
        <div class="accordion-header" @onclick="() => IsAnnualSalesOpen = !IsAnnualSalesOpen">
            Annual Sales Data
            <i class="bi bi-chevron-down"></i>
        </div>
        <div class="accordion-body">
            <div class="detail-card">
                <div class="detail-card-header">
                    <h4 class="detail-card-title"><i class="bi bi-file-earmark-spreadsheet"></i> Last Financial Year</h4>
                    <i class="bi bi-pencil-square edit-icon"></i>
                </div>
                <div class="table-responsive">
                    <table class="sales-table">
                        <thead>
                            <tr>
                                <th>S:No</th>
                                <th>Product</th>
                                <th>Category</th>
                                <th>Own Retail Qty (MT)</th>
                                <th>Own Retail Amount (₹)</th>
                                <th>Sales to Dealers Qty (MT)</th>
                                <th>Sales to Dealers Amount (₹)</th>
                                <th>Total Qty (MT)</th>
                                <th>Total Amount (₹)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_annualSales != null && _annualSales.Any())
                            {
                                var idx = 1;
                                foreach (var a in _annualSales)
                                {
                                    var product = _products.FirstOrDefault(p => p.Id == a.ProductId);
                                    var category = _categories.FirstOrDefault(c => c.Id == a.CategoryId);
                                    <tr>
                                        <td>@idx</td>
                                        <td>@(product?.Name ?? a.ProductId.ToString())</td>
                                        <td>@(category?.Name ?? a.CategoryId.ToString())</td>
                                        <td>@a.OwnRetailsSaleQty.ToString("N2")</td>
                                        <td>@a.OwnRetailsSaleAmount.ToString("N2")</td>
                                        <td>@a.SaleToDealerQty.ToString("N2")</td>
                                        <td>@a.SaleToDealerAmount.ToString("N2")</td>
                                        <td>@((a.OwnRetailsSaleQty + a.SaleToDealerQty).ToString("N2"))</td>
                                        <td>@((a.OwnRetailsSaleAmount + a.SaleToDealerAmount).ToString("N2"))</td>
                                    </tr>
                                    idx++;
                                }
                                <tr class="grand-total-row">
                                    <td colspan="3" style="text-align: right; padding-right: 40px;">GRAND TOTAL</td>
                                    <td>@_annualSales.Sum(x => x.OwnRetailsSaleQty).ToString("N2")</td>
                                    <td>@_annualSales.Sum(x => x.OwnRetailsSaleAmount).ToString("N2")</td>
                                    <td>@_annualSales.Sum(x => x.SaleToDealerQty).ToString("N2")</td>
                                    <td>@_annualSales.Sum(x => x.SaleToDealerAmount).ToString("N2")</td>
