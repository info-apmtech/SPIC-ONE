        <div class="row g-4">
            <div class="col-12 col-lg-6">
                <div class="detail-box">
                    <h5>Action Details</h5>

                    <div class="info-row">
                        <span>Action</span>
                        <strong>@(latest.Remarks?.Contains("Sections:") == true ? "Sent Back" : "Updated")</strong>
                    </div>

                    <div class="info-row">
                        <span>Action By</span>
                        <strong>@(latest.ApprovedBy ?? "-")</strong>
                    </div>

                    <div class="info-row">
                        <span>Role</span>
                        <strong>@(latest.Role ?? "-")</strong>
                    </div>

                    <div class="info-row">
