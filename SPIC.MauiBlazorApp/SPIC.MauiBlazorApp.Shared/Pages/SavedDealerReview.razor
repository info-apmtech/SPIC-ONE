    }
    
    .timeline-scroll { 
        display: flex; 
        overflow-x: auto; 
        padding-bottom: 12px;
        scrollbar-width: thin; /* For Firefox */
    }
    .timeline-scroll::-webkit-scrollbar { height: 8px; }
    .timeline-scroll::-webkit-scrollbar-thumb { background: #d1d5db; border-radius: 4px; }
    
    .timeline-col { 
        position: relative; 
        min-width: 240px; 
        width: 240px; 
        padding-right: 16px; 
        display: flex; 
        flex-direction: column; 
    }
    
    /* Horizontal Line drawn perfectly center-to-center */
    .timeline-col::after {
        content: '';
        position: absolute;
        top: 16px; /* Half of the 32px dot */
        left: 48px; /* Offset to start right after the first dot */
        width: calc(100% - 32px); /* Stretch to the next item */
        height: 2px;
        background: #e5e7eb;
        z-index: 1;
    }
    .timeline-col:last-child::after { 
        display: none; 
    }
    
    .timeline-dot { 
