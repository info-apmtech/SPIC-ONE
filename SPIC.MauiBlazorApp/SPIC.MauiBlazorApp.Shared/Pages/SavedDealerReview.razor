@code {
    // Blazor State Variables to control the open/close behavior of each accordion
    private bool IsCompanyDetailsOpen { get; set; } = false;
    private bool IsExperienceOpen { get; set; } = false;
    private bool IsAnnualSalesOpen { get; set; } = false;
    private bool IsWarehouseOpen { get; set; } = false;
    private bool IsMarketDetailsOpen { get; set; } = false;
    private bool IsProprietorDetailsOpen { get; set; } = false;
    private bool IsCompaniesOperatingOpen { get; set; } = false;
    private bool IsSalesPlanningOpen { get; set; } = false;
    private bool IsInvestmentOpen { get; set; } = false;
    private bool IsCreditLimitOpen { get; set; } = false;
    private bool IsEnclosuresOpen { get; set; } = false;
  
    // private string _currentUserRole = "RM"; // replace with login role
private bool _isApproving = false;

private bool IsDealerSubmitted()
{
    return _dealer != null;
}

private readonly string[] RmRoles = { "RM", "RMD" };
private readonly string[] SmRoles = { "SMD", "SMM" };
private readonly string[] FinalApprovalRoles = { "AVP", "CorporateAdmin" };

private bool CanShowApprovalButton()
{
    if (_dealer == null)
        return false;

    // RM can approve first
    if (LoginState.IsRegionRole)
        return _dealer.RMApproved == null;

    // SM can approve only after RM
    if (LoginState.IsStateRole)
        return _dealer.RMApproved == true && _dealer.SMApproved == null;

    // Admin / AVP can final approve only after SM
    if (LoginState.IsAdmin)
        return _dealer.RMApproved == true
            && _dealer.SMApproved == true
            && _dealer.AVPApproved == null;

    return false;
}

private string ApprovalButtonText()
{
    if (LoginState.IsRegionRole)
        return "Proceed to SM";

    if (LoginState.IsStateRole)
        return "Proceed to AVP";

    if (LoginState.IsAdmin)
        return "Approve";

    return "Approve";
}

private async Task ApproveDealer()
{
    if (_dealer == null)
        return;

    _isApproving = true;

    try
    {
        if (LoginState.IsRegionRole)
        {
            _dealer.RMApproved = true;
        }
        else if (LoginState.IsStateRole)
        {
            _dealer.SMApproved = true;
        }
        else if (LoginState.IsAdmin)
        {
            _dealer.AVPApproved = true;
            _dealer.Status = DR.DealerStatus.Active;
        }

        var response = await Http.PutAsJsonAsync(
            $"api/DealerRegistration/{_dealer.Id}",
            _dealer
        );

        if (response.IsSuccessStatusCode)
        {
            Nav.NavigateTo("/Dashboard", forceLoad: true);
        }
    }
    finally
    {
        _isApproving = false;
    }
}

private string GetSubmittedByText()
{
    if (_dealer == null)
        return "-";

    // Change property names if your DealerRegistration has different fields
    if (!string.IsNullOrWhiteSpace(_dealer.CreatedBy))
        return _dealer.CreatedBy;

    if (!string.IsNullOrWhiteSpace(_dealer.CreatedBy))
        return _dealer.CreatedBy;

    return "-";
}

private string GetDealerStatusText()
{
    if (_dealer == null)
        return "-";

    if (_dealer.AVPApproved == true)
        return "Approved";

    if (_dealer.SMApproved == true)
        return "Pending AVP";

    if (_dealer.RMApproved == true)
        return "Pending SM";

    if (_dealer.RMApproved == false || _dealer.SMApproved == false || _dealer.AVPApproved == false)
        return "Sent Back";

    return "Pending RM";
}
private RenderFragment RenderApprovalStep(
    string title,
    string stepClass,
    string status,
    bool showCheckIcon = false
) => @<div class="approval-step @stepClass">
    <div class="step-circle">
        @if (stepClass == "completed")
        {
            <i class="bi bi-check-lg"></i>
        }
        else
        {
            @title
        }
    </div>
    <div>
        <div class="step-title">@title</div>
        <div class="step-status">@status</div>
    </div>
</div>;

private string GetMoClass()
{
    return _dealer != null ? "completed" : "pending";
}

private string GetRmClass()
{
    if (_dealer == null) return "pending";

    if (_dealer.RMApproved == true)
        return "completed";

    if (_dealer.RMApproved == null)
        return "active";

    return "pending";
}

private string GetSmClass()
{
    if (_dealer == null) return "pending";

    if (_dealer.RMApproved == true && _dealer.SMApproved == true)
        return "completed";

    if (_dealer.RMApproved == true && _dealer.SMApproved == null)
        return "active";

    return "pending";
}

private string GetAvpClass()
{
    if (_dealer == null) return "pending";

    if (_dealer.AVPApproved == true)
        return "completed";

    if (_dealer.RMApproved == true && _dealer.SMApproved == true && _dealer.AVPApproved == null)
        return "active";

    return "pending";
}

private string GetMoStatus()
{
    return _dealer != null ? "Submitted" : "Pending";
}

private string GetRmStatus()
{
    if (_dealer?.RMApproved == true) return "Approved";
    if (_dealer?.RMApproved == false) return "Sent Back";
    if (_dealer != null) return "Under Review";

    return "Pending";
}

private string GetSmStatus()
{
    if (_dealer?.SMApproved == true) return "Approved";
    if (_dealer?.SMApproved == false) return "Sent Back";
    if (_dealer?.RMApproved == true) return "Under Review";

    return "Pending";
}

private string GetAvpStatus()
{
    if (_dealer?.AVPApproved == true) return "Approved";
    if (_dealer?.AVPApproved == false) return "Sent Back";
    if (_dealer?.RMApproved == true && _dealer.SMApproved == true) return "Under Review";

    return "Pending";
}

private string GetLineClass(string afterStep)
{
    if (_dealer == null) return "";

    return afterStep switch
    {
        "MO" => _dealer.RMApproved == true ? "completed-line" : "active-line",

        "RM" => _dealer.RMApproved == true && _dealer.SMApproved == true
            ? "completed-line"
            : _dealer.RMApproved == true
                ? "active-line"
                : "",

        "SM" => _dealer.RMApproved == true && _dealer.SMApproved == true && _dealer.AVPApproved == true
            ? "completed-line"
            : _dealer.RMApproved == true && _dealer.SMApproved == true
                ? "active-line"
                : "",

        _ => ""
    };
}
