         new("Under Review by AVP", "Pending", "Ramesh Kumar", "10 Apr 2026, 04:15 PM", "dot-gray", "", "", "badge-orange")
     };

     private bool IsSendBackPopupVisible { get; set; } = false;

     private void ShowSendBackPopup()
     {
         IsSendBackPopupVisible = true;
     }

     private void HideSendBackPopup()
     {
         IsSendBackPopupVisible = false;
     }

    public record TimelineItem(
        string Title,
        string Status,
        string UserName,
        string DateText,
        string DotClass,
        string Icon,
        string CardClass,
        string BadgeClass
    );

}

