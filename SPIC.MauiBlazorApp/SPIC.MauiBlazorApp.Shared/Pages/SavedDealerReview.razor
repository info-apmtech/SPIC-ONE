private async Task ApproveDealer()
{
    if (_dealer == null) return;

    _isApproving = true;
    StateHasChanged();

    try
    {
        // New Dealer flow: remarks are mandatory at every approval stage.
        if (_isNewDealer && string.IsNullOrWhiteSpace(ConfirmRemarks))
        {
            _approvalError = "Remarks are required for New Dealer approval.";
            return;
        }

        // New Dealer final (AVP) approval: AVP must review the generated code
        // shown in this popup. The server validates the selected prefix, confirms
        // that the reviewed code is still the next available code, then saves the
        // approval + DealerCode + company code fields in one final-approval step.
        if (IsNewDealerFinalApproval)
        {
            if (_isDealerCodePreviewLoading)
            {
                _approvalError = "Please wait until the Dealer Code preview is generated.";
                return;
            }

            if (string.IsNullOrWhiteSpace(_avpDealerCode))
            {
                _approvalError = "Select a Dealer Code prefix and review the generated Dealer Code before approval.";
                return;
            }

            var approveResp = await Http.PostAsJsonAsync(
                $"api/DealerRegistration/{_dealer.Id}/final-approve",
                new
                {
                    Remarks = ConfirmRemarks,
                    Prefix = _selectedDealerCodePrefix,
                    DealerCode = _avpDealerCode
                });

            if (!approveResp.IsSuccessStatusCode)
            {
                _approvalError = await ReadErrorAsync(approveResp);

                // A preview can become stale if another New Dealer is approved in
                // parallel. Refresh only the preview; do not close the popup or
                // change any of the previous approval flow.
                if (approveResp.StatusCode == System.Net.HttpStatusCode.Conflict)
                    await LoadDealerCodePreviewAsync();

                return;
            }

            _dealer = await Http.GetFromJsonAsync<DR.DealerRegistration>($"api/DealerRegistration/{_dealer.Id}");
            MarkDataChanged();
            IsConfirmProceedPopupVisible = false;
            _showSuccessNotification = true;
            StateHasChanged();
            await Task.Delay(3000);
            _showSuccessNotification = false;
            Nav.NavigateTo("/Dashboard");
            return;
        }

        if (LoginState.IsRMGroup)
        {
            _dealer.RMApproved = true;
            if (_dealer.SMApproved == false) _dealer.SMApproved = null;
        }
        else if (LoginState.IsSMGroup)
        {
            _dealer.SMApproved = true;
            if (_dealer.AVPApproved == false) _dealer.AVPApproved = null;
        }
        else if (LoginState.IsDirectorOrAVP || LoginState.IsAdmin)
        {
            _dealer.AVPApproved = true;
            _dealer.Status = DR.DealerStatus.Active;
        }

        if (_dealer.IsCreditLimitConsentGiven)
        {
            _dealer.CashCreditLimit = 0;
            _rmCreditLimitSpic = 0;
            _rmCreditLimitGfl = 0;
            _smCreditLimitSpic = 0;
            _smCreditLimitGfl = 0;
            _avpCreditLimitSpic = 0;
            _avpCreditLimitGfl = 0;
        }

        // The approval flags above were written onto the already-loaded registration,
        // which reference comparison cannot detect, so tell the sections explicitly.
        MarkDataChanged();

        var response = await Http.PutAsJsonAsync($"api/DealerRegistration/{_dealer.Id}", _dealer);

        if (response.IsSuccessStatusCode)
        {
            var role = LoginState.UserRole?.ToString() ?? "";
            var history = new DR.DealerApprovalHistory
            {
                DealerId = _dealer.Id,
                ApprovedBy = LoginState.UserId ?? "",
                Role = role,
                ApprovedAt = DateTime.Now,
                Remarks = string.IsNullOrWhiteSpace(ConfirmRemarks) ? "" : ConfirmRemarks,
                IsApproved = true,
                RmCreditLimit = _dealer.IsCreditLimitConsentGiven ? 0m : _rmCreditLimitSpic,
                RmCreditLimitGfl = _dealer.IsCreditLimitConsentGiven ? 0m : _rmCreditLimitGfl,
                SmCreditLimit = _dealer.IsCreditLimitConsentGiven ? 0m : _smCreditLimitSpic,
                SmCreditLimitGfl = _dealer.IsCreditLimitConsentGiven ? 0m : _smCreditLimitGfl,
                AvpCreditLimit = _dealer.IsCreditLimitConsentGiven ? 0m : _avpCreditLimitSpic,
                AvpCreditLimitGfl = _dealer.IsCreditLimitConsentGiven ? 0m : _avpCreditLimitGfl
            };
            try { await Http.PostAsJsonAsync("api/DealerApprovalHistory", history); } catch { }

            if (!_dealer.IsCreditLimitConsentGiven)
            {
                await SaveCreditLimitHistoryApprovalsAsync();
            }

            IsConfirmProceedPopupVisible = false;
            _showSuccessNotification = true;
            StateHasChanged();
            await Task.Delay(3000);
            _showSuccessNotification = false;
            Nav.NavigateTo("/Dashboard");
        }
    }
    finally
    {
        _isApproving = false;
        StateHasChanged();
    }
}

    private async Task SaveCreditLimitHistoryApprovalsAsync()
    {
        if (_dealer == null) return;

        try
        {
            var histories = await Http.GetFromJsonAsync<List<DR.CreditLimitHistory>>($"api/CreditLimitHistory/byDealer/{_dealer.Id}") ?? new();

            await UpdateApprovalForCreditTypeAsync(histories, DR.CreditType.SPIC, _rmCreditLimitSpic, _smCreditLimitSpic, _avpCreditLimitSpic);
            await UpdateApprovalForCreditTypeAsync(histories, DR.CreditType.Greenstar, _rmCreditLimitGfl, _smCreditLimitGfl, _avpCreditLimitGfl);
        }
        catch { Toast.Error("Could not update the credit limit approval history."); }
    }

    private async Task UpdateApprovalForCreditTypeAsync(
        List<DR.CreditLimitHistory> histories,
        DR.CreditType creditType,
        decimal? rmLimit,
        decimal? smLimit,
        decimal? avpLimit)
    {
        if (!rmLimit.HasValue && !smLimit.HasValue && !avpLimit.HasValue)
            return;

        var record = histories
            .Where(h => h.CreditType == creditType)
            .OrderByDescending(h => h.CreatedAt)
            .FirstOrDefault();

        if (record == null) return;

        if (rmLimit.HasValue) record.RMApprovedCreditLimit = rmLimit;
        if (smLimit.HasValue) record.SMApprovedCreditLimit = smLimit;
        if (avpLimit.HasValue) record.AVPApprovedCreditLimit = avpLimit;

        await Http.PutAsJsonAsync($"api/CreditLimitHistory/{record.Id}", record);
    }

