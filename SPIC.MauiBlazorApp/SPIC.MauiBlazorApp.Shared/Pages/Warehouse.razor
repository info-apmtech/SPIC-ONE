@page "/Warehouse"
@using System.Net.Http.Json
@using System.Text.RegularExpressions
@using System.Globalization
@using SPIC.Core.Entities
@using WarehouseEntity = SPIC.Core.Entities.Warehouse
@using DealerReg = SPIC.Core.Entities.DealerRegistration
@using SPIC.MauiBlazorApp.Shared.FormFlow
@inject HttpClient Http
@inject NavigationManager Nav
@inject LoadingService Loading
<style>
	fieldset:disabled .icon-delete {
		display: none !important;
	}

	fieldset:disabled .icon-edit {
		display: none !important;
	}
</style>
<div class="container-fluid py-4 px-0">
	<FormLoader />
	<fieldset disabled="@IsViewOnly" style="border:0;padding:0;margin:0;">

		@if (!string.IsNullOrEmpty(_message))
		{
			<div class="alert @(_isError ? "alert-danger" : "alert-success") alert-dismissible fade show mb-3" role="alert">
				@_message
				<button type="button" class="btn-close" @onclick='() => _message = null'></button>
			</div>
		}

		<div class="company-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
			<h3 class="fw-bold m-0 company-title">Warehouse & Logistics</h3>
		</div>

		<div class="logistics-note mb-4">
			<div class="note-header">
				<i class="bi bi-exclamation-circle"></i> Logistics Note Information
			</div>
			<p class="note-text">
				A minimum of two Warehouses, two Rail Head, and two Port must be configured to proceed further
			</p>
		</div>

		<div class="form-card">
			<!-- Header -->
			<div class="d-flex justify-content-between align-items-center py-3 flex-wrap gap-2">
				<div class="card-header-title mb-0">
					<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/WarehouseHeader.svg"
						 class="formicon" />
					Nearest Facilities
				</div>

				<button class="btn-verified">
					<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/Verifiedicon.svg"
						 class="verifyicon" />
					Active Entry
				</button>
			</div>

			<div class="row g-4">

				<!-- Warehouse Card -->
				<div class="col-md-4">
					<div class="facility-card">
						<div class="d-flex align-items-center mb-4">
							<div class="facility-icon-wrapper bg-soft-green text-green">
								<i class="bi bi-shop"></i>
							</div>
							<h3 class="facility-card-title">Warehouse</h3>
						</div>

						<!-- SEARCHABLE DROPDOWN FOR WAREHOUSE -->
						<div class="mb-3 position-relative">
							<label class="custom-label">Facility Name</label>
							<input type="text" class="custom-input custom-select"
								   placeholder="Search and Select Facility..."
								   @bind="_warehouseSearchText"
								   @bind:event="oninput"
								   @onfocus="() => _showWarehouseDropdown = true"
								   @onblur="HideWarehouseDropdownDelay" />

							@if (_showWarehouseDropdown)
							{
								<div class="dropdown-list-container">
									<div class="dropdown-item-custom text-muted" @onmousedown='() => SelectWarehouse(0, "")'>
										-- Select Facility Name --
									</div>
									@foreach (var w in _warehouses.Where(x => string.IsNullOrWhiteSpace(_warehouseSearchText) ||
																			  $"{x.WarehouseCode} - {x.Name}".Contains(_warehouseSearchText, StringComparison.OrdinalIgnoreCase)))
									{
										<div class="dropdown-item-custom" @onmousedown='() => SelectWarehouse(w.Id, $"{w.WarehouseCode} - {w.Name}")'>
											@w.WarehouseCode - @w.Name
										</div>
									}
								</div>
							}
						</div>

						<div class="row g-2 mb-4">
							<div class="col-6">
								<label class="custom-label">Distance (KM)</label>
								<div class="input-icon-wrapper">
									<input type="text" class="custom-input" placeholder="0.0" value="@WhDistanceDisplay" readonly>
									@if (_isCalculatingWhDistance)
									{
										<i class="bi bi-arrow-repeat spin"></i>
									}
									else
									{
										<i class="bi bi-map"></i>
									}
								</div>
							</div>
							<div class="col-6">
								<label class="custom-label">Freight (₹/ton/Km) </label>
								<input type="number" class="custom-input" placeholder="0.0" @bind="_whFreight" step="0.01">
							</div>
						</div>

						<div class="mt-auto">
							<button class="btn-add-action" @onclick="AddWarehouse" disabled="@(_selectedWarehouseId == 0 || _isCalculatingWhDistance)">
								<i class="bi bi-plus-lg"></i> @(_editingWhId > 0 ? "Update" : "Add") Warehouse
							</button>
						</div>
					</div>
				</div>

				<!-- Rail Head Card -->
				<div class="col-md-4">
					<div class="facility-card">
						<div class="d-flex align-items-center mb-4">
							<div class="facility-icon-wrapper bg-soft-blue text-blue">
								<i class="bi bi-train-front"></i>
							</div>
							<h3 class="facility-card-title">Rail Head</h3>
						</div>

						<div class="mb-3 position-relative">
							<label class="custom-label">Facility Name</label>
							<input type="text" class="custom-input custom-select"
								   placeholder="Search and Select Facility..."
								   @bind="_railSearchText"
								   @bind:event="oninput"
								   @onfocus="() => _showRailDropdown = true"
								   @onblur="HideRailDropdownDelay" />

							@if (_showRailDropdown)
							{
								<div class="dropdown-list-container">
									<div class="dropdown-item-custom text-muted" @onmousedown='() => SelectRail(0, "")'>
										-- Select Facility Name --
									</div>
									@foreach (var r in _rackPoints.Where(x => string.IsNullOrWhiteSpace(_railSearchText) ||
																			  x.Name.Contains(_railSearchText, StringComparison.OrdinalIgnoreCase)))
									{
										<div class="dropdown-item-custom" @onmousedown='() => SelectRail(r.Id, r.Name)'>
											@r.Name
										</div>
									}
								</div>
							}
						</div>

						<div class="row g-2 mb-4">
							<div class="col-6">
								<label class="custom-label">Distance (KM)</label>
								<div class="input-icon-wrapper">
									<input type="text" class="custom-input" placeholder="0.0" value="@RailDistanceDisplay" readonly>
									@if (_isCalculatingRailDistance)
									{
										<i class="bi bi-arrow-repeat spin"></i>
									}
									else
									{
										<i class="bi bi-map"></i>
									}
								</div>
							</div>
							<div class="col-6">
								<label class="custom-label">Freight (₹/ton/Km)</label>
								<input type="number" class="custom-input" placeholder="0.0" @bind="_railFreight" step="0.01">
							</div>
						</div>

						<div class="mt-auto">
							<button class="btn-add-action" @onclick="AddRailHead" disabled="@(_selectedRailId == 0 || _isCalculatingRailDistance)">
								<i class="bi bi-plus-lg"></i> @(_editingRailId > 0 ? "Update" : "Add") Rail Head
							</button>
						</div>
					</div>
				</div>

				<!-- Port Card -->
				<div class="col-md-4">
					<div class="facility-card">
						<div class="d-flex align-items-center mb-4">
							<div class="facility-icon-wrapper bg-soft-pink text-pink">
								<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/PortIcon.svg" class="formicon" />
							</div>
							<h3 class="facility-card-title">Port</h3>
						</div>

						<div class="mb-3 position-relative">
							<label class="custom-label">Facility Name</label>
							<input type="text" class="custom-input custom-select"
								   placeholder="Search and Select Facility..."
								   @bind="_portSearchText"
								   @bind:event="oninput"
								   @onfocus="() => _showPortDropdown = true"
								   @onblur="HidePortDropdownDelay" />

							@if (_showPortDropdown)
							{
								<div class="dropdown-list-container">
									<div class="dropdown-item-custom text-muted" @onmousedown='() => SelectPort(0, "")'>
										-- Select Facility Name --
									</div>
									@foreach (var p in _ports.Where(x => string.IsNullOrWhiteSpace(_portSearchText) ||
																		 x.Name.Contains(_portSearchText, StringComparison.OrdinalIgnoreCase)))
									{
										<div class="dropdown-item-custom" @onmousedown='() => SelectPort(p.Id, p.Name)'>
											@p.Name
										</div>
									}
								</div>
							}
						</div>

						<div class="row g-2 mb-4">
							<div class="col-6">
								<label class="custom-label">Distance (KM)</label>
								<div class="input-icon-wrapper">
									<input type="text" class="custom-input" placeholder="0.0" value="@PortDistanceDisplay" readonly>
									@if (_isCalculatingPortDistance)
									{
										<i class="bi bi-arrow-repeat spin"></i>
									}
									else
									{
										<i class="bi bi-map"></i>
									}
								</div>
							</div>
							<div class="col-6">
								<label class="custom-label">Freight (₹/ton/Km)</label>
								<input type="number" class="custom-input" placeholder="0.0" @bind="_portFreight" step="0.01">
							</div>
						</div>

						<div class="mt-auto">
							<button class="btn-add-action" @onclick="AddPort" disabled="@(_selectedPortId == 0 || _isCalculatingPortDistance)">
								<i class="bi bi-plus-lg"></i> @(_editingPortId > 0 ? "Update" : "Add") Port
							</button>
						</div>
					</div>
				</div>

			</div>
		</div>

		<!-- Selected Nearest Facilities -->
		@{
			var totalCount = _savedWarehouses.Count + _savedRails.Count + _savedPorts.Count;
		}
		<div class="form-card">
			<div class="d-flex justify-content-between align-items-center mb-4">
				<div class="card-header-title mb-0">
					<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/Active .svg"
						 class="formicon" /> Selected Nearest Facilities
				</div>
				<div class="fw-bold fs-5 text-dark">@totalCount</div>
			</div>

			<div class="row g-4">

				@foreach (var wh in _savedWarehouses)
				{
					var whName = _warehouses.FirstOrDefault(w => w.Id == wh.WarehouseId)?.Name ?? "Warehouse";
					<div class="col-md-4">
						<div class="active-infra-card">
							<div class="d-flex justify-content-between align-items-start">
								<div class="d-flex gap-3">
									<div class="facility-icon-wrapper bg-soft-green text-green m-0">
										<i class="bi bi-shop"></i>
									</div>
									<div>
										<div class="infra-type-label">WAREHOUSE</div>
										<h4 class="infra-name">@whName</h4>
									</div>
								</div>
								<div class="action-icons">
									<i class="bi bi-pencil-square icon-edit" style="cursor:pointer" @onclick="() => EditWarehouse(wh)"></i>
									<i class="bi bi-trash icon-delete" style="cursor:pointer" @onclick="() => ConfirmDeleteWarehouse(wh)"></i>
								</div>
							</div>

							<div class="row g-2 mt-2">
								<div class="col-6">
									<div class="stat-box green">
										<div class="stat-label">Distance</div>
										<div class="stat-value">@wh.Distance.ToString("F1") <span class="stat-unit">KM</span></div>
									</div>
								</div>
								<div class="col-6">
									<div class="stat-box green">
										<div class="stat-label">Freight Cost</div>
										<div class="stat-value">₹ @wh.Freight.ToString("N0") <span class="stat-unit">/ton/KM</span></div>
									</div>
								</div>
							</div>
						</div>
					</div>
				}

				@foreach (var rail in _savedRails)
				{
					var railName = _rackPoints.FirstOrDefault(r => r.Id == rail.RailFacilitiesId)?.Name ?? "Rail Head";
					<div class="col-md-4">
						<div class="active-infra-card">
							<div class="d-flex justify-content-between align-items-start">
								<div class="d-flex gap-3">
									<div class="facility-icon-wrapper bg-soft-blue text-blue m-0">
										<i class="bi bi-train-front"></i>
									</div>
									<div>
										<div class="infra-type-label">RAIL HEAD</div>
										<h4 class="infra-name">@railName</h4>
									</div>
								</div>
								<div class="action-icons">
									<i class="bi bi-pencil-square icon-edit" style="cursor:pointer" @onclick="() => EditRailHead(rail)"></i>
									<i class="bi bi-trash icon-delete" style="cursor:pointer" @onclick="() => ConfirmDeleteRail(rail)"></i>
								</div>
							</div>

							<div class="row g-2 mt-2">
								<div class="col-6">
									<div class="stat-box blue">
										<div class="stat-label">Distance</div>
										<div class="stat-value">@rail.Distance.ToString("F1") <span class="stat-unit">KM</span></div>
									</div>
								</div>
								<div class="col-6">
									<div class="stat-box blue">
										<div class="stat-label">Freight Cost</div>
										<div class="stat-value">₹ @rail.Freight.ToString("N0") <span class="stat-unit">/ton/KM</span></div>
									</div>
								</div>
							</div>
						</div>
					</div>
				}

				@foreach (var port in _savedPorts)
				{
					var portName = _ports.FirstOrDefault(p => p.Id == port.PortId)?.Name ?? "Port";
					<div class="col-md-4">
						<div class="active-infra-card">
							<div class="d-flex justify-content-between align-items-start">
								<div class="d-flex gap-3">
									<div class="facility-icon-wrapper bg-soft-pink text-pink m-0">
										<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/PortIcon.svg"
											 class="formicon" />
									</div>
									<div>
										<div class="infra-type-label">PORT</div>
										<h4 class="infra-name">@portName</h4>
									</div>
								</div>
								<div class="action-icons">
									<i class="bi bi-pencil-square icon-edit" style="cursor:pointer" @onclick="() => EditPort(port)"></i>
									<i class="bi bi-trash icon-delete" style="cursor:pointer" @onclick="() => ConfirmDeletePort(port)"></i>
								</div>
							</div>

							<div class="row g-2 mt-2">
								<div class="col-6">
									<div class="stat-box pink">
										<div class="stat-label">Distance</div>
										<div class="stat-value">@port.Distance.ToString("F1") <span class="stat-unit">KM</span></div>
									</div>
								</div>
								<div class="col-6">
									<div class="stat-box pink">
										<div class="stat-label">Freight Cost</div>
										<div class="stat-value">₹ @port.Freight.ToString("N0") <span class="stat-unit">/ton/KM</span></div>
									</div>
								</div>
							</div>
						</div>
					</div>
				}

				@if (totalCount == 0)
				{
					<div class="col-12 text-center text-muted py-4">
						<i class="bi bi-inbox fs-1"></i>
						<p class="mt-2">No facilities added yet. Use the cards above to add facilities.</p>
					</div>
				}

			</div>
		</div>
	</fieldset>
	
	<CommanFooter OnNextClick="HandleNext" IsNextDisabled="@_isSaving" />
</div>

@if (_showDeleteConfirm)
{
	<div class="modal-backdrop fade show"></div>
	<div class="modal fade show d-block" tabindex="-1" role="dialog">
		<div class="modal-dialog modal-dialog-centered" role="document">
			<div class="modal-content" style="border-radius: 16px; border: none; box-shadow: 0 20px 60px rgba(0,0,0,0.15);">
				<div class="modal-body text-center p-4">
					<div class="mb-3">
						<i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 3rem;"></i>
					</div>
					<h5 class="fw-bold mb-2">Delete Facility?</h5>
					<p class="text-muted mb-1">
						You are about to delete <strong>@_deleteItemName</strong>
					</p>
					<p class="text-muted small mb-3">
						Type: <strong>@_deleteItemType</strong>
					</p>
					<p class="text-danger small mb-4">This action cannot be undone.</p>
					<div class="d-flex justify-content-center gap-3">
						<button class="btn btn-outline-secondary rounded-pill px-4" @onclick="CancelDelete" disabled="@_isDeleting">
							Cancel
						</button>
						<button class="btn btn-danger rounded-pill px-4" @onclick="ExecuteDelete" disabled="@_isDeleting">
							@if (_isDeleting)
							{
								<span class="spinner-border spinner-border-sm me-1"></span> <span>Deleting...</span>
							}
							else
							{
								<i class="bi bi-trash me-1"></i> <span>Delete</span>
							}
						</button>
					</div>
				</div>
			</div>
		</div>
	</div>
}

@code {
	[SupplyParameterFromQuery(Name = "dealerId")]
	public int? DealerId { get; set; }
	[SupplyParameterFromQuery(Name = "mode")]
	public string? Mode { get; set; }

	private bool IsViewOnly => string.Equals(Mode, "view", StringComparison.OrdinalIgnoreCase);

	// Lookup lists
	private List<WarehouseEntity> _warehouses = new();
	private List<RackPoint> _rackPoints = new();
	private List<Port> _ports = new();

	// Dealer location
	private double? _dealerLat;
	private double? _dealerLng;

	// Saved dealer facility entries
	private List<DealerWarehouseFacilities> _savedWarehouses = new();
	private List<DealerRailFacilities> _savedRails = new();
	private List<DealerPortFacilities> _savedPorts = new();

	// Warehouse form fields
	private int _selectedWarehouseId;
	private double _whDistance;
	private double _whFreight;
	private double _warehousecode;
	private int _editingWhId;
	private bool _isCalculatingWhDistance;

	// Rail form fields
	private int _selectedRailId;
	private double _railDistance;
	private double _railFreight;
	private int _editingRailId;
	private bool _isCalculatingRailDistance;

	// Port form fields
	private int _selectedPortId;
	private double _portDistance;
	private double _portFreight;
	private int _editingPortId;
	private bool _isCalculatingPortDistance;

	// UI state
	private bool _isSaving;
	private string? _message;
	private bool _isError;

	// Delete confirmation state
	private bool _showDeleteConfirm;
	private bool _isDeleting;
	private string _deleteItemName = "";
	private string _deleteItemType = "";
	private DealerWarehouseFacilities? _whToDelete;
	private DealerRailFacilities? _railToDelete;
	private DealerPortFacilities? _portToDelete;

	// Computed distance display strings
	private string WhDistanceDisplay => _isCalculatingWhDistance ? "..." : (_whDistance > 0 ? _whDistance.ToString("F1") : "");
	private string RailDistanceDisplay => _isCalculatingRailDistance ? "..." : (_railDistance > 0 ? _railDistance.ToString("F1") : "");
	private string PortDistanceDisplay => _isCalculatingPortDistance ? "..." : (_portDistance > 0 ? _portDistance.ToString("F1") : "");

	private string _warehouseSearchText = "";
	private bool _showWarehouseDropdown = false;

	private string _railSearchText = "";
	private bool _showRailDropdown = false;

	private string _portSearchText = "";
	private bool _showPortDropdown = false;

	protected override async Task OnInitializedAsync()
	{
		Loading.Show();
		try
		{
			await LoadLookups();
			await LoadDealerLocation();
			await LoadSavedFacilities();
		}
		finally
		{
			Loading.Hide();
		}
	}

	private async Task LoadLookups()
	{
		try
		{
			_warehouses = await Http.GetFromJsonAsync<List<WarehouseEntity>>("api/Warehouse") ?? new();
			_rackPoints = await Http.GetFromJsonAsync<List<RackPoint>>("api/RackPoint") ?? new();
			_ports = await Http.GetFromJsonAsync<List<Port>>("api/Port") ?? new();
		}
		catch (Exception ex)
		{
			ShowMessage($"Failed to load facilities: {ex.Message}", true);
		}
	}

	private async Task LoadDealerLocation()
	{
		if (!DealerId.HasValue || DealerId.Value <= 0) return;
		try
		{
			var dealer = await Http.GetFromJsonAsync<DealerReg>($"api/DealerRegistration/{DealerId.Value}");
			if (dealer != null)
			{
				_dealerLat = dealer.Latitude;
				_dealerLng = dealer.Longitude;

				if (!_dealerLat.HasValue || !_dealerLng.HasValue)
				{
					ShowMessage("Dealer location (Latitude/Longitude) is not set. Distance cannot be calculated automatically. Please update dealer registration with Google Map URL first.", true);
				}
			}
		}
		catch (Exception ex)
		{
			ShowMessage($"Failed to load dealer location: {ex.Message}", true);
		}
	}

	private async Task LoadSavedFacilities()
	{
		if (!DealerId.HasValue || DealerId.Value <= 0) return;
		try
		{
			var allWh = await Http.GetFromJsonAsync<List<DealerWarehouseFacilities>>("api/DealerWarehouseFacilities/all") ?? new();
			_savedWarehouses = allWh.Where(w => w.DealerId == DealerId.Value).ToList();

			var allRail = await Http.GetFromJsonAsync<List<DealerRailFacilities>>("api/DealerRailFacilities/all") ?? new();
			_savedRails = allRail.Where(r => r.DealerId == DealerId.Value).ToList();

			var allPort = await Http.GetFromJsonAsync<List<DealerPortFacilities>>("api/DealerPortFacilities/all") ?? new();
			_savedPorts = allPort.Where(p => p.DealerId == DealerId.Value).ToList();
		}
		catch (Exception ex)
		{
			ShowMessage($"Failed to load saved facilities: {ex.Message}", true);
		}
		var hasErrorAfterLoad = _savedWarehouses.Count < 1 || _savedRails.Count < 1 || _savedPorts.Count < 1;
		FormStepData.MarkStepError(4, hasErrorAfterLoad);
	}

	// ── Google Maps URL → lat/lng extraction ──
	private (double lat, double lng)? ParseGoogleUrl(string? url)
	{
		if (string.IsNullOrWhiteSpace(url)) return null;

		var match = Regex.Match(url, @"@(-?\d+\.\d+),(-?\d+\.\d+)");
		if (!match.Success)
			match = Regex.Match(url, @"[?&]q=(-?\d+\.\d+),(-?\d+\.\d+)");
		if (!match.Success)
			match = Regex.Match(url, @"[?&]ll=(-?\d+\.\d+),(-?\d+\.\d+)");
		if (!match.Success)
			match = Regex.Match(url, @"/dir//(-?\d+\.\d+),(-?\d+\.\d+)");
		if (!match.Success)
			match = Regex.Match(url, @"(-?\d+\.\d+),\s*(-?\d+\.\d+)");

		if (match.Success
			&& double.TryParse(match.Groups[1].Value, NumberStyles.Float, CultureInfo.InvariantCulture, out var lat)
			&& double.TryParse(match.Groups[2].Value, NumberStyles.Float, CultureInfo.InvariantCulture, out var lng))
		{
			return (lat, lng);
		}
		return null;
	}

	// ── Haversine fallback (used when OSRM is unreachable) ──
	private double CalculateDistanceKm(double lat1, double lng1, double lat2, double lng2)
	{
		const double R = 6371.0;
		var dLat = (lat2 - lat1) * Math.PI / 180.0;
		var dLng = (lng2 - lng1) * Math.PI / 180.0;
		var a = Math.Sin(dLat / 2) * Math.Sin(dLat / 2)
				+ Math.Cos(lat1 * Math.PI / 180.0) * Math.Cos(lat2 * Math.PI / 180.0)
				* Math.Sin(dLng / 2) * Math.Sin(dLng / 2);
		return R * 2 * Math.Atan2(Math.Sqrt(a), Math.Sqrt(1 - a));
	}

	// ── OSRM road distance with Haversine fallback ──
	private async Task<double> ComputeDistanceAsync(string? googleUrl)
	{
		if (!_dealerLat.HasValue || !_dealerLng.HasValue) return 0;
		var coords = ParseGoogleUrl(googleUrl);
		if (coords == null) return 0;

		var destLat = coords.Value.lat;
		var destLng = coords.Value.lng;
		var originLat = _dealerLat.Value;
		var originLng = _dealerLng.Value;

		// Try OSRM (driving route via roads) first
		try
		{
			var url = $"https://router.project-osrm.org/route/v1/driving/" +
					  $"{originLng.ToString(CultureInfo.InvariantCulture)},{originLat.ToString(CultureInfo.InvariantCulture)};" +
					  $"{destLng.ToString(CultureInfo.InvariantCulture)},{destLat.ToString(CultureInfo.InvariantCulture)}" +
					  $"?overview=false";

			var osrm = await Http.GetFromJsonAsync<OsrmResponse>(url);
			if (osrm != null
				&& string.Equals(osrm.Code, "Ok", StringComparison.OrdinalIgnoreCase)
				&& osrm.Routes != null
				&& osrm.Routes.Count > 0)
			{
				return Math.Round(osrm.Routes[0].Distance / 1000.0, 1);
			}
		}
		catch
		{
			// Network / parsing / CORS issue — fall back to Haversine below
		}

		// Fallback: straight-line distance
		return Math.Round(CalculateDistanceKm(originLat, originLng, destLat, destLng), 1);
	}

