	private async Task ExecuteDelete()
	{
		_isDeleting = true;
		try
		{
			if (_whToDelete != null)
				await DeleteWarehouse(_whToDelete);
			else if (_railToDelete != null)
				await DeleteRailHead(_railToDelete);
			else if (_portToDelete != null)
				await DeletePort(_portToDelete);
		}
		finally
		{
			_isDeleting = false;
			ResetDeleteState();
		}
	}

	private void ResetDeleteState()
	{
		_showDeleteConfirm = false;
		_whToDelete = null;
		_railToDelete = null;
		_portToDelete = null;
		_deleteItemName = "";
		_deleteItemType = "";
	}

	// ── Handle Next ──
	private async Task HandleNext()
	{
		if (IsViewOnly)
		{
			Loading.Show();
			Nav.NavigateTo($"/MarketDetails?dealerId={DealerId}&mode=view");
			return;
		}
		if (!DealerId.HasValue || DealerId.Value <= 0)
		{
			ShowMessage("Dealer ID is required.", true);
			return;
		}

		_isSaving = true;
		try
		{
			var hasError = _savedWarehouses.Count < 2 || _savedRails.Count < 1 || _savedPorts.Count < 1;
			FormStepData.MarkStepError(4, hasError);
			Loading.Show();
			Nav.NavigateTo($"/MarketDetails?dealerId={DealerId}");
		}
		catch (Exception ex)
		{
			Loading.Hide();
			ShowMessage($"Failed: {ex.Message}", true);
		}
		finally
		{
			_isSaving = false;
		}
	}

	private void ShowMessage(string message, bool isError)
	{
		_message = message;
		_isError = isError;
	}

