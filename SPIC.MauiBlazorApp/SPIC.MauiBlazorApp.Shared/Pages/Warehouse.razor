@page "/Warehouse" 

<div class="container-fluid py-4 px-0">
	<FormLoader />
	<div class="company-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
		<h3 class="fw-bold m-0 company-title">Warehouse & Logistics</h3>
	</div>

	<div class="form-card">
		<!-- Header -->
		<div class="d-flex justify-content-between align-items-center py-3 flex-wrap gap-2">
			<div class="card-header-title mb-0">
				<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/WarehouseHeader.svg"
					 class="formicon" />
				Nearest Facilities
			</div>

			<button class="btn-verified">
				<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/Verifiedicon.svg"
					 class="verifyicon" />
				Active Entry
			</button>
		</div>

		<div class="row g-4">
                
			<div class="col-md-4">
				<div class="facility-card">
					<div class="d-flex align-items-center mb-4">
						<div class="facility-icon-wrapper bg-soft-green text-green">
							<i class="bi bi-shop"></i>
						</div>
						<h3 class="facility-card-title">Warehouse</h3>
					</div>

					<div class="mb-3">
						<label class="custom-label">Facility Name</label>
						<select class="custom-select">
							<option>select Facility Name</option>
						</select>
					</div>

					<div class="row g-2 mb-4">
						<div class="col-6">
							<label class="custom-label">Distance (KM)</label>
							<div class="input-icon-wrapper">
								<input type="text" class="custom-input" placeholder="0.0">
								<i class="bi bi-map"></i>
							</div>
						</div>
						<div class="col-6">
							<label class="custom-label">Freight (₹)</label>
							<select class="custom-select">
								<option>Range</option>
							</select>
						</div>
					</div>

					<div class="mt-auto">
						<button class="btn-add-action"><i class="bi bi-plus-lg"></i> Add Warehouse</button>
					</div>
				</div>
			</div>

			<div class="col-md-4">
				<div class="facility-card">
					<div class="d-flex align-items-center mb-4">
						<div class="facility-icon-wrapper bg-soft-blue text-blue">
							<i class="bi bi-train-front"></i>
						</div>
						<h3 class="facility-card-title">Rail Head</h3>
					</div>

					<div class="mb-3">
						<label class="custom-label">Facility Name</label>
						<select class="custom-select">
							<option>Select Facility Name</option>
						</select>
					</div>

					<div class="row g-2 mb-4">
						<div class="col-6">
							<label class="custom-label">Distance (KM)</label>
							<div class="input-icon-wrapper">
								<input type="text" class="custom-input" placeholder="0.0">
								<i class="bi bi-map"></i>
							</div>
						</div>
						<div class="col-6">
							<label class="custom-label">Freight (₹)</label>
							<select class="custom-select">
								<option>Range</option>
							</select>
						</div>
					</div>

					<div class="mt-auto">
						<button class="btn-add-action"><i class="bi bi-plus-lg"></i> Add Rail Head</button>
					</div>
				</div>
			</div>

			<div class="col-md-4">
				<div class="facility-card">
					<div class="d-flex align-items-center mb-4">
						<div class="facility-icon-wrapper bg-soft-pink text-pink">
							<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/PortIcon.svg" class="formicon" />
                              
						</div>
						<h3 class="facility-card-title">Port</h3>
					</div>

					<div class="mb-3">
						<label class="custom-label">Facility Name</label>
						<select class="custom-select">
							<option>Select Facility Name</option>
						</select>
					</div>

					<div class="row g-2 mb-4">
						<div class="col-6">
							<label class="custom-label">Distance (KM)</label>
							<div class="input-icon-wrapper">
								<input type="text" class="custom-input" placeholder="0.0">
								<i class="bi bi-map"></i>
							</div>
						</div>
						<div class="col-6">
							<label class="custom-label">Freight (₹)</label>
							<select class="custom-select">
								<option>Range</option>
							</select>
						</div>
					</div>

					<div class="mt-auto">
						<button class="btn-add-action"> <i class="bi bi-plus-lg"></i> Add Port</button>
					</div>
				</div>
			</div>

		</div>
	</div>

	<div class="form-card">
		<div class="d-flex justify-content-between align-items-center mb-4">
			<div class="card-header-title mb-0">
				<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/Active .svg"
					 class="formicon" /> Selected Nearest Facilities
			</div>
			<div class="fw-bold fs-5 text-dark">3</div>
		</div>
       
		<div class="row g-4">
			<div class="col-md-4">
				<div class="active-infra-card">
					<div class="d-flex justify-content-between align-items-start">
						<div class="d-flex gap-3">
							<div class="facility-icon-wrapper bg-soft-green text-green m-0">
								<i class="bi bi-shop"></i>
							</div>
							<div>
								<div class="infra-type-label">WAREHOUSE</div>
								<h4 class="infra-name">Main Punjab Storage Hub</h4>
							</div>
						</div>
						<div class="action-icons">
							<i class="bi bi-pencil-square icon-edit"></i>
							<i class="bi bi-trash icon-delete"></i>
						</div>
					</div>

					<div class="row g-2 mt-2">
						<div class="col-6">
							<div class="stat-box green">
								<div class="stat-label">Distance</div>
								<div class="stat-value">14.5 <span class="stat-unit">KM</span></div>
							</div>
						</div>
						<div class="col-6">
							<div class="stat-box green">
								<div class="stat-label">Freight Cost</div>
								<div class="stat-value">₹ 12,450 <span class="stat-unit">/ton</span></div>
							</div>
						</div>
					</div>
				</div>
			</div>

			<div class="col-md-4">
				<div class="active-infra-card">
					<div class="d-flex justify-content-between align-items-start">
						<div class="d-flex gap-3">
							<div class="facility-icon-wrapper bg-soft-blue text-blue m-0">
								<i class="bi bi-train-front"></i>
							</div>
							<div>
								<div class="infra-type-label">RAIL HEAD</div>
								<h4 class="infra-name">Ludhiana Junction Terminal</h4>
							</div>
						</div>
						<div class="action-icons">
							<i class="bi bi-pencil-square icon-edit"></i>
							<i class="bi bi-trash icon-delete"></i>
						</div>
					</div>

					<div class="row g-2 mt-2">
						<div class="col-6">
							<div class="stat-box blue">
								<div class="stat-label">Distance</div>
								<div class="stat-value">14.5 <span class="stat-unit">KM</span></div>
							</div>
						</div>
						<div class="col-6">
							<div class="stat-box blue">
								<div class="stat-label">Freight Cost</div>
								<div class="stat-value">₹ 12,450 <span class="stat-unit">/ton</span></div>
							</div>
						</div>
					</div>
				</div>
			</div>

			<div class="col-md-4">
				<div class="active-infra-card">
					<div class="d-flex justify-content-between align-items-start">
						<div class="d-flex gap-3">
							<div class="facility-icon-wrapper bg-soft-pink text-pink m-0">
								<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/PortIcon.svg"
									 class="formicon" />
							</div>
							<div>
								<div class="infra-type-label">PORT</div>
								<h4 class="infra-name">Kandla Port Terminal</h4>
							</div>
						</div>
						<div class="action-icons">
							<i class="bi bi-pencil-square icon-edit"></i>
							<i class="bi bi-trash icon-delete"></i>
						</div>
					</div>

					<div class="row g-2 mt-2">
						<div class="col-6">
							<div class="stat-box pink">
								<div class="stat-label">Distance</div>
								<div class="stat-value">14.5 <span class="stat-unit">KM</span></div>
							</div>
						</div>
						<div class="col-6">
							<div class="stat-box pink">
								<div class="stat-label">Freight Cost</div>
								<div class="stat-value">₹ 12,450 <span class="stat-unit">/ton</span></div>
							</div>
						</div>
					</div>
				</div>
			</div>

		</div>
	</div>

	<div class="logistics-note mb-4">
		<div class="note-header">
			<i class="bi bi-exclamation-circle"></i> Logistics Note Information
		</div>
		<p class="note-text">
			A minimum of two Warehouses, one Rail Head, and one Port must be configured to proceed further
		</p>
	</div>
	<CommanFooter />
</div>

    