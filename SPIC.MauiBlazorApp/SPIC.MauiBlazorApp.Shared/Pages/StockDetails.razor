    // ---- Select2 (Financial Year + State + Region + HQ + Product) ----
    private async Task InitSelect2()
    {
        if (_objRef is null) return;

        var configs = new[]
        {
            new { id = "sd-fy-select",      method = nameof(OnFinancialYearChanged) },
            new { id = "sd-state-select",   method = nameof(OnStateChanged) },
            new { id = "sd-region-select",  method = nameof(OnRegionChanged) },
            new { id = "sd-hq-select",      method = nameof(OnHqChanged) },
            new { id = "sd-product-select", method = nameof(OnProductChanged) }
        };
        await JS.InvokeVoidAsync("spicSelect2.initMultiple", configs, _objRef);
    }

    [JSInvokable]
    public async Task OnFinancialYearChanged(List<string>? v)
    {
        _selFinancialYears = (v ?? new List<string>())
            .Select(value => int.TryParse(value, out var id) ? id : 0)
            .Where(id => id > 0)
            .Distinct()
            .ToList();
        if (_selFinancialYears.Count == 0)
        {
            _dateFrom = _dateTo = null;
        }
        else
        {
            var fyItems = _financialYears.Where(x => _selFinancialYears.Contains(x.Id)).ToList();
            if (fyItems.Count > 0)
            {
                _dateFrom = fyItems.Min(x => x.StartDate);
                _dateTo = fyItems.Max(x => x.EndDate);
            }
            else
            {
                _dateFrom = _dateTo = null;
            }
        }
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnStateChanged(List<string>? v)
    {
        _selStates = ParseIds(v);
        ApplyMandatoryRoleScopeSelections();
        await Cascade("State");
    }

    [JSInvokable]
    public async Task OnRegionChanged(List<string>? v)
    {
        _selRegions = ParseIds(v);
        ApplyMandatoryRoleScopeSelections();
        await Cascade("Region");
    }

    [JSInvokable]
    public async Task OnHqChanged(List<string>? v)
    {
        _selHqs = ParseIds(v);
        ApplyMandatoryRoleScopeSelections();
        await Cascade("HQ");
    }

    [JSInvokable]
    public void OnProductChanged(List<string>? values)
    {
        _selProductKeys = (values ?? new List<string>())
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Select(value => value.Trim())
            .Where(value =>
                value.StartsWith("P:", StringComparison.OrdinalIgnoreCase) ||
                value.StartsWith("I:", StringComparison.OrdinalIgnoreCase))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        StateHasChanged();
    }

    private static List<int> ParseIds(List<string>? values)
    {
        return (values ?? new List<string>())
            .Select(value => int.TryParse(value, out var id) ? id : 0)
            .Where(id => id > 0)
            .Distinct()
            .ToList();
    }

    private async Task Cascade(string filterType)
    {
        if (filterType == "State" && _selStates.Any())
        {
            _selRegions.RemoveAll(id =>
            {
                var region = _allRegions.FirstOrDefault(item => item.Id == id);
                return region is null || !_selStates.Contains(region.StateId ?? 0);
            });

            _selHqs.RemoveAll(id =>
            {
                var hq = _allHqs.FirstOrDefault(item => item.Id == id);
                return hq is null || !_selStates.Contains(hq.StateId ?? 0);
            });
        }
        else if (filterType == "Region" && _selRegions.Any())
        {
            _selStates = _selStates
                .Union(_allRegions
                    .Where(r => _selRegions.Contains(r.Id) && r.StateId.HasValue)
                    .Select(r => r.StateId!.Value))
                .Distinct()
                .ToList();

            _selHqs.RemoveAll(id =>
            {
                var hq = _allHqs.FirstOrDefault(item => item.Id == id);
                return hq is null || !_selRegions.Contains(hq.RegionId ?? 0);
            });
        }
        else if (filterType == "HQ" && _selHqs.Any())
        {
            _selRegions = _selRegions
                .Union(_allHqs
                    .Where(h => _selHqs.Contains(h.Id) && h.RegionId.HasValue)
                    .Select(h => h.RegionId!.Value))
                .Distinct()
                .ToList();

            _selStates = _selStates
                .Union(_allHqs
                    .Where(h => _selHqs.Contains(h.Id) && h.StateId.HasValue)
                    .Select(h => h.StateId!.Value))
                .Distinct()
                .ToList();
        }

        ApplyMandatoryRoleScopeSelections();
        RebuildVisibleLocationOptions();
        await InvokeAsync(StateHasChanged);

        if (_select2Initialized)
            await RefreshSelect2();
    }

    private async Task RefreshSelect2()
    {
        await JS.InvokeVoidAsync("spicSelect2.destroyMultiple", new[]
        {
            "sd-fy-select",
            "sd-state-select",
            "sd-region-select",
            "sd-hq-select",
            "sd-product-select"
        });
        await Task.Delay(50);
        await InitSelect2();
    }

    private async Task<List<LocationDto>> FetchData(string url)
    {
        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(20));
            var raw = await Http.GetFromJsonAsync<List<JsonElement>>(url, cts.Token);
            var list = new List<LocationDto>();
            if (raw == null) return list;
            foreach (var item in raw)
            {
                var id = item.GetProperty("id").GetInt32();
                string name = "";
                if (item.TryGetProperty("name", out var n)) name = n.GetString() ?? "";
                else if (item.TryGetProperty("stateName", out n)) name = n.GetString() ?? "";
                else if (item.TryGetProperty("regionName", out n)) name = n.GetString() ?? "";
                else if (item.TryGetProperty("headquarterName", out n)) name = n.GetString() ?? "";

                var dto = new LocationDto { Id = id, Name = name };

                if (item.TryGetProperty("stateId", out var stateProperty) &&
                    stateProperty.ValueKind == JsonValueKind.Number)
                    dto.StateId = stateProperty.GetInt32();

                if (item.TryGetProperty("regionId", out var regionProperty) &&
                    regionProperty.ValueKind == JsonValueKind.Number)
                    dto.RegionId = regionProperty.GetInt32();

                list.Add(dto);
            }
            return list;
        }
        catch { return new List<LocationDto>(); }
    }

    private async Task<List<StockDetailsProductDto>> FetchProducts()
    {
        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(20));
            return await Http.GetFromJsonAsync<List<StockDetailsProductDto>>(
                "api/StockDetails/products",
                cts.Token) ?? new List<StockDetailsProductDto>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[StockDetails] product lookup: {ex.Message}");
            return new List<StockDetailsProductDto>();
        }
    }

    private async Task<List<FinancialYearDto>> FetchFinancialYears(string url)
    {
        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(20));
            var raw = await Http.GetFromJsonAsync<List<JsonElement>>(url, cts.Token);
            var list = new List<FinancialYearDto>();
            if (raw == null) return list;
            foreach (var item in raw)
            {
                var dto = new FinancialYearDto { Id = item.GetProperty("id").GetInt32() };

                if (item.TryGetProperty("name", out var n)) dto.Name = n.GetString() ?? "";
                else if (item.TryGetProperty("financialYearName", out n)) dto.Name = n.GetString() ?? "";
                else if (item.TryGetProperty("financialYear", out n)) dto.Name = n.GetString() ?? "";
                else if (item.TryGetProperty("label", out n)) dto.Name = n.GetString() ?? "";
                else if (item.TryGetProperty("year", out n)) dto.Name = n.ToString();

                if (item.TryGetProperty("startDate", out var sd) && DateTime.TryParse(sd.GetString(), out var s)) dto.StartDate = s;
                else if (item.TryGetProperty("fromDate", out sd) && DateTime.TryParse(sd.GetString(), out s)) dto.StartDate = s;

                if (item.TryGetProperty("endDate", out var ed) && DateTime.TryParse(ed.GetString(), out var e)) dto.EndDate = e;
                else if (item.TryGetProperty("toDate", out ed) && DateTime.TryParse(ed.GetString(), out e)) dto.EndDate = e;

                list.Add(dto);
            }
            return list;
        }
        catch { return new List<FinancialYearDto>(); }
    }

    public void Dispose()
    {
        _disposed = true;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _searchDebounce?.Stop();
        _searchDebounce?.Dispose();
        _objRef?.Dispose();
    }
