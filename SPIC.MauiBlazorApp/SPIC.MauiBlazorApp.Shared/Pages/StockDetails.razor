@page "/StockDetails"

<div class="container-fluid py-4 px-0">
    <div class="sd-wrapper">

        <!-- Page Header -->
        <div class="sd-page-header">
            <div class="sd-title-block">
                <div class="sd-title-row">
                    <h1>Stock Details</h1>
                    <div class="sd-badges">
                        <span class="sd-badge"><i class="bi bi-calendar3"></i> Date as on: 07 Apr 2025</span>
                        <span class="sd-badge"><i class="bi bi-calendar-event"></i> Month: April 2025</span>
                    </div>
                </div>
                <p>Consolidated stock and sales updated daily</p>
            </div>
            <div class="sd-actions">
                <button class="sd-btn sd-btn-outline"><i class="bi bi-arrow-clockwise"></i> Refresh Data</button>
                <button class="sd-btn sd-btn-outline"><i class="bi bi-file-earmark-spreadsheet" style="color:#16A34A"></i> Excel</button>
                <button class="sd-btn sd-btn-outline"><i class="bi bi-file-earmark-pdf" style="color:#DC2626"></i> PDF</button>
                <button class="sd-btn sd-btn-primary"><i class="bi bi-envelope"></i> Send Mail</button>
            </div>
        </div>

        <!-- KPI Cards -->
        <div class="sd-kpi-grid">

            <div class="sd-kpi-card sd-kpi-purple">
                <div class="sd-kpi-info">
                    <div class="sd-kpi-label">Total Stock</div>
                    <div class="sd-kpi-value">43,092</div>
                </div>
                <div class="sd-kpi-icon">
                    <i class="bi bi-bag-fill"></i>
                </div>
            </div>

            <div class="sd-kpi-card sd-kpi-green">
                <div class="sd-kpi-info">
                    <div class="sd-kpi-label">Total Sales</div>
                    <div class="sd-kpi-value">6,087</div>
                </div>
                <div class="sd-kpi-icon">
                    <i class="bi bi-cart-check-fill"></i>
                </div>
            </div>

            <div class="sd-kpi-card sd-kpi-yellow">
                <div class="sd-kpi-info">
                    <div class="sd-kpi-label">Closing Stock</div>
                    <div class="sd-kpi-value">37,005</div>
                </div>
                <div class="sd-kpi-icon">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>
            </div>

            <div class="sd-kpi-card sd-kpi-teal">
                <div class="sd-kpi-info">
                    <div class="sd-kpi-label">Sales %</div>
                    <div class="sd-kpi-value">14%</div>
                </div>
                <div class="sd-kpi-icon">
                    <i class="bi bi-bag-check-fill"></i>
                </div>
            </div>

        </div>

        <!-- Filter Card -->
        <div class="sd-card">
            <div class="sd-filters-header">
                <span><i class="bi bi-filter-left"></i> Filters</span>
                <i class="bi bi-chevron-down sd-toggle-icon"></i>
            </div>
            <div class="sd-filters-grid">
                <div class="sd-form-group">
                    <label>State</label>
                    <select class="sd-control sd-select">
                        <option value="" disabled selected hidden>All State</option>
                    </select>
                </div>
            </div>
            <div class="sd-filter-actions">
                <button class="sd-btn sd-btn-ghost"><i class="bi bi-x-lg"></i> Clear All</button>
                <button class="sd-btn sd-btn-primary"><i class="bi bi-funnel"></i> Apply Filters</button>
            </div>
        </div>

        <!-- Table Card -->
        <div class="sd-card">
            <div class="sd-table-head">
                <h2 class="sd-table-title">Stock List</h2>
                <div class="sd-search">
                    <i class="bi bi-search"></i>
                    <input type="text" placeholder="Search zones..." />
                </div>
            </div>

            <div class="sd-table-wrap">
                <table class="sd-table">
                    <thead>
                        <tr>
                            <th class="sd-th-check"><input type="checkbox" /></th>
                            <th>State</th>
                            <th>Opening Stock <span class="sd-th-sub">(as on 1 Apr)</span></th>
                            <th>Supplies <span class="sd-th-sub">(April)</span></th>
                            <th>Total Stock</th>
                            <th>Sales <span class="sd-th-sub">(1-6 Apr)</span></th>
                            <th>Sales <span class="sd-th-sub">(7 Apr)</span></th>
                            <th>Total Sales</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < 5; i++)
                        {
                            <tr>
                                <td><input type="checkbox" /></td>
                                <td class="sd-cell-left">Tamil Nadu</td>
                                <td>16,338</td>
                                <td>571</td>
                                <td>22,055</td>
                                <td>571</td>
                                <td>639</td>
                                <td>1,210</td>
                            </tr>
                        }
                        <tr class="sd-grand-total">
                            <td></td>
                            <td class="sd-cell-left">Grand Total</td>
                            <td>35,113</td>
                            <td>7,978</td>
                            <td>43,092</td>
                            <td>43,092</td>
                            <td>43,092</td>
                            <td>43,092</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <div class="sd-pagination">
                <div class="sd-page-size">
                    <span>Items Per Page</span>
                    <select class="sd-control sd-select sd-page-select">
                        <option>16</option>
                        <option>25</option>
                    </select>
                </div>
                <div class="sd-page-controls">
                    <button class="sd-page-btn"><i class="bi bi-chevron-left"></i></button>
                    <button class="sd-page-btn sd-page-active">1</button>
                    <button class="sd-page-btn">2</button>
                    <button class="sd-page-btn">3</button>
                    <span class="sd-page-ellipsis">..</span>
                    <button class="sd-page-btn">8</button>
                    <button class="sd-page-btn">9</button>
                    <button class="sd-page-btn">10</button>
                    <button class="sd-page-btn"><i class="bi bi-chevron-right"></i></button>
                </div>
            </div>
        </div>

    </div>
</div>

