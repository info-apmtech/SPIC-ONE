@page "/StockDetails"
@implements IDisposable
@inject HttpClient Http
@inject SPIC.MauiBlazorApp.Shared.Services.LoginState LoginState
@inject IJSRuntime JS
@using System.Text.Json
@using System.Net.Http.Json
@using System.Globalization
@using SPIC.Core.DTOs

<div class="sd-wrapper">

    <!-- Page Header -->
    <div class="sd-header-section">
        <div class="sd-header-left">
            <div class="sd-title-area">
                <h1>Stock Details</h1>
                <div class="sd-badges">
                    <span class="sd-badge"><i class="bi bi-calendar3"></i> Date as on: @(_dashboard is null ? "—" : _dashboard.Labels.ClosingAsOn)</span>
                    <span class="sd-badge"><i class="bi bi-calendar-event"></i> Period: @(_dateFrom?.ToString("dd MMM yyyy") ?? "—") – @(_dateTo?.ToString("dd MMM yyyy") ?? "—")</span>
                </div>
            </div>
            <p class="sd-subtitle">Consolidated stock and sales updated daily</p>
        </div>
        <div class="sd-header-actions">
            <button class="btn-custom" disabled="@_isLoading" @onclick="RefreshData"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
            <button class="btn-custom" disabled="@(_dashboard is null || _isLoading)" @onclick="ExportExcel"><i class="bi bi-file-earmark-spreadsheet" style="color:#16A34A"></i> Excel</button>
            <button class="btn-custom" disabled title="PDF export is not implemented yet"><i class="bi bi-file-earmark-pdf" style="color:#DC2626"></i> PDF</button>
            <button class="btn-custom btn-primary-custom" disabled title="Send mail is not implemented yet"><i class="bi bi-envelope"></i> Mail</button>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="sd-card">
        <div class="sd-filters-header">
            <span><i class="bi bi-filter-left"></i> Filters</span>
            <i class="bi bi-chevron-down"></i>
        </div>
        <div class="sd-filters-body">
            <div class="sd-filters-grid">
                <div class="sd-form-group">
                    <label>From Date</label>
                    <input type="date" class="sd-form-control" disabled="@(!_masterDataLoaded)" @bind="_dateFrom" />
                </div>
                <div class="sd-form-group">
                    <label>To Date</label>
                    <input type="date" class="sd-form-control" disabled="@(!_masterDataLoaded)" @bind="_dateTo" />
                </div>
                <div class="sd-form-group">
                    <label>Financial Year</label>
                    <select id="sd-fy-select" class="sd-form-control sd-state-select" multiple="multiple" disabled="@(!_masterDataLoaded)">
                        @foreach (var fy in _financialYears)
                        {
                            <option value="@fy.Id" selected="@(_selFinancialYears.Contains(fy.Id))">@fy.Name</option>
                        }
                    </select>
                </div>
                <div class="sd-form-group">
                    <label>State</label>
                    <select id="sd-state-select" class="sd-form-control sd-state-select" multiple="multiple" disabled="@(!_masterDataLoaded)">
                        @foreach (var s in _states)
                        {
                            <option value="@s.Id" selected="@(_selStates.Contains(s.Id))">@s.Name</option>
                        }
                    </select>
                </div>
                <div class="sd-form-group">
                    <label>Region</label>
                    <select id="sd-region-select" class="sd-form-control sd-state-select" multiple="multiple" disabled="@(!_masterDataLoaded)">
                        @foreach (var r in _regions)
                        {
                            <option value="@r.Id" selected="@(_selRegions.Contains(r.Id))">@r.Name</option>
                        }
                    </select>
                </div>
                <div class="sd-form-group">
                    <label>Head Quarters</label>
                    <select id="sd-hq-select" class="sd-form-control sd-state-select" multiple="multiple" disabled="@(!_masterDataLoaded)">
                        @foreach (var h in _hq)
                        {
                            <option value="@h.Id" selected="@(_selHqs.Contains(h.Id))">@h.Name</option>
                        }
                    </select>
                </div>
                <div class="sd-form-group">
                    <label>Product</label>
                    <select id="sd-product-select" class="sd-form-control sd-state-select" multiple="multiple" disabled="@(!_masterDataLoaded)">
                        @foreach (var p in _products)
                        {
                            <option value="@p.Key" selected="@(_selProductKeys.Any(x => string.Equals(x, p.Key, StringComparison.OrdinalIgnoreCase)))">@p.Name @(p.Source == "IFMS Products" ? "(IFMS)" : "")</option>
                        }
                    </select>
                </div>
            </div>
            <div class="sd-filter-actions">
                <button class="btn-custom" disabled="@(_isLoading || !_masterDataLoaded)" @onclick="ClearAll"><i class="bi bi-x"></i> Clear All</button>
                <button class="btn-custom btn-primary-custom" disabled="@(_isLoading || !_masterDataLoaded)" @onclick="ApplyFilters"><i class="bi bi-funnel"></i> Search</button>
            </div>
        </div>
    </div>

    @if (_dashboard is null)
    {
        @if (_isLoading)
        {
            <div class="sd-loading-layout" aria-busy="true" aria-label="Loading stock details">
                <div class="sd-kpi-grid">
                    @for (var i = 0; i < 4; i++)
                    {
                        <div class="sd-kpi-card sd-skeleton-card">
                            <div class="sd-kpi-info">
                                <div class="sd-skeleton sd-skeleton-label"></div>
                                <div class="sd-skeleton sd-skeleton-value"></div>
                            </div>
                            <div class="sd-skeleton sd-skeleton-icon"></div>
                        </div>
                    }
                </div>

                <div class="sd-card sd-skeleton-table-card">
                    <div class="sd-table-header">
                        <div class="sd-skeleton sd-skeleton-title"></div>
                        <div class="sd-skeleton sd-skeleton-search"></div>
                    </div>
                    <div class="sd-skeleton-table">
                        <div class="sd-skeleton sd-skeleton-table-head"></div>
                        @for (var i = 0; i < 7; i++)
                        {
                            <div class="sd-skeleton-row">
                                <div class="sd-skeleton sd-skeleton-cell sd-skeleton-cell-wide"></div>
                                <div class="sd-skeleton sd-skeleton-cell"></div>
                                <div class="sd-skeleton sd-skeleton-cell"></div>
                                <div class="sd-skeleton sd-skeleton-cell"></div>
                                <div class="sd-skeleton sd-skeleton-cell"></div>
                                <div class="sd-skeleton sd-skeleton-cell"></div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="sd-empty-state">
                <i class="bi bi-exclamation-circle"></i>
                <div>@(_loadError is null ? "No Data Available" : $"Could not load report: {_loadError}")</div>
                <button type="button" class="btn-custom" @onclick="RefreshData">Try Again</button>
            </div>
        }
    }
    else
    {
        <div class="@(_isLoading ? "sd-dashboard-shell is-updating" : "sd-dashboard-shell")">
            @if (_isLoading)
            {
                <div class="sd-update-indicator" role="status">
                    <span class="sd-update-spinner"></span>
                    Updating…
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(_loadError))
            {
                <div class="sd-inline-error">
                    <i class="bi bi-exclamation-triangle"></i>
                    @_loadError
                </div>
            }

            <!-- KPI Cards -->
            <div class="sd-kpi-grid">
                <div class="sd-kpi-card sd-kpi-purple">
                    <div class="sd-kpi-info">
                        <div class="sd-kpi-label">Total Stock</div>
                        <div class="sd-kpi-value">@Fmt(_dashboard.Summary.TotalStock)</div>
                    </div>
                    <div class="sd-kpi-icon-box"><i class="bi bi-box-seam"></i></div>
                </div>

                <div class="sd-kpi-card sd-kpi-green">
                    <div class="sd-kpi-info">
                        <div class="sd-kpi-label">Total Sales</div>
                        <div class="sd-kpi-value">@Fmt(_dashboard.Summary.TotalSales)</div>
                    </div>
                    <div class="sd-kpi-icon-box"><i class="bi bi-box-arrow-down"></i></div>
                </div>

                <div class="sd-kpi-card sd-kpi-yellow">
                    <div class="sd-kpi-info">
                        <div class="sd-kpi-label">Closing Stock</div>
                        <div class="sd-kpi-value">@Fmt(_dashboard.Summary.ClosingStock)</div>
                    </div>
                    <div class="sd-kpi-icon-box"><i class="bi bi-safe"></i></div>
                </div>

                <div class="sd-kpi-card sd-kpi-teal">
                    <div class="sd-kpi-info">
                        <div class="sd-kpi-label">Sales %</div>
                        <div class="sd-kpi-value">@Math.Round(_dashboard.Summary.SalesPct)%</div>
                    </div>
                    <div class="sd-kpi-icon-box"><i class="bi bi-tags"></i></div>
                </div>
            </div>

            <!-- Table Card -->
            <div class="sd-card">
                <div class="sd-table-header">
                    <h2 class="sd-table-title">Stock List</h2>
                    <div class="sd-search-box">
                        <i class="bi bi-search"></i>
                        <input type="text" placeholder="Search state..." disabled="@_isLoading" @bind="_filter.Search" @bind:event="oninput" @onkeyup="OnSearchKeyUp" />
                    </div>
                </div>

                <div class="sd-table-responsive">
                    <table class="sd-table">
                        <thead>
                            <tr>
                                <th class="text-start sd-sortable" @onclick='() => Sort("state")'>State</th>
                                <th>Opening Stock <span>(as on @_dashboard.Labels.OpeningAsOn)</span></th>
                                <th>Supplies <span>(@_dashboard.Labels.SuppliesMonth)</span></th>
                                <th class="sd-sortable" @onclick='() => Sort("totalstock")'>Total Stock</th>
                                <th>Sales <span>(@_dashboard.Labels.SalesBeforeRange)</span></th>
                                <th>Sales <span>(@_dashboard.Labels.SalesOnDay)</span></th>
                                <th class="sd-sortable" @onclick='() => Sort("totalsales")'>Total Sales</th>
                                <th class="sd-sortable" @onclick='() => Sort("closing")'>Closing Stock <span>(as on @_dashboard.Labels.ClosingAsOn)</span></th>
                                <th class="sd-sortable" @onclick='() => Sort("salespct")'>Sales %</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_dashboard.Grid.Items.Count == 0)
                            {
                                <tr><td class="text-start" colspan="9" style="text-align:center; padding:24px; color:#94a3b8;">No Data Available</td></tr>
                            }
                            else
                            {
                                @foreach (var row in _dashboard.Grid.Items)
                                {
                                    <tr>
                                        <td class="text-start">@row.StateName</td>
                                        <td>@Fmt(row.OpeningStock)</td>
                                        <td>@Fmt(row.Supplies)</td>
                                        <td>@Fmt(row.TotalStock)</td>
                                        <td>@Fmt(row.SalesBefore)</td>
                                        <td>@Fmt(row.SalesOnDay)</td>
                                        <td>@Fmt(row.TotalSales)</td>
                                        <td>@Fmt(row.ClosingStock)</td>
                                        <td>@Math.Round(row.SalesPct)%</td>
                                    </tr>
                                }

                                <tr class="sd-grand-total">
                                    <td class="text-start">Grand Total</td>
                                    <td>@Fmt(_dashboard.GrandTotal.OpeningStock)</td>
                                    <td>@Fmt(_dashboard.GrandTotal.Supplies)</td>
                                    <td>@Fmt(_dashboard.GrandTotal.TotalStock)</td>
                                    <td>@Fmt(_dashboard.GrandTotal.SalesBefore)</td>
                                    <td>@Fmt(_dashboard.GrandTotal.SalesOnDay)</td>
                                    <td>@Fmt(_dashboard.GrandTotal.TotalSales)</td>
                                    <td>@Fmt(_dashboard.GrandTotal.ClosingStock)</td>
                                    <td>@Math.Round(_dashboard.GrandTotal.SalesPct)%</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                <div class="sd-pagination-bar">
                    <div class="sd-page-size">
                        <span>Items Per Page</span>
                        <select @onchange="OnPageSizeChanged">
                            <option value="16" selected="@(_filter.PageSize == 16)">16</option>
                            <option value="25" selected="@(_filter.PageSize == 25)">25</option>
                            <option value="50" selected="@(_filter.PageSize == 50)">50</option>
                        </select>
                    </div>
                    <div class="sd-page-controls">
                        <button class="sd-page-btn" disabled="@(_filter.Page <= 1)" @onclick="() => GoToPage(_filter.Page - 1)"><i class="bi bi-chevron-left"></i></button>
                        @foreach (var pg in PageNumbers())
                        {
                            if (pg == -1)
                            {
                                <button class="sd-page-btn ellipsis" disabled>..</button>
                            }
                            else
                            {
                                <button class="sd-page-btn @(pg == _filter.Page ? "active" : "")" @onclick="() => GoToPage(pg)">@pg</button>
                            }
                        }
                        <button class="sd-page-btn" disabled="@(_filter.Page >= TotalPages)" @onclick="() => GoToPage(_filter.Page + 1)"><i class="bi bi-chevron-right"></i></button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private static readonly CultureInfo InIN = new("en-IN");
    private string Fmt(decimal v) => v.ToString("#,##0", InIN);

    private StockDetailsDto? _dashboard;
    private readonly StockDetailsFilter _filter = new();
    private bool _isLoading = true;
    private bool _masterDataLoaded;
    private bool _select2Initialized;
    private bool _disposed;
    private string? _loadError;
    private CancellationTokenSource? _loadCts;
    private System.Timers.Timer? _searchDebounce;

    // Filter inputs
    private DateTime? _dateFrom;
    private DateTime? _dateTo;

    private int TotalPages => _dashboard is null || _dashboard.Grid.PageSize == 0
        ? 1 : (int)Math.Ceiling((double)_dashboard.Grid.TotalCount / _dashboard.Grid.PageSize);

    private List<LocationDto> _allStates = new();
    private List<LocationDto> _allRegions = new();
    private List<LocationDto> _allHqs = new();

    private List<LocationDto> _states = new();
    private List<LocationDto> _regions = new();
    private List<LocationDto> _hq = new();

    private List<int> _selStates = new();
    private List<int> _selRegions = new();
    private List<int> _selHqs = new();

    private List<FinancialYearDto> _financialYears = new();
    private List<int> _selFinancialYears = new();

    private List<StockDetailsProductDto> _products = new();
    private List<string> _selProductKeys = new();

    private DotNetObjectReference<StockDetails>? _objRef;

    public class LocationDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public int? StateId { get; set; }
        public int? RegionId { get; set; }
    }

    public class FinancialYearDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public DateTime? StartDate { get; set; }
        public DateTime? EndDate { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        // Mandatory role scope must exist before the first dashboard request.
        ApplyMandatoryRoleScopeSelections();
        SyncSelectionsToFilter();

        // Keep the existing parallel first-load behavior after the scope is prepared.
        var dashboardTask = LoadDashboard();
        var masterDataTask = LoadMasterData();

        try
        {
            await masterDataTask;
            _masterDataLoaded = true;
        }
        catch (Exception ex)
        {
            _loadError = $"Could not load filter data: {ex.Message}";
            Console.WriteLine($"[StockDetails] master: {ex}");
        }

        await InvokeAsync(StateHasChanged);
        await dashboardTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_masterDataLoaded || _select2Initialized || _disposed) return;

        _select2Initialized = true;
        try
        {
            _objRef ??= DotNetObjectReference.Create(this);
            await InitSelect2();
        }
        catch (Exception ex)
        {
            _select2Initialized = false;
            Console.WriteLine($"[StockDetails] select2: {ex}");
        }
    }

    private async Task LoadMasterData()
    {
        var statesTask = FetchData("api/State/all");
        var regionsTask = FetchData("api/Region/all");
        var hqTask = FetchData("api/Headquarter/all");
        var fyTask = FetchFinancialYears("api/FinancialYear/all");
        var productsTask = FetchProducts();

        await Task.WhenAll(statesTask, regionsTask, hqTask, fyTask, productsTask);

        _allStates = statesTask.Result;
        _allRegions = regionsTask.Result;
        _allHqs = hqTask.Result;
        _financialYears = fyTask.Result;
        _products = productsTask.Result;

        foreach (var hq in _allHqs)
        {
            var region = _allRegions.FirstOrDefault(item => item.Id == hq.RegionId);
            if (region is not null)
                hq.StateId = region.StateId;
        }

        ApplyMandatoryRoleScopeSelections();
        RebuildVisibleLocationOptions();
        SyncSelectionsToFilter();
    }

    private bool HasGlobalLocationAccess =>
        LoginState == null || LoginState.IsAdmin || LoginState.IsDirectorOrAVP;

    private int ResolveRoleRegionId()
    {
        if (LoginState == null) return 0;
        if (LoginState.RegionId > 0) return LoginState.RegionId;

        return LoginState.HQId > 0
            ? _allHqs.FirstOrDefault(h => h.Id == LoginState.HQId)?.RegionId ?? 0
            : 0;
    }

    private int ResolveRoleStateId()
    {
        if (LoginState == null) return 0;
        if (LoginState.StateId > 0) return LoginState.StateId;

        var regionId = ResolveRoleRegionId();
        return regionId > 0
            ? _allRegions.FirstOrDefault(r => r.Id == regionId)?.StateId ?? 0
            : 0;
    }

    private void ApplyMandatoryRoleScopeSelections()
    {
        if (HasGlobalLocationAccess || LoginState == null) return;

        if (LoginState.IsHQRole && LoginState.HQId > 0)
        {
            var regionId = ResolveRoleRegionId();
            var stateId = ResolveRoleStateId();

            _selHqs = new List<int> { LoginState.HQId };
            _selRegions = regionId > 0 ? new List<int> { regionId } : new List<int>();
            _selStates = stateId > 0 ? new List<int> { stateId } : new List<int>();
            return;
        }

        if (LoginState.IsRegionRole && LoginState.RegionId > 0)
        {
            var stateId = ResolveRoleStateId();
            _selRegions = new List<int> { LoginState.RegionId };
            _selStates = stateId > 0 ? new List<int> { stateId } : new List<int>();

            if (_allHqs.Count > 0)
            {
                _selHqs = _selHqs
                    .Where(id => _allHqs.Any(h => h.Id == id && h.RegionId == LoginState.RegionId))
                    .Distinct()
                    .ToList();
            }
            return;
        }

        if (LoginState.IsStateRole && LoginState.StateId > 0)
        {
            _selStates = new List<int> { LoginState.StateId };

            if (_allRegions.Count > 0)
            {
                _selRegions = _selRegions
                    .Where(id => _allRegions.Any(r => r.Id == id && r.StateId == LoginState.StateId))
                    .Distinct()
                    .ToList();
            }

            if (_allHqs.Count > 0)
            {
                _selHqs = _selHqs
                    .Where(id => _allHqs.Any(h => h.Id == id && h.StateId == LoginState.StateId))
                    .Distinct()
                    .ToList();
            }
        }
    }

    private void RebuildVisibleLocationOptions()
    {
        IEnumerable<LocationDto> allowedStates = _allStates;
        IEnumerable<LocationDto> allowedRegions = _allRegions;
        IEnumerable<LocationDto> allowedHqs = _allHqs;

        if (!HasGlobalLocationAccess && LoginState != null)
        {
            if (LoginState.IsHQRole && LoginState.HQId > 0)
            {
                var regionId = ResolveRoleRegionId();
                var stateId = ResolveRoleStateId();

                allowedHqs = _allHqs.Where(h => h.Id == LoginState.HQId);
                allowedRegions = regionId > 0
                    ? _allRegions.Where(r => r.Id == regionId)
                    : Enumerable.Empty<LocationDto>();
                allowedStates = stateId > 0
                    ? _allStates.Where(st => st.Id == stateId)
                    : Enumerable.Empty<LocationDto>();
            }
            else if (LoginState.IsRegionRole && LoginState.RegionId > 0)
            {
                var stateId = ResolveRoleStateId();
                allowedRegions = _allRegions.Where(r => r.Id == LoginState.RegionId);
                allowedHqs = _allHqs.Where(h => h.RegionId == LoginState.RegionId);
                allowedStates = stateId > 0
                    ? _allStates.Where(st => st.Id == stateId)
                    : Enumerable.Empty<LocationDto>();
            }
            else if (LoginState.IsStateRole && LoginState.StateId > 0)
            {
                allowedStates = _allStates.Where(st => st.Id == LoginState.StateId);
                allowedRegions = _allRegions.Where(r => r.StateId == LoginState.StateId);
                allowedHqs = _allHqs.Where(h => h.StateId == LoginState.StateId);
            }
        }

        _states = allowedStates.ToList();
        _regions = _selStates.Any()
            ? allowedRegions.Where(r => _selStates.Contains(r.StateId ?? 0)).ToList()
            : allowedRegions.ToList();

        _hq = _selRegions.Any()
            ? allowedHqs.Where(h => _selRegions.Contains(h.RegionId ?? 0)).ToList()
            : _selStates.Any()
                ? allowedHqs.Where(h => _selStates.Contains(h.StateId ?? 0)).ToList()
                : allowedHqs.ToList();
    }

    private async Task LoadDashboard()
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();

        var cts = new CancellationTokenSource(TimeSpan.FromSeconds(30));
        _loadCts = cts;
        var token = cts.Token;

        _isLoading = true;
        _loadError = null;
        SyncSelectionsToFilter();
        await InvokeAsync(StateHasChanged);

        try
        {
            using var resp = await Http.PostAsJsonAsync("api/StockDetails/dashboard", _filter, token);

            if (resp.IsSuccessStatusCode)
            {
                var result = await resp.Content.ReadFromJsonAsync<StockDetailsDto>(cancellationToken: token);
                if (result is null)
                    _loadError = "The server returned an empty dashboard response.";
                else
                    _dashboard = result;
            }
            else
            {
                // Keep already displayed data visible when a refresh/filter request fails.
                _loadError = $"Server returned {(int)resp.StatusCode} {resp.ReasonPhrase}.";
            }
        }
        catch (OperationCanceledException)
        {
            if (!ReferenceEquals(_loadCts, cts)) return;
            _loadError = "Request timed out — the server took too long to respond.";
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
        finally
        {
            if (ReferenceEquals(_loadCts, cts))
            {
                _isLoading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void SyncSelectionsToFilter()
    {
        ApplyMandatoryRoleScopeSelections();

        _filter.DateFrom = _dateFrom;
        _filter.DateTo = _dateTo;
        _filter.FinancialYearIds = _selFinancialYears.ToList();
        _filter.StateIds = _selStates.ToList();
        _filter.RegionIds = _selRegions.ToList();
        _filter.HeadQuarterIds = _selHqs.ToList();
        _filter.ProductKeys = _selProductKeys
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        // Retain the older approved ProductIds contract for existing clients/service paths.
        _filter.ProductIds = _filter.ProductKeys
            .Where(x => x.StartsWith("P:", StringComparison.OrdinalIgnoreCase))
            .Select(x => int.TryParse(x.Substring(2), out var id) ? id : 0)
            .Where(id => id > 0)
            .Distinct()
            .ToList();
    }

    private async Task ApplyFilters()
    {
        SyncSelectionsToFilter();
        _filter.Page = 1;
        await LoadDashboard();
    }

    private async Task RefreshData()
    {
        SyncSelectionsToFilter();
        await LoadDashboard();
    }

    private async Task ClearAll()
    {
        _selStates.Clear();
        _selRegions.Clear();
        _selHqs.Clear();
        _selFinancialYears.Clear();
        _selProductKeys.Clear();
        _dateFrom = _dateTo = null;

        ApplyMandatoryRoleScopeSelections();
        RebuildVisibleLocationOptions();
        SyncSelectionsToFilter();

        _filter.Search = null;
        _filter.Page = 1;

        await InvokeAsync(StateHasChanged);
        if (_select2Initialized)
            await RefreshSelect2();

        await LoadDashboard();
    }

    private async Task GoToPage(int page)
    {
        if (page < 1 || page > TotalPages || page == _filter.Page) return;
        _filter.Page = page; await LoadDashboard();
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size)) { _filter.PageSize = size; _filter.Page = 1; await LoadDashboard(); }
    }

    private async Task Sort(string column)
    {
        if (_filter.SortColumn == column) _filter.SortDir = _filter.SortDir == "asc" ? "desc" : "asc";
        else { _filter.SortColumn = column; _filter.SortDir = "asc"; }
        await LoadDashboard();
    }

    private void OnSearchKeyUp()
    {
        _searchDebounce?.Stop();
        _searchDebounce?.Dispose();

        _searchDebounce = new System.Timers.Timer(400) { AutoReset = false };
        _searchDebounce.Elapsed += async (_, _) =>
        {
            if (_disposed) return;

            try
            {
                await InvokeAsync(async () =>
                {
                    _filter.Page = 1;
                    await LoadDashboard();
                });
            }
            catch (ObjectDisposedException)
            {
                // Component was closed while the debounce timer was waiting.
            }
        };
        _searchDebounce.Start();
    }

    private IEnumerable<int> PageNumbers()
    {
        int total = TotalPages, current = _filter.Page;
        if (total <= 7) { for (int i = 1; i <= total; i++) yield return i; yield break; }
        yield return 1;
        if (current > 4) yield return -1;
        for (int i = Math.Max(2, current - 1); i <= Math.Min(total - 1, current + 1); i++) yield return i;
        if (current < total - 3) yield return -1;
        yield return total;
    }

