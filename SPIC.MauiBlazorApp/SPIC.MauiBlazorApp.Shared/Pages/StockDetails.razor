@page "/StockDetails"

<div class="sd-wrapper">

    <!-- Page Header -->
    <div class="sd-header-section">
        <div class="sd-header-left">
            <div class="sd-title-area">
                <h1>Stock Details</h1>
                <div class="sd-badges">
                    <span class="sd-badge"><i class="bi bi-calendar3"></i> Date as on: 07 Apr 2025</span>
                    <span class="sd-badge"><i class="bi bi-calendar-event"></i> Month: April 2025</span>
                </div>
            </div>
            <p class="sd-subtitle">Consolidated stock and sales updated daily</p>
        </div>
        <div class="sd-header-actions">
            <button class="btn-custom"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
            <button class="btn-custom"><i class="bi bi-file-earmark-spreadsheet" style="color:#16A34A"></i> Excel</button>
            <button class="btn-custom"><i class="bi bi-file-earmark-pdf" style="color:#DC2626"></i> PDF</button>
            <button class="btn-custom btn-primary-custom"><i class="bi bi-envelope"></i> Mail</button>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="sd-card">
        <div class="sd-filters-header">
            <span><i class="bi bi-filter-left"></i> Filters</span>
            <i class="bi bi-chevron-down"></i>
        </div>
        <div class="sd-filters-body">
            <div class="sd-filters-grid">
                <div class="sd-form-group">
                    <label>Date Range</label>
                    <input type="text" class="sd-form-control" placeholder="01 Apr 2025 - 28 Apr 2025" />
                </div>
                <div class="sd-form-group">
                    <label>Month</label>
                    <select class="sd-form-control">
                        <option value="" disabled selected hidden>Select Month</option>
                    </select>
                </div>
                <div class="sd-form-group">
                    <label>Year</label>
                    <select class="sd-form-control">
                        <option value="" disabled selected hidden>Select Year</option>
                    </select>
                </div>
                <div class="sd-form-group">
                    <label>State</label>
                    <select class="sd-form-control">
                        <option value="" disabled selected hidden>All State</option>
                    </select>
                </div>
            </div>
            <div class="sd-filter-actions">
                <button class="btn-custom"><i class="bi bi-x"></i> Clear All</button>
                <button class="btn-custom btn-primary-custom"><i class="bi bi-funnel"></i> Apply Filters</button>
            </div>
        </div>
    </div>

    <!-- KPI Cards -->
    <div class="sd-kpi-grid">
        <div class="sd-kpi-card sd-kpi-purple">
            <div class="sd-kpi-info">
                <div class="sd-kpi-label">Total Stock</div>
                <div class="sd-kpi-value">43,092</div>
            </div>
            <div class="sd-kpi-icon-box">
                <i class="bi bi-box-seam"></i>
            </div>
        </div>

        <div class="sd-kpi-card sd-kpi-green">
            <div class="sd-kpi-info">
                <div class="sd-kpi-label">Total Sales</div>
                <div class="sd-kpi-value">6,087</div>
            </div>
            <div class="sd-kpi-icon-box">
                <i class="bi bi-box-arrow-down"></i>
            </div>
        </div>

        <div class="sd-kpi-card sd-kpi-yellow">
            <div class="sd-kpi-info">
                <div class="sd-kpi-label">Closing Stock</div>
                <div class="sd-kpi-value">37,005</div>
            </div>
            <div class="sd-kpi-icon-box">
                <i class="bi bi-safe"></i>
            </div>
        </div>

        <div class="sd-kpi-card sd-kpi-teal">
            <div class="sd-kpi-info">
                <div class="sd-kpi-label">Sales %</div>
                <div class="sd-kpi-value">14%</div>
            </div>
            <div class="sd-kpi-icon-box">
                <i class="bi bi-tags"></i>
            </div>
        </div>
    </div>

    <!-- Table Card -->
    <div class="sd-card">
        <div class="sd-table-header">
            <h2 class="sd-table-title">Stock List</h2>
            <div class="sd-search-box">
                <i class="bi bi-search"></i>
                <input type="text" placeholder="Search zones..." />
            </div>
        </div>

        <div class="sd-table-responsive">
            <table class="sd-table">
                <thead>
                    <tr>
                        <th class="text-start">State</th>
                        <th>Opening Stock <span>(as on 1 Apr)</span></th>
                        <th>Supplies <span>(April)</span></th>
                        <th>Total Stock</th>
                        <th>Sales <span>(1-6 Apr)</span></th>
                        <th>Sales <span>(7 Apr)</span></th>
                        <th>Total Sales</th>
                        <th>Closing Stock <span>(as on 7 Apr)</span></th>
                        <th>Sales %</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < 5; i++)
                    {
                        <tr>
                            <td class="text-start">Tamil Nadu</td>
                            <td>16,338</td>
                            <td>571</td>
                            <td>22,055</td>
                            <td>571</td>
                            <td>639</td>
                            <td>3,328</td>
                            <td>18,7771</td>
                            <td>15%</td>
                        </tr>
                    }
                    <tr class="sd-grand-total">
                        <td class="text-start">Grand Total</td>
                        <td>35,113</td>
                        <td>7,978</td>
                        <td>43,092</td>
                        <td>43,092</td>
                        <td>43,092</td>
                        <td>43,092</td>
                        <td>43,092</td>
                        <td>85%</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div class="sd-pagination-bar">
            <div class="sd-page-size">
                <span>Items Per Page</span>
                <select>
                    <option>16</option>
                    <option>25</option>
                    <option>50</option>
                </select>
            </div>
            <div class="sd-page-controls">
                <button class="sd-page-btn"><i class="bi bi-chevron-left"></i></button>
                <button class="sd-page-btn active">1</button>
                <button class="sd-page-btn">2</button>
                <button class="sd-page-btn">3</button>
                <button class="sd-page-btn ellipsis">..</button>
                <button class="sd-page-btn">8</button>
                <button class="sd-page-btn">9</button>
                <button class="sd-page-btn">10</button>
                <button class="sd-page-btn"><i class="bi bi-chevron-right"></i></button>
            </div>
        </div>
    </div>

</div>

