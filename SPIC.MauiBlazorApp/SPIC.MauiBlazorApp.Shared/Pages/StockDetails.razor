@page "/StockDetails"

<style>
    /* Global Variables & Reset */
    :root {
        --primary-blue: #3B82F6;
        --border-color: #E5E7EB;
        --bg-light: #F9FAFB;
        --bg-white: #FFFFFF;
        --text-main: #111827;
        --text-muted: #6B7280;
    }

    *, *::before, *::after {
        box-sizing: border-box;
    }

    .sd-wrapper {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        background-color: var(--bg-light);
        min-height: 100vh;
        padding: clamp(1rem, 3vw, 1.5rem);
        color: var(--text-main);
        box-sizing: border-box;
        width: 100%;
        overflow-x: hidden; /* Prevents body scroll if something tiny pokes out */
    }

    /* Page Header */
    .sd-header-section {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 1.5rem;
        gap: 1rem;
    }

    .sd-header-left {
        flex: 1 1 auto;
        min-width: 280px;
        max-width: 100%;
    }

    .sd-title-area {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .sd-title-area h1 {
        font-size: clamp(1.25rem, 4vw, 1.5rem);
        font-weight: 600;
        margin: 0;
    }

    .sd-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .sd-badge {
        background-color: #F3F4F6;
        color: var(--text-muted);
        padding: 0.35rem 0.75rem;
        border-radius: 0.5rem;
        font-size: 0.75rem;
        font-weight: 500;
        border: 1px solid var(--border-color);
        display: flex;
        align-items: center;
        gap: 0.4rem;
        white-space: nowrap;
    }

    .sd-subtitle {
        color: var(--text-muted);
        font-size: 0.875rem;
        margin-top: 0.75rem;
    }

    .sd-header-actions {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
        flex: 0 0 auto;
        width: 100%;
    }

    .btn-custom {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        font-size: 0.875rem;
        font-weight: 500;
        border-radius: 0.375rem;
        border: 1px solid var(--border-color);
        background-color: var(--bg-white);
        color: var(--text-main);
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-custom:hover {
        background-color: #F3F4F6;
    }

    .btn-primary-custom {
        background-color: var(--primary-blue);
        color: white;
        border-color: var(--primary-blue);
    }

    .btn-primary-custom:hover {
        background-color: #2563EB;
    }

    /* Cards */
    .sd-card {
        background-color: var(--bg-white);
        border: 1px solid var(--border-color);
        border-radius: 0.75rem;
        margin-bottom: 1.5rem;
        box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
        overflow: hidden;
        width: 100%;
    }

    /* Filters Section */
    .sd-filters-header {
        background-color: #F3F4F6;
        padding: 0.75rem 1.25rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-weight: 500;
        border-bottom: 1px solid var(--border-color);
        cursor: pointer;
    }
    
    .sd-filters-body {
        padding: 1.25rem;
        width: 100%;
    }

    .sd-filters-grid {
        display: grid;
        /* Using min(100%, 200px) ensures it fits even if the screen is narrower than 200px */
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
        gap: 1.25rem;
        margin-bottom: 1.25rem;
        width: 100%;
    }

    .sd-form-group {
        width: 100%;
        min-width: 0;
    }

    .sd-form-group label {
        display: block;
        font-size: 0.875rem;
        font-weight: 500;
        margin-bottom: 0.5rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .sd-form-control {
        width: 100%;
        min-width: 0; /* Forces input to shrink below its intrinsic/placeholder size */
        max-width: 100%;
        box-sizing: border-box; 
        padding: 0.5rem 0.75rem;
        border: 1px solid var(--border-color);
        border-radius: 0.375rem;
        font-size: 0.875rem;
        color: var(--text-main);
        background-color: var(--bg-white);
        text-overflow: ellipsis;
    }
    
    .sd-form-control:focus {
        outline: none;
        border-color: var(--primary-blue);
        box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.2);
    }

    .sd-filter-actions {
        display: flex;
        justify-content: flex-end;
        gap: 0.75rem;
        padding-top: 1rem;
        border-top: 1px solid var(--border-color);
        flex-wrap: wrap;
    }

    /* KPI Grid */
    .sd-kpi-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
        gap: 1.25rem;
        margin-bottom: 1.5rem;
    }

    .sd-kpi-card {
        background-color: var(--bg-white);
        border: 1px solid var(--border-color);
        border-radius: 0.5rem;
        padding: 1.25rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    }

    .sd-kpi-info {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .sd-kpi-label {
        font-size: 0.875rem;
        color: var(--text-muted);
        font-weight: 500;
    }

    .sd-kpi-value {
        font-size: clamp(1.25rem, 3vw, 1.75rem);
        font-weight: 600;
        color: var(--text-main);
    }

    .sd-kpi-icon-box {
        width: 48px;
        height: 48px;
        flex-shrink: 0;
        border-radius: 0.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        border: 1px solid;
    }

    .sd-kpi-purple { border-left: 4px solid #A855F7; }
    .sd-kpi-purple .sd-kpi-icon-box { background-color: #FAF5FF; border-color: #E9D5FF; color: #A855F7; }
    
    .sd-kpi-green { border-left: 4px solid #22C55E; }
    .sd-kpi-green .sd-kpi-icon-box { background-color: #F0FDF4; border-color: #BBF7D0; color: #22C55E; }
    
    .sd-kpi-yellow { border-left: 4px solid #EAB308; }
    .sd-kpi-yellow .sd-kpi-icon-box { background-color: #FEFCE8; border-color: #FEF08A; color: #EAB308; }
    
    .sd-kpi-teal { border-left: 4px solid #14B8A6; }
    .sd-kpi-teal .sd-kpi-icon-box { background-color: #F0FDFA; border-color: #99F6E4; color: #14B8A6; }

    /* Table Section */
    .sd-table-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.25rem;
        border-bottom: 1px solid var(--border-color);
        flex-wrap: wrap;
        gap: 1rem;
    }

    .sd-table-title {
        font-size: 1.125rem;
        font-weight: 600;
        margin: 0;
    }

    .sd-search-box {
        position: relative;
        width: 100%;
        max-width: 300px;
    }

    .sd-search-box i {
        position: absolute;
        left: 0.75rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-muted);
    }

    .sd-search-box input {
        width: 100%;
        min-width: 0;
        padding: 0.5rem 0.75rem 0.5rem 2.25rem;
        border: 1px solid var(--border-color);
        border-radius: 0.375rem;
        font-size: 0.875rem;
        background-color: #F9FAFB;
    }
    
    .sd-search-box input:focus {
        outline: none;
        border-color: var(--primary-blue);
        box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.2);
    }

    .sd-table-responsive {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    .sd-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 1000px; /* Forces scroll on small screens to prevent squishing */
    }

    .sd-table th, .sd-table td {
        padding: 1rem 1.25rem;
        text-align: center;
        border-bottom: 1px solid var(--border-color);
        font-size: 0.875rem;
    }

    .sd-table th {
        background-color: #F9FAFB;
        color: var(--text-main);
        font-weight: 600;
        white-space: nowrap;
    }
    
    .sd-table th.text-start, .sd-table td.text-start {
        text-align: left;
    }

    .sd-table th span {
        color: var(--text-muted);
        font-weight: 400;
        font-size: 0.75rem;
        display: block;
        margin-top: 0.25rem;
    }

    .sd-grand-total {
        background-color: #ECFDF5;
        font-weight: 600;
    }

    /* Pagination */
    .sd-pagination-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 1.25rem;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .sd-page-size {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.875rem;
    }
    
    .sd-page-size select {
        padding: 0.375rem;
        border: 1px solid var(--border-color);
        border-radius: 0.375rem;
        background-color: var(--bg-white);
    }

    .sd-page-controls {
        display: flex;
        gap: 0.25rem;
        flex-wrap: wrap;
        justify-content: center;
    }

    .sd-page-btn {
        padding: 0.375rem 0.75rem;
        border: 1px solid var(--border-color);
        background-color: var(--bg-white);
        border-radius: 0.375rem;
        cursor: pointer;
        font-size: 0.875rem;
        color: var(--text-muted);
        min-width: 32px;
        text-align: center;
    }

    .sd-page-btn.active {
        background-color: #F3F4F6;
        color: var(--text-main);
        font-weight: 600;
    }

    .sd-page-btn:hover:not(.ellipsis) {
        background-color: #F9FAFB;
    }
    
    .sd-page-btn.ellipsis {
        border: none;
        background: transparent;
        cursor: default;
    }

    /* Responsive Breakpoints */
    @@media (min-width: 769px) {
        .sd-header-actions {
            width: auto;
        }
    }

    /* Tablet Portrait & Large Mobile */
    @@media (max-width: 768px) {
        .sd-header-section {
            flex-direction: column;
            gap: 1.25rem;
        }
        
        .sd-header-actions {
            display: grid;
            grid-template-columns: repeat(2, 1fr); 
            gap: 0.5rem;
        }
        
        .sd-header-actions .btn-custom {
            width: 100%;
        }

        .sd-table-header {
            flex-direction: column;
            align-items: stretch;
        }
        
        .sd-table-title {
            margin-bottom: 0.5rem;
        }

        .sd-search-box {
            max-width: 100%;
        }

        .sd-pagination-bar {
            flex-direction: column;
            justify-content: center;
            text-align: center;
        }
    }

    /* Small Mobile */
    @@media (max-width: 480px) {
        .sd-title-area {
            flex-direction: column;
            align-items: flex-start;
        }

        .sd-header-actions {
            grid-template-columns: 1fr; 
        }

        .sd-filter-actions {
            flex-direction: column;
            width: 100%;
        }

        .sd-filter-actions .btn-custom {
            width: 100%;
        }
        
        .sd-page-controls {
            gap: 0.15rem;
        }
        
        .sd-page-btn {
            padding: 0.25rem 0.5rem;
            font-size: 0.75rem;
        }
    }
</style>

<div class="sd-wrapper">

    <!-- Page Header -->
    <div class="sd-header-section">
        <div class="sd-header-left">
            <div class="sd-title-area">
                <h1>Stock Details</h1>
                <div class="sd-badges">
                    <span class="sd-badge"><i class="bi bi-calendar3"></i> Date as on: 07 Apr 2025</span>
                    <span class="sd-badge"><i class="bi bi-calendar-event"></i> Month: April 2025</span>
                </div>
            </div>
            <p class="sd-subtitle">Consolidated stock and sales updated daily</p>
        </div>
        <div class="sd-header-actions">
            <button class="btn-custom"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
            <button class="btn-custom"><i class="bi bi-file-earmark-spreadsheet" style="color:#16A34A"></i> Excel</button>
            <button class="btn-custom"><i class="bi bi-file-earmark-pdf" style="color:#DC2626"></i> PDF</button>
            <button class="btn-custom btn-primary-custom"><i class="bi bi-envelope"></i> Mail</button>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="sd-card">
        <div class="sd-filters-header">
            <span><i class="bi bi-filter-left"></i> Filters</span>
            <i class="bi bi-chevron-down"></i>
        </div>
        <div class="sd-filters-body">
            <div class="sd-filters-grid">
                <div class="sd-form-group">
                    <label>Date Range</label>
                    <input type="text" class="sd-form-control" placeholder="01 Apr 2025 - 28 Apr 2025" />
                </div>
                <div class="sd-form-group">
                    <label>Month</label>
                    <select class="sd-form-control">
                        <option value="" disabled selected hidden>Select Month</option>
                    </select>
                </div>
                <div class="sd-form-group">
                    <label>Year</label>
                    <select class="sd-form-control">
                        <option value="" disabled selected hidden>Select Year</option>
                    </select>
                </div>
                <div class="sd-form-group">
                    <label>State</label>
                    <select class="sd-form-control">
                        <option value="" disabled selected hidden>All State</option>
                    </select>
                </div>
            </div>
            <div class="sd-filter-actions">
                <button class="btn-custom"><i class="bi bi-x"></i> Clear All</button>
                <button class="btn-custom btn-primary-custom"><i class="bi bi-funnel"></i> Apply Filters</button>
            </div>
        </div>
    </div>

    <!-- KPI Cards -->
    <div class="sd-kpi-grid">
        <div class="sd-kpi-card sd-kpi-purple">
            <div class="sd-kpi-info">
                <div class="sd-kpi-label">Total Stock</div>
                <div class="sd-kpi-value">43,092</div>
            </div>
            <div class="sd-kpi-icon-box">
                <i class="bi bi-box-seam"></i>
            </div>
        </div>

        <div class="sd-kpi-card sd-kpi-green">
            <div class="sd-kpi-info">
                <div class="sd-kpi-label">Total Sales</div>
                <div class="sd-kpi-value">6,087</div>
            </div>
            <div class="sd-kpi-icon-box">
                <i class="bi bi-box-arrow-down"></i>
            </div>
        </div>

        <div class="sd-kpi-card sd-kpi-yellow">
            <div class="sd-kpi-info">
                <div class="sd-kpi-label">Closing Stock</div>
                <div class="sd-kpi-value">37,005</div>
            </div>
            <div class="sd-kpi-icon-box">
                <i class="bi bi-safe"></i>
            </div>
        </div>

        <div class="sd-kpi-card sd-kpi-teal">
            <div class="sd-kpi-info">
                <div class="sd-kpi-label">Sales %</div>
                <div class="sd-kpi-value">14%</div>
            </div>
            <div class="sd-kpi-icon-box">
                <i class="bi bi-tags"></i>
            </div>
        </div>
    </div>

    <!-- Table Card -->
    <div class="sd-card">
        <div class="sd-table-header">
            <h2 class="sd-table-title">Stock List</h2>
            <div class="sd-search-box">
                <i class="bi bi-search"></i>
                <input type="text" placeholder="Search zones..." />
            </div>
        </div>

        <div class="sd-table-responsive">
            <table class="sd-table">
                <thead>
                    <tr>
                        <th class="text-start">State</th>
                        <th>Opening Stock <span>(as on 1 Apr)</span></th>
                        <th>Supplies <span>(April)</span></th>
                        <th>Total Stock</th>
                        <th>Sales <span>(1-6 Apr)</span></th>
                        <th>Sales <span>(7 Apr)</span></th>
                        <th>Total Sales</th>
                        <th>Closing Stock <span>(as on 7 Apr)</span></th>
                        <th>Sales %</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < 5; i++)
                    {
                        <tr>
                            <td class="text-start">Tamil Nadu</td>
                            <td>16,338</td>
                            <td>571</td>
                            <td>22,055</td>
                            <td>571</td>
                            <td>639</td>
                            <td>3,328</td>
                            <td>18,7771</td>
                            <td>15%</td>
                        </tr>
                    }
                    <tr class="sd-grand-total">
                        <td class="text-start">Grand Total</td>
                        <td>35,113</td>
                        <td>7,978</td>
                        <td>43,092</td>
                        <td>43,092</td>
                        <td>43,092</td>
                        <td>43,092</td>
                        <td>43,092</td>
                        <td>85%</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div class="sd-pagination-bar">
            <div class="sd-page-size">
                <span>Items Per Page</span>
                <select>
                    <option>16</option>
                    <option>25</option>
                    <option>50</option>
                </select>
            </div>
            <div class="sd-page-controls">
                <button class="sd-page-btn"><i class="bi bi-chevron-left"></i></button>
                <button class="sd-page-btn active">1</button>
                <button class="sd-page-btn">2</button>
                <button class="sd-page-btn">3</button>
                <button class="sd-page-btn ellipsis">..</button>
                <button class="sd-page-btn">8</button>
                <button class="sd-page-btn">9</button>
                <button class="sd-page-btn">10</button>
                <button class="sd-page-btn"><i class="bi bi-chevron-right"></i></button>
            </div>
        </div>
    </div>

</div>

