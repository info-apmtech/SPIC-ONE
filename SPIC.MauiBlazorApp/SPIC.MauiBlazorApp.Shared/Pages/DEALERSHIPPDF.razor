private decimal GetApprovalLimit(Func<DealerApprovalHistory, decimal?> selector)
{
    if (_approvalHistories == null || !_approvalHistories.Any()) return 0m;
    var row = _approvalHistories
        .Where(h => h.IsApproved)
        .Where(h => (selector(h) ?? 0m) > 0m)
        .OrderByDescending(h => h.ApprovedAt)
        .FirstOrDefault();
    return row != null ? (selector(row) ?? 0m) : 0m;
}

