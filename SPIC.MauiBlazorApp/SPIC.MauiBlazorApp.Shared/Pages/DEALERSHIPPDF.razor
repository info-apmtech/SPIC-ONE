<div class="dpdf-section">
    <div class="dpdf-section-title mb-2">
        <div class="dpdf-section-icon"><i class="bi bi-file-earmark-text"></i></div>
        <div class="dpdf-section-text">Enclosures</div>
    </div>

    @{
        var enclosures = new List<(string Label, string Path)>();
        void Add(string label, string? path)
        {
            if (!string.IsNullOrWhiteSpace(path)) enclosures.Add((label, path!));
        }

        // Core dealer documents (always shown from Register page)
        Add("GST Certificate", _model?.GSTFilePath);
        Add("PAN", _model?.PANFilePath);
        Add("Aadhaar", _model?.AadhaarFilePath);
        if (_hasWholesaleLicense) Add("Wholesale Fertilizers License", _model?.WholesaleLicenseFilePath);
        if (_hasRetailLicense) Add("Retail Fertilizers License", _model?.RetailLicenseFilePath);

        // Partner / proprietor documents
        if (_savedPartners != null)
        {
            foreach (var p in _savedPartners)
            {
                Add($"{p.Name} - Photo", p.ProprietorImagePath);
                Add($"{p.Name} - PAN", p.PANFilePath);
                if (!_isSoleProprietor) Add($"{p.Name} - Aadhaar", p.AadhaarFilePath);
            }
        }

        // Property documents
        if (_landAssets != null)
        {
            foreach (var l in _landAssets)
            {
                Add($"Land: {l.LandName} - Encumbrance Certificate", l.UploadedECDocumentPath);
                Add($"Land: {l.LandName} - Property Document", l.UploadedLandDocumentPath);
                Add($"Land: {l.LandName} - Valuation Certificate", l.UploadedValuationCertificatePath);
            }
        }
        if (_buildingAssets != null)
        {
            foreach (var b in _buildingAssets)
            {
                Add($"Building: {b.BuildingName} - Encumbrance Certificate", b.UploadedECDocumentPath);
                Add($"Building: {b.BuildingName} - Property Document", b.UploadedBuildingDocumentPath);
                Add($"Building: {b.BuildingName} - Valuation Certificate", b.UploadedValuationCertificatePath);
            }
        }

        // Additional documents (only when not terminated-restricted)
        if (!_isTerminatedRestricted)
        {
            if (string.IsNullOrEmpty(SelectedCompany) || SelectedCompany == "SPIC")
                Add("SPIC Specimen Signature", _docs?.SpecimanFilePath);
            if (string.IsNullOrEmpty(SelectedCompany) || SelectedCompany == "GreenStar")
                Add("Greenstar Specimen Signature", _docs?.GreenstarSpecimanFilePath);

            Add("IT Returns for Last Year", _docs?.FY1ITReturnFilePath);
            Add("IT Returns for Last 2nd Year", _docs?.FY2ITReturnFilePath);
            Add("Valuation Certificate", _docs?.ValuationCertificateFilePath);
            Add("List of Retailers", _docs?.RetailerListFilePath);
            if (_showPartnershipDeed) Add("Partnership Deed", _docs?.PartnershipDeadFilePath);
            if (_showBoardResolution) Add("Board Resolution", _docs?.BoardReasolutionFilePath);
            Add("Bank Guarantee Certificate", _docs?.BankGauranteeFilePath);
            Add("Affidavit", _docs?.AffidavitFilePath);
            Add("Deed of Guarantee", _docs?.DeedOfGuaranteeFilePath);
            if (_showAuthorizationLetter) Add("Authorization Letter", _docs?.AuthorizationLetterFilePath);
        }
    }

