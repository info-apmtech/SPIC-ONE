{
void RenderSalesPerf(string title, Func<Category?, Product?, bool> rule)
{
    var years = GetPerformanceYears();

    // Build product IDs from sales rows whose ROW category + product both match the company rule
   var productIds = _creditLimitSales
        .Where(r =>
        {
            var prod = _productsAll.FirstOrDefault(p => p.Id == r.ProductId);
            var cat  = _categoriesAll.FirstOrDefault(c => c.Id == r.CategoryId);
            return rule(cat, prod);
        })
        .Select(r => r.ProductId)
        .Distinct()
        .ToList();

    // (the old debug fallback that pulled every product is removed)

    <div class="dpdf-section">
        <div class="dpdf-section-title mb-2">
            <div class="dpdf-section-icon">📊</div>
            <div class="dpdf-section-text">@title</div>
        </div>

        @if (years.Any() && productIds.Any())
        {
            <table class="sales-table table-th-center" style="width:100%; border-collapse: collapse;">
                <thead>
                    <tr>
                        <th rowspan="2" style="vertical-align: bottom; text-align: left;">Product Name / Category</th>
                        @foreach (var y in years)
                        {
                            <th colspan="2" style="border-bottom: 1px solid var(--border-color); text-align: center;">@y.Name</th>
                        }
                    </tr>
                    <tr>
                        @foreach (var y in years)
                        {
                            <th style="background-color: #f8fafc; text-align: center;">MT</th>
                            <th style="background-color: #f8fafc; text-align: center;">Lakhs</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pId in productIds)
                    {
                        var product = _productsAll.FirstOrDefault(p => p.Id == pId);
                        var category = _categoriesAll.FirstOrDefault(c => c.Id == product?.CategoryId);
                        <tr>
                            <td style="text-align: left;">
                                @(product?.Name ?? $"Product ID: {pId}")
                                @if (category != null)
                                {
                                    <span class="stacked-val-alt" style="display:block; font-size: 11px; color: #6b7280;">@category.Name</span>
                                }
                            </td>
                            @foreach (var y in years)
                            {
                                var cell = GetPerfCell(pId, y.Id);
                                <td style="text-align: right;">@cell.qty.ToString("N2")</td>
                                <td style="text-align: right;">@cell.amount.ToString("N2")</td>
                            }
                        </tr>
                    }

                    <tr style="background-color: var(--card-bg); font-weight: bold; border-top: 2px solid #cbd5e1;">
                        <td style="text-align: left; color: var(--primary-dark);">Total</td>
                        @foreach (var y in years)
                        {
                            var totQty = productIds.Sum(id => GetPerfCell(id, y.Id).qty);
                            var totAmt = productIds.Sum(id => GetPerfCell(id, y.Id).amount);
                            <td style="color: var(--primary-green); text-align: right;">@totQty.ToString("N2")</td>
                            <td style="color: var(--primary-green); text-align: right;">@totAmt.ToString("N2")</td>
                        }
                    </tr>
                </tbody>
            </table>
        }
        else
        {
            <div class="value" style="padding: 20px; text-align: center; color: var(--label-color);">No Sales Performance Data Available</div>
        }
    </div>
}
 if (string.IsNullOrEmpty(SelectedCompany) || SelectedCompany == "SPIC")
{
    RenderSalesPerf("Sales Performance Review - SPIC",
