        {
            var rawToken = token.StartsWith("Bearer ") ? token.Substring("Bearer ".Length) : token;
            return $"{baseUrl}/api/DealerFile/view/{relative}?access_token={rawToken}";
        }
        
        return $"{baseUrl}/api/DealerFile/view/{relative}";
    }
