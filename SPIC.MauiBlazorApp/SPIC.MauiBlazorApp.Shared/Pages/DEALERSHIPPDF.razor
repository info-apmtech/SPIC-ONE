@page "/DealershipPDF/{dealerId:int?}"
@layout SPIC.MauiBlazorApp.Shared.Layout.EmptyLayout
@using Microsoft.AspNetCore.Components
@using System.Net.Http.Json
@inject HttpClient Http
@inject SPIC.MauiBlazorApp.Shared.Services.PlatformService Platform
@inject Microsoft.JSInterop.IJSRuntime JS
@inject NavigationManager NavManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dealership Application Form - Full</title>
 <style>
      :root {
          --primary-dark: #2c3e2d;
          --primary-green: #0a6b3d;
          --highlight-yellow: #f4d023;
          --dark-yellow: #b48600;
          --border-color: #e5e7eb;
          --label-color: #6b7280;
          --bg-color: #ffffff;
          --card-bg: #fefdf8;
          --pdf-font-size: 12px; /* Uniform font size across the PDF */
      }

      * { box-sizing: border-box; }

      html, body {
          height: auto !important;
          overflow-y: auto !important;
          overflow-x: hidden;
          background-color: #333333; 
          margin: 0;
          padding: 0;
          font-family: Arial, Helvetica, sans-serif;
          font-size: var(--pdf-font-size);
      }

      .page-wrapper {
          padding: 40px 20px;
          display: flex;
          flex-direction: column;
          align-items: center;
          min-height: 100vh;
      }

      .print-ui-layer {
          position: fixed;
          top: 20px;
          right: 40px;
          z-index: 9999;
      }

      .btn-print-action {
          background-color: var(--highlight-yellow);
          color: var(--primary-dark);
          border: none;
          padding: 12px 24px;
          font-weight: bold;
          border-radius: 4px;
          cursor: pointer;
          box-shadow: 0 4px 10px rgba(0,0,0,0.3);
          display: flex;
          align-items: center;
          gap: 8px;
          font-size: var(--pdf-font-size);
      }

      .btn-print-action:hover { background-color: #e2c110; }

      .document-container {
          background-color: var(--bg-color);
          width: 210mm; /* Fixed A4 Width */
          max-width: 850px;
          min-height: 297mm; 
          height: auto; 
          margin: 0 auto;
          box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
          position: relative;
      }

      .document-container::before {
          content: "GREENSTAR";
          position: absolute;
          top: 50%;
          left: 50%;
          transform: translate(-50%, -50%) rotate(-30deg);
          font-size: 12rem;
          color: rgba(244, 208, 35, 0.04);
          font-weight: bold;
          pointer-events: none;
          z-index: 0;
          white-space: nowrap;
      }

      .doc-header {
          background-color: var(--primary-dark);
          color: white;
          padding: 30px 40px;
          display: flex;
          justify-content: space-between;
          align-items: flex-start;
          position: relative;
          z-index: 1;
      }

      .logo {
          color: var(--highlight-yellow);
          font-weight: bold;
          font-size: 1.2rem;
          display: flex;
          align-items: center;
          gap: 10px;
      }

      .logo span {
          color: var(--primary-green);
          background: var(--highlight-yellow);
          border-radius: 50%;
          width: 24px;
          height: 24px;
          display: inline-flex;
          align-items: center;
          justify-content: center;
          font-size: var(--pdf-font-size);
      }

      .header-content {
          text-align: center;
          flex-grow: 1;
          padding: 0 20px;
      }

      .header-content h1 { font-size: 1.2rem; margin: 0 0 15px 0; letter-spacing: 1px; }
      .header-content h2 { color: var(--highlight-yellow); font-size: 1.1rem; margin: 0 0 8px 0; }
      .header-content p { font-size: var(--pdf-font-size); margin: 0; color: #d1d5db; }

      .header-meta { text-align: right; font-size: var(--pdf-font-size); line-height: 1.5; }

      .doc-body { padding: 30px 40px; position: relative; z-index: 1; }

      /* Fix: Force ALL headings inside the doc body to exactly match our uniform font size */
      .doc-body h1, .doc-body h2, .doc-body h3, .doc-body h4, .doc-body h5, .doc-body h6 {
          font-size: var(--pdf-font-size) !important;
          color: var(--primary-dark);
      }
      .sub-card-header h3, .exp-header h3 {
          margin-bottom: 0 !important;
          margin-top: 0 !important;
      }
      .sub-card-title {
          font-size: var(--pdf-font-size) !important;
          margin-bottom: 12px;
          margin-top: 0;
      }

      .section { margin-bottom: 25px; page-break-inside: auto; break-inside: auto;}

    .section-title {
    display: flex;
    align-items: center;
    width: 100%;
    background-color: #f4d800;
    font-weight: 600;
    font-size: var(--pdf-font-size);
    height: 32px; 
    page-break-after: avoid; 
          break-after: avoid;
}

.section-icon {
    background-color: #1f3b2d;
    color: white;
    width: 32px;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--pdf-font-size);
}

.section-text {
    padding: 0 10px;
    color: #1f3b2d;
}

      .grid-1 { display: grid; grid-template-columns: 1fr; gap: 15px; }
      .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 15px 30px; }
      .grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 15px 20px; }

      .field { display: flex; flex-direction: column; gap: 5px; }
      .field label { font-size: var(--pdf-font-size); color: var(--label-color); }
      .field .value { 
          border: 1px solid var(--border-color); 
          padding: 8px 12px; 
          font-size: var(--pdf-font-size); 
          color: var(--primary-green); 
          font-weight: 500; 
          min-height: 34px; 
          background-color: #fff; 
          word-break: break-word;
      }

      .sub-card {
          background-color: var(--card-bg);
          border: 1px solid var(--border-color);
          border-radius: 8px;
          padding: 20px;
          margin-bottom: 15px;
          page-break-inside: avoid;
      }

      .sales-table {
          width: 100%;
          border-collapse: collapse;
          font-size: var(--pdf-font-size);
          background: #fff;
          border: 1px solid var(--border-color);
          page-break-inside: auto;
      }

      .sales-table th {
          text-align: left;
          padding: 12px;
          color: var(--label-color);
          font-weight: normal;
          border-bottom: 1px solid var(--border-color);
          background: var(--card-bg);
      }

      .sales-table td { padding: 12px; border-bottom: 1px solid var(--border-color); color: #374151; }

      .summary-bar {
          background-color: #f8fafc;
          border-left: 4px solid var(--primary-dark);
          padding: 12px 20px;
          display: flex;
          justify-content: space-between;
          align-items: center;
          font-weight: bold;
          color: var(--primary-dark);
          margin-top: 15px;
          border-radius: 0 4px 4px 0;
          border-top: 1px solid var(--border-color);
          border-right: 1px solid var(--border-color);
          border-bottom: 1px solid var(--border-color);
          font-size: var(--pdf-font-size);
      }

      /* PRINT LOGIC */
      @@media print {
          body, html { background-color: white !important; overflow: visible !important; height: auto !important; font-size: var(--pdf-font-size) !important; }
          .print-ui-layer { display: none !important; }
          .page-wrapper { padding: 0 !important; }
          .document-container { 
              box-shadow: none !important; 
              margin: 0 !important; 
              width: 100% !important;
              max-width: none !important;
          }
          .doc-body { overflow: visible !important; }
          @@page { size: A4 portrait; margin: 8mm; }
          
          .table-responsive {
              overflow: visible !important;
              width: 100% !important;
          }

          .spic-table {
              width: 100% !important;
              font-size: var(--pdf-font-size) !important; 
          }
          .spic-table th, .spic-table td {
              padding: 4px !important;
          }

          .table-val-box, .section-title, .section-icon {
              -webkit-print-color-adjust: exact !important;
              print-color-adjust: exact !important;
          }
          
          .form-card {
              margin-bottom: 20px !important;
              page-break-inside: auto !important;
              break-inside: auto !important;        
          }
      }
      
      .partnerships-text {
        background-color: #FACC15;
        color: #374151;
        display: flex;
        align-items: center;
        padding-left: 16px;
        font-weight: 700;
        font-size: var(--pdf-font-size);
        flex-grow: 1;
    }

    .partnerships-pill-group {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
    }

    .partnerships-pill-tag {
        background-color: #F0FDF4; 
        border: 1px solid #86EFAC; 
        color: #065F46; 
        padding: 8px 16px;
        border-radius: 6px;
        font-size: var(--pdf-font-size);
        font-weight: 600;
        box-shadow: 0 1px 2px rgba(0,0,0,0.02);
    } 

    .proprietor-wrap {
        display: grid;
        grid-template-columns: 1fr 150px;
        gap: 18px;
        align-items: start;
    }

    .prop-fields {
        width: 100%;
    }

    .prop-photo-box {
        width: 150px;
        height: 200px;
        border: 1px solid var(--border-color);
        border-radius: 6px;
        overflow: hidden;
        background: #f8fafc;
    }

    .prop-photo-box img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }
    .file-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
}

.file-name-text {
    color: #059669;
    font-weight: 500;
    word-break: break-word;
    flex: 1;
    min-width: 0;
}

.view-file-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 0 10px;
    height: 22px;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    background: #ffffff;
    color: #1f2937;
    text-decoration: none;
    font-weight: 500;
    font-size: 11px;
    line-height: 1;
    white-space: nowrap;
    flex-shrink: 0;
}

.view-file-btn:hover {
    border-color: #9ca3af;
    background: #f9fafb;
}

.view-file-btn i { 
    font-size: 14px;
    line-height: 1;
}

.view-file-btn .bi-file-earmark-pdf-fill   { color: #dc2626; }
.view-file-btn .bi-file-earmark-image-fill { color: #2563eb; }
.view-file-btn .bi-file-earmark-word-fill  { color: #1d4ed8; }
.view-file-btn .bi-file-earmark-excel-fill { color: #16a34a; }
.view-file-btn .bi-file-earmark-fill       { color: #6b7280; }

@@media print {
    .view-file-btn { display: none; }
}
  </style>

</head>
<body>

    @if (_isLoading)
    {
        <div style="text-align:center; padding: 50px; color: white;">
            <h4>Loading Document Data...</h4>
        </div>
    }
    else
    {
        <div class="document-container">
            <header class="doc-header">
              @if (string.IsNullOrEmpty(SelectedCompany) || SelectedCompany == "SPIC")
{
    <div class="logo">
        <img src="_content/SPIC.MauiBlazorApp.Shared/Images/LayoutImages/spiclogo.png" alt="SPIC" style="height: 45px; object-fit: contain;" />
    </div>
}
else if (string.IsNullOrEmpty(SelectedCompany) || SelectedCompany == "GreenStar")
{
    <div class="logo">
        <img src="_content/SPIC.MauiBlazorApp.Shared/Images/LayoutImages/greenstarlogo.png" alt="GreenStar" style="height: 45px; object-fit: contain;" />
    </div>
}

                <div class="header-content">
                    <h1>DEALERSHIP APPLICATION FORM</h1>
                @if (string.IsNullOrEmpty(SelectedCompany) || SelectedCompany == "SPIC")
                {
                    <h2>SPIC FERTILIZERS LIMITED</h2>
                }
                 else if(string.IsNullOrEmpty(SelectedCompany) || SelectedCompany == "GreenStar")
                { 
                    <h2>GREENSTAR FERTILIZERS LIMITED</h2>
                }
                    <p>Registered Office & Principal Office: 88 Mount Road, Guindy, Chennai - 600032.</p>
                </div>
                <div class="header-meta">
                    REF: @(_model.DealerCode ?? "DR-NEW")<br>
                    @DateTime.Now.ToString("dd MMMM yyyy")
                </div>
            </header>

            <div class="doc-body">
                
                <div class="section">
                   <div class="section-title mb-2">
    <div class="section-icon">🏢</div>
    <div class="section-text">Company Details</div>
</div>
                    <div class="grid-2">
                        <div class="field">
                            <label>Company Name</label>
                            <div class="value">@(_model.FirmName ?? "-")</div>
                        </div>
                        @* <div class="field">
                            <label>Selected Company</label>
                            <div class="value">@GetSelectedCompany()</div>
                        </div> *@
                        <div class="field">
                            <label>State</label>
                            <div class="value">@GetStateName(_model.StateId)</div>
                        </div>
                        <div class="field">
                            <label>Region</label>
                            <div class="value">@GetRegionName(_model.Region)</div>
                        </div>
                        <div class="field">
                            <label>HQ</label>
                            <div class="value">@GetHqName(_model.HQ)</div>
                        </div>
                        <div class="field">
                            <label>Status</label>
                            <div class="value">@GetStatusName(_model.Status)</div>
                        </div>
                    </div>
                </div>

                <div class="section">
                    <div class="section-title mb-2">
                        <div class="section-icon">📋</div> <div class="section-text">Status Details</div>
                    </div>
                    
                    <div class="grid-3">
                        <div class="field">
                            <label>Last Transaction Date</label>
                            <div class="value">@(_model.LastTransactionDate?.ToString("dd MMMM yyyy") ?? "-")</div>
                        </div>
                        <div class="field">
                            <label>Transaction Type</label>
                            <div class="value">@(_model.IsLastTransactionIsSale == true ? "Sales" : "Collection")</div>
                        </div>
                        <div class="field">
                            <label>Remarks</label>
                            <div class="value">@(_model.Remarks ?? "Pending Review")</div>
                        </div>
                    </div>
                </div>

                <div class="section">
                    <div class="section-title mb-2">
                        <div class="section-icon">💼</div> <div class="section-text">Business Information</div>
                    </div>
                    <div class="grid-2">
                        <div class="field">
                            <label>Dealer Code & Name</label>
                            <div class="value">@_model.DealerCode - @_model.FirmName</div>
                        </div>
                        <div class="field">
                            <label>Parent Dealer</label>
                            <div class="value">@GetDealerName(_model.ParentDealer)</div>
                        </div>
                        <div class="field">
                            <label>Business Type</label>
                            <div class="value">@(_model.BusinessEntityType ?? "-")</div>
                        </div>
                        <div class="field">
                            <label>Date of Appointment</label>
                            <div class="value">@(_model.DateOfAppointment?.ToString("dd MMMM yyyy") ?? "-")</div>
                        </div>
                        <div class="field">
                            <label>Years of Experiance</label>
                            <div class="value">@(_model.YearsofExperiance > 0 ? $"{_model.YearsofExperiance} Years" : "-")</div>
                        </div>
                    </div>
                </div>

                <div class="section">
                    <div class="section-title mb-2">
                        <div class="section-icon">📍</div>  <div class="section-text"> Location Information</div>
                    </div>
                    <div class="grid-2" style="margin-bottom: 15px;">
                        <div class="field">
                            <label>Shop No / Room No / Block No</label>
                            <div class="value">@(_model.ShopNoORRoomNoOrBlockNo ?? "-")</div>
                        </div>
                        <div class="field">
                            <label>Street / Area / Locality</label>
                            <div class="value">@(_model.Street ?? "-")</div>
                        </div>
                        
                        <div class="field">
                            <label>Sub Village</label>
                            <div class="value">@(_model.SubVillage ?? "-")</div>
                        </div>
                        <div class="field">
                            <label>Village</label>
                            <div class="value">@(_model.Village ?? "-")</div>
                        </div>
                        <div class="field">
                            <label>Block</label>
                            <div class="value">@(_model.Block ?? "-")</div>
                        </div>
                        <div class="field">
                            <label>Taluk</label>
                            <div class="value">@(_model.Taluk ?? "-")</div>
                        </div>
                        <div class="field">
                            <label>District</label>
                            <div class="value">@GetDistrictName(_model.DistrictId)</div>
                        </div>  
                         
                         <div class="field">
                            <label>Pin Code</label>
                            <div class="value">@(_model.PinCode ?? "-")</div>
                        </div>
                        <div class="field">
                            <label>State</label>
                            <div class="value">@GetStateName(_model.StateId)</div>
                        </div>  
                         <div class="field">
                            <label>Official Number</label>
                            <div class="value">@(_model.OfficialContactNumber ?? "-")</div>
                        </div>
                        <div class="field">
                            <label>Whatsapp Number</label>
                            <div class="value">@(_model.WhatsAppNumber ?? "-")</div>
                        </div>
                        <div class="field">
                            <label>Alternative Number</label>
                            <div class="value">@(_model.AlternativeNumber ?? "-")</div>
                        </div>
                        
                    </div>
                </div>


                 <div class="section">
                    <div class="section-title mb-2">
                        <div class="section-icon">📋</div> <div class="section-text">Trade Deposit Details</div>
                    </div>
                    
                    <div class="grid-3">
                        <div class="field">
                            <label>Trade Deposit Amount (₹ in lakhs)</label>
                            <div class="value">@(_model.TradeDepositAmount.ToString("N2") ?? "-")</div>
                        </div>
                        <div class="field">
                            <label>Receipt No</label>
                            <div class="value">@(_model.TradeDepositReceiptNo?? "-")</div>
                        </div>
                        <div class="field">
                            <label>Deposit Date</label>
                            <div class="value">@(_model.TradeDepositDate?.ToString("dd MMMM yyyy") ?? "-")</div>
                        </div>
                    </div>
                </div>

                <div class="section">
                    <div class="section-title mb-2">
                        <div class="section-icon">🏦</div>   <div class="section-text">Bank Details</div>
                    </div>
                    <div class="grid-3" style="margin-bottom: 15px;">
                        <div class="field">
                            <label>Account Holder Name</label>
                            <div class="value">@(_model.AccountHolderName ?? "-")</div>
                        </div>
                        <div class="field">
                            <label>Account Number</label>
                            <div class="value">@(_model.AccountNumber ?? "-")</div>
                        </div>
                        <div class="field">
                            <label>Bank Name</label>
                            <div class="value">@GetBankName(_model.BankId)</div>
                        </div>
                        
                    </div>
                    <div class="grid-2">
                         <div class="field">
                            <label>Bank Branch</label>
                            <div class="value">@(_model.Branch ?? "-")</div>
                        </div>
                        <div class="field">
                            <label>IFSC Code</label>
                            <div class="value">@(_model.IFSC ?? "-")</div>
                        </div>
                    </div>
                </div>

                <div class="section">
                    <div class="section-title mb-2">
                        <div class="section-icon">🧾</div> <div class="section-text">Tax & Compliance</div>
                    </div>
                    <div class="grid-3">
                        <div class="field">
                            <label>GST Details</label>
                            <div class="value">@(_model.GSTNumber ?? "-")</div>
                        </div>
                        <div class="field">
                            <label>PAN Details</label>
                            <div class="value">@(_model.PANNumber ?? "-")</div>
                        </div>
                        <div class="field">
                            <label>Aadhaar Details</label>
                            <div class="value">@(_model.AadhaarNumber ?? "-")</div>
                        </div>
                    </div>
                </div>

                <div class="section">
                    <div class="section-title mb-2">
                        <div class="section-icon">📄</div>   <div class="section-text">Fertilizer License Details</div>
                    </div>
                    <div class="sub-card">
                        <h3 class="sub-card-title">Wholesale Fertilizer License</h3>
                        <div class="grid-3">
                            <div class="field">
                                <label>License Number</label>
                                <div class="value">@(_model.WholeSaleFertilizerLicenseNumber ?? "-")</div>
                            </div>
                            <div class="field">
                                <label>Expiry Date</label>
                                <div class="value">@(_model.WholesaleLicenseExpiryDate?.ToString("dd MMMM yyyy") ?? "-")</div>
                            </div>
                            <div class="field">
                                <label>MFMS Code</label>
                                <div class="value">@(_model.WholesalemFMSCode ?? "-")</div>
                            </div>
                        </div>
                    </div>
                    <div class="sub-card">
                        <h3 class="sub-card-title">Retail Fertilizer Details</h3>
                        <div class="grid-3">
                            <div class="field">
                                <label>License Number</label>
                                <div class="value">@(_model.RetailFertilizerLicenseNumber ?? "-")</div>
                            </div>
                            <div class="field">
                                <label>Expiry Date</label>
                                <div class="value">@(_model.RetailLicenseExpiryDate?.ToString("dd MMMM yyyy") ?? "-")</div>
                            </div>
                            <div class="field">
                                <label>MFMS Code</label>
                                <div class="value">@(_model.RetailmFMSCode ?? "-")</div>
                            </div>
                        </div>
                    </div> 
                    <div class="sub-card">
                    <div class="grid-2 mt-15">
                        <div>
                            <div class="group-title">Office Automation</div>
                            <div class="field">
                                <label>Do you have office automation?</label>
                                <div class="checkbox-wrap">
                                    <label class="checkbox-item"><input type="checkbox" checked="@(_model.IsOfficeAutomation == true)" disabled> Yes</label>
                                    <label class="checkbox-item"><input type="checkbox" checked="@(_model.IsOfficeAutomation == false)" disabled> No</label>
                                </div>
                            </div>
                        </div>
                        <div>
                            <div class="group-title">Enrollment Status</div>
                            <div class="field">
                                <label>Are You Enrolled in SDWA?</label>
                                <div class="checkbox-wrap">
                                    <label class="checkbox-item"><input type="checkbox" checked="@(_model.IsSDWA == true)" disabled> Yes</label>
                                    <label class="checkbox-item"><input type="checkbox" checked="@(_model.IsSDWA == false)" disabled> No</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                 </div>

                
                <div class="section">
    <div class="section-title mb-2">
        <div class="section-icon">📉</div>   <div class="section-text">Experience Details</div>
    </div>

    @if (_experiences != null && _experiences.Any())
    {
        @foreach (var exp in _experiences)
        {
            var companyName = _companyAll
                .FirstOrDefault(c => c.Id.ToString() == exp.CompanyId)?.Name ?? "Unknown";

            <div class="sub-card">
                <div class="exp-header d-flex justify-content-between align-items-center">
