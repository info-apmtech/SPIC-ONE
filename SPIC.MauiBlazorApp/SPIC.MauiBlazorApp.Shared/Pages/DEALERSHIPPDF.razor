<div class="dpdf-section">
    <div class="dpdf-section-title mb-2">
        <div class="dpdf-section-icon">🏭</div>   <div class="dpdf-section-text">Nearest Facility</div>
    </div>

    @{
        var facilities = new List<(string Name, double Distance, double Freight, string IconColor)>();

        if (_savedWarehouses != null)
        {
            foreach (var wh in _savedWarehouses)
            {
                var whName = _warehousesAll.FirstOrDefault(w => w.Id == wh.WarehouseId)?.Name ?? "Warehouse";
                facilities.Add((whName, wh.Distance, wh.Freight, "#059669"));
            }
        }
        if (_savedRails != null)
        {
            foreach (var rail in _savedRails)
            {
                var railName = _rackPointsAll.FirstOrDefault(r => r.Id == rail.RailFacilitiesId)?.Name ?? "Rail Head";
                facilities.Add((railName, rail.Distance, rail.Freight, "#2563eb"));
            }
        }
        if (_savedPorts != null)
        {
            foreach (var port in _savedPorts)
            {
                var portName = _portsAll.FirstOrDefault(p => p.Id == port.PortId)?.Name ?? "Port";
                facilities.Add((portName, port.Distance, port.Freight, "#db2777"));
            }
        }
    }

    @if (facilities.Any())
    {
        <table style="width: 100%; border-collapse: collapse; margin-bottom: 10px; font-size: var(--pdf-font-size);">
