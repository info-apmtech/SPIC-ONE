private decimal GetTotalFixedAssets()
{
    decimal bankTotal = _bankAssetsAll?.Sum(b => b.Value) ?? 0;
    decimal landTotal = _landAssetsAll?.Sum(l => l.PropertyValue) ?? 0;
    decimal buildingTotal = _buildingAssetsAll?.Sum(b => b.PropertyValue) ?? 0;
    return bankTotal + landTotal + buildingTotal;
}

private decimal GetTotalAssets()
{
    return GetTotalFixedAssets() + _model.AssetValue;
}

private decimal GetTotalLoans()
{
    return _loanLiabilitiesAll?.Sum(l => l.LoanValue) ?? 0;
}

private decimal GetNetFinancialPosition()
{
    return GetTotalAssets() - GetTotalLoans();
}
