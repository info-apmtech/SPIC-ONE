                <div class="section">
    <div class="section-title">
        <div class="section-icon">📉</div> Experience Details
    </div>

    @if (_experiences != null && _experiences.Any())
    {
        @foreach (var exp in _experiences)
        {
            var companyName = _companyAll
                .FirstOrDefault(c => c.Id.ToString() == exp.CompanyId)?.Name ?? "Unknown";

            <div class="sub-card">
                <div class="exp-header">
                    <h3>@companyName</h3>
                    <div class="exp-meta">
                        <span>@exp.NoOfYears Years</span>
                        <span class="badge-active">
                            @(exp.IsActive ? "Active" : "Inactive")
                        </span>
                    </div>
                </div>

                <div class="grid-3">
                    <div class="field">
                        <label>Experience</label>
                        <div class="value">@exp.NoOfYears Years</div>
                    </div>

                    <div class="field">
                        <label>Total Quantity</label>
                        <div class="value">@exp.Quantity.ToString("N0") MT</div>
                    </div>

                    <div class="field">
                        <label>Annual Turnover</label>
                        <div class="value">₹ @exp.TurnOver.ToString("N1") Lakhs</div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="value">No Experience Data Available</div>
    }
</div>
            
                <div class="section">
                    <div class="section-title">
                        <div class="section-icon">📊</div> Annual Sales Data
                    </div>
                    <table class="sales-table">
                        <thead>
                            <tr>
                                <th>Product Name</th>
                                <th style="text-align: center;">Own Retail Sales (MT)</th>
                                <th style="text-align: center;">Sales to Dealers (MT)</th>
                                <th style="text-align: center;">MT Total Values</th>
                            </tr>
                        </thead>
                        <tbody>
            @if (_annualSales != null && _annualSales.Any())
            {
                @foreach (var sale in _annualSales)
                {
                    var product = _productsAll.FirstOrDefault(p => p.Id == sale.ProductId);
                    var category = _categoriesAll.FirstOrDefault(c => c.Id == sale.CategoryId);

                    <tr>
                        <td>
                            @(product?.Name ?? "Unknown") 
                            <span class="product-desc">@(category?.Name ?? "")</span>
                        </td>
                        <td style="text-align: center;">@sale.OwnRetailsSaleQty.ToString("N2")</td>
                        <td style="text-align: center;">@sale.SaleToDealerQty.ToString("N2")</td>
                        <td style="text-align: center;">
                            @((sale.OwnRetailsSaleQty + sale.SaleToDealerQty).ToString("N2")) / 
                            ₹@((sale.OwnRetailsSaleAmount + sale.SaleToDealerAmount).ToString("N2"))
                        </td>
                    </tr>
                }
                <tr style="background-color: var(--card-bg);">
                    <td style="font-weight: bold; color: var(--primary-dark);">Grand Total</td>
                    <td style="text-align: center; font-weight: bold;">@_annualSales.Sum(s => s.OwnRetailsSaleQty).ToString("N2")</td>
                    <td style="text-align: center; font-weight: bold;">@_annualSales.Sum(s => s.SaleToDealerQty).ToString("N2")</td>
                    <td style="text-align: center; font-weight: bold; color: var(--primary-green);">
                        @_annualSales.Sum(s => s.OwnRetailsSaleQty + s.SaleToDealerQty).ToString("N2") / 
                        ₹@_annualSales.Sum(s => s.OwnRetailsSaleAmount + s.SaleToDealerAmount).ToString("N2")
                    </td>
                </tr>
            }
            else
            {
                <tr>
                    <td colspan="4" style="text-align: center; padding: 20px; color: var(--label-color);">No Annual Sales Data Available</td>
                </tr>
            }
        </tbody>
