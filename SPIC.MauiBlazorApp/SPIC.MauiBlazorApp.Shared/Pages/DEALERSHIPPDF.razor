@inject SPIC.MauiBlazorApp.Shared.Services.PlatformService Platform
@inject Microsoft.JSInterop.IJSRuntime JS
@inject NavigationManager NavManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dealership Application Form - Full</title>
    <style>
        :root {
            --primary-dark: #2c3e2d;
            --primary-green: #0a6b3d;
            --highlight-yellow: #f4d023;
            --dark-yellow: #b48600;
            --border-color: #e5e7eb;
            --label-color: #6b7280;
            --bg-color: #ffffff;
            --card-bg: #fefdf8;
        }

        /* make layout predictable and avoid scrollbars caused by padding/margins */
        * { box-sizing: border-box; }
        html, body, .document-container, .doc-body {
            height: auto !important;
            overflow: visible !important;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background-color: #333333;
            margin: 0;
            padding: 40px 20px;
        }

        .document-container {
            background-color: var(--bg-color);
            width: 100%;
            max-width: 850px;
            margin: 0 auto; /* Centers the document */
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
            position: relative;
        }

        /* Watermark */
        .document-container::before {
            content: "GREENSTAR";
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) rotate(-30deg);
            font-size: 12rem;
            color: rgba(244, 208, 35, 0.04);
            font-weight: bold;
            pointer-events: none;
            z-index: 0;
            white-space: nowrap;
        }

        /* Header Section */
        .doc-header {
            background-color: var(--primary-dark);
            color: white;
            padding: 30px 40px;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            position: relative;
            z-index: 1;
        }

        .logo {
            color: var(--highlight-yellow);
            font-weight: bold;
            font-size: 1.2rem;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .logo span {
            color: var(--primary-green);
            background: var(--highlight-yellow);
            border-radius: 50%;
            width: 24px;
            height: 24px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.8rem;
        }

        .header-content {
            text-align: center;
            flex-grow: 1;
            padding: 0 20px;
        }

        .header-content h1 {
            font-size: 1.1rem;
            margin: 0 0 15px 0;
            letter-spacing: 1px;
        }

        .header-content h2 {
            color: var(--highlight-yellow);
            font-size: 1.2rem;
            margin: 0 0 8px 0;
        }

        .header-content p {
            font-size: 0.85rem;
            margin: 0;
            color: #d1d5db;
        }

        .header-meta {
            text-align: right;
            font-size: 0.85rem;
            line-height: 1.5;
        }

        /* Form Body */
        .doc-body {
            padding: 30px 40px;
            position: relative;
            z-index: 1;
        }

        /* Section Styles */
        .section {
            margin-bottom: 25px;
            page-break-inside: avoid;
        }

        .section-title {
            background-color: var(--highlight-yellow);
            color: var(--primary-dark);
            font-weight: bold;
            padding: 8px 12px;
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 0.95rem;
            margin-bottom: 15px;
        }

        .section-icon {
            background-color: var(--primary-dark);
            color: white;
            width: 20px;
            height: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 3px;
            font-size: 0.7rem;
        }

        /* Grid Layouts */
        .grid-1 { display: grid; grid-template-columns: 1fr; gap: 15px; }
        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 15px 30px; }
        .grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 15px 20px; }

        /* Field Styles */
        .field {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .field label {
            font-size: 0.8rem;
            color: var(--label-color);
        }

        .field .value {
            border: 1px solid var(--border-color);
            padding: 8px 12px;
            font-size: 0.85rem;
            color: var(--primary-green);
            font-weight: 500;
            min-height: 18px;
            background-color: #fff;
        }

        /* Sub-cards */
        .sub-card {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 15px;
            page-break-inside: avoid;
        }

        .sub-card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
            padding-bottom: 10px;
            border-bottom: 1px solid #eee;
        }

        .sub-card-header h3 {
            margin: 0;
            font-size: 0.95rem;
            color: #374151;
        }

        .sub-card-title {
            font-size: 0.95rem;
            color: #374151;
            margin: 0 0 15px 0;
            font-weight: 600;
        }

        /* Table Styles */
        .sales-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.85rem;
            background: #fff;
            border: 1px solid var(--border-color);
            page-break-inside: avoid;
        }

        .sales-table th {
            text-align: left;
            padding: 12px;
            color: var(--label-color);
            font-weight: normal;
            border-bottom: 1px solid var(--border-color);
            background: var(--card-bg);
        }

        .sales-table td {
            padding: 12px;
            border-bottom: 1px solid var(--border-color);
            color: #374151;
        }

        .sales-table td:not(:first-child) {
            color: var(--primary-green);
            font-weight: bold;
            text-align: center;
        }
        
        .table-th-center th { text-align: center; }
        .table-th-center th:first-child { text-align: left; }

        .product-desc {
            font-size: 0.7rem;
            color: var(--label-color);
            margin-left: 5px;
            font-weight: normal;
        }

        /* Badges */
        .badge {
            padding: 4px 10px;
            border-radius: 4px;
            font-size: 0.7rem;
            font-weight: bold;
            text-transform: uppercase;
        }
        .badge-warehouse { background-color: #ecfdf5; color: #047857; }
        .badge-rail { background-color: #eff6ff; color: #1d4ed8; }
        .badge-port { background-color: #faf5ff; color: #7e22ce; }
        .badge-zone { background-color: #ffedd5; color: #c2410c; }
        .badge-active {
            background-color: #d1fae5;
            color: #047857;
            padding: 4px 12px;
            border-radius: 4px;
            font-weight: bold;
            font-size: 0.75rem;
        }

        /* Pill Tags */
        .pill-group {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .pill-tag {
            border: 1px solid #a7f3d0;
            color: #065f46;
            background: #f0fdf4;
            padding: 6px 12px;
            border-radius: 4px;
            font-size: 0.8rem;
            font-weight: 500;
        }

        /* Checkboxes */
        .group-title {
            color: var(--dark-yellow);
            font-weight: bold;
            font-size: 1rem;
            margin-bottom: 5px;
        }

        .checkbox-wrap {
            display: flex;
            gap: 20px;
            margin-top: 5px;
        }

        .checkbox-item {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 0.85rem;
            color: var(--label-color);
        }

        /* Experience Header */
        .exp-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
            padding-bottom: 10px;
            border-bottom: 1px solid #eee;
        }

        .exp-header h3 {
            margin: 0;
            font-size: 1rem;
            color: #374151;
        }

        .exp-meta {
            display: flex;
            align-items: center;
            gap: 15px;
            font-size: 0.8rem;
            color: var(--label-color);
        }

        /* Proprietor Layout */
        .proprietor-wrap {
            display: flex;
            gap: 20px;
        }

        .prop-fields {
            flex-grow: 1;
        }

        .prop-photo-box {
            width: 140px;
            height: 180px;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            overflow: hidden;
            background-color: #f3f4f6;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .prop-photo-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        
        /* Forecast Tables & Summary Bars */
        .summary-bar {
            background-color: #f8fafc;
            border-left: 4px solid var(--primary-dark);
            padding: 12px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-weight: bold;
            color: var(--primary-dark);
            margin-top: 15px;
            border-radius: 0 4px 4px 0;
            border-top: 1px solid var(--border-color);
            border-right: 1px solid var(--border-color);
            border-bottom: 1px solid var(--border-color);
        }

        .totals-wrapper {
            display: flex;
            justify-content: flex-end;
            margin-top: 15px;
        }

        .totals-box {
            display: flex;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            overflow: hidden;
            background-color: #f0fdf4;
        }

        .total-col {
            padding: 10px 25px;
            border-left: 1px solid var(--border-color);
            display: flex;
            flex-direction: column;
            align-items: flex-end;
        }

        .total-col:first-child { border-left: none; }
        .total-label { font-size: 0.75rem; color: var(--label-color); margin-bottom: 3px; }
        .total-val { font-weight: bold; color: var(--primary-dark); font-size: 0.95rem; }

        .stacked-val {
            display: block;
            color: var(--primary-green);
            font-weight: 600;
            font-size: 0.8rem;
            line-height: 1.4;
        }
        
        .stacked-val-alt {
            display: block;
            color: #059669;
            font-size: 0.8rem;
            line-height: 1.4;
        }

        .mt-15 { margin-top: 15px; }
        .mb-15 { margin-bottom: 15px; }

        /* Print Fixes for PDF */
        @@media print {
            body {
                background-color: white;
                padding: 0;
            }
            .document-container {
                box-shadow: none;
                max-width: 100%;
                width: 210mm !important; /* force A4 width in print */
                margin: 0 !important;
                overflow: visible !important;
            }
            .doc-body { overflow: visible !important; }
            html, body { width: 210mm !important; height: auto !important; overflow: visible !important; }
            @@page { size: A4 portrait; margin: 8mm; }
        }
    </style>
</head>
