<div class="dpdf-section">
    <div class="dpdf-section-title mb-2">
        <div class="dpdf-section-icon">📊</div>   <div class="dpdf-section-text">Annual Sales Data</div>
    </div>

    @if (_annualSales != null && _annualSales.Any() && _categoriesAll != null)
    {
        int annualCatIndex = 1;
        bool anyAnnualRendered = false;

        @foreach (var cat in _categoriesAll)
        {
            var catRows = _annualSales.Where(s => s.CategoryId == cat.Id).Where(s =>
            {
                var prod = _productsAll.FirstOrDefault(p => p.Id == s.ProductId);
                if (SelectedCompany == "SPIC")
                    return IsFertilizerCategory(cat) && IsUreaProduct(prod);
                if (SelectedCompany == "GreenStar")
                    return (IsFertilizerCategory(cat) && !IsUreaProduct(prod)) || IsSpecialityCategory(cat);
                return true; // no company → show all
            }).ToList();

            if (!catRows.Any()) continue;
            anyAnnualRendered = true;

            var catUnit = _unitsAll.FirstOrDefault(u => u.Id == cat.UnitId)?.Name ?? "MT";

            var catOwnRetailQty = catRows.Sum(s => s.OwnRetailsSaleQty);
            var catDealerQty    = catRows.Sum(s => s.SaleToDealerQty);
            var catTotalQty     = catRows.Sum(s => s.OwnRetailsSaleQty + s.SaleToDealerQty);
            var catTotalAmount  = catRows.Sum(s => s.OwnRetailsSaleAmount + s.SaleToDealerAmount);

            <div class="sub-card">
                <h3 class="sub-card-title">@annualCatIndex. @cat.Name Annual Sales (@catUnit / Value)</h3>

                <table class="sales-table">
                   <thead>
    <tr>
        <th>Product Name</th>
        <th>Group</th>
        <th style="text-align: center;">Own Retail Sales (@catUnit)</th>
        <th style="text-align: center;">Sales to Dealers (@catUnit)</th>
        <th style="text-align: center;">Total QTY (@catUnit)</th>
        <th style="text-align: center;">Total TO (₹) in Lakhs</th>
    </tr>
</thead>
<tbody>
    @foreach (var sale in catRows)
    {
        var product = _productsAll.FirstOrDefault(p => p.Id == sale.ProductId);
        var group = _productGroupsAll?.FirstOrDefault(g => g.Id == product?.ProductGroupId);
        <tr>
            <td>@(product?.Name ?? "Unknown")</td>
            <td>@(group?.Name ?? "-")</td>
            <td style="text-align: center;">@sale.OwnRetailsSaleQty.ToString("N2")</td>
            <td style="text-align: center;">@sale.SaleToDealerQty.ToString("N2")</td>
            <td style="text-align: center;">@((sale.OwnRetailsSaleQty + sale.SaleToDealerQty).ToString("N2"))</td>
            <td style="text-align: center;">₹@((sale.OwnRetailsSaleAmount + sale.SaleToDealerAmount).ToString("N2"))</td>
        </tr>
    }

    <tr style="background-color: var(--card-bg);">
        <td style="font-weight: bold; color: var(--primary-dark);">Total</td>
        <td></td>
        <td style="text-align: center; font-weight: bold;">@catOwnRetailQty.ToString("N2")</td>
        <td style="text-align: center; font-weight: bold;">@catDealerQty.ToString("N2")</td>
        <td style="text-align: center; font-weight: bold; color: var(--primary-green);">@catTotalQty.ToString("N2")</td>
        <td style="text-align: center; font-weight: bold; color: var(--primary-green);">₹@catTotalAmount.ToString("N2")</td>
    </tr>
</tbody>
                </table>

                <div class="totals-wrapper">
                    <div class="totals-box d-flex flex-wrap align-items-center" style="gap: 2rem; background-color: #F9FAFB; padding: 12px 16px; border-radius: 6px; border: 1px solid #E5E7EB; margin-top: 10px;">
                        <div class="total-col d-flex align-items-center" style="gap: 8px;">
                            <span class="total-label" style="color: #6B7280; font-weight: 500;">Grand Total Volume:</span>
                            <span class="total-val" style="color: #1F2937; font-weight: 700;">@catTotalQty.ToString("N2") @catUnit</span>
                        </div>
                        <div class="total-col d-flex align-items-center" style="gap: 8px;">
                            <span class="total-label" style="color: #6B7280; font-weight: 500;">Grand Total Value:</span>
                            <span class="total-val" style="color: #059669; font-weight: 700;">₹ @catTotalAmount.ToString("N2")</span>
                        </div>
                    </div>
                </div>
            </div>

            annualCatIndex++;
        }

        @if (!anyAnnualRendered)
        {
            <div class="value" style="padding: 20px; text-align: center; color: var(--label-color);">
                No Annual Sales Data Available
            </div>
        }
    }
    else
    {
        <div class="value" style="padding: 20px; text-align: center; color: var(--label-color);">
            No Annual Sales Data Available
        </div>
    }
</div>  
