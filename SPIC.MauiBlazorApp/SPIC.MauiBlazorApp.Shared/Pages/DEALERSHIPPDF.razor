private string GetSpicExperienceDisplay()
{
    if (!_model.DateOfAppointment.HasValue) return "-";

    var appointmentDate = _model.DateOfAppointment.Value;
    if (appointmentDate == default || appointmentDate > DateTime.Now) return "-";

    var today = DateTime.Now;
    var years = today.Year - appointmentDate.Year;
    var anniversaryThisYear = appointmentDate.AddYears(years);
    if (anniversaryThisYear > today)
    {
        years--;
        anniversaryThisYear = appointmentDate.AddYears(years);
    }
    var days = (int)(today - anniversaryThisYear).TotalDays;

    if (years == 0 && days == 0) return "-";
    if (years == 0) return $"{days} Days";
    if (days == 0) return $"{years} Years";
    return $"{years} Years {days} Days";
}
private double GetCreditPercentFromScore(double scorePercent) => scorePercent switch
{
    >= 75 => 25,
    >= 60 => 20,
    >= 45 => 15,
    >= 30 => 10,
    _ => 0
};

// Replicates the CreditLimit page: MO recommended = Proposed Limit + Additional Credit Limit
private decimal GetMoRecommendedLimit()
{
    if (SelectedCompany == "GreenStar")
    {
        var pct = GetCreditPercentFromScore(_proposal.GQ12Mark);

        // GreenStar page calculation:
        // GreenstarSalesTurnover = Fertilizer Sales Turnover with GFL + SP Turnover
        var greenstarSalesTurnover = GsPerfFertTurnover() + GsSpTurnover();

        var proposed = greenstarSalesTurnover * (decimal)(pct / 100.0);

        return proposed + _proposal.GreenstarAdditionalCreditLimit;
    }

    // SPIC page calculation:
    // SPIC uses only Urea Sales Turnover with SPIC
    var spicPct = GetCreditPercentFromScore(_proposal.Q11Mark);
    var spicProposed = SpicPerfUreaTurnover() * (decimal)(spicPct / 100.0);

    return spicProposed + _proposal.AdditionalCreditLimit;
}
