@code {
    [Parameter]
    public int? dealerId { get; set; }

    private DealerFormModel _model = new();
    private bool _isLoading = true;

    // Lookup data lists
    private List<LocationItemDto> _statesAll = new();
    private List<LocationItemDto> _DistrictAll = new();
    private List<LocationItemDto> _regionsAll = new();
    private List<LocationItemDto> _headquartersAll = new();
    private List<BankItemDto> _banksAll = new();
    private List<DealerItemDto> _dealersAll = new();

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        try
        {
            // Load lookups
            _statesAll = await Http.GetFromJsonAsync<List<LocationItemDto>>("api/State/all") ?? new();
            _DistrictAll = await Http.GetFromJsonAsync<List<LocationItemDto>>("api/District/all") ?? new();
            _regionsAll = await Http.GetFromJsonAsync<List<LocationItemDto>>("api/Region/all") ?? new();
            _headquartersAll = await Http.GetFromJsonAsync<List<LocationItemDto>>("api/Headquarter/all") ?? new();
            _banksAll = await Http.GetFromJsonAsync<List<BankItemDto>>("api/Bank/all") ?? new();
            _dealersAll = await Http.GetFromJsonAsync<List<DealerItemDto>>("api/DealerRegistration/all") ?? new();

            // Load main dealer
            if (dealerId.HasValue && dealerId.Value > 0)
            {
                var result = await Http.GetFromJsonAsync<DealerFormModel>($"api/DealerRegistration/{dealerId.Value}");
                if (result != null)
                {
                    _model = result;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading document: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Wait until Loading is finished before triggering the print
        if (!_isLoading)
        {
            try
            {
                if (NavManager.Uri != null && NavManager.Uri.Contains("print=true"))
                {
                    await JS.InvokeVoidAsync("triggerPrint");
                }
            }
            catch { }
        }
    }

    // Helper functions for displaying text instead of IDs
    private string GetSelectedCompany()
    {
        if (_model.InSpic && _model.InGreenStar) return "SPIC & GreenStar";
        if (_model.InSpic) return "SPIC";
        if (_model.InGreenStar) return "GreenStar";
        return "-";
    }

    private string GetStateName(int id) =>
    _statesAll.FirstOrDefault(x => x.Id == id)?.StateName ?? "-";
    private string GetDistrictName(int id) => _DistrictAll.FirstOrDefault(x => x.Id == id)?.DistrictName ?? "-";
    private string GetRegionName(int id) => _regionsAll.FirstOrDefault(x => x.Id == id)?.RegionName ?? "-";
    private string GetHqName(int id) => _headquartersAll.FirstOrDefault(x => x.Id == id)?.HeadquarterName ?? "-";
    private string GetBankName(int id) => _banksAll.FirstOrDefault(x => x.Id == id)?.Name ?? "-";
    private string GetDealerName(int id) => _dealersAll.FirstOrDefault(x => x.Id == id)?.FirmName ?? "-";

    private string GetStatusName(int status)
    {
        return status switch
        {
            0 => "Active",
            1 => "Inactive",
            2 => "Terminated",
            _ => "Unknown"
        };
    }

