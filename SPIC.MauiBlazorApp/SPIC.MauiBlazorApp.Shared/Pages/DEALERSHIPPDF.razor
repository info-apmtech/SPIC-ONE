@page "/DealershipPDF/{dealerId:int?}"
@layout SPIC.MauiBlazorApp.Shared.Layout.EmptyLayout
@using System.Net.Http.Json
@inject HttpClient Http
@inject SPIC.MauiBlazorApp.Shared.Services.PlatformService Platform
@inject Microsoft.JSInterop.IJSRuntime JS
@inject NavigationManager NavManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dealership Application Form - Full</title>
    <style>
        :root {
            --primary-dark: #2c3e2d;
            --primary-green: #0a6b3d;
            --highlight-yellow: #f4d023;
            --dark-yellow: #b48600;
            --border-color: #e5e7eb;
            --label-color: #6b7280;
            --bg-color: #ffffff;
            --card-bg: #fefdf8;
        }

        /* make layout predictable and avoid scrollbars caused by padding/margins */
        * { box-sizing: border-box; }
        html, body, .document-container, .doc-body {
            height: auto !important;
            overflow: visible !important;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background-color: #333333;
            margin: 0;
            padding: 40px 20px;
        }

        .document-container {
            background-color: var(--bg-color);
            width: 100%;
            max-width: 850px;
            margin: 0 auto; /* Centers the document */
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
            position: relative;
        }

        /* Watermark */
        .document-container::before {
            content: "GREENSTAR";
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) rotate(-30deg);
            font-size: 12rem;
            color: rgba(244, 208, 35, 0.04);
            font-weight: bold;
            pointer-events: none;
            z-index: 0;
            white-space: nowrap;
        }

        /* Header Section */
        .doc-header {
            background-color: var(--primary-dark);
            color: white;
            padding: 30px 40px;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            position: relative;
            z-index: 1;
        }

        .logo {
            color: var(--highlight-yellow);
            font-weight: bold;
            font-size: 1.2rem;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .logo span {
            color: var(--primary-green);
            background: var(--highlight-yellow);
            border-radius: 50%;
            width: 24px;
            height: 24px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.8rem;
        }

        .header-content {
            text-align: center;
            flex-grow: 1;
            padding: 0 20px;
        }

        .header-content h1 {
            font-size: 1.1rem;
            margin: 0 0 15px 0;
            letter-spacing: 1px;
        }

        .header-content h2 {
            color: var(--highlight-yellow);
            font-size: 1.2rem;
            margin: 0 0 8px 0;
        }

        .header-content p {
            font-size: 0.85rem;
            margin: 0;
            color: #d1d5db;
        }

        .header-meta {
            text-align: right;
            font-size: 0.85rem;
            line-height: 1.5;
        }

        /* Form Body */
        .doc-body {
            padding: 30px 40px;
            position: relative;
            z-index: 1;
        }

        /* Section Styles */
        .section {
            margin-bottom: 25px;
            page-break-inside: avoid;
        }

        .section-title {
            background-color: var(--highlight-yellow);
            color: var(--primary-dark);
            font-weight: bold;
            padding: 8px 12px;
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 0.95rem;
            margin-bottom: 15px;
        }

        .section-icon {
            background-color: var(--primary-dark);
            color: white;
            width: 20px;
            height: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 3px;
            font-size: 0.7rem;
        }

        /* Grid Layouts */
        .grid-1 { display: grid; grid-template-columns: 1fr; gap: 15px; }
        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 15px 30px; }
        .grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 15px 20px; }

        /* Field Styles */
        .field {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .field label {
            font-size: 0.8rem;
            color: var(--label-color);
        }

        .field .value {
            border: 1px solid var(--border-color);
            padding: 8px 12px;
            font-size: 0.85rem;
            color: var(--primary-green);
            font-weight: 500;
            min-height: 34px;
            background-color: #fff;
            word-break: break-word;
        }

        /* Sub-cards */
        .sub-card {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 15px;
            page-break-inside: avoid;
        }

        .sub-card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
            padding-bottom: 10px;
            border-bottom: 1px solid #eee;
        }

        .sub-card-header h3 {
            margin: 0;
            font-size: 0.95rem;
            color: #374151;
        }

        .sub-card-title {
            font-size: 0.95rem;
            color: #374151;
            margin: 0 0 15px 0;
            font-weight: 600;
        }

        /* Table Styles */
        .sales-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.85rem;
            background: #fff;
            border: 1px solid var(--border-color);
            page-break-inside: avoid;
        }

        .sales-table th {
            text-align: left;
            padding: 12px;
            color: var(--label-color);
            font-weight: normal;
            border-bottom: 1px solid var(--border-color);
            background: var(--card-bg);
        }

        .sales-table td {
            padding: 12px;
            border-bottom: 1px solid var(--border-color);
            color: #374151;
        }

        .sales-table td:not(:first-child) {
            color: var(--primary-green);
            font-weight: bold;
            text-align: center;
        }
        
        .table-th-center th { text-align: center; }
        .table-th-center th:first-child { text-align: left; }

        .product-desc {
            font-size: 0.7rem;
            color: var(--label-color);
            margin-left: 5px;
            font-weight: normal;
        }

        /* Badges & Pills */
        .badge {
            padding: 4px 10px;
            border-radius: 4px;
            font-size: 0.7rem;
            font-weight: bold;
            text-transform: uppercase;
        }
        .badge-warehouse { background-color: #ecfdf5; color: #047857; }
        .badge-rail { background-color: #eff6ff; color: #1d4ed8; }
        .badge-port { background-color: #faf5ff; color: #7e22ce; }
        .badge-zone { background-color: #ffedd5; color: #c2410c; }
        .badge-active {
            background-color: #d1fae5;
            color: #047857;
            padding: 4px 12px;
            border-radius: 4px;
            font-weight: bold;
            font-size: 0.75rem;
        }

        .pill-group { display: flex; flex-wrap: wrap; gap: 10px; }
        .pill-tag {
            border: 1px solid #a7f3d0;
            color: #065f46;
            background: #f0fdf4;
            padding: 6px 12px;
            border-radius: 4px;
            font-size: 0.8rem;
            font-weight: 500;
        }

        /* Checkboxes */
        .group-title {
            color: var(--dark-yellow);
            font-weight: bold;
            font-size: 1rem;
            margin-bottom: 5px;
        }
        .checkbox-wrap { display: flex; gap: 20px; margin-top: 5px; }
        .checkbox-item { display: flex; align-items: center; gap: 6px; font-size: 0.85rem; color: var(--label-color); }
        .checkbox-item input[type="checkbox"] { width: 16px; height: 16px; margin: 0; accent-color: var(--primary-green); }

        /* Experience Header */
        .exp-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
            padding-bottom: 10px;
            border-bottom: 1px solid #eee;
        }
        .exp-header h3 { margin: 0; font-size: 1rem; color: #374151; }
        .exp-meta { display: flex; align-items: center; gap: 15px; font-size: 0.8rem; color: var(--label-color); }

        /* Proprietor Layout */
        .proprietor-wrap { display: flex; gap: 20px; }
        .prop-fields { flex-grow: 1; }
        .prop-photo-box {
            width: 140px;
            height: 180px;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            overflow: hidden;
            background-color: #f3f4f6;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }
        .prop-photo-box img { width: 100%; height: 100%; object-fit: cover; }
        
        /* Forecast Tables & Summary Bars */
        .summary-bar {
            background-color: #f8fafc;
            border-left: 4px solid var(--primary-dark);
            padding: 12px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-weight: bold;
            color: var(--primary-dark);
            margin-top: 15px;
            border-radius: 0 4px 4px 0;
            border-top: 1px solid var(--border-color);
            border-right: 1px solid var(--border-color);
            border-bottom: 1px solid var(--border-color);
        }

        .totals-wrapper { display: flex; justify-content: flex-end; margin-top: 15px; }
        .totals-box {
            display: flex;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            overflow: hidden;
            background-color: #f0fdf4;
        }
        .total-col {
            padding: 10px 25px;
            border-left: 1px solid var(--border-color);
            display: flex;
            flex-direction: column;
            align-items: flex-end;
        }
        .total-col:first-child { border-left: none; }
        .total-label { font-size: 0.75rem; color: var(--label-color); margin-bottom: 3px; }
        .total-val { font-weight: bold; color: var(--primary-dark); font-size: 0.95rem; }

        .stacked-val { display: block; color: var(--primary-green); font-weight: 600; font-size: 0.8rem; line-height: 1.4; }
        .stacked-val-alt { display: block; color: #059669; font-size: 0.8rem; line-height: 1.4; }

        .mt-15 { margin-top: 15px; }
        .mb-15 { margin-bottom: 15px; }

        /* Print Fixes */
        @@media print {
            body { background-color: white; padding: 0; }
            .document-container {
                box-shadow: none;
                max-width: 100%;
                width: 210mm !important; /* force A4 width in print */
                margin: 0 !important;
                overflow: visible !important;
            }
            .doc-body { overflow: visible !important; }
            html, body { width: 210mm !important; height: auto !important; overflow: visible !important; }
            @@page { size: A4 portrait; margin: 8mm; }
        }
    </style>
</head>
<body>

    @if (_isLoading)
    {
        <div style="text-align:center; padding: 50px; color: white;">
            <h4>Loading Document Data...</h4>
        </div>
    }
    else
    {
        <div class="document-container">
            <header class="doc-header">
                <div class="logo">
                    <span>G</span> GREENSTAR
                </div>
                <div class="header-content">
                    <h1>DEALERSHIP APPLICATION FORM</h1>
                    <h2>GREENSTAR FERTILIZERS LIMITED</h2>
                    <p>Registered Office & Principal Office: 88 Mount Road, Guindy, Chennai - 600032.</p>
                </div>
                <div class="header-meta">
                    REF: @(_model.DealerCode ?? "DR-NEW")<br>
                    @DateTime.Now.ToString("dd MMMM yyyy")
                </div>
            </header>

            <div class="doc-body">
                
                <div class="section">
                    <div class="section-title">
                        <div class="section-icon">🏢</div> Company Details
                    </div>
                    <div class="grid-2">
                        <div class="field">
                            <label>Company Name</label>
                            <div class="value">@(_model.FirmName ?? "-")</div>
                        </div>
                        <div class="field">
                            <label>Selected Company</label>
                            <div class="value">@GetSelectedCompany()</div>
                        </div>
                        <div class="field">
                            <label>State</label>
                            <div class="value">@GetStateName(_model.StateId)</div>
                        </div>
                        <div class="field">
                            <label>Region</label>
                            <div class="value">@GetRegionName(_model.Region)</div>
                        </div>
                        <div class="field">
                            <label>HQ</label>
                            <div class="value">@GetHqName(_model.HQ)</div>
                        </div>
                        <div class="field">
                            <label>Status</label>
                            <div class="value">@GetStatusName(_model.Status)</div>
                        </div>
                    </div>
                </div>

                <div class="section">
                    <div class="section-title">
                        <div class="section-icon">📋</div> Status Details
                    </div>
                    <div class="grid-3">
                        <div class="field">
                            <label>Last Transaction Date</label>
                            <div class="value">@(_model.LastTransactionDate?.ToString("dd MMMM yyyy") ?? "-")</div>
                        </div>
                        <div class="field">
                            <label>Transaction Type</label>
                            <div class="value">@(_model.IsLastTransactionIsSale == true ? "Sales" : "Collection")</div>
                        </div>
                        <div class="field">
                            <label>Remarks</label>
                            <div class="value">@(_model.Remarks ?? "Pending Review")</div>
                        </div>
                    </div>
                </div>

                <div class="section">
                    <div class="section-title">
                        <div class="section-icon">💼</div> Business Information
                    </div>
                    <div class="grid-2">
                        <div class="field">
                            <label>Dealer Code & Name</label>
                            <div class="value">@_model.DealerCode - @_model.FirmName</div>
                        </div>
                        <div class="field">
                            <label>Parent Dealer</label>
                            <div class="value">@GetDealerName(_model.ParentDealer)</div>
                        </div>
                        <div class="field">
                            <label>Business Type</label>
                            <div class="value">@(_model.BusinessEntityType ?? "-")</div>
                        </div>
                        <div class="field">
                            <label>Firm Name (as per License / GST)</label>
                            <div class="value">@(_model.FirmName ?? "-")</div>
                        </div>
                        <div class="field">
                            <label>Date of Appointment</label>
                            <div class="value">@(_model.DateOfAppointment?.ToString("dd MMMM yyyy") ?? "-")</div>
                        </div>
                        <div class="field">
                            <label>Years of Association</label>
                            <div class="value">@(_model.YearsofExperiance > 0 ? $"{_model.YearsofExperiance} Years" : "-")</div>
                        </div>
                    </div>
                </div>

                <div class="section">
                    <div class="section-title">
                        <div class="section-icon">📍</div> Location Information
                    </div>
                    <div class="grid-2" style="margin-bottom: 15px;">
                        <div class="field">
                            <label>Map URL</label>
                            <div class="value">@(_model.GoogleMapURL ?? "-")</div>
                        </div>
                        <div class="field">
                            <label>Shop / Door / Block No</label>
                            <div class="value">@(_model.ShopNoORRoomNoOrBlockNo ?? "-")</div>
                        </div>
                        <div class="field">
                            <label>Street / Area / Locality</label>
                            <div class="value">@(_model.Street ?? "-")</div>
                        </div>
                        <div class="field">
                            <label>Pin Code</label>
                            <div class="value">@(_model.PinCode ?? "-")</div>
                        </div>
                        <div class="field">
                            <label>Sub Village</label>
                            <div class="value">@(_model.SubVillage ?? "-")</div>
                        </div>
                        <div class="field">
                            <label>Village</label>
                            <div class="value">@(_model.Village ?? "-")</div>
                        </div>
                        <div class="field">
                            <label>Taluk</label>
                            <div class="value">@(_model.Taluk ?? "-")</div>
                        </div>
                        <div class="field">
                            <label>District</label>
                            <div class="value">@GetDistrictName(_model.DistrictId)</div>
                        </div>
                    </div>
                    <div class="grid-3">
                        <div class="field">
                            <label>Official Number</label>
                            <div class="value">@(_model.OfficialContactNumber ?? "-")</div>
                        </div>
                        <div class="field">
                            <label>Whatsapp Number</label>
                            <div class="value">@(_model.WhatsAppNumber ?? "-")</div>
                        </div>
                        <div class="field">
                            <label>Alternative Number</label>
                            <div class="value">@(_model.AlternativeNumber ?? "-")</div>
                        </div>
                    </div>
                </div>

                <div class="section">
                    <div class="section-title">
                        <div class="section-icon">🏦</div> Bank Details
                    </div>
                    <div class="grid-2" style="margin-bottom: 15px;">
                        <div class="field">
                            <label>Account Holder Name</label>
                            <div class="value">@(_model.AccountHolderName ?? "-")</div>
                        </div>
                        <div class="field">
                            <label>Account Number</label>
                            <div class="value">@(_model.AccountNumber ?? "-")</div>
                        </div>
                        <div class="field">
                            <label>Bank Name</label>
                            <div class="value">@GetBankName(_model.BankId)</div>
                        </div>
                        <div class="field">
                            <label>Bank Branch</label>
                            <div class="value">@(_model.Branch ?? "-")</div>
                        </div>
                    </div>
                    <div class="grid-1">
                        <div class="field">
                            <label>IFSC Code</label>
                            <div class="value">@(_model.IFSC ?? "-")</div>
                        </div>
                    </div>
                </div>

                <div class="section">
                    <div class="section-title">
                        <div class="section-icon">🧾</div> Tax & Compliance
                    </div>
                    <div class="grid-3">
                        <div class="field">
                            <label>GST Details</label>
                            <div class="value">@(_model.GSTNumber ?? "-")</div>
                        </div>
                        <div class="field">
                            <label>PAN Details</label>
                            <div class="value">@(_model.PANNumber ?? "-")</div>
                        </div>
                        <div class="field">
                            <label>Aadhaar Details</label>
                            <div class="value">@(_model.AadhaarNumber ?? "-")</div>
                        </div>
                    </div>
                </div>

                <div class="section">
                    <div class="section-title">
                        <div class="section-icon">📄</div> Fertilizer License Details
                    </div>
                    <div class="sub-card">
                        <h3 class="sub-card-title">Wholesale Fertilizer License</h3>
                        <div class="grid-3">
                            <div class="field">
                                <label>License Number</label>
                                <div class="value">@(_model.WholeSaleFertilizerLicenseNumber ?? "-")</div>
                            </div>
                            <div class="field">
                                <label>Expiry Date</label>
                                <div class="value">@(_model.WholesaleLicenseExpiryDate?.ToString("dd MMMM yyyy") ?? "-")</div>
                            </div>
                            <div class="field">
                                <label>MFMS Code</label>
                                <div class="value">@(_model.WholesalemFMSCode ?? "-")</div>
                            </div>
                        </div>
                    </div>
                    <div class="sub-card">
                        <h3 class="sub-card-title">Retail Fertilizer Details</h3>
                        <div class="grid-3">
                            <div class="field">
                                <label>License Number</label>
                                <div class="value">@(_model.RetailFertilizerLicenseNumber ?? "-")</div>
                            </div>
                            <div class="field">
                                <label>Expiry Date</label>
                                <div class="value">@(_model.RetailLicenseExpiryDate?.ToString("dd MMMM yyyy") ?? "-")</div>
                            </div>
                            <div class="field">
                                <label>MFMS Code</label>
                                <div class="value">@(_model.RetailmFMSCode ?? "-")</div>
                            </div>
                        </div>
                    </div>
                    <div class="grid-2 mt-15">
                        <div>
                            <div class="group-title">Office Automation</div>
                            <div class="field">
                                <label>Do you have office automation?</label>
                                <div class="checkbox-wrap">
                                    <label class="checkbox-item"><input type="checkbox" checked="@(_model.IsOfficeAutomation == true)" disabled> Yes</label>
                                    <label class="checkbox-item"><input type="checkbox" checked="@(_model.IsOfficeAutomation == false)" disabled> No</label>
                                </div>
                            </div>
                        </div>
                        <div>
                            <div class="group-title">Enrollment Status</div>
                            <div class="field">
                                <label>Are You Enrolled in SDWA?</label>
                                <div class="checkbox-wrap">
                                    <label class="checkbox-item"><input type="checkbox" checked="@(_model.IsSDWA == true)" disabled> Yes</label>
                                    <label class="checkbox-item"><input type="checkbox" checked="@(_model.IsSDWA == false)" disabled> No</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="section">
                    <div class="section-title">
                        <div class="section-icon">📉</div> Experience Details
                    </div>
                    <div class="sub-card">
                        <div class="exp-header">
                            <h3>SPIC Fertilizers Limited</h3>
                            <div class="exp-meta">
                                <span>2015 - Present</span>
                                <span class="badge-active">Active</span>
                            </div>
                        </div>
                        <div class="grid-3">
                            <div class="field">
                                <label>Experience</label>
                                <div class="value">9 Years</div>
                            </div>
                            <div class="field">
                                <label>Total Quantity</label>
                                <div class="value">2,400 MT</div>
                            </div>
                            <div class="field">
                                <label>Annual Turnover</label>
                                <div class="value">₹ 148 Lakhs</div>
                            </div>
                        </div>
                    </div>
                    <div class="sub-card">
                        <div class="exp-header">
                            <h3>GreenStar Limited</h3>
                            <div class="exp-meta">
                                <span>2018 - Present</span>
                                <span class="badge-active">Active</span>
                            </div>
                        </div>
                        <div class="grid-3">
                            <div class="field">
                                <label>Experience</label>
                                <div class="value">6 Years</div>
                            </div>
                            <div class="field">
                                <label>Total Quantity</label>
                                <div class="value">1,200 MT</div>
                            </div>
                            <div class="field">
                                <label>Annual Turnover</label>
                                <div class="value">₹ 95 Lakhs</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="section">
                    <div class="section-title">
                        <div class="section-icon">📊</div> Annual Sales Data
                    </div>
                    <table class="sales-table">
                        <thead>
                            <tr>
                                <th>Product Name</th>
                                <th style="text-align: center;">Own Retail Sales (MT)</th>
                                <th style="text-align: center;">Sales to Dealers (MT)</th>
                                <th style="text-align: center;">MT Total Values</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>NC UREA <span class="product-desc">Nitrogen Fertilizer</span></td>
                                <td>124</td>
                                <td>14</td>
                                <td>136</td>
                            </tr>
                            <tr>
                                <td>DAP <span class="product-desc">18:46:0</span></td>
                                <td>124</td>
