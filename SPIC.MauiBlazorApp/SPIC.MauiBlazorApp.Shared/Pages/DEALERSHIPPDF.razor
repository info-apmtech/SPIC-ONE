@page "/DealershipPDF/{dealerId:int?}"
@layout SPIC.MauiBlazorApp.Shared.Layout.EmptyLayout
@using Microsoft.AspNetCore.Components
@using System.Net.Http.Json
@inject HttpClient Http
@inject SPIC.MauiBlazorApp.Shared.Services.PlatformService Platform
@inject Microsoft.JSInterop.IJSRuntime JS
@inject NavigationManager NavManager
@inject LoginState LoginState

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dealership Application Form - Full</title>
    
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
    
    <style>
                  :root {
                      --primary-dark: #2c3e2d;
                      --primary-green: #0a6b3d;
                      --highlight-yellow: #f4d023;
                      --dark-yellow: #b48600;
                      --border-color: #e5e7eb;
                      --label-color: #6b7280;
                      --bg-color: #ffffff;
                      --card-bg: #fefdf8;
                      --pdf-font-size: 12px; /* Uniform font size across the PDF */
                  }

                  * { box-sizing: border-box; }

                  html, body {
                      height: auto !important;
                      overflow-y: auto !important;
                      overflow-x: hidden;
                      background-color: #333333;
                      margin: 0;
                      padding: 0;
                      font-family: Arial, Helvetica, sans-serif;
                      font-size: var(--pdf-font-size);
                  }

                  .page-wrapper {
                      padding: 40px 20px;
                      display: flex;
                      flex-direction: column;
                      align-items: center;
                      min-height: 100vh;
                  }
                  
            /* 1. Pull the very first section ("Company Details") right up to the green header */
            .dpdf-body { 
                padding: 0px 40px 15px 40px !important; 
            }

            /* 2. Nuke the massive margins from mb-5 and mb-4 */
            .dpdf-container .mb-5, 
            .dpdf-container .mb-4 { 
                margin-bottom: 12px !important; 
            }

            /* 3. Tighten the mb-2 used on your section titles */
            .dpdf-container .mb-2 { 
                margin-bottom: 6px !important; 
            }

            /* 4. Completely remove the extra padding from pb-3 */
            .dpdf-container .pb-3 { 
                padding-bottom: 0px !important; 
            }
            .inline-field {
                display: flex;
                align-items: flex-start;
                gap: 12px; /* Space between the colon and the value */
            }

            .inline-field label {
                width: 140px; /* Fixed width for the label container */
                flex-shrink: 0;
                color: var(--label-color);
                font-size: var(--pdf-font-size);
                margin: 0;
                
                /* This forces the text to the left, and the colon to the right */
                display: flex;
                justify-content: space-between;
            }

            /* Automatically injects a perfectly aligned colon */
            .inline-field label::after {
                content: ":";
                margin-left: auto; /* Pushes the colon to the far right edge */
            }
            .inline-field .inline-val {
                color: var(--primary-green);
                font-weight: 500;
                font-size: var(--pdf-font-size);
                margin: 0;
                word-break: break-word;
            }
            /* Notice the '>' added here */
            .inline-field > label {
                width: 140px; 
                flex-shrink: 0;
                color: var(--label-color);
                font-size: var(--pdf-font-size);
                margin: 0;
                display: flex;
                justify-content: space-between;
            }

            /* Notice the '>' added here too */
            .inline-field > label::after {
                content: ":";
                margin-left: auto; 
            }
                  /* DealershipPDF — Valuation tables (SPIC & Greenstar) — scoped to this page only */
            .dpdf-valuation .table-wrapper,
            .dpdf-valuation .table-responsive {
                overflow: visible !important;
                max-height: none !important;
                width: 100%;
                border: none;
            }
            /* Forces no scrolling and auto-squeezes columns */
            .table-responsive {
                overflow-x: visible !important; 
            }
            
            /* Tighter padding and slightly smaller font to fit 10+ columns */
            .sales-table th, .sales-table td {
                padding: 6px 4px !important; 
                font-size: 10px !important; 
                vertical-align: middle;
            }

            /* Stacks the Quantity on top */
            .stacked-val {
                display: block; 
                font-weight: 600;
                color: #1f2937;
                white-space: nowrap;
                line-height: 1.2;
            }

            /* Stacks the Amount on the bottom */
            .stacked-val-alt {
                display: block; 
                font-size: 9px;
                color: #6b7280;
                white-space: nowrap;
                line-height: 1.2;
            }
            .dpdf-valuation .spic-table {
                width: 100%;
                table-layout: fixed;
                border-collapse: collapse;
                font-size: 9.5px;
                background: #fff;
            }

            .dpdf-valuation .spic-table th,
            .dpdf-valuation .spic-table td {
                padding: 4px 4px;
                border: 1px solid var(--border-color);
                word-wrap: break-word;
                overflow-wrap: anywhere;
                white-space: normal;
                vertical-align: middle;
                font-size: 9.5px;
                line-height: 1.25;
            }

            .dpdf-valuation .spic-table thead th {
                background: #F9FAFB;
                color: var(--label-color);
                font-weight: 600;
                text-align: center;
            }

            .dpdf-valuation .spic-table tfoot td {
                background: #F9FAFB;
                border-top: 2px solid var(--border-color);
                font-weight: 700;
                padding: 6px;
            }

            .dpdf-valuation .spic-table .table-val-box {
                padding: 3px 4px;
                border-radius: 3px;
                font-size: 9.5px;
                text-align: center;
                line-height: 1.2;
            }

            .dpdf-valuation .spic-table .text-muted {
                color: var(--label-color);
            }
                  .print-ui-layer {
                      position: fixed;
                      top: 20px;
                      right: 40px;
                      z-index: 9999;
                  }

                  .btn-print-action {
                      background-color: var(--highlight-yellow);
                      color: var(--primary-dark);
                      border: none;
                      padding: 12px 24px;
                      font-weight: bold;
                      border-radius: 4px;
                      cursor: pointer;
                      box-shadow: 0 4px 10px rgba(0,0,0,0.3);
                      display: flex;
                      align-items: center;
                      gap: 8px;
                      font-size: var(--pdf-font-size);
                  }

                  .btn-print-action:hover { background-color: #e2c110; }
                  .dpdf-container {
                background-color: var(--bg-color);
                width: 210mm;
                max-width: 850px;
                min-height: 297mm;
                height: auto;
                margin: 0 auto;
                box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
                position: relative;
            }

            .dpdf-container::before {
                content: "GREENSTAR";
                position: absolute;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%) rotate(-30deg);
                font-size: 12rem;
                color: rgba(244, 208, 35, 0.04);
                font-weight: bold;
                pointer-events: none;
                z-index: 0;
                white-space: nowrap;
            }

            .dpdf-header {
                background-color: var(--primary-dark);
                color: white;
                padding: 30px 40px;
                display: flex;
                justify-content: space-between;
                align-items: flex-start;
                position: relative;
                z-index: 1;
            }

            .dpdf-body { 
                padding: 10px 40px 20px 40px !important; 
                position: relative; 
                z-index: 1; 
            }

            .dpdf-body h1, .dpdf-body h2, .dpdf-body h3, .dpdf-body h4, .dpdf-body h5, .dpdf-body h6 {
                font-size: var(--pdf-font-size) !important;
                color: var(--primary-dark);
            }

            .dpdf-section { 
                margin-bottom: 10px !important; 
                page-break-inside: auto; 
                break-inside: auto;
            }

            .dpdf-section-title {
                display: flex;
                align-items: center;
                width: 100%;
                background-color: #f4d800;
                font-weight: 600;
                font-size: var(--pdf-font-size);
                height: 32px;
                page-break-after: avoid;
                break-after: avoid;
                margin-bottom: 8px !important; /* Forces tight spacing below the yellow bar */
            }

            .dpdf-section-icon {
                background-color: #1f3b2d;
                color: white;
                width: 32px;
                height: 100%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: var(--pdf-font-size);
            }

            .dpdf-section-text {
                padding: 0 10px;
                color: #1f3b2d;
            }
                  .document-container {
                      background-color: var(--bg-color);
                      width: 210mm; /* Fixed A4 Width */
                      max-width: 850px;
                      min-height: 297mm;
                      height: auto;
                      margin: 0 auto;
                      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
                      position: relative;
                  }

                  .document-container::before {
                      content: "GREENSTAR";
                      position: absolute;
                      top: 50%;
                      left: 50%;
                      transform: translate(-50%, -50%) rotate(-30deg);
                      font-size: 12rem;
                      color: rgba(244, 208, 35, 0.04);
                      font-weight: bold;
                      pointer-events: none;
                      z-index: 0;
                      white-space: nowrap;
                  }

                  .doc-header {
                      background-color: var(--primary-dark);
                      color: white;
                      padding: 30px 40px;
                      display: flex;
                      justify-content: space-between;
                      align-items: flex-start;
                      position: relative;
                      z-index: 1;
                  }

                  .logo {
                      color: var(--highlight-yellow);
                      font-weight: bold;
                      font-size: 1.2rem;
                      display: flex;
                      align-items: center;
                      gap: 10px;
                  }

                  .logo span {
                      color: var(--primary-green);
                      background: var(--highlight-yellow);
                      border-radius: 50%;
                      width: 24px;
                      height: 24px;
                      display: inline-flex;
                      align-items: center;
                      justify-content: center;
                      font-size: var(--pdf-font-size);
                  }

                  .header-content {
                      text-align: center;
                      flex-grow: 1;
                      padding: 0 20px;
                  }

                  .header-content h1 { font-size: 1.2rem; margin: 0 0 15px 0; letter-spacing: 1px; }
                  .header-content h2 { color: var(--highlight-yellow); font-size: 1.5rem; margin: 0 0 8px 0; }
                  .header-content p { font-size: var(--pdf-font-size); margin: 0; color: #d1d5db; }

                  .header-meta { text-align: right; font-size: var(--pdf-font-size); line-height: 1.5; }

                 /* REDUCED PADDING: Pulls the first section up closer to the dark green header */
                  .doc-body { padding: 10px 40px 20px 40px; position: relative; z-index: 1; }

                  /* Overrides external framework margins (like Bootstrap) to prevent massive gaps */
                  .doc-body .mb-4, .doc-body .mb-5 { margin-bottom: 12px !important; }
                  .doc-body .mb-2 { margin-bottom: 8px !important; }
                  .dpdf-mb { margin-bottom: 15px !important; }
                  /* Force ALL headings inside the doc body to exactly match our uniform font size */
                  .doc-body h1, .doc-body h2, .doc-body h3, .doc-body h4, .doc-body h5, .doc-body h6 {
                      font-size: var(--pdf-font-size) !important;
                      color: var(--primary-dark);
                  }
                  .sub-card-header h3, .exp-header h3 {
                      margin-bottom: 0 !important;
                      margin-top: 0 !important;
                  }
                  .sub-card-title {
                      font-size: var(--pdf-font-size) !important;
                      margin-bottom: 8px;
                      margin-top: 0;
                  }

                  /* REDUCED MARGIN: Tightens the space between every single section */
                  .section { margin-bottom: 12px; page-break-inside: auto; break-inside: auto;}
                .section-title {
                display: flex;
                align-items: center;
                width: 100%;
                background-color: #f4d800;
                font-weight: 600;
                font-size: var(--pdf-font-size);
                height: 32px;
                page-break-after: avoid;
                      break-after: avoid;
            }

            .section-icon {
                background-color: #1f3b2d;
                color: white;
                width: 32px;
                height: 100%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: var(--pdf-font-size);
            }

            .section-text {
                padding: 0 10px;
                color: #1f3b2d;
            }

                  .grid-1 { display: grid; grid-template-columns: 1fr; gap: 15px; }
                  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 15px 30px; }
                  .grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 15px 20px; }

                  .field { display: flex; flex-direction: column; gap: 5px; }
                  .field label { font-size: var(--pdf-font-size); color: var(--label-color); }
                  .field .value {
                      border: 1px solid var(--border-color);
                      padding: 8px 12px;
                      font-size: var(--pdf-font-size);
                      color: var(--primary-green);
                      font-weight: 500;
                      min-height: 34px;
                      background-color: #fff;
                      word-break: break-word;
                  }

                  .sub-card {
                      background-color: var(--card-bg);
                      border: 1px solid var(--border-color);
                      border-radius: 8px;
                      padding: 20px;
                      margin-bottom: 15px;
                      page-break-inside: avoid;
                  }

                  .sales-table {
                      width: 100%;
                      border-collapse: collapse;
                      font-size: var(--pdf-font-size);
                      background: #fff;
                      border: 1px solid var(--border-color);
                      page-break-inside: auto;
                  }

                  .sales-table th {
                      text-align: left;
                      padding: 12px;
                      color: var(--label-color);
                      font-weight: normal;
                      border-bottom: 1px solid var(--border-color);
                      background: var(--card-bg);
                  }

                  .sales-table td { padding: 12px; border-bottom: 1px solid var(--border-color); color: #374151; }

                  .summary-bar {
                      background-color: #f8fafc;
                      border-left: 4px solid var(--primary-dark);
                      padding: 12px 20px;
                      display: flex;
                      justify-content: space-between;
                      align-items: center;
                      font-weight: bold;
                      color: var(--primary-dark);
                      margin-top: 15px;
                      border-radius: 0 4px 4px 0;
                      border-top: 1px solid var(--border-color);
                      border-right: 1px solid var(--border-color);
                      border-bottom: 1px solid var(--border-color);
                      font-size: var(--pdf-font-size);
                  }

                @@media print {
                      body, html { 
                          background-color: white !important; 
                          overflow: visible !important; 
                          height: auto !important; 
                          font-size: var(--pdf-font-size) !important;
                          margin: 0 !important;
                          padding: 0 !important;
                      }
                      .print-ui-layer { display: none !important; }
                      .page-wrapper { padding: 0 !important; }
                      .enclosure-action-col { display: none !important; }

                      
                      /* 1. FORCE TITLE AND DOCUMENT TO STAY ON THE SAME PAGE */
                     .document-view-container {
                          border: none !important;
                          padding: 15mm 0 0 0 !important; 
                          page-break-inside: avoid !important; 
                          margin-bottom: 20px !important;
                      }
                      
                      /* 2. SQUEEZE BOTH PDFS AND REGULAR IMAGES TO FIT THE PAGE */
                      .pdf-render-target canvas,
                      .document-view-container img {
                          max-height: 225mm !important; 
                          max-width: 100% !important;
                          width: auto !important;
                          height: auto !important;
                          object-fit: contain !important;
                          box-shadow: none !important;
                      }
                      /* Apply print resets to BOTH container classes */
                      .dpdf-container, .document-container {
                          box-shadow: none !important;
                          margin: 0 !important;
                          padding: 0 !important;
                          width: 100% !important;
                          max-width: none !important;
                          min-height: auto !important;
                          border: none !important;
                      }
                      
                      .doc-body, .dpdf-body { overflow: visible !important; }
                      
                      /* Set margin to 0 to remove browser default print padding */
                      @@page { size: A4 portrait; margin: 0; }
                      
                      .dpdf-valuation .table-responsive {
                          overflow: visible !important;
                          width: 100% !important;
                      }

                      .dpdf-valuation .spic-table {
                          width: 100% !important;
                          font-size: var(--pdf-font-size) !important;
                      }
                      .dpdf-valuation .spic-table th,
                      .dpdf-valuation .spic-table td {
                          padding: 4px !important;
                      }

                      .table-val-box, .section-title, .section-icon {
                          -webkit-print-color-adjust: exact !important;
                          print-color-adjust: exact !important;
                      }
          
                      .form-card {
                          margin-bottom: 20px !important;
                          page-break-inside: auto !important;
                          break-inside: auto !important;
                      }
                  }
      
                  .partnerships-text {
                    background-color: #FACC15;
                    color: #374151;
                    display: flex;
                    align-items: center;
                    padding-left: 16px;
                    font-weight: 700;
                    font-size: var(--pdf-font-size);
                    flex-grow: 1;
                }

                .partnerships-pill-group {
                    display: flex;
                    flex-wrap: wrap;
                    gap: 12px;
                }

                .partnerships-pill-tag {
                    background-color: #F0FDF4;
                    border: 1px solid #86EFAC;
                    color: #065F46;
                    padding: 1px 3px;
                    border-radius: 6px;
                    font-size: var(--pdf-font-size);
                    font-weight: 600;
                    box-shadow: 0 1px 2px rgba(0,0,0,0.02);
                }

                .proprietor-wrap {
                    display: grid;
                    grid-template-columns: 1fr 150px;
                    gap: 18px;
                    align-items: start;
                }

                .prop-fields {
                    width: 100%;
                }

                .prop-photo-box {
     width: 100px;
     height: 100px;
     border: 1px solid var(--border-color);
     border-radius: 6px;
     overflow: hidden;
     background: #f8fafc;
}

.prop-photo-box img {
     width: 100%;
     height: 100%;
     object-fit: cover;
     display: block;
}
                .file-row {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 12px;
                width: 100%;
            }

            .file-name-text {
                color: #059669;
                font-weight: 500;
                word-break: break-word;
                flex: 1;
                min-width: 0;
            }

            .view-file-btn {
                display: inline-flex;
                align-items: center;
                gap: 5px;
                padding: 0 10px;
                height: 22px;
                border: 1px solid #d1d5db;
                border-radius: 4px;
                background: #ffffff;
                color: #1f2937;
                text-decoration: none;
                font-weight: 500;
                font-size: 11px;
                line-height: 1;
                white-space: nowrap;
                flex-shrink: 0;
            }

            .view-file-btn:hover {
                border-color: #9ca3af;
                background: #f9fafb;
            }

            .view-file-btn i {
                font-size: 14px;
                line-height: 1;
            }

            .view-file-btn .bi-file-earmark-pdf-fill   { color: #dc2626; }
            .view-file-btn .bi-file-earmark-image-fill { color: #2563eb; }
            .view-file-btn .bi-file-earmark-word-fill  { color: #1d4ed8; }
            .view-file-btn .bi-file-earmark-excel-fill { color: #16a34a; }
            .view-file-btn .bi-file-earmark-fill       { color: #6b7280; }

            @@media print {
                .view-file-btn { display: none; }
            }
            .uploaded-docs-list {
                list-style-type: none; padding-left: 0; margin-top: 8px; margin-bottom: 0;
            }
            .uploaded-docs-list li { margin-bottom: 6px; }
            
            /* PDF.js canvas styles */
           .pdf-render-target canvas {
                max-width: 100%;
                max-height: 220mm; /* CRITICAL: Forces the PDF to shrink enough to fit below the headers */
                width: auto !important;
                height: auto !important;
                object-fit: contain;
                display: block;
                margin: 0 auto 15px auto;
                box-shadow: 0 2px 5px rgba(0,0,0,0.1);
                border: 1px solid #d1d5db;
            }
    </style>

</head>
<body>

    @if (_isLoading)
    {
        <div style="text-align:center; padding: 50px; color: white;">
            <h4>Loading Document Data...</h4>
        </div>
    }
    else
    {
        <div class="dpdf-container">
            <header class="dpdf-header">
                @if (string.IsNullOrEmpty(SelectedCompany) || SelectedCompany == "SPIC")
                {
                    <div class="logo">
                        <img src="_content/SPIC.MauiBlazorApp.Shared/Images/LayoutImages/spiclogo.png" alt="SPIC" style="object-fit: contain;" />
                    </div>
                }
                else if (string.IsNullOrEmpty(SelectedCompany) || SelectedCompany == "GreenStar")
                {
                    <div class="logo">
                        <img src="_content/SPIC.MauiBlazorApp.Shared/Images/LayoutImages/greenstarlogo.png" alt="GreenStar" style="height: 45px; object-fit: contain;" />
                    </div>
                }

                <div class="header-content">
                    <h1>DEALERSHIP APPLICATION FORM</h1>
                    @if (string.IsNullOrEmpty(SelectedCompany) || SelectedCompany == "SPIC")
                    {
                        <h2>SOUTHERN PETROCHEMICAL INDUSTRIES CORPORATION</h2>
                    }
                    else if (string.IsNullOrEmpty(SelectedCompany) || SelectedCompany == "GreenStar")
                    {
                        <h2>GREENSTAR FERTILIZERS LIMITED</h2>
                    }
                    <p>Registered Office & Principal Office: 88 Mount Road, Guindy, Chennai - 600032.</p>
                </div>
               @*  <div class="header-meta">
                    REF: @(_model.DealerCode ?? "DR-NEW")<br>
                    @DateTime.Now.ToString("dd MMMM yyyy")
                </div> *@
            </header>

            <div class="dpdf-body">
                
<div class="dpdf-section">
    <div class="dpdf-section-title mb-2">
        <div class="dpdf-section-icon">🏢</div>
        <div class="dpdf-section-text">Dealer Details</div>
    </div>

    @{
        var companyPhotoPartner = _savedPartners?.FirstOrDefault(p => !string.IsNullOrWhiteSpace(p.ProprietorImagePath));
    }

    <div style="display: flex; gap: 18px; align-items: flex-start;">
        <div style="flex: 1; min-width: 0;">
            <div class="grid-2" style="row-gap: 12px;">
                <div class="inline-field">
                    <label>Dealer Name</label>
                    <div class="inline-val">@(_model.FirmName ?? "-")</div>
                </div>
                <div class="inline-field">
                    <label>State</label>
                    <div class="inline-val">@GetStateName(_model.StateId)</div>
                </div>
                <div class="inline-field">
                    <label>Region</label>
                    <div class="inline-val">@GetRegionName(_model.Region)</div>
                </div>
                <div class="inline-field">
                    <label>HQ</label>
                    <div class="inline-val">@GetHqName(_model.HQ)</div>
                </div>
            </div>
        </div>

        @if (companyPhotoPartner != null)
        {
            <div class="prop-photo-box">
                <img src="@GetFileUrl(companyPhotoPartner.ProprietorImagePath)"
                     alt="Proprietor Photo"
                     onerror="this.style.display='none';" />
            </div>
        }
    </div>
</div>
              <div class="dpdf-section">
                    <div class="dpdf-section-title mb-2">
                        <div class="dpdf-section-icon">💼</div> <div class="dpdf-section-text">Business Information</div>
                    </div>
                    <div class="grid-2" style="row-gap: 12px;">
                        <div class="inline-field">
                            <label>Dealer Code & Name</label>
                            <div class="inline-val">@_model.DealerCode - @_model.FirmName</div>
                        </div>
                        <div class="inline-field">
                            <label>Parent Dealer Code & Name</label>
                            <div class="inline-val">@GetDealerCodeAndName(_model.ParentDealer)</div>
                        </div>
