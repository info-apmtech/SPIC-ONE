<div class="section">
    <div class="section-title mb-2">
        <div class="section-icon">📊</div>  <div class="section-text">Sales Performance Review</div>
    </div>
    <table class="sales-table table-th-center">
        <thead>
            <tr>
                <th rowspan="2" style="vertical-align: bottom;">PRODUCT CATEGORY</th>
                <th colspan="2" style="border-bottom: 1px solid var(--border-color);">LAST FY</th>
                <th colspan="2" style="border-bottom: 1px solid var(--border-color);">CURRENT FY (TARGET)</th>
            </tr>
            <tr>
                <th style="background-color: #f8fafc;">Qty (MT)</th>
                <th style="background-color: #f8fafc;">Value (Lakh)</th>
                <th style="background-color: #f8fafc;">Qty (MT)</th>
                <th style="background-color: #f8fafc;">Value (Lakh)</th>
            </tr>
        </thead>
        <tbody>
            @if (_productsAll != null && _productsAll.Any() && (_annualSales.Any() || _salesPlanningAll.Any()))
            {
                // Grab all unique product IDs present in either the past year's data or this year's forecast
                var productIds = _annualSales.Select(a => a.ProductId)
                                    .Union(_salesPlanningAll.Select(s => s.ProductId))
                                    .Distinct()
                                    .ToList();

                @foreach (var pId in productIds)
                {
                    var product = _productsAll.FirstOrDefault(p => p.Id == pId);
                    
                    // --- 1. Calculate Last FY Data (From Annual Sales) ---
                    var lastFyData = _annualSales.Where(a => a.ProductId == pId).ToList();
                    var lastFyQty = lastFyData.Sum(a => a.OwnRetailsSaleQty + a.SaleToDealerQty);
                    var lastFyVal = lastFyData.Sum(a => a.OwnRetailsSaleAmount + a.SaleToDealerAmount);

                    // --- 2. Calculate Current FY Target (From Sales Planning) ---
                    var targetData = _salesPlanningAll.Where(s => s.ProductId == pId).ToList();
                    var targetQty = targetData.Sum(s => s.AprilQty + s.MayQty + s.JuneQty + s.JulyQty + 
                                                        s.AugustQty + s.SeptemberQty + s.OctoberQty + s.NovemberQty + 
                                                        s.DecemberQty + s.JanuaryQty + s.FebruaryQty + s.MarchQty);
                    var targetVal = targetData.Sum(s => s.AprilAmount + s.MayAmount + s.JuneAmount + s.JulyAmount + 
                                                        s.AugustAmount + s.SeptemberAmount + s.OctoberAmount + s.NovemberAmount + 
                                                        s.DecemberAmount + s.JanuaryAmount + s.FebruaryAmount + s.MarchAmount);

                    <tr>
                        <td>@(product?.Name ?? "Unknown")</td>
                        <td>@lastFyQty.ToString("N2")</td>
                        <td>@lastFyVal.ToString("N2")</td>
                        <td>@targetQty.ToString("N2")</td>
                        <td>@targetVal.ToString("N2")</td>
                    </tr>
                }

                <tr style="background-color: var(--card-bg); font-weight: bold;">
                    <td style="color: var(--primary-dark);">Grand Total</td>
                    <td>@_annualSales.Sum(a => a.OwnRetailsSaleQty + a.SaleToDealerQty).ToString("N2")</td>
                    <td>@_annualSales.Sum(a => a.OwnRetailsSaleAmount + a.SaleToDealerAmount).ToString("N2")</td>
                    <td>
                        @_salesPlanningAll.Sum(s => s.AprilQty + s.MayQty + s.JuneQty + s.JulyQty + s.AugustQty + s.SeptemberQty + s.OctoberQty + s.NovemberQty + s.DecemberQty + s.JanuaryQty + s.FebruaryQty + s.MarchQty).ToString("N2")
                    </td>
                    <td>
                        @_salesPlanningAll.Sum(s => s.AprilAmount + s.MayAmount + s.JuneAmount + s.JulyAmount + s.AugustAmount + s.SeptemberAmount + s.OctoberAmount + s.NovemberAmount + s.DecemberAmount + s.JanuaryAmount + s.FebruaryAmount + s.MarchAmount).ToString("N2")
                    </td>
                </tr>
            }
            else
            {
                <tr>
                    <td colspan="5" style="text-align: center; padding: 20px; color: var(--label-color);">No Sales Performance Data Available</td>
                </tr>
            }
        </tbody>
    </table>
</div>


