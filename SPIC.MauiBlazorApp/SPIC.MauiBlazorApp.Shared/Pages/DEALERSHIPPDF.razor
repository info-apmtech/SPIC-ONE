// FY columns in order (oldest -> newest), matching the CreditLimit page
// FY columns in order (oldest -> newest) — computed live, same logic as CreditLimit.razor,
// instead of trusting potentially-stale _proposal.FY1/FY2/FY3 values from the database.
private List<(int Id, string Name)> GetPerformanceYears()
{
    var today = DateTime.Today;
    int currentFyStartYear = today.Month >= 4 ? today.Year : today.Year - 1;

    var wantedStartYears = new[]
    {
        currentFyStartYear - 3,
        currentFyStartYear - 2,
        currentFyStartYear - 1
    };

    var matched = _financialYears
        .Where(fy => wantedStartYears.Contains(GetFyStartYear(fy)))
        .OrderBy(fy => GetFyStartYear(fy))
        .ToList();

    // Fallback: if naming/dates don't line up, take the 3 most recent FYs we have
    if (matched.Count == 0)
    {
        matched = _financialYears
            .OrderByDescending(fy => fy.EndDate)
            .ThenByDescending(fy => fy.Id)
            .Take(3)
            .OrderBy(fy => fy.EndDate)
            .ThenBy(fy => fy.Id)
            .ToList();
    }

    return matched.Select(fy => (fy.Id, fy.Name)).ToList();
}

// Derives the FY start year. Prefers StartDate, falls back to parsing the Name
// (handles "2023-24", "2023-2024", "FY 2023-24", "2023/24", etc.), then EndDate.
private int GetFyStartYear(FinancialYear fy)
{
    if (fy.StartDate != default && fy.StartDate.Year > 1)
        return fy.StartDate.Year;

    if (!string.IsNullOrWhiteSpace(fy.Name))
    {
        var match = System.Text.RegularExpressions.Regex.Match(fy.Name, @"(\d{4})");
        if (match.Success && int.TryParse(match.Groups[1].Value, out var y))
            return y;
    }

    if (fy.EndDate != default && fy.EndDate.Year > 1)
        return fy.EndDate.Month >= 4 ? fy.EndDate.Year : fy.EndDate.Year - 1;

    return 0;
}

private async Task LoadCreditLimitSalesData()
{
    _creditLimitSales = new();
    _creditSalesError = null; // Reset previous errors

    if (!dealerId.HasValue || dealerId.Value <= 0) return;

    var fyIds = GetPerformanceYears().Select(y => y.Id).Where(i => i > 0).ToList();
    if (fyIds.Count == 0) return;

    var fyQuery = string.Join(",", fyIds);

    var tasks = _categoriesAll.Select(cat =>
    {
        var url = $"api/creditlimitsales/by-filter" +
                  $"?customerId={dealerId.Value}" +
                  $"&categoryId={cat.Id}" +
                  $"&financialYearIds={fyQuery}";
        return SafeGetAsync<List<DealerCreditLimitSales>>(url);
    });

    var results = await Task.WhenAll(tasks);

    _creditLimitSales = results
        .Where(r => r != null)
        .SelectMany(r => r!)
        .ToList();
}
