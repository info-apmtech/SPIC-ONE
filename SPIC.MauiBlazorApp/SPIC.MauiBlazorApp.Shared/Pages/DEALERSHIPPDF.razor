private string GetEntityTypeName(int? entityType)
{
    if (!entityType.HasValue) return "-";
    return ((EntityType)entityType.Value) switch
    {
        EntityType.soleProprietor => "Sole Proprietor",
        EntityType.Partnership => "Partnership",
        EntityType.LLP => "LLP",
        EntityType.PvtLtd => "PVT LTD",
        EntityType.PubLtd => "PUB LTD",
        EntityType.Society => "Society",
        _ => "-"
    };
}
private decimal GetTotalFixedAssets()
{
    decimal bankTotal = _bankAssetsAll?.Sum(b => b.Value) ?? 0;
    decimal landTotal = _landAssetsAll?.Sum(l => l.PropertyValue) ?? 0;
    decimal buildingTotal = _buildingAssetsAll?.Sum(b => b.PropertyValue) ?? 0;
    return bankTotal + landTotal + buildingTotal;
}

private decimal GetTotalAssets()
{
    return GetTotalFixedAssets() + _model.AssetValue;
}

private decimal GetTotalLoans()
{
    return _loanLiabilitiesAll?.Sum(l => l.LoanValue) ?? 0;
}

private decimal GetNetFinancialPosition()
{
    return GetTotalAssets() - GetTotalLoans();
}
private string GetFileUrl(string? path)
{
    if (string.IsNullOrWhiteSpace(path)) return "";

    // Already absolute (http/https) — return as is
    if (path.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
        || path.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
    {
        return path;
    }

    var baseUrl = Http.BaseAddress?.ToString().TrimEnd('/') ?? "";
    var relative = path.TrimStart('/');
    return $"{baseUrl}/api/DealerFile/view/{relative}";
}
private string GetFileKindIcon(string? path)
{
    if (string.IsNullOrWhiteSpace(path)) return "bi-file-earmark";
    var ext = Path.GetExtension(path).ToLowerInvariant();
    return ext switch
    {
        ".pdf" => "bi-file-earmark-pdf-fill",
        ".jpg" or ".jpeg" or ".png" or ".gif" or ".webp" or ".bmp" => "bi-file-earmark-image-fill",
        ".doc" or ".docx" => "bi-file-earmark-word-fill",
        ".xls" or ".xlsx" => "bi-file-earmark-excel-fill",
        _ => "bi-file-earmark-fill"
    };
}

private string GetFileKindLabel(string? path)
{
    if (string.IsNullOrWhiteSpace(path)) return "View File";
    var ext = Path.GetExtension(path).ToLowerInvariant();
    return ext switch
    {
        ".pdf" => "View PDF",
        ".jpg" or ".jpeg" or ".png" or ".gif" or ".webp" or ".bmp" => "View Image",
        ".doc" or ".docx" => "View Doc",
        ".xls" or ".xlsx" => "View Excel",
        _ => "View File"
    };
}
