    // When opened with ?print=true this will prepare the page and call print()
    window.triggerPrint = function () {
        try {
            if (document.activeElement && typeof document.activeElement.blur === 'function') {
                document.activeElement.blur();
            }
            // ensure top of document is visible
            window.scrollTo(0, 0);
            // give browser time to repaint before print
            setTimeout(function () { window.print(); }, 700);
        }
        catch (e) { /* ignore */ }
    };
  </script>

