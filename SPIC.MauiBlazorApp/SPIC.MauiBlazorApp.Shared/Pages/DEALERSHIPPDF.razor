                <div class="section">
    <div class="section-title">
        <div class="section-icon">📈</div> Sales Planning & Forecast
    </div>

    @if (_salesPlanningAll != null && _salesPlanningAll.Any() && _categoriesAll != null)
    {
        int catIndex = 1;
        @foreach (var cat in _categoriesAll)
        {
            // Get all sales records for this specific category
            var catSales = _salesPlanningAll.Where(s => s.CategoryId == cat.Id).ToList();
            if (!catSales.Any()) continue; // Skip categories with no data

            var catUnit = _unitsAll.FirstOrDefault(u => u.Id == cat.UnitId)?.Name ?? "MT";
            
            // Calculate Grand Totals for the category
            var catTotalVolume = catSales.Sum(r => r.AprilQty + r.MayQty + r.JuneQty + r.JulyQty + r.AugustQty + r.SeptemberQty + r.OctoberQty + r.NovemberQty + r.DecemberQty + r.JanuaryQty + r.FebruaryQty + r.MarchQty);
            var catTotalValue = catSales.Sum(r => r.AprilAmount + r.MayAmount + r.JuneAmount + r.JulyAmount + r.AugustAmount + r.SeptemberAmount + r.OctoberAmount + r.NovemberAmount + r.DecemberAmount + r.JanuaryAmount + r.FebruaryAmount + r.MarchAmount);

            <div class="sub-card">
                <h3 class="sub-card-title">@catIndex. @cat.Name Sales Forecast (@catUnit / Value)</h3>
                
                <table class="sales-table table-th-center mb-15">
                    <thead>
                        <tr>
                            <th>PRODUCT</th>
                            <th>APR</th><th>MAY</th><th>JUN</th><th>JUL</th><th>AUG</th><th>SEP</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sale in catSales)
                        {
                            var product = _productsAll.FirstOrDefault(p => p.Id == sale.ProductId);
                            <tr>
                                <td>@(product?.Name ?? "Unknown")</td>
                                <td><span class="stacked-val">@sale.AprilQty.ToString("N0") @catUnit / ₹</span><span class="stacked-val-alt">@sale.AprilAmount.ToString("N0")</span></td>
                                <td><span class="stacked-val">@sale.MayQty.ToString("N0") @catUnit / ₹</span><span class="stacked-val-alt">@sale.MayAmount.ToString("N0")</span></td>
                                <td><span class="stacked-val">@sale.JuneQty.ToString("N0") @catUnit / ₹</span><span class="stacked-val-alt">@sale.JuneAmount.ToString("N0")</span></td>
                                <td><span class="stacked-val">@sale.JulyQty.ToString("N0") @catUnit / ₹</span><span class="stacked-val-alt">@sale.JulyAmount.ToString("N0")</span></td>
                                <td><span class="stacked-val">@sale.AugustQty.ToString("N0") @catUnit / ₹</span><span class="stacked-val-alt">@sale.AugustAmount.ToString("N0")</span></td>
                                <td><span class="stacked-val">@sale.SeptemberQty.ToString("N0") @catUnit / ₹</span><span class="stacked-val-alt">@sale.SeptemberAmount.ToString("N0")</span></td>
                            </tr>
                        }
                    </tbody>
                </table>

                <table class="sales-table table-th-center">
                    <thead>
                        <tr>
                            <th>PRODUCT</th>
                            <th>OCT</th><th>NOV</th><th>DEC</th><th>JAN</th><th>FEB</th><th>MAR</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sale in catSales)
                        {
                            var product = _productsAll.FirstOrDefault(p => p.Id == sale.ProductId);
                            <tr>
                                <td>@(product?.Name ?? "Unknown")</td>
                                <td><span class="stacked-val">@sale.OctoberQty.ToString("N0") @catUnit / ₹</span><span class="stacked-val-alt">@sale.OctoberAmount.ToString("N0")</span></td>
                                <td><span class="stacked-val">@sale.NovemberQty.ToString("N0") @catUnit / ₹</span><span class="stacked-val-alt">@sale.NovemberAmount.ToString("N0")</span></td>
                                <td><span class="stacked-val">@sale.DecemberQty.ToString("N0") @catUnit / ₹</span><span class="stacked-val-alt">@sale.DecemberAmount.ToString("N0")</span></td>
                                <td><span class="stacked-val">@sale.JanuaryQty.ToString("N0") @catUnit / ₹</span><span class="stacked-val-alt">@sale.JanuaryAmount.ToString("N0")</span></td>
                                <td><span class="stacked-val">@sale.FebruaryQty.ToString("N0") @catUnit / ₹</span><span class="stacked-val-alt">@sale.FebruaryAmount.ToString("N0")</span></td>
                                <td><span class="stacked-val">@sale.MarchQty.ToString("N0") @catUnit / ₹</span><span class="stacked-val-alt">@sale.MarchAmount.ToString("N0")</span></td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="totals-wrapper">
                    <div class="totals-box">
                        <div class="total-col">
                            <span class="total-label">Total Volume</span>
                            <span class="total-val">@catTotalVolume.ToString("N0") @catUnit</span>
                        </div>
                        <div class="total-col">
                            <span class="total-label">Total Forecast Value</span>
                            <span class="total-val">₹ @catTotalValue.ToString("N0")</span>
                        </div>
                    </div>
                </div>
            </div>
            
            catIndex++;
        }
    }
    else
    {
        <div class="value" style="padding: 20px; text-align: center; color: var(--label-color);">No Sales Planning Data Available</div>
    }
</div>

