@page "/DealershipPDF/{dealerId:int?}"
@* @implements IDisposable *@
@layout SPIC.MauiBlazorApp.Shared.Layout.EmptyLayout
@using Microsoft.AspNetCore.Components
@using System.Net.Http.Json
@inject HttpClient Http
@inject SPIC.MauiBlazorApp.Shared.Services.PlatformService Platform
@inject Microsoft.JSInterop.IJSRuntime JS
@inject NavigationManager NavManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dealership Application Form - Full</title>
 <style>
      :root {
          --primary-dark: #2c3e2d;
          --primary-green: #0a6b3d;
          --highlight-yellow: #f4d023;
          --dark-yellow: #b48600;
          --border-color: #e5e7eb;
          --label-color: #6b7280;
          --bg-color: #ffffff;
          --card-bg: #fefdf8;
      }

      * { box-sizing: border-box; }

      /* Fix: Allow natural scrolling on html and body with your original dark background */
      html, body {
          height: auto !important;
          overflow-y: auto !important;
          overflow-x: hidden;
          background-color: #333333; /* Original dark background restored */
          margin: 0;
          padding: 0;
          font-family: Arial, Helvetica, sans-serif;
      }

      /* The space around the document on screen */
      .page-wrapper {
          padding: 40px 20px;
          display: flex;
          flex-direction: column;
          align-items: center;
          min-height: 100vh;
      }

      /* Fixed Print Button UI - Stays top right regardless of scroll */
      .print-ui-layer {
          position: fixed;
          top: 20px;
          right: 40px;
          z-index: 9999;
      }

      .btn-print-action {
          background-color: var(--highlight-yellow);
          color: var(--primary-dark);
          border: none;
          padding: 12px 24px;
          font-weight: bold;
          border-radius: 4px;
          cursor: pointer;
          box-shadow: 0 4px 10px rgba(0,0,0,0.3);
          display: flex;
          align-items: center;
          gap: 8px;
      }

      .btn-print-action:hover { background-color: #e2c110; }

      /* The actual document design */
      .document-container {
          background-color: var(--bg-color);
          width: 210mm; /* Fixed A4 Width */
          max-width: 850px;
          min-height: 297mm; 
          height: auto; 
          margin: 0 auto;
          box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
          position: relative;
      }

      /* Watermark restored from old code */
      .document-container::before {
          content: "GREENSTAR";
          position: absolute;
          top: 50%;
          left: 50%;
          transform: translate(-50%, -50%) rotate(-30deg);
          font-size: 12rem;
          color: rgba(244, 208, 35, 0.04);
          font-weight: bold;
          pointer-events: none;
          z-index: 0;
          white-space: nowrap;
      }

      .doc-header {
          background-color: var(--primary-dark);
          color: white;
          padding: 30px 40px;
          display: flex;
          justify-content: space-between;
          align-items: flex-start;
          position: relative;
          z-index: 1;
      }

      .logo {
          color: var(--highlight-yellow);
          font-weight: bold;
          font-size: 1.2rem;
          display: flex;
          align-items: center;
          gap: 10px;
      }

      .logo span {
          color: var(--primary-green);
          background: var(--highlight-yellow);
          border-radius: 50%;
          width: 24px;
          height: 24px;
          display: inline-flex;
          align-items: center;
          justify-content: center;
          font-size: 0.8rem;
      }

      .header-content {
          text-align: center;
          flex-grow: 1;
          padding: 0 20px;
      }

      .header-content h1 { font-size: 1.1rem; margin: 0 0 15px 0; letter-spacing: 1px; }
      .header-content h2 { color: var(--highlight-yellow); font-size: 1.2rem; margin: 0 0 8px 0; }
      .header-content p { font-size: 0.85rem; margin: 0; color: #d1d5db; }

      .header-meta { text-align: right; font-size: 0.85rem; line-height: 1.5; }

      .doc-body { padding: 30px 40px; position: relative; z-index: 1; }

      .section { margin-bottom: 25px; page-break-inside: avoid; }

      .section-title {
          background-color: var(--highlight-yellow);
          color: var(--primary-dark);
          font-weight: bold;
          padding: 8px 12px;
          display: flex;
          align-items: center;
          gap: 10px;
          font-size: 0.95rem;
          margin-bottom: 15px;
      }

      .section-icon {
          background-color: var(--primary-dark);
          color: white;
          width: 20px;
          height: 20px;
          display: flex;
          align-items: center;
          justify-content: center;
          border-radius: 3px;
          font-size: 0.7rem;
      }

      .grid-1 { display: grid; grid-template-columns: 1fr; gap: 15px; }
      .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 15px 30px; }
      .grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 15px 20px; }

      .field { display: flex; flex-direction: column; gap: 5px; }
      .field label { font-size: 0.8rem; color: var(--label-color); }
      .field .value { 
          border: 1px solid var(--border-color); 
          padding: 8px 12px; 
          font-size: 0.85rem; 
          color: var(--primary-green); 
          font-weight: 500; 
          min-height: 34px; 
          background-color: #fff; 
          word-break: break-word;
      }

      .sub-card {
          background-color: var(--card-bg);
          border: 1px solid var(--border-color);
          border-radius: 8px;
          padding: 20px;
          margin-bottom: 15px;
          page-break-inside: avoid;
      }

      .sales-table {
          width: 100%;
          border-collapse: collapse;
          font-size: 0.85rem;
          background: #fff;
          border: 1px solid var(--border-color);
          page-break-inside: avoid;
      }

      .sales-table th {
          text-align: left;
          padding: 12px;
          color: var(--label-color);
          font-weight: normal;
          border-bottom: 1px solid var(--border-color);
          background: var(--card-bg);
      }

      .sales-table td { padding: 12px; border-bottom: 1px solid var(--border-color); color: #374151; }

      .summary-bar {
          background-color: #f8fafc;
          border-left: 4px solid var(--primary-dark);
          padding: 12px 20px;
          display: flex;
          justify-content: space-between;
          align-items: center;
          font-weight: bold;
          color: var(--primary-dark);
          margin-top: 15px;
          border-radius: 0 4px 4px 0;
          border-top: 1px solid var(--border-color);
          border-right: 1px solid var(--border-color);
          border-bottom: 1px solid var(--border-color);
      }

      /* PRINT LOGIC */
      @@media print {
          body, html { background-color: white !important; overflow: visible !important; height: auto !important; }
          .print-ui-layer { display: none !important; }
          .page-wrapper { padding: 0 !important; }
          .document-container { 
              box-shadow: none !important; 
              margin: 0 !important; 
              width: 100% !important;
              max-width: none !important;
          }
          .doc-body { overflow: visible !important; }
          @@page { size: A4 portrait; margin: 8mm; }
      }
  </style>

</head>
