@page "/PageManagement"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components
@using DR = SPIC.Core.Entities
@inject HttpClient Http
@inject LoginState LoginState

@code {
    private List<DR.ApplicationPage> _pages = new();
    private List<DR.ApplicationPage> _filtered = new();
    private DR.ApplicationPage _model = new() { Key = "", Name = "", IsActive = true, HasActions = true };

    private bool _isEditMode;
    private bool _isSaving;
    private string _searchText = "";
    private string _statusFilter = "All";
    private string? _message;
    private bool _isError;

    // Deactivate modal
    private bool _showDeleteModal;
    private int _deleteId;
    private string _deleteName = "";

    private ElementReference _firstInputRef;

    protected override async Task OnInitializedAsync()
    {
        await LoadPages();
    }

    private async Task LoadPages()
    {
        try
        {
            _pages = await Http.GetFromJsonAsync<List<DR.ApplicationPage>>("api/PageManagement/all") ?? new List<DR.ApplicationPage>();
            _pages.Sort((a, b) => a.SortOrder.CompareTo(b.SortOrder));
            ApplyFilter();
        }
        catch (Exception ex)
        {
            ShowMessage($"Failed to load pages: {ex.Message}", true);
        }
    }

    private int TotalCount => _pages.Count;
    private int ActiveCount => _pages.Count(p => p.IsActive);
    private int InactiveCount => _pages.Count(p => !p.IsActive);

    private void ApplyFilter()
    {
        var q = _searchText?.Trim() ?? "";
        _filtered = _pages
            .Where(p =>
                (string.IsNullOrEmpty(q) ||
                 (p.Key?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                 (p.Name?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                 (p.Module?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)) &&
                (_statusFilter == "All" ||
                 (_statusFilter == "Active" && p.IsActive) ||
                 (_statusFilter == "Inactive" && !p.IsActive)))
            .ToList();
    }

    private void StartAdd()
    {
        ResetForm();
        _ = _firstInputRef.FocusAsync();
    }

    private void EditPage(DR.ApplicationPage page)
    {
        _isEditMode = true;
        _model = new DR.ApplicationPage
        {
            Id = page.Id,
            Key = page.Key,
            Name = page.Name,
            Module = page.Module,
            SortOrder = page.SortOrder,
            HasActions = page.HasActions,
            IsActive = page.IsActive,
            CreatedBy = page.CreatedBy,
            CreatedAt = page.CreatedAt
        };
        _message = null;
        _isError = false;
        _ = _firstInputRef.FocusAsync();
    }

    private void ResetForm()
    {
        _isEditMode = false;
        _model = new DR.ApplicationPage
        {
            Key = "",
            Name = "",
            Module = null,
            SortOrder = _pages.Count > 0 ? _pages.Max(p => p.SortOrder) + 1 : 1,
            HasActions = true,
            IsActive = true
        };
        _message = null;
        _isError = false;
    }

    private async Task SavePage()
    {
        _isSaving = true;
        try
        {
            var savedKey = _model.Key ?? "";

            if (_isEditMode && _model.Id > 0)
            {
                _model.UpdatedBy = LoginState.UserId ?? "System";
                _model.UpdatedAt = DateTime.Now;
                var response = await Http.PutAsJsonAsync($"api/PageManagement/{_model.Id}", _model);
                if (response.IsSuccessStatusCode)
                {
                    ResetForm();
                    ShowMessage($"'{savedKey}' updated successfully", false);
                }
                else
                {
                    ShowMessage($"Failed to update: {await response.Content.ReadAsStringAsync()}", true);
                    return;
                }
            }
            else
            {
                _model.CreatedBy = LoginState.UserId ?? "System";
                _model.CreatedAt = DateTime.Now;
                var response = await Http.PostAsJsonAsync("api/PageManagement", _model);
                if (response.IsSuccessStatusCode)
                {
                    ResetForm();
                    ShowMessage($"'{savedKey}' saved successfully", false);
                }
                else
                {
                    ShowMessage($"Failed to save: {await response.Content.ReadAsStringAsync()}", true);
                    return;
                }
            }

            await LoadPages();
        }
        catch (Exception ex)
        {
            ShowMessage($"Error: {ex.Message}", true);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void OpenDeleteModal(DR.ApplicationPage page)
    {
        _deleteId = page.Id;
        _deleteName = string.IsNullOrWhiteSpace(page.Name) ? page.Key : page.Name;
        _showDeleteModal = true;
    }

    private void CancelDelete()
    {
        _showDeleteModal = false;
        _deleteId = 0;
        _deleteName = "";
    }

    // Pages are never hard-deleted (DesignationPermission has a Restrict FK to Pages.Id).
    // Deactivate instead, exactly like the Designation master.
    private async Task ConfirmDelete()
    {
        var target = _pages.FirstOrDefault(x => x.Id == _deleteId);
        if (target == null) { CancelDelete(); return; }

        try
        {
            target.IsActive = false;
            var response = await Http.PutAsJsonAsync($"api/PageManagement/{target.Id}", target);
            if (response.IsSuccessStatusCode)
            {
                ShowMessage($"'{_deleteName}' deactivated successfully", false);
                if (_model.Id == _deleteId) ResetForm();
                await LoadPages();
            }
            else
            {
                target.IsActive = true;
                ShowMessage($"Failed to deactivate: {await response.Content.ReadAsStringAsync()}", true);
            }
        }
        catch (Exception ex)
        {
            ShowMessage($"Failed to deactivate: {ex.Message}", true);
        }
        finally
        {
            CancelDelete();
        }
    }

    private async Task ReactivatePage(DR.ApplicationPage page)
    {
        try
        {
            page.IsActive = true;
            var response = await Http.PutAsJsonAsync($"api/PageManagement/{page.Id}", page);
            if (response.IsSuccessStatusCode)
                ShowMessage($"'{page.Name}' activated successfully", false);
            else
            {
                page.IsActive = false;
                ShowMessage($"Failed to activate: {await response.Content.ReadAsStringAsync()}", true);
            }
            await LoadPages();
        }
        catch (Exception ex)
        {
            ShowMessage($"Failed to activate: {ex.Message}", true);
        }
    }

    private void ShowMessage(string message, bool isError)
    {
        _message = message;
        _isError = isError;
    }
}

<style>
    .desig-page-title { color: #1F2937; font-weight: 700; font-size: 1.4rem; margin: 24px 0; }

    /* --- Add / Edit Card --- */
    .desig-form-card { background: #fff; border: 1px solid #E5E7EB; border-radius: 14px; padding: 24px; margin-bottom: 24px; box-shadow: 0 1px 3px rgba(0,0,0,.04); }
    .desig-form-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
    .desig-form-title { font-size: 1.05rem; font-weight: 700; color: #1F2937; margin: 0; }
    .desig-form-row { display: flex; gap: 16px; flex-wrap: wrap; align-items: flex-end; margin-bottom: 20px; }
    .desig-field { display: flex; flex-direction: column; }
    .desig-field label { font-size: 0.78rem; font-weight: 600; color: #374151; margin-bottom: 6px; }
    .desig-field input[type="text"] { width: 280px; max-width: 100%; padding: 9px 12px; border: 1px solid #E5E7EB; border-radius: 8px; background: #F9FAFB; font-size: 0.85rem; color: #1F2937; outline: none; transition: border-color .2s; }
    .desig-field input[type="text"]:focus { border-color: #059669; background: #fff; box-shadow: 0 0 0 2px rgba(5,150,105,.1); }
    .desig-field input[type="number"] { width: 100px; padding: 9px 12px; border: 1px solid #E5E7EB; border-radius: 8px; background: #F9FAFB; font-size: 0.85rem; color: #1F2937; outline: none; }
    .desig-field input:disabled, .desig-field input[readonly] { background: #F3F4F6; color: #6B7280; cursor: not-allowed; }
    .desig-hint { font-size: 0.7rem; color: #9CA3AF; margin-top: 4px; }
    .desig-check-field { display: flex; align-items: center; gap: 8px; padding-bottom: 10px; font-size: 0.82rem; font-weight: 600; color: #374151; }
    .desig-check-field input[type="checkbox"] { accent-color: #059669; width: 16px; height: 16px; cursor: pointer; }

    /* Active toggle pill */
    .desig-toggle-pill { display: flex; align-items: center; gap: 10px; background: #ECFDF5; border: 1px solid #D1FAE5; border-radius: 10px; padding: 9px 16px; cursor: pointer; user-select: none; }
    .desig-toggle-pill.inactive { background: #F3F4F6; border-color: #E5E7EB; }
    .desig-toggle-label { font-size: 0.85rem; font-weight: 600; color: #065F46; }
    .desig-toggle-pill.inactive .desig-toggle-label { color: #6B7280; }
    .desig-switch { position: relative; width: 42px; height: 22px; background: #22C55E; border-radius: 22px; transition: background .2s; flex-shrink: 0; }
    .desig-toggle-pill.inactive .desig-switch { background: #D1D5DB; }
    .desig-switch::after { content: ''; position: absolute; top: 2px; left: 22px; width: 18px; height: 18px; border-radius: 50%; background: #fff; transition: left .2s; box-shadow: 0 1px 2px rgba(0,0,0,.2); }
    .desig-toggle-pill.inactive .desig-switch::after { left: 2px; }

    /* Form buttons */
    .desig-form-actions { display: flex; justify-content: flex-end; gap: 12px; }
    .desig-btn { display: inline-flex; align-items: center; gap: 6px; padding: 9px 20px; border-radius: 8px; font-size: 0.85rem; font-weight: 600; cursor: pointer; transition: .2s; border: 1px solid transparent; }
    .desig-btn-cancel { background: #fff; border-color: #D1D5DB; color: #4B5563; }
    .desig-btn-cancel:hover { background: #F9FAFB; }
    .desig-btn-save { background: #2563EB; color: #fff; }
    .desig-btn-save:hover { background: #1D4ED8; }
    .desig-btn-save:disabled { opacity: .6; cursor: not-allowed; }

    /* --- Stat Cards --- */
    .desig-stats-row { display: flex; gap: 16px; margin-bottom: 24px; flex-wrap: wrap; }
    .desig-stat-card { flex: 1; min-width: 220px; border: 1px solid #E5E7EB; border-radius: 12px; padding: 18px 20px; }
    .desig-stat-card.total { background: linear-gradient(135deg, #EEF2FF, #F8FAFF); }
    .desig-stat-card.active { background: linear-gradient(135deg, #ECFDF5, #F0FDFA); }
    .desig-stat-card.inactive { background: #F3F4F6; }
    .desig-stat-label { font-size: 0.82rem; color: #6B7280; font-weight: 600; margin-bottom: 8px; }
    .desig-stat-value { font-size: 1.5rem; font-weight: 700; color: #1F2937; }

    /* --- List Card --- */
    .desig-list-card { background: #fff; border: 1px solid #E5E7EB; border-radius: 14px; padding: 24px; box-shadow: 0 1px 3px rgba(0,0,0,.04); margin-bottom: 40px; }
    .desig-list-header { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }
    .desig-list-title { font-size: 1.05rem; font-weight: 700; color: #1F2937; margin: 0; }
    .desig-list-tools { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
    .desig-search { padding: 8px 12px; border: 1px solid #E5E7EB; border-radius: 8px; background: #F9FAFB; font-size: 0.8rem; outline: none; min-width: 200px; }
    .desig-search:focus { border-color: #059669; background: #fff; }
    .desig-status-select { padding: 8px 12px; border: 1px solid #E5E7EB; border-radius: 8px; background: #fff; font-size: 0.8rem; outline: none; cursor: pointer; }

    .desig-table { width: 100%; border-collapse: collapse; text-align: center; }
    .desig-table th { background: #F8FAFC; color: #374151; font-weight: 600; font-size: 0.78rem; padding: 12px 14px; border-bottom: 1px solid #E5E7EB; }
    .desig-table td { padding: 13px 14px; font-size: 0.8rem; color: #4B5563; border-bottom: 1px solid #F3F4F6; }
    .desig-table tr:last-child td { border-bottom: none; }
    .pm-cell-left { text-align: left !important; }
    .pm-key-cell { font-weight: 600; color: #1F2937; font-family: Consolas, monospace; }
    .pm-muted { color: #9CA3AF !important; }

    .desig-badge { display: inline-block; padding: 4px 14px; border-radius: 6px; font-size: 0.72rem; font-weight: 600; }
    .desig-badge-active { background: #059669; color: #fff; }
    .desig-badge-inactive { background: #E5E7EB; color: #6B7280; }

    .desig-action-icons { display: flex; gap: 14px; justify-content: center; }
    .desig-action-icons i { font-size: 1rem; cursor: pointer; }
    .desig-icon-edit { color: #2563EB; }
    .desig-icon-delete { color: #DC2626; }
    .desig-icon-restore { color: #059669; }

    /* --- Deactivate Modal --- */
    .desig-modal-backdrop { position: fixed; inset: 0; background: rgba(0,0,0,.4); display: flex; align-items: center; justify-content: center; z-index: 1055; padding: 1rem; }
    .desig-modal { background: #fff; border-radius: 12px; padding: 28px; max-width: 420px; width: 100%; text-align: center; box-shadow: 0 8px 24px rgba(0,0,0,.15); }
    .desig-modal-icon { width: 56px; height: 56px; border-radius: 50%; background: #FEE2E2; color: #DC2626; font-size: 1.5rem; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; }
    .desig-modal-title { font-size: 1.1rem; font-weight: 700; color: #1F2937; margin-bottom: 8px; }
    .desig-modal-body { font-size: 0.85rem; color: #6B7280; margin-bottom: 4px; }
    .desig-modal-warning { font-size: 0.78rem; color: #DC2626; font-weight: 600; margin-bottom: 20px; }
    .desig-modal-actions { display: flex; gap: 12px; justify-content: center; }
    .desig-btn-delete { background: #DC2626; color: #fff; }
    .desig-btn-delete:hover { background: #B91C1C; }
</style>

<div class="container-fluid py-2 px-0">

    <h1 class="desig-page-title">Page Management</h1>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert @(_isError ? "alert-danger" : "alert-success") alert-dismissible fade show mb-3" role="alert">
            @_message
            <button type="button" class="btn-close" @onclick='() => _message = null'></button>
        </div>
    }

    <!-- ============ Add / Edit Page ============ -->
    <div class="desig-form-card">
        <div class="desig-form-header">
            <h3 class="desig-form-title">@(_isEditMode ? $"Edit Page — {_model.Key}" : "Add New Page")</h3>
        </div>

        <div class="desig-form-row">
            <div class="desig-field">
                <label>Page Key (permission code)</label>
                <input type="text" @bind="_model.Key" placeholder="e.g. NewFeatureRegister" maxlength="80" disabled="@_isEditMode" @ref="_firstInputRef" />
                <span class="desig-hint">Cannot be changed after creation</span>
            </div>

            <div class="desig-field">
                <label>Page Name</label>
                <input type="text" @bind="_model.Name" placeholder="Display name" maxlength="100" />
            </div>

            <div class="desig-field">
                <label>Module</label>
                <input type="text" @bind="_model.Module" placeholder="Optional grouping" maxlength="100" />
            </div>

            <div class="desig-field">
                <label>Sort Order</label>
                <input type="number" @bind="_model.SortOrder" min="1" />
            </div>

            <div class="desig-field">
                <label></label>
                <label class="desig-check-field">
                    <input type="checkbox" @bind="_model.HasActions" />
                    Has View/Entry/Update/Delete actions
                </label>
            </div>
        </div>

        <div class="desig-form-row">
            <div class="desig-toggle-pill @(_model.IsActive ? "" : "inactive")" @onclick="() => _model.IsActive = !_model.IsActive">
                <span class="desig-toggle-label">@(_model.IsActive ? "Active" : "Inactive")</span>
                <span class="desig-switch"></span>
            </div>
        </div>

        <div class="desig-form-actions">
            <button type="button" class="desig-btn desig-btn-cancel" @onclick="ResetForm">
                <i class="bi bi-x-lg"></i> Cancel
            </button>
            <button type="button" class="desig-btn desig-btn-save" @onclick="SavePage" disabled="@_isSaving">
                <i class="bi bi-save"></i> @(_isSaving ? "Saving..." : (_isEditMode ? "Update" : "Save"))
            </button>
        </div>
    </div>

    <!-- ============ Stat Cards ============ -->
    <div class="desig-stats-row">
        <div class="desig-stat-card total">
            <div class="desig-stat-label">Total Count</div>
            <div class="desig-stat-value">@TotalCount</div>
        </div>
        <div class="desig-stat-card active">
            <div class="desig-stat-label">Active</div>
            <div class="desig-stat-value">@ActiveCount</div>
        </div>
        <div class="desig-stat-card inactive">
            <div class="desig-stat-label">Inactive</div>
            <div class="desig-stat-value">@InactiveCount</div>
        </div>
    </div>

    <!-- ============ Page List ============ -->
    <div class="desig-list-card">
        <div class="desig-list-header">
            <h3 class="desig-list-title">Existing Pages</h3>
            <div class="desig-list-tools">
                <input type="text" class="desig-search" placeholder="Search pages..."
                       @bind="_searchText" @bind:event="oninput" @bind:after="ApplyFilter" />
                <select class="desig-status-select" @bind="_statusFilter" @bind:after="ApplyFilter">
                    <option value="All">All Status</option>
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                </select>
            </div>
        </div>

        <div class="table-responsive">
            <table class="desig-table">
                <thead>
                    <tr>
                        <th>S:No</th>
                        <th style="text-align:left;">Key</th>
                        <th style="text-align:left;">Name</th>
                        <th>Module</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_filtered.Any())
                    {
                        var sno = 1;
                        foreach (var p in _filtered)
                        {
                            <tr>
                                <td>@sno</td>
                                <td class="pm-cell-left pm-key-cell">@p.Key</td>
                                <td class="pm-cell-left">@p.Name</td>
                                <td>@(p.Module ?? "-")</td>
                                <td>
                                    <span class="desig-badge @(p.IsActive ? "desig-badge-active" : "desig-badge-inactive")">
                                        @(p.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td>
                                    <div class="desig-action-icons">
                                        @if (p.IsActive)
                                        {
                                            <i class="bi bi-slash-circle desig-icon-delete" title="Deactivate" @onclick="() => OpenDeleteModal(p)"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-arrow-counterclockwise desig-icon-restore" title="Activate" @onclick="() => ReactivatePage(p)"></i>
                                        }
                                        <i class="bi bi-pencil-square desig-icon-edit" title="Edit" @onclick="() => EditPage(p)"></i>
                                    </div>
                                </td>
                            </tr>
                            sno++;
                        }
                    }
                    else
                    {
                        <tr><td colspan="6" class="text-muted">No pages found</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ============ Deactivate Confirmation Modal ============ -->
@if (_showDeleteModal)
{
    <div class="desig-modal-backdrop" @onclick="CancelDelete">
        <div class="desig-modal" @onclick:stopPropagation="true">
            <div class="desig-modal-icon">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>
            <h3 class="desig-modal-title">Deactivate Page?</h3>
            <p class="desig-modal-body">You are about to deactivate <strong>@_deleteName</strong></p>
            <p class="desig-modal-warning">Deactivated pages are hidden from active lists but never deleted. Existing RoleAccess permissions keep working. You can reactivate it anytime.</p>
            <div class="desig-modal-actions">
                <button type="button" class="desig-btn desig-btn-cancel" @onclick="CancelDelete">Cancel</button>
                <button type="button" class="desig-btn desig-btn-delete" @onclick="ConfirmDelete">
                    <i class="bi bi-slash-circle"></i> Deactivate
                </button>
            </div>
        </div>
    </div>
}