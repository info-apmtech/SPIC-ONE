    private async Task LoadEmployees()
    {
        employeeLoadError = "";
        try
        {
            using var response = await Http.GetAsync("api/CSR2/all");
            if (!response.IsSuccessStatusCode)
            {
                employeeList = new();
                employeeLoadError = $"Unable to load employee details and roles (HTTP {(int)response.StatusCode})."; ShowCsr2Alert(employeeLoadError);
                return;
            }

            employeeList = await response.Content.ReadFromJsonAsync<List<Csr2EmployeeLookupDto>>() ?? new();
            if (employeeList.Count == 0)
            {
                employeeLoadError = "No employees returned by the employee lookup API.";
                ShowCsr2Alert(employeeLoadError);
            }
            OnEmployeeChanged();
        }
        catch (Exception ex)
        {
            employeeList = new();
            employeeLoadError = $"Employee lookup error: {ex.Message}"; ShowCsr2Alert(employeeLoadError);
            Console.WriteLine(employeeLoadError);
        }
    }

    private void OnEmployeeChanged()
    {
        employeeAddError = "";
        selectedEmployeePhone = "";
        selectedEmployeeRole = "";
        selectedEmployeeRoles = new();

        var emp = employeeList.FirstOrDefault(e =>
            e.Id == selectedEmployeeId);

        if (emp == null)
            return;

        selectedEmployeePhone =
            !string.IsNullOrWhiteSpace(emp.OfficialPhoneNumber)
                ? emp.OfficialPhoneNumber
                : emp.PersonalPhoneNumber ?? "";

        selectedEmployeeRoles =
            emp.Roles?
                .Where(r => !string.IsNullOrWhiteSpace(r))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(r => r)
                .ToList()
            ?? new();

        if (selectedEmployeeRoles.Count == 1)
            selectedEmployeeRole = selectedEmployeeRoles[0];
    }

    private void AddEmployee()
    {
        if (!CanEditCurrentCSR2) return;
        employeeAddError = "";
        var emp = employeeList.FirstOrDefault(e => e.Id == selectedEmployeeId);
        if (emp == null)
        {
            employeeAddError = "Please select an employee.";
            ShowCsr2Alert(employeeAddError);
            return;
        }
        if (string.IsNullOrWhiteSpace(emp.UserId))
        {
            employeeAddError = "Selected employee does not have a valid UserId.";
            ShowCsr2Alert(employeeAddError);
            return;
        }
        if (string.IsNullOrWhiteSpace(selectedEmployeeRole) || !selectedEmployeeRoles.Contains(selectedEmployeeRole))
        {
            employeeAddError = "Please select a role assigned to this employee.";
            ShowCsr2Alert(employeeAddError);
            return;
        }
        if (employees.Any(x => x.Id == emp.Id && x.Id != editingEmployeeId))
        {
            employeeAddError = "This employee has already been added.";
            ShowCsr2Alert(employeeAddError);
            return;
        }

        var entry = editingEmployeeId is int editId
            ? employees.FirstOrDefault(e => e.Id == editId)
            : null;
        if (entry == null)
        {
            entry = new PersonInfo();
            employees.Add(entry);
        }
        entry.Id = emp.Id;
        entry.UserId = emp.UserId ?? "";
        entry.Name = emp.Name;
        entry.Phone = selectedEmployeePhone;
        entry.Role = selectedEmployeeRole;
        entry.Initials = GetInitials(emp.Name);
        editingEmployeeId = null;
        selectedEmployeeId = 0;
        OnEmployeeChanged();
    }

    private void EditEmployee(int id)
    {
        if (!CanEditCurrentCSR2) return;
        var selected = employees.FirstOrDefault(e => e.Id == id);
        if (selected == null) return;
        editingEmployeeId = id;
        selectedEmployeeId = selected.Id;
        OnEmployeeChanged();
        if (selectedEmployeeRoles.Contains(selected.Role))
            selectedEmployeeRole = selected.Role;
    }

    private void DeleteEmployee(int id)
    {
        if (!CanEditCurrentCSR2) return;
        employees.RemoveAll(e => e.Id == id);
        if (editingEmployeeId == id)
        {
            editingEmployeeId = null;
            selectedEmployeeId = 0;
            OnEmployeeChanged();
        }
        employeeAddError = "";
    }
