    private int? editingParticipantId;
    private int nextParticipantId = 1;
    private const int participantPageSize = 5;
    private int participantPage = 1;
    private int ParticipantPageCount => Math.Max(1, (int)Math.Ceiling(participants.Count / (double)participantPageSize));
    private IEnumerable<PersonInfo> PagedParticipants => participants.Skip((participantPage - 1) * participantPageSize).Take(participantPageSize);

    private static string GetInitials(string name) => string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));

    private void AddParticipant()
    {
        participantError = "";
        var name = participantName.Trim();
        var phone = participantPhone.Trim();
        if (string.IsNullOrWhiteSpace(name) || string.IsNullOrWhiteSpace(phone) || string.IsNullOrWhiteSpace(participantRole))
        {
            participantError = "Please enter participant name, phone number and role.";
            ShowCsr2Alert(participantError);
            return;
        }
        if (phone.Length != 10 || !phone.All(char.IsDigit))
        {
            participantError = "Please enter a valid 10-digit mobile number.";
            ShowCsr2Alert(participantError);
            return;
        }
        if (participants.Any(p => p.Phone == phone && p.Id != editingParticipantId))
        {
            participantError = "This phone number is already added.";
            ShowCsr2Alert(participantError);
            return;
        }
        if (editingParticipantId is int id)
        {
            var existing = participants.FirstOrDefault(p => p.Id == id);
            if (existing != null)
            {
                existing.Name = name;
                existing.Phone = phone;
                existing.Role = participantRole;
                existing.Initials = GetInitials(name);
            }
        }
        else
        {
            participants.Add(new PersonInfo { Id = nextParticipantId++, Name = name, Phone = phone, Role = participantRole, Initials = GetInitials(name) });
            participantPage = ParticipantPageCount;
        }
        ClearParticipantForm();
    }

    private void EditParticipant(PersonInfo person)
    {
        editingParticipantId = person.Id;
        participantName = person.Name;
        participantPhone = person.Phone;
        participantRole = person.Role;
        participantError = "";
    }

    private void DeleteParticipant(int id)
    {
        participants.RemoveAll(p => p.Id == id);
        participantPage = Math.Min(participantPage, ParticipantPageCount);
        if (editingParticipantId == id) ClearParticipantForm();
    }

    private void ClearParticipantForm()
    {
        participantName = "";
        participantPhone = "";
        participantRole = "";
        participantError = "";
        editingParticipantId = null;
    }

    private void SetParticipantPage(int page) => participantPage = Math.Clamp(page, 1, ParticipantPageCount);

