        Employees = employees.Select(x => new CSR2EmployeeDto { EmployeeInformationId = x.Id, EmployeeName = x.Name, PhoneNumber = x.Phone, RoleName = x.Role }).ToList(),
        Activities = activities.Select((x, i) => new CSR2ActivityDto
        {
            ActivityName = x.Title,
            StartTime = TimeOnly.ParseExact(x.StartTime, "HH:mm", CultureInfo.InvariantCulture),
            EndTime = TimeOnly.ParseExact(x.EndTime, "HH:mm", CultureInfo.InvariantCulture),
