@page "/DealerManagementTrainingProgram"
@inject NavigationManager NavigationManager
@inject HttpClient Http
@using System.Net.Http.Json
@using SPIC.Core.DTOs
@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms

@if (isLoadingCSR1)
{
    <div class="alert alert-info m-4">Loading approved CSR-1 plan...</div>
}
else if (!string.IsNullOrWhiteSpace(csr1Error))
{
    <div class="alert alert-danger m-4">@csr1Error</div>
}
else if (csr1Plan != null)
{
    <div class="container-fluid py-4 px-0">
        <div class="dmtp-wrapper">

            <!-- Header -->
            @if (currentStep == 5)
            {
                <div class="dmtp-header dmtp-header-review">
                    <div>
                        <h1>CSR-2 Review &amp; Submit</h1>
                        <p class="dmtp-header-subtitle">Review event details before Submitting your report</p>
                    </div>
                    <div class="dmtp-header-actions">
                        <button type="button" class="dmtp-btn-header-outline">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
                            Back to List Page
                        </button>
                        <button type="button" class="dmtp-btn-header-outline">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                            Download Report
                        </button>
                        <button type="button" class="dmtp-btn-header-outline">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg>
                            Print
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="dmtp-header">
                    <h1>@csr1Plan.ProgramName</h1>
                </div>
            }

            <!-- Budget Summary (Expense & Proof step) -->
            @if (currentStep == 4)
            {
                <div class="dmtp-budget-summary-grid">
                    <div class="dmtp-budget-card dmtp-budget-green">
                        <div class="dmtp-budget-text">
                            <span class="dmtp-budget-label">Approved Budget</span>
                            <span class="dmtp-budget-value">@Money(csr1Plan.Budget)</span>
                            <span class="dmtp-budget-note">From CSR-1 approval</span>
                        </div>
                        <div class="dmtp-budget-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
                        </div>
                    </div>
                    <div class="dmtp-budget-card dmtp-budget-pink">
                        <div class="dmtp-budget-text">
                            <span class="dmtp-budget-label">Actual Expense</span>
                            <span class="dmtp-budget-value">@Money(ActualExpenseTotal)</span>
                            <span class="dmtp-budget-note">Calculated from entries below</span>
                        </div>
                        <div class="dmtp-budget-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                        </div>
                    </div>
                    <div class="dmtp-budget-card dmtp-budget-blue">
                        <div class="dmtp-budget-text">
                            <span class="dmtp-budget-label">Difference</span>
                            <span class="dmtp-budget-value">@Money(BudgetBalance)</span>
                            <span class="dmtp-budget-note">Within Budget <span class="dmtp-mini-badge">Saved</span></span>
                        </div>
                        <div class="dmtp-budget-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                        </div>
                    </div>
                </div>
            }

            <!-- Step Indicator -->
            <div class="dmtp-stepper-card">
                <div class="dmtp-stepper">
                    @foreach (var step in steps)
                    {
                        <button type="button" class="dmtp-step @StepClass(step.Number)" @onclick="() => GoToStep(step.Number)">
                            <span class="dmtp-step-circle">@step.Number</span>
                            <span class="dmtp-step-label">@step.Label</span>
                        </button>
                    }
                </div>
            </div>

            <!-- Review Banner (Review & Submit step) -->
            @if (currentStep == 5)
            {
                <div class="dmtp-review-banner">
                    <div class="dmtp-review-pills">
                        <span class="dmtp-review-pill dmtp-pill-blue">CSR-2</span>
                        <span class="dmtp-review-pill dmtp-pill-green">Ready for Submission</span>
                        <span class="dmtp-review-pill dmtp-pill-gray">@Display(csr1Plan.Scope) Level</span>
                    </div>
                    <h2 class="dmtp-review-title">@csr1Plan.ProgramName</h2>
                    <div class="dmtp-review-meta">
                        <span># Ref: @Display(csr1Plan.SanctionNo)</span>
                        <span>Sanction: <strong>@Display(csr1Plan.SanctionNo)</strong></span>
                        <span>@Display(csr1Plan.HeadquarterName)</span>
                        <span>Program date @csr1Plan.CSR1Date.ToString("dd MMM yyyy")</span>
                    </div>
                </div>

                <div class="dmtp-budget-summary-grid dmtp-budget-summary-grid-4">
                    <div class="dmtp-budget-card dmtp-budget-green">
                        <div class="dmtp-budget-text">
                            <span class="dmtp-budget-label">Approved Budget</span>
                            <span class="dmtp-budget-value">@Money(csr1Plan.Budget)</span>
                        </div>
                        <div class="dmtp-budget-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
                        </div>
                    </div>
                    <div class="dmtp-budget-card dmtp-budget-blue">
                        <div class="dmtp-budget-text">
                            <span class="dmtp-budget-label">Actual Expense</span>
                            <span class="dmtp-budget-value">@Money(ActualExpenseTotal)</span>
                        </div>
                        <div class="dmtp-budget-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                        </div>
                    </div>
                    <div class="dmtp-budget-card dmtp-budget-orange">
                        <div class="dmtp-budget-text">
                            <span class="dmtp-budget-label">Total Attendance</span>
                            <span class="dmtp-budget-value">136</span>
                        </div>
                        <div class="dmtp-budget-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                        </div>
                    </div>
                    <div class="dmtp-budget-card dmtp-budget-purple">
                        <div class="dmtp-budget-text">
                            <span class="dmtp-budget-label">Media Uploaded</span>
                            <span class="dmtp-budget-value">@(eventPhotos.Count + eventVideos.Count) items</span>
                        </div>
                        <div class="dmtp-budget-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                        </div>
                    </div>
                </div>
            }

            @if (currentStep == 1)
            {
                <!-- Approved CSR-1 Plan -->
                <div class="dmtp-card">
                    <h3 class="dmtp-card-title">Approved CSR-1 Plan</h3>
                    <div class="dmtp-plan-grid">
                        <div class="dmtp-plan-item">
                            <span class="dmtp-plan-label">Program Type</span>
                            <span class="dmtp-plan-value">@Display(csr1Plan.ProgramType)</span>
                        </div>
                        <div class="dmtp-plan-item">
                            <span class="dmtp-plan-label">Program Name</span>
                            <span class="dmtp-plan-value">@Display(csr1Plan.ProgramName)</span>
                        </div>
                        <div class="dmtp-plan-item">
                            <span class="dmtp-plan-label">Number of Programs</span>
                            <span class="dmtp-plan-value">@csr1Plan.NumberOfPrograms</span>
                        </div>
                        <div class="dmtp-plan-item">
                            <span class="dmtp-plan-label">Headquarters</span>
                            <span class="dmtp-plan-value">@Display(csr1Plan.HeadquarterName)</span>
                        </div>
                        <div class="dmtp-plan-item">
                            <span class="dmtp-plan-label">Approved Budget</span>
                            <span class="dmtp-plan-value">@Money(csr1Plan.Budget)</span>
                        </div>
                        <div class="dmtp-plan-item">
                            <span class="dmtp-plan-label">Location</span>
                            <span class="dmtp-plan-value">@Display(csr1Plan.LocationName)</span>
                        </div>
                        <div class="dmtp-plan-item">
                            <span class="dmtp-plan-label">Approved By</span>
                            <span class="dmtp-plan-value">@Display(csr1Plan.ApprovedBy)</span>
                        </div>
                        <div class="dmtp-plan-item">
                            <span class="dmtp-plan-label">Approved Date</span>
                            <span class="dmtp-plan-value">@(csr1Plan.ApprovedAt?.ToString("dd MMM yyyy") ?? "-")</span>
                        </div>
                        <div class="dmtp-plan-item">
                            <span class="dmtp-plan-label">CSR-1 Reference</span>
                            <span class="dmtp-plan-value">@Display(csr1Plan.SanctionNo)</span>
                        </div>
                        <div class="dmtp-plan-item dmtp-plan-item-highlight">
                            <span class="dmtp-plan-label">Responsible Person</span>
                            <span class="dmtp-plan-value">@Display(csr1Plan.ResponsiblePersonName)</span>
                        </div>
                    </div>
                </div>

                <!-- Focus Details from CSR1Products1, CSR1Products2, CSR1Products3 -->
                <div class="dmtp-card">
                    <h3 class="dmtp-card-title">Focus Details</h3>
                    <div class="dmtp-focus-grid">
                        @foreach (var focus in CSR1FocusGroups)
                        {
                            <div class="dmtp-focus-box">
                                <div class="dmtp-form-group">
                                    <label class="dmtp-form-label">Focused Crop - @focus.Number</label>
                                    <select class="dmtp-form-select" disabled>
                                        <option>@(focus.Items.Count > 0 ? Display(focus.Items[0].CropName) : "Not selected")</option>
                                    </select>
                                </div>
                                <div class="dmtp-form-group">
                                    <label class="dmtp-form-label">Focused Products</label>
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var product in focus.Items)
                                        {
                                            <span class="dmtp-tag">@product.ProductName</span>
                                        }
                                        @if (focus.Items.Count == 0)
                                        {
                                            <span class="text-muted">No products selected</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Actual Event Date -->
                <div class="dmtp-card">
                    <h3 class="dmtp-card-title">Actual Event Date</h3>
                    <div class="dmtp-event-grid">
                        <div class="dmtp-form-group">
                            <label class="dmtp-form-label">Actual Event Date</label>
                            <input type="date" class="dmtp-form-control" @bind="actualEventDate" />
                        </div>
                        <div class="dmtp-form-group">
                            <label class="dmtp-form-label">Start Time</label>
                            <input type="time" class="dmtp-form-control" @bind="startTime" />
                        </div>
                        <div class="dmtp-form-group">
                            <label class="dmtp-form-label">End Time</label>
                            <input type="time" class="dmtp-form-control" @bind="endTime" />
                        </div>
                        <div class="dmtp-form-group">
                            <label class="dmtp-form-label">Event Coordinator</label>
                            <select class="dmtp-form-select" @bind="eventCoordinatorId">
                                <option value="0">Select Employee</option>
                                @foreach (var employee in employeeList)
                                {
                                    <option value="@employee.Id">@employee.Name</option>
                                }
                            </select>
                        </div>
                        <div class="dmtp-form-group dmtp-span-2">
                            <label class="dmtp-form-label">Actual Location</label>
                            <input type="text" class="dmtp-form-control" placeholder="Venue name, address, city" @bind="actualLocation" />
                        </div>
                    </div>
                </div>

                <!-- Participants Summary -->
                <div class="dmtp-participants-heading">
                    <h3>Participants</h3>
                    <p>Farmers, dealers, distributors, and other attendees</p>
                </div>

                <div class="dmtp-stats-grid-3">
                    <div class="dmtp-stat-card">
                        <div class="dmtp-stat-text">
                            <p>Total Participants</p>
                            <h2>@totalParticipants</h2>
                        </div>
                        <div class="dmtp-stat-icon dmtp-stat-icon-blue">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                        </div>
                    </div>
                    <div class="dmtp-stat-card">
                        <div class="dmtp-stat-text">
                            <p>SPIC Employees</p>
                            <h2>@totalEmployees</h2>
                        </div>
                        <div class="dmtp-stat-icon dmtp-stat-icon-purple">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                        </div>
                    </div>
                    <div class="dmtp-stat-card">
                        <div class="dmtp-stat-text">
                            <p>Overall Attendance</p>
                            <h2>@overallAttendance</h2>
                        </div>
                        <div class="dmtp-stat-icon dmtp-stat-icon-green">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                        </div>
                    </div>
                </div>

                <!-- Participant List -->
                <div class="dmtp-card">
                    <div class="dmtp-list-header">
                        <h3 class="dmtp-card-title dmtp-no-margin">Participant List</h3>
                        <button type="button" class="dmtp-btn-add" @onclick="AddParticipant">
                            <i class="bi bi-plus-lg"></i> @(editingParticipantId is null ? "Add Participant" : "Update Participant")
                        </button>
                    </div>

                    <div class="dmtp-filter-row">
                        <div class="dmtp-form-group">
                            <label class="dmtp-form-label">Name</label>
                            <input type="text" class="dmtp-form-control" placeholder="Enter Name" @bind="participantName" />
                        </div>
                        <div class="dmtp-form-group">
                            <label class="dmtp-form-label">Phone Number</label>
                            <input type="tel" class="dmtp-form-control" placeholder="10-digit phone number" maxlength="10" @bind="participantPhone" />
                        </div>
                        <div class="dmtp-form-group">
                            <label class="dmtp-form-label">Role</label>
                            <select class="dmtp-form-select" @bind="participantRole">
                                <option value="">Select Role</option>
                                <option value="Farmer">Farmer</option>
                                <option value="Dealer">Dealer</option>
                                <option value="Distributor">Distributor</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(participantError))
                    {
                        <div class="alert alert-danger py-2" role="alert">@participantError</div>
                    }
                    @if (editingParticipantId is not null)
                    {
                        <button type="button" class="dmtp-btn-previous mb-3" @onclick="ClearParticipantForm">Cancel Edit</button>
                    }

                    <div class="dmtp-people-grid">
                        @foreach (var person in PagedParticipants)
                        {
                            <div class="dmtp-person-row" @key="person.Id">
                                <div class="dmtp-person-avatar">@person.Initials</div>
                                <div class="dmtp-person-info">
                                    <span class="dmtp-person-name">@person.Name</span>
                                    <span class="dmtp-person-phone">Phone Number: @person.Phone</span>
                                </div>
                                <span class="dmtp-role-badge">@person.Role</span>
                                <button type="button" class="dmtp-icon-btn dmtp-icon-edit" aria-label="Edit" @onclick="() => EditParticipant(person)">
                                    <i class="bi bi-pencil-square"></i>
                                </button>
                                <button type="button" class="dmtp-icon-btn dmtp-icon-delete" aria-label="Delete" @onclick="() => DeleteParticipant(person.Id)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        }
                    </div>

                    <div class="dmtp-pagination">
                        <span class="dmtp-pagination-text">
                            @if (participants.Count == 0)
                            {
                                <span>No participants added</span>
                            }
                            else
                            {
                                <span>Showing @((participantPage - 1) * participantPageSize + 1) to @(Math.Min(participantPage * participantPageSize, participants.Count)) of @participants.Count Participants</span>
                            }
                        </span>
                        <div class="dmtp-page-controls">
                            <button type="button" class="dmtp-page-btn" disabled="@(participantPage == 1)" @onclick="() => SetParticipantPage(participantPage - 1)">‹</button>
                            @for (var page = 1; page <= ParticipantPageCount; page++)
                            {
                                var pageNumber = page;
                                <button type="button" class="dmtp-page-btn @(participantPage == pageNumber ? "active" : "")" @onclick="() => SetParticipantPage(pageNumber)">@pageNumber</button>
                            }
                            <button type="button" class="dmtp-page-btn" disabled="@(participantPage == ParticipantPageCount)" @onclick="() => SetParticipantPage(participantPage + 1)">›</button>
                        </div>
                    </div>
                </div>

                <!-- SPIC Employee List -->
                <div class="dmtp-card">
                    <div class="dmtp-list-header">
                        <h3 class="dmtp-card-title dmtp-no-margin">SPIC Employee List</h3>
                        <button type="button" class="dmtp-btn-add" @onclick="AddEmployee">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                            Add Employee
                        </button>
                    </div>

                    <div class="dmtp-filter-row">
                        <div class="dmtp-form-group">
                            <label class="dmtp-form-label">Employee Name</label>

                            <select class="dmtp-form-select"
                                    @bind="selectedEmployeeId"
                                    @bind:after="OnEmployeeChanged">

                                <option value="0">Select Employee</option>

                                @foreach (var emp in employeeList)
                                {
                                    <option value="@emp.Id">
                                        @emp.Name
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="dmtp-form-group">
                            <label class="dmtp-form-label">Phone Number</label>
                            <input type="tel" class="dmtp-form-control" placeholder="No mobile number in Employee Master" @bind="selectedEmployeePhone" readonly />
                        </div>
                        <div class="dmtp-form-group">
                            <label class="dmtp-form-label">Role</label>
                            <select class="dmtp-form-select" @bind="selectedEmployeeRole">
                                <option value="">Select Role</option>
                                @foreach (var role in selectedEmployeeRoles)
                                {
                                    <option value="@role">@role</option>
                                }
                            </select>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(employeeLoadError))
                    {
                        <div class="alert alert-danger py-2">@employeeLoadError</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(employeeAddError))
                    {
                        <div class="alert alert-danger py-2">@employeeAddError</div>
                    }
                    <div class="dmtp-people-grid">
                        @foreach (var person in employees)
                        {
                            <div class="dmtp-person-row">
                                <div class="dmtp-person-avatar">@person.Initials</div>
                                <div class="dmtp-person-info">
                                    <span class="dmtp-person-name">@person.Name</span>
                                    <span class="dmtp-person-phone">PH: @person.Phone</span>
                                </div>
                                <span class="dmtp-role-badge">@person.Role</span>
                                <button type="button" class="dmtp-icon-btn dmtp-icon-edit" aria-label="Edit" @onclick="() => EditEmployee(person.Id)">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                </button>
                                <button type="button" class="dmtp-icon-btn dmtp-icon-delete" aria-label="Delete" @onclick="() => DeleteEmployee(person.Id)">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                </button>
                            </div>
                        }
                    </div>

                    <div class="dmtp-pagination">
                        <span class="dmtp-pagination-text">@employees.Count SPIC employees added</span>
                    </div>
                </div>

                <!-- Expected Participants Count -->
                <div class="dmtp-card dmtp-expected-card">
                    <div class="dmtp-expected-text">
                        <h3 class="dmtp-card-title dmtp-no-margin">Expected Participants Count</h3>
                        <p>Planned external participant count; individual records optional for large groups</p>
                    </div>
                    <input type="text" class="dmtp-form-control dmtp-expected-input" placeholder="e.g 150" readonly>
                </div>
            }
            else if (currentStep == 2)
            {
                <!-- Event Photos: dynamic local previews; saved by CSR-2 API in a later step -->
                <div class="dmtp-card">
                    <div class="dmtp-list-header">
                        <h3 class="dmtp-card-title dmtp-no-margin">Event Photos (@eventPhotos.Count)</h3>
                        <label for="dmtp-photos-header" class="dmtp-btn-add" style="cursor:pointer;">
                            <i class="bi bi-plus-lg"></i> Upload Photos
                        </label>
                        <InputFile id="dmtp-photos-header" OnChange="OnPhotosSelected" accept="image/jpeg,image/png,.jpg,.jpeg,.png" multiple style="display:none" />
                    </div>

                    <div class="dmtp-dropzone" style="position:relative;">
                        <InputFile OnChange="OnPhotosSelected" accept="image/jpeg,image/png,.jpg,.jpeg,.png" multiple
                                   style="position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:pointer;z-index:1;" />
                        <div class="dmtp-dropzone-icon">
                            <i class="bi bi-image"></i>
                        </div>
                        <p class="dmtp-dropzone-title">Drag and drop photos here, or click to browse</p>
                        <p class="dmtp-dropzone-sub">JPG, PNG up to 20MB each</p>
                        <div class="dmtp-dropzone-actions" style="position:relative;z-index:2;">
                            <label for="dmtp-photos-browse" class="dmtp-btn-outline-plain" style="cursor:pointer;">
                                <i class="bi bi-folder2-open"></i> Browse Files
                            </label>
                            @* On mobile this opens the gallery/file picker; it does not force the camera. *@
                            <InputFile id="dmtp-photos-browse" OnChange="OnPhotosSelected"
                                       accept="image/jpeg,image/png,.jpg,.jpeg,.png" multiple
                                       style="position:absolute;width:1px;height:1px;opacity:0;overflow:hidden;clip-path:inset(50%);pointer-events:none;" />
                            <label for="dmtp-photos-camera" class="dmtp-btn-outline-plain" style="cursor:pointer;">
                                <i class="bi bi-camera"></i> Take Photo
                            </label>
                            @* Mobile camera: rear-facing camera where supported; browsers may offer a chooser. *@
                            <InputFile id="dmtp-photos-camera" OnChange="OnPhotosSelected"
                                       accept="image/jpeg,image/png,image/*" capture="environment"
                                       style="position:absolute;width:1px;height:1px;opacity:0;overflow:hidden;clip-path:inset(50%);pointer-events:none;" />
                        </div>
                        <p class="dmtp-dropzone-sub mt-2 mb-0">On mobile: Take Photo opens the camera when supported; Browse Files opens your gallery or files.</p>
                    </div>
                    @if (isReadingPhotos)
                    {
                        <div class="text-muted small mt-2">Loading selected photos...</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(photoError))
                    {
                        <div class="alert alert-danger py-2 mt-2" role="alert">@photoError</div>
                    }
                    @if (eventPhotos.Count == 0)
                    {
                        <p class="text-muted mt-3">No event photos added yet.</p>
                    }
                    <div class="dmtp-photo-grid">
                        @foreach (var photo in eventPhotos)
                        {
                            <div class="dmtp-photo-card" @key="photo.Id">
                                <div class="dmtp-photo-thumb" style="overflow:hidden;">
                                    <img src="@photo.PreviewUrl" alt="@photo.FileName" style="width:100%;height:100%;object-fit:cover;" />
                                </div>
                                <span class="dmtp-photo-filename" title="@photo.FileName">@photo.FileName</span>
                                <input type="text" class="dmtp-form-control" placeholder="Add caption" @bind="photo.Caption" />
                                <div class="dmtp-photo-footer">
                                    <label class="dmtp-toggle-switch" style="cursor:pointer;">
                                        <input type="checkbox" @bind="photo.UseInLibrary" style="position:absolute;opacity:0;width:1px;height:1px;" />
                                        <span class="dmtp-toggle @(photo.UseInLibrary ? "on" : "")"></span>
                                        Use in Digital Library
                                    </label>
                                    <button type="button" class="dmtp-link-remove" @onclick="() => RemovePhoto(photo.Id)">
                                        <i class="bi bi-trash"></i> Remove
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Event Videos: gallery upload and mobile camera recording -->
                <div class="dmtp-card">
                    <div class="dmtp-list-header">
                        <h3 class="dmtp-card-title dmtp-no-margin">Event Videos (@eventVideos.Count)</h3>
                        <label for="dmtp-videos-header" class="dmtp-btn-add" style="cursor:pointer;">
                            <i class="bi bi-plus-lg"></i> Upload Videos
                        </label>
                        <InputFile id="dmtp-videos-header" OnChange="OnVideosSelected" accept="video/mp4,video/quicktime,.mp4,.mov" multiple
                                   style="position:absolute;width:1px;height:1px;opacity:0;clip-path:inset(50%);pointer-events:none;" />
                    </div>
                    <div class="dmtp-dropzone" style="position:relative;">
                        <InputFile OnChange="OnVideosSelected" accept="video/mp4,video/quicktime,.mp4,.mov" multiple
                                   style="position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:pointer;z-index:1;" />
                        <div class="dmtp-dropzone-icon"><i class="bi bi-camera-video"></i></div>
                        <p class="dmtp-dropzone-title">Drag and Drop Videos here, or choose an option</p>
                        <p class="dmtp-dropzone-sub">MP4, MOV up to 200MB each</p>
                        <div class="dmtp-dropzone-actions" style="position:relative;z-index:2;">
                            <label for="dmtp-videos-browse" class="dmtp-btn-outline-plain" style="cursor:pointer;">
                                <i class="bi bi-folder2-open"></i> Browse Files
                            </label>
                            <InputFile id="dmtp-videos-browse" OnChange="OnVideosSelected"
                                       accept="video/mp4,video/quicktime,.mp4,.mov" multiple
                                       style="position:absolute;width:1px;height:1px;opacity:0;clip-path:inset(50%);pointer-events:none;" />
                            <label for="dmtp-videos-record" class="dmtp-btn-outline-plain" style="cursor:pointer;">
                                <i class="bi bi-camera-video"></i> Record Video
                            </label>
                            <InputFile id="dmtp-videos-record" OnChange="OnVideosSelected"
                                       accept="video/*" capture="environment"
                                       style="position:absolute;width:1px;height:1px;opacity:0;clip-path:inset(50%);pointer-events:none;" />
                        </div>
                        <p class="dmtp-dropzone-sub mt-2 mb-0">On mobile, Record Video requests the camera. Browse Files selects a saved video.</p>
                    </div>
                    @if (isReadingVideos)
                    {
                        <div class="text-muted small mt-2">Loading selected videos...</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(videoError))
                    {
                        <div class="alert alert-danger py-2 mt-2" role="alert">@videoError</div>
                    }
                    @if (eventVideos.Count == 0)
                    {
                        <p class="text-muted mt-3">No event videos added yet.</p>
                    }
                    <div class="dmtp-photo-grid">
                        @foreach (var video in eventVideos)
                        {
                            <div class="dmtp-photo-card" @key="video.Id">
                                <div class="dmtp-photo-thumb" style="height:auto;min-height:140px;overflow:hidden;background:#152633;">
                                    @if (!string.IsNullOrEmpty(video.PreviewUrl))
                                    {
                                        <video controls playsinline preload="metadata" src="@video.PreviewUrl" style="width:100%;max-height:220px;display:block;"></video>
                                    }
                                    else
                                    {
                                        <div class="text-white text-center p-4">Preview unavailable for large video; select a shorter clip or save via server upload.</div>
                                    }
                                </div>
                                <span class="dmtp-photo-filename" title="@video.FileName">@video.FileName (@FormatVideoSize(video.Bytes.LongLength))</span>
                                <input type="text" class="dmtp-form-control" placeholder="Add video caption" @bind="video.Caption" />
                                <div class="dmtp-photo-footer">
                                    <label class="dmtp-toggle-switch" style="cursor:pointer;">
                                        <input type="checkbox" @bind="video.UseInLibrary" style="position:absolute;opacity:0;width:1px;height:1px;" />
                                        <span class="dmtp-toggle @(video.UseInLibrary ? "on" : "")"></span>
                                        Use in Digital Library
                                    </label>
                                    <button type="button" class="dmtp-link-remove" @onclick="() => RemoveVideo(video.Id)">
                                        <i class="bi bi-trash"></i> Remove
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else if (currentStep == 3)
            {
                <!-- Dynamic Event Activities -->
                <div class="dmtp-card">
                    <div class="dmtp-list-header">
                        <div>
                            <h3 class="dmtp-card-title dmtp-no-margin">Event Activities</h3>
                            <p class="dmtp-card-subtitle">Record activities actually conducted during the event</p>
                        </div>
                        <span class="dmtp-count-pill">@activities.Count Activities</span>
                    </div>
                    <div class="dmtp-new-activity-box">
                        <h4>@(editingActivityId.HasValue ? "Edit Activity" : "New Activity")</h4>
                        <div class="dmtp-quickfill-row">
                            <span class="dmtp-quickfill-label">Quick fill:</span>
                            <button type="button" class="dmtp-quickfill-chip" @onclick='() => FillActivityName("Farmer Awareness Session")'>Farmer Awareness Session</button>
                            <button type="button" class="dmtp-quickfill-chip" @onclick='() => FillActivityName("Product Demonstration")'>Product Demonstration</button>
                            <button type="button" class="dmtp-quickfill-chip" @onclick='() => FillActivityName("Crop Guidance Session")'>Crop Guidance Session</button>
                        </div>
                        <div class="dmtp-activity-grid">
                            <div class="dmtp-form-group">
                                <label class="dmtp-form-label">Activity Name *</label>
                                <input type="text" class="dmtp-form-control" placeholder="Enter activity name" @bind="activityName" />
                            </div>
                            <div class="dmtp-form-group">
                                <label class="dmtp-form-label">Start Time *</label>
                                <input type="time" class="dmtp-form-control" @bind="activityStartTime" />
                            </div>
                            <div class="dmtp-form-group">
                                <label class="dmtp-form-label">End Time *</label>
                                <input type="time" class="dmtp-form-control" @bind="activityEndTime" />
                            </div>
                            <div class="dmtp-form-group">
                                <label class="dmtp-form-label">Participants (optional)</label>
                                <input type="number" min="0" class="dmtp-form-control" placeholder="Number attending this activity" @bind="activityParticipants" />
                            </div>
                            <div class="dmtp-form-group dmtp-span-2">
                                <label class="dmtp-form-label">Activity Description *</label>
                                <input type="text" class="dmtp-form-control" placeholder="What happened during this activity?" @bind="activityDescription" />
                            </div>
                            <div class="dmtp-form-group">
                                <label class="dmtp-form-label">Remarks (optional)</label>
                                <input type="text" class="dmtp-form-control" placeholder="Additional remarks" @bind="activityRemarks" />
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(activityError))
                        {
                            <div class="alert alert-danger py-2 mt-2">@activityError</div>
                        }
                        <div class="dmtp-new-activity-actions">
                            <button type="button" class="dmtp-btn-cancel-neutral" @onclick="ClearActivityForm">Cancel</button>
                            <button type="button" class="dmtp-btn-start-event" @onclick="SaveActivity">@(editingActivityId.HasValue ? "Update Activity" : "Add Activity")</button>
                        </div>
                    </div>
                    @if (activities.Count == 0)
                    {
                        <p class="text-muted mt-3">No activities added yet.</p>
                    }
                    <div class="dmtp-activity-list">
                        @foreach (var activity in activities)
                        {
                            <div class="dmtp-activity-card" @key="activity.Id">
                                <div class="dmtp-activity-avatar">@GetInitials(activity.Title)</div>
                                <div class="dmtp-activity-info">
                                    <span class="dmtp-activity-title">@activity.Title <span class="dmtp-activity-number">#@(activities.IndexOf(activity) + 1)</span></span>
                                    <span class="dmtp-activity-desc">@activity.Description</span>
                                    <div class="dmtp-activity-meta">
                                        <span>@activity.StartTime - @activity.EndTime</span>
                                        <span>@activity.Participants Participants</span>
                                        @if (!string.IsNullOrWhiteSpace(activity.Remarks))
                                        {
                                            <span>Remarks: @activity.Remarks</span>
                                        }
                                    </div>
                                </div>
                                <div class="dmtp-activity-icons">
                                    <button type="button" class="dmtp-icon-btn dmtp-icon-edit" aria-label="Edit" @onclick="() => EditActivity(activity.Id)"><i class="bi bi-pencil-square"></i></button>
                                    <button type="button" class="dmtp-icon-btn dmtp-icon-delete" aria-label="Delete" @onclick="() => DeleteActivity(activity.Id)"><i class="bi bi-trash"></i></button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else if (currentStep == 4)
            {
                <!-- Expense & Proof: CSR-1 planned amounts with CSR-2 actual amounts -->
                <div class="dmtp-card">
                    <h3 class="dmtp-card-title">Expense &amp; Proof</h3>
                    <p class="dmtp-card-subtitle dmtp-expense-subtitle">Add actual expenses and upload bills/proofs for verification. Planned amounts are from approved CSR-1.</p>
                    <div class="dmtp-expense-color-grid">
                        @foreach (var item in expenseItems)
                        {
                            <div class="dmtp-expense-color-card @(item.Key == "Others" ? "dmtp-expense-color-full" : "")" @key="item.Key">
                                <span class="dmtp-expense-color-icon @item.IconClass" aria-hidden="true"><i class="bi @item.Icon"></i></span>
                                <div class="dmtp-expense-color-content">
                                    <div class="dmtp-expense-color-heading">
                                        <strong>@item.Label</strong>
                                        <span>CSR-1 planned: @Money(item.PlannedAmount)</span>
                                    </div>
                                    <div class="dmtp-expense-color-fields">
                                        <div class="dmtp-form-group">
                                            <label class="dmtp-form-label">Actual amount (₹)</label>
                                            <input type="number" step="0.01" min="0" class="dmtp-form-control" placeholder="₹ 0" @bind="item.ActualAmount" />
                                        </div>
                                        <div class="dmtp-form-group">
                                            <label class="dmtp-form-label">Date</label>
                                            <input type="date" class="dmtp-form-control" @bind="item.ExpenseDate" />
                                        </div>
                                        <div class="dmtp-form-group dmtp-expense-proof-control">
                                            <label class="dmtp-form-label">&nbsp;</label>
                                            <label for="@($"expense-proof-{item.Key}")" class="dmtp-expense-color-upload"><i class="bi bi-upload"></i> Upload proof</label>
                                            <InputFile id="@($"expense-proof-{item.Key}")" OnChange="@(e => OnExpenseProofSelected(e, item))" accept=".pdf,.jpg,.jpeg,.png" style="position:absolute;width:1px;height:1px;opacity:0;clip-path:inset(50%);pointer-events:none;" />
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(item.ProofFileName))
                                    {
                                        <div class="dmtp-expense-color-file">
                                            <span title="@item.ProofFileName"><i class="bi bi-paperclip"></i> @item.ProofFileName</span>
                                            <button type="button" class="dmtp-link-remove" @onclick="() => RemoveExpenseProof(item)">Remove</button>
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(item.Error))
                                    {
                                        <div class="text-danger small mt-1">@item.Error</div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                    <div class="d-flex flex-wrap justify-content-end gap-3 mt-3 small">
                        <span>Approved budget: <strong>@Money(csr1Plan.Budget)</strong></span>
                        <span>Actual expense: <strong>@Money(ActualExpenseTotal)</strong></span>
                        <span>Balance: <strong class="@(BudgetBalance < 0 ? "text-danger" : "text-success")">@Money(BudgetBalance)</strong></span>
                    </div>
                </div>
            }
            else if (currentStep == 5)
            {
                <!-- Program Overview -->
                <div class="dmtp-card">
                    <h3 class="dmtp-card-title">Program Over view</h3>
                    <div class="dmtp-plan-grid dmtp-review-grid-3">
                        <div class="dmtp-plan-item">
                            <span class="dmtp-plan-label">PO Number</span>
                            <span class="dmtp-plan-value">@Display(csr1Plan.SanctionNo)</span>
                        </div>
                        <div class="dmtp-plan-item">
                            <span class="dmtp-plan-label">Program Type</span>
                            <span class="dmtp-plan-value">@Display(csr1Plan.ProgramType)</span>
                        </div>
                        <div class="dmtp-plan-item">
                            <span class="dmtp-plan-label">Program Level</span>
                            <span class="dmtp-plan-value">@Display(csr1Plan.Scope)</span>
                        </div>
                        <div class="dmtp-plan-item">
                            <span class="dmtp-plan-label">Headquarters</span>
                            <span class="dmtp-plan-value">@Display(csr1Plan.HeadquarterName)</span>
                        </div>
                        <div class="dmtp-plan-item">
                            <span class="dmtp-plan-label">District</span>
                            <span class="dmtp-plan-value">@Display(csr1Plan.LocationName)</span>
                        </div>
                        <div class="dmtp-plan-item">
                            <span class="dmtp-plan-label">Responsible Person</span>
                            <span class="dmtp-plan-value">@Display(csr1Plan.ResponsiblePersonName)</span>
                        </div>
                    </div>
                </div>

                <!-- Actual Event Details -->
                <div class="dmtp-card">
                    <div class="dmtp-list-header">
                        <h3 class="dmtp-card-title dmtp-no-margin">Actual Event Details</h3>
                        <button type="button" class="dmtp-btn-edit-outline">Edit</button>
                    </div>
                    <div class="dmtp-plan-grid dmtp-review-grid-5">
                        <div class="dmtp-plan-item">
                            <span class="dmtp-plan-label">Event Date</span>
                            <span class="dmtp-plan-value">18 Sep 2026</span>
                        </div>
                        <div class="dmtp-plan-item">
                            <span class="dmtp-plan-label">Venue</span>
                            <span class="dmtp-plan-value">Tambaram Community Hall</span>
                        </div>
                        <div class="dmtp-plan-item">
                            <span class="dmtp-plan-label">Start Time</span>
                            <span class="dmtp-plan-value">10:00 AM</span>
                        </div>
                        <div class="dmtp-plan-item">
                            <span class="dmtp-plan-label">End Time</span>
                            <span class="dmtp-plan-value">03:30 PM</span>
                        </div>
                        <div class="dmtp-plan-item">
                            <span class="dmtp-plan-label">Duration</span>
                            <span class="dmtp-plan-value">5 hours 30 Minutes</span>
                        </div>
                    </div>
                </div>

                <!-- Approved CSR-1 Focus Details -->
                <div class="dmtp-card">
                    <h3 class="dmtp-card-title">Focus Details (Approved CSR-1)</h3>
                    <div class="dmtp-plan-grid dmtp-review-grid-3">
                        @foreach (var group in CSR1FocusGroups)
                        {
                            <div class="dmtp-plan-item">
                                <span class="dmtp-plan-label">Crop @group.Number</span>
                                <span class="dmtp-plan-value">@(group.Items.Count > 0 ? Display(group.Items[0].CropName) : "-")</span>
                                <span class="dmtp-plan-label">Products</span>
                                <span class="dmtp-plan-value">@(group.Items.Count > 0 ? string.Join(", ", group.Items.Select(x => x.ProductName)) : "-")</span>
                            </div>
                        }
                    </div>
                </div>

                <!-- Attendance Summary -->
                <div class="dmtp-card">
                    <div class="dmtp-list-header">
                        <h3 class="dmtp-card-title dmtp-no-margin dmtp-center-title">Attendance Summary</h3>
                        <button type="button" class="dmtp-btn-edit-outline">Edit</button>
                    </div>
                    <div class="dmtp-attendance-grid">
                        <div class="dmtp-attendance-card dmtp-attendance-green">
                            <span class="dmtp-plan-label">Participants</span>
                            <span class="dmtp-attendance-value">128</span>
                        </div>
                        <div class="dmtp-attendance-card dmtp-attendance-blue">
                            <span class="dmtp-plan-label">SPIC Employees</span>
                            <span class="dmtp-attendance-value">128</span>
                        </div>
                        <div class="dmtp-attendance-card dmtp-attendance-orange">
                            <span class="dmtp-plan-label">Total Attendance</span>
                            <span class="dmtp-attendance-value">128</span>
                        </div>
                    </div>
                    <div class="dmtp-attendance-legend">
                        <span><span class="dmtp-legend-dot dmtp-legend-green"></span>Farmers: 96 (75%)</span>
                        <span><span class="dmtp-legend-dot dmtp-legend-blue"></span>Dealer: 96 (75%)</span>
                        <span><span class="dmtp-legend-dot dmtp-legend-purple"></span>Distributors: 96 (75%)</span>
                        <span><span class="dmtp-legend-dot dmtp-legend-orange"></span>Others 96 (75%)</span>
                    </div>
                </div>

                <!-- Photos and Videos -->
                <div class="dmtp-card">
                    <div class="dmtp-list-header">
                        <h3 class="dmtp-card-title dmtp-no-margin">Photos and Videos</h3>
                        <button type="button" class="dmtp-btn-edit-outline">Edit</button>
                    </div>
                    <div class="dmtp-review-photo-grid">
                        @foreach (var photo in eventPhotos)
                        {
                            <div class="dmtp-review-photo-card">
                                <div class="dmtp-review-photo-thumb" style="overflow:hidden;">
                                    <img src="@photo.PreviewUrl" alt="@photo.FileName" style="width:100%;height:100%;object-fit:cover;" />
                                </div>
                                <span class="dmtp-photo-filename">@photo.Caption</span>
                            </div>
                        }
                    </div>
                    @if (eventVideos.Count > 0)
                    {
                        <div class="dmtp-review-photo-grid mt-3">
                            @foreach (var video in eventVideos)
                            {
                                <div class="dmtp-review-photo-card" @key="video.Id">
                                    <div class="dmtp-review-photo-thumb" style="overflow:hidden;">
                                        @if (!string.IsNullOrEmpty(video.PreviewUrl))
                                        {
                                            <video controls playsinline preload="metadata" src="@video.PreviewUrl" style="width:100%;height:100%;object-fit:cover;"></video>
                                        }
                                        else
                                        {
                                            <span>Video preview unavailable</span>
                                        }
                                    </div>
                                    <span class="dmtp-photo-filename">@(!string.IsNullOrWhiteSpace(video.Caption) ? video.Caption : video.FileName)</span>
                                </div>
                            }
                        </div>
                    }
                    <div class="dmtp-review-photo-footer">
                        <span class="dmtp-review-selected">
                            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            @(eventPhotos.Count(x => x.UseInLibrary) + eventVideos.Count(x => x.UseInLibrary)) items selected for Digital Library
                        </span>
                        <span class="dmtp-review-viewall">View All</span>
                    </div>
                </div>

                <!-- Activities Conducted -->
                <div class="dmtp-card">
                    <div class="dmtp-list-header">
                        <h3 class="dmtp-card-title dmtp-no-margin">Activities Conducted</h3>
                        <button type="button" class="dmtp-btn-edit-outline">Edit</button>
                    </div>
                    <div class="dmtp-table-wrap">
                        <table class="dmtp-table">
                            <thead>
                                <tr>
                                    <th>S:NO</th>
                                    <th>Activities</th>
                                    <th>Start Time</th>
                                    <th>End Time</th>
                                    <th>Participants</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in activities)
                                {
                                    <tr>
                                        <td>@(activities.IndexOf(row) + 1)</td>
                                        <td>@row.Title</td>
                                        <td>@row.StartTime</td>
                                        <td>@row.EndTime</td>
                                        <td>@(row.Participants?.ToString() ?? "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Approved CSR-1 Planned Expense Breakdown -->
                <div class="dmtp-card">
                    <h3 class="dmtp-card-title">Planned Expense Breakdown (CSR-1)</h3>
                    <div class="dmtp-table-wrap">
                        <table class="dmtp-table">
                            <thead><tr><th>Expense Category</th><th>Planned (CSR-1)</th><th>Actual (CSR-2)</th></tr></thead>
                            <tbody>
                                @foreach (var item in CSR1PlannedExpenses)
                                {
                                    <tr><td>@item.Label</td><td>@Money(item.Amount)</td><td>@Money(expenseItems.FirstOrDefault(x => x.Label == item.Label)?.ActualAmount ?? 0m)</td></tr>
                                }
                                <tr class="dmtp-table-total-row"><td>Total</td><td>@Money(CSR1PlannedExpenses.Sum(x => x.Amount))</td><td>@Money(ActualExpenseTotal)</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            <!-- Bottom Action Bar -->
            @if (currentStep == 1)
            {
                <div class="dmtp-action-bar">
                    <span class="dmtp-action-note">Complete external planning to begin execution.</span>
                    <div class="dmtp-action-buttons">
                        <button type="button" class="dmtp-btn-not-organized">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="9" y1="15" x2="15" y2="9"></line></svg>
                            Not Organized
                        </button>
                        <button type="button" class="dmtp-btn-start-event" @onclick="OpenStartConfirm">
                            Start Event
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                        </button>
                    </div>
                </div>
            }
            else if (currentStep >= 2 && currentStep <= 4)
            {
                <div class="dmtp-action-bar">
                    <button type="button" class="dmtp-btn-previous" @onclick="GoPrevious">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="19 20 9 12 19 4 19 20"></polygon><line x1="5" y1="19" x2="5" y2="5"></line></svg>
                        Previous
                    </button>
                    <div class="dmtp-action-buttons">
                        <button type="button" class="dmtp-btn-save-draft">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
                            Save Draft
                        </button>
                        <button type="button" class="dmtp-btn-start-event" @onclick="GoNext">
                            Continue to @NextStepLabel()
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="13 17 18 12 13 7"></polyline><polyline points="6 17 11 12 6 7"></polyline></svg>
                        </button>
                    </div>
                </div>
            }
            else if (currentStep == 5)
            {
                <div class="dmtp-action-bar">
                    <span class="dmtp-action-note dmtp-action-note-success">All required information is complete. Ready to submit.</span>
                    <div class="dmtp-action-buttons">
                        <button type="button" class="dmtp-btn-not-organized">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
                            Request Approval
                        </button>
                        <button type="button" class="dmtp-btn-start-event">
                            Submit CSR-2
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                        </button>
                    </div>
                </div>
            }

        </div>
    </div>

}

<!-- Start Event Confirmation Modal -->
@if (showStartConfirm)
{
    <div class="dmtp-modal-overlay" @onclick="CloseStartConfirm">
        <div class="dmtp-modal" @onclick:stopPropagation="true">
            <div class="dmtp-modal-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6"></path><path d="M10 22h4"></path><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8a4.65 4.65 0 0 0 1.5 3.5c.76.76 1.23 1.52 1.41 2.5"></path></svg>
            </div>
            <h3>Start this program now?</h3>
            <p>The program status will change to In Progress and attendance will be unlocked</p>
            <div class="dmtp-modal-actions">
                <button type="button" class="dmtp-modal-btn-cancel" @onclick="CloseStartConfirm">Cancel</button>
                <button type="button" class="dmtp-modal-btn-confirm" @onclick="ConfirmStartEvent">Start Event</button>
            </div>
        </div>
    </div>
}


