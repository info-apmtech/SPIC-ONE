        // Keep the old working page-load behavior if this endpoint is unavailable
        // (for example during mixed-version deployment or authorization mismatch).
        try
        {
            using var response = await Http.GetAsync($"api/CSR2/workflow-mode/{csr1Id}");
            if (!response.IsSuccessStatusCode)
                return;

            var mode = await response.Content.ReadFromJsonAsync<CSR2WorkflowModeDto>();
            if (mode == null)
                return;

            csr2CutoffDay = mode.CSR2Day;
            csr2RequiresMultiLevelApproval = mode.RequiresMultiLevelApproval;
            csr2WorkflowScope = mode.Scope ?? "";
            if (!string.IsNullOrWhiteSpace(mode.Status))
                csr2Status = mode.Status;
            csr2WorkflowCanApply = mode.CanApply;
            csr2WorkflowCanValidate = mode.CanValidate;
            csr2WorkflowCanApprove = mode.CanApprove;
            csr2WorkflowActionLabel = mode.ActionLabel ?? "";
        }
        catch
        {
            // Do not fail CSR-2 page load only because workflow metadata could not be read.
            // Existing local role/status fallbacks below continue to control the UI.
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (CSR1Id.HasValue && CSR1Id == loadedCsr1Id && csr1Plan != null) return;
        isLoadingCSR1 = true;
        csr1Plan = null;
        csr1Error = "";
        loadedCsr1Id = null;
        if (CSR1Id is null or <= 0)
        {
            csr1Error = "Missing or invalid csr1Id in the page URL.";
            isLoadingCSR1 = false;
            return;
        }

        // Independent lookups are requested concurrently rather than serially.
        // Apply the draft only after CSR-1 has initialized the expense categories.
        var csr1Id = CSR1Id.Value;
        try
        {
            var planTask = Http.GetAsync($"api/CSR1/details/{csr1Id}");
            var displayTask = LoadCSR1DisplayDetailsAsync(csr1Id);
            var employeeTask = LoadEmployees();
            var cropsTask = LoadFocusLookups();
            var workflowTask = LoadCSR2WorkflowModeAsync(csr1Id);
            var draftTask = Http.GetAsync($"api/CSR2/by-csr1/{csr1Id}");

            using var response = await planTask;
            if (!response.IsSuccessStatusCode)
            {
                csr1Error = $"Unable to load CSR-1 #{csr1Id}. HTTP {(int)response.StatusCode}.";
                await displayTask;
                await employeeTask;
                await cropsTask;
                await workflowTask;
                using var ignoredDraft = await draftTask;
                return;
            }

            csr1Plan = await response.Content.ReadFromJsonAsync<CSR1DetailsDto>();
            if (csr1Plan == null)
                csr1Error = "CSR-1 details API returned no data.";
            else if (!string.Equals(csr1Plan.Status, "Approved", StringComparison.OrdinalIgnoreCase))
            {
                csr1Error = "CSR-2 can be opened only for an approved CSR-1.";
                csr1Plan = null;
            }

            await displayTask;
            await employeeTask;
            await cropsTask;
            await workflowTask;

            if (csr1Plan != null)
            {
                expenseItems.Clear();

                InitializeExpensesFromCSR1();

                actualEventDate =
