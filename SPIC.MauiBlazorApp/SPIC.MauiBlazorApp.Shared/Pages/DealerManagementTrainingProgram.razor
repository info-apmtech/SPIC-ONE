    private async Task SaveNewFarmerAsync()
    {
        newFarmerError = "";
        var name = newFarmerName.Trim();
        var mobile = newFarmerMobile.Trim();

        if (string.IsNullOrWhiteSpace(name))
        {
            newFarmerError = "Farmer name is required.";
            return;
        }
        if (mobile.Length != 10 || !mobile.All(char.IsDigit))
        {
            newFarmerError = "Enter a valid 10-digit mobile number.";
            return;
        }
        if (newFarmerStateId <= 0)
        {
            newFarmerError = "Please select State.";
            return;
        }
        if (newFarmerDistrictId <= 0)
        {
            newFarmerError = "Please select District.";
            return;
        }
        if (participants.Any(x => string.Equals(x.Phone, mobile, StringComparison.OrdinalIgnoreCase)))
        {
            newFarmerError = "This farmer mobile number is already in the participant list.";
            return;
        }

        double? latitude = null;
        double? longitude = null;
        if (!string.IsNullOrWhiteSpace(newFarmerLatitude))
        {
            if (!double.TryParse(newFarmerLatitude, NumberStyles.Float, CultureInfo.InvariantCulture, out var lat))
            {
                newFarmerError = "Enter a valid Latitude.";
                return;
            }
            latitude = lat;
        }
        if (!string.IsNullOrWhiteSpace(newFarmerLongitude))
        {
            if (!double.TryParse(newFarmerLongitude, NumberStyles.Float, CultureInfo.InvariantCulture, out var lng))
            {
                newFarmerError = "Enter a valid Longitude.";
                return;
            }
            longitude = lng;
        }

        savingNewFarmer = true;
        try
        {
            var request = new SasFarmerUpsertDto
            {
                Name = name,
                Mobile = mobile,
                Address1 = string.IsNullOrWhiteSpace(newFarmerAddress1) ? null : newFarmerAddress1.Trim(),
                Address2 = string.IsNullOrWhiteSpace(newFarmerAddress2) ? null : newFarmerAddress2.Trim(),
                Village = string.IsNullOrWhiteSpace(newFarmerVillage) ? null : newFarmerVillage.Trim(),
                Taluk = string.IsNullOrWhiteSpace(newFarmerTaluk) ? null : newFarmerTaluk.Trim(),
                StateId = newFarmerStateId,
                DistrictId = newFarmerDistrictId,
                PinCode = string.IsNullOrWhiteSpace(newFarmerPinCode) ? null : newFarmerPinCode.Trim(),
                Latitude = latitude,
                Longitude = longitude,
                SurveyNumber = string.IsNullOrWhiteSpace(newFarmerSurveyNumber) ? null : newFarmerSurveyNumber.Trim()
            };

            using var response = await Http.PostAsJsonAsync("api/Sas/farmers", request);
            if (!response.IsSuccessStatusCode)
            {
                var message = await response.Content.ReadAsStringAsync();
                newFarmerError = string.IsNullOrWhiteSpace(message)
                    ? $"Unable to save farmer. HTTP {(int)response.StatusCode}."
                    : message.Trim('"');
                return;
            }

            var saved = await response.Content.ReadFromJsonAsync<SasFarmerDto>();
            if (saved == null || saved.Id <= 0)
            {
                newFarmerError = "Farmer was created but returned without a valid farmer ID.";
                return;
            }

            var savedName = saved.Name ?? name;
            var savedMobile = saved.Mobile ?? mobile;

            participants.Add(new PersonInfo
            {
                Id = nextParticipantId++,
                ParticipantSourceId = saved.Id,
                ParticipantSource = "SasFarmers",
                Name = savedName,
                Phone = savedMobile,
                Role = "Farmer",
                Initials = GetInitials(savedName)
            });

            participantPage = ParticipantPageCount;
            participantName = "";
            participantPhone = "";
            participantRole = "";
            editingParticipantId = null;
            newFarmerOpen = false;
            ShowCsr2Alert("Farmer saved successfully and added to the participant list.", false, "Success");
        }
        catch (Exception ex)
        {
            newFarmerError = $"Unable to save farmer: {ex.Message}";
        }
        finally
        {
            savingNewFarmer = false;
        }
    }

    private async Task OnParticipantPhoneInput(ChangeEventArgs e)
    {
        participantPhone = new string(
            (e.Value?.ToString() ?? "")
            .Where(char.IsDigit)
            .Take(10)
            .ToArray());

        participantPhoneMatches.Clear();

        // Phone changed, so previous Farmer / Dealer mapping is no longer valid.
        participantSourceId = null;
        participantSource = "";

        if (editingParticipantId is null)
        {
            participantName = "";
            participantRole = "";
        }

        // Increment instead of cancelling the HTTP request.
        var searchVersion = ++participantPhoneSearchVersion;
        var searchPhone = participantPhone;

        if (searchPhone.Length < 3)
        {
            participantPhoneLookupOpen = false;
            participantPhoneSearching = false;
            return;
        }

        participantPhoneLookupOpen = true;
        participantPhoneSearching = true;

        try
        {
            // Debounce.
            await Task.Delay(250);

            // User typed something else while waiting.
            if (searchVersion != participantPhoneSearchVersion)
                return;

            var result =
                await Http.GetFromJsonAsync<List<ParticipantPhoneLookupDto>>(
                    $"api/CSR2/participant-mobile-search?term={Uri.EscapeDataString(searchPhone)}");

            // Ignore an old response if the user has typed another digit.
            if (searchVersion != participantPhoneSearchVersion)
                return;

            participantPhoneMatches.Clear();

            if (result != null)
                participantPhoneMatches.AddRange(result);

            // No Farmer / Dealer found for complete 10-digit number.
            // Keep existing Other participant logic.
            if (searchPhone.Length == 10 &&
                participantPhoneMatches.Count == 0)
            {
                participantSourceId = null;
                participantSource = "";
                participantRole = "Other";
                participantPhoneLookupOpen = false;
            }
        }
        catch (Exception ex)
        {
            // Ignore result if another search has already started.
            if (searchVersion != participantPhoneSearchVersion)
                return;

            participantPhoneMatches.Clear();

            participantError =
                $"Unable to search participant mobile number: {ex.Message}";
        }
        finally
        {
            if (searchVersion == participantPhoneSearchVersion)
                participantPhoneSearching = false;
        }
    }

    private void OpenParticipantPhoneSuggestions()
    {
        if (participantPhone.Length >= 3)
            participantPhoneLookupOpen = true;
    }

    private void SelectParticipantPhoneMatch(ParticipantPhoneLookupDto match)
    {
        participantSourceId = match.SourceId;
        participantSource = match.Source;
        participantPhone = match.Mobile;
