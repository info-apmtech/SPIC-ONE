    private async Task UploadOrUpdateMedia(int serverId, byte[] bytes, string fileName, string mediaType, string caption, string contentType, Action<int> setId)
    {
        if (serverId > 0)
        {
            await UpdateMediaCaption(serverId, caption);
            return;
        }
        if (bytes.Length == 0) return;
        using var form = new MultipartFormDataContent();
        using var content = new ByteArrayContent(bytes);
        content.Headers.ContentType = MediaTypeHeaderValue.Parse(!string.IsNullOrWhiteSpace(contentType) ? contentType : (mediaType == "Photo" ? "image/jpeg" : "video/mp4"));
        form.Add(content, "file", fileName);
        form.Add(new StringContent(mediaType), "mediaType");
        form.Add(new StringContent(caption ?? ""), "caption");
        using var reply = await Http.PostAsync($"api/CSR2/{csr2DbId}/media", form);
        if (!reply.IsSuccessStatusCode) throw new Exception($"{mediaType} upload failed: {await reply.Content.ReadAsStringAsync()}");
        using var doc = System.Text.Json.JsonDocument.Parse(await reply.Content.ReadAsStringAsync());
        setId(doc.RootElement.GetProperty("id").GetInt32());
    }

    private async Task UpdateMediaCaption(int serverId, string caption)
    {
        using var patch = await Http.PatchAsJsonAsync($"api/CSR2/media/{serverId}", new CSR2MediaDto { Caption = caption });
        if (!patch.IsSuccessStatusCode) throw new Exception($"Media update failed: HTTP {(int)patch.StatusCode}");
    }
    // Required before any draft save or submission. Do not call the API for incomplete event details.
    private bool ValidateRequiredEventDetails()
    {
        string? message = null;
        if (!actualEventDate.HasValue)
            message = "Please select Actual Event Date.";
        else if (!startTime.HasValue)
            message = "Please select Start Time.";
        else if (!endTime.HasValue)
            message = "Please select End Time.";
        else if (endTime.Value <= startTime.Value)
            message = "End Time must be later than Start Time.";
        else if (string.IsNullOrWhiteSpace(eventCoordinatorId))
            message = "Please select Event Coordinator.";
        else if (string.IsNullOrWhiteSpace(actualLocation))
            message = "Please enter Actual Location.";

        if (message == null) return true;
        csr2SaveError = true;
        csr2SaveMessage = message;
        ShowCsr2Alert(message);
        return false;
    }
    private bool ValidateSaveDraftMandatoryFields()
    {
        // First validate mandatory event details.
        if (!ValidateRequiredEventDetails())
            return false;

        string? message = null;

        // At least one photo is mandatory.
        if (eventPhotos.Count == 0)
        {
            message = "Please upload at least one Event Photo.";
        }
        // At least one video is mandatory.
        else if (eventVideos.Count == 0)
        {
            message = "Please upload at least one Event Video.";
        }
        // At least one participant is mandatory.
        else if (participants.Count == 0)
        {
            message = "Please add at least one Participant.";
        }
        // At least one SPIC employee is mandatory.
        else if (employees.Count == 0)
        {
            message = "Please add at least one SPIC Employee.";
        }

        if (message == null)
            return true;

        csr2SaveError = true;
        csr2SaveMessage = message;
        ShowCsr2Alert(message);

        return false;
    }
    private async Task SaveCSR2Draft(bool showSuccess = true)
    {
        if (savingCSR2) return;
        if (!CanEditCurrentCSR2)
        {
            csr2SaveError = true;
            csr2SaveMessage = "You are not allowed to edit this CSR-2 at the current workflow stage.";
            ShowCsr2Alert(csr2SaveMessage);
            return;
        }
        if (!ValidateSaveDraftMandatoryFields()) return;
        savingCSR2 = true;
        csr2SaveError = false;
        csr2SaveMessage = csr2Status == "Draft" ? "Saving CSR-2 draft..." : "Saving CSR-2 changes...";
        try
        {
            await SaveCSR2DraftInternal();
            csr2SaveMessage = csr2Status == "Draft" ? "CSR-2 draft saved successfully." : "CSR-2 changes saved successfully.";
            if (showSuccess) ShowCsr2Alert(csr2SaveMessage, false);
        }
        catch (Exception ex)
        {
            csr2SaveError = true;
            csr2SaveMessage = ex.Message;
            ShowCsr2Alert(csr2SaveMessage);
        }
        finally { savingCSR2 = false; }
    }
    private async Task SubmitCSR2()
    {
        string endpoint;
        string successMessage;

        if (CanApplyCurrentCSR2)
        {
            endpoint = "submit";
            successMessage = csr2RequiresMultiLevelApproval
                ? "CSR-2 applied successfully and sent for Level 1 approval."
                : "CSR-2 applied successfully and sent for validation.";
        }
        else if (CanValidateCurrentCSR2)
        {
            endpoint = "validate";
            successMessage = "CSR-2 validated successfully.";
        }
        else if (CanApproveCurrentCSR2)
        {
            endpoint = "approve";
            successMessage = csr2RequiresMultiLevelApproval
                ? $"{CurrentApprovalButtonText} completed successfully."
                : "CSR-2 approved successfully.";
        }
        else
        {
            ShowCsr2Alert("You are not authorized to perform the current CSR-2 workflow action.");
            return;
        }

        // Save the latest editable data before EVERY workflow action.
        // Apply, Validate, normal Approval, Level 1, Level 2 and Level 3 all persist
        // reviewer/approver edits first; the workflow endpoint then changes status/audit fields.
        if (CanEditCurrentCSR2)
        {
            await SaveCSR2Draft(false);
            if (csr2SaveError || csr2DbId is null) return;
        }
        else if (csr2DbId is null)
        {
            ShowCsr2Alert("Unable to perform workflow action because CSR-2 ID is missing.");
            return;
        }

        savingCSR2 = true;
        try
        {
            using var response = await Http.PostAsync($"api/CSR2/{csr2DbId}/{endpoint}", null);
            if (!response.IsSuccessStatusCode)
                throw new Exception(await response.Content.ReadAsStringAsync());

            using var json = System.Text.Json.JsonDocument.Parse(await response.Content.ReadAsStringAsync());
            if (json.RootElement.TryGetProperty("status", out var statusElement) ||
                json.RootElement.TryGetProperty("Status", out statusElement))
            {
                csr2Status = statusElement.GetString() ?? csr2Status;
            }

            if (json.RootElement.TryGetProperty("requiresMultiLevelApproval", out var multiElement) ||
                json.RootElement.TryGetProperty("RequiresMultiLevelApproval", out multiElement))
            {
                csr2RequiresMultiLevelApproval = multiElement.GetBoolean();
            }

            // Apply's actual workflow is known only after SubmittedAt is stamped by the API.
            if (endpoint == "submit")
            {
                successMessage = csr2RequiresMultiLevelApproval
                    ? "CSR-2 applied successfully and sent for Level 1 approval."
                    : "CSR-2 applied successfully and sent for validation.";
            }

            // Refresh server-authoritative permissions for the next workflow stage.
            if (CSR1Id.HasValue && CSR1Id.Value > 0)
                await LoadCSR2WorkflowModeAsync(CSR1Id.Value);

            csr2SaveMessage = successMessage;
            ShowCsr2Alert(csr2SaveMessage, false);
        }
        catch (Exception ex)
        {
            csr2SaveError = true;
            csr2SaveMessage = $"Workflow action failed: {ex.Message}";
            ShowCsr2Alert(csr2SaveMessage);
        }
        finally { savingCSR2 = false; }
    }

}
