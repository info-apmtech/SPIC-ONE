    private void PrefillFocusFromCSR1()
    {
        if (csr1Plan == null) return;

        foreach (var group in csr2FocusGroups)
        {
            group.CropIds.Clear();
            group.ProductIds.Clear();
        }

        var group1 = csr2FocusGroups.First(x => x.GroupNumber == 1);
        var group2 = csr2FocusGroups.First(x => x.GroupNumber == 2);
        var group3 = csr2FocusGroups.First(x => x.GroupNumber == 3);

        if (csr1Plan.Focus1 != null)
        {
            group1.CropIds.AddRange(csr1Plan.Focus1.Select(x => x.CropId).Where(x => x > 0).Distinct().Take(3));
            group1.ProductIds.AddRange(csr1Plan.Focus1.Select(x => x.ProductId).Where(x => x > 0).Distinct().Take(3));
        }

        if (csr1Plan.Focus2 != null)
        {
            group2.CropIds.AddRange(csr1Plan.Focus2.Select(x => x.CropId).Where(x => x > 0).Distinct().Take(3));
            group2.ProductIds.AddRange(csr1Plan.Focus2.Select(x => x.ProductId).Where(x => x > 0).Distinct().Take(3));
        }

        if (csr1Plan.Focus3 != null)
        {
            group3.CropIds.AddRange(csr1Plan.Focus3.Select(x => x.CropId).Where(x => x > 0).Distinct().Take(3));
            group3.ProductIds.AddRange(csr1Plan.Focus3.Select(x => x.ProductId).Where(x => x > 0).Distinct().Take(3));
        }
    }
    private void AddFocusCrop(EditableFocusGroup group, string? value)
    {
        if (!CanEditCurrentCSR2) return;
        if (!int.TryParse(value, out var id) || id <= 0 || group.CropIds.Contains(id) || group.CropIds.Count >= 3) return;
        group.CropIds.Add(id);
    }
    private void RemoveFocusCrop(EditableFocusGroup group, int id)
    {
        if (!CanEditCurrentCSR2) return;
        group.CropIds.Remove(id);
        if (group.CropIds.Count == 0) group.ProductIds.Clear();
    }
    private void AddFocusProduct(EditableFocusGroup group, string? value)
    {
        if (!CanEditCurrentCSR2) return;
        if (group.CropIds.Count == 0 || !int.TryParse(value, out var id) || id <= 0 || group.ProductIds.Contains(id) || group.ProductIds.Count >= 3) return;
        group.ProductIds.Add(id);
    }
    private void RemoveFocusProduct(EditableFocusGroup group, int id) { if (!CanEditCurrentCSR2) return; group.ProductIds.Remove(id); }

    private CSR2SaveDto BuildCSR2SaveDto()
    {
        var group1 = csr2FocusGroups.First(x => x.GroupNumber == 1);
        var group2 = csr2FocusGroups.First(x => x.GroupNumber == 2);
        var group3 = csr2FocusGroups.First(x => x.GroupNumber == 3);

        return new CSR2SaveDto
        {
            Id = csr2DbId,
            CSR1Id = CSR1Id ?? 0,
            ActualEventDate = actualEventDate,
            StartTime = startTime,
            EndTime = endTime,
            EventCoordinatorEmployeeId = string.IsNullOrWhiteSpace(eventCoordinatorId)
                ? null
                : eventCoordinatorId,
            ActualLocation = string.IsNullOrWhiteSpace(actualLocation)
                ? null
                : actualLocation,
            ExpectedParticipantsCount = expectedParticipantsCount,

            Products1 = new CSR2FocusGroupDto
            {
                CropId = group1.CropIds.Where(x => x > 0).Distinct().Take(3).ToArray(),
                ProductId = group1.ProductIds.Where(x => x > 0).Distinct().Take(3).ToArray()
            },
            Products2 = new CSR2FocusGroupDto
            {
                CropId = group2.CropIds.Where(x => x > 0).Distinct().Take(3).ToArray(),
                ProductId = group2.ProductIds.Where(x => x > 0).Distinct().Take(3).ToArray()
            },
            Products3 = new CSR2FocusGroupDto
            {
                CropId = group3.CropIds.Where(x => x > 0).Distinct().Take(3).ToArray(),
                ProductId = group3.ProductIds.Where(x => x > 0).Distinct().Take(3).ToArray()
            },

            Participants = participants.Select(x => new CSR2ParticipantDto
            {
                ParticipantSourceId = x.ParticipantSourceId,
                ParticipantSource = string.IsNullOrWhiteSpace(x.ParticipantSource)
                    ? null
                    : x.ParticipantSource,
                Role = x.Role,
                Name = x.Name,
                PhoneNumber = x.Phone
            }).ToList(),

            Employees = employees
                .Where(x => !string.IsNullOrWhiteSpace(x.UserId))
                .Select(x => new CSR2EmployeeDto
                {
                    EmployeeInformationId = x.UserId,
                    RoleName = x.Role,
                    EmployeeName = x.Name,
                    PhoneNumber = x.Phone
                })
                .ToList(),

            // Send only expense rows where an actual amount was entered.
            // Blank/null/zero expense categories are display-only and are not persisted.
            Expenses = expenseItems
                .Where(x => x.ActualAmount.HasValue && x.ActualAmount.Value > 0)
                .Select(x => new CSR2ExpenseDto
                {
                    Id = x.Id,
                    ExpenseInformationId = x.ExpenseId,
                    ExpenseName = x.Label,
                    ActualAmount = x.ActualAmount,
                    ExpenseDate = x.ExpenseDate,
                    BillNo = string.IsNullOrWhiteSpace(x.BillNo) ? null : x.BillNo.Trim()
                })
                .ToList()
        };
    }

    private async Task ApplyCSR2DraftResponse(HttpResponseMessage response)
    {
        if (response.StatusCode == System.Net.HttpStatusCode.NotFound) return;
        if (!response.IsSuccessStatusCode)
        {
            csr2SaveError = true;
            csr2SaveMessage = $"Unable to load CSR-2: HTTP {(int)response.StatusCode}";
            ShowCsr2Alert(csr2SaveMessage);
            return;
        }

        var saved = await response.Content.ReadFromJsonAsync<CSR2DetailsDto>();
        if (saved is null) return;

        csr2DbId = saved.Id;
        csr2Status = saved.Status;
        expectedParticipantsCount = saved.ExpectedParticipantsCount;
        actualEventDate = csr1Plan?.CSR1Date;
        startTime = saved.StartTime;
        endTime = saved.EndTime;
        eventCoordinatorId = saved.EventCoordinatorEmployeeId
            ?? csr1Plan?.ResponsiblePersonId
            ?? "";
        actualLocation = saved.ActualLocation ?? "";

        // Restore the three persisted CSR-2 focus groups.
        foreach (var focus in csr2FocusGroups)
        {
            focus.CropIds.Clear();
            focus.ProductIds.Clear();
        }

        void ApplyFocusGroup(int groupNumber, CSR2FocusGroupDto? source)
        {
            if (source == null) return;

            var target = csr2FocusGroups.First(x => x.GroupNumber == groupNumber);
            target.CropIds.AddRange((source.CropId ?? Array.Empty<int>())
                .Where(x => x > 0)
                .Distinct()
                .Take(3));
            target.ProductIds.AddRange((source.ProductId ?? Array.Empty<int>())
                .Where(x => x > 0)
                .Distinct()
                .Take(3));
        }

        ApplyFocusGroup(1, saved.Products1);
        ApplyFocusGroup(2, saved.Products2);
        ApplyFocusGroup(3, saved.Products3);

        participants.Clear();
        foreach (var item in saved.Participants)
        {
            var displayName = item.Name ?? "";
            participants.Add(new PersonInfo
            {
                Id = nextParticipantId++,
                ParticipantSourceId = item.ParticipantSourceId,
                ParticipantSource = item.ParticipantSource ?? "",
                Name = displayName,
                Phone = item.PhoneNumber ?? "",
                Role = item.Role,
                Initials = GetInitials(displayName)
            });
        }

        employees.Clear();
        foreach (var item in saved.Employees)
        {
            var lookupEmployee = employeeList.FirstOrDefault(e =>
                string.Equals(e.UserId, item.EmployeeInformationId, StringComparison.OrdinalIgnoreCase));

            var employeeName = !string.IsNullOrWhiteSpace(item.EmployeeName)
                ? item.EmployeeName
                : lookupEmployee?.Name ?? "";

            var employeePhone = !string.IsNullOrWhiteSpace(item.PhoneNumber)
                ? item.PhoneNumber
                : !string.IsNullOrWhiteSpace(lookupEmployee?.OfficialPhoneNumber)
                    ? lookupEmployee!.OfficialPhoneNumber!
                    : lookupEmployee?.PersonalPhoneNumber ?? "";

            employees.Add(new PersonInfo
            {
                Id = lookupEmployee?.Id ?? 0,
                UserId = item.EmployeeInformationId,
                Name = employeeName,
                Phone = employeePhone,
                Role = item.RoleName,
                Initials = GetInitials(employeeName)
            });
        }

        // Rebuild actual expense rows. Multiple CSR2Expense rows can reference
        // the same ExpenseInformationId and each row owns its own proof collection.
        var templates = expenseItems
            .GroupBy(x => x.ExpenseId)
            .Select(g => g.First())
            .ToDictionary(x => x.ExpenseId);

        expenseItems.Clear();
        var plannedExpenses = CSR1PlannedExpenses;
        for (var plannedIndex = 0; plannedIndex < plannedExpenses.Count; plannedIndex++)
        {
            var planned = plannedExpenses[plannedIndex];
            var savedRows = saved.Expenses
                .Where(x => x.ExpenseInformationId == planned.ExpenseId)
                .OrderBy(x => x.Id)
                .ToList();

            var icon = templates.TryGetValue(planned.ExpenseId, out var template)
                ? template.Icon
                : ExpenseIcons[plannedIndex % ExpenseIcons.Length];
            var iconClass = templates.TryGetValue(planned.ExpenseId, out template)
                ? template.IconClass
                : ExpenseIconClasses[plannedIndex % ExpenseIconClasses.Length];

            if (savedRows.Count == 0)
            {
                expenseItems.Add(new ExpenseItem
                {
                    ExpenseId = planned.ExpenseId,
                    Label = planned.Label,
                    PlannedAmount = planned.Amount,
                    Icon = icon,
                    IconClass = iconClass
                });
                continue;
            }

            foreach (var item in savedRows)
            {
                expenseItems.Add(new ExpenseItem
                {
                    Id = item.Id,
                    ExpenseId = item.ExpenseInformationId,
                    Label = !string.IsNullOrWhiteSpace(item.ExpenseName)
                        ? item.ExpenseName
                        : planned.Label,
                    PlannedAmount = planned.Amount,
                    ActualAmount = item.ActualAmount,
                    ExpenseDate = item.ExpenseDate,
                    BillNo = item.BillNo ?? "",
                    Icon = icon,
                    IconClass = iconClass,
                    Proofs = item.Proofs.Select(p => new ExpenseProofItem
                    {
                        ProofId = p.Id,
                        FileName = p.OriginalFileName
                    }).ToList()
                });
            }
        }

        eventPhotos.Clear();
        eventVideos.Clear();
        triedSavedPhotoPreviews.Clear();
        foreach (var file in saved.Media)
        {
            var url = $"api/CSR2/media/{file.Id}/file";
            if (file.MediaType == "Photo")
                eventPhotos.Add(new PhotoItem
                {
                    ServerId = file.Id,
                    FileName = file.OriginalFileName,
                    Caption = file.Caption ?? "",
                    PreviewUrl = ""
                });

            if (file.MediaType == "Video")
                eventVideos.Add(new VideoItem
                {
                    ServerId = file.Id,
                    FileName = file.OriginalFileName,
                    Caption = file.Caption ?? "",
                    PreviewUrl = url,
                    SavedFileSize = file.FileSizeBytes
                });
        }

        if (saved.Status != "Draft")
            csr2SaveMessage = $"CSR-2 status: {saved.Status}";
    }

    // Protected API images cannot reliably be rendered with <img src="api/..."> when
    // authentication is attached to HttpClient requests (e.g. bearer authorization).
    // Load saved photo bytes only when the user opens the media or review step.
    // No file bytes are added to the CSR-2 JSON response.
    private bool loadingSavedPhotoPreviews;
    private readonly HashSet<int> triedSavedPhotoPreviews = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (currentStep != 1 && currentStep != 4) return;
        if (loadingSavedPhotoPreviews) return;
        var pending = eventPhotos.Where(p => p.ServerId > 0 &&
            string.IsNullOrWhiteSpace(p.PreviewUrl) && !triedSavedPhotoPreviews.Contains(p.ServerId)).ToList();
        if (pending.Count == 0) return;

        loadingSavedPhotoPreviews = true;
        try
        {
            foreach (var photo in pending)
            {
                triedSavedPhotoPreviews.Add(photo.ServerId);
                try
                {
                    // The existing injected HttpClient carries the application's auth setup.
                    using var reply = await Http.GetAsync($"api/CSR2/media/{photo.ServerId}/file",
                        System.Net.Http.HttpCompletionOption.ResponseHeadersRead);
                    if (!reply.IsSuccessStatusCode)
                    {
                        photo.PreviewError = $"Photo unavailable (HTTP {(int)reply.StatusCode}).";
                        continue;
                    }
                    var length = reply.Content.Headers.ContentLength;
                    if (length.HasValue && length.Value > MaxPhotoBytes)
                    {
                        photo.PreviewError = "Photo exceeds the preview size limit.";
                        continue;
                    }
                    await using var source = await reply.Content.ReadAsStreamAsync();
                    using var buffer = new MemoryStream();
                    var chunk = new byte[64 * 1024];
                    int count;
                    while ((count = await source.ReadAsync(chunk.AsMemory())) > 0)
                    {
                        if (buffer.Length + count > MaxPhotoBytes)
                            throw new InvalidDataException("Photo exceeds the preview size limit.");
                        await buffer.WriteAsync(chunk.AsMemory(0, count));
                    }
                    var type = reply.Content.Headers.ContentType?.MediaType;
                    if (type != "image/png" && type != "image/jpeg")
                    {
                        photo.PreviewError = "Unsupported saved photo format.";
                        continue;
                    }
                    photo.PreviewUrl = $"data:{type};base64,{Convert.ToBase64String(buffer.ToArray())}";
                    photo.PreviewError = null;
                }
                catch (Exception ex)
                {
                    photo.PreviewError = $"Unable to load photo: {ex.Message}";
                }
                await InvokeAsync(StateHasChanged);
            }
        }
        finally
        {
            loadingSavedPhotoPreviews = false;
        }
    }

    private async Task<bool> SaveCSR2DraftInternalOLD()
    {
        if (csr2DbId.HasValue && csr2DbId.Value > 0)
        {
            foreach (var proofId in removedProofIds.Distinct().ToList())
            {
                using var delete = await Http.DeleteAsync($"api/CSR2/proof/{proofId}");
                if (!delete.IsSuccessStatusCode &&
                    delete.StatusCode != System.Net.HttpStatusCode.NotFound)
                {
                    throw new Exception($"Remove expense proof failed: HTTP {(int)delete.StatusCode}");
                }
            }
            removedProofIds.Clear();
        }

        using var response = await Http.PostAsJsonAsync("api/CSR2/save-draft", BuildCSR2SaveDto());
        if (!response.IsSuccessStatusCode)
            throw new Exception($"Save draft failed: HTTP {(int)response.StatusCode} - {await response.Content.ReadAsStringAsync()}");

        var saved = await response.Content.ReadFromJsonAsync<CSR2SaveResultDto>();
        if (saved == null || saved.Id <= 0)
            throw new Exception("CSR-2 save API returned an invalid response.");

        csr2DbId = saved.Id;

        // Match generated CSR2Expense IDs only for rows that were actually saved.
        // Blank/null/zero amount rows do not exist in CSR2Expenses and must not require an ID.
        var unmatchedServerRows = saved.Expenses.ToList();
        foreach (var row in expenseItems
            .Where(x => x.ActualAmount.HasValue && x.ActualAmount.Value > 0))
        {
            if (row.Id.HasValue && row.Id.Value > 0)
            {
                unmatchedServerRows.RemoveAll(x => x.Id == row.Id.Value);
                continue;
            }

            var match = unmatchedServerRows.FirstOrDefault(x =>
                x.ExpenseInformationId == row.ExpenseId &&
                x.ActualAmount == row.ActualAmount &&
                string.Equals(x.BillNo ?? "", row.BillNo?.Trim() ?? "", StringComparison.OrdinalIgnoreCase) &&
                x.ExpenseDate == row.ExpenseDate);

            match ??= unmatchedServerRows.FirstOrDefault(x =>
                x.ExpenseInformationId == row.ExpenseId);

            if (match == null)
                throw new Exception($"Unable to resolve saved expense row ID for {row.Label}.");

            row.Id = match.Id;
            unmatchedServerRows.Remove(match);
        }

        // Any UI row with no entered amount should not retain a stale database ID.
        foreach (var row in expenseItems
            .Where(x => !x.ActualAmount.HasValue || x.ActualAmount.Value <= 0))
        {
            row.Id = null;
        }

        foreach (var mediaId in removedMediaIds.Distinct().ToList())
        {
            using var delete = await Http.DeleteAsync($"api/CSR2/media/{mediaId}");
            if (!delete.IsSuccessStatusCode &&
                delete.StatusCode != System.Net.HttpStatusCode.NotFound)
            {
                throw new Exception($"Remove media failed: HTTP {(int)delete.StatusCode}");
            }
        }
        removedMediaIds.Clear();

        foreach (var photo in eventPhotos)
        {
            await UploadOrUpdateMedia(
                photo.ServerId,
                photo.Bytes,
                photo.FileName,
                "Photo",
                photo.Caption,
                photo.ContentType,
                id =>
                {
                    photo.ServerId = id;
                    photo.Bytes = Array.Empty<byte>();
                });
        }

        foreach (var video in eventVideos)
        {
            await UploadOrUpdateMedia(
                video.ServerId,
                video.Bytes,
                video.FileName,
                "Video",
                video.Caption,
                video.ContentType,
                id =>
                {
                    video.ServerId = id;
                    video.SavedFileSize = video.Bytes.LongLength;
                    video.Bytes = Array.Empty<byte>();
                });
        }

        foreach (var item in expenseItems)
        {
            if (!item.Id.HasValue || item.Id.Value <= 0)
                continue;

            foreach (var proof in item.Proofs.Where(x => x.Bytes.Length > 0).ToList())
            {
                using var form = new MultipartFormDataContent();
                using var content = new ByteArrayContent(proof.Bytes);
                content.Headers.ContentType = MediaTypeHeaderValue.Parse(
                    string.IsNullOrWhiteSpace(proof.ContentType)
                        ? "application/octet-stream"
                        : proof.ContentType);
                form.Add(content, "file", proof.FileName);

                using var proofResponse = await Http.PostAsync(
                    $"api/CSR2/{csr2DbId.Value}/expenses/{item.Id.Value}/proof",
                    form);

                if (!proofResponse.IsSuccessStatusCode)
                {
                    throw new Exception(
                        $"Proof upload failed ({item.Label} / {proof.FileName}): {await proofResponse.Content.ReadAsStringAsync()}");
                }

                var result = await proofResponse.Content.ReadFromJsonAsync<ExpenseProofUploadResultDto>();
                if (result == null || result.Id <= 0)
                    throw new Exception($"Invalid proof upload response for {proof.FileName}.");

                proof.ProofId = result.Id;
                proof.Bytes = Array.Empty<byte>();
            }
        }

        return true;
    }

    private async Task<bool> SaveCSR2DraftInternal()
    {
        if (csr2DbId.HasValue && csr2DbId.Value > 0)
        {
            foreach (var proofId in removedProofIds.Distinct().ToList())
            {
                using var delete = await Http.DeleteAsync($"api/CSR2/proof/{proofId}");

                if (!delete.IsSuccessStatusCode &&
                    delete.StatusCode != System.Net.HttpStatusCode.NotFound)
                {
