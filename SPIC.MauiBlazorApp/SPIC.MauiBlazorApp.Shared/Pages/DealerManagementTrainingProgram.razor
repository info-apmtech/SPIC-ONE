            ActualAmount = x.ActualAmount,
            ExpenseDate = x.ExpenseDate
        }).ToList()
    };

    private async Task ApplyCSR2DraftResponse(HttpResponseMessage response)
    {
        if (response.StatusCode == System.Net.HttpStatusCode.NotFound) return;
        if (!response.IsSuccessStatusCode) { csr2SaveError = true; csr2SaveMessage = $"Unable to load CSR-2: HTTP {(int)response.StatusCode}"; ShowCsr2Alert(csr2SaveMessage); return; }
        var saved = await response.Content.ReadFromJsonAsync<CSR2DetailsDto>();
        if (saved is null) return;
        csr2DbId = saved.Id;
        csr2Status = saved.Status;
        expectedParticipantsCount = saved.ExpectedParticipantsCount;
        actualEventDate = saved.ActualEventDate; startTime = saved.StartTime; endTime = saved.EndTime;
        eventCoordinatorId = saved.EventCoordinatorEmployeeId ?? 0; actualLocation = saved.ActualLocation ?? "";
        participants.Clear();
        foreach (var item in saved.Participants) participants.Add(new PersonInfo { Id = nextParticipantId++, Name = item.Name, Phone = item.PhoneNumber ?? "", Role = item.Role, Initials = GetInitials(item.Name) });
        employees.Clear();
        foreach (var item in saved.Employees) employees.Add(new PersonInfo { Id = item.EmployeeInformationId, Name = item.EmployeeName, Phone = item.PhoneNumber ?? "", Role = item.RoleName, Initials = GetInitials(item.EmployeeName) });
        activities.Clear();
        foreach (var item in saved.Activities.OrderBy(x => x.SortOrder)) activities.Add(new ActivityItem
        {
            Title = item.ActivityName,
            StartTime = item.StartTime.ToString("HH:mm", CultureInfo.InvariantCulture),
            EndTime = item.EndTime.ToString("HH:mm", CultureInfo.InvariantCulture),
            Participants = item.ParticipantsCount,
            Description = item.Description,
            Remarks = item.Remarks ?? ""
        });
        foreach (var item in saved.Expenses)
        {
            var row = expenseItems.FirstOrDefault(x => x.Key == item.CategoryKey);
            if (row is null) continue;
            row.ActualAmount = item.ActualAmount; row.ExpenseDate = item.ExpenseDate;
            row.ProofId = item.ProofId; row.ProofFileName = item.ProofFileName ?? "";
        }
        eventPhotos.Clear(); eventVideos.Clear();
        triedSavedPhotoPreviews.Clear();
        foreach (var file in saved.Media)
        {
            var url = $"api/CSR2/media/{file.Id}/file";
            if (file.MediaType == "Photo") eventPhotos.Add(new PhotoItem { ServerId = file.Id, FileName = file.OriginalFileName, Caption = file.Caption ?? "", UseInLibrary = file.UseInDigitalLibrary, PreviewUrl = "" });
            if (file.MediaType == "Video") eventVideos.Add(new VideoItem { ServerId = file.Id, FileName = file.OriginalFileName, Caption = file.Caption ?? "", UseInLibrary = file.UseInDigitalLibrary, PreviewUrl = url, SavedFileSize = file.FileSizeBytes });
        }
        if (saved.Status != "Draft") { csr2SaveMessage = $"CSR-2 status: {saved.Status}"; }
    }

    // Protected API images cannot reliably be rendered with <img src="api/..."> when
    // authentication is attached to HttpClient requests (e.g. bearer authorization).
    // Load saved photo bytes only when the user opens the media or review step.
    // No file bytes are added to the CSR-2 JSON response.
    private bool loadingSavedPhotoPreviews;
    private readonly HashSet<int> triedSavedPhotoPreviews = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (currentStep != 2 && currentStep != 5) return;
        if (loadingSavedPhotoPreviews) return;
        var pending = eventPhotos.Where(p => p.ServerId > 0 &&
            string.IsNullOrWhiteSpace(p.PreviewUrl) && !triedSavedPhotoPreviews.Contains(p.ServerId)).ToList();
        if (pending.Count == 0) return;

        loadingSavedPhotoPreviews = true;
        try
        {
            foreach (var photo in pending)
            {
                triedSavedPhotoPreviews.Add(photo.ServerId);
                try
                {
                    // The existing injected HttpClient carries the application's auth setup.
                    using var reply = await Http.GetAsync($"api/CSR2/media/{photo.ServerId}/file",
                        System.Net.Http.HttpCompletionOption.ResponseHeadersRead);
                    if (!reply.IsSuccessStatusCode)
                    {
                        photo.PreviewError = $"Photo unavailable (HTTP {(int)reply.StatusCode}).";
                        continue;
                    }
                    var length = reply.Content.Headers.ContentLength;
                    if (length.HasValue && length.Value > MaxPhotoBytes)
                    {
                        photo.PreviewError = "Photo exceeds the preview size limit.";
                        continue;
                    }
                    await using var source = await reply.Content.ReadAsStreamAsync();
                    using var buffer = new MemoryStream();
                    var chunk = new byte[64 * 1024];
                    int count;
                    while ((count = await source.ReadAsync(chunk.AsMemory())) > 0)
                    {
                        if (buffer.Length + count > MaxPhotoBytes)
                            throw new InvalidDataException("Photo exceeds the preview size limit.");
                        await buffer.WriteAsync(chunk.AsMemory(0, count));
                    }
                    var type = reply.Content.Headers.ContentType?.MediaType;
                    if (type != "image/png" && type != "image/jpeg")
                    {
                        photo.PreviewError = "Unsupported saved photo format.";
                        continue;
                    }
                    photo.PreviewUrl = $"data:{type};base64,{Convert.ToBase64String(buffer.ToArray())}";
                    photo.PreviewError = null;
                }
                catch (Exception ex)
                {
                    photo.PreviewError = $"Unable to load photo: {ex.Message}";
                }
                await InvokeAsync(StateHasChanged);
            }
        }
        finally
        {
            loadingSavedPhotoPreviews = false;
        }
    }

    private async Task<bool> SaveCSR2DraftInternal()
    {
        var response = await Http.PostAsJsonAsync("api/CSR2/save-draft", BuildCSR2SaveDto());
        if (!response.IsSuccessStatusCode) throw new Exception($"Save draft failed: HTTP {(int)response.StatusCode} - {await response.Content.ReadAsStringAsync()}");
        using var doc = System.Text.Json.JsonDocument.Parse(await response.Content.ReadAsStringAsync());
        csr2DbId = doc.RootElement.GetProperty("id").GetInt32();
        foreach (var mediaId in removedMediaIds.Distinct().ToList())
        {
            using var delete = await Http.DeleteAsync($"api/CSR2/media/{mediaId}");
            if (!delete.IsSuccessStatusCode && delete.StatusCode != System.Net.HttpStatusCode.NotFound)
                throw new Exception($"Remove media failed: HTTP {(int)delete.StatusCode}");
        }
        removedMediaIds.Clear();
        foreach (var proofId in removedProofIds.Distinct().ToList())
        {
            using var delete = await Http.DeleteAsync($"api/CSR2/proof/{proofId}");
            if (!delete.IsSuccessStatusCode && delete.StatusCode != System.Net.HttpStatusCode.NotFound)
                throw new Exception($"Remove expense proof failed: HTTP {(int)delete.StatusCode}");
        }
        removedProofIds.Clear();
        // Update metadata for previously uploaded files, then upload pending files.
        foreach (var photo in eventPhotos) await UploadOrUpdateMedia(photo.ServerId, photo.Bytes, photo.FileName, "Photo", photo.Caption, photo.UseInLibrary, photo.ContentType, id => { photo.ServerId = id; photo.Bytes = Array.Empty<byte>(); });
        foreach (var video in eventVideos) await UploadOrUpdateMedia(video.ServerId, video.Bytes, video.FileName, "Video", video.Caption, video.UseInLibrary, video.ContentType, id => { video.ServerId = id; video.SavedFileSize = video.Bytes.LongLength; video.Bytes = Array.Empty<byte>(); });
        foreach (var item in expenseItems.Where(x => x.ProofBytes.Length > 0))
        {
            using var form = new MultipartFormDataContent();
            using var content = new ByteArrayContent(item.ProofBytes);
            content.Headers.ContentType = MediaTypeHeaderValue.Parse(string.IsNullOrEmpty(item.ProofContentType) ? "application/octet-stream" : item.ProofContentType);
            form.Add(content, "file", item.ProofFileName);
            using var proofResponse = await Http.PostAsync($"api/CSR2/{csr2DbId}/expenses/{Uri.EscapeDataString(item.Key)}/proof", form);
            if (!proofResponse.IsSuccessStatusCode) throw new Exception($"Proof upload failed ({item.Label}): {await proofResponse.Content.ReadAsStringAsync()}");
            var oldProofId = item.ProofId;
            item.ProofBytes = Array.Empty<byte>();
            using var proofDoc = System.Text.Json.JsonDocument.Parse(await proofResponse.Content.ReadAsStringAsync());
            item.ProofId = proofDoc.RootElement.GetProperty("id").GetInt32();
            if (oldProofId.HasValue && oldProofId.Value != item.ProofId.Value)
            {
                using var deleteOld = await Http.DeleteAsync($"api/CSR2/proof/{oldProofId.Value}");
                if (!deleteOld.IsSuccessStatusCode && deleteOld.StatusCode != System.Net.HttpStatusCode.NotFound)
                    throw new Exception($"New proof uploaded, but old proof deletion failed for {item.Label}.");
            }
        }
        return true;
    }
    private async Task UploadOrUpdateMedia(int serverId, byte[] bytes, string fileName, string mediaType, string caption, bool inLibrary, string contentType, Action<int> setId)
    {
        if (serverId > 0)
        {
            using var patch = await Http.PatchAsJsonAsync($"api/CSR2/media/{serverId}", new CSR2MediaDto { Caption = caption, UseInDigitalLibrary = inLibrary });
            if (!patch.IsSuccessStatusCode) throw new Exception($"Media update failed: HTTP {(int)patch.StatusCode}");
            return;
        }
        if (bytes.Length == 0) return;
        using var form = new MultipartFormDataContent();
        using var content = new ByteArrayContent(bytes);
        content.Headers.ContentType = MediaTypeHeaderValue.Parse(!string.IsNullOrWhiteSpace(contentType) ? contentType : (mediaType == "Photo" ? "image/jpeg" : "video/mp4"));
        form.Add(content, "file", fileName); form.Add(new StringContent(mediaType), "mediaType");
        form.Add(new StringContent(caption ?? ""), "caption"); form.Add(new StringContent(inLibrary.ToString().ToLowerInvariant()), "useInDigitalLibrary");
        using var reply = await Http.PostAsync($"api/CSR2/{csr2DbId}/media", form);
        if (!reply.IsSuccessStatusCode) throw new Exception($"{mediaType} upload failed: {await reply.Content.ReadAsStringAsync()}");
        using var doc = System.Text.Json.JsonDocument.Parse(await reply.Content.ReadAsStringAsync());
        setId(doc.RootElement.GetProperty("id").GetInt32());
    }
    // Required before any draft save or submission. Do not call the API for incomplete event details.
    private bool ValidateRequiredEventDetails()
    {
        string? message = null;
        if (!actualEventDate.HasValue)
            message = "Please select Actual Event Date.";
        else if (!startTime.HasValue)
            message = "Please select Start Time.";
        else if (!endTime.HasValue)
            message = "Please select End Time.";
        else if (endTime.Value <= startTime.Value)
            message = "End Time must be later than Start Time.";
        else if (eventCoordinatorId <= 0)
            message = "Please select Event Coordinator.";
        else if (string.IsNullOrWhiteSpace(actualLocation))
            message = "Please enter Actual Location.";

        if (message == null) return true;
        csr2SaveError = true;
        csr2SaveMessage = message;
        ShowCsr2Alert(message);
        return false;
    }

    private async Task SaveCSR2Draft(bool showSuccess = true)
    {
        if (savingCSR2) return;
        if (csr2Status != "Draft") { csr2SaveError = true; csr2SaveMessage = "This CSR-2 has already been submitted and is read-only."; ShowCsr2Alert(csr2SaveMessage); return; }
        if (!ValidateRequiredEventDetails()) return;
        savingCSR2 = true; csr2SaveError = false; csr2SaveMessage = "Saving CSR-2...";
        try { await SaveCSR2DraftInternal(); csr2SaveMessage = "CSR-2 draft saved successfully."; if (showSuccess) ShowCsr2Alert(csr2SaveMessage, false); }
        catch (Exception ex) { csr2SaveError = true; csr2SaveMessage = ex.Message; ShowCsr2Alert(csr2SaveMessage); }
        finally { savingCSR2 = false; }
    }
    private async Task SubmitCSR2()
    {
        await SaveCSR2Draft(false);
        if (csr2SaveError || csr2DbId is null) return;
        savingCSR2 = true;
        try
        {
            using var response = await Http.PostAsync($"api/CSR2/{csr2DbId}/submit", null);
            if (!response.IsSuccessStatusCode) throw new Exception(await response.Content.ReadAsStringAsync());
            csr2Status = "Submitted";
            csr2SaveMessage = "CSR-2 submitted successfully."; ShowCsr2Alert(csr2SaveMessage, false);
        }
        catch (Exception ex) { csr2SaveError = true; csr2SaveMessage = $"Submit failed: {ex.Message}"; ShowCsr2Alert(csr2SaveMessage); }
        finally { savingCSR2 = false; }
    }

}
