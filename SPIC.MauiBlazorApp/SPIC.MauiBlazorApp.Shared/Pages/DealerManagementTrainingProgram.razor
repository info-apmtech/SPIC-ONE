    private void FillActivityName(string name) => activityName = name;

    private void ClearActivityForm()
    {
        editingActivityId = null;
        activityName = activityDescription = activityRemarks = activityError = "";
        activityStartTime = null;
        activityEndTime = null;
        activityParticipants = null;
    }

    private void SaveActivity()
    {
        activityError = "";
        if (string.IsNullOrWhiteSpace(activityName) ||
            !activityStartTime.HasValue ||
            !activityEndTime.HasValue ||
            string.IsNullOrWhiteSpace(activityDescription))
        {
            activityError = "Enter activity name, start time, end time and description.";
            ShowCsr2Alert(activityError);
            return;
        }
        if (activityEndTime.Value <= activityStartTime.Value)
        {
            activityError = "End time must be later than start time.";
            ShowCsr2Alert(activityError);
            return;
        }
        if (activityParticipants < 0)
        {
            activityError = "Participants cannot be negative.";
            ShowCsr2Alert(activityError);
            return;
        }
        ActivityItem? item = editingActivityId.HasValue
            ? activities.FirstOrDefault(x => x.Id == editingActivityId.Value) : null;
        if (item is null)
        {
            item = new ActivityItem();
            activities.Add(item);
        }
        item.Title = activityName.Trim();
        item.StartTime = activityStartTime.Value.ToString("HH:mm", CultureInfo.InvariantCulture);
        item.EndTime = activityEndTime.Value.ToString("HH:mm", CultureInfo.InvariantCulture);
        item.Participants = activityParticipants;
        item.Description = activityDescription.Trim();
        item.Remarks = activityRemarks.Trim();
        ClearActivityForm();
    }

    private void EditActivity(Guid id)
    {
        var item = activities.FirstOrDefault(x => x.Id == id);
        if (item is null) return;
        editingActivityId = id;
        activityName = item.Title;
        activityStartTime = TimeOnly.TryParseExact(item.StartTime, "HH:mm", CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsedStart) ? parsedStart : null;
        activityEndTime = TimeOnly.TryParseExact(item.EndTime, "HH:mm", CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsedEnd) ? parsedEnd : null;
        activityParticipants = item.Participants;
        activityDescription = item.Description;
        activityRemarks = item.Remarks;
        activityError = "";
    }

    private void DeleteActivity(Guid id)
    {
        activities.RemoveAll(x => x.Id == id);
        if (editingActivityId == id) ClearActivityForm();
    }

