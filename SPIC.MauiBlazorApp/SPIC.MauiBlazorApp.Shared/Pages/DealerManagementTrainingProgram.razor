    private void PrefillFocusFromCSR1()
    {
        if (csr1Plan == null) return;
        var groups = new[] { csr1Plan.Focus1, csr1Plan.Focus2, csr1Plan.Focus3 };
        for (var i = 0; i < 3; i++)
        {
            var target = csr2FocusGroups[i]; target.CropIds.Clear(); target.ProductIds.Clear();
            var source = groups[i];
            if (source?.Count > 0)
            {
                target.CropIds.AddRange(source.Select(x => x.CropId).Where(id => id > 0).Distinct().Take(3));
                target.ProductIds.AddRange(source.Select(x => x.ProductId).Where(id => id > 0).Distinct().Take(3));
            }
        }
    }
    private void AddFocusCrop(EditableFocusGroup group, string? value)
    {
        if (!int.TryParse(value, out var id) || id <= 0 || group.CropIds.Contains(id) || group.CropIds.Count >= 3) return;
        group.CropIds.Add(id);
    }
    private void RemoveFocusCrop(EditableFocusGroup group, int id)
    {
        group.CropIds.Remove(id);
        if (group.CropIds.Count == 0) group.ProductIds.Clear();
    }
    private void AddFocusProduct(EditableFocusGroup group, string? value)
    {
        if (group.CropIds.Count == 0 || !int.TryParse(value, out var id) || id <= 0 || group.ProductIds.Contains(id) || group.ProductIds.Count >= 3) return;
        group.ProductIds.Add(id);
    }
    private void RemoveFocusProduct(EditableFocusGroup group, int id) => group.ProductIds.Remove(id);

    private CSR2SaveDto BuildCSR2SaveDto() => new()
    {
        Id = csr2DbId,
        CSR1Id = CSR1Id ?? 0,
        ActualEventDate = actualEventDate,
        StartTime = startTime,
        EndTime = endTime,
        EventCoordinatorEmployeeId = !string.IsNullOrWhiteSpace(eventCoordinatorId)
            ? eventCoordinatorId
            : null,
        ActualLocation = actualLocation,
        ExpectedParticipantsCount = expectedParticipantsCount,
        FocusProducts = csr2FocusGroups
            .SelectMany(g => g.CropIds.SelectMany(c => g.ProductIds.Select(p =>
                new CSR2FocusProductDto { GroupNumber = g.GroupNumber, CropId = c, ProductId = p })))
            .ToList(),
        Participants = participants.Select(x => new CSR2ParticipantDto { Name = x.Name, PhoneNumber = x.Phone, Role = x.Role }).ToList(),
        Employees = employees.Select(x => new CSR2EmployeeDto { EmployeeInformationId = x.UserId, EmployeeName = x.Name, PhoneNumber = x.Phone, RoleName = x.Role }).ToList(),
        Expenses = expenseItems.Select(x => new CSR2ExpenseDto
        {
            CategoryKey = x.Key,
            CategoryName = x.Label,
            ActualAmount = x.ActualAmount,
            ExpenseDate = x.ExpenseDate,
            BillNo = x.BillNo?.Trim() ?? ""
        }).ToList()
    };

    private async Task ApplyCSR2DraftResponse(HttpResponseMessage response)
    {
        if (response.StatusCode == System.Net.HttpStatusCode.NotFound) return;
        if (!response.IsSuccessStatusCode) { csr2SaveError = true; csr2SaveMessage = $"Unable to load CSR-2: HTTP {(int)response.StatusCode}"; ShowCsr2Alert(csr2SaveMessage); return; }
        var saved = await response.Content.ReadFromJsonAsync<CSR2DetailsDto>();
        if (saved is null) return;
        csr2DbId = saved.Id;
        csr2Status = saved.Status;
        expectedParticipantsCount = saved.ExpectedParticipantsCount;
        // CSR-1 date is authoritative and read-only in CSR-2.
        actualEventDate = csr1Plan?.CSR1Date; startTime = saved.StartTime; endTime = saved.EndTime;
        eventCoordinatorId = saved.EventCoordinatorEmployeeId
            ?? csr1Plan?.ResponsiblePersonId
            ?? "";
        actualLocation = saved.ActualLocation ?? "";
        if (saved.FocusProducts.Count > 0)
        {
            foreach (var focus in csr2FocusGroups) { focus.CropIds.Clear(); focus.ProductIds.Clear(); }
            foreach (var group in saved.FocusProducts.GroupBy(x => x.GroupNumber))
            {
                var target = csr2FocusGroups.FirstOrDefault(x => x.GroupNumber == group.Key);
                if (target == null) continue;
                target.CropIds.AddRange(group.Select(x => x.CropId).Where(x => x > 0).Distinct().Take(3));
                target.ProductIds.AddRange(group.Select(x => x.ProductId).Where(x => x > 0).Distinct().Take(3));
            }
        }
        participants.Clear();
        foreach (var item in saved.Participants) participants.Add(new PersonInfo { Id = nextParticipantId++, Name = item.Name, Phone = item.PhoneNumber ?? "", Role = item.Role, Initials = GetInitials(item.Name) });
        employees.Clear();
        foreach (var item in saved.Employees)
        {
            var lookupEmployee = employeeList.FirstOrDefault(e =>
                string.Equals(
                    e.UserId,
                    item.EmployeeInformationId,
                    StringComparison.OrdinalIgnoreCase));

            var employeeName = !string.IsNullOrWhiteSpace(item.EmployeeName)
                ? item.EmployeeName
                : lookupEmployee?.Name ?? "";

            employees.Add(new PersonInfo
            {
                Id = lookupEmployee?.Id ?? 0,
                UserId = item.EmployeeInformationId ?? "",
                Name = employeeName,
                Phone = item.PhoneNumber ?? "",
                Role = item.RoleName,
                Initials = GetInitials(employeeName)
            });
        }
        // Rebuild actual expense entries from saved CSR-2 rows. Multiple rows per master expense are supported.
        foreach (var group in saved.Expenses.GroupBy(x => ParseExpenseIdFromRowKey(x.CategoryKey)))
        {
            if (group.Key <= 0) continue;
            var template = expenseItems.FirstOrDefault(x => x.ExpenseId == group.Key);
            if (template is null) continue;

            var savedRows = group.ToList();
            var existingRows = expenseItems.Where(x => x.ExpenseId == group.Key).ToList();
            for (var index = 0; index < savedRows.Count; index++)
            {
                var item = savedRows[index];
                ExpenseItem row;
                if (index < existingRows.Count)
                {
                    row = existingRows[index];
                }
                else
                {
                    row = new ExpenseItem
                    {
                        ExpenseId = template.ExpenseId,
                        Label = template.Label,
                        PlannedAmount = template.PlannedAmount,
                        Icon = template.Icon,
                        IconClass = template.IconClass
                    };
                    expenseItems.Add(row);
                }

                row.Key = string.IsNullOrWhiteSpace(item.CategoryKey)
                    ? BuildExpenseRowKey(group.Key, row.RowId)
                    : item.CategoryKey;
                row.ActualAmount = item.ActualAmount;
                row.ExpenseDate = item.ExpenseDate;
                row.BillNo = item.BillNo ?? "";
            }
        }
        await LoadAllExpenseProofsAsync();
        eventPhotos.Clear(); eventVideos.Clear();
        triedSavedPhotoPreviews.Clear();
        foreach (var file in saved.Media)
        {
            var url = $"api/CSR2/media/{file.Id}/file";
            if (file.MediaType == "Photo") eventPhotos.Add(new PhotoItem { ServerId = file.Id, FileName = file.OriginalFileName, Caption = file.Caption ?? "", PreviewUrl = "" });
            if (file.MediaType == "Video") eventVideos.Add(new VideoItem { ServerId = file.Id, FileName = file.OriginalFileName, Caption = file.Caption ?? "", PreviewUrl = url, SavedFileSize = file.FileSizeBytes });
        }
        if (saved.Status != "Draft") { csr2SaveMessage = $"CSR-2 status: {saved.Status}"; }
    }

    private sealed class ExpenseProofLookupDto
    {
        public string CategoryKey { get; set; } = "";
        public int ProofId { get; set; }
        public string FileName { get; set; } = "";
        public string ContentType { get; set; } = "";
    }

    private async Task LoadAllExpenseProofsAsync()
    {
        if (!csr2DbId.HasValue || csr2DbId.Value <= 0) return;
        try
        {
            var proofs = await Http.GetFromJsonAsync<List<ExpenseProofLookupDto>>($"api/CSR2/{csr2DbId.Value}/expense-proofs") ?? new();
            foreach (var row in expenseItems)
                row.Proofs.RemoveAll(x => x.ProofId.HasValue);

            foreach (var proof in proofs)
            {
                var row = expenseItems.FirstOrDefault(x => x.Key == proof.CategoryKey);
                if (row == null) continue;
                row.Proofs.Add(new ExpenseProofItem
                {
                    ProofId = proof.ProofId,
                    FileName = proof.FileName,
                    ContentType = proof.ContentType
                });
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Unable to load expense proofs: {ex.Message}");
        }
    }

    // Protected API images cannot reliably be rendered with <img src="api/..."> when
    // authentication is attached to HttpClient requests (e.g. bearer authorization).
    // Load saved photo bytes only when the user opens the media or review step.
    // No file bytes are added to the CSR-2 JSON response.
    private bool loadingSavedPhotoPreviews;
    private readonly HashSet<int> triedSavedPhotoPreviews = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (currentStep != 1 && currentStep != 4) return;
        if (loadingSavedPhotoPreviews) return;
        var pending = eventPhotos.Where(p => p.ServerId > 0 &&
            string.IsNullOrWhiteSpace(p.PreviewUrl) && !triedSavedPhotoPreviews.Contains(p.ServerId)).ToList();
        if (pending.Count == 0) return;

        loadingSavedPhotoPreviews = true;
        try
        {
            foreach (var photo in pending)
            {
                triedSavedPhotoPreviews.Add(photo.ServerId);
                try
                {
                    // The existing injected HttpClient carries the application's auth setup.
                    using var reply = await Http.GetAsync($"api/CSR2/media/{photo.ServerId}/file",
                        System.Net.Http.HttpCompletionOption.ResponseHeadersRead);
                    if (!reply.IsSuccessStatusCode)
                    {
                        photo.PreviewError = $"Photo unavailable (HTTP {(int)reply.StatusCode}).";
                        continue;
                    }
                    var length = reply.Content.Headers.ContentLength;
                    if (length.HasValue && length.Value > MaxPhotoBytes)
                    {
                        photo.PreviewError = "Photo exceeds the preview size limit.";
                        continue;
                    }
                    await using var source = await reply.Content.ReadAsStreamAsync();
                    using var buffer = new MemoryStream();
                    var chunk = new byte[64 * 1024];
                    int count;
                    while ((count = await source.ReadAsync(chunk.AsMemory())) > 0)
                    {
                        if (buffer.Length + count > MaxPhotoBytes)
                            throw new InvalidDataException("Photo exceeds the preview size limit.");
                        await buffer.WriteAsync(chunk.AsMemory(0, count));
                    }
                    var type = reply.Content.Headers.ContentType?.MediaType;
                    if (type != "image/png" && type != "image/jpeg")
                    {
                        photo.PreviewError = "Unsupported saved photo format.";
                        continue;
                    }
                    photo.PreviewUrl = $"data:{type};base64,{Convert.ToBase64String(buffer.ToArray())}";
                    photo.PreviewError = null;
                }
                catch (Exception ex)
                {
                    photo.PreviewError = $"Unable to load photo: {ex.Message}";
                }
                await InvokeAsync(StateHasChanged);
            }
        }
        finally
        {
            loadingSavedPhotoPreviews = false;
        }
    }

    private async Task<bool> SaveCSR2DraftInternal()
    {
        // Delete server proofs first so removing an expense row cannot orphan files.
        if (csr2DbId.HasValue && csr2DbId.Value > 0)
        {
            foreach (var proofId in removedProofIds.Distinct().ToList())
            {
                using var delete = await Http.DeleteAsync($"api/CSR2/proof/{proofId}");
                if (!delete.IsSuccessStatusCode && delete.StatusCode != System.Net.HttpStatusCode.NotFound)
                    throw new Exception($"Remove expense proof failed: HTTP {(int)delete.StatusCode}");
            }
            removedProofIds.Clear();
        }

        var response = await Http.PostAsJsonAsync("api/CSR2/save-draft", BuildCSR2SaveDto());
        if (!response.IsSuccessStatusCode) throw new Exception($"Save draft failed: HTTP {(int)response.StatusCode} - {await response.Content.ReadAsStringAsync()}");
        using var doc = System.Text.Json.JsonDocument.Parse(await response.Content.ReadAsStringAsync());
        csr2DbId = doc.RootElement.GetProperty("id").GetInt32();
        foreach (var mediaId in removedMediaIds.Distinct().ToList())
        {
            using var delete = await Http.DeleteAsync($"api/CSR2/media/{mediaId}");
            if (!delete.IsSuccessStatusCode && delete.StatusCode != System.Net.HttpStatusCode.NotFound)
                throw new Exception($"Remove media failed: HTTP {(int)delete.StatusCode}");
        }
        removedMediaIds.Clear();
        // Update metadata for previously uploaded files, then upload pending files.
        foreach (var photo in eventPhotos) await UploadOrUpdateMedia(photo.ServerId, photo.Bytes, photo.FileName, "Photo", photo.Caption, photo.ContentType, id => { photo.ServerId = id; photo.Bytes = Array.Empty<byte>(); });
        foreach (var video in eventVideos) await UploadOrUpdateMedia(video.ServerId, video.Bytes, video.FileName, "Video", video.Caption, video.ContentType, id => { video.ServerId = id; video.SavedFileSize = video.Bytes.LongLength; video.Bytes = Array.Empty<byte>(); });
        foreach (var item in expenseItems)
        {
            foreach (var proof in item.Proofs.Where(x => x.Bytes.Length > 0).ToList())
            {
                using var form = new MultipartFormDataContent();
                using var content = new ByteArrayContent(proof.Bytes);
                content.Headers.ContentType = MediaTypeHeaderValue.Parse(string.IsNullOrEmpty(proof.ContentType) ? "application/octet-stream" : proof.ContentType);
                form.Add(content, "file", proof.FileName);
                using var proofResponse = await Http.PostAsync($"api/CSR2/{csr2DbId}/expenses/{Uri.EscapeDataString(item.Key)}/proof", form);
                if (!proofResponse.IsSuccessStatusCode)
                    throw new Exception($"Proof upload failed ({item.Label} / {proof.FileName}): {await proofResponse.Content.ReadAsStringAsync()}");

                using var proofDoc = System.Text.Json.JsonDocument.Parse(await proofResponse.Content.ReadAsStringAsync());
                proof.ProofId = proofDoc.RootElement.GetProperty("id").GetInt32();
                proof.Bytes = Array.Empty<byte>();
            }
        }
        return true;
    }
    private async Task UploadOrUpdateMedia(int serverId, byte[] bytes, string fileName, string mediaType, string caption, string contentType, Action<int> setId)
    {
        if (serverId > 0)
        {
            await UpdateMediaCaption(serverId, caption);
            return;
        }
        if (bytes.Length == 0) return;
        using var form = new MultipartFormDataContent();
        using var content = new ByteArrayContent(bytes);
        content.Headers.ContentType = MediaTypeHeaderValue.Parse(!string.IsNullOrWhiteSpace(contentType) ? contentType : (mediaType == "Photo" ? "image/jpeg" : "video/mp4"));
        form.Add(content, "file", fileName);
        form.Add(new StringContent(mediaType), "mediaType");
        form.Add(new StringContent(caption ?? ""), "caption");
        using var reply = await Http.PostAsync($"api/CSR2/{csr2DbId}/media", form);
        if (!reply.IsSuccessStatusCode) throw new Exception($"{mediaType} upload failed: {await reply.Content.ReadAsStringAsync()}");
        using var doc = System.Text.Json.JsonDocument.Parse(await reply.Content.ReadAsStringAsync());
        setId(doc.RootElement.GetProperty("id").GetInt32());
    }

    private async Task UpdateMediaCaption(int serverId, string caption)
    {
        using var patch = await Http.PatchAsJsonAsync($"api/CSR2/media/{serverId}", new CSR2MediaDto { Caption = caption });
        if (!patch.IsSuccessStatusCode) throw new Exception($"Media update failed: HTTP {(int)patch.StatusCode}");
    }
    // Required before any draft save or submission. Do not call the API for incomplete event details.
    private bool ValidateRequiredEventDetails()
    {
        string? message = null;
        if (!actualEventDate.HasValue)
            message = "Please select Actual Event Date.";
        else if (!startTime.HasValue)
            message = "Please select Start Time.";
        else if (!endTime.HasValue)
            message = "Please select End Time.";
        else if (endTime.Value <= startTime.Value)
            message = "End Time must be later than Start Time.";
        else if (string.IsNullOrWhiteSpace(eventCoordinatorId))
            message = "Please select Event Coordinator.";
        else if (string.IsNullOrWhiteSpace(actualLocation))
            message = "Please enter Actual Location.";

        if (message == null) return true;
        csr2SaveError = true;
        csr2SaveMessage = message;
        ShowCsr2Alert(message);
        return false;
    }

    private async Task SaveCSR2Draft(bool showSuccess = true)
    {
        if (savingCSR2) return;
        if (csr2Status != "Draft") { csr2SaveError = true; csr2SaveMessage = "This CSR-2 has already been submitted and is read-only."; ShowCsr2Alert(csr2SaveMessage); return; }
        if (!ValidateRequiredEventDetails()) return;
        savingCSR2 = true; csr2SaveError = false; csr2SaveMessage = "Saving CSR-2...";
        try { await SaveCSR2DraftInternal(); csr2SaveMessage = "CSR-2 draft saved successfully."; if (showSuccess) ShowCsr2Alert(csr2SaveMessage, false); }
        catch (Exception ex) { csr2SaveError = true; csr2SaveMessage = ex.Message; ShowCsr2Alert(csr2SaveMessage); }
        finally { savingCSR2 = false; }
    }
    private async Task SubmitCSR2()
    {
        await SaveCSR2Draft(false);
        if (csr2SaveError || csr2DbId is null) return;
        savingCSR2 = true;
        try
        {
            using var response = await Http.PostAsync($"api/CSR2/{csr2DbId}/submit", null);
            if (!response.IsSuccessStatusCode) throw new Exception(await response.Content.ReadAsStringAsync());
            csr2Status = "Submitted";
            csr2SaveMessage = "CSR-2 submitted successfully."; ShowCsr2Alert(csr2SaveMessage, false);
        }
        catch (Exception ex) { csr2SaveError = true; csr2SaveMessage = $"Submit failed: {ex.Message}"; ShowCsr2Alert(csr2SaveMessage); }
        finally { savingCSR2 = false; }
    }

}
