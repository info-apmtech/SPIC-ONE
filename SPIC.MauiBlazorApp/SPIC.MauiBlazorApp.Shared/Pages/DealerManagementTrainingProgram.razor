    private async Task OnExpenseProofSelected(InputFileChangeEventArgs e, ExpenseItem item)
    {
        item.Error = "";
        var file = e.File;
        var extension = System.IO.Path.GetExtension(file.Name).ToLowerInvariant();
        if (extension != ".pdf" && extension != ".jpg" && extension != ".jpeg" && extension != ".png")
        {
            item.Error = "Upload PDF, JPG or PNG only.";
            return;
        }
        if (file.Size == 0 || file.Size > MaxExpenseProofBytes)
        {
            item.Error = "Proof must be smaller than 10 MB.";
            return;
        }
        try
        {
            await using var stream = file.OpenReadStream(MaxExpenseProofBytes);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            item.ProofBytes = memory.ToArray();
            item.ProofFileName = file.Name;
            item.ProofContentType = file.ContentType;
        }
        catch (Exception ex)
        {
            item.Error = $"Unable to read proof: {ex.Message}";
        }
    }

    private void RemoveExpenseProof(ExpenseItem item)
    {
        item.ProofFileName = "";
        item.ProofContentType = "";
        item.ProofBytes = Array.Empty<byte>();
        item.Error = "";
    }

