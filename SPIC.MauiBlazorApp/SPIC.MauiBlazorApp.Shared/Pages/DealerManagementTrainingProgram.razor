    private const long MaxPhotoBytes = 20L * 1024 * 1024;
    private readonly List<PhotoItem> eventPhotos = new();
    private bool isReadingPhotos;
    private string photoError = "";

    private sealed class PhotoItem
    {
        public Guid Id { get; set; } = Guid.NewGuid();
        public string FileName { get; set; } = "";
        public string Caption { get; set; } = "";
        public string PreviewUrl { get; set; } = "";
        public string ContentType { get; set; } = "";
        // Binary data is kept in memory; no server persistence is performed here.
        public byte[] Bytes { get; set; } = Array.Empty<byte>();
        public int ServerId { get; set; }
        public string? PreviewError { get; set; }
    }

    private async Task OnPhotosSelected(InputFileChangeEventArgs args)
    {
        if (!CanEditCurrentCSR2) return;
        photoError = "";
        isReadingPhotos = true;
        var rejected = new List<string>();
        try
        {
            foreach (var file in args.GetMultipleFiles(30))
            {
                var extension = System.IO.Path.GetExtension(file.Name).ToLowerInvariant();
                if (extension != ".jpg" && extension != ".jpeg" && extension != ".png")
                {
                    rejected.Add($"{file.Name}: JPG/PNG only");
                    continue;
                }
                if (file.Size > MaxPhotoBytes)
                {
                    rejected.Add($"{file.Name}: exceeds 20MB");
                    continue;
                }
                var mime = extension == ".png" ? "image/png" : "image/jpeg";
                try
                {
                    await using var stream = file.OpenReadStream(MaxPhotoBytes);
                    using var buffer = new MemoryStream();
                    await stream.CopyToAsync(buffer);
                    var bytes = buffer.ToArray();
                    eventPhotos.Add(new PhotoItem
                    {
                        FileName = file.Name,
                        ContentType = mime,
                        Bytes = bytes,
                        PreviewUrl = $"data:{mime};base64,{Convert.ToBase64String(bytes)}"
                    });
                }
                catch (Exception ex)
                {
                    rejected.Add($"{file.Name}: {ex.Message}");
                }
            }
        }
        catch (Exception ex)
        {
            rejected.Add($"Unable to read selection: {ex.Message}");
        }
        finally
        {
            photoError = string.Join("; ", rejected);
            if (!string.IsNullOrWhiteSpace(photoError)) ShowCsr2Alert(photoError);
            isReadingPhotos = false;
        }
    }

    private void RemovePhoto(Guid id) { if (!CanEditCurrentCSR2) return; var media = eventPhotos.FirstOrDefault(x => x.Id == id); if (media?.ServerId > 0) removedMediaIds.Add(media.ServerId); eventPhotos.RemoveAll(x => x.Id == id); }

    private const long MaxVideoBytes = 700L * 1024 * 1024;
    // Videos are streamed to CSR2Controller on selection, not buffered in page state.
    private readonly List<VideoItem> eventVideos = new();
    private bool isReadingVideos;
    private string videoError = "";

    private sealed class VideoItem
    {
        public Guid Id { get; set; } = Guid.NewGuid();
        public string FileName { get; set; } = "";
        public string Caption { get; set; } = "";
        public string PreviewUrl { get; set; } = "";
        public string ContentType { get; set; } = "";
        public byte[] Bytes { get; set; } = Array.Empty<byte>();
        public int ServerId { get; set; }
        public long SavedFileSize { get; set; }
    }

    private static string FormatVideoSize(long bytes) => $"{bytes / (1024d * 1024d):N1} MB";
    // Stream directly from IBrowserFile to the existing CSR2Controller media API.
    // Avoid MemoryStream, byte[] copies, and base64 video data URLs.
    private async Task OnVideosSelected(InputFileChangeEventArgs args)
    {
        if (!CanEditCurrentCSR2) { ShowCsr2Alert("This CSR-2 is read-only for your current workflow stage."); return; }
        if (isReadingVideos || savingCSR2) return;
        videoError = "";
        if (!ValidateRequiredEventDetails()) { GoToStep(1); return; }
        isReadingVideos = true;
        var rejected = new List<string>();
        try
        {
            // The draft must have a server ID before a streaming upload can begin.
            await SaveCSR2DraftInternal();
            foreach (var file in args.GetMultipleFiles(10))
            {
                var ext = System.IO.Path.GetExtension(file.Name).ToLowerInvariant();
                if (ext != ".mp4" && ext != ".mov")
                {
                    rejected.Add($"{file.Name}: MP4/MOV only");
                    continue;
                }
                if (file.Size <= 0 || file.Size > MaxVideoBytes)
                {
                    rejected.Add($"{file.Name}: must be under 700MB");
                    continue;
                }
                try
                {
                    var mime = ext == ".mov" ? "video/quicktime" : "video/mp4";
                    await using var stream = file.OpenReadStream(MaxVideoBytes);
                    using var form = new MultipartFormDataContent();
                    using var content = new StreamContent(stream);
                    content.Headers.ContentType = MediaTypeHeaderValue.Parse(mime);
                    form.Add(content, "file", file.Name);
                    form.Add(new StringContent("Video"), "mediaType");
                    form.Add(new StringContent(""), "caption");
                    using var response = await Http.PostAsync($"api/CSR2/{csr2DbId}/media", form);
                    if (!response.IsSuccessStatusCode)
                    {
                        rejected.Add($"{file.Name}: upload failed (HTTP {(int)response.StatusCode})");
                        continue;
                    }
                    using var result = System.Text.Json.JsonDocument.Parse(await response.Content.ReadAsStringAsync());
                    var id = result.RootElement.GetProperty("id").GetInt32();
                    eventVideos.Add(new VideoItem
                    {
                        ServerId = id,
                        FileName = file.Name,
                        ContentType = mime,
                        SavedFileSize = file.Size,
                        PreviewUrl = $"api/CSR2/media/{id}/file"
                    });
                    // Stream was consumed without allocating a complete video byte array.
                    StateHasChanged();
                }
                catch (Exception ex) { rejected.Add($"{file.Name}: {ex.Message}"); }
            }
        }
        catch (Exception ex) { rejected.Add($"Unable to upload videos: {ex.Message}"); }
        finally
        {
            videoError = string.Join("; ", rejected);
            if (!string.IsNullOrWhiteSpace(videoError)) ShowCsr2Alert(videoError);
            isReadingVideos = false;
        }
    }

    private void RemoveVideo(Guid id) { if (!CanEditCurrentCSR2) return; var media = eventVideos.FirstOrDefault(x => x.Id == id); if (media?.ServerId > 0) removedMediaIds.Add(media.ServerId); eventVideos.RemoveAll(v => v.Id == id); }

