            // Draft response was already downloading alongside the CSR-1 calls.
            using var draftResponse = await draftTask;
            if (csr1Plan != null)
            {
                await ApplyCSR2DraftResponse(draftResponse);
                loadedCsr1Id = csr1Id;
            }
        }
        catch (Exception ex)
        {
            csr1Error = $"CSR-2 page load error: {ex.Message}";
        }
        finally { isLoadingCSR1 = false; }
