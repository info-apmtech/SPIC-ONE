@code {
    [SupplyParameterFromQuery(Name = "csr1Id")]
    public int? CSR1Id { get; set; }
    private int selectedEmployeeId = 0;

    private CSR1DetailsDto? csr1Plan;
    private bool isLoadingCSR1 = true;
    private string csr1Error = "";

    private record FocusGroup(int Number, List<CSR1FocusDetailsDto> Items);
    private record PlannedExpense(string Label, decimal Amount);

    private List<FocusGroup> CSR1FocusGroups => csr1Plan == null ? new() : new()
    {
        new(1, csr1Plan.Focus1 ?? new()),
        new(2, csr1Plan.Focus2 ?? new()),
        new(3, csr1Plan.Focus3 ?? new())
    };

    private List<PlannedExpense> CSR1PlannedExpenses => csr1Plan == null ? new() : new()
    {
        new("Printing & Stationery", csr1Plan.PrintingAndStationery),
        new("Publicity Material", csr1Plan.PublicityMaterial),
        new("Stage Arrangements", csr1Plan.StageArrangements),
        new("Service Charges - LCA", csr1Plan.ServiceChargesLCA),
        new("Transport / Rent", csr1Plan.TransportRent),
        new("Jeep Running Expenses", csr1Plan.JeepRunningExpenses),
        new("Refreshments", csr1Plan.Refreshments),
        new("Inputs", csr1Plan.Inputs),
        new("Photography", csr1Plan.Photography),
        new("Compliments", csr1Plan.Compliments),
        new("Others", csr1Plan.Others)
    };

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static string Money(decimal amount) => "₹ " + amount.ToString("N2", CultureInfo.GetCultureInfo("en-IN"));

    protected override async Task OnParametersSetAsync()
    {
        isLoadingCSR1 = true;
        csr1Plan = null;
        csr1Error = "";
        if (CSR1Id is null or <= 0)
        {
            csr1Error = "Missing or invalid csr1Id in the page URL.";
            isLoadingCSR1 = false;
            return;
        }
        try
        {
            using var response = await Http.GetAsync($"api/CSR1/details/{CSR1Id}");
            if (!response.IsSuccessStatusCode)
            {
                csr1Error = $"Unable to load CSR-1 #{CSR1Id}. HTTP {(int)response.StatusCode}.";
                return;
            }
            csr1Plan = await response.Content.ReadFromJsonAsync<CSR1DetailsDto>();
            if (csr1Plan == null)
                csr1Error = "CSR-1 details API returned no data.";
            else if (!string.Equals(csr1Plan.Status, "Approved", StringComparison.OrdinalIgnoreCase))
            {
                csr1Error = "CSR-2 can be opened only for an approved CSR-1.";
                csr1Plan = null;
            }
            if (csr1Plan != null)
            {
                InitializeExpensesFromCSR1();
                // Employee Master is loaded below for both employee and coordinator dropdowns.
            }
            await LoadEmployees();
        }
        catch (Exception ex) { csr1Error = $"CSR-1 load error: {ex.Message}"; }
        finally { isLoadingCSR1 = false; }
    }

    // Step navigation; the event and participant inputs are interactive, but not yet persisted.
    private int currentStep = 1;
    private bool showStartConfirm = false;

    private int totalParticipants => participants.Count;
    private int totalEmployees => employees.Count;
    private int overallAttendance => totalParticipants + totalEmployees;

    private string StepClass(int stepNumber) =>
        stepNumber < currentStep ? "dmtp-step-done" :
        stepNumber == currentStep ? "dmtp-step-active" : "dmtp-step-pending";

    private string NextStepLabel() => currentStep < steps.Count ? steps[currentStep].Label : "";

    private void GoToStep(int stepNumber) => currentStep = stepNumber;
    private void GoNext()
    {
        if (currentStep < steps.Count) currentStep++;
    }
    private void GoPrevious()
    {
        if (currentStep > 1) currentStep--;
    }

    private void OpenStartConfirm() => showStartConfirm = true;
    private void CloseStartConfirm() => showStartConfirm = false;
    private void ConfirmStartEvent()
    {
        showStartConfirm = false;
        GoNext();
    }

    private class StepInfo
    {
        public int Number { get; set; }
        public string Label { get; set; } = "";
    }

    private readonly List<StepInfo> steps = new()
    {
        new StepInfo { Number = 1, Label = "Plan & Start" },
        new StepInfo { Number = 2, Label = "Photos & Videos" },
        new StepInfo { Number = 3, Label = "Activities" },
        new StepInfo { Number = 4, Label = "Expense & Proof" },
        new StepInfo { Number = 5, Label = "Review & Submit" },
    };

    // Local component state only. Persist event and participant entries through your CSR-2 API when ready.
    private DateTime? actualEventDate;
    private TimeOnly? startTime;
    private TimeOnly? endTime;
    private int eventCoordinatorId = 0;
    private string actualLocation = "";

    private string participantName = "";
    private string participantPhone = "";
    private string participantRole = "";
    private string participantError = "";
    private int? editingParticipantId;
    private int nextParticipantId = 1;
    private const int participantPageSize = 5;
    private int participantPage = 1;
    private int ParticipantPageCount => Math.Max(1, (int)Math.Ceiling(participants.Count / (double)participantPageSize));
    private IEnumerable<PersonInfo> PagedParticipants => participants.Skip((participantPage - 1) * participantPageSize).Take(participantPageSize);

    private static string GetInitials(string name) => string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));

    private void AddParticipant()
    {
        participantError = "";
        var name = participantName.Trim();
        var phone = participantPhone.Trim();
        if (string.IsNullOrWhiteSpace(name) || string.IsNullOrWhiteSpace(phone) || string.IsNullOrWhiteSpace(participantRole))
        {
            participantError = "Please enter participant name, phone number and role.";
            return;
        }
        if (phone.Length != 10 || !phone.All(char.IsDigit))
        {
            participantError = "Please enter a valid 10-digit mobile number.";
            return;
        }
        if (participants.Any(p => p.Phone == phone && p.Id != editingParticipantId))
        {
            participantError = "This phone number is already added.";
            return;
        }
        if (editingParticipantId is int id)
        {
            var existing = participants.FirstOrDefault(p => p.Id == id);
            if (existing != null)
            {
                existing.Name = name;
                existing.Phone = phone;
                existing.Role = participantRole;
                existing.Initials = GetInitials(name);
            }
        }
        else
        {
            participants.Add(new PersonInfo { Id = nextParticipantId++, Name = name, Phone = phone, Role = participantRole, Initials = GetInitials(name) });
            participantPage = ParticipantPageCount;
        }
        ClearParticipantForm();
    }

    private void EditParticipant(PersonInfo person)
    {
        editingParticipantId = person.Id;
        participantName = person.Name;
        participantPhone = person.Phone;
        participantRole = person.Role;
        participantError = "";
    }

    private void DeleteParticipant(int id)
    {
        participants.RemoveAll(p => p.Id == id);
        participantPage = Math.Min(participantPage, ParticipantPageCount);
        if (editingParticipantId == id) ClearParticipantForm();
    }

    private void ClearParticipantForm()
    {
        participantName = "";
        participantPhone = "";
        participantRole = "";
        participantError = "";
        editingParticipantId = null;
    }

    private void SetParticipantPage(int page) => participantPage = Math.Clamp(page, 1, ParticipantPageCount);

    private class PersonInfo
    {
        public int Id { get; set; }
        public string Initials { get; set; } = "";
        public string Name { get; set; } = "";
        public string Phone { get; set; } = "";
        public string Role { get; set; } = "";
    }

    private readonly List<PersonInfo> participants = new();

    private readonly List<PersonInfo> employees = new();

    private const long MaxPhotoBytes = 20L * 1024 * 1024;
    private readonly List<PhotoItem> eventPhotos = new();
    private bool isReadingPhotos;
    private string photoError = "";

    private sealed class PhotoItem
    {
        public Guid Id { get; set; } = Guid.NewGuid();
        public string FileName { get; set; } = "";
        public string Caption { get; set; } = "";
        public string PreviewUrl { get; set; } = "";
        public string ContentType { get; set; } = "";
        public bool UseInLibrary { get; set; } = true;
        // Binary data is kept in memory; no server persistence is performed here.
        public byte[] Bytes { get; set; } = Array.Empty<byte>();
    }

    private async Task OnPhotosSelected(InputFileChangeEventArgs args)
    {
        photoError = "";
        isReadingPhotos = true;
        var rejected = new List<string>();
        try
        {
            foreach (var file in args.GetMultipleFiles(30))
            {
                var extension = System.IO.Path.GetExtension(file.Name).ToLowerInvariant();
                if (extension != ".jpg" && extension != ".jpeg" && extension != ".png")
                {
                    rejected.Add($"{file.Name}: JPG/PNG only");
                    continue;
                }
                if (file.Size > MaxPhotoBytes)
                {
                    rejected.Add($"{file.Name}: exceeds 20MB");
                    continue;
                }
                var mime = extension == ".png" ? "image/png" : "image/jpeg";
                try
                {
                    await using var stream = file.OpenReadStream(MaxPhotoBytes);
                    using var buffer = new MemoryStream();
                    await stream.CopyToAsync(buffer);
                    var bytes = buffer.ToArray();
                    eventPhotos.Add(new PhotoItem
                    {
                        FileName = file.Name,
                        ContentType = mime,
                        Bytes = bytes,
                        PreviewUrl = $"data:{mime};base64,{Convert.ToBase64String(bytes)}"
                    });
                }
                catch (Exception ex)
                {
                    rejected.Add($"{file.Name}: {ex.Message}");
                }
            }
        }
        catch (Exception ex)
        {
            rejected.Add($"Unable to read selection: {ex.Message}");
        }
        finally
        {
            photoError = string.Join("; ", rejected);
            isReadingPhotos = false;
        }
    }

    private void RemovePhoto(Guid id) => eventPhotos.RemoveAll(x => x.Id == id);

    private const long MaxVideoBytes = 200L * 1024 * 1024;
    // Base64 previews above this size can freeze mobile browsers. Files remain in page state.
    private const long MaxVideoPreviewBytes = 20L * 1024 * 1024;
    private readonly List<VideoItem> eventVideos = new();
    private bool isReadingVideos;
    private string videoError = "";

    private sealed class VideoItem
    {
        public Guid Id { get; set; } = Guid.NewGuid();
        public string FileName { get; set; } = "";
        public string Caption { get; set; } = "";
        public string PreviewUrl { get; set; } = "";
        public string ContentType { get; set; } = "";
        public bool UseInLibrary { get; set; } = true;
        public byte[] Bytes { get; set; } = Array.Empty<byte>();
    }

    private static string FormatVideoSize(long bytes) => $"{bytes / (1024d * 1024d):N1} MB";

    private async Task OnVideosSelected(InputFileChangeEventArgs args)
    {
        videoError = "";
        isReadingVideos = true;
        var rejected = new List<string>();
        try
        {
            foreach (var file in args.GetMultipleFiles(10))
            {
                var ext = System.IO.Path.GetExtension(file.Name).ToLowerInvariant();
                // Mobile-recorded files may use MOV; browser video codec support varies.
                if (ext != ".mp4" && ext != ".mov")
                {
                    rejected.Add($"{file.Name}: MP4/MOV only");
                    continue;
                }
                if (file.Size <= 0 || file.Size > MaxVideoBytes)
                {
                    rejected.Add($"{file.Name}: must be under 200MB");
                    continue;
                }
                try
                {
                    await using var stream = file.OpenReadStream(MaxVideoBytes);
                    using var buffer = new MemoryStream();
                    await stream.CopyToAsync(buffer);
                    var bytes = buffer.ToArray();
                    var mime = ext == ".mov" ? "video/quicktime" : "video/mp4";
                    eventVideos.Add(new VideoItem
                    {
                        FileName = file.Name,
                        ContentType = mime,
                        Bytes = bytes,
                        PreviewUrl = bytes.LongLength <= MaxVideoPreviewBytes
                            ? $"data:{mime};base64,{Convert.ToBase64String(bytes)}"
                            : ""
                    });
                }
                catch (Exception ex)
                {
                    rejected.Add($"{file.Name}: {ex.Message}");
                }
            }
        }
        catch (Exception ex)
        {
            rejected.Add($"Unable to read videos: {ex.Message}");
        }
        finally
        {
            videoError = string.Join("; ", rejected);
            isReadingVideos = false;
        }
    }

    private void RemoveVideo(Guid id) => eventVideos.RemoveAll(v => v.Id == id);

    private class ActivityItem
    {
        public Guid Id { get; set; } = Guid.NewGuid();
        public string Title { get; set; } = "";
        public string StartTime { get; set; } = "";
        public string EndTime { get; set; } = "";
        public int? Participants { get; set; }
        public string Description { get; set; } = "";
        public string Remarks { get; set; } = "";
    }

    private readonly List<ActivityItem> activities = new();
    private Guid? editingActivityId;
    private string activityName = "";
    private TimeOnly? activityStartTime;
    private TimeOnly? activityEndTime;
    private int? activityParticipants;
    private string activityDescription = "";
    private string activityRemarks = "";
    private string activityError = "";

    private void FillActivityName(string name) => activityName = name;

    private void ClearActivityForm()
    {
        editingActivityId = null;
        activityName = activityDescription = activityRemarks = activityError = "";
        activityStartTime = null;
        activityEndTime = null;
        activityParticipants = null;
    }

    private void SaveActivity()
    {
        activityError = "";
        if (string.IsNullOrWhiteSpace(activityName) ||
            !activityStartTime.HasValue ||
            !activityEndTime.HasValue ||
            string.IsNullOrWhiteSpace(activityDescription))
        {
            activityError = "Enter activity name, start time, end time and description.";
            return;
        }
        if (activityEndTime.Value <= activityStartTime.Value)
        {
            activityError = "End time must be later than start time.";
            return;
        }
        if (activityParticipants < 0)
        {
            activityError = "Participants cannot be negative.";
            return;
        }
        ActivityItem? item = editingActivityId.HasValue
            ? activities.FirstOrDefault(x => x.Id == editingActivityId.Value) : null;
        if (item is null)
        {
            item = new ActivityItem();
            activities.Add(item);
        }
        item.Title = activityName.Trim();
        item.StartTime = activityStartTime.Value.ToString("HH:mm", CultureInfo.InvariantCulture);
        item.EndTime = activityEndTime.Value.ToString("HH:mm", CultureInfo.InvariantCulture);
        item.Participants = activityParticipants;
        item.Description = activityDescription.Trim();
        item.Remarks = activityRemarks.Trim();
        ClearActivityForm();
    }

    private void EditActivity(Guid id)
    {
        var item = activities.FirstOrDefault(x => x.Id == id);
        if (item is null) return;
        editingActivityId = id;
        activityName = item.Title;
        activityStartTime = TimeOnly.TryParseExact(item.StartTime, "HH:mm", CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsedStart) ? parsedStart : null;
        activityEndTime = TimeOnly.TryParseExact(item.EndTime, "HH:mm", CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsedEnd) ? parsedEnd : null;
        activityParticipants = item.Participants;
        activityDescription = item.Description;
        activityRemarks = item.Remarks;
        activityError = "";
    }

    private void DeleteActivity(Guid id)
    {
        activities.RemoveAll(x => x.Id == id);
        if (editingActivityId == id) ClearActivityForm();
    }

