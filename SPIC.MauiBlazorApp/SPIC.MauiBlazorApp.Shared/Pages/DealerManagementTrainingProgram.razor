    private void RemoveExpenseEntry(ExpenseItem item)
    {
        if (!CanEditCurrentCSR2) return;
        if (expenseItems.Count(x => x.ExpenseId == item.ExpenseId) <= 1) return;
        foreach (var proof in item.Proofs.Where(x => x.ProofId.HasValue))
            removedProofIds.Add(proof.ProofId!.Value);
        expenseItems.Remove(item);
