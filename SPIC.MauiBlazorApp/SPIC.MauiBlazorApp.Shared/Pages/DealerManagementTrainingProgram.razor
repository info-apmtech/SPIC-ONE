        participantRole = match.Role;
        participantPhoneLookupOpen = false;
        participantPhoneMatches.Clear();
        participantError = "";
    }

    private void AddParticipant()
    {
        if (!CanEditCurrentCSR2) return;
        participantError = "";
        var name = participantName.Trim();
        var phone = participantPhone.Trim();
        var role = participantRole.Trim();

        if (string.IsNullOrWhiteSpace(name) ||
            string.IsNullOrWhiteSpace(phone) ||
            string.IsNullOrWhiteSpace(role))
        {
            participantError = "Please select participant name, phone number and role.";
            ShowCsr2Alert(participantError);
            return;
        }

        if (phone.Length != 10 || !phone.All(char.IsDigit))
        {
            participantError = "Please enter a valid 10-digit mobile number.";
            ShowCsr2Alert(participantError);
            return;
        }

        if (!string.Equals(role, "Other", StringComparison.OrdinalIgnoreCase) &&
            (!participantSourceId.HasValue ||
             participantSourceId.Value <= 0 ||
             string.IsNullOrWhiteSpace(participantSource)))
        {
            participantError = "Please select the participant from the mobile search result.";
            ShowCsr2Alert(participantError);
            return;
        }

        if (participants.Any(p => p.Phone == phone && p.Id != editingParticipantId))
        {
            participantError = "This phone number is already added.";
            ShowCsr2Alert(participantError);
            return;
        }

        if (editingParticipantId is int id)
        {
            var existing = participants.FirstOrDefault(p => p.Id == id);
            if (existing != null)
            {
                existing.ParticipantSourceId = participantSourceId;
                existing.ParticipantSource = participantSource;
                existing.Name = name;
                existing.Phone = phone;
                existing.Role = role;
                existing.Initials = GetInitials(name);
            }
        }
        else
        {
            participants.Add(new PersonInfo
            {
                Id = nextParticipantId++,
                ParticipantSourceId = participantSourceId,
                ParticipantSource = participantSource,
                Name = name,
                Phone = phone,
                Role = role,
                Initials = GetInitials(name)
            });
            participantPage = ParticipantPageCount;
        }

        ClearParticipantForm();
    }

    private void EditParticipant(PersonInfo person)
    {
        if (!CanEditCurrentCSR2) return;
        editingParticipantId = person.Id;
        participantSourceId = person.ParticipantSourceId;
        participantSource = person.ParticipantSource;
        participantName = person.Name;
        participantPhone = person.Phone;
        participantRole = person.Role;
        participantError = "";
    }

    private void DeleteParticipant(int id)
    {
        if (!CanEditCurrentCSR2) return;
        participants.RemoveAll(p => p.Id == id);
        participantPage = Math.Min(participantPage, ParticipantPageCount);
        if (editingParticipantId == id) ClearParticipantForm();
    }

