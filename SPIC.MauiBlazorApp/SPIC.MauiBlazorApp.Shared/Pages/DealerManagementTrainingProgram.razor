    private void InitializeExpensesFromCSR1()
    {
        if (csr1Plan is null) return;
        // Only create rows once so step navigation does not clear entered CSR-2 values.
        if (expenseItems.Count > 0) return;

        var planned = CSR1PlannedExpenses;
        for (var index = 0; index < planned.Count; index++)
        {
            var expense = planned[index];
            expenseItems.Add(new ExpenseItem
            {
                ExpenseId = expense.ExpenseId,
                // Composite key keeps multiple CSR-2 entries distinct for one ExpenseInformation.
                Key = BuildExpenseRowKey(expense.ExpenseId, Guid.NewGuid()),
                Label = expense.Label,
                PlannedAmount = expense.Amount,
                Icon = ExpenseIcons[index % ExpenseIcons.Length],
                IconClass = ExpenseIconClasses[index % ExpenseIconClasses.Length]
            });
        }
    }

    private static string BuildExpenseRowKey(int expenseId, Guid rowId) =>
        $"{expenseId}:{rowId:N}";

    private static int ParseExpenseIdFromRowKey(string? key)
    {
        if (string.IsNullOrWhiteSpace(key)) return 0;
        var separator = key.IndexOf(':');
        var idPart = separator >= 0 ? key[..separator] : key;
        return int.TryParse(idPart, NumberStyles.Integer, CultureInfo.InvariantCulture, out var id) ? id : 0;
    }

    private void AddExpenseEntry(ExpenseItem category)
    {
        if (csr2Status != "Draft") return;
        var rowId = Guid.NewGuid();
        expenseItems.Add(new ExpenseItem
        {
            RowId = rowId,
            ExpenseId = category.ExpenseId,
            Key = BuildExpenseRowKey(category.ExpenseId, rowId),
            Label = category.Label,
            PlannedAmount = category.PlannedAmount,
            Icon = category.Icon,
            IconClass = category.IconClass
        });
    }

    private void RemoveExpenseEntry(ExpenseItem item)
    {
        if (csr2Status != "Draft") return;
        if (expenseItems.Count(x => x.ExpenseId == item.ExpenseId) <= 1) return;
        foreach (var proof in item.Proofs.Where(x => x.ProofId.HasValue))
            removedProofIds.Add(proof.ProofId!.Value);
        expenseItems.Remove(item);
    }

    private async Task OnExpenseProofSelected(InputFileChangeEventArgs e, ExpenseItem item)
    {
        item.Error = "";
        var rejected = new List<string>();
        try
        {
            foreach (var file in e.GetMultipleFiles(20))
            {
                var extension = System.IO.Path.GetExtension(file.Name).ToLowerInvariant();
                if (extension != ".pdf" && extension != ".jpg" && extension != ".jpeg" && extension != ".png")
                {
                    rejected.Add($"{file.Name}: PDF/JPG/PNG only");
                    continue;
                }
                if (file.Size == 0 || file.Size > MaxExpenseProofBytes)
                {
                    rejected.Add($"{file.Name}: must be smaller than 10 MB");
                    continue;
                }
                await using var stream = file.OpenReadStream(MaxExpenseProofBytes);
                using var memory = new MemoryStream();
                await stream.CopyToAsync(memory);
                item.Proofs.Add(new ExpenseProofItem
                {
                    FileName = file.Name,
                    ContentType = file.ContentType,
                    Bytes = memory.ToArray()
                });
            }
        }
        catch (Exception ex)
        {
            rejected.Add($"Unable to read proof selection: {ex.Message}");
        }

        if (rejected.Count > 0)
        {
            item.Error = string.Join("; ", rejected);
            ShowCsr2Alert(item.Error);
        }
    }

    private void RemoveExpenseProof(ExpenseItem item, ExpenseProofItem proof)
    {
        if (proof.ProofId.HasValue) removedProofIds.Add(proof.ProofId.Value);
        item.Proofs.Remove(proof);
        item.Error = "";
    }

