@page "/CSR-2ProgramExecution"

<div class="container-fluid py-4 px-0">
    <div class="csr2x-wrapper">

        <!-- Header -->
        <div class="csr2x-header">
            <h1>CSR-2 Program Execution</h1>
            <p>Manage your assigned programs. Track activities, attendance, and expenses.</p>
        </div>

        <!-- Upcoming CSR Program Notification -->
        @if (showUpcomingBanner)
        {
            <div class="csr2x-banner">
                <div class="csr2x-banner-left">
                    <div class="csr2x-banner-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                        </svg>
                    </div>
                    <div class="csr2x-banner-text">
                        <h4>Upcoming CSR Program</h4>
                        <p>Dealer Management Training Program is scheduled for tomorrow, 19 Aug 2026.</p>
                        <div class="csr2x-banner-meta">
                            <span>
                                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                                19 Aug 2026
                            </span>
                            <span>
                                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                                09:00 AM - 05:00 PM
                            </span>
                            <span>
                                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                                Hotel Valarmathi, Tirunelveli
                            </span>
                        </div>
                    </div>
                </div>
                <div class="csr2x-banner-actions">
                    <button type="button" class="csr2x-btn-outline" @onclick="() => showUpcomingBanner = false">Close</button>
                    <button type="button" class="csr2x-btn-solid-green">View Event Detailes</button>
                    <button type="button" class="csr2x-banner-dismiss" @onclick="() => showUpcomingBanner = false" aria-label="Dismiss notification">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
            </div>
        }

        <!-- Summary Cards -->
        <div class="csr2x-stats-grid-4">

            <div class="csr2x-stat-card csr2x-theme-blue">
                <div class="csr2x-card-body">
                    <div class="csr2x-stat-text">
                        <h2>12</h2>
                        <p>Total CSR -2</p>
                    </div>
                    <div class="csr2x-stat-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
                            <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
                            <path d="M9 12h6"></path>
                            <path d="M9 16h6"></path>
                        </svg>
                    </div>
                </div>
                <div class="csr2x-card-footer">
                    <span>View all</span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                </div>
            </div>

            <div class="csr2x-stat-card csr2x-theme-green">
                <div class="csr2x-card-body">
                    <div class="csr2x-stat-text">
                        <h2>5</h2>
                        <p>Completed</p>
                    </div>
                    <div class="csr2x-stat-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.76 4 4 0 0 1-4.78 4.78 4 4 0 0 1-6.74 0 4 4 0 0 1-4.78-4.78 4 4 0 0 1 0-6.76Z"></path>
                            <path d="m9 12 2 2 4-4"></path>
                        </svg>
                    </div>
                </div>
                <div class="csr2x-card-footer">
                    <span>View Completed</span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                </div>
            </div>

            <div class="csr2x-stat-card csr2x-theme-orange">
                <div class="csr2x-card-body">
                    <div class="csr2x-stat-text">
                        <h2>3</h2>
                        <p>In Progress</p>
                    </div>
                    <div class="csr2x-stat-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <circle cx="16" cy="16" r="5" fill="#fff9ea"></circle>
                            <polyline points="16 14 16 16 17.5 17.5"></polyline>
                        </svg>
                    </div>
                </div>
                <div class="csr2x-card-footer">
                    <span>View In Progress</span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                </div>
            </div>

            <div class="csr2x-stat-card csr2x-theme-gray">
                <div class="csr2x-card-body">
                    <div class="csr2x-stat-text">
                        <h2>2</h2>
                        <p>Drafts</p>
                    </div>
                    <div class="csr2x-stat-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <path d="M16.5 17.5 15 18l.5-1.5L21 11l1.5 1.5-6 5.5Z" fill="#f1f5f9"></path>
                        </svg>
                    </div>
                </div>
                <div class="csr2x-card-footer">
                    <span>View drafts</span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                </div>
            </div>

        </div>

        <!-- Filters (expandable) -->
        <div class="csr2x-filter-card">
            <div class="csr2x-filter-header" @onclick="ToggleFilters">
                <div class="csr2x-filter-title">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="4" y1="6" x2="20" y2="6"></line>
                        <line x1="6" y1="12" x2="18" y2="12"></line>
                        <line x1="8" y1="18" x2="16" y2="18"></line>
                    </svg>
                    Filters
                </div>
                <svg class="csr2x-filter-chevron @(isFiltersExpanded ? "csr2x-chevron-open" : "")" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
            </div>

            @if (isFiltersExpanded)
            {
                <div class="csr2x-filter-body">
                    <div class="csr2x-filter-grid">

                        <div class="csr2x-form-group">
                            <label class="csr2x-form-label">Date Range</label>
                            <div class="csr2x-input-wrapper">
                                <input type="text" class="csr2x-form-control" placeholder="01 Apr 2025 - 28 Apr 2025" readonly style="padding-right: 36px;">
                                <svg class="csr2x-input-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                    <line x1="16" y1="2" x2="16" y2="6"></line>
                                    <line x1="8" y1="2" x2="8" y2="6"></line>
                                    <line x1="3" y1="10" x2="21" y2="10"></line>
                                </svg>
                            </div>
                        </div>

                        <div class="csr2x-form-group">
                            <label class="csr2x-form-label">Program Type</label>
                            <select class="csr2x-form-select">
                                <option value="" disabled selected hidden>All Program Type</option>
                            </select>
                        </div>

                        <div class="csr2x-form-group">
                            <label class="csr2x-form-label">Program Name</label>
                            <select class="csr2x-form-select">
                                <option value="" disabled selected hidden>All Program Name</option>
                            </select>
                        </div>

                        <div class="csr2x-form-group">
                            <label class="csr2x-form-label">Location</label>
                            <select class="csr2x-form-select">
                                <option value="" disabled selected hidden>All Location</option>
                            </select>
                        </div>

                    </div>

                    <div class="csr2x-filter-grid">
                        <div class="csr2x-form-group">
                            <label class="csr2x-form-label">Status</label>
                            <select class="csr2x-form-select">
                                <option value="" disabled selected hidden>All Statuses</option>
                            </select>
                        </div>
                    </div>

                    <div class="csr2x-filter-actions">
                        <button class="csr2x-btn csr2x-btn-outline">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                <line x1="6" y1="6" x2="18" y2="18"></line>
                            </svg>
                            Clear All
                        </button>
                        <button class="csr2x-btn csr2x-btn-solid">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="4" y1="6" x2="20" y2="6"></line>
                                <line x1="6" y1="12" x2="18" y2="12"></line>
                                <line x1="8" y1="18" x2="16" y2="18"></line>
                            </svg>
                            Apply Filters
                        </button>
                    </div>
                </div>
            }
        </div>

        <!-- Assigned Programs Table -->
        <div class="csr2x-table-card">

            <div class="csr2x-table-top">
                <h3>Assigned Programs</h3>

                <div class="csr2x-table-actions">
                    <input type="text" class="csr2x-search-input" placeholder="Search Programs or Sanction number">

                    <button class="csr2x-btn-outline">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2v6h-6"></path><path d="M3 12a9 9 0 1 0 2.13-5.88L2 9"></path></svg>
                        Refresh Data
                    </button>
                    <button class="csr2x-btn-outline">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><path d="M8 13h2"></path><path d="M8 17h2"></path><path d="M14 13h2"></path><path d="M14 17h2"></path></svg>
                        Excel
                    </button>
                    <button class="csr2x-btn-outline">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><path d="M9 15v-4"></path><path d="M12 15v-4c1 0 2 1 2 2s-1 2-2 2"></path><path d="M16 11v4"></path><path d="M16 13h2"></path></svg>
                        PDF
                    </button>
                    <button class="csr2x-btn-outline-green">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                        Send Mail
                    </button>
                </div>
            </div>

            <div class="csr2x-table-wrapper">
                <table class="csr2x-main-table">
                    <thead>
                        <tr>
                            <th><input type="checkbox" class="csr2x-checkbox"></th>
                            <th>Sanction Number</th>
                            <th>Program Type</th>
                            <th>Program</th>
                            <th>Location</th>
                            <th>Approved Budget</th>
                            <th>Report Completion</th>
                            <th>Status</th>
                            <th style="text-align: right;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var program in assignedPrograms)
                        {
                            <tr>
                                <td><input type="checkbox" class="csr2x-checkbox"></td>
                                <td>@program.SanctionNumber</td>
                                <td>@program.ProgramType</td>
                                <td>@program.ProgramName</td>
                                <td>@program.Location</td>
                                <td>@program.ApprovedBudget</td>
                                <td>
                                    <div class="csr2x-progress-wrap">
                                        <div class="csr2x-progress-track">
                                            <div class="csr2x-progress-fill" style="width: @(program.ReportCompletionPercent)%;"></div>
                                        </div>
                                        <span class="csr2x-progress-text">@(program.ReportCompletionPercent)%</span>
                                    </div>
                                </td>
                                <td><span class="csr2x-badge csr2x-badge-amber">@program.Status</span></td>
                                <td style="text-align: right;">
                                    <div class="csr2x-actions-cell">
                                        <button class="csr2x-action-btn csr2x-icon-view" aria-label="View">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                        </button>
                                        <button class="csr2x-action-btn csr2x-icon-delete" aria-label="Remove">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                                        </button>
                                        <button class="csr2x-btn-execution">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
                                            @program.ActionLabel
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="csr2x-pagination">
                <div class="csr2x-page-size">
                    <span>Items Per Page</span>
                    <select class="csr2x-page-size-select">
                        <option>16</option>
                    </select>
                </div>
                <div class="csr2x-page-controls">
                    <button class="csr2x-page-btn"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg></button>
                    <button class="csr2x-page-btn active">1</button>
                    <button class="csr2x-page-btn">2</button>
                    <button class="csr2x-page-btn">3</button>
                    <button class="csr2x-page-btn dots">..</button>
                    <button class="csr2x-page-btn">8</button>
                    <button class="csr2x-page-btn">9</button>
                    <button class="csr2x-page-btn">10</button>
                    <button class="csr2x-page-btn"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg></button>
                </div>
            </div>
        </div>

    </div>
</div>

@code {
    // UI-only view state. Static/mock display data below — no API, calculation or business logic.
    private bool showUpcomingBanner = true;
    private bool isFiltersExpanded = true;

    private void ToggleFilters() => isFiltersExpanded = !isFiltersExpanded;

    private class AssignedProgram
    {
        public string SanctionNumber { get; set; } = "";
        public string ProgramType { get; set; } = "";
        public string ProgramName { get; set; } = "";
        public string Location { get; set; } = "";
        public string ApprovedBudget { get; set; } = "";
        public int ReportCompletionPercent { get; set; }
        public string Status { get; set; } = "";
        public string ActionLabel { get; set; } = "";
    }

    private readonly List<AssignedProgram> assignedPrograms = new()
    {
        new AssignedProgram
        {
            SanctionNumber = "CSR1-2026-045",
            ProgramType = "Farmer Type",
            ProgramName = "Dealer Management Training Programe",
            Location = "Pune, Maharashtra",
            ApprovedBudget = "₹ 50,00,000",
            ReportCompletionPercent = 0,
            Status = "Upcoming Event",
            ActionLabel = "View Event"
        },
        new AssignedProgram
        {
            SanctionNumber = "CSR1-2026-045",
            ProgramType = "Farmer Type",
            ProgramName = "Dealer Management Training Programe",
            Location = "Pune, Maharashtra",
            ApprovedBudget = "₹ 50,00,000",
            ReportCompletionPercent = 80,
            Status = "Pending",
            ActionLabel = "Continue CSR-2"
        }
    };
}
