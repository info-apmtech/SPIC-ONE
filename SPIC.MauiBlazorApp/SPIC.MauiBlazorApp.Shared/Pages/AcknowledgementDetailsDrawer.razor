@using SPIC.Core.DTOs
@using System.Globalization
@inject IJSRuntime JS

@*
    Acknowledgement row details. BottomSheet renders a bottom sheet on phones and
    the familiar right-side drawer on tablet/desktop; the body markup is unchanged.
*@
<BottomSheet @bind-IsOpen="IsOpen" Title="Acknowledgement Details" CssClass="add-sheet">
    <HeaderActions>
        @if (Row is not null)
        {
            <div class="add-status-badge" style="background:@BadgeBg(); color:@BadgeFg();">
                <div class="add-dot" style="background:@BadgeFg();"></div>
                @Row.Bucket
            </div>
        }
    </HeaderActions>
    <ChildContent>
        @if (Row is not null)
        {
            <div class="add-body">

                <!-- Basic Information -->
                <div class="add-section">
                    <h3>Basic Information</h3>
                    <div class="add-row">
                        <span class="add-label">Transaction ID</span>
                        <span class="add-value"><span class="add-colon">:</span> @Dash(Row.TransactionId)</span>
                    </div>
                    <div class="add-row">
                        <span class="add-label">Invoice No</span>
                        <span class="add-value"><span class="add-colon">:</span> @Dash(Row.InvoiceNo)</span>
                    </div>
                    <div class="add-row">
                        <span class="add-label">Invoice Date</span>
                        <span class="add-value"><span class="add-colon">:</span> @Date(Row.InvoiceDate)</span>
                    </div>
                    <div class="add-row">
                        <span class="add-label">Entry Date</span>
                        <span class="add-value"><span class="add-colon">:</span> @Date(Row.EntryDate)</span>
                    </div>
                    <div class="add-row">
                        <span class="add-label">Receipt Date</span>
                        <span class="add-value"><span class="add-colon">:</span> @Date(Row.ReceiptDate)</span>
                    </div>
                    <div class="add-row">
                        <span class="add-label">Acknowledgement Cycle</span>
                        <span class="add-value" style="color:@BadgeFg();"><span class="add-colon">:</span> @Row.CycleDays Days</span>
                    </div>
                </div>

                <!-- Dealer Information -->
                <div class="add-section">
                    <h3>Dealer Information</h3>
                    <div class="add-row">
                        <span class="add-label">Dealer Name</span>
                        <span class="add-value"><span class="add-colon">:</span> @Dash(Row.DealerName)</span>
                    </div>
                    <div class="add-row">
                        <span class="add-label">Dealer ID</span>
                        <span class="add-value"><span class="add-colon">:</span> @Dash(Row.DealerCode)</span>
                    </div>
                    <div class="add-row align-items-center">
                        <span class="add-label">Channel</span>
                        <span class="add-value add-val-flex">
                            <span class="add-colon">:</span>
                            <div class="add-outline-badge add-outline-blue">@ChannelLabel()</div>
                        </span>
                    </div>
                    <div class="add-row align-items-center">
                        <span class="add-label">Mobile No.</span>
                        <span class="add-value add-val-flex">
                            <span class="add-colon">:</span> @Dash(Row.MobileNo)
                            @if (!string.IsNullOrWhiteSpace(Row.MobileNo))
                            {
                                <span class="add-contact-actions">
                                    <button type="button" class="add-contact-btn add-wa" title="WhatsApp" aria-label="WhatsApp @Row.MobileNo" @onclick="() => OpenWhatsApp(Row.MobileNo!)">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
                                    </button>
                                    <button type="button" class="add-contact-btn add-call" title="Call" aria-label="Call @Row.MobileNo" @onclick="() => Call(Row.MobileNo!)">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                                    </button>
                                    <button type="button" class="add-contact-btn add-sms" title="SMS" aria-label="SMS @Row.MobileNo" @onclick="() => SendSms(Row.MobileNo!)">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                                    </button>
                                </span>
                            }
                        </span>
                    </div>
                </div>

                <!-- Location Information -->
                <div class="add-section">
                    <h3>Location Information</h3>
                    <div class="add-row">
                        <span class="add-label">State / District</span>
                        <span class="add-value"><span class="add-colon">:</span> @Dash(Row.StateName) / @Dash(Row.District)</span>
                    </div>
                </div>

                <!-- Product Information -->
                <div class="add-section">
                    <h3>Product Information</h3>
                    <div class="add-row">
                        <span class="add-label">Product</span>
                        <span class="add-value"><span class="add-colon">:</span> @Dash(Row.ProductName)</span>
                    </div>
                    <div class="add-row">
                        <span class="add-label">Quantity (MT)</span>
                        <span class="add-value"><span class="add-colon">:</span> @Num(Row.QuantityMT)</span>
                    </div>
                    <div class="add-row">
                        <span class="add-label">Received Quantity</span>
                        <span class="add-value"><span class="add-colon">:</span> @Num(Row.ReceivedQuantity)</span>
                    </div>
                </div>

                <!-- Payment / Dispatch Information -->
                <div class="add-section">
                    <h3>Payment / Dispatch Information</h3>
                    <div class="add-row">
                        <span class="add-label">DD / Dispatch No.</span>
                        <span class="add-value"><span class="add-colon">:</span> @Dash(Row.DdNo)</span>
                    </div>
                    <div class="add-row">
                        <span class="add-label">Workflow Status</span>
                        <span class="add-value"><span class="add-colon">:</span> @Dash(Row.WorkflowStatus)</span>
                    </div>
                </div>

                <!-- Status Information -->
                <div class="add-section">
                    <h3>Status Information</h3>
                    <div class="add-alert-box" style="background:@BadgeBg(); border-color:@BadgeFg(); color:@BadgeFg();">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                            <line x1="12" y1="9" x2="12" y2="13"></line>
                            <line x1="12" y1="17" x2="12.01" y2="17"></line>
                        </svg>
                        @Row.Bucket cycle — acknowledged in @Row.CycleDays days
                    </div>
                </div>

            </div>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="add-btn-outline" @onclick="CloseDrawer">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
            Close
        </button>
        <button type="button" class="add-btn-outline">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
                <polyline points="17 6 23 6 23 12"></polyline>
            </svg>
            Escalate
        </button>
        <button type="button" class="add-btn-solid">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="22" y1="2" x2="11" y2="13"></line>
                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
            </svg>
            Send Reminder
        </button>
    </Footer>
</BottomSheet>

<style>
    /* --- SCOPED CSS FOR ACKNOWLEDGEMENT DETAILS DRAWER (content only; the
       overlay / panel / header / footer chrome comes from BottomSheet) --- */

    .add-sheet .fb-sheet__panel {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    .add-status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 11px;
        font-weight: 600;
        padding: 4px 10px;
        border-radius: 20px;
        width: fit-content;
        white-space: nowrap;
    }

    .add-dot { width: 6px; height: 6px; border-radius: 50%; }

    .add-sheet .add-body {
        padding: 4px 4px 8px;
        display: flex; flex-direction: column; gap: 20px;
    }

    .add-section {
        display: flex; flex-direction: column; gap: 14px;
        padding-bottom: 20px; border-bottom: 1px solid #d1fae5;
    }
    .add-section:last-child { border-bottom: none; padding-bottom: 0; }
    .add-section h3 { margin: 0 0 4px 0; font-size: 14px; font-weight: 700; color: #059669; }

    .add-row { display: flex; align-items: flex-start; font-size: 13px; line-height: 1.5; }
    .add-row.align-items-center { align-items: center; }

    .add-label { width: 200px; flex-shrink: 0; color: #64748b; font-weight: 500; }
    .add-value { flex: 1; color: #334155; font-weight: 600; display: flex; align-items: flex-start; }
    .add-val-flex { align-items: center; flex-wrap: wrap; }
    .add-colon { margin-right: 12px; color: #64748b; font-weight: 500; }

    /* Contact (WhatsApp / Call / SMS) action buttons */
    .add-contact-actions { display: inline-flex; gap: 6px; margin-left: 10px; }
    .add-contact-btn {
        display: inline-flex; align-items: center; justify-content: center;
        width: 30px; height: 30px; border-radius: 7px; border: 1px solid #e2e8f0;
        background: #fff; cursor: pointer; transition: all .15s ease;
    }
    .add-contact-btn:hover { transform: translateY(-1px); box-shadow: 0 2px 6px rgba(0,0,0,.08); }
    .add-contact-btn.add-wa   { color: #16a34a; }
    .add-contact-btn.add-wa:hover   { background: #16a34a; color: #fff; }
    .add-contact-btn.add-call { color: #2563eb; }
    .add-contact-btn.add-call:hover { background: #2563eb; color: #fff; }
    .add-contact-btn.add-sms  { color: #9333ea; }
    .add-contact-btn.add-sms:hover  { background: #9333ea; color: #fff; }

    .add-outline-badge {
        display: inline-flex; align-items: center; justify-content: center;
        padding: 4px 10px; border-radius: 6px; font-size: 11px; font-weight: 500;
        white-space: nowrap; border: 1px solid;
    }
    .add-outline-blue { color: #6366f1; background-color: #ffffff; border-color: #c7d2fe; }

    .add-alert-box {
        border: 1px solid; border-radius: 8px; padding: 12px 16px;
        display: flex; align-items: center; gap: 10px; font-weight: 600; font-size: 13px;
    }

    .add-btn-solid {
        display: flex; align-items: center; justify-content: center; gap: 8px; background-color: #14532d; color: #ffffff;
        border: none; border-radius: 6px; padding: 10px 16px; font-size: 13px; font-weight: 600;
        cursor: pointer; transition: background-color 0.2s;
    }
    .add-btn-solid:hover { background-color: #166534; }
    .add-btn-outline {
        display: flex; align-items: center; justify-content: center; gap: 8px; background-color: #ffffff; color: #475569;
        border: 1px solid #cbd5e1; border-radius: 6px; padding: 9px 16px; font-size: 13px;
        font-weight: 600; cursor: pointer; transition: all 0.2s;
    }
    .add-btn-outline:hover { background-color: #f8fafc; border-color: #94a3b8; color: #334155; }

    /* native: phone */
    @@media (max-width: 767.98px) {
        .add-label { width: 130px; }
        .add-contact-actions { margin-left: 0; width: 100%; padding-top: 6px; }
        .add-contact-btn { width: var(--tap-min, 44px); height: var(--tap-min, 44px); }
        .add-contact-btn svg { width: 20px; height: 20px; }
    }
</style>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public AckCycleRowDto? Row { get; set; }

    private static readonly CultureInfo Inv = CultureInfo.InvariantCulture;

    private async Task CloseDrawer()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(IsOpen);
    }

    private static string Dash(string? v) => string.IsNullOrWhiteSpace(v) ? "-" : v!;
    private static string Date(DateTime? d) => d?.ToString("dd-MM-yyyy") ?? "-";
    private static string Num(decimal v) => v.ToString("0.###", Inv);

    private string ChannelLabel() => Row?.Source switch
    {
        "Company Sales" => "Company",
        "Wholesaler Sales" => "Wholesaler",
        _ => Dash(Row?.Source)
    };

    // Colour follows the cycle bucket.
    private string BadgeFg() => Row?.Bucket switch
    {
        "Fast" => "#059669",
        "Normal" => "#ca8a04",
        "Delayed" => "#ea580c",
        "Critical" => "#ef4444",
        _ => "#64748b"
    };

    private string BadgeBg() => Row?.Bucket switch
    {
        "Fast" => "#d1fae5",
        "Normal" => "#fef9c3",
        "Delayed" => "#ffedd5",
        "Critical" => "#fee2e2",
        _ => "#f1f5f9"
    };

    // ---- Contact actions (same convention as the other drawers) ----

    // Opens a WhatsApp chat. Indian 10-digit numbers get the 91 prefix; numbers
    // that already carry a country code are used as-is.
    private async Task OpenWhatsApp(string number)
    {
        var digits = new string((number ?? "").Where(char.IsDigit).ToArray());
        if (digits.Length == 0) return;

        var wa = digits.Length == 10 ? "91" + digits : digits;
        var msg = Uri.EscapeDataString(
            $"Acknowledgement Cycle\nInvoice: {Row?.InvoiceNo}\nDealer: {Row?.DealerName}\n" +
            $"State/District: {Row?.StateName} / {Row?.District}\nProduct: {Row?.ProductName}\n" +
            $"Cycle: {Row?.CycleDays} days ({Row?.Bucket})");

        await JS.InvokeVoidAsync("open", $"https://wa.me/{wa}?text={msg}", "_blank");
    }

    // Opens the device dialer.
    private async Task Call(string number)
    {
        if (string.IsNullOrWhiteSpace(number)) return;
        await JS.InvokeVoidAsync("open", $"tel:{number}", "_self");
    }

    // Opens the device SMS composer.
    private async Task SendSms(string number)
    {
        if (string.IsNullOrWhiteSpace(number)) return;
        await JS.InvokeVoidAsync("open", $"sms:{number}", "_self");
    }
}
