@if (IsOpen)
{
    <div class="add-overlay" @onclick="CloseDrawer">
        <div class="add-drawer" @onclick:stopPropagation="true">
            
            <!-- Drawer Header -->
            <div class="add-header">
                <div class="add-header-titles">
                    <h2>Acknowledgement Details</h2>
                    <div class="add-status-badge add-st-red">
                        <div class="add-dot"></div>
                        Critical
                    </div>
                </div>
                <button class="add-close-icon" @onclick="CloseDrawer" aria-label="Close">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="15" y1="9" x2="9" y2="15"></line>
                        <line x1="9" y1="9" x2="15" y2="15"></line>
                    </svg>
                </button>
            </div>

            <!-- Drawer Body -->
            <div class="add-body">
                
                <!-- Basic Information -->
                <div class="add-section">
                    <h3>Basic Information</h3>
                    <div class="add-row">
                        <span class="add-label">Transaction ID</span>
                        <span class="add-value"><span class="add-colon">:</span> 100185299086</span>
                    </div>
                    <div class="add-row">
                        <span class="add-label">Invoice No</span>
                        <span class="add-value"><span class="add-colon">:</span> 3326100255</span>
                    </div>
                    <div class="add-row">
                        <span class="add-label">Invoice Date</span>
                        <span class="add-value"><span class="add-colon">:</span> 05-04-2026</span>
                    </div>
                    <div class="add-row">
                        <span class="add-label">Entry Date</span>
                        <span class="add-value"><span class="add-colon">:</span> 05-04-2026</span>
                    </div>
                    <div class="add-row">
                        <span class="add-label">Acknowledgement Cycle</span>
                        <span class="add-value add-txt-red"><span class="add-colon">:</span> 10 Days</span>
                    </div>
                    <div class="add-row">
                        <span class="add-label">Pending Acknowledgement Age</span>
                        <span class="add-value add-txt-red"><span class="add-colon">:</span> 10 Days</span>
                    </div>
                </div>

                <!-- Dealer Information -->
                <div class="add-section">
                    <h3>Dealer Information</h3>
                    <div class="add-row">
                        <span class="add-label">Dealer Name</span>
                        <span class="add-value"><span class="add-colon">:</span> Monsoon Agro Centre</span>
                    </div>
                    <div class="add-row">
                        <span class="add-label">Dealer ID</span>
                        <span class="add-value"><span class="add-colon">:</span> 223331</span>
                    </div>
                    <div class="add-row align-items-center">
                        <span class="add-label">Dealer Type</span>
                        <span class="add-value add-val-flex">
                            <span class="add-colon">:</span>
                            <div class="add-outline-badge add-outline-blue">
                                Wholesaler
                            </div>
                        </span>
                    </div>
                    <div class="add-row">
                        <span class="add-label">Mobile No.</span>
                        <span class="add-value"><span class="add-colon">:</span> 8765432109</span>
                    </div>
                </div>

                <!-- Location Information -->
                <div class="add-section">
                    <h3>Location Information</h3>
                    <div class="add-row">
                        <span class="add-label">State / District</span>
                        <span class="add-value"><span class="add-colon">:</span> Tamil Nadu / Coimbatore</span>
                    </div>
                </div>

                <!-- Product Information -->
                <div class="add-section">
                    <h3>Product Information</h3>
                    <div class="add-row">
                        <span class="add-label">Product</span>
                        <span class="add-value"><span class="add-colon">:</span> Neem Coated Urea (45 Kg)</span>
                    </div>
                    <div class="add-row">
                        <span class="add-label">Quantity (MT)</span>
                        <span class="add-value"><span class="add-colon">:</span> 15.3</span>
                    </div>
                    <div class="add-row">
                        <span class="add-label">Received Quantity</span>
                        <span class="add-value"><span class="add-colon">:</span> 0</span>
                    </div>
                </div>

                <!-- Payment / Dispatch Information -->
                <div class="add-section">
                    <h3>Payment / Dispatch Information</h3>
                    <div class="add-row">
                        <span class="add-label">DD No.</span>
                        <span class="add-value"><span class="add-colon">:</span> 1.00153E+11</span>
                    </div>
                </div>

                <!-- Status Information -->
                <div class="add-section">
                    <h3>Status Information</h3>
                    <div class="add-alert-box">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                            <line x1="12" y1="9" x2="12" y2="13"></line>
                            <line x1="12" y1="17" x2="12.01" y2="17"></line>
                        </svg>
                        Critical
                    </div>
                </div>

            </div>

            <!-- Drawer Footer -->
            <div class="add-footer">
                <button class="add-btn-outline" @onclick="CloseDrawer">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                    Close
                </button>
                <button class="add-btn-outline">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
                        <polyline points="17 6 23 6 23 12"></polyline>
                    </svg>
                    Escalate
                </button>
                <button class="add-btn-solid">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="22" y1="2" x2="11" y2="13"></line>
                        <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                    </svg>
                    Send Reminder
                </button>
            </div>

        </div>
    </div>
}

<style>
    /* --- SCOPED CSS FOR ACKNOWLEDGEMENT DETAILS DRAWER --- */
    
    .add-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-color: rgba(0, 0, 0, 0.4); 
        z-index: 9998;
        display: flex;
        justify-content: flex-end;
    }

    /* Floating Drawer Design */
    .add-drawer {
        width: 440px; /* Made slightly wider to fit the long labels */
        max-width: calc(100vw - 32px);
        height: calc(100vh - 32px); 
        margin: 16px; 
        background-color: #ffffff;
        border-radius: 16px; 
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
        display: flex;
        flex-direction: column;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        animation: addSlideIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        z-index: 9999;
        overflow: hidden;
    }

    @@keyframes addSlideIn {
        from { transform: translateX(100%); opacity: 0; }
        to { transform: translateX(0); opacity: 1; }
    }

    /* Header */
    .add-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        padding: 24px 32px 16px 32px;
        border-bottom: 1px solid #f1f5f9;
        background-color: #ffffff;
        z-index: 10;
    }

    .add-header-titles {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .add-header-titles h2 {
        margin: 0;
        font-size: 22px;
        font-weight: 700;
        color: #334155;
    }

    /* Header Status Badge */
    .add-status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 11px;
        font-weight: 600;
        padding: 4px 10px;
        border-radius: 20px;
        width: fit-content;
    }

    .add-st-red {
        background-color: #fee2e2;
        color: #ef4444;
    }

    .add-st-red .add-dot {
        background-color: #ef4444;
    }

    .add-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
    }

    .add-close-icon {
        background: none;
        border: none;
        cursor: pointer;
        padding: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: opacity 0.2s;
    }

    .add-close-icon:hover {
        opacity: 0.6;
    }

    /* Body & Scrollbar */
    .add-body {
        padding: 24px 32px;
        overflow-y: auto;
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 20px; 
    }

    .add-body::-webkit-scrollbar { width: 6px; }
    .add-body::-webkit-scrollbar-track { background: transparent; }
    .add-body::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
    .add-body::-webkit-scrollbar-thumb:hover { background: #94a3b8; }

    /* Sections WITH Green Dividers */
    .add-section {
        display: flex;
        flex-direction: column;
        gap: 14px;
        padding-bottom: 20px;
        border-bottom: 1px solid #d1fae5; 
    }

    .add-section:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }

    .add-section h3 {
        margin: 0 0 4px 0;
        font-size: 14px;
        font-weight: 700;
        color: #059669; 
    }

    .add-row {
        display: flex;
        align-items: flex-start;
        font-size: 13px;
        line-height: 1.5;
    }

    .add-row.align-items-center {
        align-items: center;
    }

    .add-label {
        width: 200px; /* Made wider to fit "Pending Acknowledgement Age" perfectly */
        flex-shrink: 0;
        color: #64748b;
        font-weight: 500;
    }

    .add-value {
        flex: 1;
        color: #334155;
        font-weight: 600;
        display: flex;
        align-items: flex-start;
    }

    .add-txt-red {
        color: #ef4444 !important;
    }

    .add-val-flex {
        align-items: center;
    }

    .add-colon {
        margin-right: 12px;
        color: #64748b;
        font-weight: 500;
    }

    /* Outline Badges */
    .add-outline-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 500;
        white-space: nowrap;
        border: 1px solid;
    }
    
    .add-outline-blue {
        color: #6366f1;
        background-color: #ffffff;
        border-color: #c7d2fe;
    }

    /* Full Width Alert Box */
    .add-alert-box {
        background-color: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 8px;
        padding: 12px 16px;
        display: flex;
        align-items: center;
        gap: 10px;
        color: #ef4444;
        font-weight: 600;
        font-size: 13px;
    }

    /* Footer */
    .add-footer {
        padding: 20px 32px;
        border-top: 1px solid #f1f5f9;
        background-color: #ffffff;
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .add-btn-solid {
        display: flex;
        align-items: center;
        gap: 8px;
        background-color: #14532d; 
        color: #ffffff;
        border: none;
        border-radius: 6px;
        padding: 10px 16px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 0.2s;
    }

    .add-btn-solid:hover {
        background-color: #166534;
    }

    .add-btn-outline {
        display: flex;
        align-items: center;
        gap: 8px;
        background-color: #ffffff; 
        color: #475569;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        padding: 9px 16px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }

    .add-btn-outline:hover {
        background-color: #f8fafc;
        border-color: #94a3b8;
        color: #334155;
    }

    /* Responsive */
    @@media (max-width: 540px) {
        .add-drawer {
            width: 100vw;
            height: 100vh;
            max-width: 100vw;
            margin: 0;
            border-radius: 0;
        }
        .add-label {
            width: 140px; /* Shrink label on small screens */
        }
        .add-footer {
            flex-direction: column;
            width: 100%;
        }
        .add-footer button {
            width: 100%;
            justify-content: center;
        }
    }
</style>

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    private async Task CloseDrawer()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(IsOpen);
    }
}