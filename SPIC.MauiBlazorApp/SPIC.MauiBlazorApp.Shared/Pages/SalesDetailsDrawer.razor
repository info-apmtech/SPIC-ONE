@using SPIC.Core.DTOs

@if (IsOpen)
{
    <div class="sd-overlay" @onclick="CloseDrawer">
        <div class="sd-drawer" @onclick:stopPropagation="true">

            <div class="sd-header">
                <div class="sd-header-titles">
                    <h2>Stock Details</h2>
                    <div class="sd-status-badge">
                        <div class="sd-dot"></div>
                        @(Row?.Status ?? "—")
                    </div>
                </div>
                <button class="sd-close-icon" @onclick="CloseDrawer" aria-label="Close">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="15" y1="9" x2="9" y2="15"></line>
                        <line x1="9" y1="9" x2="15" y2="15"></line>
                    </svg>
                </button>
            </div>

            <div class="sd-body">

                <div class="sd-section">
                    <h3>Dealer Information</h3>
                    <div class="sd-row">
                        <span class="sd-label">Dealer Name</span>
                        <span class="sd-value"><span class="sd-colon">:</span> @(Row?.DealerName)</span>
                    </div>
                    <div class="sd-row">
                        <span class="sd-label">Dealer ID</span>
                        <span class="sd-value"><span class="sd-colon">:</span> @(Row?.DealerRegistrationId?.ToString() ?? "—")</span>
                    </div>
                    <div class="sd-row">
                        <span class="sd-label">Mobile No.</span>
                        <span class="sd-value"><span class="sd-colon">:</span> @(string.IsNullOrWhiteSpace(Row?.MobileNo) ? "—" : Row!.MobileNo)</span>
                    </div>
                </div>

                <div class="sd-section">
                    <h3>Location Information</h3>
                    <div class="sd-row">
                        <span class="sd-label">State</span>
                        <span class="sd-value"><span class="sd-colon">:</span> @(Row?.StateName)</span>
                    </div>
                    <div class="sd-row">
                        <span class="sd-label">Lying With</span>
                        <span class="sd-value"><span class="sd-colon">:</span> @(Row?.LyingWith)</span>
                    </div>
                </div>

                <div class="sd-section">
                    <h3>Product Information</h3>
                    <div class="sd-row">
                        <span class="sd-label">Product</span>
                        <span class="sd-value"><span class="sd-colon">:</span> @(Row?.ProductName)</span>
                    </div>
                    <div class="sd-row">
                        <span class="sd-label">Quantity (MT)</span>
                        <span class="sd-value"><span class="sd-colon">:</span> @(Row?.Quantity)</span>
                    </div>
                </div>

                <div class="sd-section">
                    <h3>Inventory Information</h3>
                    <div class="sd-row">
                        <span class="sd-label">Ageing Days</span>
                        <span class="sd-value sd-val-flex">
                            <span class="sd-colon">:</span> @(Row?.AgeingDays) Days
                            <div class="sd-status-badge sd-badge-inline">
                                <div class="sd-dot"></div> @(Row?.Status ?? "—")
                            </div>
                        </span>
                    </div>
                </div>

            </div>

            <div class="sd-footer">
                <button class="sd-btn-close" @onclick="CloseDrawer">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                    Close
                </button>
            </div>

        </div>
    </div>
}


@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    // The clicked stock row. Nullable so the drawer is safe before a row is chosen.
    [Parameter]
    public StockRowDto? Row { get; set; }

    private async Task CloseDrawer()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(IsOpen);
    }
}
