    </div>

    <!-- Filter chips -->
    <nav class="filter-nav" aria-label="Filters">
        <ul class="filter-list">
            <li class="filter-dropdown" data-filter="scheme">
                <select class="filter-chip" aria-label="Select scheme" style="width: 90px;">
                    <option selected>All Schemes</option>
                    <option>Greeny Super Scheme 2026</option>
                    <option>Summer Bonus Scheme</option>
                    <option>Monsoon Special</option>
                </select>
            </li>
            <li class="filter-dropdown" data-filter="year">
                <select class="filter-chip" aria-label="Select year">
                    <option selected>2026</option>
                    <option>2025</option>
                    <option>2024</option>
                </select>
            </li>
            <li class="filter-dropdown" data-filter="type">
                <select class="filter-chip" aria-label="Select type">
                    <option selected>All Types</option>
                    <option>Dealer</option>
                    <option>Farmer</option>
                </select>
            </li>
            <li class="filter-dropdown" data-filter="location">
                <select class="filter-chip" aria-label="Select location">
                    <option selected>All Locations</option>
                    <option>Coimbatore</option>
                    <option>Erode</option>
                    <option>Madurai</option>
                    <option>Salem</option>
                </select>
            </li>
        </ul>
    </nav>

    <!-- Tabs -->
    <section class="tabs-container" aria-label="Winner category tabs">
        <div class="tabs-inner">
            <button class="tab-btn active" type="button" onclick="setTab(this)">All Winners</button>
            <button class="tab-btn" type="button" onclick="setTab(this)">Dealer Winners</button>
            <button class="tab-btn" type="button" onclick="setTab(this)">Farmer Winners</button>
        </div>
    </section>

    <!-- Winners list -->
    <section class="winners-list" aria-label="Winners list">

        <!-- Winner 1 -->
        <div class="winner-card">
            <article class="winner-article">
                <div class="winner-top">
                    <img class="winner-avatar"
                         src="https://images.pexels.com/photos/220453/pexels-photo-220453.jpeg?auto=compress&cs=tinysrgb&w=80&h=80&fit=crop"
                         alt="Ramesh Traders" />
                    <div class="winner-info">
                        <div class="winner-name-row">
                            <h3 class="winner-name">Ramesh Traders</h3>
                            <span class="winner-badge badge-dealer">Dealer</span>
                        </div>
                        <div class="winner-meta">
                            <svg viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <rect x="1.5" y="3" width="15" height="12" rx="1.5" stroke="#4a735c" stroke-width="1.2" />
                                <path d="M1.5 6.75h15" stroke="#4a735c" stroke-width="1.2" />
                                <circle cx="5.25" cy="9.75" r="0.75" fill="#4a735c" />
                                <circle cx="9" cy="9.75" r="0.75" fill="#4a735c" />
                                <circle cx="12.75" cy="9.75" r="0.75" fill="#4a735c" />
                            </svg>
                            <p>Scheme: Greeny Super Scheme 2026</p>
                        </div>
