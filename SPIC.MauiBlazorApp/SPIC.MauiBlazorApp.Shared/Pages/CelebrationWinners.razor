@page "/CelebrationWinners"

<style>
    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        font-family: 'Inter', Helvetica, Arial, sans-serif;
        background: #f3f4f3;
        min-height: 100vh;
        justify-content: center;
    }

    .page {
        width: 100%;
        max-width: 440px;
        padding: 20px 16px;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    /* Header */
    .header {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 12px;
    }

    .back-btn {
        background: none;
        border: none;
        cursor: pointer;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 24px;
        height: 24px;
        color: #5e6662;
    }

        .back-btn svg {
            width: 24px;
            height: 24px;
        }

    .header h1 {
        font-size: 16px;
        font-weight: 600;
        line-height: 24px;
        color: #5e6662;
        letter-spacing: 0;
    }

    /* Banner card */
    .banner-card {
        position: relative;
        overflow: hidden;
        border-radius: 12px;
        border: 1px solid #e4ffe0;
        background: #f7fff6;
        box-shadow: 4px 4px 12px rgba(230,230,230,0.25), -2px -2px 8px rgba(219,219,219,0.25);
        min-height: 170px;
    }

    .banner-content {
        position: relative;
        z-index: 1;
        padding: 16px;
        max-width: 170px;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .banner-card h2 {
        font-size: 16px;
        font-weight: 700;
        line-height: 24px;
        letter-spacing: -0.6px;
        color: #0d701d;
    }

    .banner-desc {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

        .banner-desc p {
            font-size: 12px;
            font-weight: 500;
            line-height: 18px;
            color: #40493d;
        }

    .banner-count {
        font-size: 12px;
        color: #40493d;
    }

        .banner-count .label {
            font-weight: 500;
            line-height: 18px;
            display: block;
        }

        .banner-count .number {
            font-size: 18px;
            font-weight: 700;
            line-height: 28px;
        }

    .banner-illustration {
        position: absolute;
        right: 0;
        top: 0;
        height: 177px;
        width: 222px;
        pointer-events: none;
        object-fit: cover;
    }

    /* Filter chips */
    .filter-nav {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        padding-bottom: 4px;
        margin-left: -32px;
    }

        .filter-nav::-webkit-scrollbar {
            display: none;
        }

    .filter-list {
        display: flex;
        gap: 1px;
        min-width: max-content;
        list-style: none;
    }

    .filter-dropdown {
        position: relative;
        display: inline-flex;
    }

    .filter-chip {
        display: inline-flex;
        align-items: center;
        gap: 0px;
        padding: 6px 0px;
        border-radius: 8px;
        border: 1px solid #8c8c8c;
        background: transparent;
        cursor: pointer;
        font-family: 'Inter', Helvetica, Arial, sans-serif;
        font-size: 13px;
        font-weight: 500;
        line-height: 20px;
        color: #5c5e5d;
        white-space: nowrap;
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        transition: background 0.15s;
    }

        .filter-chip:hover {
            background: rgba(0,0,0,0.04);
        }

        .filter-chip.active {
            border-color: #3371ce;
            color: #3371ce;
        }

    .chip-arrow {
        width: 12px;
        height: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #5c5e5d;
        transition: transform 0.2s;
    }

        .chip-arrow svg {
            width: 10px;
            height: 10px;
        }

    .filter-chip.active .chip-arrow {
        color: #3371ce;
    }

    .filter-dropdown.open .chip-arrow {
        transform: rotate(180deg);
    }

    .dropdown-menu {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        margin-top: 4px;
        min-width: 160px;
        background: #fff;
        border: 1px solid #e4e4e4;
        border-radius: 8px;
        box-shadow: 0px 4px 12px rgba(0,0,0,0.1);
        z-index: 100;
        overflow: hidden;
    }

    .filter-dropdown.open .dropdown-menu {
        display: block;
    }

    .dropdown-item {
        display: block;
        width: 100%;
        padding: 8px 12px;
        border: none;
        background: none;
        text-align: left;
        font-family: 'Inter', Helvetica, Arial, sans-serif;
        font-size: 13px;
        font-weight: 500;
        color: #5c5e5d;
        cursor: pointer;
        transition: background 0.15s;
    }

        .dropdown-item:hover {
            background: #f3f4f3;
        }

        .dropdown-item.selected {
            background: #e8f4ff;
            color: #3371ce;
        }

    /* Tabs — MOBILE: full width + horizontally scrollable */
    .tabs-container {
        display: block;
        width: 100%;
        border-radius: 12px;
        border: 1px solid #e4e4e4;
        background: #fff;
        padding: 8px;
        box-shadow: -2px -2px 8px rgba(220,220,220,0.25), 4px 4px 12px rgba(230,230,230,0.25);
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
    }

        .tabs-container::-webkit-scrollbar {
            display: none;
        }

    .tabs-inner {
        display: flex;
        align-items: center;
        gap: 0px;
        min-width: max-content;
        width: 100%;
    }

    .tab-btn {
        flex: 1;
        min-width: 90px;
        padding: 6px 0px;
        border-radius: 8px;
        border: none;
        background: transparent;
        cursor: pointer;
        font-family: 'Inter', Helvetica, Arial, sans-serif;
        font-size: 13px;
        font-weight: 500;
        line-height: 20px;
        color: #41493e;
        white-space: nowrap;
        transition: all 0.2s;
        text-align: center;
    }

        .tab-btn.active {
            background: linear-gradient(134deg, rgba(46,111,64,0.9) 0%, rgba(88,213,123,0.9) 100%);
            color: #fff;
        }

    /* Winner cards */
    .winners-list {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .winner-card {
        overflow: hidden;
        border-radius: 16px;
        border: 1px solid #185e32;
        background: linear-gradient(181deg, rgba(255,255,255,1) 0%, rgba(231,255,240,1) 100%);
        box-shadow: 0px 4px 10px rgba(0,0,0,0.1), inset -6px 0px 0px #185e32;
        padding: 20px;
    }

    .winner-article {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .winner-top {
        display: flex;
        align-items: flex-start;
        gap: 12px;
    }

    .winner-avatar {
        width: 80px;
        height: 80px;
        border-radius: 12px;
        object-fit: cover;
        flex-shrink: 0;
        background: #c5d9cc;
    }

    .winner-info {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .winner-name-row {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 8px;
    }

    .winner-name {
        font-size: 15px;
        font-weight: 700;
        line-height: 22px;
        color: #205838;
        min-width: 0;
        word-break: break-word;
    }

    .winner-badge {
        display: inline-flex;
        align-items: center;
        border-radius: 10px;
        border: 0.5px solid;
        padding: 2px 8px;
        font-size: 10px;
        font-weight: 500;
        line-height: 16px;
        flex-shrink: 0;
        white-space: nowrap;
    }

    .badge-dealer {
        background: #fdf6f2;
        color: #c75005;
        border-color: #ffd7b9;
    }

    .badge-farmer {
        background: #f9f2fd;
        color: #661091;
        border-color: #e7b9ff;
    }

    .winner-meta {
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .winner-meta svg {
            width: 18px;
            height: 18px;
            flex-shrink: 0;
        }

        .winner-meta p {
            font-size: 12px;
            font-weight: 500;
            line-height: 18px;
            color: #4a735c;
            min-width: 0;
            overflow: hidden;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
        }

    /* Prize/date boxes */
    .prize-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
    }

    .prize-box {
        position: relative;
        border-radius: 4px;
        background: linear-gradient(90deg, rgba(32,88,57,0.1) 41%, rgba(242,242,242,0.1) 100%);
        padding: 8px;
        backdrop-filter: blur(61px) brightness(100%);
        -webkit-backdrop-filter: blur(61px) brightness(100%);
        border: 1px solid rgba(109,174,148,0.7);
    }

    .prize-box-inner {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .prize-label {
        font-size: 12px;
        font-weight: 500;
        line-height: 18px;
        color: #4a735c;
    }

    .prize-value {
        font-size: 14px;
        font-weight: 700;
        line-height: 20px;
        color: #4a735c;
    }

    /* View Details button */
    .view-details-btn {
        width: 100%;
        padding: 6px 12px;
        border-radius: 8px;
        border: none;
        background: #3371ce;
        color: #fff;
        font-family: 'Inter', Helvetica, Arial, sans-serif;
        font-size: 12px;
        font-weight: 500;
        line-height: 20px;
        cursor: pointer;
        transition: background 0.15s;
        text-align: center;
    }

        .view-details-btn:hover {
            background: rgba(51,113,206,0.9);
        }

    .spacer {
        height: 48px;
    }

    /* ==============================================
           WEB / DESKTOP OVERRIDES — min-width: 768px
           Mobile styles above are completely untouched
           ============================================== */
    @@media (min-width: 768px) {

        .page {
            max-width: 1100px;
            margin: 0 auto;
            padding: 28px 32px;
            gap: 24px;
        }
        /* Header */
        .header h1 {
            font-size: 20px;
        }
        /* Banner — wider with bigger illustration */
        .banner-card {
            min-height: 200px;
            border-radius: 16px;
        }

        .banner-content {
            max-width: 340px;
            padding: 24px 28px;
            gap: 20px;
        }

        .banner-card h2 {
            font-size: 22px;
            line-height: 32px;
        }

        .banner-desc p {
            font-size: 14px;
            line-height: 22px;
        }

        .banner-count .label {
            font-size: 13px;
        }

        .banner-count .number {
            font-size: 28px;
        }

        .banner-illustration {
            height: 200px;
            width: 320px;
        }
        /* Filter chips row */
        .filter-nav {
            overflow-x: visible;
            padding-bottom: 0;
        }

        .filter-list {
            min-width: unset;
            flex-wrap: wrap;
        }

        .filter-chip {
            font-size: 14px;
            padding: 8px 16px;
        }
        /* Tabs — restore desktop original behavior */
        .tabs-container {
            width: fit-content;
            display: flex;
            border-radius: 14px;
            padding: 8px;
            overflow-x: visible;
        }

        .tabs-inner {
            min-width: unset;
        }

        .tab-btn {
            flex: unset;
            min-width: unset;
            font-size: 14px;
            padding: 8px 24px;
        }
        /* Winners grid — 2 columns on desktop */
        .winners-list {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }
        /* Winner card desktop tweaks */
        .winner-card {
            border-radius: 18px;
            padding: 22px;
            box-shadow: 0px 4px 16px rgba(0,0,0,0.08), inset -8px 0px 0px #185e32;
        }

        .winner-avatar {
            width: 88px;
            height: 88px;
            border-radius: 14px;
        }

        .winner-name {
            font-size: 17px;
            line-height: 24px;
            word-break: normal;
        }

        .winner-meta p {
            font-size: 13px;
            display: block;
            overflow: visible;
            -webkit-line-clamp: unset;
        }

        .prize-label {
            font-size: 12px;
        }

        .prize-value {
            font-size: 15px;
        }

        .view-details-btn {
            font-size: 13px;
            padding: 8px 16px;
            border-radius: 10px;
        }
    }

    /* 3 columns on very large screens */
    @@media (min-width: 1200px) {
        .winners-list {
            grid-template-columns: 1fr 1fr 1fr;
        }
    }
</style>

