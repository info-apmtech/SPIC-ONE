@page "/EmployeeManagement"
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using QuestPDF.Fluent
@using SPIC.Core.Entities
@using System.Text
@using System.IO
@using static SPIC.Core.Entities.EmployeeRegistration
@inject HttpClient Http
@inject NavigationManager Nav
@inject LoadingService Loading
@inject IJSRuntime JSRuntime

<div class="container-fluid py-4 px-4">

    <div class="page-header-row">
        <div>
            <h1 class="page-title">Employee Management</h1>
            <div class="page-subtitle">Manage employees, roles, and location-based login assignments</div>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <button class="btn-outline-green" @onclick="() => _showUploadModal = true">
                <i class="bi bi-cloud-arrow-up"></i> Bulk Upload
            </button>
            <NavLink class="btn-register text-decoration-none" href="/EmployeeRegistration">
                <i class="bi bi-plus-lg"></i> Register Employee
            </NavLink>
        </div>
    </div>

    @if (_showUploadModal)
    {
        <div class="modal-backdrop fade show"></div>
        <div class="modal fade show d-block" tabindex="-1" role="dialog">
            <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-cloud-arrow-up me-2"></i>Bulk Upload Employees</h5>
                        <button type="button" class="btn-close" @onclick="CloseUploadModal"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-muted small mb-3">
                            Excel columns: <strong>EmployeeID, EmpName, UserName, Permission, State, Region, HQ, PhoneNumber, EmailID</strong><br />
                            Phone number is used as the login password.<br />
                            Allowed roles: <strong>SMD, SMM</strong> (State) · <strong>RM, RMD</strong> (State + Region) · <strong>MDO, MO, JMDO</strong> (HQ)
                        </p>
                        <InputFile OnChange="OnEmployeeFileSelected" accept=".xlsx,.xls" />

                        @if (_isUploading)
                        {
                            <div class="mt-3 text-muted"><span class="spinner-border spinner-border-sm me-2"></span>Uploading...</div>
                        }
                        else if (_uploadInserted > 0 || _uploadSkipped > 0)
                        {
                            <div class="mt-3 alert @(_uploadSkipped == 0 ? "alert-success" : "alert-warning") py-2">
                                <strong>Inserted:</strong> @_uploadInserted &nbsp;&nbsp;
                                <strong>Skipped:</strong> @_uploadSkipped
                            </div>
                        }
                        else if (!string.IsNullOrEmpty(_uploadResult))
                        {
                            <div class="mt-3 alert alert-danger py-2">@_uploadResult</div>
                        }

                        @if (_uploadGroupedErrors.Count > 0)
                        {
                            <div class="mt-3">
                                <strong class="text-danger">Issues found:</strong>
                                @foreach (var grp in _uploadGroupedErrors)
                                {
                                    <div class="mt-2">
                                        <span class="badge bg-danger me-2">@grp.Key</span>
                                        <span class="badge bg-secondary">@grp.Value.Count</span>
                                        <ul class="mb-1 mt-1" style="font-size:0.82rem;">
                                            @foreach (var msg in grp.Value)
                                            {
                                                <li>@msg</li>
                                            }
                                        </ul>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary btn-sm rounded-pill px-4" @onclick="CloseUploadModal">Close</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="filter-bar">
        <div class="search-box main-search">
            <i class="bi bi-search"></i>
            <input type="text" placeholder="Search employees..." @bind="_searchText" @bind:event="oninput" @bind:after="ApplyFilter">
        </div>

        <div class="filter-selects">
            <select class="form-inp" @bind="_roleFilter" @bind:after="ApplyFilter">
                <option value="All">All Role</option>
                @foreach (var role in Enum.GetValues<AppRole>())
                {
                    <option value="@role">@role</option>
                }
            </select>

            <select class="form-inp" @bind="_stateFilter" @bind:after="ApplyFilter">
                <option value="All">All States</option>
                @foreach (var s in states)
                {
                    <option value="@s.Id">@(!string.IsNullOrWhiteSpace(s.StateName) ? s.StateName : s.ZoneName)</option>
                }
            </select>
        </div>
    </div>

    <div class="main-card">
        <div class="section-header d-flex justify-content-between align-items-center mb-3">
            <h3 class="section-title mb-0">Employee List</h3>
            <div class="search-box small-search">
                <i class="bi bi-search"></i>
                <input type="text" placeholder="Search employees..." @bind="_searchText" @bind:event="oninput" @bind:after="ApplyFilter">
            </div>
        </div>

        <div class="export-buttons mb-3 d-flex gap-2">
            <button class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1" @onclick="ExportCopy">
                <i class="bi bi-front"></i> Copy
            </button>
            <a href="@_csvDataUri" download="Employees_@(DateTime.Now.ToString("yyyyMMdd")).csv" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1 @(string.IsNullOrEmpty(_csvDataUri) ? "disabled" : "")">
                <i class="bi bi-filetype-csv"></i> CSV
            </a>
            <a href="@_excelDataUri" download="Employees_@(DateTime.Now.ToString("yyyyMMdd")).xlsx" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1 @(string.IsNullOrEmpty(_excelDataUri) ? "disabled" : "")">
                <i class="bi bi-file-earmark-excel"></i> Excel
            </a>
            <button class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1" @onclick="ExportPrint">
                <i class="bi bi-printer"></i> Print
            </button>
            <a href="@_pdfDataUri" download="Employees_@(DateTime.Now.ToString("yyyyMMdd")).pdf" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1 @(string.IsNullOrEmpty(_pdfDataUri) ? "disabled" : "")">
                <i class="bi bi-filetype-pdf"></i> PDF
            </a>
        </div>

        <div class="table-responsive">
            <table class="data-table table table-bordered table-hover">
                <thead>
                    <tr>
                        <th style="width: 60px; text-align: center;">S:No</th>
                        <th>Employee ID</th>
                        <th>Name</th>
                        <th>User Name</th>
                        <th>Password</th>
                        <th>Role</th>
                        <th>State</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_isLoading)
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted">Loading...</td>
                        </tr>
                    }
                    else if (!PagedItems.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted">No data available in table</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var (item, index) in PagedItems.Select((v, i) => (v, i)))
                        {
                            <tr>
                                <td class="text-center text-muted">@((_currentPage - 1) * _pageSize + index + 1)</td>
                                <td>@item.EmployeeCode</td>
                                <td>@item.Name</td>
                                <td class="text-muted">@item.UserName</td>
                                <td class="text-muted">@item.Password</td>
                                <td><span class="role-badge">@item.Role</span></td>
                                <td>@item.StateName</td>
                                <td>
                                    <div class="action-icons">
                                        <i class="bi bi-pencil-square text-primary icon-edit me-2" style="cursor:pointer;" title="Edit Employee" @onclick="() => EditEmployee(item.EmployeeId)"></i>
                                        <i class="bi bi-trash text-danger icon-del" style="cursor:pointer;" title="Delete Employee" @onclick="() => DeleteEmployee(item.EmployeeId)"></i>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <div class="d-flex align-items-center gap-2 text-muted small">
                <span>Show</span>
                <select class="form-select form-select-sm" style="width: auto;" @bind="_pageSize" @bind:after="ChangePageSize">
                    <option value="10">10</option>
                    <option value="16">16</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
                <span>entries</span>
                <span class="ms-3 border-start ps-3">
                    Showing @((FilteredItems.Count > 0) ? ((_currentPage - 1) * _pageSize + 1) : 0)
                    to @Math.Min(_currentPage * _pageSize, FilteredItems.Count)
                    of @FilteredItems.Count entries
                </span>
            </div>
            
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(_currentPage <= 1 ? "disabled" : "")">
                        <button class="page-link" @onclick="PreviousPage">Previous</button>
                    </li>
                    @foreach (var p in GetPageNumbers())
                    {
                        if (p == -1)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }
                        else
                        {
                            <li class="page-item @(p == _currentPage ? "active" : "")">
                                <button class="page-link" @onclick="() => GoToPage(p)">@p</button>
                            </li>
                        }
                    }
                    <li class="page-item @(_currentPage >= TotalPages ? "disabled" : "")">
                        <button class="page-link" @onclick="NextPage">Next</button>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</div>

@code {
    private List<EmployeeInformation> employees = new();
    private List<Employeelogin> logins = new();
    private List<UserInfoDto> users = new();
    private List<LocationItemDto> states = new();

    private Dictionary<string, UserInfoDto> userById = new();
    private Dictionary<int, string> stateNameById = new();
    private Dictionary<string, UserInfoDto> userByGuid = new(StringComparer.OrdinalIgnoreCase);

    private bool _isLoading = true;
    private string _searchText = string.Empty;
    private string _roleFilter = "All";
    private string _stateFilter = "All";
    private int _pageSize = 16;
    private int _currentPage = 1;

    private bool _showUploadModal = false;
    private bool _isUploading = false;
    private string _uploadResult = string.Empty;
    private int _uploadInserted = 0;
    private int _uploadSkipped = 0;
    private Dictionary<string, List<string>> _uploadGroupedErrors = new();

    private List<EmployeeGridItem> FilteredItems = new();
    private List<EmployeeGridItem> PagedItems = new();

    private string _csvDataUri = "";
    private string _excelDataUri = "";
    private string _pdfDataUri = "";

    private int TotalPages => FilteredItems.Count == 0 ? 1 : (int)Math.Ceiling((double)FilteredItems.Count / _pageSize);

    private void ChangePageSize()
    {
        _currentPage = 1;
        RecalculatePage();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;

        employees = await Http.GetFromJsonAsync<List<EmployeeInformation>>("api/EmployeeRegistration/all") ?? new();
        logins = await Http.GetFromJsonAsync<List<Employeelogin>>("api/Employeelogin/all") ?? new();
        users = await Http.GetFromJsonAsync<List<UserInfoDto>>("api/UserInfo/all") ?? new();
        states = await Http.GetFromJsonAsync<List<LocationItemDto>>("api/State/all") ?? new();

        userById = users.Where(u => !string.IsNullOrWhiteSpace(u.UserName)).ToDictionary(u => u.UserName!, u => u, StringComparer.OrdinalIgnoreCase);
        userByGuid = users.Where(u => !string.IsNullOrWhiteSpace(u.Id)).ToDictionary(u => u.Id, u => u, StringComparer.OrdinalIgnoreCase);
        stateNameById = states.ToDictionary(s => s.Id, s => string.IsNullOrWhiteSpace(s.StateName) ? "-" : s.StateName);

        ApplyFilter();
        _isLoading = false;
    }

    private string GetUserName(string? userId)
    {
        if (string.IsNullOrWhiteSpace(userId)) return "-";
        if (userByGuid.TryGetValue(userId, out var user)) return user.UserName;
        return userId;
    }

    private string GetPassword(int empId, string? userId)
    {
        if (string.IsNullOrWhiteSpace(userId)) return "-";
        if (userByGuid.TryGetValue(userId, out var user) || userById.TryGetValue(userId, out user))
        {
            if (!string.IsNullOrWhiteSpace(user.Password)) return user.Password;
        }
        var emp = employees.FirstOrDefault(e => e.Id == empId);
        return emp?.PersonalPhoneNumber ?? "-";
    }

    private string GetStateName(int? stateId)
        => stateId == null ? "-" : stateNameById.TryGetValue(stateId.Value, out var v) ? v : "-";

    private void ApplyFilter()
    {
        var q = (_searchText ?? string.Empty).Trim();
        var allItems = new List<EmployeeGridItem>();

        // 1. Flatten the Data: One row per login
        foreach (var emp in employees)
        {
            var empLogins = logins.Where(l => l.EmployeeInformationID == emp.Id).ToList();

            if (empLogins.Any())
            {
                foreach (var login in empLogins)
                {
                    allItems.Add(new EmployeeGridItem
                    {
                        EmployeeId = emp.Id,
                        LoginId = login.Id,
                        EmployeeCode = emp.EmployeeCode ?? "",
                        Name = emp.Name ?? "",
                        UserName = GetUserName(login.UserId),
                        Password = GetPassword(emp.Id, login.UserId),
                        Role = login.Role.ToString(),
                        StateId = login.StateId,
                        StateName = GetStateName(login.StateId)
                    });
                }
            }
            else
            {
                // Employee exists but has no login assigned yet
                allItems.Add(new EmployeeGridItem
                {
                    EmployeeId = emp.Id,
                    LoginId = 0,
                    EmployeeCode = emp.EmployeeCode ?? "",
                    Name = emp.Name ?? "",
                    UserName = "-",
                    Password = GetPassword(emp.Id, null),
                    Role = "-",
                    StateId = 0,
                    StateName = "-"
                });
            }
        }

        // 2. Apply text and dropdown filters
        IEnumerable<EmployeeGridItem> query = allItems;

        if (!string.IsNullOrEmpty(q))
        {
            query = query.Where(e =>
                e.Name.Contains(q, StringComparison.OrdinalIgnoreCase)
                || e.EmployeeCode.Contains(q, StringComparison.OrdinalIgnoreCase)
                || e.UserName.Contains(q, StringComparison.OrdinalIgnoreCase)
                || e.Password.Contains(q, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.Equals(_roleFilter, "All", StringComparison.OrdinalIgnoreCase))
        {
            query = query.Where(e => string.Equals(e.Role, _roleFilter, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.Equals(_stateFilter, "All", StringComparison.OrdinalIgnoreCase) && int.TryParse(_stateFilter, out var sid))
        {
            query = query.Where(e => e.StateId == sid);
        }

        FilteredItems = query.ToList();
        _currentPage = 1;
        RecalculatePage();
        
        GenerateExportDataUris();
    }

    private void RecalculatePage()
    {
        PagedItems = FilteredItems.Skip((_currentPage - 1) * _pageSize).Take(_pageSize).ToList();
    }

    private void EditEmployee(int employeeId)
    {
        Nav.NavigateTo($"/EmployeeRegistration?editId={employeeId}");
    }

    private async Task DeleteEmployee(int employeeId)
    {
        var response = await Http.DeleteAsync($"api/EmployeeLoginSetup/{employeeId}");
        if (response.IsSuccessStatusCode)
        {
            await LoadData();
        }
    }

    private IEnumerable<int> GetPageNumbers()
    {
        var total = TotalPages;
        if (total <= 7) return Enumerable.Range(1, total);

        var pages = new List<int> { 1 };
        var start = Math.Max(2, _currentPage - 2);
        var end = Math.Min(total - 1, _currentPage + 2);

        if (start > 2) pages.Add(-1);
        for (int i = start; i <= end; i++) pages.Add(i);
        if (end < total - 1) pages.Add(-1);
        pages.Add(total);

        return pages;
    }

    private void PreviousPage()
    {
        if (_currentPage <= 1) return;
        _currentPage--;
        RecalculatePage();
    }

    private void NextPage()
    {
        if (_currentPage >= TotalPages) return;
        _currentPage++;
        RecalculatePage();
    }

    private void GoToPage(int page)
    {
        if (page < 1 || page > TotalPages) return;
        _currentPage = page;
        RecalculatePage();
    }

    private void CloseUploadModal()
    {
        _showUploadModal = false;
        _uploadResult = string.Empty;
        _uploadInserted = 0;
        _uploadSkipped = 0;
        _uploadGroupedErrors.Clear();
    }

    private async Task OnEmployeeFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        _isUploading = true;
        _uploadResult = string.Empty;
        _uploadInserted = 0;
        _uploadSkipped = 0;
        _uploadGroupedErrors.Clear();

        try
        {
            using var ms = new MemoryStream();
            await file.OpenReadStream(20 * 1024 * 1024).CopyToAsync(ms);
            ms.Position = 0;

            using var content = new MultipartFormDataContent();
            var fileContent = new StreamContent(ms);
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType ?? "application/octet-stream");
            content.Add(fileContent, "file", file.Name);

            var resp = await Http.PostAsync("api/EmployeeBulkUpload/bulk-upload", content);
            var body = await resp.Content.ReadAsStringAsync();

            if (resp.IsSuccessStatusCode)
            {
                var result = System.Text.Json.JsonSerializer.Deserialize<BulkUploadResult>(body,
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (result != null)
                {
                    _uploadInserted = result.Inserted;
                    _uploadSkipped = result.Skipped;
                    _uploadGroupedErrors = result.GroupedErrors ?? new();
                }
                await LoadData();
            }
            else
            {
                _uploadResult = "Upload failed: " + body;
            }
        }
        catch (Exception ex)
        {
            _uploadResult = "Upload error: " + ex.Message;
        }
        finally
        {
            _isUploading = false;
        }
    }

    private async Task ExportCopy()
    {
        if (!FilteredItems.Any()) return;
        var sb = new StringBuilder();
        sb.AppendLine("Employee ID\tName\tUser Name\tPassword\tRole\tState");

        foreach (var item in FilteredItems)
        {
            sb.AppendLine($"{item.EmployeeCode}\t{item.Name}\t{item.UserName}\t{item.Password}\t{item.Role}\t{item.StateName}");
        }
        
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", sb.ToString());
        await JSRuntime.InvokeVoidAsync("alert", "Table data copied to clipboard!");
    }

    private async Task ExportPrint()
    {
        if (!FilteredItems.Any()) return;
        
        var sb = new StringBuilder();
        sb.Append("<table><thead><tr><th>Employee ID</th><th>Name</th><th>User Name</th><th>Password</th><th>Role</th><th>State</th></tr></thead><tbody>");
        
        foreach (var item in FilteredItems)
        {
            sb.Append("<tr>");
            sb.Append($"<td>{item.EmployeeCode}</td>");
            sb.Append($"<td>{item.Name}</td>");
            sb.Append($"<td>{item.UserName}</td>");
            sb.Append($"<td>{item.Password}</td>");
            sb.Append($"<td>{item.Role}</td>");
            sb.Append($"<td>{item.StateName}</td>");
            sb.Append("</tr>");
        }
        sb.Append("</tbody></table>");

        var js = $@"
            var printWindow = window.open('', '', 'height=600,width=800');
            printWindow.document.write('<html><head><title>Employee Data</title>');
            printWindow.document.write('<style>body{{font-family:Arial,sans-serif;}} table{{border-collapse:collapse;width:100%;margin-top:20px;}} th,td{{border:1px solid #ddd;padding:8px;text-align:left;}} th{{background-color:#f2f2f2;}} h2{{text-align:center;}}</style>');
            printWindow.document.write('</head><body><h2>Employee Data</h2>{sb.ToString()}</body></html>');
            printWindow.document.close();
            printWindow.focus();
            setTimeout(function() {{ printWindow.print(); printWindow.close(); }}, 250);";
            
        await JSRuntime.InvokeVoidAsync("eval", js);
    }

    private void GenerateExportDataUris()
    {
        if (!FilteredItems.Any())
        {
            _csvDataUri = _excelDataUri = _pdfDataUri = "";
            return;
        }

        // CSV
        var sb = new StringBuilder();
        sb.AppendLine("Employee ID,Name,User Name,Password,Role,State");
        foreach (var item in FilteredItems)
        {
            var uName = item.UserName.Replace(",", " ");
            var pass = item.Password.Replace(",", " ");
            var role = item.Role.Replace(",", " ");
            var state = item.StateName.Replace(",", " ");
            sb.AppendLine($"{item.EmployeeCode},{item.Name},{uName},{pass},{role},{state}");
        }

        var csvBytes = Encoding.UTF8.GetBytes(sb.ToString());
        var csvBase64 = Convert.ToBase64String(csvBytes);
        _csvDataUri = $"data:text/csv;base64,{csvBase64}";

        // Excel
        using var workbook = new ClosedXML.Excel.XLWorkbook();
        var worksheet = workbook.Worksheets.Add("Employees");
        
        worksheet.Cell(1, 1).Value = "Employee ID";
        worksheet.Cell(1, 2).Value = "Name";
        worksheet.Cell(1, 3).Value = "User Name";
        worksheet.Cell(1, 4).Value = "Password";
        worksheet.Cell(1, 5).Value = "Role";
        worksheet.Cell(1, 6).Value = "State";

        for (int i = 0; i < FilteredItems.Count; i++)
        {
            var item = FilteredItems[i];
            worksheet.Cell(i + 2, 1).Value = item.EmployeeCode;
            worksheet.Cell(i + 2, 2).Value = item.Name;
            worksheet.Cell(i + 2, 3).Value = item.UserName;
            worksheet.Cell(i + 2, 4).Value = item.Password;
            worksheet.Cell(i + 2, 5).Value = item.Role;
            worksheet.Cell(i + 2, 6).Value = item.StateName;
        }

        using var excelStream = new MemoryStream();
        workbook.SaveAs(excelStream);
        var excelBase64 = Convert.ToBase64String(excelStream.ToArray());
        _excelDataUri = $"data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64,{excelBase64}";

        // PDF
        QuestPDF.Settings.License = QuestPDF.Infrastructure.LicenseType.Community;
        var pdfBytes = QuestPDF.Fluent.Document.Create(container =>
        {
            container.Page(page =>
            {
                page.Size(QuestPDF.Helpers.PageSizes.A4);
                page.Margin(1, QuestPDF.Infrastructure.Unit.Centimetre);
                page.Header().Text("Employee Data").SemiBold().FontSize(18);
                
                page.Content().Table(table =>
                {
                    table.ColumnsDefinition(columns =>
                    {
                        columns.RelativeColumn();
                        columns.RelativeColumn();
                        columns.RelativeColumn();
                        columns.RelativeColumn();
                        columns.RelativeColumn();
                        columns.RelativeColumn();
                    });

                    table.Header(header =>
                    {
                        header.Cell().Text("ID");
                        header.Cell().Text("Name");
                        header.Cell().Text("Username");
                        header.Cell().Text("Password");
                        header.Cell().Text("Role");
                        header.Cell().Text("State");
                    });

                    foreach (var item in FilteredItems)
                    {
                        table.Cell().Text(item.EmployeeCode);
                        table.Cell().Text(item.Name);
                        table.Cell().Text(item.UserName);
                        table.Cell().Text(item.Password);
                        table.Cell().Text(item.Role);
                        table.Cell().Text(item.StateName);
                    }
                });
            });
        }).GeneratePdf();

        var pdfBase64 = Convert.ToBase64String(pdfBytes);
        _pdfDataUri = $"data:application/pdf;base64,{pdfBase64}";
    }

    // New DTO class strictly for holding flattened grid data
    private class EmployeeGridItem
    {
        public int EmployeeId { get; set; }
        public int LoginId { get; set; }
        public string EmployeeCode { get; set; } = "";
        public string Name { get; set; } = "";
        public string UserName { get; set; } = "";
        public string Password { get; set; } = "";
        public string Role { get; set; } = "-";
        public int StateId { get; set; }
        public string StateName { get; set; } = "-";
    }

    private class BulkUploadResult
    {
        public bool Success { get; set; }
        public int Inserted { get; set; }
        public int Skipped { get; set; }
        public Dictionary<string, List<string>>? GroupedErrors { get; set; }
    }

    public class UserInfoDto
    {
        public string Id { get; set; } = "";
        public string UserName { get; set; } = "";
        public string? Email { get; set; }
        public string? Name { get; set; }
        public bool IsActive { get; set; }
        public string? Password { get; set; }
    }

    public class LocationItemDto
    {
        public int Id { get; set; }
        public string ZoneName { get; set; } = "";
        public string StateName { get; set; } = "";
        public string DistrictName { get; set; } = "";
        public string SubDistrictName { get; set; } = "";
        public string RegionName { get; set; } = "";
        public string HeadquarterName { get; set; } = "";
        public string? ZoneCode { get; set; }
        public string? ZoneColorCode { get; set; }
        public int ZoneId { get; set; }
        public int StateId { get; set; }
        public int DistrictId { get; set; }
        public int RegionId { get; set; }
        public bool IsActive { get; set; }
        public DateTime CreatedAt { get; set; }
        public DateTime UpdatedAt { get; set; }

        public string Name =>
            !string.IsNullOrEmpty(ZoneName) ? ZoneName :
            !string.IsNullOrEmpty(StateName) ? StateName :
            !string.IsNullOrEmpty(DistrictName) ? DistrictName :
            !string.IsNullOrEmpty(SubDistrictName) ? SubDistrictName :
            !string.IsNullOrEmpty(RegionName) ? RegionName :
            HeadquarterName;
    }
