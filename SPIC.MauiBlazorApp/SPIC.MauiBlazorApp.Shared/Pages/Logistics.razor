  private async Task ConfirmDelete()
{
    if (_deleteTarget is null)
        return;

    if (!CanDeleteLogisticsItem(_deleteTarget))
    {
        ShowMessage("You are not allowed to delete this record.", true);
        CancelDelete();
        return;
    }

    try
    {
            _isDeleting = true;
            var response = await Http.DeleteAsync($"{CurrentApiBase}/{_deleteTarget.Id}");

            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                ShowMessage($"Delete failed: {ParseErrorMessage(body)}", true);
                return;
            }

            ShowMessage($"'{_deleteTarget.Name}' deleted successfully.", false);
            await LoadData();
        }
        catch (Exception ex)
        {
            ShowMessage($"Error: {ex.Message}", true);
        }
        finally
        {
            _isDeleting = false;
            CancelDelete();
        }
    }

    private void CancelDelete()
    {
        _showDeleteConfirm = false;
        _deleteTarget = null;
    }

