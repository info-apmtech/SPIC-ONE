    private void OnLatitudeLongitudeChanged(ChangeEventArgs e)
    {
        _latitudeLongitudeText = e.Value?.ToString() ?? "";

        var text = _latitudeLongitudeText.Trim();
        var parts = text.Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries);
        double? lat = null;
        double? lng = null;
        if (parts.Length >= 2
            && double.TryParse(parts[0].Trim(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var parsedLat)
            && double.TryParse(parts[1].Trim(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var parsedLng))
        {
            lat = parsedLat;
            lng = parsedLng;
        }

        _form.Latitude = lat;
        _form.Longitude = lng;

        if (lat.HasValue && lng.HasValue)
            _ = TriggerMapUpdate(lat.Value, lng.Value);
    }

    private void SyncLatitudeLongitudeText()
    {
        string Fmt(double d) => d.ToString("G17", System.Globalization.CultureInfo.InvariantCulture);

        if (_form.Latitude.HasValue && _form.Longitude.HasValue)
            _latitudeLongitudeText = $"{Fmt(_form.Latitude.Value)}, {Fmt(_form.Longitude.Value)}";
        else if (_form.Latitude.HasValue)
            _latitudeLongitudeText = Fmt(_form.Latitude.Value);
        else if (_form.Longitude.HasValue)
            _latitudeLongitudeText = Fmt(_form.Longitude.Value);
        else
            _latitudeLongitudeText = "";
    }

    private async Task UseCurrentLocation()
    {
        _isGettingLocation = true;
        _locationMessage = null;
        StateHasChanged();

        try
        {
            var result = await JS.InvokeAsync<GeoLocationResult>("getCurrentPosition");

            if (!string.IsNullOrWhiteSpace(result.Error))
            {
                _locationMessage = $"Location error: {result.Error}";
                _locationSuccess = false;
            }
            else
            {
                _form.Latitude = result.Latitude;
                _form.Longitude = result.Longitude;
                SyncLatitudeLongitudeText();
                _form.GoogleURL = $"http://maps.google.com/maps?q={result.Latitude.ToString(System.Globalization.CultureInfo.InvariantCulture)},{result.Longitude.ToString(System.Globalization.CultureInfo.InvariantCulture)}";
                _locationMessage = $"Location captured: {result.Latitude:F6}, {result.Longitude:F6}";
                _locationSuccess = true;
                await TriggerMapUpdate(result.Latitude, result.Longitude);
            }
        }
        catch (Exception ex)
        {
            _locationMessage = $"Failed to get location: {ex.Message}";
            _locationSuccess = false;
        }
        finally
        {
            _isGettingLocation = false;
            StateHasChanged();
        }
    }

    private string? GetUserIdFromToken(string token)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(token)) return null;

            var raw = token.StartsWith("Bearer ", StringComparison.OrdinalIgnoreCase)
                ? token.Substring("Bearer ".Length)
                : token;

            var parts = raw.Split('.');
            if (parts.Length < 2) return null;

            var payload = parts[1];
            switch (payload.Length % 4)
            {
                case 2: payload += "=="; break;
                case 3: payload += "="; break;
            }

            payload = payload.Replace('-', '+').Replace('_', '/');
            var json = System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(payload));
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            var root = doc.RootElement;

            if (root.TryGetProperty("sub", out var sub)) return sub.GetString();
            if (root.TryGetProperty("nameid", out var nid)) return nid.GetString();
            if (root.TryGetProperty("http://schemas.xmlsoap.org/ws/2005/05/identity/claims/nameidentifier", out var id2)) return id2.GetString();
            if (root.TryGetProperty("spic:user_id", out var sup)) return sup.GetString();
        }
        catch
        {
        }

        return null;
    }

