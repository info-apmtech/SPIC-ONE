            var response = await Http.PostAsJsonAsync(
                $"{CurrentApiBase}/{item.Id}/approve",
                new LogisticsApprovalRequest
                {
                    Remarks = "Approved"
                });

            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                ShowMessage($"Approval failed: {body}", true);
                return;
            }

            ShowMessage("Approval completed successfully.", false);
            await LoadData();
        }
        catch (Exception ex)
        {
            ShowMessage($"Approval failed: {ex.Message}", true);
        }
        finally
        {
            _approvingId = null;
        }
    }

