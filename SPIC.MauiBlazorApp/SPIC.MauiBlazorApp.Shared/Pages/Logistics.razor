                                    class="btn btn-sm btn-success rounded-pill px-3 shadow-sm map-loc-btn"
                                    @onclick="UseCurrentLocation"
                                    disabled="@_isGettingLocation">
                                <i class="bi bi-crosshair"></i> Use current location
                            </button>
                        </div>
                    </div>

                    <div class="col-12 col-md-8">
                        <div class="row g-3">
                            <div class="col-12 col-sm-6">
                                <label class="form-label-custom">
                                    Google Map URL
                                    @if (_form.IsActive)
                                    {
                                        <span class="text-danger">*</span>
                                    }
                                </label>
                                <input type="text"
                                       class="form-control-custom w-100"
                                       placeholder="Click map or Paste Google Maps link"
                                       @bind="_form.GoogleURL"
                                       @bind:after="OnGoogleMapUrlChanged" />
                            </div>

                            <div class="col-12 col-sm-6">
                                <label class="form-label-custom">
                                    Latitude & Longitude
                                    @if (_form.IsActive)
                                    {
                                        <span class="text-danger">*</span>
                                    }
                                </label>
                                <input type="text"
                                       class="form-control-custom w-100"
                                       value="@_latitudeLongitudeText"
                                       @onchange="OnLatitudeLongitudeChanged"
                                       placeholder="e.g. 10.7905, 78.7047" />
                            </div>

                            <!-- Requirement: Rake Point hides Door No + Street only. -->
                            @if (!IsRakePointTab)
                            {
                                <div class="col-12 col-sm-6">
                                    <label class="form-label-custom">
                                        Door No / Shop No / Room No / Block No
                                        @if (_form.IsActive)
                                        {
                                            <span class="text-danger">*</span>
                                        }
                                    </label>
                                    <input type="text"
                                           class="form-control-custom w-100"
                                           placeholder="Enter Door / Shop / Room No"
                                           @bind="_form.DoorNo" />
                                </div>

                                <div class="col-12 col-sm-6">
                                    <label class="form-label-custom">
                                        Street / Area / Locality
                                        @if (_form.IsActive)
                                        {
                                            <span class="text-danger">*</span>
                                        }
                                    </label>
                                    <input type="text"
                                           class="form-control-custom w-100"
                                           placeholder="Enter Street / Area / Locality"
                                           @bind="_form.Street" />
                                </div>
                            }

                            <div class="col-12 col-sm-6">
                                <label class="form-label-custom">
                                    Sub Village
                                    @if (_form.IsActive)
                                    {
                                        <span class="text-danger">*</span>
                                    }
                                </label>
                                <input type="text"
                                       class="form-control-custom w-100"
                                       placeholder="Enter Sub Village"
                                       @bind="_form.SubVillage" />
                            </div>

                            <div class="col-12 col-sm-6">
                                <label class="form-label-custom">
                                    Pincode
                                    @if (_form.IsActive)
                                    {
                                        <span class="text-danger">*</span>
                                    }
                                </label>
                                <input type="text"
                                       class="form-control-custom w-100"
                                       placeholder="Enter Pincode"
                                       maxlength="6"
                                       inputmode="numeric"
                                       @bind="_form.PinCode"
                                       @bind:event="oninput"
                                       @bind:after="OnPincodeChanged" />
