        var match = CurrentSapCodeOptions.FirstOrDefault(o =>
            string.Equals(o.Code, _form.SapCode, StringComparison.OrdinalIgnoreCase));

        if (match != null)
        {
            _form.Name = match.Name;
            _errors.Remove("SapCode");
        }
    }

    private static LogisticsWarehouseCategory GetWarehouseCategory(LogisticsItemDto item) =>
        item.WarehouseCategory ?? LogisticsWarehouseCategory.PvtWH;

    private async Task LoadData()
    {
        try
        {
            _isLoading = true;

            switch (ActiveTab)
            {
                case "Warehouse":
                    // PVT WH, C&F WH and Both are all stored in the same Warehouse table.
                    _warehouseAll = await Http.GetFromJsonAsync<List<LogisticsItemDto>>("api/Warehouse/all") ?? new();
                    break;

                case "Port":
                    _rakePointAll = await Http.GetFromJsonAsync<List<LogisticsItemDto>>("api/RackPoint/all") ?? new();
                    break;

                case "PortMaster":
                    _portAll = await Http.GetFromJsonAsync<List<LogisticsItemDto>>("api/Port/all") ?? new();
                    break;
            }

            ApplyFilter();
        }
        catch (Exception ex)
        {
            ShowMessage($"Failed to load {ActiveTabDisplayName}: {ex.Message}", true);
        }
        finally
        {
            _isLoading = false;
        }
    }

