@if (_showDocumentsModal)
{
    <!--
        IMPORTANT:
        The backdrop intentionally has NO @onclick handler.
        Download/View actions also do not change _showDocumentsModal.
        The popup closes only from X or Close.
    -->
    <div class="modal-backdrop fade show"></div>

    <div class="modal fade show d-block lm-doc-list-modal"
         tabindex="-1"
         role="dialog"
         aria-modal="true"
         aria-labelledby="logisticsDocumentsModalTitle">

        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable"
             role="document">

            <div class="modal-content">

                <div class="modal-header">

                    <div class="lm-doc-modal-title-wrap">
                        <h5 id="logisticsDocumentsModalTitle"
                            class="lm-doc-modal-title">
                            <i class="bi bi-folder2-open me-2 text-success"></i>
                            Documents
                        </h5>

                        @if (_documentsModalItem is not null)
                        {
                            <div class="lm-doc-modal-subtitle">
                                @_documentsModalItem.Name
                                @if (!string.IsNullOrWhiteSpace(GetDisplayCode(_documentsModalItem)))
                                {
                                    <span>
                                        &nbsp;•&nbsp; @GetDisplayCode(_documentsModalItem)
                                    </span>
                                }
                            </div>
                        }
                    </div>

                    <button type="button"
                            class="btn-close"
                            aria-label="Close"
                            @onclick="CloseDocumentsModal">
                    </button>

                </div>

                <div class="modal-body">

                    @if (_documentsModalEntries.Count == 0)
                    {
                        <div class="lm-doc-modal-empty">
                            <i class="bi bi-folder-x d-block mb-2 fs-4"></i>
                            No saved documents available.
                        </div>
                    }
                    else
                    {
                        <div class="lm-doc-modal-table-wrap">

                            <table class="lm-doc-modal-table">

                                <thead>
                                    <tr>
                                        <th>Document Name</th>
                                        <th>File Name</th>
                                        <th class="text-center">Download</th>
                                        <th class="text-center">View</th>
                                    </tr>
                                </thead>

                                <tbody>

                                    @foreach (var entry in _documentsModalEntries)
                                    {
                                        var isDownloading =
                                            _downloadingDocumentPaths.Contains(
                                                entry.Path);

                                        <tr>

                                            <td>
                                                <div class="lm-doc-modal-type">
                                                    @entry.TypeName
                                                </div>

                                                @if (!string.IsNullOrWhiteSpace(entry.Company))
                                                {
                                                    <div class="mt-1">
                                                        <span class="lm-doc-entry-company @(string.Equals(entry.Company, "SPIC", StringComparison.OrdinalIgnoreCase) ? "spic" : "gfl")">
                                                            @entry.Company
                                                        </span>
                                                    </div>
                                                }
                                            </td>

                                            <td>
                                                <div class="lm-doc-modal-file"
                                                     title="@GetFileName(entry.Path)">
                                                    @GetFileName(entry.Path)
                                                </div>
                                            </td>

                                            <td class="text-center">

                                                <button type="button"
                                                        class="lm-doc-modal-icon-btn download"
                                                        title="Download @entry.TypeName"
                                                        disabled="@isDownloading"
                                                        @onclick="() => DownloadSingleDocument(entry.Path)">

                                                    <i class="bi @(isDownloading ? "bi-hourglass-split" : "bi-download")"></i>

                                                </button>

                                            </td>

                                            <td class="text-center">

                                                <button type="button"
                                                        class="lm-doc-modal-icon-btn view"
                                                        title="View @entry.TypeName"
                                                        @onclick="() => ViewLogisticsDocument(entry.Path)">

                                                    <i class="bi bi-eye"></i>

                                                </button>

                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="lm-doc-modal-close-btn"
                            @onclick="CloseDocumentsModal">
                        Close
                    </button>

                </div>

            </div>

        </div>

    </div>
}


