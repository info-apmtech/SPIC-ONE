    private void OnBasicStateChanged()
    {
        _form.RegionId = 0;
        _form.HeadquarterId = 0;
        _filteredRegions = _regions.Where(x => x.StateId == _form.BasicStateId).ToList();
        _filteredHeadquarters = new();
    }

    private void OnRegionChanged()
    {
        _form.HeadquarterId = 0;
        _filteredHeadquarters = _headquarters.Where(x => x.RegionId == _form.RegionId).ToList();
    }

    // Reuses the Registration page's MO -> State -> Region -> HQ logic
    // (Register.razor ApplyLockedEmployeeLocation): when the logged-in/assigned
    // MO has a State/Region/HQ, pre-fill and lock those fields.
    private void ApplyAssignedMoLocation()
    {
        if (LoginState.IsAdmin)
            return;

        if (LoginState.StateId > 0)
        {
            _form.BasicStateId = LoginState.StateId;

            _filteredRegions = _regions
                .Where(r => r.StateId == _form.BasicStateId)
                .ToList();
        }

        if (LoginState.RegionId > 0)
        {
            _form.RegionId = LoginState.RegionId;

            _filteredHeadquarters = _headquarters
                .Where(h => h.RegionId == _form.RegionId)
                .ToList();
        }

        if (LoginState.HQId > 0)
        {
            _form.HeadquarterId = LoginState.HQId;
        }

        _isStateLocked = LoginState.StateId > 0;
        _isRegionLocked = LoginState.RegionId > 0;
        _isHqLocked = LoginState.HQId > 0;
    }

    private void OnLocationStateChanged()
    {
        _form.DistrictId = 0;
        _filteredDistricts = _districts.Where(x => x.StateId == _form.StateId).ToList();
    }

    private bool Validate()
    {
        _errors.Clear();

        if (IsPortTab)
        {
            if (string.IsNullOrWhiteSpace(_form.Name))
                _errors["Name"] = "Port name is required.";

            return _errors.Count == 0;
        }

        if (string.IsNullOrWhiteSpace(_form.SapCode))
            _errors["SapCode"] = "SAP Code is required.";

        // Client-side duplicate SAP Code check for Rake Point.
        if (IsRakePointTab && !string.IsNullOrWhiteSpace(_form.SapCode) && !_errors.ContainsKey("SapCode"))
        {
            var sapCode = _form.SapCode.Trim();
            bool duplicateExists = _rakePointAll.Any(x =>
                string.Equals(x.SAPCode, sapCode, StringComparison.OrdinalIgnoreCase) &&
                (!_editingId.HasValue || x.Id != _editingId.Value));

            if (duplicateExists)
                _errors["SapCode"] = $"Rake Point with SAP Code '{sapCode}' already exists.";
        }

        // Client-side duplicate SAP Code check for Warehouse.
        if (IsWarehouseTab && !string.IsNullOrWhiteSpace(_form.SapCode) && !_errors.ContainsKey("SapCode"))
        {
            var sapCode = _form.SapCode.Trim();
            bool duplicateExists = _warehouseAll.Any(x =>
                string.Equals(x.WarehouseCode, sapCode, StringComparison.OrdinalIgnoreCase) &&
                (!_editingId.HasValue || x.Id != _editingId.Value));

            if (duplicateExists)
                _errors["SapCode"] = $"Warehouse with SAP Code '{sapCode}' already exists.";
        }

        if (string.IsNullOrWhiteSpace(_form.Name))
            _errors["Name"] = $"{ActiveTabDisplayName} name is required.";

        if (!_form.OperatedBy.HasValue)
            _errors["OperatedBy"] = "Operated By is required.";

        if (ShowsPvtWarehouseContent && !_form.WarehouseType.HasValue)
            _errors["WarehouseType"] = IsPvtWarehouseCategory
                ? "WH Type is required for PVT WH."
                : "WH Type is required.";

        if (ShowsPvtWarehouseContent)
        {
            if (_form.InSpic)
            {
                if (!_form.SpicApprovedReservationQuantityMT.HasValue)
                    _errors["SpicApprovedReservationQuantityMT"] = "Approved Reservation Quantity (MT) is required for SPIC.";

                if (!_form.SpicAdditionalReservationQuantityMT.HasValue)
                    _errors["SpicAdditionalReservationQuantityMT"] = "Additional Reservation Quantity (MT) is required for SPIC.";
            }

            if (_form.InGreenStar)
            {
                if (!_form.GflApprovedReservationQuantityMT.HasValue)
                    _errors["GflApprovedReservationQuantityMT"] = "Approved Reservation Quantity (MT) is required for GFL / GREEN STAR.";

                if (!_form.GflAdditionalReservationQuantityMT.HasValue)
                    _errors["GflAdditionalReservationQuantityMT"] = "Additional Reservation Quantity (MT) is required for GFL / GREEN STAR.";
            }
        }

        // Document validation follows the Excel reference.
        // Insurance is mandatory for PVT WH / Both (company-specific) and C&F WH. Optional for Rake Point.
        if (ArePvtMatrixDocumentsRequired)
        {
            // PVT/Both: validate only the company rows selected above.
            if (_form.InSpic)
            {
                if (string.IsNullOrWhiteSpace(_form.GstDocumentPath) && _gstDocumentFile == null)
                    _errors["GstDocument"] = "SPIC GST document is required.";

                if (string.IsNullOrWhiteSpace(_form.FertilizerLicenseDocumentPath) && _fertilizerLicenseDocumentFile == null)
                    _errors["FertilizerLicenseDocument"] = "SPIC Fertilizer License document is required.";
            }

            if (_form.InGreenStar)
            {
                if (string.IsNullOrWhiteSpace(_gflGstDocumentPath) && _gflGstDocumentFile == null)
                    _errors["GflGstDocument"] = "GFL / GREEN STAR GST document is required.";

                if (string.IsNullOrWhiteSpace(_gflFertilizerLicenseDocumentPath) && _gflFertilizerLicenseDocumentFile == null)
                    _errors["GflFertilizerLicenseDocument"] = "GFL / GREEN STAR Fertilizer License document is required.";
            }
        }

        if (AreCandFDocumentsRequired)
        {
            if (string.IsNullOrWhiteSpace(_form.GstDocumentPath) && _gstDocumentFile == null)
                _errors["GstDocument"] = "GST document is required for Active C&F WH.";

            if (string.IsNullOrWhiteSpace(_form.FertilizerLicenseDocumentPath) && _fertilizerLicenseDocumentFile == null)
                _errors["FertilizerLicenseDocument"] = "Fertilizer License document is required for Active C&F WH.";
        }

        // Insurance validation is mandatory for every applicable logistics flow.
        // PVT WH / Both: require one insurance file for each selected company.
        if (RequiresCompanySpecificInsurance)
        {
            if (_form.InSpic &&
                string.IsNullOrWhiteSpace(_spicInsuranceDocumentPath) &&
                _spicInsuranceDocumentFile == null)
            {
                _errors["SpicInsuranceDocument"] = "SPIC Insurance document is required when SPIC is selected.";
            }

            if (_form.InGreenStar &&
                string.IsNullOrWhiteSpace(_gflInsuranceDocumentPath) &&
                _gflInsuranceDocumentFile == null)
            {
                _errors["GflInsuranceDocument"] = "GFL / GREEN STAR Insurance document is required when GREEN STAR is selected.";
            }
        }

        // C&F WH uses the existing single insurance document field as mandatory.
        if (RequiresGenericInsurance &&
            string.IsNullOrWhiteSpace(CurrentInsuranceDocumentPath) &&
            _insuranceDocumentFile == null)
        {
            _errors["InsuranceDocument"] = "Insurance document is required for C&F WH.";
        }

        return _errors.Count == 0;
    }

    private async Task HandleSave()
    {
        if (!Validate()) return;

        try
        {
            _isSaving = true;
            _message = null;
            _editingCreatedAt ??= DateTime.Now;

            HttpResponseMessage response = ActiveTab switch
            {
                "Warehouse" => await SaveWarehouse(),
                "Port" => await SaveRakePoint(),
                "PortMaster" => await SavePort(),
                _ => throw new InvalidOperationException("Invalid Logistics Master tab.")
            };

            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                ShowMessage($"Save failed: {body}", true);
                return;
            }

            if (HasFilesWaitingForUpload)
            {
                var recordId = _editingId ?? await ReadCreatedIdAsync(response);
                if (recordId <= 0)
                {
                    ShowMessage("Record saved, but the new record id was not returned. Documents were not uploaded.", true);
                    await LoadData();
                    return;
                }

                _isUploadingDocuments = true;
                var uploadOk = await UploadSelectedDocumentsAsync(recordId);
                _isUploadingDocuments = false;

                if (!uploadOk)
                {
                    ShowMessage($"{ActiveTabDisplayName} saved, but one or more documents failed to upload. Please edit the record and upload again.", true);
                    await LoadData();
                    return;
                }

                // Persist the uploaded file paths after the physical files are saved.
                HttpResponseMessage documentPathUpdate = ActiveTab switch
                {
                    "Warehouse" => await SaveWarehouse(forceUpdate: true, forcedId: recordId),
                    "Port" => await SaveRakePoint(forceUpdate: true, forcedId: recordId),
                    "PortMaster" => await SavePort(forceUpdate: true, forcedId: recordId),
                    _ => throw new InvalidOperationException("Invalid Logistics Master tab.")
                };

                if (!documentPathUpdate.IsSuccessStatusCode)
                {
                    var body = await documentPathUpdate.Content.ReadAsStringAsync();
                    ShowMessage($"Documents uploaded, but saving document paths failed: {body}", true);
                    await LoadData();
                    return;
                }
            }

            ShowMessage(_isEditing
                ? $"{ActiveTabDisplayName} updated successfully."
                : $"{ActiveTabDisplayName} created successfully.", false);

            ResetForm(clearMessage: false);
            await LoadData();
        }
        catch (Exception ex)
        {
            ShowMessage($"Error: {ex.Message}", true);
        }
        finally
        {
            _isSaving = false;
            _isUploadingDocuments = false;
        }
    }

