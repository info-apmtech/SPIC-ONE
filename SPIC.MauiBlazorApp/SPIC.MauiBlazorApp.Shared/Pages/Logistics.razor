    private bool CanEditLogisticsItem(LogisticsItemDto item)
    {
        if (item == null || IsPortTab)
            return false;

        if (!LoginState.Can(SPIC.Core.Entities.PagePermission.Logistics, "Update"))
            return false;

        if (IsAdminLogisticsEditRole)
            return true;

