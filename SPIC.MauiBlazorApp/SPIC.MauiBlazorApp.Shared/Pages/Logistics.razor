@page "/Logistics"



<div class="container-fluid py-4 px-4" style="max-width: 1400px; margin: auto;">

    <h2 class="page-title">Logistics Master</h2>

    <div class="tabs-wrapper">
        <div class="tabs-container">
            @foreach (var tab in TabOptions)
            {
                <div class="tab-item @(ActiveTab == tab ? "active" : "")" @onclick='() => SetActiveTab(tab)'>
                    @tab
                </div>
            }
        </div>
    </div>

    <div class="main-card">
        <div class="section-header">
            <h3 class="section-title">Add New @ActiveTab</h3>
            <button class="btn-outline-green"><i class="bi bi-cloud-arrow-up"></i> Bulk Upload</button>
        </div>

        <div class="row g-3 mb-4 align-items-end">
            
            @if (ActiveTab == "Warehouse")
            {
                <div class="col-md-5">
                    <label class="form-lbl">Warehouse Name</label>
                    <input type="text" class="form-inp" placeholder="Enter Warehouse Name">
                </div>
                <div class="col-md-5">
                    <label class="form-lbl">Google Map or Lat/Long URL</label>
                    <input type="text" class="form-inp" placeholder="Paste Google Map or Lat/Long URL">
                </div>
            }
            else if (ActiveTab == "Rake Point")
            {
                <div class="col">
                    <label class="form-lbl">Rake Point Name</label>
                    <input type="text" class="form-inp" placeholder="Enter Rake Point Name">
                </div>
                <div class="col">
                    <label class="form-lbl">Railway Code</label>
                    <input type="text" class="form-inp" placeholder="Enter Railway Code">
                </div>
                <div class="col">
                    <label class="form-lbl">State Name</label>
                    <input type="text" class="form-inp" placeholder="Enter State Name">
                </div>
                <div class="col">
                    <label class="form-lbl">District Name</label>
                    <input type="text" class="form-inp" placeholder="Enter District Name">
                </div>
            }
            else if (ActiveTab == "Port")
            {
                <div class="col">
                    <label class="form-lbl">Port Name</label>
                    <input type="text" class="form-inp" placeholder="Enter Port Name">
                </div>
                <div class="col">
                    <label class="form-lbl">State Name</label>
                    <input type="text" class="form-inp" placeholder="Enter State Name">
                </div>
                <div class="col">
                    <label class="form-lbl">District Name</label>
                    <input type="text" class="form-inp" placeholder="Enter District Name">
                </div>
            }

            <div class="col-md-auto ms-auto">
                <div class="status-toggle-box">
                    <span>Active</span>
                    <label class="switch">
                        <input type="checkbox" checked>
                        <span class="slider"></span>
                    </label>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end pt-2">
            <button class="btn-cancel"><i class="bi bi-x"></i> Cancel</button>
            <button class="btn-save"><i class="bi bi-save"></i> Save</button>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="metric-card bg-blue-light">
                <div class="metric-header">
                    <h4 class="metric-title">Total @ActiveTab</h4>
                    <div class="metric-trend"><i class="bi bi-arrow-up-right"></i> 12% from last quarter</div>
                </div>
                <div class="metric-val">24</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="metric-card bg-mint-light">
                <div class="metric-header">
                    <h4 class="metric-title">Active</h4>
                    <div class="metric-info"><i class="bi bi-exclamation-circle"></i> 6 zones pending review</div>
                </div>
                <div class="metric-val">18</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="metric-card bg-gray-light">
                <div class="metric-header">
                    <h4 class="metric-title">Inactive</h4>
                    <div class="metric-info"><i class="bi bi-info-circle"></i> 6 zones pending review</div>
                </div>
                <div class="metric-val">18</div>
            </div>
        </div>
    </div>

    <div class="main-card">
        <div class="section-header">
            <h3 class="section-title">Existing @ActiveTab</h3>
            
            <div class="table-controls">
                <div class="search-box">
                    <i class="bi bi-search"></i>
                    <input type="text" placeholder="Search @ActiveTab.ToLower()...">
                </div>
                <select class="filter-select">
                    <option>All Status</option>
                    <option>Active</option>
                    <option>Inactive</option>
                </select>
                <div class="view-toggle">
                    <button class="view-btn"><i class="bi bi-grid"></i> Card View</button>
                    <button class="view-btn active"><i class="bi bi-list-ul"></i> List View</button>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th style="width: 80px;">S:No</th>
                        <th>@ActiveTab Name</th>
                        
                        @if (ActiveTab == "Warehouse")
                        {
                            <th>Google Map or Lat/Long URL</th>
                        }
                        else if (ActiveTab == "Rake Point")
                        {
                            <th>Railway Code</th>
                            <th>District Name</th>
                        }
                        else if (ActiveTab == "Port")
                        {
                            <th>State Name</th>
                        }
                        
                        <th>Status</th>
                        <th>Created At</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="text-muted">1</td>
                        <td>PVT GODOWN ARIYALUR</td>
                        
                        @if (ActiveTab == "Warehouse")
                        {
                            <td><i class="bi bi-geo-alt-fill map-icon"></i> 13.0843° N, 80.2705° E</td>
                        }
                        else if (ActiveTab == "Rake Point")
                        {
                            <td>RLY1234</td>
                            <td>Ariyalur</td>
                        }
                        else if (ActiveTab == "Port")
                        {
                            <td>Tamil Nadu</td>
                        }

                        <td><span class="status-pill status-active">Active</span></td>
                        <td>2026-03-15</td>
                        <td>
                            <div class="action-icons">
                                <i class="bi bi-trash icon-del"></i>
                                <i class="bi bi-pencil-square icon-edit"></i>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-muted">2</td>
                        <td>PVT GODOWN PALAYAVOYAL</td>
                        @if (ActiveTab == "Warehouse") { <td><i class="bi bi-geo-alt-fill map-icon"></i> 13.0843° N, 80.2705° E</td> }
                        else if (ActiveTab == "Rake Point") { <td>RLY5678</td><td>Palayavoyal</td> }
                        else if (ActiveTab == "Port") { <td>Tamil Nadu</td> }
                        <td><span class="status-pill status-active">Active</span></td>
                        <td>2026-03-15</td>
                        <td>
                            <div class="action-icons">
                                <i class="bi bi-trash icon-del"></i>
                                <i class="bi bi-pencil-square icon-edit"></i>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-muted">3</td>
                        <td>PVT GODOWN COIMBATORE</td>
                        @if (ActiveTab == "Warehouse") { <td><i class="bi bi-geo-alt-fill map-icon"></i> 13.0843° N, 80.2705° E</td> }
                        else if (ActiveTab == "Rake Point") { <td>RLY9101</td><td>Coimbatore</td> }
                        else if (ActiveTab == "Port") { <td>Tamil Nadu</td> }
                        <td><span class="status-pill status-inactive">Inactive</span></td>
                        <td>2024-03-15</td>
                        <td>
                            <div class="action-icons">
                                <i class="bi bi-trash icon-del"></i>
                                <i class="bi bi-pencil-square icon-edit"></i>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-muted">4</td>
                        <td>PVT GODOWN COIMBATORE</td>
                        @if (ActiveTab == "Warehouse") { <td><i class="bi bi-geo-alt-fill map-icon"></i> 13.0843° N, 80.2705° E</td> }
                        else if (ActiveTab == "Rake Point") { <td>RLY9101</td><td>Coimbatore</td> }
                        else if (ActiveTab == "Port") { <td>Tamil Nadu</td> }
                        <td><span class="status-pill status-active">Active</span></td>
                        <td>2026-03-15</td>
                        <td>
                            <div class="action-icons">
                                <i class="bi bi-trash icon-del"></i>
                                <i class="bi bi-pencil-square icon-edit"></i>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="pagination-container">
            <div class="items-per-page">
                Items Per Page
                <select>
                    <option>16</option>
                    <option>32</option>
                    <option>50</option>
                </select>
            </div>
            
            <div class="pagination-controls">
                <div class="page-btn"><i class="bi bi-chevron-left"></i></div>
                <div class="page-btn active">1</div>
                <div class="page-btn">2</div>
                <div class="page-btn">3</div>
                <div class="page-btn ellipsis">...</div>
                <div class="page-btn">8</div>
                <div class="page-btn">9</div>
                <div class="page-btn">10</div>
                <div class="page-btn"><i class="bi bi-chevron-right"></i></div>
            </div>
        </div>

    </div>

</div>

@code {
    // Define the available tabs
    private List<string> TabOptions = new List<string> { "Warehouse", "Rake Point", "Port" };
    
    // State to keep track of the selected tab (Defaulting to "Warehouse" to match first image)
    private string ActiveTab { get; set; } = "Warehouse";

    // Method to switch tabs
    private void SetActiveTab(string tabName)
    {
        ActiveTab = tabName;
    }
}