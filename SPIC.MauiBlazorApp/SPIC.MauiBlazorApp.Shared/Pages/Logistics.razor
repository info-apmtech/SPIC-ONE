    private bool CanApprove(LogisticsItemDto item)
    {
        if (IsPortTab || item.IsSubmittedForReview != true)
            return false;

        if ((LoginState.UserRole == AppRole.RM || LoginState.UserRole == AppRole.RMD) &&
            item.RMApproved == null)
            return true;

        if ((LoginState.UserRole == AppRole.SMM || LoginState.UserRole == AppRole.SMD) &&
            item.RMApproved == true &&
            item.SMApproved == null)
            return true;

        if ((LoginState.UserRole == AppRole.AVP ||
             LoginState.UserRole == AppRole.Admin ||
             LoginState.UserRole == AppRole.CorporateAdmin ||
             LoginState.UserRole == AppRole.Director) &&
            item.RMApproved == true &&
            item.SMApproved == true &&
            item.AVPApproved == null)
            return true;

        return false;
    }

    private string GetApproveButtonText(LogisticsItemDto item)
    {
        if (LoginState.UserRole == AppRole.RM || LoginState.UserRole == AppRole.RMD)
            return "Approve to SMM";

        if (LoginState.UserRole == AppRole.SMM || LoginState.UserRole == AppRole.SMD)
            return "Approve to AVP";

        return "Final Approve";
    }

    private async Task ApproveItem(LogisticsItemDto item)
    {
        if (!CanApprove(item))
            return;

        try
        {
            _approvingId = item.Id;
            _message = null;

            var response = await Http.PostAsJsonAsync(
                $"{CurrentApiBase}/{item.Id}/approve",
                new LogisticsApprovalRequest
                {
                    Remarks = "Approved"
                });

            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                ShowMessage($"Approval failed: {body}", true);
                return;
            }

            ShowMessage("Approval completed successfully.", false);
            await LoadData();
        }
        catch (Exception ex)
        {
            ShowMessage($"Approval failed: {ex.Message}", true);
        }
        finally
        {
            _approvingId = null;
        }
    }


    private bool CanReject(LogisticsItemDto item) => CanApprove(item);

    private void OpenRejectModal(LogisticsItemDto item)
    {
        if (!CanReject(item))
            return;

        _rejectTarget = item;
        _rejectRemarks = string.Empty;
        _rejectRemarksError = null;
        _showRejectModal = true;
    }

    private void CancelReject()
    {
        if (_rejectingId.HasValue)
            return;

        _showRejectModal = false;
        _rejectTarget = null;
        _rejectRemarks = string.Empty;
        _rejectRemarksError = null;
    }

    private async Task RejectItem()
    {
        if (_rejectTarget == null || !CanReject(_rejectTarget))
            return;

        var remarks = _rejectRemarks.Trim();
        if (string.IsNullOrWhiteSpace(remarks))
        {
            _rejectRemarksError = "Rejection remarks are required.";
            return;
        }

        // Capture the exact selected row before async calls so only the
        // row whose Reject button was clicked is processed.
        var target = _rejectTarget;
        var apiBase = CurrentApiBase;
        var deleteWarehouseOnReject = IsWarehouseTab;

        try
        {
            _rejectingId = target.Id;
            _rejectRemarksError = null;
            _message = null;

            // Keep the existing rejection API first. This preserves the current
            // RM -> SMM -> AVP role/stage validation and rejection remarks flow.
            var response = await Http.PostAsJsonAsync(
                $"{apiBase}/{target.Id}/reject",
                new LogisticsApprovalRequest
                {
                    Remarks = remarks
                });

            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                ShowMessage($"Rejection failed: {body}", true);
                return;
            }

            // Warehouse only: after the existing reject action succeeds, reuse the
            // same DELETE endpoint already used by the page's normal delete flow.
            // This removes only the exact row whose Reject button was clicked.
            if (deleteWarehouseOnReject)
            {
                var deleteResponse = await Http.DeleteAsync($"{apiBase}/{target.Id}");
                if (!deleteResponse.IsSuccessStatusCode)
                {
                    var deleteBody = await deleteResponse.Content.ReadAsStringAsync();
                    ShowMessage(
                        $"Rejection completed, but deleting '{target.Name}' failed: {deleteBody}",
                        true);
                    return;
                }
            }

            ShowMessage(
                deleteWarehouseOnReject
                    ? $"'{target.Name}' rejected and deleted successfully."
                    : "Rejection completed successfully.",
                false);

            _showRejectModal = false;
            _rejectTarget = null;
            _rejectRemarks = string.Empty;
            await LoadData();
        }
        catch (Exception ex)
        {
            ShowMessage($"Rejection failed: {ex.Message}", true);
        }
        finally
        {
            _rejectingId = null;
        }
    }

    private static string GetCreatedByDisplay(LogisticsItemDto item) =>
        !string.IsNullOrWhiteSpace(item.CreatedByName)
            ? item.CreatedByName!
            : !string.IsNullOrWhiteSpace(item.CreatedBy)
                ? item.CreatedBy!
                : "-";

    private static string GetApprovalStatus(LogisticsItemDto item)
    {
        if (item.IsSubmittedForReview != true)
            return "Draft";

        if (item.RMApproved == false)
            return "Rejected by RM";

        if (item.SMApproved == false)
            return "Rejected by SMM";

        if (item.AVPApproved == false)
            return "Rejected by AVP";

        if (item.AVPApproved == true)
            return "Approved";

        if (item.RMApproved == null)
            return "Pending RM";

        if (item.RMApproved == true && item.SMApproved == null)
            return "Pending SMM";

        if (item.RMApproved == true && item.SMApproved == true && item.AVPApproved == null)
            return "Pending AVP";

        return "Submitted";
    }

    private static string GetApprovalBadgeClass(LogisticsItemDto item)
    {
        var status = GetApprovalStatus(item);

        if (status == "Approved")
            return "lm-approval-approved";

        if (status.StartsWith("Rejected", StringComparison.OrdinalIgnoreCase))
            return "lm-approval-rejected";

        if (status.StartsWith("Pending", StringComparison.OrdinalIgnoreCase) || status == "Submitted")
            return "lm-approval-pending";

        return "lm-approval-draft";
    }

    private async Task ToggleStatus(LogisticsItemDto item)
    {
        try
        {
            var newStatus = !item.IsActive;
            var response = await Http.PatchAsync($"{CurrentApiBase}/{item.Id}/status?isActive={newStatus}", null);

            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                ShowMessage($"Status change failed: {body}", true);
                return;
            }

            item.IsActive = newStatus;
            ApplyFilter();
        }
        catch (Exception ex)
        {
            ShowMessage($"Error: {ex.Message}", true);
        }
    }

    private void ApplyFilter()
    {
        _filteredItems = CurrentAllItems
            .Where(x => _statusFilter switch
            {
                "Active" => x.IsActive,
                "Inactive" => !x.IsActive,
                _ => true
            })
            .OrderByDescending(x => x.CreatedAt)
            .ToList();
    }

