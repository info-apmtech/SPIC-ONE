    private async Task ApproveItem()
    {
        if (_approveTarget == null || !CanApprove(_approveTarget))
            return;

        var remarks = _approveRemarks.Trim();
        if (string.IsNullOrWhiteSpace(remarks))
        {
            _approveRemarksError = "Approval remarks are required.";
            return;
        }

        var target = _approveTarget;
        var apiBase = CurrentApiBase;

        try
        {
            _approvingId = target.Id;
            _approveRemarksError = null;
            _message = null;

            var response = await Http.PostAsJsonAsync(
                $"{apiBase}/{target.Id}/approve",
                new LogisticsApprovalRequest
                {
                    Remarks = remarks
                });

            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                ShowMessage($"Approval failed: {ParseErrorMessage(body)}", true);
                return;
            }

            _showApproveModal = false;
            _approveTarget = null;
            _approveRemarks = string.Empty;
            ShowMessage("Approval completed successfully.", false);
            await LoadData();
        }
        catch (Exception ex)
        {
            ShowMessage($"Approval failed: {ex.Message}", true);
        }
        finally
        {
            _approvingId = null;
        }
    }

