    private async Task LoadLookups()
    {
        try
        {
            var statesTask = Http.GetFromJsonAsync<List<StateDto>>("api/State/all");
            var districtsTask = Http.GetFromJsonAsync<List<DistrictDto>>("api/District/all");
            var regionsTask = Http.GetFromJsonAsync<List<RegionDto>>("api/Region/all");
            var hqTask = Http.GetFromJsonAsync<List<HeadquarterDto>>("api/Headquarter/all");

            await Task.WhenAll(statesTask, districtsTask, regionsTask, hqTask);

            _states = statesTask.Result ?? new();
            _districts = districtsTask.Result ?? new();
            _regions = regionsTask.Result ?? new();
            _headquarters = hqTask.Result ?? new();
        }
        catch (Exception ex)
        {
            ShowMessage($"Failed to load location lookups: {ex.Message}", true);
        }
    }

    private async Task LoadUserNamesForExport()
    {
        try
        {
            var users = await Http.GetFromJsonAsync<List<UserInfoLookupDto>>("api/UserInfo/all") ?? new();

            _userNamesById = users
                .Where(x => !string.IsNullOrWhiteSpace(x.Id))
                .GroupBy(x => x.Id.Trim(), StringComparer.OrdinalIgnoreCase)
                .ToDictionary(
                    g => g.Key,
                    g =>
                    {
                        var user = g.First();
                        return !string.IsNullOrWhiteSpace(user.Name)
                            ? user.Name.Trim()
                            : !string.IsNullOrWhiteSpace(user.UserName)
                                ? user.UserName.Trim()
                                : user.Id.Trim();
                    },
                    StringComparer.OrdinalIgnoreCase);
        }
        catch
        {
            // Export enhancement only. If user lookup is unavailable, keep the
            // existing page/save/approval flow untouched and fall back to the stored value.
            _userNamesById = new(StringComparer.OrdinalIgnoreCase);
        }
    }

