    private async Task OnPincodeChanged()
    {
        _pincodeMessage = null;
        _pincodeSuccess = false;

        if (!string.IsNullOrEmpty(_form.PinCode))
        {
            var digitsOnly = new string(_form.PinCode.Where(char.IsDigit).ToArray());
            if (digitsOnly.Length > 6)
                digitsOnly = digitsOnly[..6];

            if (digitsOnly != _form.PinCode)
                _form.PinCode = digitsOnly;
        }

        if (string.IsNullOrWhiteSpace(_form.PinCode) || _form.PinCode.Length != 6)
            return;

        _isPincodeLookup = true;
        StateHasChanged();

        try
        {
            using var response = await Http.GetAsync($"api/PincodeLookup/{_form.PinCode}");

            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                _pincodeMessage = $"Lookup failed (HTTP {(int)response.StatusCode}): {body}";
                return;
            }

            var results = await response.Content.ReadFromJsonAsync<List<PincodeApiResponse>>();
            var result = results?.FirstOrDefault();

            if (result == null ||
                !string.Equals(result.Status, "Success", StringComparison.OrdinalIgnoreCase) ||
                result.PostOffice == null ||
                result.PostOffice.Count == 0)
            {
                _pincodeMessage = $"No data found for pincode {_form.PinCode}";
                return;
            }

            // Match Register behaviour: use the first post office returned.
            var postOffice = result.PostOffice[0];

            var apiState = NormalizeLocationName(postOffice.State);
            var matchedState = _states.FirstOrDefault(s =>
                NormalizeLocationName(s.StateName)
                    .Equals(apiState, StringComparison.OrdinalIgnoreCase));

            if (matchedState != null)
            {
                _form.StateId = matchedState.Id;
                _filteredDistricts = _districts
                    .Where(d => d.StateId == matchedState.Id)
                    .ToList();
            }

            var apiDistrict = NormalizeLocationName(postOffice.District);
            var matchedDistrict = _districts.FirstOrDefault(d =>
                NormalizeLocationName(d.DistrictName)
                    .Equals(apiDistrict, StringComparison.OrdinalIgnoreCase) &&
                (matchedState == null || d.StateId == matchedState.Id));

            if (matchedDistrict != null)
                _form.DistrictId = matchedDistrict.Id;

            if (!string.IsNullOrWhiteSpace(postOffice.Block) &&
                !string.Equals(postOffice.Block, "NA", StringComparison.OrdinalIgnoreCase))
            {
                _form.Block = postOffice.Block;
                _form.Taluk = postOffice.Block;
            }
            else if (!string.IsNullOrWhiteSpace(postOffice.Division))
            {
                _form.Taluk = postOffice.Division;
            }

            if (!string.IsNullOrWhiteSpace(postOffice.Name))
                _form.Village = postOffice.Name;

            var details = new List<string>();
            if (!string.IsNullOrWhiteSpace(postOffice.Name))
                details.Add($"Village: {postOffice.Name}");
            if (!string.IsNullOrWhiteSpace(postOffice.Block) &&
                !string.Equals(postOffice.Block, "NA", StringComparison.OrdinalIgnoreCase))
                details.Add($"Block: {postOffice.Block}");
            if (!string.IsNullOrWhiteSpace(_form.Taluk))
                details.Add($"Taluk: {_form.Taluk}");
            if (matchedDistrict != null)
                details.Add($"District: {matchedDistrict.DistrictName}");
            if (matchedState != null)
                details.Add($"State: {matchedState.StateName}");

            _pincodeSuccess = true;
            _pincodeMessage = "Auto-filled: " + string.Join(", ", details);
        }
        catch (HttpRequestException httpEx)
        {
            _pincodeMessage = $"Network error: {httpEx.Message}";
        }
        catch (TaskCanceledException)
        {
            _pincodeMessage = "Lookup timed out - try again.";
        }
        catch (Exception ex)
        {
            _pincodeMessage = $"{ex.GetType().Name}: {ex.Message}";
        }
        finally
        {
            _isPincodeLookup = false;
            StateHasChanged();
        }
    }

    private static string NormalizeLocationName(string? value) =>
        (value ?? string.Empty).Trim().Replace(" ", string.Empty);

    private async Task OnGoogleMapUrlChanged()
    {
        _locationMessage = null;

        if (string.IsNullOrWhiteSpace(_form.GoogleURL))
        {
            _form.Latitude = null;
            _form.Longitude = null;
            SyncLatitudeLongitudeText();
            return;
        }

        var url = _form.GoogleURL.Trim();

        if (url.Contains("goo.gl", StringComparison.OrdinalIgnoreCase) ||
            url.Contains("maps.app.goo.gl", StringComparison.OrdinalIgnoreCase))
        {
            _locationMessage = "Shortened URL detected. Open the link, copy the full Google Maps URL, and paste it here.";
            _locationSuccess = false;
            return;
        }

        var match = Regex.Match(url, @"@(-?\d+\.\d+),(-?\d+\.\d+)");
        if (!match.Success) match = Regex.Match(url, @"[?&]q=(-?\d+\.\d+),(-?\d+\.\d+)");
        if (!match.Success) match = Regex.Match(url, @"[?&]ll=(-?\d+\.\d+),(-?\d+\.\d+)");
        if (!match.Success) match = Regex.Match(url, @"/dir//(-?\d+\.\d+),(-?\d+\.\d+)");
        if (!match.Success) match = Regex.Match(url, @"(-?\d+\.\d+),\s*(-?\d+\.\d+)");

        if (match.Success &&
            double.TryParse(match.Groups[1].Value,
                System.Globalization.NumberStyles.Float,
                System.Globalization.CultureInfo.InvariantCulture,
                out var lat) &&
            double.TryParse(match.Groups[2].Value,
                System.Globalization.NumberStyles.Float,
                System.Globalization.CultureInfo.InvariantCulture,
                out var lng))
        {
            _form.Latitude = lat;
            _form.Longitude = lng;
            SyncLatitudeLongitudeText();
            _locationMessage = $"Coordinates extracted: {lat:F6}, {lng:F6}";
            _locationSuccess = true;
            await TriggerMapUpdate(lat, lng);
        }
        else
        {
            _form.Latitude = null;
            _form.Longitude = null;
            SyncLatitudeLongitudeText();
            _locationMessage = "Could not extract coordinates from this URL. Try the full Google Maps URL.";
            _locationSuccess = false;
        }
    }

