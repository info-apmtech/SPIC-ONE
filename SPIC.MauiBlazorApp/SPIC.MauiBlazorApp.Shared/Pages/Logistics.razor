                                        <i class="bi bi-cloud-arrow-up"></i> Choose GREEN STAR GST File
                                        <InputFile OnChange="OnGflGstDocumentSelected" accept=".pdf,.jpg,.jpeg,.png,.webp" hidden />
                                    </label>
                                    @if (_gflGstDocumentFile != null || !string.IsNullOrWhiteSpace(_gflGstDocumentPath))
