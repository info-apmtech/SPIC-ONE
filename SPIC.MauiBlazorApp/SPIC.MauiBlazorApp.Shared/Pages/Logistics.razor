                                       inputmode="numeric"
                                       class="form-control-custom w-100"
                                       placeholder="10-digit mobile number"
                                       maxlength="10"
                                       @bind="_form.ContactNumber" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

