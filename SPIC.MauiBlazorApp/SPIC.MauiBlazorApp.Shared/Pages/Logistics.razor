    private bool CanApprove(LogisticsItemDto item)
    {
        if (IsPortTab || item.IsSubmittedForReview != true)
            return false;

        // RM handles the initial RM review and requests returned by SMM.
        if (LoginState.UserRole == AppRole.RM || LoginState.UserRole == AppRole.RMD)
        {
            return item.RMApproved == null ||
                   (item.RMApproved == true && item.SMApproved == false);
        }

        // SMM handles the initial SMM review and requests returned by AVP.
        if (LoginState.UserRole == AppRole.SMM || LoginState.UserRole == AppRole.SMD)
        {
            return item.RMApproved == true &&
                   (item.SMApproved == null ||
                    (item.SMApproved == true && item.AVPApproved == false));
        }

        // Final approvers act only after RM + SMM approval and while AVP is pending.
        if (LoginState.UserRole == AppRole.AVP ||
            LoginState.UserRole == AppRole.Admin ||
            LoginState.UserRole == AppRole.CorporateAdmin ||
            LoginState.UserRole == AppRole.Director)
        {
            return item.RMApproved == true &&
                   item.SMApproved == true &&
                   item.AVPApproved == null;
        }

        return false;
    }

    private bool CanReject(LogisticsItemDto item) => CanApprove(item);

