                                    <div class="small @(_pincodeSuccess ? "text-success" : "text-warning") mt-1">
                                        @_pincodeMessage
                                    </div>
                                }
                            </div>

                            <div class="col-12 col-sm-6">
                                <label class="form-label-custom">
                                    Village
                                    @if (_form.IsActive)
                                    {
                                        <span class="text-danger">*</span>
                                    }
                                </label>
                                <input type="text"
                                       class="form-control-custom w-100"
                                       placeholder="Village"
                                       @bind="_form.Village" />
                            </div>

                            <div class="col-6 col-sm-6 col-md-3">
                                <label class="form-label-custom">
                                    Block
                                    @if (_form.IsActive)
                                    {
                                        <span class="text-danger">*</span>
                                    }
                                </label>
                                <input type="text"
                                       class="form-control-custom w-100"
                                       placeholder="Enter Block"
                                       @bind="_form.Block" />
                            </div>

                            <div class="col-6 col-sm-6 col-md-3">
                                <label class="form-label-custom">
                                    Taluk
                                    @if (_form.IsActive)
                                    {
                                        <span class="text-danger">*</span>
                                    }
                                </label>
                                <input type="text"
                                       class="form-control-custom w-100"
                                       placeholder="Enter Taluk"
                                       @bind="_form.Taluk" />
                            </div>

                            <div class="col-12 col-sm-6 col-md-3">
                                <label class="form-label-custom">
                                    District
                                    @if (_form.IsActive)
                                    {
                                        <span class="text-danger">*</span>
                                    }
                                </label>
                                <select class="form-select-custom w-100" @bind="_form.DistrictId">
                                    <option value="0">-- Select District --</option>
                                    @foreach (var district in _filteredDistricts)
                                    {
                                        <option value="@district.Id">@district.DistrictName</option>
                                    }
                                </select>
                            </div>

                            <div class="col-12 col-sm-6 col-md-3">
                                <label class="form-label-custom">
                                    State
                                    @if (_form.IsActive)
                                    {
                                        <span class="text-danger">*</span>
                                    }
                                </label>
