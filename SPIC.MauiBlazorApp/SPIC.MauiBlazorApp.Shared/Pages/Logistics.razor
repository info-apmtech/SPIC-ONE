                        <img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/LocationIcon.svg"
                             alt="Location"
                             class="formicon" />Primary Location
                    </div>

                    <button type="button"
                            class="btn btn-outline-success btn-sm rounded-pill px-3 card-header-title use-current-loc-btn"
                            @onclick="UseCurrentLocation"
                            disabled="@_isGettingLocation">
                        @if (_isGettingLocation)
                        {
                            <i class="bi bi-arrow-repeat spin"></i>
                            <span>Getting Location...</span>
                        }
                        else
                        {
                            <img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/CurrentLocation.svg"
                                 alt="Current Location"
                                 class="verifyicon" />
                            <span>Use Current Location</span>
                        }
                    </button>
                </div>

                @if (!string.IsNullOrWhiteSpace(_locationMessage))
                {
                    <div class="alert @(_locationSuccess ? "alert-success" : "alert-warning") py-1 px-2 small mb-2">
                        @_locationMessage
                    </div>
                }

                <div class="row g-3">
                    <div class="col-12 col-md-4">
                        <div class="map-box-wrap">
                            <div id="leafletMap" class="leaflet-map-el"></div>
