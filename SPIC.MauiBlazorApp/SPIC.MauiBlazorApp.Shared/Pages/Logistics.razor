 private bool CanDeleteLogisticsItem(LogisticsItemDto item)
{
    if (item == null)
        return false;

    // Existing admin delete
    if (CanDeleteLogistics)
        return true;


    // MO / MDO / JMDO delete only Warehouse
    if (!IsWarehouseTab)
        return false;


    var role = LoginState.UserRole.ToString();

    if (role.Equals("MO", StringComparison.OrdinalIgnoreCase) ||
        role.Equals("MDO", StringComparison.OrdinalIgnoreCase) ||
        role.Equals("JMDO", StringComparison.OrdinalIgnoreCase))
    {

        // Cannot delete after final approval
        if (item.AVPApproved == true)
            return false;


        // Cannot delete after RM approved
        if (item.RMApproved == true)
            return false;


        // Draft
        // Pending RM
        // Sent Back to MO
        return true;
    }


    return false;
}
