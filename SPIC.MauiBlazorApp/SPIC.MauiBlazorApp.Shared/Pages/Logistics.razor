    private bool _isDownloadingDocuments;

    private DotNetObjectReference<Logistics>? _objRef;

    protected override async Task OnInitializedAsync()
    {
        _objRef = DotNetObjectReference.Create(this);

        try
        {
            var token = await JS.InvokeAsync<string>("sessionStorage.getItem", "jwt_token");
            if (!string.IsNullOrWhiteSpace(token))
                _currentUserId = GetUserIdFromToken(token);
        }
        catch
        {
            // Keep previous fallback behaviour.
        }

        await LoadLookups();
        await LoadPvtMasters();
        await LoadRakePointMasters();
        ApplyAssignedMoLocation();
        await LoadData();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            await JS.InvokeVoidAsync("initLeafletMap", "leafletMap", _objRef);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Logistics map initialization failed: {ex.Message}");
        }
    }

    public void Dispose() => _objRef?.Dispose();

    private static LogisticsFormModel NewForm() => new()
    {
        WarehouseCategory = LogisticsWarehouseCategory.PvtWH,
        InSpic = false,
        InGreenStar = false,
        IsActive = true
    };

    private async Task LoadLookups()
    {
        try
        {
            var statesTask = Http.GetFromJsonAsync<List<StateDto>>("api/State/all");
            var districtsTask = Http.GetFromJsonAsync<List<DistrictDto>>("api/District/all");
            var regionsTask = Http.GetFromJsonAsync<List<RegionDto>>("api/Region/all");
            var hqTask = Http.GetFromJsonAsync<List<HeadquarterDto>>("api/Headquarter/all");

            await Task.WhenAll(statesTask, districtsTask, regionsTask, hqTask);

            _states = statesTask.Result ?? new();
            _districts = districtsTask.Result ?? new();
            _regions = regionsTask.Result ?? new();
            _headquarters = hqTask.Result ?? new();
        }
        catch (Exception ex)
        {
            ShowMessage($"Failed to load location lookups: {ex.Message}", true);
        }
    }

    private async Task LoadPvtMasters()
    {
        try
        {
            _pvtMasterAll = await Http.GetFromJsonAsync<List<SapCodeOptionDto>>("api/PVTMaster/all") ?? new();
        }
        catch (Exception ex)
        {
            ShowMessage($"Failed to load PVT Master data: {ex.Message}", true);
        }
    }

    private async Task LoadRakePointMasters()
    {
        try
        {
            var data = await Http.GetFromJsonAsync<List<RakePointMasterItemDto>>("api/RakePointMaster/all") ?? new();
            _rakePointMasterAll = data
                .Select(x => new SapCodeOptionDto { Id = x.Id, Code = x.RakePointCode, Name = x.Name })
                .ToList();
        }
        catch (Exception ex)
        {
            ShowMessage($"Failed to load Rake Point Master data: {ex.Message}", true);
        }
    }

