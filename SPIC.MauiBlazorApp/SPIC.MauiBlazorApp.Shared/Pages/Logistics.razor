                                        @if (!string.IsNullOrWhiteSpace(_spicInsuranceDocumentPath) || _spicInsuranceDocumentFile != null)
                                        {
                                            <button type="button"
                                                    class="lm-doc-action-btn lm-doc-icon-btn remove"
                                                    aria-label="Remove SPIC Insurance Document"
                                                    title="Remove SPIC Insurance Document"
