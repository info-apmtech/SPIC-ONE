    private async Task<bool> UploadSelectedDocumentsAsync(int recordId)
    {
        try
        {
            var entityType = ActiveTab switch
            {
                "Warehouse" => "Warehouse",
                "Port" => "RackPoint",
                "PortMaster" => "Port",
                _ => throw new InvalidOperationException("Invalid Logistics Master tab.")
            };

            if (ShowsPvtWarehouseContent && _gstDocumentFile != null)
                _form.GstDocumentPath = await UploadLogisticsFileAsync(entityType, recordId, "GST", _gstDocumentFile);

            if (ShowsPvtWarehouseContent && _insuranceDocumentFile != null)
                _form.InsuranceDocumentPath = await UploadLogisticsFileAsync(entityType, recordId, "Insurance", _insuranceDocumentFile);

            if (ShowsPvtWarehouseContent && _fertilizerLicenseDocumentFile != null)
                _form.FertilizerLicenseDocumentPath = await UploadLogisticsFileAsync(entityType, recordId, "FertilizerLicense", _fertilizerLicenseDocumentFile);

            foreach (var file in _otherDocumentFiles)
            {
                var path = await UploadLogisticsFileAsync(entityType, recordId, "Other", file);
                if (!string.IsNullOrWhiteSpace(path) && !_otherDocumentPaths.Contains(path, StringComparer.OrdinalIgnoreCase))
                    _otherDocumentPaths.Add(path);
            }

            _form.OtherDocumentPathsJson = SerializeDocumentPaths(_otherDocumentPaths);
            ClearSelectedDocumentFiles();
            return true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Logistics document upload failed: {ex.Message}");
            return false;
        }
    }

    private async Task<string> UploadLogisticsFileAsync(string entityType, int recordId, string documentType, IBrowserFile file)
    {
        using var content = new MultipartFormDataContent();
        await using var stream = file.OpenReadStream(10 * 1024 * 1024);
        using var fileContent = new StreamContent(stream);
        fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(
            string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType);
        content.Add(fileContent, "file", file.Name);

        var response = await Http.PostAsync($"api/LogisticsFile/upload/{entityType}/{recordId}/{documentType}", content);
        if (!response.IsSuccessStatusCode)
        {
            var body = await response.Content.ReadAsStringAsync();
            throw new InvalidOperationException($"{documentType} upload failed: {body}");
        }

        var result = await response.Content.ReadFromJsonAsync<LogisticsFileUploadResponse>();
        if (string.IsNullOrWhiteSpace(result?.FilePath))
            throw new InvalidOperationException($"{documentType} upload did not return a file path.");

        return result.FilePath;
    }

