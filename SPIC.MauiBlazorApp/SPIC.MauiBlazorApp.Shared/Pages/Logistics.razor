        _rakePointInsuranceDocumentPath = IsRakePointTab
            ? FindPathByDocumentType("insurance")
            : null;
        _gflInsuranceDocumentPath = FindPathByDocumentType("insurance_gfl");
        _spicInsuranceDocumentPath = FindPathByDocumentType("insurance_spic");
