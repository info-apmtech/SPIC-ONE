@page "/Logistics"
@implements IDisposable
@using System.IO
@using System.Net.Http.Json
@using System.Text.RegularExpressions
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components
@using SPIC.Core.Entities
@inject HttpClient Http
@inject IJSRuntime JS
@inject SPIC.MauiBlazorApp.Shared.Services.LoginState LoginState
@inject NavigationManager Nav

<style>
    .lm-field-error {
        color: #dc3545;
        font-size: .78rem;
        margin-top: 4px;
    }

    .lm-message {
        margin-bottom: 1rem;
    }

    /* Logistics page header - admin-only SAP Code shortcut */
    .lm-page-heading-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 1.5rem;
    }

    .lm-page-heading-row .reg-page-heading {
        margin-bottom: 0 !important;
    }

    .lm-sap-code-btn {
        min-height: 38px;
        padding: 0 14px;
        border: 1px solid #059669;
        border-radius: 8px;
        background: #ffffff;
        color: #047857;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        font-size: .8rem;
        font-weight: 700;
        line-height: 1;
        white-space: nowrap;
        cursor: pointer;
        box-shadow: 0 1px 2px rgba(15, 23, 42, .05);
        transition: background .15s ease, border-color .15s ease, transform .15s ease;
    }

    .lm-sap-code-btn:hover {
        background: #ecfdf5;
        border-color: #047857;
        transform: translateY(-1px);
    }

    @@media (max-width: 575.98px) {
        .lm-page-heading-row {
            align-items: flex-start;
        }

        .lm-sap-code-btn {
            min-height: 36px;
            padding: 0 11px;
            font-size: .75rem;
        }
    }

    .lm-company-card {
        cursor: pointer;
        user-select: none;
    }

    .lm-save-row {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin: 18px 0 24px;
    }

    .lm-location-note {
        font-size: .8rem;
        margin-top: 6px;
    }

    .lm-table-code {
        font-weight: 600;
        color: #374151;
    }

    /* Logistics list -> PDF detail view.
       Uses internal Blazor navigation so MAUI authentication state is preserved. */
    .lm-pdf-view-icon {
        color: #dc3545;
        font-size: 1.18rem;
        cursor: pointer;
        transition: transform .15s ease, color .15s ease;
    }

    .lm-pdf-view-icon:hover {
        color: #b02a37;
        transform: scale(1.08);
    }


    .lm-company-pdf-actions {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        min-width: 42px;
    }

    .lm-company-pdf-btn {
        width: 40px;
        height: 34px;
        padding: 3px 5px;
        border: 1px solid #e5e7eb;
        border-radius: 7px;
        background: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: 0 1px 2px rgba(0, 0, 0, .05);
        transition: border-color .15s ease, background .15s ease, transform .15s ease;
    }

    .lm-company-pdf-btn:hover {
        border-color: #059669;
        background: #f0fdf4;
        transform: translateY(-1px);
    }

    .lm-company-pdf-logo {
        display: block;
        max-width: 30px;
        max-height: 25px;
        object-fit: contain;
        pointer-events: none;
    }

    .lm-company-pdf-logo.greenstar {
        max-width: 36px;
        max-height: 27px;
    }


    .lm-reservation-card {
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 16px;
        background: #fff;
        height: 100%;
    }

    .lm-reservation-title {
        font-size: .9rem;
        font-weight: 700;
        color: #374151;
        margin-bottom: 12px;
    }

    .lm-doc-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
    }

    .lm-doc-card {
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 14px;
        background: #fff;
        min-height: 150px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        position: relative;
    }

        .lm-doc-card.required {
            border: 2px solid #f59e0b;
            background: #fffaf0;
            box-shadow: 0 0 0 3px rgba(245, 158, 11, .08);
        }

    .lm-doc-card-title {
        font-size: .9rem;
        font-weight: 700;
        color: #374151;
        padding-right: 72px;
    }

    .lm-doc-required-badge {
        display: inline;
        padding: 0;
        font-size: 1rem;
        font-weight: 700;
        color: #dc3545;
        background: transparent;
        margin-left: 3px;
    }

    .lm-doc-selected {
        font-size: .78rem;
        color: #198754;
        margin-top: 8px;
        overflow-wrap: anywhere;
    }

    .lm-doc-replace-note {
        color: #b45309;
        font-size: .72rem;
        font-weight: 500;
    }

    .lm-doc-existing-list {
        margin: 8px 0 0;
        padding-left: 18px;
        font-size: .78rem;
        color: #4b5563;
    }

        .lm-doc-existing-list li {
            margin-bottom: 4px;
            overflow-wrap: anywhere;
            position: relative;
            min-height: 28px;
            padding-right: 66px;
        }

    .lm-doc-list-tools {
        position: absolute;
        top: 0;
        right: 0;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    .lm-upload-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        border: 1px dashed #059669;
        color: #047857;
        border-radius: 8px;
        padding: 8px 10px;
        cursor: pointer;
        font-size: .82rem;
        font-weight: 600;
        background: #f0fdf4;
        margin-top: 10px;
    }


    .lm-doc-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 6px;
        margin-top: 10px;
    }

        .lm-doc-actions .lm-upload-btn {
            margin-top: 0;
        }

    .lm-doc-action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        border: 1px solid #d1d5db;
        background: #f8fafc;
        color: #374151;
        border-radius: 8px;
        padding: 8px 10px;
        cursor: pointer;
        font-size: .82rem;
        font-weight: 600;
        line-height: 1;
    }

    /* View and Remove remain the same actions; only their document-card UI changes. */
    .lm-doc-card .lm-doc-icon-btn {
        position: absolute;
        top: 10px;
        width: 32px;
        height: 32px;
        padding: 0;
        border-radius: 7px;
        font-size: .9rem;
        z-index: 2;
    }

    .lm-doc-card .lm-doc-icon-btn.view {
        right: 48px;
        color: #047857;
    }

    .lm-doc-card .lm-doc-icon-btn.remove {
        right: 10px;
        color: #dc3545;
    }

    .lm-doc-card .lm-doc-icon-btn.remove:hover:not(:disabled) {
        border-color: #fca5a5;
        color: #b91c1c;
        background: #fef2f2;
    }

    .lm-doc-list-icon-btn {
        width: 28px;
        height: 28px;
        padding: 0;
        border-radius: 6px;
    }

        .lm-doc-action-btn:hover:not(:disabled) {
            border-color: #059669;
            color: #047857;
            background: #ecfdf5;
        }

        .lm-doc-action-btn:disabled {
            opacity: .45;
            cursor: not-allowed;
        }

    .lm-doc-viewable {
        cursor: pointer;
        color: #047857;
    }

        .lm-doc-viewable:hover {
            text-decoration: underline;
        }

    .lm-download-icon {
        color: #059669;
        font-size: 1.05rem;
    }

        .lm-download-icon:hover {
            color: #047857;
        }


    .lm-doc-address-note {
        margin: -2px 0 14px;
        padding: 9px 12px;
        border: 1px solid #fde68a;
        border-radius: 8px;
        background: #fffbeb;
        color: #854d0e;
        font-size: .8rem;
        line-height: 1.45;
    }

    .lm-doc-subupload {
        padding: 9px 0;
        border-bottom: 1px solid #eef2f1;
    }

    .lm-doc-subupload:last-child {
        border-bottom: 0;
        padding-bottom: 0;
    }

    .lm-doc-subtitle {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        margin-bottom: 5px;
        font-size: .78rem;
        font-weight: 700;
        color: #475569;
    }

    .lm-doc-optional-badge {
        display: inline-flex;
        align-items: center;
        padding: 2px 7px;
        border-radius: 999px;
        font-size: .66rem;
        font-weight: 600;
        color: #64748b;
        background: #f1f5f9;
        white-space: nowrap;
    }

    .lm-doc-mini-selected {
        margin-top: 4px;
        color: #198754;
        font-size: .72rem;
        overflow-wrap: anywhere;
    }

    .lm-doc-card .lm-upload-btn.compact {
        width: 100%;
        margin-top: 5px;
        padding: 7px 8px;
        font-size: .76rem;
    }


    /* Warehouse Category - Status-style green segmented selector */
    .lm-category-selector {
        display: flex;
        align-items: stretch;
        width: 100%;
        max-width: 650px;
        padding: 3px;
        border: 1px solid #d1d5db;
        border-radius: 9px;
        background: #f8fafc;
        overflow: hidden;
    }

    .lm-category-btn {
        flex: 1 1 0;
        border: 0;
        background: transparent;
        color: #374151;
        border-radius: 7px;
        padding: 9px 14px;
        font-size: .88rem;
        font-weight: 600;
        cursor: pointer;
        transition: all .2s ease;
    }

        .lm-category-btn:hover {
            color: #047857;
            background: #ecfdf5;
        }

        .lm-category-btn.active {
            background: #059669;
            color: #ffffff;
            box-shadow: 0 1px 4px rgba(5, 150, 105, .20);
        }

    .lm-category-inline {
        margin-bottom: 4px;
    }

    .lm-approval-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        padding: 4px 10px;
        font-size: .75rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .lm-approval-draft { background: #f3f4f6; color: #4b5563; }
    .lm-approval-pending { background: #fef3c7; color: #92400e; }
    .lm-approval-approved { background: #dcfce7; color: #166534; }
    .lm-approval-rejected { background: #fee2e2; color: #991b1b; }

    .lm-approve-btn {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        border: 0;
        border-radius: 7px;
        padding: 5px 9px;
        background: #198754;
        color: #fff;
        font-size: .76rem;
        font-weight: 700;
        cursor: pointer;
    }

        .lm-approve-btn:disabled {
            opacity: .65;
            cursor: not-allowed;
        }


    .lm-reject-btn {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        border: 0;
        border-radius: 7px;
        padding: 5px 9px;
        background: #dc3545;
        color: #fff;
        font-size: .76rem;
        font-weight: 700;
        cursor: pointer;
    }

        .lm-reject-btn:disabled {
            opacity: .65;
            cursor: not-allowed;
        }

    .lm-doc-company-note {
        margin-bottom: 12px;
        padding: 8px 10px;
        border: 1px solid #dbe7e1;
        border-radius: 8px;
        background: #f7fbf9;
        color: #475569;
        font-size: .78rem;
    }

    .lm-doc-entry {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 3px 0;
        font-size: .76rem;
        border-bottom: 1px solid #f1f5f9;
    }

        .lm-doc-entry:last-child {
            border-bottom: none;
        }

    .lm-doc-entry-company {
        display: inline-block;
        padding: 1px 6px;
        border-radius: 4px;
        font-size: .66rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .lm-doc-entry-company.spic {
        background: #dbeafe;
        color: #1e40af;
    }

    .lm-doc-entry-company.gfl {
        background: #dcfce7;
        color: #166534;
    }

    .lm-doc-entry-name {
        color: #374151;
        font-weight: 500;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 150px;
    }

    .lm-doc-entry-actions {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        margin-left: auto;
        white-space: nowrap;
    }

    @@media (max-width: 991.98px) {
        .lm-doc-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 575.98px) {
        .lm-doc-grid {
            grid-template-columns: 1fr;
        }

        .lm-category-selector {
            max-width: 100%;
        }

        .lm-category-btn {
            padding: 9px 7px;
            font-size: .8rem;
        }
    }

    /* =========================================================
       Logistics list - compact Documents modal
       ========================================================= */

    .lm-doc-modal-open-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        min-width: 78px;
        padding: 6px 10px;
        border: 1px solid #059669;
        border-radius: 7px;
        background: #ecfdf5;
        color: #047857;
        font-size: .76rem;
        font-weight: 700;
        line-height: 1;
        cursor: pointer;
        transition: background .15s ease, border-color .15s ease, transform .15s ease;
        white-space: nowrap;
    }

    .lm-doc-modal-open-btn:hover:not(:disabled) {
        background: #d1fae5;
        border-color: #047857;
        transform: translateY(-1px);
    }

    .lm-doc-modal-open-btn:disabled {
        border-color: #d1d5db;
        background: #f8fafc;
        color: #94a3b8;
        cursor: not-allowed;
        transform: none;
    }

    .lm-doc-count-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 19px;
        height: 19px;
        padding: 0 5px;
        border-radius: 999px;
        background: #059669;
        color: #fff;
        font-size: .65rem;
        font-weight: 800;
    }

    .lm-doc-modal-open-btn:disabled .lm-doc-count-badge {
        background: #cbd5e1;
    }

    .lm-doc-list-modal .modal-dialog {
        max-width: 780px;
    }

    .lm-doc-list-modal .modal-content {
        border: 0;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 18px 50px rgba(15, 23, 42, .22);
    }

    .lm-doc-list-modal .modal-header {
        padding: 15px 18px;
        border-bottom: 1px solid #e5e7eb;
        background: #f8fafc;
    }

    .lm-doc-modal-title-wrap {
        min-width: 0;
    }

    .lm-doc-modal-title {
        margin: 0;
        color: #1f2937;
        font-size: 1rem;
        font-weight: 800;
    }

    .lm-doc-modal-subtitle {
        margin-top: 3px;
        color: #64748b;
        font-size: .76rem;
        overflow-wrap: anywhere;
    }

    .lm-doc-list-modal .modal-body {
        padding: 16px 18px;
        max-height: 60vh;
        overflow-y: auto;
    }

    .lm-doc-modal-table-wrap {
        width: 100%;
        overflow-x: auto;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
    }

    .lm-doc-modal-table {
        width: 100%;
        min-width: 620px;
        margin: 0;
        border-collapse: collapse;
        background: #fff;
    }

    .lm-doc-modal-table th {
        padding: 10px 12px;
        border-bottom: 1px solid #e5e7eb;
        background: #f8fafc;
        color: #64748b;
        font-size: .72rem;
        font-weight: 700;
        text-align: left;
        white-space: nowrap;
    }

    .lm-doc-modal-table td {
        padding: 10px 12px;
        border-bottom: 1px solid #eef2f7;
        color: #374151;
        font-size: .78rem;
        vertical-align: middle;
    }

    .lm-doc-modal-table tbody tr:last-child td {
        border-bottom: 0;
    }

    .lm-doc-modal-type {
        font-weight: 700;
        color: #1f2937;
    }

    .lm-doc-modal-file {
        max-width: 310px;
        color: #475569;
        overflow-wrap: anywhere;
        word-break: break-word;
    }

    .lm-doc-modal-icon-btn {
        width: 32px;
        height: 32px;
        padding: 0;
        border: 1px solid #d1d5db;
        border-radius: 7px;
        background: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: background .15s ease, border-color .15s ease, transform .15s ease;
    }

    .lm-doc-modal-icon-btn.download {
        color: #059669;
    }

    .lm-doc-modal-icon-btn.view {
        color: #2563eb;
    }

    .lm-doc-modal-icon-btn:hover:not(:disabled) {
        background: #f8fafc;
        border-color: currentColor;
        transform: translateY(-1px);
    }

    .lm-doc-modal-icon-btn:disabled {
        opacity: .5;
        cursor: wait;
        transform: none;
    }

    .lm-doc-list-modal .modal-footer {
        padding: 11px 18px;
        border-top: 1px solid #e5e7eb;
        background: #fff;
    }

    .lm-doc-modal-close-btn {
        min-width: 86px;
        padding: 7px 14px;
        border: 1px solid #d1d5db;
        border-radius: 7px;
        background: #fff;
        color: #374151;
        font-size: .8rem;
        font-weight: 700;
        cursor: pointer;
    }

    .lm-doc-modal-close-btn:hover {
        background: #f3f4f6;
    }

    .lm-doc-modal-empty {
        padding: 24px 16px;
        text-align: center;
        color: #64748b;
        font-size: .82rem;
    }

    @@media (max-width: 767.98px) {
        .lm-doc-list-modal .modal-dialog {
            margin: 12px;
        }

        .lm-doc-list-modal .modal-body {
            padding: 12px;
            max-height: 66vh;
        }
    }


    /* =========================================================
       Logistics list - professional alignment (visual only)
       ========================================================= */
    .lm-professional-list { width:100%; min-width:0; margin-top:2px; }
    .lm-professional-list > * { min-width:0; }

    .lm-professional-list table {
        width:100%;
        min-width:1880px;
        margin:0;
        border-collapse:separate;
        border-spacing:0;
        table-layout:auto;
        background:#fff;
        font-size:.82rem;
    }

    .lm-professional-list thead th {
        height:50px;
        padding:0 13px !important;
        vertical-align:middle !important;
        background:#f7f9fb !important;
        color:#64748b !important;
        border-top:0 !important;
        border-bottom:1px solid #dfe5ec !important;
        font-size:.72rem !important;
        font-weight:800 !important;
        letter-spacing:.015em;
        line-height:1.2;
        white-space:nowrap;
    }

    .lm-professional-list tbody td {
        min-height:62px;
        padding:11px 13px !important;
        vertical-align:middle !important;
        color:#334155;
        border-bottom:1px solid #edf1f5 !important;
        background:#fff;
        line-height:1.35;
        white-space:nowrap;
    }

    .lm-professional-list tbody tr { transition:background-color .15s ease; }
    .lm-professional-list tbody tr:hover td { background:#f8fcfa; }

    .lm-col-name      { width:180px; min-width:180px; max-width:180px; }
    .lm-col-code      { width:92px;  min-width:92px; }
    .lm-col-company   { width:118px; min-width:118px; }
    .lm-col-category  { width:105px; min-width:105px; }
    .lm-col-operated  { width:110px; min-width:110px; }
    .lm-col-wh-type   { width:115px; min-width:115px; }
    .lm-col-state     { width:115px; min-width:115px; }
    .lm-col-district  { width:125px; min-width:125px; }
    .lm-col-contact   { width:125px; min-width:125px; }
    .lm-col-status    { width:96px;  min-width:96px; text-align:center; }
    .lm-col-createdby { width:110px; min-width:110px; }
    .lm-col-approval  { width:135px; min-width:135px; text-align:center; }
    .lm-col-remarks   { width:220px; min-width:220px; max-width:220px; }
    .lm-col-createdat { width:108px; min-width:108px; text-align:center; }
    .lm-col-docs      { width:92px;  min-width:92px; text-align:center; }
    .lm-col-pdf       { width:102px; min-width:102px; text-align:center; }
    /* Action width follows the buttons available for the current role. */
    .lm-col-action    { width:1%; min-width:60px; white-space:nowrap; }

    .lm-col-name {
        overflow:hidden;
        text-overflow:ellipsis;
        font-weight:700;
        color:#1f2937 !important;
    }

    /* All columns, including Name and Action, scroll normally. */
    .lm-professional-list thead .lm-col-action,
    .lm-professional-list tbody .lm-col-action {
        position: static !important;
        left: auto !important;
        right: auto !important;
        z-index: auto !important;
        box-shadow: none !important;
    }

    .lm-professional-list thead .lm-col-action {
        background: #f7f9fb !important;
    }

    .lm-professional-list tbody .lm-col-action {
        background: #fff !important;
    }

    .lm-professional-list tbody tr:hover .lm-col-action {
        background: #f8fcfa !important;
    }

    .lm-professional-list .lm-table-code {
        display:inline-flex;
        align-items:center;
        min-height:28px;
        padding:3px 8px;
        border-radius:6px;
        background:#f1f5f9;
        color:#334155;
        font-weight:700;
        line-height:1;
    }

    .lm-remarks-text {
        display:block;
        width:100%;
        max-width:198px;
        overflow:hidden;
        text-overflow:ellipsis;
        white-space:nowrap;
        color:#475569;
        font-size:.76rem;
        line-height:1.35;
    }

    .lm-remarks-empty {
        color:#94a3b8;
        font-size:.76rem;
    }

    .lm-col-remarks:hover .lm-remarks-text { color:#1f2937; }

    .lm-professional-list .status-pill,
    .lm-professional-list .lm-approval-badge {
        min-height:28px;
        display:inline-flex;
        align-items:center;
        justify-content:center;
        padding:4px 10px;
        line-height:1;
    }

    .lm-professional-list .lm-doc-modal-open-btn {
        min-width:76px;
        height:34px;
        padding:0 9px;
        border-radius:8px;
        box-shadow:none;
    }

    .lm-professional-list .lm-company-pdf-actions { gap:6px; min-width:84px; }
    .lm-professional-list .lm-company-pdf-btn {
        width:38px;
        height:34px;
        border-radius:8px;
        box-shadow:none;
    }

    .lm-professional-list .action-icons {
        display:flex;
        align-items:center;
        justify-content:flex-start;
        flex-wrap:nowrap;
        gap:8px;
        min-height:36px;
        white-space:nowrap;
    }

    .lm-professional-list .lm-approve-btn,
    .lm-professional-list .lm-reject-btn {
        height:34px;
        padding:0 11px;
        border-radius:8px;
        font-size:.73rem;
        line-height:1;
        white-space:nowrap;
        box-shadow:none;
    }

    .lm-row-icon-action {
        width:34px;
        height:34px;
        border:1px solid #dfe5ec;
        border-radius:8px;
        background:#fff;
        display:inline-flex !important;
        align-items:center;
        justify-content:center;
        flex:0 0 34px;
        cursor:pointer;
        font-size:1rem;
        transition:background .15s ease,border-color .15s ease,transform .15s ease;
    }

    .lm-row-icon-action:hover { background:#f8fafc; transform:translateY(-1px); }
    .lm-row-icon-action.lm-edit-action { color:#2563eb !important; }
    .lm-row-icon-action.lm-edit-action:hover { border-color:#93c5fd; background:#eff6ff; }
    .lm-row-icon-action.lm-delete-action { color:#dc3545 !important; }
    .lm-row-icon-action.lm-delete-action:hover { border-color:#fca5a5; background:#fef2f2; }

    .lm-professional-list ::-webkit-scrollbar { height:9px; width:9px; }
    .lm-professional-list ::-webkit-scrollbar-track { background:#f1f5f9; border-radius:999px; }
    .lm-professional-list ::-webkit-scrollbar-thumb {
        background:#a8b1bc;
        border:2px solid #f1f5f9;
        border-radius:999px;
    }
    .lm-professional-list ::-webkit-scrollbar-thumb:hover { background:#7d8896; }

    .lm-professional-list .search-box { min-width:215px; }
    .lm-professional-list .filter-select { min-width:118px; }

    @@media (max-width:1199.98px) {
        .lm-professional-list table { min-width:1800px; }
        .lm-col-action { width:1%; min-width:60px; }
    }

    @@media (max-width:767.98px) {
        .lm-professional-list table { min-width:1700px; font-size:.8rem; }
        .lm-professional-list thead th,
        .lm-professional-list tbody td {
            padding-left:10px !important;
            padding-right:10px !important;
        }
        .lm-col-name { width:155px; min-width:155px; max-width:155px; }
    }



    /* =========================================================
       Logistics approval / send-back popup
       Matches the review workflow pattern used by SavedDealerReview.
       ========================================================= */
    .lm-flow-modal .modal-dialog { max-width: 620px; }
    .lm-flow-modal .modal-content {
        border: 0;
        border-radius: 14px;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 20px 60px rgba(15, 23, 42, .24);
    }
    .lm-flow-modal .modal-header {
        padding: 18px 22px 12px;
        border-bottom: 1px solid #eef2f7;
        background: #fff;
        align-items: flex-start;
    }
    .lm-flow-title-wrap { display:flex; align-items:flex-start; gap:12px; min-width:0; }
    .lm-flow-icon {
        width:40px; height:40px; flex:0 0 40px; border-radius:10px;
        display:inline-flex; align-items:center; justify-content:center; font-size:1.05rem;
    }
    .lm-flow-icon.approve { background:#ecfdf5; color:#047857; border:1px solid #a7f3d0; }
    .lm-flow-icon.sendback { background:#fff7ed; color:#c2410c; border:1px solid #fed7aa; }
    .lm-flow-title { margin:0; color:#1f2937; font-size:1.05rem; font-weight:800; }
    .lm-flow-subtitle { margin-top:4px; color:#6b7280; font-size:.78rem; line-height:1.45; }
    .lm-flow-modal .modal-body { padding:18px 22px; }
    .lm-flow-summary {
        display:grid; grid-template-columns:1fr 1fr; gap:8px 18px;
        padding:12px 14px; margin-bottom:16px; background:#f8fafc;
        border:1px solid #e5e7eb; border-radius:9px;
    }
    .lm-flow-summary-item { display:flex; gap:8px; min-width:0; font-size:.78rem; }
    .lm-flow-summary-label { color:#6b7280; min-width:88px; }
    .lm-flow-summary-value { color:#1f2937; font-weight:700; overflow-wrap:anywhere; }
    .lm-flow-label {
        display:flex; justify-content:space-between; gap:10px; align-items:center;
        margin-bottom:7px; color:#374151; font-size:.78rem; font-weight:800;
    }
    .lm-flow-required { color:#dc2626; font-size:.7rem; }
    .lm-flow-textarea {
        width:100%; min-height:92px; padding:10px 12px; border:1px solid #d1d5db;
        border-radius:8px; resize:vertical; outline:none; color:#374151; font-size:.82rem;
    }
    .lm-flow-textarea:focus { border-color:#059669; box-shadow:0 0 0 2px rgba(5,150,105,.09); }
    .lm-flow-textarea.sendback:focus { border-color:#d97706; box-shadow:0 0 0 2px rgba(217,119,6,.09); }
    .lm-flow-meta { display:flex; justify-content:space-between; align-items:center; margin-top:5px; }
    .lm-flow-count { color:#9ca3af; font-size:.68rem; }
    .lm-flow-error { color:#b91c1c; font-size:.75rem; font-weight:600; }
    .lm-flow-note {
        display:flex; align-items:flex-start; gap:8px; margin-top:14px; padding:10px 12px;
        border:1px solid #dbeafe; border-radius:8px; background:#eff6ff;
        color:#475569; font-size:.73rem; line-height:1.45;
    }
    .lm-flow-note.sendback { border-color:#fde68a; background:#fffbeb; }
    .lm-flow-note i { margin-top:1px; color:#2563eb; }
    .lm-flow-note.sendback i { color:#d97706; }
    .lm-flow-modal .modal-footer { padding:12px 22px 18px; border-top:1px solid #eef2f7; gap:9px; }
    .lm-flow-cancel, .lm-flow-confirm {
        min-width:108px; height:38px; padding:0 16px; border-radius:7px;
        display:inline-flex; align-items:center; justify-content:center; gap:7px;
        font-size:.79rem; font-weight:700; cursor:pointer;
    }
    .lm-flow-cancel { background:#fff; color:#4b5563; border:1px solid #d1d5db; }
    .lm-flow-confirm { color:#fff; border:1px solid transparent; }
    .lm-flow-confirm.approve { background:#115e59; border-color:#115e59; }
    .lm-flow-confirm.sendback { background:#d97706; border-color:#d97706; }
    .lm-flow-cancel:disabled, .lm-flow-confirm:disabled { opacity:.6; cursor:not-allowed; }
    .lm-reject-btn { background:#d97706; }
    .lm-reject-btn:hover:not(:disabled) { background:#b45309; }
    @@media (max-width:575.98px) {
        .lm-flow-modal .modal-dialog { margin:12px; }
        .lm-flow-summary { grid-template-columns:1fr; }
        .lm-flow-modal .modal-header, .lm-flow-modal .modal-body, .lm-flow-modal .modal-footer {
            padding-left:16px; padding-right:16px;
        }
    }

</style>

@if (PdfViewMode && PdfViewId > 0)
{
    <LogisticsPdf RouteTab="@PdfViewTab"
                  RouteId="@PdfViewId"
                  Company="@PdfViewCompany" />
}
else
{


<div class="container-fluid py-4 px-0">
    <div class="lm-page-heading-row">
        <h5 class="fw-bold reg-page-heading">Logistics Master</h5>

        @if (CanAccessSapCodeMaster)
        {
            <button type="button"
                    class="lm-sap-code-btn"
                    title="Open SAP Code / PVT Master"
                    @onclick="OpenPvtMaster">
                <i class="bi bi-upc-scan"></i>
                <span>SAP Code</span>
            </button>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert @(_isError ? "alert-danger" : "alert-success") alert-dismissible fade show lm-message" role="alert">
            @_message
            <button type="button" class="btn-close" @onclick="() => _message = null"></button>
        </div>
    }

    <!-- Warehouse now uses ONE entity/table/API.
         WarehouseCategory decides whether the record is PVT WH, C&F WH or Both.
         Rake Point and Port flows remain on their existing APIs. -->
    <div class="tabs-wrapper">
        <div class="tabs-container">
            <div class="tab-item @(ActiveTab == "Warehouse" ? "active" : "")" @onclick="SelectWarehouseTab">
                Warehouse
            </div>
            <div class="tab-item @(ActiveTab == "Port" ? "active" : "")" @onclick="SelectPortTab">
                Rake Point
            </div>
            @if (CanAccessPortTab)
            {
                <div class="tab-item @(ActiveTab == "PortMaster" ? "active" : "")" @onclick="SelectActualPortTab">
                    Port
                </div>
            }
        </div>
    </div>

    <!-- No native <form>. This avoids Blazor's form-name POST issue. -->
    @if (IsPortTab)
    {
        <!-- Existing/old Port functionality moved into the new LogisticsMaster page. -->
        <div>
            <div class="basic-info-card">
                <div class="basic-info-header">
                    <h3 class="basic-info-title">
                        <img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/BasicInfoIcon.svg"
                             class="formicon"
                             alt="icon" /> Port Information
                    </h3>
                </div>

                <div class="row g-3 align-items-end">
                    <div class="col-12 col-md-4">
                        <label class="form-label-custom">Port Name <span class="text-danger">*</span></label>
                        <input @ref="_firstInputRef"
                               type="text"
                               class="form-control-custom w-100 @(_errors.ContainsKey("Name") ? "is-invalid" : "")"
                               placeholder="Enter Port Name"
                               @bind="_form.Name" />
                        @if (_errors.TryGetValue("Name", out var portNameError))
                        {
                            <div class="lm-field-error">@portNameError</div>
                        }
                    </div>

                    <div class="col-12 col-md-4">
                        <label class="form-label-custom">Google Map or Lat/Long URL</label>
                        <input type="text"
                               class="form-control-custom w-100"
                               placeholder="Paste Google Map or Lat/Long URL"
                               @bind="_form.GoogleURL" />
                    </div>

                    <div class="col-12 col-md-4">
                        <label class="form-label-custom">State</label>
                        <select class="form-select-custom w-100"
                                @bind="_form.StateId"
                                @bind:after="OnLocationStateChanged">
                            <option value="0">-- Select State --</option>
                            @foreach (var state in _states)
                            {
                                <option value="@state.Id">@state.StateName</option>
                            }
                        </select>
                    </div>

                    <div class="col-12 col-md-4">
                        <label class="form-label-custom">District</label>
                        <select class="form-select-custom w-100" @bind="_form.DistrictId">
                            <option value="0">-- Select District --</option>
                            @foreach (var district in _filteredDistricts)
                            {
                                <option value="@district.Id">@district.DistrictName</option>
                            }
                        </select>
                    </div>

                    <div class="col-12 col-md-4">
                        <label class="form-label-custom">Status</label>
                        <div class="status-btn-group">
                            <button type="button"
                                    class="btn btn_active @(_form.IsActive ? "active" : "")"
                                    @onclick="() => _form.IsActive = true">
                                Active
                            </button>
                            <button type="button"
                                    class="btn btn_inactive @(!_form.IsActive ? "active" : "")"
                                    @onclick="() => _form.IsActive = false">
                                Inactive
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="lm-save-row">
                <button type="button" class="btn-cancel" @onclick="() => ResetForm()">
                    <i class="bi bi-x"></i> Cancel
                </button>

                @if ((!_isEditing && LoginState.Can(SPIC.Core.Entities.PagePermission.Logistics, "Entry")) ||
                                                                 (_isEditing && LoginState.Can(SPIC.Core.Entities.PagePermission.Logistics, "Update")))
                {
                    <button type="button"
                            class="btn-save"
                            @onclick="HandleSave"
                            disabled="@_isSaving">
                        <i class="bi bi-save"></i>
                        @(_isSaving ? "Saving..." : (_isEditing ? "Update" : "Save"))
                    </button>
                }
            </div>
        </div>
    }
    else
    {
        <div>
            <!-- Basic Information -->
            <div class="basic-info-card">
                <div class="basic-info-header">
                    <h3 class="basic-info-title">
                        <img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/BasicInfoIcon.svg"
                             class="formicon"
                             alt="icon" /> Basic Information
                    </h3>
                </div>

                <div class="row g-4 align-items-center">
                   

                    <div class="col-12 col-md-5">
                        <div class="row g-3 h-100">
                            <div class="col-6">
                                <div class="logo-card spic lm-company-card @(_form.InSpic ? "active" : "")"
                                     @onclick="ToggleSpic">
                                    <div class="card-checkbox">
                                        <i class="bi bi-check-lg"></i>
                                    </div>
                                    <img src="_content/SPIC.MauiBlazorApp.Shared/images/loginimages/logo.png" />
                                    <span>SPIC</span>
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="logo-card green-star lm-company-card @(_form.InGreenStar ? "active" : "")"
                                     @onclick="ToggleGreenStar">
                                    <div class="card-checkbox">
                                        <i class="bi bi-check-lg"></i>
                                    </div>
                                    <img src="_content/SPIC.MauiBlazorApp.Shared/images/loginimages/greensraticon.svg" />
                                    <span>GREEN STAR</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-7">
                        <div class="row g-3">
                            <div class="col-12 col-sm-6">
                                <label class="form-label-custom">State</label>
                                <select class="form-select-custom w-100"
                                        @bind="_form.BasicStateId"
                                        @bind:after="OnBasicStateChanged"
                                        disabled="@_isStateLocked">
                                    <option value="0">-- Select State --</option>
                                    @foreach (var state in _states)
                                    {
                                        <option value="@state.Id">@state.StateName</option>
                                    }
                                </select>
                            </div>

                            <div class="col-12 col-sm-6">
                                <label class="form-label-custom">Region</label>
                                <select class="form-select-custom w-100"
                                        @bind="_form.RegionId"
                                        @bind:after="OnRegionChanged"
                                        disabled="@_isRegionLocked">
                                    <option value="0">-- Select Region --</option>
                                    @foreach (var region in _filteredRegions)
                                    {
                                        <option value="@region.Id">@region.RegionName</option>
                                    }
                                </select>
                            </div>

                            <div class="col-12 col-sm-6">
                                <label class="form-label-custom">HQ</label>
                                <select class="form-select-custom w-100" @bind="_form.HeadquarterId" disabled="@_isHqLocked">
                                    <option value="0">-- Select HQ --</option>
                                    @foreach (var hq in _filteredHeadquarters)
                                    {
                                        <option value="@hq.Id">@hq.HeadquarterName</option>
                                    }
                                </select>
                            </div>

                            <div class="col-12 col-sm-6">
                                <label class="form-label-custom">Status</label>
                                <div class="status-btn-group">
                                    <button type="button"
                                            class="btn btn_active @(_form.IsActive ? "active" : "")"
                                            @onclick="() => SetLogisticsStatus(true)">
                                        Active
                                    </button>
                                    <button type="button"
                                            class="btn btn_inactive @(!_form.IsActive ? "active" : "")"
                                            @onclick="() => SetLogisticsStatus(false)">
                                        Inactive
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label-custom">
                            SAP Code <span class="text-danger">*</span>
                        </label>
                        <select @ref="_firstInputRef"
                                class="form-select-custom w-100 @(_errors.ContainsKey("SapCode") ? "is-invalid" : "")"
                                @bind="_form.SapCode"
                                @bind:after="OnSapCodeChanged">
                            <option value="">-- Select SAP Code --</option>
                            @if (!string.IsNullOrWhiteSpace(_form.SapCode) &&
                                                             !CurrentSapCodeOptions.Any(o => string.Equals(o.Code, _form.SapCode, StringComparison.OrdinalIgnoreCase)))
                            {
                                <option value="@_form.SapCode">@_form.SapCode</option>
                            }
                            @foreach (var opt in CurrentSapCodeOptions)
                            {
                                <option value="@opt.Code">@opt.Code</option>
                            }
                        </select>
                        @if (_errors.TryGetValue("SapCode", out var sapError))
                        {
                            <div class="lm-field-error">@sapError</div>
                        }
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label-custom">
                            Name <span class="text-danger">*</span>
                        </label>
                        <input type="text"
                               class="form-control-custom w-100 @(_errors.ContainsKey("Name") ? "is-invalid" : "")"
                               placeholder="@CurrentNamePlaceholder"
                               @bind="_form.Name" />
                        @if (_errors.TryGetValue("Name", out var nameError))
                        {
                            <div class="lm-field-error">@nameError</div>
                        }
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label-custom">
                            Operated By <span class="text-danger">*</span>
                        </label>
                        <select class="form-select-custom w-100 @(_errors.ContainsKey("OperatedBy") ? "is-invalid" : "")"
                                @bind="_form.OperatedBy">
                            <option value="">-- Select Operated By --</option>
                            @foreach (var option in Enum.GetValues<LogisticsOperatedBy>())
                            {
                                <option value="@option">@GetOperatedByDisplay(option)</option>
                            }
                        </select>
                        @if (_errors.TryGetValue("OperatedBy", out var operatedByError))
                        {
                            <div class="lm-field-error">@operatedByError</div>
                        }
                    </div>

                    <!-- WH Type is applicable to exact PVT WH and Both. Hidden for C&F WH. -->
                    @if (ShowsPvtWarehouseContent)
                    {
                        <div class="col-12 col-md-3">
                            <label class="form-label-custom">
                                WH Type <span class="text-danger">*</span>
                            </label>
                            <select class="form-select-custom w-100 @(_errors.ContainsKey("WarehouseType") ? "is-invalid" : "")"
                                    @bind="_form.WarehouseType">
                                <option value="">-- Select WH Type --</option>
                                @foreach (var option in Enum.GetValues<LogisticsWarehouseType>())
                                {
                                    <option value="@option">@GetWarehouseTypeDisplay(option)</option>
                                }
                            </select>
                            @if (_errors.TryGetValue("WarehouseType", out var typeError))
                            {
                                <div class="lm-field-error">@typeError</div>
                            }
                        </div>
                    }
                     @if (IsWarehouseTab)
                    {
                        <div class="col-12">
                            <div class="lm-category-inline">
                                <label class="form-label-custom">Warehouse Category</label>
                                <div class="lm-category-selector">
                                    <button type="button"
                                            class="lm-category-btn @(IsPvtWarehouseCategory ? "active" : "")"
                                            @onclick="() => SetWarehouseCategory(LogisticsWarehouseCategory.PvtWH)">
                                        PVT WH
                                    </button>
                                    <button type="button"
                                            class="lm-category-btn @(IsCandFWarehouseCategory ? "active" : "")"
                                            @onclick="() => SetWarehouseCategory(LogisticsWarehouseCategory.CandFWH)">
                                        C&amp;F WH
                                    </button>
                                    <button type="button"
                                            class="lm-category-btn @(IsBothWarehouseCategory ? "active" : "")"
                                            @onclick="() => SetWarehouseCategory(LogisticsWarehouseCategory.Both)">
                                        Both
                                    </button>
                                </div>
                              @*   <div class="small text-muted mt-2">
                                    @GetWarehouseCategoryDescription()
                                </div> *@
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Reservation Quantity -->
            @if (IsWarehouseTab)
            {
                <div class="basic-info-card">
                    <div class="basic-info-header">
                        <h3 class="basic-info-title">
                            <i class="bi bi-box-seam me-2"></i> Reservation Quantity
                        </h3>
                    </div>

                    @if (ShowsPvtWarehouseContent)
                    {
                        <div class="mb-3">
                            <div class="small fw-semibold text-success mb-2">PVT WH Reservation</div>
                            <div class="row g-3">
                                @if (_form.InSpic)
                                {
                                    <div class="col-12 col-lg-6">
                                        <div class="lm-reservation-card">
                                            <div class="lm-reservation-title">SPIC Reservation</div>
                                            <div class="row g-3">
                                                <div class="col-12 col-md-6">
                                                    <label class="form-label-custom">Approved Reservation Quantity (MT) <span class="text-danger">*</span></label>
                                                    <input type="number" min="0" step="0.01" class="form-control-custom w-100 @(_errors.ContainsKey("SpicApprovedReservationQuantityMT") ? "is-invalid" : "")"
                                                           @bind="_form.SpicApprovedReservationQuantityMT"
                                                           @bind:after='() => _errors.Remove("SpicApprovedReservationQuantityMT")' />
                                                    @if (_errors.ContainsKey("SpicApprovedReservationQuantityMT"))
                                                    {
                                                        <div class="lm-field-error">@_errors["SpicApprovedReservationQuantityMT"]</div>
                                                    }
                                                </div>
                                                <div class="col-12 col-md-6">
                                                    <label class="form-label-custom">Additional Reservation Quantity(MT) (If any approved by the management) <span class="text-danger">*</span></label>
                                                    <input type="number" min="0" step="0.01" class="form-control-custom w-100 @(_errors.ContainsKey("SpicAdditionalReservationQuantityMT") ? "is-invalid" : "")"
                                                           @bind="_form.SpicAdditionalReservationQuantityMT"
                                                           @bind:after='() => _errors.Remove("SpicAdditionalReservationQuantityMT")' />
                                                    @if (_errors.ContainsKey("SpicAdditionalReservationQuantityMT"))
                                                    {
                                                        <div class="lm-field-error">@_errors["SpicAdditionalReservationQuantityMT"]</div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }

                                @if (_form.InGreenStar)
                                {
                                    <div class="col-12 col-lg-6">
                                        <div class="lm-reservation-card">
                                            <div class="lm-reservation-title">GFL Reservation</div>
                                            <div class="row g-3">
                                                <div class="col-12 col-md-6">
                                                    <label class="form-label-custom">Approved Reservation Quantity (MT) <span class="text-danger">*</span></label>
