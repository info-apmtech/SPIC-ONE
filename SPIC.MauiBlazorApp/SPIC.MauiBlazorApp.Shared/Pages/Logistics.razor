    private async Task EditItem(LogisticsItemDto item)
    {
        _isEditing = true;
        _editingId = item.Id;
        _editingCreatedAt = item.CreatedAt;

        if (IsPortTab)
        {
            _form = NewForm();
            SyncLatitudeLongitudeText();
            _form.Name = item.Name;
            _form.GoogleURL = item.GoogleURL;
            _form.StateId = item.StateId;
            _form.DistrictId = item.DistrictId;
            _form.IsActive = item.IsActive;
            _filteredDistricts = _districts.Where(x => x.StateId == _form.StateId).ToList();
            ClearSelectedDocumentFiles();
            _otherDocumentPaths = new();
            try { await _firstInputRef.FocusAsync(); } catch { }
            return;
        }

        _form = new LogisticsFormModel
        {
            SapCode = IsRakePointTab
                ? (!string.IsNullOrWhiteSpace(item.SAPCode) ? item.SAPCode! : item.RailwayCode ?? "")
                : item.WarehouseCode ?? "",
            Name = item.Name,
            WarehouseCategory = IsWarehouseTab
                ? GetWarehouseCategory(item)
                : LogisticsWarehouseCategory.PvtWH,
            InSpic = item.InSpic ?? true,
            InGreenStar = item.InGreenStar ?? true,
            BasicStateId = item.BasicStateId ?? 0,
            RegionId = item.RegionId ?? 0,
            HeadquarterId = item.HeadquarterId ?? 0,
            OperatedBy = item.OperatedBy,
            WarehouseType = IsWarehouseTab && GetWarehouseCategory(item) == LogisticsWarehouseCategory.PvtWH
                ? item.WarehouseType
                : null,
            GoogleURL = item.GoogleURL,
            Latitude = item.Latitude,
            Longitude = item.Longitude,
            DoorNo = IsRakePointTab ? "" : item.DoorNo ?? "",
            Street = IsRakePointTab ? "" : item.Street ?? "",
            SubVillage = item.SubVillage ?? "",
            PinCode = item.PinCode ?? "",
            Village = item.Village ?? "",
            Block = item.Block ?? "",
            Taluk = item.Taluk ?? "",
            StateId = item.StateId,
            DistrictId = item.DistrictId,
            ContactNumber = item.ContactNumber ?? "",

            SpicApprovedReservationQuantityMT = item.SpicApprovedReservationQuantityMT,
            SpicAdditionalReservationQuantityMT = item.SpicAdditionalReservationQuantityMT,
            GflApprovedReservationQuantityMT = item.GflApprovedReservationQuantityMT,
            GflAdditionalReservationQuantityMT = item.GflAdditionalReservationQuantityMT,
            GflReservationQuantityMT = item.GflReservationQuantityMT,
            GflAdditionalReservationQuantityLitres = item.GflAdditionalReservationQuantityLitres,

            GstDocumentPath = item.GstDocumentPath,
            InsuranceDocumentPath = item.InsuranceDocumentPath,
            FertilizerLicenseDocumentPath = item.FertilizerLicenseDocumentPath,
            OtherDocumentPathsJson = item.OtherDocumentPathsJson,
            IsActive = item.IsActive
        };

        _otherDocumentPaths = DeserializeDocumentPaths(_form.OtherDocumentPathsJson);
        ClearSelectedDocumentFiles();

        _filteredRegions = _regions.Where(x => x.StateId == _form.BasicStateId).ToList();
        _filteredHeadquarters = _headquarters.Where(x => x.RegionId == _form.RegionId).ToList();
        _filteredDistricts = _districts.Where(x => x.StateId == _form.StateId).ToList();

        if (_form.Latitude.HasValue && _form.Longitude.HasValue)
            await TriggerMapUpdate(_form.Latitude.Value, _form.Longitude.Value);
        SyncLatitudeLongitudeText();

        try { await _firstInputRef.FocusAsync(); } catch { }
    }

