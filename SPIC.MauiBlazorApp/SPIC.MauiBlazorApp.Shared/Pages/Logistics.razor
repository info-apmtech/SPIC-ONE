                                    </label>
                                    @if (_gstDocumentFile != null || !string.IsNullOrWhiteSpace(_form.GstDocumentPath))
                                    {
                                        <button type="button" class="lm-doc-action-btn lm-doc-icon-btn view" aria-label="View SPIC GST Document" title="View SPIC GST Document" @onclick="() => ViewSelectedOrSavedDocument(_gstDocumentFile, _form.GstDocumentPath)">
                                            <i class="bi bi-eye"></i>
                                        </button>
