    private bool Validate()
    {
        _errors.Clear();

        if (IsPortTab)
        {
            if (string.IsNullOrWhiteSpace(_form.Name))
                _errors["Name"] = "Port name is required.";

            return _errors.Count == 0;
        }

        if (string.IsNullOrWhiteSpace(_form.SapCode))
            _errors["SapCode"] = "SAP Code is required.";

        if (string.IsNullOrWhiteSpace(_form.Name))
            _errors["Name"] = $"{ActiveTabDisplayName} name is required.";

        if (!_form.OperatedBy.HasValue)
            _errors["OperatedBy"] = "Operated By is required.";

        if (IsPvtWarehouseCategory && !_form.WarehouseType.HasValue)
            _errors["WarehouseType"] = "WH Type is required for PVT WH.";

        // Exact PVT WH: documents are required only when Status = Active.
        if (IsPvtWarehouseCategory && _form.IsActive)
        {
            if (string.IsNullOrWhiteSpace(_form.GstDocumentPath) && _gstDocumentFile == null)
                _errors["GstDocument"] = "GST document is required for Active PVT WH.";

            if (string.IsNullOrWhiteSpace(_form.InsuranceDocumentPath) && _insuranceDocumentFile == null)
                _errors["InsuranceDocument"] = "Insurance document is required for Active PVT WH.";

            if (string.IsNullOrWhiteSpace(_form.FertilizerLicenseDocumentPath) && _fertilizerLicenseDocumentFile == null)
                _errors["FertilizerLicenseDocument"] = "Fertilizer License document is required for Active PVT WH.";
        }

        // Preserve the previous Both-category document requirement.
        if (IsBothWarehouseCategory)
        {
            if (string.IsNullOrWhiteSpace(_form.GstDocumentPath) && _gstDocumentFile == null)
                _errors["GstDocument"] = "GST document is required for Both category.";

            if (string.IsNullOrWhiteSpace(_form.InsuranceDocumentPath) && _insuranceDocumentFile == null)
                _errors["InsuranceDocument"] = "Insurance document is required for Both category.";

            if (string.IsNullOrWhiteSpace(_form.FertilizerLicenseDocumentPath) && _fertilizerLicenseDocumentFile == null)
                _errors["FertilizerLicenseDocument"] = "Fertilizer License document is required for Both category.";
        }

        return _errors.Count == 0;
    }

    private async Task HandleSave()
    {
        if (!Validate()) return;

        try
        {
            _isSaving = true;
            _message = null;
            _editingCreatedAt ??= DateTime.Now;

            HttpResponseMessage response = ActiveTab switch
            {
                "Warehouse" => await SaveWarehouse(),
                "Port" => await SaveRakePoint(),
                "PortMaster" => await SavePort(),
                _ => throw new InvalidOperationException("Invalid Logistics Master tab.")
            };

            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                ShowMessage($"Save failed: {body}", true);
                return;
            }

            if (HasFilesWaitingForUpload)
            {
                var recordId = _editingId ?? await ReadCreatedIdAsync(response);
                if (recordId <= 0)
                {
                    ShowMessage("Record saved, but the new record id was not returned. Documents were not uploaded.", true);
                    await LoadData();
                    return;
                }

                _isUploadingDocuments = true;
                var uploadOk = await UploadSelectedDocumentsAsync(recordId);
                _isUploadingDocuments = false;

                if (!uploadOk)
                {
                    ShowMessage($"{ActiveTabDisplayName} saved, but one or more documents failed to upload. Please edit the record and upload again.", true);
                    await LoadData();
                    return;
                }

                // Persist the uploaded file paths after the physical files are saved.
                HttpResponseMessage documentPathUpdate = ActiveTab switch
                {
                    "Warehouse" => await SaveWarehouse(forceUpdate: true, forcedId: recordId),
                    "Port" => await SaveRakePoint(forceUpdate: true, forcedId: recordId),
                    "PortMaster" => await SavePort(forceUpdate: true, forcedId: recordId),
                    _ => throw new InvalidOperationException("Invalid Logistics Master tab.")
                };

                if (!documentPathUpdate.IsSuccessStatusCode)
                {
                    var body = await documentPathUpdate.Content.ReadAsStringAsync();
                    ShowMessage($"Documents uploaded, but saving document paths failed: {body}", true);
                    await LoadData();
                    return;
                }
            }

            ShowMessage(_isEditing
                ? $"{ActiveTabDisplayName} updated successfully."
                : $"{ActiveTabDisplayName} created successfully.", false);

            ResetForm(clearMessage: false);
            await LoadData();
        }
        catch (Exception ex)
        {
            ShowMessage($"Error: {ex.Message}", true);
        }
        finally
        {
            _isSaving = false;
            _isUploadingDocuments = false;
        }
    }

    private async Task<HttpResponseMessage> SaveWarehouse(bool forceUpdate = false, int? forcedId = null)
    {
        var now = DateTime.Now;
        var category = CurrentWarehouseCategory;
        var includesPvt = category is LogisticsWarehouseCategory.PvtWH or LogisticsWarehouseCategory.Both;
        var includesCandF = category is LogisticsWarehouseCategory.CandFWH or LogisticsWarehouseCategory.Both;

        var payload = new WarehouseSaveModel
        {
            Id = forcedId ?? _editingId ?? 0,
            Name = _form.Name.Trim(),
            WarehouseCode = _form.SapCode.Trim(),
            WarehouseCategory = category,

            InSpic = _form.InSpic,
            InGreenStar = _form.InGreenStar,
            BasicStateId = ToNullableId(_form.BasicStateId),
            RegionId = ToNullableId(_form.RegionId),
            HeadquarterId = ToNullableId(_form.HeadquarterId),
            OperatedBy = _form.OperatedBy,

            // WH Type applies only to exact PVT WH.
            WarehouseType = category == LogisticsWarehouseCategory.PvtWH
                ? _form.WarehouseType
                : null,

            GoogleURL = NullIfWhiteSpace(_form.GoogleURL),
            Latitude = _form.Latitude,
            Longitude = _form.Longitude,
            DoorNo = NullIfWhiteSpace(_form.DoorNo),
            Street = NullIfWhiteSpace(_form.Street),
            SubVillage = NullIfWhiteSpace(_form.SubVillage),
            PinCode = NullIfWhiteSpace(_form.PinCode),
            Village = NullIfWhiteSpace(_form.Village),
            Block = NullIfWhiteSpace(_form.Block),
            Taluk = NullIfWhiteSpace(_form.Taluk),
            StateId = _form.StateId,
            DistrictId = _form.DistrictId,
            ContactNumber = NullIfWhiteSpace(_form.ContactNumber),

            // PVT fields are saved for PVT and Both; otherwise null.
            SpicApprovedReservationQuantityMT = includesPvt ? _form.SpicApprovedReservationQuantityMT : null,
            SpicAdditionalReservationQuantityMT = includesPvt ? _form.SpicAdditionalReservationQuantityMT : null,
            GflApprovedReservationQuantityMT = includesPvt ? _form.GflApprovedReservationQuantityMT : null,
            GflAdditionalReservationQuantityMT = includesPvt ? _form.GflAdditionalReservationQuantityMT : null,

            // C&F fields are saved for C&F and Both; otherwise null.
            GflReservationQuantityMT = includesCandF ? _form.GflReservationQuantityMT : null,
            GflAdditionalReservationQuantityLitres = includesCandF ? _form.GflAdditionalReservationQuantityLitres : null,

            // PVT mandatory documents also apply when category = Both.
            GstDocumentPath = includesPvt ? NullIfWhiteSpace(_form.GstDocumentPath) : null,
            InsuranceDocumentPath = includesPvt ? NullIfWhiteSpace(_form.InsuranceDocumentPath) : null,
            FertilizerLicenseDocumentPath = includesPvt ? NullIfWhiteSpace(_form.FertilizerLicenseDocumentPath) : null,

            // Optional Other Documents are shared by every Warehouse category.
            OtherDocumentPathsJson = SerializeDocumentPaths(_otherDocumentPaths),

            IsActive = _form.IsActive,
            CreatedAt = _editingCreatedAt ?? now,
            UpdatedAt = now,
            UpdatedBy = _currentUserId ?? "current-user"
        };

        var updateId = forcedId ?? _editingId;
        return (forceUpdate || (_isEditing && updateId.HasValue)) && updateId.HasValue
            ? await Http.PutAsJsonAsync($"api/Warehouse/{updateId.Value}", payload)
            : await Http.PostAsJsonAsync("api/Warehouse", payload);
    }

