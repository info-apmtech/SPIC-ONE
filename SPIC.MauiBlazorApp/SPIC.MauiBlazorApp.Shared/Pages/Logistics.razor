    <!-- Preserve old CRUD/list functionality under the new Register-style form. -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="metric-card bg-blue-light">
                <div class="metric-header">
                    <h4 class="metric-title">Total @ActiveTabDisplayName</h4>
                </div>
                <div class="metric-val">@CurrentAllItems.Count</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="metric-card bg-mint-light">
                <div class="metric-header">
                    <h4 class="metric-title">Active</h4>
                </div>
                <div class="metric-val">@CurrentAllItems.Count(x => x.IsActive)</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="metric-card bg-gray-light">
                <div class="metric-header">
                    <h4 class="metric-title">Inactive</h4>
                </div>
                <div class="metric-val">@CurrentAllItems.Count(x => !x.IsActive)</div>
            </div>
        </div>
    </div>

    <SpicDataTable Items="_filteredItems"
                   IsLoading="_isLoading"
                   Title="@($"Existing {ActiveTabDisplayName}")"
                   FileName="@CurrentFileName"
                   ExportColumns="GetExportColumns()"
                   SearchText="@_searchText">

        <FilterControls>
            <div class="search-box">
                <i class="bi bi-search"></i>
                <input type="text"
                       placeholder="Search @ActiveTabDisplayName.ToLowerInvariant()..."
                       @bind="_searchText"
                       @bind:event="oninput"
                       @bind:after="StateHasChanged" />
            </div>

            <select class="filter-select" @bind="_statusFilter" @bind:after="ApplyFilter">
                <option value="All">All Status</option>
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
            </select>
        </FilterControls>

        <TableHeader>
            @if (IsPortTab)
            {
                <th>Port Name</th>
                <th>State</th>
                <th>District</th>
                <th>Status</th>
                <th>Created At</th>
                @if (LoginState.Can(SPIC.Core.Entities.PagePermission.Logistics, "Update") || CanDeleteLogistics)
                {
                    <th>Action</th>
                }
            }
            else
            {
                <th>Name</th>
                <th>SAP Code</th>
                @if (IsWarehouseTab)
                {
                    <th>Category</th>
                }
                <th>Operated By</th>
                @if (ShowsPvtWarehouseContent)
                {
                    <th>WH Type</th>
                }
                <th>State</th>
                <th>District</th>
                <th>@CurrentContactLabel</th>
                <th>Status</th>
                <th>Created By</th>
                <th>Approval Status</th>
                <th>Created At</th>
                @if (IsWarehouseTab)
                {
                    <th>Docs</th>
                }
                @if (CanShowLogisticsActionColumn)
                {
                    <th>Action</th>
                }
            }
        </TableHeader>

        <TableRow Context="item">
            @if (IsPortTab)
            {
                <td>@item.Name</td>
                <td>@GetStateName(item.StateId)</td>
                <td>@GetDistrictName(item.DistrictId)</td>
                <td>
                    <span class="status-pill @(item.IsActive ? "status-active" : "status-inactive")"
                          style="cursor:pointer"
                          @onclick="() => ToggleStatus(item)">
                        @(item.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td>@item.CreatedAt.ToString("yyyy-MM-dd")</td>
                @if (LoginState.Can(SPIC.Core.Entities.PagePermission.Logistics, "Update") || CanDeleteLogistics)
                {
                    <td>
                        <div class="action-icons">
                            @if (CanDeleteLogistics)
                            {
                                <i class="bi bi-trash icon-del" @onclick="() => DeleteItem(item)"></i>
                            }
                            @if (LoginState.Can(SPIC.Core.Entities.PagePermission.Logistics, "Update"))
                            {
                                <i class="bi bi-pencil-square icon-edit" @onclick="() => EditItem(item)"></i>
                            }
                        </div>
                    </td>
                }
            }
            else
            {
                <td>@item.Name</td>
                <td><span class="lm-table-code">@GetDisplayCode(item)</span></td>
                @if (IsWarehouseTab)
                {
                    <td>@GetWarehouseCategoryDisplay(GetWarehouseCategory(item))</td>
                }
                <td>@GetOperatedByDisplay(item.OperatedBy)</td>
                @if (ShowsPvtWarehouseContent)
                {
                    <td>@(GetWarehouseCategory(item) is LogisticsWarehouseCategory.PvtWH or LogisticsWarehouseCategory.Both ? GetWarehouseTypeDisplay(item.WarehouseType) : "")</td>
                }
                <td>@GetStateName(item.StateId)</td>
                <td>@GetDistrictName(item.DistrictId)</td>
                <td>@item.ContactNumber</td>
                <td>
                    <span class="status-pill @(item.IsActive ? "status-active" : "status-inactive")"
                          style="cursor:pointer"
                          @onclick="() => ToggleStatus(item)">
                        @(item.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td>@GetCreatedByDisplay(item)</td>
                <td>
                    <span class="lm-approval-badge @GetApprovalBadgeClass(item)">
                        @GetApprovalStatus(item)
                    </span>
                </td>
                <td>@item.CreatedAt.ToString("yyyy-MM-dd")</td>
                @if (IsWarehouseTab)
                {
                    <td>
                        <div class="action-icons">
                            <i class="bi @(_isDownloadingDocuments ? "bi-hourglass-split" : "bi-download") lm-download-icon"
                               title="Download Documents"
                               style="cursor:pointer"
                               @onclick="() => DownloadWarehouseDocuments(item)"></i>
                        </div>
                    </td>
                }
                @if (CanShowLogisticsActionColumn)
                {
                    <td>
                        <div class="action-icons">
                            @if (CanApprove(item))
                            {
                                <button type="button"
                                        class="lm-approve-btn"
                                        @onclick="() => ApproveItem(item)"
                                        disabled="@(_approvingId == item.Id || _rejectingId == item.Id)">
                                    <i class="bi bi-check-circle"></i>
                                    @(_approvingId == item.Id ? "Approving..." : GetApproveButtonText(item))
                                </button>

                                <button type="button"
                                        class="lm-reject-btn"
                                        @onclick="() => OpenRejectModal(item)"
                                        disabled="@(_approvingId == item.Id || _rejectingId == item.Id)">
                                    <i class="bi bi-x-circle"></i>
                                    Reject
                                </button>
                            }
                            @if (CanDeleteLogistics)
                            {
                                <i class="bi bi-trash icon-del" @onclick="() => DeleteItem(item)"></i>
                            }
                            @if (LoginState.Can(SPIC.Core.Entities.PagePermission.Logistics, "Update"))
                            {
                                <i class="bi bi-pencil-square icon-edit" @onclick="() => EditItem(item)"></i>
                            }
                        </div>
                    </td>
                }
            }
        </TableRow>
    </SpicDataTable>
</div>

@if (_showDeleteConfirm)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Delete</h5>
                    <button type="button" class="btn-close" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete <strong>@_deleteTarget?.Name</strong>?</p>
                    <p class="text-muted mb-0">This action cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelDelete">Cancel</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmDelete" disabled="@_isDeleting">
                        @(_isDeleting ? "Deleting..." : "Delete")
                    </button>
                </div>
            </div>
        </div>
    </div>
}


@if (_showRejectModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @(IsWarehouseTab ? "Confirm Reject & Delete" : "Reject Logistics Request")
                    </h5>
                    <button type="button" class="btn-close" @onclick="CancelReject"></button>
                </div>

                <div class="modal-body">
                    <div class="mb-2">
                        Rejecting: <strong>@_rejectTarget?.Name</strong>
                    </div>

                    @if (IsWarehouseTab)
                    {
                        <div class="alert alert-danger py-2 px-3 mb-3" role="alert">
                            <div class="fw-semibold mb-1">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                This Warehouse will be permanently deleted.
                            </div>
                            <div class="small">
                                If you continue with Reject &amp; Delete, the saved Warehouse details for this row will be removed and this action cannot be undone.
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="small text-muted mb-3">
                            Please enter the rejection reason. The current workflow stage will be marked as rejected.
                        </div>
                    }

                    <label class="form-label-custom">Rejection Remarks <span class="text-danger">*</span></label>
                    <textarea class="form-control"
                              rows="4"
                              maxlength="500"
                              placeholder="Enter rejection reason"
                              @bind="_rejectRemarks"></textarea>

                    @if (!string.IsNullOrWhiteSpace(_rejectRemarksError))
                    {
                        <div class="lm-field-error">@_rejectRemarksError</div>
                    }
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            @onclick="CancelReject"
                            disabled="@_rejectingId.HasValue">
                        Cancel
                    </button>
                    <button type="button"
                            class="btn btn-danger"
                            @onclick="RejectItem"
                            disabled="@_rejectingId.HasValue">
                        <i class="bi bi-x-circle me-1"></i>
                        @(_rejectingId.HasValue
                            ? (IsWarehouseTab ? "Rejecting & Deleting..." : "Rejecting...")
                            : (IsWarehouseTab ? "Reject & Delete" : "Reject"))
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    // Warehouse is now one tab and one entity/table/API.
    // WarehouseCategory decides whether PVT, C&F or Both-specific content is shown/saved.
    private string ActiveTab { get; set; } = "Warehouse";

    private bool IsWarehouseTab => ActiveTab == "Warehouse";
    private bool IsRakePointTab => ActiveTab == "Port";
    private bool IsPortTab => ActiveTab == "PortMaster";

    private LogisticsWarehouseCategory CurrentWarehouseCategory =>
        _form.WarehouseCategory ?? LogisticsWarehouseCategory.PvtWH;

    private bool IsPvtWarehouseCategory =>
        IsWarehouseTab && CurrentWarehouseCategory == LogisticsWarehouseCategory.PvtWH;

    private bool IsCandFWarehouseCategory =>
        IsWarehouseTab && CurrentWarehouseCategory == LogisticsWarehouseCategory.CandFWH;

    private bool IsBothWarehouseCategory =>
        IsWarehouseTab && CurrentWarehouseCategory == LogisticsWarehouseCategory.Both;

    private bool ShowsPvtWarehouseContent =>
        IsWarehouseTab && (IsPvtWarehouseCategory || IsBothWarehouseCategory);

    private bool ShowsCandFWarehouseContent =>
        IsWarehouseTab && (IsCandFWarehouseCategory || IsBothWarehouseCategory);


    // Preserve the existing Active-PVT rule and existing Both-category rule for GST / License.
    // Insurance is handled separately below and is mandatory for the applicable flow.
    private bool ArePvtMatrixDocumentsRequired =>
        IsBothWarehouseCategory || (IsPvtWarehouseCategory && _form.IsActive);

    // PVT WH / Both use company-specific insurance based on the selected company cards.
    private bool RequiresCompanySpecificInsurance =>
        IsWarehouseTab && (IsPvtWarehouseCategory || IsBothWarehouseCategory);

    // C&F WH keeps its existing single insurance upload as mandatory. Rake Point insurance is optional.
    private bool RequiresGenericInsurance =>
        IsCandFWarehouseCategory;



    // Excel reference adds GST + Fertilizer License for C&F.
    // Keep the same Active/Inactive behaviour used by PVT WH.
    private bool AreCandFDocumentsRequired =>
        IsCandFWarehouseCategory && _form.IsActive;

    private string? CurrentInsuranceDocumentPath =>
        IsRakePointTab ? _rakePointInsuranceDocumentPath : _form.InsuranceDocumentPath;

    private IEnumerable<string> VisibleOtherDocumentPaths =>
        _otherDocumentPaths.Where(path => !IsMatrixSupplementalDocumentPath(path));

    private bool HasTradingDocument =>
        !string.IsNullOrWhiteSpace(_tradingDocumentPath) || _tradingDocumentFile != null;

    private bool HasUploadedTradingDocument =>
        !string.IsNullOrWhiteSpace(_tradingDocumentPath) && _tradingDocumentFile == null;

    private bool HasInsuranceDocument =>
        !string.IsNullOrWhiteSpace(CurrentInsuranceDocumentPath) || _insuranceDocumentFile != null;

    private bool HasUploadedInsuranceDocument =>
        !string.IsNullOrWhiteSpace(CurrentInsuranceDocumentPath) && _insuranceDocumentFile == null;

    private bool HasOtherDocuments =>
        VisibleOtherDocumentPaths.Any() || _otherDocumentFiles.Count > 0;

    private bool HasUploadedOtherDocuments =>
        VisibleOtherDocumentPaths.Any();

    // Pure C&F hides WH Type. PVT, Both and Rake Point keep it visible.
    private bool IsCandFOnlyWarehouse => IsWarehouseTab && IsCandFWarehouseCategory;

    private string CurrentContactLabel => IsWarehouseTab
        ? CurrentWarehouseCategory switch
        {
            LogisticsWarehouseCategory.CandFWH => "C&F Operator Contact No",
            LogisticsWarehouseCategory.Both => "Contact No / C&F Operator Contact No",
