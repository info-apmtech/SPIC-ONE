    private async Task DownloadSingleDocument(string? path)
    {
        if (string.IsNullOrWhiteSpace(path)) return;

        // Track the exact document being downloaded so only that row/icon shows progress.
        // If the same document is already downloading, ignore duplicate clicks.
        if (!_downloadingDocumentPaths.Add(path))
            return;

        _isDownloadingDocuments = true;
        StateHasChanged();
        try
        {
            var bytes = await Http.GetByteArrayAsync(BuildLogisticsFileUrl("download", path, includeToken: false));
            var base64 = Convert.ToBase64String(bytes);
            await JS.InvokeVoidAsync("downloadFileFromBytes", GetFileName(path), GetLogisticsContentType(path), base64);
        }
        catch (Exception ex)
        {
            ShowMessage($"Failed to download document: {ex.Message}", true);
        }
        finally
        {
            _downloadingDocumentPaths.Remove(path);
            _isDownloadingDocuments = _downloadingDocumentPaths.Count > 0;
            StateHasChanged();
        }
    }

    private async Task ViewSelectedOrSavedDocument(IBrowserFile? selectedFile, string? savedPath)
    {
        if (selectedFile != null)
        {
            await ViewSelectedDocument(selectedFile);
            return;
        }

        await ViewLogisticsDocument(savedPath);
    }

    private async Task ViewSelectedDocument(IBrowserFile? file)
    {
        if (file == null) return;

        try
        {
            // Match the existing 10 MB upload limit and preview the local selection
            // without changing its upload state or the saved document path.
            await using var stream = file.OpenReadStream(10 * 1024 * 1024);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);

            var contentType = string.IsNullOrWhiteSpace(file.ContentType)
                ? GetLogisticsContentType(file.Name)
                : file.ContentType;
            var base64 = Convert.ToBase64String(memoryStream.ToArray());
            var dataUrl = $"data:{contentType};base64,{base64}";

            await JS.InvokeVoidAsync("window.open", dataUrl, "_blank");
        }
        catch (Exception ex)
        {
            ShowMessage($"Failed to view selected document: {ex.Message}", true);
        }
    }

    private async Task ViewLogisticsDocument(string? path)
    {
        if (string.IsNullOrWhiteSpace(path)) return;

        try
        {
            // Open the existing view endpoint in a new tab. Keep the current backend/API flow.
            // If LoginState.Token is not populated in this component, use the same session token
            // already used by the page so View does not silently open an unauthorized response.
            var url = BuildLogisticsFileUrl("view", path, includeToken: true);

            if (string.IsNullOrWhiteSpace(LoginState.Token) && !url.Contains("access_token=", StringComparison.OrdinalIgnoreCase))
            {
                var token = await JS.InvokeAsync<string>("sessionStorage.getItem", "jwt_token");
                if (!string.IsNullOrWhiteSpace(token))
                {
                    var rawToken = token.StartsWith("Bearer ", StringComparison.OrdinalIgnoreCase)
                        ? token["Bearer ".Length..]
                        : token;
                    var separator = url.Contains('?') ? "&" : "?";
                    url += $"{separator}access_token={Uri.EscapeDataString(rawToken)}";
                }
            }

            await JS.InvokeVoidAsync("window.open", url, "_blank");
        }
        catch (Exception ex)
        {
            ShowMessage($"Failed to view document: {ex.Message}", true);
        }
    }

    private async Task DownloadWarehouseDocuments(LogisticsItemDto item)
    {
        var paths = GetWarehouseDocumentPaths(item);
        if (paths.Count == 0)
        {
            ShowMessage("No documents are available for this warehouse.", true);
            return;
        }

        _isDownloadingDocuments = true;
        StateHasChanged();
        try
        {
            foreach (var path in paths)
            {
                var bytes = await Http.GetByteArrayAsync(BuildLogisticsFileUrl("download", path, includeToken: false));
                var base64 = Convert.ToBase64String(bytes);
                await JS.InvokeVoidAsync("downloadFileFromBytes", GetFileName(path), GetLogisticsContentType(path), base64);
            }
            ShowMessage("Warehouse documents downloaded successfully.", false);
        }
        catch (Exception ex)
        {
            ShowMessage($"Failed to download warehouse documents: {ex.Message}", true);
        }
        finally
        {
            _isDownloadingDocuments = false;
        }
    }

    private List<string> GetWarehouseDocumentPaths(LogisticsItemDto item)
    {
        var paths = new List<string>();
        AddDocumentPath(paths, item.GstDocumentPath);
        AddDocumentPath(paths, item.InsuranceDocumentPath);
        AddDocumentPath(paths, item.FertilizerLicenseDocumentPath);
        foreach (var path in DeserializeDocumentPaths(item.OtherDocumentPathsJson))
            AddDocumentPath(paths, path);
        return paths;
    }

    private static void AddDocumentPath(List<string> paths, string? path)
    {
        if (!string.IsNullOrWhiteSpace(path) && !paths.Contains(path, StringComparer.OrdinalIgnoreCase))
            paths.Add(path);
    }

    private static string ToLogisticsRelativePath(string path)
    {
        var normalized = (path ?? string.Empty).Replace('\\', '/').TrimStart('/');
        if (normalized.StartsWith("uploads/", StringComparison.OrdinalIgnoreCase))
            normalized = normalized["uploads/".Length..];
        return normalized;
    }

    private string BuildLogisticsFileUrl(string action, string path, bool includeToken)
    {
        var baseUrl = Http.BaseAddress?.ToString().TrimEnd('/') ?? "";
        var relative = ToLogisticsRelativePath(path);
        var url = $"{baseUrl}/api/LogisticsFile/{action}/{relative}";

        if (includeToken)
        {
            var token = LoginState.Token;
            if (!string.IsNullOrWhiteSpace(token))
            {
                var rawToken = token.StartsWith("Bearer ", StringComparison.OrdinalIgnoreCase)
                    ? token["Bearer ".Length..]
                    : token;
                url += $"?access_token={Uri.EscapeDataString(rawToken)}";
            }
        }

        return url;
    }

    private static string GetLogisticsContentType(string path)
    {
        var ext = System.IO.Path.GetExtension(path).ToLowerInvariant();
        return ext switch
        {
            ".pdf" => "application/pdf",
            ".jpg" or ".jpeg" => "image/jpeg",
            ".png" => "image/png",
            ".webp" => "image/webp",
            ".doc" => "application/msword",
            ".docx" => "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            ".xls" => "application/vnd.ms-excel",
            ".xlsx" => "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            _ => "application/octet-stream"
        };
    }

