                                            <i class="bi bi-check-circle-fill me-1"></i>@GetFileName(_form.GstDocumentPath)
                                        </div>
                                    }
                                    @if (_gstDocumentFile != null)
                                    {
                                        <div class="lm-doc-selected">
                                            <i class="bi bi-paperclip me-1"></i>@_gstDocumentFile.Name
                                        </div>
                                    }
