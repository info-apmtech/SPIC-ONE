    private string? FindPathByDocumentType(string documentType)
    {
        var token = $"/{documentType.Trim().ToLowerInvariant()}/";
        return _otherDocumentPaths.FirstOrDefault(path =>
            (path ?? string.Empty)
                .Replace('\\', '/')
                .ToLowerInvariant()
                .Contains(token));
    }

    private static bool IsMatrixSupplementalDocumentPath(string? path)
    {
        if (string.IsNullOrWhiteSpace(path))
            return false;

        var normalized = path.Replace('\\', '/').ToLowerInvariant();

        return normalized.Contains("/gst_gfl/") ||
               normalized.Contains("/gst_trading/") ||
               normalized.Contains("/fertilizerlicense_gfl/") ||
               normalized.Contains("/insurance/") ||
               normalized.Contains("/insurance_gfl/") ||
               normalized.Contains("/insurance_spic/");
    }

    private async Task<string> UploadLogisticsFileAsync(string entityType, int recordId, string documentType, IBrowserFile file)
    {
        using var content = new MultipartFormDataContent();
        await using var stream = file.OpenReadStream(10 * 1024 * 1024);
        using var fileContent = new StreamContent(stream);
        fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(
            string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType);
        content.Add(fileContent, "file", file.Name);

        var response = await Http.PostAsync($"api/LogisticsFile/upload/{entityType}/{recordId}/{documentType}", content);
        if (!response.IsSuccessStatusCode)
        {
            var body = await response.Content.ReadAsStringAsync();
            throw new InvalidOperationException($"{documentType} upload failed: {body}");
        }

        var result = await response.Content.ReadFromJsonAsync<LogisticsFileUploadResponse>();
        if (string.IsNullOrWhiteSpace(result?.FilePath))
            throw new InvalidOperationException($"{documentType} upload did not return a file path.");

        return result.FilePath;
    }

    private static async Task<int> ReadCreatedIdAsync(HttpResponseMessage response)
    {
        try
        {
            var body = await response.Content.ReadFromJsonAsync<CreateLogisticsResponse>();
            return body?.Data?.Id ?? 0;
        }
        catch
        {
            return 0;
        }
    }

    private static string? SerializeDocumentPaths(List<string> paths) =>
        paths.Count == 0 ? null : JsonSerializer.Serialize(paths);

    private static List<string> DeserializeDocumentPaths(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return new();
        try
        {
            return JsonSerializer.Deserialize<List<string>>(json)
                ?.Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList() ?? new();
        }
        catch
        {
            return new();
        }
    }

    private static string GetFileName(string? path)
    {
        if (string.IsNullOrWhiteSpace(path)) return string.Empty;
        var normalized = path.Replace('\\', '/');
        return normalized[(normalized.LastIndexOf('/') + 1)..];
    }

    private static string GetDocumentTypeName(string? path)
    {
        if (string.IsNullOrWhiteSpace(path)) return "Document";
        var normalized = path.Replace('\\', '/').ToLowerInvariant();
        if (normalized.Contains("/gst_spic/")) return "SPIC GST";
        if (normalized.Contains("/gst_gfl/")) return "GREEN STAR GST";
        if (normalized.Contains("/gst_trading/")) return "Trading Document";
        if (normalized.Contains("/insurance_spic/")) return "SPIC Insurance";
        if (normalized.Contains("/insurance_gfl/")) return "GREEN STAR Insurance";
        if (normalized.Contains("/insurance/")) return "Insurance Document";
        if (normalized.Contains("/fertilizerlicense_spic/")) return "SPIC Fertilizer License";
        if (normalized.Contains("/fertilizerlicense_gfl/")) return "GREEN STAR Fertilizer License";
        if (normalized.Contains("/other/")) return "Other Document";
        var name = GetFileName(path);
        return string.IsNullOrWhiteSpace(name) ? "Document" : name;
    }

    private static string? GetDocumentCompany(string? path)
    {
        if (string.IsNullOrWhiteSpace(path)) return null;
        var normalized = path.Replace('\\', '/').ToLowerInvariant();
        if (normalized.Contains("/gst_spic/") || normalized.Contains("/insurance_spic/") || normalized.Contains("/fertilizerlicense_spic/"))
            return "SPIC";
        if (normalized.Contains("/gst_gfl/") || normalized.Contains("/insurance_gfl/") || normalized.Contains("/fertilizerlicense_gfl/"))
            return "Green Star";
        return null;
    }

    private List<(string Path, string TypeName, string? Company)> GetItemDocumentEntries(LogisticsItemDto item)
    {
        var entries = new List<(string Path, string TypeName, string? Company)>();
        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        void AddEntry(string? p)
        {
            if (string.IsNullOrWhiteSpace(p) || !seen.Add(p)) return;
            entries.Add((p, GetDocumentTypeName(p), GetDocumentCompany(p)));
        }

        AddEntry(item.GstDocumentPath);
        AddEntry(item.InsuranceDocumentPath);
        AddEntry(item.FertilizerLicenseDocumentPath);
        foreach (var p in DeserializeDocumentPaths(item.OtherDocumentPathsJson))
            AddEntry(p);

        return entries;
    }

