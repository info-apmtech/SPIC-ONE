    private async Task<bool> UploadSelectedDocumentsAsync(int recordId)
    {
        try
        {
            var entityType = ActiveTab switch
            {
                "Warehouse" => "Warehouse",
                "Port" => "RackPoint",
                "PortMaster" => "Port",
                _ => throw new InvalidOperationException("Invalid Logistics Master tab.")
            };

            if (IsWarehouseTab)
            {
                // Primary GST column: SPIC GST for selected SPIC in PVT/Both,
                // or the existing single GST document for C&F.
                if (_gstDocumentFile != null)
                {
                    if ((IsPvtWarehouseCategory || IsBothWarehouseCategory) && _form.InSpic)
                    {
                        _form.GstDocumentPath = await UploadLogisticsFileAsync(
                            entityType, recordId, "GST_SPIC", _gstDocumentFile);
                    }
                    else if (IsCandFWarehouseCategory)
                    {
                        _form.GstDocumentPath = await UploadLogisticsFileAsync(
                            entityType, recordId, "GST", _gstDocumentFile);
                    }
                }

                // GREEN STAR maps to GFL in the Excel document matrix.
                if ((IsPvtWarehouseCategory || IsBothWarehouseCategory) &&
                    _form.InGreenStar &&
                    _gflGstDocumentFile != null)
                {
                    var path = await UploadLogisticsFileAsync(
                        entityType, recordId, "GST_GFL", _gflGstDocumentFile);
                    SetMatrixSupplementalPath(ref _gflGstDocumentPath, path);
                }

                if ((IsPvtWarehouseCategory || IsBothWarehouseCategory) && _tradingDocumentFile != null)
                {
                    // Keep GST_TRADING as the legacy document-type key so previously
                    // uploaded Trading files continue to restore without a migration.
                    var path = await UploadLogisticsFileAsync(
                        entityType, recordId, "GST_TRADING", _tradingDocumentFile);
                    SetMatrixSupplementalPath(ref _tradingDocumentPath, path);
                }

                // Generic insurance is required for C&F WH; if selected it is uploaded and saved normally.
                if (_insuranceDocumentFile != null)
                {
                    // C&F uses the primary InsuranceDocumentPath column.
                    _form.InsuranceDocumentPath = await UploadLogisticsFileAsync(
                        entityType, recordId, "Insurance", _insuranceDocumentFile);
                }

                // Company-specific insurance for any Warehouse category stored as supplemental paths.
                if (IsWarehouseTab && _form.InSpic && _spicInsuranceDocumentFile != null)
                {
                    var path = await UploadLogisticsFileAsync(entityType, recordId, "Insurance_SPIC", _spicInsuranceDocumentFile);
                    SetMatrixSupplementalPath(ref _spicInsuranceDocumentPath, path);
                }

                if (IsWarehouseTab && _form.InGreenStar && _gflInsuranceDocumentFile != null)
                {
                    var path = await UploadLogisticsFileAsync(entityType, recordId, "Insurance_GFL", _gflInsuranceDocumentFile);
                    SetMatrixSupplementalPath(ref _gflInsuranceDocumentPath, path);
                }

                // Primary Fertilizer License: selected SPIC for PVT/Both,
                // or the existing single C&F License.
                if (_fertilizerLicenseDocumentFile != null)
                {
                    if ((IsPvtWarehouseCategory || IsBothWarehouseCategory) && _form.InSpic)
                    {
                        _form.FertilizerLicenseDocumentPath = await UploadLogisticsFileAsync(
                            entityType, recordId, "FertilizerLicense_SPIC", _fertilizerLicenseDocumentFile);
                    }
                    else if (IsCandFWarehouseCategory)
                    {
                        _form.FertilizerLicenseDocumentPath = await UploadLogisticsFileAsync(
                            entityType, recordId, "FertilizerLicense", _fertilizerLicenseDocumentFile);
                    }
                }

                if ((IsPvtWarehouseCategory || IsBothWarehouseCategory) &&
                    _form.InGreenStar &&
                    _gflFertilizerLicenseDocumentFile != null)
                {
                    var path = await UploadLogisticsFileAsync(
                        entityType, recordId, "FertilizerLicense_GFL", _gflFertilizerLicenseDocumentFile);
                    SetMatrixSupplementalPath(ref _gflFertilizerLicenseDocumentPath, path);
                }
            }
            else if (IsRakePointTab && _insuranceDocumentFile != null)
            {
                // RackPoint currently stores document paths in OtherDocumentPathsJson.
                var path = await UploadLogisticsFileAsync(
                    entityType, recordId, "Insurance", _insuranceDocumentFile);
                SetMatrixSupplementalPath(ref _rakePointInsuranceDocumentPath, path);
            }

            foreach (var file in _otherDocumentFiles)
            {
                var path = await UploadLogisticsFileAsync(entityType, recordId, "Other", file);
                if (!string.IsNullOrWhiteSpace(path) && !_otherDocumentPaths.Contains(path, StringComparer.OrdinalIgnoreCase))
                    _otherDocumentPaths.Add(path);
            }

            _form.OtherDocumentPathsJson = SerializeDocumentPaths(_otherDocumentPaths);
            ClearSelectedDocumentFiles();
            return true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Logistics document upload failed: {ex.Message}");
            return false;
        }
    }

   private void SetMatrixSupplementalPath(ref string? target, string path)
{
    var previousPath = target;

    if (!string.IsNullOrWhiteSpace(previousPath))
    {
        _otherDocumentPaths.RemoveAll(x =>
            string.Equals(x, previousPath, StringComparison.OrdinalIgnoreCase));
    }

    target = path;

    if (!string.IsNullOrWhiteSpace(path) &&
        !_otherDocumentPaths.Contains(path, StringComparer.OrdinalIgnoreCase))
    {
        _otherDocumentPaths.Add(path);
    }
}

    private void RestoreMatrixSupplementalDocumentPaths()
    {
        _gflGstDocumentPath = FindPathByDocumentType("gst_gfl");
        _tradingDocumentPath = FindPathByDocumentType("gst_trading");
