@if (_showApproveModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block lm-flow-modal" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <div class="lm-flow-title-wrap">
                        <div class="lm-flow-icon approve"><i class="bi bi-check-circle-fill"></i></div>
                        <div>
                            <h5 class="lm-flow-title">Confirm Proceed</h5>
                            <div class="lm-flow-subtitle">
                                Are you sure you want to approve and forward this logistics request to @(GetNextApprovalTarget())?
                            </div>
                        </div>
                    </div>
                    <button type="button" class="btn-close" aria-label="Close"
                            disabled="@_approvingId.HasValue" @onclick="CancelApprove"></button>
                </div>

                <div class="modal-body">
                    @if (_approveTarget is not null)
                    {
                        <div class="lm-flow-summary">
                            <div class="lm-flow-summary-item">
                                <span class="lm-flow-summary-label">Name</span>
                                <span class="lm-flow-summary-value">@_approveTarget.Name</span>
                            </div>
                            <div class="lm-flow-summary-item">
                                <span class="lm-flow-summary-label">SAP Code</span>
                                <span class="lm-flow-summary-value">@GetDisplayCode(_approveTarget)</span>
                            </div>
                            <div class="lm-flow-summary-item">
                                <span class="lm-flow-summary-label">Current Stage</span>
                                <span class="lm-flow-summary-value">@GetApprovalStatus(_approveTarget)</span>
                            </div>
                            <div class="lm-flow-summary-item">
                                <span class="lm-flow-summary-label">Next Stage</span>
                                <span class="lm-flow-summary-value">@GetNextApprovalTarget()</span>
                            </div>
                        </div>
                    }

                    <div class="lm-flow-label">
                        <span>Approval Remarks</span>
                        <span class="lm-flow-required">Required</span>
                    </div>
                    <textarea class="lm-flow-textarea" rows="4" maxlength="500"
                              placeholder="Enter approval remarks..."
                              @bind="_approveRemarks" @bind:event="oninput"></textarea>
                    <div class="lm-flow-meta">
                        <div>
                            @if (!string.IsNullOrWhiteSpace(_approveRemarksError))
                            {
                                <span class="lm-flow-error"><i class="bi bi-exclamation-circle me-1"></i>@_approveRemarksError</span>
                            }
                        </div>
                        <span class="lm-flow-count">@_approveRemarks.Length / 500</span>
                    </div>

                    <div class="lm-flow-note">
                        <i class="bi bi-info-circle-fill"></i>
                        <span>The current RM → SMM → AVP workflow remains unchanged. The entered remarks are saved with this approval action.</span>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="lm-flow-cancel" @onclick="CancelApprove" disabled="@_approvingId.HasValue">Cancel</button>
                    <button type="button" class="lm-flow-confirm approve" @onclick="ApproveItem" disabled="@_approvingId.HasValue">
                        @if (_approvingId.HasValue)
                        {
                            <i class="bi bi-arrow-repeat spin"></i><span>Processing...</span>
                        }
                        else
                        {
                            <i class="bi bi-check-lg"></i><span>Confirm &amp; Proceed</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}


@if (_showRejectModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block lm-flow-modal" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <div class="lm-flow-title-wrap">
                        <div class="lm-flow-icon sendback"><i class="bi bi-arrow-counterclockwise"></i></div>
                        <div>
                            <h5 class="lm-flow-title">Send Back for Correction</h5>
                            <div class="lm-flow-subtitle">
                                This request will be returned to @(GetPreviousApprovalTarget()). The Warehouse / Rake Point record will remain saved.
                            </div>
                        </div>
                    </div>
                    <button type="button" class="btn-close" aria-label="Close"
                            disabled="@_rejectingId.HasValue" @onclick="CancelReject"></button>
                </div>

                <div class="modal-body">
                    @if (_rejectTarget is not null)
                    {
                        <div class="lm-flow-summary">
                            <div class="lm-flow-summary-item">
                                <span class="lm-flow-summary-label">Name</span>
                                <span class="lm-flow-summary-value">@_rejectTarget.Name</span>
                            </div>
                            <div class="lm-flow-summary-item">
                                <span class="lm-flow-summary-label">SAP Code</span>
                                <span class="lm-flow-summary-value">@GetDisplayCode(_rejectTarget)</span>
                            </div>
                            <div class="lm-flow-summary-item">
                                <span class="lm-flow-summary-label">Current Stage</span>
                                <span class="lm-flow-summary-value">@GetApprovalStatus(_rejectTarget)</span>
                            </div>
                            <div class="lm-flow-summary-item">
                                <span class="lm-flow-summary-label">Send Back To</span>
                                <span class="lm-flow-summary-value">@GetPreviousApprovalTarget()</span>
                            </div>
                        </div>
                    }

                    <div class="lm-flow-label">
                        <span>Send Back Remarks</span>
                        <span class="lm-flow-required">Required</span>
                    </div>
                    <textarea class="lm-flow-textarea sendback" rows="4" maxlength="500"
                              placeholder="Enter the reason and correction required..."
                              @bind="_rejectRemarks" @bind:event="oninput"></textarea>
                    <div class="lm-flow-meta">
                        <div>
                            @if (!string.IsNullOrWhiteSpace(_rejectRemarksError))
                            {
                                <span class="lm-flow-error"><i class="bi bi-exclamation-circle me-1"></i>@_rejectRemarksError</span>
                            }
                        </div>
                        <span class="lm-flow-count">@_rejectRemarks.Length / 500</span>
                    </div>

                    <div class="lm-flow-note sendback">
                        <i class="bi bi-info-circle-fill"></i>
                        <span><strong>No delete action will run.</strong> The request is only moved back one workflow stage with these remarks.</span>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="lm-flow-cancel" @onclick="CancelReject" disabled="@_rejectingId.HasValue">Cancel</button>
                    <button type="button" class="lm-flow-confirm sendback" @onclick="RejectItem" disabled="@_rejectingId.HasValue">
                        @if (_rejectingId.HasValue)
                        {
                            <i class="bi bi-arrow-repeat spin"></i><span>Sending Back...</span>
                        }
                        else
                        {
                            <i class="bi bi-arrow-counterclockwise"></i><span>Confirm Send Back</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}


}

@code {

    // ===============================================================
    // INLINE PDF MODE
    // Keep PDF rendering inside the already-authorized /Logistics route.
    // ===============================================================
    [SupplyParameterFromQuery(Name = "pdf")]
    public bool PdfViewMode { get; set; }

    [SupplyParameterFromQuery(Name = "pdfTab")]
    public string? PdfViewTab { get; set; }

    [SupplyParameterFromQuery(Name = "pdfId")]
    public int PdfViewId { get; set; }

    [SupplyParameterFromQuery(Name = "company")]
    public string? PdfViewCompany { get; set; }


    // Warehouse is now one tab and one entity/table/API.
    // WarehouseCategory decides whether PVT, C&F or Both-specific content is shown/saved.
    private string ActiveTab { get; set; } = "Warehouse";

    private bool IsWarehouseTab => ActiveTab == "Warehouse";
    private bool IsRakePointTab => ActiveTab == "Port";
    private bool IsPortTab => ActiveTab == "PortMaster";

    private LogisticsWarehouseCategory CurrentWarehouseCategory =>
        _form.WarehouseCategory ?? LogisticsWarehouseCategory.PvtWH;

    private bool IsPvtWarehouseCategory =>
        IsWarehouseTab && CurrentWarehouseCategory == LogisticsWarehouseCategory.PvtWH;

    private bool IsCandFWarehouseCategory =>
        IsWarehouseTab && CurrentWarehouseCategory == LogisticsWarehouseCategory.CandFWH;

    private bool IsBothWarehouseCategory =>
        IsWarehouseTab && CurrentWarehouseCategory == LogisticsWarehouseCategory.Both;

    private bool ShowsPvtWarehouseContent =>
        IsWarehouseTab && (IsPvtWarehouseCategory || IsBothWarehouseCategory);

    private bool ShowsCandFWarehouseContent =>
        IsWarehouseTab && (IsCandFWarehouseCategory || IsBothWarehouseCategory);


    // Preserve the existing Active-PVT rule and existing Both-category rule for GST / License.
    // Insurance is handled separately below and is mandatory for the applicable flow.
    private bool ArePvtMatrixDocumentsRequired =>
        IsBothWarehouseCategory || (IsPvtWarehouseCategory && _form.IsActive);

    // PVT WH / Both use company-specific insurance based on the selected company cards.
    private bool RequiresCompanySpecificInsurance =>
        IsWarehouseTab && (IsPvtWarehouseCategory || IsBothWarehouseCategory);

    // C&F WH keeps its existing single insurance upload as mandatory. Rake Point insurance is optional.
    private bool RequiresGenericInsurance =>
        IsCandFWarehouseCategory;



    // Excel reference adds GST + Fertilizer License for C&F.
    // Keep the same Active/Inactive behaviour used by PVT WH.
    private bool AreCandFDocumentsRequired =>
        IsCandFWarehouseCategory && _form.IsActive;

    private string? CurrentInsuranceDocumentPath =>
        IsRakePointTab ? _rakePointInsuranceDocumentPath : _form.InsuranceDocumentPath;

    private IEnumerable<string> VisibleOtherDocumentPaths =>
        _otherDocumentPaths.Where(path => !IsMatrixSupplementalDocumentPath(path));

    private bool HasTradingDocument =>
        !string.IsNullOrWhiteSpace(_tradingDocumentPath) || _tradingDocumentFile != null;

    private bool HasUploadedTradingDocument =>
        !string.IsNullOrWhiteSpace(_tradingDocumentPath) && _tradingDocumentFile == null;

    private bool HasInsuranceDocument =>
        !string.IsNullOrWhiteSpace(CurrentInsuranceDocumentPath) || _insuranceDocumentFile != null;

    private bool HasUploadedInsuranceDocument =>
        !string.IsNullOrWhiteSpace(CurrentInsuranceDocumentPath) && _insuranceDocumentFile == null;

    private bool HasOtherDocuments =>
        VisibleOtherDocumentPaths.Any() || _otherDocumentFiles.Count > 0;

    private bool HasUploadedOtherDocuments =>
        VisibleOtherDocumentPaths.Any();

    // Pure C&F hides WH Type. PVT, Both and Rake Point keep it visible.
    private bool IsCandFOnlyWarehouse => IsWarehouseTab && IsCandFWarehouseCategory;

    private string CurrentContactLabel => IsWarehouseTab
        ? CurrentWarehouseCategory switch
        {
            LogisticsWarehouseCategory.CandFWH => "C&F Operator Contact No",
            LogisticsWarehouseCategory.Both => "Contact No / C&F Operator Contact No",
            _ => "Contact No"
        }
        : "Contact No";

    private string ActiveTabDisplayName => ActiveTab switch
    {
        "Warehouse" => LoginState.IsAdmin
            ? "Warehouse"
            : CurrentWarehouseCategory switch
            {
                LogisticsWarehouseCategory.PvtWH => "PVT WH",
                LogisticsWarehouseCategory.CandFWH => "C&F WH",
                LogisticsWarehouseCategory.Both => "PVT + C&F WH",
                _ => "Warehouse"
            },
        "Port" => "Rake Point",
        "PortMaster" => "Port",
        _ => ActiveTab
    };

    private string CurrentApiBase => ActiveTab switch
    {
        "Warehouse" => "api/Warehouse",
        "Port" => "api/RackPoint",
        "PortMaster" => "api/Port",
        _ => ""
    };

    private string CurrentFileName => ActiveTabDisplayName.Replace(" ", "_").Replace("&", "and").Replace("+", "and");

    private string CurrentNamePlaceholder => ActiveTab switch
    {
        "Warehouse" => CurrentWarehouseCategory switch
        {
            LogisticsWarehouseCategory.PvtWH => "Enter PVT Warehouse Name",
            LogisticsWarehouseCategory.CandFWH => "Enter C&F Warehouse Name",
            LogisticsWarehouseCategory.Both => "Enter Warehouse Name",
            _ => "Enter Warehouse Name"
        },
        "PortMaster" => "Enter Port Name",
