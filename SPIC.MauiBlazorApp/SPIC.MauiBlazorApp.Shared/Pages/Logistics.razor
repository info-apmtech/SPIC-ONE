    private static string GetApprovalStatus(LogisticsItemDto item)
    {
        if (item.IsSubmittedForReview != true)
            return "Draft";

        if (item.RMApproved == false)
            return "Rejected by RM";

        if (item.SMApproved == false)
            return "Rejected by SMM";

        if (item.AVPApproved == false)
            return "Rejected by AVP";

        if (item.AVPApproved == true)
            return "Approved";

        if (item.RMApproved == null)
            return "Pending RM";

        if (item.RMApproved == true && item.SMApproved == null)
            return "Pending SMM";

        if (item.RMApproved == true && item.SMApproved == true && item.AVPApproved == null)
            return "Pending AVP";

        return "Submitted";
    }

    private static string GetApprovalBadgeClass(LogisticsItemDto item)
    {
        var status = GetApprovalStatus(item);

        if (status == "Approved")
            return "lm-approval-approved";

        if (status.StartsWith("Rejected", StringComparison.OrdinalIgnoreCase))
            return "lm-approval-rejected";

        if (status.StartsWith("Pending", StringComparison.OrdinalIgnoreCase) || status == "Submitted")
            return "lm-approval-pending";

        return "lm-approval-draft";
    }

