@page "/DigitalLibrary/view/{Id:int}"
@inject NavigationManager Nav
@inject ToastService Toast

<PageTitle>@(Item?.Title ?? "Content") - Digital Library - SPIC ONE</PageTitle>

@*
    Single-item view for the Digital Library (Figma frame supplied 2026-09-20): hero banner,
    SPIC AI chat box, overview with video player / document, details panel, related videos,
    related brochures, key features, usage. The section order comes from the item's layout
    configuration (step 3 of the add wizard); sample content until the API exists.
*@

@if (Item is null)
{
    <EmptyState Icon="bi-collection" Title="Content not found" Message="This item is not in the library any more.">
        <button type="button" class="btn btn-success" @onclick='() => Nav.NavigateTo("/DigitalLibrary/content")'>Back to All Content</button>
    </EmptyState>
}
else
{
    <div class="dv-page">

        <section class="dv-hero" style="background-image:url('@Item.Image')">
            <div class="dv-hero-shade"></div>
            <div class="dv-hero-top">
                <button type="button" class="dv-hero-btn" @onclick="Back"><i class="bi bi-arrow-left"></i> Back</button>
                <button type="button" class="dv-hero-btn" @onclick="Edit"><i class="bi bi-pencil"></i> Edit Content</button>
            </div>
            <div class="dv-hero-body">
                <div class="dv-tags">
                    <span class="dv-pill dv-pill-type">@Item.TypeLabel</span>
                    <span class="dv-pill @(Item.Published ? "dv-pill-pub" : "dv-pill-draft")">@(Item.Published ? "Published" : "Draft")</span>
                </div>
                <h1 class="dv-title">@Item.Title</h1>
                <p class="dv-desc">@Item.Description</p>
                <div class="dv-chips">
                    @foreach (var t in Tags) { <span class="dv-chip">@t</span> }
                </div>
            </div>
        </section>

        <div class="dv-main">
            <div class="dv-content">

                <section class="dv-ai">
                    <span class="dv-ai-logo" aria-hidden="true"><i class="bi bi-stars"></i></span>
                    <div class="dv-ai-text">
                        <strong>SPIC AI Chatbox</strong>
                        <span>Ask SPIC AI about this @KindWord or the related product</span>
                    </div>
                    <button type="button" class="dv-ai-btn" @onclick='() => Nav.NavigateTo($"/DigitalLibrary/chat?about={Item.Id}")'><i class="bi bi-stars"></i> Start Conversation</button>
                </section>

                <section class="dv-card dv-overview">
                    <div class="dv-overview-text">
                        <h2 class="dv-card-title">Overview / Summary</h2>
                        <p>@Overview</p>
                    </div>
                    @if (Item.Type == DigitalLibraryType.Videos)
                    {
                        <div class="dv-player">
                            <img src="@Item.Image" alt="" />
                            <button type="button" class="dv-play" aria-label="Play video" @onclick='() => Toast.Info("Video playback arrives with the media service.")'><i class="bi bi-play-fill"></i></button>
                            <div class="dv-player-bar">
                                <i class="bi bi-play-fill"></i> <span>00:00 / @Duration</span>
                                <span class="dv-player-spacer"></span>
                                <i class="bi bi-volume-up"></i> <i class="bi bi-arrows-fullscreen"></i>
                            </div>
                        </div>
                    }
                    else if (Item.Type == DigitalLibraryType.Brochures)
                    {
                        <div class="dv-document">
                            <img src="@Item.Image" alt="" />
                            <button type="button" class="dv-doc-btn" @onclick='() => Toast.Info("Brochure download arrives with the document service.")'><i class="bi bi-file-earmark-pdf"></i> Open brochure (PDF)</button>
                        </div>
                    }
                    else
                    {
                        <div class="dv-product-img"><img src="@Item.Image" alt="" /></div>
                    }
                </section>

                <section class="dv-card">
                    <h2 class="dv-card-title">Related Video</h2>
                    <div class="dv-related-grid">
                        @foreach (var r in RelatedVideos)
                        {
                            <a class="dv-related-card" href="@($"DigitalLibrary/view/{r.Id}")">
                                <div class="dv-related-img">
                                    <img src="@r.Image" alt="" loading="lazy" />
                                    <span class="dv-pill dv-pill-type">@r.TypeLabel</span>
                                    <span class="dv-pill dv-pill-related">Related Video</span>
                                </div>
                                <span class="dv-related-title">@r.Title</span>
                                <span class="dv-related-desc">@r.Description</span>
                            </a>
                        }
                    </div>
                </section>

                <section class="dv-card">
                    <h2 class="dv-card-title">Related Brochure</h2>
                    <div class="dv-brochure-grid">
                        @foreach (var b in RelatedBrochures)
                        {
                            <a class="dv-brochure-row" href="@($"DigitalLibrary/view/{b.Id}")">
                                <img src="@b.Image" alt="" loading="lazy" />
                                <div class="dv-brochure-text">
                                    <div class="dv-brochure-pills"><span class="dv-pill dv-pill-brochure">Brochure</span><span class="dv-pill dv-pill-related">Related Brochure</span></div>
                                    <span class="dv-related-title">@b.Title</span>
                                    <span class="dv-related-desc">@b.Description</span>
                                </div>
                            </a>
                        }
                    </div>
                </section>

                <section class="dv-card">
                    <h2 class="dv-card-title">Key Features &amp; Benefits</h2>
                    <p class="dv-text">High nutrient concentration ensures maximum efficiency per application. Water-soluble formulation allows rapid uptake by plant root systems. Consistent granule size enables uniform spreading through mechanical applicators. Certified to national quality standards with full traceability.</p>
                </section>

                <section class="dv-card">
                    <h2 class="dv-card-title">Usage &amp; Application</h2>
                    <p class="dv-text">Recommended rate: apply 100 to 120 kg per acre as a basal dose prior to sowing. For top-dressing, apply in split doses corresponding to crop growth stages. Avoid application during heavy rain or waterlogging conditions. Consult the SPIC Agri advisory for crop-specific dosage recommendations.</p>
                </section>
            </div>

            <aside class="dv-side">
                <section class="dv-card dv-details">
                    <h2 class="dv-card-title">Details</h2>
                    <dl>
                        <div><dt>Category</dt><dd>Phosphatic Fertilizers</dd></div>
                        <div><dt>Published</dt><dd>@Item.Date.ToString("dd MMM yyyy")</dd></div>
                        <div><dt>Author</dt><dd>@Item.Author</dd></div>
                        <div><dt>Status</dt><dd><span class="dv-pill @(Item.Published ? "dv-pill-pub" : "dv-pill-draft")">@(Item.Published ? "Published" : "Draft")</span></dd></div>
                        <div><dt>Related Product</dt><dd>DAP Fertilizer</dd></div>
                        @if (Item.Type == DigitalLibraryType.Videos) { <div><dt>Duration</dt><dd>@Duration</dd></div> }
                        <div><dt>Tag</dt><dd class="dv-chips">@foreach (var t in Tags) { <span class="dv-chip dv-chip-green">@t</span> }</dd></div>
                    </dl>
                    <button type="button" class="dv-side-btn dv-side-edit" @onclick="Edit">Edit Details</button>
                    @if (Item.Published)
                    {
                        <button type="button" class="dv-side-btn dv-side-unpub" @onclick="() => _unpublishTarget = Item">Unpublish @KindWordCap</button>
                    }
                    else
                    {
                        <button type="button" class="dv-side-btn dv-side-pub" @onclick="Publish">Publish @KindWordCap</button>
                    }
                </section>
            </aside>
        </div>

        <DigitalLibraryUnpublishDialog Item="_unpublishTarget" OnConfirm="ConfirmUnpublish" OnCancel="() => _unpublishTarget = null" />
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private static readonly List<DigitalLibraryItem> Pool = DigitalLibrarySampleData.Create(30);
    private DigitalLibraryItem? Item => Pool.FirstOrDefault(p => p.Id == Id);
    private DigitalLibraryItem? _unpublishTarget;

    private static readonly string[] Tags = { "DAP", "Fertilizer" };
    private const string Duration = "03:12";

    private string KindWord => Item?.Type switch { DigitalLibraryType.Videos => "video", DigitalLibraryType.Brochures => "brochure", _ => "product" };
    private string KindWordCap => char.ToUpperInvariant(KindWord[0]) + KindWord[1..];

    private string Overview => Item?.Type == DigitalLibraryType.Videos
        ? "This video explains how DAP (Di-ammonium Phosphate) improves soil fertility and helps in higher crop yield. It covers composition, benefits, usage methods and best practices for maximum results."
        : Item?.Description ?? "";

    private IEnumerable<DigitalLibraryItem> RelatedVideos => Pool.Where(p => p.Type == DigitalLibraryType.Videos && p.Id != Id).Take(3);
    private IEnumerable<DigitalLibraryItem> RelatedBrochures => Pool.Where(p => p.Type == DigitalLibraryType.Brochures && p.Id != Id).Take(4);

    private void Back() => Nav.NavigateTo($"/DigitalLibrary/content?type={Item?.Type.ToString().ToLowerInvariant()}");
    private void Edit() => Nav.NavigateTo($"/DigitalLibrary/add/{Item?.Type.ToString().ToLowerInvariant()}?id={Id}");

    private void Publish()
    {
        if (Item is null) return;
        Item.Published = true;
        Toast.Success($"{KindWordCap} published.");
    }

    private void ConfirmUnpublish(DigitalLibraryItem item)
    {
        item.Published = false;
        _unpublishTarget = null;
        Toast.Success($"{KindWordCap} moved to Drafts.");
    }
}
