@page "/TaskDetail"
@implements IDisposable
@using System.Net.Http.Json
@using SPIC.Core.DTOs
@using SPIC.Core.Entities
@inject NavigationManager Navigation
@inject SPIC.MauiBlazorApp.Shared.Services.ToastService Toast
@inject SPIC.MauiBlazorApp.Shared.Services.LoginState LoginState
@inject SPIC.MauiBlazorApp.Shared.Services.NavHistoryService NavHistory
@inject IJSRuntime JS

<div class="container-fluid py-4 px-0 td-page">

    <div class="td-header-row">
        <button type="button" class="td-back-link" @onclick="GoBack">
            <i class="bi bi-arrow-left"></i> Back to Tasks
        </button>

        <span class="td-category-badge">@CategoryLabel</span>
    </div>
    @if (kind == TaskKind.Dealer)
    {
        <h2 class="td-title">@dynamicTitle</h2>
        <p class="td-subtitle">Pending Ack. @dynamicPendingAck &middot; Dues @dynamicDues &middot; @dynamicLocation</p>
    }
    else if (kind == TaskKind.MdProgram)
    {
        <h2 class="td-title">@dynamicTitle</h2>
        <p class="td-subtitle">Sanction No: @dynamicSanctionNo &middot; Sanction Date: @dynamicSanctionDate &middot; Budget: @dynamicBudget</p>
    }

    <div class="td-timeline-card">
        <h3 class="td-timeline-title">Task Timeline</h3>
        <div class="td-timeline">
            @for (var i = 0; i < TimelineSteps.Count; i++)
            {
                var step = TimelineSteps[i];
                var index = i;
                <div class="td-timeline-step">
                    <div class="td-timeline-node @(step.Done ? "done" : "pending")">
                        <i class="bi @(step.Done ? "bi-check-lg" : "bi-clock")"></i>
                    </div>
                    <div class="td-timeline-label">@step.Label</div>
                    <div class="td-timeline-sub">@step.SubLabel</div>
                </div>

                @if (index < TimelineSteps.Count - 1)
                {
                    <div class="td-timeline-connector @(step.Done && TimelineSteps[index + 1].Done ? "done" : "")"></div>
                }
            }
        </div>
    </div>


<style>
                .td-main-grid {
                    grid-auto-flow: dense;
                    align-items: start;
                }
            </style>

<div class="td-main-grid">
    <div class="td-col-left-wrap d-flex flex-column" style="gap: 1.5rem;">
        @if (kind == TaskKind.Dealer)
            {
                <div class="td-card td-col-left">
                    <h3 class="td-card-title">Task Details</h3>
                    <div class="td-details-grid">
                        <div class="td-detail">
                            <span class="td-detail-label">Dealer / Farmer</span>
                            <span class="td-detail-val">@(dynamicTitle.ToUpperInvariant())</span>
                        </div>
                        <div class="td-detail">
                            <span class="td-detail-label">Task Type</span>
                            <span class="td-detail-val">dealer</span>
                        </div>
                        <div class="td-detail">
                            <span class="td-detail-label">Location</span>
                            <span class="td-detail-val">@dynamicLocation</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(dynamicPriority) && dynamicPriority != "-" && dynamicPriority != "—")
                        {
                            <div class="td-detail">
                                <span class="td-detail-label">Priority</span>
                                <span class="td-detail-val td-detail-val-priority-high"><i class="bi bi-exclamation-triangle-fill"></i> @dynamicPriority</span>
                            </div>
                        }
                        <div class="td-detail">
                            <span class="td-detail-label">Assigned To</span>
                            <span class="td-detail-val">@(LoginState.UserName ?? "Me")</span>
                        </div>
                    </div>
                </div>
            }
        @if (kind == TaskKind.MdProgram)
            {
                <div class="td-card td-col-left">
                    <h3 class="td-card-title">Program Details</h3>
                    <div class="td-details-grid">
                        <div class="td-detail">
                            <span class="td-detail-label">Program</span>
                            <span class="td-detail-val">@dynamicTitle</span>
                        </div>
                        <div class="td-detail">
                            <span class="td-detail-label">Task Type</span>
                            <span class="td-detail-val">MD Program</span>
                        </div>
                        <div class="td-detail">
                            <span class="td-detail-label">Sanction Date</span>
                            <span class="td-detail-val">@dynamicSanctionDate</span>
                        </div>
                        <div class="td-detail">
                            <span class="td-detail-label">Sanction No</span>
                            <span class="td-detail-val">@dynamicSanctionNo</span>
                        </div>
                        <div class="td-detail">
                            <span class="td-detail-label">Program Type</span>
                            <span class="td-detail-val">@dynamicProgramType</span>
                        </div>
                        <div class="td-detail">
                            <span class="td-detail-label">Total Budget</span>
                            <span class="td-detail-val">@dynamicBudget</span>
                        </div>
                    </div>
                </div>
            }
        <div class="td-time-bar td-col-left">
                <div class="td-time-left">
                    <span class="td-time-label">Time on task</span>
                    <span class="td-time-val">@ElapsedDisplay</span>
                </div>
                <div class="td-time-location @(!isStarted && !isClosed ? "text-muted" : "text-success")">
                    @if (isLocationCapturing)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                        <span>Capturing location...</span>
                    }
                    else if (!isStarted && !isClosed)
                    {
                        <i class="bi bi-geo-alt me-1"></i>
                        <span>Location not captured</span>
                    }
                    else if (!string.IsNullOrWhiteSpace(capturedPlaceName))
                    {
                        <i class="bi bi-geo-alt-fill me-1"></i>
                        <span class="td-time-location-text" title="@(capturedLatitude.HasValue ? $"Lat: {capturedLatitude}, Lng: {capturedLongitude} (±{capturedAccuracy ?? 20}m)" : capturedPlaceName)">@capturedPlaceName</span>
                    }
                    else if (capturedLatitude.HasValue && capturedLongitude.HasValue)
                    {
                        <i class="bi bi-geo-alt-fill me-1"></i>
                        <span title="Lat: @capturedLatitude, Lng: @capturedLongitude">Location captured (&plusmn;@(capturedAccuracy ?? 20)m)</span>
                    }
                    else
                    {
                        <i class="bi bi-geo-alt-fill me-1"></i>
                        <span>Location captured (&plusmn;20m)</span>
                    }
                </div>

                @if (!isStarted && !isClosed)
                {
                    <button type="button" class="td-btn td-btn-primary" disabled="@isLocationCapturing" @onclick="StartTask">
                        @if (isLocationCapturing)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            <span>Starting...</span>
                        }
                        else
                        {
                            <i class="bi bi-play-circle"></i>
                            <span>Start Task</span>
                        }
                    </button>
                }
                else if (isStarted && !isClosed)
                {
                    <button type="button" class="td-btn td-btn-danger" @onclick="ConfirmStopTask">
                        <i class="bi bi-stop-circle"></i> Stop Task
                    </button>
                }
                else
                {
                    <div class="text-success fw-bold mt-2"><i class="bi bi-check-circle-fill"></i> Task Closed</div>
                }
            </div>
        <div class="td-card td-col-left">
                <h3 class="td-card-title">Close-out form</h3>
                <p class="td-card-subtitle">Fill this once work is done, then close the task.</p>

                @if (!isStarted && !isClosed)
                {
                    <div class="alert alert-light border d-flex align-items-center gap-2 py-2 px-3 mb-3 text-muted small">
                        <i class="bi bi-lock-fill text-secondary"></i>
                        <span>Close-out form is readable only. Click <strong>Start Task</strong> above to enable editing.</span>
                    </div>
                }
                else if (isClosed)
                {
                    <div class="alert alert-success border d-flex align-items-center gap-2 py-2 px-3 mb-3 text-success small">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>This task is closed. Close-out form is now read-only.</span>
                    </div>
                }

                <fieldset disabled="@(!isStarted || isClosed)" style="border: none; margin: 0; padding: 0;">
                    <label class="td-field-label" for="td-outcome">Outcome<span class="td-required">*</span></label>
                    <select id="td-outcome" class="td-input" @bind="outcome" disabled="@(!isStarted || isClosed)">
                        <option value="Fully Completed">Fully Completed</option>
                        <option value="Partially Completed">Partially Completed</option>
                        <option value="Not Completed">Not Completed</option>
                    </select>

                    @if (kind == TaskKind.Dealer)
                    {
                        <div class="d-flex justify-content-end mb-2 mt-3">
                            <button type="button" class="btn btn-link text-success fw-bold p-0 text-decoration-none" disabled="@(!isStarted || isClosed)" @onclick="OpenAddProductPopup">
                                + Add another Product
                            </button>
                        </div>

                        @foreach (var prod in dealerProducts)
                        {
                            <div class="td-product-card">
                                <div class="td-product-col">
                                    <span class="td-product-label">Product Group</span>
                                    <span class="td-product-val">@prod.Group</span>
                                </div>
                                <div class="td-product-col td-border-left">
                                    <span class="td-product-label">Product Name</span>
                                    <span class="td-product-val">@prod.Name</span>
                                </div>
                                <div class="td-product-col td-border-left">
                                    <span class="td-product-label">Stock</span>
                                    <span class="td-product-val">@prod.Stock</span>
                                </div>
                            </div>
                        }
                    }

                    @if (kind == TaskKind.Spcm)
                    {
                        @if (SpcmTargetValue > 0)
                        {
                            <div class="td-target-progress">
                                <span>Weekly Target <strong>@SpcmTargetValue</strong></span>
                                <span>Achieved So Far <strong>@SpcmAchievedSoFar</strong></span>
                                <span>Remaining <strong>@SpcmRemaining</strong></span>
                            </div>
                        }
                        <label class="td-field-label" for="td-achieved">Achieved Target</label>
                        <input id="td-achieved" type="number" min="0" max="@SpcmRemaining" class="td-input" placeholder="e.g. 1" @bind="achievedTarget" @bind:event="oninput" disabled="@(!isStarted || isClosed)" readonly="@(!isStarted || isClosed)" />
                    }

                    @if (kind == TaskKind.PosLiquidation)
                    {
                        <div class="td-pos-grid">
                            <div>
                                <label class="td-field-label" for="td-pos-urea">Urea</label>
                                @if (PosUreaTargetValue > 0)
                                {
                                    <div class="td-target-progress td-target-progress-compact">Target <strong>@PosUreaTargetValue</strong> &middot; Done <strong>@PosUreaAchievedSoFar</strong> &middot; Left <strong>@(Math.Max(PosUreaTargetValue - PosUreaAchievedSoFar, 0))</strong></div>
                                }
                                <input id="td-pos-urea" type="number" min="0" class="td-input" placeholder="e.g. 1" @bind="posUrea" @bind:event="oninput" disabled="@(!isStarted || isClosed)" readonly="@(!isStarted || isClosed)" />
                            </div>
                            <div>
                                <label class="td-field-label" for="td-pos-nps">NPKS</label>
                                @if (PosNpsTargetValue > 0)
                                {
                                    <div class="td-target-progress td-target-progress-compact">Target <strong>@PosNpsTargetValue</strong> &middot; Done <strong>@PosNpsAchievedSoFar</strong> &middot; Left <strong>@(Math.Max(PosNpsTargetValue - PosNpsAchievedSoFar, 0))</strong></div>
                                }
                                <input id="td-pos-nps" type="number" min="0" class="td-input" placeholder="e.g. 1" @bind="posNps" @bind:event="oninput" disabled="@(!isStarted || isClosed)" readonly="@(!isStarted || isClosed)" />
                            </div>
                            <div>
                                <label class="td-field-label" for="td-pos-dap">DAP</label>
                                @if (PosDapTargetValue > 0)
                                {
                                    <div class="td-target-progress td-target-progress-compact">Target <strong>@PosDapTargetValue</strong> &middot; Done <strong>@PosDapAchievedSoFar</strong> &middot; Left <strong>@(Math.Max(PosDapTargetValue - PosDapAchievedSoFar, 0))</strong></div>
                                }
                                <input id="td-pos-dap" type="number" min="0" class="td-input" placeholder="e.g. 1" @bind="posDap" @bind:event="oninput" disabled="@(!isStarted || isClosed)" readonly="@(!isStarted || isClosed)" />
                            </div>
                            <div>
                                <label class="td-field-label" for="td-pos-other">Other</label>
                                @if (PosOtherTargetValue > 0)
                                {
                                    <div class="td-target-progress td-target-progress-compact">Target <strong>@PosOtherTargetValue</strong> &middot; Done <strong>@PosOtherAchievedSoFar</strong> &middot; Left <strong>@(Math.Max(PosOtherTargetValue - PosOtherAchievedSoFar, 0))</strong></div>
                                }
                                <input id="td-pos-other" type="number" min="0" class="td-input" placeholder="e.g. 1" @bind="posOther" @bind:event="oninput" disabled="@(!isStarted || isClosed)" readonly="@(!isStarted || isClosed)" />
                            </div>
                        </div>
                    }

                    <label class="td-field-label" for="td-remarks">Remarks</label>
                    <textarea id="td-remarks" class="td-textarea" placeholder="What happened on this visit..." @bind="remarks" disabled="@(!isStarted || isClosed)" readonly="@(!isStarted || isClosed)"></textarea>

                    <label class="td-field-label">@FileFieldLabel</label>
                    @if (!isStarted || isClosed)
                    {
                        <input type="file" class="td-file-input" disabled />
                    }
                    else
                    {
                        <InputFile @key="fileInputKey" OnChange="OnFileSelected" class="td-file-input" />
                    }
                    @if (selectedFile != null)
                    {
                        <div class="td-selected-file"><i class="bi bi-paperclip"></i> @selectedFile.Name</div>
                    }

                    <div class="d-flex justify-content-end mt-4">
                        <button type="button" class="td-btn td-btn-primary" disabled="@(!isStarted || isClosed || isSavingRecord)" @onclick="SaveRecordAsync">
                            @(isSavingRecord ? "Saving..." : "Save Record")
                        </button>
                    </div>
                </fieldset>
            </div>
    </div>
    <div class="td-col-right-wrap d-flex flex-column" style="gap: 1.5rem;">
        <div class="td-card td-col-right">
                <h3 class="td-card-title">Quick actions</h3>
                <p class="td-card-subtitle">Open these if this visit needs them</p>

                <button type="button" class="td-quick-action" @onclick="OpenSoilSampleCollection">
                    <i class="bi bi-eyedropper"></i> Soil Sample Collection
                </button>
                <button type="button" class="td-quick-action" @onclick="OpenAddFarmerData">
                    <i class="bi bi-person-plus"></i> Add Farmer Data
                </button>
            </div>
        @if (kind == TaskKind.Dealer && dealerRecords.Any())
            {
                <div class="td-card td-col-right" style="padding: 0; overflow: hidden;">
                    <div class="table-responsive">
                        <table class="table mb-0 td-spcm-table">
                            <thead>
                                <tr>
                                    <th>Outcome</th>
                                    <th>Products</th>
                                    <th>Remarks</th>
                                    <th>Support Documents</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var record in dealerRecords)
                                {
                                    <tr>
                                        <td><span class="td-spcm-badge">@record.Outcome</span></td>
                                        <td>@ProductsSummary(record)</td>
                                        <td>@record.Remarks</td>
                                        <td>
                                            <div class="td-spcm-doc d-flex align-items-center justify-content-between w-100 flex-wrap gap-2">
                                                <div><i class="bi bi-paperclip text-muted"></i> <span class="text-dark small">@(record.FileName ?? "No file")</span></div>
                                                <div class="d-flex align-items-center gap-3 fs-5">
                                                    @if (!string.IsNullOrWhiteSpace(record.FilePath))
                                                    {
                                                        <a href="@ResolveFileUrl(record.FilePath)" target="_blank" title="View"><i class="bi bi-eye text-primary"></i></a>
                                                        <a href="@ResolveDownloadUrl(record.FilePath, record.FileName)" title="Download"><i class="bi bi-download text-success"></i></a>
                                                    }
                                                    @if (isStarted && !isClosed)
                                                    {
                                                        <i class="bi bi-pencil text-warning" style="cursor:pointer;" title="Edit" @onclick="() => EditDealerRecord(record)"></i>
                                                        <i class="bi bi-trash text-danger" style="cursor:pointer;" title="Delete" @onclick="() => DeleteRecordAsync(record, dealerRecords)"></i>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        @if (kind == TaskKind.Spcm && spcmRecords.Any())
            {
                <div class="td-card td-col-right" style="padding: 0; overflow: hidden;">
                    <div class="table-responsive">
                        <table class="table mb-0 td-spcm-table">
                            <thead>
                                <tr>
                                    <th>Outcome</th>
                                    <th>Achieved Target</th>
                                    <th>Remarks</th>
                                    <th>Support Documents</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var record in spcmRecords)
                                {
                                    <tr>
                                        <td>
                                            <span class="td-spcm-badge">@record.Outcome</span>
                                        </td>
                                        <td>@(record.AchievedTarget?.ToString() ?? "—")</td>
                                        <td>@record.Remarks</td>
                                        <td>
                                            <div class="td-spcm-doc d-flex align-items-center justify-content-between w-100 flex-wrap gap-2">
                                                <div><i class="bi bi-paperclip text-muted"></i> <span class="text-dark small">@(record.FileName ?? "No file")</span></div>
                                                <div class="d-flex align-items-center gap-3 fs-5">
                                                    @if (!string.IsNullOrWhiteSpace(record.FilePath))
                                                    {
                                                        <a href="@ResolveFileUrl(record.FilePath)" target="_blank" title="View"><i class="bi bi-eye text-primary"></i></a>
                                                        <a href="@ResolveDownloadUrl(record.FilePath, record.FileName)" title="Download"><i class="bi bi-download text-success"></i></a>
                                                    }
                                                    @if (isStarted && !isClosed)
                                                    {
                                                        <i class="bi bi-pencil text-warning" style="cursor:pointer;" title="Edit" @onclick="() => EditSpcmRecord(record)"></i>
                                                        <i class="bi bi-trash text-danger" style="cursor:pointer;" title="Delete" @onclick="() => DeleteRecordAsync(record, spcmRecords)"></i>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        @if (kind == TaskKind.MdProgram && mdProgramRecords.Any())
            {
                <div class="td-card td-col-right" style="padding: 0; overflow: hidden;">
                    <div class="table-responsive">
                        <table class="table mb-0 td-spcm-table">
                            <thead>
                                <tr>
                                    <th>Outcome</th>
                                    <th>Remarks</th>
                                    <th>Support Documents</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var record in mdProgramRecords)
                                {
                                    <tr>
                                        <td><span class="td-spcm-badge">@record.Outcome</span></td>
                                        <td>@record.Remarks</td>
                                        <td>
                                            <div class="td-spcm-doc d-flex align-items-center justify-content-between w-100 flex-wrap gap-2">
                                                <div><i class="bi bi-paperclip text-muted"></i> <span class="text-dark small">@(record.FileName ?? "No file")</span></div>
                                                <div class="d-flex align-items-center gap-3 fs-5">
                                                    @if (!string.IsNullOrWhiteSpace(record.FilePath))
                                                    {
                                                        <a href="@ResolveFileUrl(record.FilePath)" target="_blank" title="View"><i class="bi bi-eye text-primary"></i></a>
                                                        <a href="@ResolveDownloadUrl(record.FilePath, record.FileName)" title="Download"><i class="bi bi-download text-success"></i></a>
                                                    }
                                                    @if (isStarted && !isClosed)
                                                    {
                                                        <i class="bi bi-pencil text-warning" style="cursor:pointer;" title="Edit" @onclick="() => EditMdProgramRecord(record)"></i>
                                                        <i class="bi bi-trash text-danger" style="cursor:pointer;" title="Delete" @onclick="() => DeleteRecordAsync(record, mdProgramRecords)"></i>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        @if (kind == TaskKind.PosLiquidation && posRecords.Any())
            {
                <div class="td-card td-col-right" style="padding: 0; overflow: hidden;">
                    <div class="table-responsive">
                        <table class="table mb-0 td-spcm-table" style="min-width: 900px;">
                            <thead>
                                <tr>
                                    <th>Outcome</th>
                                    <th>Urea</th>
                                    <th>NPKS</th>
                                    <th>DAP</th>
                                    <th>Other</th>
                                    <th>Remarks</th>
                                    <th>Support Documents</th>
                                    <th>Date</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var record in posRecords)
                                {
                                    <tr>
                                        <td><span class="td-spcm-badge">@record.Outcome</span></td>
                                        <td class="text-center fw-bold">@(record.Urea?.ToString() ?? "—")</td>
                                        <td class="text-center fw-bold">@(record.Nps?.ToString() ?? "—")</td>
                                        <td class="text-center fw-bold">@(record.Dap?.ToString() ?? "—")</td>
                                        <td class="text-center fw-bold">@(record.Other?.ToString() ?? "—")</td>
                                        <td>@record.Remarks</td>
                                        <td>
                                            <div class="td-spcm-doc">
                                                <i class="bi bi-paperclip text-muted"></i> <span class="text-dark small">@(record.FileName ?? "No file")</span>
                                            </div>
                                        </td>
                                        <td class="small fw-semibold">@record.CreatedAt.ToString("dd MMM yyyy")</td>
                                        <td>
                                            <div class="d-flex align-items-center gap-3 fs-5 flex-wrap">
                                                @if (!string.IsNullOrWhiteSpace(record.FilePath))
                                                {
                                                    <a href="@ResolveFileUrl(record.FilePath)" target="_blank" title="View"><i class="bi bi-eye text-primary"></i></a>
                                                    <a href="@ResolveDownloadUrl(record.FilePath, record.FileName)" title="Download"><i class="bi bi-download text-success"></i></a>
                                                }
                                                @if (isStarted && !isClosed)
                                                {
                                                    <i class="bi bi-pencil text-warning" style="cursor:pointer;" title="Edit" @onclick="() => EditPosRecord(record)"></i>
                                                    <i class="bi bi-trash text-danger" style="cursor:pointer;" title="Delete" @onclick="() => DeleteRecordAsync(record, posRecords)"></i>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
    </div>
</div>

@if (showAddProductPopup)
{
    <div class="td-modal-overlay">
        <div class="td-modal-card">
            <div class="td-modal-header">
                <h4>Add Product</h4>
                <button type="button" class="td-modal-close" @onclick="CloseAddProductPopup">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="td-modal-body">
                <select class="td-input mb-3" @bind="selectedProductGroupId">
                    <option value="">Select Product Group</option>
                    @foreach (var g in _productGroups)
                    {
                        <option value="@g.Id">@g.Name</option>
                    }
                </select>

                <div class="td-modal-row">
                    <div>
                        <label class="td-field-label" style="margin-top:0;">Product Name</label>
                        <select class="td-input" @bind="selectedProductId">
                            <option value="">Select Product</option>
                            @foreach (var p in _products.Where(x => x.ProductGroupId == selectedProductGroupId))
                            {
                                <option value="@p.Id">@p.Name</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="td-field-label" style="margin-top:0;">Stock</label>
                        <div style="position:relative;">
                           <input type="number" step="any" class="td-input" @bind="stockQty" placeholder="@GetUnitForSelectedProduct()" />
                           <span style="position:absolute; right:12px; top:50%; transform:translateY(-50%); color:#111827; font-size:0.85rem; pointer-events:none;">@GetUnitForSelectedProduct()</span>
                        </div>
                    </div>
                </div>
            </div>
