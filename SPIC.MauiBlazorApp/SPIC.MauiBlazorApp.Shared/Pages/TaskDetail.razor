    // Shared by every "Edit" button above (which removes-then-expects-a-resave) and
    // the trash icon - the removal is now real, not just an in-memory list splice.
    private async Task DeleteRecordAsync(JmdoTaskCloseoutDto record, List<JmdoTaskCloseoutDto> list)
    {
        if (!isStarted || isClosed) return;
        try
        {
            var response = await Http.DeleteAsync($"api/JmdoTaskAllocation/closeouts/{record.Id}");
            if (!response.IsSuccessStatusCode)
            {
                Toast.Error("Could not delete that record.");
                return;
            }

            list.Remove(record);
            ResetFileSelection();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Delete closeout failed: {ex.Message}");
            Toast.Error("Could not delete that record.");
        }
    }

    private IBrowserFile? selectedFile;

    // InputFile wraps a native <input type="file">, and clearing selectedFile in C#
    // does NOT clear what the browser's native file picker still shows - the DOM node
    // has to be torn down and recreated. Bumping this @key on the element does that.
    private int fileInputKey;

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
    }

    private void ResetFileSelection()
    {
        selectedFile = null;
        fileInputKey++;
    }

    private const long MaxCloseoutFileSize = 5 * 1024 * 1024;
    private bool isSavingRecord;

    private async Task SaveRecordAsync()
    {
        if (!isStarted || isClosed)
        {
            Toast.Warning("Please start the task before saving records.");
            return;
        }

        if (isSavingRecord) return;
        isSavingRecord = true;

        try
        {
            string? filePath = null;
            string? fileName = null;

            if (selectedFile != null)
            {
                using var content = new MultipartFormDataContent();
                await using var stream = selectedFile.OpenReadStream(MaxCloseoutFileSize);
                content.Add(new StreamContent(stream), "file", selectedFile.Name);

                var uploadResponse = await Http.PostAsync("api/JmdoTaskAllocation/closeout-files/upload", content);
                if (!uploadResponse.IsSuccessStatusCode)
                {
                    Toast.Error("Could not upload the attached file.");
                    return;
                }

                var uploadResult = await uploadResponse.Content.ReadFromJsonAsync<CloseoutFileUploadResponse>();
                filePath = uploadResult?.FilePath;
                fileName = selectedFile.Name;
            }

            var dto = new CreateJmdoTaskCloseoutDto
            {
                Outcome = outcome,
                Remarks = remarks,
                FilePath = filePath,
                FileName = fileName
            };

            if (kind == TaskKind.Dealer)
            {
                dto.Kind = JmdoCloseoutKind.Dealer;
                dto.SubDealerId = currentDealerId;
                dto.Products = dealerProducts.Select(p => new ProductLineDto
                {
                    ProductGroupId = p.GroupId,
                    ProductId = p.ProductId,
                    ProductGroupName = p.Group,
                    ProductName = p.Name,
                    StockText = p.Stock
                }).ToList();
            }
            else if (kind == TaskKind.Spcm)
            {
                dto.Kind = JmdoCloseoutKind.Spcm;
                dto.AchievedTarget = int.TryParse(achievedTarget, out var at) ? at : null;
            }
            else if (kind == TaskKind.MdProgram)
            {
                dto.Kind = JmdoCloseoutKind.MdProgram;
                dto.Csr1Id = currentProgramId;
            }
            else if (kind == TaskKind.PosLiquidation)
            {
                dto.Kind = JmdoCloseoutKind.PosLiquidation;
                dto.Urea = int.TryParse(posUrea, out var u) ? u : null;
                dto.Nps = int.TryParse(posNps, out var n) ? n : null;
                dto.Dap = int.TryParse(posDap, out var d) ? d : null;
                dto.Other = int.TryParse(posOther, out var o) ? o : null;
            }

            var response = await Http.PostAsJsonAsync("api/JmdoTaskAllocation/closeouts", dto);
            if (!response.IsSuccessStatusCode)
            {
                var errorMsg = "Could not save the record. Please try again.";
                try
                {
                    var errObj = await response.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
                    if (errObj.TryGetProperty("message", out var m) || errObj.TryGetProperty("Message", out m))
                    {
                        var text = m.GetString();
                        if (!string.IsNullOrWhiteSpace(text)) errorMsg = text;
                    }
                }
                catch { }
                Toast.Error(errorMsg);
                return;
            }

            var saved = await response.Content.ReadFromJsonAsync<JmdoTaskCloseoutDto>();
            if (saved != null)
            {
                if (kind == TaskKind.Dealer) dealerRecords.Add(saved);
                else if (kind == TaskKind.Spcm) spcmRecords.Add(saved);
                else if (kind == TaskKind.MdProgram) mdProgramRecords.Add(saved);
                else if (kind == TaskKind.PosLiquidation) posRecords.Add(saved);
            }

            dealerProducts.Clear();
            achievedTarget = "";
            posUrea = posNps = posDap = posOther = "";
            outcome = "Fully Completed";
            remarks = "";
            ResetFileSelection();

            // SPCM/PoS can auto-complete server-side the instant this save pushes the logged
            // count to the weekly target (see CreateCloseout) - re-sync local state right away
            // so the form disables itself without waiting for a page reload.
            if (kind == TaskKind.Spcm || kind == TaskKind.PosLiquidation)
            {
                var wasClosed = isClosed;
                await ReloadAllocationStateAsync();
                Toast.Success(isClosed && !wasClosed
                    ? "Record saved - weekly target reached, task completed!"
                    : "Record saved.");
            }
            else
            {
                Toast.Success("Record saved.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Save closeout failed: {ex.Message}");
            Toast.Error("Could not save the record. Please try again.");
        }
        finally
        {
            isSavingRecord = false;
        }
    }

