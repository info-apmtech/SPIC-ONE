@page "/TaskDetail"
@implements IDisposable
@inject NavigationManager Navigation
@inject SPIC.MauiBlazorApp.Shared.Services.ToastService Toast
@inject SPIC.MauiBlazorApp.Shared.Services.LoginState LoginState

<div class="container-fluid py-4 px-0 td-page">

    <button type="button" class="td-back-link" @onclick='() => Navigation.NavigateTo("/TasksAllocation?tab=today")'>
        <i class="bi bi-arrow-left"></i> Back to Tasks
    </button>

    <span class="td-category-badge">@CategoryLabel</span>
    @if (kind == TaskKind.Dealer)
    {
        <h2 class="td-title">@dynamicTitle</h2>
        <p class="td-subtitle">Pending Ack. 10 mT &middot; Dues 99 Lakhs &middot; @dynamicLocation</p>
    }

    <div class="td-timeline-card">
        <h3 class="td-timeline-title">Task Timeline</h3>
        <div class="td-timeline">
            @for (var i = 0; i < TimelineSteps.Count; i++)
            {
                var step = TimelineSteps[i];
                var index = i;
                <div class="td-timeline-step">
                    <div class="td-timeline-node @(step.Done ? "done" : "pending")">
                        <i class="bi @(step.Done ? "bi-check-lg" : "bi-clock")"></i>
                    </div>
                    <div class="td-timeline-label">@step.Label</div>
                    <div class="td-timeline-sub">@step.SubLabel</div>
                </div>

                @if (index < TimelineSteps.Count - 1)
                {
                    <div class="td-timeline-connector @(step.Done && TimelineSteps[index + 1].Done ? "done" : "")"></div>
                }
            }
        </div>
    </div>

    <div class="td-main-grid">
            @if (kind == TaskKind.Dealer)
            {
                <div class="td-card td-col-left">
                    <h3 class="td-card-title">Task Details</h3>
                    <div class="td-details-grid">
                        <div class="td-detail">
                            <span class="td-detail-label">Dealer / Farmer</span>
                            <span class="td-detail-val">@(dynamicTitle.ToUpperInvariant())</span>
                        </div>
                        <div class="td-detail">
                            <span class="td-detail-label">Task Type</span>
                            <span class="td-detail-val">dealer</span>
                        </div>
                        <div class="td-detail">
                            <span class="td-detail-label">Location</span>
                            <span class="td-detail-val">Coimbatore</span>
                        </div>
                        <div class="td-detail">
                            <span class="td-detail-label">Due Date</span>
                            <span class="td-detail-val">23 Sep 2026</span>
                        </div>
                        <div class="td-detail">
                            <span class="td-detail-label">Priority</span>
                            <span class="td-detail-val">High</span>
                        </div>
                        <div class="td-detail">
                            <span class="td-detail-label">Assigned To</span>
                            <span class="td-detail-val">@(LoginState.UserName ?? "Me")</span>
                        </div>
                    </div>
                </div>
            }

            @if (kind == TaskKind.MdProgram)
            {
                <div class="td-card td-col-left">
                    <h3 class="td-card-title">Program Details</h3>
                    <div class="td-details-grid">
                        <div class="td-detail">
                            <span class="td-detail-label">Program</span>
                            <span class="td-detail-val">@dynamicTitle</span>
                        </div>
                        <div class="td-detail">
                            <span class="td-detail-label">Task Type</span>
                            <span class="td-detail-val">MD Program</span>
                        </div>
                        <div class="td-detail">
                            <span class="td-detail-label">Sanction Date</span>
                            <span class="td-detail-val">01 May 2026</span>
                        </div>
                        <div class="td-detail">
                            <span class="td-detail-label">Sanction No</span>
                            <span class="td-detail-val">CSR1-2026-045</span>
                        </div>
                        <div class="td-detail">
                            <span class="td-detail-label">Program Type</span>
                            <span class="td-detail-val">Training</span>
                        </div>
                        <div class="td-detail">
                            <span class="td-detail-label">Total Budget</span>
                            <span class="td-detail-val">&#8377;50,000</span>
                        </div>
                    </div>
                </div>
            }

            <style>
                .td-main-grid {
                    grid-auto-flow: dense;
                }
            </style>

            <div class="td-card td-col-right">
                <h3 class="td-card-title">Quick actions</h3>
                <p class="td-card-subtitle">Open these if this visit needs them</p>

                <button type="button" class="td-quick-action" @onclick="OpenSoilSampleCollection">
                    <i class="bi bi-eyedropper"></i> Soil Sample Collection
                </button>
                <button type="button" class="td-quick-action" @onclick="OpenAddFarmerData">
                    <i class="bi bi-leaf"></i> Add Farmer Data
                </button>
            </div>

            <div class="td-time-bar td-col-left">
                <div class="td-time-left">
                    <span class="td-time-label">Time on task</span>
                    <span class="td-time-val">@ElapsedDisplay</span>
                </div>
                <div class="td-time-location"><i class="bi bi-geo-alt-fill"></i> Location captured (&plusmn;20m)</div>

                @if (!isStarted)
                {
                    <button type="button" class="td-btn td-btn-primary" @onclick="StartTask">
                        <i class="bi bi-check-circle"></i> Start Task
                    </button>
                }
                else
                {
                    <!-- Sole close action: the close-out form below (Outcome/Remarks/
                         Photo Proof) has no submit button of its own - this is it. -->
                    <button type="button" class="td-btn td-btn-danger" disabled="@isClosed" @onclick="CloseTask">
                        <i class="bi @(isClosed ? "bi-check-circle" : "bi-x-circle")"></i> @(isClosed ? "Task Closed" : "Close Task")
                    </button>
                }
            </div>

            <div class="td-card td-col-left">
                <h3 class="td-card-title">Close-out form</h3>
                <p class="td-card-subtitle">Fill this once work is done, then close the task.</p>

                <label class="td-field-label" for="td-outcome">Outcome<span class="td-required">*</span></label>
                <input id="td-outcome" type="text" class="td-input" @bind="outcome" @bind:event="oninput" disabled="@isClosed" />

                @if (kind == TaskKind.Dealer)
                {
                    <div class="d-flex justify-content-end mb-2 mt-3">
                        <button type="button" class="btn btn-link text-success fw-bold p-0 text-decoration-none" disabled="@isClosed" @onclick="OpenAddProductPopup">
                            + Add another Product
                        </button>
                    </div>

                    @foreach (var prod in dealerProducts)
                    {
                        <div class="td-product-card">
                            <div class="td-product-col">
                                <span class="td-product-label">Product Group</span>
                                <span class="td-product-val">@prod.Group</span>
                            </div>
                            <div class="td-product-col td-border-left">
                                <span class="td-product-label">Product Name</span>
                                <span class="td-product-val">@prod.Name</span>
                            </div>
                            <div class="td-product-col td-border-left">
                                <span class="td-product-label">Stock</span>
                                <span class="td-product-val">@prod.Stock</span>
                            </div>
                        </div>
                    }
                }

                @if (kind == TaskKind.Spcm)
                {
                    <label class="td-field-label" for="td-achieved">Achieved Target</label>
                    <input id="td-achieved" type="number" min="0" class="td-input" placeholder="e.g. 1" @bind="achievedTarget" @bind:event="oninput" disabled="@isClosed" />
                }

                @if (kind == TaskKind.PosLiquidation)
                {
                    <div class="td-pos-grid">
                        <div>
                            <label class="td-field-label" for="td-pos-urea">Urea</label>
                            <input id="td-pos-urea" type="number" min="0" class="td-input" placeholder="e.g. 1" @bind="posUrea" @bind:event="oninput" disabled="@isClosed" />
                        </div>
                        <div>
                            <label class="td-field-label" for="td-pos-nps">NPS</label>
                            <input id="td-pos-nps" type="number" min="0" class="td-input" placeholder="e.g. 1" @bind="posNps" @bind:event="oninput" disabled="@isClosed" />
                        </div>
                        <div>
                            <label class="td-field-label" for="td-pos-dap">DAP</label>
                            <input id="td-pos-dap" type="number" min="0" class="td-input" placeholder="e.g. 1" @bind="posDap" @bind:event="oninput" disabled="@isClosed" />
                        </div>
                        <div>
                            <label class="td-field-label" for="td-pos-other">Other</label>
                            <input id="td-pos-other" type="number" min="0" class="td-input" placeholder="e.g. 1" @bind="posOther" @bind:event="oninput" disabled="@isClosed" />
                        </div>
                    </div>
                }

                <label class="td-field-label" for="td-remarks">Remarks</label>
                <textarea id="td-remarks" class="td-textarea" placeholder="What happened on this visit..." @bind="remarks" disabled="@isClosed"></textarea>

                <label class="td-field-label">@FileFieldLabel</label>
                <input type="file" class="td-file-input" disabled="@isClosed" />
            </div>
    </div>

@if (showAddProductPopup)
{
    <div class="td-modal-overlay">
        <div class="td-modal-card">
            <div class="td-modal-header">
                <h4>Add Product</h4>
                <button type="button" class="td-modal-close" @onclick="CloseAddProductPopup">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="td-modal-body">
                <select class="td-input mb-3" @bind="selectedProductGroupId">
                    <option value="">Select Product Group</option>
                    @foreach (var g in _productGroups)
                    {
                        <option value="@g.Id">@g.Name</option>
                    }
                </select>

                <div class="td-modal-row">
                    <div>
                        <label class="td-field-label" style="margin-top:0;">Product Name</label>
                        <select class="td-input" @bind="selectedProductId">
                            <option value="">Select Product</option>
                            @foreach (var p in _products.Where(x => x.ProductGroupId == selectedProductGroupId))
                            {
                                <option value="@p.Id">@p.Name</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="td-field-label" style="margin-top:0;">Stock</label>
                        <div style="position:relative;">
                           <input type="number" step="any" class="td-input" @bind="stockQty" placeholder="@GetUnitForSelectedProduct()" />
                           <span style="position:absolute; right:12px; top:50%; transform:translateY(-50%); color:#6b7280; font-size:0.85rem; pointer-events:none;">@GetUnitForSelectedProduct()</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="td-modal-footer">
                <button type="button" class="td-btn td-btn-outline" @onclick="CloseAddProductPopup">Cancel</button>
                <button type="button" class="td-btn td-btn-primary" @onclick="ConfirmAddProduct" disabled="@(selectedProductId == null || stockQty <= 0)">Add Product</button>
            </div>
        </div>
    </div>
}

<style>
.td-product-card {
    background: #f8fafc;
    border: 1px solid #86efac;
    border-radius: 8px;
    padding: 12px 16px;
    display: flex;
    gap: 16px;
    margin-bottom: 12px;
}
.td-product-col {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
}
.td-product-col.td-border-left {
    border-left: 1px solid #d1d5db;
    padding-left: 16px;
}
.td-product-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: #15803d;
}
.td-product-val {
    font-size: 0.9rem;
    font-weight: 600;
    color: #111827;
}

.td-modal-overlay {
    position: fixed;
    top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0,0,0,0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1050;
}
.td-modal-card {
    background: #fff;
    border-radius: 12px;
    padding: 24px;
    width: 100%;
    max-width: 480px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.15);
}
.td-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}
.td-modal-header h4 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
    color: #111827;
}
.td-modal-close {
    background: none;
    border: none;
    font-size: 1.5rem;
    color: #9ca3af;
    cursor: pointer;
    line-height: 1;
}
.td-modal-row {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 16px;
}
.td-modal-footer {
    display: flex;
    justify-content: flex-end;
    gap: 12px;
    margin-top: 24px;
}
.td-btn-outline {
    background: #fff;
    border: 1px solid #15803d;
    color: #15803d;
}
.td-btn-outline:hover {
    background: #f0fdf4;
}
</style>

</div>

@code {
    // Which task type opened this page - drives the parts that differ
    // between the Dealer/SPCM/MD Program/PoS Liquidation Figma frames
    // (title/subtitle, category badge text, the details card, the
    // close-out form's extra fields). Soil Sample has no Figma frame yet,
    // so it still just cycles status in place on TasksAllocation.
    private enum TaskKind { Dealer, Spcm, MdProgram, PosLiquidation }

    [SupplyParameterFromQuery(Name = "type")]
    public string? TypeQuery { get; set; }

    [SupplyParameterFromQuery(Name = "id")]
    public string? IdQuery { get; set; }

    [Inject]
    private HttpClient Http { get; set; } = default!;

    private TaskKind kind;
    private string dynamicTitle = "Hanumesh Trading Co";
    private string dynamicCode = "";
    private string dynamicLocation = "Coimbatore";

    private class DealerProductRow
    {
        public string Group { get; set; } = "";
        public string Name { get; set; } = "";
        public string Stock { get; set; } = "";
    }
    
    private List<DealerProductRow> dealerProducts = new()
    {
        new DealerProductRow { Group = "Fertilizers", Name = "Urea 46%", Stock = "250 Bags" },
        new DealerProductRow { Group = "Seeds", Name = "Paddy Seed - CO 51", Stock = "120 Kg" }
    };
    
    private bool showAddProductPopup;
    private int? selectedProductGroupId;
    private int? selectedProductId;
    private decimal stockQty;

    private List<SPIC.Core.Entities.ProductGroup> _productGroups = new();
    private List<SPIC.Core.Entities.Product> _products = new();
    private List<SPIC.Core.Entities.Category> _categories = new();
    private List<SPIC.Core.Entities.Unit> _units = new();

    private void OpenAddProductPopup()
    {
        selectedProductGroupId = null;
        selectedProductId = null;
        stockQty = 0;
        showAddProductPopup = true;
    }

    private void CloseAddProductPopup()
    {
        showAddProductPopup = false;
    }

    private string GetUnitForSelectedProduct()
    {
        if (selectedProductId == null) return "Unit";
        var p = _products.FirstOrDefault(x => x.Id == selectedProductId);
        if (p == null) return "Unit";
        var c = _categories.FirstOrDefault(x => x.Id == p.CategoryId);
        if (c == null) return "Unit";
        var u = _units.FirstOrDefault(x => x.Id == c.UnitId);
        return u?.Name ?? "Unit";
    }

    private void ConfirmAddProduct()
    {
        var p = _products.FirstOrDefault(x => x.Id == selectedProductId);
        var g = _productGroups.FirstOrDefault(x => x.Id == selectedProductGroupId);
        if (p != null)
        {
            dealerProducts.Add(new DealerProductRow
            {
                Group = g?.Name ?? "",
                Name = p.Name,
                Stock = $"{stockQty} {GetUnitForSelectedProduct()}"
            });
        }
        CloseAddProductPopup();
    }

    protected override async Task OnInitializedAsync()
    {
        var assigneeName = LoginState.UserName ?? "Me";
        TimelineSteps[0] = TimelineSteps[0] with { SubLabel = assigneeName };

        kind = TypeQuery?.ToLowerInvariant() switch
        {
            "spcm" => TaskKind.Spcm,
            "mdprogram" => TaskKind.MdProgram,
            "posliquidation" => TaskKind.PosLiquidation,
            _ => TaskKind.Dealer
        };

        if (kind == TaskKind.Dealer)
        {
            try
            {
                var pgTask = Http.GetFromJsonAsync<List<SPIC.Core.Entities.ProductGroup>>("api/ProductGroup");
                var pTask = Http.GetFromJsonAsync<List<SPIC.Core.Entities.Product>>("api/Product");
                var cTask = Http.GetFromJsonAsync<List<SPIC.Core.Entities.Category>>("api/Category");
                var uTask = Http.GetFromJsonAsync<List<SPIC.Core.Entities.Unit>>("api/Unit");

                await Task.WhenAll(pgTask, pTask, cTask, uTask);

                _productGroups = pgTask.Result ?? new();
                _products = pTask.Result ?? new();
                _categories = cTask.Result ?? new();
                _units = uTask.Result ?? new();
            }
            catch { }
        }

        if (kind == TaskKind.Dealer || kind == TaskKind.MdProgram)
        {
            try
            {
                var response = await Http.GetAsync("api/JmdoTaskAllocation/mine/today");
                if (response.IsSuccessStatusCode && response.StatusCode != System.Net.HttpStatusCode.NoContent)
                {
                    var allocation = await response.Content.ReadFromJsonAsync<SPIC.Core.DTOs.JmdoTaskAllocationResponseDto>();
                    if (allocation != null)
                    {
                        if (kind == TaskKind.Dealer && IdQuery?.StartsWith("dealer_") == true)
                        {
                            if (int.TryParse(IdQuery.Substring("dealer_".Length), out var dId))
                            {
                                var dealer = allocation.DealerAssignments.FirstOrDefault(x => x.DealerId == dId);
                                if (dealer != null)
                                {
                                    dynamicTitle = dealer.DealerName;
                                    dynamicCode = dealer.DealerCode;
                                }
                            }
                        }
                        else if (kind == TaskKind.MdProgram && IdQuery?.StartsWith("prog_") == true)
                        {
                            if (int.TryParse(IdQuery.Substring("prog_".Length), out var pId))
                            {
                                var prog = allocation.Programs.FirstOrDefault(x => x.Csr1Id == pId);
                                if (prog != null)
                                {
                                    dynamicTitle = prog.ProgramName;
                                }
                            }
                        }
                    }
                }
            }
            catch { }
        }
    }

    // Each Figma frame used its own casing for this badge (DEALER, SPCM,
    // "MD Program", "Pos liquidation") rather than one shared rule.
    private string CategoryLabel => kind switch
    {
        TaskKind.Dealer => "DEALER",
        TaskKind.Spcm => "SPCM",
        TaskKind.MdProgram => "MD Program",
        TaskKind.PosLiquidation => "Pos liquidation",
        _ => kind.ToString().ToUpperInvariant()
    };

    private string FileFieldLabel => kind == TaskKind.Dealer ? "Photo Proof" : "Supporting Document";

    private string achievedTarget = "";
    private string posUrea = "";
    private string posNps = "";
    private string posDap = "";
    private string posOther = "";

    private sealed record TimelineStep(string Label, string SubLabel, bool Done);

    // Static placeholder: mirrors the Hanumesh Trading Co dealer task from
    // Today's Allocation. The Figma frame's own title said "Malar
    // Fertilizers" while its Task Details panel said "Hanumesh Trading Co" -
    // an internal inconsistency in the mockup - so this uses the name that's
    // consistent with the rest of the app's example data instead.
    private List<TimelineStep> TimelineSteps = new()
    {
        new("Assigned", "", true),
        new("Requested", "By JMDO", true),
        new("Approved", "By RM", true),
        new("Started", "Pending", false),
        new("Closed", "Pending", false)
    };

    private bool isStarted;
    private bool isClosed;
    private int elapsedSeconds;
    private System.Timers.Timer? timer;

    private string ElapsedDisplay => TimeSpan.FromSeconds(elapsedSeconds).ToString(@"mm\:ss");

    private string outcome = "Fully Completed";
    private string remarks = "";

    private void StartTask()
    {
        if (isStarted) return;
        isStarted = true;

        var idx = TimelineSteps.FindIndex(s => s.Label == "Started");
        if (idx >= 0) TimelineSteps[idx] = TimelineSteps[idx] with { SubLabel = "Time & GPS logged", Done = true };

        timer = new System.Timers.Timer(1000) { AutoReset = true };
        timer.Elapsed += (_, _) =>
        {
            elapsedSeconds++;
            InvokeAsync(StateHasChanged);
        };
        timer.Start();

        Toast.Success("Task started - time and location are now being logged.");
    }

    private void CloseTask()
    {
        if (string.IsNullOrWhiteSpace(outcome) || isClosed) return;

        isClosed = true;
        timer?.Stop();

        var idx = TimelineSteps.FindIndex(s => s.Label == "Closed");
        if (idx >= 0) TimelineSteps[idx] = TimelineSteps[idx] with { SubLabel = "Just now", Done = true };

        Toast.Success("Task closed.");
    }

    private void OpenSoilSampleCollection() => Toast.Info("Soil Sample Collection form is not built yet.");

    private void OpenAddFarmerData() => Toast.Info("Add Farmer Data form is not built yet.");

    public void Dispose()
    {
        timer?.Stop();
        timer?.Dispose();
    }
}
