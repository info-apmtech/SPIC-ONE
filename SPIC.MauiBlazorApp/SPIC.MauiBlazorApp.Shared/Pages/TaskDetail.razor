@code {
    // Which task type opened this page - drives the parts that differ
    // between the Dealer/SPCM/MD Program/PoS Liquidation Figma frames
    // (title/subtitle, category badge text, the details card, the
    // close-out form's extra fields). Soil Sample has no Figma frame yet,
    // so it still just cycles status in place on TasksAllocation.
    private enum TaskKind { Dealer, Spcm, MdProgram, PosLiquidation }

    [SupplyParameterFromQuery(Name = "type")]
    public string? TypeQuery { get; set; }

    [SupplyParameterFromQuery(Name = "id")]
    public string? IdQuery { get; set; }

    [Inject]
    private HttpClient Http { get; set; } = default!;

    [Inject]
    private SPIC.MauiBlazorApp.Shared.Services.JMDOAttendanceApi AttendanceApi { get; set; } = default!;

    private TaskKind kind;
    private string dynamicTitle = "Loading...";
    private string dynamicCode = "";

    // The dealer/program this page is scoped to, parsed once from IdQuery -
    // reused by status lookups, close-out record filtering, and saving.
    private int? currentDealerId;
    private int? currentProgramId;
    private JmdoTaskAllocationResponseDto? currentAllocation;

    private class DealerProductRow
    {
        public int? GroupId { get; set; }
        public int? ProductId { get; set; }
        public string Group { get; set; } = "";
        public string Name { get; set; } = "";
        public string Stock { get; set; } = "";
    }

    private List<DealerProductRow> dealerProducts = new();

    private List<JmdoTaskCloseoutDto> dealerRecords = new();
    private List<JmdoTaskCloseoutDto> spcmRecords = new();
    private List<JmdoTaskCloseoutDto> mdProgramRecords = new();
    private List<JmdoTaskCloseoutDto> posRecords = new();

    private string dynamicLocation = "—";
    private string dynamicDueDate = "—";
    private string dynamicPriority = "—";
    private string dynamicPendingAck = "—";
    private string dynamicDues = "—";

    private string dynamicSanctionDate = "—";
    private string dynamicSanctionNo = "—";
    private string dynamicProgramType = "—";
    private string dynamicBudget = "—";

    private bool showAddProductPopup;
    private int? selectedProductGroupId;
    private int? selectedProductId;
    private decimal stockQty;

    private List<SPIC.Core.Entities.ProductGroup> _productGroups = new();
    private List<SPIC.Core.Entities.Product> _products = new();
    private List<SPIC.Core.Entities.Category> _categories = new();
    private List<SPIC.Core.Entities.Unit> _units = new();

    private void OpenAddProductPopup()
    {
        if (!isStarted || isClosed) return;
        selectedProductGroupId = null;
        selectedProductId = null;
        stockQty = 0;
        showAddProductPopup = true;
    }

    private void CloseAddProductPopup()
    {
        showAddProductPopup = false;
    }

    private string GetUnitForSelectedProduct()
    {
        if (selectedProductId == null) return "Unit";
        var p = _products.FirstOrDefault(x => x.Id == selectedProductId);
        if (p == null) return "Unit";
        var c = _categories.FirstOrDefault(x => x.Id == p.CategoryId);
        if (c == null) return "Unit";
        var u = _units.FirstOrDefault(x => x.Id == c.UnitId);
        return u?.Name ?? "Unit";
    }

    private void ConfirmAddProduct()
    {
        var p = _products.FirstOrDefault(x => x.Id == selectedProductId);
        var g = _productGroups.FirstOrDefault(x => x.Id == selectedProductGroupId);
        if (p != null)
        {
            dealerProducts.Add(new DealerProductRow
            {
                GroupId = g?.Id,
                ProductId = p.Id,
                Group = g?.Name ?? "",
                Name = p.Name,
                Stock = $"{stockQty} {GetUnitForSelectedProduct()}"
            });
        }
        CloseAddProductPopup();
    }

    protected override async Task OnInitializedAsync()
    {
        var assigneeName = LoginState.UserName ?? "Me";
        TimelineSteps[0] = TimelineSteps[0] with { SubLabel = assigneeName };

        kind = TypeQuery?.ToLowerInvariant() switch
        {
            "spcm" => TaskKind.Spcm,
            "mdprogram" => TaskKind.MdProgram,
            "posliquidation" => TaskKind.PosLiquidation,
            _ => TaskKind.Dealer
        };

        if (IdQuery?.StartsWith("dealer_", StringComparison.Ordinal) == true
            && int.TryParse(IdQuery.AsSpan("dealer_".Length), out var dId))
        {
            currentDealerId = dId;
        }
        else if (IdQuery?.StartsWith("prog_", StringComparison.Ordinal) == true
            && int.TryParse(IdQuery.AsSpan("prog_".Length), out var pId))
        {
            currentProgramId = pId;
        }

        if (kind == TaskKind.Dealer)
        {
            try
            {
                var pgTask = Http.GetFromJsonAsync<List<SPIC.Core.Entities.ProductGroup>>("api/ProductGroup");
                var pTask = Http.GetFromJsonAsync<List<SPIC.Core.Entities.Product>>("api/Product");
                var cTask = Http.GetFromJsonAsync<List<SPIC.Core.Entities.Category>>("api/Category");
                var uTask = Http.GetFromJsonAsync<List<SPIC.Core.Entities.Unit>>("api/Unit");

                await Task.WhenAll(pgTask, pTask, cTask, uTask);

                _productGroups = pgTask.Result ?? new();
                _products = pTask.Result ?? new();
                _categories = cTask.Result ?? new();
                _units = uTask.Result ?? new();
            }
            catch { }
        }

        currentAllocation = await FetchCurrentAllocationAsync();

        if (currentAllocation != null)
        {
            await ApplyStatusFromAllocationAsync(currentAllocation);
            PopulateCloseoutRecords(currentAllocation);

            if (kind == TaskKind.Dealer && currentDealerId is { } dIdVal)
            {
                var dealer = currentAllocation.DealerAssignments.FirstOrDefault(x => x.DealerId == dIdVal);
                if (dealer != null)
                {
                    dynamicTitle = dealer.DealerName;
                    dynamicCode = dealer.DealerCode;
                    dynamicDueDate = currentAllocation.AllocationDate.ToString("dd MMM yyyy");
                }
            }
            else if (kind == TaskKind.MdProgram && currentProgramId is { } pIdVal)
            {
                var prog = currentAllocation.Programs.FirstOrDefault(x => x.Csr1Id == pIdVal);
                if (prog != null)
                {
                    dynamicTitle = prog.ProgramName;
                }
            }
        }

        if (kind == TaskKind.Dealer && currentDealerId is { } dealerId)
        {
            try
            {
                var dInfo = await Http.GetFromJsonAsync<SPIC.Core.DTOs.DealerBriefDto>($"api/DealerRegistration/{dealerId}/brief");
                if (dInfo != null)
                {
                    dynamicLocation = !string.IsNullOrWhiteSpace(dInfo.Village) ? dInfo.Village :
                                      !string.IsNullOrWhiteSpace(dInfo.Taluk) ? dInfo.Taluk :
                                      !string.IsNullOrWhiteSpace(dInfo.FirmName) ? dInfo.FirmName : "Unknown Location";
                    if (string.IsNullOrWhiteSpace(dynamicTitle) || dynamicTitle == "Loading...")
                        dynamicTitle = dInfo.FirmName ?? dynamicTitle;
                }
            }
            catch { }
        }
        else if (kind == TaskKind.MdProgram && currentProgramId is { } programId)
        {
            try
            {
                var pInfo = await Http.GetFromJsonAsync<SPIC.Core.DTOs.CSR1DetailsDto>($"api/CSR1/details/{programId}");
                if (pInfo != null)
                {
                    if (!string.IsNullOrWhiteSpace(pInfo.ProgramName))
                        dynamicTitle = pInfo.ProgramName;

                    dynamicSanctionDate = pInfo.CSR1Date != default && pInfo.CSR1Date != DateTime.MinValue
                        ? pInfo.CSR1Date.ToString("dd MMM yyyy")
                        : (pInfo.CreatedAt != default ? pInfo.CreatedAt.ToString("dd MMM yyyy") : "—");

                    dynamicSanctionNo = !string.IsNullOrWhiteSpace(pInfo.SanctionNo)
                        ? pInfo.SanctionNo
                        : $"MD-{pInfo.Id}";

                    dynamicProgramType = !string.IsNullOrWhiteSpace(pInfo.ProgramType)
                        ? pInfo.ProgramType
                        : "—";

                    dynamicBudget = pInfo.Budget > 0
                        ? (pInfo.Budget % 1 == 0 ? $"₹{pInfo.Budget:N0}" : $"₹{pInfo.Budget:N2}")
                        : "—";
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"CSR1 details load failed: {ex.Message}");
            }
        }
    }

    // Derives isStarted/isClosed/timeline completion from the real Status on the
    // matching dealer/program row or header field, instead of a shared in-memory
    // dictionary - this is what actually survives navigation, refresh, and re-login.
    private async Task ApplyStatusFromAllocationAsync(JmdoTaskAllocationResponseDto allocation)
    {
        var dealerAssignment = kind == TaskKind.Dealer && currentDealerId is { } d
            ? allocation.DealerAssignments.FirstOrDefault(x => x.DealerId == d)
            : null;
        var programAssignment = kind == TaskKind.MdProgram && currentProgramId is { } p
            ? allocation.Programs.FirstOrDefault(x => x.Csr1Id == p)
            : null;

        // Set by the MDO during review (AllocationRequestReview.razor), not by the JMDO - defaults
        // to Normal, in which case the existing "Priority" row below stays hidden entirely (same
        // dash-check it already used before this field had any real data behind it).
        dynamicPriority = dealerAssignment?.Priority == DealerTaskPriority.High ? "High Priority" : "—";

        var status = kind switch
        {
            TaskKind.Dealer => dealerAssignment?.Status ?? AllocTaskStatus.YetToStart,
            TaskKind.MdProgram => programAssignment?.Status ?? AllocTaskStatus.YetToStart,
            TaskKind.Spcm => allocation.SpcmStatus,
            TaskKind.PosLiquidation => allocation.PosLiquidationStatus,
            _ => AllocTaskStatus.YetToStart
        };

        var startedAt = kind switch
        {
            TaskKind.Dealer => dealerAssignment?.StartedAt,
            TaskKind.MdProgram => programAssignment?.StartedAt,
            TaskKind.Spcm => allocation.SpcmStartedAt,
            TaskKind.PosLiquidation => allocation.PosLiquidationStartedAt,
            _ => null
        };

        var completedAt = kind switch
        {
            TaskKind.Dealer => dealerAssignment?.CompletedAt,
            TaskKind.MdProgram => programAssignment?.CompletedAt,
            TaskKind.Spcm => allocation.SpcmCompletedAt,
            TaskKind.PosLiquidation => allocation.PosLiquidationCompletedAt,
            _ => null
        };

        var startPlaceName = kind switch
        {
            TaskKind.Dealer => dealerAssignment?.StartPlaceName,
            TaskKind.MdProgram => programAssignment?.StartPlaceName,
            TaskKind.Spcm => allocation.SpcmStartPlaceName,
            TaskKind.PosLiquidation => allocation.PosLiquidationStartPlaceName,
            _ => null
        };

        if (status is AllocTaskStatus.InProgress or AllocTaskStatus.Completed)
        {
            // Cached at Start, so a page reload/re-login shows the real address again instead of
            // falling back to the generic "Location captured (+-20m)" text - no live GPS or a
            // second geocoding call needed for this.
            capturedPlaceName = startPlaceName;
        }

        if (status == AllocTaskStatus.InProgress)
        {
            isStarted = true;
            var idx = TimelineSteps.FindIndex(s => s.Label == "Started");
            if (idx >= 0) TimelineSteps[idx] = TimelineSteps[idx] with { SubLabel = "Time & GPS logged", Done = true };

            // Resume the real elapsed time since the task was actually started, instead of
            // counting from 0 on every page load/re-login.
            if (startedAt is { } started)
            {
                elapsedSeconds = Math.Max(0, (int)(DateTime.Now - started).TotalSeconds);
            }
            else
            {
                // This task was marked InProgress before StartedAt existed (or some other
                // gap), so there's no real history to resume from - back-fill it now so
                // every load from this point on resumes correctly.
                var key = TaskKey;
                try
                {
                    await Http.PutAsJsonAsync("api/JmdoTaskAllocation/mine/task-status",
                        new UpdateTaskStatusDto { TaskKey = key, Status = AllocTaskStatus.InProgress });
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Backfilling StartedAt failed: {ex.Message}");
                }
            }

            StartTimer();
        }
        else if (status == AllocTaskStatus.Completed)
        {
            isStarted = true;
            isClosed = true;
            var idx1 = TimelineSteps.FindIndex(s => s.Label == "Started");
            if (idx1 >= 0) TimelineSteps[idx1] = TimelineSteps[idx1] with { SubLabel = "Time & GPS logged", Done = true };
            var idx2 = TimelineSteps.FindIndex(s => s.Label == "Closed");
            if (idx2 >= 0) TimelineSteps[idx2] = TimelineSteps[idx2] with { SubLabel = "Just now", Done = true };

            // "Time on task" for a closed task is the fixed CompletedAt - StartedAt duration,
            // not a running timer. Older records closed before CompletedAt existed have no
            // history to compute from, so back-fill it now (same gap-handling as StartedAt
            // above) - every load from this point on will show the real duration.
            if (startedAt is { } started && completedAt is { } completed)
            {
                elapsedSeconds = Math.Max(0, (int)(completed - started).TotalSeconds);
            }
            else if (completedAt is null)
            {
                var key = TaskKey;
                try
                {
                    await Http.PutAsJsonAsync("api/JmdoTaskAllocation/mine/task-status",
                        new UpdateTaskStatusDto { TaskKey = key, Status = AllocTaskStatus.Completed });
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Backfilling CompletedAt failed: {ex.Message}");
                }
            }
        }
    }

    private void PopulateCloseoutRecords(JmdoTaskAllocationResponseDto allocation)
    {
        dealerRecords = allocation.Closeouts.Where(c => c.Kind == JmdoCloseoutKind.Dealer && c.SubDealerId == currentDealerId).ToList();
        spcmRecords = allocation.Closeouts.Where(c => c.Kind == JmdoCloseoutKind.Spcm).ToList();
        mdProgramRecords = allocation.Closeouts.Where(c => c.Kind == JmdoCloseoutKind.MdProgram && c.Csr1Id == currentProgramId).ToList();
        posRecords = allocation.Closeouts.Where(c => c.Kind == JmdoCloseoutKind.PosLiquidation).ToList();
    }

    private async Task<JmdoTaskAllocationResponseDto?> FetchCurrentAllocationAsync()
    {
        try
        {
            var response = await Http.GetAsync("api/JmdoTaskAllocation/mine/today");
            if (response.IsSuccessStatusCode && response.StatusCode != System.Net.HttpStatusCode.NoContent)
            {
                return await response.Content.ReadFromJsonAsync<JmdoTaskAllocationResponseDto>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Allocation load failed: {ex.Message}");
        }
        return null;
    }

    // Re-syncs isStarted/isClosed/the records lists from the server after saving a close-out
    // record - needed because SPCM/PoS Liquidation can now auto-complete the moment a save
    // pushes the logged count to the weekly target (see CreateCloseout), so the form has to
    // disable itself right away instead of waiting for a page reload to notice.
    private async Task ReloadAllocationStateAsync()
    {
        var allocation = await FetchCurrentAllocationAsync();
        if (allocation == null) return;

        currentAllocation = allocation;
        await ApplyStatusFromAllocationAsync(allocation);
        PopulateCloseoutRecords(allocation);
    }

    private static string ProductsSummary(JmdoTaskCloseoutDto record) =>
        record.Products.Any() ? $"{record.Products.Count} product(s)" : "None";

    // record.FilePath is a relative path served from SpicAPI's own wwwroot (e.g.
    // "/uploads/jmdo-closeouts/..."). The Blazor app runs on a different origin, so a
    // bare relative href resolves against the WRONG server (this app's own address,
    // which has no matching route - that's what was showing a blank/login page instead
    // of the file). Same fix used throughout this codebase: prefix with Http.BaseAddress.
    private string ResolveFileUrl(string? path)
    {
        if (string.IsNullOrWhiteSpace(path)) return "";
        var baseUrl = Http.BaseAddress?.ToString().TrimEnd('/') ?? "";
        return $"{baseUrl}{path}";
    }

    // The HTML5 `download` attribute on a plain <a> is silently ignored by browsers
    // for cross-origin URLs (view and download pointed at the same static file URl
    // both just opened it, identically, instead of actually downloading) - this routes
    // through a controller action that sets Content-Disposition: attachment instead,
    // which forces a real download regardless of origin.
    private string ResolveDownloadUrl(string? path, string? fileName)
    {
        if (string.IsNullOrWhiteSpace(path)) return "";
        var baseUrl = Http.BaseAddress?.ToString().TrimEnd('/') ?? "";
        var query = $"path={Uri.EscapeDataString(path)}";
        if (!string.IsNullOrWhiteSpace(fileName))
            query += $"&fileName={Uri.EscapeDataString(fileName)}";
        return $"{baseUrl}/api/JmdoTaskAllocation/closeout-files/download?{query}";
    }

    // Each Figma frame used its own casing for this badge (DEALER, SPCM,
    // "MD Program", "Pos liquidation") rather than one shared rule.
    private string CategoryLabel => kind switch
    {
        TaskKind.Dealer => "DEALER",
        TaskKind.Spcm => "SPCM",
        TaskKind.MdProgram => "MD Program",
        TaskKind.PosLiquidation => "Pos liquidation",
        _ => kind.ToString().ToUpperInvariant()
    };

    private string FileFieldLabel => kind == TaskKind.Dealer ? "Photo Proof" : "Supporting Document";

    private string achievedTarget = "";
    private string posUrea = "";
    private string posNps = "";
    private string posDap = "";
    private string posOther = "";

    private sealed record TimelineStep(string Label, string SubLabel, bool Done);

    private List<TimelineStep> TimelineSteps = new()
    {
        new("Assigned", "", true),
        new("Requested", "By JMDO", true),
        new("Approved", "By RM", true),
        new("Started", "Pending", false),
        new("Closed", "Pending", false)
    };

    private bool isStarted;
    private bool isClosed;
    private bool isLocationCapturing;
    private double? capturedLatitude;
    private double? capturedLongitude;
    private int? capturedAccuracy;
    private string? capturedPlaceName;
    private int elapsedSeconds;
    private System.Timers.Timer? timer;

    private sealed class GeoResult
    {
        public double Latitude { get; set; }
        public double Longitude { get; set; }
        public int Accuracy { get; set; }
        public string? Error { get; set; }
    }

    private sealed class NominatimReverseResult
    {
        [System.Text.Json.Serialization.JsonPropertyName("display_name")]
        public string? DisplayName { get; set; }
    }

    // Converts a raw GPS fix into the full current address instead of just an accuracy radius -
    // "Location captured (+-108m)" told the reviewer nothing about WHERE the visit happened.
    // Uses OpenStreetMap's free Nominatim reverse-geocoding endpoint (no API key needed, same
    // open-data stack this app already uses for maps via Leaflet) and returns its full
    // "display_name" (house/road through state and postcode), not just a condensed locality -
    // that's the actual full-address string the reviewer asked for. Best-effort: any failure
    // (offline, rate-limited, no address component at all, etc.) falls back to the old
    // accuracy-radius text at the call site.
    private async Task<string?> ResolvePlaceNameAsync(double latitude, double longitude)
    {
        try
        {
            var request = new HttpRequestMessage(HttpMethod.Get,
                $"https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat={latitude}&lon={longitude}&zoom=18");
            request.Headers.UserAgent.ParseAdd("SPICOne/1.0 (+https://apmtechnologies.in)");

            var response = await Http.SendAsync(request);
            if (!response.IsSuccessStatusCode) return null;

            var result = await response.Content.ReadFromJsonAsync<NominatimReverseResult>();
            return !string.IsNullOrWhiteSpace(result?.DisplayName) ? result!.DisplayName : null;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Reverse geocoding failed: {ex.Message}");
            return null;
        }
    }

    private string ElapsedDisplay => TimeSpan.FromSeconds(elapsedSeconds).ToString(@"mm\:ss");

    // SPCM/PoS are weekly count targets, not a single visit - these surface "how much is left"
    // so the JMDO can see progress before saving, instead of finding out only when a save is
    // rejected for exceeding what's left (see CreateCloseout's server-side gate, which is the
    // authoritative check - these are just for display/UX).
    private int SpcmAchievedSoFar => spcmRecords.Sum(r => r.AchievedTarget ?? 0);
    private int SpcmTargetValue => currentAllocation?.SpcmTarget ?? 0;
    private int SpcmRemaining => Math.Max(SpcmTargetValue - SpcmAchievedSoFar, 0);

    private int PosUreaAchievedSoFar => posRecords.Sum(r => r.Urea ?? 0);
    private int PosNpsAchievedSoFar => posRecords.Sum(r => r.Nps ?? 0);
    private int PosDapAchievedSoFar => posRecords.Sum(r => r.Dap ?? 0);
    private int PosOtherAchievedSoFar => posRecords.Sum(r => r.Other ?? 0);
    private int PosUreaTargetValue => currentAllocation?.UreaTarget ?? 0;
    private int PosNpsTargetValue => currentAllocation?.NpsTarget ?? 0;
    private int PosDapTargetValue => currentAllocation?.DapTarget ?? 0;
    private int PosOtherTargetValue => currentAllocation?.OthersTarget ?? 0;

    private string outcome = "Fully Completed";
    private string remarks = "";

    private string TaskKey => kind switch
    {
        TaskKind.Dealer => !string.IsNullOrWhiteSpace(IdQuery) ? IdQuery : (currentDealerId.HasValue ? $"dealer_{currentDealerId}" : "dealer"),
        TaskKind.MdProgram => !string.IsNullOrWhiteSpace(IdQuery) ? IdQuery : (currentProgramId.HasValue ? $"prog_{currentProgramId}" : "mdprogram"),
        TaskKind.Spcm => "spcm",
        TaskKind.PosLiquidation => "pos",
        _ => IdQuery ?? TypeQuery ?? ""
    };

    private async Task StartTask()
    {
        if (isStarted || isLocationCapturing) return;

        // Friendly redirect before even touching the GPS/network work below - the server (PUT
        // mine/task-status) enforces this too (JmdoTaskAllocationController.UpdateMyTaskStatus), so
        // this is purely UX: a JMDO who hasn't marked attendance today lands on MarkAttendance
        // instead of a raw 400. "Loaded" false (a network hiccup on this check itself) falls through
        // to the normal flow below rather than blocking on an inconclusive answer - the server-side
        // check is still authoritative either way.
        var (loaded, todayAttendance) = await AttendanceApi.LoadTodayAsync();
        if (loaded && todayAttendance is null)
        {
            Toast.Warning("Mark today's attendance before starting a task.");
            Navigation.NavigateTo("/MarkAttendance");
            return;
        }

        isLocationCapturing = true;
        StateHasChanged();

        try
        {
            var geo = await JS.InvokeAsync<GeoResult>("getCurrentPosition");
            if (geo != null && string.IsNullOrEmpty(geo.Error) && (geo.Latitude != 0 || geo.Longitude != 0))
            {
                capturedLatitude = geo.Latitude;
                capturedLongitude = geo.Longitude;
                capturedAccuracy = geo.Accuracy > 0 ? geo.Accuracy : 20;
                capturedPlaceName = await ResolvePlaceNameAsync(geo.Latitude, geo.Longitude);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Location capture failed: {ex.Message}");
        }
        finally
        {
            isLocationCapturing = false;
        }

        var key = TaskKey;
        try
        {
            var response = await Http.PutAsJsonAsync("api/JmdoTaskAllocation/mine/task-status",
                new UpdateTaskStatusDto { TaskKey = key, Status = AllocTaskStatus.InProgress, PlaceName = capturedPlaceName });
            if (!response.IsSuccessStatusCode)
            {
                var errorMsg = "Could not start the task. Please try again.";
                try
                {
                    var errObj = await response.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
                    if (errObj.TryGetProperty("message", out var m) || errObj.TryGetProperty("Message", out m))
                    {
                        var text = m.GetString();
                        if (!string.IsNullOrWhiteSpace(text)) errorMsg = text;
                    }
                }
                catch { }
                Toast.Error(errorMsg);
                return;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Start task failed: {ex.Message}");
            Toast.Error("Could not start the task. Please try again.");
            return;
        }

        isStarted = true;

        var idx = TimelineSteps.FindIndex(s => s.Label == "Started");
        if (idx >= 0) TimelineSteps[idx] = TimelineSteps[idx] with { SubLabel = "Time & GPS logged", Done = true };

        StartTimer();

        Toast.Success("Task started - time and location are now being logged.");
    }

    // Shared by StartTask() (fresh start) and ApplyStatusFromAllocation (resuming a task
    // that was already InProgress in the DB from an earlier session) - without this, a
    // page reload/re-login on an in-progress task left isStarted=true but no timer ever
    // running, so "Time on task" stayed frozen at 00:00 even though it was still active.
    // There's no persisted start timestamp, so this counts from 0 on resume rather than
    // recovering the true original elapsed time.
    private void StartTimer()
    {
        if (timer != null) return;

        timer = new System.Timers.Timer(1000) { AutoReset = true };
        timer.Elapsed += (_, _) =>
        {
            elapsedSeconds++;
            InvokeAsync(StateHasChanged);
        };
        timer.Start();
    }

    private bool showStopConfirm;

    private void ConfirmStopTask()
    {
        showStopConfirm = true;
    }

    private void CancelStopTask()
    {
        showStopConfirm = false;
    }

    private async Task StopTask()
    {
        showStopConfirm = false;

        var key = TaskKey;
        try
        {
            var response = await Http.PutAsJsonAsync("api/JmdoTaskAllocation/mine/task-status",
                new UpdateTaskStatusDto { TaskKey = key, Status = AllocTaskStatus.Completed });
            if (!response.IsSuccessStatusCode)
            {
                var errorMsg = "Could not close the task. Please try again.";
                try
                {
                    var errObj = await response.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
                    if (errObj.TryGetProperty("message", out var m) || errObj.TryGetProperty("Message", out m))
                    {
                        var text = m.GetString();
                        if (!string.IsNullOrWhiteSpace(text)) errorMsg = text;
                    }
                }
                catch { }
                Toast.Error(errorMsg);
                return;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Stop task failed: {ex.Message}");
            Toast.Error("Could not close the task. Please try again.");
            return;
        }

        isStarted = false;
        isClosed = true;
        timer?.Stop();
        Toast.Success("Task stopped and closed.");

        var idx = TimelineSteps.FindIndex(s => s.Label == "Closed");
        if (idx >= 0) TimelineSteps[idx] = TimelineSteps[idx] with { SubLabel = "Just now", Done = true };

        Navigation.NavigateTo("/TasksAllocation?tab=completed");
    }

