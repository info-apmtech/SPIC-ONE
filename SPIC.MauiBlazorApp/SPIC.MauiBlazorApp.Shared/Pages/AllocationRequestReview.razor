@page "/AllocationRequestReview"
@using System.Net.Http.Json
@using System.Text.Json
@using SPIC.Core.DTOs
@using SPIC.Core.Entities
@implements IDisposable
@inject NavigationManager Navigation
@inject HttpClient Http
@inject SPIC.MauiBlazorApp.Shared.Services.ToastService Toast
@inject SPIC.MauiBlazorApp.Shared.Services.LoginState LoginState
@inject IJSRuntime JS

<div class="container-fluid py-4 px-0 alreq-page">

    <button type="button" class="alreq-back-link" @onclick='() => Navigation.NavigateTo("/AllocationRequests")'>
        <i class="bi bi-arrow-left"></i> Back to all requests (@TotalPending)
    </button>

    @if (_isLoading)
    {
        <div class="p-3 text-muted">Loading allocation...</div>
    }
    else if (_loadFailed || _detail is null)
    {
        <div class="p-3 text-muted">Couldn't load this allocation. Please go back and try again.</div>
    }
    else
    {
        <div class="alreq-title-row">
            <h2 class="alreq-title">@_detail.JmdoName's Allocation</h2>
            <span class="alreq-status-pill alreq-status-@(_detail.Status.ToLowerInvariant())">@_detail.Status</span>
        </div>
        <p class="alreq-subtitle">Review and approve this JMDO's weekly allocation &mdash; dealer tasks, SPCM &amp; soil sample targets, and MD programs.</p>

        @if (_detail.Status == "Approved")
        {
            <div class="alreq-notice-banner">
                <i class="bi bi-info-circle-fill"></i>
                <span>This allocation was already approved on @(_detail.SubmittedAt.ToString("dd MMM yyyy")). As Admin you can still add/remove dealer tasks, change their date, add/remove MD programs, or adjust targets here if something needs correcting.</span>
            </div>
        }
        else
        {
            <div class="alreq-notice-banner">
                <i class="bi bi-info-circle-fill"></i>
                <span>@_detail.JmdoName submitted this allocation (@_detail.SubmittedAt.ToString("dd MMM yyyy")) for your approval. You can add or remove dealer tasks, pin them to a date, add/remove MD programs, or adjust targets before approving. @OtherPendingCount more JMDO(s) still waiting on your review.</span>
            </div>
        }

        <div class="alreq-card">
            <h3 class="alreq-card-title">Dealer Tasks</h3>

            <div class="alreq-table-scroll">
                <table class="alreq-table">
                    <thead>
                        <tr>
                            <th>Type</th>
                            <th>Party</th>
                            <th>Assign To</th>
                            <th>Date</th>
                            <th>Priority</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var task in _detail.Dealers)
                        {
                            <tr>
                                <td data-label="Type"><span class="alreq-type-pill">Dealer</span></td>
                                <td class="alreq-cell-header">
                                    <div class="alreq-task-code">@task.DealerName</div>
                                    <div class="alreq-task-sub">Dealer Code @task.DealerCode</div>
                                </td>
                                <td data-label="Assign To">
                                    <input type="text" class="alreq-select alreq-assign-select" value="@_detail.JmdoName" disabled title="The whole allocation belongs to this JMDO - tasks within it aren't individually reassignable." />
                                </td>
                                <td data-label="Date">
                                    <input type="date" class="alreq-select alreq-assign-select alreq-date-select"
                                           value="@(task.PlannedDate?.ToString("yyyy-MM-dd"))"
                                           @onchange="e => UpdateDealerPlannedDate(task, e.Value?.ToString())" />
                                </td>
                                <td data-label="Priority">
                                    <select class="alreq-select alreq-assign-select" @bind="task.Priority" @bind:after="() => UpdateDealerPriority(task)">
                                        <option value="@DealerTaskPriority.Normal">Normal</option>
                                        <option value="@DealerTaskPriority.High">High Priority</option>
                                    </select>
                                </td>
                                <td class="alreq-cell-actions">
                                    <button type="button" class="alreq-icon-btn-danger" title="Remove task" @onclick="() => RemoveDealerTask(task)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                        @if (!_detail.Dealers.Any())
                        {
                            <tr><td colspan="6" class="text-muted">No dealer tasks on this allocation.</td></tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="alreq-add-row">
                <div class="alreq-add-field">
                    <label class="alreq-add-label">Add dealer task(s)</label>
                    <select id="alreq-add-dealer-select" class="alreq-select" multiple="multiple">
                        @foreach (var option in AvailableDealers)
                        {
                            <option value="@option.Id">@option.FirmName &mdash; @option.SubDealerCode</option>
                        }
                    </select>
                </div>
                <div class="alreq-add-field alreq-add-field-date">
                    <label class="alreq-add-label">Date</label>
                    <input type="date" class="alreq-select alreq-date-select" @bind="selectedDateToAdd" />
                </div>
                <button type="button" class="alreq-btn-add" @onclick="AddDealerTask">
                    <i class="bi bi-plus-lg"></i> Add
                </button>
            </div>
        </div>

        <div class="alreq-two-col">
            <div class="alreq-card">
                <h3 class="alreq-card-title">This Week's Targets</h3>
                <div class="alreq-target-grid">
                    <div class="alreq-target-field">
                        <label class="alreq-field-label" for="alreq-spcm">SPCM Target</label>
                        <input id="alreq-spcm" type="number" min="0" class="alreq-input" @bind="spcmTarget" @bind:event="onchange" @bind:after="SaveTargets" />
                    </div>
                    <div class="alreq-target-field">
                        <label class="alreq-field-label" for="alreq-soil">Soil Sample Target</label>
                        <input id="alreq-soil" type="number" min="0" class="alreq-input" @bind="soilTarget" @bind:event="onchange" @bind:after="SaveTargets" />
                    </div>
                    <div class="alreq-target-field">
                        <label class="alreq-field-label" for="alreq-urea">Urea</label>
                        <input id="alreq-urea" type="number" min="0" class="alreq-input" @bind="ureaTarget" @bind:event="onchange" @bind:after="SaveTargets" />
                    </div>
                    <div class="alreq-target-field">
                        <label class="alreq-field-label" for="alreq-dap">DAP</label>
                        <input id="alreq-dap" type="number" min="0" class="alreq-input" @bind="dapTarget" @bind:event="onchange" @bind:after="SaveTargets" />
                    </div>
                    <div class="alreq-target-field">
                        <label class="alreq-field-label" for="alreq-nps">NPKS</label>
                        <input id="alreq-nps" type="number" min="0" class="alreq-input" @bind="npsTarget" @bind:event="onchange" @bind:after="SaveTargets" />
                    </div>
                    <div class="alreq-target-field">
                        <label class="alreq-field-label" for="alreq-other">Other</label>
                        <input id="alreq-other" type="number" min="0" class="alreq-input" @bind="otherTarget" @bind:event="onchange" @bind:after="SaveTargets" />
                    </div>
                </div>
            </div>

            <div class="alreq-card">
                <h3 class="alreq-card-title">MD Programs</h3>

                <div class="alreq-chip-list">
                    @foreach (var program in _detail.Programs)
                    {
                        <span class="alreq-chip">
                            <span class="alreq-chip-dot"></span>@program.ProgramName
                            <button type="button" class="alreq-chip-remove" title="Remove program" @onclick="() => RemoveProgramRow(program)">&times;</button>
                        </span>
                    }
                    @if (!_detail.Programs.Any())
                    {
                        <span class="alreq-chip-empty">No programs assigned.</span>
                    }
                </div>
            </div>
        </div>

        <div class="alreq-summary-bar">
            <div class="alreq-summary-text">
                @_detail.Dealers.Count dealer task(s) &middot; SPCM target @Fallback(spcmTarget) &middot; Soil sample target @Fallback(soilTarget) &middot; @_detail.Programs.Count program(s) &middot; @Fallback(ureaTarget)-Urea &middot; @Fallback(dapTarget)-DAP &middot; @Fallback(npsTarget)-NPKS &middot; @Fallback(otherTarget)-Other
            </div>
            <button type="button" class="alreq-btn-approve" disabled="@_isApproving" @onclick="ApproveAllocation">
                <i class="bi bi-check-lg"></i> @(_isApproving ? "Approving..." : "Approve Allocation")
            </button>
        </div>
    }

</div>

@code {
    [SupplyParameterFromQuery(Name = "allocationId")]
    public int? AllocationIdQuery { get; set; }

    private bool _isLoading = true;
    private bool _loadFailed;
    private JmdoAllocationDetailDto? _detail;
    private int TotalPending;
    private int OtherPendingCount => Math.Max(0, TotalPending - 1);

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadPendingCountAsync(), LoadDetailAsync());
    }

    // "Add a dealer task" multiselect - same shared spicSelect2 interop every other page's
    // multiselect uses (see select2-interop.js), not a one-off for this page.
    private DotNetObjectReference<AllocationRequestReview>? _objRef;
    private bool _select2Initialized;
    private static readonly string[] AddDealerSelect2Ids = { "alreq-add-dealer-select" };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_detail is null || _select2Initialized) return;

        try
        {
            _objRef ??= DotNetObjectReference.Create(this);
            await InitAddDealerSelect2Async();
            _select2Initialized = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Select2 init failed: {ex.Message}");
        }
    }

    private Task InitAddDealerSelect2Async() =>
        JS.InvokeVoidAsync("spicSelect2.initMultiple",
            new object[] { new { id = "alreq-add-dealer-select", method = nameof(OnDealerSelectionChanged), parent = (string?)null } },
            _objRef).AsTask();

    // The option list changes after every successful add/remove (a just-added dealer drops out
    // of "available to add") - Select2 doesn't pick up <option> changes on its own, so it has to
    // be destroyed and re-initialized, same pattern as every cascading multiselect elsewhere.
    private async Task RefreshAddDealerSelect2Async()
    {
        if (_objRef is null) return;

        try
        {
            await JS.InvokeVoidAsync("spicSelect2.destroyMultiple", AddDealerSelect2Ids);
            await Task.Delay(50);
            await InitAddDealerSelect2Async();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Select2 refresh failed: {ex.Message}");
        }
    }

    [JSInvokable]
    public void OnDealerSelectionChanged(List<string>? values)
    {
        selectedDealerIdsToAdd = (values ?? new())
            .Select(v => int.TryParse(v, out var id) ? id : 0)
            .Where(id => id > 0)
            .ToList();
    }

    public void Dispose() => _objRef?.Dispose();

    private sealed class PendingCountRow { }

    private async Task LoadPendingCountAsync()
    {
        try
        {
            var pending = await Http.GetFromJsonAsync<List<PendingCountRow>>("api/JmdoTaskAllocation/pending");
            TotalPending = pending?.Count ?? 0;
        }
        catch
        {
            // Non-fatal: only drives the "N more waiting" hint in the banner/back link.
        }
    }

    private async Task LoadDetailAsync()
    {
        if (AllocationIdQuery is not > 0)
        {
            _loadFailed = true;
            _isLoading = false;
            return;
        }

        _isLoading = true;
        _loadFailed = false;
        try
        {
            var detail = await Http.GetFromJsonAsync<JmdoAllocationDetailDto>($"api/JmdoTaskAllocation/{AllocationIdQuery}");
            if (detail == null)
            {
                _loadFailed = true;
                return;
            }

            _detail = detail;
            spcmTarget = detail.SpcmTarget?.ToString() ?? "";
            soilTarget = detail.SoilSampleTarget?.ToString() ?? "";
            ureaTarget = detail.UreaTarget?.ToString() ?? "";
            dapTarget = detail.DapTarget?.ToString() ?? "";
            npsTarget = detail.NpsTarget?.ToString() ?? "";
            otherTarget = detail.OthersTarget?.ToString() ?? "";

            // Calculate PlannedDate from Day if it's null
            foreach (var task in _detail.Dealers)
            {
                if (task.PlannedDate == null && task.Day.HasValue)
                {
                    DateTime weekStart = _detail.SubmittedAt.Date;
                    int diff = (int)weekStart.DayOfWeek;
                    weekStart = weekStart.AddDays(-diff);
                    task.PlannedDate = weekStart.AddDays((int)task.Day.Value);
                    
                    // Fire update to backend silently so it's persisted
                    _ = UpdateDealerPlannedDate(task, task.PlannedDate.Value.ToString("yyyy-MM-dd"));
                }
            }

            await LoadAvailableDealersAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Allocation detail load failed: {ex.Message}");
            _loadFailed = true;
        }
        finally
        {
            _isLoading = false;
        }
    }

    // ---------- Dealer tasks ----------
    private sealed class SubDealerOptionDto
    {
        public int Id { get; set; }
        public string FirmName { get; set; } = "";
        public string SubDealerCode { get; set; } = "";
    }

    private List<SubDealerOptionDto> AvailableDealers = new();
    private List<int> selectedDealerIdsToAdd = new();
    private DateTime selectedDateToAdd = DateTime.Today;

    // Scoped to the allocation's own HQ (falling back to the signed-in MDO's)
    // so the add-dealer list reflects the submitting JMDO's area, not the
    // reviewer's own if they ever differ.
    private async Task LoadAvailableDealersAsync()
    {
        if (_detail is null) return;

        try
        {
            var hqId = _detail.HeadquarterId ?? (LoginState.HQId > 0 ? LoginState.HQId : (int?)null);
            var query = new List<string> { "page=1", "pageSize=1000", $"status={(int)SubDealerStatus.Active}" };
            if (hqId is > 0) query.Add($"hqId={hqId}");

            var url = "api/SubDealerRegistration/list?" + string.Join("&", query);
            var result = await Http.GetFromJsonAsync<SubDealerPagedListResponse>(url);

            AvailableDealers = (result?.Items ?? new())
                .Select(d => new SubDealerOptionDto { Id = d.Id, FirmName = d.FirmName, SubDealerCode = d.SubDealerCode })
                .ToList();

            // The <option> list just changed (a just-added dealer drops out of this list) -
            // no-ops safely before Select2 is first initialized (see OnAfterRenderAsync).
            await RefreshAddDealerSelect2Async();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Available dealer list load failed: {ex.Message}");
        }
    }

    private async Task AddDealerTask()
    {
        if (_detail is null || selectedDealerIdsToAdd.Count == 0) return;

        // Same (dealer, date) check the server enforces in AddDealer - checked here first so an
        // obvious duplicate is rejected instantly instead of waiting on a round trip.
        var alreadyAssigned = selectedDealerIdsToAdd
            .Where(id => _detail.Dealers.Any(d => d.SubDealerId == id && d.PlannedDate?.Date == selectedDateToAdd.Date))
            .ToList();
        if (alreadyAssigned.Count > 0)
        {
            var names = AvailableDealers.Where(d => alreadyAssigned.Contains(d.Id)).Select(d => d.FirmName);
            Toast.Error($"Already assigned on that date: {string.Join(", ", names)}");
            return;
        }

        // No bulk-add endpoint - add one at a time, same AddDealer call the single-select version
        // used, and keep going even if one fails so a single rejected dealer doesn't block the rest.
        var failures = new List<string>();
        foreach (var dealerId in selectedDealerIdsToAdd)
        {
            try
            {
                var dto = new AddDealerToAllocationDto { DealerId = dealerId, PlannedDate = selectedDateToAdd };
                var response = await Http.PostAsJsonAsync($"api/JmdoTaskAllocation/{_detail.Id}/dealers", dto);
                if (!response.IsSuccessStatusCode)
                {
                    var dealerName = AvailableDealers.FirstOrDefault(d => d.Id == dealerId)?.FirmName ?? $"#{dealerId}";
                    failures.Add($"{dealerName}: {await ExtractApiErrorAsync(response, "could not be added")}");
                    continue;
                }

                var row = await response.Content.ReadFromJsonAsync<JmdoAllocationDealerRowDto>();
                if (row != null) _detail.Dealers.Add(row);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Add dealer task failed: {ex.Message}");
                failures.Add($"#{dealerId}: unexpected error");
            }
        }

        if (failures.Count > 0)
            Toast.Error(string.Join("; ", failures));

        selectedDealerIdsToAdd = new();
        await LoadAvailableDealersAsync();
    }

    // The server's BadRequest bodies here are a plain { success, message } object (not the
    // ModelState/Identity-errors shapes other controllers return), so this just needs to pull
    // "message" back out instead of showing a generic toast for an already-specific server reason
    // (e.g. the duplicate-dealer-on-date check in AddDealer/UpdateDealerPlannedDate).
    private static async Task<string> ExtractApiErrorAsync(HttpResponseMessage response, string fallback)
    {
        try
        {
            var body = await response.Content.ReadFromJsonAsync<JsonElement>();
            if (body.ValueKind == JsonValueKind.Object && body.TryGetProperty("message", out var msg)
                && msg.ValueKind == JsonValueKind.String && !string.IsNullOrWhiteSpace(msg.GetString()))
            {
                return msg.GetString()!;
            }
        }
        catch (Exception)
        {
            // Not JSON, or no "message" property - fall back below.
        }

        return fallback;
    }

    private async Task RemoveDealerTask(JmdoAllocationDealerRowDto task)
    {
        if (_detail is null) return;
        try
        {
            var response = await Http.DeleteAsync($"api/JmdoTaskAllocation/{_detail.Id}/dealers/{task.RowId}");
            if (!response.IsSuccessStatusCode)
            {
                Toast.Error("Could not remove that dealer task.");
                return;
            }

            _detail.Dealers.Remove(task);
            await LoadAvailableDealersAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Remove dealer task failed: {ex.Message}");
            Toast.Error("Could not remove that dealer task.");
        }
    }

    private async Task UpdateDealerPlannedDate(JmdoAllocationDealerRowDto task, string? dateValue)
    {
        if (_detail is null) return;
        DateTime? date = DateTime.TryParse(dateValue, out var parsed) ? parsed : null;

        try
        {
            var response = await Http.PutAsJsonAsync($"api/JmdoTaskAllocation/{_detail.Id}/dealers/{task.RowId}/date", new UpdateDealerPlannedDateDto { PlannedDate = date });
            if (!response.IsSuccessStatusCode)
            {
                Toast.Error(await ExtractApiErrorAsync(response, "Could not update the planned date."));
                return;
            }

            task.PlannedDate = date;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Update dealer planned date failed: {ex.Message}");
            Toast.Error("Could not update the planned date.");
        }
    }

    // task.Priority is already the new value by the time this runs (@bind applies it before
    // @bind:after fires) - same "no rollback on failure" behavior as SaveTargets below.
    private async Task UpdateDealerPriority(JmdoAllocationDealerRowDto task)
    {
        if (_detail is null) return;

        try
        {
            var response = await Http.PutAsJsonAsync($"api/JmdoTaskAllocation/{_detail.Id}/dealers/{task.RowId}/priority", new UpdateDealerPriorityDto { Priority = task.Priority });
            if (!response.IsSuccessStatusCode)
                Toast.Error(await ExtractApiErrorAsync(response, "Could not update the dealer's priority."));
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Update dealer priority failed: {ex.Message}");
            Toast.Error("Could not update the dealer's priority.");
        }
    }

    // ---------- MD Programs ----------
    // No "available programs to add" list anymore - MD programs come from CSR1's own
    // ResponsiblePersonId assignment (set when the CSR1 record is created/approved), not from a
    // picker on this review page. Removal stays available for the MDO to exclude a program from
    // this week's work order without touching the underlying CSR1 assignment.
    private async Task RemoveProgramRow(JmdoAllocationProgramRowDto program)
    {
        if (_detail is null) return;
        try
        {
            var response = await Http.DeleteAsync($"api/JmdoTaskAllocation/{_detail.Id}/programs/{program.RowId}");
            if (!response.IsSuccessStatusCode)
            {
                Toast.Error("Could not remove that program.");
                return;
            }

            _detail.Programs.Remove(program);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Remove program failed: {ex.Message}");
            Toast.Error("Could not remove that program.");
        }
    }

    // ---------- Targets ----------
    private string spcmTarget = "";
    private string soilTarget = "";
    private string ureaTarget = "";
    private string dapTarget = "";
    private string npsTarget = "";
    private string otherTarget = "";

    private static int? ParseOrNull(string value) => int.TryParse(value, out var n) ? n : null;

    private async Task SaveTargets()
    {
        if (_detail is null) return;
        try
        {
            var dto = new UpdateAllocationTargetsDto
            {
                SpcmTarget = ParseOrNull(spcmTarget),
                SoilSampleTarget = ParseOrNull(soilTarget),
                UreaTarget = ParseOrNull(ureaTarget),
                DapTarget = ParseOrNull(dapTarget),
                NpsTarget = ParseOrNull(npsTarget),
                OthersTarget = ParseOrNull(otherTarget)
            };

            var response = await Http.PutAsJsonAsync($"api/JmdoTaskAllocation/{_detail.Id}/targets", dto);
            if (!response.IsSuccessStatusCode)
                Toast.Error("Could not save the updated targets.");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Save targets failed: {ex.Message}");
            Toast.Error("Could not save the updated targets.");
        }
    }

    private static string Fallback(string value) => string.IsNullOrWhiteSpace(value) ? "0" : value;

    // ---------- Approve ----------
    private bool _isApproving;

    private async Task ApproveAllocation()
    {
        if (_detail is null || _isApproving) return;
        _isApproving = true;
        try
        {
            var response = await Http.PostAsync($"api/JmdoTaskAllocation/{_detail.Id}/approve", null);
            if (!response.IsSuccessStatusCode)
            {
                Toast.Error("Could not approve this allocation. Please try again.");
                return;
            }

            Toast.Success($"{_detail.JmdoName}'s allocation approved.");
            Navigation.NavigateTo("/AllocationRequests");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Approve allocation failed: {ex.Message}");
            Toast.Error("Could not approve this allocation. Please try again.");
        }
        finally
        {
            _isApproving = false;
        }
    }
}
