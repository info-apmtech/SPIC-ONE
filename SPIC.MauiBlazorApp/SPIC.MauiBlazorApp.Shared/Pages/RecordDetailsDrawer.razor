@if (IsOpen)
{
    <div class="rd-overlay" @onclick="CloseDrawer">
        <div class="rd-drawer" @onclick:stopPropagation="true">
            
            <div class="rd-header">
                <div class="rd-header-titles">
                    <h2>Record Details</h2>
                    <span class="rd-pill-solid-purple">Company Sales</span>
                </div>
                <button class="rd-close-icon" @onclick="CloseDrawer" aria-label="Close">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="15" y1="9" x2="9" y2="15"></line>
                        <line x1="9" y1="9" x2="15" y2="15"></line>
                    </svg>
                </button>
            </div>

            <div class="rd-body">
                
                <div class="rd-section">
                    <h3>Basic Information</h3>
                    <div class="rd-row">
                        <span class="rd-label">Transaction ID</span>
                        <span class="rd-value"><span class="rd-colon">:</span> 100185299086</span>
                    </div>
                    <div class="rd-row">
                        <span class="rd-label">Invoice No</span>
                        <span class="rd-value"><span class="rd-colon">:</span> 3326100255</span>
                    </div>
                    <div class="rd-row">
                        <span class="rd-label">Invoice Date</span>
                        <span class="rd-value"><span class="rd-colon">:</span> 05-04-2026</span>
                    </div>
                    <div class="rd-row">
                        <span class="rd-label">Entry Date</span>
                        <span class="rd-value"><span class="rd-colon">:</span> 05-04-2026</span>
                    </div>
                </div>

                <div class="rd-section">
                    <h3>Dealer / Buyer Information</h3>
                    <div class="rd-row">
                        <span class="rd-label">Dealer Name</span>
                        <span class="rd-value"><span class="rd-colon">:</span> Monsoon Agro Centre</span>
                    </div>
                    <div class="rd-row">
                        <span class="rd-label">Dealer ID</span>
                        <span class="rd-value"><span class="rd-colon">:</span> 223331</span>
                    </div>
                    <div class="rd-row">
                        <span class="rd-label">Dealer Type</span>
                        <span class="rd-value rd-val-flex"><span class="rd-colon">:</span> <span class="rd-pill-outline-purple">Wholesaler</span></span>
                    </div>
                    <div class="rd-row">
                        <span class="rd-label">Mobile No.</span>
                        <span class="rd-value"><span class="rd-colon">:</span> 8765432109</span>
                    </div>
                </div>

                <div class="rd-section">
                    <h3>Location Information</h3>
                    <div class="rd-row">
                        <span class="rd-label">State / District</span>
                        <span class="rd-value"><span class="rd-colon">:</span> Tamil Nadu / Coimbatore</span>
                    </div>
                </div>

                <div class="rd-section">
                    <h3>Product Information</h3>
                    <div class="rd-row">
                        <span class="rd-label">Product</span>
                        <span class="rd-value"><span class="rd-colon">:</span> Neem Coated Urea (45 Kg)</span>
                    </div>
                    <div class="rd-row">
                        <span class="rd-label">Quantity (MT)</span>
                        <span class="rd-value"><span class="rd-colon">:</span> 15.3</span>
                    </div>
                    <div class="rd-row">
                        <span class="rd-label">Received Quantity</span>
                        <span class="rd-value"><span class="rd-colon">:</span> 0</span>
                    </div>
                </div>

                <div class="rd-section">
                    <h3>Payment / Dispatch Information</h3>
                    <div class="rd-row">
                        <span class="rd-label">DD No.</span>
                        <span class="rd-value"><span class="rd-colon">:</span> 1.00153E+11</span>
                    </div>
                </div>

                <div class="rd-section">
                    <h3>Acknowledgement Status</h3>
                    
                    <div class="rd-alert-box">
                        <div class="rd-alert-header">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path>
                                <line x1="12" y1="9" x2="12" y2="13"></line>
                                <line x1="12" y1="17" x2="12.01" y2="17"></line>
                            </svg>
                            Overdue
                        </div>
                        <div class="rd-alert-text">
                            7 days pending<br>
                            Acknowledgement not received yet
                        </div>
                    </div>
                </div>

            </div>

            <div class="rd-footer">
                <button class="rd-btn-outline" @onclick="CloseDrawer">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                    Close
                </button>
              @*   <button class="rd-btn-solid">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                    Acknowledge
                </button> *@
            </div>

        </div>
    </div>
}


@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    private async Task CloseDrawer()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(IsOpen);
    }
}