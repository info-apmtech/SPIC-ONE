@using SPIC.Core.DTOs
@inject IJSRuntime JS

@if (IsOpen)
{
    <div class="rd-overlay" @onclick="CloseDrawer">
        <div class="rd-drawer" @onclick:stopPropagation="true">

            <div class="rd-header">
                <div class="rd-header-titles">
                    <h2>Record Details</h2>
                    <span class="@SourcePillClass">@Val(Row?.Source)</span>
                </div>
                <button class="rd-close-icon" @onclick="CloseDrawer" aria-label="Close">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="15" y1="9" x2="9" y2="15"></line>
                        <line x1="9" y1="9" x2="15" y2="15"></line>
                    </svg>
                </button>
            </div>

            <div class="rd-body">

                <div class="rd-section">
                    <h3>Basic Information</h3>
                    <div class="rd-row">
                        <span class="rd-label">Transaction ID</span>
                        <span class="rd-value"><span class="rd-colon">:</span> @Val(Row?.TransactionId)</span>
                    </div>
                    <div class="rd-row">
                        <span class="rd-label">Invoice No</span>
                        <span class="rd-value"><span class="rd-colon">:</span> @Val(Row?.InvoiceNo)</span>
                    </div>
                    <div class="rd-row">
                        <span class="rd-label">Invoice Date</span>
                        <span class="rd-value"><span class="rd-colon">:</span> @Date(Row?.InvoiceDate)</span>
                    </div>
                    <div class="rd-row">
                        <span class="rd-label">Entry Date</span>
                        <span class="rd-value"><span class="rd-colon">:</span> @Date(Row?.EntryDate)</span>
                    </div>
                </div>

                <div class="rd-section">
                    <h3>Dealer / Buyer Information</h3>
                    <div class="rd-row">
                        <span class="rd-label">Dealer Name</span>
                        <span class="rd-value"><span class="rd-colon">:</span> @Val(Row?.AgencyName)</span>
                    </div>
                    <div class="rd-row">
                        <span class="rd-label">Dealer ID</span>
                        <span class="rd-value"><span class="rd-colon">:</span> @Val(Row?.DealerCode)</span>
                    </div>
                    <div class="rd-row">
                        <span class="rd-label">Dealer Type</span>
                        <span class="rd-value rd-val-flex"><span class="rd-colon">:</span> <span class="rd-pill-outline-purple">@Val(Row?.DealerType)</span></span>
                    </div>
                    <div class="rd-row">
                        <span class="rd-label">Mobile No.</span>
                        <span class="rd-value rd-val-flex">
                            <span class="rd-colon">:</span> @Val(Row?.MobileNo)
                            @if (!string.IsNullOrWhiteSpace(Row?.MobileNo))
                            {
                                <span class="rd-contact-actions">
                                    <button class="rd-contact-btn rd-wa" title="WhatsApp" @onclick="() => OpenWhatsApp(Row!.MobileNo!)">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
                                    </button>
                                    <button class="rd-contact-btn rd-call" title="Call" @onclick="() => Call(Row!.MobileNo!)">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                                    </button>
                                    <button class="rd-contact-btn rd-sms" title="SMS" @onclick="() => SendSms(Row!.MobileNo!)">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                                    </button>
                                </span>
                            }
                        </span>
                    </div>
                </div>

                <div class="rd-section">
                    <h3>Location Information</h3>
                    <div class="rd-row">
                        <span class="rd-label">State / District</span>
                        <span class="rd-value"><span class="rd-colon">:</span> @Val(Row?.StateName) / @Val(Row?.District)</span>
                    </div>
                </div>

                <div class="rd-section">
                    <h3>Product Information</h3>
                    <div class="rd-row">
                        <span class="rd-label">Product</span>
                        <span class="rd-value"><span class="rd-colon">:</span> @Val(Row?.ProductName)</span>
                    </div>
                    <div class="rd-row">
                        <span class="rd-label">Quantity (MT)</span>
                        <span class="rd-value"><span class="rd-colon">:</span> @Num(Row?.QuantityMT)</span>
                    </div>
                    <div class="rd-row">
                        <span class="rd-label">Received Quantity</span>
                        <span class="rd-value"><span class="rd-colon">:</span> @Num(Row?.ReceivedQuantity)</span>
                    </div>
                </div>

                <div class="rd-section">
                    <h3>Payment / Dispatch Information</h3>
                    <div class="rd-row">
                        <span class="rd-label">DD No.</span>
                        <span class="rd-value"><span class="rd-colon">:</span> @Val(Row?.DdNo)</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Row?.DispatchNo))
                    {
                        <div class="rd-row">
                            <span class="rd-label">Dispatch No.</span>
                            <span class="rd-value"><span class="rd-colon">:</span> @Row!.DispatchNo</span>
                        </div>
                    }
                </div>

                <div class="rd-section">
                    <h3>Acknowledgement Status</h3>

                    <div class="rd-alert-box">
                        <div class="rd-alert-header">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path>
                                <line x1="12" y1="9" x2="12" y2="13"></line>
                                <line x1="12" y1="17" x2="12.01" y2="17"></line>
                            </svg>
                            @Val(Row?.AgeStatus)
                        </div>
                        <div class="rd-alert-text">
                            @if (Row?.AgeStatus == "Completed")
                            {
                                <span>Acknowledgement received</span>
                            }
                            else
                            {
                                <span>@(Row?.PendingAckAgeDays ?? 0) days pending</span>
                                <br />
                                <span>Acknowledgement not received yet</span>
                            }
                        </div>
                    </div>
                </div>

            </div>

            <div class="rd-footer">
                <button class="rd-btn-outline" @onclick="CloseDrawer">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                    Close
                </button>
                @*   <button class="rd-btn-solid">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                    Acknowledge
                </button> *@
            </div>

        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public PendingAckRowDto? Row { get; set; }

    // "Company Sales" gets the solid purple pill; wholesaler gets a different one
    // if your CSS has it, otherwise it falls back to the same class.
    private string SourcePillClass =>
        Row?.Source == "Wholesaler Sales" ? "rd-pill-solid-green" : "rd-pill-solid-purple";

    private static string Val(string? s) => string.IsNullOrWhiteSpace(s) ? "-" : s!;
    private static string Date(DateTime? d) => d?.ToString("dd-MM-yyyy") ?? "-";
    private static string Num(decimal? n) => (n ?? 0m).ToString("0.###");

    private async Task CloseDrawer()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(IsOpen);
    }

    // ---- Contact actions (same convention as the Stock drawer) ----

    // Opens a WhatsApp chat. Indian 10-digit numbers get the 91 prefix; numbers
    // that already carry a country code are used as-is.
    private async Task OpenWhatsApp(string number)
    {
        var digits = new string((number ?? "").Where(char.IsDigit).ToArray());
        if (digits.Length == 0) return;

        var wa = digits.Length == 10 ? "91" + digits : digits;
        var msg = Uri.EscapeDataString(
            $"Pending Acknowledgement\nInvoice: {Row?.InvoiceNo}\nDealer: {Row?.AgencyName}\n" +
            $"State/District: {Row?.StateName} / {Row?.District}\nProduct: {Row?.ProductName}\n" +
            $"Quantity: {Row?.QuantityMT} MT\nStatus: {Row?.AgeStatus} ({Row?.PendingAckAgeDays} days pending)");

        await JS.InvokeVoidAsync("open", $"https://wa.me/{wa}?text={msg}", "_blank");
    }

    // Opens the device dialer.
    private async Task Call(string number)
    {
        if (string.IsNullOrWhiteSpace(number)) return;
        await JS.InvokeVoidAsync("open", $"tel:{number}", "_self");
    }

    // Opens the device SMS composer.
    private async Task SendSms(string number)
    {
        if (string.IsNullOrWhiteSpace(number)) return;
        await JS.InvokeVoidAsync("open", $"sms:{number}", "_self");
    }
}
