@page "/home"
@using SPIC.MauiBlazorApp.Shared.Services
@inject IFormFactor FormFactor

@*
    Diagnostic page (not linked from any menu): shows which host and platform
    the shared UI is running on. Kept for support; reachable only by URL.
*@

<PageHeader Title="Diagnostics" Subtitle="Host and platform information for support" />

<div class="hm-page">
    <div class="hm-card">
        <div class="hm-row">
            <span class="hm-label">Form factor</span>
            <span class="hm-value">@factor</span>
        </div>
        <div class="hm-row">
            <span class="hm-label">Platform</span>
            <span class="hm-value">@platform</span>
        </div>
        <div class="hm-row">
            <span class="hm-label">Shared UI</span>
            <span class="hm-value">SPIC ONE</span>
        </div>
    </div>
    <p class="hm-note">This page is for support diagnostics only and is not part of the application menu.</p>
</div>

<style>
    .hm-page { max-width: 560px; }
    .hm-card { background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 4px 16px; }
    .hm-row { display: flex; justify-content: space-between; gap: 12px; padding: 12px 0; border-bottom: 1px solid #f1f5f9; font-size: 0.9rem; }
    .hm-row:last-child { border-bottom: 0; }
    .hm-label { color: #6b7280; font-weight: 600; }
    .hm-value { color: #1f2937; font-weight: 700; text-align: right; overflow-wrap: anywhere; }
    .hm-note { margin-top: 12px; color: #9ca3af; font-size: 0.8rem; }

    /* native: phone */
    @@media (max-width: 767.98px) {
        .hm-page { max-width: none; }
        .hm-row { min-height: var(--tap-min, 44px); align-items: center; }
    }
</style>

@code {
    private string factor => FormFactor.GetFormFactor();
    private string platform => FormFactor.GetPlatform();
}
