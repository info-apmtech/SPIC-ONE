@page "/Treatment02"

<div class="container-fluid py-4 treatment-page">

    <PageHeader Title="Treatment 02"
                Subtitle="Track second treatment details and field observation">
    </PageHeader>


    <div class="section-card previous-treatment-card">

        <div class="reference-header">

            <h6>
                Previous Treatment Reference - Treatment 01
            </h6>

            <button class="view-details-btn">
                View Full Details
            </button>

        </div>


        <div class="grid-4 reference-grid">

            <div>
                <label>Visit Date</label>
                <div class="value">14 Aug 20276</div>
            </div>


            <div>
                <label>Current Plant Stage</label>
                <div class="value">Vegetative Stage</div>
            </div>


            <div>
                <label>Dosage Applied</label>
                <div class="value">Dosage Value</div>
            </div>


            <div>
                <label>Method</label>
                <div class="value">Foliar Spray</div>
            </div>

        </div>


        <div class="grid-2 observation-grid">

            <div>
                <label>Field Observation</label>

                <div class="info-box">
                    Improved branching, Healthy leaf color, Stable growth observed across field
                </div>

            </div>


            <div>
                <label>Yield Parameters</label>

                <div class="info-box">
                    Monitor aphid levels; apply targeted spray if infestation increases
                </div>

            </div>

        </div>

    </div>


    <div class="section-card visit-details-card">

        <h6>Visit Details</h6>


        <div class="visit-grid">

            <div>
                <label>Visit Date</label>
                <input type="date" class="form-control" />
            </div>


            <div>
                <label>Field Officer / Visited By</label>
                <input class="form-control" />
            </div>


            <div>
                <label>Current Plant Stage</label>
                <select class="form-control">
                </select>
            </div>


            <div>
                <label>Plant Condition</label>
                <select class="form-control">
                </select>
            </div>


        </div>

    </div>


    <div class="section-card">

        <h6>Treatment Applied</h6>

        <div class="grid-3">

            <div><label>Product Used</label><select class="form-control"></select></div>
            <div><label>Dosage</label><input class="form-control" /></div>
            <div><label>Application Method</label><select class="form-control"></select></div>
            <div><label>Treatment Date</label><input type="date" class="form-control" /></div>
            <div><label>Stage of Application</label><select class="form-control"></select></div>
            <div><label>Remarks</label><input class="form-control" /></div>

        </div>

    </div>


    <div class="section-card">

        <h6>Observations</h6>

        <div class="grid-2">
            <div><label>Physical Parameters</label><textarea class="form-control"></textarea></div>
            <div><label>Yield Parameters</label><textarea class="form-control"></textarea></div>
        </div>

        <label>Quick Observations</label>
        <div class="chips">
            <span>Increase of More Branches</span>
            <span>Improved Leaf Growth</span>
            <span>Pest Control</span>
            <span>Disease Control</span>
        </div>

        <label>Observation Notes</label>
        <textarea class="form-control"></textarea>

    </div>


    <div class="image-grid">


        <div class="image-card">

            <div class="image-header">

                <h6>Control Images</h6>

                <button class="upload-btn">
                    + Upload Image
                </button>

            </div>


            <div class="upload-box">

                <div class="upload-icon">
                    ☁
                </div>

                <div>
                    Drop images or click to upload
                </div>

                <small>
                    JPG, PNG - Max 10MB
                </small>

            </div>



            <div class="image-preview-list">

                <img src="images/sample1.jpg" />
                <img src="images/sample2.jpg" />
                <img src="images/sample3.jpg" />
                <img src="images/sample4.jpg" />
                <img src="images/sample5.jpg" />

            </div>



            <button class="view-btn">
                View All Images (15)
                <span>›</span>
            </button>


        </div>





        <div class="image-card">


            <div class="image-header">

                <h6>Treated Images</h6>

                <button class="upload-btn">
                    + Upload Image
                </button>

            </div>



            <div class="upload-box">

                <div class="upload-icon">
                    ☁
                </div>

                <div>
                    Drop images or click to upload
                </div>

                <small>
                    JPG, PNG - Max 10MB
                </small>

            </div>




            <div class="image-preview-list">

                <img src="images/sample6.jpg" />
                <img src="images/sample7.jpg" />
                <img src="images/sample8.jpg" />
                <img src="images/sample9.jpg" />
                <img src="images/sample10.jpg" />

            </div>



            <button class="view-btn">
                View All Images (15)
                <span>›</span>
            </button>


        </div>


    </div>


    <div class="section-card problem-card">

        <h6>
            Problem Identification & Recommendation
        </h6>


        <div class="problem-grid">


            <div>
                <label>Problem Observed ?</label>

                <div class="toggle">

                    <button class="active">
                        Yes, problem identified
                    </button>

                    <button>
                        No all looks good
                    </button>

                </div>

            </div>



            <div>
                <label>Problem Category</label>

                <select class="form-control">
                </select>

            </div>




            <div>
                <label>Problem Description</label>

                <input class="form-control" />

            </div>




            <div>
                <label>Severity</label>

                <select class="form-control">
                    <option value="">Select Severity</option>
                    <option value="low">Low</option>
                    <option value="medium">Medium</option>
                    <option value="high">High</option>
                    <option value="critical">Critical</option>
                </select>

            </div>




            <div>
                <label>Recommendation / Monitoring Action</label>

                <input class="form-control" />

            </div>




            <div>
                <label>Action Taken</label>

                <input class="form-control" />

            </div>


        </div>


    </div>


    <div class="actions">
        <button>Save Draft</button>
        <button class="complete">Complete This Treatment</button>
    </div>

</div>
