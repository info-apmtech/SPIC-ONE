@using System.Net.Http.Json
@using SPIC.MauiBlazorApp.Shared.FormFlow
@using SPIC.Core.Entities
@inject NavigationManager Nav
@inject LoadingService Loading
@inject HttpClient Http

@if (CurrentStep is FormStepModel)
{
    <div class="footer-nav">
        <div>
            @if (CurrentIndex > 0)
            {
                <button type="button" class="btn btn-prev" @onclick="GoToPrevious">
                    <i class="bi bi-chevron-left"></i>
                    Previous Step
                </button>
            }
        </div>

        <div>
            @if (CurrentIndex < TotalSteps - 1)
            {
                @if (OnNextClick.HasDelegate)
                {
                    <button type="button"
                            class="btn btn-next"
                            @onclick="OnNextClick"
                            disabled="@IsNextDisabled">
                        @if (IsNextDisabled)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }

                        @(NextButtonText ?? "Next")
                        <i class="bi bi-chevron-right"></i>
                    </button>
                }
                else
                {
                    <button type="button" class="btn btn-next" @onclick="GoToNext">
                        @(NextButtonText ?? "Next")
                        <i class="bi bi-chevron-right"></i>
                    </button>
                }
            }
            else if (!HideFinalSubmit)
            {
                @if (OnNextClick.HasDelegate)
                {
                    <button type="button"
                            class="btn btn-next"
                            @onclick="OnNextClick"
                            disabled="@IsNextDisabled">
                        @if (IsNextDisabled)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }

                        <img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/SendIcon.svg"
                             class="verifyicon"
                             alt="sendicon" />
                        Submit Registration
                    </button>
                }
                else
                {
                    <button type="button" class="btn btn-next">
                        <img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/SendIcon.svg"
                             class="verifyicon"
                             alt="sendicon" />
                        Submit Registration
                    </button>
                }
            }
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback OnNextClick { get; set; }
    [Parameter] public bool IsNextDisabled { get; set; }
    [Parameter] public string? NextButtonText { get; set; }
    [Parameter] public bool HideFinalSubmit { get; set; }

    private FormStepModel? CurrentStep;
    private List<FormStepModel> VisibleSteps = new();
    private string _queryString = string.Empty;
    private bool _hasGreenStar;
    private bool _isRestrictedFlow;
    private bool _isNewDealerFlow;

    private int TotalSteps => VisibleSteps.Count;

    private int CurrentIndex
    {
        get
        {
            if (CurrentStep == null)
                return 0;

            var idx = VisibleSteps.FindIndex(x =>
                x.Route.Equals(CurrentStep.Route, StringComparison.OrdinalIgnoreCase));

            return idx >= 0 ? idx : 0;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        LoadQueryString();
        SetCurrentStep();

        var urlFlow = GetFlowValue();
        var statusRestricted = false;
        _isRestrictedFlow = string.Equals(urlFlow, "restricted", StringComparison.OrdinalIgnoreCase);
        _isNewDealerFlow = string.Equals(urlFlow, "new", StringComparison.OrdinalIgnoreCase);

        var dealerId = GetDealerIdFromQuery();
        if (dealerId > 0)
        {
            try
            {
                var dealer = await Http.GetFromJsonAsync<DealerRegistration>($"api/DealerRegistration/{dealerId}");
                _hasGreenStar = dealer?.InGreenStar ?? false;
                _isNewDealerFlow = _isNewDealerFlow || dealer?.IsNewDealerRegistration == true;

                if (dealer != null)
                {
                    statusRestricted = dealer.Status == DealerStatus.Terminated ||
                        (dealer.Status == DealerStatus.InActive &&
                         dealer.InactiveProposal == FutureBusinessProposal.Terminated);
                }
            }
            catch
            {
                _hasGreenStar = false;
            }
        }

        _isRestrictedFlow = _isRestrictedFlow || statusRestricted;
        _queryString = EnsureFlowParameter(_queryString);
        VisibleSteps = FormStepData.GetVisibleSteps(_hasGreenStar, _isRestrictedFlow);
    }

    private string? GetFlowValue()
    {
        var values = GetQueryValues();
        return values.TryGetValue("flow", out var flow) ? flow : null;
    }

    private void LoadQueryString()
    {
        var baseRelative = Nav.ToBaseRelativePath(Nav.Uri);
        var qIndex = baseRelative.IndexOf('?');
        _queryString = qIndex >= 0 ? baseRelative[qIndex..] : string.Empty;
    }

    private void SetCurrentStep()
    {
        var baseRelative = Nav.ToBaseRelativePath(Nav.Uri);
        var relativePath = "/" + baseRelative.Split('?')[0];
        CurrentStep = FormStepData.GetStepByRoute(relativePath);
    }

    private int GetDealerIdFromQuery()
    {
        var values = GetQueryValues();
        return values.TryGetValue("dealerId", out var value) &&
               int.TryParse(value, out var id) && id > 0
            ? id
            : 0;
    }

    private Dictionary<string, string> GetQueryValues()
    {
        var baseRelative = Nav.ToBaseRelativePath(Nav.Uri);
        var qIndex = baseRelative.IndexOf('?');
        if (qIndex < 0)
            return new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

        return baseRelative[(qIndex + 1)..]
            .Split('&', StringSplitOptions.RemoveEmptyEntries)
            .Select(p => p.Split('=', 2))
            .Where(p => p.Length == 2)
            .GroupBy(p => p[0], StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g => Uri.UnescapeDataString(g.Last()[1]), StringComparer.OrdinalIgnoreCase);
    }

    private void GoToPrevious()
    {
        if (CurrentStep == null)
            return;

        Loading.Show();
        var previousRoute = FormStepData.GetPreviousRoute(
            CurrentStep.Route,
            _hasGreenStar,
            _isRestrictedFlow);

        Nav.NavigateTo(previousRoute + _queryString);
    }

    private void GoToNext()
    {
        if (CurrentStep == null)
            return;

        Loading.Show();
        var nextRoute = FormStepData.GetNextRoute(
            CurrentStep.Route,
            _hasGreenStar,
            _isRestrictedFlow);

        Nav.NavigateTo(nextRoute + _queryString);
    }

    private string EnsureFlowParameter(string queryString)
    {
        if (_isRestrictedFlow && !queryString.Contains("flow=restricted", StringComparison.OrdinalIgnoreCase))
            return AppendQuery(queryString, "flow=restricted");

        if (_isNewDealerFlow && !queryString.Contains("flow=new", StringComparison.OrdinalIgnoreCase))
            return AppendQuery(queryString, "flow=new");

        return queryString;
    }

    private static string AppendQuery(string queryString, string value) =>
        queryString + (queryString.Contains('?') ? "&" : "?") + value;
}
