@code {

    // =========================================================
    // PARAMETERS
    // =========================================================

    [Parameter]
    public int CSR1Id { get; set; }

    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    [Parameter]
    public EventCallback OnStatusChanged { get; set; }


    // =========================================================
    // STATE
    // =========================================================

    private CSR1DetailsDto? details;

    private bool isLoading = false;

    private int lastLoadedId = 0;

    private bool isActionInProgress = false;
    private bool showRejectModal = false;
    private string rejectionRemarks = "";
    private string rejectErrorMessage = "";


    // =========================================================
    // PARAMETER CHANGE
    // =========================================================

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen &&
            CSR1Id > 0 &&
            CSR1Id != lastLoadedId)
        {
            await LoadCSR1Details();
        }
    }


    // =========================================================
    // LOAD DETAILS
    // =========================================================

    private async Task LoadCSR1Details()
    {
        try
        {
            isLoading = true;

            details =
                await Http.GetFromJsonAsync<CSR1DetailsDto>(
                    $"api/CSR1/details/{CSR1Id}");

            lastLoadedId =
                CSR1Id;
        }
        catch (Exception ex)
        {
            details = null;

            Console.WriteLine(
                $"CSR1 Details Load Error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }


    // =========================================================
    // FOCUS CROPS
    // =========================================================

    private List<string> AllFocusCrops
    {
        get
        {
            if (details == null)
                return new();

            return details.Focus1
                .Concat(details.Focus2)
                .Concat(details.Focus3)
                .Where(x =>
                    !string.IsNullOrWhiteSpace(x.CropName))
                .Select(x =>
                    x.CropName.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
    }


    // =========================================================
    // FOCUS PRODUCTS
    // =========================================================

    private List<string> AllFocusProducts
    {
        get
        {
            if (details == null)
                return new();

            return details.Focus1
                .Concat(details.Focus2)
                .Concat(details.Focus3)
                .Where(x =>
                    !string.IsNullOrWhiteSpace(x.ProductName))
                .Select(x =>
                    x.ProductName.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
    }


    // =========================================================
    // STATUS FLOW & WORKFLOW ELIGIBILITY
    // =========================================================

    private bool IsSubmittedOrLater =>
        details != null &&
        !string.Equals(
            details.Status,
            "Draft",
            StringComparison.OrdinalIgnoreCase);

    private bool IsHQScope =>
        string.Equals(details?.Scope, "HQ", StringComparison.OrdinalIgnoreCase) ||
        (details?.HeadquarterId.HasValue == true && details.HeadquarterId.Value > 0);

    private bool IsStateScope => !IsHQScope;

    private bool CanValidate =>
        details != null &&
        (string.Equals(details.Status, "SubmittedForValidation", StringComparison.OrdinalIgnoreCase) ||
         string.Equals(details.Status, "Submitted", StringComparison.OrdinalIgnoreCase) ||
         string.Equals(details.Status, "Pending", StringComparison.OrdinalIgnoreCase)) &&
        (loginState.IsAdmin ||
         (IsHQScope && loginState.UserRole == AppRole.MO) ||
         (IsStateScope && loginState.UserRole == AppRole.SMD));

    private bool CanApprove =>
        details != null &&
        (string.Equals(details.Status, "Validated", StringComparison.OrdinalIgnoreCase) ||
         (loginState.IsAdmin && (string.Equals(details.Status, "SubmittedForValidation", StringComparison.OrdinalIgnoreCase) ||
                                string.Equals(details.Status, "Validated", StringComparison.OrdinalIgnoreCase)))) &&
        (loginState.IsAdmin ||
         (IsHQScope && (loginState.UserRole == AppRole.RM || loginState.UserRole == AppRole.RMD)) ||
         (IsStateScope && loginState.UserRole == AppRole.SMM));

    private bool IsAwaitingValidation =>
        details != null &&
        (string.Equals(details.Status, "SubmittedForValidation", StringComparison.OrdinalIgnoreCase) ||
         string.Equals(details.Status, "Submitted", StringComparison.OrdinalIgnoreCase) ||
         string.Equals(details.Status, "Pending", StringComparison.OrdinalIgnoreCase)) &&
        ((IsHQScope && (loginState.UserRole == AppRole.RM || loginState.UserRole == AppRole.RMD)) ||
         (IsStateScope && loginState.UserRole == AppRole.SMM));

    private bool CanReject =>
        details != null &&
        !string.Equals(details.Status, "Approved", StringComparison.OrdinalIgnoreCase) &&
        !string.Equals(details.Status, "Rejected", StringComparison.OrdinalIgnoreCase) &&
        !string.Equals(details.Status, "Draft", StringComparison.OrdinalIgnoreCase) &&
        (loginState.IsAdmin ||
         (IsHQScope && (loginState.UserRole == AppRole.MO || loginState.UserRole == AppRole.RM || loginState.UserRole == AppRole.RMD)) ||
         (IsStateScope && (loginState.UserRole == AppRole.SMD || loginState.UserRole == AppRole.SMM)));

    private async Task ValidateCSR1()
    {
        if (details == null || isActionInProgress) return;
        try
        {
            isActionInProgress = true;
            var response = await Http.PostAsync($"api/CSR1/{details.Id}/validate", null);
            if (response.IsSuccessStatusCode)
            {
                Toast.Success("CSR-1 validated successfully.");
                await LoadCSR1Details();
                await OnStatusChanged.InvokeAsync();
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                Toast.Error(string.IsNullOrWhiteSpace(err) ? "Failed to validate CSR-1." : err);
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Error validating CSR-1: {ex.Message}");
        }
        finally
        {
            isActionInProgress = false;
        }
    }

    private async Task ApproveCSR1()
    {
        if (details == null || isActionInProgress) return;
        try
        {
            isActionInProgress = true;
            var response = await Http.PostAsync($"api/CSR1/{details.Id}/approve", null);
            if (response.IsSuccessStatusCode)
            {
                Toast.Success("CSR-1 approved successfully.");
                await LoadCSR1Details();
                await OnStatusChanged.InvokeAsync();
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                Toast.Error(string.IsNullOrWhiteSpace(err) ? "Failed to approve CSR-1." : err);
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Error approving CSR-1: {ex.Message}");
        }
        finally
        {
            isActionInProgress = false;
        }
    }

    private void OpenRejectModal()
    {
        rejectionRemarks = "";
        rejectErrorMessage = "";
        showRejectModal = true;
    }

    private void CloseRejectModal()
    {
        showRejectModal = false;
        rejectionRemarks = "";
        rejectErrorMessage = "";
    }

    private async Task SubmitRejection()
    {
        if (details == null || isActionInProgress) return;
        if (string.IsNullOrWhiteSpace(rejectionRemarks))
        {
            rejectErrorMessage = "Please enter rejection remarks.";
            return;
        }

        try
        {
            isActionInProgress = true;
            var request = new CSR1RejectRequest { Remarks = rejectionRemarks.Trim() };
            var response = await Http.PostAsJsonAsync($"api/CSR1/{details.Id}/reject", request);
            if (response.IsSuccessStatusCode)
            {
                Toast.Success("CSR-1 rejected successfully.");
                showRejectModal = false;
                await LoadCSR1Details();
                await OnStatusChanged.InvokeAsync();
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                rejectErrorMessage = string.IsNullOrWhiteSpace(err) ? "Failed to reject CSR-1." : err;
                Toast.Error(rejectErrorMessage);
            }
        }
        catch (Exception ex)
        {
            rejectErrorMessage = ex.Message;
            Toast.Error($"Error rejecting CSR-1: {ex.Message}");
        }
        finally
        {
            isActionInProgress = false;
        }
    }

    private string GetHeaderStatusClass(
        string? status)
    {
        var css =
            status?.Trim().ToLowerInvariant() switch
            {
                "approved" =>
                    "csr-pd-status-approved",

                "validated" =>
                    "csr-pd-status-validated",

                "rejected" =>
                    "csr-pd-status-rejected",

                "submittedforvalidation" =>
                    "csr-pd-status-pending",

                "submitted" =>
                    "csr-pd-status-pending",

                "pending" =>
                    "csr-pd-status-pending",

                _ =>
                    "csr-pd-status-default"
            };

        return $"csr-pd-status {css}";
    }


    private string GetStatusDisplay(
        string? status)
    {
        if (string.Equals(
            status,
            "SubmittedForValidation",
            StringComparison.OrdinalIgnoreCase))
        {
            return "Pending";
        }

        return string.IsNullOrWhiteSpace(status)
            ? "-"
            : status;
    }


    // =========================================================
    // FORMATTING
    // =========================================================

    private string FormatAmount(
        decimal value)
    {
        return $"₹ {value.ToString(
            "N0",
            CultureInfo.CreateSpecificCulture("en-IN"))}";
    }


    private string ShowValue(
        string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "-"
            : value;
    }


    // =========================================================
    // EXPENSE ROW
    // =========================================================

    private RenderFragment ExpenseRow(
        string label,
        decimal value) =>
        @<div class="csr-pd-expense-row">

            <span>
                @label
            </span>

            <strong>
                @FormatAmount(value)
            </strong>

        </div>;


    // =========================================================
    // CLOSE
    // =========================================================

    private async Task CloseDrawer()
    {
        IsOpen = false;

        await IsOpenChanged.InvokeAsync(false);
    }


    // =========================================================
    // CSR2
    // =========================================================

    private void OpenCsr2()
    {
        NavigationManager.NavigateTo(
            "/CSR-2ProgramExecution");
    }
}