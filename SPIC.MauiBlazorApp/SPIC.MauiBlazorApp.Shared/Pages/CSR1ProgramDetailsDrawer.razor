@if (IsOpen)
{
    <div class="csr-pd-overlay" @onclick="CloseDrawer">
        <div class="csr-pd-drawer" @onclick:stopPropagation="true">
            
            <div class="csr-pd-header">
                <div class="csr-pd-header-titles">
                    <h2>CSR-1 Program Details</h2>
                    <p>Crop Protection Workshop</p>
                </div>
                <button class="csr-pd-close-icon" @onclick="CloseDrawer" aria-label="Close">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>

            <div class="csr-pd-body">
                
                <div class="csr-pd-section">
                    <h3>Program Information</h3>
                    <div class="csr-pd-info-box">
                        <div class="csr-pd-row">
                            <span class="csr-pd-label">Program Type:</span>
                            <span class="csr-pd-value">Training</span>
                        </div>
                        <div class="csr-pd-row">
                            <span class="csr-pd-label">Program Name:</span>
                            <span class="csr-pd-value">Crop Protection Workshop</span>
                        </div>
                        <div class="csr-pd-row">
                            <span class="csr-pd-label">Status:</span>
                            <span class="csr-pd-value">
                                <span class="csr-pd-badge csr-pd-badge-approved">Approved</span>
                            </span>
                        </div>
                        <div class="csr-pd-row">
                            <span class="csr-pd-label">Sanction Number:</span>
                            <span class="csr-pd-value">CSR1-2026-045</span>
                        </div>
                    </div>
                </div>

                <div class="csr-pd-section">
                    <h3>Location Details</h3>
                    <div class="csr-pd-info-box">
                        <div class="csr-pd-row">
                            <span class="csr-pd-label">District:</span>
                            <span class="csr-pd-value">Pune</span>
                        </div>
                        <div class="csr-pd-row">
                            <span class="csr-pd-label">HQ:</span>
                            <span class="csr-pd-value">Pune, Maharashtra</span>
                        </div>
                    </div>
                </div>

                <div class="csr-pd-section">
                    <h3>Budget Details</h3>
                    <div class="csr-pd-info-box">
                        <div class="csr-pd-row">
                            <span class="csr-pd-label">Total Budget:</span>
                            <span class="csr-pd-value csr-pd-font-bold">₹50,000</span>
                        </div>
                    </div>
                </div>

                <div class="csr-pd-section">
                    <h3>Expense Breakdown</h3>
                    <div class="csr-pd-info-box">
                        <div class="csr-pd-row">
                            <span class="csr-pd-label">Printing & Stationary:</span>
                            <span class="csr-pd-value">₹5,000</span>
                        </div>
                        <div class="csr-pd-row">
                            <span class="csr-pd-label">Publicity Material:</span>
                            <span class="csr-pd-value">₹8,000</span>
                        </div>
                        <div class="csr-pd-row">
                            <span class="csr-pd-label">Stage Arrangements:</span>
                            <span class="csr-pd-value">₹12,000</span>
                        </div>
                        <div class="csr-pd-row">
                            <span class="csr-pd-label">Service Charges - LCA:</span>
                            <span class="csr-pd-value">₹7,000</span>
                        </div>
                        <div class="csr-pd-row">
                            <span class="csr-pd-label">Transport / Rent:</span>
                            <span class="csr-pd-value">₹6,000</span>
                        </div>
                        <div class="csr-pd-row">
                            <span class="csr-pd-label">Jeep Running Expenses:</span>
                            <span class="csr-pd-value">₹4,000</span>
                        </div>
                        <div class="csr-pd-row">
                            <span class="csr-pd-label">Refreshments:</span>
                            <span class="csr-pd-value">₹5,000</span>
                        </div>
                        <div class="csr-pd-row">
                            <span class="csr-pd-label">Inputs:</span>
                            <span class="csr-pd-value">₹0</span>
                        </div>
                        <div class="csr-pd-row">
                            <span class="csr-pd-label">Photography:</span>
                            <span class="csr-pd-value">₹2,000</span>
                        </div>
                        <div class="csr-pd-row">
                            <span class="csr-pd-label">Compliments:</span>
                            <span class="csr-pd-value">₹1,000</span>
                        </div>
                        <div class="csr-pd-row">
                            <span class="csr-pd-label">Others:</span>
                            <span class="csr-pd-value">₹0</span>
                        </div>
                        <div class="csr-pd-row csr-pd-expense-total">
                            <span class="csr-pd-label" style="font-weight: 700; color: #1e293b;">Total:</span>
                            <span class="csr-pd-value csr-pd-font-bold">₹50,000</span>
                        </div>
                    </div>
                </div>

                <div class="csr-pd-section">
                    <h3>Focus Areas</h3>
                    <div class="csr-pd-info-box">
                        <div class="csr-pd-row" style="align-items: flex-start; gap: 12px; line-height: normal;">
                            <span class="csr-pd-label">Focused Crops:</span>
                            <span class="csr-pd-value">
                                <span class="csr-pd-pill csr-pd-pill-green">Cotton</span>
                                <span class="csr-pd-pill csr-pd-pill-green">Wheat</span>
                                <span class="csr-pd-pill csr-pd-pill-green">Sugarcane</span>
                            </span>
                        </div>
                        <div class="csr-pd-row" style="align-items: flex-start; gap: 12px; line-height: normal;">
                            <span class="csr-pd-label">Focused Products:</span>
                            <span class="csr-pd-value">
                                <span class="csr-pd-pill csr-pd-pill-blue">Insecticide A</span>
                                <span class="csr-pd-pill csr-pd-pill-blue">Fungicide B</span>
                                <span class="csr-pd-pill csr-pd-pill-blue">Herbicide C</span>
                            </span>
                        </div>
                    </div>
                </div>

                <div class="csr-pd-section">
                    <h3>Budget Details</h3>
                    <div class="csr-pd-timeline">
                        <div class="csr-pd-tl-item">
                            <div class="csr-pd-tl-line"></div>
                            <div class="csr-pd-tl-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                            </div>
                            <div class="csr-pd-tl-content">
                                <h4>Created</h4>
                                <div class="csr-pd-tl-meta">
                                    <span>John Doe (MO)</span>
                                    <span class="csr-pd-date-pill">May 1, 2026</span>
                                </div>
                            </div>
                        </div>
                        <div class="csr-pd-tl-item">
                            <div class="csr-pd-tl-line"></div>
                            <div class="csr-pd-tl-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                            </div>
                            <div class="csr-pd-tl-content">
                                <h4>Submitted</h4>
                                <div class="csr-pd-tl-meta">
                                    <span>John Doe (MO)</span>
                                    <span class="csr-pd-date-pill">May 1, 2026</span>
                                </div>
                            </div>
                        </div>
                        <div class="csr-pd-tl-item">
                            <div class="csr-pd-tl-line"></div>
                            <div class="csr-pd-tl-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                            </div>
                            <div class="csr-pd-tl-content">
                                <h4>Validated</h4>
                                <div class="csr-pd-tl-meta">
                                    <span>Regional MD</span>
                                    <span class="csr-pd-date-pill">May 1, 2026</span>
                                </div>
                            </div>
                        </div>
                        <div class="csr-pd-tl-item">
                            <div class="csr-pd-tl-line"></div>
                            <div class="csr-pd-tl-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                            </div>
                            <div class="csr-pd-tl-content">
                                <h4>Approved</h4>
                                <div class="csr-pd-tl-meta">
                                    <span>State MD</span>
                                    <span class="csr-pd-date-pill">May 1, 2026</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="csr-pd-section">
                    <h3>Status History</h3>
                    <div class="csr-pd-info-box">
                        <div class="csr-pd-row">
                            <span class="csr-pd-label">Submitted Date:</span>
                            <span class="csr-pd-value">May 1, 2026</span>
                        </div>
                        <div class="csr-pd-row">
                            <span class="csr-pd-label">Validation Due:</span>
                            <span class="csr-pd-value">May 10, 2026</span>
                        </div>
                    </div>
                </div>

            </div>

            <div class="csr-pd-footer">
                <button class="csr-pd-btn-action csr-pd-btn-dark">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                        <polyline points="15 3 21 3 21 9"></polyline>
                        <line x1="10" y1="14" x2="21" y2="3"></line>
                    </svg>
                    Open CSR-2
                </button>
                <button class="csr-pd-btn-action csr-pd-btn-green">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 6 2 18 2 18 9"></polyline>
                        <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                        <rect x="6" y="14" width="12" height="8"></rect>
                    </svg>
                    Print
                </button>
                <button class="csr-pd-btn-action csr-pd-btn-blue">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="7 10 12 15 17 10"></polyline>
                        <line x1="12" y1="15" x2="12" y2="3"></line>
                    </svg>
                    Export PDF
                </button>
            </div>

        </div>
    </div>
}


@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    private async Task CloseDrawer()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(IsOpen);
    }
}