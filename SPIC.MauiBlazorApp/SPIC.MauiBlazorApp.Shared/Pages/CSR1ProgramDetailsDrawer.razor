@using System.Net.Http.Json
@using System.Globalization
@using SPIC.Core.DTOs
@using SPIC.Core.Entities

@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject SPIC.MauiBlazorApp.Shared.Services.LoginState loginState


@if (IsOpen)
{
    <div class="csr-pd-overlay" @onclick="CloseDrawer">

        <div class="csr-pd-drawer"
             @onclick:stopPropagation="true">

            @if (isLoading)
            {
                <div class="csr-pd-loading">
                    <div class="spinner-border spinner-border-sm"></div>
                    <span>Loading CSR-1 details...</span>
                </div>
            }
            else if (details == null)
            {
                <div class="csr-pd-loading">
                    Unable to load CSR-1 details.
                </div>
            }
            else
            {
                @* ================================================= *@
                @* HEADER                                            *@
                @* ================================================= *@

                <div class="csr-pd-header">

                    <div>
                        <h2>CSR-1 Program Details</h2>

                        <p>
                            @(string.IsNullOrWhiteSpace(details.ProgramName)
                                ? "-"
                                : details.ProgramName)
                        </p>
                    </div>

                    <div class="csr-pd-header-right">

                        <span class="csr-pd-scope-pill @(IsStateScope ? "csr-pd-scope-pill-state" : "")">
                            @(IsHQScope ? "Headquarters" : "State")
                        </span>

                        <span class="@GetHeaderStatusClass(details.Status)">
                            @GetStatusDisplay(details.Status)
                        </span>

                        <button type="button"
                                class="csr-pd-close"
                                @onclick="CloseDrawer">

                            <i class="bi bi-x-lg"></i>

                        </button>

                    </div>

                </div>


                <div class="csr-pd-content">

                    @* Inline editable CSR-1 form: same source fields as CREATE-CSR-1Management *@
                    <section class="csr-pd-section">
                        <h3>Program Information</h3>
                        @if (CanValidate || CanApprove)
                        {
                            @if (reviewRequest == null)
                            {
                                <div class="alert alert-warning">@reviewError</div>
                            }
                            else
                            {
                                <div class="csr-pd-panel csr-inline-edit-grid">
                                    <label class="csr-inline-field">
                                        Program Type
                                        <input class="form-control" value="@details.ProgramType" disabled />
                                    </label>
                                    <label class="csr-inline-field">
                                        Program Name
                                        <input class="form-control" value="@details.ProgramName" disabled />
                                    </label>
                                    <label class="csr-inline-field">
                                        Number of Programs
                                        <input type="number" min="1" class="form-control" @bind="reviewRequest.CSR1.NumberOfPrograms" />
                                    </label>
                                    <label class="csr-inline-field">
                                        Allocated Budget (fixed)
                                        <input type="number" class="form-control" value="@details.Budget" disabled />
                                    </label>
                                    <label class="csr-inline-field">
                                        HQ
                                        <select class="form-select" @bind="reviewRequest.CSR1.HeadquarterId">
                                            <option value="">Select HQ</option>
                                            @foreach (var h in reviewHeadquarters)
                                            {
                                                <option value="@h.Id">@h.HeadquarterName</option>
                                            }
                                        </select>
                                    </label>
                                    <label class="csr-inline-field">
                                        Location
                                        <select class="form-select" @bind="reviewRequest.CSR1.LocationId">
                                            <option value="">Select Location</option>
                                            @foreach (var z in reviewZones)
                                            {
                                                <option value="@z.Id">@z.ZoneName</option>
                                            }
                                        </select>
                                    </label>
                                    <label class="csr-inline-field">
                                        Responsible Person

                                        <select class="form-select"
                                                @bind="reviewRequest.CSR1.ResponsiblePersonId">

                                            <option value="">Select Person</option>

                                            @foreach (var e in reviewEmployees)
                                            {
                                                <option value="@e.UserId">
                                                    @e.Name - @e.UserName
                                                </option>
                                            }

                                        </select>
                                    </label>
                                    <label class="csr-inline-field">
                                        Program Date
                                        <input type="date" class="form-control" @bind="reviewRequest.CSR1.CSR1Date" @bind:format="yyyy-MM-dd" min="@ReviewMinDate" max="@ReviewMaxDate" />
                                    </label>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="csr-pd-panel csr-pd-info-grid">
                                <div class="csr-pd-info-column">
                                    <div class="csr-pd-field"><span>Program Type</span><strong>@ShowValue(details.ProgramType)</strong></div>
                                    <div class="csr-pd-field"><span>Program Name</span><strong>@ShowValue(details.ProgramName)</strong></div>
                                    <div class="csr-pd-field"><span>Number of Programs</span><strong>@details.NumberOfPrograms</strong></div>
                                    <div class="csr-pd-field"><span>Responsible Person</span><strong>@ShowValue(details.ResponsiblePersonName)</strong></div>
                                </div>
                                <div class="csr-pd-info-column">
                                    <div class="csr-pd-field"><span>HQ</span><strong>@ShowValue(details.HeadquarterName)</strong></div>
                                    <div class="csr-pd-field"><span>Location</span><strong>@ShowValue(details.LocationName)</strong></div>
                                    <div class="csr-pd-field"><span>Budget</span><strong>@FormatAmount(details.Budget)</strong></div>
                                    <div class="csr-pd-field"><span>Program Date</span><strong>@details.CSR1Date.ToString("dd MMM yyyy")</strong></div>
                                </div>
                            </div>
                        }
                    </section>
                    <section class="csr-pd-section">
                        <h3>Expense Breakdown</h3>
                        @if (reviewRequest != null)
                        {
                            <div class="csr-pd-panel csr-inline-edit-grid">
                                @foreach (var expense in reviewExpenseInformations)
                                {
                                    var expenseRow = GetReviewExpense(expense.Id);
                                    <label class="csr-inline-field">
                                        @expense.Name
                                        <input type="number"
                                               class="form-control"
                                               min="0"
                                               step="0.01"
                                               value="@expenseRow.ExpenseAmount"
                                               @oninput="e => UpdateReviewExpense(expense.Id, e.Value?.ToString())"
                                               disabled="@(!(CanValidate || CanApprove))" />
                                    </label>
                                }

                                <div class="csr-review-total">
                                    <strong>Total Expenses: @FormatAmount(ReviewTotalExpense)</strong>
                                    <span>Remaining Budget: @FormatAmount(details.Budget - ReviewTotalExpense)</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="csr-pd-panel">No expense details available.</div>
                        }
                    </section>
                    <section class="csr-pd-section">
                        <h3>Focus Details</h3>
                        @if ((CanValidate || CanApprove) && reviewRequest != null)
                        {
                            <div class="csr-pd-panel" style="padding:14px">
                                <div class="csr-focus-inline-grid">
                                    @for (var groupIndex = 1; groupIndex <= 3; groupIndex++)
                                    {
                                        var group = groupIndex;
                                        <div class="csr-focus-inline-card">
                                            <strong>Focus @group</strong>
                                            <label class="csr-inline-field">Focused Crop</label>
                                            <div class="csr-pd-pills">
                                                @foreach (var cropId in GetCrops(group).ToList())
                                                {
                                                    var crop = reviewCrops.FirstOrDefault(x => x.Id == cropId);
                                                    <span class="csr-pd-pill csr-pd-pill-green">
                                                        @(crop?.Name ?? cropId.ToString())
                                                        <button type="button"
                                                                class="btn btn-sm p-0 ms-1"
                                                                @onclick="() => ToggleReviewCrop(group, cropId, false)">
                                                            ×
                                                        </button>
                                                    </span>
                                                }
                                            </div>
                                            <select class="form-select mt-2"
                                                    value="0"
                                                    @onchange="e => AddReviewCrop(group, e.Value?.ToString())">
                                                <option value="0">Select Crop</option>
                                                @foreach (var crop in reviewCrops.Where(x => !GetCrops(group).Contains(x.Id)))
                                                {
                                                    <option value="@crop.Id">@crop.Name</option>
                                                }
                                            </select>

                                            <label class="csr-inline-field">Focused Product</label>
                                            <div class="csr-pd-pills">
                                                @foreach (var productId in GetProducts(group).ToList())
                                                {
                                                    var product = reviewProducts.FirstOrDefault(x => x.Id == productId);
                                                    <span class="csr-pd-pill csr-pd-pill-blue">
                                                        @(product?.Name ?? productId.ToString())
                                                        <button type="button" class="btn btn-sm p-0 ms-1" @onclick="() => ToggleReviewProduct(group, productId, false)">×</button>
                                                    </span>
                                                }
                                            </div>
                                            <select class="form-select mt-2" value="0" @onchange="e => AddReviewProduct(group, e.Value?.ToString())">
                                                <option value="0">Select Product</option>
                                                @foreach (var product in reviewProducts.Where(x => !GetProducts(group).Contains(x.Id)))
                                                {
                                                    <option value="@product.Id">@product.Name</option>
                                                }
                                            </select>
                                        </div>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(reviewError))
                                {
                                    <div class="text-danger mt-2">@reviewError</div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="csr-pd-panel csr-pd-focus-grid">
                                <div class="csr-pd-focus-item">
                                    <label>Focused Crops</label><div class="csr-pd-pills">
                                    @foreach (var crop in AllFocusCrops)
                                    {
                                        <span class="csr-pd-pill csr-pd-pill-green">@crop</span>
                                    }
                                </div>
                            </div>
                            <div class="csr-pd-focus-item">
                                <label>Focused Products</label><div class="csr-pd-pills">
                                @foreach (var product in AllFocusProducts)
                                {
                                    <span class="csr-pd-pill csr-pd-pill-blue">@product</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </section>

            @* ================================================= *@
            @* BUDGET / WORKFLOW TIMELINE                        *@
            @* ================================================= *@

            <section class="csr-pd-section">

                <h3>Budget Details</h3>

                <div class="csr-pd-timeline">

                    <div class="csr-pd-timeline-item">

                        <div class="csr-pd-timeline-marker">
                            <i class="bi bi-check"></i>
                        </div>

                        <div class="csr-pd-timeline-content">

                            <strong>Created</strong>

                            <div class="csr-pd-timeline-meta">

                                <span>
                                    @ShowValue(details.CreatedBy)
                                </span>

                                <span class="csr-pd-date-pill">
                                    @details.CreatedAt.ToString("dd MMM yyyy")
                                </span>

                            </div>

                        </div>

                    </div>


                    @if (IsSubmittedOrLater)
                    {
                        <div class="csr-pd-timeline-item">

                            <div class="csr-pd-timeline-marker">
                                <i class="bi bi-check"></i>
                            </div>

                            <div class="csr-pd-timeline-content">

                                <strong>Submitted</strong>

                                <div class="csr-pd-timeline-meta">

                                    <span>
                                        @ShowValue(details.CreatedBy)
                                    </span>

                                    <span class="csr-pd-date-pill">
                                        @(details.CSR1Date != default ? details.CSR1Date.ToString("dd MMM yyyy") : "-")
                                    </span>

                                </div>

                            </div>

                        </div>
                    }


                    @if (IsThreeLevelWorkflow && approvalFlow != null)
                    {
                        @foreach (var step in approvalFlow.Steps)
                        {
                            <div class="csr-pd-timeline-item">
                                <div class="csr-pd-timeline-marker">
                                    <i class="bi @(step.Completed ? "bi-check" : "bi-hourglass")"></i>
                                </div>
                                <div class="csr-pd-timeline-content">
                                    <strong>@step.Name</strong>
                                    <div class="csr-pd-timeline-meta">
                                        <span>@ShowValue(step.Actor)</span>
                                        <span class="csr-pd-date-pill">@(step.At?.ToString("dd MMM yyyy") ?? "Pending")</span>
                                    </div>
                                </div>
                            </div>
                        }
                    }

                    @if (!IsThreeLevelWorkflow && (string.Equals(
                        details.Status,
                        "Validated",
                        StringComparison.OrdinalIgnoreCase)
                        ||
                        string.Equals(
                            details.Status,
                            "Approved",
                            StringComparison.OrdinalIgnoreCase)))
                    {
                        <div class="csr-pd-timeline-item">

                            <div class="csr-pd-timeline-marker">
                                <i class="bi bi-check"></i>
                            </div>

                            <div class="csr-pd-timeline-content">

                                <strong>Validated</strong>

                                <div class="csr-pd-timeline-meta">

                                    <span>
                                        @ShowValue(details.ValidateBy)
                                    </span>

                                    <span class="csr-pd-date-pill">

                                        @(details.ValidateAt.HasValue
                                            ? details.ValidateAt.Value.ToString("dd MMM yyyy")
                                            : "-")

                                    </span>

                                </div>

                            </div>

                        </div>
                    }


                    @if (!IsThreeLevelWorkflow && string.Equals(
                        details.Status,
                        "Approved",
                        StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="csr-pd-timeline-item csr-pd-timeline-last">

                            <div class="csr-pd-timeline-marker">
                                <i class="bi bi-check"></i>
                            </div>

                            <div class="csr-pd-timeline-content">

                                <strong>Approved</strong>

                                <div class="csr-pd-timeline-meta">

                                    <span>
                                        @ShowValue(details.ApprovedBy)
                                    </span>

                                    <span class="csr-pd-date-pill">

                                        @(details.ApprovedAt.HasValue
                                            ? details.ApprovedAt.Value.ToString("dd MMM yyyy")
                                            : "-")

                                    </span>

                                </div>

                            </div>

                        </div>
                    }

                    @if (string.Equals(
                        details.Status,
                        "Rejected",
                        StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="csr-pd-timeline-item csr-pd-timeline-last">

                            <div class="csr-pd-timeline-marker csr-pd-marker-rejected">
                                <i class="bi bi-x"></i>
                            </div>

                            <div class="csr-pd-timeline-content">

                                <strong style="color: #dc2626;">Rejected</strong>

                                <div class="csr-pd-timeline-meta">

                                    <span>
                                        @ShowValue(details.UpdatedBy)
                                    </span>

                                    <span class="csr-pd-date-pill" style="background: #dc2626;">

                                        @(details.UpdatedAt.HasValue
                                            ? details.UpdatedAt.Value.ToString("dd MMM yyyy")
                                            : "-")

                                    </span>

                                </div>

                            </div>

                        </div>
                    }

                </div>

            </section>


            @if (!string.IsNullOrWhiteSpace(details.Remarks))
            {
                <section class="csr-pd-section">

                    <h3 style="color: #dc2626;">Remarks</h3>

                    <div class="csr-pd-panel csr-pd-remarks">
                        @details.Remarks
                    </div>

                </section>
            }

        </div>


        @* ================================================= *@
        @* FOOTER                                            *@
        @* ================================================= *@

        <div class="csr-pd-footer">

            <button type="button"
                    class="csr-pd-footer-btn csr-pd-footer-outline">

                <i class="bi bi-download"></i>
                Export PDF

            </button>


            <button type="button"
                    class="csr-pd-footer-btn csr-pd-footer-outline">

                <i class="bi bi-printer"></i>
                Print

            </button>

            @if (CanReject)
            {
                <button type="button"
                        class="csr-pd-footer-btn csr-pd-footer-danger"
                        disabled="@isActionInProgress"
                        @onclick="OpenRejectModal">
                    <i class="bi bi-x-circle"></i>
                    Reject
                </button>
            }

            @if (CanValidate)
            {
                <button type="button"
                        class="csr-pd-footer-btn csr-pd-footer-validate"
                        disabled="@isActionInProgress"
                        @onclick="ValidateCSR1">
                    @if (isActionInProgress)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    else
                    {
                        <i class="bi bi-check-circle"></i>
                    }
                    Validate
                </button>
            }

            @if (CanApprove)
            {
                <button type="button"
                        class="csr-pd-footer-btn csr-pd-footer-approve"
                        disabled="@isActionInProgress"
                        @onclick="ApproveCSR1">
                    @if (isActionInProgress)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    else
                    {
                        <i class="bi bi-check2-all"></i>
                    }
                    @ApproveButtonText
                </button>
            }
            else if (IsThreeLevelWorkflow && !string.IsNullOrWhiteSpace(approvalFlow?.AwaitingLabel))
            {
                <div class="csr-pd-awaiting-badge">
                    <i class="bi bi-hourglass-split"></i>
                    <span>@approvalFlow.AwaitingLabel</span>
                </div>
            }
            else if (IsAwaitingValidation)
            {
                <div class="csr-pd-awaiting-badge">
                    <i class="bi bi-hourglass-split"></i>
                    <span>Awaiting @(IsHQScope ? "MO" : "SMD") Validation</span>
                </div>
            }

            @if (string.Equals(details.Status, "Approved", StringComparison.OrdinalIgnoreCase))
            {
                <button type="button"
                        class="csr-pd-footer-btn csr-pd-footer-primary"
                        @onclick="OpenCsr2">

                    <i class="bi bi-box-arrow-up-right"></i>
                    Open CSR-2

                </button>
            }

        </div>
    }

</div>

@* Reject popup must be outside Program Details modal *@
@if (showRejectModal)
{
    <div class="csr-pd-reject-modal-backdrop" @onclick="CloseRejectModal">
        <div class="csr-pd-reject-modal" @onclick:stopPropagation="true">
            <div class="csr-pd-reject-modal-header">
                <h4>Reject CSR-1</h4>
                <button type="button" class="btn-close" @onclick="CloseRejectModal"></button>
            </div>

            <div class="csr-pd-reject-modal-body">
                <p>Please enter the reason / remarks for rejecting this CSR-1:</p>
                <textarea class="form-control"
                          rows="3"
                          placeholder="Enter remarks..."
                          @bind="rejectionRemarks"></textarea>

                @if (!string.IsNullOrWhiteSpace(rejectErrorMessage))
                {
                    <div class="text-danger mt-2 small">@rejectErrorMessage</div>
                }
            </div>

            <div class="csr-pd-reject-modal-footer">
                <button type="button" class="btn btn-sm btn-secondary" @onclick="CloseRejectModal">Cancel</button>
                <button type="button" class="btn btn-sm btn-danger" disabled="@isActionInProgress" @onclick="SubmitRejection">
                    Confirm Reject
                </button>
            </div>
        </div>
    </div>
}

</div>
}



@if (showCSRPopup)
{
    <div class="csr-pd-message-overlay">
        <div class="csr-pd-message-popup" role="alertdialog" aria-modal="true"
             aria-labelledby="csr-pd-message-title" aria-describedby="csr-pd-message-body">
            <div class="csr-pd-message-icon @(csrPopupSuccess ? "success" : "error")" aria-hidden="true">
                <i class="bi @(csrPopupSuccess ? "bi-check-circle-fill" : "bi-x-circle-fill")"></i>
            </div>
            <h3 id="csr-pd-message-title">@(csrPopupSuccess ? "Success" : "Action Failed")</h3>
            <p id="csr-pd-message-body">@csrPopupMessage</p>
            <button type="button" class="csr-pd-message-confirm" @onclick="CloseCSRPopup">OK</button>
        </div>
    </div>
}

<style>
    .csr-inline-edit-grid {
        display: grid;
        grid-template-columns: repeat(2,minmax(0,1fr));
        gap: 14px;
        padding: 16px
    }

    .csr-inline-field {
        display: flex;
        flex-direction: column;
        gap: 6px;
        font-size: 11px;
        color: #475569;
        min-width: 0
    }

        .csr-inline-field .form-control, .csr-inline-field .form-select {
            font-size: 12px;
            min-height: 35px
        }

    .csr-review-total {
        grid-column: 1/-1;
        display: flex;
        justify-content: space-between;
        gap: 10px;
        flex-wrap: wrap;
        background: #effcf5;
        padding: 12px;
        border-radius: 6px
    }

    .csr-focus-inline-grid {
        display: grid;
        grid-template-columns: repeat(3,minmax(0,1fr));
        gap: 12px
    }

    .csr-focus-inline-card {
        min-width: 0;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 12px;
        display: flex;
        flex-direction: column;
        gap: 9px
    }

    @@media(max-width:750px) {
        .csr-inline-edit-grid, .csr-focus-inline-grid {
            grid-template-columns: 1fr
        }
    }


    .csr-review-grid {
        display: grid;
        grid-template-columns: repeat(2,minmax(0,1fr));
        gap: 12px;
    }

        .csr-review-grid label {
            display: block;
            font-size: 11px;
            color: #334155;
        }

    .csr-review-products {
        max-height: 155px;
        overflow: auto;
        border: 1px solid #ddd;
        padding: 8px;
        background: white;
    }

        .csr-review-products label {
            display: block;
            margin: 4px 0;
        }

    @@media(max-width:650px) {
        .csr-review-grid {
            grid-template-columns: 1fr
        }
    }
    /* Match BudgetingManagements center notification. Above drawer/rejection backdrop. */
    .csr-pd-message-overlay {
        position: fixed;
        inset: 0;
        z-index: 99999;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(15, 23, 42, .48);
    }

    .csr-pd-message-popup {
        width: min(460px, 100%);
        background: #fff;
        border-radius: 18px;
        padding: 38px 30px 30px;
        text-align: center;
        box-shadow: 0 24px 70px rgba(0,0,0,.22);
        animation: csrPdPopupIn .2s ease-out;
    }

    .csr-pd-message-icon {
        font-size: 60px;
        margin-bottom: 14px;
        line-height: 1.2;
    }

        .csr-pd-message-icon.success {
            color: #16a34a;
        }

        .csr-pd-message-icon.error {
            color: #dc2626;
        }

    .csr-pd-message-popup h3 {
        color: #0f172a;
        font-size: 23px;
        font-weight: 700;
        margin: 0 0 12px;
    }

    .csr-pd-message-popup p {
        color: #475569;
        font-size: 15px;
        line-height: 1.6;
        overflow-wrap: anywhere;
        margin: 0 0 26px;
    }

    .csr-pd-message-confirm {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 135px;
        min-height: 40px;
        padding: 10px 20px;
        border: 0;
        border-radius: 6px;
        background: #2563eb;
        color: #fff;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
    }

        .csr-pd-message-confirm:hover {
            background: #1d4ed8;
        }

    @@keyframes csrPdPopupIn {
        from {
            opacity: 0;
            transform: translateY(12px) scale(.97);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }


    /* =========================================================
                                       DRAWER
                                       ========================================================= */

    .csr-pd-overlay {
        position: fixed;
        inset: 0;
        z-index: 1050;
        background: rgba(15, 23, 42, 0.28);
        display: flex;
        justify-content: flex-end;
    }

