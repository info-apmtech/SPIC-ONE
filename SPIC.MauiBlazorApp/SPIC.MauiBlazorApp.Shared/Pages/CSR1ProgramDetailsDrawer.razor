        font-size: 10px;
    }


    /* =========================================================
           TIMELINE
           ========================================================= */

    .csr-pd-timeline {
        padding: 3px 2px;
    }

    .csr-pd-timeline-item {
        position: relative;
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding-bottom: 14px;
    }

        .csr-pd-timeline-item::after {
            content: "";
            position: absolute;
            top: 20px;
            bottom: 0;
            left: 9px;
