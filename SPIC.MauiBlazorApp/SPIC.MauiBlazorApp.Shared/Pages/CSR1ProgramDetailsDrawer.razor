    }

    .csr-pd-timeline-marker {
        position: relative;
        z-index: 2;
        flex: 0 0 19px;
        width: 19px;
        height: 19px;
        border: 1px solid #22c55e;
        background: #dcfce7;
        color: #16a34a;
        border-radius: 50%;
