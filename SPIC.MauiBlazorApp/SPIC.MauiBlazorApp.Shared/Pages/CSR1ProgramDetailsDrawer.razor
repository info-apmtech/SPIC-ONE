        }

        .csr-pd-info-grid,
        .csr-pd-expense-grid,
        .csr-pd-focus-grid {
            grid-template-columns: 1fr;
        }

        .csr-pd-field {
            grid-template-columns: 110px minmax(0, 1fr);
        }

        .csr-pd-footer {
            flex-wrap: wrap;
        }

        .csr-pd-footer-btn {
            flex: 1;
            min-height: 42px;
        }
    }

</style>


@code {

    // =========================================================
    // PARAMETERS
    // =========================================================

    [Parameter]
    public int CSR1Id { get; set; }

    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }


    // =========================================================
    // STATE
    // =========================================================

    private CSR1DetailsDto? details;

    private bool isLoading = false;

    private int lastLoadedId = 0;


    // =========================================================
    // PARAMETER CHANGE
    // =========================================================

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen &&
            CSR1Id > 0 &&
            CSR1Id != lastLoadedId)
        {
            await LoadCSR1Details();
        }
    }


    // =========================================================
    // LOAD DETAILS
    // =========================================================

    private async Task LoadCSR1Details()
    {
        try
        {
            isLoading = true;

            details =
                await Http.GetFromJsonAsync<CSR1DetailsDto>(
                    $"api/CSR1/details/{CSR1Id}");

            lastLoadedId =
                CSR1Id;
        }
        catch (Exception ex)
        {
            details = null;

            Console.WriteLine(
                $"CSR1 Details Load Error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }


    // =========================================================
    // FOCUS CROPS
    // =========================================================

    private List<string> AllFocusCrops
    {
        get
        {
            if (details == null)
                return new();

            return details.Focus1
                .Concat(details.Focus2)
                .Concat(details.Focus3)
                .Where(x =>
                    !string.IsNullOrWhiteSpace(x.CropName))
                .Select(x =>
                    x.CropName.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
    }


    // =========================================================
    // FOCUS PRODUCTS
    // =========================================================

    private List<string> AllFocusProducts
    {
        get
        {
            if (details == null)
                return new();

            return details.Focus1
                .Concat(details.Focus2)
                .Concat(details.Focus3)
                .Where(x =>
                    !string.IsNullOrWhiteSpace(x.ProductName))
                .Select(x =>
                    x.ProductName.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
    }


    // =========================================================
    // STATUS FLOW
    // =========================================================

    private bool IsSubmittedOrLater =>
        details != null &&
        !string.Equals(
            details.Status,
            "Draft",
            StringComparison.OrdinalIgnoreCase);


    private string GetHeaderStatusClass(
        string? status)
    {
        var css =
            status?.Trim().ToLowerInvariant() switch
            {
                "approved" =>
                    "csr-pd-status-approved",

                "rejected" =>
                    "csr-pd-status-rejected",

                "submittedforvalidation" =>
                    "csr-pd-status-pending",

                "submitted" =>
                    "csr-pd-status-pending",

                "pending" =>
                    "csr-pd-status-pending",

                _ =>
                    "csr-pd-status-default"
            };

        return $"csr-pd-status {css}";
    }


    private string GetStatusDisplay(
        string? status)
    {
        if (string.Equals(
            status,
            "SubmittedForValidation",
            StringComparison.OrdinalIgnoreCase))
        {
            return "Pending";
        }

        return string.IsNullOrWhiteSpace(status)
            ? "-"
            : status;
    }


    // =========================================================
    // FORMATTING
    // =========================================================

    private string FormatAmount(
        decimal value)
    {
        return $"₹ {value.ToString(
            "N0",
            CultureInfo.CreateSpecificCulture("en-IN"))}";
    }


    private string ShowValue(
        string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "-"
            : value;
    }


    // =========================================================
    // EXPENSE ROW
    // =========================================================

    private RenderFragment ExpenseRow(
        string label,
        decimal value) =>
        @<div class="csr-pd-expense-row">

            <span>
                @label
            </span>

            <strong>
                @FormatAmount(value)
            </strong>

        </div>;


    // =========================================================
    // CLOSE
    // =========================================================

    private async Task CloseDrawer()
    {
        IsOpen = false;

        await IsOpenChanged.InvokeAsync(false);
    }


    // =========================================================
    // CSR2
    // =========================================================

    private void OpenCsr2()
    {
        NavigationManager.NavigateTo(
            "/CSR-2ProgramExecution");
    }
}