@using System.Net.Http.Json
@using System.Globalization
@using SPIC.Core.DTOs
@using SPIC.Core.Entities

@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject SPIC.MauiBlazorApp.Shared.Services.LoginState loginState
@inject ToastService Toast


@if (IsOpen)
{
    <div class="csr-pd-overlay" @onclick="CloseDrawer">

        <div class="csr-pd-drawer"
             @onclick:stopPropagation="true">

            @if (isLoading)
            {
                <div class="csr-pd-loading">
                    <div class="spinner-border spinner-border-sm"></div>
                    <span>Loading CSR-1 details...</span>
                </div>
            }
            else if (details == null)
            {
                <div class="csr-pd-loading">
                    Unable to load CSR-1 details.
                </div>
            }
            else
            {
                @* ================================================= *@
                @* HEADER                                            *@
                @* ================================================= *@

                <div class="csr-pd-header">

                    <div>
                        <h2>CSR-1 Program Details</h2>

                        <p>
                            @(string.IsNullOrWhiteSpace(details.ProgramName)
                                ? "-"
                                : details.ProgramName)
                        </p>
                    </div>

                    <div class="csr-pd-header-right">

                        <span class="csr-pd-scope-pill @(IsStateScope ? "csr-pd-scope-pill-state" : "")">
                            @(IsHQScope ? "Headquarters" : "State")
                        </span>

                        <span class="@GetHeaderStatusClass(details.Status)">
                            @GetStatusDisplay(details.Status)
                        </span>

                        <button type="button"
                                class="csr-pd-close"
                                @onclick="CloseDrawer">

                            <i class="bi bi-x-lg"></i>

                        </button>

                    </div>

                </div>


                <div class="csr-pd-content">

                    @* ================================================= *@
                    @* PROGRAM INFORMATION                               *@
                    @* ================================================= *@

                    <section class="csr-pd-section">

                        <h3>Program Information</h3>

                        <div class="csr-pd-panel csr-pd-info-grid">

                            <div class="csr-pd-info-column">

                                <div class="csr-pd-field">
                                    <span>Program Type</span>
                                    <strong>@ShowValue(details.ProgramType)</strong>
                                </div>

                                <div class="csr-pd-field">
                                    <span>Program Name</span>
                                    <strong>@ShowValue(details.ProgramName)</strong>
                                </div>

                                <div class="csr-pd-field">
                                    <span>Number of Programs</span>
                                    <strong>@details.NumberOfPrograms</strong>
                                </div>

                                <div class="csr-pd-field csr-pd-highlight-green">
                                    <span>Responsible Person</span>
                                    <strong>@ShowValue(details.ResponsiblePersonName)</strong>
                                </div>

                            </div>


                            <div class="csr-pd-info-column">

                                <div class="csr-pd-field">
                                    <span>HQ</span>
                                    <strong>@ShowValue(details.HeadquarterName)</strong>
                                </div>

                                <div class="csr-pd-field">
                                    <span>Location</span>
                                    <strong>@ShowValue(details.LocationName)</strong>
                                </div>

                                <div class="csr-pd-field">
                                    <span>Status</span>
                                    <strong>@GetStatusDisplay(details.Status)</strong>
                                </div>

                                <div class="csr-pd-field">
                                    <span>Submission Date</span>

                                    <strong>
                                        @(details.CSR1Date != default ? details.CSR1Date.ToString("dd MMM yyyy") : "-")
                                    </strong>
                                </div>

                            </div>

                        </div>

                    </section>


                    @* ================================================= *@
                    @* EXPENSE BREAKDOWN                                 *@
                    @* ================================================= *@

                    <section class="csr-pd-section">

                        <h3>Expense Breakdown</h3>

                        <div class="csr-pd-panel csr-pd-expense-grid">

                            <div class="csr-pd-expense-column">

                                @ExpenseRow(
                                    "Printing & Stationery",
                                    details.PrintingAndStationery)

                                @ExpenseRow(
                                    "Publicity Material",
                                    details.PublicityMaterial)

                                @ExpenseRow(
                                    "Stage Material",
                                    details.StageArrangements)

                                @ExpenseRow(
                                    "Service Charges - LCA",
                                    details.ServiceChargesLCA)

                                @ExpenseRow(
                                    "Transport / Rent",
                                    details.TransportRent)

                                @ExpenseRow(
                                    "Jeep Running Expenses",
                                    details.JeepRunningExpenses)

                            </div>


                            <div class="csr-pd-expense-column">

                                @ExpenseRow(
                                    "Refreshments",
                                    details.Refreshments)

                                @ExpenseRow(
                                    "Inputs",
                                    details.Inputs)

                                @ExpenseRow(
                                    "Photography",
                                    details.Photography)

                                @ExpenseRow(
                                    "Compliments",
                                    details.Compliments)

                                @ExpenseRow(
                                    "Others",
                                    details.Others)


                                <div class="csr-pd-expense-row csr-pd-total-row">

                                    <span>Total Budget</span>

                                    <strong>
                                        @FormatAmount(details.Budget)
                                    </strong>

                                </div>

                            </div>

                        </div>

                    </section>


                    @* ================================================= *@
                    @* FOCUS AREAS                                       *@
                    @* ================================================= *@

                    <section class="csr-pd-section">

                        <h3>Focus Areas</h3>

                        <div class="csr-pd-panel csr-pd-focus-grid">

                            <div class="csr-pd-focus-item">

                                <label>Focused Crops:</label>

                                <div class="csr-pd-pills">

                                    @foreach (var crop in AllFocusCrops)
                                    {
                                        <span class="csr-pd-pill csr-pd-pill-green">
                                            @crop
                                        </span>
                                    }

                                    @if (!AllFocusCrops.Any())
                                    {
                                        <span class="csr-pd-empty">-</span>
                                    }

                                </div>

                            </div>


                            <div class="csr-pd-focus-item">

                                <label>Focused Products:</label>

                                <div class="csr-pd-pills">

                                    @foreach (var product in AllFocusProducts)
                                    {
                                        <span class="csr-pd-pill csr-pd-pill-blue">
                                            @product
                                        </span>
                                    }

                                    @if (!AllFocusProducts.Any())
                                    {
                                        <span class="csr-pd-empty">-</span>
                                    }

                                </div>

                            </div>

                        </div>

                    </section>


                    @* ================================================= *@
                    @* BUDGET / WORKFLOW TIMELINE                        *@
                    @* ================================================= *@

                    <section class="csr-pd-section">

                        <h3>Budget Details</h3>

                        <div class="csr-pd-timeline">

                            <div class="csr-pd-timeline-item">

                                <div class="csr-pd-timeline-marker">
                                    <i class="bi bi-check"></i>
                                </div>

                                <div class="csr-pd-timeline-content">

                                    <strong>Created</strong>

                                    <div class="csr-pd-timeline-meta">

                                        <span>
                                            @ShowValue(details.CreatedBy)
                                        </span>

                                        <span class="csr-pd-date-pill">
                                            @details.CreatedAt.ToString("dd MMM yyyy")
                                        </span>

                                    </div>

                                </div>

                            </div>


                            @if (IsSubmittedOrLater)
                            {
                                <div class="csr-pd-timeline-item">

                                    <div class="csr-pd-timeline-marker">
                                        <i class="bi bi-check"></i>
                                    </div>

                                    <div class="csr-pd-timeline-content">

                                        <strong>Submitted</strong>

                                        <div class="csr-pd-timeline-meta">

                                            <span>
                                                @ShowValue(details.CreatedBy)
                                            </span>

                                            <span class="csr-pd-date-pill">
                                                @(details.CSR1Date != default ? details.CSR1Date.ToString("dd MMM yyyy") : "-")
                                            </span>

                                        </div>

                                    </div>

                                </div>
                            }


                            @if (string.Equals(
                                details.Status,
                                "Validated",
                                StringComparison.OrdinalIgnoreCase)
                                ||
                                string.Equals(
                                    details.Status,
                                    "Approved",
                                    StringComparison.OrdinalIgnoreCase))
                            {
                                <div class="csr-pd-timeline-item">

                                    <div class="csr-pd-timeline-marker">
                                        <i class="bi bi-check"></i>
                                    </div>

                                    <div class="csr-pd-timeline-content">

                                        <strong>Validated</strong>

                                        <div class="csr-pd-timeline-meta">

                                            <span>
                                                @ShowValue(details.ValidateBy)
                                            </span>

                                            <span class="csr-pd-date-pill">

                                                @(details.ValidateAt.HasValue
                                                    ? details.ValidateAt.Value.ToString("dd MMM yyyy")
                                                    : "-")

                                            </span>

                                        </div>

                                    </div>

                                </div>
                            }


                            @if (string.Equals(
                                details.Status,
                                "Approved",
                                StringComparison.OrdinalIgnoreCase))
                            {
                                <div class="csr-pd-timeline-item csr-pd-timeline-last">

                                    <div class="csr-pd-timeline-marker">
                                        <i class="bi bi-check"></i>
                                    </div>

                                    <div class="csr-pd-timeline-content">

                                        <strong>Approved</strong>

                                        <div class="csr-pd-timeline-meta">

                                            <span>
                                                @ShowValue(details.ApprovedBy)
                                            </span>

                                            <span class="csr-pd-date-pill">

                                                @(details.ApprovedAt.HasValue
                                                    ? details.ApprovedAt.Value.ToString("dd MMM yyyy")
                                                    : "-")

                                            </span>

                                        </div>

                                    </div>

                                </div>
                            }

                            @if (string.Equals(
                                details.Status,
                                "Rejected",
                                StringComparison.OrdinalIgnoreCase))
                            {
                                <div class="csr-pd-timeline-item csr-pd-timeline-last">

                                    <div class="csr-pd-timeline-marker csr-pd-marker-rejected">
                                        <i class="bi bi-x"></i>
                                    </div>

                                    <div class="csr-pd-timeline-content">

                                        <strong style="color: #dc2626;">Rejected</strong>

                                        <div class="csr-pd-timeline-meta">

                                            <span>
                                                @ShowValue(details.UpdatedBy)
                                            </span>

                                            <span class="csr-pd-date-pill" style="background: #dc2626;">

                                                @(details.UpdatedAt.HasValue
                                                    ? details.UpdatedAt.Value.ToString("dd MMM yyyy")
                                                    : "-")

                                            </span>

                                        </div>

                                    </div>

                                </div>
                            }

                        </div>

                    </section>


                    @if (!string.IsNullOrWhiteSpace(details.Remarks))
                    {
                        <section class="csr-pd-section">

                            <h3 style="color: #dc2626;">Remarks</h3>

                            <div class="csr-pd-panel csr-pd-remarks">
                                @details.Remarks
                            </div>

                        </section>
                    }

                </div>


                @* ================================================= *@
                @* FOOTER                                            *@
                @* ================================================= *@

                <div class="csr-pd-footer">

                    <button type="button"
                            class="csr-pd-footer-btn csr-pd-footer-outline">

                        <i class="bi bi-download"></i>
                        Export PDF

                    </button>


                    <button type="button"
                            class="csr-pd-footer-btn csr-pd-footer-outline">

                        <i class="bi bi-printer"></i>
                        Print

                    </button>

                    @if (CanReject)
                    {
                        <button type="button"
                                class="csr-pd-footer-btn csr-pd-footer-danger"
                                disabled="@isActionInProgress"
                                @onclick="OpenRejectModal">
                            <i class="bi bi-x-circle"></i>
                            Reject
                        </button>
                    }

                    @if (CanValidate)
                    {
                        <button type="button"
                                class="csr-pd-footer-btn csr-pd-footer-validate"
                                disabled="@isActionInProgress"
                                @onclick="ValidateCSR1">
                            @if (isActionInProgress)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            else
                            {
                                <i class="bi bi-check-circle"></i>
                            }
                            Validate
                        </button>
                    }

                    @if (CanApprove)
                    {
                        <button type="button"
                                class="csr-pd-footer-btn csr-pd-footer-approve"
                                disabled="@isActionInProgress"
                                @onclick="ApproveCSR1">
                            @if (isActionInProgress)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            else
                            {
                                <i class="bi bi-check2-all"></i>
                            }
                            Approve
                        </button>
                    }
                    else if (IsAwaitingValidation)
                    {
                        <div class="csr-pd-awaiting-badge">
                            <i class="bi bi-hourglass-split"></i>
                            <span>Awaiting @(IsHQScope ? "MO" : "SMD") Validation</span>
                        </div>
                    }

                    @if (string.Equals(details.Status, "Approved", StringComparison.OrdinalIgnoreCase))
                    {
                        <button type="button"
                                class="csr-pd-footer-btn csr-pd-footer-primary"
                                @onclick="OpenCsr2">

                            <i class="bi bi-box-arrow-up-right"></i>
                            Open CSR-2

                        </button>
                    }

                </div>
            }

        </div>

        @if (showRejectModal)
        {
            <div class="csr-pd-reject-modal-backdrop" @onclick="CloseRejectModal">
                <div class="csr-pd-reject-modal" @onclick:stopPropagation="true">
                    <div class="csr-pd-reject-modal-header">
                        <h4>Reject CSR-1</h4>
                        <button type="button" class="btn-close" @onclick="CloseRejectModal"></button>
                    </div>
                    <div class="csr-pd-reject-modal-body">
                        <p>Please enter the reason / remarks for rejecting this CSR-1:</p>
                        <textarea class="form-control"
                                  rows="3"
                                  placeholder="Enter remarks..."
                                  @bind="rejectionRemarks" />
                        @if (!string.IsNullOrWhiteSpace(rejectErrorMessage))
                        {
                            <div class="text-danger mt-2 small">@rejectErrorMessage</div>
                        }
                    </div>
                    <div class="csr-pd-reject-modal-footer">
                        <button type="button" class="btn btn-sm btn-secondary" @onclick="CloseRejectModal">Cancel</button>
                        <button type="button" class="btn btn-sm btn-danger" disabled="@isActionInProgress" @onclick="SubmitRejection">
                            @if (isActionInProgress)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            Confirm Reject
                        </button>
                    </div>
                </div>
            </div>
        }

    </div>
}


<style>

    /* =========================================================
               DRAWER
               ========================================================= */

    .csr-pd-overlay {
        position: fixed;
        inset: 0;
        z-index: 1050;
        background: rgba(15, 23, 42, 0.28);
        display: flex;
        justify-content: flex-end;
    }

    .csr-pd-drawer {
        width: min(820px, 94vw);
        height: 100vh;
        background: #ffffff;
        display: flex;
        flex-direction: column;
        box-shadow: -10px 0 30px rgba(15, 23, 42, 0.12);
        font-family: 'Inter', sans-serif;
        overflow: hidden;
    }


    /* =========================================================
               HEADER
               ========================================================= */

    .csr-pd-header {
        min-height: 72px;
        padding: 16px 20px;
        border-bottom: 1px solid #e8edf3;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        flex-shrink: 0;
    }

        .csr-pd-header h2 {
            margin: 0;
            color: #0f172a;
            font-size: 17px;
            font-weight: 700;
        }

        .csr-pd-header p {
            margin: 4px 0 0;
            color: #64748b;
            font-size: 11px;
            font-weight: 500;
        }

    .csr-pd-header-right {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .csr-pd-status {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 24px;
        padding: 3px 12px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 600;
    }

    .csr-pd-status-approved {
        background: #dcfce7;
        border: 1px solid #bbf7d0;
        color: #15803d;
    }

    .csr-pd-status-pending {
        background: #fff7ed;
        border: 1px solid #fed7aa;
        color: #c2410c;
    }

    .csr-pd-status-validated {
        background: #fef3c7;
        border: 1px solid #fde68a;
        color: #d97706;
    }

    .csr-pd-status-rejected {
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #b91c1c;
    }

    .csr-pd-status-default {
        background: #f1f5f9;
        border: 1px solid #e2e8f0;
        color: #475569;
    }

    .csr-pd-scope-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 24px;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 600;
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        color: #166534;
    }

    .csr-pd-scope-pill-state {
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        color: #1d4ed8;
    }

    .csr-pd-close {
        width: 30px;
        height: 30px;
        border: 0;
        background: transparent;
        border-radius: 6px;
        color: #64748b;
        cursor: pointer;
    }

        .csr-pd-close:hover {
            background: #f8fafc;
        }


    /* =========================================================
               CONTENT
               ========================================================= */

    .csr-pd-content {
        flex: 1;
        overflow-y: auto;
        padding: 16px 20px 22px;
    }

    .csr-pd-section {
        margin-bottom: 18px;
    }

        .csr-pd-section h3 {
            margin: 0 0 8px;
            color: #059669;
            font-size: 11px;
            font-weight: 700;
        }

    .csr-pd-panel {
        border: 1px solid #eef2f7;
        background: #fbfcfd;
        border-radius: 5px;
    }


    /* =========================================================
               PROGRAM INFO
               ========================================================= */

    .csr-pd-info-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0 24px;
        padding: 8px 12px;
    }

    .csr-pd-info-column {
        min-width: 0;
    }

    .csr-pd-field {
        min-height: 37px;
        display: grid;
        grid-template-columns: 125px minmax(0, 1fr);
        align-items: center;
        gap: 10px;
        padding: 5px 7px;
        border-bottom: 1px solid #edf1f5;
    }

    .csr-pd-info-column .csr-pd-field:last-child {
        border-bottom: 0;
    }

    .csr-pd-field span {
        color: #64748b;
        font-size: 9px;
        font-weight: 500;
    }

    .csr-pd-field strong {
        color: #334155;
        font-size: 9.5px;
        font-weight: 600;
    }

    .csr-pd-highlight-green {
        background: #e9fbf2;
        border-radius: 4px;
        border-bottom: 0;
        margin-top: 2px;
    }


    /* =========================================================
               EXPENSE
               ========================================================= */

    .csr-pd-expense-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0 24px;
        padding: 8px 12px;
    }

    .csr-pd-expense-row {
        min-height: 34px;
        padding: 6px 7px;
        border-bottom: 1px solid #edf1f5;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
    }

        .csr-pd-expense-row span {
            color: #64748b;
            font-size: 9px;
        }

        .csr-pd-expense-row strong {
            color: #334155;
            font-size: 9.5px;
            font-weight: 600;
            white-space: nowrap;
        }

    .csr-pd-total-row {
        border: 0;
        margin-top: 3px;
        border-radius: 4px;
        background: #dcfce7;
        color: #166534;
    }

        .csr-pd-total-row span,
        .csr-pd-total-row strong {
            color: #166534;
            font-weight: 700;
        }


    /* =========================================================
               FOCUS AREA
               ========================================================= */

    .csr-pd-focus-grid {
        padding: 12px;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 24px;
    }

    .csr-pd-focus-item {
        min-width: 0;
    }

        .csr-pd-focus-item label {
            display: block;
            margin-bottom: 7px;
            color: #64748b;
            font-size: 9px;
            font-weight: 500;
        }

    .csr-pd-pills {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
    }

    .csr-pd-pill {
        display: inline-flex;
        align-items: center;
        min-height: 18px;
        padding: 2px 9px;
        border-radius: 12px;
        font-size: 8.5px;
        font-weight: 600;
    }

    .csr-pd-pill-green {
        background: #dcfce7;
        color: #16a34a;
    }

    .csr-pd-pill-blue {
        background: #dbeafe;
        color: #2563eb;
    }

    .csr-pd-empty {
        color: #94a3b8;
        font-size: 10px;
    }


    /* =========================================================
               TIMELINE
               ========================================================= */

    .csr-pd-timeline {
        padding: 3px 2px;
    }

    .csr-pd-timeline-item {
        position: relative;
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding-bottom: 14px;
    }

        .csr-pd-timeline-item::after {
            content: "";
            position: absolute;
            top: 20px;
            bottom: 0;
            left: 9px;
            width: 1px;
            background: #86efac;
        }

    .csr-pd-timeline-last::after {
        display: none;
    }

    .csr-pd-timeline-marker {
        position: relative;
        z-index: 2;
        flex: 0 0 19px;
        width: 19px;
        height: 19px;
        border: 1px solid #22c55e;
        background: #dcfce7;
        color: #16a34a;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 9px;
    }

    .csr-pd-timeline-content {
        padding-top: 1px;
    }

        .csr-pd-timeline-content > strong {
            display: block;
            color: #334155;
            font-size: 10px;
            font-weight: 600;
            margin-bottom: 3px;
        }

    .csr-pd-timeline-meta {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        color: #64748b;
        font-size: 8px;
    }

    .csr-pd-date-pill {
        padding: 2px 6px;
        background: #334155;
        color: #ffffff;
        border-radius: 8px;
        font-size: 7px;
    }


    /* =========================================================
               REMARKS
               ========================================================= */

    .csr-pd-remarks {
        padding: 12px;
        color: #475569;
        font-size: 10px;
        line-height: 1.5;
    }


    /* =========================================================
               FOOTER
               ========================================================= */

    .csr-pd-footer {
        min-height: 60px;
        padding: 10px 20px;
        border-top: 1px solid #e8edf3;
