    private string FormatAmount(
        decimal value)
    {
        return $"₹ {value.ToString(
            "N0",
            CultureInfo.CreateSpecificCulture("en-IN"))}";
    }


    private string ShowValue(
        string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "-"
            : value;
    }


