            white-space: nowrap;
        }

    .csr-pd-total-row {
        border: 0;
        margin-top: 3px;
        border-radius: 4px;
        background: #dcfce7;
        color: #166534;
    }

        .csr-pd-total-row span,
        .csr-pd-total-row strong {
            color: #166534;
            font-weight: 700;
        }


    /* =========================================================
           FOCUS AREA
           ========================================================= */

    .csr-pd-focus-grid {
        padding: 12px;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 24px;
    }

    .csr-pd-focus-item {
        min-width: 0;
    }

        .csr-pd-focus-item label {
            display: block;
            margin-bottom: 7px;
            color: #64748b;
            font-size: 9px;
            font-weight: 500;
        }

    .csr-pd-pills {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
    }

    .csr-pd-pill {
        display: inline-flex;
        align-items: center;
        min-height: 18px;
        padding: 2px 9px;
        border-radius: 12px;
        font-size: 8.5px;
        font-weight: 600;
    }

    .csr-pd-pill-green {
        background: #dcfce7;
        color: #16a34a;
    }

    .csr-pd-pill-blue {
        background: #dbeafe;
        color: #2563eb;
    }

    .csr-pd-empty {
