@code {

    // =========================================================
    // PARAMETERS
    // =========================================================

    [Parameter]
    public int CSR1Id { get; set; }

    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    [Parameter]
    public EventCallback OnStatusChanged { get; set; }


    // =========================================================
    // STATE
    // =========================================================


    private bool showCSRPopup;
    private bool csrPopupSuccess = true;
    private string csrPopupMessage = string.Empty;

    private void ShowCSRPopup(string message, bool success = true)
    {
        csrPopupMessage = message;
        csrPopupSuccess = success;
        showCSRPopup = true;
    }

    private void CloseCSRPopup()
    {
        showCSRPopup = false;
    }

    private CSR1DetailsDto? details;
    private CSR1SaveRequestWithExpenses? reviewRequest;
    private string reviewError = "";
    private sealed class ReviewLookup { public int Id { get; set; } public string UserId { get; set; } = ""; public string Name { get; set; } = ""; public string UserName { get; set; } = ""; }
    private sealed class ReviewHeadquarter { public int Id { get; set; } public string HeadquarterName { get; set; } = ""; }
    private sealed class ReviewZone { public int Id { get; set; } public string ZoneName { get; set; } = ""; }
    private List<ReviewHeadquarter> reviewHeadquarters = new();
    private List<ReviewZone> reviewZones = new();
    private List<ReviewLookup> reviewEmployees = new();
    private string ReviewMinDate => reviewRequest?.CSR1?.ProgramYear is int y && reviewRequest.CSR1.ProgramMonth is int m && m >= 1 && m <= 12 ? new DateTime(y, m, 1).ToString("yyyy-MM-dd") : "";
    private string ReviewMaxDate => reviewRequest?.CSR1?.ProgramYear is int y && reviewRequest.CSR1.ProgramMonth is int m && m >= 1 && m <= 12 ? new DateTime(y, m, DateTime.DaysInMonth(y, m)).ToString("yyyy-MM-dd") : "";
    private decimal ReviewTotalExpense =>
        reviewRequest?.Expenses?.Sum(x => x.ExpenseAmount) ?? 0m;

    private List<ReviewExpenseInformation> reviewExpenseInformations = new();

    private sealed class ReviewExpenseInformation
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public bool IsActive { get; set; }
    }

    private CSR1ExpenseSaveDto GetReviewExpense(int expenseId)
    {
        if (reviewRequest == null)
            return new CSR1ExpenseSaveDto { ExpenseId = expenseId };

        reviewRequest.Expenses ??= new();
        var row = reviewRequest.Expenses.FirstOrDefault(x => x.ExpenseId == expenseId);
        if (row != null) return row;

        row = new CSR1ExpenseSaveDto { ExpenseId = expenseId, ExpenseAmount = 0m };
        reviewRequest.Expenses.Add(row);
        return row;
    }

    private void UpdateReviewExpense(int expenseId, string? value)
    {
        var row = GetReviewExpense(expenseId);
        row.ExpenseAmount = decimal.TryParse(value, NumberStyles.Any, CultureInfo.InvariantCulture, out var amount)
            ? Math.Max(0m, amount)
            : 0m;
    }
    private void AddReviewProduct(int group, string? value)
    {
        if (int.TryParse(value, out var id) && id > 0) ToggleReviewProduct(group, id, true);
    }
    private List<ReviewLookup> reviewCrops = new();
    private List<ReviewLookup> reviewProducts = new();

    private List<int> GetCrops(int group)
    {
        if (reviewRequest == null) return new();

        return group switch
        {
            1 => reviewRequest.Crop1Ids ??= new(),
            2 => reviewRequest.Crop2Ids ??= new(),
            _ => reviewRequest.Crop3Ids ??= new()
        };
    }

    private void AddReviewCrop(int group, string? value)
    {
        if (int.TryParse(value, out var id) && id > 0)
            ToggleReviewCrop(group, id, true);
    }

    private void ToggleReviewCrop(int group, int cropId, bool selected)
    {
        var list = GetCrops(group);

        if (selected && !list.Contains(cropId))
        {
            if (list.Count >= 3)
            {
                reviewError = "Maximum 3 crops per focus group.";
                return;
            }

            list.Add(cropId);
        }
        else if (!selected)
        {
            list.Remove(cropId);
        }

        reviewError = "";
    }

    private List<int> GetProducts(int group)
    {
        if (reviewRequest == null) return new();
        return group switch
        {
            1 => reviewRequest.Product1Ids ??= new(),
            2 => reviewRequest.Product2Ids ??= new(),
            _ => reviewRequest.Product3Ids ??= new()
        };
    }
    private void ToggleReviewProduct(int group, int productId, bool selected)
    {
        var list = GetProducts(group);
        if (selected && !list.Contains(productId))
        {
            if (list.Count >= 3) { reviewError = "Maximum 3 products per focus group."; return; }
            list.Add(productId);
        }
        else if (!selected) list.Remove(productId);
        reviewError = "";
    }
    private async Task LoadReviewFormAsync()
    {
        reviewRequest = null;
        reviewError = "";
        try
        {
            reviewRequest = await Http.GetFromJsonAsync<CSR1SaveRequestWithExpenses>($"api/CSR1/{CSR1Id}/review-edit");
            reviewExpenseInformations = await Http.GetFromJsonAsync<List<ReviewExpenseInformation>>("api/CSR1/expense-informations") ?? new();
            reviewExpenseInformations = reviewExpenseInformations.Where(x => x.IsActive).OrderBy(x => x.Id).ToList();

            if (reviewRequest != null)
            {
                reviewRequest.Expenses ??= new();
                foreach (var expense in reviewExpenseInformations)
                    _ = GetReviewExpense(expense.Id);
            }

            reviewCrops = await Http.GetFromJsonAsync<List<ReviewLookup>>("api/Budget/crops") ?? new();
            reviewProducts = await Http.GetFromJsonAsync<List<ReviewLookup>>("api/Budget/products") ?? new();
            reviewHeadquarters = await Http.GetFromJsonAsync<List<ReviewHeadquarter>>("api/Budget/headquarters") ?? new();
            reviewZones = await Http.GetFromJsonAsync<List<ReviewZone>>("api/Budget/zones") ?? new();
            reviewEmployees = await Http.GetFromJsonAsync<List<ReviewLookup>>("api/Budget/employees") ?? new();
        }
        catch (Exception ex) { reviewError = $"Could not load editable CSR1 data: {ex.Message}"; }
    }


    // New workflow is opt-in per CSR-1 record. The server must persist this flag.
    // Legacy records continue to use the original role and status checks.
    private Csr1ApprovalFlow? approvalFlow;
    private sealed class Csr1ApprovalFlow
    {
        public bool IsThreeLevelWorkflow { get; set; }
        public bool CanApprove { get; set; }
        public bool CanValidate { get; set; }
        public bool CanReject { get; set; }
        public string? ApprovalLabel { get; set; }
        public string? AwaitingLabel { get; set; }
        public string? ProgramMonth { get; set; }
        public List<Csr1ApprovalStep> Steps { get; set; } = new();
    }
    private sealed class Csr1ApprovalStep
    {
        public string Name { get; set; } = "";
        public string? Actor { get; set; }
        public DateTime? At { get; set; }
        public bool Completed { get; set; }
    }
    private bool IsThreeLevelWorkflow => approvalFlow?.IsThreeLevelWorkflow == true;
    private string ApproveButtonText => IsThreeLevelWorkflow
        ? (approvalFlow?.ApprovalLabel ?? "Approve stage") : "Approve";

    private bool isLoading = false;

    private int lastLoadedId = 0;

    private bool isActionInProgress = false;
    private bool showRejectModal = false;
    private string rejectionRemarks = "";
    private string rejectErrorMessage = "";


    // =========================================================
    // PARAMETER CHANGE
    // =========================================================

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen &&
            CSR1Id > 0 &&
            CSR1Id != lastLoadedId)
        {
            await LoadCSR1Details();
        }
    }


    // =========================================================
    // LOAD DETAILS
    // =========================================================

    private async Task LoadCSR1Details()
    {
        try
        {
            isLoading = true;

            details =
                await Http.GetFromJsonAsync<CSR1DetailsDto>(
                    $"api/CSR1/details/{CSR1Id}");

            await LoadReviewFormAsync();
            approvalFlow = null;
            // Server supplies workflow mode and permissions for post-26th applications.
            // A missing endpoint does not change legacy button behavior.
            try
            {
                using var response = await Http.GetAsync($"api/CSR1/{CSR1Id}/workflow");
                if (response.IsSuccessStatusCode)
                    approvalFlow = await response.Content.ReadFromJsonAsync<Csr1ApprovalFlow>();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"CSR1 optional workflow metadata unavailable: {ex.Message}");
            }

            lastLoadedId =
                CSR1Id;
        }
        catch (Exception ex)
        {
            details = null;
            approvalFlow = null;

            Console.WriteLine(
                $"CSR1 Details Load Error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }


    // =========================================================
    // FOCUS CROPS
    // =========================================================

    private List<string> AllFocusCrops
    {
        get
        {
            if (details == null)
                return new();

            return details.Focus1
                .Concat(details.Focus2)
                .Concat(details.Focus3)
                .Where(x =>
                    !string.IsNullOrWhiteSpace(x.CropName))
                .Select(x =>
                    x.CropName.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
    }


    // =========================================================
    // FOCUS PRODUCTS
    // =========================================================

    private List<string> AllFocusProducts
    {
        get
        {
            if (details == null)
                return new();

            return details.Focus1
                .Concat(details.Focus2)
                .Concat(details.Focus3)
                .Where(x =>
                    !string.IsNullOrWhiteSpace(x.ProductName))
                .Select(x =>
                    x.ProductName.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
    }


    // =========================================================
    // STATUS FLOW & WORKFLOW ELIGIBILITY
    // =========================================================

    private bool IsSubmittedOrLater =>
        details != null &&
        !string.Equals(
            details.Status,
            "Draft",
            StringComparison.OrdinalIgnoreCase);

    // The API resolves CSR-1 scope from the creator role first.
    // A State-level application may still contain HeadquarterId,
    // so never override an explicit State scope with that value.
    private bool IsHQScope =>
        string.Equals(details?.Scope, "HQ", StringComparison.OrdinalIgnoreCase);

    private bool IsStateScope =>
        string.Equals(details?.Scope, "State", StringComparison.OrdinalIgnoreCase);

    // Existing rules below remain unchanged; only three-level records branch away.
    private bool CanValidate => IsThreeLevelWorkflow
        ? details != null && approvalFlow?.CanValidate == true
        : LegacyCanValidate;
    private bool CanApprove => IsThreeLevelWorkflow
        ? details != null && approvalFlow?.CanApprove == true
        : LegacyCanApprove;
    private bool CanReject => IsThreeLevelWorkflow
        ? details != null && approvalFlow?.CanReject == true
        : LegacyCanReject;

    private bool LegacyCanValidate =>
        details != null &&
        (string.Equals(details.Status, "SubmittedForValidation", StringComparison.OrdinalIgnoreCase) ||
         string.Equals(details.Status, "Submitted", StringComparison.OrdinalIgnoreCase) ||
         string.Equals(details.Status, "Pending", StringComparison.OrdinalIgnoreCase)) &&
        (loginState.IsAdmin ||
         (IsHQScope && loginState.UserRole == AppRole.MO) ||
         (IsStateScope && loginState.UserRole == AppRole.SMD));

    private bool LegacyCanApprove =>
        details != null &&
        (string.Equals(details.Status, "Validated", StringComparison.OrdinalIgnoreCase) ||
         (loginState.IsAdmin && (string.Equals(details.Status, "SubmittedForValidation", StringComparison.OrdinalIgnoreCase) ||
                                string.Equals(details.Status, "Validated", StringComparison.OrdinalIgnoreCase)))) &&
        (loginState.IsAdmin ||
         (IsHQScope && (loginState.UserRole == AppRole.RM || loginState.UserRole == AppRole.RMD)) ||
         (IsStateScope && loginState.UserRole == AppRole.SMM));

    private bool IsAwaitingValidation => !IsThreeLevelWorkflow && LegacyIsAwaitingValidation;
    private bool LegacyIsAwaitingValidation =>
        details != null &&
        (string.Equals(details.Status, "SubmittedForValidation", StringComparison.OrdinalIgnoreCase) ||
         string.Equals(details.Status, "Submitted", StringComparison.OrdinalIgnoreCase) ||
         string.Equals(details.Status, "Pending", StringComparison.OrdinalIgnoreCase)) &&
        ((IsHQScope && (loginState.UserRole == AppRole.RM || loginState.UserRole == AppRole.RMD)) ||
         (IsStateScope && loginState.UserRole == AppRole.SMM));

    private bool LegacyCanReject =>
        details != null &&
        !string.Equals(details.Status, "Approved", StringComparison.OrdinalIgnoreCase) &&
        !string.Equals(details.Status, "Rejected", StringComparison.OrdinalIgnoreCase) &&
        !string.Equals(details.Status, "Draft", StringComparison.OrdinalIgnoreCase) &&
        (loginState.IsAdmin ||
         (IsHQScope && (loginState.UserRole == AppRole.MO || loginState.UserRole == AppRole.RM || loginState.UserRole == AppRole.RMD)) ||
         (IsStateScope && (loginState.UserRole == AppRole.SMD || loginState.UserRole == AppRole.SMM)));

    private async Task ValidateCSR1()
    {
        if (details == null || isActionInProgress || !CanValidate || reviewRequest == null) return;
        try
        {
            isActionInProgress = true;
            reviewError = "";
            var response = await Http.PostAsJsonAsync($"api/CSR1/{details.Id}/validate", reviewRequest);
            if (response.IsSuccessStatusCode)
            {
                ShowCSRPopup("CSR-1 validated successfully.");
                await LoadCSR1Details();
                await OnStatusChanged.InvokeAsync();
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                ShowCSRPopup(string.IsNullOrWhiteSpace(err) ? "Failed to validate CSR-1." : err, false);
            }
        }
        catch (Exception ex)
        {
            ShowCSRPopup($"Error validating CSR-1: {ex.Message}", false);
        }
        finally
        {
            isActionInProgress = false;
        }
    }

    private async Task ApproveCSR1()
    {
        if (details == null || isActionInProgress || !CanApprove || reviewRequest == null) return;
        try
        {
            isActionInProgress = true;
            // Backend must branch by persisted workflow mode and authorize each stage.
            reviewError = "";
            var response = await Http.PostAsJsonAsync($"api/CSR1/{details.Id}/approve", reviewRequest);
            if (response.IsSuccessStatusCode)
            {
                ShowCSRPopup(IsThreeLevelWorkflow
                    ? "CSR-1 approval stage completed successfully."
                    : "CSR-1 approved successfully.");
                await LoadCSR1Details();
                await OnStatusChanged.InvokeAsync();
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                ShowCSRPopup(string.IsNullOrWhiteSpace(err) ? "Failed to approve CSR-1." : err, false);
            }
        }
        catch (Exception ex)
        {
            ShowCSRPopup($"Error approving CSR-1: {ex.Message}", false);
        }
        finally
        {
            isActionInProgress = false;
        }
    }

    private void OpenRejectModal()
    {
        rejectionRemarks = "";
        rejectErrorMessage = "";
        showRejectModal = true;
    }

    private void CloseRejectModal()
    {
        showRejectModal = false;
        rejectionRemarks = "";
        rejectErrorMessage = "";
    }

    private async Task SubmitRejection()
    {
        if (details == null || isActionInProgress) return;
        if (string.IsNullOrWhiteSpace(rejectionRemarks))
        {
            rejectErrorMessage = "Please enter rejection remarks.";
            ShowCSRPopup(rejectErrorMessage, false);
            return;
        }

        try
        {
            isActionInProgress = true;
            var request = new CSR1RejectRequest { Remarks = rejectionRemarks.Trim() };
            var response = await Http.PostAsJsonAsync($"api/CSR1/{details.Id}/reject", request);
            if (response.IsSuccessStatusCode)
            {
                ShowCSRPopup("CSR-1 rejected successfully.");
                showRejectModal = false;
                await LoadCSR1Details();
                await OnStatusChanged.InvokeAsync();
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                rejectErrorMessage = string.IsNullOrWhiteSpace(err) ? "Failed to reject CSR-1." : err;
                ShowCSRPopup(rejectErrorMessage, false);
            }
        }
        catch (Exception ex)
        {
            rejectErrorMessage = ex.Message;
            ShowCSRPopup($"Error rejecting CSR-1: {ex.Message}", false);
        }
        finally
        {
            isActionInProgress = false;
        }
    }

    private string GetHeaderStatusClass(
        string? status)
    {
        var css =
            status?.Trim().ToLowerInvariant() switch
            {
                "approved" =>
                    "csr-pd-status-approved",

                "validated" =>
                    "csr-pd-status-validated",

                "rejected" =>
                    "csr-pd-status-rejected",

                "submittedforvalidation" =>
                    "csr-pd-status-pending",

                "submitted" =>
                    "csr-pd-status-pending",

                "pending" =>
                    "csr-pd-status-pending",

                _ =>
                    "csr-pd-status-default"
            };

        return $"csr-pd-status {css}";
    }


    private string GetStatusDisplay(
        string? status)
    {
        if (string.Equals(
            status,
            "SubmittedForValidation",
            StringComparison.OrdinalIgnoreCase))
        {
            return "Pending";
        }

        return string.IsNullOrWhiteSpace(status)
            ? "-"
            : status;
    }


