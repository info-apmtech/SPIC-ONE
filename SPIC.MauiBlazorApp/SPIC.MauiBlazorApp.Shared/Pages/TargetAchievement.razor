@page "/TargetAchievement"
@using System.Net.Http.Json
@using SPIC.Core.DTOs
@using SPIC.MauiBlazorApp.Shared.Pages.Lab.Analyst
@inject SPIC.MauiBlazorApp.Shared.Services.ToastService Toast
@inject HttpClient Http

<div class="container-fluid py-4 px-0 tga-page">

    <h2 class="tga-title">Yearly Target Allocation</h2>
    <p class="tga-subtitle">Set the yearly SPCM and Soil Sample collection target for each JMDO.</p>

    <div class="tga-card tga-form-card">
        <h3 class="tga-card-title">Allocate target to a JMDO</h3>
        <p class="tga-card-subtitle">Choose a JMDO, then set their target for FY @AnalystText.FinancialYear(AnalystText.CurrentFinancialYear).</p>

        <label class="tga-field-label" for="tga-jmdo">JMDO<span class="tga-required">*</span></label>
        <select id="tga-jmdo" class="tga-select" @bind="selectedJmdoId" @bind:after="LoadSelectedJmdoTargets" disabled="@(_isLoadingJmdos || _jmdos.Count == 0 || _saving)">
            @if (_isLoadingJmdos)
            {
                <option value="0">Loading JMDOs...</option>
            }
            else if (_loadError)
            {
                <option value="0">Could not load JMDOs</option>
            }
            else if (_jmdos.Count == 0)
            {
                <option value="0">No JMDOs found for your HQ</option>
            }
            else
            {
                <option value="0">Select a JMDO</option>
                @foreach (var jmdo in _jmdos)
                {
                    <option value="@jmdo.EmployeeLoginId">@jmdo.Name &mdash; @JmdoSubLabel(jmdo.EmployeeCode, jmdo.HeadquarterName)</option>
                }
            }
        </select>

        <div class="tga-target-row">
            <div class="tga-target-field">
                <label class="tga-field-label" for="tga-spcm">SPCM Target (yearly)<span class="tga-required">*</span></label>
                <input id="tga-spcm" type="number" min="0" class="tga-input" placeholder="e.g. 420" @bind="spcmTarget" @bind:event="oninput" />
            </div>
            <div class="tga-target-field">
                <label class="tga-field-label" for="tga-soil">Soil Sample Target (yearly)<span class="tga-required">*</span></label>
                <input id="tga-soil" type="number" min="0" class="tga-input" placeholder="e.g. 180" @bind="soilTarget" @bind:event="oninput" />
            </div>
        </div>

        <button type="button" class="tga-btn-save" disabled="@(_saving || selectedJmdoId == 0 || string.IsNullOrWhiteSpace(spcmTarget) || string.IsNullOrWhiteSpace(soilTarget))" @onclick="SaveTargetAllocation">
            <i class="bi bi-check-lg"></i> @(_saving ? "Saving..." : "Save Target Allocation")
        </button>
    </div>

    @if (_targetsError)
    {
        <div class="tga-card">
            <h3 class="tga-card-title">Current yearly targets</h3>
            <p class="tga-card-subtitle">Across all JMDOs in your region.</p>
            <EmptyState Icon="bi-exclamation-triangle" Title="Could not load yearly targets" Message="Please refresh the page to try again." Compact="true" />
        </div>
    }
    else
    {
        <SpicDataTable Items="_targets"
                       IsLoading="_isLoadingTargets"
                       Title="Current yearly targets"
                       FileName="YearlyTargets"
                       ExportColumns="GetExportColumns()"
                       SearchText="@_searchText"
                       EmptyTitle="@(_targets.Count == 0 ? "No yearly targets allocated yet" : null)">
            <FilterControls>
                <input type="text" class="tga-select tga-quick-search"
                       placeholder="Search..."
                       @bind="_searchText" @bind:event="oninput" @bind:after="StateHasChanged" />
            </FilterControls>
            <TableHeader>
                <th>JMDO</th>
                <th>Financial Year</th>
                <th>SPCM Target</th>
                <th>Soil Sample Target</th>
                <th></th>
            </TableHeader>
            <TableRow Context="row">
                <td class="tga-cell-header">
                    <div class="tga-jmdo-name">@row.Name</div>
                    <div class="tga-jmdo-sub">@JmdoSubLabel(row.EmployeeCode, row.HeadquarterName)</div>
                </td>
                <td data-label="Financial Year">@AnalystText.FinancialYear(row.FinancialYearStart)</td>
                <td data-label="SPCM Target">@row.SpcmTarget</td>
                <td data-label="Soil Sample Target">@row.SoilSampleTarget</td>
                <td class="tga-cell-actions">
                    <button type="button" class="tga-icon-btn" title="Edit target" disabled="@_saving" @onclick="() => EditTarget(row)">
                        <i class="bi bi-pencil"></i>
                    </button>
                </td>
            </TableRow>
            <CardActions Context="row">
                <button type="button" class="tga-icon-btn" title="Edit target" disabled="@_saving" @onclick="() => EditTarget(row)">
                    <i class="bi bi-pencil"></i>
                </button>
            </CardActions>
        </SpicDataTable>
    }

</div>

@code {
    // JMDO list comes from api/Team/jmdos - the same endpoint and HQ scoping MdoDashboard uses
    // for "this MDO's team". Saved targets come from api/Team/yearly-targets, which applies the
    // same team scope server-side and decides the financial year itself (current April-March FY).
    private bool _isLoadingJmdos = true;
    private bool _loadError;
    private List<TeamJmdoDto> _jmdos = new();

    private bool _isLoadingTargets = true;
    private bool _targetsError;
    private List<JmdoYearlyTargetDto> _targets = new();

    private int selectedJmdoId;
    private string spcmTarget = "";
    private string soilTarget = "";
    private bool _saving;

    // Quick free-text box inside the table toolbar - SpicDataTable matches this against every
    // export column on its own, same pattern as TaskMonitoring.razor/AllocationRequests.razor.
    private string _searchText = "";

    private List<ExportColumn<JmdoYearlyTargetDto>> GetExportColumns() => new()
    {
        new() { Header = "JMDO", ValueSelector = r => r.Name },
        new() { Header = "Employee Code", ValueSelector = r => r.EmployeeCode ?? "" },
        new() { Header = "Headquarter", ValueSelector = r => r.HeadquarterName ?? "" },
        new() { Header = "Financial Year", ValueSelector = r => AnalystText.FinancialYear(r.FinancialYearStart) },
        new() { Header = "SPCM Target", ValueSelector = r => r.SpcmTarget.ToString() },
        new() { Header = "Soil Sample Target", ValueSelector = r => r.SoilSampleTarget.ToString() }
    };

    private static string JmdoSubLabel(string? employeeCode, string? headquarterName)
    {
        var code = string.IsNullOrWhiteSpace(employeeCode) ? "Code Pending" : employeeCode;
        return string.IsNullOrWhiteSpace(headquarterName) ? code : $"{code} · {headquarterName}";
    }

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadJmdosAsync(), LoadTargetsAsync());
    }

    private async Task LoadJmdosAsync()
    {
        _isLoadingJmdos = true;
        try
        {
            _jmdos = await Http.GetFromJsonAsync<List<TeamJmdoDto>>("api/Team/jmdos") ?? new();
        }
        catch (Exception ex)
        {
            _loadError = true;
            Console.WriteLine($"Error loading JMDO team: {ex.Message}");
            Toast.Error("Could not load your JMDOs. Please try again.");
        }
        finally
        {
            _isLoadingJmdos = false;
        }
    }

    private async Task LoadTargetsAsync()
    {
        _isLoadingTargets = true;
        _targetsError = false;
        try
        {
            _targets = await Http.GetFromJsonAsync<List<JmdoYearlyTargetDto>>("api/Team/yearly-targets") ?? new();
        }
        catch (Exception ex)
        {
            _targetsError = true;
            Console.WriteLine($"Error loading yearly targets: {ex.Message}");
            Toast.Error("Could not load yearly targets.");
        }
        finally
        {
            _isLoadingTargets = false;
        }
    }

    // Prefills the form with the JMDO's saved target for this FY, or clears it if none exists yet.
    private void LoadSelectedJmdoTargets()
    {
        var saved = _targets.FirstOrDefault(t => t.EmployeeLoginId == selectedJmdoId);
        spcmTarget = saved?.SpcmTarget.ToString() ?? "";
        soilTarget = saved?.SoilSampleTarget.ToString() ?? "";
    }

    private void EditTarget(JmdoYearlyTargetDto row)
    {
        selectedJmdoId = row.EmployeeLoginId;
        spcmTarget = row.SpcmTarget.ToString();
        soilTarget = row.SoilSampleTarget.ToString();
    }

    private async Task SaveTargetAllocation()
    {
        if (_saving) return;

        var jmdo = _jmdos.FirstOrDefault(j => j.EmployeeLoginId == selectedJmdoId);
        if (jmdo is null)
        {
            Toast.Warning("Select a JMDO.");
            return;
        }
        if (!int.TryParse(spcmTarget, out var spcm) || spcm < 0 || !int.TryParse(soilTarget, out var soil) || soil < 0)
        {
            Toast.Warning("Enter valid, non-negative SPCM and Soil Sample targets.");
            return;
        }

        _saving = true;
        try
        {
            var response = await Http.PutAsJsonAsync("api/Team/yearly-targets",
                new SaveJmdoYearlyTargetDto { EmployeeLoginId = jmdo.EmployeeLoginId, SpcmTarget = spcm, SoilSampleTarget = soil });

            if (!response.IsSuccessStatusCode)
            {
                Toast.Error(await ReadErrorAsync(response) ?? "Could not save the target allocation. Please try again.");
                return;
            }

            Toast.Success($"{jmdo.Name}'s yearly target saved.");
            await LoadTargetsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Saving yearly target failed: {ex.Message}");
            Toast.Error("Could not reach the server to save the target allocation.");
        }
        finally
        {
            _saving = false;
        }
    }

    private static async Task<string?> ReadErrorAsync(HttpResponseMessage response)
    {
        try
        {
            var body = await response.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
            return body.TryGetProperty("message", out var m) || body.TryGetProperty("Message", out m) ? m.GetString() : null;
        }
        catch (Exception)
        {
            return null;
        }
    }
}
