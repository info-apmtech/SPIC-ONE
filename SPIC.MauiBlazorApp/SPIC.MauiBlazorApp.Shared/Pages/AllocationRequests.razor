@page "/AllocationRequests"
@using System.Net.Http.Json
@using SPIC.Core.Entities
@using SPIC.Core.DTOs
@using SPIC.MauiBlazorApp.Shared.Services
@inject NavigationManager Navigation
@inject HttpClient Http
@inject SPIC.MauiBlazorApp.Shared.Services.ToastService Toast
@inject SPIC.MauiBlazorApp.Shared.Services.LoginState LoginState
@inject LookupCacheService LookupCache

<div class="container-fluid py-4 px-0 alreq-page">

    <h2 class="alreq-title">Allocation Requests</h2>
    <p class="alreq-subtitle">Review and approve each JMDO's daily allocation &mdash; dealer tasks, SPCM &amp; soil sample targets, and MD programs.</p>

    <div class="alreq-tabs" role="tablist">
        <button type="button"
                class="alreq-tab @(currentTab == ReqTab.Allocations ? "active" : "")"
                role="tab"
                aria-selected="@(currentTab == ReqTab.Allocations ? "true" : "false")"
                @onclick="() => currentTab = ReqTab.Allocations">
            Allocations
        </button>
        <button type="button"
                class="alreq-tab @(currentTab == ReqTab.Postpone ? "active" : "")"
                role="tab"
                aria-selected="@(currentTab == ReqTab.Postpone ? "true" : "false")"
                @onclick="() => currentTab = ReqTab.Postpone">
            Postpone Requests @(PostponeRows.Count > 0 ? $"({PostponeRows.Count})" : "")
        </button>
    </div>

    @if (currentTab == ReqTab.Allocations)
    {
    @if (!_isLoading && !_loadFailed && Rows.Any())
    {
        <div class="alreq-notice-banner">
            <i class="bi bi-info-circle-fill"></i>
            @if (LoginState.UserRole == AppRole.Admin)
            {
                <span>@Rows.Count allocation(s) shown &mdash; pending ones need your approval, approved ones can still be edited (dealer, date, targets) if something needs correcting.</span>
            }
            else
            {
                <span>@Rows.Count JMDO(s) have submitted their allocation for your approval. Review and approve them one by one.</span>
            }
        </div>
    }

    @if (_loadFailed)
    {
        <div class="alreq-card p-3 text-muted">Couldn't load allocation requests. Please try again in a moment.</div>
    }
    else
    {
        <SpicDataTable Items="FilteredRows"
                       IsLoading="_isLoading"
                       Title="Allocation Requests"
                       FileName="AllocationRequests"
                       ExportColumns="GetExportColumns()"
                       SearchText="@_searchText"
                       EmptyTitle="@(Rows.Any() ? "No allocation requests match these filters" : "No pending allocation requests")">
            <FilterControls>
                <div class="alreq-filter-toolbar">
                    <input type="text" class="alreq-filter-select alreq-filter-search"
                           placeholder="Search..."
                           @bind="_searchText" @bind:event="oninput" @bind:after="StateHasChanged" />
                    <select class="alreq-filter-select" @bind="selectedDistrictFilter" @bind:after="OnDistrictFilterChanged">
                        <option value="0">All Districts</option>
                        @foreach (var district in AvailableDistrictFilters)
                        {
                            <option value="@district.Id">@district.DistrictName</option>
                        }
                    </select>
                    <select class="alreq-filter-select" @bind="selectedTalukFilter" @bind:after="OnTalukFilterChanged">
                        <option value="">All Sub Districts</option>
                        @foreach (var taluk in AvailableTalukFilters)
                        {
                            <option value="@taluk">@taluk</option>
                        }
                    </select>
                    <select class="alreq-filter-select" @bind="selectedJmdoFilter">
                        <option value="">All JMDOs</option>
                        @foreach (var jmdo in AvailableJmdoFilters)
                        {
                            <option value="@jmdo">@jmdo</option>
                        }
                    </select>
                </div>
            </FilterControls>
            <TableHeader>
                <th class="alreq-th-jmdo">JMDO</th>
                @if (LoginState.UserRole == AppRole.Admin)
                {
                    <th class="alreq-th-sm" style="@SmColumnWidthStyle">Status</th>
                }
                <th class="alreq-th-sm" style="@SmColumnWidthStyle">Submitted</th>
                <th class="alreq-th-sm" style="@SmColumnWidthStyle">Dealer Tasks</th>
                <th class="alreq-th-sm" style="@SmColumnWidthStyle">SPCM Target</th>
                <th class="alreq-th-sm" style="@SmColumnWidthStyle">Soil Target</th>
                <th class="alreq-th-sm" style="@SmColumnWidthStyle">MD Programs</th>
                <th class="alreq-th-sm" style="@SmColumnWidthStyle">Pos Liquidation</th>
                <th></th>
            </TableHeader>
            <TableRow Context="row">
                <td class="alreq-cell-header">
                    <div class="alreq-jmdo-cell">
                        <span class="alreq-avatar">@Initials(row.JmdoName)</span>
                        <div>
                            <div class="alreq-jmdo-name">@row.JmdoName</div>
                            <div class="alreq-jmdo-sub">@(row.JmdoCode ?? "Code Pending") &middot; @(row.Location ?? "—")</div>
                        </div>
                    </div>
                </td>
                @if (LoginState.UserRole == AppRole.Admin)
                {
                    <td data-label="Status">
                        <span class="alreq-status-pill alreq-status-@(row.Status.ToLowerInvariant())">@row.Status</span>
                    </td>
                }
                <td data-label="Submitted">@row.SubmittedAt.ToString("dd MMM yyyy")</td>
                <td data-label="Dealer Tasks">@row.DealerCount</td>
                <td data-label="SPCM Target">@(row.SpcmTarget ?? 0)</td>
                <td data-label="Soil Target">@(row.SoilSampleTarget ?? 0)</td>
                <td data-label="MD Programs">@row.ProgramCount</td>
                <td data-label="Pos Liquidation">@row.PosLiquidationFieldCount</td>
                <td class="alreq-cell-actions">
                    <button type="button" class="alreq-btn-review" @onclick='() => Navigation.NavigateTo($"/AllocationRequestReview?allocationId={row.AllocationId}")'>
                        @(row.Status == "Approved" ? "Edit" : "Review") <i class="bi bi-arrow-right"></i>
                    </button>
                </td>
            </TableRow>
            <CardActions Context="row">
                <button type="button" class="alreq-btn-review" @onclick='() => Navigation.NavigateTo($"/AllocationRequestReview?allocationId={row.AllocationId}")'>
                    @(row.Status == "Approved" ? "Edit" : "Review") <i class="bi bi-arrow-right"></i>
                </button>
            </CardActions>
        </SpicDataTable>
    }
    }
    else
    {
        @* Postpone Requests: a JMDO asking to move one dealer visit to a different day - see
           JmdoDealerVisitPostponeRequest's own doc comment. HQ-scoped server-side the same way
           the Allocations tab above is. *@
        @if (_postponeLoadFailed)
        {
            <div class="alreq-card p-3 text-muted">Couldn't load postpone requests. Please try again in a moment.</div>
        }
        else
        {
            @* Bulk select, same mechanic as the JMDO's own multi-select postpone request (see
               TasksAllocation.razor) - check one or more rows, then Approve/Reject them together
               instead of one row at a time. *@
            @if (_selectedPostponeIds.Count > 0)
            {
                <div class="alreq-postpone-selection-bar">
                    <span>@_selectedPostponeIds.Count request(s) selected</span>
                    <div class="alreq-postpone-selection-actions">
                        <button type="button" class="alreq-modal-btn-outline" @onclick="ClearPostponeSelection">Clear</button>
                        <button type="button" class="alreq-modal-btn-outline" @onclick="OpenBulkRejectPostpone">Reject Selected</button>
                        <button type="button" class="alreq-btn-review" @onclick="OpenBulkApprovePostpone">Approve Selected</button>
                    </div>
                </div>
            }
            <SpicDataTable Items="PostponeRows"
                           IsLoading="_isLoadingPostpone"
                           Title="Postpone Requests"
                           FileName="PostponeRequests"
                           ExportColumns="GetPostponeExportColumns()"
                           EmptyTitle="No postpone requests awaiting review">
                <TableHeader>
                    <th class="alreq-th-select">
                        <input type="checkbox" checked="@IsAllPostponeSelected" @onchange="TogglePostponeSelectAll" aria-label="Select all" />
                    </th>
                    <th class="alreq-th-jmdo">JMDO</th>
                    <th class="alreq-th-dealer">Dealer</th>
                    <th class="alreq-th-pr-sm">Current Day/Date</th>
                    <th class="alreq-th-pr-sm">Current Status</th>
                    <th class="alreq-th-pr-sm">Requested Date</th>
                    <th class="alreq-th-reason">Reason</th>
                    <th class="alreq-th-pr-sm">Target Week</th>
                </TableHeader>
                <TableRow Context="row">
                    <td data-label="Select">
                        <input type="checkbox" checked="@_selectedPostponeIds.Contains(row.Id)" @onchange="() => TogglePostponeRow(row.Id)" aria-label="Select @row.DealerName" />
                    </td>
                    <td class="alreq-cell-header">
                        <div class="alreq-jmdo-cell">
                            <span class="alreq-avatar">@Initials(row.JmdoName)</span>
                            <div>
                                <div class="alreq-jmdo-name">@row.JmdoName</div>
                                <div class="alreq-jmdo-sub">@(row.JmdoCode ?? "Code Pending") &middot; @(row.Location ?? "—")</div>
                            </div>
                        </div>
                    </td>
                    <td data-label="Dealer" class="alreq-cell-dealer">@row.DealerName <span class="text-muted">(@row.DealerCode)</span></td>
                    <td data-label="Current Day/Date">@FormatPostponeOriginal(row)</td>
                    <td data-label="Current Status">@row.DealerTaskStatus</td>
                    <td data-label="Requested Date">@row.RequestedDate.ToString("dd MMM yyyy")</td>
                    <td data-label="Reason" class="alreq-cell-reason">@row.Reason</td>
                    <td data-label="Target Week">
                        @if (row.TargetWeekAllocationStatus == "Pending")
                        {
                            <span class="alreq-status-pill alreq-status-pending" title="That week's own allocation must be approved first">Pending approval</span>
                        }
                        else
                        {
                            <span class="text-muted" title="Requested date falls in the same week - nothing to check">Same week</span>
                        }
                    </td>
                </TableRow>
                <CardActions Context="row">
                    <label class="alreq-select-checkbox">
                        <input type="checkbox" checked="@_selectedPostponeIds.Contains(row.Id)" @onchange="() => TogglePostponeRow(row.Id)" />
                        <span>Select for bulk action</span>
                    </label>
                </CardActions>
            </SpicDataTable>
        }
    }

</div>

@* Approve/Reject postpone-request modals - act on every currently selected request at once
   (see _selectedPostponeIds above) instead of one row at a time. Each still goes through the
   API's own per-row approve/reject call (one visit = one independent approval row), but the MDO
   only confirms once; ConfirmApprovePostpone/ConfirmRejectPostpone report a combined
   success/failure summary rather than letting one bad row silently swallow the rest. *@
@if (_approvePostponeOpen)
{
    <div class="alreq-modal-overlay">
        <div class="alreq-modal-card">
            <div class="alreq-modal-header">
                <h4>Approve Postponement</h4>
                <button type="button" class="alreq-modal-close" @onclick="() => _approvePostponeOpen = false">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="alreq-modal-body">
                <p>Approve <strong>@SelectedPostponeRows.Count</strong> request(s)? Each visit moves to its own requested date, with existing progress preserved.</p>
                <ul class="alreq-postpone-selected-list">
                    @foreach (var r in SelectedPostponeRows)
                    {
                        <li>@r.DealerName <span class="text-muted">(@r.JmdoName &middot; @r.RequestedDate.ToString("dd MMM yyyy"))</span></li>
                    }
                </ul>
                <div class="alreq-modal-field">
                    <label for="alreq-approve-remarks">Remarks (optional)</label>
                    <textarea id="alreq-approve-remarks" rows="2" class="alreq-filter-select" @bind="_approvePostponeRemarks"></textarea>
                </div>
                @if (!string.IsNullOrWhiteSpace(_postponeActionError))
                {
                    <p class="text-danger mt-2">@_postponeActionError</p>
                }
            </div>
            <div class="alreq-modal-footer">
                <button type="button" class="alreq-modal-btn-outline" @onclick="() => _approvePostponeOpen = false" disabled="@_postponeActionBusy">Cancel</button>
                <button type="button" class="alreq-modal-btn-primary" disabled="@_postponeActionBusy" @onclick="ConfirmApprovePostpone">
                    @(_postponeActionBusy ? "Approving..." : $"Yes, Approve ({SelectedPostponeRows.Count})")
                </button>
            </div>
        </div>
    </div>
}

@if (_rejectPostponeOpen)
{
    <div class="alreq-modal-overlay">
        <div class="alreq-modal-card">
            <div class="alreq-modal-header">
                <h4>Reject Postponement</h4>
                <button type="button" class="alreq-modal-close" @onclick="() => _rejectPostponeOpen = false">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="alreq-modal-body">
                <p>Reject <strong>@SelectedPostponeRows.Count</strong> request(s)? Each visit stays on its original date.</p>
                <ul class="alreq-postpone-selected-list">
                    @foreach (var r in SelectedPostponeRows)
                    {
                        <li>@r.DealerName <span class="text-muted">(@r.JmdoName)</span></li>
                    }
                </ul>
                <div class="alreq-modal-field">
                    <label for="alreq-reject-remarks">Remarks (optional)</label>
                    <textarea id="alreq-reject-remarks" rows="2" class="alreq-filter-select" @bind="_rejectPostponeRemarks"></textarea>
                </div>
                @if (!string.IsNullOrWhiteSpace(_postponeActionError))
                {
                    <p class="text-danger mt-2">@_postponeActionError</p>
                }
            </div>
            <div class="alreq-modal-footer">
                <button type="button" class="alreq-modal-btn-outline" @onclick="() => _rejectPostponeOpen = false" disabled="@_postponeActionBusy">Cancel</button>
                <button type="button" class="alreq-modal-btn-danger" disabled="@_postponeActionBusy" @onclick="ConfirmRejectPostpone">
                    @(_postponeActionBusy ? "Rejecting..." : $"Yes, Reject ({SelectedPostponeRows.Count})")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private sealed class PendingAllocationRowDto
    {
        public int AllocationId { get; set; }
        public string Status { get; set; } = "";
        public string JmdoName { get; set; } = "";
        public string? JmdoCode { get; set; }
        public string? Location { get; set; }
        public DateTime SubmittedAt { get; set; }
        public int DealerCount { get; set; }
        public int? SpcmTarget { get; set; }
        public int? SoilSampleTarget { get; set; }
        public int ProgramCount { get; set; }
        public int PosLiquidationFieldCount { get; set; }
        public List<PendingAllocationDealerFilterDto> Dealers { get; set; } = new();
    }

    private sealed class PendingAllocationDealerFilterDto
    {
        public int SubDealerId { get; set; }
        public string DealerName { get; set; } = "";
        public string DealerCode { get; set; } = "";
        public int? DistrictId { get; set; }
        public string? Taluk { get; set; }
    }

    private bool _isLoading = true;
    private bool _loadFailed;
    private List<PendingAllocationRowDto> Rows = new();

    // District / Sub District (Taluk) / JMDO filters, same cascading pattern as
    // TasksAllocation.razor's own Dealer tab filters - 0/"" mean "no filter". District/Taluk
    // options still come from the dealers inside each allocation (an allocation can span several
    // districts across its dealer tasks); JMDO narrows which of those allocations are shown.
    private int selectedDistrictFilter = 0;
    private string selectedTalukFilter = "";
    private string selectedJmdoFilter = "";

    private IEnumerable<PendingAllocationDealerFilterDto> AllDealers => Rows.SelectMany(r => r.Dealers);

    private IEnumerable<PendingAllocationDealerFilterDto> DistrictFilteredDealers =>
        selectedDistrictFilter > 0 ? AllDealers.Where(d => d.DistrictId == selectedDistrictFilter) : AllDealers;

    private IEnumerable<LocationItemDto> AvailableDistrictFilters =>
        LookupCache.Districts
            .Where(dist => AllDealers.Any(d => d.DistrictId == dist.Id))
            .OrderBy(dist => dist.DistrictName);

    private IEnumerable<string> AvailableTalukFilters =>
        DistrictFilteredDealers
            .Select(d => d.Taluk)
            .Where(t => !string.IsNullOrWhiteSpace(t))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(t => t);

    private IEnumerable<PendingAllocationRowDto> DistrictFilteredRows =>
        selectedDistrictFilter > 0 ? Rows.Where(r => r.Dealers.Any(d => d.DistrictId == selectedDistrictFilter)) : Rows;

    private IEnumerable<PendingAllocationRowDto> DistrictAndTalukFilteredRows =>
        string.IsNullOrWhiteSpace(selectedTalukFilter)
            ? DistrictFilteredRows
            : DistrictFilteredRows.Where(r => r.Dealers.Any(d => string.Equals(d.Taluk, selectedTalukFilter, StringComparison.OrdinalIgnoreCase)));

    private IEnumerable<string> AvailableJmdoFilters =>
        DistrictAndTalukFilteredRows.Select(r => r.JmdoName).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(n => n);

    private void OnDistrictFilterChanged()
    {
        selectedTalukFilter = "";
        selectedJmdoFilter = "";
    }

    private void OnTalukFilterChanged() => selectedJmdoFilter = "";

    private IEnumerable<PendingAllocationRowDto> FilteredRows =>
        DistrictAndTalukFilteredRows.Where(r =>
            string.IsNullOrWhiteSpace(selectedJmdoFilter) || string.Equals(r.JmdoName, selectedJmdoFilter, StringComparison.OrdinalIgnoreCase));

    // Free-text search - SpicDataTable matches this against every column below on its own,
    // no extra filtering logic needed here.
    private string _searchText = "";

    // table-layout: fixed needs every column told its width explicitly, computed here rather
    // than as a flat CSS percentage: the "Status" column only renders for Admin, so the number
    // of .alreq-th-sm columns actually in the row is 7 for Admin and 6 for everyone else. A
    // fixed per-column % sized for one count left the row short (and the extra space collapsed
    // the other columns into each other) whenever the other count rendered instead. Dividing a
    // constant 74% budget (JMDO gets 20%, actions gets a fixed 110px - see AllocationRequests.css)
    // by however many columns are actually present keeps the row exactly full either way.
    private int SmColumnCount => LoginState.UserRole == AppRole.Admin ? 7 : 6;
    private string SmColumnWidthStyle => $"width:{74.0 / SmColumnCount:0.##}%;";

    private List<ExportColumn<PendingAllocationRowDto>> GetExportColumns() => new()
    {
        new() { Header = "JMDO", ValueSelector = r => r.JmdoName },
        new() { Header = "Status", ValueSelector = r => r.Status },
        new() { Header = "Submitted", ValueSelector = r => r.SubmittedAt.ToString("dd MMM yyyy") },
        new() { Header = "Dealer Tasks", ValueSelector = r => r.DealerCount.ToString() },
        new() { Header = "SPCM Target", ValueSelector = r => (r.SpcmTarget ?? 0).ToString() },
        new() { Header = "Soil Target", ValueSelector = r => (r.SoilSampleTarget ?? 0).ToString() },
        new() { Header = "MD Programs", ValueSelector = r => r.ProgramCount.ToString() },
        new() { Header = "Pos Liquidation", ValueSelector = r => r.PosLiquidationFieldCount.ToString() }
    };

    private enum ReqTab { Allocations, Postpone }
    private ReqTab currentTab = ReqTab.Allocations;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadPendingAsync(), LookupCache.EnsureLoadedAsync(), LoadPostponePendingAsync());
    }

    // Scoped server-side to "same HQ as the signed-in MDO" - there's no literal
    // reporting-line field anywhere in the data model (see api/Team/jmdos).
    private async Task LoadPendingAsync()
    {
        _isLoading = true;
        _loadFailed = false;
        try
        {
            var result = await Http.GetFromJsonAsync<List<PendingAllocationRowDto>>("api/JmdoTaskAllocation/pending");
            Rows = result ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Pending allocation list load failed: {ex.Message}");
            Toast.Error("Could not load allocation requests. Please try again.");
            _loadFailed = true;
        }
        finally
        {
            _isLoading = false;
        }
    }

    // ---------- Postpone Requests tab ----------
    private bool _isLoadingPostpone = true;
    private bool _postponeLoadFailed;
    private List<PostponeRequestRowDto> PostponeRows = new();

    private async Task LoadPostponePendingAsync()
    {
        _isLoadingPostpone = true;
        _postponeLoadFailed = false;
        try
        {
            var result = await Http.GetFromJsonAsync<List<PostponeRequestRowDto>>("api/JmdoTaskAllocation/postpone-requests/pending");
            PostponeRows = result ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Pending postpone-request list load failed: {ex.Message}");
            Toast.Error("Could not load postpone requests. Please try again.");
            _postponeLoadFailed = true;
        }
        finally
        {
            _isLoadingPostpone = false;
        }
    }

    private static string FormatPostponeOriginal(PostponeRequestRowDto row) =>
        row.OriginalPlannedDate is { } date
            ? date.ToString("dd MMM yyyy")
            : row.OriginalPlannedDay?.ToString() ?? "—";

    private List<ExportColumn<PostponeRequestRowDto>> GetPostponeExportColumns() => new()
    {
        new() { Header = "JMDO", ValueSelector = r => r.JmdoName },
        new() { Header = "Dealer", ValueSelector = r => $"{r.DealerName} ({r.DealerCode})" },
        new() { Header = "Current Day/Date", ValueSelector = FormatPostponeOriginal },
        new() { Header = "Current Status", ValueSelector = r => r.DealerTaskStatus.ToString() },
        new() { Header = "Requested Date", ValueSelector = r => r.RequestedDate.ToString("dd MMM yyyy") },
        new() { Header = "Reason", ValueSelector = r => r.Reason }
    };

    // Bulk selection - same mechanic as the JMDO's own multi-select postpone request
    // (TasksAllocation.razor's _selectedPostponeRowIds): one shared set of request ids, a
    // "select all" checkbox toggles every currently-loaded row, and Approve/Reject act on
    // whatever's selected instead of needing a click per row.
    private readonly HashSet<int> _selectedPostponeIds = new();

    private bool IsAllPostponeSelected => PostponeRows.Count > 0 && PostponeRows.All(r => _selectedPostponeIds.Contains(r.Id));

    private List<PostponeRequestRowDto> SelectedPostponeRows =>
        PostponeRows.Where(r => _selectedPostponeIds.Contains(r.Id)).ToList();

    private void TogglePostponeRow(int id)
    {
        if (!_selectedPostponeIds.Add(id))
            _selectedPostponeIds.Remove(id);
    }

    private void TogglePostponeSelectAll(ChangeEventArgs e)
    {
        var isChecked = (bool)(e.Value ?? false);
        foreach (var row in PostponeRows)
        {
            if (isChecked) _selectedPostponeIds.Add(row.Id);
            else _selectedPostponeIds.Remove(row.Id);
        }
    }

    private void ClearPostponeSelection() => _selectedPostponeIds.Clear();

    private bool _approvePostponeOpen;
    private string _approvePostponeRemarks = "";

    private bool _rejectPostponeOpen;
    private string _rejectPostponeRemarks = "";

    private string? _postponeActionError;
    private bool _postponeActionBusy;

    private void OpenBulkApprovePostpone()
    {
        if (_selectedPostponeIds.Count == 0) return;
        _approvePostponeOpen = true;
        _approvePostponeRemarks = "";
        _postponeActionError = null;
    }

    private void OpenBulkRejectPostpone()
    {
        if (_selectedPostponeIds.Count == 0) return;
        _rejectPostponeOpen = true;
        _rejectPostponeRemarks = "";
        _postponeActionError = null;
    }

    private async Task ConfirmApprovePostpone()
    {
        if (!_approvePostponeOpen || _postponeActionBusy || _selectedPostponeIds.Count == 0) return;
        _postponeActionBusy = true;
        try
        {
            // No date override in the bulk flow - each selected request keeps its own
            // RequestedDate (ApprovedDate left null, same as a single approve with no override),
            // since one shared date wouldn't make sense across visits requesting different days.
            var remarks = string.IsNullOrWhiteSpace(_approvePostponeRemarks) ? null : _approvePostponeRemarks.Trim();
            var (succeeded, failures) = await RunBulkPostponeActionAsync(
                "approve", new ReviewPostponeRequestDto { ReviewRemarks = remarks });

            if (succeeded > 0)
            {
                Toast.Success(failures.Count == 0
                    ? $"{succeeded} postpone request(s) approved."
                    : $"{succeeded} approved, {failures.Count} failed: {string.Join("; ", failures)}");
                _approvePostponeOpen = false;
                await LoadPostponePendingAsync();
            }
            else
            {
                _postponeActionError = string.Join("; ", failures);
            }
        }
        finally
        {
            _postponeActionBusy = false;
        }
    }

    private async Task ConfirmRejectPostpone()
    {
        if (!_rejectPostponeOpen || _postponeActionBusy || _selectedPostponeIds.Count == 0) return;
        _postponeActionBusy = true;
        try
        {
            var remarks = string.IsNullOrWhiteSpace(_rejectPostponeRemarks) ? null : _rejectPostponeRemarks.Trim();
            var (succeeded, failures) = await RunBulkPostponeActionAsync(
                "reject", new RejectPostponeRequestDto { ReviewRemarks = remarks });

            if (succeeded > 0)
            {
                Toast.Success(failures.Count == 0
                    ? $"{succeeded} postpone request(s) rejected."
                    : $"{succeeded} rejected, {failures.Count} failed: {string.Join("; ", failures)}");
                _rejectPostponeOpen = false;
                await LoadPostponePendingAsync();
            }
            else
            {
                _postponeActionError = string.Join("; ", failures);
            }
        }
        finally
        {
            _postponeActionBusy = false;
        }
    }

    // Shared by both bulk confirm handlers - posts to .../{id}/approve or .../{id}/reject for
    // every selected request one at a time (the API has no batch endpoint; each request is its
    // own independent approval row), removing a row from the selection the moment it succeeds so
    // a partial failure leaves only the still-failed ones selected for another attempt.
    private async Task<(int Succeeded, List<string> Failures)> RunBulkPostponeActionAsync(string action, object dto)
    {
        var succeeded = 0;
        var failures = new List<string>();

        foreach (var id in _selectedPostponeIds.ToList())
        {
            var response = await Http.PostAsJsonAsync($"api/JmdoTaskAllocation/postpone-requests/{id}/{action}", dto);
            if (response.IsSuccessStatusCode)
            {
                succeeded++;
                _selectedPostponeIds.Remove(id);
            }
            else
            {
                var dealerName = PostponeRows.FirstOrDefault(r => r.Id == id)?.DealerName ?? $"Request {id}";
                failures.Add($"{dealerName}: {await ReadErrorMessageAsync(response) ?? "request failed"}");
            }
        }

        return (succeeded, failures);
    }

    private static async Task<string?> ReadErrorMessageAsync(HttpResponseMessage response)
    {
        try
        {
            var body = await response.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
            return body.TryGetProperty("message", out var m) ? m.GetString() : null;
        }
        catch
        {
            return null;
        }
    }

    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "—",
            1 => parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant(),
            _ => $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant()
        };
    }
}
