@page "/StockReport"
@implements IDisposable
@inject HttpClient Http
@inject SPIC.MauiBlazorApp.Shared.Services.LoginState LoginState
@inject IJSRuntime JS
@using System.Text.Json
@using System.Net.Http.Json
@using System.Globalization
@using SPIC.Core.DTOs
<div class="spic-sr-container">

	<!-- Header Section -->
	<div class="sr-header-container">
		<div class="sr-header-text">
			<h1>Stock Report</h1>
			<p>View current stock availability across dealers</p>
		</div>
		<div class="sr-action-buttons">
			<button class="sr-btn sr-btn-outline" @onclick="RefreshData" disabled="@_isLoading">
				<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2v6h-6"></path><path d="M3 12a9 9 0 1 0 2.13-5.88L2 9"></path></svg>
				Refresh Data
			</button>
			<button class="sr-btn sr-btn-outline" @onclick="ExportExcel" disabled="@(_dashboard is null || _isLoading)">
				<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><path d="M8 13h2"></path><path d="M8 17h2"></path><path d="M14 13h2"></path><path d="M14 17h2"></path></svg>
				Excel
			</button>
			<button class="sr-btn sr-btn-outline" @onclick="ExportPdf" disabled="@(_dashboard is null || _isLoading)">
				<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><path d="M9 15v-4"></path><path d="M12 15v-4c1 0 2 1 2 2s-1 2-2 2"></path><path d="M16 11v4"></path><path d="M16 13h2"></path></svg>
				PDF
			</button>
			<button class="sr-btn sr-btn-solid" @onclick="SendMail" disabled="@(_dashboard is null || _isLoading)">
				<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
				Send Mail
			</button>
		</div>
	</div>

	<!-- Filters Section -->
	<div class="sr-filter-card">
		<div class="sr-filter-header">
			<div class="sr-filter-title">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="6" x2="20" y2="6"></line><line x1="6" y1="12" x2="18" y2="12"></line><line x1="8" y1="18" x2="16" y2="18"></line></svg>
				Filters
			</div>
			<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
		</div>

		<div class="sr-filter-body">
			<div class="sr-filter-grid">
				<div class="sr-form-group">
					<label class="sr-form-label">State</label>
					<select id="state-select" class="sr-form-select" multiple="multiple">
						@foreach (var s in _states)
						{
							<option value="@s.Id" selected="@(_selectedStates.Contains(s.Id))">@s.Name</option>
						}
					</select>
				</div>
				<div class="sr-form-group">
					<label class="sr-form-label">Region</label>
					<select id="region-select" class="sr-form-select" multiple="multiple">
						@foreach (var r in _regions)
						{
							<option value="@r.Id" selected="@(_selectedRegions.Contains(r.Id))">@r.Name</option>
						}
					</select>
				</div>
				<div class="sr-form-group">
					<label class="sr-form-label">Head Quarters</label>
					<select id="hq-select" class="sr-form-select" multiple="multiple">
						@foreach (var h in _hq)
						{
							<option value="@h.Id" selected="@(_selectedHqs.Contains(h.Id))">@h.Name</option>
						}
					</select>
				</div>
				<div class="sr-form-group">
					<label class="sr-form-label">District</label>
					<select id="district-select" class="sr-form-select" multiple="multiple">
						@foreach (var d in _districts)
						{
							<option value="@d.Id" selected="@(_selectedDistricts.Contains(d.Id))">@d.Name</option>
						}
					</select>
				</div>
				<div class="sr-form-group">
					<label class="sr-form-label">Sub District</label>
					<select id="subdistrict-select" class="sr-form-select" multiple="multiple">
						@foreach (var sd in _subDistricts)
						{
							<option value="@sd.Id" selected="@(_selectedSubDistricts.Contains(sd.Id))">@sd.Name</option>
						}
					</select>
				</div>
				<div class="sr-form-group">
					<label class="sr-form-label">Lying With</label>
					<select id="lyingwith-select" class="sr-form-select" multiple="multiple">
						@foreach (var lw in _lyingWith)
						{
							<option value="@lw.Id" selected="@(_selectedLyingWiths.Contains(lw.Id))">@lw.Name</option>
						}
					</select>
				</div>
				<div class="sr-form-group">
					<label class="sr-form-label">Product</label>
					<select id="product-select" class="sr-form-select" multiple="multiple">
						@foreach (var p in _products)
						{
							<option value="@p.Value" selected="@(_selectedProducts.Contains(p.Value))">@p.Name</option>
						}
					</select>
				</div>
				<div class="sr-form-group">
					<label class="sr-form-label">Ageing Range (Days)</label>
					<select id="ageing-select" class="sr-form-select" multiple="multiple">
						<option value="0-30" selected="@(_selectedAgeings.Contains("0-30"))">Fresh (0-30)</option>
						<option value="31-90" selected="@(_selectedAgeings.Contains("31-90"))">Medium (30-90)</option>
						<option value="91-180" selected="@(_selectedAgeings.Contains("91-180"))">Slow Moving (90-180)</option>
						<option value="181-364" selected="@(_selectedAgeings.Contains("181-364"))">Long Aged (180-365)</option>
						<option value="365+" selected="@(_selectedAgeings.Contains("365+"))">Critical (365+)</option>
					</select>
				</div>
			</div>

			<div class="sr-filter-actions">
				<button class="sr-btn sr-btn-outline" @onclick="ClearAll" disabled="@(!_select2Initialized || _isLoading)">
					<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
					Clear All
				</button>
				<button class="sr-btn sr-btn-solid" @onclick="ApplyFilters" disabled="@(!_select2Initialized || _isLoading)">
					<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="6" x2="20" y2="6"></line><line x1="6" y1="12" x2="18" y2="12"></line><line x1="8" y1="18" x2="16" y2="18"></line></svg>
					Search
				</button>
			</div>
		</div>
	</div>

	@if (_dashboard is null && _isLoading)
	{
		<!-- Initial dashboard skeleton: keeps the complete lower-page layout visible
             while the API request is running, so there is no blank-area jump. -->
		<section class="sr-dashboard-skeleton" aria-busy="true" aria-label="Loading stock dashboard">
			<div class="sr-loading-status" role="status">
				<span class="sr-inline-spinner" aria-hidden="true"></span>
				<span>Loading dashboard data…</span>
			</div>

			<div class="sr-stats-grid">
				@for (var cardIndex = 0; cardIndex < 4; cardIndex++)
				{
					<div class="sr-stat-card sr-skeleton-stat-card">
						<div class="sr-skeleton-stat-content">
							<span class="sr-skeleton-block sr-skeleton-title"></span>
							<span class="sr-skeleton-block sr-skeleton-value"></span>
							<span class="sr-skeleton-block sr-skeleton-trend"></span>
						</div>
						<span class="sr-skeleton-block sr-skeleton-icon"></span>
					</div>
				}
			</div>

			<div class="sr-charts-grid">
				<div class="sr-chart-card sr-skeleton-chart-card">
					<span class="sr-skeleton-block sr-skeleton-heading"></span>
					<div class="sr-skeleton-bar-chart" aria-hidden="true">
						@for (var barIndex = 0; barIndex < 10; barIndex++)
						{
							<span class="sr-skeleton-block"></span>
						}
					</div>
					<div class="sr-skeleton-chart-legend">
						<span class="sr-skeleton-block"></span>
						<span class="sr-skeleton-block"></span>
					</div>
				</div>

				<div class="sr-chart-card sr-skeleton-chart-card">
					<span class="sr-skeleton-block sr-skeleton-heading"></span>
					<div class="sr-skeleton-donut-layout">
						<span class="sr-skeleton-donut" aria-hidden="true"></span>
						<div class="sr-skeleton-donut-legend">
							@for (var legendIndex = 0; legendIndex < 5; legendIndex++)
							{
								<span class="sr-skeleton-block"></span>
							}
						</div>
					</div>
				</div>
			</div>

			<div class="sr-table-card sr-skeleton-table-card">
				<div class="sr-table-top">
					<span class="sr-skeleton-block sr-skeleton-table-title"></span>
					<span class="sr-skeleton-block sr-skeleton-search"></span>
				</div>
				<div class="sr-skeleton-table-head">
					@for (var columnIndex = 0; columnIndex < 9; columnIndex++)
					{
						<span class="sr-skeleton-block"></span>
					}
				</div>
				<div class="sr-skeleton-table-body">
					@for (var rowIndex = 0; rowIndex < 5; rowIndex++)
					{
						<div class="sr-skeleton-table-row">
							@for (var cellIndex = 0; cellIndex < 9; cellIndex++)
							{
								<span class="sr-skeleton-block"></span>
							}
						</div>
					}
				</div>
				<div class="sr-skeleton-pagination">
					<span class="sr-skeleton-block"></span>
					<span class="sr-skeleton-block"></span>
				</div>
			</div>
		</section>
	}
	else if (_dashboard is null)
	{
		<div class="sr-empty-state">
			@(_loadError is null ? "No Data Available" : $"Could not load report: {_loadError}")
		</div>
	}
	else
	{
		<!-- Keep existing data visible during refresh/filter/paging requests. -->
		<div class="sr-dashboard-content @(_isLoading ? "is-refreshing" : string.Empty)">
			@if (_isLoading)
			{
				<div class="sr-refresh-indicator" role="status">
					<span class="sr-inline-spinner" aria-hidden="true"></span>
					<span>Updating…</span>
				</div>
			}

			@if (!string.IsNullOrWhiteSpace(_loadError))
			{
				<div class="sr-dashboard-warning" role="alert">@_loadError</div>
			}

			<!-- KPIs Section -->
			<div class="sr-stats-grid">

				<!-- 1. Total Stock: wholesaler stock + retailer closing balance -->
				<div class="sr-stat-card sr-card-green">
					<div class="sr-stat-content">
						<span class="sr-stat-title">Total Stock (Current Stock)</span>
						<span class="sr-stat-value">@Fmt(_dashboard.Summary.TotalStock) <span style="font-size: 16px;">MT</span></span>
						<div class="sr-stat-trend @TrendClass((double)_dashboard.Summary.TotalStockChangePct)">
							<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg>
							<span>@Sign((double)_dashboard.Summary.TotalStockChangePct)@_dashboard.Summary.TotalStockChangePct.ToString("0.#")% from last month</span>
						</div>
					</div>
					<div class="sr-stat-icon-box sr-icon-green"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path><path d="m3.3 7 8.7 5 8.7-5"></path><path d="M12 22V12"></path></svg></div>
				</div>

				<!-- 2. Dealers Count: today, with yesterday vs today at the bottom -->
				<div class="sr-stat-card sr-card-blue">
					<div class="sr-stat-content">
						<span class="sr-stat-title">Dealers Count</span>
						<span class="sr-stat-value">@_dashboard.Summary.DealerCount</span>
						@{
							var dealerDiff = _dashboard.Summary.TodayDealerCount - _dashboard.Summary.YesterdayDealerCount;
						}
						<div class="sr-stat-trend @TrendClass(dealerDiff)">
							<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
								<polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline>
								<polyline points="16 7 22 7 22 13"></polyline>
							</svg>
							<span>@Sign(dealerDiff)@dealerDiff new dealers from yesterday</span>
						</div>
					</div>
					<div class="sr-stat-icon-box sr-icon-blue"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg></div>
				</div>

				<!-- 3. Average Ageing -->
				<div class="sr-stat-card sr-card-orange">
					<div class="sr-stat-content">
						<span class="sr-stat-title">Average Ageing</span>
						<span class="sr-stat-value">@_dashboard.Summary.AverageAgeing.ToString("0") <span style="font-size: 16px;">days</span></span>
						<div class="sr-stat-trend @TrendClass(-_dashboard.Summary.AverageAgeingChange)">
							<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 17 13.5 8.5 8.5 13.5 2 7"></polyline><polyline points="16 17 22 17 22 11"></polyline></svg>
							<span>@Sign(_dashboard.Summary.AverageAgeingChange)@_dashboard.Summary.AverageAgeingChange.ToString("0") days from last month</span>
						</div>
					</div>
					<div class="sr-stat-icon-box sr-icon-orange"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg></div>
				</div>

				<!-- 4. High Ageing Stock: > 6 months -->
				<div class="sr-stat-card sr-card-red">
					<div class="sr-stat-content">
						<span class="sr-stat-title">High Ageing Stock</span>
						<span class="sr-stat-value">@_dashboard.Summary.HighAgeingCount</span>
						<div class="sr-stat-trend @TrendClass(_dashboard.Summary.HighAgeingChange)">
							<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg>
							<span>@Sign(_dashboard.Summary.HighAgeingChange)@_dashboard.Summary.HighAgeingChange from last week</span>
						</div>
					</div>
					<div class="sr-stat-icon-box sr-icon-red"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg></div>
				</div>
			</div>

			<!-- CHARTS SECTION -->
			<div class="sr-charts-grid">

				<!-- Bar Chart: state-wise current year vs previous year -->
				<div class="sr-chart-card">
					<div class="sr-chart-header">
						<h3>State-wise Stock Availability</h3>
					</div>

					<div class="chart-scroll-wrapper">
						<div class="pure-bar-chart">
							<div class="chart-y-axis">
								@foreach (var lbl in AxisLabels())
								{
									<span>@lbl</span>
								}
							</div>

							<div class="chart-grid">
								<div class="chart-grid-line"></div>
								<div class="chart-grid-line"></div>
								<div class="chart-grid-line"></div>
								<div class="chart-grid-line"></div>
								<div class="chart-grid-line"></div>
							</div>

							<div class="chart-bars-container">
								@foreach (var st in _dashboard.StateWise)
								{
									<div class="chart-bar-group">
										<div class="chart-bar green" style="height: @(BarHeight(st.CurrentYear).ToString("0.##", Inv))%;">
											<span class="bar-val">@Fmt(st.CurrentYear)</span>
										</div>
										<div class="chart-bar purple" style="height: @(BarHeight(st.PreviousYear).ToString("0.##", Inv))%;">
											<span class="bar-val">@Fmt(st.PreviousYear)</span>
										</div>
										<div class="chart-x-label">@st.StateName</div>

										<div class="chart-tooltip">
											<div class="tt-header">@st.StateName</div>
											<div class="tt-row">
												<span class="tt-label" style="color: #10b981;">Current Year:</span>
												<span class="tt-val">@Fmt(st.CurrentYear)</span><span class="tt-unit">MT</span>
											</div>
											<div class="tt-row">
												<span class="tt-label" style="color: #8b5cf6;">Previous Year:</span>
												<span class="tt-val">@Fmt(st.PreviousYear)</span><span class="tt-unit">MT</span>
											</div>
										</div>
									</div>
								}
							</div>
						</div>
					</div>

					<div style="display: flex; justify-content: center; flex-wrap: wrap; gap: 24px; margin-top: 24px; font-size: 13px; font-weight: 500;">
						<div style="display: flex; align-items: center; gap: 8px; color: #10b981;">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="21" x2="4" y2="14"></line><line x1="4" y1="10" x2="4" y2="3"></line><line x1="12" y1="21" x2="12" y2="12"></line><line x1="12" y1="8" x2="12" y2="3"></line><line x1="20" y1="21" x2="20" y2="16"></line><line x1="20" y1="12" x2="20" y2="3"></line><line x1="1" y1="14" x2="7" y2="14"></line><line x1="9" y1="8" x2="15" y2="8"></line><line x1="17" y1="16" x2="23" y2="16"></line></svg> Current Year (@DateTime.Today.Year)
						</div>
						<div style="display: flex; align-items: center; gap: 8px; color: #8b5cf6;">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="21" x2="4" y2="14"></line><line x1="4" y1="10" x2="4" y2="3"></line><line x1="12" y1="21" x2="12" y2="12"></line><line x1="12" y1="8" x2="12" y2="3"></line><line x1="20" y1="21" x2="20" y2="16"></line><line x1="20" y1="12" x2="20" y2="3"></line><line x1="1" y1="14" x2="7" y2="14"></line><line x1="9" y1="8" x2="15" y2="8"></line><line x1="17" y1="16" x2="23" y2="16"></line></svg> Previous Year (@(DateTime.Today.Year - 1))
						</div>
					</div>
				</div>

				<!-- Donut: product-wise distribution -->
				<div class="sr-chart-card">
					<h3 style="margin: 0 0 20px 0;">Product-wise Stock Distribution (MT)</h3>
					<div class="sr-donut-wrapper">

						<div style="position: relative; width: 200px; height: 200px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">

							<svg width="100%" height="100%" viewBox="0 0 42 42" style="position: relative; z-index: 5; transform: rotate(-90deg); overflow: visible;">
								<circle cx="21" cy="21" r="15.9155" fill="transparent" stroke="#f8fafc" stroke-width="7"></circle>
								@{
									double _offset = 0;
								}
								@foreach (var p in _dashboard.ProductWise)
								{
									var dash = p.Percentage;
									var thisOffset = -_offset;
									_offset += dash;
    
									<!-- We open the circle tag and add the <title> inside it -->
									<circle cx="21" cy="21" r="15.9155" fill="transparent"
											stroke="@p.Color" stroke-width="7"
											stroke-dasharray="@dash.ToString("0.##", Inv) @((100 - dash).ToString("0.##", Inv))"
											stroke-dashoffset="@thisOffset.ToString("0.##", Inv)">
        
										<!-- The line break is achieved using the HTML entity &#10; -->
										<title>@p.ProductName&#10;Stock: @Fmt(p.Quantity) MT (@p.Percentage.ToString("0.00")%)</title>
        
									</circle>
								}
							</svg>

							<div style="position: absolute; text-align: center; z-index: 10;">
								<div style="font-size: 22px; font-weight: 700; color: #0f172a;">@Fmt(_dashboard.ProductWise.Sum(p => p.Quantity))</div>
								<div style="font-size: 13px; color: #64748b; font-weight: 500; margin-top: 2px;">Total Stock (MT)</div>
							</div>
						</div>

						<div class="sr-donut-legend" style="display: flex; flex-direction: column; gap: 16px;">
							@foreach (var p in _dashboard.ProductWise.OrderByDescending(x => x.Quantity).Take(5))
							{
								<div>
									<div style="display: flex; align-items: center; font-size: 13px; color: #64748b; font-weight: 500;"><div class="dot" style="background-color: @p.Color; margin-right: 8px; width: 10px; height: 10px; border-radius: 50%;"></div>@p.ProductName</div>
									<div style="font-weight: 700; margin-left: 18px; font-size: 14px; color: #0f172a; margin-top: 4px;">@Fmt(p.Quantity) MT <span style="font-weight: 400; color: #64748b; font-size: 12px;">(@p.Percentage.ToString("0.00")%)</span></div>
								</div>
							}
						</div>
					</div>
				</div>

			</div>

			<!-- Data Table Section -->
			<div class="sr-table-card">
				<div class="sr-table-top">
					<h3>Stock Report List</h3>
					<input type="text" class="sr-search-input" placeholder="Search dealer / state / product…"
						   @bind="_filter.Search" @bind:event="oninput" @onkeyup="OnSearchKeyUp" />
				</div>

				<div class="sr-table-responsive">
					<table class="sr-table">
						<thead>
							<tr>
								<th style="width: 60px;">S.No</th>
								<th class="sr-sortable" @onclick='() => Sort("state")'>State</th>
								<th class="sr-sortable" @onclick='() => Sort("dealer")'>Dealer Name</th>
								<th class="sr-sortable" @onclick='() => Sort("product")'>Product</th>
								<th class="sr-sortable" @onclick='() => Sort("quantity")'>Quantity (MT)</th>
								<th>Lying With</th>
								<th class="sr-sortable" @onclick='() => Sort("ageing")'>Ageing in Days</th>
								<th>Status</th>
								<th>Action</th>
							</tr>
						</thead>
						<tbody>
							@if (_dashboard.Grid.Items.Count == 0)
							{
								<tr><td colspan="9" style="text-align:center; padding:24px; color:#64748b;">No Data Available</td></tr>
							}
							else
							{
								var startIndex = (_filter.Page - 1) * _filter.PageSize;
								var rowNumber = 0;
								@foreach (var row in _dashboard.Grid.Items)
								{
									rowNumber++;
									<tr>
										<td>@(startIndex + rowNumber)</td>
										<td>@row.StateName</td>
										<td>@row.DealerName</td>
										<td>@row.ProductName</td>
										<td>@row.Quantity</td>
										<td>@row.LyingWith</td>
										<td class="@AgeingClass(row.AgeingDays)">@row.AgeingDays</td>
										<td><div class="sr-status @StatusClass(row.Status)"><div class="dot"></div>@StatusName(row.Status)</div></td>
										<td style="white-space:nowrap;">
											<button class="sr-action-btn" title="View" @onclick="() => OpenSalesDetails(row)">
												<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path><circle cx="12" cy="12" r="3"></circle></svg>
											</button>
											@* <button class="sr-action-btn" title="Share on WhatsApp" @onclick="() => ShareWhatsApp(row)">
												<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
											</button> *@
										</td>
									</tr>
								}
							}
						</tbody>
					</table>
				</div>

				<div class="sr-pagination">
					<div style="display: flex; align-items: center; gap: 12px; font-size: 14px; color: #475569;">
						<span>Items Per Page</span>
						<select class="sr-form-select" style="padding: 6px 32px 6px 12px; width: auto;"
								@onchange="OnPageSizeChanged">
							<option value="16" selected="@(_filter.PageSize == 16)">16</option>
							<option value="25" selected="@(_filter.PageSize == 25)">25</option>
							<option value="50" selected="@(_filter.PageSize == 50)">50</option>
							<option value="100" selected="@(_filter.PageSize == 100)">100</option>
						</select>
					</div>
					<div class="sr-page-controls">
						<button type="button" class="sr-page-btn" disabled="@(_filter.Page <= 1)" @onclick="() => GoToPage(_filter.Page - 1)">
							<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
						</button>
    
						@foreach (var pg in PageNumbers())
						{
							if (pg == -1)
							{
								<button type="button" class="sr-page-btn dots" disabled>..</button>
							}
							else
							{
								<button type="button" class="sr-page-btn @(pg == _filter.Page ? "active" : "")" @onclick="() => GoToPage(pg)">@pg</button>
							}
						}
    
						<button type="button" class="sr-page-btn" disabled="@(_filter.Page >= TotalPages)" @onclick="() => GoToPage(_filter.Page + 1)">
							<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
						</button>
					</div>
				</div>
			</div>
		</div>

		<!-- Closes sr-dashboard-content -->
	}
</div>

<StockDetailsDrawer @bind-IsOpen="isSalesDetailsOpen" Row="_selectedRow" />

@code {
	// ---------- Culture / formatting helpers ----------
	private static readonly CultureInfo InIN = new("en-IN");   // Indian grouping: 1,17,210
	private static readonly CultureInfo Inv = CultureInfo.InvariantCulture;
	private string Fmt(decimal v) => v.ToString("#,##0", InIN);

	private string TrendClass(double change) => change >= 0 ? "sr-trend-positive" : "sr-trend-negative";
	private string Sign(double change) => change > 0 ? "+" : "";

	// ---------- Dashboard state ----------
	// NOTE: DTO types (StockDashboardDto, StockReportFilter, StockRowDto, etc.)
	// now come from SPIC.Core.DTOs via the @using at the top. The old nested
	// copies were removed so this view and SalesDetailsDrawer share one type.
	private StockDashboardDto? _dashboard;
	private readonly StockReportFilter _filter = new();
	private bool _isLoading = true;
	private string? _loadError;
	private CancellationTokenSource? _loadCts;
	private System.Timers.Timer? _searchDebounce;

	private bool isSalesDetailsOpen = false;
	private StockRowDto? _selectedRow;

	private int TotalPages => _dashboard is null || _dashboard.Grid.PageSize == 0
		? 1
		: (int)Math.Ceiling((double)_dashboard.Grid.TotalCount / _dashboard.Grid.PageSize);

	// ---------- Filter master data ----------
	private List<LocationDto> _allStates = new();
	private List<LocationDto> _allRegions = new();
	private List<LocationDto> _allHqs = new();
	private List<LocationDto> _allDistricts = new();
	private List<LocationDto> _allSubDistricts = new();

	private List<LocationDto> _states = new();
	private List<LocationDto> _regions = new();
	private List<LocationDto> _hq = new();
	private List<LocationDto> _districts = new();
	private List<LocationDto> _subDistricts = new();

	private List<ProductFilterOptionDto> _products = new();
	private List<LocationDto> _lyingWith = new();

	private List<int> _selectedStates = new();
	private List<int> _selectedRegions = new();
	private List<int> _selectedHqs = new();
	private List<int> _selectedDistricts = new();
	private List<int> _selectedSubDistricts = new();
	private List<string> _selectedProducts = new();
	private List<int> _selectedLyingWiths = new();
	private List<string> _selectedAgeings = new();

	private DotNetObjectReference<StockReport>? _objRef;

	// LocationDto is local to this view (not part of the shared DTOs).
	public class LocationDto
	{
		public int Id { get; set; }
		public string Name { get; set; } = "";
		public int? StateId { get; set; }
		public int? RegionId { get; set; }
		public int? DistrictId { get; set; }
	}

	// ---------- Lifecycle ----------
	private bool _masterDataLoaded;
	private bool _select2Initialized;

	protected override async Task OnInitializedAsync()
	{
		// Start the dashboard request immediately instead of waiting for Select2.
		// Blazor can render the filter placeholders and dashboard skeleton while
		// both the master-data and dashboard requests run in parallel.
		_isLoading = true;
		_loadError = null;

		var dashboardTask = LoadDashboard(renderLoadingState: false);

		try
		{
			await LoadMasterData();
		}
		catch (Exception ex)
		{
			Console.WriteLine($"[StockReport] master: {ex}");
		}
		finally
		{
			// Render the loaded <option> elements. OnAfterRenderAsync will attach
			// Select2 only after those options are physically available in the DOM.
			_masterDataLoaded = true;
			await InvokeAsync(StateHasChanged);
		}

		await dashboardTask;
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (!_masterDataLoaded || _select2Initialized)
			return;

		_select2Initialized = true;

		try
		{
			_objRef ??= DotNetObjectReference.Create(this);
			await InitSelect2();
		}
		catch (Exception ex)
		{
			// Allow a later render to retry if the Select2 script was not ready yet.
			_select2Initialized = false;
			Console.WriteLine($"[StockReport] select2: {ex}");
		}
	}

	private async Task LoadMasterData()
	{
		var statesTask = FetchData("api/State/all");
		var regionsTask = FetchData("api/Region/all");
		var hqTask = FetchData("api/Headquarter/all");
		var districtsTask = FetchData("api/District/all");
		var subDistrictsTask = FetchData("api/SubDistrict/all");
		var productsTask = FetchProductOptions();
		var lyingWithTask = FetchData("api/LyingWithMaster/all");

		await Task.WhenAll(
			statesTask,
			regionsTask,
			hqTask,
			districtsTask,
			subDistrictsTask,
			productsTask,
			lyingWithTask);

		_allStates = statesTask.Result;
		_allRegions = regionsTask.Result;
		_allHqs = hqTask.Result;
		_allDistricts = districtsTask.Result;
		_allSubDistricts = subDistrictsTask.Result;

		foreach (var hq in _allHqs)
		{
			var parentRegion = _allRegions.FirstOrDefault(r => r.Id == hq.RegionId);
			if (parentRegion is not null)
				hq.StateId = parentRegion.StateId;
		}

		foreach (var subDistrict in _allSubDistricts)
		{
			var parentDistrict = _allDistricts.FirstOrDefault(d => d.Id == subDistrict.DistrictId);
			if (parentDistrict is not null)
				subDistrict.StateId = parentDistrict.StateId;
		}

		// Apply role-based visibility similar to DealerRegistration: admins/director/avp see all,
		// other roles should be restricted to their assigned State/Region/HQ.
		ApplyRoleRestrictions();

		// If ApplyRoleRestrictions didn't set lists (e.g. for admins), fall back to full lists.
		_states ??= _allStates;
		_regions ??= _allRegions;
		_hq ??= _allHqs;
		_districts = _allDistricts;
		_subDistricts = _allSubDistricts;
		_products = productsTask.Result;
		_lyingWith = lyingWithTask.Result;
	}

	private void ApplyRoleRestrictions()
	{
		try
		{
			if (LoginState is null) return;
			// Admins and Director/AVP see everything
			if (LoginState.IsAdmin || LoginState.IsDirectorOrAVP)
			{
				_states = _allStates;
				_regions = _allRegions;
				_hq = _allHqs;
				return;
			}

			// HQ-level users (MO/MDO/JMDO) -> restrict to their HQ/region/state
			if (LoginState.IsHQRole && LoginState.HQId > 0)
			{
				_hq = _allHqs.Where(h => h.Id == LoginState.HQId).ToList();
				var regionId = _allHqs.FirstOrDefault(h => h.Id == LoginState.HQId)?.RegionId ?? LoginState.RegionId;
				if (regionId > 0) _regions = _allRegions.Where(r => r.Id == regionId).ToList();
				var stateId = _allRegions.FirstOrDefault(r => r.Id == regionId)?.StateId ?? LoginState.StateId;
				if (stateId > 0) _states = _allStates.Where(s => s.Id == stateId).ToList();
				return;
			}

			// Region-level users (RM/RMD)
			if (LoginState.IsRegionRole && LoginState.RegionId > 0)
			{
				_regions = _allRegions.Where(r => r.Id == LoginState.RegionId).ToList();
				_states = _allStates.Where(s => s.Id == (_allRegions.FirstOrDefault(r => r.Id == LoginState.RegionId)?.StateId ?? LoginState.StateId)).ToList();
				_hq = _allHqs.Where(h => h.RegionId == LoginState.RegionId).ToList();
				return;
			}

			// State-level users (SMD/SMM)
			if (LoginState.IsStateRole && LoginState.StateId > 0)
			{
				_states = _allStates.Where(s => s.Id == LoginState.StateId).ToList();
				_regions = _allRegions.Where(r => r.StateId == LoginState.StateId).ToList();
				_hq = _allHqs.Where(h => h.StateId == LoginState.StateId).ToList();
				return;
			}
		}
		catch { /* swallow; keep full lists if anything goes wrong */ }
	}

	// ---------- Dashboard load ----------
	private async Task LoadDashboard(bool renderLoadingState = true)
	{
		// Cancel the previous request. Its own finally block disposes its CTS.
		_loadCts?.Cancel();

		var cts = new CancellationTokenSource(TimeSpan.FromSeconds(30));
		_loadCts = cts;
		var token = cts.Token;

		_isLoading = true;
		_loadError = null;

		if (renderLoadingState)
			await InvokeAsync(StateHasChanged);

		try
		{
			var response = await Http.PostAsJsonAsync("api/StockReport/dashboard", _filter, token);

			if (response.IsSuccessStatusCode)
			{
				var dashboard = await response.Content.ReadFromJsonAsync<StockDashboardDto>(cancellationToken: token);

				if (dashboard is null)
				{
					if (_dashboard is null)
						_loadError = "The server returned an empty dashboard response.";
				}
				else
				{
					_dashboard = dashboard;
				}
			}
			else
			{
				_loadError = $"Server returned {(int)response.StatusCode} {response.ReasonPhrase}.";
			}
		}
		catch (OperationCanceledException)
		{
			// A newer request has replaced this request, so it no longer owns the UI.
			if (!ReferenceEquals(_loadCts, cts))
				return;

			_loadError = "Request timed out - the server took too long to respond.";
		}
		catch (Exception ex)
		{
			_loadError = ex.Message;
		}
		finally
		{
			var isCurrentRequest = ReferenceEquals(_loadCts, cts);

			if (isCurrentRequest)
			{
				_isLoading = false;
				_loadCts = null;
				await InvokeAsync(StateHasChanged);
			}

			cts.Dispose();
		}
	}

	private void SyncSelectionsToFilter()
	{
		_filter.StateIds = _selectedStates.ToList();
		_filter.RegionIds = _selectedRegions.ToList();
		_filter.HeadQuarterIds = _selectedHqs.ToList();
		_filter.DistrictIds = _selectedDistricts.ToList();
		_filter.SubDistrictIds = _selectedSubDistricts.ToList();
		_filter.LyingWithIds = _selectedLyingWiths.ToList();
		_filter.ProductIds = ParseSelectedProductIds(_selectedProducts, "P:");
		_filter.IfmsProductIds = ParseSelectedProductIds(_selectedProducts, "I:");
		_filter.AgeingRanges = _selectedAgeings.ToList();
	}

	private async Task ApplyFilters()
	{
		SyncSelectionsToFilter();
		_filter.Page = 1;
		await LoadDashboard();
	}

	private async Task RefreshData() => await LoadDashboard();

	private async Task ClearAll()
	{
		_selectedStates.Clear(); _selectedRegions.Clear(); _selectedHqs.Clear();
		_selectedDistricts.Clear(); _selectedSubDistricts.Clear();
		_selectedProducts.Clear(); _selectedLyingWiths.Clear(); _selectedAgeings.Clear();

		_states = _allStates; _regions = _allRegions; _hq = _allHqs;
		_districts = _allDistricts; _subDistricts = _allSubDistricts;

		SyncSelectionsToFilter();
		_filter.Search = null;
		_filter.Page = 1;

		StateHasChanged();
		await RefreshSelect2Hierarchy();
		await LoadDashboard();
	}

	// ---------- Grid: paging / sorting / searching ----------
	private async Task GoToPage(int page)
	{
		// Prevent out-of-bounds AND prevent fetching if we are already on this page
		if (page < 1 || page > TotalPages || page == _filter.Page)
			return;
        
		_filter.Page = page;
		await LoadDashboard();
	}

	private async Task OnPageSizeChanged(ChangeEventArgs e)
	{
		if (int.TryParse(e.Value?.ToString(), out var size))
		{
			_filter.PageSize = size;
			_filter.Page = 1;
			await LoadDashboard();
		}
	}

	private async Task Sort(string column)
	{
		if (_filter.SortColumn == column)
			_filter.SortDir = _filter.SortDir == "asc" ? "desc" : "asc";
		else
		{
			_filter.SortColumn = column;
			_filter.SortDir = "asc";
		}
		await LoadDashboard();
	}

	private void OnSearchKeyUp()
	{
		// debounce search so we don't hit the API on every keystroke
		_searchDebounce?.Stop();
		_searchDebounce?.Dispose();
		_searchDebounce = new System.Timers.Timer(400) { AutoReset = false };
		_searchDebounce.Elapsed += async (_, _) =>
{
	_filter.Page = 1;
	await InvokeAsync(() => LoadDashboard());
};
		_searchDebounce.Start();
	}

	private IEnumerable<int> PageNumbers()
	{
		int total = TotalPages, current = _filter.Page;
		if (total <= 7)
		{
			for (int i = 1; i <= total; i++) yield return i;
			yield break;
		}
		yield return 1;
		if (current > 4) yield return -1; // dots
		for (int i = Math.Max(2, current - 1); i <= Math.Min(total - 1, current + 1); i++)
			yield return i;
		if (current < total - 3) yield return -1; // dots
		yield return total;
	}

	// ---------- Chart helpers ----------
	private decimal AxisMax()
	{
		if (_dashboard is null || _dashboard.StateWise.Count == 0) return 40000m;
		var max = _dashboard.StateWise.Max(s => Math.Max(s.CurrentYear, s.PreviousYear));
		return Math.Max(10000m, Math.Ceiling(max / 10000m) * 10000m);
	}

	private double BarHeight(decimal value)
	{
		var max = AxisMax();
		return max == 0 ? 0 : (double)(value / max) * 100;
	}

	private IEnumerable<string> AxisLabels()
	{
		var max = AxisMax();
		for (int i = 4; i >= 0; i--)
		{
			var val = max * i / 4m;
			yield return val >= 1000 ? $"{(val / 1000m):0.#}k" : val.ToString("0", Inv);
		}
	}

	// ---------- Status / ageing pill colours ----------
	private static string StatusName(string? status)
	{
		var value = status?.Trim() ?? string.Empty;

		if (value.StartsWith("Fresh", StringComparison.OrdinalIgnoreCase))
			return "Fresh";
		if (value.StartsWith("Medium", StringComparison.OrdinalIgnoreCase))
			return "Medium";
		if (value.StartsWith("Slow Moving", StringComparison.OrdinalIgnoreCase))
			return "Slow Moving";
		if (value.StartsWith("Long Aged", StringComparison.OrdinalIgnoreCase))
			return "Long Aged";
		if (value.StartsWith("Critical", StringComparison.OrdinalIgnoreCase))
			return "Critical";

		return value;
	}

	private string StatusClass(string status)
	{
		var value = status?.Trim() ?? string.Empty;

		if (value.StartsWith("Fresh", StringComparison.OrdinalIgnoreCase))
			return "st-green";

		if (value.StartsWith("Medium", StringComparison.OrdinalIgnoreCase))
			return "st-teal";

		if (value.StartsWith("Slow Moving", StringComparison.OrdinalIgnoreCase))
			return "st-orange";

		if (value.StartsWith("Long Aged", StringComparison.OrdinalIgnoreCase))
			return "st-amber";

		if (value.StartsWith("Critical", StringComparison.OrdinalIgnoreCase))
			return "st-critical";

		return "st-neutral";
	}

	private string AgeingClass(int days) => days <= 30 ? "txt-green" : days <= 60 ? "txt-orange" : "txt-red";

	// ---------- Row actions ----------
	private void OpenSalesDetails(StockRowDto row)
	{
		_selectedRow = row;
		isSalesDetailsOpen = true;
	}

	// private async Task ShareWhatsApp(StockRowDto row)
	// {
	// 	var msg = Uri.EscapeDataString(
	// 		$"Stock Report\nDealer: {row.DealerName}\nState: {row.StateName}\n" +
	// 		$"Product: {row.ProductName}\nQuantity: {row.Quantity} MT\n" +
	// 		$"Ageing: {row.AgeingDays} days ({row.Status})");

	// 	// If a mobile number exists, target it directly; otherwise open a blank share.
	// 	var phone = new string((row.MobileNo ?? "").Where(char.IsDigit).ToArray());
	// 	var url = string.IsNullOrEmpty(phone)
	// 		? $"https://wa.me/?text={msg}"
	// 		: $"https://wa.me/91{phone}?text={msg}";

	// 	await JS.InvokeVoidAsync("open", url, "_blank");
	// }

	// ---------- Export / mail (call your export endpoints) ----------
	private async Task ExportExcel()
	{
		SyncSelectionsToFilter();
		await JS.InvokeVoidAsync("spicDownload.post", "api/StockReport/export/excel", _filter, "StockReport.xlsx");
	}

	private async Task ExportPdf()
	{
		SyncSelectionsToFilter();
		await JS.InvokeVoidAsync("spicDownload.post", "api/StockReport/export/pdf", _filter, "StockReport.pdf");
	}

	private async Task SendMail()
	{
		SyncSelectionsToFilter();
		await Http.PostAsJsonAsync("api/StockReport/send-mail", _filter);
	}

	// ==========================================================
	//  select2 cascade logic
	// ==========================================================
	private async Task InitSelect2()
	{
		if (_objRef is null)
			return;

		var configs = new[]
		{
			new { id = "state-select", method = nameof(OnStateChanged) },
			new { id = "region-select", method = nameof(OnRegionChanged) },
			new { id = "hq-select", method = nameof(OnHqChanged) },
			new { id = "district-select", method = nameof(OnDistrictChanged) },
			new { id = "subdistrict-select", method = nameof(OnSubDistrictChanged) },
			new { id = "lyingwith-select", method = nameof(OnLyingWithChanged) },
			new { id = "product-select", method = nameof(OnProductChanged) },
			new { id = "ageing-select", method = nameof(OnAgeingChanged) }
		};

		await JS.InvokeVoidAsync("spicSelect2.initMultiple", configs, _objRef);
	}

	private static List<int> ParseSelectedIds(IEnumerable<string>? values)
	{
		if (values is null)
			return new List<int>();

		return values
			.Where(value => int.TryParse(value, out _))
			.Select(int.Parse)
			.Distinct()
			.ToList();
	}

	private static List<int> ParseSelectedProductIds(
		IEnumerable<string>? values,
		string prefix)
	{
		if (values is null)
			return new List<int>();

		return values
			.Where(value =>
				!string.IsNullOrWhiteSpace(value) &&
				value.StartsWith(prefix, StringComparison.Ordinal))
			.Select(value => value[prefix.Length..])
			.Where(value => int.TryParse(value, out _))
			.Select(int.Parse)
			.Distinct()
			.ToList();
	}

	[JSInvokable]
	public async Task OnStateChanged(List<string>? values)
	{
		var newSelected = ParseSelectedIds(values);
		if (_selectedStates.SequenceEqual(newSelected)) return;
		_selectedStates = newSelected;
		await ProcessFilterChange("State");
	}

