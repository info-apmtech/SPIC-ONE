@page "/StockReport"
@implements IDisposable
@inject HttpClient Http
@inject IJSRuntime JS
@using System.Text.Json

<div class="spic-sr-container">
    
    <!-- Header Section -->
    <div class="sr-header-container">
        <div class="sr-header-text">
            <h1>Stock Report</h1>
            <p>View current stock availability across dealers</p>
        </div>
        <div class="sr-action-buttons">
            <button class="sr-btn sr-btn-outline">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2v6h-6"></path><path d="M3 12a9 9 0 1 0 2.13-5.88L2 9"></path></svg> 
                Refresh Data
            </button>
            <button class="sr-btn sr-btn-outline">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><path d="M8 13h2"></path><path d="M8 17h2"></path><path d="M14 13h2"></path><path d="M14 17h2"></path></svg> 
                Excel
            </button>
            <button class="sr-btn sr-btn-outline">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><path d="M9 15v-4"></path><path d="M12 15v-4c1 0 2 1 2 2s-1 2-2 2"></path><path d="M16 11v4"></path><path d="M16 13h2"></path></svg> 
                PDF
            </button>
            <button class="sr-btn sr-btn-solid">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg> 
                Send Mail
            </button>
        </div>
    </div>
    
    <!-- Filters Section -->
    <div class="sr-filter-card">
        <div class="sr-filter-header">
            <div class="sr-filter-title">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="6" x2="20" y2="6"></line><line x1="6" y1="12" x2="18" y2="12"></line><line x1="8" y1="18" x2="16" y2="18"></line></svg> 
                Filters
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </div>
        
        <div class="sr-filter-body">
            <div class="sr-filter-grid">
                <div class="sr-form-group">
                    <label class="sr-form-label">State</label>
                    <select id="state-select" class="sr-form-select" multiple="multiple">
                        @foreach (var s in _states) { <option value="@s.Id" selected="@(_selectedStates.Contains(s.Id))">@s.Name</option> }
                    </select>
                </div>
                <div class="sr-form-group">
                    <label class="sr-form-label">Region</label>
                    <select id="region-select" class="sr-form-select" multiple="multiple">
                        @foreach (var r in _regions) { <option value="@r.Id" selected="@(_selectedRegions.Contains(r.Id))">@r.Name</option> }
                    </select>
                </div>
                <div class="sr-form-group">
                    <label class="sr-form-label">Head Quarters</label>
                    <select id="hq-select" class="sr-form-select" multiple="multiple">
                        @foreach (var h in _hq) { <option value="@h.Id" selected="@(_selectedHqs.Contains(h.Id))">@h.Name</option> }
                    </select>
                </div>
                <div class="sr-form-group">
                    <label class="sr-form-label">District</label>
                    <select id="district-select" class="sr-form-select" multiple="multiple">
                        @foreach (var d in _districts) { <option value="@d.Id" selected="@(_selectedDistricts.Contains(d.Id))">@d.Name</option> }
                    </select>
                </div>
                <div class="sr-form-group">
                    <label class="sr-form-label">Sub District</label>
                    <select id="subdistrict-select" class="sr-form-select" multiple="multiple">
                        @foreach (var sd in _subDistricts) { <option value="@sd.Id" selected="@(_selectedSubDistricts.Contains(sd.Id))">@sd.Name</option> }
                    </select>
                </div>
                <div class="sr-form-group">
                    <label class="sr-form-label">Lying With</label>
                    <select id="lyingwith-select" class="sr-form-select" multiple="multiple">
                        @foreach (var lw in _lyingWith) { <option value="@lw.Id" selected="@(_selectedLyingWiths.Contains(lw.Id))">@lw.Name</option> }
                    </select>
                </div>
                <div class="sr-form-group">
                    <label class="sr-form-label">Product</label>
                    <select id="product-select" class="sr-form-select" multiple="multiple">
                        @foreach (var p in _products) { <option value="@p.Id" selected="@(_selectedProducts.Contains(p.Id))">@p.Name</option> }
                    </select>
                </div>
                <div class="sr-form-group">
                    <label class="sr-form-label">Ageing Range (Days)</label>
                    <select id="ageing-select" class="sr-form-select" multiple="multiple">
                        <option value="0-30" selected="@(_selectedAgeings.Contains("0-30"))">0–30 Days</option>
                        <option value="31-60" selected="@(_selectedAgeings.Contains("31-60"))">31–60 Days</option>
                        <option value="61-90" selected="@(_selectedAgeings.Contains("61-90"))">61–90 Days</option>
                        <option value="91-120" selected="@(_selectedAgeings.Contains("91-120"))">91–120 Days</option>
                        <option value="Above 120" selected="@(_selectedAgeings.Contains("Above 120"))">Above 120 Days</option>
                    </select>
                </div>
            </div>
            
            <div class="sr-filter-actions">
                <button class="sr-btn sr-btn-outline">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg> 
                    Clear All
                </button>
                <button class="sr-btn sr-btn-solid">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="6" x2="20" y2="6"></line><line x1="6" y1="12" x2="18" y2="12"></line><line x1="8" y1="18" x2="16" y2="18"></line></svg> 
                    Apply Filters
                </button>
            </div>
        </div>
    </div>
    
    <!-- KPIs Section -->
    <div class="sr-stats-grid">
        <div class="sr-stat-card sr-card-green">
            <div class="sr-stat-content">
                <span class="sr-stat-title">Total Stock (Current Stock)</span>
                <span class="sr-stat-value">1,17,210 <span style="font-size: 16px;">MT</span></span>
                <div class="sr-stat-trend sr-trend-positive">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg>
                    <span>+12% from last month</span>
                </div>
            </div>
            <div class="sr-stat-icon-box sr-icon-green"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path><path d="m3.3 7 8.7 5 8.7-5"></path><path d="M12 22V12"></path></svg></div>
        </div>

        <div class="sr-stat-card sr-card-blue">
            <div class="sr-stat-content">
                <span class="sr-stat-title">Dealers Count</span>
                <span class="sr-stat-value">12</span>
                <div class="sr-stat-trend sr-trend-positive">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg>
                    <span>+3 new dealers</span>
                </div>
            </div>
            <div class="sr-stat-icon-box sr-icon-blue"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg></div>
        </div>

        <div class="sr-stat-card sr-card-orange">
            <div class="sr-stat-content">
                <span class="sr-stat-title">Average Ageing</span>
                <span class="sr-stat-value">55 <span style="font-size: 16px;">days</span></span>
                <div class="sr-stat-trend sr-trend-positive">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 17 13.5 8.5 8.5 13.5 2 7"></polyline><polyline points="16 17 22 17 22 11"></polyline></svg>
                    <span>-5 days from last month</span>
                </div>
            </div>
            <div class="sr-stat-icon-box sr-icon-orange"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg></div>
        </div>

        <div class="sr-stat-card sr-card-red">
            <div class="sr-stat-content">
                <span class="sr-stat-title">High Ageing Stock</span>
                <span class="sr-stat-value">5</span>
                <div class="sr-stat-trend sr-trend-negative">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg>
                    <span>+2 from last week</span>
                </div>
            </div>
            <div class="sr-stat-icon-box sr-icon-red"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg></div>
        </div>
    </div>

    <!-- PURE CSS/HTML CHARTS SECTION -->
    <div class="sr-charts-grid">
        
        <!-- CSS Bar Chart Component -->
        <div class="sr-chart-card">
            <div class="sr-chart-header">
                <h3>State-wise Stock Availability</h3>
                <select class="sr-form-select" style="width: auto; padding: 6px 30px 6px 12px; margin: 0;"><option>Year</option></select>
            </div>
            
            <div class="chart-scroll-wrapper">
                <div class="pure-bar-chart">
                    <!-- Y Axis Labels -->
                    <div class="chart-y-axis">
                        <span>40k</span><span>30k</span><span>20k</span><span>10k</span><span>0</span>
                    </div>
                    
                    <!-- Grid Background -->
                    <div class="chart-grid">
                        <div class="chart-grid-line"></div>
                        <div class="chart-grid-line"></div>
                        <div class="chart-grid-line"></div>
                        <div class="chart-grid-line"></div>
                        <div class="chart-grid-line"></div>
                    </div>

                    <!-- Dynamic Bars -->
                    <div class="chart-bars-container">
                        
                        <!-- TN -->
                        <div class="chart-bar-group">
                            <div class="chart-bar green" style="height: 75.55%;"><span class="bar-val">30,220</span></div>
                            <div class="chart-bar purple" style="height: 71.12%;"><span class="bar-val">28,450</span></div>
                            <div class="chart-x-label">Tamil Nadu</div>
                        </div>

                        <!-- KA -->
                        <div class="chart-bar-group">
                            <div class="chart-bar green" style="height: 66.97%;"><span class="bar-val">26,789</span></div>
                            <div class="chart-bar purple" style="height: 59.47%;"><span class="bar-val">23,789</span></div>
                            <div class="chart-x-label">Karnataka</div>
                        </div>

                        <!-- KL -->
                        <div class="chart-bar-group">
                            <div class="chart-bar green" style="height: 56.97%;"></div>
                            <div class="chart-bar purple" style="height: 49.47%;"></div>
                            <div class="chart-x-label">Kerala</div>
                        </div>

                        <!-- AP -->
                        <div class="chart-bar-group">
                            <div class="chart-bar green" style="height: 61.97%;"></div>
                            <div class="chart-bar purple" style="height: 54.47%;"></div>
                            <div class="chart-x-label">Andhra Pradesh</div>
                        </div>

                        <!-- TS -->
                        <div class="chart-bar-group">
                            <div class="chart-bar green" style="height: 51.97%;"></div>
                            <div class="chart-bar purple" style="height: 49.47%;"></div>
                            <div class="chart-x-label">Telangana</div>
                        </div>

                        <!-- MH (With Custom Tooltip) -->
                        <div class="chart-bar-group">
                            <div class="chart-bar green" style="height: 66.97%;"><span class="bar-val">26,789</span></div>
                            <div class="chart-bar purple" style="height: 51.97%;"><span class="bar-val">20,789</span></div>
                            <div class="chart-x-label">Maharashtra</div>
                            
                            <!-- Pure CSS Tooltip -->
                            <div class="chart-tooltip">
                                <div class="tt-header">Maharashtra</div>
                                <div class="tt-row">
                                    <span class="tt-label" style="color: #10b981;">Current Year:</span>
                                    <span class="tt-val">26,789</span><span class="tt-unit">MT</span>
                                </div>
                                <div class="tt-row">
                                    <span class="tt-label" style="color: #8b5cf6;">Previous Year:</span>
                                    <span class="tt-val">20,789</span><span class="tt-unit">MT</span>
                                </div>
                            </div>
                        </div>

                        <!-- GJ -->
                        <div class="chart-bar-group">
                            <div class="chart-bar green" style="height: 26.97%;"></div>
                            <div class="chart-bar purple" style="height: 36.97%;"></div>
                            <div class="chart-x-label">Gujarat</div>
                        </div>

                        <!-- Others -->
                        <div class="chart-bar-group">
                            <div class="chart-bar green" style="height: 16.97%;"></div>
                            <div class="chart-bar purple" style="height: 24.47%;"></div>
                            <div class="chart-x-label">Others</div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Legend below bar chart -->
            <div style="display: flex; justify-content: center; flex-wrap: wrap; gap: 24px; margin-top: 24px; font-size: 13px; font-weight: 500;">
                <div style="display: flex; align-items: center; gap: 8px; color: #10b981;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="21" x2="4" y2="14"></line><line x1="4" y1="10" x2="4" y2="3"></line><line x1="12" y1="21" x2="12" y2="12"></line><line x1="12" y1="8" x2="12" y2="3"></line><line x1="20" y1="21" x2="20" y2="16"></line><line x1="20" y1="12" x2="20" y2="3"></line><line x1="1" y1="14" x2="7" y2="14"></line><line x1="9" y1="8" x2="15" y2="8"></line><line x1="17" y1="16" x2="23" y2="16"></line></svg> Current Year (2026)
                </div>
                <div style="display: flex; align-items: center; gap: 8px; color: #8b5cf6;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="21" x2="4" y2="14"></line><line x1="4" y1="10" x2="4" y2="3"></line><line x1="12" y1="21" x2="12" y2="12"></line><line x1="12" y1="8" x2="12" y2="3"></line><line x1="20" y1="21" x2="20" y2="16"></line><line x1="20" y1="12" x2="20" y2="3"></line><line x1="1" y1="14" x2="7" y2="14"></line><line x1="9" y1="8" x2="15" y2="8"></line><line x1="17" y1="16" x2="23" y2="16"></line></svg> Previous Year (2025)
                </div>
            </div>
        </div>

        <!-- Pure SVG Donut Chart Component -->
        <div class="sr-chart-card">
            <h3 style="margin: 0 0 20px 0;">Product-wise Stock Distribution (MT)</h3>
            <div class="sr-donut-wrapper">
                
                <!-- Native SVG Donut -->
                <div style="position: relative; width: 200px; height: 200px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                    
                    <svg width="100%" height="100%" viewBox="0 0 42 42" style="position: relative; z-index: 5; transform: rotate(-90deg); overflow: visible;">
                        <!-- Base Background Ring -->
                        <circle cx="21" cy="21" r="15.9155" fill="transparent" stroke="#f8fafc" stroke-width="7"></circle>
                        
                        <!-- Purple (10%) -->
                        <circle cx="21" cy="21" r="15.9155" fill="transparent" stroke="#6366f1" stroke-width="7" stroke-dasharray="10 90" stroke-dashoffset="0"></circle>
                        <!-- Red (15%) -->
                        <circle cx="21" cy="21" r="15.9155" fill="transparent" stroke="#ef4444" stroke-width="7" stroke-dasharray="15 85" stroke-dashoffset="-10"></circle>
                        <!-- Green (50%) -->
                        <circle cx="21" cy="21" r="15.9155" fill="transparent" stroke="#059669" stroke-width="7" stroke-dasharray="50 50" stroke-dashoffset="-25"></circle>
                        <!-- Orange (25%) -->
                        <circle cx="21" cy="21" r="15.9155" fill="transparent" stroke="#f59e0b" stroke-width="7" stroke-dasharray="25 75" stroke-dashoffset="-75"></circle>
                    </svg>
                    
                    <!-- Center Overlay Text -->
                    <div style="position: absolute; text-align: center; z-index: 10;">
                        <div style="font-size: 22px; font-weight: 700; color: #0f172a;">1,17,210</div>
                        <div style="font-size: 13px; color: #64748b; font-weight: 500; margin-top: 2px;">Total Stock (MT)</div>
                    </div>
                </div>
                
                <!-- Right Side Legend -->
                <div class="sr-donut-legend" style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <div style="display: flex; align-items: center; font-size: 13px; color: #64748b; font-weight: 500;"><div class="dot" style="background-color: #059669; margin-right: 8px; width: 10px; height: 10px;"></div>Neem Coated Urea (45 kg)</div>
                        <div style="font-weight: 700; margin-left: 18px; font-size: 14px; color: #0f172a; margin-top: 4px;">62,456 MT <span style="font-weight: 400; color: #64748b; font-size: 12px;">(50.18%)</span></div>
                    </div>
                    <div>
                        <div style="display: flex; align-items: center; font-size: 13px; color: #64748b; font-weight: 500;"><div class="dot" style="background-color: #f59e0b; margin-right: 8px; width: 10px; height: 10px;"></div>Bio DAP (45 kg)</div>
                        <div style="font-weight: 700; margin-left: 18px; font-size: 14px; color: #0f172a; margin-top: 4px;">62,456 MT <span style="font-weight: 400; color: #64748b; font-size: 12px;">(50.18%)</span></div>
                    </div>
                    <div>
                        <div style="display: flex; align-items: center; font-size: 13px; color: #64748b; font-weight: 500;"><div class="dot" style="background-color: #6366f1; margin-right: 8px; width: 10px; height: 10px;"></div>MOP (45 kg)</div>
                        <div style="font-weight: 700; margin-left: 18px; font-size: 14px; color: #0f172a; margin-top: 4px;">62,456 MT <span style="font-weight: 400; color: #64748b; font-size: 12px;">(50.18%)</span></div>
                    </div>
                    <div>
                        <div style="display: flex; align-items: center; font-size: 13px; color: #64748b; font-weight: 500;"><div class="dot" style="background-color: #ef4444; margin-right: 8px; width: 10px; height: 10px;"></div>Others</div>
                        <div style="font-weight: 700; margin-left: 18px; font-size: 14px; color: #0f172a; margin-top: 4px;">62,456 MT <span style="font-weight: 400; color: #64748b; font-size: 12px;">(50.18%)</span></div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Data Table Section -->
    <div class="sr-table-card">
        <div class="sr-table-top">
            <h3>Stock Report List</h3>
            <input type="text" class="sr-search-input" placeholder="Search zones...">
        </div>

        <div class="sr-table-responsive">
            <table class="sr-table">
                <thead>
                    <tr>
                        <th style="width: 50px;"><input type="checkbox" style="width: 16px; height: 16px; border-radius: 4px; border: 1px solid #cbd5e1;"></th>
                        <th>State</th>
                        <th>Dealer Name</th>
                        <th>Product</th>
                        <th>Quantity (MT)</th>
                        <th>Ageing in Days</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><input type="checkbox" style="width: 16px; height: 16px; border-radius: 4px; border: 1px solid #cbd5e1;"></td>
                        <td>Tamil Nadu</td>
                        <td>Monsoon Agro Centre</td>
                        <td>Neem Coated Urea (45 Kg)</td>
                        <td>15.3</td>
                        <td class="txt-red">66</td>
                        <td><div class="sr-status st-red"><div class="dot"></div>Dead Stock</div></td>
                        <td><button class="sr-action-btn" @onclick="OpenSalesDetails"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path><circle cx="12" cy="12" r="3"></circle></svg></button></td>
                    </tr>
                    <tr>
                        <td><input type="checkbox" style="width: 16px; height: 16px; border-radius: 4px; border: 1px solid #cbd5e1;"></td>
