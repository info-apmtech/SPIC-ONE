    // ---- DTOs (client-side mirrors) ----

    public class BillItemRow
    {
        public BillItemCategory Category { get; set; }
        public string Description { get; set; } = "";
        public decimal Quantity { get; set; } = 1;
        public decimal Rate { get; set; }
        public decimal CgstPercent { get; set; }
        public decimal SgstPercent { get; set; }
        public bool IsEditable { get; set; } = true;
        public bool CanRemove { get; set; }
        public bool IsSystemLine { get; set; }
        public bool IsGstEditable { get; set; }

        public decimal Amount => Math.Round(Quantity * Rate, 2, MidpointRounding.AwayFromZero);
        public decimal CgstAmount => Math.Round(Amount * (CgstPercent / 100m), 2, MidpointRounding.AwayFromZero);
        public decimal SgstAmount => Math.Round(Amount * (SgstPercent / 100m), 2, MidpointRounding.AwayFromZero);
        public decimal LineTotal => Amount + CgstAmount + SgstAmount;
    }

