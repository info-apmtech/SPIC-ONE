    private static string InvAmt(decimal value) => value.ToString("0.00", CultureInfo.InvariantCulture);
    private static string InvQty(decimal value) => value.ToString("0.##", CultureInfo.InvariantCulture);
    private static string InvPct(decimal value) => value.ToString("0.##", CultureInfo.InvariantCulture);
    private static string InvDateTime(DateTime? value) => value.HasValue ? value.Value.ToString("dd-MM-yy hh:mm tt", CultureInfo.InvariantCulture) : "-";

    private static string PaymentMethodLabel(int method) => method switch
    {
        4 => "Credit",
        0 => "Razorpay",
        1 => "UPI",
        2 => "Card",
        3 => "Net Banking",
        _ => method.ToString()
    };

    private static string SACode(string? description)
    {
        var d = (description ?? string.Empty).ToLowerInvariant();
        if (d.Contains("food")) return "996332";
        if (d.Contains("laundry")) return "999721";
        return "996311";
    }

    private List<GstGroupRow> GstGroups() => _viewBill is null
        ? new List<GstGroupRow>()
        : _viewBill.LineItems
            .Select(li => new { Sac = SACode(li.Description), li.Amount, li.CgstPercent, li.CgstAmount, li.SgstPercent, li.SgstAmount })
            .GroupBy(x => new { x.Sac, x.CgstPercent, x.SgstPercent })
            .Select(g => new GstGroupRow
            {
                Sac = g.Key.Sac,
                CgstPercent = g.Key.CgstPercent,
                SgstPercent = g.Key.SgstPercent,
                TaxableValue = g.Sum(x => x.Amount),
                CgstAmount = g.Sum(x => x.CgstAmount),
                SgstAmount = g.Sum(x => x.SgstAmount)
            })
            .OrderBy(x => x.Sac)
            .ThenBy(x => x.CgstPercent)
            .ToList();

    private sealed class GstGroupRow
    {
        public string Sac { get; set; } = "";
        public decimal CgstPercent { get; set; }
        public decimal SgstPercent { get; set; }
        public decimal TaxableValue { get; set; }
        public decimal CgstAmount { get; set; }
        public decimal SgstAmount { get; set; }
    }

