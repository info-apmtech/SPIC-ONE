@code {
    private readonly CultureInfo _ci = CultureInfo.InvariantCulture;

    // ---- Tabs ----
    private string _activeTab = "bookings";

    // ---- Date range filters ----
    private DateTime _fromDate = DateTime.Today;
    private DateTime _toDate = DateTime.Today;

    // ---- Completed bookings ----
    private List<CompletedBookingForBillingDto> _completedBookings = new();
    private bool _loadingList;
    private string _bookingsSearchText = "";

    // ---- Generated bills ----
    private List<BillListItemDto> _bills = new();
    private BillViewDto? _viewBill;
    private bool _loadingBills;
    private int _highlightId;
    private string _billsSearchText = "";

    // ---- Bill form ----
    private BillDraftDto? _draft;
    private List<BillItemRow> _billItems = new();
    private bool _busy;
    private string? _error;
    private string? _success;

    private decimal? _discount;
    private decimal? _advance;
    private decimal? _roundOff;
    private int _paymentMethod = 0;
    private bool _paymentReceived = true;
    private string _remarks = "";

    private bool _allLinesLocked => _draft != null && _draft.ExistingBillId.HasValue;

    private decimal Subtotal => _billItems.Sum(l => l.Amount);
    private decimal CgstTotal => _billItems.Sum(l => l.CgstAmount);
    private decimal SgstTotal => _billItems.Sum(l => l.SgstAmount);
    private decimal GrandTotal => Subtotal + CgstTotal + SgstTotal;
    private decimal Balance => GrandTotal - (_discount ?? 0) - (_advance ?? 0) + (_roundOff ?? 0);

    private decimal EffectiveDiscount => Math.Max(0, _discount ?? 0);
    private decimal EffectiveAdvance => Math.Max(0, _advance ?? 0);
    private decimal EffectiveRoundOff => _roundOff ?? 0;

    private string? BillingValidationMessage
    {
        get
        {
            var gross = GrandTotal;
            var discount = EffectiveDiscount;
            var advance = EffectiveAdvance;
            var roundOff = EffectiveRoundOff;
            var balance = gross - discount - advance + roundOff;

            if (_billItems.Any(i => i.Quantity < 0 || i.Rate < 0 || i.CgstPercent < 0 || i.SgstPercent < 0))
                return "Quantities, rates and GST percentages must not be negative.";

            if (discount > gross)
                return "Discount cannot exceed Grand Total.";
            if (advance > gross)
                return "Advance Payment cannot exceed Grand Total.";
            if (balance < 0)
                return "Balance Payable cannot be negative. Check Discount, Advance Payment and Round Off values.";

            return null;
        }
    }

    private bool HasBillingValidationError => BillingValidationMessage != null;

    protected override async Task OnInitializedAsync()
    {
        _fromDate = DateTime.Today;
        _toDate = DateTime.Today;

        var q = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(q.Query);
        _ = int.TryParse(query["highlight"], out _highlightId);
        if (_highlightId > 0) _activeTab = "bills";

        await LoadCompletedAsync();
        await LoadBillsAsync();
    }

    // ---- Tab switching ----

    private async Task SwitchTab(string tab)
    {
        _activeTab = tab;
        if (tab == "bookings")
            await LoadCompletedAsync();
        else
            await LoadBillsAsync();
    }

    // ---- Completed bookings ----

    private async Task LoadCompletedAsync()
    {
        _loadingList = true;
        _error = null;
        try
        {
            var fromStr = _fromDate.ToString("yyyy-MM-dd", _ci);
            var toStr = _toDate.ToString("yyyy-MM-dd", _ci);
            var url = $"api/GuestHouseFrontOffice/billing/completed?from={fromStr}&to={toStr}";
            var response = await Http.GetAsync(url);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<CompletedBookingListResult>();
                _completedBookings = result?.Bookings ?? new();
            }
            else
            {
                _error = "Could not load completed bookings.";
            }
        }
        catch (Exception)
        {
            _error = "Could not load completed bookings.";
        }
        finally
        {
            _loadingList = false;
        }
    }

    // ---- Generated bills ----

    private async Task LoadBillsAsync()
    {
        _loadingBills = true;
        _error = null;
        try
        {
            var fromStr = _fromDate.ToString("yyyy-MM-dd", _ci);
            var toStr = _toDate.ToString("yyyy-MM-dd", _ci);
            var url = $"api/GuestHouseFrontOffice/bills?from={fromStr}&to={toStr}";
            var response = await Http.GetAsync(url);
            if (response.IsSuccessStatusCode)
            {
                _bills = await response.Content.ReadFromJsonAsync<List<BillListItemDto>>() ?? new();
            }
            else
            {
                _error = "Could not load bills.";
            }
        }
        catch (Exception)
        {
            _error = "Could not load bills.";
        }
        finally
        {
            _loadingBills = false;
        }
    }

    private async Task OpenBill(int billId)
    {
        try
        {
            var response = await Http.GetAsync($"api/GuestHouseFrontOffice/bill/{billId}");
            if (response.IsSuccessStatusCode)
            {
                _viewBill = await response.Content.ReadFromJsonAsync<BillViewDto>();
            }
        }
        catch (Exception)
        {
        }
    }

    private async Task OpenBillByBookingId(int bookingId)
    {
        try
        {
            var bills = await Http.GetFromJsonAsync<List<BillListItemDto>>("api/GuestHouseFrontOffice/bills");
            var bill = bills?.FirstOrDefault(b => b.BookingId == bookingId);
            if (bill != null)
                await OpenBill(bill.BillId);
        }
        catch (Exception)
        {
        }
    }

    private void CloseBill() => _viewBill = null;

    private async Task DownloadPdf(int billId, string billNumber)
    {
        await FetchPdfAsync(billId, billNumber, false);
    }

    private async Task PrintPdf(int billId, string billNumber)
    {
        await FetchPdfAsync(billId, billNumber, true);
    }

    private async Task FetchPdfAsync(int billId, string billNumber, bool openNewWindow)
    {
        try
        {
            var bytes = await Http.GetByteArrayAsync($"api/GuestHouseFrontOffice/bill/{billId}/pdf");
            var base64 = Convert.ToBase64String(bytes);
            var fileName = $"{billNumber}.pdf";
            if (openNewWindow)
                await JS.InvokeVoidAsync("openPdfInNewWindow", base64);
            else
                await JS.InvokeVoidAsync("downloadFileFromBytes", fileName, "application/pdf", base64);
        }
        catch (Exception)
        {
        }
    }

    // ---- Search / Filter ----

    private async Task SearchAsync()
    {
        if (_fromDate > _toDate)
        {
            _error = "From Date cannot be after To Date.";
            return;
        }
        _error = null;
        if (_activeTab == "bookings")
            await LoadCompletedAsync();
        else
            await LoadBillsAsync();
    }

    private async Task ResetToTodayAsync()
    {
        _fromDate = DateTime.Today;
        _toDate = DateTime.Today;
        _error = null;
        if (_activeTab == "bookings")
            await LoadCompletedAsync();
        else
            await LoadBillsAsync();
    }

    private async Task RefreshAsync()
    {
        _error = null;
        if (_activeTab == "bookings")
            await LoadCompletedAsync();
        else
            await LoadBillsAsync();
    }

    // ---- Bill form navigation ----

    private void OpenBillForm(int bookingId)
    {
        ResetErrorAndSuccess();
        _draft = null;
        _busy = true;
        _ = Task.Run(async () =>
        {
            try
            {
                var response = await Http.GetAsync($"api/GuestHouseFrontOffice/bills/booking/{bookingId}");
                if (response.IsSuccessStatusCode)
                {
                    var dto = await response.Content.ReadFromJsonAsync<BillDraftDto>();
                    InvokeAsync(() =>
                    {
                        _draft = dto;
                        ResetBillInputs();
                        BuildBillRows();
                        _busy = false;
                        StateHasChanged();
                    });
                }
                else
                {
                    var body = await SafeReadMessage(response);
                    InvokeAsync(() =>
                    {
                        _busy = false;
                        _error = !string.IsNullOrWhiteSpace(body) ? body : "Could not load the booking for billing.";
                        StateHasChanged();
                    });
                }
            }
            catch (Exception)
            {
                InvokeAsync(() =>
                {
                    _busy = false;
                    _error = "Could not load the booking for billing.";
                    StateHasChanged();
                });
            }
        });
    }

    private void BackToList()
    {
        _draft = null;
        ResetErrorAndSuccess();
        _ = LoadCompletedAsync();
        _ = LoadBillsAsync();
    }

    private void ResetBillInputs()
    {
        _discount = 0;
        _advance = _draft?.AdvancePayment ?? 0;
        _roundOff = 0;
        _paymentMethod = 0;
        _paymentReceived = true;
        _remarks = "";
    }

    private void AddLine()
    {
        _billItems.Add(new BillItemRow
        {
            Category = BillItemCategory.LaundryOther,
            Description = "Additional Charge",
            Quantity = 1,
            Rate = 0,
            IsEditable = true,
            CanRemove = true,
            IsSystemLine = false,
            IsGstEditable = true
        });
    }

    private void RemoveLine(int index)
    {
        if (index < 0 || index >= _billItems.Count) return;
        _billItems.RemoveAt(index);
    }

    private void BuildBillRows()
    {
        _billItems = new List<BillItemRow>();
        if (_draft == null) return;

        var existingBill = _draft.ExistingBillId.HasValue;

        var room = new BillItemRow
        {
            Category = BillItemCategory.Room,
            Description = $"{(string.IsNullOrWhiteSpace(_draft.RoomType) ? "Room" : _draft.RoomType)} - Room Charge",
            Quantity = (_draft.NumberOfRooms ?? 1) * Math.Max(1, _draft.NumberOfNights),
            IsEditable = false,
            IsSystemLine = true,
            IsGstEditable = false
        };
        BillItemRow? bedsRow = null;

        foreach (var serverLine in _draft.LineItems)
        {
            var desc = serverLine.Description ?? "";
            if (IsRoomLine(desc))
            {
                room = FromServerLine(serverLine, BillItemCategory.Room, editable: false);
            }
            else if (IsBedsLine(desc))
            {
                bedsRow = FromServerLine(serverLine, BillItemCategory.AdditionalBeds, editable: !existingBill);
            }
        }

        if (existingBill)
        {
            _billItems.Add(room);
            if (bedsRow != null) _billItems.Add(bedsRow);
            return;
        }

        var extraOthers = new List<BillItemRow>();
        foreach (var serverLine in _draft.LineItems)
        {
            var desc = serverLine.Description ?? "";
            if (IsRoomLine(desc) || IsBedsLine(desc)) continue;
            extraOthers.Add(FromServerLine(serverLine, BillItemCategory.LaundryOther, editable: false));
        }

        _billItems.Add(room);

        _billItems.Add(new BillItemRow { Category = BillItemCategory.Food, Description = "Food Bill", Quantity = 1, Rate = 0, IsEditable = true, IsSystemLine = true, IsGstEditable = false });

        if (bedsRow != null)
        {
            _billItems.Add(bedsRow);
        }
        else
        {
            _billItems.Add(new BillItemRow { Category = BillItemCategory.AdditionalBeds, Description = "Additional Beds", Quantity = 0, Rate = 0, IsEditable = true, IsSystemLine = true, IsGstEditable = false });
        }

        _billItems.Add(new BillItemRow { Category = BillItemCategory.LaundryOther, Description = "Laundry / Others", Quantity = 1, Rate = 0, IsEditable = true, IsSystemLine = true, IsGstEditable = false });

        _billItems.AddRange(extraOthers);
    }

    private static bool IsRoomLine(string description) => description.Contains("Room Charge", StringComparison.OrdinalIgnoreCase);

    private static bool IsBedsLine(string description) => description.Contains("Additional Beds", StringComparison.OrdinalIgnoreCase) || description.Contains("Extra Cot", StringComparison.OrdinalIgnoreCase);

    private static BillItemRow FromServerLine(BillLineItemDto serverLine, BillItemCategory category, bool editable)
    {
        return new BillItemRow
        {
            Category = category,
            Description = serverLine.Description ?? "",
            Quantity = serverLine.Quantity,
            Rate = serverLine.Rate,
            CgstPercent = serverLine.CgstPercent,
            SgstPercent = serverLine.SgstPercent,
            IsEditable = editable,
            CanRemove = false,
            IsSystemLine = true,
            IsGstEditable = false
        };
    }

    private void ResetErrorAndSuccess()
    {
        _error = null;
        _success = null;
    }

    private async Task SaveBillAsync()
    {
        if (_draft == null) return;
        _busy = true;
        _error = null;
        _success = null;
        try
        {
            var validationMessage = BillingValidationMessage;
            if (validationMessage != null)
            {
                _error = validationMessage;
                _busy = false;
                return;
            }

            var payload = new
            {
                BookingId = _draft.BookingId,
                LineItems = _billItems
                    .Where(l => l.Amount != 0)
                    .Select(l => new
                    {
                        Description = l.Description,
                        Quantity = l.Quantity,
                        Rate = l.Rate,
                        CgstPercent = l.CgstPercent,
                        SgstPercent = l.SgstPercent,
                        IsEditable = l.IsEditable
                    }).ToList(),
                Discount = _discount,
                AdvancePayment = _advance,
                RoundOff = _roundOff,
                PaymentReceived = _paymentReceived,
                PaymentMethod = _paymentMethod,
                Remarks = string.IsNullOrWhiteSpace(_remarks) ? null : _remarks
            };

            var response = await Http.PostAsJsonAsync("api/GuestHouseFrontOffice/generate-bill", payload);
            var result = await response.Content.ReadFromJsonAsync<GenerateBillResult>();
            if (response.IsSuccessStatusCode && result?.Success == true)
            {
                _success = $"Bill {result.BillNumber} generated successfully.";
                _draft = null;
                await Task.Delay(500);
                await LoadCompletedAsync();
                await LoadBillsAsync();
                _activeTab = "bills";
                _highlightId = result.BillId;
            }
            else
            {
                _error = result?.Message ?? "Bill could not be generated.";
            }
        }
        catch (Exception)
        {
            _error = "Bill could not be generated.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task<string> SafeReadMessage(HttpResponseMessage response)
    {
        try
        {
            var content = await response.Content.ReadAsStringAsync();
            try
            {
                var parsed = System.Text.Json.JsonSerializer.Deserialize<GenerateBillResult>(content, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (!string.IsNullOrWhiteSpace(parsed?.Message)) return parsed.Message;
            }
            catch { }
            return "";
        }
        catch { return ""; }
    }

    // ---- Formatting helpers ----

    private static string FormatDate(DateTime? value) => value?.ToString("dd MMM yyyy hh:mm tt") ?? "-";
    private static string FormatDateWithTime(DateTime? value) => value?.ToString("dd MMM yyyy hh:mm tt") ?? "-";
    private static string FormatDateOnly(DateTime value) => value.ToString("dd MMM yyyy", CultureInfo.InvariantCulture);
    private string FormatMoney(decimal value) => "₹" + value.ToString("N2", _ci);
    private static string FormatBillDate(DateTime? value) => value.HasValue ? value.Value.ToString("dd MMM yyyy", CultureInfo.InvariantCulture) : "-";

    // ---- DataTable export columns (LocationMaster's SpicDataTable Copy/CSV/Excel/PDF/Print) ----

    private List<ExportColumn<CompletedBookingForBillingDto>> GetCompletedBookingsExportColumns()
    {
        return new List<ExportColumn<CompletedBookingForBillingDto>>
        {
            new() { Header = "Booking ID", ValueSelector = i => i.BookingReference },
            new() { Header = "Guest Name", ValueSelector = i => i.GuestName ?? "-" },
            new() { Header = "Guest House", ValueSelector = i => i.GuestHouseName },
            new() { Header = "Room", ValueSelector = i => (string.IsNullOrEmpty(i.RoomNumber) ? "-" : i.RoomNumber) + " (" + i.RoomType + ")" },
            new() { Header = "Check-In", ValueSelector = i => FormatDateWithTime(i.CheckInDate) },
            new() { Header = "Check-Out", ValueSelector = i => FormatDateWithTime(i.CheckOutDate) },
            new() { Header = "Amount", ValueSelector = i => FormatMoney(i.Amount) },
            new() { Header = "Payment Status", ValueSelector = i => i.PaymentStatus == 1 ? "Paid" : "Pending" },
            new() { Header = "Bill Status", ValueSelector = i => i.HasBill ? "Billed" : "Not Billed" },
        };
    }

