            new() { Header = "Total", ValueSelector = b => FormatMoney(b.TotalAmount) },
            new() { Header = "Balance", ValueSelector = b => FormatMoney(b.BalanceAmount) },
            new() { Header = "Payment", ValueSelector = b => b.PaymentStatus == 1 ? "Paid" : "Pending" },
        };
    }

