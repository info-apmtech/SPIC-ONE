    private void CalculateStepStatus()
    {
        // Step 1: Dealer Registration — FirmName, StateId, address, bank
        _stepStatus[0] = !string.IsNullOrEmpty(_dealer.FirmName) && _dealer.StateId > 0 && !string.IsNullOrEmpty(_dealer.OfficialContactNumber) && _dealer.BankId > 0;

        // Step 2: Experience
        _stepStatus[1] = _experiences.Count > 0;

        // Step 3: Annual Sales
        _stepStatus[2] = _annualSales.Count > 0;

        // Step 4: Warehouse
        _stepStatus[3] = _warehouses.Count > 0 || _railFacilities.Count > 0 || _portFacilities.Count > 0;

        // Step 5: Market Details
        _stepStatus[4] = _marketDetails.Count > 0;

        // Step 6: Companies Operating
        _stepStatus[5] = _companies.Count > 0;

        // Step 7: Proprietor
        _stepStatus[6] = _partners.Count > 0;

        // Step 8: Sales Planning
        _stepStatus[7] = _salesPlans.Count > 0;

        // Step 9: Investment
        _stepStatus[8] = _assetBanks.Count > 0 || _assetLands.Count > 0 || _assetBuildings.Count > 0;

        // Step 10: Credit Limit
        _stepStatus[9] = _creditLimit != null;

        // Step 11: Enclosures
        _stepStatus[10] = _docs != null &&
            !string.IsNullOrEmpty(_docs.SpecimanFilePath) &&
            !string.IsNullOrEmpty(_docs.BankGauranteeFilePath) &&
            !string.IsNullOrEmpty(_docs.FY1ITReturnFilePath) &&
            !string.IsNullOrEmpty(_docs.FY2ITReturnFilePath) &&
            (_hasRetailLicense || !string.IsNullOrEmpty(_docs.RetailerListFilePath));
    }

    private void BuildEnclosureItems()
    {
        _enclosureItems = new List<EnclosureItem>
        {
            new("GST Certificate", !string.IsNullOrEmpty(_dealer.GSTFilePath)),
            new("PAN Copy", !string.IsNullOrEmpty(_dealer.PANFilePath)),
            new("Aadhaar Copy", !string.IsNullOrEmpty(_dealer.AadhaarFilePath)),
            new("SPIC Specimen Signature", _docs != null && !string.IsNullOrEmpty(_docs.SpecimanFilePath)),
            new("Bank Guarantee Certificate", _docs != null && !string.IsNullOrEmpty(_docs.BankGauranteeFilePath)),
            new("IT Returns (FY1)", _docs != null && !string.IsNullOrEmpty(_docs.FY1ITReturnFilePath)),
            new("IT Returns (FY2)", _docs != null && !string.IsNullOrEmpty(_docs.FY2ITReturnFilePath)),
            new("Affidavit", _docs != null && !string.IsNullOrEmpty(_docs.AffidavitFilePath)),
        };

        // Only show Deed of Guarantee if uploaded
        if (_docs != null && !string.IsNullOrEmpty(_docs.DeedOfGuaranteeFilePath))
            _enclosureItems.Add(new("Deed of Guarantee", true));

        // Only show Retailer List if uploaded
        if (_docs != null && !string.IsNullOrEmpty(_docs.RetailerListFilePath))
            _enclosureItems.Add(new("Retailer List", true));

        // Only show Greenstar Specimen if uploaded
        if (_docs != null && !string.IsNullOrEmpty(_docs.GreenstarSpecimanFilePath))
            _enclosureItems.Add(new("Greenstar Specimen Signature", true));

        // Conditional license documents
        if (_hasWholesaleLicense)
            _enclosureItems.Add(new("Wholesale Fertilizers License", !string.IsNullOrEmpty(_dealer.WholesaleLicenseFilePath)));
        if (_hasRetailLicense)
            _enclosureItems.Add(new("Retail Fertilizers License", !string.IsNullOrEmpty(_dealer.RetailLicenseFilePath)));

        // Conditional documents based on business entity type
        if (_showPartnershipDeed)
            _enclosureItems.Add(new("Partnership Deed", _docs != null && !string.IsNullOrEmpty(_docs.PartnershipDeadFilePath)));
        if (_showBoardResolution)
            _enclosureItems.Add(new("Board Resolution", _docs != null && !string.IsNullOrEmpty(_docs.BoardReasolutionFilePath)));
        if (_showAuthorizationLetter)
            _enclosureItems.Add(new("Authorization Letter", _docs != null && !string.IsNullOrEmpty(_docs.AuthorizationLetterFilePath)));

        // Partner documents
        foreach (var p in _partners)
        {
            _enclosureItems.Add(new($"Photo — {p.Name}", !string.IsNullOrEmpty(p.ProprietorImagePath)));
            if (!_isSoleProprietor)
            {
                _enclosureItems.Add(new($"Aadhaar — {p.Name}", !string.IsNullOrEmpty(p.AadhaarFilePath)));
                _enclosureItems.Add(new($"PAN — {p.Name}", !string.IsNullOrEmpty(p.PANFilePath)));
            }
        }

        // Land asset documents
        foreach (var l in _assetLands)
        {
            _enclosureItems.Add(new($"EC — Land: {l.LandName}", !string.IsNullOrEmpty(l.UploadedECDocumentPath)));
            _enclosureItems.Add(new($"Property Doc — Land: {l.LandName}", !string.IsNullOrEmpty(l.UploadedLandDocumentPath)));
            _enclosureItems.Add(new($"Valuation — Land: {l.LandName}", !string.IsNullOrEmpty(l.UploadedValuationCertificatePath)));
        }

        // Building asset documents
        foreach (var b in _assetBuildings)
        {
            _enclosureItems.Add(new($"EC — Building: {b.BuildingName}", !string.IsNullOrEmpty(b.UploadedECDocumentPath)));
            _enclosureItems.Add(new($"Property Doc — Building: {b.BuildingName}", !string.IsNullOrEmpty(b.UploadedBuildingDocumentPath)));
            _enclosureItems.Add(new($"Valuation — Building: {b.BuildingName}", !string.IsNullOrEmpty(b.UploadedValuationCertificatePath)));
        }

        _docTotalCount = _enclosureItems.Count;
        _docUploadedCount = _enclosureItems.Count(d => d.Uploaded);
        _docMissingCount = _docTotalCount - _docUploadedCount;
    }

    private void CalculateProgress()
    {
        _completedSections = _stepStatus.Count(s => s);
        _incompleteSections = _totalSections - _completedSections;
        _progressPercent = _totalSections > 0 ? (int)Math.Round((double)_completedSections / _totalSections * 100) : 0;
    }

    private async Task HandleSubmit()
    {
        if (_incompleteSections > 0)
        {
            SPIC.MauiBlazorApp.Shared.FormFlow.FormStepData.MarkStepError(13, true);
            ShowMessage($"Please complete all {_incompleteSections} incomplete section(s) before submitting.", true);
            return;
        }

        _isSubmitting = true;
        _message = null;

        try
        {
            if (_dealer.RMApproved == false || _dealer.SMApproved == false || _dealer.AVPApproved == false)
            {
                _dealer.RMApproved = null;
                _dealer.SMApproved = null;
                _dealer.AVPApproved = null;
            }
            _dealer.Status = DealerStatus.Active;
            var resp = await Http.PutAsJsonAsync($"api/DealerRegistration/{_dealer.Id}", _dealer);
            resp.EnsureSuccessStatusCode();
            SPIC.MauiBlazorApp.Shared.FormFlow.FormStepData.MarkStepError(13, false);
            ShowMessage("Registration submitted successfully!", false);
            await Task.Delay(1500);
            Nav.NavigateTo("/Dashboard");
        }
        catch (Exception ex)
        {
            SPIC.MauiBlazorApp.Shared.FormFlow.FormStepData.MarkStepError(12, true);
            ShowMessage($"Error submitting registration: {ex.Message}", true);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private string MaskValue(string? value)
    {
        if (string.IsNullOrEmpty(value)) return "—";
        if (value.Length <= 4) return value;
        return new string('*', value.Length - 4) + value[^4..];
    }

    private void ShowMessage(string msg, bool isError)
    {
        _message = msg;
        _isError = isError;
    }

    private record EnclosureItem(string Name, bool Uploaded);
}