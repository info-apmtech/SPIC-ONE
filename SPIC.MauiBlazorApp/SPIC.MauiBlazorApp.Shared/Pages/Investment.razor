<div class="main-section">
	<div class="section-header border-0 mb-2">
		<h3 class="section-title">
			<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/HomeLoan.svg" style="width: 24px;" />
			<i class="bi bi-cash-stack" style="display:none;"></i>
			Loan Liabilities List
		</h3>
		<div class="val-pill pill-light-blue">Total Liabilities Value <span class="ms-1">0₹</span></div>
	</div>
           
	<div class="row g-3 mb-3">
		<div class="col-md-4">
			<label class="custom-label">Loan Source / Institution *</label>
			<input type="text" class="custom-input" placeholder="e.g., State Bank Of India">
		</div>
		<div class="col-md-4">
			<label class="custom-label">Loan Value *</label>
			<input type="text" class="custom-input" placeholder="₹ 0.00">
		</div>
		<div class="col-md-4 d-flex align-items-end">
			<input type="text" class="custom-input" placeholder="Remarks...">
		</div>
	</div>

	<div class="d-flex justify-content-end mb-4">
		<button class="btn-blue-action" style="width: auto;">
			<i class="bi bi-plus-lg"></i> Add Loan
		</button>
	</div>

	<div class="loan-list-container">
		<div class="d-flex justify-content-between align-items-center mb-4">
			<h4 class="list-header m-0 d-flex align-items-center gap-2">
				<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/HomeLoan.svg" style="width: 20px;"/>
				Loan Liabilities List
			</h4>
			<div class="fw-bold text-dark fs-5">3</div>
		</div>

		<div class="row g-3">
			@for (int i = 0; i<3; i++)
			{
				<div class="col-md-4">
					<div class="loan-card-white">
						<div class="loan-header">
							<div class="loan-bank-name">
								<i class="bi bi-bank"></i> State Bank
							</div>
							<div class="asset-actions ms-auto">
								<i class="bi bi-pencil-square edit"></i>
								<i class="bi bi-trash delete"></i>
							</div>
						</div>
                    
						<div class="loan-detail-box">
							<div class="asset-lbl">Loan Value</div>
							<div class="asset-val">200000</div>
						</div>
						<div class="loan-detail-box">
							<div class="asset-lbl">Remarks</div>
							<div class="asset-val" style="font-weight: 500;">Add the Remarks</div>
						</div>
					</div>
				</div>
			}
		</div>
	</div>
</div>
