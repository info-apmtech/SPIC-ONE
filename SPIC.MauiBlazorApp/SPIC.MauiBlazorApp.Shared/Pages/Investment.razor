@page "/Investment"
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@using SPIC.Core.Entities
@using DealerReg = SPIC.Core.Entities.DealerRegistration
@inject HttpClient Http
@inject NavigationManager Nav
@inject LoadingService Loading

<div class="container-fluid py-4 px-0">
	<FormLoader />

	@if (!string.IsNullOrEmpty(_message))
	{
		<div class="alert @(_isError ? "alert-danger" : "alert-success") alert-dismissible fade show mb-3" role="alert">
			@_message
			<button type="button" class="btn-close" @onclick='() => _message = null'></button>
		</div>
	}

	<div class="company-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
		<h3 class="fw-bold m-0 company-title">Investment</h3>
	</div>

	<!-- Assets (Banking & Properties) Section -->
	<div class="main-section">
		<div class="section-header">
			<h3 class="section-title">
				<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/Banking.svg" style="width: 24px;" />
				Assets (Banking & Properties)
			</h3>
			<div class="d-flex gap-3">
				<div class="val-pill">Assets Added <span>@(_bankAssets.Count + _landAssets.Count + _buildingAssets.Count)</span></div>
				<div class="val-pill">Total Capital Value <span>₹@((_bankAssets.Sum(b => b.Value) + _landAssets.Sum(l => l.PropertyValue) + _buildingAssets.Sum(b => b.PropertyValue)).ToString("N0"))</span></div>
			</div>
		</div>

		<div class="row g-4 mb-4">

			<!-- Banking Sub-Card -->
			<div class="col-md-6">
				<div class="sub-card">
					<div class="sub-card-title"><i class="bi bi-bank icon-blue"></i> Banking</div>
					<div class="row g-3 mb-3">
						<div class="col-6">
							<label class="custom-label">Bank Name</label>
							<select class="form-select-custom w-100" @bind="_bankForm.BankId">
								<option value="0">Select Bank Name</option>
								@foreach (var bank in _banks)
								{
									<option value="@bank.Id">@bank.Name</option>
								}
							</select>
						</div>
						<div class="col-6">
							<label class="custom-label">Bank Branch</label>
							<input type="text" class="custom-input" placeholder="Enter Branch" @bind="_bankForm.BankBranch" />
						</div>
					</div>
					<div class="row g-3 mb-4">
						<div class="col-6">
							<label class="custom-label">OD Limit (₹) Lakhs</label>
							<input type="number" class="custom-input" placeholder="0.0" @bind="_bankForm.Value" />
						</div>
						<div class="col-6">
							<label class="custom-label">Remarks</label>
							<input type="text" class="custom-input" placeholder="" @bind="_bankForm.Remarks" />
						</div>
					</div>
					<div class="mt-auto">
						<button class="btn-blue-action" @onclick="SaveBankAsset"><i class="bi bi-plus"></i> @(_bankForm.Id > 0 ? "Update" : "Add") Banking</button>
					</div>
				</div>
			</div>

			<!-- Land Sub-Card -->
			<div class="col-md-6">
				<div class="sub-card">
					<div class="sub-card-title">
						<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/Land.svg" style="width: 24px;" />
						Land
					</div>
					<div class="row g-3 mb-3">
						<div class="col-6">
							<label class="custom-label">Land Name / Location</label>
							<input type="text" class="custom-input" placeholder="Enter Land Name" @bind="_landForm.LandName" />
						</div>
						<div class="col-6">
							<label class="custom-label">Survey Number</label>
							<input type="text" class="custom-input" placeholder="Enter Survey Number" @bind="_landForm.SurvayNumber" />
						</div>
					</div>
					<div class="row g-3 mb-4">
						<div class="col-6">
							<label class="custom-label">Land Size (In Cent)</label>
							<input type="number" class="custom-input" placeholder="Enter In Cent" @bind="_landForm.LandSize" />
						</div>
						<div class="col-6">
							<label class="custom-label">Market Value (₹) (In Lakhs)</label>
							<input type="number" class="custom-input" placeholder="Enter Value" @bind="_landForm.PropertyValue" />
						</div>
					</div>
					<div class="row g-3 mb-4">
						<div class="col-6">
							<label class="custom-label">EC (Encumbrance Certificate)</label>
							<label for="landEcUpload" class="btn-upload-dashed btn-upload-attach-Enclosure w-100 mb-0 h-50 mt-2" style="cursor:pointer;">
								<i class="bi bi-upload"></i>
								@(string.IsNullOrEmpty(_landForm.UploadedECDocumentPath) ? "Upload EC" : "Replace EC")
							</label>
							<InputFile id="landEcUpload" hidden OnChange="OnLandECSelected" accept=".pdf,.jpg,.jpeg,.png" />
							@if (!string.IsNullOrEmpty(_landForm.UploadedECDocumentPath))
							{
								<div class="small text-success mt-1"><i class="bi bi-check-circle"></i> @GetFileName(_landForm.UploadedECDocumentPath)</div>
							}
						</div>
						<div class="col-6">
							<label class="custom-label">Property Document</label>
							<label for="landPropertyUpload" class="btn-upload-dashed btn-upload-attach-Enclosure w-100 mb-0 h-50 mt-2" style="cursor:pointer;">
								<i class="bi bi-upload"></i>
								@(string.IsNullOrEmpty(_landForm.UploadedLandDocumentPath) ? "Upload Property Doc" : "Replace Property Doc")
							</label>
							<InputFile id="landPropertyUpload" hidden OnChange="OnLandPropertyDocSelected" accept=".pdf,.jpg,.jpeg,.png" />
							@if (!string.IsNullOrEmpty(_landForm.UploadedLandDocumentPath))
							{
								<div class="small text-success mt-1"><i class="bi bi-check-circle"></i> @GetFileName(_landForm.UploadedLandDocumentPath)</div>
							}
						</div>
					</div>
					<div class="row g-3 mb-4">
						<div class="col-6">
							<label class="custom-label">Valuation Certificate</label>
							<label for="landValuationUpload" class="btn-upload-dashed btn-upload-attach-Enclosure w-100 mb-0 h-50 mt-2" style="cursor:pointer;">
								<i class="bi bi-upload"></i>
								@(string.IsNullOrEmpty(_landForm.UploadedValuationCertificatePath) ? "Upload Valuation Cert" : "Replace Valuation Cert")
							</label>
							<InputFile id="landValuationUpload" hidden OnChange="OnLandValuationCertSelected" accept=".pdf,.jpg,.jpeg,.png" />
							@if (!string.IsNullOrEmpty(_landForm.UploadedValuationCertificatePath))
							{
								<div class="small text-success mt-1"><i class="bi bi-check-circle"></i> @GetFileName(_landForm.UploadedValuationCertificatePath)</div>
							}
						</div>
					</div>
					<div class="mt-auto">
						<button class="btn-blue-action" @onclick="SaveLandAsset"><i class="bi bi-plus"></i> @(_landForm.Id > 0 ? "Update" : "Add") Land</button>
					</div>
				</div>
			</div>
		</div>

		<!-- Building Sub-Card -->
		<div class="sub-card mb-4">
			<div class="sub-card-title">
				<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/Home.svg" />
				Building
			</div>
			<div class="row g-3 mb-3">
				<div class="col-md-4">
					<label class="custom-label">Building Name</label>
					<input type="text" class="custom-input" placeholder="Enter Building Name" @bind="_buildingForm.BuildingName" />
				</div>
				<div class="col-md-4">
					<label class="custom-label">Market Value (₹) In Lakhs</label>
					<input type="number" class="custom-input" placeholder="Enter Value" @bind="_buildingForm.PropertyValue" />
				</div>
				<div class="col-md-4">
					<label class="custom-label">Survey Number</label>
					<input type="text" class="custom-input" placeholder="Enter Survey Number" @bind="_buildingForm.SurveyNumber" />
				</div>
			</div>
			<div class="row g-3 mb-3">
				<div class="col-md-4">
					<label class="custom-label">Land Size (In Square Ft)</label>
					<input type="number" class="custom-input" placeholder="Enter In Square Ft" @bind="_buildingForm.LandSize" />
				</div>
				<div class="col-md-4">
					<label class="custom-label">Remarks</label>
					<input type="text" class="custom-input" placeholder="" @bind="_buildingForm.Remarks" />
				</div>
				<div class="col-md-4">
					<label class="custom-label">Shop No / Room No / Block No</label>
					<input type="text" class="custom-input" placeholder="Enter Shop/Room/Block No" @bind="_buildingForm.ShopNoORRoomNoOrBlockNo" />
				</div>
			</div>
			<div class="row g-3 mb-3">
				<div class="col-md-4">
					<label class="custom-label">Pin Code</label>
					<input type="text" class="custom-input" placeholder="Enter Pincode" maxlength="6" @bind="_buildingForm.PinCode" @bind:after="OnBuildingPincodeChanged" />
					@if (_isBuildingPincodeLookup)
					{
						<div class="small text-muted mt-1"><i class="bi bi-arrow-repeat spin"></i> Looking up pincode...</div>
					}
					@if (!string.IsNullOrEmpty(_buildingPincodeMessage))
					{
						<div class="small @(_buildingPincodeSuccess ? "text-success" : "text-warning") mt-1">@_buildingPincodeMessage</div>
					}
				</div>
				<div class="col-md-4">
					<label class="custom-label">Street</label>
					<input type="text" class="custom-input" placeholder="Enter Street" @bind="_buildingForm.Street" />
				</div>
				<div class="col-md-4">
					<label class="custom-label">Sub Village</label>
					<input type="text" class="custom-input" placeholder="Enter Sub Village" @bind="_buildingForm.SubVillage" />
				</div>
			</div>
			<div class="row g-3 mb-3">
				<div class="col-md-4">
					<label class="custom-label">Village</label>
					<input type="text" class="custom-input" placeholder="Enter Village" @bind="_buildingForm.Village" />
				</div>
				<div class="col-md-4">
					<label class="custom-label">Block</label>
					<input type="text" class="custom-input" placeholder="Enter Block" @bind="_buildingForm.Block" />
				</div>
				<div class="col-md-4">
					<label class="custom-label">Taluk</label>
					<input type="text" class="custom-input" placeholder="Enter Taluk" @bind="_buildingForm.Taluk" />
				</div>
			</div>
			<div class="row g-3 mb-4">
				<div class="col-md-4">
					<label class="custom-label">District</label>
					<select class="form-select-custom w-100" @bind="_buildingForm.DistrictId">
						<option value="0">Select District</option>
						@foreach (var d in _districts)
						{
							<option value="@d.Id">@d.DistrictName</option>
						}
					</select>
				</div>
				<div class="col-md-4">
					<label class="custom-label">State</label>
					<select class="form-select-custom w-100" @bind="_buildingForm.StateId">
						<option value="0">Select State</option>
						@foreach (var s in _states)
						{
							<option value="@s.Id">@s.StateName</option>
						}
					</select>
				</div>
				<div class="col-md-4">
					<label class="custom-label">EC (Encumbrance Certificate)</label>
					<label for="buildingEcUpload" class="btn-upload-dashed btn-upload-attach-Enclosure w-100 mb-0 h-50 mt-2" style="cursor:pointer;">
						<i class="bi bi-upload"></i>
						@(string.IsNullOrEmpty(_buildingForm.UploadedECDocumentPath) ? "Upload EC" : "Replace EC")
					</label>
					<InputFile id="buildingEcUpload" hidden OnChange="OnBuildingECSelected" accept=".pdf,.jpg,.jpeg,.png" />

					@if (!string.IsNullOrEmpty(_buildingForm.UploadedECDocumentPath))
					{
						<div class="small text-success mt-1">
							<i class="bi bi-check-circle"></i> @GetFileName(_buildingForm.UploadedECDocumentPath)
						</div>
					}
				</div>
			</div>
			<div class="row g-3 mb-3">
				<div class="col-md-4">
					<label class="custom-label">Property Document</label>
					<label for="buildingPropertyUpload" class="btn-upload-dashed btn-upload-attach-Enclosure w-100 mb-0 h-50 mt-2" style="cursor:pointer;">
						<i class="bi bi-upload"></i>
						@(string.IsNullOrEmpty(_buildingForm.UploadedBuildingDocumentPath) ? "Upload Property Doc" : "Replace Property Doc")
					</label>
					<InputFile id="buildingPropertyUpload" hidden OnChange="OnBuildingPropertyDocSelected" accept=".pdf,.jpg,.jpeg,.png" />

					@if (!string.IsNullOrEmpty(_buildingForm.UploadedBuildingDocumentPath))
					{
						<div class="small text-success mt-1">
							<i class="bi bi-check-circle"></i> @GetFileName(_buildingForm.UploadedBuildingDocumentPath)
						</div>
					}
				</div>
				<div class="col-md-4">
					<label class="custom-label">Valuation Certificate</label>
					<label for="buildingValuationUpload" class="btn-upload-dashed btn-upload-attach-Enclosure w-100 mb-0 h-50 mt-2" style="cursor:pointer;">
						<i class="bi bi-upload"></i>
						@(string.IsNullOrEmpty(_buildingForm.UploadedValuationCertificatePath) ? "Upload Valuation Cert" : "Replace Valuation Cert")
					</label>
					<InputFile id="buildingValuationUpload" hidden OnChange="OnBuildingValuationCertSelected" accept=".pdf,.jpg,.jpeg,.png" />

					@if (!string.IsNullOrEmpty(_buildingForm.UploadedValuationCertificatePath))
					{
						<div class="small text-success mt-1">
							<i class="bi bi-check-circle"></i> @GetFileName(_buildingForm.UploadedValuationCertificatePath)
						</div>
					}
				</div>
				<div class="col-md-4">
					<button class="btn-blue-action w-100" @onclick="SaveBuildingAsset"><i class="bi bi-plus"></i> @(_buildingForm.Id > 0 ? "Update" : "Add") Building</button>
				</div>
			</div>
		</div>

		<h4 class="list-header">Your Added Assets</h4>

		@foreach (var item in _bankAssets)
		{
			var bankName = _banks.FirstOrDefault(b => b.Id == item.BankId)?.Name ?? "Bank";
			var bankType = "bank";
			<div class="asset-row">
				<div class="asset-icon" style="color: #3B82F6; background: #EFF6FF;"><i class="bi bi-bank"></i></div>
				<div class="asset-detail"><div class="asset-lbl">Bank Name</div><div class="asset-val">@bankName</div></div>
				<div class="asset-detail"><div class="asset-lbl">Bank Branch</div><div class="asset-val">@item.BankBranch</div></div>
				<div class="asset-detail"><div class="asset-lbl">Value (₹)</div><div class="asset-val">₹ @item.Value.ToString("N0")</div></div>
				<div class="asset-detail"><div class="asset-lbl">Remarks</div><div class="asset-val text-muted">@item.Remarks</div></div>
				<div class="asset-actions">
					<i class="bi bi-pencil-square edit" style="cursor:pointer;" @onclick="() => EditBankAsset(item)"></i>
					<i class="bi bi-trash delete" style="cursor:pointer;" @onclick="() => ConfirmDelete(item.Id, bankType)"></i>
				</div>
			</div>
		}

		@foreach (var item in _landAssets)
		{
			var landType = "land";
			<div class="asset-row">
				<div class="asset-icon" style="color: #10B981; background: #ECFDF5;"><i class="bi bi-geo-alt"></i></div>
				<div class="asset-detail"><div class="asset-lbl">Land Name</div><div class="asset-val">@item.LandName</div></div>
				<div class="asset-detail"><div class="asset-lbl">Survey No</div><div class="asset-val">@item.SurvayNumber</div></div>
				<div class="asset-detail"><div class="asset-lbl">Size (Cent)</div><div class="asset-val">@item.LandSize</div></div>
				<div class="asset-detail"><div class="asset-lbl">Value (₹)</div><div class="asset-val">₹ @item.PropertyValue.ToString("N0")</div></div>
				<div class="asset-detail">
					<div class="asset-lbl">Documents</div>
					<div class="asset-val">
						@if (!string.IsNullOrEmpty(item.UploadedECDocumentPath))
						{
							<span class="badge bg-success me-1">EC</span>
						}
						@if (!string.IsNullOrEmpty(item.UploadedLandDocumentPath))
						{
							<span class="badge bg-success me-1">Property</span>
						}
						@if (!string.IsNullOrEmpty(item.UploadedValuationCertificatePath))
						{
							<span class="badge bg-success">Valuation</span>
						}
					</div>
				</div>
				<div class="asset-actions">
					<i class="bi bi-pencil-square edit" style="cursor:pointer;" @onclick="() => EditLandAsset(item)"></i>
					<i class="bi bi-trash delete" style="cursor:pointer;" @onclick="() => ConfirmDelete(item.Id, landType)"></i>
				</div>
			</div>
		}

		@foreach (var item in _buildingAssets)
		{
			var buildingType = "building";
			<div class="asset-row">
				<div class="asset-icon" style="color: #EC4899; background: #FCE7F3;"><i class="bi bi-building"></i></div>
				<div class="asset-detail"><div class="asset-lbl">Building</div><div class="asset-val">@item.BuildingName</div></div>
				<div class="asset-detail"><div class="asset-lbl">Value (₹)</div><div class="asset-val">₹ @item.PropertyValue.ToString("N0")</div></div>
				<div class="asset-detail"><div class="asset-lbl">Size (Sq Ft)</div><div class="asset-val">@item.LandSize</div></div>
				<div class="asset-detail">
					<div class="asset-lbl">Documents</div>
					<div class="asset-val">
						@if (!string.IsNullOrEmpty(item.UploadedECDocumentPath))
						{
							<span class="badge bg-success me-1">EC</span>
						}
						@if (!string.IsNullOrEmpty(item.UploadedBuildingDocumentPath))
						{
							<span class="badge bg-success me-1">Property</span>
						}
						@if (!string.IsNullOrEmpty(item.UploadedValuationCertificatePath))
						{
							<span class="badge bg-success">Valuation</span>
						}
					</div>
				</div>
				<div class="asset-actions">
					<i class="bi bi-pencil-square edit" style="cursor:pointer;" @onclick="() => EditBuildingAsset(item)"></i>
					<i class="bi bi-trash delete" style="cursor:pointer;" @onclick="() => ConfirmDelete(item.Id, buildingType)"></i>
				</div>
			</div>
		}
	</div>

	<!-- Movable Section -->
	<div class="main-section">
		<div class="section-header border-0 mb-0 pb-0">
			<h3 class="section-title">
				<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/MovableAsset.svg" style="width: 24px;" />
				Movable
			</h3>
		</div>
		<div class="row g-3 mt-1">
			<div class="col-md-6">
				<label class="custom-label">Movable Assets Value(₹ in Lakhs)</label>
				<input type="number" class="custom-input" placeholder="Enter Value" @bind="_dealer.AssetValue" />
			</div>
			<div class="col-md-6">
				<label class="custom-label">Remarks (Assets car,bike,gold,silver,diamond,etc)</label>
				<input type="text" class="custom-input" placeholder="" @bind="_dealer.Remarks" />
			</div>
		</div>
	</div>

	<!-- Infrastructure Section -->
	<div class="main-section">
		<div class="section-header border-0 mb-0 pb-0">
			<h3 class="section-title"><img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/Infrastructure.svg" style="width: 24px;" /> Infrastructure</h3>
		</div>
		<div class="row g-4 mt-1">
			<div class="col-md-6">
				<div class="sub-card">
					<div class="sub-card-title">
						<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/OwnGodown.svg" style="width: 24px;" />
						Own Godown Capacity
					</div>
					<label class="custom-label">MT</label>
					<input type="number" class="custom-input" placeholder="Enter The Value" @bind="_dealer.OwnGodownCapacity" />
				</div>
			</div>
			<div class="col-md-6">
				<div class="sub-card">
					<div class="sub-card-title">
						<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/RentGodown.svg" style="width: 24px;" />
						Rent Godown Capacity
					</div>
					<label class="custom-label">MT</label>
					<input type="number" class="custom-input" placeholder="Enter The Value" @bind="_dealer.RentGodownCapacity" />
				</div>
			</div>
		</div>
	</div>

	<!-- Loan Liabilities Section -->
	<div class="main-section">
		<div class="section-header border-0 mb-2">
			<h3 class="section-title">
				<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/LoanLiabilities .svg" style="width: 24px;" />
				<i class="bi bi-cash-stack" style="display:none;"></i>
				Loan Liabilities List
			</h3>
			<div class="val-pill pill-light-blue">Total Liabilities Value <span class="ms-1">₹@_loanLiabilities.Sum(l => l.LoanValue).ToString("N0")</span></div>
		</div>

		<div class="row g-3 mb-3">
			<div class="col-md-4">
				<label class="custom-label">Loan Source / Institution *</label>
				<input type="text" class="custom-input" placeholder="e.g., State Bank Of India" @bind="_loanForm.LoanSource" />
			</div>
			<div class="col-md-4">
				<label class="custom-label">Loan Value (₹) In Lakhs *</label>
				<input type="number" class="custom-input" placeholder="₹ 0.00" @bind="_loanForm.LoanValue" />
			</div>
			<div class="col-md-4 d-flex align-items-end">
				<input type="text" class="custom-input" placeholder="Remarks..." @bind="_loanForm.Remarks" />
			</div>
		</div>

		<div class="d-flex justify-content-end mb-4">
			<button class="btn-blue-action" style="width: auto;" @onclick="SaveLoan">
				<i class="bi bi-plus-lg"></i> @(_loanForm.Id > 0 ? "Update" : "Add") Loan
			</button>
		</div>

		<div class="loan-list-container">
			<div class="d-flex justify-content-between align-items-center mb-4">
				<h4 class="list-header m-0 d-flex align-items-center gap-2">
					<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/LoanLiabilities .svg" style="width: 20px;" />
					Loan Liabilities List
				</h4>
				<div class="fw-bold text-dark fs-5">@_loanLiabilities.Count</div>
			</div>

			<div class="row g-3">
				@foreach (var loan in _loanLiabilities)
				{
					var loanType = "loan";
					<div class="col-md-4">
						<div class="loan-card-white">
							<div class="loan-header">
								<div class="loan-bank-name">
									<i class="bi bi-bank"></i> @loan.LoanSource
								</div>
								<div class="asset-actions ms-auto">
									<i class="bi bi-pencil-square edit" style="cursor:pointer;" @onclick="() => EditLoan(loan)"></i>
									<i class="bi bi-trash delete" style="cursor:pointer;" @onclick="() => ConfirmDelete(loan.Id, loanType)"></i>
								</div>
							</div>
							<div class="loan-detail-box">
								<div class="asset-lbl">Loan Value</div>
								<div class="asset-val">₹ @loan.LoanValue.ToString("N0")</div>
							</div>
							<div class="loan-detail-box">
								<div class="asset-lbl">Remarks</div>
								<div class="asset-val" style="font-weight: 500;">@(string.IsNullOrEmpty(loan.Remarks) ? "-" : loan.Remarks)</div>
							</div>
						</div>
					</div>
				}
			</div>
		</div>
	</div>

	<!-- Financial Summary Footer -->
	<div class="financial-footer">
		<div class="fin-top-row">
			<div class="fin-title">
				<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/LoanLiabilities .svg" style="width: 24px;" />
				Net Financial Position
			</div>
			<div class="d-flex align-items-center gap-3 flex-wrap justify-content-end">
				@if (NetFinancial >= 0)
				{
					<div class="badge-outline-green"><i class="bi bi-check-circle-fill"></i> Positive Financial Position</div>
				}
				else
				{
					<div class="badge-outline-red"><i class="bi bi-exclamation-triangle-fill"></i> Negative Financial Position</div>
				}
			</div>
		</div>

		<div class="fin-pill-grid">
			<div class="fin-card-white fin-green">
				<div class="fin-card-header">
					<div class="fin-icon-bg"><i class="bi bi-bank"></i></div>
					Fixed Assets
				</div>
				<div class="fin-card-val">₹ @AssetsTotal.ToString("N0")</div>
				<div class="fin-card-sub">Banking, Land, Building & Movable</div>
			</div>

			<div class="fin-card-white fin-red">
				<div class="fin-card-header">
					<div class="fin-icon-bg"><i class="bi bi-dash-circle"></i></div>
					Total Liabilities
				</div>
				<div class="fin-card-val">₹ @LoansTotal.ToString("N0")</div>
				<div class="fin-card-sub">Loan obligations</div>
			</div>

			<div class="fin-card-highlight @(NetFinancial >= 0 ? "fin-net-positive" : "fin-net-negative")">
				<div class="fin-card-header">
					<div class="fin-icon-bg"><i class="bi bi-wallet2"></i></div>
					Net Financial Value
				</div>
				<div class="fin-card-val">₹ @NetFinancial.ToString("N0")</div>
				<div class="fin-card-formula">₹@AssetsTotal.ToString("N0") − ₹@LoansTotal.ToString("N0")</div>
			</div>
		</div>
	</div>

	<CommanFooter OnNextClick="HandleNext" IsNextDisabled="@_isSaving" />
</div>

<!-- Delete Confirmation Modal -->
@if (_showDeleteModal)
{
	<div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
		<div class="modal-dialog modal-dialog-centered">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title">Confirm Delete</h5>
					<button type="button" class="btn-close" @onclick="() => _showDeleteModal = false"></button>
				</div>
				<div class="modal-body">Are you sure you want to delete this item?</div>
				<div class="modal-footer">
					<button class="btn btn-secondary" @onclick="() => _showDeleteModal = false">Cancel</button>
					<button class="btn btn-danger" @onclick="ExecuteDelete">Delete</button>
				</div>
			</div>
		</div>
	</div>
}

@code {
	[SupplyParameterFromQuery(Name = "dealerId")]
	public int? DealerId { get; set; }

	private DealerReg _dealer = new();
	private List<Bank> _banks = new();
	private List<DealerAssetBank> _bankAssets = new();
	private List<DealerAssetLand> _landAssets = new();
	private List<DealerAssetBuilding> _buildingAssets = new();
	private List<DealerLoanLiabilities> _loanLiabilities = new();

	private DealerAssetBank _bankForm = new();
	private DealerAssetLand _landForm = new();
	private DealerAssetBuilding _buildingForm = new();
	private DealerLoanLiabilities _loanForm = new();

	private List<LocationItemDto> _states = new();
	private List<LocationItemDto> _districts = new();

	private bool _isBuildingPincodeLookup;
	private string? _buildingPincodeMessage;
	private bool _buildingPincodeSuccess;

	private bool _isSaving;
	private string? _message;
	private bool _isError;

	private bool _showDeleteModal;
	private int _deleteId;
	private string _deleteType = "";

	private decimal AssetsTotal => _bankAssets.Sum(b => b.Value) + _landAssets.Sum(l => l.PropertyValue) + _buildingAssets.Sum(b => b.PropertyValue) + _dealer.AssetValue;
	private decimal LoansTotal => _loanLiabilities.Sum(l => l.LoanValue);
	private decimal NetFinancial => AssetsTotal - LoansTotal;

	protected override async Task OnInitializedAsync()
	{
		Loading.Show();
		try
		{
			await Task.WhenAll(LoadBanks(), LoadStates(), LoadDistricts());

			if (DealerId.HasValue && DealerId.Value > 0)
			{
				await Task.WhenAll(
					LoadDealer(),
					LoadBankAssets(),
					LoadLandAssets(),
					LoadBuildingAssets(),
					LoadLoanLiabilities()
				);
			}
		}
		finally
		{
			Loading.Hide();
		}
	}

	private async Task LoadDealer()
	{
		try
		{
			_dealer = await Http.GetFromJsonAsync<DealerReg>($"api/DealerRegistration/{DealerId}") ?? new();
		}
		catch (Exception ex) { ShowMessage($"Failed to load dealer: {ex.Message}", true); }
	}

	private async Task LoadBanks()
	{
		try { _banks = await Http.GetFromJsonAsync<List<Bank>>("api/Bank") ?? new(); }
		catch (Exception ex) { ShowMessage($"Failed to load banks: {ex.Message}", true); }
	}

	private async Task LoadStates()
	{
		try { _states = await Http.GetFromJsonAsync<List<LocationItemDto>>("api/State/all") ?? new(); }
		catch { }
	}

	private async Task LoadDistricts()
	{
		try { _districts = await Http.GetFromJsonAsync<List<LocationItemDto>>("api/District/all") ?? new(); }
		catch { }
	}

	private async Task LoadBankAssets()
	{
		try
		{
			var all = await Http.GetFromJsonAsync<List<DealerAssetBank>>("api/DealerAssetBank/all") ?? new();
			_bankAssets = all.Where(a => a.DealerId == DealerId!.Value).ToList();
		}
		catch (Exception ex) { ShowMessage($"Failed to load bank assets: {ex.Message}", true); }
	}

