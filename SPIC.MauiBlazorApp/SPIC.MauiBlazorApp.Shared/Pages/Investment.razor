    private async Task<string?> UploadFileToServer(int dealerId, string docType, IBrowserFile file)
    {
        try
        {
            using var content = new MultipartFormDataContent();
            var stream = file.OpenReadStream(10 * 1024 * 1024);
            content.Add(new StreamContent(stream), "file", file.Name);
            var response = await Http.PostAsync($"api/DealerFile/upload/{dealerId}/{docType}", content);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<FileUploadResponse>();
                return result?.FilePath;
            }
            else
            {
                ShowMessage($"Upload failed: {await response.Content.ReadAsStringAsync()}", true);
            }
        }
        catch (Exception ex)
        {
            ShowMessage($"Upload error: {ex.Message}", true);
        }
        return null;
    }

    private bool _showDocDeleteModal = false;
    private string _docDeleteDisplayName = "";
    private string _docDeleteFileName = "";
    private Func<Task>? _docDeleteAction;

    private void OpenDocDeleteModal(string displayName, string filePath, Func<Task> onConfirm)
    {
        if (string.IsNullOrEmpty(filePath)) return;
        _docDeleteDisplayName = displayName;
        _docDeleteFileName = GetFileName(filePath);
        _docDeleteAction = onConfirm;
        _showDocDeleteModal = true;
    }

    private void CancelDocDelete()
    {
        _showDocDeleteModal = false;
        _docDeleteAction = null;
        _docDeleteDisplayName = "";
        _docDeleteFileName = "";
    }

    private async Task ConfirmDocDelete()
    {
        try
        {
            if (_docDeleteAction != null)
                await _docDeleteAction.Invoke();
            ShowMessage($"{_docDeleteDisplayName} deleted successfully", false);
        }
        catch (Exception ex)
        {
            ShowMessage($"Failed to delete: {ex.Message}", true);
        }
        finally
        {
            CancelDocDelete();
        }
    }

    private async Task DeleteFileFromServer(string filePath)
    {
        if (string.IsNullOrEmpty(filePath) || !filePath.Contains("/")) return;
        try
        {
            await Http.DeleteAsync($"api/DealerFile/delete?filePath={Uri.EscapeDataString(filePath)}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to delete file from server: {ex.Message}");
        }
    }

