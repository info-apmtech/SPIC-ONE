@page "/Investment" 

    <style>
        

        /* --- Financial Position Footer --- */
.financial-footer {
    background: linear-gradient(90deg, #dbeafe38, #dbeafe 100%);
    border-radius: 12px;
    padding: 24px;
    margin-top: 30px;
    border: 1px solid #E0E7FF;
}

.fin-top-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

.fin-title { 
    font-size: 1.1rem; 
    font-weight: 700; 
    color: #1F2937; 
    display: flex; 
    align-items: center; 
    gap: 10px;
}

/* White Pill for Calculation */
.fin-calc-pill { 
    background-color: #ffffff;
    border-radius: 8px;
    padding: 10px 16px;
    font-size: 0.8rem; 
    color: #4B5563; 
    font-weight: 500; 
    box-shadow: 0 1px 2px rgba(0,0,0,0.02);
}
.fin-calc-pill strong {
    color: #1F2937;
    font-weight: 700;
    margin-left: 8px;
}

/* Hollow Green Badge */
.badge-outline-green { 
    background-color: transparent; 
    color: #059669; 
    border: 1px solid #059669;
    font-size: 0.85rem; 
    font-weight: 600; 
    padding: 9px 16px; 
    border-radius: 6px; 
    display: flex;
    align-items: center;
    gap: 8px;
}

/* 4 Grid Cards */
.fin-pill-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
}

.fin-card-white {
    background-color: #ffffff;
    border-radius: 10px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    box-shadow: 0 1px 2px rgba(0,0,0,0.02);
}

.fin-card-header {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.75rem;
    color: #6B7280;
    font-weight: 500;
}

.fin-icon-bg {
    width: 28px;
    height: 28px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
}

.fin-card-val {
    font-size: 1.1rem;
    font-weight: 700;
}

/* Themes for the Icons and Text */
.fin-pink .fin-icon-bg { background-color: #FCE7F3; color: #EC4899; }
.fin-pink .fin-card-val { color: #EC4899; }

.fin-green .fin-icon-bg { background-color: #ECFDF5; color: #10B981; }
.fin-green .fin-card-val { color: #10B981; }

.fin-yellow .fin-icon-bg { background-color: #FEF3C7; color: #F59E0B; }
.fin-yellow .fin-card-val { color: #F59E0B; }

.fin-blue .fin-icon-bg { background-color: #EFF6FF; color: #3B82F6; }
.fin-blue .fin-card-val { color: #3B82F6; }


        /* --- Loan Liabilities Section Styling --- */

/* The bordered box surrounding the list of loans */
.loan-list-container {
    border: 1px solid #E5E7EB;
    border-radius: 12px;
    padding: 20px;
    background-color: #ffffff;
}

/* The white card for each loan */
.loan-card-white {
    background-color: #ffffff;
    border: 1px solid #E5E7EB;
    border-radius: 12px;
    padding: 16px;
    height: 100%;
    box-shadow: 0 1px 2px rgba(0,0,0,0.02);
}

.loan-header { 
    display: flex; 
    justify-content: space-between; 
    margin-bottom: 16px; 
    align-items: center;
}

.loan-bank-name { 
    font-weight: 700; 
    font-size: 0.95rem; 
    color: #1F2937; 
    display: flex; 
    align-items: center; 
    gap: 8px;
}

.loan-bank-name i { 
    color: #10B981; /* Green bank icon */
}

/* The soft green stacked boxes inside the card */
.loan-detail-box {
    background-color: #DCFCE7; /* Soft Green */
    border-radius: 6px;
    padding: 10px 12px;
    margin-bottom: 8px;
}
.loan-detail-box:last-child {
    margin-bottom: 0;
}

.loan-detail-box .asset-lbl {
    font-size: 0.65rem;
    color: #6B7280;
    margin-bottom: 2px;
}
.loan-detail-box .asset-val {
    font-size: 0.9rem;
    font-weight: 700;
    color: #1F2937;
}

/* Top Right Pill specific to this section */
.pill-light-blue {
    background-color: #F0F9FF;
    border-color: #E0F2FE;
    color: #1E3A8A;
}

        /* --- Page Typography --- */
        .page-title {
            color: #374151;
            font-weight: 700;
            font-size: 1.4rem;
            margin-bottom: 24px;
        }

        /* --- Main Sections --- */
        .main-section {
            background: #ffffff;
