@code {
    [SupplyParameterFromQuery(Name = "dealerId")]
    public int? DealerId { get; set; }
    [SupplyParameterFromQuery(Name = "mode")]
    public string? Mode { get; set; }
    [SupplyParameterFromQuery(Name = "flow")]
    public string? Flow { get; set; }

    private bool IsViewOnly => string.Equals(Mode, "view", StringComparison.OrdinalIgnoreCase);
    private DealerReg _dealer = new();
    private List<Bank> _banks = new();
    private List<DealerAssetBank> _bankAssets = new();
    private List<DealerAssetLand> _landAssets = new();
    private List<DealerAssetBuilding> _buildingAssets = new();
    private List<DealerLoanLiabilities> _loanLiabilities = new();

    private DealerAssetBank _bankForm = new();
    private DealerAssetLand _landForm = new();
    private DealerAssetBuilding _buildingForm = new();
    private DealerLoanLiabilities _loanForm = new();

    private List<LocationItemDto> _states = new();
    private List<LocationItemDto> _districts = new();

    private string _bankSearchText = "";
    private bool _showBankDropdown;
    private string _stateSearchText = "";
    private bool _showStateDropdown;
    private string _districtSearchText = "";
    private bool _showDistrictDropdown;

    private bool _isBuildingPincodeLookup;
    private string? _buildingPincodeMessage;
    private bool _buildingPincodeSuccess;

    private bool _isSaving;
    private string? _message;
    private bool _isError;

    private bool _showDeleteModal;
    private int _deleteId;
    private string _deleteType = "";

    private decimal AssetsTotal => _bankAssets.Sum(b => b.Value) + _landAssets.Sum(l => l.PropertyValue) + _buildingAssets.Sum(b => b.PropertyValue) + _dealer.AssetValue;
    private decimal LoansTotal => _loanLiabilities.Sum(l => l.LoanValue);
    private decimal NetFinancial => AssetsTotal - LoansTotal;

    protected override async Task OnInitializedAsync()
    {
        Loading.Show();
        try
        {
            var tasks = new List<Task> { LoadBanks(), LoadStates(), LoadDistricts() };

            if (DealerId.HasValue && DealerId.Value > 0)
            {
                tasks.Add(LoadDealer());
                tasks.Add(LoadBankAssets());
                tasks.Add(LoadLandAssets());
                tasks.Add(LoadBuildingAssets());
                tasks.Add(LoadLoanLiabilities());
            }

            await Task.WhenAll(tasks);
        }
        finally
        {
            Loading.Hide();
        }
    }

    private async Task LoadDealer()
    {
        try { _dealer = await Http.GetFromJsonAsync<DealerReg>($"api/DealerRegistration/{DealerId}") ?? new(); }
        catch (Exception ex) { ShowMessage($"Failed to load dealer: {ex.Message}", true); }
    }

    private async Task LoadBanks()
    {
        try { _banks = await Http.GetFromJsonAsync<List<Bank>>("api/Bank") ?? new(); }
        catch (Exception ex) { ShowMessage($"Failed to load banks: {ex.Message}", true); }
    }

    private async Task LoadStates()
    {
        try { _states = await Http.GetFromJsonAsync<List<LocationItemDto>>("api/State/all") ?? new(); }
        catch { }
    }

    private async Task LoadDistricts()
    {
        try { _districts = await Http.GetFromJsonAsync<List<LocationItemDto>>("api/District/all") ?? new(); }
        catch { }
    }

    private async Task LoadBankAssets()
    {
        try
        {
            _bankAssets = await Http.GetFromJsonAsync<List<DealerAssetBank>>(
                $"api/DealerAssetBank/byDealer/{DealerId!.Value}") ?? new();
        }
        catch (Exception ex) { ShowMessage($"Failed to load bank assets: {ex.Message}", true); }
    }

    private async Task LoadLandAssets()
    {
        try
        {
            _landAssets = await Http.GetFromJsonAsync<List<DealerAssetLand>>(
                $"api/DealerAssetLand/byDealer/{DealerId!.Value}") ?? new();
        }
        catch (Exception ex) { ShowMessage($"Failed to load land assets: {ex.Message}", true); }
    }

    private async Task LoadBuildingAssets()
    {
        try
        {
            _buildingAssets = await Http.GetFromJsonAsync<List<DealerAssetBuilding>>(
                $"api/DealerAssetBuilding/byDealer/{DealerId!.Value}") ?? new();
        }
        catch (Exception ex) { ShowMessage($"Failed to load building assets: {ex.Message}", true); }
    }

    private async Task LoadLoanLiabilities()
    {
        try
        {
            _loanLiabilities = await Http.GetFromJsonAsync<List<DealerLoanLiabilities>>(
                $"api/DealerLoanLiabilities/byDealer/{DealerId!.Value}") ?? new();
        }
        catch (Exception ex) { ShowMessage($"Failed to load loans: {ex.Message}", true); }
    }

    private async Task SaveBankAsset()
    {
        _bankForm.DealerId = DealerId ?? 0;
        if (_bankForm.Id > 0)
        {
            await Http.PutAsJsonAsync($"api/DealerAssetBank/{_bankForm.Id}", _bankForm);
            var idx = _bankAssets.FindIndex(b => b.Id == _bankForm.Id);
            if (idx >= 0) _bankAssets[idx] = _bankForm;
        }
        else
        {
            var resp = await Http.PostAsJsonAsync("api/DealerAssetBank", _bankForm);
            if (resp.IsSuccessStatusCode)
            {
                var result = await resp.Content.ReadFromJsonAsync<CreateResponse<DealerAssetBank>>();
                if (result?.Data != null) { _bankForm.Id = result.Data.Id; _bankAssets.Add(_bankForm); }
            }
        }
        _bankForm = new();
        _bankSearchText = "";
    }

    private void EditBankAsset(DealerAssetBank item)
    {
        _bankForm = new DealerAssetBank
        {
            Id = item.Id,
            DealerId = item.DealerId,
            BankId = item.BankId,
            BankBranch = item.BankBranch,
            Value = item.Value,
            Remarks = item.Remarks
        };
        _bankSearchText = _banks.FirstOrDefault(b => b.Id == item.BankId)?.Name ?? "";
    }

    private async Task SaveLandAsset()
    {
        _landForm.DealerId = DealerId ?? 0;
        if (_landForm.Id > 0)
        {
            await Http.PutAsJsonAsync($"api/DealerAssetLand/{_landForm.Id}", _landForm);
            var idx = _landAssets.FindIndex(l => l.Id == _landForm.Id);
            if (idx >= 0) _landAssets[idx] = _landForm;
        }
        else
        {
            var resp = await Http.PostAsJsonAsync("api/DealerAssetLand", _landForm);
            if (resp.IsSuccessStatusCode)
            {
                var result = await resp.Content.ReadFromJsonAsync<CreateResponse<DealerAssetLand>>();
                if (result?.Data != null) { _landForm.Id = result.Data.Id; _landAssets.Add(_landForm); }
            }
        }
        _landForm = new();
    }

    private void EditLandAsset(DealerAssetLand item)
    {
        _landForm = new DealerAssetLand
        {
            Id = item.Id,
            DealerId = item.DealerId,
            LandName = item.LandName,
            SurvayNumber = item.SurvayNumber,
            LandSize = item.LandSize,
            PropertyValue = item.PropertyValue,
            UploadedECDocumentPath = item.UploadedECDocumentPath,
            UploadedLandDocumentPath = item.UploadedLandDocumentPath,
            UploadedValuationCertificatePath = item.UploadedValuationCertificatePath
        };
    }

    private async Task SaveBuildingAsset()
    {
        _buildingForm.DealerId = DealerId ?? 0;
        if (_buildingForm.Id > 0)
        {
            await Http.PutAsJsonAsync($"api/DealerAssetBuilding/{_buildingForm.Id}", _buildingForm);
            var idx = _buildingAssets.FindIndex(b => b.Id == _buildingForm.Id);
            if (idx >= 0) _buildingAssets[idx] = _buildingForm;
        }
        else
        {
            var resp = await Http.PostAsJsonAsync("api/DealerAssetBuilding", _buildingForm);
            if (resp.IsSuccessStatusCode)
            {
                var result = await resp.Content.ReadFromJsonAsync<CreateResponse<DealerAssetBuilding>>();
                if (result?.Data != null) { _buildingForm.Id = result.Data.Id; _buildingAssets.Add(_buildingForm); }
            }
        }
        _buildingForm = new();
        _stateSearchText = "";
        _districtSearchText = "";
    }

    private void EditBuildingAsset(DealerAssetBuilding item)
    {
        _buildingForm = new DealerAssetBuilding
        {
            Id = item.Id,
            DealerId = item.DealerId,
            BuildingName = item.BuildingName,
            PropertyValue = item.PropertyValue,
            SurveyNumber = item.SurveyNumber,
            LandSize = item.LandSize,
            Remarks = item.Remarks,
            ShopNoORRoomNoOrBlockNo = item.ShopNoORRoomNoOrBlockNo,
            Street = item.Street,
            SubVillage = item.SubVillage,
            Village = item.Village,
            PinCode = item.PinCode,
            Block = item.Block,
            Taluk = item.Taluk,
            DistrictId = item.DistrictId,
            StateId = item.StateId,
            UploadedECDocumentPath = item.UploadedECDocumentPath,
            UploadedBuildingDocumentPath = item.UploadedBuildingDocumentPath,
            UploadedValuationCertificatePath = item.UploadedValuationCertificatePath
        };
        _stateSearchText = _states.FirstOrDefault(s => s.Id == item.StateId)?.StateName ?? "";
        _districtSearchText = _districts.FirstOrDefault(d => d.Id == item.DistrictId)?.DistrictName ?? "";
    }

    private async Task SaveLoan()
    {
        _loanForm.DealerId = DealerId ?? 0;
        if (_loanForm.Id > 0)
        {
            await Http.PutAsJsonAsync($"api/DealerLoanLiabilities/{_loanForm.Id}", _loanForm);
            var idx = _loanLiabilities.FindIndex(l => l.Id == _loanForm.Id);
            if (idx >= 0) _loanLiabilities[idx] = _loanForm;
        }
        else
        {
            var resp = await Http.PostAsJsonAsync("api/DealerLoanLiabilities", _loanForm);
            if (resp.IsSuccessStatusCode)
            {
                var result = await resp.Content.ReadFromJsonAsync<CreateResponse<DealerLoanLiabilities>>();
                if (result?.Data != null) { _loanForm.Id = result.Data.Id; _loanLiabilities.Add(_loanForm); }
            }
        }
        _loanForm = new();
    }

    private void EditLoan(DealerLoanLiabilities item)
    {
        _loanForm = new DealerLoanLiabilities
        {
            Id = item.Id,
            DealerId = item.DealerId,
            LoanSource = item.LoanSource,
            LoanValue = item.LoanValue,
            Remarks = item.Remarks
        };
    }

    private void ConfirmDelete(int id, string type)
    {
        _deleteId = id;
        _deleteType = type;
        _showDeleteModal = true;
    }

    private async Task ExecuteDelete()
    {
        _showDeleteModal = false;
        try
        {
            switch (_deleteType)
            {
                case "bank":
                    await Http.DeleteAsync($"api/DealerAssetBank/{_deleteId}");
                    _bankAssets.RemoveAll(b => b.Id == _deleteId);
                    break;
                case "land":
                    await Http.DeleteAsync($"api/DealerAssetLand/{_deleteId}");
                    _landAssets.RemoveAll(l => l.Id == _deleteId);
                    break;
                case "building":
                    await Http.DeleteAsync($"api/DealerAssetBuilding/{_deleteId}");
                    _buildingAssets.RemoveAll(b => b.Id == _deleteId);
                    break;
                case "loan":
                    await Http.DeleteAsync($"api/DealerLoanLiabilities/{_deleteId}");
                    _loanLiabilities.RemoveAll(l => l.Id == _deleteId);
                    break;
            }
        }
        catch (Exception ex) { ShowMessage($"Failed to delete: {ex.Message}", true); }
    }

    private async Task HandleNext()
    {
        if (IsViewOnly)
        {
            Loading.Show();
            var viewNext = string.Equals(Flow, "restricted", StringComparison.OrdinalIgnoreCase) ? "/Dashboard" : "/CreditLimit";
            Nav.NavigateTo($"{viewNext}?dealerId={DealerId}&mode=view");
            return;
        }
        if (!DealerId.HasValue || DealerId.Value <= 0)
        {
            ShowMessage("Dealer ID is required.", true);
            return;
        }

        _isSaving = true;
        try
        {
            var response = await Http.PutAsJsonAsync($"api/DealerRegistration/{DealerId}", _dealer);
            response.EnsureSuccessStatusCode();
            FormStepData.MarkStepError(9, false);
            if (string.Equals(Flow, "restricted", StringComparison.OrdinalIgnoreCase))
                Nav.NavigateTo($"/Dashboard?dealerId={DealerId}");
            else
                Nav.NavigateTo($"/CreditLimit?dealerId={DealerId}");
        }
        catch (Exception ex)
        {
            ShowMessage($"Failed to save: {ex.Message}", true);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void SelectBank(int id, string displayText)
    {
        _bankSearchText = displayText;
        _showBankDropdown = false;
        _bankForm.BankId = id;
    }

    private void SelectState(int id, string displayText)
    {
        _stateSearchText = displayText;
        _showStateDropdown = false;
        _buildingForm.StateId = id;
        _districtSearchText = "";
        OnBuildingStateChanged();
    }

    private void SelectDistrict(int id, string displayText)
    {
        _districtSearchText = displayText;
        _showDistrictDropdown = false;
        _buildingForm.DistrictId = id;
    }

    private async Task HideBankDropdown() { await Task.Delay(200); _showBankDropdown = false; StateHasChanged(); }
    private async Task HideStateDropdown() { await Task.Delay(200); _showStateDropdown = false; StateHasChanged(); }
    private async Task HideDistrictDropdown() { await Task.Delay(200); _showDistrictDropdown = false; StateHasChanged(); }

    private void ShowMessage(string message, bool isError)
    {
        _message = message;
        _isError = isError;
    }

  private async Task OnBuildingPincodeChanged()
{
    _buildingPincodeMessage = null;
    _buildingPincodeSuccess = false;

    // Strip non-digit characters
    if (!string.IsNullOrEmpty(_buildingForm.PinCode))
    {
        var digitsOnly = new string(_buildingForm.PinCode.Where(char.IsDigit).ToArray());
        if (digitsOnly != _buildingForm.PinCode)
            _buildingForm.PinCode = digitsOnly;
    }

    if (string.IsNullOrWhiteSpace(_buildingForm.PinCode) || _buildingForm.PinCode.Length != 6)
        return;

    _isBuildingPincodeLookup = true;
    StateHasChanged();

    try
    {
        using var response = await Http.GetAsync($"api/PincodeLookup/{_buildingForm.PinCode}");

        if (!response.IsSuccessStatusCode)
        {
            var body = await response.Content.ReadAsStringAsync();
            _buildingPincodeMessage = $"Lookup failed (HTTP {(int)response.StatusCode}): {body}";
            return;
        }

        var results = await response.Content.ReadFromJsonAsync<List<PincodeApiResponse>>();
        var result = results?.FirstOrDefault();

        if (result == null
            || !string.Equals(result.Status, "Success", StringComparison.OrdinalIgnoreCase)
            || result.PostOffice == null
            || result.PostOffice.Count == 0)
        {
            _buildingPincodeMessage = $"No data found for pincode {_buildingForm.PinCode}";
            return;
        }

        var po = result.PostOffice[0];

        var apiDistrict = po.District?.Trim().Replace(" ", "") ?? "";
        var matchedDistrict = _districts.FirstOrDefault(d =>
            d.DistrictName.Trim().Replace(" ", "").Equals(apiDistrict, StringComparison.OrdinalIgnoreCase));
        if (matchedDistrict != null)
        {
            _buildingForm.DistrictId = matchedDistrict.Id;
            _districtSearchText = matchedDistrict.DistrictName;
        }

        var apiState = po.State?.Trim().Replace(" ", "") ?? "";
        var matchedState = _states.FirstOrDefault(s =>
            s.StateName.Trim().Replace(" ", "").Equals(apiState, StringComparison.OrdinalIgnoreCase));
        if (matchedState != null)
        {
            _buildingForm.StateId = matchedState.Id;
            _stateSearchText = matchedState.StateName;
        }

        if (!string.IsNullOrWhiteSpace(po.Block) && po.Block != "NA")
            _buildingForm.Block = po.Block;
        if (!string.IsNullOrWhiteSpace(po.Division)) _buildingForm.Taluk = po.Division;
        if (!string.IsNullOrWhiteSpace(po.Name)) _buildingForm.Village = po.Name;

        _buildingPincodeSuccess = true;
        _buildingPincodeMessage = $"Auto-filled: {po.District}, {po.State}";
    }
    catch (HttpRequestException httpEx)
    {
        _buildingPincodeMessage = $"Network error: {httpEx.Message}";
    }
    catch (TaskCanceledException)
    {
        _buildingPincodeMessage = "Lookup timed out — try again.";
    }
    catch (Exception ex)
    {
        _buildingPincodeMessage = $"{ex.GetType().Name}: {ex.Message}";
    }
    finally
    {
        _isBuildingPincodeLookup = false;
    }
}

