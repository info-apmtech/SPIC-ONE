@page "/Investment" 

<div class="container-fluid py-4 px-0">
	<FormLoader />
	<div class="company-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
		<h3 class="fw-bold m-0 company-title">Investment</h3>
	</div>

	<div class="main-section">
		<div class="section-header">
			<h3 class="section-title">
				<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/Captial.svg" style="width: 24px;" />
				Capital Investment
			</h3>
			<div class="val-pill">Total Capital Value <span>₹0</span></div>
		</div>
            
		<div class="row g-3 mb-3">
			<div class="col-md-6">
				<label class="custom-label">Capital Investment (₹)</label>
				<input type="text" class="custom-input" placeholder="₹ 0.00">
			</div>
			<div class="col-md-6">
				<label class="custom-label">Cash Credit Limit (₹)</label>
				<input type="text" class="custom-input" placeholder="₹ 0.00">
			</div>
		</div>
		<div class="row g-3">
			<div class="col-md-6">
				<input type="text" class="custom-input" placeholder="Remarks">
			</div>
			<div class="col-md-6">
				<input type="text" class="custom-input" placeholder="Remarks">
			</div>
		</div>
	</div>

	<div class="main-section">
		<div class="section-header">
			<h3 class="section-title">
				<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/Banking.svg" style="width: 24px;" />
				Assets (Banking & Properties)
			</h3>
			<div class="d-flex gap-3">
				<div class="val-pill">Assets Added <span>1</span></div>
				<div class="val-pill">Total Capital Value <span>₹0</span></div>
			</div>
		</div>

		<div class="row g-4 mb-4">
                
			<div class="col-md-6">
				<div class="sub-card">
					<div class="sub-card-title"><i class="bi bi-bank icon-blue"></i> Banking</div>
					<div class="row g-3 mb-3">
						<div class="col-6">
							<label class="custom-label">Bank Name</label>
							<select class="custom-select"><option>Select Bank Name</option></select>
						</div>
						<div class="col-6">
							<label class="custom-label">Bank Branch</label>
							<select class="custom-select"><option>Select Bank Branch</option></select>
						</div>
					</div>
					<div class="row g-3 mb-4">
						<div class="col-6">
							<label class="custom-label">Value (₹)</label>
							<input type="text" class="custom-input" placeholder="0.0">
						</div>
						<div class="col-6">
							<label class="custom-label">Remarks</label>
							<input type="text" class="custom-input" placeholder="">
						</div>
					</div>
					<div class="mt-auto">
						<button class="btn-upload-dashed mb-3">
							<i class="bi bi-upload"></i> <label class="btn-upload-attach mb-0">
							PDF File Upload
							<input type="file" hidden @onchange="HandlePdfUpload" />
						</label>
					</button>
					<button class="btn-blue-action"><i class="bi bi-plus"></i> Add Banking</button>
				</div>
			</div>
		</div>

		<div class="col-md-6">
			<div class="sub-card">
				<div class="sub-card-title">
                            
					<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/Land.svg" style="width: 24px;"/>
                            
					Land
				</div>
				<div class="row g-3 mb-3">
					<div class="col-6">
						<label class="custom-label">Land Name</label>
						<input type="text" class="custom-input" placeholder="Enter Land Name">
					</div>
					<div class="col-6">
						<label class="custom-label">Survey Number</label>
						<input type="text" class="custom-input" placeholder="Enter ID/Cent">
					</div>
				</div>
				<div class="row g-3 mb-4">
					<div class="col-6">
						<label class="custom-label">Land Size (In Cent)</label>
						<input type="text" class="custom-input" placeholder="Enter In Cent">
					</div>
					<div class="col-6">
						<label class="custom-label">Property Value (₹) (In Lakhs)</label>
						<input type="text" class="custom-input" placeholder="Enter Value">
					</div>
				</div>
				<div class="mt-auto">
					<div class="row g-2 mb-3">
						<div class="col-6">
							<button class="btn-upload-dashed">
								<i class="bi bi-upload"></i> <label class="btn-upload-attach mb-0">
								Upload Land Document
								<input type="file" hidden @onchange="HandleLandDocumentUpload" />
							</label>
						</button>
					</div>
					<div class="col-6">
						<button class="btn-upload-dashed">
							<i class="bi bi-upload"></i> <label class="btn-upload-attach mb-0">
							Upload EC Document
							<input type="file" hidden @onchange="HandleECDocumentUpload" />
						</label>
					</button>
				</div>
			</div>
			<button class="btn-blue-action"><i class="bi bi-plus"></i> Add Land</button>
		</div>
	</div>
</div>
</div>

<div class="sub-card mb-4">
	<div class="sub-card-title">
		<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/Home.svg" />
                    
		Building
	</div>
	<div class="row g-3 mb-3">
		<div class="col-md-4">
			<label class="custom-label">Building Name</label>
			<input type="text" class="custom-input" placeholder="Enter Building Name">
		</div>
		<div class="col-md-4">
			<label class="custom-label">Property Value (₹)</label>
			<input type="number" class="custom-input" placeholder="Enter Value">
		</div>
		<div class="col-md-4">
			<label class="custom-label">Survey Number</label>
			<input type="number" class="custom-input" placeholder="Enter ID/Cent">
		</div>
	</div>
	<div class="row g-3 mb-4">
		<div class="col-md-6">
			<label class="custom-label">Land Size (In Square Fit)</label>
			<input type="number" class="custom-input" placeholder="Enter In Square Fit">
		</div>
		<div class="col-md-6">
			<label class="custom-label">Remarks</label>
			<input type="text" class="custom-input" placeholder="">
		</div>
	</div>
	<div class="row g-3">
		<div class="col-md-4">
			<button class="btn-upload-dashed">
				<i class="bi bi-upload"></i><label class="btn-upload-attach mb-0">
				Upload Building Document
				<input type="file" hidden @onchange="HandleBuildingDocumentUpload" />
			</label>
		</button>
	</div>
	<div class="col-md-4">
		<button class="btn-upload-dashed">
			<i class="bi bi-upload"></i> <label class="btn-upload-attach mb-0">
			Upload EC Document
			<input type="file" hidden @onchange="HandleECDocumentUpload" />
		</label>
	</button>
</div>
<div class="col-md-4"><button class="btn-blue-action w-100"><i class="bi bi-plus"></i> Add Building</button></div>
</div>
</div>

<h4 class="list-header">Your Added Assets</h4>
            
<div class="asset-row">
	<div class="asset-icon" style="color: #3B82F6; background: #EFF6FF;"><i class="bi bi-bank"></i></div>
	<div class="asset-detail"><div class="asset-lbl">Bank Name</div><div class="asset-val">State Bank</div></div>
	<div class="asset-detail"><div class="asset-lbl">Bank Branch</div><div class="asset-val">Saidapet</div></div>
	<div class="asset-detail"><div class="asset-lbl">Monthly Transaction (₹)</div><div class="asset-val">₹ 1200000</div></div>
	<div class="asset-detail"><div class="asset-lbl">PDF File</div><div class="asset-val" style="color:#059669;">Uploaded</div></div>
	<div class="asset-detail"><div class="asset-lbl">Remarks</div><div class="asset-val text-muted">Remarks...</div></div>
	<div class="asset-actions">
		<i class="bi bi-pencil-square edit"></i>
		<i class="bi bi-trash delete"></i>
	</div>
</div>

<div class="asset-row">
	<div class="asset-icon" style="color: #EC4899; background: #FCE7F3;"><i class="bi bi-building"></i></div>
	<div class="asset-detail"><div class="asset-lbl">Building Name</div><div class="asset-val">Avanti Gardens</div></div>
	<div class="asset-detail"><div class="asset-lbl">Property Value (₹)</div><div class="asset-val">1200000</div></div>
	<div class="asset-detail"><div class="asset-lbl">Land Size</div><div class="asset-val">230 Sq Ft</div></div>
	<div class="asset-detail"><div class="asset-lbl">EC File</div><div class="asset-val" style="color:#059669;">Uploaded</div></div>
	<div class="asset-detail"><div class="asset-lbl">PDF File</div><div class="asset-val" style="color:#059669;">Uploaded</div></div>
	<div class="asset-detail"><div class="asset-lbl">Remarks</div><div class="asset-val text-muted">Remarks...</div></div>
	<div class="asset-actions">
		<i class="bi bi-pencil-square edit"></i>
		<i class="bi bi-trash delete"></i>
	</div>
</div>
</div>

<div class="main-section">
	<div class="section-header border-0 mb-0 pb-0">
		<h3 class="section-title">
			<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/Home2.svg" style="width: 24px;" />
			Movable
		</h3>
	</div>
	<div class="row g-3 mt-1">
		<div class="col-md-6">
			<label class="custom-label">Movable Assets Value (₹)</label>
			<input type="number" class="custom-input" placeholder="Enter Value">
		</div>
		<div class="col-md-6">
			<label class="custom-label">Remarks</label>
			<input type="text" class="custom-input" placeholder="">
		</div>
	</div>
</div>

<div class="main-section">
	<div class="section-header border-0 mb-0 pb-0">
		<h3 class="section-title"><i class="bi bi-diagram-3"></i> Infrastructure</h3>
	</div>
	<div class="row g-4 mt-1">
		<div class="col-md-6">
			<div class="sub-card">
				<div class="sub-card-title">
					<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/OwnCapacity.svg" style="width: 24px;"/>

					Own Godown Capacity
				</div>
				<label class="custom-label">MT</label>
				<input type="number" class="custom-input" placeholder="Enter The Value">
			</div>
		</div>
		<div class="col-md-6">
			<div class="sub-card">
				<div class="sub-card-title">
					<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/OwnCapacity.svg" style="width: 24px;" />
					Rent Godown Capacity
				</div>
				<label class="custom-label">MT</label>
				<input type="number" class="custom-input" placeholder="Enter The Value">
