<div class="financial-footer">
	<div class="fin-top-row">
		<div class="fin-title">
			<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/HomeLoan.svg" style="width: 24px;" />


			Net Financial Position
		</div>
		<div class="d-flex align-items-center gap-3">
			<div class="fin-calc-pill">
				Calculation: (Capital + Assets) - Loans <strong>(₹0 + ₹324) - ₹0 = ₹324</strong>
			</div>
			<div class="badge-outline-green">
				<i class="bi bi-check2"></i> Positive Financial Position
			</div>
		</div>
	</div>

	<div class="fin-pill-grid">
		<div class="fin-card-white fin-pink">
			<div class="fin-card-header">
				<div class="fin-icon-bg"><i class="bi bi-shield-check"></i></div>
				Capital Position
			</div>
			<div class="fin-card-val">₹ 0</div>
		</div>

		<div class="fin-card-white fin-green">
			<div class="fin-card-header">
				<div class="fin-icon-bg"><i class="bi bi-bank"></i></div>
				Banking & Property Assets
			</div>
			<div class="fin-card-val">₹ 324</div>
		</div>

		<div class="fin-card-white fin-yellow">
			<div class="fin-card-header">
				<div class="fin-icon-bg"><i class="bi bi-cash-stack"></i></div>
				Loan Liabilities
			</div>
			<div class="fin-card-val">₹ 0</div>
		</div>

		<div class="fin-card-white fin-blue">
			<div class="fin-card-header">
				<div class="fin-icon-bg"><i class="bi bi-snow"></i></div>
				Net Financial Value
			</div>
			<div class="fin-card-val">₹ 324</div>
		</div>
	</div>
</div>
<CommanFooter />
</div>

@code {
	private async Task HandlePdfUpload(ChangeEventArgs e)
	{
		var file = (e.Value as Microsoft.AspNetCore.Components.Forms.IBrowserFile);
		if (file != null)
		{
			Console.WriteLine($"Pdf file selected: {file.Name}");
		}
	}
	private async Task HandleLandDocumentUpload(ChangeEventArgs e)
	{
		var file = (e.Value as Microsoft.AspNetCore.Components.Forms.IBrowserFile);
		if (file != null)
		{
			Console.WriteLine($"Land file selected: {file.Name}");
		}
	}
	private async Task HandleECDocumentUpload(ChangeEventArgs e)
	{
		var file = (e.Value as Microsoft.AspNetCore.Components.Forms.IBrowserFile);
		if (file != null)
		{
			Console.WriteLine($"EC file selected: {file.Name}");
		}
	}
	private async Task HandleBuildingDocumentUpload(ChangeEventArgs e)
	{
		var file = (e.Value as Microsoft.AspNetCore.Components.Forms.IBrowserFile);
		if (file != null)
		{
			Console.WriteLine($"EC file selected: {file.Name}");
		}
	}
}
