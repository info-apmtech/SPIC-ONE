@page "/GpsSettings"

@using System.Net.Http.Json
@using SPIC.Core.DTOs
@using SPIC.Core.Entities
@inject HttpClient Http
@inject NavigationManager Nav
@inject SPIC.MauiBlazorApp.Shared.Services.LoginState LoginState

<div class="container-fluid mf-page">

    <PageHeader Title="GPS Settings" />

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert @(_isError ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
            <i class="bi @(_isError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") me-2"></i>
            @_message
            <button type="button" class="btn-close" @onclick="() => _message = null" aria-label="Close"></button>
        </div>
    }

    <!-- ============================================================ -->
    <!-- SETTINGS CARD -->
    <!-- ============================================================ -->
    <div class="main-card mf-form-card shadow-sm p-4 mb-4">

        <div class="section-header pb-2 mb-4 border-bottom">
            <h3 class="section-title mb-1">
                <i class="bi bi-geo-alt-fill text-primary me-2"></i>
                Configure Tracking Interval
            </h3>
            <p class="text-muted small mb-0">
                Configure the frequency at which the JMDO mobile app records GPS coordinates during active live tracking sessions.
            </p>
        </div>

        @if (_isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading settings...</span>
                </div>
                <div class="text-muted mt-2">Loading current GPS settings...</div>
            </div>
        }
        else
        {
            <!-- Current Status Indicator -->
            <div class="row mb-4">
                <div class="col-md-6 col-lg-4">
                    <div class="p-3 bg-light rounded-3 border d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small d-block">Current Saved Interval</span>
                            <span class="fs-4 fw-bold text-primary">@_savedInterval s</span>
                        </div>
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2">
                            <i class="bi bi-broadcast me-1"></i> Active
                        </span>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4">
                    <div class="p-3 bg-light rounded-3 border d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small d-block">System Default</span>
                            <span class="fs-4 fw-bold text-secondary">20 s</span>
                        </div>
                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1 small">
                            Standard
                        </span>
                    </div>
                </div>
                <div class="col-md-12 col-lg-4 mt-3 mt-lg-0">
                    <div class="p-3 bg-light rounded-3 border">
                        <span class="text-muted small d-block">Allowed Range</span>
                        <span class="fs-6 fw-semibold text-dark">1 to 100 seconds</span>
                    </div>
                </div>
            </div>

            <!-- Configuration Controls -->
            <div class="card border-0 bg-light p-4 rounded-3 mb-4">
                <div class="row g-4 align-items-center">

                    <div class="col-12">
                        <label class="form-label fw-bold mb-2 fs-6" for="intervalSlider">
                            Tracking Interval (Seconds)
                        </label>
                        <p class="text-muted small mb-3">
                            Move the slider or enter an exact integer between 1 and 100 seconds.
                        </p>
                    </div>

                    <!-- Synchronized Slider -->
                    <div class="col-md-8">
                        <div class="d-flex align-items-center gap-3">
                            <span class="text-muted small fw-bold">1s</span>
                            <input type="range"
                                   id="intervalSlider"
                                   class="form-range flex-grow-1"
                                   min="1"
                                   max="100"
                                   step="1"
                                   @bind="_intervalInput"
                                   @bind:event="oninput" />
                            <span class="text-muted small fw-bold">100s</span>
                        </div>
                        <div class="d-flex justify-content-between text-muted px-1 mt-1" style="font-size: 0.75rem;">
                            <span>1s (High Frequency)</span>
                            <span>20s (Default)</span>
                            <span>50s</span>
                            <span>100s (Battery Saver)</span>
                        </div>
                    </div>

                    <!-- Synchronized Numeric Input -->
                    <div class="col-md-4">
                        <div class="input-group">
                            <input type="number"
                                   id="intervalNumber"
                                   class="form-control form-control-lg text-center fw-bold"
                                   min="1"
                                   max="100"
                                   step="1"
                                   @bind="_intervalInput"
                                   @bind:event="oninput" />
                            <span class="input-group-text bg-white fw-semibold">seconds</span>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Action Buttons -->
            <div class="d-flex justify-content-end gap-2 pt-2 mf-form-actions">
                <button type="button"
                        class="btn btn-outline-secondary px-4 py-2"
                        @onclick="ResetToDefault"
                        disabled="@_isSaving">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>
                    Reset to Default (20s)
                </button>

                <button type="button"
                        class="btn btn-primary px-4 py-2 fw-semibold"
                        @onclick="HandleSave"
                        disabled="@_isSaving">
                    @if (_isSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>Saving Settings...</span>
                    }
                    else
                    {
                        <i class="bi bi-save me-1"></i>
                        <span>Save Settings</span>
                    }
                </button>
            </div>
        }

    </div>

</div>

@code {
    private const string ApiBase = "api/GpsSetting";
    private const int DefaultInterval = 20;

    private int _savedInterval = DefaultInterval;
    private int _intervalInput = DefaultInterval;
    private bool _isLoading = true;
    private bool _isSaving = false;
    private string? _message;
    private bool _isError;

    protected override async Task OnInitializedAsync()
    {
        // Strict Admin authorization check
        if (LoginState.UserRole != AppRole.Admin && LoginState.UserRole != AppRole.SuperAdmin)
        {
            Nav.NavigateTo(LoginState.LandingPage, replace: true);
            return;
        }

        await LoadSettings();
    }

    private async Task LoadSettings()
    {
        try
        {
            _isLoading = true;
            _message = null;

            var active = await Http.GetFromJsonAsync<GpsSettingDto>($"{ApiBase}/active");
            if (active != null && active.IntervalSeconds is >= 1 and <= 100)
            {
                _savedInterval = active.IntervalSeconds;
                _intervalInput = active.IntervalSeconds;
            }
            else
            {
                _savedInterval = DefaultInterval;
                _intervalInput = DefaultInterval;
            }
        }
        catch (Exception ex)
        {
            ShowMessage($"Could not load GPS settings: {ex.Message}", true);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ResetToDefault()
    {
        _intervalInput = DefaultInterval;
        _message = null;
    }

    private async Task HandleSave()
    {
        if (_intervalInput < 1 || _intervalInput > 100)
        {
            ShowMessage("Tracking interval must be an integer between 1 and 100 seconds.", true);
            return;
        }

        try
        {
            _isSaving = true;
            _message = null;

            var dto = new UpdateGpsSettingDto { IntervalSeconds = _intervalInput };
            var response = await Http.PostAsJsonAsync(ApiBase, dto);

            if (response.IsSuccessStatusCode)
            {
                _savedInterval = _intervalInput;
                ShowMessage($"GPS tracking interval successfully updated to {_savedInterval} seconds.", false);
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                ShowMessage($"Failed to save settings: {error}", true);
            }
        }
        catch (Exception ex)
        {
            ShowMessage($"Error saving settings: {ex.Message}", true);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void ShowMessage(string msg, bool isError)
    {
        _message = msg;
        _isError = isError;
    }
}
