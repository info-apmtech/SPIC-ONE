@page "/ReviewScheme"


<div class="container-fluid py-4 px-0">
    <div class="rev-wrapper">

        <!-- Top Status Banner -->
        <div class="rev-banner">
            <div class="rev-status-left">
                <div class="rev-dot-halo">
                    <div class="rev-dot"></div>
                </div>
                <div class="rev-banner-text">
                    <h2>Review Your Scheme</h2>
                    <p>Please review all details before activating the scheme</p>
                </div>
            </div>
            <!-- Crown/Stadium SVG Icon -->
            <div class="rev-banner-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M2 4h20M4 4v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V4M8 21v-4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v4" />
                    <path d="M12 8v4" />
                    <path d="M10 10h4" />
                </svg>
            </div>
        </div>

        <!-- Scheme Details Card -->
        <div class="rev-card">
            <div class="rev-card-header">
                <div class="rev-header-left">
                    <div class="rev-header-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
                            <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
                            <path d="M9 14h6"></path>
                            <path d="M9 18h6"></path>
                            <path d="M9 10h.01"></path>
                        </svg>
                    </div>
                    <h3>Scheme Details</h3>
                </div>
                
                <div class="rev-badges">
                    <div class="rev-badge-applicable">
                        <div class="rev-badge-label">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                <circle cx="12" cy="7" r="4"></circle>
                            </svg>
                            APPLICABLE FOR:
                        </div>
                        <div class="rev-badge-pill">BOTH</div>
                    </div>
                    <div class="rev-badge-active">ACTIVE DRAFT</div>
                </div>
            </div>

            <div class="rev-title-row">
                <h1>Tamil Newyear Special Scheme</h1>
                <span class="rev-date">Created on April 10, 2026</span>
            </div>
            
            <div class="rev-desc-box">
                <p>A seasonal loyalty incentive programme designed to reward both farmers and dealers who purchase SPIC-recommended fertilizer products during the Kharif season. Participants accumulate points and qualify for the lucky draw to win exciting prizes</p>
            </div>
        </div>

        <!-- Middle Grid (Timeline & Reward) -->
        <div class="rev-middle-grid">
            <!-- Campine Time Line Card -->
            <div class="rev-timeline-card">
                <div class="rev-timeline-header">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                    <h3>Campine Time Line</h3>
                </div>
                    
                <div class="rev-timeline-body">
                    <div class="rev-date-box">
                        <span class="rev-date-label">End Date</span>
                        <span class="rev-date-value">30/04/2026</span>
                    </div>
                        
                    <div class="rev-date-arrow">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="16 3 21 8 16 13"></polyline>
                            <line x1="21" y1="8" x2="9" y2="8"></line>
                            <polyline points="8 21 3 16 8 11"></polyline>
                            <line x1="3" y1="16" x2="15" y2="16"></line>
                        </svg>
                    </div>

                    <div class="rev-date-box">
                        <span class="rev-date-label">Start Date</span>
                        <span class="rev-date-value">14/04/2026</span>
                    </div>
                </div>
            </div>

            <!-- Reward Showcase Card -->
            <div class="rev-reward-card">
                <!-- Background decorative elements -->
                <div class="rev-reward-bg-shapes">
                    <div class="rev-reward-curve-overlay"></div>
                    <div class="rev-shape-circle-1"></div>
                    <div class="rev-shape-circle-2"></div>
                    <!-- Inline SVG for the stylized Gift Box -->
                    <svg class="rev-shape-gift" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect x="10" y="40" width="80" height="60" rx="6" fill="#fef08a" />
                        <rect x="10" y="65" width="80" height="10" fill="#eab308" opacity="0.4" />
                        <rect x="45" y="40" width="10" height="60" fill="#eab308" opacity="0.4" />
                        <path d="M50 40 C 35 25, 20 40, 45 45 Z" fill="#eab308" opacity="0.4" />
                        <path d="M50 40 C 65 25, 80 40, 55 45 Z" fill="#eab308" opacity="0.4" />
                        <path d="M48 45 L 35 60 L 42 62 Z" fill="#eab308" opacity="0.4" />
                        <path d="M52 45 L 65 60 L 58 62 Z" fill="#eab308" opacity="0.4" />
                        <rect x="20" y="75" width="16" height="12" rx="2" fill="#eab308" opacity="0.2" />
                    </svg>
                </div>

                <div class="rev-reward-img-container">
                    <img src="_content/SPIC.MauiBlazorApp.Shared/Images/Schemes/img_image_93.png" alt="Single Wardrobe" class="rev-reward-img">
                </div>

                <div class="rev-reward-content">
                    <div class="rev-reward-badge">THE GRAND REWARD</div>
                    <h2 class="rev-reward-title">Single Wardrobe</h2>
                    <p class="rev-reward-desc">Premium teak-finished, Royal Estate collection. A statement of prestige for your home.</p>
                </div>
            </div>
        </div>

        <!-- Product Rules Table -->
        <div class="rev-product-rules-card">
            <h3>Product Rules</h3>
            <div class="rev-table-wrapper">
                <table class="rev-rules-table">
                    <thead>
                        <tr>
                            <th>S:No</th>
                            <th>Category</th>
                            <th>Product</th>
                            <th>Dealer Quantity</th>
                            <th>Farmer Quantity</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Row 1 -->
                        <tr>
                            <td>1</td>
                            <td>Fertilizer</td>
                            <td>DAP</td>
                            <td><span class="rev-qty-pill">2 Ton</span></td>
                            <td><span class="rev-qty-pill">25 Kg</span></td>
                            <td>
                                <div class="rev-action-icons">
                                    <button class="rev-icon-btn rev-delete-btn">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M3 6h18"></path>
                                            <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path>
                                            <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path>
                                            <line x1="10" y1="11" x2="10" y2="17"></line>
                                            <line x1="14" y1="11" x2="14" y2="17"></line>
                                        </svg>
                                    </button>
                                    <button class="rev-icon-btn rev-edit-btn">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        <!-- Row 2 -->
                        <tr>
                            <td>2</td>
                            <td>Fertilizer</td>
                            <td>DAP</td>
                            <td><span class="rev-qty-pill">2 Ton</span></td>
                            <td><span class="rev-qty-pill">25 Kg</span></td>
                            <td>
                                <div class="rev-action-icons">
                                    <button class="rev-icon-btn rev-delete-btn">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                                    </button>
                                    <button class="rev-icon-btn rev-edit-btn">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        <!-- Row 3 -->
                        <tr>
                            <td>3</td>
                            <td>Fertilizer</td>
                            <td>DAP</td>
                            <td><span class="rev-qty-pill">2 Ton</span></td>
                            <td><span class="rev-qty-pill">25 Kg</span></td>
                            <td>
                                <div class="rev-action-icons">
                                    <button class="rev-icon-btn rev-delete-btn">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                                    </button>
                                    <button class="rev-icon-btn rev-edit-btn">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        <!-- Row 4 -->
                        <tr>
                            <td>4</td>
                            <td>Fertilizer</td>
                            <td>DAP</td>
                            <td><span class="rev-qty-pill">2 Ton</span></td>
                            <td><span class="rev-qty-pill">25 Kg</span></td>
                            <td>
                                <div class="rev-action-icons">
                                    <button class="rev-icon-btn rev-delete-btn">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                                    </button>
                                    <button class="rev-icon-btn rev-edit-btn">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Bottom Grid -->
        <div class="rev-bottom-grid">
            
            <!-- Target Segment Card -->
            <div class="rev-bottom-card">
                <h3 class="rev-section-title">Target Segment</h3>
                <div class="rev-segment-box">
                    <div class="rev-segment-row">
                        <span class="rev-segment-label">State</span>
                        <div class="rev-segment-pills">
                            <span class="rev-pill-green">Tamil Nadu</span>
                            <span class="rev-pill-green">Andhra Pradesh</span>
                        </div>
                    </div>
                    <div class="rev-segment-row">
                        <span class="rev-segment-label">District</span>
                        <div class="rev-segment-pills">
                            <span class="rev-pill-green">Thanjavur</span>
                            <span class="rev-pill-green">Madurai</span>
                            <span class="rev-pill-green">Trichy</span>
                        </div>
                    </div>
                    <div class="rev-segment-row">
                        <span class="rev-segment-label">Dealers</span>
                        <div class="rev-segment-pills">
                            <span class="rev-pill-blue">All Dealers</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Review Checklist Card -->
            <div class="rev-bottom-card">
                <h3 class="rev-section-title">Review Checklist</h3>
                <div class="rev-checklist-grid">
                    <div class="rev-check-item">
                        <span class="rev-check-label">Draw Points</span>
                        <span class="rev-check-value">200</span>
                        <span class="rev-check-sub">To Qualify</span>
                    </div>
                    <div class="rev-check-item">
                        <span class="rev-check-label">Product Points</span>
                        <span class="rev-check-value">2</span>
                        <span class="rev-check-sub">Per Purchase</span>
                    </div>
                    <div class="rev-check-item">
                        <span class="rev-check-label">Draw Mode</span>
                        <span class="rev-check-value">Auto</span>
                        <span class="rev-check-sub">Automatic</span>
                    </div>
                    <div class="rev-check-item">
                        <span class="rev-check-label">Frequency</span>
                        <span class="rev-check-value">Monthly</span>
                        <span class="rev-check-sub">Every Month</span>
                    </div>
                </div>
                
                <div class="rev-check-footer">
                    <div class="rev-footer-item">
                        <span class="rev-footer-label">Schedule Draw Monthly</span>
                        <span class="rev-footer-value" style="font-weight: 400;">Automatic</span>
                    </div>
                    <div class="rev-footer-item">
                        <span class="rev-footer-label">Draw Date</span>
                        <span class="rev-footer-value">30/04/2026</span>
                    </div>
                    <div class="rev-footer-item">
                        <span class="rev-footer-label">Draw Time</span>
                        <span class="rev-footer-value">10:00 AM</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Action Buttons (Bottom Right) -->
        <div class="rev-action-row">
            <button class="rev-btn rev-btn-outline">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                    <polyline points="17 21 17 13 7 13 7 21"></polyline>
                    <polyline points="7 3 7 8 15 8"></polyline>
                </svg>
                Save Draft
            </button>
            <button class="rev-btn rev-btn-solid">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                Active Scheme
            </button>
        </div>

    </div>
</div>