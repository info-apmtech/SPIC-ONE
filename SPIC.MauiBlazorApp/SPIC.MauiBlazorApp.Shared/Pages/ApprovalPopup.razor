



    
    <style>
    /* Base Styles & Reset */
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}



/
.modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
}

/* Modal Container */
.modal-content {
    background-color: #ffffff;
    width: 100%;
    max-width: 850px;
    border-radius: 12px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
    display: flex;
    flex-direction: column;
}

/* Header */
.modal-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 24px 32px 16px;
}

.modal-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: #374151;
    margin-bottom: 8px;
}

.modal-subtitle {
    font-size: 0.95rem;
    color: #6b7280;
}

.btn-close {
    background: transparent;
    border: none;
    color: #4b5563;
    cursor: pointer;
    padding: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s;
}

.btn-close:hover {
    color: #111827;
}

/* Body */
.modal-body {
    padding: 0 32px;
}

/* Typography elements */
.section-title {
    font-size: 1.05rem;
    font-weight: 600;
    color: #374151;
    margin-bottom: 16px;
}

.optional-text {
    font-weight: 400;
    color: #6b7280;
    font-size: 0.95rem;
}

/* Summary Grid */
.summary-section {
    margin-top: 12px;
    margin-bottom: 28px;
}

.summary-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    row-gap: 16px;
    column-gap: 32px;
}

.summary-item {
    display: flex;
    font-size: 0.95rem;
}

.summary-label {
    color: #6b7280;
    flex: 0 0 180px; /* Fixed width for alignment */
}

.summary-value {
    color: #1f2937;
    font-weight: 500;
}

/* Remarks Textarea */
.remarks-section {
    margin-bottom: 24px;
}

.remarks-input {
    width: 100%;
    min-height: 100px;
    padding: 16px;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    resize: vertical;
    font-size: 0.95rem;
    color: #374151;
    outline: none;
    transition: border-color 0.2s;
}

.remarks-input::placeholder {
    color: #9ca3af;
}

.remarks-input:focus {
    border-color: #d1d5db;
}

/* Info Alert */
.info-alert {
    background-color: #eff6ff;
    border-radius: 8px;
    padding: 16px 20px;
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
}

.alert-icon {
    width: 32px;
    height: 32px;
    background-color: #dbeafe;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.alert-text {
    color: #6b7280;
    font-size: 0.95rem;
    margin: 0;
    line-height: 1.5;
}

/* Footer Actions */
.modal-footer {
    display: flex;
    justify-content: flex-end;
    gap: 16px;
    padding: 20px 32px 32px;
}

.btn {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    border-radius: 6px;
    font-size: 0.95rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
}

.btn-cancel {
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    color: #4b5563;
}

.btn-cancel:hover {
    background-color: #f9fafb;
    color: #1f2937;
}

.btn-confirm {
    background-color: #115e59; /* Dark green matching the image */
    border: 1px solid #115e59;
    color: #ffffff;
}

.btn-confirm:hover {
    background-color: #0f514e;
}

/* Responsive adjustments */
@@media (max-width: 768px) {
    .summary-grid {
        grid-template-columns: 1fr;
    }
    .summary-label {
        flex: 0 0 150px;
    }
    .modal-header, .modal-body, .modal-footer {
        padding-left: 20px;
        padding-right: 20px;
    }
}
    
    </style>


<div class="modal-overlay">
    <div class="modal-content">
        
        <header class="modal-header">
            <div class="header-text">
                <h1 class="modal-title">Confirm Proceed</h1>
                <p class="modal-subtitle">Are you sure you want to approve and forward this application to state manager for review?</p>
            </div>
            <button class="btn-close" aria-label="Close modal">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="15" y1="9" x2="9" y2="15"></line>
                    <line x1="9" y1="9" x2="15" y2="15"></line>
                </svg>
            </button>
        </header>

        <div class="modal-body">
            <section class="summary-section">
                <h2 class="section-title">Application Summary</h2>
                <div class="summary-grid">
                    <div class="summary-item">
                        <span class="summary-label">Application Ref No</span>
                        <span class="summary-value">: CLP/2026/04/1123</span>
                    </div>
                    <div class="summary-item">
                        <span class="summary-label">Dealer Name</span>
                        <span class="summary-value">: Shri Balaji Traders</span>
                    </div>
                    <div class="summary-item">
                        <span class="summary-label">Proposed Credit Limit</span>
                        <span class="summary-value">: ₹ 5.00 Cr</span>
                    </div>
                    <div class="summary-item">
                        <span class="summary-label">Current Stage</span>
                        <span class="summary-value">: RM Review</span>
                    </div>
                    <div class="summary-item">
                        <span class="summary-label">Next Stage</span>
                        <span class="summary-value">: State Manager (SM) Review</span>
                    </div>
                </div>
            </section>

            <section class="remarks-section">
                <h2 class="section-title">Remarks <span class="optional-text">(optional)</span></h2>
                <textarea class="remarks-input" placeholder="Enter Remarks Optional"></textarea>
            </section>

            <div class="info-alert">
                <div class="alert-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="16" x2="12" y2="12"></line>
                        <line x1="12" y1="8" x2="12.01" y2="8"></line>
                    </svg>
                </div>
                <p class="alert-text">Once You Proceed the Application will be Forwarded to state Manager (SM) and you will not be able to edit it</p>
            </div>
        </div>

        <footer class="modal-footer">
            <button class="btn btn-cancel">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
                Cancel
            </button>
            <button class="btn btn-confirm">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                Confirm & Proceed
            </button>
        </footer>

    </div>
</div>













