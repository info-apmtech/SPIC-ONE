@page "/DealerSalesUpload"
@using System
@using System.Collections.Generic
@using System.Globalization
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Dealer Sales Management · SPIC ONE</PageTitle>

<div class="dsm-page">
    <section class="dsm-panel">
        <header class="dsm-header">
            <div class="dsm-header-title">
                <h1>Dealer Sales List</h1>
            </div>
            <div class="dsm-toolbar-controls">
                <div class="dsm-search">
                    <span aria-hidden="true">&#9906;</span>
                    <input type="search" value="@SearchText" @onchange="OnSearchChanged"
                           placeholder="Search invoice, dealer or product..." aria-label="Search dealer sales" />
                </div>
                <label class="dsm-upload-control @(IsUploading ? "dsm-disabled" : "")">
                    <span class="dsm-upload-glyph">&#8679;</span>
                    <span>@(IsUploading ? "Uploading..." : "Bulk Upload")</span>
                    <InputFile OnChange="OnFileSelected" accept=".xlsx,.xls"
                               disabled="@(IsUploading || IsLoading)" class="dsm-file-input"
                               title="Bulk upload SAP dealer sales Excel" />
                </label>
            </div>
        </header>

        @if (IsUploading)
        {
            <div class="dsm-message dsm-info" role="status">Validating and importing Excel invoice lines...</div>
        }
        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <div class="dsm-message dsm-error" role="alert">@Error</div>
        }
        @if (!string.IsNullOrWhiteSpace(Success))
        {
            <div class="dsm-message dsm-success" role="status">@Success</div>
        }
        @if (ValidationErrors.Count > 0)
        {
            <div class="dsm-validation">
                <strong>Upload errors (@ValidationErrors.Count shown)</strong>
                <div class="dsm-table-scroll">
                    <table class="dsm-table dsm-validation-table">
                        <thead>
                            <tr><th>Excel Row</th><th>Field</th><th>Reason</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var issue in ValidationErrors)
                            {
                                <tr>
                                    <td>@issue.RowNo</td>
                                    <td>@issue.Field</td>
                                    <td>@issue.Reason</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <div class="dsm-toolbar-row">
            <div class="dsm-export-actions" aria-label="Export actions">
                <button type="button" class="dsm-export-btn" @onclick="CopyCurrentRowsAsync" disabled="@(IsLoading || Rows.Count == 0)"><i class="bi bi-clipboard"></i> Copy</button>
                <button type="button" class="dsm-export-btn" @onclick="ExportCsvAsync" disabled="@(IsLoading || TotalRows == 0)"><i class="bi bi-filetype-csv"></i> CSV</button>
                <button type="button" class="dsm-export-btn" @onclick="ExportExcelAsync" disabled="@(IsLoading || TotalRows == 0)"><i class="bi bi-file-earmark-excel"></i> Excel</button>
                <button type="button" class="dsm-export-btn" @onclick="ExportPdfAsync" disabled="@(IsLoading || Rows.Count == 0)"><i class="bi bi-file-earmark-pdf"></i> PDF</button>
                <button type="button" class="dsm-export-btn" @onclick="PrintCurrentAsync" disabled="@(IsLoading || Rows.Count == 0)"><i class="bi bi-printer"></i> Print</button>
            </div>
        </div>

        <div class="dsm-table-scroll" id="dealer-sales-print-area">
            <table class="dsm-table">
                <thead>
                    <tr>
                        <th class="dsm-number">S.No</th>
                        <th>Billing Date</th>
                        <th>Billing Document</th>
                        <th>Dealer Code</th>
                        <th>Dealer Name</th>
                        <th>Product Code</th>
                        <th>Product Name</th>
                        <th class="dsm-right">Quantity</th>
                        <th>Unit</th>
                        <th class="dsm-right">Gross Amount (₹)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (IsLoading)
                    {
                        <tr><td colspan="10" class="dsm-empty">Loading dealer sales...</td></tr>
                    }
                    else if (Rows.Count == 0)
                    {
                        <tr><td colspan="10" class="dsm-empty">@(string.IsNullOrWhiteSpace(SearchText) ? "No sales records yet. Use Bulk Upload to add SAP invoice data." : "No sales records match your search.")</td></tr>
                    }
                    else
                    {
                        @foreach (var (row, index) in Rows.Select((r, i) => (r, i)))
                        {
                            <tr>
                                <td class="dsm-number">@((Page - 1) * PageSize + index + 1)</td>
                                <td class="dsm-nowrap">@(row.BillingDate == default ? "" : row.BillingDate.ToString("dd MMM yyyy"))</td>
                                <td class="dsm-code">@row.BillingDocument</td>
                                <td class="dsm-code">@row.CustomerNumber</td>
                                <td>@row.CustomerName</td>
                                <td class="dsm-code">@row.ProductCode</td>
                                <td>@row.ProductName</td>
                                <td class="dsm-right">@row.Quantity.ToString("N3", CultureInfo.InvariantCulture)</td>
                                <td>@row.UnitOfMeasure</td>
                                <td class="dsm-right dsm-amount">@row.GrossAmount.ToString("N2", new CultureInfo("en-IN"))</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <footer class="dsm-footer">
            <div class="dsm-page-size">
                <label for="dsm-page-size">Items Per Page</label>
                <select id="dsm-page-size" value="@PageSize" @onchange="OnPageSizeChanged" disabled="@IsLoading">
                    <option value="10">10</option>
                    <option value="16">16</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select>
            </div>
            <div class="dsm-footer-summary">
                Showing @(TotalRows == 0 ? 0 : (Page - 1) * PageSize + 1) to @Math.Min(Page * PageSize, TotalRows) of @TotalRows records
                <span class="dsm-total">Gross sales: ₹@TotalGrossAmountRs.ToString("N2", new CultureInfo("en-IN"))</span>
            </div>
            <nav class="dsm-paging" aria-label="Dealer sales pagination">
                <button type="button" disabled="@(IsLoading || Page <= 1)" title="Previous page" @onclick="PreviousPage">&#8249;</button>
                <span>Page @Page of @TotalPages</span>
                <button type="button" disabled="@(IsLoading || Page >= TotalPages)" title="Next page" @onclick="NextPage">&#8250;</button>
            </nav>
        </footer>
    </section>
</div>

<script>
    window.dealerSalesDownload = function (url) {
        const a = document.createElement('a');
        a.href = url;
        a.target = '_blank';
        a.rel = 'noopener';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
    };

    window.dealerSalesCopyText = async function (text) {
        await navigator.clipboard.writeText(text);
    };

    window.dealerSalesPrintHtml = function (html) {
        const w = window.open('', '_blank', 'width=1200,height=800');
        if (!w) return;
        w.document.open();
        w.document.write(html);
        w.document.close();
        w.focus();
        setTimeout(() => w.print(), 300);
    };
</script>

