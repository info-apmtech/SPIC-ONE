@code {
    private bool IsLoading = true;
    private bool IsUploading;
    private string? Error;
    private string? Success;
    private string SearchText = string.Empty;
    private int Page = 1;
    private int PageSize = 16;
    private int TotalPages = 1;
    private long TotalRows;
    private decimal TotalGrossAmountRs;
    private List<SaleRow> Rows = new();
    private List<ImportIssue> ValidationErrors = new();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            IsLoading = true;
            Error = null;
            Success = null;

            var url = $"api/dealer-sales?page={Page}&pageSize={PageSize}&search={Uri.EscapeDataString(SearchText ?? string.Empty)}";
            var response = await Http.GetAsync(url);
            var body = await response.Content.ReadAsStringAsync();
            if (!response.IsSuccessStatusCode)
            {
                Error = $"Unable to load sales (HTTP {(int)response.StatusCode}): {body}";
                Rows.Clear();
                TotalRows = 0;
                TotalGrossAmountRs = 0;
                TotalPages = 1;
                return;
            }

            var data = System.Text.Json.JsonSerializer.Deserialize<ListResponse>(body, new System.Text.Json.JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true
            });

            Rows = data?.Rows ?? new();
            TotalRows = data?.TotalRows ?? 0;
            TotalGrossAmountRs = data?.TotalGrossAmountRs ?? 0;
            Page = data?.Page ?? 1;
            PageSize = data?.PageSize ?? PageSize;
            TotalPages = Math.Max(1, (int)Math.Ceiling(TotalRows / (double)PageSize));
        }
        catch (Exception ex)
        {
            Error = "Unable to load dealer sales: " + ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;

        try
        {
            IsUploading = true;
            Error = null;
            Success = null;
            ValidationErrors.Clear();

            await using var stream = file.OpenReadStream(5 * 1024 * 1024);
            using var content = new MultipartFormDataContent();
            using var fileContent = new StreamContent(stream);
            fileContent.Headers.ContentType = new MediaTypeHeaderValue(file.ContentType == "application/octet-stream" ? "application/vnd.ms-excel" : file.ContentType);
            content.Add(fileContent, "file", file.Name);

            var response = await Http.PostAsync("api/dealer-sales/upload", content);
            var body = await response.Content.ReadAsStringAsync();

            if (!response.IsSuccessStatusCode)
            {
                TryReadUploadErrors(body);
                Error = $"Upload failed (HTTP {(int)response.StatusCode}): {ReadMessage(body)}";
                return;
            }

            var uploadResult = System.Text.Json.JsonSerializer.Deserialize<UploadResult>(body,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            Page = 1;
            await LoadAsync();
            // LoadAsync resets status, so set the final outcome after refreshing.
            Success = uploadResult is null
                ? "Upload completed successfully."
                : $"New records: {uploadResult.ImportedRows} | " +
                  $"Already imported: {uploadResult.SkippedExistingRows} | " +
                  $"Repeated in Excel: {uploadResult.SkippedInFileRows}.";
        }
        catch (Exception ex)
        {
            Error = "Upload failed: " + ex.Message;
        }
        finally
        {
            IsUploading = false;
        }
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        SearchText = Convert.ToString(e.Value) ?? string.Empty;
        Page = 1;
        _ = LoadAsync();
    }

    private void OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(Convert.ToString(e.Value), out var value))
        {
            PageSize = value;
            Page = 1;
            _ = LoadAsync();
        }
    }

    private Task PreviousPage()
    {
        if (Page > 1)
        {
            Page--;
            return LoadAsync();
        }
        return Task.CompletedTask;
    }

    private Task NextPage()
    {
        if (Page < TotalPages)
        {
            Page++;
            return LoadAsync();
        }
        return Task.CompletedTask;
    }

    private async Task CopyCurrentRowsAsync()
    {
        var lines = new List<string>
        {
            "Billing Date\tBilling Document\tDealer Code\tDealer Name\tProduct Code\tProduct Name\tQuantity\tUnit\tGross Amount"
        };

        foreach (var row in Rows)
        {
            lines.Add(string.Join("\t", new[]
            {
                row.BillingDate == default ? "" : row.BillingDate.ToString("dd-MMM-yyyy"),
                row.BillingDocument,
                row.CustomerNumber,
                row.CustomerName,
                row.ProductCode,
                row.ProductName,
                row.Quantity.ToString("0.###", CultureInfo.InvariantCulture),
                row.UnitOfMeasure,
                row.GrossAmount.ToString("0.00", CultureInfo.InvariantCulture)
            }));
        }

        await JS.InvokeVoidAsync("dealerSalesCopyText", string.Join("\n", lines));
        Success = "Current page rows copied to clipboard.";
    }

    private async Task ExportCsvAsync() =>
        await JS.InvokeVoidAsync("dealerSalesDownload", BuildExportUrl("csv"));

    private async Task ExportExcelAsync() =>
        await JS.InvokeVoidAsync("dealerSalesDownload", BuildExportUrl("excel"));

    private async Task ExportPdfAsync()
    {
        var html = BuildPrintableHtml(true);
        await JS.InvokeVoidAsync("dealerSalesPrintHtml", html);
    }

    private async Task PrintCurrentAsync()
    {
        var html = BuildPrintableHtml(false);
        await JS.InvokeVoidAsync("dealerSalesPrintHtml", html);
    }

    private string BuildExportUrl(string format)
    {
        var search = Uri.EscapeDataString(SearchText ?? string.Empty);
        return Nav.ToAbsoluteUri($"api/dealer-sales/export/{format}?search={search}").ToString();
    }

    private string BuildPrintableHtml(bool titleAsPdf)
    {
        var sb = new System.Text.StringBuilder();
        sb.Append("<html><head><meta charset='utf-8'><title>")
          .Append(titleAsPdf ? "Dealer Sales Export" : "Dealer Sales Print")
          .Append("</title><style>")
          .Append("body{font-family:Arial,sans-serif;padding:24px;color:#223;}h2{margin:0 0 6px;}p{margin:0 0 14px;color:#667;}table{width:100%;border-collapse:collapse;font-size:12px;}th,td{border:1px solid #cfd8e3;padding:7px 8px;text-align:left;}th{background:#eef3f7;} .r{text-align:right;} .n{white-space:nowrap;} ")
          .Append("</style></head><body>");
        sb.Append("<h2>Dealer Sales Management</h2>");
        sb.Append("<p>Search: ").Append(System.Net.WebUtility.HtmlEncode(string.IsNullOrWhiteSpace(SearchText) ? "All records" : SearchText))
          .Append(" &nbsp; | &nbsp; Gross sales: ₹").Append(TotalGrossAmountRs.ToString("N2", new CultureInfo("en-IN")))
          .Append("</p>");
        sb.Append("<table><thead><tr>")
          .Append("<th>S.No</th><th>Billing Date</th><th>Billing Document</th><th>Dealer Code</th><th>Dealer Name</th><th>Product Code</th><th>Product Name</th><th>Quantity</th><th>Unit</th><th>Gross Amount</th>")
          .Append("</tr></thead><tbody>");
        foreach (var (row, index) in Rows.Select((r, i) => (r, i)))
        {
            sb.Append("<tr>")
              .Append("<td>").Append((Page - 1) * PageSize + index + 1).Append("</td>")
              .Append("<td class='n'>").Append(System.Net.WebUtility.HtmlEncode(row.BillingDate == default ? "" : row.BillingDate.ToString("dd-MMM-yyyy"))).Append("</td>")
              .Append("<td>").Append(System.Net.WebUtility.HtmlEncode(row.BillingDocument)).Append("</td>")
              .Append("<td>").Append(System.Net.WebUtility.HtmlEncode(row.CustomerNumber)).Append("</td>")
              .Append("<td>").Append(System.Net.WebUtility.HtmlEncode(row.CustomerName)).Append("</td>")
              .Append("<td>").Append(System.Net.WebUtility.HtmlEncode(row.ProductCode)).Append("</td>")
              .Append("<td>").Append(System.Net.WebUtility.HtmlEncode(row.ProductName)).Append("</td>")
              .Append("<td class='r'>").Append(System.Net.WebUtility.HtmlEncode(row.Quantity.ToString("0.###", CultureInfo.InvariantCulture))).Append("</td>")
              .Append("<td>").Append(System.Net.WebUtility.HtmlEncode(row.UnitOfMeasure)).Append("</td>")
              .Append("<td class='r'>").Append(System.Net.WebUtility.HtmlEncode(row.GrossAmount.ToString("0.00", new CultureInfo("en-IN")))).Append("</td>")
              .Append("</tr>");
        }
        sb.Append("</tbody></table></body></html>");
        return sb.ToString();
    }

    private void TryReadUploadErrors(string body)
    {
        try
        {
            var model = System.Text.Json.JsonSerializer.Deserialize<UploadErrorResponse>(body, new System.Text.Json.JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true
            });
            ValidationErrors = model?.ValidationErrors ?? new();
        }
        catch
        {
            ValidationErrors.Clear();
        }
    }

    private static string? ReadMessage(string body)
    {
        try
        {
            var model = System.Text.Json.JsonSerializer.Deserialize<MessageOnly>(body, new System.Text.Json.JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true
            });
            return model?.Message ?? body;
        }
        catch
        {
            return body;
        }
    }

    private sealed class ListResponse
    {
        public long TotalRows { get; set; }
        public decimal TotalGrossAmountRs { get; set; }
        public int Page { get; set; }
        public int PageSize { get; set; }
        public List<SaleRow> Rows { get; set; } = new();
    }

    private sealed class SaleRow
    {
        public long Id { get; set; }
        public string BillingDocument { get; set; } = string.Empty;
        public string Item { get; set; } = string.Empty;
        public DateTime BillingDate { get; set; }
        public string CustomerNumber { get; set; } = string.Empty;
        public string CustomerName { get; set; } = string.Empty;
        public string ProductCode { get; set; } = string.Empty;
        public string ProductName { get; set; } = string.Empty;
        public decimal Quantity { get; set; }
        public string UnitOfMeasure { get; set; } = string.Empty;
        public decimal GrossAmount { get; set; }
    }

    private sealed class ImportIssue
    {
        public int RowNo { get; set; }
        public string Field { get; set; } = string.Empty;
        public string Reason { get; set; } = string.Empty;
    }

    private sealed class UploadResult
    {
        public int ImportedRows { get; set; }
        public int SkippedExistingRows { get; set; }
        public int SkippedInFileRows { get; set; }
    }

    private sealed class UploadErrorResponse
    {
        public string? Message { get; set; }
        public List<ImportIssue> ValidationErrors { get; set; } = new();
    }

    private sealed class MessageOnly
    {
        public string? Message { get; set; }
    }
}
