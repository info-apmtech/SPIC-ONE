@page "/RequestExtension/{CSRId:int}"
@using System.Net.Http.Json
@using System.Globalization
@using SPIC.Core.DTOs
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Request Extension · SPIC ONE</PageTitle>

<div class="container-fluid py-4 px-0">
    <div class="rex-wrapper">

        <!-- Header -->
        <div class="rex-header">
            <div>
                <h1>Request Extension</h1>
                <p>Submit a request to extend the Scheme period as the required turnover has not yet been achieved.</p>
            </div>
            <button type="button" class="rex-btn-outline-green" @onclick="BackToTracking">
                <SalesAuditIcon Name="arrow-left" Size="15" />
                Back to Period and Review
            </button>
        </div>

        @if (IsLoading)
        {
            <div class="rex-banner" role="status">Loading scheme information...</div>
        }
        else if (!string.IsNullOrWhiteSpace(LoadError))
        {
            <div class="rex-banner" role="alert">@LoadError</div>
            <button type="button" class="rex-btn rex-btn-back" @onclick="BackToTracking">Back to Sales Tracking</button>
        }
        else if (Scheme is not null && Submitted is null)
        {
            <!-- Info banner -->
            <div class="rex-banner">
                <SalesAuditIcon Name="info" Size="16" />
                <span>Please provide the details below to request an extension. Submitting will create an extension request for approval. The scheme end date will not change.</span>
            </div>

            <!-- Scheme Information -->
            <h3 class="rex-section-title">Scheme Information <span>(Read Only)</span></h3>
            <div class="rex-info-grid">
                @foreach (var tile in InfoTiles)
                {
                    <div class="rex-info-tile">
                        <div class="rex-info-icon rex-tone-@tile.Tone">
                            <SalesAuditIcon Name="file-chart" Size="22" StrokeWidth="1.6" />
                        </div>
                        <div class="rex-info-text">
                            <span class="rex-label">@tile.Label</span>
                            <span class="rex-info-value @(tile.Tone == "red" ? "rex-red" : "")">@tile.Value</span>
                        </div>
                    </div>
                }
            </div>

            <!-- Scheme Period form -->
            <div class="rex-card">
                <h3 class="rex-card-title">Scheme Period</h3>

                <div class="rex-form-grid">
                    <div class="rex-form-group">
                        <label class="rex-form-label" for="rex-end-date">Requested New End Date</label>
                        <div class="rex-date-wrap @(ShowErrors && DateError is not null ? "rex-invalid" : "")">
                            <span class="rex-date-display @(NewEndDate is null ? "rex-placeholder" : "")">
                                @(NewEndDate?.ToString("dd MMM yyyy") ?? "Select new end date")
                            </span>
                            <SalesAuditIcon Name="calendar" Size="16" CssClass="rex-date-icon" />
                            <input id="rex-end-date" type="date" class="rex-date-native"
                                   min="@CurrentEnd.AddDays(1).ToString("yyyy-MM-dd")"
                                   value="@NewEndDate?.ToString("yyyy-MM-dd")" @onchange="SetNewEndDate" />
                        </div>
                        @if (ShowErrors && DateError is not null)
                        {
                            <span class="rex-error">@DateError</span>
                        }
                        else
                        {
                            <span class="rex-help">Select the new end date for the scheme period</span>
                        }
                    </div>

                    <div class="rex-form-group">
                        <label class="rex-form-label" for="rex-reason">Reason for Extension</label>
                        <select id="rex-reason" class="rex-select @(string.IsNullOrEmpty(Reason) ? "rex-placeholder" : "") @(ShowErrors && ReasonError is not null ? "rex-invalid" : "")"
                                @bind="Reason">
                            <option value="">Select reason</option>
                            @foreach (var reason in Reasons)
                            {
                                <option value="@reason">@reason</option>
                            }
                        </select>
                        @if (ShowErrors && ReasonError is not null)
                        {
                            <span class="rex-error">@ReasonError</span>
                        }
                        else
                        {
                            <span class="rex-help">Select the primary reason for requesting extension</span>
                        }
                    </div>

                    <div class="rex-form-group rex-span-2">
                        <label class="rex-form-label" for="rex-remarks">Remarks / Explanation (Optional)</label>
                        <textarea id="rex-remarks" class="rex-textarea @(ShowErrors && RemarksError is not null ? "rex-invalid" : "")" rows="3"
                                  maxlength="@RemarksMax" placeholder="Optional: add an explanation for the extension request"
                                  @bind="Remarks" @bind:event="oninput"></textarea>
                        @if (ShowErrors && RemarksError is not null)
                        {
                            <span class="rex-error">@RemarksError</span>
                        }
                        else
                        {
                            <span class="rex-help">Optional. Maximum 500 characters.</span>
                        }
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(SubmitError))
            {
                <div class="rex-banner" role="alert">@SubmitError</div>
            }

            <!-- Footer actions -->
            <div class="rex-footer">
                <button type="button" class="rex-btn rex-btn-back" @onclick="BackToList">
                    <SalesAuditIcon Name="chevrons-left" Size="16" />
                    Back to List
                </button>
                <div class="rex-footer-right">
                    <button type="button" class="rex-btn rex-btn-back" @onclick="BackToTracking">Close</button>
                    <button type="button" class="rex-btn rex-btn-primary" disabled="@IsSubmitting" @onclick="Submit">
                        Submit Extension Request
                        <SalesAuditIcon Name="chevrons-right" Size="16" />
                    </button>
                </div>
            </div>
        }
        else
        {
            <!-- Submitted -->
            <div class="rex-success">
                <span class="rex-success-icon">
                    <SalesAuditIcon Name="badge-check" Size="34" StrokeWidth="1.8" />
                </span>
                <h2 class="rex-success-title">@(IsExistingPending ? "Extension Request Pending Approval" : "Extension Request Submitted")</h2>
                <p class="rex-success-lead">@(IsExistingPending ? "A request is already awaiting approval for this CSR." : "Your extension request was saved successfully and is awaiting approval.")</p>
                <p class="rex-success-text">
                    The Sales Audit scheme end date remains unchanged until a separate approval workflow is implemented.
                </p>

                <dl class="rex-summary">
                    <div class="rex-summary-cell"><dt>Request ID</dt><dd class="rex-green">@Submitted.RequestId</dd></div>
                    <div class="rex-summary-cell"><dt>Request Date</dt><dd>@Submitted.RequestDate.ToString("d MMM yyyy")</dd></div>
                    <div class="rex-summary-cell"><dt>Current Scheme Period</dt><dd>@Scheme!.SchemeFrom.ToString("dd MMM yyyy") - @Submitted.PreviousEndDate.ToString("dd MMM yyyy")</dd></div>
                    <div class="rex-summary-cell"><dt>Request New End Date</dt><dd>@Scheme!.SchemeFrom.ToString("dd MMM yyyy") - @Submitted.NewEndDate.ToString("d MMM yyyy")</dd></div>
                    <div class="rex-summary-cell"><dt>Reason</dt><dd>@Submitted.Reason</dd></div>
                    <div class="rex-summary-cell"><dt>Status</dt><dd><span class="rex-status-pill"><span class="rex-dot"></span>Pending Approval</span></dd></div>
                    <div class="rex-summary-remarks"><dt>Remarks</dt><dd>@Submitted.Remarks</dd></div>
                </dl>

                <div class="rex-success-actions">
                    <button type="button" class="rex-btn rex-btn-soft" @onclick="GoToExtensionRequests">
                        <SalesAuditIcon Name="eye" Size="16" />
                        View My Request
                    </button>
                    <button type="button" class="rex-btn rex-btn-primary" @onclick="GoToSalesTrackingList">
                        Go to Sales Audit List
                        <SalesAuditIcon Name="arrow-right" Size="16" />
                    </button>
                </div>
            </div>
        }

    </div>
</div>

@code {
    [Parameter] public int CSRId { get; set; }

    private SchemeExtensionInfoDto? Scheme;
    private ExtensionRequestReceiptDto? Submitted;
    private bool IsLoading = true;
    private bool IsSubmitting;
    private bool IsExistingPending;
    private bool ShowErrors;
    private string? LoadError;
    private string? SubmitError;
    private DateTime? NewEndDate;
    private string Reason = "";
    private string Remarks = "";
    private const int RemarksMax = 500;

    private static readonly string[] Reasons =
    {
        "Market Condition", "Weather / Crop Season Delay", "Stock Availability",
        "Dealer Onboarding Delay", "Other"
    };

    private record InfoTile(string Label, string Value, string Tone);
    private static string Money(decimal amount) => "₹ " + amount.ToString("N2", CultureInfo.GetCultureInfo("en-IN"));
    private List<InfoTile> InfoTiles => Scheme is null ? new() : new()
    {
        new("Program Name", Scheme.ProgramName, "purple"),
        new("Sanction Number", Scheme.SanctionNumber, "green"),
        new("Current Scheme Period", $"{Scheme.SchemeFrom:dd MMM yyyy} - {Scheme.SchemeTo:dd MMM yyyy}", "blue"),
        new("Required Turnover (TO)", Money(Scheme.RequiredTurnover), "purple"),
        new("Actual Turnover Achieved", Money(Scheme.ActualTurnover), "blue"),
        new("Balance to Target", Money(Math.Max(0m, Scheme.RequiredTurnover - Scheme.ActualTurnover)), "red"),
    };

    private DateTime CurrentEnd => Scheme?.SchemeTo ?? DateTime.MaxValue;
    private string? DateError => NewEndDate is null ? "Select the new end date."
        : NewEndDate.Value.Date <= CurrentEnd.Date ? $"The new end date must be after {CurrentEnd:dd MMM yyyy}." : null;
    private string? ReasonError => !Reasons.Contains(Reason) ? "Select a valid extension reason." : null;
    private string? RemarksError => Remarks.Trim().Length > RemarksMax
        ? $"Remarks cannot exceed {RemarksMax} characters." : null;

    protected override async Task OnParametersSetAsync()
    {
        Scheme = null;
        Submitted = null;
        IsExistingPending = false;
        LoadError = null;
        IsLoading = true;
        try
        {
            if (CSRId <= 0) throw new InvalidOperationException("Invalid Sales Audit ID.");
            using var response = await Http.GetAsync($"api/SalesAudit/extension/{CSRId}");
            if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
                throw new InvalidOperationException("The selected Sales Audit record was not found.");
            if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
                throw new InvalidOperationException("You do not have permission to view this Sales Audit record.");
            response.EnsureSuccessStatusCode();
            Scheme = await response.Content.ReadFromJsonAsync<SchemeExtensionInfoDto>()
                ?? throw new InvalidOperationException("Scheme information was empty.");

            // An existing unapproved request is shown instead of a new submission form.
            using var pendingResponse = await Http.GetAsync($"api/SalesAudit/extension/{CSRId}/pending");
            if (pendingResponse.IsSuccessStatusCode)
            {
                Submitted = await pendingResponse.Content.ReadFromJsonAsync<ExtensionRequestReceiptDto>()
                    ?? throw new InvalidOperationException("Pending extension information was empty.");
                IsExistingPending = true;
            }
            else if (pendingResponse.StatusCode != System.Net.HttpStatusCode.NotFound)
            {
                pendingResponse.EnsureSuccessStatusCode();
            }
        }
        catch (Exception ex) { LoadError = ex.Message; }
        finally { IsLoading = false; }
    }

    private void SetNewEndDate(ChangeEventArgs e)
    {
        NewEndDate = DateTime.TryParseExact(e.Value?.ToString(), "yyyy-MM-dd",
            CultureInfo.InvariantCulture, DateTimeStyles.None, out var date) ? date : null;
    }

    private async Task Submit()
    {
        if (Scheme is null || IsSubmitting || IsExistingPending || Submitted is not null) return;
        ShowErrors = true;
        SubmitError = null;
        if (DateError is not null || ReasonError is not null || RemarksError is not null) return;
        IsSubmitting = true;
        try
        {
            var payload = new CreateExtensionRequestDto(NewEndDate!.Value.Date, Reason, Remarks.Trim());
            using var response = await Http.PostAsJsonAsync($"api/SalesAudit/extension/{CSRId}", payload);
            if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
                throw new InvalidOperationException("An extension request may already be pending for this CSR. Reload the page to view it.");
            if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
                throw new InvalidOperationException("You do not have permission to request an extension.");
            response.EnsureSuccessStatusCode();
            Submitted = await response.Content.ReadFromJsonAsync<ExtensionRequestReceiptDto>()
                ?? throw new InvalidOperationException("The server did not return the saved request details.");
            try { await JS.InvokeVoidAsync("scrollPageToTop"); } catch (JSException) { }
        }
        catch (Exception ex) { SubmitError = ex.Message; }
        finally { IsSubmitting = false; }
    }

    private void BackToTracking() => Nav.NavigateTo($"/SalesTracking?CSRId={CSRId}");
    private void BackToList() => Nav.NavigateTo("/SalesAudit");
    private void GoToExtensionRequests() => Nav.NavigateTo("/ExtensionRequests");
    private void GoToSalesTrackingList() => Nav.NavigateTo("/SalesTrackingList");
}
