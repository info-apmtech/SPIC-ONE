    // On Submit, Total Budget must equal Allocated to Headquarters + Remaining Amount. This
    // client-side check is for immediate UX feedback only - the server independently
    // re-validates the same rule, plus that Total Budget doesn't exceed the applicable
    // Region's own allocated amount (see BudgetController.SubmitHeadquarterBudgetSummary).
    private async Task SubmitHeadquarterBudgetSummaryAsync()
    {
        if (_isSavingHqSummary || _isSubmittingHqSummary || _hqSelectedRegionId <= 0 || _selectedFY.Length == 0 || _hqSummaryStatus == "Submitted")
            return;

        if (_hqSummaryTotalBudget != _hqSummaryAllocated + _hqSummaryRemaining)
        {
            _hqSummaryValidationMessage =
                $"Total Budget (₹{_hqSummaryTotalBudget:N0}) must equal Allocated to Headquarters (₹{_hqSummaryAllocated:N0}) + Remaining Amount (₹{_hqSummaryRemaining:N0}).";
            return;
        }

        _isSubmittingHqSummary = true;
        _hqSummarySuccessMessage = null;
