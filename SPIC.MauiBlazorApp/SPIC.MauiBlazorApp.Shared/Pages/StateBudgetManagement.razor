@code {

    // Section toggle only - purely a display switch, no data reload/reset on
    // change (State and Region data are each already loaded/reloaded by their
    // own existing triggers: FY change and State-dropdown change respectively).
    private string _activeSection = "State";

    // Role-gated tab visibility, reusing the existing LoginState role-group helpers (no new
    // permission architecture): Admin -> State, SM (SMD/SMM) -> Region, RM (RM/RMD) -> Headquarters.
    // Admin can also see Region/Headquarters, same bypass convention as LoginState.Can/CanAccess.
    private bool CanSeeStateTab => LoginState.IsAdmin;
    private bool CanSeeRegionTab => LoginState.IsAdmin || LoginState.IsStateRole;
    private bool CanSeeHeadquartersTab => LoginState.IsAdmin || LoginState.IsRegionRole;

    private List<StateBudgetDto> States = new();

    private List<string> _availableFYs = new();
    private string _selectedFY = "";
    private Dictionary<string, decimal> _annualBudgetByFY = new();

    private bool _isSaving;
    private bool _isSubmitting;
    private string? _validationMessage;
    private string? _successMessage;

    // "Draft" until Submit For Validation marks every row for the FY "Submitted" -
    // reuses BudgetProgram.Status's existing string-status convention, not a new one.
    private string _currentStatus = "Draft";

    private decimal UtilizedBudget = 0;

    // Sourced from the AnnualBudgeting amount for the selected FY - this is the
    // maximum available budget for state-wise allocation, never a sum of the
    // states themselves.
    private decimal TotalStateBudget =>
        _selectedFY.Length > 0 && _annualBudgetByFY.TryGetValue(_selectedFY, out var amt) ? amt : 0m;


    private decimal TotalAllocated =>
        States.Sum(x => x.BudgetAmount);


    private decimal RemainingBudget =>
        TotalStateBudget - TotalAllocated;


    private decimal MonthlyAverage =>
        TotalAllocated / 12;

    private string AllocatedPercentText =>
        TotalStateBudget > 0 ? (TotalAllocated / TotalStateBudget).ToString("P1") : "0.0%";

    // The single source of truth for "can this be saved": the moment the sum of every
    // state's amount exceeds the FY's Annual Budget, saving is blocked - regardless of
    // which row was just edited.
    private bool _hasValidationError => _selectedFY.Length > 0 && TotalAllocated > TotalStateBudget;

    // ---- Level 1 (Admin) Budget Summary: Total Budget / Allocated to State / Remaining Amount.
    // Separate from the State-wise allocation table above: all three fields here are plain
    // manually-entered values, persisted as their own StateBudgetSummary row - Remaining is
    // never computed from Total - Allocated, client or server side. ----
    private decimal _stateSummaryTotalBudget;
    private decimal _stateSummaryAllocated;
    private decimal _stateSummaryRemaining;
    private string _stateSummaryStatus = "Draft";
    private bool _isSavingStateSummary;
    private bool _isSubmittingStateSummary;
    private string? _stateSummaryValidationMessage;
    private string? _stateSummarySuccessMessage;

    private async Task LoadStateBudgetSummaryAsync()
    {
        if (_selectedFY.Length == 0)
        {
            _stateSummaryTotalBudget = 0;
            _stateSummaryAllocated = 0;
            _stateSummaryRemaining = 0;
            _stateSummaryStatus = "Draft";
            return;
        }

        try
        {
            var dto = await Http.GetFromJsonAsync<StateBudgetSummaryDto>(
                $"api/Budget/state-budget-summary?fy={Uri.EscapeDataString(_selectedFY)}");
            _stateSummaryTotalBudget = dto?.TotalBudget ?? 0;
            _stateSummaryAllocated = dto?.AllocatedAmount ?? 0;
            _stateSummaryRemaining = dto?.RemainingAmount ?? 0;
            _stateSummaryStatus = dto?.Status ?? "Draft";
        }
        catch
        {
            _stateSummaryStatus = "Draft";
        }
    }

    private async Task SaveStateBudgetSummaryAsync()
    {
        if (_isSavingStateSummary || _selectedFY.Length == 0)
            return;

        _isSavingStateSummary = true;
        try
        {
            await TrySaveStateBudgetSummaryAsync();
        }
        finally
        {
            _isSavingStateSummary = false;
        }
    }

    private async Task<bool> TrySaveStateBudgetSummaryAsync()
    {
        try
        {
            var request = new SaveStateBudgetSummaryRequest
            {
                FY = _selectedFY,
                TotalBudget = _stateSummaryTotalBudget,
                AllocatedAmount = _stateSummaryAllocated,
                RemainingAmount = _stateSummaryRemaining
            };

            var response = await Http.PutAsJsonAsync("api/Budget/state-budget-summary", request);
            if (response.IsSuccessStatusCode)
            {
                _stateSummaryValidationMessage = null;
                await LoadStateBudgetSummaryAsync();
                return true;
            }

            var raw = await response.Content.ReadAsStringAsync();
            _stateSummaryValidationMessage = ExtractMessage(raw);
            return false;
        }
        catch (Exception ex)
        {
            _stateSummaryValidationMessage = $"Failed to save: {ex.Message}";
            return false;
        }
    }

    // On Submit, Total Budget must equal Allocated to State + Remaining Amount. This client-side
    // check is for immediate UX feedback only - the server independently re-validates the same
    // rule and is the authority (see BudgetController.SubmitStateBudgetSummary).
    private async Task SubmitStateBudgetSummaryAsync()
    {
        if (_isSavingStateSummary || _isSubmittingStateSummary || _selectedFY.Length == 0 || _stateSummaryStatus == "Submitted")
            return;

        if (_stateSummaryTotalBudget != _stateSummaryAllocated + _stateSummaryRemaining)
        {
            _stateSummaryValidationMessage =
                $"Total Budget (₹{_stateSummaryTotalBudget:N0}) must equal Allocated to State (₹{_stateSummaryAllocated:N0}) + Remaining Amount (₹{_stateSummaryRemaining:N0}).";
            return;
        }

        _isSubmittingStateSummary = true;
        _stateSummarySuccessMessage = null;
        try
        {
            var saved = await TrySaveStateBudgetSummaryAsync();
            if (!saved)
                return;

            var request = new SubmitStateBudgetSummaryRequest { FY = _selectedFY };
            var response = await Http.PutAsJsonAsync("api/Budget/state-budget-summary/submit", request);
            if (response.IsSuccessStatusCode)
            {
                await LoadStateBudgetSummaryAsync();
                _stateSummaryValidationMessage = null;
                _stateSummarySuccessMessage = $"State budget summary for FY {_selectedFY} submitted successfully.";
            }
            else
            {
                var raw = await response.Content.ReadAsStringAsync();
                _stateSummaryValidationMessage = ExtractMessage(raw);
            }
        }
        catch (Exception ex)
        {
            _stateSummaryValidationMessage = $"Failed to submit: {ex.Message}";
        }
        finally
        {
            _isSubmittingStateSummary = false;
        }
    }

    // ---- Region-wise allocation (distributes one State's own allocated amount) ----
    private int _selectedStateId;
    private List<RegionBudgetDto> _regions = new();
    private bool _isSavingRegion;
    private string? _regionValidationMessage;
    private string? _regionSuccessMessage;

    // The State's own saved allocation for the selected FY - never a sum of the
    // regions themselves - exactly mirroring how TotalStateBudget sources from
