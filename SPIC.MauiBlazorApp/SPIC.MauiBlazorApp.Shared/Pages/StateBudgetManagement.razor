        }
        catch
        {
            _hqSummaryStatus = "Draft";
        }
    }

    private async Task SaveHeadquarterBudgetSummaryAsync()
    {
        if (_isSavingHqSummary || _hqSelectedRegionId <= 0 || _selectedFY.Length == 0)
            return;

        _isSavingHqSummary = true;
        try
        {
            await TrySaveHeadquarterBudgetSummaryAsync();
        }
        finally
        {
            _isSavingHqSummary = false;
        }
    }

    private async Task<bool> TrySaveHeadquarterBudgetSummaryAsync()
    {
        try
        {
            var request = new SaveHeadquarterBudgetSummaryRequest
            {
                RegionId = _hqSelectedRegionId,
                FY = _selectedFY,
                TotalBudget = _hqSummaryTotalBudget,
                AllocatedAmount = _hqSummaryAllocated,
                RemainingAmount = _hqSummaryRemaining
            };

            var response = await Http.PutAsJsonAsync("api/Budget/hq-budget-summary", request);
