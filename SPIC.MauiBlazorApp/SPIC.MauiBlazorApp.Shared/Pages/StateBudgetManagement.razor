        }
    }

    // ---- Headquarters-wise allocation (distributes one Region's own allocated amount) ----
    // Kept independent from the Region Allocation section's own _selectedStateId/_regions
    // so a user can go straight to Headquarters Allocation without visiting Region Allocation first.
    private int _hqSelectedStateId;
    private int _hqSelectedRegionId;
    private List<RegionBudgetDto> _hqRegions = new();
    private List<HeadquarterBudgetDto> _headquarters = new();
    private bool _isSavingHq;
    private string? _hqValidationMessage;
    private string? _hqSuccessMessage;

    // The Region's own saved allocation for the selected FY - never a sum of the
    // headquarters themselves - same convention as SelectedStateAmount/TotalStateBudget.
    private decimal SelectedRegionAmount =>
        _hqRegions.FirstOrDefault(r => r.RegionId == _hqSelectedRegionId)?.BudgetAmount ?? 0m;

    private decimal TotalHeadquartersAllocated =>
        _headquarters.Sum(x => x.BudgetAmount);

    private decimal RemainingRegionBudget =>
        SelectedRegionAmount - TotalHeadquartersAllocated;

    private bool _hasHqValidationError =>
        _hqSelectedRegionId > 0 && TotalHeadquartersAllocated > SelectedRegionAmount;

    // ---- Level 3 (RM) Budget Summary: Total Budget / Allocated to Headquarters / Remaining
    // Amount, scoped to the selected Region + FY. Separate from the Headquarters-wise allocation
    // table above: all three fields here are plain manually-entered values, persisted as their
    // own HeadquarterBudgetSummary row - Remaining is never computed from Total - Allocated. ----
    private decimal _hqSummaryTotalBudget;
    private decimal _hqSummaryAllocated;
    private decimal _hqSummaryRemaining;
    private string _hqSummaryStatus = "Draft";
    private bool _isSavingHqSummary;
    private bool _isSubmittingHqSummary;
    private string? _hqSummaryValidationMessage;
    private string? _hqSummarySuccessMessage;

