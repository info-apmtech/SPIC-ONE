@page "/StateBudgetManagement"
@inject HttpClient Http
@inject SPIC.MauiBlazorApp.Shared.Services.LoginState LoginState
@using System.Net.Http.Json
@using SPIC.Core.DTOs
@using DR = SPIC.Core.Entities

<div class="container-fluid budget-page">

    <!-- Header -->
    <div class="page-header">
        <h3>State Budgeting Management</h3>
    </div>

    <!-- Section Toggle (same tabs-wrapper/tab-item pattern as LocationMaster). Each tab is
         shown only to the role responsible for that level (Admin/SM/RM), reusing the existing
         LoginState role-group helpers - Admin can see every level, same bypass convention as
         LoginState.Can/CanAccess elsewhere in the app. -->
    <div class="tabs-wrapper">
        <div class="tabs-container">
            @if (CanSeeStateTab)
            {
                <div class="tab-item @(_activeSection == "State" ? "active" : "")" @onclick='() => _activeSection = "State"'>
                    State Allocation
                </div>
            }
            @if (CanSeeRegionTab)
            {
                <div class="tab-item @(_activeSection == "Region" ? "active" : "")" @onclick='() => _activeSection = "Region"'>
                    Region Allocation
                </div>
            }
            @if (CanSeeHeadquartersTab)
            {
                <div class="tab-item @(_activeSection == "Headquarters" ? "active" : "")" @onclick='() => _activeSection = "Headquarters"'>
                    Headquarters Allocation
                </div>
            }
        </div>
    </div>

    @if (!CanSeeStateTab && !CanSeeRegionTab && !CanSeeHeadquartersTab)
    {
        <div class="alert-box">⚠ You do not have access to any budget allocation level.</div>
    }

    @if (_activeSection == "State" && CanSeeStateTab)
    {
    <!-- Selection -->
    <div class="main-card">
        <div class="row g-3">
            <div class="col-12 col-sm-6 col-lg-3">
                <label class="form-label-custom">Financial Year</label>
                @if (_availableFYs.Count > 0)
                {
                    <select class="form-select-custom w-100" @bind="_selectedFY" @bind:after="OnFYChangedAsync">
                        @foreach (var fy in _availableFYs)
                        {
                            <option value="@fy">FY @fy</option>
                        }
                    </select>
                }
                else
                {
                    <div class="form-control-custom w-100 text-muted">No Annual Budget defined</div>
                }
            </div>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="metric-card bg-blue-light">
                <div class="metric-header">
                    <h4 class="metric-title">State Details</h4>
                </div>
                <div class="metric-val">@States.Count State(s)</div>
                <div class="metric-info">FY @(_selectedFY.Length > 0 ? _selectedFY : "-")</div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="metric-card bg-mint-light">
                <div class="metric-header">
                    <h4 class="metric-title">Annual Budget</h4>
                </div>
                <div class="metric-val">₹ @TotalStateBudget.ToString("N2")</div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="metric-card bg-gray-light">
                <div class="metric-header">
                    <h4 class="metric-title">Allocated Budget</h4>
                </div>
                <div class="metric-val">₹ @TotalAllocated.ToString("N2")</div>
                <div class="metric-info">@AllocatedPercentText allocated</div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="metric-card bg-amber-light">
                <div class="metric-header">
                    <h4 class="metric-title">Remaining Budget</h4>
                </div>
                <div class="metric-val">₹ @RemainingBudget.ToString("N2")</div>
            </div>
        </div>

    </div>

    <!-- Allocation Table -->
    <div class="main-card">

        <div class="section-header">
            <h3 class="section-title">
                State-wise Budget Allocation
            </h3>
        </div>

        @if (!string.IsNullOrEmpty(_validationMessage))
        {
            <div class="alert-box">⚠ @_validationMessage</div>
        }

        @if (!string.IsNullOrEmpty(_successMessage))
        {
            <div class="success-box">✓ @_successMessage</div>
        }

        <table class="budget-table">

            <thead>
                <tr>
                    <th>
                        State
                    </th>

                    <th>
                        Budget
                    </th>
                </tr>
            </thead>


            <tbody>

                @foreach (var item in States)
                {
                    <tr>

                        <td>
                            @item.StateName
                        </td>


                        <td>

                            <input type="number"
                                   class="budget-input"
                                   min="0"
                                   @bind="item.BudgetAmount"
                                   @bind:event="oninput"
                                   @bind:after="() => OnAmountChanged(item)" />

                        </td>

                    </tr>
                }


            </tbody>

            <!-- Total Budget / Allocated to State are the existing Annual Budget and the sum of
                 the rows above - reused as-is, never re-entered. Remaining Amount is the only
                 manually-entered summary value, saved into StateBudgetSummary alongside them
                 whenever the allocation above is saved - no auto-calculation, no separate form. -->
            <tfoot>
                <tr class="budget-table-total-row">
                    <td><strong>Total Allocated to State</strong></td>
                    <td><strong>₹ @TotalAllocated.ToString("N0")</strong></td>
                </tr>
                @if (!LoginState.IsAdmin)
                {
                    <tr>
                        <td><strong>Remaining Amount</strong></td>
                        <td>
                            <input type="number"
                                   class="budget-input"
                                   min="0"
                                   @bind="_stateSummaryRemaining"
                                   @bind:event="oninput" />
                        </td>
                    </tr>
                }
            </tfoot>

        </table>

    </div>
    }


    @if (_activeSection == "Region" && CanSeeRegionTab)
    {
    <!-- Selection -->
    <div class="main-card">
        <div class="row g-3">
            <div class="col-12 col-sm-6 col-lg-3">
                <label class="form-label-custom">Financial Year</label>
                @if (_availableFYs.Count > 0)
                {
                    <select class="form-select-custom w-100" @bind="_selectedFY" @bind:after="OnFYChangedAsync">
                        @foreach (var fy in _availableFYs)
                        {
                            <option value="@fy">FY @fy</option>
                        }
                    </select>
                }
                else
                {
                    <div class="form-control-custom w-100 text-muted">No Annual Budget defined</div>
                }
            </div>

            <div class="col-12 col-sm-6 col-lg-3">
                <label class="form-label-custom">State</label>
                <select class="form-select-custom w-100" @bind="_selectedStateId" @bind:after="OnSelectedStateChangedAsync">
                    <option value="0">-- Select State --</option>
                    @foreach (var s in States)
                    {
                        <option value="@s.StateId">@s.StateName</option>
                    }
                </select>
            </div>
        </div>
    </div>

    @if (_selectedStateId > 0)
    {
        <!-- Summary Cards -->
        <div class="row g-3 mb-4">

            <div class="col-12 col-sm-6 col-lg-3">
                <div class="metric-card bg-blue-light">
                    <div class="metric-header">
                        <h4 class="metric-title">State Details</h4>
                    </div>
                    <div class="metric-val">@(States.FirstOrDefault(s => s.StateId == _selectedStateId)?.StateName ?? "-")</div>
                    <div class="metric-info">FY @_selectedFY</div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-lg-3">
                <div class="metric-card bg-mint-light">
                    <div class="metric-header">
                        <h4 class="metric-title">Region Details</h4>
                    </div>
                    <div class="metric-val">@_regions.Count Region(s)</div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-lg-3">
                <div class="metric-card bg-gray-light">
                    <div class="metric-header">
                        <h4 class="metric-title">State Allocated Budget</h4>
                    </div>
                    <div class="metric-val">₹ @SelectedStateAmount.ToString("N2")</div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-lg-3">
                <div class="metric-card bg-amber-light">
                    <div class="metric-header">
                        <h4 class="metric-title">Remaining State Budget</h4>
                    </div>
                    <div class="metric-val">₹ @RemainingStateBudget.ToString("N2")</div>
                </div>
            </div>

        </div>

        <!-- Region Allocation -->
        <div class="main-card">

            <div class="section-header">
                <h3 class="section-title">
                    Region-wise Budget Allocation
                </h3>
            </div>

            @if (!string.IsNullOrEmpty(_regionValidationMessage))
            {
                <div class="alert-box">⚠ @_regionValidationMessage</div>
            }

            @if (!string.IsNullOrEmpty(_regionSuccessMessage))
            {
                <div class="success-box">✓ @_regionSuccessMessage</div>
            }

            @if (SelectedStateAmount <= 0)
            {
                <div class="alert-box">⚠ Save this state's allocation above before distributing it to regions.</div>
            }
            else if (_regions.Count == 0)
            {
                <div class="alert-box">⚠ No regions found for the selected state.</div>
            }
            else
            {
                <table class="budget-table">

                    <thead>
                        <tr>
                            <th>
                                Region
                            </th>

                            <th>
                                Allocation
                            </th>
                        </tr>
                    </thead>


                    <tbody>

                        @foreach (var item in _regions)
                        {
                            <tr>

                                <td>
                                    @item.RegionName
                                </td>


                                <td>

                                    <input type="number"
                                           class="budget-input"
                                           min="0"
                                           @bind="item.BudgetAmount"
                                           @bind:event="oninput"
                                           @bind:after="() => OnRegionAmountChanged(item)" />

                                </td>

                            </tr>
                        }


                    </tbody>

                    <!-- Total Budget / Allocated to Region are the existing applicable State
                         budget and the sum of the rows above - reused as-is, never re-entered.
                         Remaining Amount is the only manually-entered summary value, saved into
                         RegionBudgetSummary alongside them whenever this allocation is saved. -->
                    <tfoot>
                        <tr class="budget-table-total-row">
                            <td><strong>Allocated to Region</strong></td>
                            <td><strong>₹ @TotalRegionAllocated.ToString("N0")</strong></td>
                        </tr>
                        <tr>
                            <td><strong>Remaining Amount</strong></td>
                            <td>
                                <input type="number"
                                       class="budget-input"
                                       min="0"
                                       @bind="_regionSummaryRemaining"
                                       @bind:event="oninput" />
                            </td>
                        </tr>
                    </tfoot>

                </table>

                <div class="bottom-bar">
                    <div class="bottom-summary">
                        <div class="bottom-item">
                            <label>Selected State Budget</label>
                            <strong>₹ @SelectedStateAmount.ToString("N0")</strong>
                        </div>

                        <div class="bottom-item">
                            <label>Total Region Allocation</label>
                            <strong>₹ @TotalRegionAllocated.ToString("N0")</strong>
                        </div>

                        <div class="bottom-item">
                            <label>Remaining State Budget</label>
                            <strong>₹ @RemainingStateBudget.ToString("N0")</strong>
                        </div>
                    </div>

                    <div class="action-buttons">
                        <button class="btn-draft"
                                @onclick="SaveRegionAllocationsAsync"
                                disabled="@(_isSavingRegion || _hasRegionValidationError)">
                            @(_isSavingRegion ? "Saving..." : "Save Region Allocation")
                        </button>
                    </div>
                </div>
            }

        </div>
    }
    }


    @if (_activeSection == "Headquarters" && CanSeeHeadquartersTab)
    {
    <!-- Selection -->
    <div class="main-card">
        <div class="row g-3">
            <div class="col-12 col-sm-6 col-lg-3">
                <label class="form-label-custom">Financial Year</label>
                @if (_availableFYs.Count > 0)
                {
                    <select class="form-select-custom w-100" @bind="_selectedFY" @bind:after="OnFYChangedAsync">
                        @foreach (var fy in _availableFYs)
                        {
                            <option value="@fy">FY @fy</option>
                        }
                    </select>
                }
                else
                {
                    <div class="form-control-custom w-100 text-muted">No Annual Budget defined</div>
                }
            </div>

            <div class="col-12 col-sm-6 col-lg-3">
                <label class="form-label-custom">State</label>
                <select class="form-select-custom w-100" @bind="_hqSelectedStateId" @bind:after="OnHqSelectedStateChangedAsync">
                    <option value="0">-- Select State --</option>
                    @foreach (var s in States)
                    {
                        <option value="@s.StateId">@s.StateName</option>
                    }
                </select>
            </div>

            @if (_hqSelectedStateId > 0 && _hqRegions.Count > 0)
            {
                <div class="col-12 col-sm-6 col-lg-3">
                    <label class="form-label-custom">Region</label>
                    <select class="form-select-custom w-100" @bind="_hqSelectedRegionId" @bind:after="OnHqSelectedRegionChangedAsync">
                        <option value="0">-- Select Region --</option>
                        @foreach (var r in _hqRegions)
                        {
                            <option value="@r.RegionId">@r.RegionName</option>
                        }
                    </select>
                </div>
            }
        </div>
    </div>

    @if (_hqSelectedStateId > 0)
    {
        @if (_hqRegions.Count == 0)
        {
            <div class="alert-box">⚠ No regions found for the selected state.</div>
        }

        @if (_hqSelectedRegionId > 0)
        {
            <!-- Summary Cards -->
            <div class="row g-3 mb-4">

                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="metric-card bg-blue-light">
                        <div class="metric-header">
                            <h4 class="metric-title">State Details</h4>
                        </div>
                        <div class="metric-val">@(States.FirstOrDefault(s => s.StateId == _hqSelectedStateId)?.StateName ?? "-")</div>
                        <div class="metric-info">FY @_selectedFY</div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="metric-card bg-mint-light">
                        <div class="metric-header">
                            <h4 class="metric-title">Region Details</h4>
                        </div>
                        <div class="metric-val">@(_hqRegions.FirstOrDefault(r => r.RegionId == _hqSelectedRegionId)?.RegionName ?? "-")</div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="metric-card bg-gray-light">
                        <div class="metric-header">
                            <h4 class="metric-title">Headquarters Details</h4>
                        </div>
                        <div class="metric-val">@_headquarters.Count Headquarter(s)</div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="metric-card bg-amber-light">
                        <div class="metric-header">
                            <h4 class="metric-title">Region Available Budget</h4>
                        </div>
                        <div class="metric-val">₹ @RemainingRegionBudget.ToString("N2")</div>
                    </div>
                </div>

            </div>

            <!-- Headquarters Allocation -->
            <div class="main-card">

                <div class="section-header">
                    <h3 class="section-title">
                        Headquarters-wise Budget Allocation
                    </h3>
                </div>

                @if (!string.IsNullOrEmpty(_hqValidationMessage))
                {
                    <div class="alert-box">⚠ @_hqValidationMessage</div>
                }

                @if (!string.IsNullOrEmpty(_hqSuccessMessage))
                {
                    <div class="success-box">✓ @_hqSuccessMessage</div>
                }

                @if (SelectedRegionAmount <= 0)
                {
                    <div class="alert-box">⚠ Save this region's allocation above before distributing it to headquarters.</div>
                }
                else if (_headquarters.Count == 0)
                {
                    <div class="alert-box">⚠ No headquarters found for the selected region.</div>
                }
                else
                {
                    <table class="budget-table">

                        <thead>
                            <tr>
                                <th>
                                    Headquarters
                                </th>

                                <th>
                                    Allocation
                                </th>
                            </tr>
                        </thead>


                        <tbody>

                            @foreach (var item in _headquarters)
                            {
                                <tr>

                                    <td>
                                        @item.HeadquarterName
                                    </td>


                                    <td>

                                        <input type="number"
                                               class="budget-input"
                                               min="0"
                                               @bind="item.BudgetAmount"
                                               @bind:event="oninput"
                                               @bind:after="() => OnHqAmountChanged(item)" />

                                    </td>

                                </tr>
                            }


                        </tbody>

                        <!-- Total Budget / Allocated to Headquarters are the existing applicable
                             Region budget and the sum of the rows above - reused as-is, never
                             re-entered. Remaining Amount is the only manually-entered summary
                             value, saved into HeadquarterBudgetSummary alongside them whenever
                             this allocation is saved. -->
                        <tfoot>
                            <tr class="budget-table-total-row">
                                <td><strong>Allocated to Headquarters</strong></td>
                                <td><strong>₹ @TotalHeadquartersAllocated.ToString("N0")</strong></td>
                            </tr>
                            <tr>
                                <td><strong>Remaining Amount</strong></td>
                                <td>
                                    <input type="number"
                                           class="budget-input"
                                           min="0"
                                           @bind="_hqSummaryRemaining"
                                           @bind:event="oninput" />
                                </td>
                            </tr>
                        </tfoot>

                    </table>

                    <div class="bottom-bar">
                        <div class="bottom-summary">
                            <div class="bottom-item">
                                <label>Region Allocated Budget</label>
                                <strong>₹ @SelectedRegionAmount.ToString("N0")</strong>
                            </div>

                            <div class="bottom-item">
                                <label>Total Headquarters Allocated</label>
                                <strong>₹ @TotalHeadquartersAllocated.ToString("N0")</strong>
                            </div>

                            <div class="bottom-item">
                                <label>Remaining Region Budget</label>
                                <strong>₹ @RemainingRegionBudget.ToString("N0")</strong>
                            </div>
                        </div>

                        <div class="action-buttons">
                            <button class="btn-draft"
                                    @onclick="SaveHeadquarterAllocationsAsync"
                                    disabled="@(_isSavingHq || _hasHqValidationError)">
                                @(_isSavingHq ? "Saving..." : "Save Headquarters Allocation")
                            </button>
                        </div>
                    </div>
                }

            </div>
        }
    }
    }


    @if (_activeSection == "State" && CanSeeStateTab)
    {
    <!-- Bottom Summary -->
    <div class="main-card bottom-bar">


        <div class="bottom-summary">

            <div class="bottom-item">
                <label>Total Allocated</label>
                <strong>
                    ₹ @TotalAllocated.ToString("N0")
                </strong>
            </div>


            <div class="bottom-item">
                <label>Monthly Avg</label>
                <strong>
                    ₹ @MonthlyAverage.ToString("N0")
                </strong>
            </div>


            @if (_hasValidationError)
            {
                <div class="alert-box">
                    ⚠ Total allocated exceeds annual budget
                </div>
            }

        </div>



        <div class="action-buttons">

            <button class="btn-draft"
                    @onclick="SaveAllocationsAsync"
                    disabled="@(_isSaving || _isSubmitting || _hasValidationError || _availableFYs.Count == 0)">
                @(_isSaving ? "Saving..." : "Save Draft")
            </button>


            <button class="btn-submit"
                    @onclick="SubmitForValidationAsync"
                    disabled="@(_isSaving || _isSubmitting || _hasValidationError || _availableFYs.Count == 0 || _currentStatus == "Submitted")">
                @(_isSubmitting ? "Submitting..." : (_currentStatus == "Submitted" ? "Submitted" : "Submit For Validation"))
            </button>

        </div>


    </div>
    }


</div>

<style>
    .budget-page {
        padding: 18px 0;
    }


    .page-header h3 {
        font-size: 18px;
        font-weight: 600;
        color: #1f2937;
        margin-bottom: 16px;
    }



    /* Metric card accents re-use the LocationMaster metric-card look
       (.bg-blue-light/.bg-mint-light/.bg-gray-light come from LocationSaveList.css);
       .bg-amber-light adds a 4th tone following the same gradient formula. */
    .metric-card.bg-amber-light {
        border: 1px solid #fde7c7;
        background: linear-gradient(90deg, #fff7ed24, #fff7ed 100%);
    }

    .metric-card .metric-val {
        font-size: 1.15rem;
    }



    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .budget-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 15px;
    }



        .budget-table th {
            text-align: left;
            background: #f3f4f6;
            padding: 10px;
            font-size: 12px;
        }



        .budget-table td {
            padding: 8px;
            border-bottom: 1px solid #edf0f2;
            font-size: 12px;
        }

        .budget-table tfoot td {
            padding: 8px;
            border-top: 2px solid #e5e7eb;
            border-bottom: none;
            background: #f9fafb;
            font-size: 12px;
        }



    .budget-input {
        width: 100%;
        height: 28px;
        border: 1px solid #e5e7eb;
        padding: 5px;
        font-size: 12px;
    }



    .bottom-bar {
        margin-top: 12px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }



    .bottom-summary {
        display: flex;
        gap: 12px;
    }



    .bottom-item {
        background: #e8f5ee;
        padding: 10px 20px;
        border-radius: 4px;
    }



        .bottom-item label {
            font-size: 11px;
            display: block;
        }



        .bottom-item strong {
            font-size: 14px;
        }



    .alert-box {
        background: #fee2e2;
        color: #dc2626;
        padding: 10px;
        font-size: 12px;
    }

    .success-box {
        background: #dcfce7;
        color: #15803d;
        padding: 10px;
        font-size: 12px;
        margin-top: 10px;
    }



    .action-buttons {
        display: flex;
        gap: 10px;
    }



    .btn-draft {
        background: #e5e7eb;
        border: none;
        padding: 10px 18px;
        border-radius: 5px;
    }

        .btn-draft:disabled {
            opacity: .6;
            cursor: not-allowed;
        }



    .btn-submit {
        background: #047857;
        color: white;
        border: none;
        padding: 10px 18px;
        border-radius: 5px;
    }
</style>

@code {

    // Section toggle only - purely a display switch, no data reload/reset on
    // change (State and Region data are each already loaded/reloaded by their
    // own existing triggers: FY change and State-dropdown change respectively).
    private string _activeSection = "State";

    // Role-gated tab visibility, reusing the existing LoginState role-group helpers (no new
    // permission architecture): Admin -> State, SM (SMD/SMM) -> Region, RM (RM/RMD) -> Headquarters.
    // For admin role: Region Allocation and Headquarters Allocation tabs are hidden.
    private bool CanSeeStateTab => LoginState.IsAdmin;
    private bool CanSeeRegionTab => !LoginState.IsAdmin && LoginState.IsStateRole;
    private bool CanSeeHeadquartersTab => !LoginState.IsAdmin && LoginState.IsRegionRole;

    private List<StateBudgetDto> States = new();

    private List<string> _availableFYs = new();
    private string _selectedFY = "";
    private Dictionary<string, decimal> _annualBudgetByFY = new();

    private bool _isSaving;
    private bool _isSubmitting;
    private string? _validationMessage;
    private string? _successMessage;

    // "Draft" until Submit For Validation marks every row for the FY "Submitted" -
    // reuses BudgetProgram.Status's existing string-status convention, not a new one.
    private string _currentStatus = "Draft";

    private decimal UtilizedBudget = 0;

    // Sourced from the AnnualBudgeting amount for the selected FY - this is the
    // maximum available budget for state-wise allocation, never a sum of the
    // states themselves.
    private decimal TotalStateBudget =>
        _selectedFY.Length > 0 && _annualBudgetByFY.TryGetValue(_selectedFY, out var amt) ? amt : 0m;


    private decimal TotalAllocated =>
        States.Sum(x => x.BudgetAmount);


    private decimal RemainingBudget =>
        TotalStateBudget - TotalAllocated;


    private decimal MonthlyAverage =>
        TotalAllocated / 12;

    private string AllocatedPercentText =>
