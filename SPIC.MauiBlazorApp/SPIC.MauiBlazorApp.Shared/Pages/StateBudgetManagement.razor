            return;
        }

        _isSubmittingRegionSummary = true;
        _regionSummarySuccessMessage = null;
        try
        {
            var saved = await TrySaveRegionBudgetSummaryAsync();
            if (!saved)
                return;

            var request = new SubmitRegionBudgetSummaryRequest { StateId = _selectedStateId, FY = _selectedFY };
            var response = await Http.PutAsJsonAsync("api/Budget/region-budget-summary/submit", request);
            if (response.IsSuccessStatusCode)
            {
                await LoadRegionBudgetSummaryAsync();
                _regionSummaryValidationMessage = null;
                _regionSummarySuccessMessage = $"Region budget summary for FY {_selectedFY} submitted successfully.";
            }
            else
            {
                var raw = await response.Content.ReadAsStringAsync();
                _regionSummaryValidationMessage = ExtractMessage(raw);
            }
        }
        catch (Exception ex)
        {
            _regionSummaryValidationMessage = $"Failed to submit: {ex.Message}";
        }
        finally
        {
