    private decimal SelectedStateAmount =>
        States.FirstOrDefault(s => s.StateId == _selectedStateId)?.BudgetAmount ?? 0m;

    private decimal TotalRegionAllocated =>
        _regions.Sum(x => x.BudgetAmount);

    private decimal RemainingStateBudget =>
        SelectedStateAmount - TotalRegionAllocated;

    private bool _hasRegionValidationError =>
        _selectedStateId > 0 && TotalRegionAllocated > SelectedStateAmount;

    // ---- Level 2 (SM) Budget Summary: Total Budget / Allocated to Region / Remaining Amount,
    // scoped to the selected State + FY. Separate from the Region-wise allocation table above:
    // all three fields here are plain manually-entered values, persisted as their own
    // RegionBudgetSummary row - Remaining is never computed from Total - Allocated. ----
    private decimal _regionSummaryTotalBudget;
    private decimal _regionSummaryAllocated;
    private decimal _regionSummaryRemaining;
