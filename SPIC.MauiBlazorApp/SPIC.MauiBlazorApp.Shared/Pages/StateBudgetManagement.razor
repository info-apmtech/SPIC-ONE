    // submit failure on this page. The TotalBudget/AllocatedAmount checks below mirror the
    // server's own (authoritative) checks purely for immediate UX feedback - the server
    // re-validates independently and cannot be bypassed by calling the API directly.
    private async Task<bool> TrySubmitStateBudgetSummaryAsync()
    {
        if (TotalStateBudget <= 0)
        {
            _validationMessage = "Total Budget must be greater than 0.";
            return false;
        }

        if (TotalAllocated <= 0)
        {
            _validationMessage = "Allocated Amount must be greater than 0.";
            return false;
        }

        if (LoginState.IsAdmin && TotalAllocated != TotalStateBudget)
        {
            var diff = TotalStateBudget - TotalAllocated;
            _validationMessage = diff > 0
                ? $"All budget must be allocated to states. ₹{diff:N0} remaining to be allocated."
                : $"Allocated Amount (₹{TotalAllocated:N0}) cannot exceed Total Budget (₹{TotalStateBudget:N0}).";
            return false;
        }

        try
        {
            var request = new SubmitStateBudgetSummaryRequest { FY = _selectedFY };
            var response = await Http.PutAsJsonAsync("api/Budget/state-budget-summary/submit", request);
            if (response.IsSuccessStatusCode)
                return true;

            var raw = await response.Content.ReadAsStringAsync();
            _validationMessage = ExtractMessage(raw);
            return false;
        }
        catch (Exception ex)
        {
            _validationMessage = $"Failed to submit budget summary: {ex.Message}";
            return false;
        }
    }

