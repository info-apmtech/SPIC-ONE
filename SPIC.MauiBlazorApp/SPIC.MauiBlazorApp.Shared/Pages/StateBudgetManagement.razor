    // Negative values are never allowed; while over budget, the message reports the
    // remaining room excluding the row just edited (its own current amount is not
    // double-counted against itself).
    private void OnAmountChanged(StateBudgetDto item)
    {
        _successMessage = null;

        if (item.BudgetAmount < 0)
            item.BudgetAmount = 0;

        if (_hasValidationError)
        {
            var otherStatesTotal = TotalAllocated - item.BudgetAmount;
            var allowedForThisState = Math.Max(0, TotalStateBudget - otherStatesTotal);
            _validationMessage =
                $"Allocation amount cannot exceed the remaining budget of ₹{allowedForThisState:N0}.";
        }
        else
        {
            _validationMessage = null;
        }
    }


    private async Task SaveAllocationsAsync()
    {
        if (_isSaving || _hasValidationError || _selectedFY.Length == 0)
            return;

        _isSaving = true;
        try
        {
            await TrySaveAllocationsAsync();
        }
        finally
        {
            _isSaving = false;
        }
    }

    // Shared by the Save Draft button and by Submit For Validation (which must persist
    // the current on-screen amounts before marking the FY submitted). Returns true only
    // when the PUT actually succeeded, so a submit can safely stop if the save failed.
    //
    // Validated BEFORE anything is sent to the server: if the on-screen Total Budget / Allocated
    // to State / Remaining Amount don't reconcile, neither the detail allocation rows nor the
    // StateBudgetSummary are touched at all - this is a UX shortcut only, the server
    // independently re-validates the identical rule in both SaveStateBudgetSummary and
    // SubmitStateBudgetSummary and remains the sole authority.
    private async Task<bool> TrySaveAllocationsAsync()
    {
        if (LoginState.IsAdmin)
        {
            if (TotalStateBudget <= 0)
            {
                _validationMessage = "Total Budget must be greater than 0.";
                return false;
            }

            if (TotalAllocated <= 0)
            {
                _validationMessage = "Allocated Amount must be greater than 0.";
                return false;
            }

            if (TotalAllocated != TotalStateBudget)
            {
                var diff = TotalStateBudget - TotalAllocated;
                _validationMessage = diff > 0
                    ? $"All budget must be allocated to states. ₹{diff:N0} remaining to be allocated."
                    : $"Allocated Amount (₹{TotalAllocated:N0}) cannot exceed Total Budget (₹{TotalStateBudget:N0}).";
                return false;
            }

            _stateSummaryRemaining = 0;
        }
        else
        {
            if (!TryValidateSummaryAmounts(TotalStateBudget, TotalAllocated, _stateSummaryRemaining, out var preCheckError))
            {
                _validationMessage = preCheckError;
                return false;
            }
        }

        try
        {
            var request = new SaveStateBudgetRequest
            {
                FY = _selectedFY,
                Allocations = States.Select(s => new StateBudgetAllocationRequest
                {
                    StateId = s.StateId,
                    Amount = s.BudgetAmount
                }).ToList()
            };

            var response = await Http.PutAsJsonAsync("api/Budget/state-budget", request);
            if (response.IsSuccessStatusCode)
            {
                _validationMessage = null;
                // Reload from the DB rather than trusting local state, so the page
                // always shows exactly what was persisted.
                await LoadStatesAsync();

                // Keep StateBudgetSummary's Total Budget/Allocated to State in sync with what was
                // just persisted above, every time the allocation is saved (Save Draft or Submit).
                return await TrySaveStateBudgetSummaryAsync();
            }

            var raw = await response.Content.ReadAsStringAsync();
            _validationMessage = ExtractMessage(raw);
            return false;
        }
        catch (Exception ex)
        {
            _validationMessage = $"Failed to save: {ex.Message}";
            return false;
        }
    }

    // Submit For Validation: saves the current amounts first (same validated Save Draft
    // path, so the submitted data always matches what's on screen), then marks every
    // saved row for the FY "Submitted". Blocked while already Submitted, over budget, or
    // saving/submitting is already in progress, so the same allocation can't be submitted twice.
    private async Task SubmitForValidationAsync()
    {
        if (_isSaving || _isSubmitting || _hasValidationError || _selectedFY.Length == 0 || _currentStatus == "Submitted")
            return;

        _isSubmitting = true;
        _successMessage = null;
        try
        {
            var saved = await TrySaveAllocationsAsync();
            if (!saved)
                return;

            // Validates TotalBudget == AllocatedAmount + RemainingAmount server-side and marks the
            // StateBudgetSummary Submitted - a mismatch blocks the whole Submit here, before the
            // detail allocation below is ever marked Submitted, via the same _validationMessage.
            var summarySubmitted = await TrySubmitStateBudgetSummaryAsync();
            if (!summarySubmitted)
                return;

            var request = new SubmitStateBudgetRequest { FY = _selectedFY };
            var response = await Http.PutAsJsonAsync("api/Budget/state-budget/submit", request);
            if (response.IsSuccessStatusCode)
            {
                await LoadStatusAsync();
                _validationMessage = null;
                _successMessage = $"State budget allocation for FY {_selectedFY} submitted for validation successfully.";
            }
            else
            {
                var raw = await response.Content.ReadAsStringAsync();
                _validationMessage = ExtractMessage(raw);
            }
        }
        catch (Exception ex)
        {
            _validationMessage = $"Failed to submit: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task OnSelectedStateChangedAsync()
    {
        _regionValidationMessage = null;
        _regionSuccessMessage = null;
        await LoadRegionsAsync();
        await LoadRegionBudgetSummaryAsync();
    }

    // Loads only the regions belonging to the selected State (existing Region/byState
    // relationship - no new Region master, nothing hardcoded), merged with whatever
    // has already been saved for this State + FY so a reload shows exactly the DB state.
    private async Task LoadRegionsAsync()
    {
        if (_selectedStateId <= 0 || _selectedFY.Length == 0)
        {
            _regions = new();
            return;
        }

        _regions =
            await Http.GetFromJsonAsync<List<RegionBudgetDto>>(
                $"api/Budget/regions-budget?stateId={_selectedStateId}&fy={Uri.EscapeDataString(_selectedFY)}")
            ?? new();
    }

    // Same convention as OnAmountChanged: negative values are clamped, and while over
    // the State's own allocated amount, the message reports the remaining room
    // excluding the region just edited so its own value is never double-counted.
    private void OnRegionAmountChanged(RegionBudgetDto item)
    {
        _regionSuccessMessage = null;

        if (item.BudgetAmount < 0)
            item.BudgetAmount = 0;

        if (_hasRegionValidationError)
        {
            var otherRegionsTotal = TotalRegionAllocated - item.BudgetAmount;
            var allowedForThisRegion = Math.Max(0, SelectedStateAmount - otherRegionsTotal);
            _regionValidationMessage =
                $"Region allocation cannot exceed the remaining state budget of ₹{allowedForThisRegion:N0}.";
        }
        else
        {
            _regionValidationMessage = null;
        }
    }

    // Full replace of every region's allocation for the selected State + FY, same
    // convention as Save Draft for states - the backend independently re-validates
    // everything (state/region existence, region-belongs-to-state, negatives, total
    // vs. the state's own allocated amount) regardless of what the client already checked.
    //
    // Validated BEFORE anything is sent to the server: if Total Budget (the applicable State's
    // own allocation) / Allocated to Region / Remaining Amount don't reconcile, neither the
    // detail allocation rows nor the RegionBudgetSummary are touched, and no success message is
    // shown - this is a UX shortcut only, the server independently re-validates the identical
    // rule in both SaveRegionBudgetSummary and SubmitRegionBudgetSummary.
    private async Task SaveRegionAllocationsAsync()
    {
        if (_isSavingRegion || _hasRegionValidationError || _selectedStateId <= 0 || _selectedFY.Length == 0)
            return;

        if (!TryValidateSummaryAmounts(SelectedStateAmount, TotalRegionAllocated, _regionSummaryRemaining, out var preCheckError))
        {
            _regionValidationMessage = preCheckError;
            _regionSuccessMessage = null;
            return;
        }

        _isSavingRegion = true;
        try
        {
            var request = new SaveRegionBudgetRequest
            {
                StateId = _selectedStateId,
                FY = _selectedFY,
                Allocations = _regions.Select(r => new RegionBudgetAllocationRequest
                {
                    RegionId = r.RegionId,
                    Amount = r.BudgetAmount
                }).ToList()
            };

            var response = await Http.PutAsJsonAsync("api/Budget/region-budget", request);
            if (response.IsSuccessStatusCode)
            {
                _regionValidationMessage = null;
                // Reload from the DB rather than trusting local state, so the page
                // always shows exactly what was persisted.
                await LoadRegionsAsync();

                // Keep RegionBudgetSummary's Total Budget/Allocated to Region in sync with what
                // was just persisted above, then validate+submit it (TotalBudget ==
                // AllocatedAmount + RemainingAmount) every time the allocation is saved - Region
                // has no separate Draft/Submit buttons, so this single save does both. The success
                // message only appears once the WHOLE operation (detail + summary save + summary
                // submit) has gone through - never on a partial/rejected save.
                var summarySaved = await TrySaveRegionBudgetSummaryAsync();
                if (summarySaved && await TrySubmitRegionBudgetSummaryAsync())
                    _regionSuccessMessage = "Region budget allocation saved successfully.";
            }
            else
            {
                var raw = await response.Content.ReadAsStringAsync();
                _regionValidationMessage = ExtractMessage(raw);
            }
        }
        catch (Exception ex)
        {
            _regionValidationMessage = $"Failed to save: {ex.Message}";
        }
        finally
        {
            _isSavingRegion = false;
        }
    }

    private async Task OnHqSelectedStateChangedAsync()
    {
        _hqSelectedRegionId = 0;
        _headquarters = new();
        _hqValidationMessage = null;
        _hqSuccessMessage = null;
        await LoadHqRegionsAsync();
        await LoadHeadquarterBudgetSummaryAsync();
    }

    // Reuses the existing regions-budget endpoint (Region + its already-saved allocation
    // amount for the FY) - the same data the Region Allocation section itself loads, just
    // kept in this section's own independent list.
    private async Task LoadHqRegionsAsync()
    {
        if (_hqSelectedStateId <= 0 || _selectedFY.Length == 0)
        {
            _hqRegions = new();
            return;
        }

        _hqRegions =
            await Http.GetFromJsonAsync<List<RegionBudgetDto>>(
                $"api/Budget/regions-budget?stateId={_hqSelectedStateId}&fy={Uri.EscapeDataString(_selectedFY)}")
            ?? new();
    }

    private async Task OnHqSelectedRegionChangedAsync()
    {
        _hqValidationMessage = null;
        _hqSuccessMessage = null;
        await LoadHeadquartersAsync();
        await LoadHeadquarterBudgetSummaryAsync();
    }

    // Loads only the headquarters belonging to the selected Region (existing
    // Headquarter.RegionId relationship - no new Headquarters master, nothing hardcoded),
    // merged with whatever has already been saved for this Region + FY so a reload shows
    // exactly the DB state.
    private async Task LoadHeadquartersAsync()
    {
        if (_hqSelectedRegionId <= 0 || _selectedFY.Length == 0)
        {
            _headquarters = new();
            return;
        }

        _headquarters =
            await Http.GetFromJsonAsync<List<HeadquarterBudgetDto>>(
                $"api/Budget/hq-budget?regionId={_hqSelectedRegionId}&fy={Uri.EscapeDataString(_selectedFY)}")
            ?? new();
    }

    // Same convention as OnRegionAmountChanged: negative values are clamped, and while over
    // the Region's own allocated amount, the message reports the remaining room excluding
    // the headquarter just edited so its own value is never double-counted.
    private void OnHqAmountChanged(HeadquarterBudgetDto item)
    {
        _hqSuccessMessage = null;

        if (item.BudgetAmount < 0)
            item.BudgetAmount = 0;

        if (_hasHqValidationError)
        {
            var otherHqTotal = TotalHeadquartersAllocated - item.BudgetAmount;
            var allowedForThisHq = Math.Max(0, SelectedRegionAmount - otherHqTotal);
            _hqValidationMessage =
                $"Headquarters allocation cannot exceed the remaining region budget of ₹{allowedForThisHq:N0}.";
        }
        else
        {
            _hqValidationMessage = null;
        }
    }

    // Full replace of every headquarter's allocation for the selected Region + FY, same
    // convention as Save Draft/Save Region Allocation - the backend independently
    // re-validates everything (region/headquarter existence, headquarter-belongs-to-region,
    // negatives, total vs. the region's own allocated amount) regardless of what the client
    // already checked.
    //
    // Validated BEFORE anything is sent to the server: if Total Budget (the applicable Region's
    // own allocation) / Allocated to Headquarters / Remaining Amount don't reconcile, neither the
    // detail allocation rows nor the HeadquarterBudgetSummary are touched, and no success message
    // is shown - this is a UX shortcut only, the server independently re-validates the identical
    // rule in both SaveHeadquarterBudgetSummary and SubmitHeadquarterBudgetSummary.
    private async Task SaveHeadquarterAllocationsAsync()
    {
        if (_isSavingHq || _hasHqValidationError || _hqSelectedRegionId <= 0 || _selectedFY.Length == 0)
            return;

        if (!TryValidateSummaryAmounts(SelectedRegionAmount, TotalHeadquartersAllocated, _hqSummaryRemaining, out var preCheckError))
        {
            _hqValidationMessage = preCheckError;
            _hqSuccessMessage = null;
            return;
        }

        _isSavingHq = true;
        try
        {
            var request = new SaveHeadquarterBudgetRequest
            {
                RegionId = _hqSelectedRegionId,
                FY = _selectedFY,
                Allocations = _headquarters.Select(h => new HeadquarterBudgetAllocationRequest
                {
                    HeadquarterId = h.HeadquarterId,
                    Amount = h.BudgetAmount
                }).ToList()
            };

            var response = await Http.PutAsJsonAsync("api/Budget/hq-budget", request);
            if (response.IsSuccessStatusCode)
            {
                _hqValidationMessage = null;
                // Reload from the DB rather than trusting local state, so the page
                // always shows exactly what was persisted.
                await LoadHeadquartersAsync();

                // Keep HeadquarterBudgetSummary's Total Budget/Allocated to Headquarters in sync
                // with what was just persisted above, then validate+submit it (TotalBudget ==
                // AllocatedAmount + RemainingAmount) every time the allocation is saved -
                // Headquarters has no separate Draft/Submit buttons, so this single save does
                // both. The success message only appears once the WHOLE operation (detail +
                // summary save + summary submit) has gone through - never on a partial/rejected save.
                var summarySaved = await TrySaveHeadquarterBudgetSummaryAsync();
                if (summarySaved && await TrySubmitHeadquarterBudgetSummaryAsync())
                    _hqSuccessMessage = "Headquarters budget allocation saved successfully.";
            }
            else
            {
                var raw = await response.Content.ReadAsStringAsync();
                _hqValidationMessage = ExtractMessage(raw);
            }
        }
        catch (Exception ex)
        {
            _hqValidationMessage = $"Failed to save: {ex.Message}";
        }
        finally
        {
            _isSavingHq = false;
        }
    }

    private static string ExtractMessage(string rawJson)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(rawJson);
            if (doc.RootElement.TryGetProperty("message", out var msg))
                return msg.GetString() ?? "Save failed.";
        }
        catch { }
        return "Save failed.";
    }

    // Mirrors BudgetController.TryValidateSummaryAmounts exactly, for immediate UX feedback only -
    // the server independently re-validates the same rules on every Save and Submit endpoint and
    // is the sole authority; this client copy can never be the only thing standing between an
    // unreconciled row and the database.
    private static bool TryValidateSummaryAmounts(decimal totalBudget, decimal allocatedAmount, decimal remainingAmount, out string error)
    {
        if (totalBudget <= 0)
        {
            error = "Total Budget must be greater than 0.";
            return false;
        }

        if (allocatedAmount <= 0)
        {
            error = "Allocated Amount must be greater than 0.";
            return false;
        }

        if (remainingAmount < 0)
        {
            error = "Remaining Amount cannot be negative.";
            return false;
        }

        if (totalBudget != allocatedAmount + remainingAmount)
        {
            var expectedRemaining = totalBudget - allocatedAmount;
            error = expectedRemaining >= 0
                ? $"Remaining Amount must be ₹{expectedRemaining:N0}. Current entered amount is ₹{remainingAmount:N0}."
                : $"Allocated Amount (₹{allocatedAmount:N0}) cannot exceed Total Budget (₹{totalBudget:N0}).";
            return false;
        }

        error = "";
        return true;
    }

}
