@page "/CreditLimit"
   
<div class="container-fluid py-4 px-0">
	<FormLoader />
	<div class="company-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
		<h3 class="fw-bold m-0 company-title">Credit Limit Proposal</h3>
	</div>
        
	<div class="form-card">
		<!-- Header -->
		<div class="d-flex justify-content-between align-items-center py-3 flex-wrap gap-2">
			<div class="card-header-title mb-0">
				<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/DealerSummary.svg" class="formicon" /> Dealer Summary
			</div>
		</div>
	
		<div class="row g-3">
			<div class="col-md-3">
				<div class="info-box">
					<div class="info-label">Firm Name</div>
					<div class="info-value">Sample Dealer Firm</div>
				</div>
			</div>
			<div class="col-md-3">
				<div class="info-box">
					<div class="info-label">Total Investment</div>
					<div class="info-value">50,00,000</div>
				</div>
			</div>
			<div class="col-md-3">
				<div class="info-box">
					<div class="info-label">Godown Capacity</div>
					<div class="info-value">5000 sq ft</div>
				</div>
			</div>
			<div class="col-md-3">
				<div class="info-box">
					<div class="info-label">Experience</div>
					<div class="info-value">10 years (10/12/2012)</div>
				</div>
			</div>
		</div>
	</div>

	<div class="form-card">
		<!-- Header -->
		<div class="d-flex justify-content-between align-items-center py-3 flex-wrap gap-2">
			<div class="card-header-title mb-0">
				<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/PropertyAssets.svg" class="formicon" /> Property Assets (Collateral)
			</div>
			<button class="btn btn-add" id="addExperienceBtn">
				<i class="bi bi-plus-lg"></i>
				Add Assets
			</button>
		</div>
		<div class="row g-3 mb-4">
			<div class="col-md-4">
				<div class="asset-box blue">
					<div class="asset-title">Primary Warehouse</div>
					<div class="asset-value">1,240</div>
					<div class="asset-badge">VERIFIED</div>
				</div>
			</div>
			<div class="col-md-4">
				<div class="asset-box pink">
					<div class="asset-title">Office Complex</div>
					<div class="asset-value">₹ 45.0 L</div>
					<div class="asset-badge">VERIFIED</div>
				</div>
			</div>
			<div class="col-md-4">
				<div class="asset-box gray">
					<div class="asset-title">Total Valuation</div>
					<div class="asset-value">₹ 1.65 Cr</div>
					<div class="asset-badge">LTV RATIO: 45%</div>
				</div>
			</div>
		</div>

		<div class="custom-tabs">
			<div class="tab-btn active">Fertilizer (MT/Value)</div>
			<div class="tab-btn">SP (MT / Value)</div>
			<div class="tab-btn">SP (Litre / Value)</div>
		</div>
		<div class="table-wrapper">
			<div class="table-responsive">
				<table class="spic-table">
					<thead>
						<tr>
							<th rowspan="2" style="min-width: 180px;">Product Name / Category</th>
							<th colspan="2" class="text-center border-start">2024 - 2025</th>
							<th colspan="2" class="text-center border-start">2025 - 2026</th>
							<th colspan="2" class="text-center border-start">2026 - 2027</th>
						</tr>
						<tr>
							<th class="text-center text-muted fw-normal border-start">Metric</th>
							<th class="text-center text-muted fw-normal">Lakhs</th>
							<th class="text-center text-muted fw-normal border-start">Metric</th>
							<th class="text-center text-muted fw-normal">Lakhs</th>
							<th class="text-center text-muted fw-normal border-start">Metric</th>
							<th class="text-center text-muted fw-normal">Lakhs</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var product in new[] { "NC Urea", "DAP 18:46:0", "NPK 20:20:0:13", "NPK 10:26:26", "NPK 15:15:15", "SSP - P & G", "MOP", "SP Sales Value (In Lakhs)", "WSF" })
						{
							<tr>
								<td class="fw-medium text-dark">@product</td>
								<td class="border-start"><div class="table-val-box">12450</div></td>
								<td><div class="table-val-box">12450</div></td>
								<td class="border-start"><div class="table-val-box">12450</div></td>
								<td><div class="table-val-box">12450</div></td>
								<td class="border-start"><div class="table-val-box">12450</div></td>
								<td><div class="table-val-box">12450</div></td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>

	<div class="form-card">
		<div class="d-flex justify-content-between align-items-center mb-4">
			<div class="section-title">
				<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/SalesPerformaReview.svg" class="formicon" /> Sales Performance Review
			</div>
			<button class="btn-verified">
				Values in Metric Tons (MT)
			</button>
		</div>

		<div class="row g-3">
			<div class="col-md-3">
				<div class="perf-card">
					<div class="perf-year">FY 2021-22</div>
					<div class="perf-val">₹ 1.2 Cr <span style="font-size:0.75rem; font-weight:normal; color:#6B7280;">MT</span></div>
				</div>
			</div>
			<div class="col-md-3">
				<div class="perf-card">
					<div class="perf-year">FY 2022-23</div>
					<div class="perf-val">₹ 1.3 Cr <span style="font-size:0.75rem; font-weight:normal; color:#6B7280;">MT</span></div>
				</div>
			</div>
			<div class="col-md-3">
				<div class="perf-card">
					<div class="perf-year">FY 2023-24</div>
					<div class="perf-val">₹ 1.2 Cr <span style="font-size:0.75rem; font-weight:normal; color:#6B7280;">MT</span></div>
				</div>
			</div>
			<div class="col-md-3">
				<div class="perf-card green position-relative">
					<div class="perf-year">FY 2024-25 (Est)</div>
					<div class="perf-val">2,400 <span style="font-size:0.75rem; font-weight:normal; color:#A7F3D0;">MT</span></div>
					<span class="badge bg-success bg-opacity-25 text-light position-absolute top-0 end-0 m-2" style="font-size:0.6rem;">+ 25% Growth</span>
				</div>
			</div>
		</div>
	</div>

	<div class="form-card">
		<!-- Header -->
		<div class="d-flex justify-content-between align-items-center py-3 flex-wrap gap-2">
			<div class="card-header-title mb-0">
				<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/OtherCompanies.svg" class="formicon" /> Other Companies Handled
			</div>

			<button class="btn btn-add" id="addExperienceBtn">
				<i class="bi bi-plus-lg"></i>
				Add Company
			</button>
		</div>
		<div class="row g-3">
			<div class="col-md-4">
				<label class="form-label-custom">Company</label>
				<select class="form-select-custom w-100">
					<option>Company Name</option>
				</select>
			</div>
			<div class="col-md-4">
				<label class="form-label-custom">Qty (MT)</label>
				<input type="number" class="form-control-custom w-100" placeholder="Quantity">
			</div>
			<div class="col-md-4">
				<label class="form-label-custom">Value (₹ Lakhs)</label>
				<input type="number" class="form-control-custom w-100" placeholder="Value">
			</div>
		</div>
	</div>

	<div class="form-card">
		<!-- Header -->
		<div class="d-flex justify-content-between align-items-center py-3 flex-wrap gap-2">
			<div class="card-header-title mb-0">
				<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/FiscalYear.svg" class="formicon" /> Fiscal Year 2023-24
			</div>

			<button class="btn-verified">
				<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/Verifiedicon.svg"
					 class="verifyicon" />
				Verified Units
			</button>
		</div>
		<div class="table-wrapper">
			<div class="table-responsive">
				<table class="spic-table">
					<thead>
						<tr>
							<th>Parameter</th>
							<th>Max Marks</th>
							<th>Own Retail Sales</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td class="text-muted">Total Fertilizer Sales Volume during last year</td>
							<td>15</td>
							<td>0</td>
						</tr>
						<tr>
							<td class="text-muted">Fertilizer Sales Balance with CPL during last year</td>
							<td>15</td>
							<td>0</td>
						</tr>
						<tr>
							<td class="text-muted">Total Fertilizer Sales Turnover during last year</td>
							<td>15</td>
							<td>0</td>
						</tr>
						<tr>
							<td class="text-muted">Fertilizer Sales Turnover with CPL during last year</td>
							<td>15</td>
							<td>0</td>
						</tr>
						<tr>
							<td class="text-muted">CP Turnover during last year</td>
							<td>10</td>
							<td>0</td>
						</tr>
						<tr>
							<td class="text-muted">Dealership tenure with CPL</td>
							<td>10</td>
							<td>0</td>
						</tr>
						<tr>
							<td class="text-muted">Monthly Average Net Credit due during last year</td>
							<td>10</td>
							<td>0</td>
						</tr>
						<tr>
							<td class="text-muted">Value of dealer's property - Fixed Assets</td>
							<td>15</td>
							<td>0</td>
						</tr>
						<tr>
							<td class="text-muted">Property Value as % of the Sales Turnover with CPL during last year BG/M + EC * 100</td>
							<td>15</td>
							<td>0</td>
						</tr>
						<tr>
							<td class="text-muted">Available Security BG / FD / Collateral</td>
							<td>15</td>
							<td>0</td>
						</tr>
						<tr>
							<td class="text-muted">Available Security as % of Sales Turnover with CPL during last year BG/M + EC * 100</td>
							<td>15</td>
							<td>0</td>
						</tr>
					</tbody>
					<tfoot>
						<tr>
							<td>Grand Total</td>
							<td>40,000,000</td>
							<td>40,750 MT</td>
						</tr>
					</tfoot>
				</table>
			</div>
		</div>
	</div>

	<div class="credit-footer">
		<div class="row align-items-center">
			<div class="col-md-5">
				<h4 class="mb-1 fw-bold">Recommended Credit Limit</h4>
				<p class="credit-desc mb-0">Based on the weighted score of 30/40 and property valuation of $1.45M, the system proposes the following limit.</p>
			</div>
                
			<div class="col-md-5">
				<div class="row g-3">
					<div class="col-6">
						<div class="credit-box">
							<div class="credit-box-label">Proposal Limit</div>
							<div class="credit-box-val">$350,000.00</div>
						</div>
					</div>
					<div class="col-6">
						<div class="credit-box">
							<div class="credit-box-label">Credit Multiplier</div>
							<div class="credit-box-val">2.4x</div>
						</div>
					</div>
				</div>
			</div>

			<div class="col-md-2">
				<button class="btn-white">Submit Proposal</button>
				<button class="btn-outline-green">Request Modification</button>
			</div>
		</div>
	</div>
	<CommanFooter />
</div>

  