@page "/CreditLimit"
@using System.Net.Http.Json
@using SPIC.Core.Entities
@using DealerReg = SPIC.Core.Entities.DealerRegistration
@using SPIC.MauiBlazorApp.Shared.FormFlow
@inject HttpClient Http
@inject NavigationManager Nav
<style>
	.table-wrapper {
		width: 100%;
		max-width: 100%;
		overflow: hidden;
	}

	.table-responsive {
		max-height: 420px; /* vertical inline scroller */
		overflow: auto; /* both x and y scroll */
		width: 100%;
		border: 1px solid #E5E7EB;
		border-radius: 12px;
	}

	/* Prevent table from squeezing too much */
	.spic-table {
		width: 100%;
		min-width: 900px; /* horizontal scroll for wide tables */
		border-collapse: separate;
		border-spacing: 0;
	}

		/* Sticky header */
		.spic-table thead th {
			position: sticky;
			top: 0;
			z-index: 5;
			background: #F9FAFB;
		}

		/* For tables with 2 header rows */
		.spic-table thead tr:nth-child(2) th {
			top: 42px; /* adjust if your first header row height differs */
			z-index: 6;
		}

		/* Keep footer visible style clean, not sticky */
		.spic-table tfoot td {
			background: #F9FAFB;
		}

	/* Better scrollbar behavior on mobile */
	.table-responsive::-webkit-scrollbar {
		height: 8px;
		width: 8px;
	}

	.table-responsive::-webkit-scrollbar-thumb {
		background: #CBD5E1;
		border-radius: 999px;
	}
	.spic-table tfoot td {
	background: #F9FAFB;
	border-top: 2px solid #E5E7EB;
	font-weight: 700;
	position: sticky;
	bottom: 0;
	z-index: 4;
}
</style>

<div class="container-fluid py-4 px-0">
	<FormLoader />

	@if (!string.IsNullOrEmpty(_message))
	{
		<div class="alert @(_isError ? "alert-danger" : "alert-success") alert-dismissible fade show mb-3" role="alert">
			@_message
			<button type="button" class="btn-close" @onclick='() => _message = null'></button>
		</div>
	}
	<!-- Dealer Summary -->
	<_Creditlimitdealersummary_Card Dealer="_dealer" LandTotal="LandTotal" BuildingTotal="BuildingTotal" />
	<!-- Existing Credit Limit -->
	<div class="form-card">
		<div class="d-flex justify-content-between align-items-center py-3 flex-wrap gap-2">
			<div class="card-header-title mb-0">
				<i class="bi bi-credit-card-2-front" style="color:#2563EB;"></i> Existing Credit Limit - Spic
			</div>
		</div>
		<div class="row g-3">
			<div class="col-md-4">
				<label class="form-label">Credit Limit Amount (₹) In Lakhs</label>
				<input type="number" class="form-control-custom w-100" step="0.01"
					   @bind="_proposal.SpicExistingCreditLimitAmount" />
			</div>
			<div class="col-md-4">
				<label class="form-label">Valid From</label>
				<input type="date" class="form-control-custom w-100"
					   @bind="_proposal.SpicExistingCreditLimitFrom" />
			</div>
			<div class="col-md-4">
				<label class="form-label">Valid To</label>
				<input type="date" class="form-control-custom w-100"
					   @bind="_proposal.SpicExistingCreditLimitTo" />
			</div>
		</div>
	</div>
	<!-- Property Assets (Collateral) -->
	<_CreditLimitPropertyAsset Dealer="_dealer" BankingTotal="BankingTotal" LandTotal="LandTotal" BuildingTotal="BuildingTotal" TotalPropertyValue="TotalPropertyValue" LoansTotal="LoansTotal" />
	<!-- Sales Performance Review -->
	<_creditLimitSalesPerformanceReview
    Categories="_categories"
    Units="_units"
    FinancialYears="_financialYears"
    SalesPerfRows="_salesPerfViewRows"
    SelectedCategoryId="_selectedCategoryId"
    SelectedUnitName="@_selectedUnitName"
    FY1="_proposal.FY1"
    FY2="_proposal.FY2"
    FY3="_proposal.FY3"
    SalesPlanTotalQty="@SalesPlanTotalQty"
    SalesPlanTotalAmount="@SalesPlanTotalAmount"
    SalesPlanCardTitle="SPIC Sales Plan (Current FY)"
    SalesPlanUnitName="MT"
    Company="SPIC"
    OnCategoryChanged="SelectCategory" />
	@if (_dealer.InSpic && (string.IsNullOrEmpty(SelectedCompany) || SelectedCompany == "SPIC"))
	{
		<!-- Details of Securities SPIC -->
		<div class="form-card">
			<div class="d-flex justify-content-between align-items-center py-3 flex-wrap gap-2">
				<div class="card-header-title mb-0">
					<i class="bi bi-shield-check" style="color:#2563EB;"></i> Details of Securities — SPIC
				</div>
			</div>
			<div class="table-wrapper">
				<div class="table-responsive">
					<table class="spic-table">
						<thead>
							<tr>
								<th style="width:25%;">Type</th>
								<th style="width:25%;">Number</th>
								<th style="width:25%;">Other Details</th>
								<th style="width:25%;">Amount (₹) In Lakhs</th>
							</tr>
						</thead>
						<tbody>
							<tr>
								<td class="fw-medium">Fixed Deposit with SPIC</td>
								<td><input type="text" class="form-control-custom w-100" placeholder="FD Number" @bind="_proposal.SpicFDNumber" /></td>
								<td><input type="text" class="form-control-custom w-100" placeholder="Details" @bind="_proposal.SpicFDOtherDetails" /></td>
								<td><input type="number" class="form-control-custom w-100" step="0.01" @bind="_proposal.SpicFDAmount" /></td>
							</tr>
							<tr>
								<td class="fw-medium">BG in favour of SPIC</td>
								<td><input type="text" class="form-control-custom w-100" placeholder="BG Number" @bind="_proposal.SpicBGNumber" /></td>
								<td><input type="text" class="form-control-custom w-100" placeholder="Details" @bind="_proposal.SpicBGOtherDetails" /></td>
								<td><input type="number" class="form-control-custom w-100" step="0.01" @bind="_proposal.SpicBGAmount" /></td>
							</tr>
							<tr>
								<td class="fw-medium">Collateral Security</td>
								<td><input type="text" class="form-control-custom w-100" placeholder="Number" @bind="_proposal.SpicCollateralNumber" /></td>
								<td><input type="text" class="form-control-custom w-100" placeholder="Details" @bind="_proposal.SpicCollateralOtherDetails" /></td>
								<td><input type="number" class="form-control-custom w-100" step="0.01" @bind="_proposal.SpicCollateralAmount" /></td>
							</tr>
							<tr>
								<td class="fw-medium">Trade Deposit As On Date</td>
								<td><input type="text" class="form-control-custom w-100" placeholder="Number" @bind="_proposal.SpicTradeDepositNumber" /></td>
								<td><input type="text" class="form-control-custom w-100" placeholder="Details" @bind="_proposal.SpicTradeDepositOtherDetails" /></td>
								<td><input type="number" class="form-control-custom w-100" step="0.01" @bind="_proposal.SpicTradeDepositAmount" /></td>
							</tr>
						</tbody>
						<tfoot>
							<tr>
								<td colspan="3"><strong>Total</strong></td>
								<td><strong>₹ @((_proposal.SpicFDAmount + _proposal.SpicBGAmount + _proposal.SpicCollateralAmount + _proposal.SpicTradeDepositAmount).ToString("N2"))</strong></td>
							</tr>
						</tfoot>
					</table>
				</div>
			</div>
		</div>

