@page "/CreditLimit"
@using System.Net.Http.Json
@using SPIC.Core.Entities
@using DealerReg = SPIC.Core.Entities.DealerRegistration
@inject HttpClient Http
@inject NavigationManager Nav

<div class="container-fluid py-4 px-0">
	<FormLoader />

	@if (!string.IsNullOrEmpty(_message))
	{
		<div class="alert @(_isError ? "alert-danger" : "alert-success") alert-dismissible fade show mb-3" role="alert">
			@_message
			<button type="button" class="btn-close" @onclick='() => _message = null'></button>
		</div>
	}

	<div class="company-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
		<h3 class="fw-bold m-0 company-title">Credit Limit Proposal</h3>
		<button class="btn btn-outline-secondary" @onclick="HandleSkip">
			<i class="bi bi-skip-forward"></i> Skip Credit Limit
		</button>
	</div>

	<!-- Dealer Summary -->
	<div class="form-card">
		<div class="d-flex justify-content-between align-items-center py-3 flex-wrap gap-2">
			<div class="card-header-title mb-0">
				<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/DealerSummary.svg" class="formicon" /> Dealer Summary
			</div>
		</div>
		<div class="row g-3">
			<div class="col-md-3">
				<div class="info-box">
					<div class="info-label">Firm Name</div>
					<div class="info-value">@(_dealer.FirmName ?? "-")</div>
				</div>
			</div>
			<div class="col-md-3">
				<div class="info-box">
					<div class="info-label">Total Investment</div>
					<div class="info-value">₹ @((_dealer.CapitalInvestment + _dealer.CashCreditLimit).ToString("N0"))</div>
				</div>
			</div>
			<div class="col-md-3">
				<div class="info-box">
					<div class="info-label">Godown Capacity</div>
					<div class="info-value">@((_dealer.OwnGodownCapacity + _dealer.RentGodownCapacity).ToString("N0")) MT</div>
				</div>
			</div>
			<div class="col-md-3">
				<div class="info-box">
					<div class="info-label">Experience</div>
					<div class="info-value">@_dealer.YearsofExperiance years (in SPIC @_dealer.DateOfAppointment.ToString("dd/MM/yyyy"))</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Existing Credit Limit -->
	<div class="form-card">
		<div class="d-flex justify-content-between align-items-center py-3 flex-wrap gap-2">
			<div class="card-header-title mb-0">
				<i class="bi bi-credit-card-2-front" style="color:#2563EB;"></i> Existing Credit Limit
			</div>
		</div>
		<div class="row g-3">
			<div class="col-md-4">
				<div class="info-box">
					<div class="info-label">Credit Limit Amount</div>
						<div class="info-value">₹ @_proposal.ExistingCreditLimitAmount.ToString("N2")</div>
						</div>
					</div>
					<div class="col-md-4">
						<div class="info-box">
							<div class="info-label">Valid From</div>
							<div class="info-value">@_proposal.ExistingCreditLimitFrom.ToString("dd/MM/yyyy")</div>
						</div>
					</div>
					<div class="col-md-4">
						<div class="info-box">
							<div class="info-label">Valid To</div>
							<div class="info-value">@_proposal.ExistingCreditLimitTo.ToString("dd/MM/yyyy")</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Property Assets (Collateral) -->
	<div class="form-card">
		<div class="d-flex justify-content-between align-items-center py-3 flex-wrap gap-2">
			<div class="card-header-title mb-0">
				<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/PropertyAssets.svg" class="formicon" /> Property Assets (Collateral)
			</div>
		</div>
		<div class="row g-3 mb-4">
			<div class="col-md-3">
				<div class="asset-box blue">
					<div class="asset-title"><img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/Bank.svg" class="verifyicon mb-1 mr-1" /> Banking</div>
					<div class="asset-value">₹ @BankingTotal.ToString("N0")</div>
				</div>
			</div>
			<div class="col-md-3">
				<div class="asset-box gray">
					<div class="asset-title"><img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/land.svg" class="verifyicon" /> Land</div>
					<div class="asset-value">₹ @LandTotal.ToString("N0")</div>
				</div>
			</div>
			<div class="col-md-3">
				<div class="asset-box pink">
					<div class="asset-title"><img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/Building.svg" class="verifyicon mb-1 mr-1" /> Building</div>
					<div class="asset-value">₹ @BuildingTotal.ToString("N0")</div>
				</div>
			</div>
			<div class="col-md-3">
				<div class="asset-box orange">
					<div class="asset-title"><img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/Movable.svg" class="verifyicon" /> Movable</div>
					<div class="asset-value">₹ @_dealer.AssetValue.ToString("N0")</div>
				</div>
			</div>
		</div>
		<div class="row g-3 mb-4">
			<div class="col-md-4">
				<div class="asset-box blue">
					<div class="asset-title">Total Valuation</div>
					<div class="asset-value">₹ @TotalPropertyValue.ToString("N0")</div>
					<div class="asset-badge">TOTAL ASSETS</div>
				</div>
			</div>
			<div class="col-md-4">
				<div class="asset-box pink">
					<div class="asset-title">Net Valuation</div>
					<div class="asset-value">₹ @((TotalPropertyValue - LoansTotal).ToString("N0"))</div>
					<div class="asset-badge">AFTER LIABILITIES</div>
				</div>
			</div>
			<div class="col-md-4">
				<div class="asset-box gray">
					<div class="asset-title">LTV Ratio</div>
					<div class="asset-value">@(TotalPropertyValue > 0 ? ((LoansTotal / TotalPropertyValue) * 100).ToString("N0") : "0")%</div>
					<div class="asset-badge">LOAN TO VALUE</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Sales Performance Review -->
	<div class="form-card">
		<div class="d-flex justify-content-between align-items-center mb-1">
			<div class="section-title">
				<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/SalesPerformaReview.svg" class="formicon" /> Sales Performance Review
			</div>
			<button class="btn-verified">
				Values in @_selectedUnitName
			</button>
		</div>

		<div class="financial-note-box">
			<div class="financial-note-badge">
				Only last 3 completed financial years are allowed
			</div>
		</div>

		<div class="custom-tabs">
			@foreach (var cat in _categories)
			{
				var catId = cat.Id;
				var unitName = _units.FirstOrDefault(u => u.Id == cat.UnitId)?.Name ?? "";
				<div class="tab-btn @(catId == _selectedCategoryId ? "active" : "")"
					 @onclick="() => SelectCategory(catId)" style="cursor:pointer;">
					@cat.Name (@unitName / Value)
				</div>
			}
		</div>

		<div class="table-wrapper">
			<div class="table-responsive">
				<table class="spic-table">
					<thead>
						<tr>
							<th rowspan="2" style="min-width: 180px;">Product Name / Category</th>
							@for (int fi = 0; fi < 3; fi++)
							{
								var fyIdx = fi;
								<th colspan="2" class="text-center border-start">
									<select class="form-select form-select-sm text-center"
											value="@GetSelectedFY(fyIdx)"
											@onchange="(e) => SetSelectedFY(fyIdx, e)">
										<option value="0">Select Year</option>
										@foreach (var fy in _financialYears)
										{
											<option value="@fy.Id">@fy.Name</option>
										}
									</select>
								</th>
							}
						</tr>
						<tr>
							@for (int fi = 0; fi < 3; fi++)
							{
								<th class="text-center text-muted fw-normal border-start">@_selectedUnitName</th>
								<th class="text-center text-muted fw-normal">Lakhs</th>
							}
						</tr>
					</thead>
					<tbody>
						@foreach (var row in _currentSalesPerfRows)
						{
							var r = row;
							var product = _products.FirstOrDefault(p => p.Id == r.ProductId);
							<tr>
								<td class="fw-medium text-dark">@(product?.Name ?? "Unknown")</td>
								@for (int fi = 0; fi < 3; fi++)
								{
									var fyIdx = fi;
									<td class="border-start">
										<input class="table-input" type="number" step="0.01"
											   value="@GetPerfQty(r, fyIdx)"
											   @onchange="(e) => SetPerfQty(r, fyIdx, e)" />
									</td>
									<td>
										<input class="table-input" type="number" step="0.01"
											   value="@GetPerfAmount(r, fyIdx)"
											   @onchange="(e) => SetPerfAmount(r, fyIdx, e)" />
									</td>
								}
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>

		<div class="row g-3">
			@for (int fi = 0; fi < 3; fi++)
			{
				var fyIdx = fi;
				var fyName = GetFYName(fyIdx);
				<div class="col-md-3">
					<div class="perf-card">
						<div class="perf-year">@fyName</div>
						<div class="perf-val">
							@GetFYTotalQty(fyIdx).ToString("N2") <span style="font-size:0.75rem; font-weight:normal; color:#6B7280;">@_selectedUnitName</span>
							/ ₹ @GetFYTotalAmount(fyIdx).ToString("N2") <span style="font-size:0.75rem; font-weight:normal; color:#6B7280;">Lakhs</span>
						</div>
					</div>
				</div>
			}
			<div class="col-md-3">
				<div class="perf-card green position-relative">
					<div class="perf-year">Sales Plan (Current FY)</div>
					<div class="perf-val">
						@SalesPlanTotalQty.ToString("N2") <span style="font-size:0.75rem; font-weight:normal; color:#A7F3D0;">@_selectedUnitName</span>
						/ ₹ @SalesPlanTotalAmount.ToString("N2") <span style="font-size:0.75rem; font-weight:normal; color:#A7F3D0;">Lakhs</span>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Details of Securities SPIC -->
	<div class="form-card">
		<div class="d-flex justify-content-between align-items-center py-3 flex-wrap gap-2">
			<div class="card-header-title mb-0">
				<i class="bi bi-shield-check" style="color:#2563EB;"></i> Details of Securities — SPIC
			</div>
		</div>
		<div class="table-wrapper">
			<div class="table-responsive">
				<table class="spic-table">
					<thead>
						<tr>
							<th style="width:25%;">Type</th>
							<th style="width:25%;">Number</th>
							<th style="width:25%;">Other Details</th>
							<th style="width:25%;">Amount (₹) In Lakhs</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td class="fw-medium">Fixed Deposit with SPIC</td>
							<td><input type="text" class="form-control-custom w-100" placeholder="FD Number" @bind="_proposal.SpicFDNumber" /></td>
							<td><input type="text" class="form-control-custom w-100" placeholder="Details" @bind="_proposal.SpicFDOtherDetails" /></td>
							<td><input type="number" class="form-control-custom w-100" step="0.01" @bind="_proposal.SpicFDAmount" /></td>
						</tr>
						<tr>
							<td class="fw-medium">BG in favour of SPIC</td>
							<td><input type="text" class="form-control-custom w-100" placeholder="BG Number" @bind="_proposal.SpicBGNumber" /></td>
							<td><input type="text" class="form-control-custom w-100" placeholder="Details" @bind="_proposal.SpicBGOtherDetails" /></td>
							<td><input type="number" class="form-control-custom w-100" step="0.01" @bind="_proposal.SpicBGAmount" /></td>
						</tr>
						<tr>
							<td class="fw-medium">Collateral Security</td>
							<td><input type="text" class="form-control-custom w-100" placeholder="Number" @bind="_proposal.SpicCollateralNumber" /></td>
							<td><input type="text" class="form-control-custom w-100" placeholder="Details" @bind="_proposal.SpicCollateralOtherDetails" /></td>
							<td><input type="number" class="form-control-custom w-100" step="0.01" @bind="_proposal.SpicCollateralAmount" /></td>
						</tr>
						<tr>
							<td class="fw-medium">Trade Deposit As On Date</td>
							<td><input type="text" class="form-control-custom w-100" placeholder="Number" @bind="_proposal.SpicTradeDepositNumber" /></td>
							<td><input type="text" class="form-control-custom w-100" placeholder="Details" @bind="_proposal.SpicTradeDepositOtherDetails" /></td>
							<td><input type="number" class="form-control-custom w-100" step="0.01" @bind="_proposal.SpicTradeDepositAmount" /></td>
						</tr>
					</tbody>
					<tfoot>
						<tr>
							<td colspan="3"><strong>Total</strong></td>
							<td><strong>₹ @((_proposal.SpicFDAmount + _proposal.SpicBGAmount + _proposal.SpicCollateralAmount + _proposal.SpicTradeDepositAmount).ToString("N2"))</strong></td>
						</tr>
					</tfoot>
				</table>
			</div>
		</div>
	</div>

	<!-- SPIC Valuation -->
	<div class="form-card">
		<div class="d-flex justify-content-between align-items-center py-3 flex-wrap gap-2">
			<div class="card-header-title mb-0">
				<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/FiscalYear.svg" class="formicon" /> SPIC Valuation
			</div>
		</div>
		<div class="table-wrapper">
			<div class="table-responsive">
				<table class="spic-table">
					<thead>
						<tr>
							<th rowspan="2" style="width:4%;">S.No</th>
							<th rowspan="2">Critical Parameter</th>
							<th rowspan="2" style="width:10%;">Measure</th>
							<th rowspan="2" style="width:7%;">Weightage (%)</th>
							<th rowspan="2" style="width:7%;">Unit &amp; Marks</th>
							<th colspan="5" class="text-center">Norms / Marks</th>
							<th colspan="2" class="text-center">Dealer Score</th>
						</tr>
						<tr>
							<th class="text-center">1</th>
							<th class="text-center">2</th>
							<th class="text-center">3</th>
							<th class="text-center">4</th>
							<th class="text-center">5</th>
							<th class="text-center" style="width:8%;">Value</th>
							<th class="text-center" style="width:6%;">Marks</th>
						</tr>
					</thead>
					<tbody>
						<!-- 1. Total Urea Sales Volume -->
						<tr>
							<td rowspan="2" class="text-center align-middle">1</td>
							<td rowspan="2" class="align-middle">Total Urea Sales Volume during last year</td>
							<td rowspan="8" class="text-center align-middle text-muted" style="vertical-align:middle;">Fertilizer Business Involvement</td>
							<td rowspan="2" class="text-center align-middle">10</td>
							<td class="text-center">MT</td>
							<td class="text-center">&gt;3000</td>
							<td class="text-center">&gt;1500</td>
							<td class="text-center">&gt;1000</td>
							<td class="text-center">&gt;500</td>
							<td class="text-center">&lt;500</td>
							<td rowspan="2" class="align-middle">
								<input type="number" class="form-control-custom w-100" step="0.01" value="@_spicValues[0]" @onchange="(e) => OnSpicValueChanged(0, e)" />
							</td>
							<td rowspan="2" class="text-center align-middle">
								<div class="table-val-box">@GetSpicMark(0).ToString("N0")</div>
							</td>
						</tr>
						<tr>
							<td class="text-center text-muted">Marks</td>
							<td class="text-center">10</td><td class="text-center">8</td><td class="text-center">6</td><td class="text-center">4</td><td class="text-center">2</td>
						</tr>
						<!-- 2. Urea Sales Volume with SPIC -->
						<tr>
							<td rowspan="2" class="text-center align-middle">2</td>
							<td rowspan="2" class="align-middle">Urea Sales Volume with SPIC during last year</td>
							<td rowspan="2" class="text-center align-middle">10</td>
							<td class="text-center">MT</td>
							<td class="text-center">&gt;500</td>
							<td class="text-center">&gt;300</td>
							<td class="text-center">&gt;200</td>
							<td class="text-center">&gt;100</td>
							<td class="text-center">&lt;100</td>
							<td rowspan="2" class="align-middle">
								<input type="number" class="form-control-custom w-100" step="0.01" value="@_spicValues[1]" @onchange="(e) => OnSpicValueChanged(1, e)" />
							</td>
							<td rowspan="2" class="text-center align-middle">
								<div class="table-val-box">@GetSpicMark(1).ToString("N0")</div>
							</td>
						</tr>
						<tr>
							<td class="text-center text-muted">Marks</td>
							<td class="text-center">10</td><td class="text-center">8</td><td class="text-center">6</td><td class="text-center">4</td><td class="text-center">2</td>
						</tr>
						<!-- 3. Total Urea Sales Turnover -->
						<tr>
							<td rowspan="2" class="text-center align-middle">3</td>
							<td rowspan="2" class="align-middle">Total Urea Sales Turnover during last year</td>
							<td rowspan="2" class="text-center align-middle">10</td>
							<td class="text-center">Rs. Lakhs</td>
							<td class="text-center">&gt;200</td>
							<td class="text-center">&gt;100</td>
							<td class="text-center">&gt;60</td>
							<td class="text-center">&gt;30</td>
							<td class="text-center">&lt;30</td>
							<td rowspan="2" class="align-middle">
								<input type="number" class="form-control-custom w-100" step="0.01" value="@_spicValues[2]" @onchange="(e) => OnSpicValueChanged(2, e)" />
							</td>
							<td rowspan="2" class="text-center align-middle">
								<div class="table-val-box">@GetSpicMark(2).ToString("N0")</div>
							</td>
						</tr>
						<tr>
							<td class="text-center text-muted">Marks</td>
							<td class="text-center">10</td><td class="text-center">8</td><td class="text-center">6</td><td class="text-center">4</td><td class="text-center">2</td>
						</tr>
						<!-- 4. Urea Sales Turnover with SPIC -->
						<tr>
							<td rowspan="2" class="text-center align-middle">4</td>
							<td rowspan="2" class="align-middle">Urea Sales Turnover with SPIC during last year</td>
							<td rowspan="2" class="text-center align-middle">20</td>
							<td class="text-center">Rs. Lakhs</td>
							<td class="text-center">&gt;30</td>
							<td class="text-center">&gt;20</td>
							<td class="text-center">&gt;15</td>
							<td class="text-center">&gt;10</td>
							<td class="text-center">&lt;10</td>
							<td rowspan="2" class="align-middle">
								<input type="number" class="form-control-custom w-100" step="0.01" value="@_spicValues[3]" @onchange="(e) => OnSpicValueChanged(3, e)" />
							</td>
							<td rowspan="2" class="text-center align-middle">
								<div class="table-val-box">@GetSpicMark(3).ToString("N0")</div>
							</td>
						</tr>
						<tr>
							<td class="text-center text-muted">Marks</td>
							<td class="text-center">20</td><td class="text-center">16</td><td class="text-center">12</td><td class="text-center">8</td><td class="text-center">4</td>
						</tr>
						<!-- 5. Dealership tenure -->
						<tr>
							<td rowspan="2" class="text-center align-middle">5</td>
							<td rowspan="2" class="align-middle">Dealership tenure with SPIC</td>
							<td rowspan="2" class="text-center align-middle text-muted">Loyalty to SPIC</td>
							<td rowspan="2" class="text-center align-middle">10</td>
							<td class="text-center">Years</td>
							<td class="text-center">&gt;10</td>
							<td class="text-center">&gt;8</td>
							<td class="text-center">&gt;6</td>
							<td class="text-center">&gt;4</td>
							<td class="text-center">&gt;1</td>
							<td rowspan="2" class="align-middle">
								<input type="number" class="form-control-custom w-100" step="0.01" value="@_spicValues[4]" @onchange="(e) => OnSpicValueChanged(4, e)" />
							</td>
							<td rowspan="2" class="text-center align-middle">
								<div class="table-val-box">@GetSpicMark(4).ToString("N0")</div>
							</td>
						</tr>
						<tr>
							<td class="text-center text-muted">Marks</td>
							<td class="text-center">10</td><td class="text-center">8</td><td class="text-center">6</td><td class="text-center">4</td><td class="text-center">2</td>
						</tr>
						<!-- 6. Monthly Average Net Overdues -->
						<tr>
							<td rowspan="2" class="text-center align-middle">6</td>
							<td rowspan="2" class="align-middle">Monthly Average Net Overdues during last year</td>
							<td rowspan="2" class="text-center align-middle"></td>
							<td rowspan="2" class="text-center align-middle">20</td>
							<td class="text-center">Rs. Lakhs</td>
							<td class="text-center">&lt;1</td>
							<td class="text-center">&lt;5</td>
							<td class="text-center">&lt;10</td>
							<td class="text-center">&lt;20</td>
							<td class="text-center">&lt;30</td>
							<td rowspan="2" class="align-middle">
								<input type="number" class="form-control-custom w-100" step="0.01" value="@_spicValues[5]" @onchange="(e) => OnSpicValueChanged(5, e)" />
							</td>
							<td rowspan="2" class="text-center align-middle">
								<div class="table-val-box">@GetSpicMark(5).ToString("N0")</div>
							</td>
						</tr>
						<tr>
							<td class="text-center text-muted">Marks</td>
							<td class="text-center">20</td><td class="text-center">16</td><td class="text-center">12</td><td class="text-center">8</td><td class="text-center">4</td>
						</tr>
