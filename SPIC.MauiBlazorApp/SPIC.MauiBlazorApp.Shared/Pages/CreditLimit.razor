								</td>
								<td rowspan="2" class="text-center align-middle">
									<div class="table-val-box">@GetSpicMark(4).ToString("N0")</div>
								</td>
							</tr>
							<tr>
								<td class="text-center text-muted">Marks</td>
								<td class="text-center">10</td><td class="text-center">8</td><td class="text-center">6</td><td class="text-center">4</td><td class="text-center">2</td>
							</tr>
							<!-- 6. Monthly Average Net Overdues -->
							<tr>
								<td rowspan="2" class="text-center align-middle">6</td>
								<td rowspan="2" class="align-middle">Monthly Average Net Overdues during last year</td>
