	private static double CalculateMark(int idx, double v) => idx switch
	{
		0 => v > 3000 ? 10 : v > 1500 ? 8 : v > 1000 ? 6 : v > 500 ? 4 : 2,
		1 => v > 500 ? 10 : v > 300 ? 8 : v > 200 ? 6 : v > 100 ? 4 : 2,
		2 => v > 200 ? 10 : v > 100 ? 8 : v > 60 ? 6 : v > 30 ? 4 : 2,
		3 => v > 30 ? 20 : v > 20 ? 16 : v > 15 ? 12 : v > 10 ? 8 : 4,
		4 => v > 10 ? 10 : v > 8 ? 8 : v > 6 ? 6 : v > 4 ? 4 : 2,
		5 => v < 1 ? 20 : v < 5 ? 16 : v < 10 ? 12 : v < 20 ? 8 : 4,
		6 => 0,
		7 => v > 50 ? 10 : v > 40 ? 8 : v > 30 ? 6 : v > 20 ? 4 : v > 10 ? 2 : 0,
		8 => 0,
		9 => v > 10 ? 10 : v > 8 ? 8 : v > 6 ? 6 : v > 4 ? 4 : 2,
		_ => 0
	};

	private double GetSpicMark(int idx)
	{
		if (idx == 7 || idx == 9)
		{
			bool depEntered = idx == 7
				? _spicValueEntered[6] && _spicValueEntered[3]
				: _spicValueEntered[8] && _spicValueEntered[3];
			return !depEntered ? 0 : CalculateMark(idx, _spicValues[idx]);
		}
		return !_spicValueEntered[idx] ? 0 : CalculateMark(idx, _spicValues[idx]);
	}

	private async Task HandleNext()
	{
		if (IsViewOnly)
		{
			Loading.Show();
			// Dashboard entry uses separate pages: SPIC review "Next" forwards to
			// the standalone GreenStar page when the dealer also has GreenStar.
			if (IsDashboardCreditLimitMode)
			{
				if (_dealer.InGreenStar)
					Nav.NavigateTo($"/CreditLimitForGreenStar?dealerId={DealerId}&mode=view{SourceParam}");
				else
					Nav.NavigateTo("/Dashboard");
			}
			else
				Nav.NavigateTo($"/CreditLimitForGreenStar?dealerId={DealerId}&mode=view{FlowParam}{SourceParam}");
			return;
		}
		if (!DealerId.HasValue || DealerId.Value <= 0)
		{
			ShowMessage("Dealer ID is required.", true);
			return;
		}

		_isSaving = true;
		try
		{
			if (IsNewDealerFlow)
			{
				_dealer.DealershipApplicationFeeAmount = NewDealerApplicationFeeAmount;

				var hasError = _dealer.InSpic &&
					(_dealer.DealershipApplicationFeeBankId is null or <= 0 ||
					 string.IsNullOrWhiteSpace(_dealer.DealershipApplicationFeeDDNumber) ||
					 !_dealer.DealershipApplicationFeeDDDate.HasValue ||
					 _dealer.DealershipApplicationFeeAmount != NewDealerApplicationFeeAmount ||
					 string.IsNullOrWhiteSpace(_dealer.DealershipApplicationFeePayableAt) ||
					 string.IsNullOrWhiteSpace(_dealer.DealershipApplicationFeeFilePath) ||
					 string.IsNullOrWhiteSpace(_dealer.SpicTradeDepositDDNumber) ||
					 _dealer.SpicTradeDepositDDBankId is null or <= 0 ||
					 !_dealer.SpicTradeDepositDDDate.HasValue ||
					 !_dealer.SpicTradeDepositDDAmount.HasValue ||
					 _dealer.SpicTradeDepositDDAmount <= 0 ||
					 string.IsNullOrWhiteSpace(_dealer.SpicTradeDepositFilePath));

				FormStepData.MarkStepError(10, hasError);
				if (hasError)
				{
					ShowMessage("Complete all SPIC Application Fee and Trade Deposit fields, and upload both attachments.", true);
					return;
				}

				var dealerSave = await Http.PutAsJsonAsync($"api/DealerRegistration/{DealerId}", _dealer);
				dealerSave.EnsureSuccessStatusCode();
				Nav.NavigateTo($"/CreditLimitForGreenStar?dealerId={DealerId}{FlowParam}");
				return;
			}

			_proposal.DealerId = DealerId.Value;
			_proposal.Q1Mark = GetSpicMark(0);
			_proposal.Q2Mark = GetSpicMark(1);
			_proposal.Q3Mark = GetSpicMark(2);
			_proposal.Q4Mark = GetSpicMark(3);
			_proposal.Q5Mark = GetSpicMark(4);
			_proposal.SpicMonthlyAvgNetOverdues = _spicValueEntered[5] ? _spicValues[5] : null;
			_proposal.Q6Mark = GetSpicMark(5);
			_proposal.Q7Mark = GetSpicMark(6);
			_proposal.Q8Mark = GetSpicMark(7);
			_proposal.Q9Mark = GetSpicMark(8);
			_proposal.Q10Mark = GetSpicMark(9);
			_proposal.Q11Mark = SpicTotalMark;

			if (_proposal.Id > 0)
			{
				var response = await Http.PutAsJsonAsync($"api/DealerCreditLimitProposal/{_proposal.Id}", _proposal);
				response.EnsureSuccessStatusCode();
			}
			else
			{
				var response = await Http.PostAsJsonAsync("api/DealerCreditLimitProposal", _proposal);
				if (response.IsSuccessStatusCode)
				{
					var result = await response.Content.ReadFromJsonAsync<CreateResponse<DealerCreditLimitProposal>>();
					if (result?.Data != null)
						_proposal.Id = result.Data.Id;
				}
			}

			await SaveSpicCreditLimitHistoryAsync();

			FormStepData.MarkStepError(11, false);

			if (IsDashboardCreditLimitMode)
			{
				// Separate-page flow: after SPIC is saved, forward to the standalone
				// GreenStar page (its own Next returns to the Dashboard).
				if (_dealer.InGreenStar)
				{
					Nav.NavigateTo($"/CreditLimitForGreenStar?dealerId={DealerId}{SourceParam}");
					return;
				}

				Nav.NavigateTo("/Dashboard");
				return;
			}

			Nav.NavigateTo($"/CreditLimitForGreenStar?dealerId={DealerId}{FlowParam}");
		}
		catch (Exception ex)
		{
			ShowMessage($"Failed to save: {ex.Message}", true);
		}
		finally
		{
			_isSaving = false;
		}
	}

