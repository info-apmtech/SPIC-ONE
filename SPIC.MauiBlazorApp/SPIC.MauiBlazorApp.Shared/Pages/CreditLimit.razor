@code {
	[SupplyParameterFromQuery(Name = "dealerId")]
	public int? DealerId { get; set; }
	public string? SelectedCompany { get; set; }

	private DealerReg _dealer = new();
	private List<DealerAssetBank> _bankAssets = new();
	private List<DealerAssetLand> _landAssets = new();
	private List<DealerAssetBuilding> _buildingAssets = new();
	private List<DealerLoanLiabilities> _loanLiabilities = new();
	private List<FinancialYear> _financialYears = new();
	private List<Category> _categories = new();
	private List<Unit> _units = new();
	private List<Product> _products = new();
	private List<SalesPlanningInDealerRegistration> _salesPlanData = new();

	private DealerCreditLimitProposal _proposal = new();
	private List<DealerCreditLimitSales> _creditLimitSalesData = new();
	private List<SalesPerfViewRow> _salesPerfViewRows = new();
	private List<AnnualSaleDataLastFYofDealerRegistration> _annualSalesData = new();

	private int _selectedCategoryId;
	private string _selectedUnitName = "MT";
	private bool _isSaving;
	private string? _message;
	private bool _isError;
	private double[] _spicValues = new double[10];
	private bool[] _spicValueEntered = new bool[10];

	// Asset totals
	private decimal BankingTotal => _bankAssets.Sum(b => b.Value);
	private decimal LandTotal => _landAssets.Sum(l => l.PropertyValue);
	private decimal BuildingTotal => _buildingAssets.Sum(b => b.PropertyValue);
	private decimal TotalPropertyValue => BankingTotal + LandTotal + BuildingTotal + _dealer.AssetValue;
	private decimal LoansTotal => _loanLiabilities.Sum(l => l.LoanValue);

	// Sales Plan totals
	private IEnumerable<SalesPlanningInDealerRegistration> SpicSalesPlanRows =>
    _salesPlanData.Where(row =>
        IsFertilizerSalesPlanRow(row) &&
        IsUreaSalesPlanRow(row));

private decimal SalesPlanTotalQty =>
    SpicSalesPlanRows.Sum(GetSalesPlanRowTotalQty);

private decimal SalesPlanTotalAmount =>
    SpicSalesPlanRows.Sum(GetSalesPlanRowTotalAmount);

private static decimal GetSalesPlanRowTotalQty(SalesPlanningInDealerRegistration r) =>
    r.AprilQty + r.MayQty + r.JuneQty + r.JulyQty +
    r.AugustQty + r.SeptemberQty + r.OctoberQty + r.NovemberQty +
    r.DecemberQty + r.JanuaryQty + r.FebruaryQty + r.MarchQty;

private static decimal GetSalesPlanRowTotalAmount(SalesPlanningInDealerRegistration r) =>
    r.AprilAmount + r.MayAmount + r.JuneAmount + r.JulyAmount +
    r.AugustAmount + r.SeptemberAmount + r.OctoberAmount + r.NovemberAmount +
    r.DecemberAmount + r.JanuaryAmount + r.FebruaryAmount + r.MarchAmount;

private bool IsFertilizerSalesPlanRow(SalesPlanningInDealerRegistration row)
{
    var category = _categories.FirstOrDefault(c => c.Id == row.CategoryId);

    return category?.Name != null &&
           category.Name.Contains("Fertilizer", StringComparison.OrdinalIgnoreCase);
}

private bool IsUreaSalesPlanRow(SalesPlanningInDealerRegistration row)
{
    var product = _products.FirstOrDefault(p => p.Id == row.ProductId);

    return product?.Name != null &&
           product.Name.Contains("Urea", StringComparison.OrdinalIgnoreCase);
}

	// Credit limit calculations — SPIC
	private double SpicTotalMark => Enumerable.Range(0, 10).Where(i => _valuationParams[i].Weightage > 0).Sum(i => GetSpicMark(i));
	private double SpicScorePercent => SpicTotalMark;
	private double SpicCreditPercent => GetCreditPercentFromScore(SpicScorePercent);
	private decimal SpicSalesTurnover => (decimal)_spicValues[3];
	private decimal SpicProposedLimit => SpicSalesTurnover * (decimal)(SpicCreditPercent / 100.0);
	private decimal SpicTotalCreditLimit => SpicProposedLimit + _proposal.AdditionalCreditLimit;
	private double SpicCreditMultiplier => SpicSalesTurnover > 0 ? (double)(SpicTotalCreditLimit / SpicSalesTurnover) : 0;

	private static double GetCreditPercentFromScore(double scorePercent) => scorePercent switch
	{
		>= 75 => 25,
		>= 60 => 20,
		>= 45 => 15,
		>= 30 => 10,
		_ => 0
	};

	private static readonly ValuationParam[] _valuationParams =
	[
		new("Total Fertilizer Sales Volume during last year", 10, "MT", false),
		new("Fertilizer Sales Volume with SPIC during last year", 10, "MT", false),
		new("Total Fertilizer Sales Turnover during last year", 10, "Rs. Lakhs", false),
		new("Fertilizer Sales Turnover with SPIC during last year", 20, "Rs. Lakhs", false),
		new("Dealership tenure with SPIC", 10, "Years", false),
		new("Monthly Average Net Overdues during last year", 20, "Rs. Lakhs", false),
		new("Value of dealer's property - Fixed Assets", 0, "Rs. Lakhs", false),
		new("Property Value as % of Sales Turnover with SPIC (7/4 x 100)", 10, "%", true),
		new("Available Security (SD / FD / BG / Collateral)", 0, "Rs. Lakhs", false),
		new("Available Security as % of Sales Turnover with SPIC (9/4 x 100)", 10, "%", true),
	];

	protected override async Task OnInitializedAsync()
	{
		SelectedCompany = "SPIC";

		var fyTask = SafeGetAsync<List<FinancialYear>>("api/FinancialYear");
		var catTask = SafeGetAsync<List<Category>>("api/Category");
		var unitTask = SafeGetAsync<List<Unit>>("api/Unit");
		var prodTask = SafeGetAsync<List<Product>>("api/Product");

		if (DealerId.HasValue && DealerId.Value > 0)
		{
			var dealerTask = SafeGetAsync<DealerReg>($"api/DealerRegistration/{DealerId}");
			var bankTask = SafeGetAsync<List<DealerAssetBank>>("api/DealerAssetBank/all");
			var landTask = SafeGetAsync<List<DealerAssetLand>>("api/DealerAssetLand/all");
			var buildingTask = SafeGetAsync<List<DealerAssetBuilding>>("api/DealerAssetBuilding/all");
			var loanTask = SafeGetAsync<List<DealerLoanLiabilities>>("api/DealerLoanLiabilities/all");
			var salesPlanTask = SafeGetAsync<List<SalesPlanningInDealerRegistration>>("api/SalesPlanning/all");
			var proposalTask = SafeGetAsync<List<DealerCreditLimitProposal>>("api/DealerCreditLimitProposal/all");

			await Task.WhenAll(
				fyTask, catTask, unitTask, prodTask,
				dealerTask, bankTask, landTask, buildingTask,
				loanTask, salesPlanTask, proposalTask
			);

			_financialYears = fyTask.Result ?? new();
			_categories = catTask.Result ?? new();
			_units = unitTask.Result ?? new();
			_products = prodTask.Result ?? new();

			var dealerId = DealerId.Value;

			_dealer = dealerTask.Result ?? new();

			_bankAssets = (bankTask.Result ?? new())
				.Where(a => a.DealerId == dealerId)
				.ToList();

			_landAssets = (landTask.Result ?? new())
				.Where(a => a.DealerId == dealerId)
				.ToList();

			_buildingAssets = (buildingTask.Result ?? new())
				.Where(a => a.DealerId == dealerId)
				.ToList();

			_loanLiabilities = (loanTask.Result ?? new())
				.Where(a => a.DealerId == dealerId)
				.ToList();

			_salesPlanData = (salesPlanTask.Result ?? new())
				.Where(s => s.DealerId == dealerId)
				.ToList();

			var proposals = proposalTask.Result ?? new();

			var existing = proposals.FirstOrDefault(p => p.DealerId == dealerId);

			if (existing != null)
				_proposal = existing;

			InitValuesFromData();
		}
		else
		{
			await Task.WhenAll(fyTask, catTask, unitTask, prodTask);

			_financialYears = fyTask.Result ?? new();
			_categories = catTask.Result ?? new();
			_units = unitTask.Result ?? new();
			_products = prodTask.Result ?? new();
		}

		if (_categories.Count > 0)
{
    _selectedCategoryId = GetDefaultCategoryIdForCompany();
    UpdateSelectedUnit();
}

SetFixedFinancialYears();
await LoadCreditLimitSalesData();

if (DealerId.HasValue && DealerId.Value > 0)
{
    await LoadSpicValuationDefaultValues();
}
	}

	private async Task<T?> SafeGetAsync<T>(string url)
	{
		try { return await Http.GetFromJsonAsync<T>(url); }
		catch { return default; }
	}
	private int GetDefaultCategoryIdForCompany()
{
    if (!string.IsNullOrEmpty(SelectedCompany) &&
        SelectedCompany.Equals("SPIC", StringComparison.OrdinalIgnoreCase))
    {
        var fertilizerCategory = _categories.FirstOrDefault(c =>
            !string.IsNullOrWhiteSpace(c.Name) &&
            c.Name.Contains("Fertilizer", StringComparison.OrdinalIgnoreCase));

        if (fertilizerCategory != null)
            return fertilizerCategory.Id;
    }

    return _categories.FirstOrDefault()?.Id ?? 0;
}
	private void InitValuesFromData()
	{
		RecalculateSpicPercentages();
	}

	private void RecalculateSpicPercentages()
	{
		if (_spicValues[3] > 0)
		{
			_spicValues[7] = (_spicValues[6] / _spicValues[3]) * 100;
			_spicValues[9] = (_spicValues[8] / _spicValues[3]) * 100;
		}
		else
		{
			_spicValues[7] = 0;
			_spicValues[9] = 0;
		}
	}

	private async Task SelectCategory(int categoryId)
	{
		_selectedCategoryId = categoryId;
		UpdateSelectedUnit();
		await LoadCreditLimitSalesData();
	}

	private async Task LoadCreditLimitSalesData()
	{
		if (_dealer.Id <= 0 || _selectedCategoryId <= 0)
		{
			_creditLimitSalesData = new();
			BuildSalesPerfRows();
			return;
		}

		var fyIds = new[]
		{
			_proposal.FY1,
			_proposal.FY2,
			_proposal.FY3
		}
		.Where(x => x > 0)
		.Distinct()
		.ToList();

		if (fyIds.Count == 0)
		{
			_creditLimitSalesData = new();
			BuildSalesPerfRows();
			return;
		}

		var fyQuery = string.Join(",", fyIds);

		var url =
			$"api/creditlimitsales/by-filter" +
			$"?customerId={_dealer.Id}" +
			$"&categoryId={_selectedCategoryId}" +
			$"&financialYearIds={fyQuery}";

		_creditLimitSalesData =
			await SafeGetAsync<List<DealerCreditLimitSales>>(url) ?? new();

		BuildSalesPerfRows();
	}

	private DealerCreditLimitSales? GetCreditLimitSales(int productId, int financialYearId)
	{
		if (financialYearId <= 0)
			return null;

		return _creditLimitSalesData.FirstOrDefault(x =>
			x.CustomerId == _dealer.Id &&
			x.ProductGroupId == _selectedCategoryId &&
			x.SubGroupId == productId &&
			x.FinancialYearId == financialYearId);
	}

	private static decimal ConvertToLakhs(double grossAmount)
	{
		return (decimal)grossAmount / 100000;
	}

	private void UpdateSelectedUnit()
	{
		var cat = _categories.FirstOrDefault(c => c.Id == _selectedCategoryId);
		if (cat != null)
			_selectedUnitName = _units.FirstOrDefault(u => u.Id == cat.UnitId)?.Name ?? "MT";
	}

	private void BuildSalesPerfRows()
	{
		_salesPerfViewRows = new();

		var categoryProducts = _products
			.Where(p => p.CategoryId == _selectedCategoryId)
			.ToList();

		foreach (var product in categoryProducts)
		{
			var row = new SalesPerfViewRow
			{
				ProductId = product.Id,
				ProductName = product.Name
			};

			var fy1Data = GetCreditLimitSales(product.Id, _proposal.FY1);
			var fy2Data = GetCreditLimitSales(product.Id, _proposal.FY2);
			var fy3Data = GetCreditLimitSales(product.Id, _proposal.FY3);

			if (fy1Data != null)
			{
				row.FY1Qty = fy1Data.Quantity;
				row.FY1Amount = ConvertToLakhs(fy1Data.GrossAmount);
			}

			if (fy2Data != null)
			{
				row.FY2Qty = fy2Data.Quantity;
				row.FY2Amount = ConvertToLakhs(fy2Data.GrossAmount);
			}

			if (fy3Data != null)
			{
				row.FY3Qty = fy3Data.Quantity;
				row.FY3Amount = ConvertToLakhs(fy3Data.GrossAmount);
			}

			_salesPerfViewRows.Add(row);
		}
	}

	private int GetSelectedFY(int fyIdx) => fyIdx switch
	{
		0 => _proposal.FY1,
		1 => _proposal.FY2,
		2 => _proposal.FY3,
		_ => 0
	};

	private void SetSelectedFY(int fyIdx, ChangeEventArgs e)
	{
		if (!int.TryParse(e.Value?.ToString(), out var val)) return;
		switch (fyIdx)
		{
			case 0: _proposal.FY1 = val; break;
			case 1: _proposal.FY2 = val; break;
			case 2: _proposal.FY3 = val; break;
		}
	}

	private string GetFYName(int fyIdx)
	{
		var fyId = GetSelectedFY(fyIdx);
		return _financialYears.FirstOrDefault(f => f.Id == fyId)?.Name ?? $"FY {fyIdx + 1}";
	}

	private decimal GetFYTotalQtyByCategory(int fyIdx) => _salesPerfViewRows.Sum(r => fyIdx switch
	{
		0 => r.FY1Qty,
		1 => r.FY2Qty,
		2 => r.FY3Qty,
		_ => 0
	});

	private decimal GetFYTotalAmountByCategory(int fyIdx) => _salesPerfViewRows.Sum(r => fyIdx switch
	{
		0 => r.FY1Amount,
		1 => r.FY2Amount,
		2 => r.FY3Amount,
		_ => 0
	});

	private decimal GetFYTotalQty(int fyIdx) => GetFYTotalQtyByCategory(fyIdx);

	private decimal GetFYTotalAmount(int fyIdx) => GetFYTotalAmountByCategory(fyIdx);

	private void OnSpicValueChanged(int idx, ChangeEventArgs e)
{
    if (double.TryParse(e.Value?.ToString(), out var val))
    {
        _spicValues[idx] = val;
        _spicValueEntered[idx] = true;
    }
    else if (string.IsNullOrWhiteSpace(e.Value?.ToString()))
    {
        _spicValues[idx] = 0;
        _spicValueEntered[idx] = false;
    }

    RecalculateSpicPercentages();
}

	private static double CalculateMark(int idx, double v) => idx switch
	{
		0 => v > 3000 ? 10 : v > 1500 ? 8 : v > 1000 ? 6 : v > 500 ? 4 : 2,
		1 => v > 500 ? 10 : v > 300 ? 8 : v > 200 ? 6 : v > 100 ? 4 : 2,
		2 => v > 200 ? 10 : v > 100 ? 8 : v > 60 ? 6 : v > 30 ? 4 : 2,
		3 => v > 30 ? 20 : v > 20 ? 16 : v > 15 ? 12 : v > 10 ? 8 : 4,
		4 => v > 10 ? 10 : v > 8 ? 8 : v > 6 ? 6 : v > 4 ? 4 : 2,
		5 => v < 1 ? 20 : v < 5 ? 16 : v < 10 ? 12 : v < 20 ? 8 : 4,
		6 => 0,
		7 => v > 50 ? 10 : v > 40 ? 8 : v > 30 ? 6 : v > 20 ? 4 : v > 10 ? 2 : 0,
		8 => 0,
		9 => v > 10 ? 10 : v > 8 ? 8 : v > 6 ? 6 : v > 4 ? 4 : 2,
		_ => 0
	};

	private double GetSpicMark(int idx)
	{
		if (idx == 7 || idx == 9)
		{
			bool depEntered = idx == 7
				? _spicValueEntered[6] && _spicValueEntered[3]
				: _spicValueEntered[8] && _spicValueEntered[3];
			return !depEntered ? 0 : CalculateMark(idx, _spicValues[idx]);
		}
		return !_spicValueEntered[idx] ? 0 : CalculateMark(idx, _spicValues[idx]);
	}

	private async Task HandleNext()
	{
		if (!DealerId.HasValue || DealerId.Value <= 0)
		{
			ShowMessage("Dealer ID is required.", true);
			return;
		}

		_isSaving = true;
		try
		{
			_proposal.DealerId = DealerId.Value;
			_proposal.Q1Mark = GetSpicMark(0);
			_proposal.Q2Mark = GetSpicMark(1);
			_proposal.Q3Mark = GetSpicMark(2);
			_proposal.Q4Mark = GetSpicMark(3);
			_proposal.Q5Mark = GetSpicMark(4);
			_proposal.Q6Mark = GetSpicMark(5);
			_proposal.Q7Mark = GetSpicMark(6);
			_proposal.Q8Mark = GetSpicMark(7);
			_proposal.Q9Mark = GetSpicMark(8);
			_proposal.Q10Mark = GetSpicMark(9);
			_proposal.Q11Mark = SpicTotalMark;

			if (_proposal.Id > 0)
			{
				var response = await Http.PutAsJsonAsync($"api/DealerCreditLimitProposal/{_proposal.Id}", _proposal);
				response.EnsureSuccessStatusCode();
			}
			else
			{
				var response = await Http.PostAsJsonAsync("api/DealerCreditLimitProposal", _proposal);
				if (response.IsSuccessStatusCode)
				{
					var result = await response.Content.ReadFromJsonAsync<CreateResponse<DealerCreditLimitProposal>>();
					if (result?.Data != null)
						_proposal.Id = result.Data.Id;
				}
			}

			FormStepData.MarkStepError(11, false);
			Nav.NavigateTo($"/CreditLimitForGreenStar?dealerId={DealerId}");
		}
		catch (Exception ex)
		{
			ShowMessage($"Failed to save: {ex.Message}", true);
		}
		finally
		{
			_isSaving = false;
		}
	}

	private void HandleSkip()
	{
		Nav.NavigateTo($"/CreditLimitForGreenStar?dealerId={DealerId}");
	}

	private void ShowMessage(string message, bool isError)
	{
		_message = message;
		_isError = isError;
	}

	private static string GetGradeFromScore(double scorePercent) => scorePercent switch
	{
		>= 75 => "I",
		>= 60 => "II",
		>= 45 => "III",
		>= 30 => "IV",
		_ => "V (Cash/DD Only)"
	};

	private record ValuationParam(string Name, int Weightage, string Unit, bool IsCalculated);

	private class CreateResponse<T>
	{
		public string? Message { get; set; }
		public T? Data { get; set; }
	}

	private void SetFixedFinancialYears()
	{
		var selectedYears = _financialYears
			.OrderByDescending(f => f.Id)
			.Take(3)
			.OrderBy(f => f.Id)
			.ToList();

		_proposal.FY1 = selectedYears.Count > 0 ? selectedYears[0].Id : 0;
		_proposal.FY2 = selectedYears.Count > 1 ? selectedYears[1].Id : 0;
		_proposal.FY3 = selectedYears.Count > 2 ? selectedYears[2].Id : 0;
	}
	private bool IsUreaProduct(Product? product)
{
    return product?.Name != null &&
           product.Name.Contains("Urea", StringComparison.OrdinalIgnoreCase);
}

private bool IsFertilizerCategory(Category? category)
{
    return category?.Name != null &&
           category.Name.Contains("Fertilizer", StringComparison.OrdinalIgnoreCase);
}

private bool IsUreaAnnualSalesRow(AnnualSaleDataLastFYofDealerRegistration row)
{
    var product = _products.FirstOrDefault(p => p.Id == row.ProductId);
    var category = _categories.FirstOrDefault(c => c.Id == row.CategoryId);

    return IsFertilizerCategory(category) && IsUreaProduct(product);
}

private bool IsUreaCreditLimitSalesRow(DealerCreditLimitSales row)
{
    var product = _products.FirstOrDefault(p => p.Id == row.SubGroupId);
    var category = _categories.FirstOrDefault(c => c.Id == row.ProductGroupId);

    return IsFertilizerCategory(category) && IsUreaProduct(product);
}
private async Task LoadAnnualSalesData()
{
    if (!DealerId.HasValue || DealerId.Value <= 0)
    {
        _annualSalesData = new();
        return;
    }

    var allAnnualSales =
        await SafeGetAsync<List<AnnualSaleDataLastFYofDealerRegistration>>("api/AnnualSaleDataLastFY/all")
        ?? new();

    _annualSalesData = allAnnualSales
        .Where(x => x.DealerId == DealerId.Value)
        .ToList();
}

private decimal GetAnnualSalesUreaQty()
{
    return _annualSalesData
        .Where(IsUreaAnnualSalesRow)
        .Sum(r => r.OwnRetailsSaleQty + r.SaleToDealerQty);
}

private decimal GetAnnualSalesUreaTurnover()
{
    return _annualSalesData
        .Where(IsUreaAnnualSalesRow)
        .Sum(r => r.OwnRetailsSaleAmount + r.SaleToDealerAmount);
}
private decimal GetSalesPerformanceUreaQty()
{
    return _creditLimitSalesData
        .Where(IsUreaCreditLimitSalesRow)
        .Sum(r => r.Quantity);
}

private decimal GetSalesPerformanceUreaTurnover()
{
    var grossAmount = _creditLimitSalesData
        .Where(IsUreaCreditLimitSalesRow)
        .Sum(r => r.GrossAmount);

    return ConvertToLakhs(grossAmount);
}
private async Task LoadSpicValuationDefaultValues()
{
    if (!DealerId.HasValue || DealerId.Value <= 0)
        return;

    await LoadAnnualSalesData();

    // Row 1: AnnualSales Urea Qty
    var annualUreaQty = GetAnnualSalesUreaQty();
    if (annualUreaQty > 0 && !_spicValueEntered[0])
    {
        _spicValues[0] = (double)annualUreaQty;
        _spicValueEntered[0] = true;
    }

    // Row 2: Sales Performance Urea Qty
    var salesPerformanceUreaQty = GetSalesPerformanceUreaQty();
    if (salesPerformanceUreaQty > 0 && !_spicValueEntered[1])
    {
        _spicValues[1] = (double)salesPerformanceUreaQty;
        _spicValueEntered[1] = true;
    }

    // Row 3: AnnualSales Urea Turnover in Lakhs
    var annualUreaTurnover = GetAnnualSalesUreaTurnover();
    if (annualUreaTurnover > 0 && !_spicValueEntered[2])
    {
        _spicValues[2] = (double)annualUreaTurnover;
        _spicValueEntered[2] = true;
    }

    // Row 4: Sales Performance Urea Turnover in Lakhs
    var salesPerformanceUreaTurnover = GetSalesPerformanceUreaTurnover();
    if (salesPerformanceUreaTurnover > 0 && !_spicValueEntered[3])
    {
        _spicValues[3] = (double)salesPerformanceUreaTurnover;
        _spicValueEntered[3] = true;
    }

    // Row 5: SPIC dealership experience
    if (_dealer?.YearsofExperiance > 0 && !_spicValueEntered[4])
    {
        _spicValues[4] = _dealer.YearsofExperiance;
        _spicValueEntered[4] = true;
    }

    // Row 6: Manual only
    // Do not auto-feed _spicValues[5]

    // Row 7: Fixed Assets = LandTotal + BuildingTotal
    var fixedAssets = LandTotal + BuildingTotal;
    if (fixedAssets > 0 && !_spicValueEntered[6])
    {
        _spicValues[6] = (double)fixedAssets;
        _spicValueEntered[6] = true;
    }

    // Row 8: Auto calculation only
    // Do not directly set _spicValues[7]

    // Row 9: SPIC Securities total
    var spicSecurityTotal =
        _proposal.SpicFDAmount +
        _proposal.SpicBGAmount +
        _proposal.SpicCollateralAmount +
        _proposal.SpicTradeDepositAmount;

    if (spicSecurityTotal > 0 && !_spicValueEntered[8])
    {
        _spicValues[8] = (double)spicSecurityTotal;
        _spicValueEntered[8] = true;
    }

    // Row 10: Auto calculation only
    // Do not directly set _spicValues[9]

    RecalculateSpicPercentages();
}

}
