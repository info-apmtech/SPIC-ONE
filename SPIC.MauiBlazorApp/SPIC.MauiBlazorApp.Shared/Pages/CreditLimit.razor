	private async Task LoadSpicValuationDefaultValues()
	{
		if (!DealerId.HasValue || DealerId.Value <= 0)
			return;

		//await LoadAnnualSalesData();

		// Row 1: AnnualSales Urea Qty
		var annualUreaQty = GetAnnualSalesUreaQty();
		if (annualUreaQty > 0 && !_spicValueEntered[0])
		{
			_spicValues[0] = (double)annualUreaQty;
			_spicValueEntered[0] = true;
		}

		// Row 2: Sales Performance Urea Qty
     // Use the most recent completed FY selected in the proposal (FY3) for sales performance defaults
		var salesPerformanceUreaQty = GetSalesPerformanceUreaQty(_proposal.FY3);
		if (salesPerformanceUreaQty > 0 && !_spicValueEntered[1])
		{
			_spicValues[1] = (double)salesPerformanceUreaQty;
			_spicValueEntered[1] = true;
		}

		// Row 3: AnnualSales Urea Turnover in Lakhs
		var annualUreaTurnover = GetAnnualSalesUreaTurnover();
		if (annualUreaTurnover > 0 && !_spicValueEntered[2])
		{
			_spicValues[2] = (double)annualUreaTurnover;
			_spicValueEntered[2] = true;
		}

		// Row 4: Sales Performance Urea Turnover in Lakhs
       // Use the same FY for turnover as for qty
		var salesPerformanceUreaTurnover = GetSalesPerformanceUreaTurnover(_proposal.FY3);
		if (salesPerformanceUreaTurnover > 0 && !_spicValueEntered[3])
		{
			_spicValues[3] = (double)salesPerformanceUreaTurnover;
			_spicValueEntered[3] = true;
		}

		// Row 5: SPIC dealership experience (from DateOfAppointment)
		if (_dealer?.DateOfAppointment != default && _dealer.DateOfAppointment <= DateTime.Now && !_spicValueEntered[4])
		{
			var tenure = (DateTime.Now - _dealer.DateOfAppointment).TotalDays / 365.25;
			_spicValues[4] = Math.Round(tenure, 1);
			_spicValueEntered[4] = true;
		}

		// Row 6: Manual only - restore from DB if previously saved
		if (_proposal.Id > 0 && _proposal.SpicMonthlyAvgNetOverdues.HasValue && !_spicValueEntered[5])
		{
			_spicValues[5] = _proposal.SpicMonthlyAvgNetOverdues.Value;
			_spicValueEntered[5] = true;
		}

		// Row 7: Fixed Assets = LandTotal + BuildingTotal
		var fixedAssets = LandTotal + BuildingTotal;
		if (fixedAssets > 0 && !_spicValueEntered[6])
		{
			_spicValues[6] = (double)fixedAssets;
			_spicValueEntered[6] = true;
		}

		// Row 8: Auto calculation only
		// Do not directly set _spicValues[7]

		// Row 9: SPIC Securities total
		var spicSecurityTotal =
			_proposal.SpicFDAmount +
			_proposal.SpicBGAmount +
			_proposal.SpicCollateralAmount +
			_proposal.SpicTradeDepositAmount;

		if (spicSecurityTotal > 0 && !_spicValueEntered[8])
		{
			_spicValues[8] = (double)spicSecurityTotal;
			_spicValueEntered[8] = true;
		}

		// Row 10: Auto calculation only
		// Do not directly set _spicValues[9]

		RecalculateSpicPercentages();
	}
	private List<int> GetCompletedFYIds()
	{
		return GetReviewFinancialYears().Select(fy => fy.Id).ToList();
	}
	private decimal SpicMORecommendedCreditLimit =>
    SpicProposedLimit + _proposal.AdditionalCreditLimit;

	private async Task SaveSpicCreditLimitHistoryAsync()
	{
		try
		{
			if (!DealerId.HasValue || DealerId.Value <= 0) return;

			var history = new CreditLimitHistory
			{
				DealerId = DealerId.Value,
				CreditType = CreditType.SPIC,
				ExistingCreditLimit = _proposal.SpicExistingCreditLimitAmount,
				ExistingValidFrom = _proposal.SpicExistingCreditLimitFrom,
				ExistingValidTo = _proposal.SpicExistingCreditLimitTo,
				AdditionalCreditLimit = _proposal.AdditionalCreditLimit,
				MORecommendedCreditLimit = SpicMORecommendedCreditLimit,
				CreatedBy = LoginState?.UserId,
				CreatedAt = DateTime.Now
			};
			await Http.PostAsJsonAsync("api/CreditLimitHistory", history);
		}
		catch { }
	}

	private bool CanAdd => LoginState.Can("CreditLimit", "Entry");
	private bool CanEdit => LoginState.Can("CreditLimit", "Update");
	private bool CanDelete => LoginState.Can("CreditLimit", "Delete");
