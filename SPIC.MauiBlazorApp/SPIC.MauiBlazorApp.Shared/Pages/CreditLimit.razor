@page "/CreditLimit"
@using System.Net.Http.Json
@using SPIC.Core.Entities
@using DealerReg = SPIC.Core.Entities.DealerRegistration
@inject HttpClient Http
@inject NavigationManager Nav

<div class="container-fluid py-4 px-0">
	<FormLoader />

	@if (!string.IsNullOrEmpty(_message))
	{
		<div class="alert @(_isError ? "alert-danger" : "alert-success") alert-dismissible fade show mb-3" role="alert">
			@_message
			<button type="button" class="btn-close" @onclick='() => _message = null'></button>
		</div>
	}

	<div class="company-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
		<h3 class="fw-bold m-0 company-title">Credit Limit Proposal</h3>
	</div>

	<!-- Dealer Summary -->
	<div class="form-card">
		<div class="d-flex justify-content-between align-items-center py-3 flex-wrap gap-2">
			<div class="card-header-title mb-0">
				<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/DealerSummary.svg" class="formicon" /> Dealer Summary
			</div>
		</div>
		<div class="row g-3">
			<div class="col-md-3">
				<div class="info-box">
					<div class="info-label">Firm Name</div>
					<div class="info-value">@(_dealer.FirmName ?? "-")</div>
				</div>
			</div>
			<div class="col-md-3">
				<div class="info-box">
					<div class="info-label">Total Investment</div>
					<div class="info-value">₹ @((_dealer.CapitalInvestment + _dealer.CashCreditLimit).ToString("N0"))</div>
				</div>
			</div>
			<div class="col-md-3">
				<div class="info-box">
					<div class="info-label">Godown Capacity</div>
					<div class="info-value">@((_dealer.OwnGodownCapacity + _dealer.RentGodownCapacity).ToString("N0")) MT</div>
				</div>
			</div>
			<div class="col-md-3">
				<div class="info-box">
					<div class="info-label">Experience</div>
					<div class="info-value">@_dealer.YearsofExperiance years (in SPIC @_dealer.DateOfAppointment.ToString("dd/MM/yyyy"))</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Property Assets (Collateral) -->
	<div class="form-card">
		<div class="d-flex justify-content-between align-items-center py-3 flex-wrap gap-2">
			<div class="card-header-title mb-0">
				<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/PropertyAssets.svg" class="formicon" /> Property Assets (Collateral)
			</div>
		</div>
		<div class="row g-3 mb-4">
			<div class="col-md-3">
				<div class="asset-box blue">
					<div class="asset-title"><img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/Bank.svg" class="verifyicon mb-1 mr-1" /> Banking</div>
					<div class="asset-value">₹ @BankingTotal.ToString("N0")</div>
				</div>
			</div>
			<div class="col-md-3">
				<div class="asset-box gray">
					<div class="asset-title"><img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/land.svg" class="verifyicon" /> Land</div>
					<div class="asset-value">₹ @LandTotal.ToString("N0")</div>
				</div>
			</div>
			<div class="col-md-3">
				<div class="asset-box pink">
					<div class="asset-title"><img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/Building.svg" class="verifyicon mb-1 mr-1" /> Building</div>
					<div class="asset-value">₹ @BuildingTotal.ToString("N0")</div>
				</div>
			</div>
			<div class="col-md-3">
				<div class="asset-box orange">
					<div class="asset-title"><img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/Movable.svg" class="verifyicon" /> Movable</div>
					<div class="asset-value">₹ @_dealer.AssetValue.ToString("N0")</div>
				</div>
			</div>
		</div>
		<div class="row g-3 mb-4">
			<div class="col-md-4">
				<div class="asset-box blue">
					<div class="asset-title">Total Valuation</div>
					<div class="asset-value">₹ @TotalPropertyValue.ToString("N0")</div>
					<div class="asset-badge">TOTAL ASSETS</div>
				</div>
			</div>
			<div class="col-md-4">
				<div class="asset-box pink">
					<div class="asset-title">Net Valuation</div>
					<div class="asset-value">₹ @((TotalPropertyValue - LoansTotal).ToString("N0"))</div>
					<div class="asset-badge">AFTER LIABILITIES</div>
				</div>
			</div>
			<div class="col-md-4">
				<div class="asset-box gray">
					<div class="asset-title">LTV Ratio</div>
					<div class="asset-value">@(TotalPropertyValue > 0 ? ((LoansTotal / TotalPropertyValue) * 100).ToString("N0") : "0")%</div>
					<div class="asset-badge">LOAN TO VALUE</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Sales Performance Review -->
	<div class="form-card">
		<div class="d-flex justify-content-between align-items-center mb-1">
			<div class="section-title">
				<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/SalesPerformaReview.svg" class="formicon" /> Sales Performance Review
			</div>
			<button class="btn-verified">
				Values in @_selectedUnitName
			</button>
		</div>

		<div class="financial-note-box">
			<div class="financial-note-badge">
				Only last 3 completed financial years are allowed
			</div>
		</div>

		<div class="custom-tabs">
			@foreach (var cat in _categories)
			{
				var catId = cat.Id;
				var unitName = _units.FirstOrDefault(u => u.Id == cat.UnitId)?.Name ?? "";
				<div class="tab-btn @(catId == _selectedCategoryId ? "active" : "")"
					 @onclick="() => SelectCategory(catId)" style="cursor:pointer;">
					@cat.Name (@unitName / Value)
				</div>
			}
		</div>

		<div class="table-wrapper">
			<div class="table-responsive">
				<table class="spic-table">
					<thead>
						<tr>
							<th rowspan="2" style="min-width: 180px;">Product Name / Category</th>
							@for (int fi = 0; fi < 3; fi++)
							{
								var fyIdx = fi;
								<th colspan="2" class="text-center border-start">
									<select class="form-select form-select-sm text-center"
											value="@GetSelectedFY(fyIdx)"
											@onchange="(e) => SetSelectedFY(fyIdx, e)">
										<option value="0">Select Year</option>
										@foreach (var fy in _financialYears)
										{
											<option value="@fy.Id">@fy.Name</option>
										}
									</select>
								</th>
							}
						</tr>
						<tr>
							@for (int fi = 0; fi < 3; fi++)
							{
								<th class="text-center text-muted fw-normal border-start">@_selectedUnitName</th>
								<th class="text-center text-muted fw-normal">Lakhs</th>
							}
						</tr>
					</thead>
					<tbody>
						@foreach (var row in _currentSalesPerfRows)
						{
							var r = row;
							var product = _products.FirstOrDefault(p => p.Id == r.ProductId);
							<tr>
								<td class="fw-medium text-dark">@(product?.Name ?? "Unknown")</td>
								@for (int fi = 0; fi < 3; fi++)
								{
									var fyIdx = fi;
									<td class="border-start">
										<input class="table-input" type="number" step="0.01"
											   value="@GetPerfQty(r, fyIdx)"
											   @onchange="(e) => SetPerfQty(r, fyIdx, e)" />
									</td>
									<td>
										<input class="table-input" type="number" step="0.01"
											   value="@GetPerfAmount(r, fyIdx)"
											   @onchange="(e) => SetPerfAmount(r, fyIdx, e)" />
									</td>
								}
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>

		<div class="row g-3">
			@for (int fi = 0; fi < 3; fi++)
			{
				var fyIdx = fi;
				var fyName = GetFYName(fyIdx);
				<div class="col-md-3">
					<div class="perf-card">
						<div class="perf-year">@fyName</div>
						<div class="perf-val">
							@GetFYTotalQty(fyIdx).ToString("N2") <span style="font-size:0.75rem; font-weight:normal; color:#6B7280;">@_selectedUnitName</span>
							/ ₹ @GetFYTotalAmount(fyIdx).ToString("N2") <span style="font-size:0.75rem; font-weight:normal; color:#6B7280;">Lakhs</span>
						</div>
					</div>
				</div>
			}
			<div class="col-md-3">
				<div class="perf-card green position-relative">
					<div class="perf-year">Sales Plan (Current FY)</div>
					<div class="perf-val">
						@SalesPlanTotalQty.ToString("N2") <span style="font-size:0.75rem; font-weight:normal; color:#A7F3D0;">@_selectedUnitName</span>
						/ ₹ @SalesPlanTotalAmount.ToString("N2") <span style="font-size:0.75rem; font-weight:normal; color:#A7F3D0;">Lakhs</span>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Valuation -->
	<div class="form-card">
		<div class="d-flex justify-content-between align-items-center py-3 flex-wrap gap-2">
			<div class="card-header-title mb-0">
				<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/FiscalYear.svg" class="formicon" /> Valuation
			</div>
			<button class="btn-verified">
				<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/Verifiedicon.svg" class="verifyicon" />
				Verified Units
			</button>
		</div>
		<div class="table-wrapper">
			<div class="table-responsive">
				<table class="spic-table">
					<thead>
						<tr>
							<th style="width:5%;">S.No</th>
							<th>Critical Parameter</th>
@* 							<th style="width:10%;">Weightage</th>
							<th style="width:10%;">Unit</th> *@
							<th style="width:15%;">Value</th>
							<th style="width:10%;">Mark</th>
						</tr>
					</thead>
					<tbody>
						@for (int i = 0; i < _valuationParams.Length; i++)
						{
							var idx = i;
							var p = _valuationParams[idx];
							<tr>
								<td>@(idx + 1)</td>
								<td class="text-muted">@p.Name</td>
@* 								<td class="text-center">@(p.Weightage > 0 ? p.Weightage.ToString() : "-")</td>
								<td>@p.Unit</td> *@
								<td>
									@if (p.IsCalculated)
									{
										<div class="table-val-box">@_values[idx].ToString("N2")</div>
									}
									else
									{
										<input type="number" class="form-control-custom w-100" step="0.01"
											   value="@_values[idx]"
											   @onchange="(e) => OnValueChanged(idx, e)" />
									}
								</td>
								<td class="text-center">
									@*  @if (p.Weightage > 0) 
									{ *@
										<div class="table-val-box">@GetMark(idx).ToString("N0")</div>
									@* }
									else
									{
										<span class="text-muted">-</span>
									} *@
								</td>
							</tr>
						}
					</tbody>
					<tfoot>
						<tr>
							<td colspan="4"><strong>Grand Total</strong></td>
							<td></td>
							<td class="text-center"><strong>@TotalMark.ToString("N0") / 100</strong></td>
						</tr>
					</tfoot>
				</table>
			</div>
		</div>
	</div>

	<!-- Credit Limit Footer -->
	<div class="credit-footer">
		<div class="row align-items-center">
			<div class="col-md-12">
				<h4 class="mb-1 fw-bold" style="font-size: 14px;">
					Recommended Credit Limit
				</h4>
				<p class="credit-desc mb-3">Based on the weighted score of @TotalMark.ToString("N0")/100 and property valuation of ₹ @TotalPropertyValue.ToString("N0"), the system proposes the following limit.</p>
			</div>
			<div class="col-md-12">
				<div class="row g-3">
					<div class="col-3">
						<div class="credit-box">
							<div class="credit-box-label">Proposed Limit</div>
							<div class="credit-box-val">₹ @ProposedLimit.ToString("N2")</div>
						</div>
					</div>
					<div class="col-3">
						<div class="credit-box">
							<div class="credit-box-label">Additional Credit Limit</div>
							<div class="mt-1">
								<input type="number" class="form-control-custom w-100" step="0.01"
									   @bind="_proposal.AdditionalCreditLimit" />
							</div>
						</div>
					</div>
					<div class="col-3">
						<div class="credit-box">
							<div class="credit-box-label">Credit Multiplier</div>
							<div class="credit-box-val">@CreditMultiplier.ToString("N1")x</div>
						</div>
					</div>
					<div class="col-3">
						<div class="credit-box">
							<div class="credit-box-label">Total Credit Limit</div>
							<div class="credit-box-val">₹ @TotalCreditLimit.ToString("N2")</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<CommanFooter OnNextClick="HandleNext" IsNextDisabled="@_isSaving" />
</div>

@code {
	[SupplyParameterFromQuery(Name = "dealerId")]
	public int? DealerId { get; set; }

	private DealerReg _dealer = new();
	private List<DealerAssetBank> _bankAssets = new();
	private List<DealerAssetLand> _landAssets = new();
	private List<DealerAssetBuilding> _buildingAssets = new();
	private List<DealerLoanLiabilities> _loanLiabilities = new();
	private List<FinancialYear> _financialYears = new();
	private List<Category> _categories = new();
	private List<Unit> _units = new();
	private List<Product> _products = new();
	private List<SalesPlanningInDealerRegistration> _salesPlanData = new();

	private DealerCreditLimitProposal _proposal = new();
	private List<DealerCreditLimitSalesPerformance> _allSalesPerfData = new();
	private List<DealerCreditLimitSalesPerformance> _currentSalesPerfRows = new();

	private int _selectedCategoryId;
	private string _selectedUnitName = "MT";
	private bool _isSaving;
	private string? _message;
	private bool _isError;
	private double[] _values = new double[10];

	// Asset totals
	private decimal BankingTotal => _bankAssets.Sum(b => b.Value);
	private decimal LandTotal => _landAssets.Sum(l => l.PropertyValue);
	private decimal BuildingTotal => _buildingAssets.Sum(b => b.PropertyValue);
	private decimal TotalPropertyValue => BankingTotal + LandTotal + BuildingTotal + _dealer.AssetValue;
	private decimal LoansTotal => _loanLiabilities.Sum(l => l.LoanValue);

	// Sales Plan totals (from previous SalesPlanning page)
	private decimal SalesPlanTotalQty => _salesPlanData
		.Where(s => s.CategoryId == _selectedCategoryId)
		.Sum(r => r.AprilQty + r.MayQty + r.JuneQty + r.JulyQty + r.AugustQty + r.SeptemberQty +
			r.OctoberQty + r.NovemberQty + r.DecemberQty + r.JanuaryQty + r.FebruaryQty + r.MarchQty);

	private decimal SalesPlanTotalAmount => _salesPlanData
		.Where(s => s.CategoryId == _selectedCategoryId)
		.Sum(r => r.AprilAmount + r.MayAmount + r.JuneAmount + r.JulyAmount + r.AugustAmount + r.SeptemberAmount +
			r.OctoberAmount + r.NovemberAmount + r.DecemberAmount + r.JanuaryAmount + r.FebruaryAmount + r.MarchAmount);

	// Credit limit calculations
	private double TotalMark => Enumerable.Range(0, 10).Where(i => _valuationParams[i].Weightage > 0).Sum(i => GetMark(i));
	private decimal ProposedLimit => TotalPropertyValue * (decimal)(TotalMark / 100.0);
	private decimal TotalCreditLimit => ProposedLimit + _proposal.AdditionalCreditLimit;
	private double CreditMultiplier => TotalPropertyValue > 0 ? (double)(TotalCreditLimit / TotalPropertyValue) : 0;

	// Valuation parameters based on scoring norms
	private static readonly ValuationParam[] _valuationParams =
	[
		new("Total Fertilizer Sales Volume during last year", 10, "MT", false),
		new("Fertilizer Sales Volume with SPIC during last year", 10, "MT", false),
		new("Total Fertilizer Sales Turnover during last year", 10, "Rs. Lakhs", false),
		new("Fertilizer Sales Turnover with SPIC during last year", 20, "Rs. Lakhs", false),
		new("Dealership tenure with SPIC", 10, "Years", false),
		new("Monthly Average Net Overdues during last year", 20, "Rs. Lakhs", false),
		new("Value of dealer's property - Fixed Assets", 0, "Rs. Lakhs", false),
		new("Property Value as % of Sales Turnover with SPIC (7/4 x 100)", 10, "%", true),
		new("Available Security (SD / FD / BG / Collateral)", 0, "Rs. Lakhs", false),
		new("Available Security as % of Sales Turnover with SPIC (9/4 x 100)", 10, "%", true),
	];

	protected override async Task OnInitializedAsync()
	{
		try { _financialYears = await Http.GetFromJsonAsync<List<FinancialYear>>("api/FinancialYear") ?? new(); } catch { }
		try { _categories = await Http.GetFromJsonAsync<List<Category>>("api/Category") ?? new(); } catch { }
		try { _units = await Http.GetFromJsonAsync<List<Unit>>("api/Unit") ?? new(); } catch { }
		try { _products = await Http.GetFromJsonAsync<List<Product>>("api/Product") ?? new(); } catch { }

		if (_categories.Count > 0)
		{
			_selectedCategoryId = _categories.First().Id;
			UpdateSelectedUnit();
		}

		if (DealerId.HasValue && DealerId.Value > 0)
		{
			await LoadDealer();
			await LoadAssets();
			await LoadSalesPlanning();
			await LoadProposal();
			await LoadSalesPerformance();
			InitValuesFromData();
		}

		BuildSalesPerfRows();
	}

	private async Task LoadDealer()
	{
		try { _dealer = await Http.GetFromJsonAsync<DealerReg>($"api/DealerRegistration/{DealerId}") ?? new(); }
		catch (Exception ex) { ShowMessage($"Failed to load dealer: {ex.Message}", true); }
	}

	private async Task LoadAssets()
	{
		try
		{
			var all = await Http.GetFromJsonAsync<List<DealerAssetBank>>("api/DealerAssetBank/all") ?? new();
			_bankAssets = all.Where(a => a.DealerId == DealerId!.Value).ToList();
		}
		catch { }
		try
		{
			var all = await Http.GetFromJsonAsync<List<DealerAssetLand>>("api/DealerAssetLand/all") ?? new();
			_landAssets = all.Where(a => a.DealerId == DealerId!.Value).ToList();
		}
		catch { }
		try
		{
			var all = await Http.GetFromJsonAsync<List<DealerAssetBuilding>>("api/DealerAssetBuilding/all") ?? new();
			_buildingAssets = all.Where(a => a.DealerId == DealerId!.Value).ToList();
		}
		catch { }
		try
		{
			var all = await Http.GetFromJsonAsync<List<DealerLoanLiabilities>>("api/DealerLoanLiabilities/all") ?? new();
			_loanLiabilities = all.Where(a => a.DealerId == DealerId!.Value).ToList();
		}
		catch { }
	}

	private async Task LoadSalesPlanning()
	{
		try
		{
			var all = await Http.GetFromJsonAsync<List<SalesPlanningInDealerRegistration>>("api/SalesPlanning/all") ?? new();
			_salesPlanData = all.Where(s => s.DealerId == DealerId!.Value).ToList();
		}
		catch { }
	}

	private async Task LoadProposal()
	{
		try
		{
			var all = await Http.GetFromJsonAsync<List<DealerCreditLimitProposal>>("api/DealerCreditLimitProposal/all") ?? new();
			var existing = all.FirstOrDefault(p => p.DealerId == DealerId!.Value);
			if (existing != null)
				_proposal = existing;
		}
		catch { }
	}

	private async Task LoadSalesPerformance()
	{
		try
		{
			var all = await Http.GetFromJsonAsync<List<DealerCreditLimitSalesPerformance>>("api/DealerCreditLimitSalesPerformance/all") ?? new();
			_allSalesPerfData = _proposal.Id > 0
				? all.Where(s => s.CreditLimitId == _proposal.Id).ToList()
				: new();
		}
		catch { }
	}

	private void InitValuesFromData()
	{
		_values[4] = _dealer.YearsofExperiance;
		_values[6] = (double)TotalPropertyValue;
		_values[8] = (double)BankingTotal;
		RecalculatePercentages();
	}

	private void RecalculatePercentages()
	{
		if (_values[3] > 0)
		{
			_values[7] = (_values[6] / _values[3]) * 100;
			_values[9] = (_values[8] / _values[3]) * 100;
		}
		else
		{
			_values[7] = 0;
			_values[9] = 0;
		}
	}

	// --- Category Tab ---
	private void SelectCategory(int categoryId)
	{
		_selectedCategoryId = categoryId;
		UpdateSelectedUnit();
		BuildSalesPerfRows();
	}

	private void UpdateSelectedUnit()
	{
		var cat = _categories.FirstOrDefault(c => c.Id == _selectedCategoryId);
		if (cat != null)
			_selectedUnitName = _units.FirstOrDefault(u => u.Id == cat.UnitId)?.Name ?? "MT";
	}

	private void BuildSalesPerfRows()
	{
		var categoryProducts = _products.Where(p => p.CategoryId == _selectedCategoryId).ToList();
		_currentSalesPerfRows = new();

		foreach (var product in categoryProducts)
		{
			var existing = _allSalesPerfData.FirstOrDefault(s => s.ProductId == product.Id && s.CategoryId == _selectedCategoryId);
			if (existing != null)
			{
				_currentSalesPerfRows.Add(existing);
			}
			else
			{
				var newRow = new DealerCreditLimitSalesPerformance
				{
					CreditLimitId = _proposal.Id,
					CategoryId = _selectedCategoryId,
					ProductId = product.Id
				};
				_currentSalesPerfRows.Add(newRow);
				_allSalesPerfData.Add(newRow);
			}
		}
	}

	// --- FY Selection ---
	private int GetSelectedFY(int fyIdx) => fyIdx switch
	{
		0 => _proposal.FY1,
		1 => _proposal.FY2,
		2 => _proposal.FY3,
		_ => 0
	};

	private void SetSelectedFY(int fyIdx, ChangeEventArgs e)
	{
		if (!int.TryParse(e.Value?.ToString(), out var val)) return;
		switch (fyIdx)
		{
			case 0: _proposal.FY1 = val; break;
			case 1: _proposal.FY2 = val; break;
			case 2: _proposal.FY3 = val; break;
		}
	}

	private string GetFYName(int fyIdx)
	{
		var fyId = GetSelectedFY(fyIdx);
		return _financialYears.FirstOrDefault(f => f.Id == fyId)?.Name ?? $"FY {fyIdx + 1}";
	}

	// --- Sales Performance Helpers ---
	private static decimal GetPerfQty(DealerCreditLimitSalesPerformance row, int fyIdx) => fyIdx switch
	{
		0 => row.FY1Qty, 1 => row.FY2Qty, 2 => row.FY3Qty, _ => 0
	};

	private static decimal GetPerfAmount(DealerCreditLimitSalesPerformance row, int fyIdx) => fyIdx switch
	{
		0 => row.FY1Amount, 1 => row.FY2Amount, 2 => row.FY3Amount, _ => 0
	};

	private static void SetPerfQty(DealerCreditLimitSalesPerformance row, int fyIdx, ChangeEventArgs e)
	{
		if (!decimal.TryParse(e.Value?.ToString(), out var val)) return;
		switch (fyIdx)
		{
			case 0: row.FY1Qty = val; break;
			case 1: row.FY2Qty = val; break;
			case 2: row.FY3Qty = val; break;
		}
	}

	private static void SetPerfAmount(DealerCreditLimitSalesPerformance row, int fyIdx, ChangeEventArgs e)
	{
		if (!decimal.TryParse(e.Value?.ToString(), out var val)) return;
		switch (fyIdx)
		{
			case 0: row.FY1Amount = val; break;
			case 1: row.FY2Amount = val; break;
			case 2: row.FY3Amount = val; break;
		}
	}

	private decimal GetFYTotalQty(int fyIdx) => _allSalesPerfData.Sum(r => fyIdx switch
	{
		0 => r.FY1Qty, 1 => r.FY2Qty, 2 => r.FY3Qty, _ => 0
	});

	private decimal GetFYTotalAmount(int fyIdx) => _allSalesPerfData.Sum(r => fyIdx switch
	{
		0 => r.FY1Amount, 1 => r.FY2Amount, 2 => r.FY3Amount, _ => 0
	});

	// --- Valuation ---
	private void OnValueChanged(int idx, ChangeEventArgs e)
	{
		if (double.TryParse(e.Value?.ToString(), out var val))
			_values[idx] = val;
		RecalculatePercentages();
	}

	private double GetMark(int idx)
	{
		var v = _values[idx];
		return idx switch
		{
			0 => v > 3000 ? 10 : v > 1500 ? 8 : v > 1000 ? 6 : v > 500 ? 4 : 2,
			1 => v > 500 ? 10 : v > 300 ? 8 : v > 200 ? 6 : v > 100 ? 4 : 2,
			2 => v > 200 ? 10 : v > 100 ? 8 : v > 60 ? 6 : v > 30 ? 4 : 2,
			3 => v > 30 ? 20 : v > 20 ? 16 : v > 15 ? 12 : v > 10 ? 8 : 4,
			4 => v > 10 ? 10 : v > 8 ? 8 : v > 6 ? 6 : v > 4 ? 4 : 2,
			5 => v < 1 ? 20 : v < 5 ? 16 : v < 10 ? 12 : v < 20 ? 8 : 4,
			6 => 0,
			7 => v > 50 ? 10 : v > 40 ? 8 : v > 30 ? 6 : v > 20 ? 4 : v > 10 ? 2 : 0,
			8 => 0,
			9 => v > 10 ? 10 : v > 8 ? 8 : v > 6 ? 6 : v > 4 ? 4 : 2,
			_ => 0
		};
	}

	// --- Save & Navigate ---
	private async Task HandleNext()
	{
		if (!DealerId.HasValue || DealerId.Value <= 0)
		{
			ShowMessage("Dealer ID is required.", true);
			return;
		}

		_isSaving = true;
		try
		{
			_proposal.DealerId = DealerId.Value;
			_proposal.Q1Mark = GetMark(0);
			_proposal.Q2Mark = GetMark(1);
			_proposal.Q3Mark = GetMark(2);
			_proposal.Q4Mark = GetMark(3);
			_proposal.Q5Mark = GetMark(4);
			_proposal.Q6Mark = GetMark(5);
			_proposal.Q7Mark = GetMark(6);
			_proposal.Q8Mark = GetMark(7);
			_proposal.Q9Mark = GetMark(8);
			_proposal.Q10Mark = GetMark(9);
			_proposal.Q11Mark = TotalMark;

			if (_proposal.Id > 0)
			{
				var response = await Http.PutAsJsonAsync($"api/DealerCreditLimitProposal/{_proposal.Id}", _proposal);
				response.EnsureSuccessStatusCode();
			}
			else
			{
				var response = await Http.PostAsJsonAsync("api/DealerCreditLimitProposal", _proposal);
				if (response.IsSuccessStatusCode)
				{
					var result = await response.Content.ReadFromJsonAsync<CreateResponse<DealerCreditLimitProposal>>();
					if (result?.Data != null)
						_proposal.Id = result.Data.Id;
				}
			}

			foreach (var row in _allSalesPerfData)
			{
				row.CreditLimitId = _proposal.Id;
				var hasData = row.FY1Qty != 0 || row.FY1Amount != 0 || row.FY2Qty != 0 || row.FY2Amount != 0 || row.FY3Qty != 0 || row.FY3Amount != 0;
				if (row.Id == 0 && !hasData) continue;

				if (row.Id > 0)
				{
					await Http.PutAsJsonAsync($"api/DealerCreditLimitSalesPerformance/{row.Id}", row);
				}
				else
				{
					var resp = await Http.PostAsJsonAsync("api/DealerCreditLimitSalesPerformance", row);
					if (resp.IsSuccessStatusCode)
					{
						var result = await resp.Content.ReadFromJsonAsync<CreateResponse<DealerCreditLimitSalesPerformance>>();
						if (result?.Data != null)
							row.Id = result.Data.Id;
					}
				}
			}

			Nav.NavigateTo($"/Enclosures?dealerId={DealerId}");
		}
		catch (Exception ex)
		{
			ShowMessage($"Failed to save: {ex.Message}", true);
		}
		finally
		{
			_isSaving = false;
		}
	}

	private void ShowMessage(string message, bool isError)
	{
		_message = message;
		_isError = isError;
	}

	private record ValuationParam(string Name, int Weightage, string Unit, bool IsCalculated);

	private class CreateResponse<T>
	{
		public string? Message { get; set; }
		public T? Data { get; set; }
	}
}
