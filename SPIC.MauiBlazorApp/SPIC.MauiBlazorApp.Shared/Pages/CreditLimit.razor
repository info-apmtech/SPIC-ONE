	private void SetFixedFinancialYears()
	{
		var years = GetReviewFinancialYears();
		_proposal.FY1 = years.Count > 0 ? years[0].Id : 0;
		_proposal.FY2 = years.Count > 1 ? years[1].Id : 0;
		_proposal.FY3 = years.Count > 2 ? years[2].Id : 0;
	}

	// Returns 2023-24, 2024-25, 2025-26 style: the 3 completed FYs
	// immediately before the current financial year (April–March).
	private List<FinancialYear> GetReviewFinancialYears()
	{
		var today = DateTime.Today;
		int currentFyStartYear = today.Month >= 4 ? today.Year : today.Year - 1;

		var wantedStartYears = new[]
		{
			currentFyStartYear - 3,
			currentFyStartYear - 2,
			currentFyStartYear - 1
		};

		var matched = _financialYears
			.Where(fy => wantedStartYears.Contains(GetFyStartYear(fy)))
			.OrderBy(fy => GetFyStartYear(fy))   // oldest -> newest, left to right
			.ToList();

		// Fallback: if naming/dates don't line up, take the 3 most recent FYs we have
		if (matched.Count == 0)
		{
			matched = _financialYears
				.OrderByDescending(fy => fy.EndDate)
				.ThenByDescending(fy => fy.Id)
				.Take(3)
				.OrderBy(fy => fy.EndDate)
				.ThenBy(fy => fy.Id)
				.ToList();
		}

		return matched;
	}

	// Derives the FY start year. Prefers StartDate, falls back to parsing the Name
	// (handles "2023-24", "2023-2024", "FY 2023-24", "2023/24", etc.), then EndDate.
	private int GetFyStartYear(FinancialYear fy)
	{
		if (fy.StartDate != default && fy.StartDate.Year > 1)
			return fy.StartDate.Year;

		if (!string.IsNullOrWhiteSpace(fy.Name))
		{
			var match = System.Text.RegularExpressions.Regex.Match(fy.Name, @"(\d{4})");
			if (match.Success && int.TryParse(match.Groups[1].Value, out var y))
				return y;
		}

		if (fy.EndDate != default && fy.EndDate.Year > 1)
			return fy.EndDate.Month >= 4 ? fy.EndDate.Year : fy.EndDate.Year - 1;

		return 0;
	}
