@page "/AgeingReport"
@implements IDisposable
@inject HttpClient Http
@inject IJSRuntime JS
@using System.Text.Json
@using System.Net.Http.Json
@using System.Globalization
@using SPIC.Core.DTOs
@using SPIC.MauiBlazorApp.Shared.Pages

<style>
    select.ar-form-select[multiple]:not(.select2-hidden-accessible) {
        height: 38px !important;
        min-height: 38px !important;
        overflow: hidden !important;
        background-color: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 6px;
        color: transparent;
        pointer-events: none;
        appearance: none;
        -webkit-appearance: none;
    }
</style>

<div class="container-fluid py-4 px-0">

    <div class="ar-header-container">
        <div class="ar-header-text">
            <h1>Ageing Report</h1>
            <p>Monitor stock ageing and identify slow-moving inventory</p>
        </div>
        <div class="ar-action-buttons">
            <button class="ar-btn ar-btn-outline" @onclick="RefreshData"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2v6h-6"></path><path d="M3 12a9 9 0 1 0 2.13-5.88L2 9"></path></svg> Refresh Data</button>
            <button class="ar-btn ar-btn-outline" @onclick="ExportExcel"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><path d="M8 13h2"></path><path d="M8 17h2"></path><path d="M14 13h2"></path><path d="M14 17h2"></path></svg> Excel</button>
            <button class="ar-btn ar-btn-outline" @onclick="ExportPdf"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><path d="M9 15v-4"></path><path d="M12 15v-4c1 0 2 1 2 2s-1 2-2 2"></path><path d="M16 11v4"></path><path d="M16 13h2"></path></svg> PDF</button>
            <button class="ar-btn ar-btn-solid" @onclick="SendMail"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg> Send Mail</button>
        </div>
    </div>

    <!-- Filters -->
    <div class="ar-filter-card">
        <div class="ar-filter-header">
            <div class="ar-filter-title">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="6" x2="20" y2="6"></line><line x1="6" y1="12" x2="18" y2="12"></line><line x1="8" y1="18" x2="16" y2="18"></line></svg>
                Filters
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </div>

        <div class="ar-filter-body">
            <div class="ar-filter-grid">
                <div class="ar-form-group">
                    <label class="ar-form-label">State</label>
                    <select id="ar-state-select" class="ar-form-select" multiple="multiple">
                        @foreach (var s in _states)
                        {
                            <option value="@s.Id" selected="@(_selStates.Contains(s.Id))">@s.Name</option>
                        }
                    </select>
                </div>
                <div class="ar-form-group">
                    <label class="ar-form-label">Region</label>
                    <select id="ar-region-select" class="ar-form-select" multiple="multiple">
                        @foreach (var r in _regions)
                        {
                            <option value="@r.Id" selected="@(_selRegions.Contains(r.Id))">@r.Name</option>
                        }
                    </select>
                </div>
                <div class="ar-form-group">
                    <label class="ar-form-label">Head Quarters</label>
                    <select id="ar-hq-select" class="ar-form-select" multiple="multiple">
                        @foreach (var h in _hq)
                        {
                            <option value="@h.Id" selected="@(_selHqs.Contains(h.Id))">@h.Name</option>
                        }
                    </select>
                </div>
                <div class="ar-form-group">
                    <label class="ar-form-label">District</label>
                    <select id="ar-district-select" class="ar-form-select" multiple="multiple">
                        @foreach (var d in _districts)
                        {
                            <option value="@d.Id" selected="@(_selDistricts.Contains(d.Id))">@d.Name</option>
                        }
                    </select>
                </div>
                <div class="ar-form-group">
                    <label class="ar-form-label">Sub District</label>
                    <select id="ar-subdistrict-select" class="ar-form-select" multiple="multiple">
                        @foreach (var sd in _subDistricts)
                        {
                            <option value="@sd.Id" selected="@(_selSubDistricts.Contains(sd.Id))">@sd.Name</option>
                        }
                    </select>
                </div>
                <div class="ar-form-group">
                    <label class="ar-form-label">Lying with</label>
                    <select id="ar-lyingwith-select" class="ar-form-select" multiple="multiple">
                        @foreach (var lw in _lyingWith)
                        {
                            <option value="@lw.Id" selected="@(_selLyingWiths.Contains(lw.Id))">@lw.Name</option>
                        }
                    </select>
                </div>
                <div class="ar-form-group">
                    <label class="ar-form-label">Product</label>
                    <select id="ar-product-select" class="ar-form-select" multiple="multiple">
                        @foreach (var p in _products)
                        {
                            <option value="@p.Id" selected="@(_selProducts.Contains(p.Id))">@p.Name</option>
                        }
                    </select>
                </div>
                <div class="ar-form-group">
                    <label class="ar-form-label">Ageing Range (Days)</label>
                    <select id="ar-ageing-select" class="ar-form-select" multiple="multiple">
                        <option value="0-30" selected="@(_selAgeings.Contains("0-30"))">0–30 Days</option>
                        <option value="31-60" selected="@(_selAgeings.Contains("31-60"))">31–60 Days</option>
                        <option value="61-90" selected="@(_selAgeings.Contains("61-90"))">61–90 Days</option>
                        <option value="91-120" selected="@(_selAgeings.Contains("91-120"))">91–120 Days</option>
                        <option value="Above 120" selected="@(_selAgeings.Contains("Above 120"))">Above 120 Days</option>
                    </select>
                </div>
            </div>

            <div class="ar-filter-actions">
                <button class="ar-btn ar-btn-outline" @onclick="ClearAll">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                    Clear All
                </button>
                <button class="ar-btn ar-btn-solid" @onclick="ApplyFilters">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="6" x2="20" y2="6"></line><line x1="6" y1="12" x2="18" y2="12"></line><line x1="8" y1="18" x2="16" y2="18"></line></svg>
                    Apply Filters
                </button>
            </div>
        </div>
    </div>

    @if (_isLoading && _dashboard is null)
    {
        <div style="display:flex; flex-direction:column; align-items:center; gap:12px; padding:48px; color:#64748b;">
            <div style="width:32px; height:32px; border:3px solid #e2e8f0; border-top-color:#3b82f6; border-radius:50%; animation:ar-spin 0.8s linear infinite;"></div>
            <span>Loading dashboard…</span>
        </div>
        <style>
                @@keyframes ar-spin {
                    to {
                        transform: rotate(360deg);
                    }
                }
        </style>
    }
    else if (_dashboard is null)
    {
        <div style="padding:48px; text-align:center; color:#94a3b8;">
            @(_loadError is null ? "No Data Available" : $"Could not load report: {_loadError}")
        </div>
    }
    else
    {
        <div style="@(_isLoading ? "opacity:0.6; pointer-events:none; transition:0.2s;" : "transition:0.2s;")">

            <!-- KPI cards -->
            <div class="ar-stats-grid">
                <div class="ar-stat-card ar-theme-green">
                    <div class="ar-card-top">
                        <div class="ar-stat-info">
                            <span class="ar-stat-title">Total Stock (MT)</span>
                            <span class="ar-stat-value">@Fmt(_dashboard.Summary.TotalStock)</span>
                        </div>
                        <div class="ar-icon-box"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21V9l9-6 9 6v12"></path><path d="M9 21v-6h6v6"></path><rect x="15" y="15" width="4" height="4"></rect><rect x="5" y="15" width="4" height="4"></rect></svg></div>
                    </div>
                    <div class="ar-stat-trend">
                        <svg class="ar-trend-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg>
                        <span class="ar-text-green">@_dashboard.Summary.TotalStockChangePct.ToString("0.##")% vs last period</span>
                    </div>
                </div>

                <div class="ar-stat-card ar-theme-orange">
                    <div class="ar-card-top">
                        <div class="ar-stat-info">
                            <span class="ar-stat-title">Average Ageing (Days)</span>
                            <span class="ar-stat-value">@_dashboard.Summary.AverageAgeing.ToString("0.#")</span>
                        </div>
                        <div class="ar-icon-box"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg></div>
                    </div>
                    <div class="ar-stat-trend">
                        <svg class="ar-trend-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg>
                        <span class="ar-text-green">@_dashboard.Summary.AverageAgeingChange.ToString("0.#") Days vs last period</span>
                    </div>
                </div>

                <div class="ar-stat-card ar-theme-yellow">
                    <div class="ar-card-top">
                        <div class="ar-stat-info">
                            <span class="ar-stat-title">30-60 Days Stock (MT)</span>
                            <span class="ar-stat-value">@Fmt(_dashboard.Summary.Stock30To60)</span>
                        </div>
                        <div class="ar-icon-box"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg></div>
                    </div>
                    <div class="ar-stat-trend">
                        <svg class="ar-trend-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg>
                        <span class="ar-text-green">@_dashboard.Summary.Stock30To60ChangePct.ToString("0.##")% vs last period</span>
                    </div>
                </div>

                <div class="ar-stat-card ar-theme-red">
                    <div class="ar-card-top">
                        <div class="ar-stat-info">
                            <span class="ar-stat-title">60+ Days Stock (MT)</span>
                            <span class="ar-stat-value">@Fmt(_dashboard.Summary.Stock60Plus)</span>
                        </div>
                        <div class="ar-icon-box"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg></div>
                    </div>
                    <div class="ar-stat-trend">
                        <svg class="ar-trend-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg>
                        <span class="ar-text-green">@_dashboard.Summary.Stock60PlusChangePct.ToString("0.##")% vs last period</span>
                    </div>
                </div>
            </div>

            <!-- Charts (inline SVG/CSS — no JS) -->
            <div class="ar-charts-grid">

                <!-- Ageing by Days: bar -->
                <div class="ar-chart-card">
                    <div class="ar-chart-header"><h3>Ageing by Days (MT)</h3></div>
                    <div class="ar-chart-area" style="min-height:300px;">
                        <div style="display:flex; height:100%; min-height:300px;">
                            <!-- Y axis -->
                            <div style="display:flex; flex-direction:column; justify-content:space-between; padding-right:12px; text-align:right; font-size:12px; color:#94a3b8; height:calc(100% - 28px); width:46px; flex-shrink:0;">
                                @foreach (var lbl in BarAxisLabels())
                                {
                                    <span>@lbl</span>
                                }
                            </div>
                            <!-- Plot -->
                            <div style="flex:1; position:relative;">
                                <div style="position:absolute; top:0; left:0; right:0; bottom:28px; display:flex; flex-direction:column; justify-content:space-between; z-index:0;">
                                    <div style="border-top:1px dashed #eef2f7;"></div>
                                    <div style="border-top:1px dashed #eef2f7;"></div>
                                    <div style="border-top:1px dashed #eef2f7;"></div>
                                    <div style="border-top:1px dashed #eef2f7;"></div>
                                    <div style="border-top:1px solid #e2e8f0;"></div>
                                </div>
                                <div style="position:absolute; top:0; left:0; right:0; bottom:28px; display:flex; align-items:flex-end; justify-content:space-around; gap:16px; padding:0 8px; z-index:1;">
                                    @foreach (var b in _dashboard.DayBuckets)
                                    {
                                        var h = BarHeight(b.Stock);
                                        <div style="flex:1; display:flex; flex-direction:column; align-items:center; justify-content:flex-end; height:100%; position:relative;">
                                            <div style="font-size:12px; font-weight:600; color:#334155; margin-bottom:4px;">@Fmt(b.Stock)</div>
                                            <div title="@b.Category — @Fmt(b.Stock) MT (@b.Percentage.ToString("0.#")%)"
                                                 style="width:70%; max-width:54px; height:@h.ToString("0.##", Inv)%; background:@b.Color; border-radius:6px 6px 0 0; transition:height .3s;"></div>
                                            <div style="position:absolute; bottom:-24px; font-size:11px; color:#64748b; text-align:center; white-space:nowrap;">@b.Category</div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Ageing by Days: donut + table -->
                <div class="ar-chart-card">
                    <div class="ar-chart-header"><h3>Ageing by Days (MT)</h3></div>
                    <div class="ar-donut-container">
                        <div class="ar-donut-wrapper" style="position:relative; display:flex; align-items:center; justify-content:center;">
                            <svg width="100%" height="100%" viewBox="0 0 42 42" style="transform:rotate(-90deg); overflow:visible;">
                                <circle cx="21" cy="21" r="15.9155" fill="transparent" stroke="#f1f5f9" stroke-width="7"></circle>
                                @{
                                    var total = _dashboard.DayBuckets.Sum(b => b.Stock);
                                    double off = 0;
                                }
                                @foreach (var b in _dashboard.DayBuckets)
                                {
                                    var pct = total == 0 ? 0 : (double)(b.Stock / total) * 100;
                                    if (pct > 0)
                                    {
                                        var thisOff = -off;
                                        off += pct;
                                        <circle cx="21" cy="21" r="15.9155" fill="transparent"
                                                stroke="@b.Color" stroke-width="7"
                                                stroke-dasharray="@pct.ToString("0.##", Inv) @((100 - pct).ToString("0.##", Inv))"
                                                stroke-dashoffset="@thisOff.ToString("0.##", Inv)">
                                            <title>@b.Label: @Fmt(b.Stock) MT (@b.Percentage.ToString("0.#")%)</title>
                                        </circle>
                                    }
                                }
                            </svg>
                            <div style="position:absolute; text-align:center;">
                                <div style="font-size:20px; font-weight:700; color:#0f172a;">@Fmt(_dashboard.DayBuckets.Sum(b => b.Stock))</div>
                                <div style="font-size:12px; color:#64748b;">Total Stock (MT)</div>
                            </div>
                        </div>
                        <div class="ar-donut-table-wrapper">
                            <table class="ar-data-table">
                                <thead>
                                    <tr><th>Ageing Days</th><th>Stock(MT)</th><th>% Of Total</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var b in _dashboard.DayBuckets)
                                    {
                                        <tr>
                                            <td>
                                                <div class="ar-dot-row">
                                                    <span class="ar-table-dot" style="background:@b.Color;"></span>
                                                    @b.Label
                                                </div>
                                            </td>
                                            <td>@Fmt(b.Stock)</td>
                                            <td>@b.Percentage.ToString("0.#")%</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Table -->
            <div class="ar-table-card">
                <div class="ar-table-top">
                    <h3>Ageing Report List</h3>
                    <input type="text" class="ar-search-input" placeholder="Search zones..."
                           @bind="_filter.Search" @bind:event="oninput" @onkeyup="OnSearchKeyUp" />
                </div>

                <div class="ar-table-wrapper">
                    <table class="ar-main-table">
                        <thead>
                            <tr>
                                <th style="width:60px;">S.No</th>
                                <th class="ar-sortable" @onclick='() => Sort("state")'>State</th>
                                <th class="ar-sortable" @onclick='() => Sort("dealer")'>Dealer Name</th>
                                <th class="ar-sortable" @onclick='() => Sort("product")'>Product</th>
                                <th class="ar-sortable" @onclick='() => Sort("quantity")'>Quantity (MT)</th>
                                <th class="ar-sortable" @onclick='() => Sort("ageing")'>Ageing in Days</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_dashboard.Grid.Items.Count == 0)
                            {
                                <tr><td colspan="8" style="text-align:center; padding:24px; color:#64748b;">No records found.</td></tr>
                            }
                            else
                            {
                                var startIndex = (_filter.Page - 1) * _filter.PageSize;
                                var rowNo = 0;
                                @foreach (var row in _dashboard.Grid.Items)
                                {
                                    rowNo++;
                                    <tr>
                                        <td>@(startIndex + rowNo)</td>
                                        <td>@row.StateName</td>
                                        <td>@row.DealerName</td>
                                        <td>@row.ProductName</td>
                                        <td>@row.Quantity.ToString("0.#", Inv)</td>
                                        <td class="@AgeingClass(row.AgeingDays)">@row.AgeingDays</td>
                                        <td>
                                            <div class="ar-status @StatusClass(row.Status)">
                                                <div class="dot"></div>@row.Status
                                            </div>
                                        </td>
                                        <td>
                                            <button type="button" class="ar-action-btn" @onclick="() => OpenAgeingDetails(row)">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <div class="ar-pagination">
                    <div class="ar-page-size">
                        <span>Items Per Page</span>
                        <select class="ar-form-select" style="padding:6px 32px 6px 12px; width:65px; margin:0;" @onchange="OnPageSizeChanged">
                            <option value="16" selected="@(_filter.PageSize == 16)">16</option>
                            <option value="25" selected="@(_filter.PageSize == 25)">25</option>
                            <option value="50" selected="@(_filter.PageSize == 50)">50</option>
                            <option value="100" selected="@(_filter.PageSize == 100)">100</option>
                        </select>
                    </div>
                    <div class="ar-page-controls">
                        <button type="button" class="ar-page-btn" disabled="@(_filter.Page <= 1)" @onclick="() => GoToPage(_filter.Page - 1)">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
                        </button>
                        @foreach (var pg in PageNumbers())
                        {
                            if (pg == -1)
                            {
                                <button type="button" class="ar-page-btn dots" disabled>..</button>
                            }
                            else
                            {

                                <button type="button" class="ar-page-btn @(pg == _filter.Page ? "active" : "")" @onclick="() => GoToPage(pg)">@pg</button>
                            }
                        }
                        <button type="button" class="ar-page-btn" disabled="@(_filter.Page >= TotalPages)" @onclick="() => GoToPage(_filter.Page + 1)">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<StockAgeingDetailsDrawer @bind-IsOpen="isAgeingDetailsOpen" Row="_selectedRow" />
@code {
    private static readonly CultureInfo InIN = new("en-IN");
    private static readonly CultureInfo Inv = CultureInfo.InvariantCulture;
    private string Fmt(decimal v) => v.ToString("#,##0", InIN);

    private AgeingDashboardDto? _dashboard;
    private readonly AgeingReportFilter _filter = new();
    private bool _isLoading = true;
    private string? _loadError;
    private CancellationTokenSource? _loadCts;
    private System.Timers.Timer? _searchDebounce;

    private bool isAgeingDetailsOpen = false;
    private AgeingRowDto? _selectedRow;

    private int TotalPages => _dashboard is null || _dashboard.Grid.PageSize == 0
        ? 1 : (int)Math.Ceiling((double)_dashboard.Grid.TotalCount / _dashboard.Grid.PageSize);

    // ---- Master data ----
    private List<LocationDto> _allStates = new(), _allRegions = new(), _allHqs = new(), _allDistricts = new(), _allSubDistricts = new();
    private List<LocationDto> _states = new(), _regions = new(), _hq = new(), _districts = new(), _subDistricts = new();
    private List<LocationDto> _products = new(), _lyingWith = new();

    private List<int> _selStates = new(), _selRegions = new(), _selHqs = new(), _selDistricts = new(), _selSubDistricts = new(), _selProducts = new(), _selLyingWiths = new();
    private List<string> _selAgeings = new();

    private DotNetObjectReference<AgeingReport> _objRef = default!;

    public class LocationDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public int? StateId { get; set; }
        public int? RegionId { get; set; }
        public int? DistrictId { get; set; }
    }

    // ---- Chart helpers (inline SVG/CSS) ----
    private decimal BarAxisMax()
    {
        var max = _dashboard?.DayBuckets.Count > 0 ? _dashboard.DayBuckets.Max(b => b.Stock) : 0m;
        if (max <= 0) return 100m;
        var mag = (decimal)Math.Pow(10, Math.Floor(Math.Log10((double)max)));
        return Math.Ceiling(max / mag) * mag;   // e.g. 12,400 -> 20,000 ; 7,600 -> 8,000
    }

    private IEnumerable<string> BarAxisLabels()
    {
        var max = BarAxisMax();
        for (int i = 4; i >= 0; i--)
        {
            var val = max * i / 4m;
            yield return val >= 1000 ? $"{(val / 1000m):0.#}k" : val.ToString("0", Inv);
        }
    }

    private double BarHeight(decimal value)
    {
        var max = BarAxisMax();
        return max == 0 ? 0 : (double)(value / max) * 100;
    }

    // ---- Lifecycle ----
    private bool _initialLoaded = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _initialLoaded = true;

        try { await LoadMasterData(); } catch (Exception ex) { Console.WriteLine($"[Ageing] master: {ex}"); }
        await Task.Delay(1);
        try { _objRef = DotNetObjectReference.Create(this); await InitSelect2(); }
        catch (Exception ex) { Console.WriteLine($"[Ageing] select2: {ex}"); }
        try { await LoadDashboard(); }
        catch (Exception ex) { _isLoading = false; _loadError = ex.Message; StateHasChanged(); Console.WriteLine($"[Ageing] dashboard: {ex}"); }
    }

    private async Task LoadMasterData()
    {
        var statesTask = FetchData("api/State/all");
        var regionsTask = FetchData("api/Region/all");
        var hqTask = FetchData("api/Headquarter/all");
        var districtsTask = FetchData("api/District/all");
        var subDistrictsTask = FetchData("api/SubDistrict/all");
        var productsTask = FetchData("api/Product/all");
        var lyingWithTask = FetchData("api/LyingWithMaster/all");

        await Task.WhenAll(statesTask, regionsTask, hqTask, districtsTask, subDistrictsTask, productsTask, lyingWithTask);

        _allStates = statesTask.Result; _allRegions = regionsTask.Result; _allHqs = hqTask.Result;
        _allDistricts = districtsTask.Result; _allSubDistricts = subDistrictsTask.Result;

        foreach (var hq in _allHqs) { var p = _allRegions.FirstOrDefault(r => r.Id == hq.RegionId); if (p != null) hq.StateId = p.StateId; }
        foreach (var sd in _allSubDistricts) { var p = _allDistricts.FirstOrDefault(d => d.Id == sd.DistrictId); if (p != null) sd.StateId = p.StateId; }

        _states = _allStates; _regions = _allRegions; _hq = _allHqs; _districts = _allDistricts; _subDistricts = _allSubDistricts;
        _products = productsTask.Result; _lyingWith = lyingWithTask.Result;
        StateHasChanged();
    }

    // ---- Dashboard ----
    private async Task LoadDashboard()
    {
        _loadCts?.Cancel(); _loadCts?.Dispose();
        var cts = new CancellationTokenSource(TimeSpan.FromSeconds(30));
        _loadCts = cts; var token = cts.Token;

        _isLoading = true; _loadError = null; StateHasChanged();
        try
        {
            var resp = await Http.PostAsJsonAsync("api/AgeingReport/dashboard", _filter, token);
            if (resp.IsSuccessStatusCode)
                _dashboard = await resp.Content.ReadFromJsonAsync<AgeingDashboardDto>(cancellationToken: token);
            else { _dashboard = null; _loadError = $"Server returned {(int)resp.StatusCode} {resp.ReasonPhrase}."; }
        }
        catch (OperationCanceledException)
        {
            if (!ReferenceEquals(_loadCts, cts)) return;
            _dashboard = null; _loadError = "Request timed out — the server took too long to respond.";
        }
        catch (Exception ex) { _dashboard = null; _loadError = ex.Message; }
        finally { if (ReferenceEquals(_loadCts, cts)) { _isLoading = false; StateHasChanged(); } }
    }

    private void SyncSelectionsToFilter()
    {
        _filter.StateIds = _selStates.ToList();
        _filter.RegionIds = _selRegions.ToList();
        _filter.HeadQuarterIds = _selHqs.ToList();
        _filter.DistrictIds = _selDistricts.ToList();
        _filter.SubDistrictIds = _selSubDistricts.ToList();
        _filter.LyingWithIds = _selLyingWiths.ToList();
        _filter.ProductIds = _selProducts.ToList();
        _filter.AgeingRanges = _selAgeings.ToList();
    }

    private async Task ApplyFilters() { SyncSelectionsToFilter(); _filter.Page = 1; await LoadDashboard(); }
    private async Task RefreshData() => await LoadDashboard();

    private async Task ClearAll()
    {
        _selStates.Clear(); _selRegions.Clear(); _selHqs.Clear(); _selDistricts.Clear();
        _selSubDistricts.Clear(); _selProducts.Clear(); _selLyingWiths.Clear(); _selAgeings.Clear();
        _states = _allStates; _regions = _allRegions; _hq = _allHqs; _districts = _allDistricts; _subDistricts = _allSubDistricts;
        SyncSelectionsToFilter(); _filter.Search = null; _filter.Page = 1;
        StateHasChanged(); await RefreshSelect2Hierarchy(); await LoadDashboard();
    }

    private async Task GoToPage(int page)
    {
        if (page < 1 || page > TotalPages || page == _filter.Page) return;
        _filter.Page = page; await LoadDashboard();
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size)) { _filter.PageSize = size; _filter.Page = 1; await LoadDashboard(); }
    }

    private async Task Sort(string column)
    {
        if (_filter.SortColumn == column) _filter.SortDir = _filter.SortDir == "asc" ? "desc" : "asc";
        else { _filter.SortColumn = column; _filter.SortDir = "asc"; }
        await LoadDashboard();
    }

    private void OnSearchKeyUp()
    {
        _searchDebounce?.Stop(); _searchDebounce?.Dispose();
        _searchDebounce = new System.Timers.Timer(400) { AutoReset = false };
        _searchDebounce.Elapsed += async (_, _) => { _filter.Page = 1; await InvokeAsync(LoadDashboard); };
        _searchDebounce.Start();
    }

    private IEnumerable<int> PageNumbers()
    {
        int total = TotalPages, current = _filter.Page;
        if (total <= 7) { for (int i = 1; i <= total; i++) yield return i; yield break; }
        yield return 1;
        if (current > 4) yield return -1;
        for (int i = Math.Max(2, current - 1); i <= Math.Min(total - 1, current + 1); i++) yield return i;
        if (current < total - 3) yield return -1;
        yield return total;
    }

    private string StatusClass(string status) => status switch
    {
        "Fresh" => "ar-st-dgreen",
        "Medium" => "ar-st-lgreen",
        "Slow Moving" => "ar-st-orange",
        _ => "ar-st-red"
    };

    private string AgeingClass(int days) => days switch
    {
        <= 7 => "ar-txt-dgreen",
        <= 30 => "ar-txt-lgreen",
        <= 60 => "ar-txt-orange",
        _ => "ar-txt-red"
    };

    private void OpenAgeingDetails(AgeingRowDto row)
    {
        _selectedRow = row;
        isAgeingDetailsOpen = true;
        StateHasChanged();
    }

    private async Task ExportExcel() { SyncSelectionsToFilter(); await JS.InvokeVoidAsync("spicDownload.post", "api/AgeingReport/export/excel", _filter, "AgeingReport.xlsx"); }
    private async Task ExportPdf() { SyncSelectionsToFilter(); await JS.InvokeVoidAsync("spicDownload.post", "api/AgeingReport/export/pdf", _filter, "AgeingReport.pdf"); }
    private async Task SendMail() { SyncSelectionsToFilter(); await Http.PostAsJsonAsync("api/AgeingReport/send-mail", _filter); }

    // ==========================================================
    //  Select2 cascade
    // ==========================================================
    private async Task InitSelect2()
    {
        var configs = new[]
        {
            new { id = "ar-state-select", method = nameof(OnStateChanged) },
            new { id = "ar-region-select", method = nameof(OnRegionChanged) },
            new { id = "ar-hq-select", method = nameof(OnHqChanged) },
            new { id = "ar-district-select", method = nameof(OnDistrictChanged) },
            new { id = "ar-subdistrict-select", method = nameof(OnSubDistrictChanged) },
            new { id = "ar-lyingwith-select", method = nameof(OnLyingWithChanged) },
            new { id = "ar-product-select", method = nameof(OnProductChanged) },
            new { id = "ar-ageing-select", method = nameof(OnAgeingChanged) }
        };
        await JS.InvokeVoidAsync("spicSelect2.initMultiple", configs, _objRef);
    }

    [JSInvokable] public async Task OnStateChanged(List<string> v) { var n = v.Select(int.Parse).ToList(); if (_selStates.SequenceEqual(n)) return; _selStates = n; await Cascade("State"); }
    [JSInvokable] public async Task OnRegionChanged(List<string> v) { var n = v.Select(int.Parse).ToList(); if (_selRegions.SequenceEqual(n)) return; _selRegions = n; await Cascade("Region"); }
    [JSInvokable] public async Task OnHqChanged(List<string> v) { var n = v.Select(int.Parse).ToList(); if (_selHqs.SequenceEqual(n)) return; _selHqs = n; await Cascade("HQ"); }
    [JSInvokable] public async Task OnDistrictChanged(List<string> v) { var n = v.Select(int.Parse).ToList(); if (_selDistricts.SequenceEqual(n)) return; _selDistricts = n; await Cascade("District"); }
    [JSInvokable] public async Task OnSubDistrictChanged(List<string> v) { var n = v.Select(int.Parse).ToList(); if (_selSubDistricts.SequenceEqual(n)) return; _selSubDistricts = n; await Cascade("SubDistrict"); }
    [JSInvokable] public void OnLyingWithChanged(List<string> v) { _selLyingWiths = v.Select(int.Parse).ToList(); StateHasChanged(); }
    [JSInvokable] public void OnProductChanged(List<string> v) { _selProducts = v.Select(int.Parse).ToList(); StateHasChanged(); }
    [JSInvokable] public void OnAgeingChanged(List<string> v) { _selAgeings = v; StateHasChanged(); }

    private async Task Cascade(string filterType)
    {
        if (filterType == "State" && _selStates.Any())
        {
            _selRegions.RemoveAll(id => { var r = _allRegions.FirstOrDefault(x => x.Id == id); return r == null || !_selStates.Contains(r.StateId ?? 0); });
            _selHqs.RemoveAll(id => { var h = _allHqs.FirstOrDefault(x => x.Id == id); return h == null || !_selStates.Contains(h.StateId ?? 0); });
            _selDistricts.RemoveAll(id => { var d = _allDistricts.FirstOrDefault(x => x.Id == id); return d == null || !_selStates.Contains(d.StateId ?? 0); });
            _selSubDistricts.RemoveAll(id => { var sd = _allSubDistricts.FirstOrDefault(x => x.Id == id); return sd == null || !_selStates.Contains(sd.StateId ?? 0); });
        }
        else if (filterType == "Region" && _selRegions.Any())
        {
            _selStates = _selStates.Union(_allRegions.Where(r => _selRegions.Contains(r.Id) && r.StateId.HasValue).Select(r => r.StateId!.Value)).Distinct().ToList();
            _selHqs.RemoveAll(id => { var h = _allHqs.FirstOrDefault(x => x.Id == id); return h == null || !_selRegions.Contains(h.RegionId ?? 0); });
            _selDistricts.RemoveAll(id => { var d = _allDistricts.FirstOrDefault(x => x.Id == id); return d == null || !_selStates.Contains(d.StateId ?? 0); });
            _selSubDistricts.RemoveAll(id => { var sd = _allSubDistricts.FirstOrDefault(x => x.Id == id); return sd == null || !_selStates.Contains(sd.StateId ?? 0); });
        }
        else if (filterType == "HQ" && _selHqs.Any())
        {
            _selRegions = _selRegions.Union(_allHqs.Where(h => _selHqs.Contains(h.Id) && h.RegionId.HasValue).Select(h => h.RegionId!.Value)).Distinct().ToList();
            _selStates = _selStates.Union(_allHqs.Where(h => _selHqs.Contains(h.Id) && h.StateId.HasValue).Select(h => h.StateId!.Value)).Distinct().ToList();
        }
        else if (filterType == "District" && _selDistricts.Any())
        {
            _selStates = _selStates.Union(_allDistricts.Where(d => _selDistricts.Contains(d.Id) && d.StateId.HasValue).Select(d => d.StateId!.Value)).Distinct().ToList();
            _selSubDistricts.RemoveAll(id => { var sd = _allSubDistricts.FirstOrDefault(x => x.Id == id); return sd == null || !_selDistricts.Contains(sd.DistrictId ?? 0); });
        }
        else if (filterType == "SubDistrict" && _selSubDistricts.Any())
        {
            _selDistricts = _selDistricts.Union(_allSubDistricts.Where(sd => _selSubDistricts.Contains(sd.Id) && sd.DistrictId.HasValue).Select(sd => sd.DistrictId!.Value)).Distinct().ToList();
            _selStates = _selStates.Union(_allSubDistricts.Where(sd => _selSubDistricts.Contains(sd.Id) && sd.StateId.HasValue).Select(sd => sd.StateId!.Value)).Distinct().ToList();
        }

        _states = _allStates;
        _regions = _selStates.Any() ? _allRegions.Where(r => _selStates.Contains(r.StateId ?? 0)).ToList() : _allRegions;
        _hq = _selRegions.Any() ? _allHqs.Where(h => _selRegions.Contains(h.RegionId ?? 0)).ToList()
              : (_selStates.Any() ? _allHqs.Where(h => _selStates.Contains(h.StateId ?? 0)).ToList() : _allHqs);
        _districts = _selStates.Any() ? _allDistricts.Where(d => _selStates.Contains(d.StateId ?? 0)).ToList() : _allDistricts;
        _subDistricts = _selDistricts.Any() ? _allSubDistricts.Where(sd => _selDistricts.Contains(sd.DistrictId ?? 0)).ToList()
                        : (_selStates.Any() ? _allSubDistricts.Where(sd => _selStates.Contains(sd.StateId ?? 0)).ToList() : _allSubDistricts);

        StateHasChanged();
        await RefreshSelect2Hierarchy();
    }

    private async Task RefreshSelect2Hierarchy()
    {
        var ids = new[] { "ar-state-select", "ar-region-select", "ar-hq-select", "ar-district-select", "ar-subdistrict-select" };
        await JS.InvokeVoidAsync("spicSelect2.destroyMultiple", ids);
        await Task.Delay(50);
        var configs = new[]
        {
            new { id = "ar-state-select", method = nameof(OnStateChanged) },
            new { id = "ar-region-select", method = nameof(OnRegionChanged) },
            new { id = "ar-hq-select", method = nameof(OnHqChanged) },
            new { id = "ar-district-select", method = nameof(OnDistrictChanged) },
            new { id = "ar-subdistrict-select", method = nameof(OnSubDistrictChanged) }
        };
        await JS.InvokeVoidAsync("spicSelect2.initMultiple", configs, _objRef);
    }

    private async Task<List<LocationDto>> FetchData(string url)
    {
        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(20));
            var raw = await Http.GetFromJsonAsync<List<JsonElement>>(url, cts.Token);
            var list = new List<LocationDto>();
            if (raw == null) return list;
            foreach (var item in raw)
            {
                var id = item.GetProperty("id").GetInt32();
                string name = "";
                if (item.TryGetProperty("name", out var n)) name = n.GetString() ?? "";
                else if (item.TryGetProperty("stateName", out n)) name = n.GetString() ?? "";
                else if (item.TryGetProperty("regionName", out n)) name = n.GetString() ?? "";
                else if (item.TryGetProperty("headquarterName", out n)) name = n.GetString() ?? "";
                else if (item.TryGetProperty("districtName", out n)) name = n.GetString() ?? "";
                else if (item.TryGetProperty("subDistrictName", out n)) name = n.GetString() ?? "";

                var dto = new LocationDto { Id = id, Name = name };
                if (item.TryGetProperty("stateId", out var s) && s.ValueKind == JsonValueKind.Number) dto.StateId = s.GetInt32();
                if (item.TryGetProperty("regionId", out var r) && r.ValueKind == JsonValueKind.Number) dto.RegionId = r.GetInt32();
                if (item.TryGetProperty("districtId", out var d) && d.ValueKind == JsonValueKind.Number) dto.DistrictId = d.GetInt32();
                list.Add(dto);
            }
            return list;
        }
        catch { return new List<LocationDto>(); }
    }

    public void Dispose()
    {
        _loadCts?.Cancel(); _loadCts?.Dispose();
        _searchDebounce?.Dispose();
        _objRef?.Dispose();
    }
