                        <td>Tamil Nadu</td>
                        <td>Monsoon Agro Centre</td>
                        <td>Neem Coated Urea (45 Kg)</td>
                        <td>15.3</td>
                        <td class="ar-txt-dgreen">3</td>
                        <td>
                            <div class="ar-status ar-st-dgreen">
                                <div class="dot"></div>Fresh
                            </div>
