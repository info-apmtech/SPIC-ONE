            </div>
            <div class="ar-stat-trend">
                <svg class="ar-trend-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg>
                <span class="ar-text-green">3.18 Days vs last period</span>
            </div>
        </div>

        <div class="ar-stat-card ar-theme-yellow">
            <div class="ar-card-top">
                <div class="ar-stat-info">
                    <span class="ar-stat-title">30-60 Days Stock (MT)</span>
                    <span class="ar-stat-value">15,300</span>
                </div>
                <div class="ar-icon-box"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line><rect x="14" y="14" width="4" height="4"></rect></svg></div>
            </div>
            <div class="ar-stat-trend">
                <svg class="ar-trend-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg>
                <span class="ar-text-green">2.15% vs last period</span>
            </div>
        </div>

        <div class="ar-stat-card ar-theme-red">
            <div class="ar-card-top">
                <div class="ar-stat-info">
                    <span class="ar-stat-title">60+ Days Stock (MT)</span>
                    <span class="ar-stat-value">10,300</span>
                </div>
                <div class="ar-icon-box"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v4"></path><path d="M12 18v4"></path><path d="M4.93 4.93l2.83 2.83"></path><path d="M16.24 16.24l2.83 2.83"></path><path d="M2 12h4"></path><path d="M18 12h4"></path><path d="M4.93 19.07l2.83-2.83"></path><path d="M16.24 7.76l2.83-2.83"></path><path d="M14 18l-2-4-2 4h4z" fill="#fef2f2" stroke="#dc2626"></path><line x1="12" y1="14" x2="12" y2="16" stroke="#dc2626"></line></svg></div>
            </div>
            <div class="ar-stat-trend">
                <svg class="ar-trend-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg>
