@page "/AgeingReport"
@inject IJSRuntime JS


<div class="container-fluid py-4 px-0">
        
    <div class="ar-header-container">
        <div class="ar-header-text">
            <h1>Ageing Report</h1>
            <p>Monitor stock ageing and identify slow-moving inventory</p>
        </div>
        
        <div class="ar-action-buttons">
            <button class="ar-btn ar-btn-outline"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2v6h-6"></path><path d="M3 12a9 9 0 1 0 2.13-5.88L2 9"></path></svg> Refresh Data</button>
            <button class="ar-btn ar-btn-outline"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><path d="M8 13h2"></path><path d="M8 17h2"></path><path d="M14 13h2"></path><path d="M14 17h2"></path></svg> Excel</button>
            <button class="ar-btn ar-btn-outline"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><path d="M9 15v-4"></path><path d="M12 15v-4c1 0 2 1 2 2s-1 2-2 2"></path><path d="M16 11v4"></path><path d="M16 13h2"></path></svg> PDF</button>
            <button class="ar-btn ar-btn-solid"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg> Send Mail</button>
        </div>
    </div>
    <div class="ar-filter-card">
        <div class="ar-filter-header">
            <div class="ar-filter-title">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="4" y1="6" x2="20" y2="6"></line>
                    <line x1="6" y1="12" x2="18" y2="12"></line>
                    <line x1="8" y1="18" x2="16" y2="18"></line>
                </svg>
                Filters
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
        </div>
        
        <div class="ar-filter-body">
            <div class="ar-filter-grid">
                <div class="ar-form-group">
                    <label class="ar-form-label">State</label>
                    <select class="ar-form-select"><option>All State</option></select>
                </div>
                <div class="ar-form-group">
                    <label class="ar-form-label">Region</label>
                    <select class="ar-form-select"><option>All Region</option></select>
                </div>
                <div class="ar-form-group">
                    <label class="ar-form-label">Head Quarters</label>
                    <select class="ar-form-select"><option>All Head Quarters</option></select>
                </div>
                <div class="ar-form-group">
                    <label class="ar-form-label">District</label>
                    <select class="ar-form-select"><option>All District</option></select>
                </div>
                <div class="ar-form-group">
                    <label class="ar-form-label">Sub District</label>
                    <select class="ar-form-select"><option>All Sub Districts</option></select>
                </div>
                <div class="ar-form-group">
                    <label class="ar-form-label">Lying with</label>
                    <select class="ar-form-select"><option>Select All</option></select>
                </div>
                <div class="ar-form-group">
                    <label class="ar-form-label">Product</label>
                    <select class="ar-form-select"><option>All Products</option></select>
                </div>
                <div class="ar-form-group">
                    <label class="ar-form-label">Ageing Range (Days)</label>
                    <select class="ar-form-select"><option>All Ranges</option></select>
                </div>
            </div>
            
            <div class="ar-filter-actions">
                <button class="ar-btn ar-btn-outline">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                    Clear All
                </button>
                <button class="ar-btn ar-btn-solid">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="4" y1="6" x2="20" y2="6"></line>
                        <line x1="6" y1="12" x2="18" y2="12"></line>
                        <line x1="8" y1="18" x2="16" y2="18"></line>
                    </svg>
                    Apply Filters
                </button>
            </div>
        </div>
    </div>
