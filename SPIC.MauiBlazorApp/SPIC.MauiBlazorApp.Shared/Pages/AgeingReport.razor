<StockAgeingDetailsDrawer @bind-IsOpen="isAgeingDetailsOpen" />

@code {
    private bool isAgeingDetailsOpen = false;

    private void OpenAgeingDetails()
    {
        isAgeingDetailsOpen = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(100); 
            await JS.InvokeVoidAsync("loadAgeingCharts");
        }
    }
}