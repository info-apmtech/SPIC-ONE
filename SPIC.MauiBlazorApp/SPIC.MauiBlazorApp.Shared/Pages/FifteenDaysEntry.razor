    private MarkupString IconFor(string name) =>
        new(ProductIconSvgs.TryGetValue(name, out var svg) ? svg : "<i class=\"bi bi-box-seam\"></i>");

    private string pageTitle => currentStep switch
    {
        "Income" => "Income Entry",
        "Expense" => "Expense Entry",
        "Review" => "15-Day Report Review",
        _ => "Inventory Entry"
    };

    private string pageSubtitle => currentStep switch
    {
        "Income" => "Enter each sale once. Inventory sold quantity updates automatically.",
        "Expense" => "Record farm expenses for this reporting period.",
        "Review" => "Review your inventory, income and expense details before final submission.",
        _ => "Enter stock changes for this 15-day reporting period. Closing stock is calculated automatically."
    };

    private string backLabel => currentStep switch
    {
        "Income" => "Back to Inventory Entry",
        "Expense" => "Back to Income Entry",
        "Review" => "Back to Expense Entry",
        _ => "Back to Dashboard"
    };

    private string continueLabel => currentStep switch
    {
        "Income" => "Continue to Expense",
        "Expense" => "Continue to Review",
        "Review" => "Submit 15-Day Report",
        _ => "Continue to Income"
    };

    private void BackClicked()
    {
        if (currentStep == "Inventory")
        {
            Nav.NavigateTo(LoginState.LandingPage);
            return;
        }

        currentStep = currentStep switch
        {
            "Income" => "Inventory",
            "Expense" => "Income",
            "Review" => "Expense",
            _ => currentStep
        };
    }

    private void BackToList() => Nav.NavigateTo("/ProductRateManagement");

    private void SaveDraft() => Toast.Success("Saved as draft.");

    private void ContinueClicked()
    {
        if (currentStep == "Review")
        {
            showSubmitConfirm = true;
            return;
        }

        currentStep = currentStep switch
        {
            "Inventory" => "Income",
            "Income" => "Expense",
            "Expense" => "Review",
            _ => currentStep
        };

        Toast.Info(currentStep == "Review" ? "Ready to review." : $"Saved. Continue with {currentStep}.");
    }

    private async Task DeleteRow(LedgerRow row)
    {
        var ok = await Toast.ConfirmAsync("Remove product?", $"Remove \"{row.Name}\" from this period's ledger? This cannot be undone.", "Remove", danger: true);
        if (!ok) return;

        ledgerRows.Remove(row);
        Toast.Success($"\"{row.Name}\" removed from this period's ledger.");
    }
}
