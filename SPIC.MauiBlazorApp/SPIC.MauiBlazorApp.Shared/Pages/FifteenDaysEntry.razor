@page "/15daysEntry"
@inject NavigationManager Nav
@inject LoginState LoginState
@inject ToastService Toast

@*
    SAS portal: the periodic (15-day) farm report - Inventory, Income, Expense and
    Review are all steps of this ONE report, not separate pages, hence the page-level
    name/route rather than "InventoryEntry". Route is "/15daysEntry"; the file/class
    is named FifteenDaysEntry instead since C# identifiers can't start with a digit.
    UI-first pass: the reporting periods and ledger rows below are all in-memory (no
    backend yet), same approach as ProductRateManagement.razor. Not yet wired into
    the sidebar nav.
*@

<div class="ie-page">

    @if (reportSubmitted)
    {
        <PageHeader Title="Request Extension"
                    Subtitle="Submit a request to extend the Scheme period as the required turnover has been achieved."
                    ShowBack="false">
            <Actions>
                <button type="button" class="ie-btn ie-btn-outline" @onclick="BackToReview">
                    <i class="bi bi-arrow-left"></i> Back to Period and Review
                </button>
            </Actions>
        </PageHeader>

        <div class="ie-success-card">
            <div class="ie-success-badge"><i class="bi bi-patch-check-fill"></i></div>
            <h1 class="ie-success-title">15-Day Report Submitted Successfully!</h1>
            <p class="ie-success-subtitle">Your report has been submitted for the selected period</p>

            <div class="ie-success-details">
                <div class="ie-success-detail-row">
                    <div><span>Reporting Period</span><strong>01 - 15 Sept 2026</strong></div>
                    <div><span>Submitted By</span><strong>@SubmittedByDisplay</strong></div>
                </div>
                <div class="ie-success-detail-row">
                    <div><span>Submitted On</span><strong>@(submittedAt?.ToString("dd MMMM yyyy, hh:mm tt") ?? "-")</strong></div>
                    <div><span>Status</span><strong><span class="ie-badge ie-badge-emerald">● Submitted</span></strong></div>
                </div>
            </div>

            <div class="ie-summary-grid">
                <div class="ie-summary-card ie-summary-green">
                    <div class="ie-summary-top">
                        <span class="ie-summary-label">Total Income</span>
                        <span class="ie-summary-icon"><i class="bi bi-file-earmark-arrow-up"></i></span>
                    </div>
                    <div class="ie-summary-value">₹@IncomeGrandTotal.ToString("N0")</div>
                </div>

                <div class="ie-summary-card ie-summary-rose">
                    <div class="ie-summary-top">
                        <span class="ie-summary-label">Total Expense</span>
                        <span class="ie-summary-icon"><i class="bi bi-clock-history"></i></span>
                    </div>
                    <div class="ie-summary-value">₹@MainCategoriesTotal.ToString("N0")</div>
                </div>

                <div class="ie-summary-card ie-summary-violet">
                    <div class="ie-summary-top">
                        <span class="ie-summary-label">Net Profit</span>
                        <span class="ie-summary-icon"><i class="bi bi-clock-history"></i></span>
                    </div>
                    <div class="ie-summary-value">₹@NetProfit.ToString("N0")</div>
                </div>
            </div>

            <div class="ie-success-actions">
                <button type="button" class="ie-btn ie-btn-outline" @onclick="BackToReview">
                    <i class="bi bi-eye"></i> View Submitted Report
                </button>
                <button type="button" class="ie-btn ie-btn-primary" @onclick="GoToFinanceSummary">
                    Go to finance summary <i class="bi bi-arrow-right"></i>
                </button>
            </div>
        </div>
    }
    else
    {

    <div class="ie-steps">
        <button type="button" class='ie-step @(currentStep == "Inventory" ? "active" : "")' @onclick='() => currentStep = "Inventory"'>Inventory</button>
        <button type="button" class='ie-step @(currentStep == "Income" ? "active" : "")' @onclick='() => currentStep = "Income"'>Income</button>
        <button type="button" class='ie-step @(currentStep == "Expense" ? "active" : "")' @onclick='() => currentStep = "Expense"'>Expense</button>
        <button type="button" class='ie-step @(currentStep == "Review" ? "active" : "")' @onclick='() => currentStep = "Review"'>Review</button>
    </div>

    <PageHeader Title="@pageTitle"
                Subtitle="@pageSubtitle"
                ShowBack="false">
        <TitleBadge>
            @if (currentStep == "Review")
            {
                <span class="ie-ready-badge">Ready to submit</span>
            }
        </TitleBadge>
        <Actions>
            <button type="button" class="ie-btn ie-btn-outline" @onclick="BackClicked">
                <i class="bi bi-arrow-left"></i> @backLabel
            </button>
        </Actions>
    </PageHeader>

    @if (currentStep == "Income")
    {
        <div class="ie-summary-grid ie-summary-grid-4">
            <div class="ie-summary-card ie-summary-green">
                <div class="ie-summary-top">
                    <span class="ie-summary-label">Total Farm Income</span>
                    <span class="ie-summary-icon"><i class="bi bi-file-earmark-arrow-up"></i></span>
                </div>
                <div class="ie-summary-value">₹1,75,000</div>
                <div class="ie-summary-bottom">
                    <span class="ie-summary-desc"><i class="bi bi-arrow-up-short"></i> 12.4% higher than previous 15-day report</span>
                </div>
            </div>

            <div class="ie-summary-card ie-summary-blue">
                <div class="ie-summary-top">
                    <span class="ie-summary-label">Livestock Income</span>
                    <span class="ie-summary-icon"><i class="bi bi-journal-text"></i></span>
                </div>
                <div class="ie-summary-value">₹85,000</div>
                <div class="ie-summary-bottom">
                    <span class="ie-summary-desc">Multiple selling rates used in some entries</span>
                </div>
            </div>

            <div class="ie-summary-card ie-summary-violet">
                <div class="ie-summary-top">
                    <span class="ie-summary-label">Orchard Income</span>
                    <span class="ie-summary-icon"><i class="bi bi-tree"></i></span>
                </div>
                <div class="ie-summary-value">₹62,500</div>
                <div class="ie-summary-bottom">
                    <span class="ie-summary-desc">From orchard sales</span>
                </div>
            </div>

            <div class="ie-summary-card ie-summary-amber">
                <div class="ie-summary-top">
                    <span class="ie-summary-label">Reporting Period</span>
                    <span class="ie-summary-icon"><i class="bi bi-clock-history"></i></span>
                </div>
                <div class="ie-summary-value">01-15 Sept 2026</div>
                <div class="ie-summary-bottom">
                    <span class="ie-summary-desc">Current 15-day report</span>
                </div>
            </div>
        </div>

        <div class="ie-card">
            <h2 class="ie-card-title">Livestock Sales Ledger</h2>

            <div class="ie-table-scroll">
                <table class="ie-table">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Sold Quantity</th>
                            <th>UOM</th>
                            <th>Rate per unit</th>
                            <th>Total amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in livestockIncomeRows)
                        {
                            <tr @key="row.Id">
                                <td data-label="Product">
                                    <span class="ie-product">
                                        <span class="ie-icon">@IconFor(row.IconKey)</span>
                                        @row.Name
                                    </span>
                                </td>
                                <td data-label="Sold Quantity"><input type="number" min="0" @bind="row.SoldQuantity" /></td>
                                <td data-label="UOM">
                                    <select @bind="row.Uom">
                                        <option value="Kg">Kg</option>
                                        <option value="Unit">Unit</option>
                                        <option value="Litre">Litre</option>
                                        <option value="Nos">Nos</option>
                                    </select>
                                </td>
                                <td data-label="Rate per unit"><input type="number" min="0" @bind="row.Rate" /></td>
                                <td data-label="Total amount"><input type="text" value="@IncomeTotal(row).ToString("N0")" disabled class="ie-readonly" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="ie-remarks">
                <label>Remarks</label>
                <textarea rows="3" @bind="livestockIncomeRemarks" placeholder="Need to add your remarks"></textarea>
            </div>
        </div>

        <div class="ie-card">
            <h2 class="ie-card-title">Orchard Sales</h2>

            <div class="ie-table-scroll">
                <table class="ie-table">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>UOM</th>
                            <th>Rate Per Unit</th>
                            <th>Total amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in orchardIncomeRows)
                        {
                            <tr @key="row.Id">
                                <td data-label="Product">
                                    <span class="ie-product">
                                        <span class="ie-icon">@IconFor(row.IconKey)</span>
                                        @row.Name
                                    </span>
                                </td>
                                <td data-label="UOM">
                                    <select @bind="row.Uom">
                                        <option value="Kg">Kg</option>
                                        <option value="Unit">Unit</option>
                                        <option value="Litre">Litre</option>
                                        <option value="Nos">Nos</option>
                                    </select>
                                </td>
                                <td data-label="Rate Per Unit"><input type="number" min="0" @bind="row.Rate" /></td>
                                <td data-label="Total amount"><input type="text" value="@OrchardTotal(row).ToString("N0")" disabled class="ie-readonly" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="ie-remarks">
                <label>Remarks</label>
                <textarea rows="3" @bind="orchardIncomeRemarks" placeholder="Need to add your remarks"></textarea>
            </div>
        </div>
    }
    else if (currentStep == "Expense")
    {
        <div class="ie-summary-grid ie-summary-grid-4">
            <div class="ie-summary-card ie-summary-green">
                <div class="ie-summary-top">
                    <span class="ie-summary-label">Total Expense (This Period)</span>
                    <span class="ie-summary-icon"><i class="bi bi-file-earmark-arrow-up"></i></span>
                </div>
                <div class="ie-summary-value">₹@MainCategoriesTotal.ToString("N0")</div>
                <div class="ie-summary-bottom">
                    <span class="ie-summary-desc">Current 15-day period</span>
                </div>
            </div>

            <div class="ie-summary-card ie-summary-blue">
                <div class="ie-summary-top">
                    <span class="ie-summary-label">Highest Expense</span>
                    <span class="ie-summary-icon"><i class="bi bi-file-earmark-arrow-up"></i></span>
                </div>
                <div class="ie-summary-value">₹@HighestExpenseAmount.ToString("N0")</div>
                <div class="ie-summary-bottom">
                    <span class="ie-summary-desc">@HighestExpenseCategory</span>
                </div>
            </div>

            <div class="ie-summary-card ie-summary-violet">
                <div class="ie-summary-top">
                    <span class="ie-summary-label">Expense Categories</span>
                    <span class="ie-summary-icon"><i class="bi bi-grid-3x3-gap"></i></span>
                </div>
                <div class="ie-summary-value">@mainExpenseRows.Count Main Categories</div>
                <div class="ie-summary-bottom">
                    <span class="ie-summary-desc">Miscellaneous is one of these @mainExpenseRows.Count</span>
                </div>
            </div>

            <div class="ie-summary-card ie-summary-amber">
                <div class="ie-summary-top">
                    <span class="ie-summary-label">Reporting Period</span>
                    <span class="ie-summary-icon"><i class="bi bi-clock-history"></i></span>
                </div>
                <div class="ie-summary-value">01-15 Sept 2026</div>
                <div class="ie-summary-bottom">
                    <span class="ie-summary-desc">Current 15-day report</span>
                </div>
            </div>
        </div>

        <div class="ie-card">
            <div class="ie-card-head">
                <div class="ie-card-head-icon ie-card-head-icon-green"><i class="bi bi-house-gear"></i></div>
                <div>
                    <h2 class="ie-card-title">Expenditure Breakup <span class="ie-card-title-sub">(Farm Operations)</span></h2>
                    <p class="ie-card-subtitle">Enter the expenses for farm operations for this 15-days period</p>
                </div>
                <button type="button" class="ie-btn ie-btn-outline ie-card-head-action" @onclick="AddMainCategory">
                    <i class="bi bi-plus-lg"></i> Add New Category
                </button>
            </div>

            <div class="ie-table-scroll">
                <table class="ie-table ie-expense-table">
                    <thead>
                        <tr>
                            <th>S.NO</th>
                            <th>Expense Category</th>
                            <th>Amount (₹)</th>
                            <th class="ie-col-action">Unit</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < mainExpenseRows.Count; i++)
                        {
                            var row = mainExpenseRows[i];
                            <tr @key="row.Id">
                                <td data-label="S.NO">@(i + 1)</td>
                                <td data-label="Expense Category">
                                    @row.Category
                                    @if (row.IsAutoCalculated)
                                    {
                                        <span class="ie-auto-note">Auto-calculated from sub-categories</span>
                                    }
                                </td>
                                <td data-label="Amount (₹)">
                                    <div class="ie-currency-input">
                                        <span>₹</span>
                                        @if (row.IsAutoCalculated)
                                        {
                                            <input type="text" value="@SubCategoriesTotal.ToString("N2")" disabled class="ie-readonly" />
                                        }
                                        else
                                        {
                                            <input type="number" min="0" step="0.01" @bind="row.Amount" />
                                        }
                                    </div>
                                </td>
                                <td data-label="Unit" class="ie-col-action">
                                    <button type="button" class="ie-action-btn ie-action-edit" title="Edit">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="ie-total-row">
                            <td colspan="4">
                                <div class="ie-total-bar">
                                    <span>Total (Main @mainExpenseRows.Count Categories)</span>
                                    <strong>₹ @MainCategoriesTotal.ToString("N0")</strong>
                                </div>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="ie-remarks">
                <label>Remarks</label>
                <textarea rows="3" @bind="mainExpenseRemarks" placeholder="Need to add your remarks"></textarea>
            </div>
        </div>

        <div class="ie-card">
            <div class="ie-card-head">
                <div class="ie-card-head-icon ie-card-head-icon-violet"><i class="bi bi-boxes"></i></div>
                <div>
                    <h2 class="ie-card-title">Miscellaneous Expenditure <span class="ie-card-title-sub">(Sub Categories)</span></h2>
                    <p class="ie-card-subtitle">Enter expenses under Miscellaneous category for this 15-day period</p>
                </div>
                <button type="button" class="ie-btn ie-btn-outline ie-card-head-action" @onclick="AddSubCategory">
                    <i class="bi bi-plus-lg"></i> Add New Sub Category
                </button>
            </div>

            <div class="ie-table-scroll">
                <table class="ie-table ie-expense-table">
                    <thead>
                        <tr>
                            <th>S.NO</th>
                            <th>Expense Category</th>
                            <th>Amount (₹)</th>
                            <th class="ie-col-action">Unit</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < subExpenseRows.Count; i++)
                        {
                            var row = subExpenseRows[i];
                            <tr @key="row.Id">
                                <td data-label="S.NO">@(i + 1)</td>
                                <td data-label="Expense Category">@row.Category</td>
                                <td data-label="Amount (₹)">
                                    <div class="ie-currency-input">
                                        <span>₹</span>
                                        <input type="number" min="0" step="0.01" @bind="row.Amount" />
                                    </div>
                                </td>
                                <td data-label="Unit" class="ie-col-action">
                                    <button type="button" class="ie-action-btn ie-action-edit" title="Edit">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="ie-total-row">
                            <td colspan="4">
                                <div class="ie-total-bar">
                                    <span>Total (Sub Categories)</span>
                                    <strong>₹ @SubCategoriesTotal.ToString("N0")</strong>
                                </div>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="ie-remarks">
                <label>Remarks</label>
                <textarea rows="3" @bind="subExpenseRemarks" placeholder="Need to add your remarks"></textarea>
            </div>
        </div>
    }
    else if (currentStep == "Review")
    {
        <div class="ie-summary-grid ie-summary-grid-4">
            <div class="ie-summary-card ie-summary-green">
                <div class="ie-summary-top">
                    <span class="ie-summary-label">Total Income</span>
                    <span class="ie-summary-icon"><i class="bi bi-file-earmark-arrow-up"></i></span>
                </div>
                <div class="ie-summary-value">₹@IncomeGrandTotal.ToString("N0")</div>
                <div class="ie-summary-bottom">
                    <span class="ie-summary-desc">From 01 - 15 Sept 2026</span>
                </div>
            </div>

            <div class="ie-summary-card ie-summary-rose">
                <div class="ie-summary-top">
                    <span class="ie-summary-label">Total Expense</span>
                    <span class="ie-summary-icon"><i class="bi bi-clock-history"></i></span>
                </div>
                <div class="ie-summary-value">₹@MainCategoriesTotal.ToString("N0")</div>
                <div class="ie-summary-bottom">
                    <span class="ie-summary-desc">From 01 - 15 Sept 2026</span>
                </div>
            </div>

            <div class="ie-summary-card ie-summary-violet">
                <div class="ie-summary-top">
                    <span class="ie-summary-label">Net Profit</span>
                    <span class="ie-summary-icon"><i class="bi bi-clock-history"></i></span>
                </div>
                <div class="ie-summary-value">₹@NetProfit.ToString("N0")</div>
                <div class="ie-summary-bottom">
                    <span class="ie-summary-desc">Income - Expense</span>
                </div>
            </div>

            <div class="ie-summary-card ie-summary-amber">
                <div class="ie-summary-top">
                    <span class="ie-summary-label">Reporting Period</span>
                    <span class="ie-summary-icon"><i class="bi bi-clock-history"></i></span>
                </div>
                <div class="ie-summary-value">01-15 Sept 2026</div>
                <div class="ie-summary-bottom">
                    <span class="ie-summary-desc"><i class="bi bi-info-circle"></i> Upcoming</span>
                </div>
            </div>
        </div>

        <div class="ie-card ie-review-card">
            <div class="ie-review-head">
                <div>
                    <h2 class="ie-card-title">Inventory Summary</h2>
                    <p class="ie-card-subtitle">Stock position for this 15-day period</p>
                </div>
                <div class="ie-review-head-actions">
                    <button type="button" class="ie-btn ie-btn-outline" @onclick='() => currentStep = "Inventory"'>Edit Inventory</button>
                    <button type="button" class="ie-review-toggle" @onclick="() => inventorySummaryExpanded = !inventorySummaryExpanded">
                        <i class="bi @(inventorySummaryExpanded ? "bi-chevron-up" : "bi-chevron-down")"></i>
                    </button>
                </div>
            </div>

            @if (inventorySummaryExpanded)
            {
                <h3 class="ie-review-subhead">Live Stock</h3>
                <div class="ie-table-scroll">
                    <table class="ie-table ie-review-table">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Opening Stock</th>
                                <th>Purchase / Old Quantity</th>
                                <th>Hatched / New Breed</th>
                                <th>Sold <span class="ie-th-badge">Auto from Income</span></th>
                                <th>Mortality</th>
                                <th>Others</th>
                                <th>Closing Stock</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in ledgerRows)
                            {
                                <tr @key="row.Id">
                                    <td data-label="Product">
                                        <span class="ie-product">
                                            <span class="ie-icon">@IconFor(row.IconKey)</span>
                                            @row.Name
                                        </span>
                                    </td>
                                    <td data-label="Opening Stock">@row.Opening</td>
                                    <td data-label="Purchase / Old Quantity">@row.Purchase</td>
                                    <td data-label="Hatched / New Breed">@row.Hatched</td>
                                    <td data-label="Sold">@row.Sold</td>
                                    <td data-label="Mortality">@row.Mortality</td>
                                    <td data-label="Others">@row.Others</td>
                                    <td data-label="Closing Stock" class="ie-review-highlight">@ClosingStock(row)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="ie-card ie-review-card">
            <div class="ie-review-head">
                <div>
                    <h2 class="ie-card-title">Income Summary</h2>
                    <p class="ie-card-subtitle">Sales income for this 15-day period</p>
                </div>
                <div class="ie-review-head-actions">
                    <button type="button" class="ie-btn ie-btn-outline" @onclick='() => currentStep = "Income"'>Edit Income</button>
                    <button type="button" class="ie-review-toggle" @onclick="() => incomeSummaryExpanded = !incomeSummaryExpanded">
                        <i class="bi @(incomeSummaryExpanded ? "bi-chevron-up" : "bi-chevron-down")"></i>
                    </button>
                </div>
            </div>

            @if (incomeSummaryExpanded)
            {
                <h3 class="ie-review-subhead">Live Stock</h3>
                <div class="ie-table-scroll">
                    <table class="ie-table ie-review-table">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Sold Quantity</th>
                                <th>UOM</th>
                                <th>Rate per unit</th>
                                <th>Total Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in livestockIncomeRows)
                            {
                                <tr @key="row.Id">
                                    <td data-label="Product">
                                        <span class="ie-product">
                                            <span class="ie-icon">@IconFor(row.IconKey)</span>
                                            @row.Name
                                        </span>
                                    </td>
                                    <td data-label="Sold Quantity">@row.SoldQuantity</td>
                                    <td data-label="UOM">@row.Uom</td>
                                    <td data-label="Rate per unit">₹@row.Rate.ToString("N0")</td>
                                    <td data-label="Total Amount" class="ie-review-highlight">₹@IncomeTotal(row).ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="ie-total-row">
                                <td colspan="5">
                                    <div class="ie-total-bar">
                                        <span>&nbsp;</span>
                                        <strong>₹ @LivestockIncomeTotal.ToString("N0")</strong>
                                    </div>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <h3 class="ie-review-subhead">Orchard Income</h3>
                <div class="ie-table-scroll">
                    <table class="ie-table ie-review-table">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>UOM</th>
                                <th>Rate per unit</th>
                                <th>Total Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in orchardIncomeRows)
                            {
                                <tr @key="row.Id">
                                    <td data-label="Product">
                                        <span class="ie-product">
                                            <span class="ie-icon">@IconFor(row.IconKey)</span>
                                            @row.Name
                                        </span>
                                    </td>
                                    <td data-label="UOM">@row.Uom</td>
                                    <td data-label="Rate per unit">₹@row.Rate.ToString("N0")</td>
                                    <td data-label="Total Amount" class="ie-review-highlight">₹@OrchardTotal(row).ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="ie-total-row">
                                <td colspan="4">
                                    <div class="ie-total-bar">
                                        <span>Total Income :</span>
                                        <strong>₹ @IncomeGrandTotal.ToString("N0")</strong>
                                    </div>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <div class="ie-overall-bar ie-overall-green">
                    <span>Over All Total Income Summary :</span>
                    <strong>₹ @IncomeGrandTotal.ToString("N0")</strong>
                </div>

                <div class="ie-remarks">
                    <label>Remarks</label>
                    <textarea rows="3" disabled placeholder="Need to add your remarks">@CombinedIncomeRemarks</textarea>
                </div>
            }
        </div>

        <div class="ie-card ie-review-card">
            <div class="ie-review-head ie-review-head-rose">
                <div>
                    <h2 class="ie-card-title">Expense Summary</h2>
                    <p class="ie-card-subtitle">All expenses for this 15-day period</p>
                </div>
                <div class="ie-review-head-actions">
                    <button type="button" class="ie-btn ie-btn-outline" @onclick='() => currentStep = "Expense"'>Edit Expense Summary</button>
                    <button type="button" class="ie-review-toggle" @onclick="() => expenseSummaryExpanded = !expenseSummaryExpanded">
                        <i class="bi @(expenseSummaryExpanded ? "bi-chevron-up" : "bi-chevron-down")"></i>
                    </button>
                </div>
            </div>

            @if (expenseSummaryExpanded)
            {
                <div class="ie-review-expense-grid">
                    <div>
                        <h3 class="ie-review-subhead">Expenditure Breakup</h3>
                        <div class="ie-table-scroll">
                            <table class="ie-table ie-review-table ie-review-table-rose">
                                <thead>
                                    <tr>
                                        <th>Expense Category</th>
                                        <th>Amount (₹)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in mainExpenseRows)
                                    {
                                        <tr @key="row.Id">
                                            <td data-label="Expense Category" class="ie-review-ellipsis">@row.Category</td>
                                            <td data-label="Amount (₹)">₹@(row.IsAutoCalculated ? SubCategoriesTotal : row.Amount).ToString("N0")</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="ie-total-row">
                                        <td colspan="2">
                                            <div class="ie-total-bar ie-total-bar-rose">
                                                <span>Total Expense :</span>
                                                <strong>₹ @MainCategoriesTotal.ToString("N0")</strong>
                                            </div>
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>

                    <div>
                        <h3 class="ie-review-subhead">Miscellaneous Expenditure <span class="ie-card-title-sub">(Sub Categories)</span></h3>
                        <div class="ie-table-scroll">
                            <table class="ie-table ie-review-table ie-review-table-rose">
                                <thead>
                                    <tr>
                                        <th>Expense Category</th>
                                        <th>Amount (₹)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in subExpenseRows)
                                    {
                                        <tr @key="row.Id">
                                            <td data-label="Expense Category" class="ie-review-ellipsis">@row.Category</td>
                                            <td data-label="Amount (₹)">₹@row.Amount.ToString("N0")</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="ie-total-row">
                                        <td colspan="2">
                                            <div class="ie-total-bar ie-total-bar-rose">
                                                <span>Total Expense :</span>
                                                <strong>₹ @SubCategoriesTotal.ToString("N0")</strong>
                                            </div>
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="ie-overall-bar ie-overall-rose">
                    <span>Over All Total Expense Summary :</span>
                    <strong>₹ @MainCategoriesTotal.ToString("N0")</strong>
                </div>

                <div class="ie-remarks">
                    <label>Remarks</label>
                    <textarea rows="3" disabled placeholder="Need to add your remarks">@CombinedExpenseRemarks</textarea>
                </div>
            }
        </div>
    }
    else if (currentStep != "Inventory")
    {
        <div class="ie-card ie-placeholder">
            <EmptyState Icon="bi-hourglass-split" Title="@($"{currentStep} - coming soon")" Message="This step of the reporting flow isn't built yet." />
        </div>
    }
    else
    {
        <div class="ie-summary-grid">
            <div class="ie-summary-card ie-summary-green">
                <div class="ie-summary-top">
                    <span class="ie-summary-label">Current Reporting</span>
                    <span class="ie-summary-icon"><i class="bi bi-file-earmark-arrow-up"></i></span>
                </div>
                <div class="ie-summary-value">01-15 Sept 2026</div>
                <div class="ie-summary-bottom">
                    <span class="ie-summary-desc">Enter stock changes for this period</span>
                    <span class="ie-badge ie-badge-amber">Ready for Update</span>
                </div>
            </div>

            <div class="ie-summary-card ie-summary-blue">
                <div class="ie-summary-top">
                    <span class="ie-summary-label">Previous Period</span>
                    <span class="ie-summary-icon"><i class="bi bi-file-earmark-arrow-up"></i></span>
                </div>
                <div class="ie-summary-value">16-31 Aug 2026</div>
                <div class="ie-summary-bottom">
                    <span class="ie-summary-desc">Closing stock: 132 Nos</span>
                    <span class="ie-badge ie-badge-emerald">Completed</span>
                </div>
            </div>

            <div class="ie-summary-card ie-summary-violet">
                <div class="ie-summary-top">
                    <span class="ie-summary-label">Next Reporting Period</span>
                    <span class="ie-summary-icon"><i class="bi bi-clock-history"></i></span>
                </div>
                <div class="ie-summary-value">16-30 Sept 2026</div>
                <div class="ie-summary-bottom">
                    <span class="ie-summary-desc">Will be available after current submission</span>
                    <span class="ie-badge ie-badge-violet">Upcoming</span>
                </div>
            </div>
        </div>

        <div class="ie-card">
            <h2 class="ie-card-title">Livestock Sales Ledger</h2>

            <div class="ie-table-scroll">
                <table class="ie-table">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Opening Stock</th>
                            <th>Purchase / Old Quantity</th>
                            <th>Hatched / New Breed</th>
                            <th>Sold <span class="ie-th-badge">Auto from Income</span></th>
                            <th>Mortality</th>
                            <th>Others</th>
                            <th>Closing Stock</th>
                            <th class="ie-col-action">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ledgerRows.Count == 0)
                        {
                            <tr class="ie-state-row">
                                <td colspan="9">
                                    <EmptyState Title="No products in this ledger" Message="Approved products from Product & Rate Management will appear here." />
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var row in ledgerRows)
                            {
                                <tr @key="row.Id">
                                    <td data-label="Product">
                                        <span class="ie-product">
                                            <span class="ie-icon">@IconFor(row.IconKey)</span>
                                            @row.Name
                                        </span>
                                    </td>
                                    <td data-label="Opening Stock"><input type="number" min="0" @bind="row.Opening" /></td>
                                    <td data-label="Purchase / Old Quantity"><input type="number" min="0" @bind="row.Purchase" /></td>
                                    <td data-label="Hatched / New Breed"><input type="number" min="0" @bind="row.Hatched" /></td>
                                    <td data-label="Sold"><input type="number" value="@row.Sold" disabled class="ie-readonly" /></td>
                                    <td data-label="Mortality"><input type="number" min="0" @bind="row.Mortality" /></td>
                                    <td data-label="Others"><input type="number" @bind="row.Others" /></td>
                                    <td data-label="Closing Stock"><input type="number" value="@ClosingStock(row)" disabled class="ie-readonly" /></td>
                                    <td data-label="Action" class="ie-col-action">
                                        <div class="ie-action-wrap">
                                            <button type="button" class="ie-action-btn ie-action-edit" title="Edit">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                            <button type="button" class="ie-action-btn ie-action-delete" title="Delete" @onclick="() => DeleteRow(row)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="ie-remarks">
                <label>Remarks</label>
                <textarea rows="3" @bind="remarks" placeholder="Need to add your remarks"></textarea>
            </div>
        </div>
    }

    <div class="ie-actionbar">
        <button type="button" class="ie-btn ie-btn-outline" @onclick="BackToList">
            <i class="bi bi-chevron-double-left"></i> Back to List
        </button>
        <div class="ie-actionbar-right">
            <button type="button" class="ie-btn ie-btn-outline" @onclick="SaveDraft">Save as Draft</button>
            <button type="button" class="ie-btn ie-btn-primary" @onclick="ContinueClicked">
                @continueLabel <i class="bi bi-chevron-double-right"></i>
            </button>
        </div>
    </div>
    }
</div>

@if (showSubmitConfirm)
{
    <div class="ie-modal-backdrop" @onclick="CloseSubmitConfirm">
        <div class="ie-modal" @onclick:stopPropagation="true">
            <div class="ie-modal-header">
                <div class="ie-modal-icon"><i class="bi bi-info-circle-fill"></i></div>
                <div>
                    <h3>Submit 15-Day Report?</h3>
                    <p class="ie-modal-subtitle">You are about to submit the report for <strong>01 - 15 September 2026</strong></p>
                </div>
            </div>

            <div class="ie-modal-body">
                <div class="ie-confirm-checklist">
                    <div class="ie-confirm-checklist-row">
                        <span>Inventory Details</span>
                        <span class="ie-confirm-done">Completed <i class="bi bi-check2-all"></i></span>
                    </div>
                    <div class="ie-confirm-checklist-row">
                        <span>Income Details</span>
                        <span class="ie-confirm-done">Completed <i class="bi bi-check2-all"></i></span>
                    </div>
                    <div class="ie-confirm-checklist-row">
                        <span>Expense Details</span>
                        <span class="ie-confirm-done">Completed <i class="bi bi-check2-all"></i></span>
                    </div>
                </div>

                <div class="ie-confirm-warning">
                    <i class="bi bi-info-circle-fill"></i>
                    <span>Once submitted, this report cannot be edited unless reopened by Admin</span>
                </div>
            </div>

            <div class="ie-modal-footer">
                <button type="button" class="ie-btn ie-btn-outline" @onclick="CloseSubmitConfirm">Close</button>
                <button type="button" class="ie-btn ie-btn-primary" @onclick="ConfirmSubmit">Confirm Submit</button>
            </div>
        </div>
    </div>
}

<style>
    .ie-page {
        --ie-amber-bg: #fef3c7;
        --ie-amber-text: #92400e;
        --ie-amber-border: #fcd34d;
        --ie-emerald-bg: #d1fae5;
        --ie-emerald-text: #065f46;
        --ie-emerald-border: #6ee7b7;
        --ie-violet-bg: #ede9fe;
        --ie-violet-text: #6d28d9;
        --ie-violet-border: #c4b5fd;
        --ie-blue-bg: #dbeafe;
        --ie-blue-text: #1d4ed8;
        --ie-rose-bg: #ffe4e6;
        --ie-rose-text: #be123c;
        --ie-rose-border: #fda4af;
        color: var(--text-main);
    }

    .ie-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 16px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all .15s ease;
        white-space: nowrap;
    }

    .ie-btn-outline {
        background: #fff;
        border: 1px solid var(--primary);
        color: var(--primary);
    }

        .ie-btn-outline:hover {
            background: var(--primary-soft);
        }

    .ie-btn-primary {
        background: var(--primary);
        border: 1px solid var(--primary);
        color: #fff;
    }

        .ie-btn-primary:hover {
            background: var(--primary-dark);
        }

    /* Step tabs */
    .ie-steps {
        display: flex;
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 4px;
        gap: 4px;
        margin-bottom: 20px;
    }

    .ie-step {
        flex: 1;
        padding: 12px 10px;
        border: none;
        border-radius: 8px;
        background: transparent;
        color: var(--text-soft);
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all .15s ease;
    }

        .ie-step:hover {
            color: var(--text-main);
        }

        .ie-step.active {
            background: var(--primary);
            color: #fff;
        }

    /* Summary cards */
    .ie-summary-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin: 20px 0;
    }

    .ie-summary-grid-4 {
        grid-template-columns: repeat(4, 1fr);
    }

    .ie-summary-card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 18px 20px;
        box-shadow: 0 1px 2px rgba(0,0,0,.05);
    }

    .ie-summary-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 8px;
        margin-bottom: 10px;
    }

    .ie-summary-label {
        font-size: 13px;
        color: var(--text-soft);
        font-weight: 600;
    }

    .ie-summary-icon {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        flex-shrink: 0;
    }

    .ie-summary-green .ie-summary-icon {
        background: var(--ie-emerald-bg);
        color: var(--ie-emerald-text);
    }

    .ie-summary-blue .ie-summary-icon {
        background: var(--ie-blue-bg);
        color: var(--ie-blue-text);
    }

    .ie-summary-violet .ie-summary-icon {
        background: var(--ie-violet-bg);
        color: var(--ie-violet-text);
    }

    .ie-summary-amber .ie-summary-icon {
        background: var(--ie-amber-bg);
        color: var(--ie-amber-text);
    }

    .ie-summary-rose .ie-summary-icon {
        background: var(--ie-rose-bg);
        color: var(--ie-rose-text);
    }

    .ie-ready-badge {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 999px;
        background: var(--ie-emerald-bg);
        color: var(--ie-emerald-text);
        font-size: 12px;
        font-weight: 700;
    }

    .ie-summary-value {
        font-size: 1.3rem;
        font-weight: 700;
        color: var(--text-main);
        margin-bottom: 10px;
    }

    .ie-summary-bottom {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        flex-wrap: wrap;
    }

    .ie-summary-desc {
        font-size: 12px;
        color: var(--text-soft);
    }

    .ie-badge {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
        border: 1px solid;
        white-space: nowrap;
    }

    .ie-badge-amber {
        background: var(--ie-amber-bg);
        color: var(--ie-amber-text);
        border-color: var(--ie-amber-border);
    }

    .ie-badge-emerald {
        background: var(--ie-emerald-bg);
        color: var(--ie-emerald-text);
        border-color: var(--ie-emerald-border);
    }

    .ie-badge-violet {
        background: var(--ie-violet-bg);
        color: var(--ie-violet-text);
        border-color: var(--ie-violet-border);
    }

    /* Ledger card */
    .ie-card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 12px;
        box-shadow: 0 1px 2px rgba(0,0,0,.05);
        padding: 20px;
        margin-bottom: 20px;
    }

    .ie-placeholder {
        margin-top: 20px;
    }

    .ie-card-title {
        margin: 0 0 16px;
        font-size: 17px;
        font-weight: 700;
        color: var(--text-main);
    }

    .ie-card-head {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        margin-bottom: 16px;
    }

        .ie-card-head .ie-card-title {
            margin: 0;
            display: inline;
        }

    .ie-card-title-sub {
        font-weight: 500;
        color: var(--text-soft);
        font-size: 14px;
    }

    .ie-card-subtitle {
        margin: 4px 0 0;
        font-size: 13px;
        color: var(--text-soft);
    }

    .ie-card-head-icon {
        flex-shrink: 0;
        width: 38px;
        height: 38px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

    .ie-card-head-icon-green {
        background: var(--ie-emerald-bg);
        color: var(--ie-emerald-text);
    }

    .ie-card-head-icon-violet {
        background: var(--ie-violet-bg);
        color: var(--ie-violet-text);
    }

    .ie-card-head > div:nth-child(2) {
        flex: 1;
        min-width: 0;
    }

    .ie-card-head-action {
        flex-shrink: 0;
    }

    .ie-auto-note {
        display: block;
        font-size: 11px;
        font-weight: 400;
        color: var(--text-soft);
        margin-top: 2px;
    }

    .ie-currency-input {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 0 10px;
        border: 1px solid var(--border);
        border-radius: 6px;
        background: #fff;
    }

        .ie-currency-input:focus-within {
            border-color: var(--primary);
        }

        .ie-currency-input > span {
            color: var(--text-soft);
            font-size: 13px;
        }

        .ie-currency-input input {
            border: none !important;
            padding: 7px 0 !important;
            width: 100% !important;
        }

            .ie-currency-input input:focus {
                outline: none;
            }

        /* .ie-table input.ie-readonly (below) sets the same background/color and has
           equal specificity - without the extra .ie-expense-table ancestor here, that
           later rule would win on source order and leave a grey pill sitting inside
           the (still white) .ie-currency-input wrapper, with the rupee sign stranded
           outside it. */
        .ie-expense-table .ie-currency-input input.ie-readonly {
            background: transparent;
            color: var(--text-soft);
            cursor: not-allowed;
        }

    .ie-expense-table .ie-currency-input {
        max-width: 220px;
    }

    /* Review step: collapsible recap sections over the SAME Inventory/Income/Expense
       state entered in the earlier steps. */
    .ie-review-card {
        padding: 0;
        overflow: hidden;
    }

    .ie-review-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
        padding: 18px 20px;
        background: var(--primary-soft);
    }

        .ie-review-head .ie-card-title {
            margin: 0;
        }

    .ie-review-head-rose {
        background: var(--ie-rose-bg);
    }

    .ie-review-head-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-shrink: 0;
    }

    .ie-review-toggle {
        width: 34px;
        height: 34px;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: #fff;
        color: var(--text-soft);
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

        .ie-review-toggle:hover {
            background: var(--bg);
        }

    .ie-review-subhead {
        margin: 20px 20px 10px;
        font-size: 15px;
        font-weight: 700;
        color: var(--text-main);
    }

    .ie-review-card .ie-table-scroll {
        margin: 0 20px 16px;
        width: auto;
    }

    .ie-review-table td,
    .ie-review-table th {
        white-space: nowrap;
    }

        .ie-review-table td:not(:first-child),
        .ie-review-table th:not(:first-child) {
            text-align: center;
        }

    .ie-review-highlight {
        background: var(--primary-soft);
        font-weight: 600;
    }

    .ie-review-table-rose .ie-review-highlight {
        background: var(--ie-rose-bg);
    }

    .ie-review-expense-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        padding: 0 20px;
    }

    .ie-review-ellipsis {
        max-width: 220px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .ie-review-table-rose td:last-child,
    .ie-review-table-rose .ie-total-bar-rose strong {
        color: var(--ie-rose-text);
    }

    .ie-total-bar-rose {
        background: var(--ie-rose-bg) !important;
    }

    .ie-overall-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin: 0 20px 16px;
        padding: 14px 18px;
        border-radius: 8px;
        font-weight: 700;
        font-size: 14px;
    }

    .ie-overall-green {
        background: var(--primary-soft);
        color: var(--text-main);
    }

    .ie-overall-rose {
        background: var(--ie-rose-bg);
        color: var(--ie-rose-text);
    }

    .ie-review-card .ie-remarks {
        margin: 0 20px 20px;
    }

    .ie-review-card .ie-remarks textarea {
        background: var(--bg);
        cursor: default;
    }

    /* Submission success view - replaces the whole step flow once submitted. */

    .ie-success-card {
        padding: 40px 0 0;
        text-align: center;
    }

    .ie-success-badge {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        background: var(--primary);
        color: #fff;
        font-size: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
    }

    .ie-success-title {
        margin: 0 0 8px;
        font-size: 1.6rem;
        font-weight: 700;
        color: var(--primary-dark);
    }

    .ie-success-subtitle {
        margin: 0 0 28px;
        font-size: 14px;
        color: var(--text-soft);
    }

    .ie-success-details {
        margin: 0 0 28px;
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 10px;
        overflow: hidden;
        text-align: left;
    }

    .ie-success-detail-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
