    private void BuildCompletionSet()
    {
        _dealerStepCounts.Clear();
        foreach (var d in _allDealers)
        {
            // Count completed distinct sections for this dealer. Requirements: 12 steps total.
            int count = 0;
            if (!string.IsNullOrWhiteSpace(d.PinCode)) count++; // basic info
            if (_allExperiences.Any(x => x.DealerId == d.Id)) count++; // experience
            if (_allAnnualSales.Any(x => x.DealerId == d.Id)) count++; // annual sales
            if (_allWarehouses.Any(x => x.DealerId == d.Id) || _allRails.Any(x => x.DealerId == d.Id) || _allPorts.Any(x => x.DealerId == d.Id)) count++; // logistics
            if (_allMarketDetails.Any(x => x.DealerId == d.Id)) count++; // market details
            if (_allCompaniesOperating.Any(x => x.DealerId == d.Id)) count++; // companies operating
            if (_allOwnerships.Any(x => x.DealerId == d.Id)) count++; // ownership/proprietor
                                                                      // partners/occupations reference an ownership record via OwnershipPartnerId -> DealerOwnershipInfo.Id
            bool hasPartner = _allPartners.Any(p => _allOwnerships.Any(o => o.Id == p.OwnershipPartnerId && o.DealerId == d.Id));
            bool hasOccupation = _allOccupations.Any(o => _allOwnerships.Any(own => own.Id == o.OwnershipPartnerId && own.DealerId == d.Id));
            if (hasPartner || hasOccupation) count++; // partners/occupations
            if (_allSalesPlanning.Any(x => x.DealerId == d.Id)) count++; // sales planning
            if (_allAssetBanks.Any(x => x.DealerId == d.Id) || _allAssetLands.Any(x => x.DealerId == d.Id) || _allAssetBuildings.Any(x => x.DealerId == d.Id)) count++; // assets
            if (_allLoans.Any(x => x.DealerId == d.Id)) count++; // loans
            bool hasCreditProposal = _allCreditProposals.Any(cp => cp.DealerId == d.Id);
            bool hasCreditSales = _allCreditSales.Any(s => _allCreditProposals.Any(cp => cp.Id == s.CreditLimitId && cp.DealerId == d.Id));
            if (hasCreditProposal || hasCreditSales) count++; // credit proposal/performance
            if (_allDocuments.Any(x => x.DealerId == d.Id)) count++; // documents/enclosures

            _dealerStepCounts[d.Id] = count;
        }

        _completeDealerIds = _dealerStepCounts.Where(kv => kv.Value >= 12).Select(kv => kv.Key).ToHashSet();
    }

    private bool IsDealerComplete(int dealerId) => _dealerStepCounts.TryGetValue(dealerId, out var c) && c >= 12;

