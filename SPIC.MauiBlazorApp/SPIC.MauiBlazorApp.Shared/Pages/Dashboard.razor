    // Fetches the exact same by-filter data the real CreditLimit/CreditLimitForGreenStar pages use
    private async Task<List<DealerCreditLimitSales>> GetCreditLimitSalesByFilterDash(int dealerId, int categoryId, int financialYearId)
    {
        if (categoryId <= 0 || financialYearId <= 0) return new();
        var url = $"api/creditlimitsales/by-filter?customerId={dealerId}&categoryId={categoryId}&financialYearIds={financialYearId}";
        return await SafeGet<DealerCreditLimitSales>(url);
    }

    private async Task<decimal> GetSpicMoRecommendedCreditLimitAsync(int dealerId)
    {
        var proposal = _allCreditProposals.FirstOrDefault(p => p.DealerId == dealerId);
        if (proposal == null) return 0m;

        var fertCatId = GetFertilizerCategoryIdDash();
        var rows = await GetCreditLimitSalesByFilterDash(dealerId, fertCatId, proposal.FY3);

        var turnoverGross = rows
            .Where(s => IsUreaProductDash(s.ProductId))
            .Sum(s => s.GrossAmount);

        var turnover = ConvertToLakhsDash(turnoverGross);
        var pct = GetCreditPercentFromScoreDash(proposal.Q11Mark);
        return (turnover * (decimal)(pct / 100.0)) + proposal.AdditionalCreditLimit;
    }

    private async Task<decimal> GetGflMoRecommendedCreditLimitAsync(int dealerId)
    {
        var proposal = _allCreditProposals.FirstOrDefault(p => p.DealerId == dealerId);
        if (proposal == null) return 0m;

        var fertCatId = GetFertilizerCategoryIdDash();
        var fertRows = await GetCreditLimitSalesByFilterDash(dealerId, fertCatId, proposal.FY3);
        var fertTurnover = ConvertToLakhsDash(fertRows
            .Where(s => !IsUreaProductDash(s.ProductId))
            .Sum(s => s.GrossAmount));

        decimal spTurnover = 0m;
        foreach (var specCatId in GetSpecialityCategoryIdsDash())
        {
            var specRows = await GetCreditLimitSalesByFilterDash(dealerId, specCatId, proposal.FY3);
            spTurnover += ConvertToLakhsDash(specRows.Sum(s => s.GrossAmount));
        }

        var pct = GetCreditPercentFromScoreDash(proposal.GQ12Mark);
        return ((fertTurnover + spTurnover) * (decimal)(pct / 100.0)) + proposal.GreenstarAdditionalCreditLimit;
    }

    private decimal GetApprovalLimitDash(int dealerId, Func<DealerApprovalHistory, decimal?> selector)
    {
        var row = _allApprovalHistory
            .Where(h => h.DealerId == dealerId && h.IsApproved)
            .Where(h => (selector(h) ?? 0m) > 0m)
            .OrderByDescending(h => h.ApprovedAt)
            .FirstOrDefault();
        return row != null ? (selector(row) ?? 0m) : 0m;
    }

    private decimal GetSpicRmRecommendedCreditLimit(int dealerId) => GetApprovalLimitDash(dealerId, h => h.RmCreditLimit);
    private decimal GetGflRmRecommendedCreditLimit(int dealerId) => GetApprovalLimitDash(dealerId, h => h.RmCreditLimitGfl);
    private decimal GetSpicSmmRecommendedCreditLimit(int dealerId) => GetApprovalLimitDash(dealerId, h => h.SmCreditLimit);
    private decimal GetGflSmmRecommendedCreditLimit(int dealerId) => GetApprovalLimitDash(dealerId, h => h.SmCreditLimitGfl);
    private decimal GetSpicAvpRecommendedCreditLimit(int dealerId) => GetApprovalLimitDash(dealerId, h => h.AvpCreditLimit);
    private decimal GetGflAvpRecommendedCreditLimit(int dealerId) => GetApprovalLimitDash(dealerId, h => h.AvpCreditLimitGfl);

  private List<StateWiseSummary> GetStateWiseSummary()
    {
        // SAP counts (from full dealer table) split by company.
        var sapSpicByState = _allDealersFull
            .Where(d => d.InSpic)
            .GroupBy(d => d.StateId)
            .ToDictionary(g => g.Key, g => g.Count());
        var sapGflByState = _allDealersFull
            .Where(d => d.InGreenStar)
            .GroupBy(d => d.StateId)
            .ToDictionary(g => g.Key, g => g.Count());

        var allSapStateIds = _allDealersFull.Select(d => d.StateId).Distinct().ToHashSet();

        var savedByState = _allDealers
            .GroupBy(d => d.StateId)
            .Select(g =>
            {
                var stateName = _statesAll.FirstOrDefault(s => s.Id == g.Key)?.StateName ?? "Unknown";
                var dealers = g.ToList();

                bool IsMo(DealerDto d) => d.Status != 2 && GetApprovalStatus(d) == "Draft";
                bool IsRm(DealerDto d) => d.Status != 2 && d.IsSubmittedForReview == true && ((d.RMApproved == null) || (d.RMApproved == true && d.SMApproved == false));
                bool IsSmm(DealerDto d) => d.Status != 2 && ((_completeDealerIds.Contains(d.Id) && d.RMApproved == true && d.SMApproved == null) || (d.RMApproved == true && d.SMApproved == true && d.AVPApproved == false));
                bool IsAvp(DealerDto d) => d.Status != 2 && _completeDealerIds.Contains(d.Id) && d.RMApproved == true && d.SMApproved == true && d.AVPApproved == null;
                bool IsCompleted(DealerDto d) => d.Status != 2 && d.AVPApproved == true;

                return new StateWiseSummary
                {
                    StateName = stateName,
                    AsPerSapSpic = sapSpicByState.TryGetValue(g.Key, out var ss) ? ss : 0,
                    AsPerSapGfl = sapGflByState.TryGetValue(g.Key, out var sg) ? sg : 0,
                    SavedDealersSpic = dealers.Count(d => d.InSpic),
                    SavedDealersGfl = dealers.Count(d => d.InGreenStar),
                    MoSpic = dealers.Count(d => IsMo(d) && d.InSpic),
                    MoGfl = dealers.Count(d => IsMo(d) && d.InGreenStar),
                    RmSpic = dealers.Count(d => IsRm(d) && d.InSpic),
                    RmGfl = dealers.Count(d => IsRm(d) && d.InGreenStar),
                    SmmSpic = dealers.Count(d => IsSmm(d) && d.InSpic),
                    SmmGfl = dealers.Count(d => IsSmm(d) && d.InGreenStar),
                    AvpSpic = dealers.Count(d => IsAvp(d) && d.InSpic),
                    AvpGfl = dealers.Count(d => IsAvp(d) && d.InGreenStar),
                    CompletedSpic = dealers.Count(d => IsCompleted(d) && d.InSpic),
                    CompletedGfl = dealers.Count(d => IsCompleted(d) && d.InGreenStar)
                };
            })
            .ToList();

        // States present in the full dealer table but with zero submitted dealers.
        var missingStates = allSapStateIds
            .Where(stateId => !savedByState.Any(s => _statesAll.FirstOrDefault(st => st.StateName == s.StateName)?.Id == stateId))
            .Select(stateId => new StateWiseSummary
            {
                StateName = _statesAll.FirstOrDefault(s => s.Id == stateId)?.StateName ?? "Unknown",
                AsPerSapSpic = sapSpicByState.TryGetValue(stateId, out var ss) ? ss : 0,
                AsPerSapGfl = sapGflByState.TryGetValue(stateId, out var sg) ? sg : 0
            });

        return savedByState
            .Concat(missingStates)
            .OrderBy(s => s.StateName)
            .ToList();
    }
private List<StateWiseSummary> GetCachedStateWiseSummary()
    {
        if (_stateWiseSummaryCache.Count == 0)
            _stateWiseSummaryCache = GetStateWiseSummary();
        return _stateWiseSummaryCache;
    }

    private int StateTableTotalPages => Math.Max(1, (int)Math.Ceiling(GetCachedStateWiseSummary().Count / (double)_stateTablePageSize));

    private IEnumerable<StateWiseSummary> StateTablePagedRows => GetCachedStateWiseSummary()
        .Skip((_stateTableCurrentPage - 1) * _stateTablePageSize)
        .Take(_stateTablePageSize);

    private void StateTableGoToPage(int page) { _stateTableCurrentPage = page; }
    private void StateTablePreviousPage() { if (_stateTableCurrentPage > 1) _stateTableCurrentPage--; }
    private void StateTableNextPage() { if (_stateTableCurrentPage < StateTableTotalPages) _stateTableCurrentPage++; }
    private void StateTableOnPageSizeChanged() { _stateTableCurrentPage = 1; }

    private IEnumerable<int> StateTablePageNumbers
    {
        get
        {
            var total = StateTableTotalPages;
            if (total <= 7)
                return Enumerable.Range(1, total);

            var pages = new List<int> { 1 };
            var start = Math.Max(2, _stateTableCurrentPage - 1);
            var end = Math.Min(total - 1, _stateTableCurrentPage + 1);

            if (start > 2) pages.Add(-1);
            for (var i = start; i <= end; i++) pages.Add(i);
            if (end < total - 1) pages.Add(-1);
            pages.Add(total);

            return pages;
        }
    }
