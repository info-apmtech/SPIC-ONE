    private double GetCreditPercentFromScoreDash(double scorePercent) => scorePercent switch
    {
        >= 75 => 25,
        >= 60 => 20,
        >= 45 => 15,
        >= 30 => 10,
        _ => 0
    };

   private static decimal ConvertToLakhsDash(decimal grossAmount) => grossAmount / 100000m;

