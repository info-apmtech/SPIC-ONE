@if (_showManualModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content" style="border-radius: 16px; border: none; box-shadow: 0 20px 60px rgba(0,0,0,0.15);">
                <div class="modal-header">
                    <h5 class="modal-title">Add Dealer Manually</h5>
                    <button type="button" class="btn-close" @onclick="() => _showManualModal = false" disabled="@_isSavingManual"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small mb-3">
                        CUSTOMER prefix: <code>D</code> → SPICCode, <code>Z</code> → GreenStarCode,
                        <code>T</code> → TnCode, <code>N</code> → NCode. Same routing as bulk import.
                    </p>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">CUSTOMER Code <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" placeholder="e.g. D41089157"
                               @bind="_manualCustomer" disabled="@_isSavingManual" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">CUSTOMER Name</label>
                        <input type="text" class="form-control" placeholder="Firm / dealer name"
                               @bind="_manualCustomerName" disabled="@_isSavingManual" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">State</label>
                        <select class="form-select" @bind="_manualStateId" disabled="@_isSavingManual">
                            <option value="0">-- Select State --</option>
                            @foreach (var s in _statesAll.OrderBy(s => s.StateName))
                            {
                                <option value="@s.Id">@s.StateName</option>
                            }
                        </select>
                    </div>

                    @if (!string.IsNullOrEmpty(_manualResult))
                    {
                        <div class="alert @(_manualSuccess ? "alert-success" : "alert-danger") py-2 mb-0">
                            @_manualResult
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => _showManualModal = false" disabled="@_isSavingManual">Close</button>
                    <button class="btn btn-success" @onclick="SaveManualDealer" disabled="@_isSavingManual">
                        @if (_isSavingManual)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span> <span>Saving...</span>
                        }
                        else
                        {
                            <i class="bi bi-check-lg me-1"></i> <span>Save Dealer</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showImportModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content" style="border-radius: 16px; border: none; box-shadow: 0 20px 60px rgba(0,0,0,0.15);">
                <div class="modal-header">
                    <h5 class="modal-title">Import Dealers from Excel</h5>
                    <button type="button" class="btn-close" @onclick="() => _showImportModal = false" disabled="@_isImporting"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small mb-3">
                        Expected columns: <strong>CUSTOMER</strong>, <strong>CUSTOMER NAME</strong>, <strong>State</strong>.<br />
                        CUSTOMER prefix: <code>D</code> → SPICCode, <code>N,Z,T</code> → GreenStarCode.
                    </p>
                    <InputFile OnChange="OnImportFileSelected" accept=".xlsx,.xls" disabled="@_isImporting" />
                    <div class="mt-3">
                        @if (_isImporting)
                        {
                            <div class="d-flex align-items-center gap-2 text-muted">
                                <span class="spinner-border spinner-border-sm"></span>
                                <span>Importing, please wait...</span>
                            </div>
                        }
                        else if (!string.IsNullOrEmpty(_importResult))
                        {
                            <div class="alert @(_importSuccess ? (_importGroupedErrors.Count > 0 ? "alert-warning" : "alert-success") : "alert-danger") mb-2 py-2">
                                @_importResult
                            </div>
                            @if (_importGroupedErrors.Count > 0)
                            {
                                <div style="border: 1px solid #dee2e6; border-radius: 4px; padding: 8px;">
                                    <small class="text-muted fw-semibold d-block mb-2">Skipped Groups:</small>
                                    <div style="max-height: 260px; overflow-y: auto;">
                                        @foreach (var group in _importGroupedErrors)
                                        {
                                            <div class="mb-2">
                                                <div style="font-size: 0.82rem;">
                                                    <span class="badge bg-secondary me-1">@group.Value.Count</span>
                                                    <strong>@group.Key</strong>
                                                </div>
                                                <ul class="mb-0 ps-3 mt-1" style="font-size: 0.8rem; color: #555;">
                                                    @foreach (var item in group.Value)
                                                    {
                                                        <li>@item</li>
                                                    }
                                                </ul>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => _showImportModal = false" disabled="@_isImporting">Close</button>
                </div>
            </div>
        </div>
    </div>
}

