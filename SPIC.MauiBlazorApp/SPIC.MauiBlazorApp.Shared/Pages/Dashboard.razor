@page "/Dashboard" 
@inject NavigationManager NavManager
   
<div class="container-fluid py-4 px-0">
        
	<div class="d-flex justify-content-between align-items-center mb-4">
		<div>
			<h1 class="page-title">Dealer Registrations</h1>
			<p class="page-subtitle">Manage all draft, in-progress, submitted, and approved dealer applications</p>
		</div>
		<NavLink href="/Register" class="btn-create-new text-decoration-none">
			<i class="bi bi-plus-lg"></i> Create New Registration
		</NavLink>
	</div>

	<div class="row g-3 mb-4">
		<div class="col">
			<div class="kpi-card">
				<div class="kpi-header">
					<div class="kpi-icon bg-light-green"><i class="bi bi-file-earmark-check"></i></div>
					<div class="kpi-number">8</div>
				</div>
				<div class="kpi-label">Total Registrations</div>
			</div>
		</div>
		<div class="col">
			<div class="kpi-card">
				<div class="kpi-header">
					<div class="kpi-icon bg-light-gray"><i class="bi bi-file-earmark-text"></i></div>
					<div class="kpi-number">8</div>
				</div>
				<div class="kpi-label">Drafts</div>
			</div>
		</div>
		<div class="col">
			<div class="kpi-card">
				<div class="kpi-header">
					<div class="kpi-icon bg-light-yellow"><i class="bi bi-clock"></i></div>
					<div class="kpi-number">8</div>
				</div>
				<div class="kpi-label">Pending Approval</div>
			</div>
		</div>
		<div class="col">
			<div class="kpi-card">
				<div class="kpi-header">
					<div class="kpi-icon bg-light-green"><i class="bi bi-check-circle"></i></div>
					<div class="kpi-number">8</div>
				</div>
				<div class="kpi-label">Approved</div>
			</div>
		</div>
		<div class="col">
			<div class="kpi-card">
				<div class="kpi-header">
					<div class="kpi-icon bg-light-red"><i class="bi bi-x-circle"></i></div>
					<div class="kpi-number">8</div>
				</div>
				<div class="kpi-label">Rejected / Returned</div>
			</div>
		</div>
		<div class="col">
			<div class="kpi-card justify-content-center">
				<div class="kpi-label mb-2">Status</div>
				<div class="d-flex justify-content-between align-items-center mb-2">
					<div class="status-list"><span class="status-dot bg-success"></span> Active</div>
					<div class="fw-bold fs-6">12</div>
				</div>
				<div class="d-flex justify-content-between align-items-center">
					<div class="status-list"><span class="status-dot" style="background-color: #F59E0B;"></span> Inact / Term</div>
					<div class="fw-bold fs-6">3/7</div>
				</div>
			</div>
		</div>
	</div>

	<div class="filter-bar">

		<div class="search-wrap">
			<i class="bi bi-search"></i>
			<input type="text" class="search-input" placeholder="Search by Dealer Code or Firm Name">
		</div>

		<div class="filter-group">
			<select class="filter-select"><option>All Companies</option></select>
			<select class="filter-select"><option>All Statuses</option></select>
			<select class="filter-select"><option>All Regions</option></select>
			<select class="filter-select"><option>All Entity Type</option></select>
			<select class="filter-select"><option>Recently Updated</option></select>
		</div>

	</div>

	<div class="row g-4">
            
		<div class="col-md-4">
			<div class="reg-card">
				<div class="card-top-row">
					<div class="progress-circle p-80">
						<div class="progress-inner">
							<div class="progress-val">80%</div>
							<div class="progress-steps">10 of 12 steps</div>
						</div>
					</div>
					<div class="d-flex flex-column align-items-end gap-2">
						<div class="badge-group">
							<span class="badge-custom badge-yellow">In Progress</span>
							<span class="badge-custom badge-green">Active</span>
						</div>
						<div class="d-flex gap-2">
							<button class="btn-continue-blue"><i class="bi bi-play-circle me-1"></i> Continue</button>
							<button class="btn-view"><i class="bi bi-eye"></i> View</button>
							<button class="btn-dots"><i class="bi bi-three-dots-vertical"></i></button>
						</div>
					</div>
				</div>
				<div class="tags-row mb-2">
					<div class="reg-id">REG #DL-4829</div>
					<h3 class="company-name">Veridian Fields Ltd</h3>
					<div class="location-info">
						<div><i class="bi bi-geo-alt"></i> Region: Mysur</div> |
						<div>HQ: Shivamogga</div>
					</div>
				</div>
				<div class="tags-row mb-2">
					SPIC / GFL <span class="bullet-dot">•</span> Partnership <span class="bullet-dot">•</span> Wholesale
				</div>
				<div class="card-footer-note">Last Updated: 14 May 2025</div>
			</div>
		</div>

