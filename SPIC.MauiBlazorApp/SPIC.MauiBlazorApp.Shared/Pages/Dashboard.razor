    // Determines exactly where the application is in the workflow
    private string GetApprovalStatus(DealerDto d)
    {
        // 1. Rejections take priority - return which role rejected
        if (d.RMApproved == false)
            return "Rejected by RM";
        if (d.SMApproved == false)
            return "Rejected by SMM";
        if (d.AVPApproved == false)
            return "Rejected by AVP";

        // 2. Final approval
        if (d.AVPApproved == true)
            return "Approved";

        // 3. Not submitted yet
        if (!IsDealerComplete(d.Id))
            return "Draft";

        // 4. Workflow Queue Routing
        if (d.RMApproved == null)
            return "In RM";

        // If RM has approved and SM approval is null, it's in SMM queue
        if (d.RMApproved == true && d.SMApproved == null)
            return "In SMM";

        if (d.RMApproved == true && d.SMApproved == true && d.AVPApproved == null)
            return "In AVP";

        return "Submitted";
    }

    // Determines if the current user needs to act on this dealer.
    // This pushes the card to the top and adds the "Action Required" badge.
    private bool IsPendingForMe(DealerDto d)
    {
        var status = GetApprovalStatus(d);

        // Determine if this is a rejection that should be shown to the previous role
        var showForRejected = false;
        if (!string.IsNullOrEmpty(status) && status.StartsWith("Rejected"))
        {
            if (LoginState.IsRegionRole && d.RMApproved == true && d.SMApproved == false)
                showForRejected = true;
            if (LoginState.IsStateRole && d.RMApproved == true && d.SMApproved == true && d.AVPApproved == false)
                showForRejected = true;
        }

        // Do not show pending for incomplete dealers unless it's a send-back rejection
        if (!IsDealerComplete(d.Id) && !showForRejected)
            return false;

        // If dealer is already fully approved, do not show the Review or Edit buttons
        if (d.AVPApproved == true)
            return false;

        // For each role determine whether this dealer requires action for that role.
        // RegionRole (RM) should act on dealers that are still in RM OR that were sent back by SMM
        if (LoginState.IsRegionRole)
        {
            // Pending if RM has not approved yet
            if (d.RMApproved == null)
                return true;

            // Also pending for RM if SMM has rejected it (sent back to RM)
            if (d.RMApproved == true && d.SMApproved == false)
                return true;

            // Also pending if this is a send-back rejection targeted at RM
            if (showForRejected)
                return true;

            return false;
        }

        // StateRole (SMM) should act on dealers that are in SMM OR that were sent back by AVP
        if (LoginState.IsStateRole)
        {
            if (d.RMApproved == true && d.SMApproved == null)
                return true;

            // AVP rejected -> shown in SMM queue
            if (d.RMApproved == true && d.SMApproved == true && d.AVPApproved == false)
                return true;

            // Also pending if this is a send-back rejection targeted at SMM
            if (showForRejected)
                return true;

            return false;
        }

        // Admin role handles AVP (final) stage
        if (LoginState.IsAdmin)
        {
            if (d.RMApproved == true && d.SMApproved == true && d.AVPApproved == null)
                return true;

            return false;
        }

        return false;
    }

    private void ApplyFilters()
    {
        var query = _allDealers.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            var search = _searchText.Trim().ToLower();
            query = query.Where(d =>
                (d.DealerCode?.ToLower().Contains(search) == true) ||
                (d.FirmName?.ToLower().Contains(search) == true));
        }

        if (_filterCompany == "SPIC")
            query = query.Where(d => d.InSpic);
        else if (_filterCompany == "GreenStar")
            query = query.Where(d => d.InGreenStar);
        else if (_filterCompany == "Both")
            query = query.Where(d => d.InSpic && d.InGreenStar);

        if (_filterStatus >= 0)
            query = query.Where(d => d.Status == _filterStatus);

        if (_filterRegionId > 0)
            query = query.Where(d => d.Region == _filterRegionId);

        if (!string.IsNullOrEmpty(_filterEntityType))
            query = query.Where(d => string.Equals(d.BusinessEntityType, _filterEntityType, StringComparison.OrdinalIgnoreCase));

        // SORTING: Pending for the logged-in user ALWAYS floats to the top, then follows user's sort preference
        query = _sortOrder switch
        {
            "oldest" => query.OrderByDescending(d => IsPendingForMe(d)).ThenBy(d => d.UpdatedAt),
            "name" => query.OrderByDescending(d => IsPendingForMe(d)).ThenBy(d => d.FirmName),
            _ => query.OrderByDescending(d => IsPendingForMe(d)).ThenByDescending(d => d.UpdatedAt)
        };

        _filteredDealers = query.ToList();
    }

    private string GetStatusName(int status) => status switch
    {
        0 => "Active",
        1 => "Inactive",
        2 => "Terminated",
        _ => "Unknown"
    };

    private async Task OnImportFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        _isImporting = true;
        _importResult = string.Empty;
        _importGroupedErrors = new();
        _importSuccess = false;

        try
        {
            using var content = new MultipartFormDataContent();
            var stream = file.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024);
            var streamContent = new StreamContent(stream);
            streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType ?? "application/octet-stream");
            content.Add(streamContent, "file", file.Name);

            var response = await Http.PostAsync("api/dealerbulkupload/import", content);
            var bodyText = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                _importSuccess = true;
                try
                {
                    var json = JsonSerializer.Deserialize<JsonElement>(bodyText);
                    var msg = json.TryGetProperty("message", out var m) ? m.GetString()
                        : json.TryGetProperty("Message", out var m2) ? m2.GetString() : null;
                    _importResult = msg ?? "Import completed.";

                    JsonElement groupedProp = default;
                    if (json.TryGetProperty("groupedErrors", out groupedProp) || json.TryGetProperty("GroupedErrors", out groupedProp))
                        foreach (var g in groupedProp.EnumerateObject())
                        {
                            var items = g.Value.EnumerateArray().Select(x => x.GetString() ?? "").Where(x => !string.IsNullOrEmpty(x)).ToList();
                            if (items.Count > 0) _importGroupedErrors[g.Name] = items;
                        }
                }
                catch { _importResult = "Import completed."; }
                await LoadData();
            }
            else
            {
                _importSuccess = false;
                try
                {
                    var json = JsonSerializer.Deserialize<JsonElement>(bodyText);
                    var msg = json.TryGetProperty("message", out var m) ? m.GetString()
                        : json.TryGetProperty("Message", out var m2) ? m2.GetString() : null;
                    _importResult = msg ?? "Import failed.";
                }
                catch { _importResult = $"Import failed: {bodyText}"; }
            }
        }
        catch (Exception ex)
        {
            _importSuccess = false;
            _importResult = $"Import error: {ex.Message}";
        }
        finally
        {
            _isImporting = false;
        }
    }

