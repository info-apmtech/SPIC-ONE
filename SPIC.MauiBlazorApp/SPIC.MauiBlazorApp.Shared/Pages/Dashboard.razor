    private async Task ExportDealerMaster()
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            var data = _filteredDealers.ToList();
            if (!data.Any()) return;

            // Dealer Master needs fields that are not guaranteed to be included in
            // the lightweight submitted-list response. Load them only for export so
            // normal Dashboard loading and role filtering stay unchanged.
            var exportRows = await LoadDealerMasterExportRows(data);

            using var workbook = new XLWorkbook();
            var ws = workbook.Worksheets.Add("DealerMaster");

            var headers = new[]
            {
                "Dealer Code", "Firm Name", "Company", "Region", "HQ", "Entity Type",
                "Status", "Approval Status", "SPIC Code", "GreenStar Code",
                "DoorNo", "Street", "SubVillage", "PinCode", "Village", "Block", "Taluk",
                "Dealer Type", "Wholesaler ID", "Retailer ID", "GST No", "Aadhaar No", "PAN No", "SDWA Status",
                "Authorized Person Name", "Authorized Person Email", "Authorized Person Contact",
                "Latitude", "Longitude"
            };

            for (int c = 0; c < headers.Length; c++)
            {
                ws.Cell(1, c + 1).Value = headers[c];
                ws.Cell(1, c + 1).Style.Font.Bold = true;
                ws.Cell(1, c + 1).Style.Fill.BackgroundColor = XLColor.LightGray;
            }

            for (int r = 0; r < data.Count; r++)
            {
                var exportRow = exportRows[r];
                var d = exportRow.Summary;
                var detail = exportRow.Detail ?? d;
                var authorizedPerson = exportRow.AuthorizedPerson;
                var company = detail.InSpic && detail.InGreenStar ? "Both" : detail.InSpic ? "SPIC" : detail.InGreenStar ? "GreenStar" : "-";
                var regionId = detail.Region != 0 ? detail.Region : d.Region;
                var hqId = detail.HQ != 0 ? detail.HQ : d.HQ;
                var regionName = _regionsAll.FirstOrDefault(x => x.Id == regionId)?.RegionName ?? "-";
                var hqName = _headquartersAll.FirstOrDefault(x => x.Id == hqId)?.HeadquarterName ?? "-";
                var status = GetStatusName(d.Status);
                var approvalStatus = GetApprovalStatus(d);

                ws.Cell(r + 2, 1).Value = FirstNonEmpty(detail.DealerCode, d.DealerCode, $"DL-{d.Id}");
                ws.Cell(r + 2, 2).Value = FirstNonEmpty(detail.FirmName, d.FirmName);
                ws.Cell(r + 2, 3).Value = company;
                ws.Cell(r + 2, 4).Value = regionName;
                ws.Cell(r + 2, 5).Value = hqName;
                ws.Cell(r + 2, 6).Value = GetEntityTypeName(
                    detail.EntityType ?? d.EntityType,
                    FirstNonEmpty(detail.BusinessEntityType, d.BusinessEntityType));
                ws.Cell(r + 2, 7).Value = status;
                ws.Cell(r + 2, 8).Value = approvalStatus;
                ws.Cell(r + 2, 9).Value = FirstNonEmpty(detail.SPICCode, d.SPICCode);
                ws.Cell(r + 2, 10).Value = FirstNonEmpty(detail.GreenStarCode, d.GreenStarCode);

                // Address fields in separate columns
                ws.Cell(r + 2, 11).Value = FirstNonEmpty(detail.ShopNoORRoomNoOrBlockNo, detail.DoorNo, d.ShopNoORRoomNoOrBlockNo, d.DoorNo);
                ws.Cell(r + 2, 12).Value = FirstNonEmpty(detail.Street, d.Street);
                ws.Cell(r + 2, 13).Value = FirstNonEmpty(detail.SubVillage, d.SubVillage);
                ws.Cell(r + 2, 14).Value = FirstNonEmpty(detail.PinCode, d.PinCode);
                ws.Cell(r + 2, 15).Value = FirstNonEmpty(detail.Village, d.Village);
                ws.Cell(r + 2, 16).Value = FirstNonEmpty(detail.Block, d.Block);
                ws.Cell(r + 2, 17).Value = FirstNonEmpty(detail.Taluk, d.Taluk);

                var wholesaleId = FirstNonEmpty(detail.WholeSaleFertilizerLicenseNumber, d.WholeSaleFertilizerLicenseNumber);
                var retailerId = FirstNonEmpty(detail.RetailFertilizerLicenseNumber, d.RetailFertilizerLicenseNumber);
                ws.Cell(r + 2, 18).Value = !string.IsNullOrEmpty(wholesaleId) && !string.IsNullOrEmpty(retailerId)
                    ? "Both"
                    : !string.IsNullOrEmpty(wholesaleId) ? "Wholesaler" : !string.IsNullOrEmpty(retailerId) ? "Retailer" : "";
                ws.Cell(r + 2, 19).Value = wholesaleId;
                ws.Cell(r + 2, 20).Value = retailerId;
                ws.Cell(r + 2, 21).Value = FirstNonEmpty(detail.GSTNumber, d.GSTNumber);
                ws.Cell(r + 2, 22).Value = FirstNonEmpty(detail.AadhaarNumber, d.AadhaarNumber);
                ws.Cell(r + 2, 23).Value = FirstNonEmpty(detail.PANNumber, d.PANNumber);
                ws.Cell(r + 2, 24).Value = GetSdwaStatus(detail, d);

                // Proprietor page data: use the first saved ownership record for this dealer.
                ws.Cell(r + 2, 25).Value = FirstNonEmpty(authorizedPerson?.Name, d.AuthorizedPersonName);
                ws.Cell(r + 2, 26).Value = authorizedPerson?.Email ?? "";
                ws.Cell(r + 2, 27).Value = authorizedPerson?.PhoneNumber ?? "";

                var latitude = detail.Latitude ?? d.Latitude;
                var longitude = detail.Longitude ?? d.Longitude;

                if (latitude.HasValue)
                    ws.Cell(r + 2, 28).Value = latitude.Value;

                if (longitude.HasValue)
                    ws.Cell(r + 2, 29).Value = longitude.Value;
            }

            ws.Columns().AdjustToContents();

            using var stream = new MemoryStream();
            workbook.SaveAs(stream);
            var fileName = $"Dealer_Master_{DateTime.Now:yyyyMMdd}.xlsx";
            var dataUri = $"data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64,{Convert.ToBase64String(stream.ToArray())}";
            var js = $"var a = document.createElement('a'); a.href = '{dataUri}'; a.download = '{fileName}'; document.body.appendChild(a); a.click(); document.body.removeChild(a);";
            await JSRuntime.InvokeVoidAsync("eval", js);
        }
        catch (Exception ex)
        {
            // ignore or show message
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

