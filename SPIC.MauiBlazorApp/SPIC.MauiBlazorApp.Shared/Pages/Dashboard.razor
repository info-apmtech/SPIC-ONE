    private async Task DeleteConfirmed()
    {
        if (_dealerToDelete == null) return;
        _isDeleting = true;
        try
        {
            var response = await Http.DeleteAsync($"api/DealerRegistration/{_dealerToDelete.Id}");
            if (response.IsSuccessStatusCode)
            {
                _allDealers.Remove(_dealerToDelete);
                ApplyFilters();
            }
        }
        catch { }
        finally
        {
            _isDeleting = false;
            _showDeleteConfirm = false;
            _dealerToDelete = null;
        }
    }

    private async Task ExportDealers()
    {
        var data = _filteredDealers.ToList();
        if (!data.Any()) return;

        using var workbook = new XLWorkbook();
        var ws = workbook.Worksheets.Add("Dealers");

      var headers = new[] { "Dealer Code", "Firm Name", "Company", "Region", "HQ", "Entity Type", "Status", "Approval Status", /* "Pincode", */ "SPIC Code", "GreenStar Code",/*  "Wholesale License", "Retail License", */ "MO Recommended (SPIC)", "MO Recommended (GFL)", "RM Recommended (SPIC)", "RM Recommended (GFL)", "SMM Recommended (SPIC)", "SMM Recommended (GFL)", "AVP Recommended (SPIC)", "AVP Recommended (GFL)"/* , "Last Updated" */ };
        for (int c = 0; c < headers.Length; c++)
        {
            ws.Cell(1, c + 1).Value = headers[c];
            ws.Cell(1, c + 1).Style.Font.Bold = true;
            ws.Cell(1, c + 1).Style.Fill.BackgroundColor = XLColor.LightGray;
        }

        for (int r = 0; r < data.Count; r++)
        {
            var d = data[r];
            var company = d.InSpic && d.InGreenStar ? "Both" : d.InSpic ? "SPIC" : d.InGreenStar ? "GreenStar" : "-";
            var regionName = _regionsAll.FirstOrDefault(x => x.Id == d.Region)?.RegionName ?? "-";
            var hqName = _headquartersAll.FirstOrDefault(x => x.Id == d.HQ)?.HeadquarterName ?? "-";
            var status = GetStatusName(d.Status);
            var approvalStatus = GetApprovalStatus(d);

            ws.Cell(r + 2, 1).Value = d.DealerCode ?? $"DL-{d.Id}";
            ws.Cell(r + 2, 2).Value = d.FirmName ?? "";
            ws.Cell(r + 2, 3).Value = company;
            ws.Cell(r + 2, 4).Value = regionName;
            ws.Cell(r + 2, 5).Value = hqName;
           ws.Cell(r + 2, 6).Value = GetEntityTypeName(d.EntityType);          
            ws.Cell(r + 2, 7).Value = status;
            ws.Cell(r + 2, 8).Value = approvalStatus;
            // ws.Cell(r + 2, 9).Value = d.PinCode ?? "";
            ws.Cell(r + 2, 9).Value = d.SPICCode ?? "";
            ws.Cell(r + 2, 10).Value = d.GreenStarCode ?? "";
            // ws.Cell(r + 2, 12).Value = d.WholeSaleFertilizerLicenseNumber ?? "";
          //ws.Cell(r + 2, 13).Value = d.RetailFertilizerLicenseNumber ?? "";
            ws.Cell(r + 2, 11).Value = (double)Math.Round(await GetSpicMoRecommendedCreditLimitAsync(d.Id));
            ws.Cell(r + 2, 12).Value = (double)Math.Round(await GetGflMoRecommendedCreditLimitAsync(d.Id));
            ws.Cell(r + 2, 13).Value = (double)Math.Round(GetSpicRmRecommendedCreditLimit(d.Id),2);
            ws.Cell(r + 2, 14).Value = (double)Math.Round(GetGflRmRecommendedCreditLimit(d.Id),2);
            ws.Cell(r + 2, 15).Value = (double)Math.Round(GetSpicSmmRecommendedCreditLimit(d.Id),2);
            ws.Cell(r + 2, 16).Value = (double)Math.Round(GetGflSmmRecommendedCreditLimit(d.Id),2);
            ws.Cell(r + 2, 17).Value = (double)Math.Round(GetSpicAvpRecommendedCreditLimit(d.Id),2);
            ws.Cell(r + 2, 18).Value = (double)Math.Round(GetGflAvpRecommendedCreditLimit(d.Id),2);
            // ws.Cell(r + 2, 20).Value = d.UpdatedAt.ToString("dd MMM yyyy");

        }

       for (int col = 14; col <= 21; col++)
        {
            ws.Column(col).Style.NumberFormat.Format = "0.00";
        }

        ws.Columns().AdjustToContents();

        using var stream = new MemoryStream();
        workbook.SaveAs(stream);

        var fileName = $"Dealer_List_{DateTime.Now:yyyyMMdd}.xlsx";
        var dataUri = $"data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64,{Convert.ToBase64String(stream.ToArray())}";
        var js = $@"var a = document.createElement('a'); a.href = '{dataUri}'; a.download = '{fileName}'; document.body.appendChild(a); a.click(); document.body.removeChild(a);";
        await JSRuntime.InvokeVoidAsync("eval", js);
    }

