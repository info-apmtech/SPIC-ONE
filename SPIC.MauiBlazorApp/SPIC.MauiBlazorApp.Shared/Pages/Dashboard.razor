@page "/Dashboard"
@using System.Net.Http.Json
@using System.Text.Json
@using SPIC.Core.Entities
@using SPIC.MauiBlazorApp.Shared.Services
@using ClosedXML.Excel
@inject HttpClient Http
@inject NavigationManager NavManager
@inject LoginState LoginState
@inject IJSRuntime JSRuntime

<style>
    /* Dealer card status badge colors — visual only, no logic change */
    .badge-status-active { background:#D1FAE5; color:#047857; }
    .badge-status-inactive { background:#FFEDD5; color:#C2410C; }
    .badge-status-terminated { background:#FEE2E2; color:#DC2626; }
    .badge-status-draft { background:#FEF9C3; color:#A16207; }
    .badge-status-inrm { background:#DBEAFE; color:#1D4ED8; }
    .badge-status-insmm { background:#EDE9FE; color:#7C3AED; }
    .badge-status-inavp { background:#E0E7FF; color:#4338CA; }

    /* Dealer identity badges - visual distinction only */
    .dealer-kind-new {
        display:inline-flex;
        align-items:center;
        gap:6px;
        padding:5px 10px;
        border-radius:999px;
        background:#F3E8FF;
        color:#7E22CE;
        border:1px solid #E9D5FF;
        font-size:0.78rem;
        font-weight:700;
        letter-spacing:0.02em;
    }


    .dealer-kind-code {
        display:inline-flex;
        align-items:center;
        gap:6px;
        padding:5px 10px;
        border-radius:999px;
        background:#DBEAFE;
        color:#1D4ED8;
        border:1px solid #BFDBFE;
        font-size:0.78rem;
        font-weight:700;
        letter-spacing:0.01em;
    }

    .dealer-kind-pending {
        display:inline-flex;
        align-items:center;
        gap:6px;
        padding:5px 10px;
        border-radius:999px;
        background:#F3F4F6;
        color:#6B7280;
        border:1px solid #E5E7EB;
        font-size:0.78rem;
        font-weight:700;
    }

    .btn-credit-limit {
        border:1px solid #A7F3D0;
        background:#ECFDF5;
        color:#047857;
        border-radius:8px;
        padding:6px 10px;
        font-size:0.82rem;
        font-weight:600;
        display:inline-flex;
        align-items:center;
        gap:5px;
        transition:all .15s ease-in-out;
    }

    .btn-credit-limit:hover {
        background:#D1FAE5;
        border-color:#6EE7B7;
        color:#065F46;
    }

    /* Approved New Dealer -> Existing Dealer maintenance action.
       Visual addition only; normal Edit/Review routing is unchanged. */
    .btn-update-existing-dealer {
        border:1px solid #BFDBFE;
        background:#EFF6FF;
        color:#1D4ED8;
        border-radius:8px;
        padding:6px 10px;
        font-size:0.82rem;
        font-weight:600;
        display:inline-flex;
        align-items:center;
        gap:5px;
        transition:all .15s ease-in-out;
        white-space:nowrap;
    }

    .btn-update-existing-dealer:hover {
        background:#DBEAFE;
        border-color:#93C5FD;
        color:#1E40AF;
    }

    .btn-completed-badge {
        background:#F3F4F6;
        color:#6B7280;
        border:1px solid #E5E7EB;
        padding:6px 14px;
        border-radius:999px;
        font-size:0.85rem;
        font-weight:600;
        cursor:not-allowed;
        display:inline-flex;
        align-items:center;
        gap:6px;
    }

    .progress-val-small {
        font-size: 0.78rem !important;
        line-height: 1 !important;
        white-space: nowrap;
    }

    /* First-time New Dealer final approval marker.
       Existing Dealer and New Dealer maintenance completion keep the existing
       100% Completed circle. Visual-only differentiation. */
    .new-dealer-first-complete {
        width: 72px;
        height: 72px;
        min-width: 72px;
        border: 5px solid #087A3D;
        border-radius: 50%;
        background: #FFFFFF;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-sizing: border-box;
    }

    .new-dealer-first-complete i {
        color: #16A34A;
        font-size: 39px;
        line-height: 1;
    }
</style>

<div class="container-fluid py-4 px-0">
   <div class="dealer-page-header mb-4">

    <div class="dealer-heading">
        <h1 class="page-title">Dealer Registrations</h1>

        <p class="page-subtitle">
            Manage all draft, in-progress, submitted, and approved dealer applications
        </p>
    </div>

    <div class="dealer-header-actions">

        @if (CanShowcreatebutton && CanCreateDealer)
        {
           

            <NavLink href="/Register"
                     class="header-action-btn action-primary text-decoration-none">
                <i class="bi bi-plus-lg"></i>
                <span>Create Existing Dealer</span>
            </NavLink>
        }

        @if (CanShowHeaderActions)
        {
             <NavLink href="/Register?flow=new"
                     class="header-action-btn action-green text-decoration-none">
                <i class="bi bi-plus-circle"></i>
                <span>Create New Dealer</span>
            </NavLink>
            <button type="button"
                    class="header-action-btn action-green"
                    @onclick="DownloadSampleTemplate">
                <i class="bi bi-file-earmark-excel"></i>
                <span>Sample Format</span>
            </button>

            <button type="button"
                    class="header-action-btn action-green"
                    @onclick="() => _showImportModal = true">
                <i class="bi bi-cloud-arrow-up"></i>
                <span>Import from Excel</span>
            </button>

            <button type="button"
                    class="header-action-btn action-green"
                    @onclick="OpenManualModal">
                <i class="bi bi-person-plus"></i>
                <span>Add Dealer</span>
            </button>

        }

        @* Both read-only exports are available to every Dashboard role. Each uses
           _filteredDealers, which has already been restricted by ApplyRoleFilter
           to the logged-in user's State, Region, or HQ scope. *@
        <button type="button"
                class="header-action-btn action-green"
                @onclick="ExportDealerMaster">
            <i class="bi bi-file-earmark-excel"></i>
            <span>Dealer Master</span>
        </button>

        <button type="button"
                class="header-action-btn action-blue"
                @onclick="ExportDealers">
            <i class="bi bi-download"></i>
            <span>Credit limit status</span>
        </button>

        @* State-wise dealer summary moved to a separate page so Dashboard stays fast.
           Visibility remains exactly the same as the old inline table: Admin only. *@
        @if (LoginState.IsAdmin)
        {
            <NavLink href="/DealerStateSummary"
                     class="header-action-btn action-primary text-decoration-none">
                <i class="bi bi-table"></i>
                <span>Total Dealer List</span>
            </NavLink>
        }

    </div>
</div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-4 col-lg-3">
            <div class="kpi-card">
                <div class="kpi-header">
                    <div class="kpi-icon bg-light-green"><i class="bi bi-file-earmark-check"></i></div>
                    <div class="kpi-number">@_filteredDealers.Count</div>
                </div>
                <div class="kpi-label">Total Registrations</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-3">
            <div class="kpi-card">
                <div class="kpi-header">
                    <div class="kpi-icon bg-light-gray"><i class="bi bi-file-earmark-text"></i></div>
                    <div class="kpi-number">@CountDraft()</div>
                </div>
                <div class="kpi-label">Draft</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-3">
            <div class="kpi-card">
                <div class="kpi-header">
                    <div class="kpi-icon bg-light-yellow"><i class="bi bi-clock"></i></div>
                   <div class="kpi-number">@CountInRM()</div>
                </div>
                <div class="kpi-label">In RM</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-3">
            <div class="kpi-card">
                <div class="kpi-header">
                    <div class="kpi-icon bg-light-yellow"><i class="bi bi-clock"></i></div>
                  <div class="kpi-number">@CountInSMM()</div>
                </div>
                <div class="kpi-label">In SMM</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-3">
            <div class="kpi-card">
                <div class="kpi-header">
                    <div class="kpi-icon bg-light-yellow"><i class="bi bi-clock"></i></div>
                  <div class="kpi-number">@CountInAVP()</div>
                </div>
                <div class="kpi-label">In AVP</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-3">
            <div class="kpi-card">
                <div class="kpi-header">
                    <div class="kpi-icon bg-light-green"><i class="bi bi-check-circle"></i></div>
                   <div class="kpi-number">@CountApproved()</div>
                </div>
                <div class="kpi-label">Approved</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-3">
            <div class="kpi-card">
                <div class="kpi-header">
                    <div class="kpi-icon bg-light-red"><i class="bi bi-x-circle"></i></div>
                    <div class="kpi-number">@CountRejectedTotal()</div>
                </div>
                <div class="kpi-label">Rejected / Returned</div>
                <div class="kpi-subtext text-muted" style="font-size:0.85rem; padding:6px 12px;">
                    RM: @CountRejectedByRM() &nbsp;|&nbsp; SMM: @CountRejectedBySMM() &nbsp;|&nbsp; AVP: @CountRejectedByAVP()
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-3">
            <div class="kpi-card justify-content-center">
                <div class="kpi-label mb-2">Status</div>
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div class="status-list"><span class="status-dot bg-success"></span> Active</div>
                    <div class="fw-bold fs-6">@_filteredDealers.Count(d => d.Status == 0)</div>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <div class="status-list"><span class="status-dot" style="background-color: #F59E0B;"></span> Inact / Term</div>
                    <div class="fw-bold fs-6">@_filteredDealers.Count(d => d.Status == 1) / @_filteredDealers.Count(d => d.Status == 2)</div>
                </div>
            </div>
        </div>
    </div>

    <div class="p-3 bg-white mb-4" style="border-radius: 12px; border: 1px solid #E5E7EB;">
        <div class="row g-3">
            <div class="col-12 col-md-6 col-lg-4 col-xxl-4">
                <div class="search-wrap h-100 position-relative">
                    <input type="text" class="search-input w-100 h-100" placeholder="Search by Dealer Code or Firm Name" @bind="_searchText" @bind:after="ApplyFilters" style="padding: 8px 12px 8px 32px; min-height: 38px;">
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4 col-xxl">
                <select class="filter-select w-100 h-100" @bind="_filterCompany" @bind:after="ApplyFilters" style="min-height: 38px;">
                    <option value="">All Companies</option>
                    <option value="SPIC">SPIC</option>
                    <option value="GreenStar">GreenStar</option>
                    <option value="Both">Both (SPIC & GreenStar)</option>
                </select>
            </div>
            <div class="col-12 col-md-6 col-lg-4 col-xxl">
                <select class="filter-select w-100 h-100" @bind="_filterDealerRegistrationType" @bind:after="ApplyFilters" style="min-height: 38px;">
                    <option value="">All Dealer Types</option>
                    <option value="new">New Dealers</option>
                    <option value="existing">Existing Dealers</option>
                </select>
            </div>
            <div class="col-12 col-md-6 col-lg-4 col-xxl">
                <select class="filter-select w-100 h-100" @bind="_filterStatus" @bind:after="ApplyFilters" style="min-height: 38px;">
                    <option value="-1">All Statuses</option>
                    <option value="0">Active</option>
                    <option value="1">Inactive</option>
                    <option value="2">Terminated</option>
                </select>
            </div>
            <div class="col-12 col-md-6 col-lg-4 col-xxl">
                <select class="filter-select w-100 h-100" @bind="_filterRegionId" @bind:after="ApplyFilters" style="min-height: 38px;">
                    <option value="0">All Regions</option>
                    @foreach (var r in _regionsAll)
                    {
                        <option value="@r.Id">@r.RegionName</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-6 col-lg-4 col-xxl">
                <select class="filter-select w-100 h-100" @bind="_filterEntityType" @bind:after="ApplyFilters" style="min-height: 38px;">
                    <option value="">All Entities</option>
                    <option value="soleProprietor">Sole Proprietor</option>
                    <option value="Partnership">Partnership</option>
                    <option value="LLP">LLP</option>
                    <option value="PvtLtd">Pvt Ltd</option>
                    <option value="PubLtd">Pub Ltd</option>
                    <option value="Society">Society</option>
                </select>
            </div>
            <div class="col-12 col-md-6 col-lg-4 col-xxl">
                <select class="filter-select w-100 h-100" @bind="_sortOrder" @bind:after="ApplyFilters" style="min-height: 38px;">
                    <option value="recent">Recently Updated</option>
                    <option value="oldest">Oldest First</option>
                    <option value="name">Firm Name A-Z</option>
                </select>
            </div>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="text-muted mt-2">Loading dealers...</p>
        </div>
    }
    else if (!_filteredDealers.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
            <p class="text-muted mt-2">No dealer registrations found.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var dealer in _filteredDealers)
            {
                var approvalStatus = GetApprovalStatus(dealer);
                var statusName = GetStatusName(dealer.Status);
                var regionName = _regionsAll.FirstOrDefault(r => r.Id == dealer.Region)?.RegionName ?? "-";
                var hqName = _headquartersAll.FirstOrDefault(h => h.Id == dealer.HQ)?.HeadquarterName ?? "-";
                var isPendingForMe = IsPendingForMe(dealer);

                <div class="col-12 col-sm-12 col-md-6 col-xl-4">
                    <div class="reg-card @(isPendingForMe ? "border-primary shadow-sm" : "")">
                        <div class="card-top-row">

                            @if (approvalStatus == "Approved")
                            {
                                @if (ShowFirstNewDealerCompletionDesign(dealer))
                                {
                                    <div class="new-dealer-first-complete"
                                         title="New Dealer registration approved"
                                         aria-label="New Dealer registration approved">
                                        <i class="bi bi-patch-check-fill" aria-hidden="true"></i>
                                    </div>
                                }
                                else
                                {
                                    <div class="progress-circle p-100">
                                        <div class="progress-inner">
                                            <div class="progress-val">100%</div>
                                            <div class="progress-steps">Completed</div>
                                        </div>
                                    </div>
                                }
                            }
                            else if (approvalStatus == "In RM" || approvalStatus == "In SMM" || approvalStatus == "In AVP")
                            {
                                <div class="progress-circle p-60">
                                    <div class="progress-inner">
                                        <div class="progress-val">@approvalStatus</div>
                                        <div class="progress-steps">@approvalStatus</div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="progress-circle p-30">
                                    <div class="progress-inner">
                                        <div class="progress-val">
                                            @(approvalStatus == "Draft" ? "Draft" : approvalStatus.StartsWith("Rejected") ? "!" : "...")
                                        </div>
                                        <div class="progress-steps">@approvalStatus</div>
                                    </div>
                                </div>
                            }

                            <div class="d-flex flex-column align-items-end gap-2 card-top-right">
                                <div class="badge-group align-items-center">

                                    @* ── Action button routing ──
                                       Edit   → only for the MO/creator level:
                                                  • Draft
                                                  • Rejected by RM  (routed back down to the MO)
                                       Review → for the approver who currently owns the record:
                                                  • In RM  / Rejected by SMM  → RM
                                                  • In SMM / Rejected by AVP  → SMM
                                                  • In AVP                    → AVP
                                    *@
                                    @if (ShowEditButton(dealer))
                                    {
                                        <button class="btn-continue-blue" @onclick="() => EditDealer(dealer)">
                                            <i class="bi bi-pencil-square me-1"></i> Edit
                                        </button>
                                    }
                                    else if (CanShowReviewButton(dealer))
                                    {
                                        <button class="btn-continue-blue" @onclick="() => ReviewDealer(dealer.Id)">
                                            <i class="bi bi-search me-1"></i> Review
                                        </button>
                                    }

                                    @if (isPendingForMe)
                                    {
                                        <span class="badge-custom bg-primary text-white border-0">Action Required</span>
                                    }
                                    else if (approvalStatus == "Approved")
                                    {
                                        <span class="badge-custom badge-green-dashboard" style="background:#D1FAE5; color:#047857;">Approved</span>
                                    }
                                    else if (approvalStatus.StartsWith("Rejected"))
                                    {
                                        <span class="badge-custom" style="background:#FEE2E2; color:#DC2626;">@approvalStatus</span>
                                    }
                                    else if (approvalStatus == "Draft")
                                    {
                                        <span class="badge-custom badge-status-draft">Draft</span>
                                    }
                                    else if (approvalStatus == "In RM")
                                    {
                                        <span class="badge-custom badge-status-inrm">In RM</span>
                                    }
                                    else if (approvalStatus == "In SMM")
                                    {
                                        <span class="badge-custom badge-status-insmm">In SMM</span>
                                    }
                                    else if (approvalStatus == "In AVP")
                                    {
                                        <span class="badge-custom badge-status-inavp">In AVP</span>
                                    }
                                    else
                                    {
                                        <span class="badge-custom badge-yellow">@approvalStatus</span>
                                    }

                                   <span class="badge-custom @(statusName switch { "Active" => "badge-status-active", "Inactive" => "badge-status-inactive", "Terminated" => "badge-status-terminated", _ => "badge-yellow" })">@statusName</span>
                                </div>
                                <div class="d-flex flex-wrap justify-content-end gap-2 card-action-row">

                                    <button class="btn-view" @onclick="() => ViewDealer(dealer)"><i class="bi bi-eye"></i></button>

                                    @* After a New Dealer has completed final AVP approval, allow the
                                       same record to be maintained through the Existing Dealer form.
                                       The permanent IsNewDealerRegistration source flag is preserved. *@
                                    @if (CanShowApprovedNewDealerMaintenanceButton(dealer))
                                    {
                                        <button type="button"
                                                class="btn-update-existing-dealer"
                                                title="Update this approved New Dealer using the Existing Dealer form"
                                                @onclick="() => UpdateApprovedNewDealerAsExisting(dealer)">
                                            <i class="bi bi-arrow-repeat"></i>
                                            <span>Update Dealer</span>
                                        </button>
                                    }

                                    @if (CanShowCreditLimitButton(dealer))
                                    {
                                        <button type="button"
                                                class="btn-credit-limit"
                                                title="Add / Edit Credit Limit"
                                                @onclick="() => OpenCreditLimit(dealer)">
                                            <i class="bi bi-credit-card-2-front"></i>
                                            <span>Credit Limit</span>
                                        </button>
                                    }

                                        @if (dealer.InSpic)
                                        {
                                            <a class="btn-view text-decoration-none" href="@($"/DealershipPDF/{dealer.Id}?company=SPIC")">
                                                <i class="bi bi-file-earmark-pdf me-1"></i> SPIC
                                            </a>
                                        }

                                        @if (dealer.InGreenStar)
                                        {
                                            <a class="btn-view text-decoration-none" href="@($"/DealershipPDF/{dealer.Id}?company=GreenStar")">
                                                <i class="bi bi-file-earmark-pdf me-1"></i> GFL
                                            </a>
                                        }

                                    @if (CanDeleteDealer)
                                    {
                                        <button class="btn-dots" style="color:#DC2626;" @onclick="() => ConfirmDelete(dealer)"><i class="bi bi-trash"></i></button>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="tags-row mb-2">
                            @if (dealer.IsNewDealerRegistration && string.IsNullOrWhiteSpace(dealer.DealerCode))
                            {
                                <div class="dealer-kind-new">
                                    <i class="bi bi-person-plus-fill"></i>
                                    <span>NEW DEALER</span>
                                </div>
                            }
                            else if (!string.IsNullOrWhiteSpace(dealer.DealerCode))
                            {
                                <div class="dealer-kind-code">
                                    <i class="bi bi-person-badge-fill"></i>
                                    <span>Dealer Code: @dealer.DealerCode</span>
                                </div>
                            }
                            else
                            {
                                <div class="dealer-kind-pending">
                                    <i class="bi bi-hourglass-split"></i>
                                    <span>Dealer Code Pending</span>
                                </div>
                            }
                            <h3 class="company-name">@(dealer.FirmName ?? "Unnamed Firm")</h3>
                            <div class="location-info">
                                <div><i class="bi bi-geo-alt"></i> Region: @regionName</div>
                                <div class="location-divider">|</div>
                                <div>HQ: @hqName</div>
                            </div>
                        </div>
                        <div class="tags-row mb-2">
                            @if (dealer.InSpic)
                            {
                                <span>SPIC</span>
                            }
                            @if (dealer.InSpic && dealer.InGreenStar)
                            {
                                <span class="bullet-dot">•</span>
                            }
                            @if (dealer.InGreenStar)
                            {
                                <span>GreenStar</span>
                            }
                            @if (!string.IsNullOrEmpty(dealer.BusinessEntityType))
                            {
                                <span class="bullet-dot">•</span> <span>@dealer.BusinessEntityType</span>
                            }
                            @if (!string.IsNullOrEmpty(dealer.WholeSaleFertilizerLicenseNumber))
                            {
                                <span class="bullet-dot">•</span> <span>Wholesale</span>
                            }
                            @if (!string.IsNullOrEmpty(dealer.RetailFertilizerLicenseNumber))
                            {
                                <span class="bullet-dot">•</span> <span>Retail</span>
                            }
                        </div>
                        <div class="card-footer-note">Last Updated: @dealer.UpdatedAt.ToString("dd MMM yyyy")</div>
                    </div>
                </div>
            }
        </div>
   }

</div>


@if (_showManualModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content" style="border-radius: 16px; border: none; box-shadow: 0 20px 60px rgba(0,0,0,0.15);">
                <div class="modal-header">
                    <h5 class="modal-title">Add Dealer Manually</h5>
                    <button type="button" class="btn-close" @onclick="() => _showManualModal = false" disabled="@_isSavingManual"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small mb-3">
                        CUSTOMER prefix: <code>D</code> → SPICCode, <code>Z</code> → GreenStarCode,
                        <code>T</code> → TnCode, <code>N</code> → NCode. Same routing as bulk import.
                    </p>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">CUSTOMER Code <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" placeholder="e.g. D41089157"
                               @bind="_manualCustomer" disabled="@_isSavingManual" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">CUSTOMER Name</label>
                        <input type="text" class="form-control" placeholder="Firm / dealer name"
                               @bind="_manualCustomerName" disabled="@_isSavingManual" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">State</label>
                        <select class="form-select" @bind="_manualStateId" disabled="@_isSavingManual">
                            <option value="0">-- Select State --</option>
                            @foreach (var s in _statesAll.OrderBy(s => s.StateName))
                            {
                                <option value="@s.Id">@s.StateName</option>
                            }
                        </select>
                    </div>

                    @if (!string.IsNullOrEmpty(_manualResult))
                    {
                        <div class="alert @(_manualSuccess ? "alert-success" : "alert-danger") py-2 mb-0">
                            @_manualResult
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => _showManualModal = false" disabled="@_isSavingManual">Close</button>
                    <button class="btn btn-success" @onclick="SaveManualDealer" disabled="@_isSavingManual">
                        @if (_isSavingManual)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span> <span>Saving...</span>
                        }
                        else
                        {
                            <i class="bi bi-check-lg me-1"></i> <span>Save Dealer</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

