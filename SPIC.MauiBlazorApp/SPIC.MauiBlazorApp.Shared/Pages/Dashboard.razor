    // Determines whether the Review button should be shown to the current user for this dealer.
    private bool CanShowReviewButton(DealerDto d)
    {
        if (d == null) return false;

        var status = GetApprovalStatus(d);

        // Determine if this is a rejection that should be shown to the previous role
        var showForRejected = false;
        if (!string.IsNullOrEmpty(status) && status.StartsWith("Rejected"))
        {
            // SM rejected -> appears in RM queue when RM had previously approved
            if (LoginState.IsRegionRole && d.RMApproved == true && d.SMApproved == false)
                showForRejected = true;

            // AVP rejected -> appears in SMM queue when RM & SM had previously approved
            if (LoginState.IsStateRole && d.RMApproved == true && d.SMApproved == true && d.AVPApproved == false)
                showForRejected = true;
        }

        // Must be fully completed (100%) unless this is a rejected record or was sent back
        if (!IsDealerComplete(d.Id) && !showForRejected && !(status != null && status.StartsWith("Rejected")))
            return false;

        // Only show review when the application is in RM, SMM or AVP stage or when it's a send-back or rejected
        if (!(status == "In RM" || status == "In SMM" || status == "In AVP" || showForRejected || (status != null && status.StartsWith("Rejected"))))
            return false;

        // Allow listed roles: reviewers and the dealer owner
        if (LoginState.IsReviewerRole) return true;
        // HQ creator roles should not automatically get Review unless they are the creator
        if (LoginState.IsHQCreatorRole) return !string.IsNullOrEmpty(LoginState.UserId) && LoginState.UserId == d.CreatedBy;
        // dealer who created the record
        if (!string.IsNullOrEmpty(LoginState.UserId) && LoginState.UserId == d.CreatedBy) return true;

        return false;
    }

    private void CancelDelete()
    {
        _showDeleteConfirm = false;
        _dealerToDelete = null;
    }

    private async Task DeleteConfirmed()
    {
        if (_dealerToDelete == null) return;
        _isDeleting = true;
        try
        {
            var response = await Http.DeleteAsync($"api/DealerRegistration/{_dealerToDelete.Id}");
            if (response.IsSuccessStatusCode)
            {
                _allDealers.Remove(_dealerToDelete);
                ApplyFilters();
            }
        }
        catch { }
        finally
        {
            _isDeleting = false;
            _showDeleteConfirm = false;
            _dealerToDelete = null;
        }
    }

