@page "/Dashboard"
@using System.Net.Http.Json
@using System.Text.Json
@using SPIC.Core.Entities
@using SPIC.MauiBlazorApp.Shared.Services
@using ClosedXML.Excel
@inject HttpClient Http
@inject NavigationManager NavManager
@inject LoginState LoginState
@inject IJSRuntime JSRuntime

<style>
    /* Dealer card status badge colors — visual only, no logic change */
    .badge-status-active { background:#D1FAE5; color:#047857; }
    .badge-status-inactive { background:#FFEDD5; color:#C2410C; }
    .badge-status-terminated { background:#FEE2E2; color:#DC2626; }
    .badge-status-draft { background:#FEF9C3; color:#A16207; }
    .badge-status-inrm { background:#DBEAFE; color:#1D4ED8; }
    .badge-status-insmm { background:#EDE9FE; color:#7C3AED; }
    .badge-status-inavp { background:#E0E7FF; color:#4338CA; }

    .btn-completed-badge {
        background:#F3F4F6;
        color:#6B7280;
        border:1px solid #E5E7EB;
        padding:6px 14px;
        border-radius:999px;
        font-size:0.85rem;
        font-weight:600;
        cursor:not-allowed;
        display:inline-flex;
        align-items:center;
        gap:6px;
    }

    .progress-val-small {
        font-size: 0.78rem !important;
        line-height: 1 !important;
        white-space: nowrap;
    }
</style>

<div class="container-fluid py-4 px-0">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-3 mb-4 page-header-row">
        <div class="page-header-text">
            <h1 class="page-title">Dealer Registrations</h1>
            <p class="page-subtitle">Manage all draft, in-progress, submitted, and approved dealer applications</p>
        </div>
        <div class="d-flex flex-column flex-sm-row align-items-stretch align-items-sm-center gap-2 page-header-actions">
            <NavLink href="/Register" class="btn-create-new text-decoration-none">
                <i class="bi bi-plus-lg"></i> Create New Registration
            </NavLink>
            <button class="btn-create-new" @onclick="DownloadSampleTemplate"
                    style="background: #fff; color: #16a34a; border: 1.5px solid #16a34a;">
                <i class="bi bi-file-earmark-excel"></i> Sample Format
            </button>
            <button class="btn-create-new" @onclick="() => _showImportModal = true"
                    style="background: #fff; color: #16a34a; border: 1.5px solid #16a34a;">
                <i class="bi bi-cloud-arrow-up"></i> Import from Excel
            </button>
            <button class="btn-create-new" @onclick="ExportDealers"
                    style="background: #fff; color: #2563eb; border: 1.5px solid #2563eb;">
                <i class="bi bi-download"></i> Export Dealers
            </button>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-6 col-lg-3">
            <div class="kpi-card">
                <div class="kpi-header">
                    <div class="kpi-icon bg-light-green"><i class="bi bi-file-earmark-check"></i></div>
                    <div class="kpi-number">@_filteredDealers.Count</div>
                </div>
                <div class="kpi-label">Total Registrations</div>
            </div>
        </div>
        <div class="col-6 col-md-6 col-lg-3">
            <div class="kpi-card">
                <div class="kpi-header">
                    <div class="kpi-icon bg-light-gray"><i class="bi bi-file-earmark-text"></i></div>
                    <div class="kpi-number">@_filteredDealers.Count(d => GetApprovalStatus(d) == "Draft")</div>
                </div>
                <div class="kpi-label">Draft</div>
            </div>
        </div>
        <div class="col-6 col-md-6 col-lg-3">
            <div class="kpi-card">
                <div class="kpi-header">
                    <div class="kpi-icon bg-light-yellow"><i class="bi bi-clock"></i></div>
                    <div class="kpi-number">@_filteredDealers.Count(d => (_completeDealerIds.Contains(d.Id) && d.RMApproved == null) || (d.RMApproved == true && d.SMApproved == false))</div>
                </div>
                <div class="kpi-label">In RM</div>
            </div>
        </div>
        <div class="col-6 col-md-6 col-lg-3">
            <div class="kpi-card">
                <div class="kpi-header">
                    <div class="kpi-icon bg-light-yellow"><i class="bi bi-clock"></i></div>
                    <div class="kpi-number">@_filteredDealers.Count(d => (_completeDealerIds.Contains(d.Id) && d.RMApproved == true && d.SMApproved == null) || (d.RMApproved == true && d.SMApproved == true && d.AVPApproved == false))</div>
                </div>
                <div class="kpi-label">In SMM</div>
            </div>
        </div>
    </div>
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-6 col-lg-3">
            <div class="kpi-card">
                <div class="kpi-header">
                    <div class="kpi-icon bg-light-yellow"><i class="bi bi-clock"></i></div>
                    <div class="kpi-number">@_filteredDealers.Count(d => _completeDealerIds.Contains(d.Id) && d.RMApproved == true && d.SMApproved == true && d.AVPApproved == null)</div>
                </div>
                <div class="kpi-label">In Office</div>
            </div>
        </div>
        <div class="col-6 col-md-6 col-lg-3">
            <div class="kpi-card">
                <div class="kpi-header">
                    <div class="kpi-icon bg-light-green"><i class="bi bi-check-circle"></i></div>
                    <div class="kpi-number">@_filteredDealers.Count(d => d.AVPApproved == true)</div>
                </div>
                <div class="kpi-label">Approved</div>
            </div>
        </div>
        <div class="col-6 col-md-6 col-lg-3">
            <div class="kpi-card">
                <div class="kpi-header">
                    <div class="kpi-icon bg-light-red"><i class="bi bi-x-circle"></i></div>
                    <div class="kpi-number">@CountRejectedTotal()</div>
                </div>
                <div class="kpi-label">Rejected / Returned</div>
                <div class="kpi-subtext text-muted" style="font-size:0.85rem; padding:6px 12px;">
                    RM: @CountRejectedByRM() &nbsp;|&nbsp; SMM: @CountRejectedBySMM() &nbsp;|&nbsp; AVP: @CountRejectedByAVP()
                </div>
            </div>
        </div>
        <div class="col-6 col-md-6 col-lg-3">
            <div class="kpi-card justify-content-center">
                <div class="kpi-label mb-2">Status</div>
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div class="status-list"><span class="status-dot bg-success"></span> Active</div>
                    <div class="fw-bold fs-6">@_filteredDealers.Count(d => d.Status == 0)</div>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <div class="status-list"><span class="status-dot" style="background-color: #F59E0B;"></span> Inact / Term</div>
                    <div class="fw-bold fs-6">@_filteredDealers.Count(d => d.Status == 1) / @_filteredDealers.Count(d => d.Status == 2)</div>
                </div>
            </div>
        </div>
    </div>

    <div class="filter-bar">

        <div class="search-wrap">
            <input type="text" class="search-input" placeholder="Search by Dealer Code or Firm Name" @bind="_searchText" @bind:after="ApplyFilters">
        </div>

        <div class="filter-group">
            <select class="filter-select" @bind="_filterCompany" @bind:after="ApplyFilters">
                <option value="">All Companies</option>
                <option value="SPIC">SPIC</option>
                <option value="GreenStar">GreenStar</option>
                <option value="Both">Both (SPIC & GreenStar)</option>
            </select>
            <select class="filter-select" @bind="_filterStatus" @bind:after="ApplyFilters">
                <option value="-1">All Statuses</option>
                <option value="0">Active</option>
                <option value="1">Inactive</option>
                <option value="2">Terminated</option>
            </select>
            <select class="filter-select" @bind="_filterRegionId" @bind:after="ApplyFilters">
                <option value="0">All Regions</option>
                @foreach (var r in _regionsAll)
                {
                    <option value="@r.Id">@r.RegionName</option>
                }
            </select>
            <select class="filter-select" @bind="_filterEntityType" @bind:after="ApplyFilters">
                <option value="">All Entity Type</option>
                <option value="soleProprietor">Sole Proprietor</option>
                <option value="Partnership">Partnership</option>
                <option value="LLP">LLP</option>
                <option value="PvtLtd">Pvt Ltd</option>
                <option value="PubLtd">Pub Ltd</option>
                <option value="Society">Society</option>
            </select>
            <select class="filter-select" @bind="_sortOrder" @bind:after="ApplyFilters">
                <option value="recent">Recently Updated</option>
                <option value="oldest">Oldest First</option>
                <option value="name">Firm Name A-Z</option>
            </select>
        </div>

    </div>

    @if (_isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="text-muted mt-2">Loading dealers...</p>
        </div>
    }
    else if (!_filteredDealers.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
            <p class="text-muted mt-2">No dealer registrations found.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var dealer in _filteredDealers)
            {
                var approvalStatus = GetApprovalStatus(dealer);
                var statusName = GetStatusName(dealer.Status);
                var regionName = _regionsAll.FirstOrDefault(r => r.Id == dealer.Region)?.RegionName ?? "-";
                var hqName = _headquartersAll.FirstOrDefault(h => h.Id == dealer.HQ)?.HeadquarterName ?? "-";
                var isPendingForMe = IsPendingForMe(dealer);

                // Terminated-specific display flags — do NOT affect GetApprovalStatus, filters,
                // KPI counts, or IsDealerComplete/CanShowReviewButton logic used elsewhere.
                var isTerminatedDealer = dealer.Status == 2;
                var isTerminatedSubmitted = dealer.Status == 2 && dealer.IsSubmittedForReview == true;

                <div class="col-12 col-sm-12 col-md-6 col-xl-4">
                    <div class="reg-card @(isPendingForMe ? "border-primary shadow-sm" : "")">
                        <div class="card-top-row">

                            @if (isTerminatedSubmitted)
                            {
                                <div class="progress-circle p-30">
                                    <div class="progress-inner">
                                        <div class="progress-val progress-val-small">Term</div>
                                        <div class="progress-steps">Completed</div>
                                    </div>
                                </div>
                            }
                            else if (isTerminatedDealer)
                            {
                                <div class="progress-circle p-30">
                                    <div class="progress-inner">
                                        <div class="progress-val">Draft</div>
                                        <div class="progress-steps">Draft</div>
                                    </div>
                                </div>
                            }
                            else if (approvalStatus == "Approved")
                            {
                                <div class="progress-circle p-100">
                                    <img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/CheckedGreen.svg" class="formicon" />
                                </div>
                            }
                            else if (approvalStatus == "In RM" || approvalStatus == "In SMM" || approvalStatus == "In AVP")
                            {
                                <div class="progress-circle p-60">
                                    <div class="progress-inner">
                                        <div class="progress-val">@approvalStatus</div>
                                        <div class="progress-steps">@approvalStatus</div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="progress-circle p-30">
                                    <div class="progress-inner">
                                        <div class="progress-val">
                                            @(approvalStatus == "Draft" ? "Draft" : approvalStatus.StartsWith("Rejected") ? "!" : "...")
                                        </div>
                                        <div class="progress-steps">@approvalStatus</div>
                                    </div>
                                </div>
                            }

                            <div class="d-flex flex-column align-items-end gap-2 card-top-right">
                                <div class="badge-group">

                                    @if (isTerminatedSubmitted)
                                    {
                                        <span class="badge-custom badge-status-terminated">Terminated</span>
                                    }
                                    else if (isPendingForMe)
                                    {
                                        <span class="badge-custom bg-primary text-white border-0">Action Required</span>
                                    }
                                    else if (approvalStatus == "Approved")
                                    {
                                        <span class="badge-custom badge-green-dashboard" style="background:#D1FAE5; color:#047857;">Approved</span>
                                    }
                                    else if (approvalStatus.StartsWith("Rejected"))
                                    {
                                        <span class="badge-custom" style="background:#FEE2E2; color:#DC2626;">@approvalStatus</span>
                                    }
                                    else if (approvalStatus == "Draft")
                                    {
                                        <span class="badge-custom badge-status-draft">Draft</span>
                                    }
                                    else if (approvalStatus == "In RM")
                                    {
                                        <span class="badge-custom badge-status-inrm">In RM</span>
                                    }
                                    else if (approvalStatus == "In SMM")
                                    {
                                        <span class="badge-custom badge-status-insmm">In SMM</span>
                                    }
                                    else if (approvalStatus == "In AVP")
                                    {
                                        <span class="badge-custom badge-status-inavp">In AVP</span>
                                    }
                                    else
                                    {
                                        <span class="badge-custom badge-yellow">@approvalStatus</span>
                                    }

                                    @if (!isTerminatedDealer)
                                    {
                                        <span class="badge-custom @(statusName switch { "Active" => "badge-status-active", "Inactive" => "badge-status-inactive", "Terminated" => "badge-status-terminated", _ => "badge-yellow" })">@statusName</span>
                                    }
                                </div>
                                <div class="d-flex flex-wrap justify-content-end gap-2 card-action-row">

                                    @if (isTerminatedDealer && !isTerminatedSubmitted && (LoginState.IsHQCreatorRole || LoginState.IsAdmin))
                                    {
                                        <button class="btn-continue-blue" @onclick="() => EditDealer(dealer.Id)">
                                            <i class="bi bi-pencil-square me-1"></i> Edit
                                        </button>
                                    }
                                    else if (!isTerminatedDealer && IsDealerComplete(dealer.Id))
                                    {
                                        if (dealer.RMApproved == false && (LoginState.IsHQCreatorRole || LoginState.IsAdmin))
                                        {
                                            <button class="btn-continue-blue" @onclick="() => EditDealer(dealer.Id)">
                                                <i class="bi bi-pencil-square me-1"></i> Edit
                                            </button>
                                        }
                                        else if (CanShowReviewButton(dealer) && approvalStatus != "Approved")
                                        {
                                            <button class="btn-continue-blue" @onclick="() => ReviewDealer(dealer.Id)">
                                                <i class="bi bi-search me-1"></i> Review
                                            </button>
                                        }
                                    }
                                    else if (!isTerminatedDealer && (LoginState.IsHQCreatorRole || LoginState.IsAdmin))
                                    {
                                        if (approvalStatus != "Approved" && !approvalStatus.StartsWith("Rejected"))
                                        {
                                            <button class="btn-continue-blue" @onclick="() => EditDealer(dealer.Id)">
                                                <i class="bi bi-pencil-square me-1"></i> Edit
                                            </button>
                                        }
                                    }

                                    <button class="btn-view" @onclick="() => ViewDealer(dealer.Id)"><i class="bi bi-eye"></i></button>

                                    @if (dealer.InSpic)
                                    {
                                        <a class="btn-view text-decoration-none" href="@($"/DealershipPDF/{dealer.Id}?company=SPIC")">
                                            <i class="bi bi-file-earmark-pdf me-1"></i> SPIC
                                        </a>
                                    }

                                    @if (dealer.InGreenStar)
                                    {
                                        <a class="btn-view text-decoration-none" href="@($"/DealershipPDF/{dealer.Id}?company=GreenStar")">
                                            <i class="bi bi-file-earmark-pdf me-1"></i> GFL
                                        </a>
                                    }

                                    <button class="btn-dots" style="color:#DC2626;" @onclick="() => ConfirmDelete(dealer)"><i class="bi bi-trash"></i></button>
                                </div>
                            </div>
                        </div>
                        <div class="tags-row mb-2">
                            <div class="reg-id">REG #@(dealer.DealerCode ?? $"DL-{dealer.Id}")</div>
                            <h3 class="company-name">@(dealer.FirmName ?? "Unnamed Firm")</h3>
                            <div class="location-info">
                                <div><i class="bi bi-geo-alt"></i> Region: @regionName</div>
                                <div class="location-divider">|</div>
                                <div>HQ: @hqName</div>
                            </div>
                        </div>
                        <div class="tags-row mb-2">
                            @if (dealer.InSpic)
                            {
                                <span>SPIC</span>
                            }
                            @if (dealer.InSpic && dealer.InGreenStar)
                            {
                                <span class="bullet-dot">•</span>
                            }
                            @if (dealer.InGreenStar)
                            {
                                <span>GreenStar</span>
                            }
                            @if (!string.IsNullOrEmpty(dealer.BusinessEntityType))
                            {
                                <span class="bullet-dot">•</span> <span>@dealer.BusinessEntityType</span>
                            }
                            @if (!string.IsNullOrEmpty(dealer.WholeSaleFertilizerLicenseNumber))
                            {
                                <span class="bullet-dot">•</span> <span>Wholesale</span>
                            }
                            @if (!string.IsNullOrEmpty(dealer.RetailFertilizerLicenseNumber))
                            {
                                <span class="bullet-dot">•</span> <span>Retail</span>
                            }
                        </div>
                        <div class="card-footer-note">Last Updated: @dealer.UpdatedAt.ToString("dd MMM yyyy")</div>
                    </div>
                </div>
            }
        </div>
    }

</div>

@if (_showImportModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content" style="border-radius: 16px; border: none; box-shadow: 0 20px 60px rgba(0,0,0,0.15);">
                <div class="modal-header">
                    <h5 class="modal-title">Import Dealers from Excel</h5>
                    <button type="button" class="btn-close" @onclick="() => _showImportModal = false" disabled="@_isImporting"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small mb-3">
                        Expected columns: <strong>CUSTOMER</strong>, <strong>CUSTOMER NAME</strong>, <strong>State</strong>.<br />
                        CUSTOMER prefix: <code>D</code> → SPICCode, <code>N,Z,T</code> → GreenStarCode.
                    </p>
                    <InputFile OnChange="OnImportFileSelected" accept=".xlsx,.xls" disabled="@_isImporting" />
                    <div class="mt-3">
                        @if (_isImporting)
                        {
                            <div class="d-flex align-items-center gap-2 text-muted">
                                <span class="spinner-border spinner-border-sm"></span>
                                <span>Importing, please wait...</span>
                            </div>
                        }
                        else if (!string.IsNullOrEmpty(_importResult))
                        {
                            <div class="alert @(_importSuccess ? (_importGroupedErrors.Count > 0 ? "alert-warning" : "alert-success") : "alert-danger") mb-2 py-2">
                                @_importResult
                            </div>
                            @if (_importGroupedErrors.Count > 0)
                            {
                                <div style="border: 1px solid #dee2e6; border-radius: 4px; padding: 8px;">
                                    <small class="text-muted fw-semibold d-block mb-2">Skipped Groups:</small>
                                    <div style="max-height: 260px; overflow-y: auto;">
                                        @foreach (var group in _importGroupedErrors)
                                        {
                                            <div class="mb-2">
                                                <div style="font-size: 0.82rem;">
                                                    <span class="badge bg-secondary me-1">@group.Value.Count</span>
                                                    <strong>@group.Key</strong>
                                                </div>
                                                <ul class="mb-0 ps-3 mt-1" style="font-size: 0.8rem; color: #555;">
                                                    @foreach (var item in group.Value)
                                                    {
                                                        <li>@item</li>
                                                    }
                                                </ul>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => _showImportModal = false" disabled="@_isImporting">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showDeleteConfirm)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content" style="border-radius: 16px; border: none; box-shadow: 0 20px 60px rgba(0,0,0,0.15);">
                <div class="modal-body text-center p-4">
                    <div class="mb-3">
                        <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 3rem;"></i>
                    </div>
                    <h5 class="fw-bold mb-2">Delete Dealer Registration?</h5>
                    <p class="text-muted mb-1">
                        You are about to delete <strong>@(_dealerToDelete?.FirmName ?? "this dealer")</strong>
                    </p>
                    <p class="text-muted small mb-3">
                        Dealer Code: <strong>@(_dealerToDelete?.DealerCode ?? $"DL-{_dealerToDelete?.Id}")</strong>
                    </p>
                    <p class="text-danger small mb-4">This action cannot be undone.</p>
                    <div class="d-flex justify-content-center gap-3">
                        <button class="btn btn-outline-secondary rounded-pill px-4" @onclick="CancelDelete" disabled="@_isDeleting">
                            Cancel
                        </button>
                        <button class="btn btn-danger rounded-pill px-4" @onclick="DeleteConfirmed" disabled="@_isDeleting">
                            @if (_isDeleting)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span> <span>Deleting...</span>
                            }
                            else
                            {
                                <i class="bi bi-trash me-1"></i> <span>Delete</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<DealerDto> _allDealers = new();
    private List<DealerDto> _filteredDealers = new();
    private List<RegionDto> _regionsAll = new();
    private List<HeadquarterDto> _headquartersAll = new();
    private bool _isLoading = true;

    // Filters
    private string _searchText = "";
    private string _filterCompany = "";
    private int _filterStatus = -1;
    private int _filterRegionId;
    private string _filterEntityType = "";
    private string _sortOrder = "recent";

    // Delete confirmation
    private bool _showDeleteConfirm;
    private bool _isDeleting;
    private DealerDto? _dealerToDelete;

    // Import modal state
    private bool _showImportModal = false;
    private bool _isImporting = false;
    private string _importResult = string.Empty;
    private bool _importSuccess = false;
    private Dictionary<string, List<string>> _importGroupedErrors = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private HashSet<int> _completeDealerIds = new();
    private Dictionary<int, int> _dealerStepCounts = new();

    private List<DealerExperience> _allExperiences = new();
    private List<AnnualSaleDataLastFYofDealerRegistration> _allAnnualSales = new();
    private List<DealerWarehouseFacilities> _allWarehouses = new();
    private List<DealerRailFacilities> _allRails = new();
    private List<DealerPortFacilities> _allPorts = new();
    private List<DealerMarketDetail> _allMarketDetails = new();
    private List<DealerCompaniesOperatingInArea> _allCompaniesOperating = new();
    private List<DealerOwnershipInfo> _allOwnerships = new();
    private List<PartnerFamilyDetails> _allPartners = new();
    private List<PartnerOccupation> _allOccupations = new();
    private List<SalesPlanningInDealerRegistration> _allSalesPlanning = new();
    private List<DealerAssetBank> _allAssetBanks = new();
    private List<DealerAssetLand> _allAssetLands = new();
    private List<DealerAssetBuilding> _allAssetBuildings = new();
    private List<DealerLoanLiabilities> _allLoans = new();
    private List<DealerCreditLimitProposal> _allCreditProposals = new();
    private List<DealerCreditLimitSalesPerformance> _allCreditSales = new();
    private List<DealerRegistrationDocuments> _allDocuments = new();

    private async Task<List<TItem>> SafeGet<TItem>(string url)
    {
        try { return await Http.GetFromJsonAsync<List<TItem>>(url) ?? new(); }
        catch { return new(); }
    }

    private async Task LoadData()
    {
        _isLoading = true;
        try
        {
            // Kick off every request at once (no awaits yet)
            var dealersTask   = SafeGet<DealerDto>("api/DealerRegistration/submitted");
            var regionsTask   = SafeGet<RegionDto>("api/Region/all");
            var hqTask        = SafeGet<HeadquarterDto>("api/Headquarter/all");
            var expTask       = SafeGet<DealerExperience>("api/DealerExperience");
            var annualTask    = SafeGet<AnnualSaleDataLastFYofDealerRegistration>("api/AnnualSaleDataLastFYofDealerRegistration");
            var whTask        = SafeGet<DealerWarehouseFacilities>("api/DealerWarehouseFacilities");
            var railTask      = SafeGet<DealerRailFacilities>("api/DealerRailFacilities");
            var portTask      = SafeGet<DealerPortFacilities>("api/DealerPortFacilities");
            var marketTask    = SafeGet<DealerMarketDetail>("api/DealerMarketDetail");
            var compTask      = SafeGet<DealerCompaniesOperatingInArea>("api/DealerCompaniesOperatingInArea");
            var ownerTask     = SafeGet<DealerOwnershipInfo>("api/DealerOwnershipInfo");
            var partnerTask   = SafeGet<PartnerFamilyDetails>("api/PartnerFamilyDetails");
            var occTask       = SafeGet<PartnerOccupation>("api/PartnerOccupation");
            var salesPlanTask = SafeGet<SalesPlanningInDealerRegistration>("api/SalesPlanning");
            var bankTask      = SafeGet<DealerAssetBank>("api/DealerAssetBank");
            var landTask      = SafeGet<DealerAssetLand>("api/DealerAssetLand");
            var buildingTask  = SafeGet<DealerAssetBuilding>("api/DealerAssetBuilding");
            var loanTask      = SafeGet<DealerLoanLiabilities>("api/DealerLoanLiabilities");
            var creditTask    = SafeGet<DealerCreditLimitProposal>("api/DealerCreditLimitProposal");
            var creditSalesTask = SafeGet<DealerCreditLimitSalesPerformance>("api/DealerCreditLimitSalesPerformance");
            var docsTask      = SafeGet<DealerRegistrationDocuments>("api/DealerRegistrationDocuments");

            // Wait for all of them in parallel
            await Task.WhenAll(
                dealersTask, regionsTask, hqTask, expTask, annualTask, whTask, railTask,
                portTask, marketTask, compTask, ownerTask, partnerTask, occTask,
                salesPlanTask, bankTask, landTask, buildingTask, loanTask,
                creditTask, creditSalesTask, docsTask);

            // Assign results
            _allDealers          = await dealersTask;
            _regionsAll          = await regionsTask;
            _headquartersAll     = await hqTask;
            _allExperiences      = await expTask;
            _allAnnualSales      = await annualTask;
            _allWarehouses       = await whTask;
            _allRails            = await railTask;
            _allPorts            = await portTask;
            _allMarketDetails    = await marketTask;
            _allCompaniesOperating = await compTask;
            _allOwnerships       = await ownerTask;
            _allPartners         = await partnerTask;
            _allOccupations      = await occTask;
            _allSalesPlanning    = await salesPlanTask;
            _allAssetBanks       = await bankTask;
            _allAssetLands       = await landTask;
            _allAssetBuildings   = await buildingTask;
            _allLoans            = await loanTask;
            _allCreditProposals  = await creditTask;
            _allCreditSales      = await creditSalesTask;
            _allDocuments        = await docsTask;

            BuildCompletionSet();
            ApplyRoleFilter();
            ApplyFilters();
        }
        catch { }
        finally
        {
            _isLoading = false;
        }
    }

    private void ApplyRoleFilter()
    {
        if (LoginState.IsStateRole)
            _allDealers = _allDealers.Where(d => d.StateId == LoginState.StateId).ToList();
        else if (LoginState.IsRegionRole)
            _allDealers = _allDealers.Where(d => d.Region == LoginState.RegionId).ToList();
        else if (LoginState.IsHQRole)
            _allDealers = _allDealers.Where(d => d.HQ == LoginState.HQId).ToList();
    }

    private void BuildCompletionSet()
    {
        _dealerStepCounts.Clear();
        foreach (var d in _allDealers)
        {
            int count = 0;
            if (!string.IsNullOrWhiteSpace(d.PinCode)) count++;
            if (_allExperiences.Any(x => x.DealerId == d.Id)) count++;
            if (_allAnnualSales.Any(x => x.DealerId == d.Id)) count++;
            if (_allWarehouses.Any(x => x.DealerId == d.Id) || _allRails.Any(x => x.DealerId == d.Id) || _allPorts.Any(x => x.DealerId == d.Id)) count++;
            if (_allMarketDetails.Any(x => x.DealerId == d.Id)) count++;
            if (_allCompaniesOperating.Any(x => x.DealerId == d.Id)) count++;
            if (_allOwnerships.Any(x => x.DealerId == d.Id)) count++;
            bool hasPartner = _allPartners.Any(p => _allOwnerships.Any(o => o.Id == p.OwnershipPartnerId && o.DealerId == d.Id));
            bool hasOccupation = _allOccupations.Any(o => _allOwnerships.Any(own => own.Id == o.OwnershipPartnerId && own.DealerId == d.Id));
            if (hasPartner || hasOccupation) count++;
            if (_allSalesPlanning.Any(x => x.DealerId == d.Id)) count++;
            if (_allAssetBanks.Any(x => x.DealerId == d.Id) || _allAssetLands.Any(x => x.DealerId == d.Id) || _allAssetBuildings.Any(x => x.DealerId == d.Id)) count++;
            if (_allLoans.Any(x => x.DealerId == d.Id)) count++;
            bool hasCreditProposal = _allCreditProposals.Any(cp => cp.DealerId == d.Id);
            bool hasCreditSales = _allCreditSales.Any(s => _allCreditProposals.Any(cp => cp.Id == s.CreditLimitId && cp.DealerId == d.Id));
            if (hasCreditProposal || hasCreditSales) count++;
            if (_allDocuments.Any(x => x.DealerId == d.Id)) count++;

            _dealerStepCounts[d.Id] = count;
        }

        _completeDealerIds = _dealerStepCounts.Where(kv => kv.Value >= 11).Select(kv => kv.Key).ToHashSet();
    }

    private bool IsDealerComplete(int dealerId) => _dealerStepCounts.TryGetValue(dealerId, out var c) && c >= 11;

    private int CountRejectedTotal()
    {
        return _filteredDealers.Count(d => d.RMApproved == false || d.SMApproved == false || d.AVPApproved == false);
    }

    private int CountRejectedByRM() => _filteredDealers.Count(d => d.RMApproved == false);
    private int CountRejectedBySMM() => _filteredDealers.Count(d => d.SMApproved == false);
    private int CountRejectedByAVP() => _filteredDealers.Count(d => d.AVPApproved == false);

    private string GetApprovalStatus(DealerDto d)
    {
        // Nothing counts as "in review" until the user explicitly clicked Submit Registration
        // on the Final Submission page — filling in all sections alone is not enough.
        if (!d.IsSubmittedForReview) return "Draft";

        if (d.RMApproved == false) return "Rejected by RM";
        if (d.SMApproved == false) return "Rejected by SMM";
        if (d.AVPApproved == false) return "Rejected by AVP";
        if (d.AVPApproved == true) return "Approved";
        if (d.RMApproved == null) return "In RM";
        if (d.RMApproved == true && d.SMApproved == null) return "In SMM";
        if (d.RMApproved == true && d.SMApproved == true && d.AVPApproved == null) return "In AVP";
        return "Submitted";
    }

    private bool IsPendingForMe(DealerDto d)
    {
        var status = GetApprovalStatus(d);

        var showForRejected = false;
        if (!string.IsNullOrEmpty(status) && status.StartsWith("Rejected"))
        {
            if (LoginState.IsRegionRole && d.RMApproved == true && d.SMApproved == false) showForRejected = true;
            if (LoginState.IsStateRole && d.RMApproved == true && d.SMApproved == true && d.AVPApproved == false) showForRejected = true;
        }

        if ((!d.IsSubmittedForReview || !IsDealerComplete(d.Id)) && !showForRejected) return false;
        if (d.AVPApproved == true) return false;

        if (LoginState.IsRegionRole)
        {
            if (d.RMApproved == null) return true;
            if (d.RMApproved == true && d.SMApproved == false) return true;
            if (showForRejected) return true;
            return false;
        }

        if (LoginState.IsStateRole)
        {
            if (d.RMApproved == true && d.SMApproved == null) return true;
            if (d.RMApproved == true && d.SMApproved == true && d.AVPApproved == false) return true;
            if (showForRejected) return true;
            return false;
        }

        if (LoginState.IsAdmin)
        {
            if (d.RMApproved == true && d.SMApproved == true && d.AVPApproved == null) return true;
            return false;
        }

        return false;
    }

    private void ApplyFilters()
    {
        var query = _allDealers.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            var search = _searchText.Trim().ToLower();
            query = query.Where(d =>
                (d.DealerCode?.ToLower().Contains(search) == true) ||
                (d.FirmName?.ToLower().Contains(search) == true));
        }

        if (_filterCompany == "SPIC") query = query.Where(d => d.InSpic);
        else if (_filterCompany == "GreenStar") query = query.Where(d => d.InGreenStar);
        else if (_filterCompany == "Both") query = query.Where(d => d.InSpic && d.InGreenStar);

        if (_filterStatus >= 0) query = query.Where(d => d.Status == _filterStatus);
        if (_filterRegionId > 0) query = query.Where(d => d.Region == _filterRegionId);
        if (!string.IsNullOrEmpty(_filterEntityType)) query = query.Where(d => string.Equals(d.BusinessEntityType, _filterEntityType, StringComparison.OrdinalIgnoreCase));

        query = _sortOrder switch
        {
            "oldest" => query.OrderByDescending(d => IsPendingForMe(d)).ThenBy(d => d.UpdatedAt),
            "name" => query.OrderByDescending(d => IsPendingForMe(d)).ThenBy(d => d.FirmName),
            _ => query.OrderByDescending(d => IsPendingForMe(d)).ThenByDescending(d => d.UpdatedAt)
        };

        _filteredDealers = query.ToList();
    }

    private string GetStatusName(int status) => status switch
    {
        0 => "Active",
        1 => "Inactive",
        2 => "Terminated",
        _ => "Unknown"
    };

    private async Task DownloadSampleTemplate()
    {
        try
        {
            var bytes = await Http.GetByteArrayAsync("api/dealerbulkupload/sample-template");
            var fileName = "Dealer_Import_Sample_Template.xlsx";
            var dataUri = $"data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64,{Convert.ToBase64String(bytes)}";
            var js = $@"var a = document.createElement('a'); a.href = '{dataUri}'; a.download = '{fileName}'; document.body.appendChild(a); a.click(); document.body.removeChild(a);";
            await JSRuntime.InvokeVoidAsync("eval", js);
        }
        catch (Exception ex)
        {
            _importResult = $"Failed to download sample template: {ex.Message}";
            _importSuccess = false;
            _showImportModal = true;
        }
    }

    private async Task OnImportFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        _isImporting = true;
        _importResult = string.Empty;
        _importGroupedErrors = new();
        _importSuccess = false;

        try
        {
            using var content = new MultipartFormDataContent();
            var stream = file.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024);
            var streamContent = new StreamContent(stream);
            streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType ?? "application/octet-stream");
            content.Add(streamContent, "file", file.Name);

            var response = await Http.PostAsync("api/dealerbulkupload/import", content);
            var bodyText = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                _importSuccess = true;
                try
                {
                    var json = JsonSerializer.Deserialize<JsonElement>(bodyText);
                    var msg = json.TryGetProperty("message", out var m) ? m.GetString()
                        : json.TryGetProperty("Message", out var m2) ? m2.GetString() : null;
                    _importResult = msg ?? "Import completed.";

                    JsonElement groupedProp = default;
                    if (json.TryGetProperty("groupedErrors", out groupedProp) || json.TryGetProperty("GroupedErrors", out groupedProp))
                        foreach (var g in groupedProp.EnumerateObject())
                        {
                            var items = g.Value.EnumerateArray().Select(x => x.GetString() ?? "").Where(x => !string.IsNullOrEmpty(x)).ToList();
                            if (items.Count > 0) _importGroupedErrors[g.Name] = items;
                        }
                }
                catch { _importResult = "Import completed."; }
                await LoadData();
            }
            else
            {
                _importSuccess = false;
                try
                {
                    var json = JsonSerializer.Deserialize<JsonElement>(bodyText);
                    var msg = json.TryGetProperty("message", out var m) ? m.GetString()
                        : json.TryGetProperty("Message", out var m2) ? m2.GetString() : null;
                    _importResult = msg ?? "Import failed.";
                }
                catch { _importResult = $"Import failed: {bodyText}"; }
            }
        }
        catch (Exception ex)
        {
            _importSuccess = false;
            _importResult = $"Import error: {ex.Message}";
        }
        finally
        {
            _isImporting = false;
        }
    }

