   private bool CanCreateDealer => LoginState.Can("Dashboard", "Entry");
    private bool CanDeleteDealer => LoginState.UserRole == AppRole.Admin;

    // Header action buttons (Create/Import/Add/Export) — Admin and AVP only
    private bool CanShowHeaderActions => LoginState.UserRole == AppRole.Admin || LoginState.UserRole == AppRole.AVP;
    private bool CanShowcreatebutton => LoginState.UserRole == AppRole.MO || LoginState.UserRole == AppRole.MDO || LoginState.UserRole == AppRole.JMDO|| LoginState.IsAdmin;

    // Approved New Dealer maintenance: shown only after final AVP approval and only
    // to users who already have Dashboard Update permission. This does not replace
    // or widen the existing Draft/Review ownership rules above.
    private bool CanShowApprovedNewDealerMaintenanceButton(DealerDto dealer)
    {
        if (dealer == null) return false;
        if (!LoginState.Can("Dashboard", "Update")) return false;

        return dealer.IsNewDealerRegistration
            && dealer.AVPApproved == true
            && !string.IsNullOrWhiteSpace(dealer.DealerCode);
    }

    // Completion display rule:
    // 1) Normal Existing Dealer final approval -> existing 100% Completed design.
    // 2) First New Dealer final AVP approval -> dedicated green verification design.
    // 3) New Dealer after Update Existing Dealer + RM/SMM/AVP re-approval ->
    //    existing 100% Completed design.
    // The API supplies HasCompletedExistingMaintenance from credit-limit + approval-history
    // evidence, so DealerCode is never used as the completion-cycle discriminator.
    private static bool ShowFirstNewDealerCompletionDesign(DealerDto dealer)
    {
        if (dealer == null) return false;

        return dealer.IsNewDealerRegistration
            && dealer.AVPApproved == true
            && !string.IsNullOrWhiteSpace(dealer.DealerCode)
            && !dealer.HasCompletedExistingMaintenance;
    }

    // Standalone Credit Limit action is available only after the application has
    // been submitted for review AND fully approved by the AVP (both must be true),
    // and a real Dealer Code exists.
    // Visibility is restricted to Admin and MO roles only.
    // Page-level CreditLimit permissions are reused; approval/edit/review routing is untouched.
    private bool CanShowCreditLimitButton(DealerDto dealer)
    {
        if (dealer == null) return false;

        if (LoginState.UserRole != AppRole.Admin && LoginState.UserRole != AppRole.MO) return false;

        if (dealer.IsSubmittedForReview != true || dealer.AVPApproved != true) return false;

        if (string.IsNullOrWhiteSpace(dealer.DealerCode)) return false;

        var canSpic = dealer.InSpic &&
            (LoginState.Can("CreditLimit", "Entry") || LoginState.Can("CreditLimit", "Update"));

        var canGreenStar = dealer.InGreenStar &&
            (LoginState.Can("CreditLimitForGreenStar", "Entry") || LoginState.Can("CreditLimitForGreenStar", "Update"));

        return canSpic || canGreenStar;
    }

    private async Task<List<TItem>> SafeGet<TItem>(string url)
    {
        try { return await Http.GetFromJsonAsync<List<TItem>>(url) ?? new(); }
        catch { return new(); }
    }

    private async Task<TItem?> SafeGetSingle<TItem>(string url) where TItem : class
    {
        try { return await Http.GetFromJsonAsync<TItem>(url); }
        catch { return null; }
    }

    private async Task<List<DealerMasterExportRow>> LoadDealerMasterExportRows(List<DealerDto> summaries)
    {
        const int batchSize = 10;
        var rows = new List<DealerMasterExportRow>(summaries.Count);

        // Keep export order unchanged while avoiding an unbounded burst of API calls
        // when the filtered Dealer Master list contains many dealers.
        for (var index = 0; index < summaries.Count; index += batchSize)
        {
            var batchTasks = summaries
                .Skip(index)
                .Take(batchSize)
                .Select(LoadDealerMasterExportRow);

            rows.AddRange(await Task.WhenAll(batchTasks));
        }

        return rows;
    }

    private async Task<DealerMasterExportRow> LoadDealerMasterExportRow(DealerDto summary)
    {
        var detailTask = SafeGetSingle<DealerDto>($"api/DealerRegistration/{summary.Id}");
        var ownershipTask = SafeGet<DealerOwnershipInfo>($"api/DealerOwnershipInfo/byDealer/{summary.Id}");

        await Task.WhenAll(detailTask, ownershipTask);

        var ownershipRecords = await ownershipTask;
        return new DealerMasterExportRow
        {
            Summary = summary,
            Detail = await detailTask,
            // Id is generated when a Proprietor/Authorized Person is first saved.
            // Ordering by Id therefore gives the first saved record for this dealer.
            AuthorizedPerson = ownershipRecords.OrderBy(x => x.Id).FirstOrDefault()
        };
    }

    private static string FirstNonEmpty(params string?[] values) =>
        values.FirstOrDefault(x => !string.IsNullOrWhiteSpace(x)) ?? "";

    private static string GetSdwaStatus(DealerDto detail, DealerDto summary)
    {
        var isSdwa = detail.IsSDWA ?? summary.IsSDWA;
        return isSdwa.HasValue
            ? (isSdwa.Value ? "Yes" : "No")
            : FirstNonEmpty(detail.SDWAStatus, summary.SDWAStatus);
    }

    private async Task LoadData()
    {
        _isLoading = true;
        try
        {
            var dealersTask   = SafeGet<DealerDto>("api/DealerRegistration/submitted");
            var regionsTask   = SafeGet<RegionDto>("api/Region/all");
            var hqTask        = SafeGet<HeadquarterDto>("api/Headquarter/all");
            var statesTask    = SafeGet<StateDto>("api/State/all");

            // Existing optimized endpoint for step counts.
            var countsTask    = Http.GetFromJsonAsync<Dictionary<int, int>>("api/DealerRegistration/dashboard-completion-counts");

            await Task.WhenAll(dealersTask, regionsTask, hqTask, statesTask, countsTask);

            _allDealers          = await dealersTask;
            _regionsAll          = await regionsTask;
            _headquartersAll     = await hqTask;
            _statesAll           = await statesTask;

            _dealerStepCounts = await countsTask ?? new Dictionary<int, int>();
            _completeDealerIds = _dealerStepCounts.Where(kv => kv.Value >= 11).Select(kv => kv.Key).ToHashSet();

            ApplyRoleFilter();
            ApplyFilters();
        }
        catch { }
        finally
        {
            _isLoading = false;
        }
    }

    private void ApplyRoleFilter()
    {
        if (LoginState.IsStateRole)
            _allDealers = _allDealers.Where(d => d.StateId == LoginState.StateId).ToList();
        else if (LoginState.IsRegionRole)
            _allDealers = _allDealers.Where(d => d.Region == LoginState.RegionId).ToList();
        else if (LoginState.IsHQRole)
            _allDealers = _allDealers.Where(d => d.HQ == LoginState.HQId).ToList();
    }



    private bool IsDealerComplete(int dealerId) => _dealerStepCounts.TryGetValue(dealerId, out var c) && c >= 11;

    private int CountRejectedTotal()
    {
        return _filteredDealers.Count(d => (d.RMApproved == false || d.SMApproved == false || d.AVPApproved == false));
    }

    private int CountRejectedByRM() => _filteredDealers.Count(d => d.RMApproved == false);
    private int CountRejectedBySMM() => _filteredDealers.Count(d => d.SMApproved == false);
    private int CountRejectedByAVP() => _filteredDealers.Count(d => d.AVPApproved == false);

    // ── Stage counts for the KPI cards ──
    // Driven purely by the approval flags (same logic as GetApprovalStatus) so
    // they never silently read 0 when the completion-counts endpoint is stale
    // or fails. Rejections are folded into the level they route back down to,
    // matching the "In RM / In SMM" card semantics.
    private int CountDraft() =>
        _filteredDealers.Count(d => d.Status != 2 && GetApprovalStatus(d) == "Draft");

    private int CountInRM() =>
        _filteredDealers.Count(d =>
        {
            var s = GetApprovalStatus(d);
            return s == "In RM" || s == "Rejected by SMM";
        });

    private int CountInSMM() =>
        _filteredDealers.Count(d =>
        {
            var s = GetApprovalStatus(d);
            return s == "In SMM" || s == "Rejected by AVP";
        });

    private int CountInAVP() =>
        _filteredDealers.Count(d => GetApprovalStatus(d) == "In AVP");

    // AVP-approved = fully approved dealers.
    private int CountApproved() =>
        _filteredDealers.Count(d => d.AVPApproved == true);

    private string GetApprovalStatus(DealerDto d)
    {
        // Nothing counts as "in review" until the user explicitly clicked Submit Registration
        // on the Final Submission page — filling in all sections alone is not enough.
        if (d.IsSubmittedForReview != true) return "Draft";

        if (d.RMApproved == false) return "Rejected by RM";
        if (d.SMApproved == false) return "Rejected by SMM";
        if (d.AVPApproved == false) return "Rejected by AVP";
        if (d.AVPApproved == true) return "Approved";
        if (d.RMApproved == null) return "In RM";
        if (d.RMApproved == true && d.SMApproved == null) return "In SMM";
        if (d.RMApproved == true && d.SMApproved == true && d.AVPApproved == null) return "In AVP";
        return "Submitted";
    }

    // ─────────────────────────────────────────────────────────────────────────
    //  Ownership / routing — WHO currently owns the record and must act on it.
    //  This is the single source of truth for which button (Edit vs Review) is
    //  shown, and does NOT alter the approval/rejection workflow itself.
    //
    //  Draft                → MO  (creator edits)
    //  Rejected by RM       → MO  (routed back down to the creator)
    //  In RM  / Rej. by SMM → RM  (RM reviews & corrects, or sends back to MO)
    //  In SMM / Rej. by AVP → SMM (SMM reviews & corrects, or sends back to RM)
    //  In AVP               → AVP
    //  Approved             → None
    // ─────────────────────────────────────────────────────────────────────────
    private enum OwnerLevel { None, MO, RM, SMM, AVP }

    private OwnerLevel GetCurrentOwnerLevel(DealerDto d)
    {
        if (d == null) return OwnerLevel.None;

        // Never submitted → still a draft owned by the MO/creator.
        if (d.IsSubmittedForReview != true) return OwnerLevel.MO;

        // Fully approved → nobody needs to act.
        if (d.AVPApproved == true) return OwnerLevel.None;

        // Rejections route BACK DOWN one level (order matters: match GetApprovalStatus).
        if (d.RMApproved == false) return OwnerLevel.MO;   // Rejected by RM  → MO
        if (d.SMApproved == false) return OwnerLevel.RM;   // Rejected by SMM → RM
        if (d.AVPApproved == false) return OwnerLevel.SMM; // Rejected by AVP → SMM

        // Normal forward flow.
        if (d.RMApproved == null) return OwnerLevel.RM;                                   // In RM
        if (d.RMApproved == true && d.SMApproved == null) return OwnerLevel.SMM;          // In SMM
        if (d.RMApproved == true && d.SMApproved == true && d.AVPApproved == null) return OwnerLevel.AVP; // In AVP

        return OwnerLevel.None;
    }

    // Edit (full re-registration) is ONLY for the MO/creator level:
    //   • Draft
    //   • Rejected by RM  (came back down to the MO)
    // For SMM/AVP rejections the record is owned by RM/SMM respectively, so
    // those approvers get the Review button instead — never a raw Edit.
    private bool ShowEditButton(DealerDto d)
    {
        if (d == null) return false;
        if (!LoginState.Can("Dashboard", "Update")) return false;

        // Edit is only for MO-level records (Draft or Rejected-by-RM) and only
        // for the maker who owns them — the actual creator or an MO-type role.
        if (GetCurrentOwnerLevel(d) != OwnerLevel.MO) return false;

        return IsCreatorLevelUser(d);
    }

    // The maker/creator who owns MO-level records: the user who created the
    // registration, or an MO / MDO / JMDO role (already scoped to their HQ by
    // ApplyRoleFilter). Approver roles (RM / SMM / AVP) are NOT creators, so a
    // draft never shows "Action Required" or Edit to them.
    private bool IsCreatorLevelUser(DealerDto d)
    {
        if (d == null) return false;

        if (!string.IsNullOrEmpty(LoginState.UserId) && LoginState.UserId == d.CreatedBy)
            return true;

        return LoginState.UserRole == AppRole.MO
            || LoginState.UserRole == AppRole.MDO
            || LoginState.UserRole == AppRole.JMDO;
    }

    // "Action Required" lights up only for the exact role that currently owns
    // the record at its stage:
    //   Draft   (owner MO)  → MO / creator only
    //   In RM   (owner RM)  → RM role only
    //   In SMM  (owner SMM) → SMM role only
    //   In AVP  (owner AVP) → AVP role only
    // (Rejections route the ownership back down one level, so the correcting
    //  role sees "Action Required" there too.)
    private bool IsPendingForMe(DealerDto d)
    {
        return GetCurrentOwnerLevel(d) switch
        {
            OwnerLevel.MO  => IsCreatorLevelUser(d),
            OwnerLevel.RM  => LoginState.IsRegionRole,
            OwnerLevel.SMM => LoginState.IsStateRole,
            OwnerLevel.AVP => LoginState.IsAdmin,
            _              => false
        };
    }

    private void ApplyFilters()
    {
        var query = _allDealers.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            var search = _searchText.Trim().ToLower();
            query = query.Where(d =>
                (d.DealerCode?.ToLower().Contains(search) == true) ||
                (d.FirmName?.ToLower().Contains(search) == true));
        }

        if (_filterCompany == "SPIC") query = query.Where(d => d.InSpic);
        else if (_filterCompany == "GreenStar") query = query.Where(d => d.InGreenStar);
        else if (_filterCompany == "Both") query = query.Where(d => d.InSpic && d.InGreenStar);

        // Registration-flow filter uses the permanent DB flag, not DealerCode.
        // A New Dealer remains a New Dealer even after AVP approval generates DealerCode.
        if (_filterDealerRegistrationType == "new")
            query = query.Where(d => d.IsNewDealerRegistration);
        else if (_filterDealerRegistrationType == "existing")
            query = query.Where(d => !d.IsNewDealerRegistration);

        if (_filterStatus >= 0) query = query.Where(d => d.Status == _filterStatus);
        if (_filterRegionId > 0) query = query.Where(d => d.Region == _filterRegionId);
        if (!string.IsNullOrEmpty(_filterEntityType)) query = query.Where(d => string.Equals(d.BusinessEntityType, _filterEntityType, StringComparison.OrdinalIgnoreCase));

        query = _sortOrder switch
        {
            "oldest" => query.OrderByDescending(d => IsPendingForMe(d)).ThenBy(d => d.UpdatedAt),
            "name" => query.OrderByDescending(d => IsPendingForMe(d)).ThenBy(d => d.FirmName),
            _ => query.OrderByDescending(d => IsPendingForMe(d)).ThenByDescending(d => d.UpdatedAt)
        };

        _filteredDealers = query.ToList();
    }
    private string GetEntityTypeName(int? entityType, string? fallbackName = null)
    {
        if (!entityType.HasValue)
            return string.IsNullOrWhiteSpace(fallbackName) ? "-" : fallbackName;

        var entityTypeName = entityType.Value switch
        {
            (int)EntityType.soleProprietor => "Sole Proprietor",
            (int)EntityType.Partnership => "Partnership",
            (int)EntityType.LLP => "LLP",
            (int)EntityType.PvtLtd => "PVT LTD",
            (int)EntityType.PubLtd => "PUB LTD",
            (int)EntityType.Society => "Society",
            _ => null
        };

        return entityTypeName
            ?? (string.IsNullOrWhiteSpace(fallbackName) ? "-" : fallbackName);
    }

    private bool IsFertilizerCategoryDash(int categoryId) =>
        _allCategories.FirstOrDefault(c => c.Id == categoryId)?.Name?.Contains("Fertilizer", StringComparison.OrdinalIgnoreCase) == true;

    private bool IsSpecialityCategoryDash(int categoryId) =>
        _allCategories.FirstOrDefault(c => c.Id == categoryId)?.Name is string n &&
        (n.Contains("Speciality", StringComparison.OrdinalIgnoreCase) || n.Contains("Specialty", StringComparison.OrdinalIgnoreCase));

    private bool IsUreaProductDash(int productId) =>
        _allProducts.FirstOrDefault(p => p.Id == productId)?.Name?.Trim().Equals("Urea", StringComparison.OrdinalIgnoreCase) == true;

    private double GetCreditPercentFromScoreDash(double scorePercent) => scorePercent switch
    {
        >= 75 => 25,
        >= 60 => 20,
        >= 45 => 15,
        >= 30 => 10,
        _ => 0
    };

   private static decimal ConvertToLakhsDash(decimal grossAmount) => grossAmount / 100000m;

    private int GetFertilizerCategoryIdDash() =>
        _allCategories.FirstOrDefault(c => c.Name != null && c.Name.Contains("Fertilizer", StringComparison.OrdinalIgnoreCase))?.Id ?? 0;

    private List<int> GetSpecialityCategoryIdsDash() =>
        _allCategories.Where(c => c.Name != null &&
            (c.Name.Contains("Speciality", StringComparison.OrdinalIgnoreCase) || c.Name.Contains("Specialty", StringComparison.OrdinalIgnoreCase)))
            .Select(c => c.Id).ToList();

    // Fetches the exact same by-filter data the real CreditLimit/CreditLimitForGreenStar pages use
    private async Task<List<DealerCreditLimitSales>> GetCreditLimitSalesByFilterDash(int dealerId, int categoryId, int financialYearId)
    {
        if (categoryId <= 0 || financialYearId <= 0) return new();
        var url = $"api/creditlimitsales/by-filter?customerId={dealerId}&categoryId={categoryId}&financialYearIds={financialYearId}";
        return await SafeGet<DealerCreditLimitSales>(url);
    }

    private async Task<decimal> GetSpicMoRecommendedCreditLimitAsync(int dealerId)
    {
        var proposal = _allCreditProposals.FirstOrDefault(p => p.DealerId == dealerId);
        if (proposal == null) return 0m;

        var fertCatId = GetFertilizerCategoryIdDash();
        var rows = await GetCreditLimitSalesByFilterDash(dealerId, fertCatId, proposal.FY3);

        var turnoverGross = rows
            .Where(s => IsUreaProductDash(s.ProductId))
            .Sum(s => s.GrossAmount);

        var turnover = ConvertToLakhsDash(turnoverGross);
        var pct = GetCreditPercentFromScoreDash(proposal.Q11Mark);
        return (turnover * (decimal)(pct / 100.0)) + proposal.AdditionalCreditLimit;
    }

    private async Task<decimal> GetGflMoRecommendedCreditLimitAsync(int dealerId)
    {
        var proposal = _allCreditProposals.FirstOrDefault(p => p.DealerId == dealerId);
        if (proposal == null) return 0m;

        var fertCatId = GetFertilizerCategoryIdDash();
        var fertRows = await GetCreditLimitSalesByFilterDash(dealerId, fertCatId, proposal.FY3);
        var fertTurnover = ConvertToLakhsDash(fertRows
            .Where(s => !IsUreaProductDash(s.ProductId))
            .Sum(s => s.GrossAmount));

        decimal spTurnover = 0m;
        foreach (var specCatId in GetSpecialityCategoryIdsDash())
        {
            var specRows = await GetCreditLimitSalesByFilterDash(dealerId, specCatId, proposal.FY3);
            spTurnover += ConvertToLakhsDash(specRows.Sum(s => s.GrossAmount));
        }

        var pct = GetCreditPercentFromScoreDash(proposal.GQ12Mark);
        return ((fertTurnover + spTurnover) * (decimal)(pct / 100.0)) + proposal.GreenstarAdditionalCreditLimit;
    }

    private decimal GetApprovalLimitDash(int dealerId, Func<DealerApprovalHistory, decimal?> selector)
    {
        var row = _allApprovalHistory
            .Where(h => h.DealerId == dealerId && h.IsApproved)
            .Where(h => (selector(h) ?? 0m) > 0m)
            .OrderByDescending(h => h.ApprovedAt)
            .FirstOrDefault();
        return row != null ? (selector(row) ?? 0m) : 0m;
    }

    private decimal GetSpicRmRecommendedCreditLimit(int dealerId) => GetApprovalLimitDash(dealerId, h => h.RmCreditLimit);
    private decimal GetGflRmRecommendedCreditLimit(int dealerId) => GetApprovalLimitDash(dealerId, h => h.RmCreditLimitGfl);
    private decimal GetSpicSmmRecommendedCreditLimit(int dealerId) => GetApprovalLimitDash(dealerId, h => h.SmCreditLimit);
    private decimal GetGflSmmRecommendedCreditLimit(int dealerId) => GetApprovalLimitDash(dealerId, h => h.SmCreditLimitGfl);
    private decimal GetSpicAvpRecommendedCreditLimit(int dealerId) => GetApprovalLimitDash(dealerId, h => h.AvpCreditLimit);
    private decimal GetGflAvpRecommendedCreditLimit(int dealerId) => GetApprovalLimitDash(dealerId, h => h.AvpCreditLimitGfl);

