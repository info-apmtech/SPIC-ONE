	private async Task OnBulkFileSelected(InputFileChangeEventArgs e)
	{
		var file = e.File;
		if (file == null) return;

		using var content = new MultipartFormDataContent();
		var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
		var streamContent = new StreamContent(stream);
		streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType ?? "application/octet-stream");
		content.Add(streamContent, "file", file.Name);

		_isUploading = true;
		_uploadResult = string.Empty;
		_groupedErrors = new();
		_uploadSuccess = false;
		try
		{
			var response = await Http.PostAsync($"api/GuestHouseMaster/bulk-upload?type={CurrentUploadType}", content);
			var bodyText = await response.Content.ReadAsStringAsync();

			if (response.IsSuccessStatusCode)
			{
				_uploadSuccess = true;
				try
				{
					var json = JsonSerializer.Deserialize<JsonElement>(bodyText);
					JsonElement groupedProp = default;
					if (json.TryGetProperty("groupedErrors", out groupedProp) || json.TryGetProperty("GroupedErrors", out groupedProp))
						foreach (var g in groupedProp.EnumerateObject())
						{
							var items = g.Value.EnumerateArray().Select(x => x.GetString() ?? "").Where(x => !string.IsNullOrEmpty(x)).ToList();
							if (items.Count > 0) _groupedErrors[g.Name] = items;
						}
				}
				catch { }
				var totalSkipped = _groupedErrors.Values.Sum(v => v.Count);

				var inserted = 0;
				var updated = 0;
				try
				{
					var json = JsonSerializer.Deserialize<JsonElement>(bodyText);
					if (json.TryGetProperty("insertedCount", out var ic)) inserted = ic.GetInt32();
					if (json.TryGetProperty("updatedCount", out var uc)) updated = uc.GetInt32();
				}
				catch { }

				_uploadResult = totalSkipped > 0
					? $"Upload completed with {inserted} inserted, {updated} updated and {totalSkipped} skipped row(s) across {_groupedErrors.Count} group(s). See details below."
					: $"Upload completed successfully. {inserted} inserted, {updated} updated.";
				await LoadTabData();
			}
			else
			{
				_uploadSuccess = false;
				try
				{
					var json = JsonSerializer.Deserialize<JsonElement>(bodyText);
					var msg = json.TryGetProperty("message", out var m) ? m.GetString()
						: json.TryGetProperty("Message", out var m2) ? m2.GetString() : null;
					_uploadResult = msg ?? "Upload failed.";

					if (json.TryGetProperty("missing", out var miss) || json.TryGetProperty("Missing", out miss))
						if (miss.ValueKind == JsonValueKind.Array)
						{
							var missingItems = miss.EnumerateArray().Select(x => x.GetString() ?? "").Where(x => !string.IsNullOrEmpty(x)).ToList();
							if (missingItems.Count > 0) _groupedErrors["Missing columns"] = missingItems;
						}
				}
				catch
				{
					_uploadResult = $"Upload failed: {bodyText}";
				}
			}
		}
		catch (Exception ex)
		{
			_uploadSuccess = false;
			_uploadResult = $"Upload error: {ex.Message}";
		}
		finally
		{
			_isUploading = false;
		}
	}

	private void CloseUploadModal()
	{
		_showUploadModal = false;
		_uploadResult = string.Empty;
		_groupedErrors = new();
		_errorsCopied = false;
	}

	private async Task CopyUploadErrors()
	{
		if (_groupedErrors.Count == 0) return;
		var sb = new System.Text.StringBuilder();
		foreach (var group in _groupedErrors)
		{
			sb.AppendLine($"[{group.Key}] ({group.Value.Count})");
			foreach (var item in group.Value) sb.AppendLine($"  - {item}");
			sb.AppendLine();
		}
		await JS.InvokeVoidAsync("navigator.clipboard.writeText", sb.ToString().TrimEnd());
		_errorsCopied = true;
		StateHasChanged();
		await Task.Delay(2000);
		_errorsCopied = false;
		StateHasChanged();
	}

	private static string ParseErrorMessage(string body)
	{
		try
		{
			var json = JsonSerializer.Deserialize<JsonElement>(body);
			if (json.TryGetProperty("message", out var m)) return m.GetString() ?? body;
			if (json.TryGetProperty("Message", out var m2)) return m2.GetString() ?? body;
		}
		catch { }
		return body;
	}

	private string? _currentUserId;

	private string? GetUserIdFromToken(string token)
	{
		try
		{
			if (string.IsNullOrWhiteSpace(token)) return null;
			var raw = token.StartsWith("Bearer ") ? token.Substring("Bearer ".Length) : token;
			var parts = raw.Split('.');
			if (parts.Length < 2) return null;
			var payload = parts[1];
			switch (payload.Length % 4)
			{
				case 2: payload += "=="; break;
				case 3: payload += "="; break;
			}
			payload = payload.Replace('-', '+').Replace('_', '/');
			var json = System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(payload));
			using var doc = System.Text.Json.JsonDocument.Parse(json);
			var root = doc.RootElement;
			if (root.TryGetProperty("sub", out var sub)) return sub.GetString();
			if (root.TryGetProperty("nameid", out var nid)) return nid.GetString();
			if (root.TryGetProperty("http://schemas.xmlsoap.org/ws/2005/05/identity/claims/nameidentifier", out var id2)) return id2.GetString();
			if (root.TryGetProperty("spic:user_id", out var sup)) return sup.GetString();
		}
		catch { }
		return null;
	}

