@page "/GuestHouseMaster"
@using System.Net.Http.Json
@using System.Text.Json
@using SPIC.Core.Entities
@using SPIC.MauiBlazorApp.Shared.Services
@inject HttpClient Http
@inject IJSRuntime JS
@inject SPIC.MauiBlazorApp.Shared.Services.LoginState LoginState
@inject NavigationManager Navigation

<div class="container-fluid">

	<h2 class="page-title">Guest House &amp; Room Master</h2>

	@if (!string.IsNullOrEmpty(_message))
	{
		<div class="alert @(_isError ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
			@_message
			<button type="button" class="btn-close" @onclick="() => _message = null"></button>
		</div>
	}

	<div class="tabs-wrapper">
		<div class="tabs-container">
			@foreach (var tab in TabOptions)
			{
				<div class="tab-item @(ActiveTab == tab ? "active" : "")" @onclick="() => SetActiveTab(tab)">
					@tab
				</div>
			}
		</div>
		<div class="tab-hint">@(ActiveTab == TabHouse ? "Create / update the Guest House records first, then map Rooms to them." : "Map rooms to an existing Guest House. Guest Houses are created on the Guest House tab.")</div>
	</div>

	@if (IsAdmin)
	{
		<div class="main-card">
			<div class="section-header">
				<h3 class="section-title">@(_isEditing ? $"Edit {(ActiveTab == TabHouse ? "Guest House" : "Room")}" : $"Add New {(ActiveTab == TabHouse ? "Guest House" : "Room")}")</h3>
				<div class="d-flex gap-2">
					<button class="btn-outline-green" @onclick="DownloadSampleTemplate">
						<i class="bi bi-file-earmark-excel"></i> Download Template
					</button>
					<button class="btn-outline-green" @onclick="() => _showUploadModal = true">
						<i class="bi bi-cloud-arrow-up"></i> Upload File
					</button>
				</div>
			</div>

			<div class="row g-3 mb-4">
				@if (ActiveTab == TabHouse)
				{
					<div class="col-md-6 col-lg-4">
						<label class="form-label-custom">Name *</label>
						<input type="text" class="form-control-custom w-100" placeholder="Enter Guest House Name"
							   @bind="_houseForm.Name" @ref="_firstInputRef" />
					</div>
					<div class="col-md-6 col-lg-4">
						<label class="form-label-custom">Address</label>
						<input type="text" class="form-control-custom w-100" placeholder="Enter Address"
							   @bind="_houseForm.Address" />
					</div>
					<div class="col-md-6 col-lg-4">
						<label class="form-label-custom">Phone Number</label>
						<input type="text" class="form-control-custom w-100" placeholder="Enter Phone Number"
							   @bind="_houseForm.PhoneNumber" />
					</div>
					<div class="col-md-12 col-lg-8">
						<label class="form-label-custom">Description</label>
						<input type="text" class="form-control-custom w-100" placeholder="Short description"
							   @bind="_houseForm.Description" />
					</div>
				}
				else
				{
					<div class="col-md-6 col-lg-3">
						<label class="form-label-custom">Guest House *</label>
						<select class="form-control-custom w-100" @bind="_roomForm.GuestHouseId">
							<option value="0">-- Select Guest House --</option>
							@foreach (var h in _housesAll)
							{
								<option value="@h.Id">@h.Name</option>
							}
						</select>
					</div>
					<div class="col-md-6 col-lg-3">
						<label class="form-label-custom">Room Type *</label>
						<input type="text" class="form-control-custom w-100" placeholder="e.g. Non AC"
							   @bind="_roomForm.RoomType" @ref="_firstInputRef" />
					</div>
					<div class="col-md-6 col-lg-2">
						<label class="form-label-custom">Room Number</label>
						<input type="text" class="form-control-custom w-100" placeholder="e.g. 101"
							   @bind="_roomForm.RoomNumber" />
					</div>
					<div class="col-md-4 col-lg-2">
						<label class="form-label-custom">No. of Rooms *</label>
						<input type="number" min="1" class="form-control-custom w-100" placeholder="1"
							   @bind="_roomForm.NoOfRooms" />
					</div>
					<div class="col-md-4 col-lg-2">
						<label class="form-label-custom">Rate (₹) *</label>
						<input type="number" min="0" step="0.01" class="form-control-custom w-100" placeholder="0"
							   @bind="_roomForm.Rate" />
					</div>
				}

				<div class="col-md-6 col-lg-1">
					<label class="form-label-custom d-block">&nbsp;</label>
					<div class="status-toggle-box @(CurrentFormIsActive ? "" : "status-toggle-inactive")">
						<span>@(CurrentFormIsActive ? "Active" : "Inactive")</span>
						<label class="switch">
							@if (ActiveTab == TabHouse)
							{
								<input type="checkbox" @bind="_houseForm.IsActive">
							}
							else
							{
								<input type="checkbox" @bind="_roomForm.IsActive">
							}
							<span class="slider"></span>
						</label>
					</div>
				</div>
			</div>

			<div class="d-flex justify-content-end pt-2 mt-4">
				<button class="btn-cancel mt-3" @onclick="ResetForm"><i class="bi bi-x"></i> Cancel</button>
				<button class="btn-save mt-3" @onclick="HandleSave" disabled="@_isSaving">
					<i class="bi bi-save"></i> @(_isSaving ? "Saving..." : "Save")
				</button>
			</div>
		</div>

		<div class="row g-3 mb-4 mt-1">
			<div class="col-md-4">
				<div class="metric-card bg-blue-light">
					<div class="metric-header">
						<h4 class="metric-title">Total @(ActiveTab == TabHouse ? "Guest Houses" : "Rooms")</h4>
					</div>
					<div class="metric-val">@(ActiveTab == TabHouse ? _housesAll.Count : _roomsAll.Count)</div>
				</div>
			</div>
			<div class="col-md-4">
				<div class="metric-card bg-mint-light">
					<div class="metric-header">
						<h4 class="metric-title">Active</h4>
					</div>
					<div class="metric-val">@(ActiveTab == TabHouse ? _housesAll.Count(x => x.IsActive) : _roomsAll.Count(x => x.IsActive))</div>
				</div>
			</div>
			<div class="col-md-4">
				<div class="metric-card bg-gray-light">
					<div class="metric-header">
						<h4 class="metric-title">Inactive</h4>
					</div>
					<div class="metric-val">@(ActiveTab == TabHouse ? _housesAll.Count(x => !x.IsActive) : _roomsAll.Count(x => !x.IsActive))</div>
				</div>
			</div>
		</div>

		@if (ActiveTab == TabHouse)
		{
			<SpicDataTable Items="_filteredHouses"
						   IsLoading="_isLoading"
						   Title="Existing Guest Houses"
						   FileName="GuestHouseMaster_GuestHouses"
						   ExportColumns="GetHouseExportColumns()"
						   SearchText="@_searchText">

				<FilterControls>
					<div class="search-box">
						<i class="bi bi-search"></i>
						<input type="text" placeholder="Search guest houses..."
							   @bind="_searchText" @bind:event="oninput" @bind:after="ApplyFilter" />
					</div>
					<select class="filter-select" @bind="_statusFilter" @bind:after="ApplyFilter">
						<option value="All">All Status</option>
						<option value="Active">Active</option>
						<option value="Inactive">Inactive</option>
					</select>
				</FilterControls>

				<TableHeader>
					<th>Name</th>
					<th>Address</th>
					<th>Phone</th>
					<th>Description</th>
					<th>Rooms</th>
					<th>Status</th>
					<th>Updated</th>
					<th>Action</th>
				</TableHeader>

				<TableRow Context="item">
					<td>@item.Name</td>
					<td>@(item.Address ?? "-")</td>
					<td>@(item.PhoneNumber ?? "-")</td>
					<td>@(item.Description ?? "-")</td>
					<td>@item.RoomCount</td>
					<td>
						<span class="status-pill @(item.IsActive ? "status-active" : "status-inactive")"
							  style="cursor:pointer" title="Click to toggle"
							  @onclick="() => ToggleStatus(item)">
							@(item.IsActive ? "Active" : "Inactive")
						</span>
					</td>
					<td>@item.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</td>
					<td>
						<div class="action-icons">
							<i class="bi bi-trash icon-del" @onclick="() => DeleteItem(item)"></i>
							<i class="bi bi-pencil-square icon-edit" @onclick="() => EditItem(item)"></i>
						</div>
					</td>
				</TableRow>
			</SpicDataTable>
		}
		else
		{
			<SpicDataTable Items="_filteredRooms"
						   IsLoading="_isLoading"
						   Title="Existing Rooms"
						   FileName="GuestHouseMaster_Rooms"
						   ExportColumns="GetRoomExportColumns()"
						   SearchText="@_searchText">

				<FilterControls>
					<div class="search-box">
						<i class="bi bi-search"></i>
						<input type="text" placeholder="Search rooms..."
							   @bind="_searchText" @bind:event="oninput" @bind:after="ApplyFilter" />
					</div>
					<select class="filter-select" @bind="_statusFilter" @bind:after="ApplyFilter">
						<option value="All">All Status</option>
						<option value="Active">Active</option>
						<option value="Inactive">Inactive</option>
					</select>
				</FilterControls>

				<TableHeader>
					<th>Guest House</th>
					<th>Room Type</th>
					<th>Room Number</th>
					<th>Rate (₹)</th>
					<th>No. of Rooms</th>
					<th>Status</th>
					<th>Updated</th>
					<th>Action</th>
				</TableHeader>

				<TableRow Context="item">
					<td>@item.GuestHouseName</td>
					<td>@item.RoomType</td>
					<td>@(item.RoomNumber ?? "-")</td>
					<td>@item.PricePerNight.ToString("N0")</td>
					<td>@item.AvailableQuantity</td>
					<td>
						<span class="status-pill @(item.IsActive ? "status-active" : "status-inactive")"
							  style="cursor:pointer" title="Click to toggle"
							  @onclick="() => ToggleStatus(item)">
							@(item.IsActive ? "Active" : "Inactive")
						</span>
					</td>
					<td>@item.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</td>
					<td>
						<div class="action-icons">
							<i class="bi bi-trash icon-del" @onclick="() => DeleteItem(item)"></i>
							<i class="bi bi-pencil-square icon-edit" @onclick="() => EditItem(item)"></i>
						</div>
					</td>
				</TableRow>
			</SpicDataTable>
		}
	}

</div>

@if (_showDeleteConfirm)
{
	<div class="modal-backdrop fade show"></div>
	<div class="modal fade show d-block" tabindex="-1" role="dialog">
		<div class="modal-dialog modal-dialog-centered" role="document">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title">Confirm Delete</h5>
					<button type="button" class="btn-close" @onclick="CancelDelete"></button>
				</div>
				<div class="modal-body">
					<p>Are you sure you want to delete <strong>@(_deleteTarget is GuestHouseGridDto delH ? delH.DisplayName : _deleteTarget is GuestHouseRoomGridDto delR ? delR.DisplayName : "")</strong>?</p>
					<p class="text-muted mb-0">This action cannot be undone.</p>
				</div>
				<div class="modal-footer">
					<button class="btn btn-secondary" @onclick="CancelDelete">Cancel</button>
					<button class="btn btn-danger" @onclick="ConfirmDelete" disabled="@_isDeleting">
						@(_isDeleting ? "Deleting..." : "Delete")
					</button>
				</div>
			</div>
		</div>
	</div>
}

@if (_showUploadModal)
{
	<div class="modal-backdrop fade show"></div>
	<div class="modal fade show d-block" tabindex="-1" role="dialog">
		<div class="modal-dialog modal-dialog-centered" role="document">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title">Bulk Upload - @ActiveTab</h5>
					<button type="button" class="btn-close" @onclick="CloseUploadModal"></button>
				</div>
				<div class="modal-body">
					<InputFile OnChange="OnBulkFileSelected" accept=".xlsx,.xls" />
					<div class="upload-help" style="background:#F0FDF4;border:1px solid #BBF7D0;border-radius:6px;padding:10px 12px;margin-top:10px;font-size:0.8rem;color:#14532D;">
						@if (ActiveTab == TabHouse)
						{
							<span>Columns: <strong>Name *</strong> | Address | PhoneNumber | Description</span>
						}
						else
						{
							<span>Columns: <strong>GuestHouseName *</strong> | <strong>RoomType *</strong> | RoomNumber | <strong>NoOfRooms *</strong> | <strong>Rate *</strong></span>
							<div class="mt-1">RoomNumber is optional; leave blank to create a single room-type record. Re-uploading the same (Guest House + Room Type + Room Number) updates the record.</div>
						}
					</div>
					<div class="upload-result" style="margin-top: 12px;">
						@if (_isUploading)
						{
							<div class="d-flex align-items-center gap-2 text-muted">
								<span class="spinner-border spinner-border-sm"></span>
								<span>Uploading, please wait...</span>
							</div>
						}
						else if (!string.IsNullOrEmpty(_uploadResult))
						{
							<div class="alert @(_uploadSuccess ? (_groupedErrors.Count > 0 ? "alert-warning" : "alert-success") : "alert-danger") mb-2 py-2">
								@_uploadResult
							</div>
							@if (_groupedErrors.Count > 0)
							{
								<div style="border: 1px solid #dee2e6; border-radius: 4px; padding: 8px;">
									<div class="d-flex justify-content-between align-items-center mb-2">
										<small class="text-muted fw-semibold">@(_uploadSuccess ? "Skipped Groups:" : "Issues:")</small>
										<button class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size: 0.75rem;"
												@onclick="CopyUploadErrors" title="Copy all errors to clipboard">
											@if (_errorsCopied)
											{
												<i class="bi bi-check2"></i> <span>Copied!</span>
											}
											else
											{
												<i class="bi bi-clipboard"></i> <span>Copy</span>
											}
										</button>
									</div>
									<div style="max-height: 280px; overflow-y: auto;">
										@foreach (var group in _groupedErrors)
										{
											<div class="mb-2">
												<div style="font-size: 0.82rem;">
													<span class="badge bg-secondary me-1">@group.Value.Count</span>
													<strong>@group.Key</strong>
												</div>
												<ul class="mb-0 ps-3 mt-1" style="font-size: 0.8rem; color: #555;">
													@foreach (var item in group.Value)
													{
														<li>@item</li>
													}
												</ul>
											</div>
										}
									</div>
								</div>
							}
						}
					</div>
				</div>
			</div>
		</div>
	</div>
}

@code {
	private const string TabHouse = "Guest House";
	private const string TabRooms = "Rooms";

	private readonly List<string> TabOptions = [TabHouse, TabRooms];

	// Element reference for focusing
	private ElementReference _firstInputRef;

	// Tab state
	private string ActiveTab { get; set; } = TabHouse;

	private string CurrentApiBase => ActiveTab == TabHouse ? "api/GuestHouseMaster/houses" : "api/GuestHouseMaster/rooms";

	private string CurrentUploadType => ActiveTab == TabHouse ? "house" : "rooms";

	private bool IsAdmin => LoginState.UserRole is AppRole.Admin or AppRole.CorporateAdmin;
	private bool CanViewPage => IsAdmin;

	// Upload modal state
	private bool _showUploadModal = false;
	private bool _isUploading = false;
	private string _uploadResult = string.Empty;
	private bool _uploadSuccess = false;
	private Dictionary<string, List<string>> _groupedErrors = new();
	private bool _errorsCopied = false;

	// Data
	private List<GuestHouseGridDto> _housesAll = new();
	private List<GuestHouseRoomGridDto> _roomsAll = new();

	// Filtered grid items (one filtered list per tab)
	private List<GuestHouseGridDto> _filteredHouses = new();
	private List<GuestHouseRoomGridDto> _filteredRooms = new();

	// Forms
	private GuestHouseFormModel _houseForm = new();
	private GuestHouseRoomFormModel _roomForm = new();

	private bool _isEditing;
	private int? _editingId;

	private bool CurrentFormIsActive => ActiveTab == TabHouse ? _houseForm.IsActive : _roomForm.IsActive;

	// UI state
	private bool _isLoading = true;
	private bool _isSaving;
	private string? _message;
	private bool _isError;

	// Delete confirmation
	private bool _showDeleteConfirm;
	private bool _isDeleting;
	private object? _deleteTarget;

	// Search & filter
	private string _searchText = "";
	private string _statusFilter = "All";

	protected override async Task OnInitializedAsync()
	{
		if (!CanViewPage)
		{
			Navigation.NavigateTo("/Dashboard", replace: true);
			return;
		}

		try
		{
			var token = await JS.InvokeAsync<string>("sessionStorage.getItem", "jwt_token");
			if (!string.IsNullOrEmpty(token))
			{
				var uid = GetUserIdFromToken(token);
				if (!string.IsNullOrEmpty(uid)) _currentUserId = uid;
			}
		}
		catch { }

		await LoadTabData();
		_isLoading = false;
	}

	private async Task SetActiveTab(string tabName)
	{
		if (ActiveTab == tabName) return;
		ActiveTab = tabName;
		_searchText = "";
		_statusFilter = "All";
		ResetForm();
		await LoadTabData();
	}

	private async Task LoadTabData()
	{
		try
		{
			_isLoading = true;

			// Guest houses are always needed (grid + the Rooms form dropdown).
			var housesResponse = await Http.GetAsync("api/GuestHouseMaster/houses");
			if (housesResponse.StatusCode == System.Net.HttpStatusCode.Unauthorized)
			{
				ShowMessage("Session expired. Please log in again.", true);
				Navigation.NavigateTo("/login", replace: true);
				return;
			}
			if (housesResponse.StatusCode == System.Net.HttpStatusCode.Forbidden)
			{
				ShowMessage("You do not have permission to view this data.", true);
				return;
			}
			housesResponse.EnsureSuccessStatusCode();
			_housesAll = await housesResponse.Content.ReadFromJsonAsync<List<GuestHouseGridDto>>() ?? new();

			var roomsResponse = await Http.GetAsync("api/GuestHouseMaster/rooms");
			if (!roomsResponse.IsSuccessStatusCode)
			{
				ShowMessage($"Failed to load rooms: {await roomsResponse.Content.ReadAsStringAsync()}", true);
				return;
			}
			_roomsAll = await roomsResponse.Content.ReadFromJsonAsync<List<GuestHouseRoomGridDto>>() ?? new();

			ApplyFilter();
		}
		catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Forbidden)
		{
			ShowMessage("Access denied (403 Forbidden). You do not have permission for this page.", true);
		}
		catch (Exception ex)
		{
			ShowMessage($"Failed to load: {ex.Message}", true);
		}
		finally
		{
			_isLoading = false;
		}
	}

	private void ApplyFilter()
	{
		if (ActiveTab == TabHouse)
		{
			IEnumerable<GuestHouseGridDto> source = _housesAll;
			source = _statusFilter switch
			{
				"Active" => source.Where(x => x.IsActive),
				"Inactive" => source.Where(x => !x.IsActive),
				_ => source
			};
			if (!string.IsNullOrWhiteSpace(_searchText))
			{
				var term = _searchText.Trim();
				source = source.Where(x =>
					(x.Name?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
					(x.Address?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
					(x.PhoneNumber?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false));
			}
			_filteredHouses = source.OrderBy(x => x.Name).ToList();
		}
		else
		{
			IEnumerable<GuestHouseRoomGridDto> source = _roomsAll;
			source = _statusFilter switch
			{
				"Active" => source.Where(x => x.IsActive),
				"Inactive" => source.Where(x => !x.IsActive),
				_ => source
			};
			if (!string.IsNullOrWhiteSpace(_searchText))
			{
				var term = _searchText.Trim();
				source = source.Where(x =>
					(x.GuestHouseName?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
					(x.RoomType?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
					(x.RoomNumber?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false));
			}
			_filteredRooms = source.OrderBy(x => x.GuestHouseName).ThenBy(x => x.RoomNumber).ToList();
		}
	}

	private List<ExportColumn<GuestHouseGridDto>> GetHouseExportColumns()
	{
		return
		[
			new ExportColumn<GuestHouseGridDto> { Header = "Name", ValueSelector = item => item.Name },
			new ExportColumn<GuestHouseGridDto> { Header = "Address", ValueSelector = item => item.Address ?? "" },
			new ExportColumn<GuestHouseGridDto> { Header = "Phone", ValueSelector = item => item.PhoneNumber ?? "" },
			new ExportColumn<GuestHouseGridDto> { Header = "Description", ValueSelector = item => item.Description ?? "" },
			new ExportColumn<GuestHouseGridDto> { Header = "Rooms", ValueSelector = item => item.RoomCount.ToString() },
			new ExportColumn<GuestHouseGridDto> { Header = "Status", ValueSelector = item => item.IsActive ? "Active" : "Inactive" }
		];
	}

	private List<ExportColumn<GuestHouseRoomGridDto>> GetRoomExportColumns()
	{
		return
		[
			new ExportColumn<GuestHouseRoomGridDto> { Header = "Guest House", ValueSelector = item => item.GuestHouseName },
			new ExportColumn<GuestHouseRoomGridDto> { Header = "Room Type", ValueSelector = item => item.RoomType ?? "" },
			new ExportColumn<GuestHouseRoomGridDto> { Header = "Room Number", ValueSelector = item => item.RoomNumber ?? "" },
			new ExportColumn<GuestHouseRoomGridDto> { Header = "Rate", ValueSelector = item => item.PricePerNight.ToString("N0") },
			new ExportColumn<GuestHouseRoomGridDto> { Header = "No. of Rooms", ValueSelector = item => item.AvailableQuantity.ToString() },
			new ExportColumn<GuestHouseRoomGridDto> { Header = "Status", ValueSelector = item => item.IsActive ? "Active" : "Inactive" }
		];
	}

	private async Task DownloadSampleTemplate()
	{
		try
		{
			var bytes = await Http.GetByteArrayAsync($"api/GuestHouseMaster/sample-template?type={CurrentUploadType}");
			var base64 = Convert.ToBase64String(bytes);
			await JS.InvokeVoidAsync("downloadFileFromBytes",
				ActiveTab == TabHouse ? "GuestHouse_Sample_Template.xlsx" : "GuestHouseRooms_Sample_Template.xlsx",
				"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
				base64);
		}
		catch (Exception ex)
		{
			ShowMessage($"Failed to download template: {ex.Message}", true);
		}
	}

	private async Task HandleSave()
	{
		string emptyFieldError;
		object payload;

		if (ActiveTab == TabHouse)
		{
			emptyFieldError =
				string.IsNullOrWhiteSpace(_houseForm.Name) ? "Guest House Name is required." :
				string.Empty;

			payload = new
			{
				_houseForm.Name,
				_houseForm.Address,
				_houseForm.PhoneNumber,
				_houseForm.Description,
				_houseForm.IsActive
			};
		}
		else
		{
			if (!int.TryParse(_roomForm.NoOfRooms, out var noOfRooms) || noOfRooms < 1)
			{
				ShowMessage("No. of Rooms must be a positive whole number.", true);
				return;
			}
			if (!decimal.TryParse(_roomForm.Rate, out var rate) || rate < 0)
			{
				ShowMessage("Rate must be a valid amount.", true);
				return;
			}

			emptyFieldError =
				_roomForm.GuestHouseId <= 0 ? "Please select a Guest House." :
				string.IsNullOrWhiteSpace(_roomForm.RoomType) ? "Room Type is required." :
				string.Empty;

			payload = new
			{
				GuestHouseId = _roomForm.GuestHouseId,
				_roomForm.RoomType,
				_roomForm.RoomNumber,
				PricePerNight = rate,
				AvailableQuantity = noOfRooms,
				_roomForm.IsActive
			};
		}

		if (!string.IsNullOrEmpty(emptyFieldError))
		{
			ShowMessage(emptyFieldError, true);
			return;
		}

		var singularName = ActiveTab == TabHouse ? "Guest House" : "Room";

		try
		{
			_isSaving = true;

			HttpResponseMessage response;
			if (_isEditing && _editingId.HasValue)
			{
				response = await Http.PutAsJsonAsync($"{CurrentApiBase}/{_editingId.Value}", payload);
				if (!response.IsSuccessStatusCode)
				{
					var error = await response.Content.ReadAsStringAsync();
					ShowMessage($"Update failed: {ParseErrorMessage(error)}", true);
					return;
				}
				ShowMessage($"{singularName} updated successfully.", false);
			}
			else
			{
				response = await Http.PostAsJsonAsync(CurrentApiBase, payload);
				if (!response.IsSuccessStatusCode)
				{
					var error = await response.Content.ReadAsStringAsync();
					ShowMessage($"Create failed: {ParseErrorMessage(error)}", true);
					return;
				}
				ShowMessage($"{singularName} created successfully.", false);
			}

			ResetForm();
			await LoadTabData();
		}
		catch (Exception ex)
		{
			ShowMessage($"Error: {ex.Message}", true);
		}
		finally
		{
			_isSaving = false;
		}
	}

	private void EditItem(object item)
	{
		_isEditing = true;

		if (ActiveTab == TabHouse && item is GuestHouseGridDto house)
		{
			_editingId = house.Id;
			_houseForm = new GuestHouseFormModel
			{
				Name = house.Name,
				Address = house.Address,
				PhoneNumber = house.PhoneNumber,
				Description = house.Description,
				IsActive = house.IsActive
			};
		}
		else if (ActiveTab == TabRooms && item is GuestHouseRoomGridDto room)
		{
			_editingId = room.Id;
			_roomForm = new GuestHouseRoomFormModel
			{
				GuestHouseId = room.GuestHouseId,
				RoomType = room.RoomType ?? "",
				RoomNumber = room.RoomNumber,
				NoOfRooms = room.AvailableQuantity.ToString(),
				Rate = room.PricePerNight.ToString("0.##"),
				IsActive = room.IsActive
			};
		}

		try
		{
			_firstInputRef.FocusAsync();
		}
		catch { }
	}

	private void DeleteItem(object item)
	{
		_deleteTarget = item;
		_showDeleteConfirm = true;
	}

	private async Task ConfirmDelete()
	{
		if (_deleteTarget is null) return;

		try
		{
			_isDeleting = true;
			var id = ActiveTab == TabHouse && _deleteTarget is GuestHouseGridDto house
				? house.Id
				: _deleteTarget is GuestHouseRoomGridDto room ? room.Id : 0;
			var label = ActiveTab == TabHouse && _deleteTarget is GuestHouseGridDto h
				? h.DisplayName
				: _deleteTarget is GuestHouseRoomGridDto r ? r.DisplayName : "item";

			var response = await Http.DeleteAsync($"{CurrentApiBase}/{id}");
			if (response.IsSuccessStatusCode)
			{
				ShowMessage($"'{label}' deleted successfully.", false);
				await LoadTabData();
			}
			else
			{
				var error = await response.Content.ReadAsStringAsync();
				ShowMessage($"Delete failed: {ParseErrorMessage(error)}", true);
			}
		}
		catch (Exception ex)
		{
			ShowMessage($"Error: {ex.Message}", true);
		}
		finally
		{
			_isDeleting = false;
			CancelDelete();
		}
	}

	private void CancelDelete()
	{
		_showDeleteConfirm = false;
		_deleteTarget = null;
	}

	private async Task ToggleStatus(object item)
	{
		try
		{
			var id = 0;
			var newStatus = false;
			if (item is GuestHouseGridDto house)
			{
				id = house.Id;
				newStatus = !house.IsActive;
			}
			else if (item is GuestHouseRoomGridDto room)
			{
				id = room.Id;
				newStatus = !room.IsActive;
			}
			if (id <= 0) return;

			var response = await Http.PatchAsync($"{CurrentApiBase}/{id}/status?isActive={newStatus}", null);
			if (response.IsSuccessStatusCode)
			{
				await LoadTabData();
			}
			else
			{
				var error = await response.Content.ReadAsStringAsync();
				ShowMessage($"Status change failed: {ParseErrorMessage(error)}", true);
			}
		}
		catch (Exception ex)
		{
			ShowMessage($"Error: {ex.Message}", true);
		}
	}

	private void ResetForm()
	{
		_houseForm = new GuestHouseFormModel();
		_roomForm = new GuestHouseRoomFormModel();
		_isEditing = false;
		_editingId = null;
	}

