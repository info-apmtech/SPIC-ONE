<SchemeApprovalDrawer @bind-IsOpen="isDrawerOpen" Status="@ActiveTab" />
@code {
    private bool isDrawerOpen = false;
    
    // Track the active tab
    private string ActiveTab { get; set; } = "Pending";

    private void OpenDrawer()
    {
        isDrawerOpen = true;
    }

    private void SetActiveTab(string tabName)
    {
        ActiveTab = tabName;
    }

    private string GetTableTitle()
    {
        if (ActiveTab == "Validated by MO") return "Validated By MO List";
        if (ActiveTab == "Recommended by RM") return "Recommended by RM List";
        if (ActiveTab == "Recommended by SMM") return "Recommended by SMM Applications List";
        
        return $"{ActiveTab} Applications List";
    }
}