@page "/DigitalLibrary"
@inject NavigationManager Nav
@inject ToastService Toast

<PageTitle>Digital Library - SPIC ONE</PageTitle>

@*
    Digital Library landing page (design: Figma "SPIC" > Digital Library, screenshot supplied
    2026-09-20). Static sample content for now; the content service comes in the next step.
    Layout: hero + search + three category cards, featured strip, content grid.
    Category cards, their headings and "View All Content" open the All Content list
    (/DigitalLibrary/content) pre-filtered by type.
    Phone: everything stacks; tablet: 2 columns; desktop: 3 columns as designed.
*@

<div class="dl-page">

    <section class="dl-hero">
        <h1 class="dl-hero-title">Digital Library Assistant</h1>
        <p class="dl-hero-sub">
            Get instant answers and discover relevant knowledge from the digital library.
            Ask about products, usage guides, or find related content.
        </p>

        <div class="dl-hero-actions">
            <button type="button" class="dl-btn dl-btn-light" @onclick='() => Nav.NavigateTo("/DigitalLibrary/chat")'>
                <i class="bi bi-stars"></i> Start Chat
            </button>
            <button type="button" class="dl-btn dl-btn-outline" @onclick="() => _createOpen = true">
                <i class="bi bi-plus-square"></i> Add Content
            </button>
        </div>

        <form class="dl-search" @onsubmit="Search" @onsubmit:preventDefault>
            <i class="bi bi-search dl-search-icon" aria-hidden="true"></i>
            <input class="dl-search-input"
                   type="search"
                   placeholder="Search products, videos, brochures or ask a question"
                   aria-label="Search the digital library"
                   @bind="_query" @bind:event="oninput" />
            <button type="submit" class="dl-search-go" aria-label="Search"><i class="bi bi-arrow-right"></i></button>
        </form>

        <div class="dl-chips" role="list">
            @foreach (var s in Suggestions)
            {
                <button type="button" class="dl-chip" role="listitem" @onclick="() => UseSuggestion(s)">@s</button>
            }
        </div>

        <h2 class="dl-hero-heading">Digital Library</h2>

        <div class="dl-categories">
            @foreach (var c in Categories)
            {
                <article class="dl-cat" @onclick="() => OpenType(c.Type)">
                    <div class="dl-cat-body">
                        <h3 class="dl-cat-title"><a href="@ListHref(c.Type)" @onclick:stopPropagation>@c.Title</a></h3>
                        <p class="dl-cat-desc">@c.Description</p>
                    </div>
                    <div class="dl-cat-art" aria-hidden="true">
                        <i class="bi @c.Icon"></i>
                    </div>
                    <a class="dl-cat-footer" href="@ListHref(c.Type)" @onclick:stopPropagation>
                        <span class="dl-cat-count"><i class="bi @c.CountIcon"></i> @Count(c.Type) @c.Unit</span>
                        <span class="dl-cat-link">@c.LinkText <i class="bi bi-chevron-right"></i></span>
                    </a>
                </article>
            }
        </div>
    </section>

    <section class="dl-section">
        <h2 class="dl-section-title">Featured Content</h2>

        <div class="dl-featured">
            @foreach (var f in Items.Where(i => i.Published).Take(3))
            {
                <article class="dl-feat">
                    <img class="dl-feat-img" src="@f.Image" alt="" loading="lazy" />
                    <div class="dl-feat-body">
                        <h3 class="dl-feat-title">@f.Title</h3>
                        <p class="dl-feat-desc">@f.Description</p>
                        <a class="dl-more" href="@($"DigitalLibrary/{f.Type.ToString().ToLowerInvariant()}?id={f.Id}")">
                            @(f.Type == DigitalLibraryType.Videos ? "Explore Videos" : "Open") <i class="bi bi-chevron-right"></i>
                        </a>
                    </div>
                </article>
            }
        </div>

        <a class="dl-viewall" href="DigitalLibrary/content">View All Content <i class="bi bi-chevron-right"></i></a>

        <div class="dl-grid">
            @foreach (var item in Items.Take(9))
            {
                <DigitalLibraryCard @key="item.Id" Item="item"
                                    OnEdit="Edit" OnDelete="Delete" OnArchive="Archive" OnTogglePublish="TogglePublish" />
            }
        </div>

        <a class="dl-viewall dl-viewall-end" href="DigitalLibrary/content">View All Content <i class="bi bi-chevron-right"></i></a>
    </section>

    <DigitalLibraryCreateDialog @bind-IsOpen="_createOpen" />
    <DigitalLibraryUnpublishDialog Item="_unpublishTarget" OnConfirm="ConfirmUnpublish" OnCancel="() => _unpublishTarget = null" />
</div>

@code {
    private bool _createOpen;
    private DigitalLibraryItem? _unpublishTarget;

    private string _query = "";

    private static readonly string[] Suggestions =
    {
        "Find Product Information", "Show latest brochures", "Explain a product", "Find a related video"
    };

    private sealed record Category(DigitalLibraryType Type, string Title, string Description, string Icon, string CountIcon, string Unit, string LinkText);

    private static readonly Category[] Categories =
    {
        new(DigitalLibraryType.Videos, "AI Videos", "Watch smart, AI-powered videos that explain products, solutions and technologies.",
            "bi-camera-video-fill", "bi-play-btn", "Videos", "Explore Videos"),
        new(DigitalLibraryType.Products, "Product Information", "Explore detailed product information, specifications and technical resources.",
            "bi-clipboard2-data-fill", "bi-box-seam", "Products", "Explore Products"),
        new(DigitalLibraryType.Brochures, "Product Brochures", "Access official brochures, datasheets and catalogues in one place.",
            "bi-journal-bookmark-fill", "bi-file-earmark-pdf", "Brochures", "Explore Brochures"),
    };

    // Sample content until the library API exists (shared with the All Content list).
    private readonly List<DigitalLibraryItem> Items = DigitalLibrarySampleData.Create(16);

    private int Count(DigitalLibraryType t) => Items.Count(i => i.Type == t);

    private static string ListHref(DigitalLibraryType t) => $"DigitalLibrary/content?type={t.ToString().ToLowerInvariant()}";

    private void OpenType(DigitalLibraryType t) => Nav.NavigateTo("/" + ListHref(t));

    private void Search()
    {
        if (string.IsNullOrWhiteSpace(_query)) return;
        Nav.NavigateTo($"/DigitalLibrary/chat?q={Uri.EscapeDataString(_query.Trim())}");
    }

    private void UseSuggestion(string s)
    {
        _query = s;
        Search();
    }

    private void Edit(DigitalLibraryItem item) => Nav.NavigateTo($"/DigitalLibrary/add?id={item.Id}");

    private async Task Delete(DigitalLibraryItem item)
    {
        if (!await Toast.ConfirmAsync("Delete content", $"Delete \"{item.Title}\"? This cannot be undone.", "Delete", danger: true)) return;
        Items.Remove(item);
        Toast.Success("Content deleted.");
    }

    private void Archive(DigitalLibraryItem item)
    {
        Items.Remove(item);
        Toast.Info("Content archived.");
    }

    private void TogglePublish(DigitalLibraryItem item)
    {
        if (item.Published)
        {
            _unpublishTarget = item; // confirmed in the dialog
            return;
        }

        item.Published = true;
        Toast.Success("Content published.");
    }

    private void ConfirmUnpublish(DigitalLibraryItem item)
    {
        item.Published = false;
        _unpublishTarget = null;
        Toast.Success("Content moved to Drafts.");
    }
}
