@page "/MarkAttendance"
@using SPIC.Core.Entities
@using SPIC.Core.DTOs
@using System.Net.Http.Json
@inject NavigationManager Navigation
@inject HttpClient Http
@inject SPIC.MauiBlazorApp.Shared.Services.ToastService Toast
@inject SPIC.MauiBlazorApp.Shared.Services.FieldAttendanceState AttendanceState
@inject SPIC.MauiBlazorApp.Shared.Services.LoginState LoginState
@inject SPIC.MauiBlazorApp.Shared.Services.JMDOAttendanceApi Api
@inject SPIC.MauiBlazorApp.Shared.Services.IFormFactor FormFactor
@inject SPIC.MauiBlazorApp.Shared.Services.NavHistoryService NavHistory
@inject SPIC.MauiBlazorApp.Shared.Services.LookupCacheService LookupCache
@inject IJSRuntime JS

<div class="container-fluid py-4 px-0 ma-page">

    <div class="ma-header-row">
        <button type="button" class="ma-back-btn" @onclick="GoBack" aria-label="Go back" title="Go back">
            <i class="bi bi-arrow-left"></i>
        </button>
        <div class="ma-header-text">
            <h2 class="ma-title">Mark Attendance</h2>
            <p class="ma-subtitle">Today's visited area &amp; attendance status.</p>
        </div>
    </div>

    @if (!IsNativeApp)
    {
        <div class="ma-card">
            <EmptyState Icon="bi-phone"
                        Title="Attendance can only be marked from the SPIC mobile app"
                        Message="Please open SPIC ONE on your phone to mark today's attendance, start a task, or use live tracking." />
        </div>
    }
    else
    {
        <div class="ma-grid">
            <div class="ma-card">
                <p class="ma-meta">Region: @FieldExecRegion &middot; JMDO H.Q: @FieldExecJmdoHq</p>

                @if (showStoppedState)
                {
                    <div class="ma-success-banner">
                        <span class="ma-success-icon"><i class="bi bi-check-lg"></i></span>
                        <div class="ma-success-text">
                            <div class="ma-success-title-row">
                                <span class="ma-success-title">Location tracking stopped successfully!</span>
                                <span class="ma-success-time">@(_stoppedAt is { } st ? st.ToString("dd MMM yyyy, hh:mm tt") : "just now")</span>
                            </div>
                            <div class="ma-success-sub">Your location has been recorded.</div>
                        </div>
                    </div>

                    <div class="ma-stats-row">
                        <div class="ma-stat">
                            <div class="ma-stat-top"><i class="bi bi-check-circle"></i> <span class="ma-stat-pct">@(_todayAttendance is not null ? "100%" : "0%")</span></div>
                            <div class="ma-stat-label">Attendance Completed</div>
                        </div>
                        <div class="ma-stat">
                            <div class="ma-stat-top"><i class="bi bi-geo-alt"></i> <span class="ma-stat-pct">@(_stoppedAt is not null ? "100%" : "0%")</span></div>
                            <div class="ma-stat-label">Location Point Saved</div>
                        </div>
                        <div class="ma-stat">
                            <div class="ma-stat-top"><i class="bi bi-clipboard-check"></i> <span class="ma-stat-pct">@TodayTaskCompletionPct</span></div>
                            <div class="ma-stat-label">Today Task Completed</div>
                        </div>
                    </div>

                    <button type="button" class="ma-btn-submit" @onclick='() => Navigation.NavigateTo("/TrackPlayback")'>
                        <i class="bi bi-map"></i> View Tracking Details
                    </button>
                }
                else if (_todayAttendance is not null && !_editingAttendance)
                {
                    <div class="ma-attendance-done">
                        <span class="ma-attendance-done-icon"><i class="bi bi-check-circle-fill"></i></span>
                        <div class="ma-attendance-done-text">
                            <div class="ma-attendance-done-title">Attendance marked today</div>
                            <div class="ma-attendance-done-sub">
                                @StatusToLabel(_todayAttendance.AttendanceStatus)
                                @if (!string.IsNullOrWhiteSpace(_todayAttendance.VisitArea))
                                {
                                    <text> &middot; @_todayAttendance.VisitArea</text>
                                }
                                @if (_todayAttendance.AttendanceUpdatedAt is { } markedAt)
                                {
                                    <text> &middot; @markedAt.ToString("h:mm tt")</text>
                                }
                            </div>
                            @if (_todayAttendance.AttendanceLatitude.HasValue && _todayAttendance.AttendanceLongitude.HasValue)
                            {
                                <div class="mt-1">
                                    <button type="button" class="ma-link-btn" @onclick="() => ViewCoordsOnMap(_todayAttendance.AttendanceLatitude.Value, _todayAttendance.AttendanceLongitude.Value, _todayAttendance.VisitArea)">
                                        <i class="bi bi-geo-alt-fill me-1"></i>View saved location on map
                                    </button>
                                </div>
                            }
                        </div>
                        @if (LoginState.Can(PagePermission.MarkAttendance, "Update"))
                        {
                            <button type="button" class="ma-link-btn" @onclick="() => _editingAttendance = true">Edit</button>
                        }
                    </div>
                }
                else if (_todayAttendance is null
                    ? LoginState.Can(PagePermission.MarkAttendance, "Entry")
                    : LoginState.Can(PagePermission.MarkAttendance, "Update"))
                {
                    @if (isLate)
                    {
                        <div class="ma-late-banner">
                            <i class="bi bi-exclamation-circle-fill"></i>
                            Submitted late for today &mdash; you can still update the details below.
                        </div>
                    }

                    <label class="ma-field-label" for="ma-date">Date<span class="ma-required">*</span></label>
                    <input id="ma-date" type="date" class="ma-input" @bind="visitDate" />

                    <label class="ma-field-label" for="ma-area">
                        Visit Area / Place
                        @if (_latitude is null && _longitude is null && !_locating)
                        {
                            <span class="text-danger ms-1">* (Type manually)</span>
                        }
                        @if (_resolvingAddress)
                        {
                            <span class="ma-info-sub">(fetching from your location...)</span>
                        }
                        else if (_addressAutoFilled)
                        {
                            <span class="ma-info-sub">(from your location - edit if needed)</span>
                        }
                    </label>
                    <input id="ma-area" type="text" class="ma-input"
                           placeholder="@(_latitude is not null ? "e.g. Anaimalai - auto-filled from location when available" : "Type your visit area / place...")"
                           @bind="visitArea" @bind:event="oninput" @bind:after="() => _addressAutoFilled = false" />

                    <label class="ma-field-label" for="ma-status">Attendance Status</label>
                    <select id="ma-status" class="ma-input" @bind="attendanceStatus">
                        <option>Present</option>
                        <option>Half Day</option>
                        <option>On Leave</option>
                    </select>

                    <div class="ma-location-row">
                        @if (_locating)
                        {
                            <span class="spinner-border spinner-border-sm text-success" role="status" aria-hidden="true"></span>
                        }
                        else if (_latitude is not null && _longitude is not null)
                        {
                            <i class="bi bi-check-circle-fill text-success"></i>
                        }
                        else
                        {
                            <i class="bi bi-geo-alt text-secondary"></i>
                        }
                        <span>@LocationStatusText</span>
                        @if (CoordinatesText is not null)
                        {
                            <span class="ma-info-sub">(@CoordinatesText)</span>
                        }
                        @if (_latitude is not null && _longitude is not null)
                        {
                            <text> &middot; </text>
                            <button type="button" class="ma-link-btn" @onclick="ViewOnMap">view on map</button>
                        }
                    </div>

                    <button type="button" class="ma-btn-submit" disabled="@_saving" @onclick="UpdateAttendance">
                        @(_saving ? "Updating..." : "Update Attendance")
                    </button>
                }
            </div>

            <div class="ma-card ma-profile-card">
                <div class="ma-profile-top">
                    <span class="ma-role-badge">@(LoginState.UserRole?.ToString() ?? "—")</span>
                    <h3 class="ma-profile-name">@(string.IsNullOrWhiteSpace(LoginState.UserName) ? "—" : LoginState.UserName)</h3>
                </div>

                <div class="ma-info-rows">
                    <div class="ma-info-row">
                        <span class="ma-info-key"><i class="bi bi-calendar3"></i> This week</span>
                        <span class="ma-info-val">@WeekRangeText</span>
                    </div>
                    <div class="ma-info-row">
                        <span class="ma-info-key"><i class="bi bi-person-check"></i> Current Status</span>
                        @if (_statusLoading)
                        {
                            <span class="ma-info-val">Checking...</span>
                        }
                        else
                        {
                            <span class="ma-info-val"><span class="@(AttendanceState.IsOnDuty ? "ma-dot" : "ma-dot ma-dot-off")"></span>@(AttendanceState.IsOnDuty ? "On Duty" : "Off Duty")</span>
                        }
                    </div>
                    <div class="ma-info-row">
                        <span class="ma-info-key"><i class="bi bi-person"></i> Current Location</span>
                        <span class="ma-info-val ma-info-val-stack">
                            <span>@LocationStatusText</span>
                            @if (CoordinatesText is not null)
                            {
                                <span class="ma-info-sub">@CoordinatesText</span>
                            }
                            @if (_locatedAt is not null)
                            {
                                <span class="ma-info-sub">(@_locatedAt.Value.ToString("dd MMM yyyy, hh:mm tt"))</span>
                            }
                            @if (_latitude is not null && _longitude is not null)
                            {
                                <button type="button" class="ma-link-btn text-start mt-1" @onclick="ViewOnMap">
                                    <i class="bi bi-map me-1"></i>View on map
                                </button>
                            }
                        </span>
                    </div>
                </div>

                <h4 class="ma-weekly-title">Weekly Summary</h4>
                @if (_weekLoading)
                {
                    <EmptyState Icon="bi-hourglass-split" Title="Loading weekly summary..." Compact="true" />
                }
                else if (_week is null)
                {
                    <EmptyState Icon="bi-exclamation-triangle" Title="Could not load the weekly summary" Message="You can still mark or update attendance." Compact="true" />
                }
                else
                {
                    <div class="ma-weekly-list">
                        @foreach (var day in _week.Days)
                        {
                            <div class="ma-weekly-row">
                                <div class="ma-weekly-head">
                                    <span class="ma-weekly-dot"></span>
                                    <span class="ma-weekly-day">@day.Date.ToString("ddd, dd MMM yyyy")</span>
                                </div>
                                <div class="ma-weekly-meta">
                                    <span class="ma-info-sub">@(day.AttendanceStatus is { } status ? (status == JMDOAttendanceStatus.Absent ? "Absent" : StatusToLabel(status)) : "No attendance")</span>
                                    <span class="ma-weekly-hours">@FormatDuration(day.WorkingDuration)</span>
                                    <span class="ma-weekly-sep">-</span>
                                    <span class="ma-weekly-locations">@day.TasksStarted @(day.TasksStarted == 1 ? "task" : "tasks") started</span>
                                    <span class="ma-weekly-km">@day.DistanceKm.ToString("0.0") km</span>
                                </div>
                                <span class="ma-weekly-tasks">@DayTaskText(day.Date)</span>
                            </div>
                        }
                    </div>

                    @if (_tasks is { HasAllocation: true } tasks)
                    {
                        <div class="ma-weekly-row ma-weekly-extra">
                            <div class="ma-weekly-head">
                                <span class="ma-weekly-dot"></span>
                                <span class="ma-weekly-day">Weekly tasks</span>
                            </div>
                            <div class="ma-weekly-meta">
                                <span class="ma-info-sub">No planned day</span>
                            </div>
                            <span class="ma-weekly-tasks">@TaskCountsText(tasks.WeeklyTasks)</span>
                        </div>
                        @if (tasks.UnscheduledDealerTasks.Allocated > 0)
                        {
                            <div class="ma-weekly-row ma-weekly-extra">
                                <div class="ma-weekly-head">
                                    <span class="ma-weekly-dot"></span>
                                    <span class="ma-weekly-day">Unscheduled dealers</span>
                                </div>
                                <div class="ma-weekly-meta">
                                    <span class="ma-info-sub">no planned day in this week</span>
                                </div>
                                <span class="ma-weekly-tasks">@TaskCountsText(tasks.UnscheduledDealerTasks)</span>
                            </div>
                        }
                    }
                }
            </div>
        </div>
    }

    @if (_showMapModal)
    {
        <div class="ma-modal-backdrop" @onclick="CloseMapModal"></div>
        <div class="ma-modal" role="dialog" aria-modal="true" aria-labelledby="ma-map-title">
            <div class="ma-modal-header">
                <div class="ma-modal-title-wrap">
                    <i class="bi bi-geo-alt-fill text-danger me-1"></i>
                    <h5 id="ma-map-title" class="ma-modal-title">Location on Map</h5>
                </div>
                <button type="button" class="ma-modal-close" @onclick="CloseMapModal" aria-label="Close">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="ma-modal-body">
                <div class="ma-modal-meta">
                    <div class="ma-modal-address">
                        <i class="bi bi-pin-map-fill text-success me-1"></i>
                        <strong>@(!string.IsNullOrWhiteSpace(_modalLabel) ? _modalLabel : "Captured Location")</strong>
                    </div>
                    @if (_modalLatitude.HasValue && _modalLongitude.HasValue)
                    {
                        <div class="ma-modal-coords text-muted">
                            <i class="bi bi-crosshair me-1"></i> @_modalLatitude.Value.ToString("0.####"), @_modalLongitude.Value.ToString("0.####")
                        </div>
                    }
                </div>
                <div id="ma-location-view-map" class="ma-view-map-canvas"></div>
            </div>
            <div class="ma-modal-footer">
                <button type="button" class="btn btn-outline-primary btn-sm d-inline-flex align-items-center gap-1" @onclick="OpenExternalMaps">
                    <i class="bi bi-box-arrow-up-right"></i> Open in Google Maps
                </button>
                <button type="button" class="btn btn-secondary btn-sm" @onclick="CloseMapModal">Close</button>
            </div>
        </div>
    }

</div>

@code {
    // Resolved from the signed-in user's own HQ (LoginState) and the shared HQ/Region lookup
    // (LookupCacheService) - same source FieldDashboard.razor's RoleRegionLine uses, replacing the
    // page's old hardcoded "COIMBATORE" / "COIMBATORE" placeholder. "—" when genuinely unavailable
    // (lookup not loaded yet, or the signed-in user has no HQ), same fallback convention used
    // elsewhere in this app rather than a fake default.
    private SPIC.MauiBlazorApp.Shared.Services.LocationItemDto? MyHeadquarter =>
        LookupCache.Headquarters.FirstOrDefault(h => h.Id == LoginState.HQId);
    private SPIC.MauiBlazorApp.Shared.Services.LocationItemDto? MyRegion =>
        LookupCache.Regions.FirstOrDefault(r => r.Id == LoginState.RegionId);
    private string FieldExecRegion => (MyHeadquarter?.RegionName ?? MyRegion?.RegionName) is { Length: > 0 } r ? r.ToUpperInvariant() : "—";
    private string FieldExecJmdoHq => MyHeadquarter?.HeadquarterName is { Length: > 0 } h ? h.ToUpperInvariant() : "—";

    // IFormFactor already distinguishes the two hosts for us: "Web" on the Blazor Web host
    // (any browser, desktop or mobile), the real device idiom (Phone/Tablet/...) on the native
    // MAUI app - see SPIC.MauiBlazorApp.Shared/Services/IFormFactor.cs. Attendance, task-start and
    // live tracking are mobile-app-only by design (see TaskDetail.StartTask/TasksAllocation.
    // StartSoilSampleTask's own attendance-redirect gate, and JMDOTrackingController's class doc
    // comment) - a desktop OR mobile-browser visit here only ever sees the blocking message below,
    // never the form.
    private bool IsNativeApp => FormFactor.GetFormFactor() != "Web";

    // Two states behind this one route/title now that Track Playback is its own page
    // (TrackPlayback.razor): the usual mark-attendance form, and the post-stop confirmation summary
    // (reached from FieldDashboard's "Stop Tracking" confirm, or from Track Playback's own Stop
    // Tracking button).
    [SupplyParameterFromQuery(Name = "view")]
    public string? ViewQuery { get; set; }

    // The server's own EndTime for the session Track Playback just stopped, passed back via query
    // string - a navigation between two different page components (unlike the old shared-component
    // "view" query trick) never carries in-memory field state across, so this is how the stopped-
    // confirmation banner below still shows the real stop time instead of always falling back to
    // "just now".
    [SupplyParameterFromQuery(Name = "stoppedAt")]
    public string? StoppedAtQuery { get; set; }

    private bool showStoppedState;

    // OnParametersSet, not OnInitialized: a Stop Tracking -> "?view=stopped" transition stays on
    // this same /MarkAttendance route and only changes the query string, so Blazor's router reuses
    // the same component instance instead of creating a new one. OnInitialized only runs once for
    // that instance - computing this flag there meant a later "view" change was silently ignored.
    //
    // Today's status and the week summary are reloaded on every "view" change for the same
    // reason - landing on "stopped" right after a Stop Tracking must not show pre-stop data.
    private string? _loadedView;
    private bool _loadedOnce;

    protected override async Task OnParametersSetAsync()
    {
        if (!IsNativeApp) return; // nothing to load - the whole page is just the blocking message

        showStoppedState = string.Equals(ViewQuery, "stopped", StringComparison.OrdinalIgnoreCase);
        _stoppedAt = showStoppedState && DateTime.TryParse(
            StoppedAtQuery, System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.RoundtripKind, out var parsed)
            ? parsed
            : null;

        var viewKey = ViewQuery ?? "";
        if (_loadedOnce && string.Equals(_loadedView, viewKey, StringComparison.OrdinalIgnoreCase))
            return;
        _loadedView = viewKey;

        var prefillForm = !_loadedOnce;
        _loadedOnce = true;

        await Task.WhenAll(RefreshTodayStatusAsync(prefillForm), RefreshWeekAsync(), RefreshTaskSummaryAsync(), LookupCache.EnsureLoadedAsync());
    }

    // ---- Daily task counts (Weekly Summary rows): api/JmdoTaskAllocation/mine/summary, loaded
    // independently of the attendance calls so a failure here never blocks them.
    private bool _tasksLoading = true;
    private JmdoTaskSummaryDto? _tasks;

    private async Task RefreshTaskSummaryAsync()
    {
        _tasksLoading = true;

        JmdoTaskSummaryDto? result = null;
        try
        {
            var response = await Http.GetAsync("api/JmdoTaskAllocation/mine/summary");
            if (response.IsSuccessStatusCode)
                result = await response.Content.ReadFromJsonAsync<JmdoTaskSummaryDto>();
            else
                Console.WriteLine($"Loading the task summary failed: HTTP {(int)response.StatusCode}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Loading the task summary failed: {ex.Message}");
        }

        _tasks = result;
        _tasksLoading = false;
    }

    // Today's own dealer-visit bucket plus the not-day-specific weekly bucket (MD Program/SPCM/
    // Soil/PoS), the same two buckets FieldDashboard.razor's TodayCounts combines - the stopped-
    // confirmation stat tile's real completion percentage instead of a fixed "100%". "—" (not 0%)
    // when there is genuinely nothing allocated today, since 0% would misleadingly read as "none
    // completed" rather than "nothing to complete".
    private string TodayTaskCompletionPct
    {
        get
        {
            if (_tasks is not { HasAllocation: true }) return "—";
            var today = _tasks.Days.FirstOrDefault(d => d.Date.Date == DateTime.Today);
            var weekly = _tasks.WeeklyTasks;
            var allocated = (today?.Allocated ?? 0) + weekly.Allocated;
            var completed = (today?.Completed ?? 0) + weekly.Completed;
            return allocated <= 0 ? "—" : $"{completed * 100 / allocated}%";
        }
    }

    // Per-day allocated dealer visits (the only task type with a day). Matched by date, so a task
    // summary for a different week (e.g. loaded either side of midnight Saturday) never lines up wrongly.
    private string DayTaskText(DateTime date)
    {
        if (_tasks is null) return _tasksLoading ? "Tasks: loading..." : "Tasks: unavailable";
        if (!_tasks.HasAllocation) return "Tasks: no allocation";

        var counts = _tasks.Days.FirstOrDefault(d => d.Date.Date == date.Date);
        return counts is null ? "Tasks: -" : TaskCountsText(counts);
    }

    private static string TaskCountsText(JmdoTaskCountsDto c) =>
        c.Allocated == 0
            ? "Allocated: 0"
            : $"Allocated: {c.Allocated} | Completed: {c.Completed} | Pending: {c.Pending}"
              + (c.InProgress > 0 ? $" | In Progress: {c.InProgress}" : "");

    // ---- This Week / Current Status / Weekly Summary: all from the server, for the signed-in JMDO.
    private bool _statusLoading = true;
    private bool _weekLoading = true;
    private JMDOWeeklySummaryDto? _week;

    // Attendance is a once-a-day action: once today's row exists, show a read-only confirmation
    // instead of the editable form every time the JMDO lands here - "Edit" is still available for
    // a genuine correction, it's just no longer the default view.
    private JMDOAttendanceDto? _todayAttendance;
    private bool _editingAttendance;

    private string WeekRangeText =>
        _weekLoading ? "Loading..."
        : _week is null ? "Unavailable"
        : $"{_week.WeekStart:dd MMM yyyy} - {_week.WeekEnd:dd MMM yyyy}";

    private static string FormatDuration(TimeSpan duration) =>
        $"{(int)duration.TotalHours}h {duration.Minutes}m";

    // The shared IsOnDuty flag is only ever overwritten with an answer from the server - a failed
    // load leaves it as it was. prefillForm is only true on the first load, so a later refresh never
    // replaces what the user has typed or the date they picked.
    private async Task RefreshTodayStatusAsync(bool prefillForm = false)
    {
        _statusLoading = true;
        try
        {
            var (loaded, today) = await Api.LoadTodayAsync();
            if (!loaded) return;

            AttendanceState.IsOnDuty = today?.DutyStatus == JMDODutyStatus.OnDuty;
            _todayAttendance = today;

            // Pre-fills the form from the caller's own attendance row for today, if one already
            // exists - the server upserts by (UserId, Date), so this just lets the JMDO see and
            // amend what they already submitted instead of blindly overwriting it.
            if (prefillForm && today is not null)
            {
                visitDate = today.Date;
                visitArea = today.VisitArea;
                attendanceStatus = StatusToLabel(today.AttendanceStatus);
            }
        }
        finally
        {
            _statusLoading = false;
        }
    }

    private async Task RefreshWeekAsync()
    {
        _weekLoading = true;
        try
        {
            _week = await Api.GetWeekAsync();
        }
        finally
        {
            _weekLoading = false;
        }
    }

    private bool isLate => visitDate < DateTime.Today || (visitDate == DateTime.Today && (_todayAttendance?.AttendanceUpdatedAt is { } u ? u.TimeOfDay > new TimeSpan(10, 0, 0) : DateTime.Now.TimeOfDay > new TimeSpan(10, 0, 0)));

    private bool _showMapModal;
    private bool _mapModalPendingInit;
    private double? _modalLatitude;
    private double? _modalLongitude;
    private string? _modalLabel;

    private DateTime visitDate = DateTime.Today;
    private string visitArea = "";
    // True while the current visitArea text came from GPS reverse-geocoding, not typing - lets the
    // "(from your location - edit if needed)" hint disappear the instant the user actually edits it.
    private bool _addressAutoFilled;
    private string attendanceStatus = "Present";
    private bool _saving;

    // Current-location capture: reuses the same window.getCurrentPosition bridge as
    // Sas/NewFarmerDialog.razor (js/location.js on the Web; MAUI bridges the same name to the
    // native locator). Display-only here - JMDOAttendance has no lat/lng fields; GPS points are
    // persisted by the tracking session work, done separately.
    private bool _locating;
    private double? _latitude;
    private double? _longitude;
    private DateTime? _locatedAt;
    private string? _locationError;

    // Readable address for the captured fix - display-only, never sent with the attendance.
    private string? _address;
    private bool _resolvingAddress;
    private string? _addressKey; // coordinates (4 dp, ~11 m) _address / the in-flight lookup belongs to

    private string LocationStatusText =>
        _locating ? "Capturing location..."
        : _latitude is null ? (_locationError ?? "Location unavailable")
        : _resolvingAddress ? "Fetching address..."
        : _address is not null && _addressKey == CoordinateKey(_latitude.Value, _longitude!.Value) ? $"Location captured: {_address}"
        : "Location captured · Address unavailable";

    private string? CoordinatesText =>
        _locating || _latitude is null ? null
        : $"{_latitude.Value.ToString("0.####")}, {_longitude!.Value.ToString("0.####")}";

    private static string CoordinateKey(double lat, double lng) =>
        FormattableString.Invariant($"{lat:0.####},{lng:0.####}");

    private sealed class GeoResult
    {
        public double Latitude { get; set; }
        public double Longitude { get; set; }
        public string? Error { get; set; }
    }

    private sealed class NominatimReverseResult
    {
        [System.Text.Json.Serialization.JsonPropertyName("display_name")]
        public string? DisplayName { get; set; }

        [System.Text.Json.Serialization.JsonPropertyName("address")]
        public NominatimAddress? Address { get; set; }
    }

    private sealed class NominatimAddress
    {
        [System.Text.Json.Serialization.JsonPropertyName("suburb")]
        public string? Suburb { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("village")]
        public string? Village { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("town")]
        public string? Town { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("city")]
        public string? City { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("hamlet")]
        public string? Hamlet { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("county")]
        public string? County { get; set; }

        // Most to least specific, in the order a field officer would actually recognize a place by.
        public string? ShortAreaName => Suburb ?? Village ?? Town ?? City ?? Hamlet ?? County;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && IsNativeApp)
        {
            await CaptureLocationAsync();
            await ResolveAddressAsync();
        }

        if (_showMapModal && _mapModalPendingInit && _modalLatitude.HasValue && _modalLongitude.HasValue)
        {
            _mapModalPendingInit = false;
            try
            {
                await JS.InvokeVoidAsync("initSingleLocationMap", "ma-location-view-map", _modalLatitude.Value, _modalLongitude.Value, _modalLabel ?? "Location");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Init single location map failed: {ex.Message}");
            }
        }
    }

    // Same reverse-geocoding call as TaskDetail.ResolvePlaceNameAsync (OpenStreetMap Nominatim,
    // full "display_name"). Best-effort: a failure leaves _address null and the coordinates shown,
    // and it's never awaited on the submit path, so it can't hold up or block attendance.
    private async Task ResolveAddressAsync()
    {
        if (_latitude is not { } lat || _longitude is not { } lng) return;

        var key = CoordinateKey(lat, lng);
        if (key == _addressKey && (_resolvingAddress || _address is not null)) return; // already resolved / in flight

        _addressKey = key;
        _address = null;
        _resolvingAddress = true;
        StateHasChanged();

        string? address = null;
        string? areaName = null;
        try
        {
            // addressdetails=1 asks Nominatim for the structured components too, not just the full
            // display_name - suburb/village/town/city is a much better fit for "Visit Area / Place"
            // (e.g. "Anaimalai") than the full postal address, which starts with house number/road.
            var request = new HttpRequestMessage(HttpMethod.Get, FormattableString.Invariant(
                $"https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat={lat}&lon={lng}&zoom=18&addressdetails=1"));
            request.Headers.UserAgent.ParseAdd("SPICOne/1.0 (+https://apmtechnologies.in)");

            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<NominatimReverseResult>();
                address = string.IsNullOrWhiteSpace(result?.DisplayName) ? null : result!.DisplayName;
                areaName = result?.Address?.ShortAreaName;
            }
            else
            {
                Console.WriteLine($"Reverse geocoding failed: HTTP {(int)response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Reverse geocoding failed: {ex.Message}");
        }

        // A newer fix may have replaced the coordinates while this lookup was running.
        if (_addressKey != key) return;

        _address = address;
        _resolvingAddress = false;
        if (address is null)
            _addressKey = null; // allow a retry for these coordinates on the next capture

        // Auto-fill Visit Area from the captured location, but only while it's still exactly what an
        // earlier auto-fill put there (or empty) - never overwrite text the user actually typed,
        // including a value pre-filled from today's already-saved attendance row.
        if ((string.IsNullOrWhiteSpace(visitArea) || _addressAutoFilled) && !string.IsNullOrWhiteSpace(areaName))
        {
            visitArea = areaName!;
            _addressAutoFilled = true;
        }

        StateHasChanged();
    }

    private async Task CaptureLocationAsync()
    {
        _locating = true;
        StateHasChanged();

        try
        {
            var position = await JS.InvokeAsync<GeoResult?>("getCurrentPosition");

            if (position is null || !string.IsNullOrWhiteSpace(position.Error))
            {
                _latitude = null;
                _longitude = null;
                _locationError = string.IsNullOrWhiteSpace(position?.Error)
                    ? "Location unavailable"
                    : position!.Error;
            }
            else
            {
                _latitude = position.Latitude;
                _longitude = position.Longitude;
                _locatedAt = DateTime.Now;
                _locationError = null;
            }
        }
        catch (Exception)
        {
            _latitude = null;
            _locationError = "Location is not available on this device.";
        }
        finally
        {
            _locating = false;
            StateHasChanged();
        }
    }

    private static JMDOAttendanceStatus ParseStatus(string label) => label switch
    {
        "Half Day" => JMDOAttendanceStatus.HalfDay,
        "On Leave" => JMDOAttendanceStatus.OnLeave,
        _ => JMDOAttendanceStatus.Present
    };

    private static string StatusToLabel(JMDOAttendanceStatus status) => status switch
    {
        JMDOAttendanceStatus.HalfDay => "Half Day",
        JMDOAttendanceStatus.OnLeave => "On Leave",
        _ => "Present"
    };

    private void ViewOnMap()
    {
        if (_latitude is null || _longitude is null)
        {
            Toast.Warning("No location captured yet.");
            return;
        }
        ViewCoordsOnMap(_latitude.Value, _longitude.Value, !string.IsNullOrWhiteSpace(visitArea) ? visitArea : _address);
    }

    private void ViewCoordsOnMap(double lat, double lng, string? label)
    {
        _modalLatitude = lat;
        _modalLongitude = lng;
        _modalLabel = label ?? "Captured Location";
        _showMapModal = true;
        _mapModalPendingInit = true;
        StateHasChanged();
    }

    private async Task CloseMapModal()
    {
        _showMapModal = false;
        _mapModalPendingInit = false;
        try { await JS.InvokeVoidAsync("destroySingleLocationMap", "ma-location-view-map"); }
        catch { }
    }

    private async Task OpenExternalMaps()
    {
        var lat = _modalLatitude ?? _latitude;
        var lng = _modalLongitude ?? _longitude;
        if (lat is null || lng is null) return;
        var url = FormattableString.Invariant($"https://www.google.com/maps/search/?api=1&query={lat.Value},{lng.Value}");
        try
        {
            await JS.InvokeVoidAsync("open", url, "_blank");
        }
        catch (Exception ex)
        {
            Toast.Error("Could not open external maps: " + ex.Message);
        }
    }

    // Set from the "stoppedAt" query string in OnParametersSetAsync - the server's own EndTime for
    // the session Track Playback (TrackPlayback.razor) just stopped. Null if the stopped view is
    // reached some other way (e.g. a hard reload on that URL without the query param), in which case
    // the banner falls back to "just now" instead of showing a wrong/fake date.
    private DateTime? _stoppedAt;

    private async Task UpdateAttendance()
    {
        if (!LoginState.IsLoggedIn)
        {
            Toast.Error("Please sign in again to mark attendance.");
            return;
        }
        if (visitDate == default)
        {
            Toast.Warning("Date is required.");
            return;
        }

        _saving = true;
        try
        {
            // Try to capture location if not yet captured
            if (_latitude is null || _longitude is null)
            {
                await CaptureLocationAsync();
            }

            // If location was captured and visitArea is still empty, auto-fetch from reverse-geocoding
            if (_latitude is not null && _longitude is not null && string.IsNullOrWhiteSpace(visitArea))
            {
                await ResolveAddressAsync();
            }

            // If location is NOT captured, the user MUST manually type the Visit Area
            if ((_latitude is null || _longitude is null) && string.IsNullOrWhiteSpace(visitArea))
            {
                Toast.Warning("Location could not be captured. Please type your Visit Area / Place to save attendance.");
                return;
            }

            var saved = await Api.UpdateAttendanceAsync(
                visitDate,
                string.IsNullOrWhiteSpace(visitArea) ? null : visitArea.Trim(),
                ParseStatus(attendanceStatus),
                _latitude,
                _longitude);

            if (saved is null)
            {
                _ = ResolveAddressAsync();
                return;
            }

            // Re-read today's status rather than trusting the saved row: the user may have saved a
            // past/future date, which must not change today's On/Off Duty.
            await RefreshTodayStatusAsync();
            Toast.Success("Attendance updated.");
            Navigation.NavigateTo("/FieldDashboard");
        }
        finally
        {
            _saving = false;
        }
    }

    private void GoBack()
    {
        if (NavHistory.TryGoBack())
            return;
        Navigation.NavigateTo("/FieldDashboard");
    }
}
