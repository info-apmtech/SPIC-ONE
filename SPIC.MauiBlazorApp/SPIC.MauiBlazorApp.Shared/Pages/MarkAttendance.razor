@page "/MarkAttendance"
@using SPIC.Core.Entities
@using SPIC.Core.DTOs
@using System.Net.Http.Json
@inject NavigationManager Navigation
@inject HttpClient Http
@inject SPIC.MauiBlazorApp.Shared.Services.ToastService Toast
@inject SPIC.MauiBlazorApp.Shared.Services.FieldAttendanceState AttendanceState
@inject SPIC.MauiBlazorApp.Shared.Services.LoginState LoginState
@inject SPIC.MauiBlazorApp.Shared.Services.JMDOAttendanceApi Api
@inject SPIC.MauiBlazorApp.Shared.Services.JMDOTrackingApi TrackingApi
@inject IJSRuntime JS

<div class="container-fluid py-4 px-0 ma-page">

    <h2 class="ma-title">Mark Attendance</h2>
    <p class="ma-subtitle">Today's visited area &amp; attendance status.</p>

    @if (showTrackingState)
    {
        <div class="ma-tracking-card">
            <div class="ma-tracking-header">
                <div class="ma-tracking-left">
                    <span class="ma-tracking-icon"><i class="bi bi-geo-alt-fill"></i></span>
                    <div>
                        <div class="ma-tracking-title">Tracking Active <span class="ma-tracking-dot"></span></div>
                        <div class="ma-tracking-sub">Your location and team members are being tracked in real-time</div>
                    </div>
                </div>

                <div class="ma-tracking-actions">
                    <button type="button" class="ma-btn-stop" disabled="@_stopping" @onclick="StopTracking">
                        <i class="bi bi-stop-circle-fill"></i> Stop Tracking
                    </button>
                    <span class="ma-timer-badge"><i class="bi bi-stopwatch"></i> 00:12:34</span>
                </div>
            </div>

            <div class="ma-map" role="img" aria-label="Map showing today's tracked route">
                <svg class="ma-map-route-svg" viewBox="0 0 1000 400" preserveAspectRatio="none">
                    <path d="M120,330 L120,260 Q120,230 150,215 L430,215 Q460,215 460,185 L460,120 Q460,90 490,80 L760,80" />
                </svg>

                <span class="ma-map-pin-start"><i class="bi bi-person-fill"></i></span>
                <span class="ma-map-label">JMDO<br />Karthik Raja</span>
                <span class="ma-map-pin-end"><i class="bi bi-geo-alt-fill"></i></span>

                <div class="ma-map-zoom">
                    <button type="button" aria-label="Zoom in"><i class="bi bi-plus-lg"></i></button>
                    <button type="button" aria-label="Zoom out"><i class="bi bi-dash-lg"></i></button>
                </div>
                <button type="button" class="ma-map-locate" aria-label="Center on my location"><i class="bi bi-cursor-fill"></i></button>
            </div>
        </div>
    }
    else
    {
        <div class="ma-grid">
            <div class="ma-card">
                <p class="ma-meta">Region: @FieldExecRegion &middot; JMDO H.Q: @FieldExecJmdoHq</p>

                @if (showStoppedState)
                {
                    <div class="ma-success-banner">
                        <span class="ma-success-icon"><i class="bi bi-check-lg"></i></span>
                        <div class="ma-success-text">
                            <div class="ma-success-title-row">
                                <span class="ma-success-title">Location tracking stopped successfully!</span>
                                <span class="ma-success-time">23 Sep 2026, 04:32 PM</span>
                            </div>
                            <div class="ma-success-sub">Your location has been recorded.</div>
                        </div>
                    </div>

                    <div class="ma-stats-row">
                        <div class="ma-stat">
                            <div class="ma-stat-top"><i class="bi bi-check-circle"></i> <span class="ma-stat-pct">100%</span></div>
                            <div class="ma-stat-label">Attendance Completed</div>
                        </div>
                        <div class="ma-stat">
                            <div class="ma-stat-top"><i class="bi bi-geo-alt"></i> <span class="ma-stat-pct">100%</span></div>
                            <div class="ma-stat-label">Location Point Saved</div>
                        </div>
                        <div class="ma-stat">
                            <div class="ma-stat-top"><i class="bi bi-clipboard-check"></i> <span class="ma-stat-pct">100%</span></div>
                            <div class="ma-stat-label">Today Task Completed</div>
                        </div>
                    </div>

                    <button type="button" class="ma-btn-submit" @onclick='() => Navigation.NavigateTo("/MarkAttendance?view=tracking")'>
                        <i class="bi bi-map"></i> View Tracking Details
                    </button>
                }
                else
                {
                    @if (isLate)
                    {
                        <div class="ma-late-banner">
                            <i class="bi bi-exclamation-circle-fill"></i>
                            Submitted late for today &mdash; you can still update the details below.
                        </div>
                    }

                    <label class="ma-field-label" for="ma-date">Date<span class="ma-required">*</span></label>
                    <input id="ma-date" type="date" class="ma-input" @bind="visitDate" />

                    <label class="ma-field-label" for="ma-area">Visit Area / Place<span class="ma-required">*</span></label>
                    <input id="ma-area" type="text" class="ma-input" placeholder="e.g. Anaimalai" @bind="visitArea" @bind:event="oninput" />

                    <label class="ma-field-label" for="ma-status">Attendance Status</label>
                    <select id="ma-status" class="ma-input" @bind="attendanceStatus">
                        <option>Present</option>
                        <option>Half Day</option>
                        <option>On Leave</option>
                    </select>

                    <div class="ma-location-row">
                        <i class="bi bi-check-circle-fill"></i> @LocationStatusText
                        @if (CoordinatesText is not null)
                        {
                            <span class="ma-info-sub">(@CoordinatesText)</span>
                        }
                        &middot;
                        <button type="button" class="ma-link-btn" @onclick="ViewOnMap">view on map</button>
                    </div>

                    <button type="button" class="ma-btn-submit" disabled="@(_saving || string.IsNullOrWhiteSpace(visitArea))" @onclick="UpdateAttendance">
                        @(_saving ? "Updating..." : "Update Attendance")
                    </button>
                }
            </div>

            <div class="ma-card ma-profile-card">
                <div class="ma-profile-top">
                    <span class="ma-role-badge">JMDO</span>
                    <h3 class="ma-profile-name">Karthik Raja</h3>
                </div>

                <div class="ma-info-rows">
                    <div class="ma-info-row">
                        <span class="ma-info-key"><i class="bi bi-calendar3"></i> This week</span>
                        <span class="ma-info-val">@WeekRangeText</span>
                    </div>
                    <div class="ma-info-row">
                        <span class="ma-info-key"><i class="bi bi-person-check"></i> Current Status</span>
                        @if (_statusLoading)
                        {
                            <span class="ma-info-val">Checking...</span>
                        }
                        else
                        {
                            <span class="ma-info-val"><span class="@(AttendanceState.IsOnDuty ? "ma-dot" : "ma-dot ma-dot-off")"></span>@(AttendanceState.IsOnDuty ? "On Duty" : "Off Duty")</span>
                        }
                    </div>
                    <div class="ma-info-row">
                        <span class="ma-info-key"><i class="bi bi-person"></i> Current Location</span>
                        <span class="ma-info-val ma-info-val-stack">
                            <span>@LocationStatusText</span>
                            @if (CoordinatesText is not null)
                            {
                                <span class="ma-info-sub">@CoordinatesText</span>
                            }
                            @if (_locatedAt is not null)
                            {
                                <span class="ma-info-sub">(@_locatedAt.Value.ToString("dd MMM yyyy, hh:mm tt"))</span>
                            }
                        </span>
                    </div>
                </div>

                <h4 class="ma-weekly-title">Weekly Summary</h4>
                @if (_weekLoading)
                {
                    <EmptyState Icon="bi-hourglass-split" Title="Loading weekly summary..." Compact="true" />
                }
                else if (_week is null)
                {
                    <EmptyState Icon="bi-exclamation-triangle" Title="Could not load the weekly summary" Message="You can still mark or update attendance." Compact="true" />
                }
                else
                {
                    <div class="ma-weekly-list">
                        @foreach (var day in _week.Days)
                        {
                            <div class="ma-weekly-row">
                                <span class="ma-weekly-dot"></span>
                                <span class="ma-weekly-day">@day.Date.ToString("ddd, dd MMM yyyy")</span>
                                <span class="ma-info-sub">@(day.AttendanceStatus is { } status ? (status == JMDOAttendanceStatus.Absent ? "Absent" : StatusToLabel(status)) : "No attendance")</span>
                                <span class="ma-weekly-hours">@FormatDuration(day.WorkingDuration)</span>
                                <span class="ma-weekly-sep">-</span>
                                <span class="ma-weekly-locations">@day.TasksStarted @(day.TasksStarted == 1 ? "task" : "tasks") started</span>
                                <span class="ma-weekly-km">@day.DistanceKm.ToString("0.0") km</span>
                                <span class="ma-weekly-tasks">@DayTaskText(day.Date)</span>
                            </div>
                        }
                    </div>

                    @if (_tasks is { HasAllocation: true } tasks)
                    {
                        <div class="ma-weekly-row ma-weekly-extra">
                            <span class="ma-weekly-dot"></span>
                            <span class="ma-weekly-day">Weekly tasks</span>
                            <span class="ma-info-sub">MD Program, SPCM, Soil Sample, PoS &middot; no planned day</span>
                            <span class="ma-weekly-tasks">@TaskCountsText(tasks.WeeklyTasks)</span>
                        </div>
                        @if (tasks.UnscheduledDealerTasks.Allocated > 0)
                        {
                            <div class="ma-weekly-row ma-weekly-extra">
                                <span class="ma-weekly-dot"></span>
                                <span class="ma-weekly-day">Unscheduled dealers</span>
                                <span class="ma-info-sub">no planned day in this week</span>
                                <span class="ma-weekly-tasks">@TaskCountsText(tasks.UnscheduledDealerTasks)</span>
                            </div>
                        }
                    }
                }
            </div>
        </div>
    }

</div>

@code {
    // Static placeholder: matches Karthik Raja's profile elsewhere in the app
    // (FieldDashboard) - no logged-in-user hierarchy lookup exists yet. The
    // Figma frame's own profile card said "Ravi Kumar", which would
    // contradict the rest of the app's example data, so this uses the name
    // that's consistent everywhere else instead.
    private const string FieldExecRegion = "COIMBATORE";
    private const string FieldExecJmdoHq = "COIMBATORE";

    // Three states behind one route/title: the usual mark-attendance form,
    // the post-stop confirmation summary (reached from FieldDashboard's
    // "Stop Tracking" confirm), and the full tracking map (reached from the
    // confirmation's own "View Tracking Details" button).
    [SupplyParameterFromQuery(Name = "view")]
    public string? ViewQuery { get; set; }

    private bool showStoppedState;
    private bool showTrackingState;

    // OnParametersSet, not OnInitialized: every transition here (form ->
    // stopped -> tracking -> stopped -> ...) stays on the /MarkAttendance
    // route and only changes the "view" query string, so Blazor's router
    // reuses the same component instance instead of creating a new one.
    // OnInitialized only runs once for that instance - computing these flags
    // there meant later "view" changes were silently ignored.
    //
    // Today's status and the week summary are reloaded on every "view" change for the same
    // reason - landing on "stopped" right after a Stop Tracking must not show pre-stop data.
    private string? _loadedView;
    private bool _loadedOnce;

    protected override async Task OnParametersSetAsync()
    {
        showStoppedState = string.Equals(ViewQuery, "stopped", StringComparison.OrdinalIgnoreCase);
        showTrackingState = string.Equals(ViewQuery, "tracking", StringComparison.OrdinalIgnoreCase);

        if (_loadedOnce && string.Equals(_loadedView, ViewQuery, StringComparison.OrdinalIgnoreCase))
            return;
        _loadedView = ViewQuery;

        var prefillForm = !_loadedOnce;
        _loadedOnce = true;
        await Task.WhenAll(RefreshTodayStatusAsync(prefillForm), RefreshWeekAsync(), RefreshTaskSummaryAsync());
    }

    // ---- Daily task counts (Weekly Summary rows): api/JmdoTaskAllocation/mine/summary, loaded
    // independently of the attendance calls so a failure here never blocks them.
    private bool _tasksLoading = true;
    private JmdoTaskSummaryDto? _tasks;

    private async Task RefreshTaskSummaryAsync()
    {
        _tasksLoading = true;

        JmdoTaskSummaryDto? result = null;
        try
        {
            var response = await Http.GetAsync("api/JmdoTaskAllocation/mine/summary");
            if (response.IsSuccessStatusCode)
                result = await response.Content.ReadFromJsonAsync<JmdoTaskSummaryDto>();
            else
                Console.WriteLine($"Loading the task summary failed: HTTP {(int)response.StatusCode}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Loading the task summary failed: {ex.Message}");
        }

        _tasks = result;
        _tasksLoading = false;
    }

    // Per-day allocated dealer visits (the only task type with a day). Matched by date, so a task
    // summary for a different week (e.g. loaded either side of midnight Saturday) never lines up wrongly.
    private string DayTaskText(DateTime date)
    {
        if (_tasks is null) return _tasksLoading ? "Tasks: loading..." : "Tasks: unavailable";
        if (!_tasks.HasAllocation) return "Tasks: no allocation";

        var counts = _tasks.Days.FirstOrDefault(d => d.Date.Date == date.Date);
        return counts is null ? "Tasks: -" : TaskCountsText(counts);
    }

    private static string TaskCountsText(JmdoTaskCountsDto c) =>
        c.Allocated == 0
            ? "Allocated: 0"
            : $"Allocated: {c.Allocated} | Completed: {c.Completed} | Pending: {c.Pending}"
              + (c.InProgress > 0 ? $" | In Progress: {c.InProgress}" : "");

    // ---- This Week / Current Status / Weekly Summary: all from the server, for the signed-in JMDO.
    private bool _statusLoading = true;
    private bool _weekLoading = true;
    private JMDOWeeklySummaryDto? _week;

    private string WeekRangeText =>
        _weekLoading ? "Loading..."
        : _week is null ? "Unavailable"
        : $"{_week.WeekStart:dd MMM yyyy} - {_week.WeekEnd:dd MMM yyyy}";

    private static string FormatDuration(TimeSpan duration) =>
        $"{(int)duration.TotalHours}h {duration.Minutes}m";

    // The shared IsOnDuty flag is only ever overwritten with an answer from the server - a failed
    // load leaves it as it was. prefillForm is only true on the first load, so a later refresh never
    // replaces what the user has typed or the date they picked.
    private async Task RefreshTodayStatusAsync(bool prefillForm = false)
    {
        _statusLoading = true;
        try
        {
            var (loaded, today) = await Api.LoadTodayAsync();
            if (!loaded) return;

            AttendanceState.IsOnDuty = today?.DutyStatus == JMDODutyStatus.OnDuty;

            // Pre-fills the form from the caller's own attendance row for today, if one already
            // exists - the server upserts by (UserId, Date), so this just lets the JMDO see and
            // amend what they already submitted instead of blindly overwriting it.
            if (prefillForm && today is not null)
            {
                visitDate = today.Date;
                visitArea = today.VisitArea;
                attendanceStatus = StatusToLabel(today.AttendanceStatus);
            }
        }
        finally
        {
            _statusLoading = false;
        }
    }

    private async Task RefreshWeekAsync()
    {
        _weekLoading = true;
        try
        {
            _week = await Api.GetWeekAsync();
        }
        finally
        {
            _weekLoading = false;
        }
    }

    private bool isLate = true;

    private DateTime visitDate = DateTime.Today;
    private string visitArea = "";
    private string attendanceStatus = "Present";
    private bool _saving;

    // Current-location capture: reuses the same window.getCurrentPosition bridge as
    // Sas/NewFarmerDialog.razor (js/location.js on the Web; MAUI bridges the same name to the
    // native locator). Display-only here - JMDOAttendance has no lat/lng fields; GPS points are
    // persisted by the tracking session work, done separately.
    private bool _locating;
    private double? _latitude;
    private double? _longitude;
    private DateTime? _locatedAt;
    private string? _locationError;

    // Readable address for the captured fix - display-only, never sent with the attendance.
    private string? _address;
    private bool _resolvingAddress;
    private string? _addressKey; // coordinates (4 dp, ~11 m) _address / the in-flight lookup belongs to

    private string LocationStatusText =>
        _locating ? "Capturing location..."
        : _latitude is null ? (_locationError ?? "Location unavailable")
        : _resolvingAddress ? "Fetching address..."
        : _address is not null && _addressKey == CoordinateKey(_latitude.Value, _longitude!.Value) ? $"Location captured: {_address}"
        : "Location captured · Address unavailable";

    private string? CoordinatesText =>
        _locating || _latitude is null ? null
        : $"{_latitude.Value.ToString("0.####")}, {_longitude!.Value.ToString("0.####")}";

    private static string CoordinateKey(double lat, double lng) =>
        FormattableString.Invariant($"{lat:0.####},{lng:0.####}");

    private sealed class GeoResult
    {
        public double Latitude { get; set; }
        public double Longitude { get; set; }
        public string? Error { get; set; }
    }

    private sealed class NominatimReverseResult
    {
        [System.Text.Json.Serialization.JsonPropertyName("display_name")]
        public string? DisplayName { get; set; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CaptureLocationAsync();
            await ResolveAddressAsync();
        }
    }

    // Same reverse-geocoding call as TaskDetail.ResolvePlaceNameAsync (OpenStreetMap Nominatim,
    // full "display_name"). Best-effort: a failure leaves _address null and the coordinates shown,
    // and it's never awaited on the submit path, so it can't hold up or block attendance.
    private async Task ResolveAddressAsync()
    {
        if (_latitude is not { } lat || _longitude is not { } lng) return;

        var key = CoordinateKey(lat, lng);
        if (key == _addressKey && (_resolvingAddress || _address is not null)) return; // already resolved / in flight

        _addressKey = key;
        _address = null;
        _resolvingAddress = true;
        StateHasChanged();

        string? address = null;
        try
        {
            var request = new HttpRequestMessage(HttpMethod.Get, FormattableString.Invariant(
                $"https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat={lat}&lon={lng}&zoom=18"));
            request.Headers.UserAgent.ParseAdd("SPICOne/1.0 (+https://apmtechnologies.in)");

            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<NominatimReverseResult>();
                address = string.IsNullOrWhiteSpace(result?.DisplayName) ? null : result!.DisplayName;
            }
            else
            {
                Console.WriteLine($"Reverse geocoding failed: HTTP {(int)response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Reverse geocoding failed: {ex.Message}");
        }

        // A newer fix may have replaced the coordinates while this lookup was running.
        if (_addressKey != key) return;

        _address = address;
        _resolvingAddress = false;
        if (address is null)
            _addressKey = null; // allow a retry for these coordinates on the next capture
        StateHasChanged();
    }

    private async Task CaptureLocationAsync()
    {
        _locating = true;
        StateHasChanged();

        try
        {
            var position = await JS.InvokeAsync<GeoResult?>("getCurrentPosition");

            if (position is null || !string.IsNullOrWhiteSpace(position.Error))
            {
                _latitude = null;
                _longitude = null;
                _locationError = string.IsNullOrWhiteSpace(position?.Error)
                    ? "Location unavailable"
                    : position!.Error;
            }
            else
            {
                _latitude = position.Latitude;
                _longitude = position.Longitude;
                _locatedAt = DateTime.Now;
                _locationError = null;
            }
        }
        catch (Exception)
        {
            _latitude = null;
            _locationError = "Location is not available on this device.";
        }
        finally
        {
            _locating = false;
            StateHasChanged();
        }
    }

    private static JMDOAttendanceStatus ParseStatus(string label) => label switch
    {
        "Half Day" => JMDOAttendanceStatus.HalfDay,
        "On Leave" => JMDOAttendanceStatus.OnLeave,
        _ => JMDOAttendanceStatus.Present
    };

    private static string StatusToLabel(JMDOAttendanceStatus status) => status switch
    {
        JMDOAttendanceStatus.HalfDay => "Half Day",
        JMDOAttendanceStatus.OnLeave => "On Leave",
        _ => "Present"
    };

    private void ViewOnMap() => Toast.Info("Map view isn't built yet.");

    // No confirmation modal on this frame (unlike FieldDashboard's own Stop
    // Tracking button) - stops immediately and lands on the same
    // post-stop summary that FieldDashboard's confirm flow uses. Goes through the real
    // api/JMDOTracking/stop (same as FieldDashboard) so Off Duty is saved, not just set locally.
    private bool _stopping;

    private async Task StopTracking()
    {
        if (_stopping) return;
        _stopping = true;
        try
        {
            GeoResult? position;
            try
            {
                position = await JS.InvokeAsync<GeoResult?>("getCurrentPosition");
            }
            catch (Exception)
            {
                position = null;
            }

            if (position is null || !string.IsNullOrWhiteSpace(position.Error))
            {
                Toast.Error(string.IsNullOrWhiteSpace(position?.Error)
                    ? "Could not get your current location. Tracking is still active - please try again."
                    : position!.Error!);
                return;
            }

            var stopped = await TrackingApi.StopAsync(position.Latitude, position.Longitude);
            if (stopped is null) return; // TrackingApi already raised an error toast; session stays Active

            AttendanceState.IsOnDuty = false;
            Navigation.NavigateTo("/MarkAttendance?view=stopped"); // view change reloads status + week
        }
        finally
        {
            _stopping = false;
        }
    }

    private async Task UpdateAttendance()
    {
        if (!LoginState.IsLoggedIn)
        {
            Toast.Error("Please sign in again to mark attendance.");
            return;
        }
        if (visitDate == default)
        {
            Toast.Warning("Date is required.");
            return;
        }
        if (string.IsNullOrWhiteSpace(visitArea))
        {
            Toast.Warning("Visit Area / Place is required.");
            return;
        }

        _saving = true;
        try
        {
            // A fresh fix at the moment attendance is marked, not the one captured on page load -
            // the coordinates must represent "now", not whenever the page happened to render.
            await CaptureLocationAsync();

            if (_latitude is null || _longitude is null)
            {
                Toast.Error(_locationError ?? "Could not get your current location. Please try again.");
                return;
            }

            var saved = await Api.UpdateAttendanceAsync(
                visitDate, visitArea.Trim(), ParseStatus(attendanceStatus), _latitude.Value, _longitude.Value);
            if (saved is null)
            {
                // Api already raised an error toast. Still on this page, so label the fresh fix -
                // not awaited, the address lookup must never hold up the form.
                _ = ResolveAddressAsync();
                return;
            }

            // Re-read today's status rather than trusting the saved row: the user may have saved a
            // past/future date, which must not change today's On/Off Duty.
            await RefreshTodayStatusAsync();
            Toast.Success("Attendance updated.");
            Navigation.NavigateTo("/FieldDashboard");
        }
        finally
        {
            _saving = false;
        }
    }
}
