@page "/MarkAttendance"
@page "/TrackPlayback"
@implements IAsyncDisposable
@using SPIC.Core.Entities
@using SPIC.Core.DTOs
@using System.Net.Http.Json
@inject NavigationManager Navigation
@inject HttpClient Http
@inject SPIC.MauiBlazorApp.Shared.Services.ToastService Toast
@inject SPIC.MauiBlazorApp.Shared.Services.FieldAttendanceState AttendanceState
@inject SPIC.MauiBlazorApp.Shared.Services.LoginState LoginState
@inject SPIC.MauiBlazorApp.Shared.Services.JMDOAttendanceApi Api
@inject SPIC.MauiBlazorApp.Shared.Services.JMDOTrackingApi TrackingApi
@inject SPIC.MauiBlazorApp.Shared.Services.IFormFactor FormFactor
@inject SPIC.MauiBlazorApp.Shared.Services.NavHistoryService NavHistory
@inject IJSRuntime JS

<div class="container-fluid py-4 px-0 ma-page">

    <div class="ma-header-row">
        <button type="button" class="ma-back-btn" @onclick="GoBack" aria-label="Go back" title="Go back">
            <i class="bi bi-arrow-left"></i>
        </button>
        <div class="ma-header-text">
            <h2 class="ma-title">Mark Attendance</h2>
            <p class="ma-subtitle">Today's visited area &amp; attendance status.</p>
        </div>
    </div>

    @if (!IsNativeApp)
    {
        <div class="ma-card">
            <EmptyState Icon="bi-phone"
                        Title="Attendance can only be marked from the SPIC mobile app"
                        Message="Please open SPIC ONE on your phone to mark today's attendance, start a task, or use live tracking." />
        </div>
    }
    else if (showTrackingState)
    {
        <div class="ma-tracking-card">
            <div class="ma-tracking-header">
                <div class="ma-tracking-left">
                    <span class="ma-tracking-icon"><i class="bi bi-geo-alt-fill"></i></span>
                    <div class="ma-tracking-left-text">
                        <div class="ma-tracking-title">
                            @(_trackSession?.Status == JMDOTrackingSessionStatus.Active ? "Tracking Active" : "Tracking Stopped")
                            @if (_trackSession?.Status == JMDOTrackingSessionStatus.Active)
                            {
                                <span class="ma-tracking-dot"></span>
                            }
                        </div>
                        <div class="ma-tracking-sub">
                            @(_trackSession?.Status == JMDOTrackingSessionStatus.Active
                                ? "Your location is being tracked in real-time"
                                : "Route recorded for this session")
                        </div>
                    </div>
                </div>

                <div class="ma-tracking-actions">
                    @if (_trackSession?.Status == JMDOTrackingSessionStatus.Active)
                    {
                        <button type="button" class="ma-btn-stop" disabled="@_stopping" @onclick="StopTracking">
                            <i class="bi bi-stop-circle-fill"></i> Stop Tracking
                        </button>
                    }
                    <span class="ma-timer-badge"><i class="bi bi-stopwatch"></i> @FormatElapsed(_trackElapsed)</span>
                </div>
            </div>

            @if (!_trackLoading && _todaySessions.Count > 1)
            {
                <div class="ma-session-picker">
                    @foreach (var s in _todaySessions)
                    {
                        <button type="button"
                                class="@("ma-session-chip" + (s.Id == _trackSession?.Id ? " active" : ""))"
                                @onclick="() => SelectSession(s)">
                            @if (s.Status == JMDOTrackingSessionStatus.Active)
                            {
                                <span class="ma-session-chip-dot"></span>
                            }
                            @FormatSessionLabel(s)
                        </button>
                    }
                </div>
            }

            @if (_trackLoading)
            {
                <EmptyState Icon="bi-hourglass-split" Title="Loading today's route..." Compact="true" />
            }
            else if (_trackSession is null)
            {
                <EmptyState Icon="bi-geo-alt"
                            Title="No tracking session for today yet"
                            Message="Start live tracking from the Field Dashboard to record your route."
                            Compact="true" />
            }
            else
            {
                <div class="ma-map">
                    <div id="ma-tracking-map" class="ma-map-canvas"></div>
                </div>

                @if (_trackPoints.Count >= 2)
                {
                    <div class="ma-playback-bar">
                        <div class="ma-playback-row">
                            <button type="button" class="ma-playback-btn" @onclick="TogglePlayback" aria-label="@(_playbackPlaying ? "Pause" : "Play")">
                                <i class="bi @(_playbackPlaying ? "bi-pause-fill" : "bi-play-fill")"></i>
                            </button>

                            <input type="range" class="ma-playback-scrubber"
                                   min="0" max="@(_trackPoints.Count - 1)" value="@_playbackIndex"
                                   @oninput="OnScrubberInput" />
                        </div>

                        <div class="ma-playback-row ma-playback-row-meta">
                            <span class="ma-playback-time">@PlaybackTimeLabel</span>

                            <div class="ma-playback-speed">
                                @foreach (var speed in PlaybackSpeeds)
                                {
                                    <button type="button" class="@(speed == _playbackSpeed ? "active" : "")" @onclick="() => SetPlaybackSpeed(speed)">@speed.ToString("0.#")x</button>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    }
    else
    {
        <div class="ma-grid">
            <div class="ma-card">
                <p class="ma-meta">Region: @FieldExecRegion &middot; JMDO H.Q: @FieldExecJmdoHq</p>

                @if (showStoppedState)
                {
                    <div class="ma-success-banner">
                        <span class="ma-success-icon"><i class="bi bi-check-lg"></i></span>
                        <div class="ma-success-text">
                            <div class="ma-success-title-row">
                                <span class="ma-success-title">Location tracking stopped successfully!</span>
                                <span class="ma-success-time">23 Sep 2026, 04:32 PM</span>
                            </div>
                            <div class="ma-success-sub">Your location has been recorded.</div>
                        </div>
                    </div>

                    <div class="ma-stats-row">
                        <div class="ma-stat">
                            <div class="ma-stat-top"><i class="bi bi-check-circle"></i> <span class="ma-stat-pct">100%</span></div>
                            <div class="ma-stat-label">Attendance Completed</div>
                        </div>
                        <div class="ma-stat">
                            <div class="ma-stat-top"><i class="bi bi-geo-alt"></i> <span class="ma-stat-pct">100%</span></div>
                            <div class="ma-stat-label">Location Point Saved</div>
                        </div>
                        <div class="ma-stat">
                            <div class="ma-stat-top"><i class="bi bi-clipboard-check"></i> <span class="ma-stat-pct">100%</span></div>
                            <div class="ma-stat-label">Today Task Completed</div>
                        </div>
                    </div>

                    <button type="button" class="ma-btn-submit" @onclick='() => Navigation.NavigateTo("/MarkAttendance?view=tracking")'>
                        <i class="bi bi-map"></i> View Tracking Details
                    </button>
                }
                else if (_todayAttendance is not null && !_editingAttendance)
                {
                    <div class="ma-attendance-done">
                        <span class="ma-attendance-done-icon"><i class="bi bi-check-circle-fill"></i></span>
                        <div class="ma-attendance-done-text">
                            <div class="ma-attendance-done-title">Attendance marked today</div>
                            <div class="ma-attendance-done-sub">
                                @StatusToLabel(_todayAttendance.AttendanceStatus) &middot; @_todayAttendance.VisitArea
                                @if (_todayAttendance.AttendanceUpdatedAt is { } markedAt)
                                {
                                    <text> &middot; @markedAt.ToString("h:mm tt")</text>
                                }
                            </div>
                        </div>
                        <button type="button" class="ma-link-btn" @onclick="() => _editingAttendance = true">Edit</button>
                    </div>
                }
                else
                {
                    @if (isLate)
                    {
                        <div class="ma-late-banner">
                            <i class="bi bi-exclamation-circle-fill"></i>
                            Submitted late for today &mdash; you can still update the details below.
                        </div>
                    }

                    <label class="ma-field-label" for="ma-date">Date<span class="ma-required">*</span></label>
                    <input id="ma-date" type="date" class="ma-input" @bind="visitDate" />

                    <label class="ma-field-label" for="ma-area">Visit Area / Place<span class="ma-required">*</span></label>
                    <input id="ma-area" type="text" class="ma-input" placeholder="e.g. Anaimalai" @bind="visitArea" @bind:event="oninput" />

                    <label class="ma-field-label" for="ma-status">Attendance Status</label>
                    <select id="ma-status" class="ma-input" @bind="attendanceStatus">
                        <option>Present</option>
                        <option>Half Day</option>
                        <option>On Leave</option>
                    </select>

                    <div class="ma-location-row">
                        <i class="bi bi-check-circle-fill"></i> @LocationStatusText
                        @if (CoordinatesText is not null)
                        {
                            <span class="ma-info-sub">(@CoordinatesText)</span>
                        }
                        &middot;
                        <button type="button" class="ma-link-btn" @onclick="ViewOnMap">view on map</button>
                    </div>

                    <button type="button" class="ma-btn-submit" disabled="@(_saving || string.IsNullOrWhiteSpace(visitArea))" @onclick="UpdateAttendance">
                        @(_saving ? "Updating..." : "Update Attendance")
                    </button>
                }
            </div>

            <div class="ma-card ma-profile-card">
                <div class="ma-profile-top">
                    <span class="ma-role-badge">JMDO</span>
                    <h3 class="ma-profile-name">Karthik Raja</h3>
                </div>

                <div class="ma-info-rows">
                    <div class="ma-info-row">
                        <span class="ma-info-key"><i class="bi bi-calendar3"></i> This week</span>
                        <span class="ma-info-val">@WeekRangeText</span>
                    </div>
                    <div class="ma-info-row">
                        <span class="ma-info-key"><i class="bi bi-person-check"></i> Current Status</span>
                        @if (_statusLoading)
                        {
                            <span class="ma-info-val">Checking...</span>
                        }
                        else
                        {
                            <span class="ma-info-val"><span class="@(AttendanceState.IsOnDuty ? "ma-dot" : "ma-dot ma-dot-off")"></span>@(AttendanceState.IsOnDuty ? "On Duty" : "Off Duty")</span>
                        }
                    </div>
                    <div class="ma-info-row">
                        <span class="ma-info-key"><i class="bi bi-person"></i> Current Location</span>
                        <span class="ma-info-val ma-info-val-stack">
                            <span>@LocationStatusText</span>
                            @if (CoordinatesText is not null)
                            {
                                <span class="ma-info-sub">@CoordinatesText</span>
                            }
                            @if (_locatedAt is not null)
                            {
                                <span class="ma-info-sub">(@_locatedAt.Value.ToString("dd MMM yyyy, hh:mm tt"))</span>
                            }
                        </span>
                    </div>
                </div>

                <h4 class="ma-weekly-title">Weekly Summary</h4>
                @if (_weekLoading)
                {
                    <EmptyState Icon="bi-hourglass-split" Title="Loading weekly summary..." Compact="true" />
                }
                else if (_week is null)
                {
                    <EmptyState Icon="bi-exclamation-triangle" Title="Could not load the weekly summary" Message="You can still mark or update attendance." Compact="true" />
                }
                else
                {
                    <div class="ma-weekly-list">
                        @foreach (var day in _week.Days)
                        {
                            <div class="ma-weekly-row">
                                <div class="ma-weekly-head">
                                    <span class="ma-weekly-dot"></span>
                                    <span class="ma-weekly-day">@day.Date.ToString("ddd, dd MMM yyyy")</span>
                                </div>
                                <div class="ma-weekly-meta">
                                    <span class="ma-info-sub">@(day.AttendanceStatus is { } status ? (status == JMDOAttendanceStatus.Absent ? "Absent" : StatusToLabel(status)) : "No attendance")</span>
                                    <span class="ma-weekly-hours">@FormatDuration(day.WorkingDuration)</span>
                                    <span class="ma-weekly-sep">-</span>
                                    <span class="ma-weekly-locations">@day.TasksStarted @(day.TasksStarted == 1 ? "task" : "tasks") started</span>
                                    <span class="ma-weekly-km">@day.DistanceKm.ToString("0.0") km</span>
                                </div>
                                <span class="ma-weekly-tasks">@DayTaskText(day.Date)</span>
                            </div>
                        }
                    </div>

                    @if (_tasks is { HasAllocation: true } tasks)
                    {
                        <div class="ma-weekly-row ma-weekly-extra">
                            <div class="ma-weekly-head">
                                <span class="ma-weekly-dot"></span>
                                <span class="ma-weekly-day">Weekly tasks</span>
                            </div>
                            <div class="ma-weekly-meta">
                                <span class="ma-info-sub">MD Program, SPCM, Soil Sample, PoS &middot; no planned day</span>
                            </div>
                            <span class="ma-weekly-tasks">@TaskCountsText(tasks.WeeklyTasks)</span>
                        </div>
                        @if (tasks.UnscheduledDealerTasks.Allocated > 0)
                        {
                            <div class="ma-weekly-row ma-weekly-extra">
                                <div class="ma-weekly-head">
                                    <span class="ma-weekly-dot"></span>
                                    <span class="ma-weekly-day">Unscheduled dealers</span>
                                </div>
                                <div class="ma-weekly-meta">
                                    <span class="ma-info-sub">no planned day in this week</span>
                                </div>
                                <span class="ma-weekly-tasks">@TaskCountsText(tasks.UnscheduledDealerTasks)</span>
                            </div>
                        }
                    }
                }
            </div>
        </div>
    }

</div>

@code {
    // Static placeholder: matches Karthik Raja's profile elsewhere in the app
    // (FieldDashboard) - no logged-in-user hierarchy lookup exists yet. The
    // Figma frame's own profile card said "Ravi Kumar", which would
    // contradict the rest of the app's example data, so this uses the name
    // that's consistent everywhere else instead.
    private const string FieldExecRegion = "COIMBATORE";
    private const string FieldExecJmdoHq = "COIMBATORE";

    // IFormFactor already distinguishes the two hosts for us: "Web" on the Blazor Web host
    // (any browser, desktop or mobile), the real device idiom (Phone/Tablet/...) on the native
    // MAUI app - see SPIC.MauiBlazorApp.Shared/Services/IFormFactor.cs. Attendance, task-start and
    // live tracking are mobile-app-only by design (see TaskDetail.StartTask/TasksAllocation.
    // StartSoilSampleTask's own attendance-redirect gate, and JMDOTrackingController's class doc
    // comment) - a desktop OR mobile-browser visit here only ever sees the blocking message below,
    // never the form.
    private bool IsNativeApp => FormFactor.GetFormFactor() != "Web";

    // Three states behind one route/title: the usual mark-attendance form,
    // the post-stop confirmation summary (reached from FieldDashboard's
    // "Stop Tracking" confirm), and the full tracking map (reached from the
    // confirmation's own "View Tracking Details" button).
    [SupplyParameterFromQuery(Name = "view")]
    public string? ViewQuery { get; set; }

    private bool showStoppedState;
    private bool showTrackingState;

    // OnParametersSet, not OnInitialized: every transition here (form ->
    // stopped -> tracking -> stopped -> ...) stays on the /MarkAttendance
    // route and only changes the "view" query string, so Blazor's router
    // reuses the same component instance instead of creating a new one.
    // OnInitialized only runs once for that instance - computing these flags
    // there meant later "view" changes were silently ignored.
    //
    // Today's status and the week summary are reloaded on every "view" change for the same
    // reason - landing on "stopped" right after a Stop Tracking must not show pre-stop data.
    private string? _loadedView;
    private bool _loadedOnce;

    protected override async Task OnParametersSetAsync()
    {
        if (!IsNativeApp) return; // nothing to load - the whole page is just the blocking message

        var wasTrackingView = showTrackingState;
        showStoppedState = string.Equals(ViewQuery, "stopped", StringComparison.OrdinalIgnoreCase);
        // Two ways to land on this same view: the "?view=tracking" query (FieldDashboard's "View
        // Route", MarkAttendance's own "View Tracking Details") and the dedicated "/TrackPlayback"
        // route (sidebar entry) - the dedicated route exists purely so the sidebar's NavLink can
        // tell "Mark Attendance" and "Track Playback" apart by path instead of by query string,
        // which this app's NavLink match was highlighting as the same item for both.
        var isTrackPlaybackRoute = Navigation.ToBaseRelativePath(Navigation.Uri)
            .StartsWith("TrackPlayback", StringComparison.OrdinalIgnoreCase);
        showTrackingState = isTrackPlaybackRoute || string.Equals(ViewQuery, "tracking", StringComparison.OrdinalIgnoreCase);

        if (wasTrackingView && !showTrackingState)
            await StopTrackingViewLiveUpdatesAsync();

        // Keyed on the resolved view, not just ViewQuery - "/MarkAttendance" and "/TrackPlayback"
        // both have a null ViewQuery, so keying on ViewQuery alone would treat navigating between
        // them as "nothing changed" and skip loading the tracking view's data.
        var viewKey = isTrackPlaybackRoute ? "tracking" : (ViewQuery ?? "");
        if (_loadedOnce && string.Equals(_loadedView, viewKey, StringComparison.OrdinalIgnoreCase))
            return;
        _loadedView = viewKey;

        var prefillForm = !_loadedOnce;
        _loadedOnce = true;

        var tasks = new List<Task> { RefreshTodayStatusAsync(prefillForm), RefreshWeekAsync(), RefreshTaskSummaryAsync() };
        if (showTrackingState) tasks.Add(LoadTrackingViewAsync());
        await Task.WhenAll(tasks);
    }

    // ---- Daily task counts (Weekly Summary rows): api/JmdoTaskAllocation/mine/summary, loaded
    // independently of the attendance calls so a failure here never blocks them.
    private bool _tasksLoading = true;
    private JmdoTaskSummaryDto? _tasks;

    private async Task RefreshTaskSummaryAsync()
    {
        _tasksLoading = true;

        JmdoTaskSummaryDto? result = null;
        try
        {
            var response = await Http.GetAsync("api/JmdoTaskAllocation/mine/summary");
            if (response.IsSuccessStatusCode)
                result = await response.Content.ReadFromJsonAsync<JmdoTaskSummaryDto>();
            else
                Console.WriteLine($"Loading the task summary failed: HTTP {(int)response.StatusCode}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Loading the task summary failed: {ex.Message}");
        }

        _tasks = result;
        _tasksLoading = false;
    }

    // Per-day allocated dealer visits (the only task type with a day). Matched by date, so a task
    // summary for a different week (e.g. loaded either side of midnight Saturday) never lines up wrongly.
    private string DayTaskText(DateTime date)
    {
        if (_tasks is null) return _tasksLoading ? "Tasks: loading..." : "Tasks: unavailable";
        if (!_tasks.HasAllocation) return "Tasks: no allocation";

        var counts = _tasks.Days.FirstOrDefault(d => d.Date.Date == date.Date);
        return counts is null ? "Tasks: -" : TaskCountsText(counts);
    }

    private static string TaskCountsText(JmdoTaskCountsDto c) =>
        c.Allocated == 0
            ? "Allocated: 0"
            : $"Allocated: {c.Allocated} | Completed: {c.Completed} | Pending: {c.Pending}"
              + (c.InProgress > 0 ? $" | In Progress: {c.InProgress}" : "");

    // ---- This Week / Current Status / Weekly Summary: all from the server, for the signed-in JMDO.
    private bool _statusLoading = true;
    private bool _weekLoading = true;
    private JMDOWeeklySummaryDto? _week;

    // Attendance is a once-a-day action: once today's row exists, show a read-only confirmation
    // instead of the editable form every time the JMDO lands here - "Edit" is still available for
    // a genuine correction, it's just no longer the default view.
    private JMDOAttendanceDto? _todayAttendance;
    private bool _editingAttendance;

    private string WeekRangeText =>
        _weekLoading ? "Loading..."
        : _week is null ? "Unavailable"
        : $"{_week.WeekStart:dd MMM yyyy} - {_week.WeekEnd:dd MMM yyyy}";

    private static string FormatDuration(TimeSpan duration) =>
        $"{(int)duration.TotalHours}h {duration.Minutes}m";

    // The shared IsOnDuty flag is only ever overwritten with an answer from the server - a failed
    // load leaves it as it was. prefillForm is only true on the first load, so a later refresh never
    // replaces what the user has typed or the date they picked.
    private async Task RefreshTodayStatusAsync(bool prefillForm = false)
    {
        _statusLoading = true;
        try
        {
            var (loaded, today) = await Api.LoadTodayAsync();
            if (!loaded) return;

            AttendanceState.IsOnDuty = today?.DutyStatus == JMDODutyStatus.OnDuty;
            _todayAttendance = today;

            // Pre-fills the form from the caller's own attendance row for today, if one already
            // exists - the server upserts by (UserId, Date), so this just lets the JMDO see and
            // amend what they already submitted instead of blindly overwriting it.
            if (prefillForm && today is not null)
            {
                visitDate = today.Date;
                visitArea = today.VisitArea;
                attendanceStatus = StatusToLabel(today.AttendanceStatus);
            }
        }
        finally
        {
            _statusLoading = false;
        }
    }

    private async Task RefreshWeekAsync()
    {
        _weekLoading = true;
        try
        {
            _week = await Api.GetWeekAsync();
        }
        finally
        {
            _weekLoading = false;
        }
    }

    private bool isLate = true;

    private DateTime visitDate = DateTime.Today;
    private string visitArea = "";
    private string attendanceStatus = "Present";
    private bool _saving;

    // Current-location capture: reuses the same window.getCurrentPosition bridge as
    // Sas/NewFarmerDialog.razor (js/location.js on the Web; MAUI bridges the same name to the
    // native locator). Display-only here - JMDOAttendance has no lat/lng fields; GPS points are
    // persisted by the tracking session work, done separately.
    private bool _locating;
    private double? _latitude;
    private double? _longitude;
    private DateTime? _locatedAt;
    private string? _locationError;

    // Readable address for the captured fix - display-only, never sent with the attendance.
    private string? _address;
    private bool _resolvingAddress;
    private string? _addressKey; // coordinates (4 dp, ~11 m) _address / the in-flight lookup belongs to

    private string LocationStatusText =>
        _locating ? "Capturing location..."
        : _latitude is null ? (_locationError ?? "Location unavailable")
        : _resolvingAddress ? "Fetching address..."
        : _address is not null && _addressKey == CoordinateKey(_latitude.Value, _longitude!.Value) ? $"Location captured: {_address}"
        : "Location captured · Address unavailable";

    private string? CoordinatesText =>
        _locating || _latitude is null ? null
        : $"{_latitude.Value.ToString("0.####")}, {_longitude!.Value.ToString("0.####")}";

    private static string CoordinateKey(double lat, double lng) =>
        FormattableString.Invariant($"{lat:0.####},{lng:0.####}");

    private sealed class GeoResult
    {
        public double Latitude { get; set; }
        public double Longitude { get; set; }
        public string? Error { get; set; }
    }

    private sealed class NominatimReverseResult
    {
        [System.Text.Json.Serialization.JsonPropertyName("display_name")]
        public string? DisplayName { get; set; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && IsNativeApp)
        {
            await CaptureLocationAsync();
            await ResolveAddressAsync();
        }

        if (showTrackingState && !_trackLoading && _trackSession is not null)
            await RenderTrackingMapAsync();
    }

    // ---- Tracking view (view=tracking): a real route map (tracking-map.js, Leaflet) for one of
    // today's sessions - see LoadTrackingViewAsync. A JMDO can Start/Stop Live Tracking more than
    // once a day (separate site visits); _todaySessions holds every one of them (oldest first) so
    // SelectSession can switch which route is shown instead of only ever seeing the latest.
    private List<JMDOTrackingSessionDto> _todaySessions = new();
    private JMDOTrackingSessionDto? _trackSession;
    private List<JMDOTrackingPointDto> _trackPoints = new();
    private bool _trackLoading = true;
    private TimeSpan _trackElapsed;
    private System.Threading.Timer? _trackElapsedTimer;
    private CancellationTokenSource? _trackRefreshCts;
    private int? _mapInitializedForSessionId;
    private bool _mapPointsDirty;

    // ---- Route playback: steps a "playhead" through _trackPoints over time (tracking-map.js's
    // setPlaybackPosition draws the amber trail/marker; all timing lives here, same split of
    // responsibility as the live elapsed-timer badge). Compressed time, not real-world-accurate -
    // watching a multi-hour session back at real speed would be useless for a quick review.
    private static readonly double[] PlaybackSpeeds = { 1, 2, 4 };
    private const int BasePlaybackTickMs = 400;

    private int _playbackIndex;
    private bool _playbackPlaying;
    private double _playbackSpeed = 1;
    private System.Threading.Timer? _playbackTimer;

    private string PlaybackTimeLabel =>
        _trackPoints.Count == 0 ? "--:--:--"
        : _trackPoints[Math.Clamp(_playbackIndex, 0, _trackPoints.Count - 1)].RecordedAt.ToString("hh:mm:ss tt");

    private void TogglePlayback()
    {
        if (_playbackPlaying)
        {
            PausePlayback();
            return;
        }

        if (_trackPoints.Count < 2) return;
        if (_playbackIndex >= _trackPoints.Count - 1) _playbackIndex = 0; // replay from the start

        _playbackPlaying = true;
        _playbackTimer?.Dispose();
        _playbackTimer = new System.Threading.Timer(PlaybackTick, null,
            (int)(BasePlaybackTickMs / _playbackSpeed), (int)(BasePlaybackTickMs / _playbackSpeed));
    }

    private void PausePlayback()
    {
        _playbackPlaying = false;
        _playbackTimer?.Dispose();
        _playbackTimer = null;
    }

    private void PlaybackTick(object? _)
    {
        if (_playbackIndex >= _trackPoints.Count - 1)
        {
            InvokeAsync(PausePlayback);
            return;
        }

        _playbackIndex++;
        _ = InvokeAsync(async () =>
        {
            await RenderPlaybackPositionAsync();
            StateHasChanged();
        });
    }

    private async Task OnScrubberInput(ChangeEventArgs e)
    {
        PausePlayback(); // manual scrubbing takes over from auto-play
        if (int.TryParse(e.Value?.ToString(), out var index))
        {
            _playbackIndex = Math.Clamp(index, 0, Math.Max(0, _trackPoints.Count - 1));
            await RenderPlaybackPositionAsync();
        }
    }

    private void SetPlaybackSpeed(double speed)
    {
        _playbackSpeed = speed;
        if (_playbackPlaying)
        {
            // Restart at the new cadence rather than letting the old interval finish one more tick.
            _playbackTimer?.Dispose();
            _playbackTimer = new System.Threading.Timer(PlaybackTick, null,
                (int)(BasePlaybackTickMs / _playbackSpeed), (int)(BasePlaybackTickMs / _playbackSpeed));
        }
    }

    private async Task RenderPlaybackPositionAsync()
    {
        if (_trackPoints.Count == 0) return;
        var points = _trackPoints.Select(p => new { latitude = p.Latitude, longitude = p.Longitude });
        try { await JS.InvokeVoidAsync("setPlaybackPosition", "ma-tracking-map", points, _playbackIndex); }
        catch (Exception) { /* map not ready yet - next render/tick will retry */ }
    }

    private static string FormatElapsed(TimeSpan ts) =>
        $"{(int)ts.TotalHours:D2}:{ts.Minutes:D2}:{ts.Seconds:D2}";

    // Loads every session the JMDO ran today, then selects the live Active one if there is one,
    // otherwise the most recently started - so a page reached via "View Tracking Details" (right
    // after Stop) still shows the route just recorded instead of an empty state. The rest of today's
    // sessions stay available via the picker (SelectSession) instead of being discarded.
    private async Task LoadTrackingViewAsync()
    {
        _trackLoading = true;
        StateHasChanged();

        _todaySessions = await TrackingApi.GetMineTodayAsync();
        _trackSession = _todaySessions.FirstOrDefault(s => s.Status == JMDOTrackingSessionStatus.Active)
            ?? _todaySessions.LastOrDefault(); // oldest-first list, so Last = most recently started
        _trackPoints = _trackSession is null ? new() : await TrackingApi.GetSessionPointsAsync(_trackSession.Id);
        _mapPointsDirty = true;

        _trackLoading = false;
        StateHasChanged();

        StartElapsedTimer();
        StartRefreshLoopIfActive();
    }

    // Switches the map/playback to a different one of today's sessions - everything else
    // (RenderTrackingMapAsync's own session-id guard) already resets the map/playhead correctly for
    // a changed _trackSession.Id, so this just needs to load that session's own points.
    private async Task SelectSession(JMDOTrackingSessionDto session)
    {
        if (_trackSession?.Id == session.Id) return;

        PausePlayback();
        _trackSession = session;
        _trackPoints = await TrackingApi.GetSessionPointsAsync(session.Id);
        _mapPointsDirty = true;

        StartElapsedTimer();
        StartRefreshLoopIfActive();
        StateHasChanged();
    }

    private static string FormatSessionLabel(JMDOTrackingSessionDto s) =>
        s.Status == JMDOTrackingSessionStatus.Active
            ? $"Live · {s.StartTime:h:mm tt}"
            : s.EndTime is { } end
                ? $"{s.StartTime:h:mm tt} – {end:h:mm tt}"
                : $"{s.StartTime:h:mm tt}";

    private void StartElapsedTimer()
    {
        _trackElapsedTimer?.Dispose();
        _trackElapsedTimer = null;
        if (_trackSession is null) return;

        void Tick(object? _)
        {
            _trackElapsed = _trackSession.Status == JMDOTrackingSessionStatus.Active
                ? DateTime.Now - _trackSession.StartTime
                : (_trackSession.Duration ?? TimeSpan.Zero);
            _ = InvokeAsync(StateHasChanged);
        }

        Tick(null);
        _trackElapsedTimer = new System.Threading.Timer(Tick, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    // Polls for new points only while the session is genuinely still Active - stops itself the
    // moment it sees the session end (stopped from here, auto-ended server-side, or from another
    // device), so this never keeps polling a finished session forever.
    private void StartRefreshLoopIfActive()
    {
        _trackRefreshCts?.Cancel();
        _trackRefreshCts = null;
        if (_trackSession?.Status != JMDOTrackingSessionStatus.Active) return;

        var cts = new CancellationTokenSource();
        _trackRefreshCts = cts;
        _ = RefreshLoopAsync(cts.Token);
    }

    private async Task RefreshLoopAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(15));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                var latest = await TrackingApi.GetMineActiveAsync();
                if (ct.IsCancellationRequested) return;

                _trackSession = latest ?? await TrackingApi.GetMineLatestAsync();
                if (ct.IsCancellationRequested) return;

                if (_trackSession is not null)
                {
                    _trackPoints = await TrackingApi.GetSessionPointsAsync(_trackSession.Id, ct);
                    _mapPointsDirty = true;
                }
                if (ct.IsCancellationRequested) return;

                StartElapsedTimer(); // reflects a status change (e.g. now Stopped) in the ticking badge
                await InvokeAsync(StateHasChanged);

                if (_trackSession?.Status != JMDOTrackingSessionStatus.Active)
                    return; // session ended - nothing left to keep polling for
            }
        }
        catch (OperationCanceledException)
        {
            // Expected when the view changes away from "tracking" - see StopTrackingViewLiveUpdatesAsync.
        }
    }

    private async Task StopTrackingViewLiveUpdatesAsync()
    {
        _trackElapsedTimer?.Dispose();
        _trackElapsedTimer = null;
        _trackRefreshCts?.Cancel();
        _trackRefreshCts = null;
        PausePlayback();

        if (_mapInitializedForSessionId is not null)
        {
            _mapInitializedForSessionId = null;
            try { await JS.InvokeVoidAsync("destroyTrackingRouteMap", "ma-tracking-map"); }
            catch (Exception) { /* page/circuit may already be gone */ }
        }
    }

    private async Task RenderTrackingMapAsync()
    {
        var freshSession = false;

        if (_mapInitializedForSessionId != _trackSession!.Id)
        {
            var startLat = _trackSession.StartLatitude ?? _trackPoints.FirstOrDefault()?.Latitude ?? 0;
            var startLng = _trackSession.StartLongitude ?? _trackPoints.FirstOrDefault()?.Longitude ?? 0;
            try
            {
                await JS.InvokeVoidAsync("initTrackingRouteMap", "ma-tracking-map", startLat, startLng);
                _mapInitializedForSessionId = _trackSession.Id;
                _mapPointsDirty = true; // force the first draw right after init
                freshSession = true;

                // Fresh/changed session - reset the playhead instead of carrying over a previous
                // session's playback position.
                PausePlayback();
                _playbackIndex = 0;
                try { await JS.InvokeVoidAsync("clearPlayback", "ma-tracking-map"); }
                catch (Exception) { /* nothing to clear yet on a brand-new map instance */ }
            }
            catch (Exception)
            {
                return; // map element not in the DOM yet - OnAfterRenderAsync will retry next render
            }
        }

        if (_mapPointsDirty && _trackPoints.Count > 0)
        {
            var points = _trackPoints.Select(p => new { latitude = p.Latitude, longitude = p.Longitude });
            await JS.InvokeVoidAsync("updateTrackingRouteMap", "ma-tracking-map", points);
            _mapPointsDirty = false;

            if (freshSession)
                await RenderPlaybackPositionAsync(); // shows the playhead at the start, before Play is pressed
        }
    }

    public async ValueTask DisposeAsync()
    {
        await StopTrackingViewLiveUpdatesAsync();
    }

    // Same reverse-geocoding call as TaskDetail.ResolvePlaceNameAsync (OpenStreetMap Nominatim,
    // full "display_name"). Best-effort: a failure leaves _address null and the coordinates shown,
    // and it's never awaited on the submit path, so it can't hold up or block attendance.
    private async Task ResolveAddressAsync()
    {
        if (_latitude is not { } lat || _longitude is not { } lng) return;

        var key = CoordinateKey(lat, lng);
        if (key == _addressKey && (_resolvingAddress || _address is not null)) return; // already resolved / in flight

        _addressKey = key;
        _address = null;
        _resolvingAddress = true;
        StateHasChanged();

        string? address = null;
        try
        {
            var request = new HttpRequestMessage(HttpMethod.Get, FormattableString.Invariant(
                $"https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat={lat}&lon={lng}&zoom=18"));
            request.Headers.UserAgent.ParseAdd("SPICOne/1.0 (+https://apmtechnologies.in)");

            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<NominatimReverseResult>();
                address = string.IsNullOrWhiteSpace(result?.DisplayName) ? null : result!.DisplayName;
            }
            else
            {
                Console.WriteLine($"Reverse geocoding failed: HTTP {(int)response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Reverse geocoding failed: {ex.Message}");
        }

        // A newer fix may have replaced the coordinates while this lookup was running.
        if (_addressKey != key) return;

        _address = address;
        _resolvingAddress = false;
        if (address is null)
            _addressKey = null; // allow a retry for these coordinates on the next capture
        StateHasChanged();
    }

    private async Task CaptureLocationAsync()
    {
        _locating = true;
        StateHasChanged();

        try
        {
            var position = await JS.InvokeAsync<GeoResult?>("getCurrentPosition");

            if (position is null || !string.IsNullOrWhiteSpace(position.Error))
            {
                _latitude = null;
                _longitude = null;
                _locationError = string.IsNullOrWhiteSpace(position?.Error)
                    ? "Location unavailable"
                    : position!.Error;
            }
            else
            {
                _latitude = position.Latitude;
                _longitude = position.Longitude;
                _locatedAt = DateTime.Now;
                _locationError = null;
            }
        }
        catch (Exception)
        {
            _latitude = null;
            _locationError = "Location is not available on this device.";
        }
        finally
        {
            _locating = false;
            StateHasChanged();
        }
    }

    private static JMDOAttendanceStatus ParseStatus(string label) => label switch
    {
        "Half Day" => JMDOAttendanceStatus.HalfDay,
        "On Leave" => JMDOAttendanceStatus.OnLeave,
        _ => JMDOAttendanceStatus.Present
    };

    private static string StatusToLabel(JMDOAttendanceStatus status) => status switch
    {
        JMDOAttendanceStatus.HalfDay => "Half Day",
        JMDOAttendanceStatus.OnLeave => "On Leave",
        _ => "Present"
    };

    private void ViewOnMap() => Toast.Info("Map view isn't built yet.");

    // No confirmation modal on this frame (unlike FieldDashboard's own Stop
    // Tracking button) - stops immediately and lands on the same
    // post-stop summary that FieldDashboard's confirm flow uses. Goes through the real
    // api/JMDOTracking/stop (same as FieldDashboard) so Off Duty is saved, not just set locally.
    private bool _stopping;

    private async Task StopTracking()
    {
        if (_stopping) return;
        _stopping = true;
        try
        {
            GeoResult? position;
            try
            {
                position = await JS.InvokeAsync<GeoResult?>("getCurrentPosition");
            }
            catch (Exception)
            {
                position = null;
            }

            if (position is null || !string.IsNullOrWhiteSpace(position.Error))
            {
                Toast.Error(string.IsNullOrWhiteSpace(position?.Error)
                    ? "Could not get your current location. Tracking is still active - please try again."
                    : position!.Error!);
                return;
            }

            var stopped = await TrackingApi.StopAsync(position.Latitude, position.Longitude);
            if (stopped is null) return; // TrackingApi already raised an error toast; session stays Active

            AttendanceState.IsOnDuty = false;
            Navigation.NavigateTo("/MarkAttendance?view=stopped"); // view change reloads status + week
        }
        finally
        {
            _stopping = false;
        }
    }

    private async Task UpdateAttendance()
    {
        if (!LoginState.IsLoggedIn)
        {
            Toast.Error("Please sign in again to mark attendance.");
            return;
        }
        if (visitDate == default)
        {
            Toast.Warning("Date is required.");
            return;
        }
        if (string.IsNullOrWhiteSpace(visitArea))
        {
            Toast.Warning("Visit Area / Place is required.");
            return;
        }

        _saving = true;
        try
        {
            // A fresh fix at the moment attendance is marked, not the one captured on page load -
            // the coordinates must represent "now", not whenever the page happened to render.
            await CaptureLocationAsync();

            if (_latitude is null || _longitude is null)
            {
                Toast.Error(_locationError ?? "Could not get your current location. Please try again.");
                return;
            }

            var saved = await Api.UpdateAttendanceAsync(
                visitDate, visitArea.Trim(), ParseStatus(attendanceStatus), _latitude.Value, _longitude.Value);
            if (saved is null)
            {
                // Api already raised an error toast. Still on this page, so label the fresh fix -
                // not awaited, the address lookup must never hold up the form.
                _ = ResolveAddressAsync();
                return;
            }

            // Re-read today's status rather than trusting the saved row: the user may have saved a
            // past/future date, which must not change today's On/Off Duty.
            await RefreshTodayStatusAsync();
            Toast.Success("Attendance updated.");
            Navigation.NavigateTo("/FieldDashboard");
        }
        finally
        {
            _saving = false;
        }
    }

    private void GoBack()
    {
        if (NavHistory.TryGoBack())
            return;
        Navigation.NavigateTo("/FieldDashboard");
    }
