@page "/InventorySummary"
@inject NavigationManager Nav

<PageTitle>Inventory Summary · SPIC ONE</PageTitle>

<div class="is-page">

        <PageHeader Title="Inventory Summary"
                    Subtitle="View stock movement and closing balance for each 15-days reporting period (Livestock / Orchard)"
                    ShowBack="false">
            <Actions>
                <button type="button" class="is-btn-back" @onclick="GoBack">
                    <i class="bi bi-arrow-left"></i> Back to Inventory Entry
                </button>
            </Actions>
        </PageHeader>

    <!-- Filters -->
    <div class="is-card is-filters-card">
        <div class="is-filters-header" @onclick="ToggleFilters">
            <div class="is-filters-title">
                <i class="bi bi-filter"></i> Filters
            </div>
            <i class="bi @(filtersExpanded ? "bi-chevron-down" : "bi-chevron-up")"></i>
        </div>
        
        @if (filtersExpanded)
        {
            <div class="is-filters-body">
                <div class="is-filters-grid">
                    <div class="is-filter-group">
                        <label>Year</label>
                        <select class="is-select-date">
                            <option>2026</option>
                        </select>
                    </div>
                    <div class="is-filter-group">
                        <label>Month</label>
                        <select class="is-select-date">
                            <option>September</option>
                        </select>
                    </div>
                    <div class="is-filter-group">
                        <label>Reporting Period</label>
                        <select class="is-select-chevron">
                            <option>All Periods</option>
                        </select>
                    </div>
                    <div class="is-filter-group">
                        <label>Category</label>
                        <select class="is-select-chevron">
                            <option>All</option>
                        </select>
                    </div>
                    <div class="is-filter-group">
                        <label>Product</label>
                        <select class="is-select-chevron">
                            <option>All Product</option>
                        </select>
                    </div>
                </div>
                <div class="is-filters-actions">
                    <button type="button" class="is-btn-clear"><i class="bi bi-x"></i> Clear All</button>
                    <button type="button" class="is-btn-primary"><i class="bi bi-filter"></i> Apply Filters</button>
                </div>
            </div>
        }
    </div>

