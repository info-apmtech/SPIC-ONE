    }

    .sbp-warning-icon {
        width: 30px;
        height: 30px;
        flex: 0 0 30px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #ffe4e6;
        color: #be123c;
        font-size: 0.88rem;
    }

    .sbp-warning-title {
        color: #9f1239;
        font-size: 0.81rem;
        font-weight: 700;
        line-height: 1.4;
    }

    .sbp-warning-text {
        margin: 3px 0 0;
        color: #6f3846;
        font-size: 0.76rem;
