    }

    .sbp-textarea:focus {
        border-color: #9ca3af;
        box-shadow: 0 0 0 3px rgba(148, 163, 184, 0.12);
    }

    .sbp-textarea:disabled {
        background: #f9fafb;
        cursor: not-allowed;
    }

    .sbp-field-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 5px;
    }

    .sbp-char-count {
        color: #9ca3af;
        font-size: 0.7rem;
    }

    .sbp-corrections-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
    }

    .sbp-correction-card {
        position: relative;
        display: flex;
        align-items: center;
        gap: 9px;
        min-height: 42px;
        padding: 9px 11px;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        background: #ffffff;
        cursor: pointer;
        transition: border-color .16s ease, background .16s ease, box-shadow .16s ease;
