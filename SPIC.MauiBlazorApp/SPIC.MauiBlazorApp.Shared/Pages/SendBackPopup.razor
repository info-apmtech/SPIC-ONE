@using System.Net.Http.Json
@using DR = SPIC.Core.Entities
@inject HttpClient Http

<div class="sbp-overlay" @onclick="ClosePopup">
    <div class="sbp-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="sbp-title">
        <header class="sbp-header">
            <div class="sbp-header-copy">
                <div class="sbp-header-icon" aria-hidden="true">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </div>
                <div>
                    <h1 id="sbp-title" class="sbp-title">Send Back Application</h1>
                    <p class="sbp-subtitle">Review the correction details before returning this application.</p>
                </div>
            </div>

            <button type="button"
                    class="sbp-close"
                    @onclick="ClosePopup"
                    disabled="@IsSubmitting"
                    aria-label="Close">
                <i class="bi bi-x-lg"></i>
            </button>
        </header>

        <div class="sbp-body">
            <section class="sbp-summary-section">
                <div class="sbp-section-heading">Application Summary</div>
                <div class="sbp-summary-grid">
                    <div class="sbp-summary-item">
                        <span class="sbp-summary-label">Dealer</span>
                        <span class="sbp-summary-value">@(Dealer?.FirmName ?? "-")</span>
                    </div>
                    <div class="sbp-summary-item">
                        <span class="sbp-summary-label">Dealer Code</span>
                        <span class="sbp-summary-value">@(Dealer?.DealerCode ?? $"DL-{Dealer?.Id}")</span>
                    </div>
                    <div class="sbp-summary-item">
                        <span class="sbp-summary-label">Action</span>
                        <span class="sbp-summary-value">Send Back</span>
                    </div>
                    <div class="sbp-summary-item">
                        <span class="sbp-summary-label">Send Back To</span>
                        <span class="sbp-summary-value">@GetRoleTargetText()</span>
                    </div>
                </div>
            </section>

            <section class="sbp-warning" aria-label="Send back warning">
                <div class="sbp-warning-icon">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>
                <div>
                    <div class="sbp-warning-title">Application will be returned for correction</div>
                    <p class="sbp-warning-text">
                        This action sends the application back to <strong>@GetRoleTargetText()</strong>.
                        Provide a clear reason and select the sections that need correction before proceeding.
                    </p>
                </div>
            </section>

            <section class="sbp-form-section">
                <div class="sbp-section-title-row">
                    <div>
                        <div class="sbp-section-heading">Reason for Sending Back</div>
                        <div class="sbp-section-help">Give a concise explanation so the reviewer knows what must be corrected.</div>
                    </div>
                    <span class="sbp-required">Required</span>
                </div>

                <textarea class="sbp-textarea"
                          placeholder="Enter the reason for sending this application back..."
                          maxlength="500"
                          rows="4"
                          @bind="Reason"
                          @bind:event="oninput"
                          disabled="@IsSubmitting">
                </textarea>

                <div class="sbp-field-meta">
                    <span></span>
                    <span class="sbp-char-count">@Reason.Length / 500</span>
                </div>
            </section>

            <section class="sbp-form-section">
                <div class="sbp-section-title-row">
                    <div>
                        <div class="sbp-section-heading">Sections Requiring Correction</div>
                        <div class="sbp-section-help">Select one or more sections that need to be updated.</div>
                    </div>
                    <span class="sbp-selection-count">@SelectedSections.Count selected</span>
                </div>

                <div class="sbp-corrections-grid">
                    @foreach (var sec in CorrectionSections)
                    {
                        var isSelected = SelectedSections.Contains(sec);
                        <label class="sbp-correction-card @(isSelected ? "is-selected" : "")">
                            <input type="checkbox"
                                   checked="@isSelected"
                                   @onchange="e => ToggleSection(sec, e)"
                                   disabled="@IsSubmitting" />
                            <span class="sbp-check-visual">
                                <i class="bi bi-check-lg"></i>
                            </span>
                            <span class="sbp-correction-label">@sec</span>
                        </label>
                    }
                </div>
            </section>

            <section class="sbp-form-section">
                <div class="sbp-section-heading">Priority Level</div>
                <div class="sbp-section-help">Choose how urgently the correction should be addressed.</div>

                <div class="sbp-priority-grid">
                    @foreach (var priority in Priorities)
                    {
                        var isSelected = Priority == priority;
                        <label class="sbp-priority-card sbp-priority-@priority.ToLowerInvariant() @(isSelected ? "is-selected" : "")">
                            <input type="radio"
                                   name="priority"
                                   value="@priority"
                                   checked="@isSelected"
                                   @onchange="() => Priority = priority"
                                   disabled="@IsSubmitting" />
                            <span class="sbp-radio-dot"></span>
                            <span class="sbp-priority-copy">
                                <strong>@priority</strong>
                                <small>@GetPriorityDescription(priority)</small>
                            </span>
                        </label>
                    }
                </div>
            </section>

            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="sbp-error" role="alert">
                    <i class="bi bi-exclamation-circle"></i>
                    <span>@ErrorMessage</span>
                </div>
            }

            <section class="sbp-note">
                <div class="sbp-note-icon"><i class="bi bi-info-circle"></i></div>
                <p>
                    The application will be moved back to <strong>@GetRoleTargetText()</strong>.
                    They can make the selected corrections and resubmit it through the existing review flow.
                </p>
            </section>
        </div>

        <footer class="sbp-footer">
            <button type="button"
                    class="sbp-btn sbp-btn-cancel"
                    @onclick="ClosePopup"
                    disabled="@IsSubmitting">
                <i class="bi bi-x-lg"></i>
                Cancel
            </button>

            <button type="button"
                    class="sbp-btn sbp-btn-send"
                    @onclick="RejectDealer"
                    disabled="@IsSubmitting">
                @if (IsSubmitting)
                {
                    <span class="sbp-spinner" aria-hidden="true"></span>
                    <span>Sending...</span>
                }
                else
                {
                    <i class="bi bi-arrow-counterclockwise"></i>
                    <span>@SendBackButtonText()</span>
                }
            </button>
        </footer>
    </div>
</div>

<style>
    .sbp-overlay,
    .sbp-overlay * {
        box-sizing: border-box;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    .sbp-overlay {
        position: fixed;
        inset: 0;
        z-index: 99999;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 18px;
        background: rgba(17, 24, 39, 0.46);
        backdrop-filter: blur(1px);
    }

    .sbp-modal {
        width: min(760px, 100%);
        max-height: min(90vh, 860px);
        display: flex;
        flex-direction: column;
        overflow: hidden;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        box-shadow: 0 24px 70px rgba(17, 24, 39, 0.24);
    }

    .sbp-header {
        flex: 0 0 auto;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        padding: 20px 24px 16px;
        border-bottom: 1px solid #eef0f3;
        background: #ffffff;
    }

    .sbp-header-copy {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        min-width: 0;
    }

    .sbp-header-icon {
        width: 38px;
        height: 38px;
        flex: 0 0 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #fff1f2;
        color: #be123c;
        font-size: 1rem;
    }

    .sbp-title {
        margin: 0;
        color: #1f2937;
        font-size: 1.18rem;
        font-weight: 700;
        line-height: 1.3;
    }

    .sbp-subtitle {
        margin: 4px 0 0;
        color: #6b7280;
        font-size: 0.82rem;
        line-height: 1.45;
    }

    .sbp-close {
        width: 34px;
        height: 34px;
        flex: 0 0 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        border: 1px solid #e5e7eb;
        border-radius: 50%;
        background: #ffffff;
        color: #9ca3af;
        cursor: pointer;
        transition: 0.18s ease;
    }

    .sbp-close:hover:not(:disabled) {
        color: #374151;
        background: #f9fafb;
        border-color: #d1d5db;
    }

    .sbp-body {
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
        overscroll-behavior: contain;
        padding: 18px 24px 20px;
        scrollbar-width: thin;
        scrollbar-color: #cbd5e1 transparent;
    }

    .sbp-body::-webkit-scrollbar { width: 7px; }
    .sbp-body::-webkit-scrollbar-track { background: transparent; }
    .sbp-body::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 999px; }

    .sbp-summary-section,
    .sbp-form-section {
        margin-bottom: 18px;
    }

    .sbp-section-heading {
        color: #374151;
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
