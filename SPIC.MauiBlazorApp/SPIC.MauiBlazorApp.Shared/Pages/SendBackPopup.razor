<div class="backdrop" @onclick="ClosePopup">
    <div class="modal-content" @onclick:stopPropagation>
        <div class="container-fluid px-2 px-sm-3 px-lg-4">
    <div class="main-card mx-auto">
        <div class="p-3 p-sm-3 p-md-4 d-flex flex-column gap-section" style="gap:1rem;">

            <!-- ══ APPLICATION HEADER ══ -->
            <header class="w-100">
                <div class="app-header d-flex align-items-start justify-content-between gap-3">
                    <div class="flex-grow-1 px-1">
                        <h1>Send Back Application</h1>
                        <p>APP-2026-001 - Agro Enterprises Pvt Ltd</p>
                    </div>
                    <button type="button" class="btn-close-custom" aria-label="Close" @onclick="ClosePopup">
                        <i class="bi bi-x" style="font-size:1.25rem;"></i>
                    </button>
                </div>
            </header>

            <!-- ══ CORRECTION DETAILS ══ -->
            <section class="d-flex flex-column gap-section w-100">

                <!-- Red alert banner -->
                <div class="alert-red p-2">
                    <div class="d-flex align-items-start align-items-sm-center gap-2 gap-sm-3">
                        <div class="icon-circle-red">
                            <i class="bi bi-exclamation-circle" style="font-size:0.9rem;color:#bc0000;"></i>
                        </div>
                        <div class="d-flex flex-column gap-0 flex-grow-1">
                            <p class="alert-title-red">This action will send the application back to Marketing Officer (MO)</p>
                            <p class="alert-body">Please provide the reason and select sections that require correction.</p>
                        </div>
                    </div>
                </div>

                <!-- Reason textarea -->
                <div class="d-flex flex-column gap-3 w-100">
                    <div class="d-flex flex-column gap-3">
                        <h3 class="section-title">Reason for sending back</h3>
                        <textarea id="reasonTextarea"
                                  class="reason-textarea"
                                  placeholder="Please provide the reason and select sections that require correction."
                                  maxlength="500"
                                  rows="4"
                                  oninput="updateCount(this)"></textarea>
                    </div>
                    <div class="d-flex justify-content-end w-100">
                        <span class="char-count" id="charCount">0/500</span>
                    </div>
                </div>

                <!-- Correction checkboxes -->
                <div class="d-flex flex-column gap-3 w-100">
                    <h3 class="section-title">What needs to be corrected? (Select all that apply)</h3>
                    <div class="row g-3">

                        <div class="col-12 col-md-6 col-xl-4">
                            <label class="correction-item w-100">
                                <input type="checkbox" checked />
                                <span class="correction-label">Tax &amp; Compliance</span>
                            </label>
                        </div>

                        <div class="col-12 col-md-6 col-xl-4">
                            <label class="correction-item w-100">
                                <input type="checkbox" checked />
                                <span class="correction-label">Ownership Information</span>
                            </label>
                        </div>

                        <div class="col-12 col-md-6 col-xl-4">
                            <label class="correction-item w-100">
                                <input type="checkbox" checked />
                                <span class="correction-label">Loan Liabilities</span>
                            </label>
                        </div>

                        <div class="col-12 col-md-6 col-xl-4">
                            <label class="correction-item w-100">
                                <input type="checkbox" checked />
                                <span class="correction-label">Primary Location</span>
                            </label>
                        </div>

                        <div class="col-12 col-md-6 col-xl-4">
                            <label class="correction-item w-100">
                                <input type="checkbox" />
                                <span class="correction-label">Sales Planning &amp; Forecast</span>
                            </label>
                        </div>

                        <div class="col-12 col-md-6 col-xl-4">
                            <label class="correction-item w-100">
                                <input type="checkbox" />
                                <span class="correction-label">Investment</span>
                            </label>
                        </div>

                        <div class="col-12 col-md-6 col-xl-4">
                            <label class="correction-item w-100">
                                <input type="checkbox" checked />
                                <span class="correction-label">Enclosures</span>
                            </label>
                        </div>

                        <div class="col-12 col-md-6 col-xl-4">
                            <label class="correction-item w-100">
                                <input type="checkbox" />
                                <span class="correction-label">Retail Fertilizer Details</span>
                            </label>
                        </div>

                        <div class="col-12 col-md-6 col-xl-4">
                            <label class="correction-item w-100">
                                <input type="checkbox" />
                                <span class="correction-label">Sales Performance Review</span>
                            </label>
                        </div>

                        <div class="col-12 col-md-6 col-xl-4">
                            <label class="correction-item w-100">
                                <input type="checkbox" />
                                <span class="correction-label">Other (Please specify in remarks)</span>
                            </label>
                        </div>

                    </div>
                </div>

                <!-- Priority level -->
                <div class="d-flex flex-column gap-3 w-100">
                    <h3 class="section-title">Priority Level</h3>
                    <div class="priority-group">
                        <label class="priority-item">
                            <input type="radio" name="priority" value="high" checked />
                            <span class="priority-label">High</span>
                        </label>
                        <label class="priority-item">
                            <input type="radio" name="priority" value="medium" />
                            <span class="priority-label">Medium</span>
                        </label>
                        <label class="priority-item">
                            <input type="radio" name="priority" value="low" />
                            <span class="priority-label">Low</span>
                        </label>
                    </div>
                </div>

                <!-- Yellow info banner -->
                <div class="alert-yellow p-2">
                    <div class="d-flex align-items-start align-items-sm-center gap-2 gap-sm-3">
                        <div class="icon-circle-yellow">
                            <i class="bi bi-info-circle" style="font-size:0.9rem;color:#acbc00;"></i>
                        </div>
                        <div class="d-flex flex-column gap-0 flex-grow-1">
                            <p class="alert-title-yellow">Please Note:</p>
                            <p class="alert-body">The application will be moved back to MO. They will be notified to make the required corrections and resubmit.</p>
                        </div>
                    </div>
                </div>

            </section>

            <!-- ══ FORM ACTIONS ══ -->
            <section class="d-flex justify-content-end w-100">
                <div class="d-flex flex-wrap justify-content-end gap-3">
                    <button type="button" class="btn-cancel" @onclick="ClosePopup">
                        <i class="bi bi-x-lg" style="font-size:1rem;"></i>
                        <span>Cancel</span>
                    </button>
                    <button type="button" class="btn-send-back">
                        <i class="bi bi-send" style="font-size:1rem;"></i>
                        <span>Send Back to MO</span>
                    </button>
                </div>
            </section>

        </div>
    </div>
</div>
</div>
</div>

<style>
    *, *::before, *::after { box-sizing: border-box; }

    .backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.45);
        z-index: 1050;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0.5rem;
        overflow-y: auto;
    }

    .modal-content {
        width: 100%;
        max-width: 800px;
        max-height: 85vh;
        overflow-y: auto;
    }

    /* ── Card wrapper ── */
    .main-card {
      max-width: 780px;
      border-radius: 12px;
      border: 1px solid #e6ece9;
      background: #fff;
      box-shadow: 0 10px 40px rgba(0,0,0,0.15) !important;
    }

    /* ── Header ── */
    .app-header {
      border-bottom: 1px solid #d7d7d7;
      padding-bottom: 0.5rem;
    }
    .app-header h1 {
      font-size: 20px;
      font-weight: 600;
      line-height: 1.8rem;
      letter-spacing: -0.56px;
      color: #47443f;
      margin: 0;
    }
    .app-header p {
      font-size: 0.875rem;
      font-weight: 400;
      color: #364153;
      margin: 0.25rem 0 0;
    }
    .btn-close-custom {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      border: none;
      background: transparent;
      color: #6b6b6b;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      padding: 0;
      cursor: pointer;
      transition: color 0.15s;
    }
    .btn-close-custom:hover { color: #47443f; background: transparent; }

    /* ── Alert cards ── */
    .alert-red, .alert-yellow {
      border-radius: 8px;
      padding: 12px !important;
    }
    .icon-circle-red, .icon-circle-yellow {
      width: 36px;
      height: 36px;
      flex-shrink: 0;
    }
    .icon-circle-red i, .icon-circle-yellow i {
      font-size: 0.9rem !important;
    }
    .alert-title-red, .alert-title-yellow {
      font-size: 14px;
      font-weight: 600;
      line-height: 20px;
      margin: 0;
    }
    .alert-body {
      font-size: 0.75rem;
      font-weight: 500;
      line-height: 1.1rem;
      color: #656565;
      margin: 0.15rem 0 0;
    }

    /* ── Section headings ── */
    .section-title {
      font-size: 0.95rem;
      font-weight: 600;
      line-height: 22px;
      color: #36483d;
      margin: 0 0 0.25rem;
    }

    /* ── Textarea ── */
    .reason-textarea {
      min-height: 100px;
      resize: none;
      border-radius: 8px;
      border: 1px solid #dedede;
      padding: 0.5rem 0.75rem;
      font-family: 'Inter', Helvetica, sans-serif;
      font-size: 0.8rem;
      font-weight: 500;
      line-height: 1.1rem;
      color: #36483d;
      width: 100%;
      outline: none;
      transition: border-color 0.15s;
    }
    .reason-textarea::placeholder { color: #bebcbc; }
    .reason-textarea:focus { border-color: #00a05e; box-shadow: none; }
    .char-count {
      font-size: 0.8rem;
      font-weight: 500;
      line-height: 1rem;
      color: #a0a0a0;
    }

    /* ── Correction checkboxes ── */
    .correction-item {
      display: flex;
      align-items: center;
      gap: 8px;
      border-radius: 8px;
      border: 1px solid #00a05e;
      padding: 0.5rem 0.75rem;
      cursor: pointer;
      min-height: 28px;
      user-select: none;
      transition: background 0.1s;
      font-size: 0.85rem;
    }
    .correction-item:hover { background: #f0faf5; }
    .correction-item input[type="checkbox"] {
      width: 18px;
      height: 18px;
      border-radius: 4px;
      border: none;
      background: rgba(0,0,0,0.05);
      appearance: none;
      -webkit-appearance: none;
      flex-shrink: 0;
      cursor: pointer;
      position: relative;
      transition: background 0.15s;
    }
    .correction-item input[type="checkbox"]:checked {
      background: #006139;
    }
    .correction-item input[type="checkbox"]:checked::after {
      content: '';
      position: absolute;
      left: 5px;
      top: 2px;
      width: 5px;
      height: 9px;
      border: 2px solid #fff;
      border-top: none;
      border-left: none;
      transform: rotate(45deg);
    }
    .correction-label {
      font-size: 0.85rem;
      font-weight: 600;
      line-height: 1.2rem;
      color: #395a45;
    }

    /* ── Priority radio ── */
    .priority-group {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
    }
    .priority-item {
      display: flex;
      align-items: center;
      gap: 8px;
      cursor: pointer;
      user-select: none;
      font-size: 0.85rem;
    }
    .priority-item input[type="radio"] {
      width: 14px;
      height: 14px;
      border: 1.5px solid #4d4d4d;
      border-radius: 50%;
      appearance: none;
      -webkit-appearance: none;
      flex-shrink: 0;
      cursor: pointer;
      position: relative;
      transition: border-color 0.15s;
    }
    .priority-item input[type="radio"]:checked {
      border-color: #c40000;
    }
    .priority-item input[type="radio"]:checked::after {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #c40000;
    }
    .priority-label {
      font-size: 0.85rem;
      font-weight: 600;
      line-height: 1.2rem;
      color: #395a45;
    }

    /* ── Action buttons ── */
    .btn-cancel {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      border-radius: 6px;
      border: 1px solid #656565;
      background: transparent;
      padding: 0.5rem 0.75rem;
      font-size: 0.85rem;
      font-weight: 600;
      line-height: 1.2rem;
      color: #656565;
      cursor: pointer;
      min-height: 36px;
      transition: opacity 0.15s;
      white-space: nowrap;
    }
    .btn-cancel:hover { opacity: 0.8; background: transparent; color: #656565; }

    .btn-send-back {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      border-radius: 6px;
      border: 1px solid #fff;
      background: #da2323;
      padding: 0.5rem 1.25rem;
      font-size: 0.85rem;
      font-weight: 500;
      line-height: 1.2rem;
      color: #fff;
      cursor: pointer;
      min-height: 36px;
      transition: opacity 0.15s;
      white-space: nowrap;
    }
    .btn-send-back:hover { opacity: 0.88; background: #da2323; color: #fff; }

    /* ── Spacing helpers ── */
    .gap-section { gap: 1rem; }
  </style>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private void ClosePopup()
    {
        OnClose.InvokeAsync();
    }
}