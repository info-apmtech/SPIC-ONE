        background: #0f766e;
        color: #ffffff;
    }

    .sbp-correction-label {
        color: #4b5563;
        font-size: 0.77rem;
        font-weight: 500;
        line-height: 1.35;
    }

    .sbp-priority-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 8px;
        margin-top: 9px;
    }

    .sbp-priority-card {
        position: relative;
        display: flex;
        align-items: center;
        gap: 9px;
        min-height: 54px;
        padding: 9px 10px;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        background: #ffffff;
        cursor: pointer;
        transition: .16s ease;
    }

    .sbp-priority-card input[type="radio"] {
        position: absolute;
        opacity: 0;
        pointer-events: none;
    }

    .sbp-radio-dot {
        width: 16px;
        height: 16px;
        flex: 0 0 16px;
        border: 1.5px solid #cbd5e1;
        border-radius: 50%;
        background: #ffffff;
