        background: #fbfdff;
    }

    .sbp-correction-card.is-selected {
        border-color: #99d8c9;
        background: #f2fbf8;
        box-shadow: inset 0 0 0 1px rgba(15, 118, 110, 0.04);
    }

    .sbp-correction-card input[type="checkbox"] {
