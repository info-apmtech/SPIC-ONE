        color: #8a94a3;
        font-size: 0.75rem;
        line-height: 1.45;
    }

    .sbp-summary-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px 22px;
        margin-top: 9px;
        padding: 12px 16px;
