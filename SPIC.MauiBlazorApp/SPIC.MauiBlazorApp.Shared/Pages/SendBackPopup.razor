@using System.Net.Http.Json
@using DR = SPIC.Core.Entities
@inject HttpClient Http

<div class="backdrop" @onclick="ClosePopup" style="position:fixed; top:0; left:0; width:100%; height:100%; display:flex; align-items:center; justify-content:center; z-index:99999; background: rgba(0,0,0,0.55);">
    <div class="modal-content" @onclick:stopPropagation style="max-width: 980px; width: 96%; background:#ffffff; border-radius:8px; max-height:90vh; overflow:auto; box-shadow: 0 10px 30px rgba(0,0,0,0.15); border: 1px solid rgba(0,0,0,0.06);">
        <div class="container-fluid px-2 px-sm-3 px-lg-4">
            <div class="main-card mx-auto">
                <div class="p-3 p-sm-3 p-md-4 d-flex flex-column gap-section">

                    <header class="sb-header">
                        <div class="sb-header-left">
                            <h1 class="sb-title">Send Back Application</h1>
                            <div class="sb-subtitle">@ApplicationText</div>
                        </div>

<style>
/* SendBack popup styles */
.sb-header { display:flex; justify-content:space-between; align-items:flex-start; gap:12px; padding-bottom:8px; }
.sb-title { font-size:1.25rem; margin:0; font-weight:700; }
.sb-subtitle { color:#6b7280; font-size:0.85rem; margin-top:4px; }
.btn-close-custom { background:transparent; border-radius:50%; border:1px solid rgba(0,0,0,0.06); width:36px; height:36px; display:flex; align-items:center; justify-content:center; }
.alert-red{ background:#fff1f2; border:1px solid #fee2e2; border-radius:6px; padding:12px; }
.icon-circle-red{ width:36px; height:36px; border-radius:50%; background:#fee2e2; display:flex; align-items:center; justify-content:center; }
.alert-title-red { font-weight:700; color:#9b1c1c; margin:0 0 6px 0; }
.alert-body { color:#7c2b2b; margin:0; }
.reason-textarea{ width:100%; border:1px solid #e6e6e6; border-radius:6px; padding:12px; min-height:110px; resize:vertical; }
.corrections-grid{ display:grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap:10px; margin-top:8px; }
.correction-item{ display:flex; align-items:center; gap:10px; padding:10px 12px; border:1px solid #a7f3d0; border-radius:8px; background:#f8fffb; }
.correction-item input[type=checkbox]{ width:18px; height:18px; }
.priority-group{ display:flex; gap:12px; align-items:center; margin-top:8px; }
.priority-item input[type=radio]{ margin-right:6px; }
.alert-yellow{ background:#fffbeb; border:1px solid #fef3c7; border-radius:6px; padding:12px; margin-top:12px; }
.btn-cancel{ background:#fff; border:1px solid #e5e7eb; padding:8px 14px; border-radius:6px; }
.btn-send-back{ background:#ef4444; color:#fff; border:none; padding:8px 14px; border-radius:6px; }
.char-count{ color:#6b7280; font-size:0.85rem; }

@@media (max-width: 768px){
    .corrections-grid{ grid-template-columns: repeat(1, 1fr); }
}
</style>

                        <button type="button" class="btn-close-custom" @onclick="ClosePopup" aria-label="Close">
                            <i class="bi bi-x" style="font-size:1.1rem;"></i>
                        </button>
                    </header>

                    <div class="alert-red p-2">
                        <div class="d-flex align-items-start gap-3">
                            <div class="icon-circle-red">
                                <i class="bi bi-exclamation-circle" style="font-size:0.9rem;color:#bc0000;"></i>
                            </div>
                            <div>
                                <p class="alert-title-red">
                                    This action will send the application back to @GetRoleTargetText()
                                </p>
                        <p class="alert-body">
                            Please provide the reason and select sections that require correction.
                        </p>
                            </div>
                        </div>

                    <div class="sb-section">
                        <h3 class="section-title">Reason for sending back</h3>

                        <textarea class="reason-textarea"
                                  placeholder="Please provide the reason."
                                  maxlength="500"
                                  rows="4"
                                  @bind="Reason"
                                  @bind:event="oninput">
                        </textarea>

                        <div class="d-flex justify-content-end">
                            <span class="char-count">@Reason.Length/500</span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                        {
                            <div class="text-danger small mt-2">@ErrorMessage</div>
                        }
                    </div>
                    </div>

                    @* replaced by styled section above *@

                    <div>
                        <h3 class="section-title">What needs to be corrected?</h3>

                        <div class="corrections-grid">
                            @foreach (var sec in CorrectionSections)
                            {
                                <label class="correction-item">
                                    <input type="checkbox"
                                           checked="@SelectedSections.Contains(sec)"
                                           @onchange="e => ToggleSection(sec, e)" />
                                    <span class="correction-label">@sec</span>
                                </label>
                            }
                        </div>
                    </div>

                    <div>
                        <h3 class="section-title">Priority Level</h3>

                        <div class="priority-group">
                            @foreach (var priority in Priorities)
                            {
                                <label class="priority-item" style="font-weight: bold;">
                                    <input type="radio"
                                           name="priority"
                                           value="@priority"
                                           checked="@(Priority == priority)"
                                           @onchange="() => Priority = priority" />
                                    <span class="priority-label">@priority</span>
                                </label>
                            }
                        </div>
                    </div>

                    <div class="alert-yellow p-2">
                        <p class="alert-title-yellow">Please Note:</p>
                        <p class="alert-body">
                            The application will be moved back to @GetRoleTargetText(). They will be notified to make the required corrections and resubmit.
                        </p>
                    </div>

                    <div class="d-flex justify-content-end gap-3">
                        <button type="button" class="btn-cancel" @onclick="ClosePopup" disabled="@IsSubmitting">
                            <i class="bi bi-x-lg"></i>
                            Cancel
                        </button>

                        @* Dynamic label based on role *@
                        <button type="button" class="btn-send-back" @onclick="RejectDealer" disabled="@IsSubmitting">
                            <i class="bi bi-send"></i>
                            @(IsSubmitting ? "Sending..." : SendBackButtonText())
                        </button>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

                            @code {
    [Parameter] public DR.DealerRegistration? Dealer { get; set; } = default!;
[Parameter] public LoginState LoginState { get; set; } = default!;
[Parameter] public EventCallback OnClose { get; set; }
[Parameter] public EventCallback OnRejected { get; set; }

    private string Reason { get; set; } = "";
    private string Priority { get; set; } = "High";
    private bool IsSubmitting { get; set; }
    private string? ErrorMessage { get; set; }

    private HashSet<string> SelectedSections { get; set; } = new();

    private readonly string[] Priorities =
    {
        "High",
        "Medium",
        "Low"
    };

    private readonly List<string> CorrectionSections = new()
    {
        "Tax & Compliance",
        "Ownership Information",
        "Loan Liabilities",
        "Primary Location",
        "Sales Planning & Forecast",
        "Investment",
        "Enclosures",
        "Retail Fertilizer Details",
        "Sales Performance Review",
        "Other"
    };

    private string SendBackButtonText()
    {
        if (LoginState == null) return "Send Back";

        if (LoginState.IsRegionRole)
            return "Send Back to MO";

        if (LoginState.IsStateRole)
            return "Send Back to RM";

        if (LoginState.IsAdmin)
            return "Send Back to SM";

        return "Send Back";
    }

    private string ApplicationText =>
    Dealer == null
        ? "Dealer Application"
        : $"{Dealer.DealerCode ?? $"DL-{Dealer.Id}"} - {Dealer.FirmName ?? "Dealer Application"}";

    protected override void OnInitialized()
    {
        SelectedSections = new HashSet<string>
        {
            "Tax & Compliance",
            "Ownership Information",
            "Loan Liabilities",
            "Primary Location",
            "Enclosures"
        };
    }

    private void ToggleSection(string section, ChangeEventArgs e)
    {
        var isChecked = e.Value as bool? ?? false;

        if (isChecked)
            SelectedSections.Add(section);
        else
            SelectedSections.Remove(section);
    }

    private async Task RejectDealer()
    {
        ErrorMessage = null;

        if (string.IsNullOrWhiteSpace(Reason))
        {
            ErrorMessage = "Reason is required.";
            return;
        }

        if (!SelectedSections.Any())
        {
            ErrorMessage = "Please select at least one correction section.";
            return;
        }

        IsSubmitting = true;

        try
        {
            var request = new DealerSendBackRequest
            {
                DealerId = Dealer.Id,
                Reason = Reason.Trim(),
                Priority = Priority,
                Sections = SelectedSections.ToList(),
                TargetRole = GetTargetRoleCode()
            };

            var sendBackResponse = await Http.PostAsJsonAsync(
                $"api/DealerRegistration/{Dealer.Id}/send-back",
                request
            );

            if (!sendBackResponse.IsSuccessStatusCode)
            {
                ErrorMessage = "Unable to send back dealer application.";
                return;
            }

            // Local state update, same style as approve process
            if (LoginState.IsRegionRole)
            {
                Dealer.RMApproved = false;
            }
            else if (LoginState.IsStateRole)
            {
                Dealer.SMApproved = false;
            }
            else if (LoginState.IsAdmin)
            {
                Dealer.AVPApproved = false;
            }

            // Change this status name according to your enum
            // Dealer.Status = DR.DealerStatus.SentBack;

            var updateResponse = await Http.PutAsJsonAsync(
                $"api/DealerRegistration/{Dealer.Id}",
                Dealer
            );

            if (updateResponse.IsSuccessStatusCode)
            {
                await OnRejected.InvokeAsync();
            }
            else
            {
                ErrorMessage = "Send back saved, but dealer status update failed.";
            }
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private async Task ClosePopup()
    {
        await OnClose.InvokeAsync();
    }

    private string GetRoleTargetText()
    {
        if (LoginState == null) return "the previous role";

        if (LoginState.IsRegionRole)
            return "Marketing Officer (MO)";

        if (LoginState.IsStateRole)
            return "Regional Manager (RM)";

        if (LoginState.IsAdmin)
            return "State Manager (SM)";

        return "the previous role";
    }

    private string? GetTargetRoleCode()
    {
        if (LoginState == null) return null;

        if (LoginState.IsRegionRole)
            return "MO";

        if (LoginState.IsStateRole)
            return "RM";

        if (LoginState.IsAdmin)
            return "SM";

        return null;
    }

    public class DealerSendBackRequest
    {
        public int DealerId { get; set; }
        public string Reason { get; set; } = "";
        public string Priority { get; set; } = "High";
        public List<string> Sections { get; set; } = new();
        public string? TargetRole { get; set; }
    }
