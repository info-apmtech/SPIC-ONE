    .sbp-note {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 10px 12px;
        border: 1px solid #dbeafe;
        border-radius: 8px;
        background: #f7fbff;
    }

    .sbp-note-icon {
        color: #3b82f6;
        font-size: 0.86rem;
        line-height: 1.3;
    }

    .sbp-note p {
        margin: 0;
        color: #64748b;
        font-size: 0.73rem;
        line-height: 1.5;
    }

    .sbp-footer {
        flex: 0 0 auto;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        padding: 12px 24px 16px;
        border-top: 1px solid #eef0f3;
        background: #ffffff;
        box-shadow: 0 -8px 18px rgba(15, 23, 42, 0.025);
    }

    .sbp-btn {
        min-height: 40px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 8px 17px;
        border-radius: 7px;
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
        transition: .18s ease;
    }

    .sbp-btn:disabled,
    .sbp-close:disabled {
        opacity: 0.62;
        cursor: not-allowed;
    }

    .sbp-btn-cancel {
        border: 1px solid #d1d5db;
        background: #ffffff;
        color: #4b5563;
    }

    .sbp-btn-cancel:hover:not(:disabled) {
        background: #f9fafb;
        color: #1f2937;
    }

    .sbp-btn-send {
        border: 1px solid #be123c;
        background: #be123c;
        color: #ffffff;
        box-shadow: 0 1px 2px rgba(190, 18, 60, 0.14);
    }

    .sbp-btn-send:hover:not(:disabled) {
        border-color: #9f1239;
        background: #9f1239;
    }

    .sbp-spinner {
        width: 14px;
        height: 14px;
        border: 2px solid rgba(255,255,255,.38);
        border-top-color: #ffffff;
        border-radius: 50%;
        animation: sbp-spin .7s linear infinite;
    }

    @@keyframes sbp-spin {
        to { transform: rotate(360deg); }
    }

    @@media (max-width: 640px) {
        .sbp-overlay { padding: 10px; }
        .sbp-modal { max-height: 94vh; border-radius: 11px; }
        .sbp-header { padding: 16px 16px 13px; }
        .sbp-body { padding: 15px 16px 18px; }
        .sbp-footer { padding: 11px 16px 14px; }
        .sbp-summary-grid,
        .sbp-corrections-grid,
        .sbp-priority-grid { grid-template-columns: 1fr; }
        .sbp-summary-label { flex-basis: 90px; }
        .sbp-btn { flex: 1; padding-left: 10px; padding-right: 10px; }
    }
</style>

@code {
    [Parameter] public DR.DealerRegistration? Dealer { get; set; } = default!;
    [Parameter] public LoginState LoginState { get; set; } = default!;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnRejected { get; set; }

    private string Reason { get; set; } = "";
    private string Priority { get; set; } = "High";
    private bool IsSubmitting { get; set; }
    private string? ErrorMessage { get; set; }

    private HashSet<string> SelectedSections { get; set; } = new();

    private readonly string[] Priorities =
    {
        "High",
        "Medium",
        "Low"
    };

    private readonly List<string> CorrectionSections = new()
    {
        "Tax & Compliance",
        "Ownership Information",
        "Loan Liabilities",
        "Primary Location",
        "Sales Planning & Forecast",
        "Investment",
        "Enclosures",
        "Retail Fertilizer Details",
        "Sales Performance Review",
        "Other"
    };

    private string SendBackButtonText()
    {
        if (LoginState == null) return "Send Back";

        if (LoginState.IsRegionRole)
            return "Send Back to MO";

        if (LoginState.IsStateRole)
            return "Send Back to RM";

        if (LoginState.IsAdmin)
            return "Send Back to SM";

        return "Send Back";
    }

    private string ApplicationText =>
        Dealer == null
            ? "Dealer Application"
            : $"{Dealer.DealerCode ?? $"DL-{Dealer.Id}"} - {Dealer.FirmName ?? "Dealer Application"}";

    protected override void OnInitialized()
    {
        SelectedSections = new HashSet<string>
        {
            "Tax & Compliance",
            "Ownership Information",
            "Loan Liabilities",
            "Primary Location",
            "Enclosures"
        };
    }

    private void ToggleSection(string section, ChangeEventArgs e)
    {
        var isChecked = e.Value as bool? ?? false;

        if (isChecked)
            SelectedSections.Add(section);
        else
            SelectedSections.Remove(section);
    }

    private async Task RejectDealer()
    {
        ErrorMessage = null;

        if (string.IsNullOrWhiteSpace(Reason))
        {
            ErrorMessage = "Reason is required.";
            return;
        }

        if (!SelectedSections.Any())
        {
            ErrorMessage = "Please select at least one correction section.";
            return;
        }

        IsSubmitting = true;

        try
        {
            var request = new DealerSendBackRequest
            {
                DealerId = Dealer.Id,
                Reason = Reason.Trim(),
                Priority = Priority,
                Sections = SelectedSections.ToList(),
                TargetRole = GetTargetRoleCode()
            };

            var sendBackResponse = await Http.PostAsJsonAsync(
                $"api/DealerRegistration/{Dealer.Id}/send-back",
                request
            );

            if (!sendBackResponse.IsSuccessStatusCode)
            {
                ErrorMessage = "Unable to send back dealer application.";
                return;
            }

            // Local state update, same style as approve process
            if (LoginState.IsRegionRole)
            {
                Dealer.RMApproved = false;
            }
            else if (LoginState.IsStateRole)
            {
                Dealer.SMApproved = false;
            }
            else if (LoginState.IsAdmin)
            {
                Dealer.AVPApproved = false;
            }

            // Change this status name according to your enum
            // Dealer.Status = DR.DealerStatus.SentBack;

            var updateResponse = await Http.PutAsJsonAsync(
                $"api/DealerRegistration/{Dealer.Id}",
                Dealer
            );

            if (updateResponse.IsSuccessStatusCode)
            {
                await OnRejected.InvokeAsync();
            }
            else
            {
                ErrorMessage = "Send back saved, but dealer status update failed.";
            }
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private async Task ClosePopup()
    {
        await OnClose.InvokeAsync();
    }

    private string GetRoleTargetText()
    {
        if (LoginState == null) return "the previous role";

        if (LoginState.IsRegionRole)
            return "Marketing Officer (MO)";

        if (LoginState.IsStateRole)
            return "Regional Manager (RM)";

        if (LoginState.IsAdmin)
            return "State Manager (SM)";

        return "the previous role";
    }

    private string? GetTargetRoleCode()
    {
        if (LoginState == null) return null;

        if (LoginState.IsRegionRole)
            return "MO";

        if (LoginState.IsStateRole)
            return "RM";

        if (LoginState.IsAdmin)
            return "SM";

        return null;
    }

    private static string GetPriorityDescription(string priority) => priority switch
    {
        "High" => "Needs prompt correction",
        "Medium" => "Standard follow-up",
        "Low" => "Minor correction",
        _ => "Correction priority"
    };

    public class DealerSendBackRequest
    {
        public int DealerId { get; set; }
        public string Reason { get; set; } = "";
        public string Priority { get; set; } = "High";
        public List<string> Sections { get; set; } = new();
        public string? TargetRole { get; set; }
    }
}
