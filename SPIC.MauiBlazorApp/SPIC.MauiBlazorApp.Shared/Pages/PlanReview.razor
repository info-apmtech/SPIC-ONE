@page "/PlanReview"
@inject NavigationManager Nav
@inject HttpClient Http
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components

<PageTitle>Review &amp; Confirm Plan · SPIC ONE</PageTitle>

<style>
    /* Saved invoice statuses; visual styles do not affect the matching logic. */
    .pr-invoice-state {
        display: inline-block;
        padding: 3px 9px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
        line-height: 1.5;
        white-space: nowrap;
    }

    .pr-invoice-state-old {
        color: #526175;
        background: #ecf0f5;
        border: 1px solid #d6dfea;
    }

    .pr-invoice-state-new {
        color: #096d43;
        background: #e9f7ef;
        border: 1px solid #b9e8cb;
    }
    /* Plan Review animated cards: scoped to the new comparison grid. */
    .pr-wrapper .pr-compare-grid {
        display: grid;
        grid-template-columns: repeat(4,minmax(0,1fr));
        gap: 12px;
        margin-top: 12px;
    }

        .pr-wrapper .pr-compare-grid > .pr-tile {
            min-width: 0;
            position: relative;
            overflow: hidden;
            border-radius: 12px;
            box-shadow: 0 3px 9px rgba(18,42,74,.05);
            border: 1px solid rgba(115,136,166,.15);
            padding: 14px 15px;
            transition: transform .24s ease,box-shadow .24s ease,border-color .24s ease;
            animation: prCardIn .52s cubic-bezier(.2,.8,.2,1) both;
        }

            .pr-wrapper .pr-compare-grid > .pr-tile:hover {
                transform: translateY(-4px);
                box-shadow: 0 12px 24px rgba(18,42,74,.12);
                border-color: rgba(115,136,166,.3);
            }

            .pr-wrapper .pr-compare-grid > .pr-tile::before {
                content: "";
                position: absolute;
                left: 0;
                right: 0;
                top: 0;
                height: 3px;
                background: var(--pr-accent,#286be3);
            }

            .pr-wrapper .pr-compare-grid > .pr-tile:nth-child(1) {
                --pr-accent: #7951e5;
                animation-delay: 0ms
            }

            .pr-wrapper .pr-compare-grid > .pr-tile:nth-child(2) {
                --pr-accent: #13815b;
                animation-delay: 75ms
            }

            .pr-wrapper .pr-compare-grid > .pr-tile:nth-child(3) {
                --pr-accent: #286be3;
                animation-delay: 150ms
            }

            .pr-wrapper .pr-compare-grid > .pr-tile:nth-child(4) {
                --pr-accent: #e16c45;
                animation-delay: 225ms
            }

            .pr-wrapper .pr-compare-grid > .pr-tile:nth-child(5) {
                --pr-accent: #286be3;
                animation-delay: 300ms
            }

            .pr-wrapper .pr-compare-grid > .pr-tile:nth-child(6) {
                --pr-accent: #286be3;
                animation-delay: 375ms
            }

            .pr-wrapper .pr-compare-grid > .pr-tile:nth-child(7) {
                --pr-accent: #13815b;
                animation-delay: 450ms
            }

            .pr-wrapper .pr-compare-grid > .pr-tile:nth-child(8) {
                --pr-accent: #286be3;
                animation-delay: 525ms
            }

        .pr-wrapper .pr-compare-grid .pr-tile-value {
            display: block;
            font-variant-numeric: tabular-nums
        }

    .pr-wrapper .pr-compact-summary-head {
        margin-top: 20px;
        padding-top: 15px;
        border-top: 1px solid rgba(115,136,166,.17);
    }

        .pr-wrapper .pr-compact-summary-head .pr-card-title {
            margin: 0;
            font-size: 15px;
        }

    .pr-wrapper .pr-compare-grid .pr-tile-value {
        font-size: clamp(18px,1.8vw,23px);
        line-height: 1.35;
    }

    .pr-wrapper .pr-compare-grid .pr-tile-sub {
        font-size: 11px;
        line-height: 1.45;
    }

    .pr-wrapper .pr-compare-progress {
        height: 7px;
        width: 100%;
        border-radius: 99px;
        overflow: hidden;
        background: rgba(40,107,227,.13);
        margin-top: 12px
    }

    .pr-wrapper .pr-compare-progress-fill {
        height: 100%;
        display: block;
        border-radius: inherit;
        background: linear-gradient(90deg,#316fe8,#32b4d6);
        transform-origin: left center;
        animation: prBarIn 1.1s cubic-bezier(.2,.8,.2,1) .5s both;
        transition: width .6s ease
    }

    .pr-wrapper .pr-compare-dot {
        display: inline-block;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #18a46d;
        margin-right: 8px;
        vertical-align: middle;
        box-shadow: 0 0 0 3px rgba(24,164,109,.13)
    }

    .pr-wrapper .pr-compare-status:not(.pr-tile-green) .pr-compare-dot {
        background: #cc7654;
        box-shadow: none
    }
    /* Status cards: same prominent title, tinted background and clear explanation. */
    .pr-wrapper .pr-compare-grid > .pr-compare-status {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: flex-start;
        min-height: 124px;
    }

        .pr-wrapper .pr-compare-grid > .pr-compare-status .pr-label {
            font-weight: 500;
            color: #27364a;
            margin-bottom: 5px;
        }

        .pr-wrapper .pr-compare-grid > .pr-compare-status .pr-tile-value {
            font-weight: 750;
            font-size: clamp(20px,2vw,25px);
            line-height: 1.2;
            margin-bottom: 8px;
        }

        .pr-wrapper .pr-compare-grid > .pr-compare-status .pr-tile-sub {
            font-size: 11px;
            line-height: 1.45;
            color: #253047;
        }

        .pr-wrapper .pr-compare-grid > .pr-compare-status.pr-tile-red {
            background: #fff2f2;
            border-color: #ffdcdc;
            --pr-accent: #ec4545;
        }

            .pr-wrapper .pr-compare-grid > .pr-compare-status.pr-tile-red .pr-tile-value {
                color: #df2525;
            }

        .pr-wrapper .pr-compare-grid > .pr-compare-status.pr-tile-green {
            background: #eef7f1;
            border-color: #d9eae0;
            --pr-accent: #148452;
        }

            .pr-wrapper .pr-compare-grid > .pr-compare-status.pr-tile-green .pr-tile-value {
                color: #087745;
            }

        .pr-wrapper .pr-compare-grid > .pr-compare-status.pr-tile-blue {
            background: #eef4ff;
            border-color: #dbe6ff;
            --pr-accent: #286be3;
        }

            .pr-wrapper .pr-compare-grid > .pr-compare-status.pr-tile-blue .pr-tile-value {
                color: #245ee3;
            }

        .pr-wrapper .pr-compare-grid > .pr-compare-status.pr-tile-orange {
            background: #fff7ef;
            border-color: #fbe2cc;
            --pr-accent: #d88a29;
        }

            .pr-wrapper .pr-compare-grid > .pr-compare-status.pr-tile-orange .pr-tile-value {
                color: #a76a19;
            }

    @@keyframes prCardIn {
        from {
            opacity: 0;
            transform: translateY(14px)
        }

        to {
            opacity: 1;
            transform: translateY(0)
        }
    }

    @@keyframes prBarIn {
        from {
            transform: scaleX(0)
        }

        to {
            transform: scaleX(1)
        }
    }

    @@media(max-width:1200px) {
        .pr-wrapper .pr-compare-grid {
            grid-template-columns: repeat(3,minmax(0,1fr))
        }
    }

    @@media(max-width:768px) {
        .pr-wrapper .pr-compare-grid {
            grid-template-columns: repeat(2,minmax(0,1fr))
        }
    }

    @@media(max-width:480px) {
        .pr-wrapper .pr-compare-grid {
            grid-template-columns: minmax(0,1fr)
        }
    }

    @@media(prefers-reduced-motion:reduce) {
        .pr-wrapper .pr-compare-grid > .pr-tile, .pr-wrapper .pr-compare-progress-fill {
            animation: none !important;
            transition: none !important
        }

            .pr-wrapper .pr-compare-grid > .pr-tile:hover {
                transform: none
            }
    }
</style>

<div class="container-fluid py-4 px-0">
    <div class="pr-wrapper">

        <!-- Header -->
        <div class="pr-header">
            <h1>Review &amp; Confirm Plan</h1>
            <p>Review all details before submitting the plan for approval</p>
        </div>

        <SalesAuditStepper CurrentStep="4" CSR2Id="@CSR2Id" />

        <!-- Info banner -->
        <div class="pr-banner">
            <SalesAuditIcon Name="info" Size="16" />
            <span>Review the approved CSR-2 program, saved Sales Plan and dealer mapping data. Additional budget is the saved amount; MD approval is not independently verified.</span>
        </div>

        @if (IsLoading)
        {
            <div class="alert alert-info">Loading plan review...</div>
        }
        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <div class="alert alert-danger">@Error</div>
        }
        @if (!string.IsNullOrWhiteSpace(Success))
        {
            <div class="alert alert-success">@Success</div>
        }
        @if (IsLoaded)
        {
            <!-- Program summary strip -->
            <div class="pr-card pr-summary">
                <div class="pr-summary-item">
                    <div class="pr-summary-icon pr-tone-green"><SalesAuditIcon Name="users" Size="22" StrokeWidth="1.6" /></div>
                    <div class="pr-summary-text">
                        <span class="pr-label">Program Type</span>
                        <span class="pr-summary-value">@Display(Overview?.ProgramType)</span>
                    </div>
                </div>
                <div class="pr-summary-item">
                    <div class="pr-summary-icon pr-tone-purple"><SalesAuditIcon Name="clipboard" Size="22" StrokeWidth="1.6" /></div>
                    <div class="pr-summary-text">
                        <span class="pr-label">Program Name</span>
                        <span class="pr-summary-value">@Display(Overview?.ProgramName)</span>
                    </div>
                </div>
                <div class="pr-summary-item">
                    <div class="pr-summary-icon pr-tone-blue"><SalesAuditIcon Name="stamp" Size="22" StrokeWidth="1.6" /></div>
                    <div class="pr-summary-text">
                        <span class="pr-label">
                            Scheme Period
                            @if (!IsConfirmed)
                            {
                                <button type="button" class="pr-inline-edit" aria-label="Edit scheme period" title="Edit scheme period" @onclick="EditSalesPlan">
                                    <SalesAuditIcon Name="pencil" Size="13" />
                                </button>
                            }
                        </span>
                        <span class="pr-summary-value">@DateText(SchemeFrom) - @DateText(SchemeTo)</span>
                    </div>
                </div>
                <div class="pr-summary-item">
                    <div class="pr-summary-icon pr-tone-green"><SalesAuditIcon Name="badge-check" Size="22" StrokeWidth="1.6" /></div>
                    <div class="pr-summary-text">
                        <span class="pr-label">Scheme Duration</span>
                        <span class="pr-summary-value pr-green">@DurationText</span>
                    </div>
                </div>
            </div>

            <!-- Program Information -->
            <div class="pr-card">
                <h3 class="pr-card-title">Program Information</h3>

                <div class="pr-info-grid">
                    @foreach (var info in ProgramInfo)
                    {
                        <div class="pr-info-item">
                            <SalesAuditIcon Name="@info.Icon" Size="20" StrokeWidth="1.5" CssClass="pr-info-icon" />
                            <div class="pr-info-text">
                                <span class="pr-label">@info.Label</span>
                                @if (info.IsBadge)
                                {
                                    <span class="pr-status-pill">@info.Value</span>
                                }
                                else
                                {
                                    <span class="pr-info-value">@info.Value</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Budget Details -->
            <div class="pr-card">
                <div class="pr-card-top">
                    <h3 class="pr-card-title">Budget Details</h3>
                    <span class="pr-ratio-pill">₹ 1.00 Cr Turnover for every ₹1.50 Lakh Budget</span>
                </div>

                <div class="pr-grid-4">
                    <div class="pr-tile pr-tile-white">
                        <span class="pr-label">CSR1 Approved Budget</span>
                        <span class="pr-tile-value pr-green">@SalesAuditFormat.Rupees(Csr1Budget)</span>
                        <span class="pr-tile-sub">From CSR1</span>
                    </div>
                    <div class="pr-tile pr-tile-white">
                        <span class="pr-label">Additional Approved Budget</span>
                        <span class="pr-tile-value pr-green">@SalesAuditFormat.Rupees(AdditionalBudget)</span>
                        <span class="pr-tile-sub">Saved amount (MD approval unverified)</span>
                    </div>
                    <div class="pr-tile pr-tile-green">
                        <span class="pr-label">Total Approved Budget</span>
                        <span class="pr-tile-value pr-green">@SalesAuditFormat.Rupees(Csr1Budget + AdditionalBudget)</span>
                        <span class="pr-tile-sub">CSR1 + saved additional amount</span>
                    </div>
                    <div class="pr-tile pr-tile-purple">
                        <span class="pr-label">Required Turnover</span>
                        <span class="pr-tile-value">@SalesAuditFormat.Crore(RequiredTurnover) Cr</span>
                        <span class="pr-tile-sub">Required Turnover is auto-calculated</span>
                    </div>
                </div>
            </div>

            <!-- Product-wise Sales Plan & Summary -->
            <div class="pr-card">
                <div class="pr-card-top">
                    <h3 class="pr-card-title">Product - wise Sales Plan &amp; Summary</h3>
                    @if (!IsConfirmed)
                    {
                        <button type="button" class="pr-edit-btn" @onclick="EditSalesPlan">
                            <SalesAuditIcon Name="pencil" Size="15" />
                            Edit Sales Plan
                        </button>
                    }
                </div>

                <div class="pr-table-wrapper">
                    <table class="pr-table">
                        <thead>
                            <tr>
                                <th class="pr-col-no">S:NO</th>
                                <th>Product</th>
                                <th>Unit</th>
                                <th>Planned Quantity</th>
                                <th>Planned Value (₹)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var (row, index) in PlanRows.Select((r, i) => (r, i)))
                            {
                                <tr>
                                    <td class="pr-col-no">@(index + 1)</td>
                                    <td>@row.Product</td>
                                    <td>@row.Unit</td>
                                    <td>@SalesAuditFormat.Indian(row.Quantity)</td>
                                    <td>@SalesAuditFormat.Rupees(row.Value)</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3" class="pr-total-label">TOTAL PLANNED COMMITMENT (sum)</td>
                                <td class="pr-total-value">@SalesAuditFormat.Indian(PlanRows.Sum(r => r.Quantity)) MT</td>
                                <td class="pr-total-value">@SalesAuditFormat.Rupees(PlanTotal)</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

            </div>

            <!-- Read-only SAP matches: exactly the same API used in Dealer Mapping (Step 3). -->
            <div class="pr-card">
                <div class="pr-card-top">
                    <h3 class="pr-card-title">Matched Dealer Invoice Details</h3>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <button type="button" class="pr-edit-btn" disabled="@(IsLoadingSapSales || IsSavingInvoices)"
                                @onclick="LoadMatchedSapSalesAsync">
                            @(IsLoadingSapSales ? "Loading..." : "Refresh Sales")
                        </button>
                        <button type="button" class="pr-edit-btn"
                                disabled="@(!CanSaveDailySales)"
                                @onclick="() => OpenDialog(DialogState.DailyConfirm)"
                                title="Persist currently matched SAP invoices to Sales Audit using the server-side matching rules">
                            <SalesAuditIcon Name="save" Size="15" />
                            @(IsSavingInvoices ? "Saving Invoices..." : "Save Sales Progress")
                        </button>
                    </div>
                </div>
                @if (IsLoadingSapSales)
                {
                    <div class="alert alert-info">Loading SAP invoice records matched in Dealer Mapping...</div>
                }
                @if (IsLoaded && IsConfirmed && !IsAuditCompleted && !IsLoadingSapSales && MatchedSapSales is not null)
                {
                    <div class="alert alert-info py-2" role="status">
                        <strong>Sales Plan already confirmed.</strong> Confirmation is required only once.
                        @if (NewInvoiceCount > 0)
                        {
                            <span> @NewInvoiceCount new invoice line(s) are ready. Click <strong>Save Daily Sales</strong> or <strong>Save Sales Progress</strong> to add them to the cumulative achievement.</span>
                        }
                        else
                        {
                            <span> No new invoices are available. Upload the next day's SAP sales and click <strong>Refresh Sales</strong>; already saved invoices will remain visible as Old.</span>
                        }
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(SapSalesError))
                {
                    <div class="alert alert-warning" role="alert">@SapSalesError</div>
                }
                @if (!string.IsNullOrWhiteSpace(InvoiceSaveError))
                {
                    <div class="alert alert-danger" role="alert">@InvoiceSaveError</div>
                }
                @if (!string.IsNullOrWhiteSpace(InvoiceSaveSuccess))
                {
                    <div class="alert alert-success" role="status">@InvoiceSaveSuccess</div>
                }
                @if (MatchedSapSales is not null)
                {
                    <p class="text-muted small mb-3">
                        Scheme: @MatchedSapSales.SchemeFrom.ToString("dd MMM yyyy") to @MatchedSapSales.SchemeTo.ToString("dd MMM yyyy")
                        &nbsp; | &nbsp; Mapped dealers: <strong>@MatchedSapSales.MappedDealers</strong>
                        &nbsp; | &nbsp; Matched lines: <strong>@MatchedSapSales.MatchedInvoiceLines</strong>
                        &nbsp; | &nbsp; Old: <strong>@MatchedSapSales.OldInvoiceLines</strong>
                        &nbsp; | &nbsp; New: <strong>@MatchedSapSales.NewInvoiceLines</strong>
                        &nbsp; | &nbsp; New gross: <strong>@SalesAuditFormat.Rupees(MatchedSapSales.NewInvoiceGrossRs)</strong>
                    </p>
                    <div class="pr-table-wrapper">
                        <table class="pr-table">
                            <thead>
                                <tr>
                                    <th class="pr-col-no">S:NO</th>
                                    <th>Dealer Code</th>
                                    <th>Dealer Name</th>
                                    <th>Billing Date</th>
                                    <th>Billing Document</th>
                                    <th>Product Code</th>
                                    <th>Product</th>
                                    <th>Qty (MT)</th>
                                    <th>Gross Amount (₹)</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var (sale, index) in MatchedSapSales.Rows.Select((r, i) => (r, i)))
                                {
                                    <tr>
                                        <td class="pr-col-no">@(index + 1)</td>
                                        <td>@sale.DealerCode</td>
                                        <td>@sale.DealerName</td>
                                        <td>@sale.BillingDate.ToString("dd MMM yyyy")</td>
                                        <td>@sale.BillingDocument</td>
                                        <td>@sale.ProductCode</td>
                                        <td>@sale.ProductName</td>
                                        <td>@SalesAuditFormat.Indian(sale.QuantityMT)</td>
                                        <td>@SalesAuditFormat.Rupees(sale.GrossAmountRs)</td>
                                        <td><span class="pr-invoice-state @(sale.IsSaved ? "pr-invoice-state-old" : "pr-invoice-state-new")">@(sale.IsSaved ? "Old" : "New")</span></td>
                                    </tr>
                                }
                                @if (MatchedSapSales.Rows.Count == 0)
                                {
                                    <tr><td colspan="10" class="text-center text-muted py-3">No eligible SAP invoice lines were found for these dealers, products and scheme dates.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (MatchedSapSales.UnmatchedSapProductNames.Count > 0)
                    {
                        <p class="text-muted small mt-2 mb-0">SAP products excluded because no unambiguous planned-product name matched: @string.Join(", ", MatchedSapSales.UnmatchedSapProductNames)</p>
                    }
                    <p class="text-muted small mt-2 mb-0">
                        Old = already linked to this CSR-2 and included in cumulative saved achievement. New = not yet saved. Click Save Sales Progress to save New invoice IDs; their status changes to Old after saving. Old invoices are never counted twice.
                        @MatchedSapSales.ExcludedOutsideDates invoice lines were outside the scheme period;
                        @MatchedSapSales.ExcludedDifferentUnits had a unit other than MT.
                    </p>
                }
            </div>


            <!-- Consolidated achievement summary follows the matched SAP invoices -->
            <div class="pr-card">
                <div class="pr-card-top pr-compact-summary-head">
                    <h4 class="pr-card-title">Sales Achievement &amp; Dealer Allocation</h4>
                    @if (!IsConfirmed)
                    {
                        <button type="button" class="pr-edit-btn" @onclick="EditDealerMapping">
                            <SalesAuditIcon Name="pencil" Size="15" />
                            Edit Dealer Mapping
                        </button>
                    }
                </div>
                <div class="pr-compare-grid" aria-label="Plan Summary and Comparison">
                    <!-- 1. Required Turnover -->
                    <div class="pr-tile pr-tile-purple">
                        <span class="pr-label">Required Turnover</span>
                        <span class="pr-tile-value">₹ @((RequiredTurnover / 10_000_000m).ToString("0.000")) Cr</span>
                        <span class="pr-tile-sub">Minimum target you must achieve</span>
                    </div>
                    <!-- 2. Product Plan Total -->
                    <div class="pr-tile pr-tile-green">
                        <span class="pr-label">Product Plan Total (Tab 2)</span>
                        <span class="pr-tile-value pr-green">₹ @((PlanTotal / 10_000_000m).ToString("0.000")) Cr</span>
                        <span class="pr-tile-sub">Sum of product-wise planned values</span>
                    </div>
                    <!-- 3. Achievement Amount: matched invoice detail gross totals -->
                    <div class="pr-tile pr-tile-blue">
                        <span class="pr-label">Achievement Amount</span>
                        <span class="pr-tile-value">@(Overview is null ? "--" : $"₹ {AchievementAmount / 10_000_000m:0.000} Cr")</span>
                        <span class="pr-tile-sub">@(Overview is null ? "Saved achievement unavailable" : $"Saved exact: {SalesAuditFormat.Rupees(AchievementAmount)} · New pending: {SalesAuditFormat.Rupees(NewInvoiceAmount)}")</span>
                    </div>
                    <!-- 4. Difference: achieved sales minus required turnover -->
                    <div class="pr-tile @(Overview is not null && AchievementDifference >= 0 ? "pr-tile-green" : "pr-tile-red")">
                        <span class="pr-label">Difference</span>
                        <span class="pr-tile-value">@(Overview is null ? "--" : $"{(AchievementDifference >= 0 ? "+" : "-")} ₹ {Math.Abs(AchievementDifference) / 10_000_000m:0.000} Cr")</span>
                        <span class="pr-tile-sub">@(Overview is null ? "Saved achievement unavailable" : AchievementDifference >= 0 ? "Above required turnover" : "Below required turnover")</span>
                    </div>
                    <!-- 5. Progress %: achieved sales against required turnover -->
                    <div class="pr-tile @(AchievementProgress >= 100m ? "pr-tile-green" : "pr-tile-blue")">
                        <span class="pr-label">Progress %</span>
                        <span class="pr-tile-value">@(Overview is null || RequiredTurnover <= 0 ? "--" : $"{AchievementProgress:0.00}%")</span>
                        <span class="pr-tile-sub">Achievement against required turnover</span>
                        <div class="pr-compare-progress" role="progressbar" aria-label="Achievement progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@Math.Clamp(AchievementProgress, 0m, 100m).ToString(System.Globalization.CultureInfo.InvariantCulture)">
                            <span class="pr-compare-progress-fill" style="width:@(Overview is null ? "0" : Math.Clamp(AchievementProgress, 0m, 100m).ToString(System.Globalization.CultureInfo.InvariantCulture))%"></span>
                        </div>
                    </div>
                    <!-- 6. Mapped Dealers -->
                    <div class="pr-tile pr-tile-blue">
                        <span class="pr-label">Mapped Dealers</span>
                        <span class="pr-tile-value">@MappedDealerCount</span>
                        <span class="pr-tile-sub">Dealer registrations mapped to this CSR-2</span>
                    </div>
                    <!-- 7. Requirement Status: same status-card design as reference -->
                    <div class="pr-tile pr-compare-status @(PlanDifference >= 0 ? "pr-tile-green" : "pr-tile-red")">
                        <span class="pr-label">Requirement Status</span>
                        <span class="pr-tile-value pr-status">@(PlanDifference >= 0 ? "Met" : "Not Met")</span>
                        <span class="pr-tile-sub">
                            @(PlanDifference >= 0
                                ? "Planned Commitment meets the Required TO"
                                : "Planned Commitment is below the Required TO")
                        </span>
                    </div>
                    <!-- 8. Audit Status: real server workflow status, styled like Requirement Status -->
                    <div class="pr-tile pr-compare-status @AuditStatusTileClass">
                        <span class="pr-label">Audit Status</span>
                        <span class="pr-tile-value pr-status">@AuditStatusText</span>
                        <span class="pr-tile-sub">@AuditStatusDescription</span>
                    </div>
                </div>
            </div>

        }
        <!-- Footer actions -->
        <div class="pr-footer">
            <button type="button" class="pr-btn pr-btn-back" @onclick="BackToList">
                <SalesAuditIcon Name="chevrons-left" Size="16" />
                Back to List
            </button>

            <div class="pr-footer-right">
                <button type="button" class="pr-btn pr-btn-draft" disabled="@(IsConfirmed || IsSaving || !IsLoaded)" @onclick="SaveDraftAsync">
                    <SalesAuditIcon Name="file-pen" Size="16" />
                    Save Draft
                </button>
                @if (IsConfirmed)
                {
                    @if (IsAuditCompleted)
                    {
                        <button type="button" class="pr-btn pr-btn-primary" disabled title="The saved achievement reached the required turnover; audit is closed.">
                            <SalesAuditIcon Name="check-circle" Size="16" />
                            Audit Completed
                        </button>
                    }
                    else
                    {
                        <button type="button" class="pr-btn pr-btn-primary" disabled="@(!CanSaveDailySales)"
                                @onclick="() => OpenDialog(DialogState.DailyConfirm)"
                                title="@(CanSaveDailySales ? "Save new daily SAP invoice lines" : "Upload daily SAP sales and use Refresh Sales to check for New invoice lines")">
                            <SalesAuditIcon Name="save" Size="16" />
                            @(IsSavingInvoices ? "Saving Daily Sales..." : $"Save Daily Sales ({NewInvoiceCount} New)")
                        </button>
                    }
                }
                else
                {
                    <button type="button" class="pr-btn pr-btn-primary" disabled="@(!CanConfirm)" @onclick="() => OpenDialog(DialogState.Confirm)"
                            title="@(CanConfirm ? null : "Save a valid scheme period, planned turnover at least equal to required turnover, and at least one mapped dealer")">
                        Confirm Sales Plan
                        <SalesAuditIcon Name="chevrons-right" Size="16" />
                    </button>
                }
            </div>
        </div>

        <!-- Confirm / Confirmed dialogs -->
        @if (Dialog != DialogState.None)
        {
            <div class="pr-overlay" @onclick="CloseDialog">
                <div class="pr-modal @((Dialog == DialogState.Confirmed || Dialog == DialogState.DailySaved) ? "pr-modal-success" : "")"
                     role="dialog" aria-modal="true" aria-labelledby="pr-dialog-title" tabindex="-1"
                     @ref="DialogRef" @onclick:stopPropagation="true" @onkeydown="OnDialogKeyDown">

                    @if (Dialog == DialogState.Confirm)
                    {
                        <div class="pr-modal-body pr-confirm-body">
                            @* Bulb + pencil + gear illustration *@
                            <svg class="pr-confirm-art" width="64" height="64" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M32 4v4M18 8.5l2.5 3M46 8.5l-2.5 3M12 18l3.5 1.5M52 18l-3.5 1.5"></path>
                                <path d="M24.5 32.5c-2.8-2.2-4.5-5.5-4.5-9.2C20 16.5 25.4 11 32 11s12 5.5 12 12.3c0 3.7-1.7 7-4.5 9.2V36h-15z"></path>
                                <path d="M28.5 29.5v-6.5a2 2 0 1 1 3.5 1.3M35.5 29.5v-6.5a2 2 0 1 0-3.5 1.3"></path>
                                <path d="M9 40h40l5 2.5-5 2.5H9z"></path>
                                <path d="M15 40v5M44 40v5"></path>
                                <path d="M22 45v3.5l3.5 1 1 3.5 3.5-1.5 2 3 2-3 3.5 1.5 1-3.5 3.5-1V45"></path>
                                <path d="M28 49a4 4 0 0 0 8 0"></path>
                            </svg>
                            <h2 id="pr-dialog-title" class="pr-modal-title">Confirm Sales Plan?</h2>
                            <p class="pr-modal-text">
                                Confirmation requires a dedicated server-side approval action to lock the plan. Review all values first. Do not treat a visual confirmation as a completed database submission.
                            </p>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(ConfirmationError))
                        {
                            <div class="alert alert-danger mx-3" role="alert">@ConfirmationError</div>
                        }
                        <div class="pr-modal-actions">
                            <button type="button" class="pr-modal-btn pr-modal-btn-cancel" disabled="@IsSaving" @onclick="CloseDialog">Cancel</button>
                            <button type="button" class="pr-modal-btn pr-modal-btn-primary" disabled="@IsSaving" @onclick="ConfirmPlan">
                                @(IsSaving ? "Confirming..." : "Yes, Confirm & Save")
                            </button>
                        </div>
                    }
                    else if (Dialog == DialogState.DailyConfirm)
                    {
                        <div class="pr-modal-body pr-confirm-body">
                            <svg class="pr-confirm-art" width="64" height="64" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="14" y="12" width="36" height="40" rx="5"></rect>
                                <path d="M22 23h20M22 31h20M22 39h10M36 39l4 4 8-9"></path>
                            </svg>
                            <h2 id="pr-dialog-title" class="pr-modal-title">Save Daily Sales?</h2>
                            <p class="pr-modal-text">
                                Save <strong>@NewInvoiceCount new invoice line(s)</strong> for this Sales Audit.
                                Old invoice records will not be duplicated. Your cumulative achievement and audit status will be updated in the database.
                            </p>
                            <p class="pr-modal-text">New sales: <strong>@SalesAuditFormat.Rupees(NewInvoiceAmount)</strong></p>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(InvoiceSaveError))
                        {
                            <div class="alert alert-danger mx-3" role="alert">@InvoiceSaveError</div>
                        }
                        <div class="pr-modal-actions">
                            <button type="button" class="pr-modal-btn pr-modal-btn-cancel" disabled="@IsSavingInvoices" @onclick="CloseDialog">Cancel</button>
                            <button type="button" class="pr-modal-btn pr-modal-btn-primary" disabled="@(!CanSaveDailySales)" @onclick="() => SaveMatchedInvoicesAsync()">
                                @(IsSavingInvoices ? "Saving..." : "Yes, Save Daily Sales")
                            </button>
                        </div>
                    }
                    else if (Dialog == DialogState.DailySaved)
                    {
                        <div class="pr-modal-body pr-success-body">
                            <span class="pr-success-icon">
                                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>
                            </span>
                            <h2 id="pr-dialog-title" class="pr-modal-title">Daily Sales Saved Successfully</h2>
                            <p class="pr-modal-text">New SAP invoice links have been saved, and the cumulative achievement has been updated in the Sales Audit database.</p>
                        </div>
                        <div class="pr-success-summary">
                            <dl>
                                <div><dt>Program</dt><dd>@ProgramName</dd></div>
                                <div><dt>Scheme Period</dt><dd>@DateText(SchemeFrom) – @DateText(SchemeTo)</dd></div>
                                <div><dt>New Invoices Saved</dt><dd>@DailySavedNewCount</dd></div>
                                <div><dt>Total Saved Invoices</dt><dd>@DailySavedTotalCount</dd></div>
                                <div><dt>Cumulative Achievement</dt><dd>@SalesAuditFormat.Rupees(DailySavedAmountRs)</dd></div>
                                <div><dt>Required Turnover</dt><dd>@SalesAuditFormat.Rupees(RequiredTurnover)</dd></div>
                                <div class="pr-summary-status"><dt>Audit Status</dt><dd><span class="pr-tracking-pill"><span class="pr-dot"></span>@DailySavedStatus</span></dd></div>
                            </dl>
                        </div>
                        <div class="pr-modal-actions pr-success-actions">
                            <button type="button" class="pr-modal-btn pr-modal-btn-primary" @onclick="CloseDialog">Continue</button>
                            <button type="button" class="pr-modal-btn pr-modal-btn-soft" @onclick="BackToList">Back to Sales Audit</button>
                        </div>
                    }
                    else
                    {
                        <div class="pr-modal-body pr-success-body">
                            <span class="pr-success-icon">
                                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>
                            </span>
                            <h2 id="pr-dialog-title" class="pr-modal-title">Sales Plan Confirmed</h2>
                            <p class="pr-modal-text">
                                The Sales Plan is confirmed and locked. Matched SAP invoice saving is tracked separately below.
                            </p>
                            @if (!string.IsNullOrWhiteSpace(InvoiceSaveError))
                            {
                                <div class="alert alert-warning mx-3" role="alert">
                                    The Sales Plan was confirmed, but invoice saving did not complete: @InvoiceSaveError
                                    Use Save Sales Progress after resolving the issue.
                                </div>
                            }
                            else if (!string.IsNullOrWhiteSpace(InvoiceSaveSuccess))
                            {
                                <div class="alert alert-info mx-3" role="status">@InvoiceSaveSuccess</div>
                            }
                        </div>

                        <div class="pr-success-summary">
                            <dl>
                                <div><dt>Program</dt><dd>@ProgramName</dd></div>
                                <div><dt>Scheme Period</dt><dd>@DateText(SchemeFrom) – @DateText(SchemeTo)</dd></div>
                                <div><dt>Required Turnover</dt><dd>₹@SalesAuditFormat.Crore(RequiredTurnover) Cr</dd></div>
                                <div><dt>Planned Commitment</dt><dd>₹@SalesAuditFormat.Crore(PlanTotal) Cr</dd></div>
                                <div><dt>Dealers</dt><dd>@TotalDealers</dd></div>
                                <div class="pr-summary-status"><dt>Status</dt><dd><span class="pr-tracking-pill"><span class="pr-dot"></span>Sales Tracking</span></dd></div>
                            </dl>
                        </div>

                        <div class="pr-modal-actions pr-success-actions">
                            <button type="button" class="pr-modal-btn pr-modal-btn-primary" @onclick="BackToList">Back to Sales Audit</button>
                            <button type="button" class="pr-modal-btn pr-modal-btn-soft" @onclick="ViewTracking">View Tracking →</button>
                        </div>
                    }
                </div>
            </div>
        }

    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "csr2Id")]
    public int? CSR2Id { get; set; }

    private record InfoItem(string Label, string Value, string Icon, bool IsBadge = false);
    private record PlanRow(string Product, string Unit, decimal Quantity, decimal Value);

    private sealed class OverviewDto
    {
        public string? ProgramName { get; set; }
        public string? ProgramType { get; set; }
        public string? SanctionNumber { get; set; }
        public string? CSR2Status { get; set; }
        public DateTime? ActualEventDate { get; set; }
        public string? State { get; set; }
        public string? Region { get; set; }
        public string? HQ { get; set; }
        public decimal Csr1BudgetRs { get; set; }
        public decimal AdditionalApprovedBudgetRs { get; set; }
        public DateTime? SchemeFrom { get; set; }
        public DateTime? SchemeTo { get; set; }
        public bool IsFinalSubmitted { get; set; }
        // Must be returned by GET /api/SalesAudit/overview after plan confirmation.
        public bool? IsPlanConfirmed { get; set; }
        public string? DocumentStatus { get; set; }
        public decimal ActualTurnoverCr { get; set; }
    }
    private sealed class ProductDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
    }
    private sealed class AuditLineDto
    {
        public int ProductId { get; set; }
        public decimal QuantityMT { get; set; }
        public decimal ValueRs { get; set; }
    }
    private sealed class DetailsDto
    {
        public DateTime? SchemeFrom { get; set; }
        public DateTime? SchemeTo { get; set; }
        public decimal RequiredTurnoverRs { get; set; }
        public bool IsFinalSubmitted { get; set; }
        public List<ProductDto> Products { get; set; } = new();
        public List<AuditLineDto> Plan { get; set; } = new();
    }
    private sealed class MatchedSapSalesDto
    {
        public int CSR2Id { get; set; }
        public DateTime SchemeFrom { get; set; }
        public DateTime SchemeTo { get; set; }
        public int MappedDealers { get; set; }
        public int MatchedInvoiceLines { get; set; }
        public int NewInvoiceLines { get; set; }
        public int OldInvoiceLines { get; set; }
        public decimal NewInvoiceGrossRs { get; set; }
        public int ExcludedOutsideDates { get; set; }
        public int ExcludedDifferentUnits { get; set; }
        public decimal TotalMatchedGrossRs { get; set; }
        public List<string> UnmatchedSapProductNames { get; set; } = new();
        public List<MatchedSapSaleRow> Rows { get; set; } = new();
    }

    private sealed class MatchedSapSaleRow
    {
        public long SaleId { get; set; }
        public bool IsSaved { get; set; }
        public string Status { get; set; } = "New";
        public string DealerCode { get; set; } = "";
        public string DealerName { get; set; } = "";
        public DateTime BillingDate { get; set; }
        public string BillingDocument { get; set; } = "";
        public string ProductCode { get; set; } = "";
        public string ProductName { get; set; } = "";
        public decimal QuantityMT { get; set; }
        public decimal GrossAmountRs { get; set; }
    }

    private sealed class DealerMappingDto
    {
        public List<DealerDto> Rows { get; set; } = new();
    }
    private sealed class DealerDto
    {
        public string CustomerNumber { get; set; } = "";
        public decimal? PlannedCommitmentRs { get; set; }
    }

    private MatchedSapSalesDto? MatchedSapSales;
    private bool IsLoadingSapSales;
    private bool IsSavingInvoices;
    private bool IsAuditClosedInDatabase;
    private string InvoiceSaveError = "";
    private string InvoiceSaveSuccess = "";
    private string SapSalesError = "";
    private OverviewDto? Overview;
    private bool IsLoading, IsLoaded, IsSaving;
    private string Error = "", Success = "";
    private string ConfirmationError = "";
    private DateTime? SchemeFrom, SchemeTo;
    private List<PlanRow> PlanRows = new();
    private decimal Csr1Budget, AdditionalBudget, RequiredTurnover, DealerAllocation;
    private int TotalDealers;
    private int MappedDealerCount;
    private bool HasDealerAllocationData;
    private bool IsConfirmed;

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "--" : value;
    private static string DateText(DateTime? date) => date?.ToString("dd MMM yyyy") ?? "--";
    private string ProgramName => Display(Overview?.ProgramName);
    private decimal PlanTotal => PlanRows.Sum(r => r.Value);
    private decimal PlanDifference => PlanTotal - RequiredTurnover;
    // Persisted cumulative sales, not the unsaved invoice preview.
    // ActualTurnoverCr is stored with sufficient precision for exact rupee/paise totals.
    private decimal AchievementAmount => (Overview?.ActualTurnoverCr ?? 0m) * 10_000_000m;
    private decimal NewInvoiceAmount => MatchedSapSales?.Rows?.Where(x => !x.IsSaved).Sum(x => x.GrossAmountRs) ?? 0m;
    private decimal AchievementDifference => AchievementAmount - RequiredTurnover;
    private decimal AchievementProgress => RequiredTurnover > 0m
        ? AchievementAmount / RequiredTurnover * 100m : 0m;
    private decimal Remaining => PlanTotal - DealerAllocation;
    // Display-only sales achievement status. Do not overwrite the API workflow status.
    // Wait for matched invoice data before deciding whether the target is achieved.
    private bool HasAchievementData => Overview is not null;
    private bool IsAuditCompleted => IsAuditClosedInDatabase ||
        string.Equals(Overview?.DocumentStatus, "Completed", StringComparison.OrdinalIgnoreCase);
    private string AuditStatusText => IsAuditCompleted ? "Completed" :
        !IsConfirmed ? "Plan Not Confirmed" :
        !HasAchievementData ? "--" : "In Progress";
    private string AuditStatusTileClass => IsAuditCompleted ? "pr-tile-green" :
        !IsConfirmed || !HasAchievementData ? "pr-tile-orange" : "pr-tile-blue";
    private string AuditStatusDescription => IsAuditCompleted
        ? "Saved achievement meets or exceeds Required Turnover"
        : !IsConfirmed ? "Confirm Sales Plan to begin saving achievements"
        : !HasAchievementData ? "Matched invoice data unavailable"
        : "Save daily progress; completion is verified by the database";
    // Plan confirmation happens only once. Every later day uses the independent
    // invoice-saving endpoint while the persisted audit status is still open.
    private int NewInvoiceCount => MatchedSapSales?.Rows?.Count(x => !x.IsSaved) ?? 0;
    private bool CanSaveDailySales => IsLoaded && !IsLoading && !IsSaving &&
        !IsLoadingSapSales && !IsSavingInvoices && IsConfirmed &&
        !IsAuditClosedInDatabase && !IsAuditCompleted && NewInvoiceCount > 0;
    private bool CanConfirm => IsLoaded && !IsSaving && !IsConfirmed && SchemeFrom.HasValue &&
        SchemeTo.HasValue && PlanRows.Count > 0 && TotalDealers > 0 &&
        PlanDifference >= 0;
    private IEnumerable<InfoItem> ProgramInfo => new[]
    {
        new InfoItem("Sanction Number", Display(Overview?.SanctionNumber), "gavel"),
        new InfoItem("Program Status", Display(Overview?.CSR2Status), "user-check", true),
        new InfoItem("State", Display(Overview?.State), "map-pin"),
        new InfoItem("Region", Display(Overview?.Region), "calendar"),
        new InfoItem("HQ", Display(Overview?.HQ), "calendar"),
        new InfoItem("CSR-2 Event Date", DateText(Overview?.ActualEventDate), "calendar"),
        new InfoItem("Scheme Start Date", DateText(SchemeFrom), "calendar"),
        new InfoItem("Scheme End Date", DateText(SchemeTo), "calendar")
    };
    private string DurationText
    {
        get
        {
            if (!SchemeFrom.HasValue || !SchemeTo.HasValue) return "--";
            if (SchemeTo.Value.Date < SchemeFrom.Value.Date) return "Invalid period";
            var days = (SchemeTo.Value.Date - SchemeFrom.Value.Date).Days + 1;
            var months = (SchemeTo.Value.Year - SchemeFrom.Value.Year) * 12 + SchemeTo.Value.Month - SchemeFrom.Value.Month + 1;
            return $"{months} {(months == 1 ? "Month" : "Months")} ({days} Days)";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        IsLoaded = false;
        Error = Success = ConfirmationError = "";
        MatchedSapSales = null;
        SapSalesError = "";
        if (CSR2Id is null or <= 0)
        {
            Error = "Missing csr2Id. Open Plan Review from Dealer Mapping.";
            return;
        }
        IsLoading = true;
        try
        {
            var id = CSR2Id.Value;
            using var overviewResponse = await Http.GetAsync($"api/SalesAudit/overview?csr2Id={id}");
            if (!overviewResponse.IsSuccessStatusCode)
            {
                Error = $"Could not load program information (HTTP {(int)overviewResponse.StatusCode}).";
                return;
            }
            var overview = await overviewResponse.Content.ReadFromJsonAsync<OverviewDto>();

            using var detailsResponse = await Http.GetAsync($"api/SalesAudit/details?csr2Id={id}");
            if (!detailsResponse.IsSuccessStatusCode)
            {
                Error = $"Could not load saved Sales Plan (HTTP {(int)detailsResponse.StatusCode}).";
                return;
            }
            var details = await detailsResponse.Content.ReadFromJsonAsync<DetailsDto>();

            using var dealerResponse = await Http.GetAsync($"api/SalesAudit/dealer-mapping?csr2Id={id}");
            if (!dealerResponse.IsSuccessStatusCode)
            {
                Error = $"Could not load Dealer Mapping (HTTP {(int)dealerResponse.StatusCode}).";
                return;
            }
            var dealers = await dealerResponse.Content.ReadFromJsonAsync<DealerMappingDto>();
            if (overview is null || details is null || dealers is null)
            {
                Error = "One or more Sales Audit API responses were empty.";
                return;
            }

            Overview = overview;
            SchemeFrom = details.SchemeFrom;
            SchemeTo = details.SchemeTo;
            Csr1Budget = overview.Csr1BudgetRs;
            AdditionalBudget = overview.AdditionalApprovedBudgetRs;
            RequiredTurnover = details.RequiredTurnoverRs;
            var productNames = details.Products.ToDictionary(p => p.Id, p => p.Name);
            PlanRows = details.Plan.Select(line => new PlanRow(
                productNames.TryGetValue(line.ProductId, out var name) ? name : $"Product #{line.ProductId}",
                "MT", line.QuantityMT, line.ValueRs)).ToList();
            var mappedRows = dealers.Rows ?? new();
            MappedDealerCount = mappedRows.Count;
            // Mapping API exposes dealer rows, not CustomerNumber. Match Step 3 count.
            TotalDealers = MappedDealerCount;
            // A missing commitment field must not be represented as an actual zero allocation.
            HasDealerAllocationData = mappedRows.Count > 0 && mappedRows.All(r => r.PlannedCommitmentRs.HasValue);
            DealerAllocation = mappedRows.Sum(r => r.PlannedCommitmentRs ?? 0m);
            // Plan confirmation must be separate from final achievement submission.
            IsConfirmed = overview.IsPlanConfirmed == true ||
                overview.IsFinalSubmitted ||
                overview.DocumentStatus is "Plan Confirmed" or "In Progress" or "Completed";
            IsAuditClosedInDatabase = string.Equals(overview.DocumentStatus, "Completed", StringComparison.OrdinalIgnoreCase);
            IsLoaded = true;
            await LoadMatchedSapSalesAsync();
        }
        catch (Exception ex)
        {
            Error = $"Unable to load Plan Review: {ex.Message}";
        }
        finally { IsLoading = false; }
    }

    // Same read-only endpoint as DealerMapping.razor: reads SalesAuditDealerSales,
    // filters mapped dealer codes, scheme dates and planned products on the server.
    // Requires a backend POST endpoint. The endpoint MUST independently run the
    // existing server-side matching rules and save IDs by (CSR2Id, SaleId).
    // Do not trust browser-sent invoice values and do not change plan confirmation.
    private sealed class InvoiceSaveResult
    {
        public int SavedInvoiceLines { get; set; }
        public int AddedInvoiceLines { get; set; }
        public decimal AchievementAmountRs { get; set; }
        public bool IsAuditCompleted { get; set; }
        public string DocumentStatus { get; set; } = "";
    }

    private async Task SaveMatchedInvoicesAsync(bool fromPlanConfirmation = false)
    {
        // The one-time Plan Confirm action is already busy while performing its initial save.
        // Daily saves use the normal button guard and always present a confirmation dialog.
        if (CSR2Id is null or <= 0 ||
            (fromPlanConfirmation
                ? (!IsConfirmed || IsAuditClosedInDatabase || NewInvoiceCount == 0 || IsSavingInvoices)
                : !CanSaveDailySales)) return;

        InvoiceSaveError = "";
        InvoiceSaveSuccess = "";
        IsSavingInvoices = true;
        try
        {
            using var response = await Http.PostAsync(
                $"api/SalesAudit/matched-invoices/save?csr2Id={CSR2Id.Value}", null);
            if (!response.IsSuccessStatusCode)
            {
                var message = await response.Content.ReadAsStringAsync();
                InvoiceSaveError = response.StatusCode == System.Net.HttpStatusCode.NotFound
                    ? "Invoice save API is not installed. Implement POST api/SalesAudit/matched-invoices/save before using this action."
                    : $"Unable to save matched invoices (HTTP {(int)response.StatusCode}): {message}";
                return;
            }

            // Successful HTTP status indicates the API accepted the save; the API
            // must commit the transaction before returning 2xx.
            var saveResult = await response.Content.ReadFromJsonAsync<InvoiceSaveResult>();
            if (saveResult is null)
            {
                InvoiceSaveError = "Save returned an empty response; verify saved status before retrying.";
                return;
            }
            IsAuditClosedInDatabase = saveResult.IsAuditCompleted;
            if (Overview is not null)
            {
                Overview.DocumentStatus = saveResult.DocumentStatus;
                Overview.ActualTurnoverCr = saveResult.AchievementAmountRs / 10_000_000m;
            }
            // Reload all eligible rows: saved New invoices become Old without disappearing.
            await LoadMatchedSapSalesAsync();
            InvoiceSaveSuccess = $"Saved cumulative {saveResult.SavedInvoiceLines} SAP invoice links; " +
                $"achievement ₹{saveResult.AchievementAmountRs:N2}. Audit: {saveResult.DocumentStatus}.";
            if (!fromPlanConfirmation)
            {
                DailySavedNewCount = saveResult.AddedInvoiceLines;
                DailySavedTotalCount = saveResult.SavedInvoiceLines;
                DailySavedAmountRs = saveResult.AchievementAmountRs;
                DailySavedStatus = saveResult.DocumentStatus;
                OpenDialog(DialogState.DailySaved);
            }
        }
        catch (Exception ex)
        {
            InvoiceSaveError = $"Unable to save matched invoices: {ex.Message}";
        }
        finally { IsSavingInvoices = false; }
    }

    private async Task LoadMatchedSapSalesAsync()
    {
        if (CSR2Id is null or <= 0) return;
        IsLoadingSapSales = true;
        InvoiceSaveSuccess = "";
        SapSalesError = "";
        MatchedSapSales = null;
        try
        {
            using var response = await Http.GetAsync($"api/SalesAudit/dealer-mapping/sap-sales?csr2Id={CSR2Id.Value}&excludeSaved=false");
            if (!response.IsSuccessStatusCode)
            {
                SapSalesError = $"Unable to load matched SAP invoice details (HTTP {(int)response.StatusCode}): " +
                    await response.Content.ReadAsStringAsync();
                return;
            }
            MatchedSapSales = await response.Content.ReadFromJsonAsync<MatchedSapSalesDto>();
            if (MatchedSapSales is null)
                SapSalesError = "The matching API returned no invoice data.";
        }
        catch (Exception ex)
        {
            SapSalesError = "Unable to load matched SAP sales: " + ex.Message;
        }
        finally { IsLoadingSapSales = false; }
    }

    private void EditSalesPlan() => Nav.NavigateTo($"/SalesPlan?csr2Id={CSR2Id}");
    private void EditDealerMapping() => Nav.NavigateTo($"/DealerMapping?csr2Id={CSR2Id}");
    private void BackToList() => Nav.NavigateTo("/SalesAudit");
    private void ViewTracking() => Nav.NavigateTo($"/SalesTracking?csr2Id={CSR2Id}");

    private async Task SaveDraftAsync()
    {
        if (CSR2Id is null or <= 0 || !IsLoaded || IsConfirmed || IsSaving) return;
        Error = Success = "";
        IsSaving = true;
        try
        {
            using var response = await Http.PostAsync($"api/SalesAudit/overview/save-draft?csr2Id={CSR2Id.Value}", null);
            if (!response.IsSuccessStatusCode)
            {
                Error = $"Unable to save review draft (HTTP {(int)response.StatusCode}): " +
                        await response.Content.ReadAsStringAsync();
                return;
            }
            Success = "Sales Audit draft saved. Product and dealer data remain unchanged.";
        }
        catch (Exception ex) { Error = $"Unable to save draft: {ex.Message}"; }
        finally { IsSaving = false; }
    }

    private enum DialogState { None, Confirm, Confirmed, DailyConfirm, DailySaved }
    private DialogState Dialog = DialogState.None;
    private int DailySavedNewCount, DailySavedTotalCount;
    private decimal DailySavedAmountRs;
    private string DailySavedStatus = "";
    private ElementReference DialogRef;
    private bool FocusDialog;
    private void OpenDialog(DialogState state)
    {
        ConfirmationError = "";
        if (state == DialogState.DailyConfirm) InvoiceSaveError = "";
        Dialog = state;
        FocusDialog = true;
    }
    private void CloseDialog()
    {
        if (!IsSaving && !IsSavingInvoices) Dialog = DialogState.None;
    }

    private async Task ConfirmPlan()
    {
        ConfirmationError = "";
        Error = "";

        if (CSR2Id is null or <= 0)
        {
            ConfirmationError = "Missing CSR-2 ID.";
            return;
        }

        if (IsSaving || IsConfirmed) return;
        if (!CanConfirm)
        {
            ConfirmationError = "The sales plan or dealer allocation no longer meets confirmation requirements.";
            return;
        }

        IsSaving = true;
        try
        {
            using var response = await Http.PostAsync(
                $"api/SalesAudit/confirm-plan?csr2Id={CSR2Id.Value}", null);

            if (!response.IsSuccessStatusCode)
            {
                var message = await response.Content.ReadAsStringAsync();
                ConfirmationError = response.StatusCode == System.Net.HttpStatusCode.NotFound
                    ? "Plan-confirmation API not found (HTTP 404). Add POST /api/SalesAudit/confirm-plan to the API."
                    : $"Confirmation failed (HTTP {(int)response.StatusCode}): {message}";
                return;
            }

            // A successful HTTP response alone is not proof of persisted confirmation.
            // Re-read the server state, which must expose a distinct IsPlanConfirmed flag.
            using var verifyResponse = await Http.GetAsync(
                $"api/SalesAudit/overview?csr2Id={CSR2Id.Value}");
            if (!verifyResponse.IsSuccessStatusCode)
            {
                ConfirmationError = $"Confirmation request returned success, but the saved status could not be verified (HTTP {(int)verifyResponse.StatusCode}).";
                return;
            }

            var verified = await verifyResponse.Content.ReadFromJsonAsync<OverviewDto>();
            if (verified?.IsPlanConfirmed != true)
            {
                ConfirmationError = "Confirmation has not been verified in the database. The overview API must return IsPlanConfirmed=true after saving the plan.";
                return;
            }

            Overview = verified;
            IsConfirmed = true;

            // Plan confirmation and achievement saving are separate server writes.
            // On initial confirmation, automatically persist currently matched SAP sales.
            // Future daily uploads still use the independent Save Sales Progress button.
            if (MatchedSapSales is not null && MatchedSapSales.Rows.Any(x => !x.IsSaved))
            {
                await SaveMatchedInvoicesAsync(fromPlanConfirmation: true);
            }
            else
            {
                InvoiceSaveSuccess = "Sales Plan confirmed. No eligible SAP invoice rows are currently available to save; upload daily sales and use Save Sales Progress.";
            }

            OpenDialog(DialogState.Confirmed);
        }
        catch (Exception ex)
        {
            ConfirmationError = $"Unable to confirm Sales Plan: {ex.Message}";
        }
        finally
        {
            IsSaving = false;
        }
    }

    private void OnDialogKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CloseDialog();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (FocusDialog && Dialog != DialogState.None)
        {
            FocusDialog = false;
            await DialogRef.FocusAsync();
        }
    }
