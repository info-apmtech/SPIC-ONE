@page "/RefundStatus"
@using System.Globalization
@inject HttpClient Http
@inject NavigationManager Navigation

<style>
    :root {
        --rs-bg-body: #f4f6f8;
        --rs-bg-card: #ffffff;
        --rs-text-main: #1f2937;
        --rs-text-muted: #6b7280;
        --rs-border-light: #e5e7eb;
        --rs-primary-blue: #3b82f6;
        
        /* Specific Theme Colors */
        --rs-header-bg-green: #eef5ec; 
        --rs-header-text-green: #3f4e42;
        --rs-text-red: #dc2626;
        --rs-text-green: #16a34a;
        --rs-alert-orange-bg: #fff7ed;
        --rs-alert-orange-border: #ffedd5;
        --rs-alert-orange-text: #c2410c;
    }

    /* --- Page Base --- */
    .rs-page-container {
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        color: var(--rs-text-main);
        max-width: 1200px;
        margin: auto;
    }

    /* --- Page Header --- */
    .rs-page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
        gap: 15px;
    }
    .rs-page-title {
        font-size: 1.4rem;
        font-weight: 700;
        color: var(--rs-text-main);
        margin-bottom: 0.25rem;
    }
    .rs-page-subtitle {
        font-size: 0.85rem;
        color: var(--rs-text-muted);
        margin: 0;
    }
    .rs-text-red { color: var(--rs-text-red); font-weight: 600; }

    /* --- Buttons --- */
    .rs-btn-outline {
        background-color: #ffffff;
        border: 1px solid var(--rs-border-light);
        color: #374151;
        font-weight: 600;
        font-size: 0.85rem;
        padding: 8px 16px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: 0.2s;
        box-shadow: 0 1px 2px rgba(0,0,0,0.02);
        cursor: pointer;
    }
    .rs-btn-outline:hover { background-color: #f9fafb; color: #1f2937; }

    .rs-btn-solid-blue {
        background-color: #2563eb;
        border: 1px solid #2563eb;
        color: #ffffff;
        font-weight: 600;
        font-size: 0.85rem;
        padding: 8px 20px;
        border-radius: 6px;
        transition: 0.2s;
        cursor: pointer;
    }
    .rs-btn-solid-blue:hover { background-color: #1d4ed8; }

    /* --- Cards --- */
    .rs-card {
        background: var(--rs-bg-card);
        border: 1px solid var(--rs-border-light);
        border-radius: 12px;
        margin-bottom: 1.5rem;
        overflow: hidden; 
        box-shadow: 0 1px 2px rgba(0,0,0,0.02);
    }
    .rs-card-header {
        background-color: var(--rs-header-bg-green);
        padding: 14px 20px;
        border-bottom: 1px solid #dce4d6;
    }
    .rs-card-title {
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--rs-header-text-green);
        margin: 0;
    }
    .rs-card-body {
        padding: 20px;
    }

    /* --- Top Summary Section (Card 1) --- */
    .rs-summary-top {
        text-align: center;
        padding-bottom: 1.25rem;
        border-bottom: 1px solid var(--rs-border-light);
        margin-bottom: 1.25rem;
    }
    .rs-summary-lbl {
        font-size: 0.85rem;
        color: var(--rs-text-muted);
        font-weight: 600;
        margin-bottom: 8px;
    }
    .rs-summary-amount {
        font-size: 1.8rem;
        font-weight: 700;
        color: var(--rs-text-green);
        margin-bottom: 8px;
    }
    .rs-summary-id {
        font-size: 0.85rem;
        color: var(--rs-text-main);
        font-weight: 600;
    }

    /* --- Key Value Rows --- */
    .rs-kv-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 16px;
    }
    .rs-kv-row:last-child { margin-bottom: 0; }
    .rs-kv-label {
        font-size: 0.85rem;
        font-weight: 500;
        color: var(--rs-text-muted);
        flex-shrink: 0;
    }
    .rs-kv-value {
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--rs-text-main);
        text-align: right;
    }
    .rs-kv-value.red { color: var(--rs-text-red); }
    .rs-kv-value.blue { color: var(--rs-primary-blue); font-size: 1rem; }

    .rs-divider {
        height: 1px;
        background-color: var(--rs-border-light);
        margin: 16px 0;
    }

    /* --- Status Pill --- */
    .rs-status-pill {
        background-color: #e0e7ff; /* light indigo/purple */
        color: #4f46e5;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        display: inline-block;
    }

    /* --- Timeline Tracker --- */
    .rs-timeline {
        position: relative;
        padding-top: 8px;
        padding-bottom: 8px;
    }
    .rs-tl-item {
        display: flex;
        gap: 16px;
        position: relative;
        padding-bottom: 28px;
    }
    .rs-tl-item:last-child { padding-bottom: 0; }
    
    /* Connecting Lines */
    .rs-tl-line {
        position: absolute;
        top: 32px;
        bottom: 0;
        left: 15px; /* Center of 32px icon */
        width: 2px;
        z-index: 1;
    }
    .rs-tl-line.green { background-color: #22c55e; }
    .rs-tl-line.gray { background-color: #e5e7eb; }

    /* Icons */
    .rs-tl-icon {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        font-weight: bold;
        z-index: 2;
        background-color: #ffffff;
        flex-shrink: 0;
    }
    .rs-tl-icon.done {
        border: 2px solid #22c55e;
        color: #22c55e;
    }
    .rs-tl-icon.active {
        border: 2px solid #6366f1; /* Purple */
        color: #6366f1;
        background-color: #e0e7ff;
    }
    .rs-tl-icon.pending {
        background-color: #d1d5db; /* Solid gray */
        border: 2px solid #d1d5db;
    }

    /* Timeline Content */
    .rs-tl-content {
        padding-top: 4px;
    }
    .rs-tl-title {
        font-size: 0.95rem;
        font-weight: 700;
        margin: 0 0 4px 0;
    }
    .rs-tl-title.red { color: #dc2626; }
    .rs-tl-title.green { color: #16a34a; }
    .rs-tl-title.dark { color: #374151; }
    
    .rs-tl-date {
        font-size: 0.8rem;
        color: var(--rs-text-muted);
        margin: 0 0 2px 0;
    }
    .rs-tl-desc {
        font-size: 0.75rem;
        color: #9ca3af;
        margin: 0;
        line-height: 1.4;
    }

    /* --- Alert Box --- */
    .rs-alert-orange {
        background-color: var(--rs-alert-orange-bg);
        border: 1px solid var(--rs-alert-orange-border);
        color: var(--rs-alert-orange-text);
        padding: 12px 16px;
        border-radius: 8px;
        font-size: 0.8rem;
        display: flex;
        align-items: flex-start;
        gap: 12px;
        margin-top: 24px;
        line-height: 1.5;
    }
    .rs-alert-orange i { font-size: 1.1rem; margin-top: -2px; color: #ea580c; }

    /* --- Bottom Actions --- */
    .rs-bottom-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 1rem;
        padding-bottom: 2rem;
    }

    /* native: phone */
    .rs-page-header .shell-page-header { margin-bottom: 0; }
    .rs-bottom-actions > .fb-actionbar { flex: 1 1 100%; }
    @@media (min-width: 768px) {
        .rs-bottom-actions > .fb-actionbar { padding: 0; }
    }
    @@media (max-width: 767.98px) {
        .rs-btn-outline, .rs-btn-solid-blue {
            min-height: 44px;
            min-width: 0;
            justify-content: center;
            padding-left: 10px;
            padding-right: 10px;
        }
        .rs-card { margin-bottom: 12px; }
        .rs-card-header { padding: 10px 16px; }
        .rs-card-body { padding: 16px; }
        .rs-bottom-actions { margin-top: 0; padding-bottom: 0; }
    }
</style>

<div class="container-fluid py-4 px-0">

    <div class="rs-page-header">
        <PageHeader Title="Refund Status" Subtitle="@($"Track the progress of your refund for booking {(_status?.CancellationReference ?? _status?.BookingReference ?? "")}")" BackHref="/MyBookings" CssClass="w-100">
            <Actions>
                <button class="rs-btn-outline"><i class="bi bi-file-earmark-arrow-down"></i> Download Cancellation Receipt</button>
            </Actions>
        </PageHeader>
    </div>

    @if (_isLoading)
    {
        <Skeleton Variant="table" Rows="6" LoadingText="Loading refund status" />
    }
    else if (_status == null)
    {
        <EmptyState Icon="bi-exclamation-circle" Title="Refund status unavailable" Message="@(_loadError ?? "We could not load the refund status.")">
            <button class="rs-btn-outline" @onclick="GoBack">Back to My Bookings</button>
        </EmptyState>
    }
    else
    {
    <div class="row g-4">

        <div class="col-lg-5">

            <div class="rs-card">
                <div class="rs-card-body">

                    <div class="rs-summary-top">
                        <div class="rs-summary-lbl">Total Refund Amount</div>
                        <div class="rs-summary-amount">@Money(_status.RefundAmount)</div>
                        <div class="rs-summary-id">Cancellation ID: <span class="rs-text-red">@Dash(_status.CancellationReference)</span></div>
                    </div>

                    <div class="rs-kv-row">
                        <span class="rs-kv-label">Refund Method</span>
                        <span class="rs-kv-value">@Dash(_status.RefundMethod)@(string.IsNullOrWhiteSpace(_status.PaymentMethod) ? "" : $" ({_status.PaymentMethod})")</span>
                    </div>
                    <div class="rs-kv-row">
                        <span class="rs-kv-label">Target Credit Date</span>
                        <span class="rs-kv-value">@(IsRejected ? "-" : _status.EstimatedRefundDate.HasValue ? FormatDate(_status.EstimatedRefundDate) : "Within 2 working days after Admin approval")</span>
                    </div>
                    <div class="rs-kv-row">
                        <span class="rs-kv-label">Transaction Ref.</span>
                        <span class="rs-kv-value">@Dash(_status.RefundReference)</span>
                    </div>
                    <div class="rs-kv-row">
                        <span class="rs-kv-label">Cancellation Date</span>
                        <span class="rs-kv-value">@FormatDateTime(_status.RequestedAt)</span>
                    </div>
                    <div class="rs-kv-row mt-3">
                        <span class="rs-kv-label">Current Status</span>
                        <span class="rs-status-pill">@CurrentStatusLabel</span>
                    </div>

                </div>
            </div>

            <div class="rs-card">
                <div class="rs-card-header">
                    <h3 class="rs-card-title">Refund Breakdown</h3>
                </div>
                <div class="rs-card-body">
                    <div class="rs-kv-row">
                        <span class="rs-kv-label">Total Paid</span>
                        <span class="rs-kv-value">@Money(_status.TotalPaid)</span>
                    </div>
                    <div class="rs-kv-row">
                        <span class="rs-kv-label">Cancellation Charges</span>
                        <span class="rs-kv-value red">−@Money(_status.CancellationCharge)</span>
                    </div>
                    <div class="rs-kv-row">
                        <span class="rs-kv-label">Tax Adjustment (GST)</span>
                        <span class="rs-kv-value red">−@Money(_status.TaxAdjustment)</span>
                    </div>

                    <div class="rs-divider"></div>

                    <div class="rs-kv-row">
                        <span class="rs-kv-label" style="font-size: 0.95rem; font-weight: 700; color: #1f2937;">Refund Amount</span>
                        <span class="rs-kv-value blue">@Money(_status.RefundAmount)</span>
                    </div>
                </div>
            </div>

        </div>

        <div class="col-lg-7">

            <div class="rs-card h-100 mb-0">
                <div class="rs-card-header">
                    <h3 class="rs-card-title">Refund Tracking</h3>
                </div>
                <div class="rs-card-body">

                    <div class="rs-timeline">

                        <div class="rs-tl-item">
                            <div class="rs-tl-line green"></div>
                            <div class="rs-tl-icon done"><i class="bi bi-check-lg"></i></div>
                            <div class="rs-tl-content">
                                <h4 class="rs-tl-title red">Cancellation Requested</h4>
                                <p class="rs-tl-date">@FormatDateTime(_status.RequestedAt)</p>
                                <p class="rs-tl-desc">@(string.IsNullOrWhiteSpace(_status.CancellationReason) ? "Cancellation request recorded in system" : $"Reason: {_status.CancellationReason}")</p>
                            </div>
                        </div>

                        <div class="rs-tl-item">
                            <div class="rs-tl-line @(IsApproved ? "green" : "gray")"></div>
                            @if (IsApproved)
                            {
                                <div class="rs-tl-icon done"><i class="bi bi-check-lg"></i></div>
                            }
                            else if (IsRejected)
                            {
                                <div class="rs-tl-icon active"><i class="bi bi-x-lg"></i></div>
                            }
                            else
                            {
                                <div class="rs-tl-icon active"><i class="bi bi-hourglass-split"></i></div>
                            }
                            <div class="rs-tl-content">
                                <h4 class="rs-tl-title @(IsRejected ? "red" : IsApproved ? "green" : "dark")">@(IsRejected ? "Cancellation Rejected" : IsApproved ? "Approved by Admin" : "Pending Admin Approval")</h4>
                                <p class="rs-tl-date">@(_status.DecidedAt.HasValue ? FormatDateTime(_status.DecidedAt.Value) : "(In Progress)")</p>
                                <p class="rs-tl-desc">@(IsRejected ? $"Reason: {Dash(_status.RejectionReason)}. Your booking remains active." : IsApproved ? "Your booking has been cancelled and the room released" : "Your request is awaiting review by the Admin")</p>
                            </div>
                        </div>

                        @if (IsApproved && _status.RefundAmount <= 0)
                        {
                            <div class="rs-tl-item">
                                <div class="rs-tl-icon done"><i class="bi bi-dash-lg"></i></div>
                                <div class="rs-tl-content">
                                    <h4 class="rs-tl-title dark">No Refund Due</h4>
                                    <p class="rs-tl-date">@(_status.DecidedAt.HasValue ? FormatDateTime(_status.DecidedAt.Value) : "-")</p>
                                    <p class="rs-tl-desc">No refund is due for this cancellation under the cancellation policy</p>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="rs-tl-item">
                                <div class="rs-tl-line @(IsRefundInitiated ? "green" : "gray")"></div>
                                @if (IsRefundInitiated)
                                {
                                    <div class="rs-tl-icon done"><i class="bi bi-check-lg"></i></div>
                                }
                                else
                                {
                                    <div class="rs-tl-icon pending"></div>
                                }
                                <div class="rs-tl-content">
                                    <h4 class="rs-tl-title @(IsRefundInitiated ? "green" : "dark")">Refund Initiated</h4>
                                    <p class="rs-tl-date">@(IsRefundInitiated && _status.DecidedAt.HasValue ? FormatDateTime(_status.DecidedAt.Value) : IsRejected ? "-" : "Pending")</p>
                                    <p class="rs-tl-desc">Refund of @Money(_status.RefundAmount) initiated to your original payment method@(string.IsNullOrWhiteSpace(_status.RefundReference) ? "" : $" (Ref. {_status.RefundReference})")</p>
                                </div>
                            </div>

                            <div class="rs-tl-item">
                                <div class="rs-tl-line @(IsRefundCompleted ? "green" : "gray")"></div>
                                @if (IsRefundCompleted)
                                {
                                    <div class="rs-tl-icon done"><i class="bi bi-check-lg"></i></div>
                                }
                                else if (IsRefundProcessing)
                                {
                                    <div class="rs-tl-icon active"><i class="bi bi-arrow-clockwise"></i></div>
                                }
                                else
                                {
                                    <div class="rs-tl-icon pending"></div>
                                }
                                <div class="rs-tl-content">
                                    <h4 class="rs-tl-title @(IsRefundCompleted ? "green" : "dark")">Refund Processing</h4>
                                    <p class="rs-tl-date">@(IsRefundProcessing ? "(In Progress)" : IsRefundCompleted ? "Done" : IsRefundFailed ? "Failed" : "Pending")</p>
                                    <p class="rs-tl-desc">@(IsRefundFailed ? "The payment gateway could not complete this refund. Our team will contact you." : "Your refund is being processed by the payment gateway and your bank")</p>
                                </div>
                            </div>

                            <div class="rs-tl-item">
                                @if (IsRefundCompleted)
                                {
                                    <div class="rs-tl-icon done"><i class="bi bi-check-lg"></i></div>
                                }
                                else
                                {
                                    <div class="rs-tl-icon pending"></div>
                                }
                                <div class="rs-tl-content">
                                    @* "Completed" = Razorpay's final "processed" state. Razorpay does not
                                       report the credit to the payment source itself, so this never says "credited". *@
                                    <h4 class="rs-tl-title @(IsRefundCompleted ? "green" : "dark")">Refund Completed by Razorpay</h4>
                                    <p class="rs-tl-date">@(IsRefundCompleted && _status.RefundProcessedAt.HasValue ? FormatDateTime(_status.RefundProcessedAt.Value) : IsRejected ? "-" : _status.EstimatedRefundDate.HasValue ? $"Target credit date: {FormatDate(_status.EstimatedRefundDate)}" : "Within 2 working days after Admin approval")</p>
                                    <p class="rs-tl-desc">@(IsRefundCompleted ? "Razorpay has completed the refund to your original payment source. Please check your bank or card statement." : "Razorpay confirms when it has completed the refund")</p>
                                </div>
                            </div>
                        }

                    </div>

                    @if (!IsRejected && !(IsApproved && _status.RefundAmount <= 0))
                    {
                        <div class="rs-alert-orange">
                            <i class="bi bi-info-circle"></i>
                            <div>
                                @_status.RefundTimelineMessage
                                @if (IsPastTargetDate)
                                {
                                    <br/>
                                    <span>The target date (@FormatDate(_status.EstimatedRefundDate)) has passed. If the amount has not reached your original payment source, please contact support with reference: <strong>@(_status.RefundReference ?? _status.CancellationReference)</strong></span>
                                }
                                else if (_status.EstimatedRefundDate.HasValue)
                                {
                                    <br/>
                                    <span>If the amount has not reached your original payment source by @FormatDate(_status.EstimatedRefundDate), please contact support with reference: <strong>@(_status.RefundReference ?? _status.CancellationReference)</strong></span>
                                }
                            </div>
                        </div>
                    }

                </div>
            </div>

        </div>

    </div>
    }

    <div class="rs-bottom-actions">
        <ActionBar AriaLabel="Refund actions">
            @* Three buttons do not fit one sticky row at 392px, so the two long
               labels shorten on phones (the bar clips rather than ellipsises,
               because the buttons are flex containers). *@
            <Secondary>
                <button class="rs-btn-outline" @onclick="GoBack">Back</button>
                <button class="rs-btn-outline">
                    <span class="phone-only">Share</span>
                    <span class="tablet-up">Share Refund Details</span>
                </button>
            </Secondary>
            <ChildContent>
                <button class="rs-btn-solid-blue">
                    <span class="phone-only">Support</span>
                    <span class="tablet-up">Contact Support</span>
                </button>
            </ChildContent>
        </ActionBar>
    </div>

</div>

@code {
    [SupplyParameterFromQuery(Name = "bookingId")]
    public int? BookingId { get; set; }

    private RefundStatusDto? _status;
    private bool _isLoading = true;
    private string? _loadError;

    private bool IsApproved => _status?.ApprovalStatus == "Approved";
    private bool IsRejected => _status?.ApprovalStatus == "Rejected";
    private bool IsRefundInitiated => IsApproved && _status!.RefundAmount > 0
        && (_status.RefundStatus == "Processing" || _status.RefundStatus == "Completed");
    private bool IsRefundCompleted => IsApproved && _status!.RefundAmount > 0 && _status.RefundStatus == "Completed";
    private bool IsRefundProcessing => IsApproved && _status!.RefundAmount > 0 && _status.RefundStatus == "Processing";
    private bool IsRefundFailed => IsApproved && _status!.RefundStatus == "Failed";
    private bool IsPastTargetDate => _status?.EstimatedRefundDate.HasValue == true && DateTime.Now > _status.EstimatedRefundDate.Value;

    private string CurrentStatusLabel
    {
        get
        {
            if (_status == null) return "-";
            if (IsRejected) return "Rejected";
            if (!IsApproved) return _status.RefundStatus == "Failed" ? "Refund Retry Pending" : "Pending Approval";
            if (_status.RefundAmount <= 0) return "Cancelled - No Refund Due";
            return _status.RefundStatus switch
            {
                "Completed" => "Refund Completed by Razorpay",
                "Processing" => "Refund Initiated / Processing",
                "Failed" => "Refund Failed",
                _ => "Refund Pending"
            };
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!BookingId.HasValue)
        {
            _loadError = "No booking selected.";
            _isLoading = false;
            return;
        }

        try
        {
            var response = await Http.GetAsync($"api/GuestHouseBooking/bookings/{BookingId}/refund-status");
            if (response.IsSuccessStatusCode)
            {
                _status = await response.Content.ReadFromJsonAsync<RefundStatusDto>();
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                _loadError = "No cancellation request was found for this booking.";
            }
            else
            {
                _loadError = "We could not load the refund status. Please try again.";
            }
        }
        catch (Exception)
        {
            _loadError = "We could not load the refund status. Please try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void GoBack() => Navigation.NavigateTo("/MyBookings");

    private static string Money(decimal value) => "₹" + value.ToString("N2", CultureInfo.InvariantCulture);

    private static string Dash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string FormatDate(DateTime? value) =>
        value.HasValue ? value.Value.ToString("dd MMM yyyy", CultureInfo.InvariantCulture) : "-";

    private static string FormatDateTime(DateTime value) =>
        value.ToString("dd MMM yyyy 'at' hh:mm tt", CultureInfo.InvariantCulture);

    private sealed class RefundStatusDto
    {
        public int BookingId { get; set; }
        public string BookingReference { get; set; } = "";
        public string GuestHouseName { get; set; } = "";
        public string RoomType { get; set; } = "";
        public int CancellationId { get; set; }
        public string? CancellationReference { get; set; }
        public string? CancellationReason { get; set; }
        public string ApprovalStatus { get; set; } = "";
        public string RefundStatus { get; set; } = "";
        public DateTime RequestedAt { get; set; }
        public DateTime? DecidedAt { get; set; }
        public string? RejectionReason { get; set; }
        public decimal TotalPaid { get; set; }
        public decimal CancellationCharge { get; set; }
        public decimal TaxAdjustment { get; set; }
        public decimal RefundAmount { get; set; }
        public string? RefundMethod { get; set; }
        public DateTime? EstimatedRefundDate { get; set; }
        public string? RefundReference { get; set; }
        public DateTime? RefundProcessedAt { get; set; }
        public string PaymentMethod { get; set; } = "";
        public string RefundTimelineMessage { get; set; } = "";
    }
}
