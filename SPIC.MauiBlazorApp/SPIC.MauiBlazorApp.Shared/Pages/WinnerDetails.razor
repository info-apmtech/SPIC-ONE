@page "/WinnerDetails"    
    <style>
        /* === CSS Variables for Theme Colors === */
       

        /* Custom utility classes */
        .text-theme-green { color: var(--theme-primary-green); }
        .text-theme-purple { color: var(--theme-primary-purple); }
        .bg-hero { background-color: var(--theme-light-green); border: 1px solid #dff2e3; }
        .bg-summary { background-color: var(--theme-light-purple); border: 1px solid #f6e8fa; }
        .bg-card-header { background-color: var(--theme-header-green); }
        
        .icon-svg { width: 18px; height: 18px; fill: currentColor; }

        /* Card Hover Effect for Desktop */
        .hover-card {
            transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
        }
        @@media (min-width: 992px) {
            .hover-card:hover {
                transform: translateY(-4px);
                box-shadow: 0 10px 25px rgba(0,0,0,0.08) !important;
            }
        }

        /* Image Sizing */
        .winner-img {
            width: 75px;
            height: 95px;
            object-fit: cover;
        }
        .prize-img {
            width: 140px;
            height: 140px;
            object-fit: cover;
        }

        /* List alignment */
        .list-label {
            width: 130px;
            flex-shrink: 0;
            color: #6b6b6b;
            font-size: 0.85rem;
        }
        .list-value {
            font-size: 0.85rem;
            color: #2c2c2c;
            font-weight: 600;
        }

        /* Custom Badges */
        .badge-orange { background-color: #fff3cd; color: #d39e00; }
        .badge-green { background-color: #d4edda; color: #1e7e34; }

        /* Desktop specific tweaks */
        @@media (min-width: 992px) {
            .sticky-sidebar {
                /* position: sticky; */
                top: 24px;
            }
            .header-container {
                background: transparent !important;
                padding-left: 0 !important;
            }
        }
    </style>


<div class="container py-3 py-lg-5" style="max-width: 1140px;">
    
    <!-- Header -->
    <header class="header-container d-flex align-items-center mb-3 mb-lg-4 px-2 bg-white sticky-top py-3">
        <button class="btn btn-link text-dark p-0 me-3 shadow-none text-decoration-none border-0 hover-card">
            <svg class="icon-svg" viewBox="0 0 24 24"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
        </button>
        <h1 class="h5 mb-0 fw-bold">Winner Details</h1>
    </header>

    <div class="row g-4">
        
        <!-- ========================================== -->
        <!-- LEFT COLUMN: Overview (Sidebar on Desktop) -->
        <!-- ========================================== -->
        <div class="col-12 col-lg-4">
            <div class="sticky-sidebar d-flex flex-column gap-3">
                
                <!-- Hero Banner -->
                <div class="bg-hero rounded-4 p-4 d-flex align-items-center justify-content-between position-relative overflow-hidden shadow-sm hover-card">
                    <div class="position-relative" style="z-index: 2;">
                        <div class="fw-bold text-theme-green mb-1" style="font-size: 0.9rem;">Congratulations!</div>
                        <h2 class="fw-bolder text-theme-green mb-2 h4">You are a Winner</h2>
                        <div class="text-secondary" style="font-size: 0.75rem;">Draw ID: SPIC/KSS/2026/0420</div>
                    </div>
                    <img src="https://images.unsplash.com/photo-1578269174936-2709b6aeb913?ixlib=rb-1.2.1&auto=format&fit=crop&w=200&q=80" alt="Trophy" class="rounded-circle shadow-sm position-relative" style="width: 90px; height: 90px; z-index: 2;">
                </div>

                <!-- Draw Summary -->
                <div class="bg-summary rounded-4 p-4 shadow-sm hover-card">
                    <div class="d-flex align-items-center mb-3 text-theme-purple">
                        <svg class="icon-svg me-2" viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z"/></svg>
                        <span class="fw-bold" style="font-size: 0.9rem;">Draw Summary</span>
                    </div>
                    <div class="row text-center g-2">
                        <div class="col-4 border-end border-light">
                            <div class="text-secondary mb-1" style="font-size: 0.7rem;">Participants</div>
                            <div class="fw-bold text-theme-purple fs-5">120</div>
                        </div>
                        <div class="col-4 border-end border-light">
                            <div class="text-secondary mb-1" style="font-size: 0.7rem;">Winners</div>
                            <div class="fw-bold text-theme-purple fs-5">03</div>
                        </div>
                        <div class="col-4">
                            <div class="text-secondary mb-1" style="font-size: 0.7rem;">Entries</div>
                            <div class="fw-bold text-theme-purple fs-5">100</div>
                        </div>
                    </div>
                </div>

                <!-- Help Section (Visible on Desktop Sidebar, hidden on mobile here) -->
                <div class="card border-0 bg-white rounded-4 p-3 shadow-sm hover-card d-none d-lg-block">
                    <div class="d-flex align-items-start mb-3">
                        <div class="bg-card-header rounded-3 d-flex align-items-center justify-content-center me-3 flex-shrink-0" style="width: 40px; height: 40px;">
                            <svg class="icon-svg text-theme-green" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 17h-2v-2h2v2zm2.07-7.75l-.9.92C13.45 12.9 13 13.5 13 15h-2v-.5c0-1.1.45-2.1 1.17-2.83l1.24-1.26c.37-.36.59-.86.59-1.41 0-1.1-.9-2-2-2s-2 .9-2 2H8c0-2.21 1.79-4 4-4s4 1.79 4 4c0 .88-.36 1.68-.93 2.25z"/></svg>
                        </div>
                        <div>
                            <h4 class="mb-1 text-dark fw-bold" style="font-size: 0.9rem;">Need Help?</h4>
                            <p class="text-secondary mb-0" style="font-size: 0.75rem;">Contact our support team for any assistance regarding your prize.</p>
                        </div>
                    </div>
                    <button class="btn btn-primary w-100 fw-semibold rounded-3 py-2 shadow-sm" style="font-size: 0.85rem;">Contact Support</button>
                </div>

            </div>
        </div>

        <!-- ========================================== -->
        <!-- RIGHT COLUMN: Detailed Information Cards   -->
        <!-- ========================================== -->
        <div class="col-12 col-lg-8">
            <div class="row g-3">
                
                <!-- Winner Information Card -->
                <div class="col-12 col-md-6">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden hover-card">
                        <div class="card-header bg-card-header border-0 py-3 d-flex align-items-center text-theme-green" style="background-color: aliceblue;">
                            <svg class="icon-svg me-2" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"></path></svg>
                            <h3 class="h6 mb-0 fw-bold" style="font-size: 0.9rem;">Winner Information</h3>
                        </div>
                        <div class="card-body d-flex justify-content-between p-4">
                            <div class="flex-grow-1 pe-2">
                                <div class="d-flex mb-3 align-items-start">
                                    <span class="list-label">Winner Name</span>
                                    <span class="list-value text-break">Ramesh Traders</span>
                                </div>
                                <div class="d-flex mb-3 align-items-center">
                                    <span class="list-label">Type</span>
                                    <span class="badge badge-orange px-2 py-1">Dealer</span>
                                </div>
                                <div class="d-flex mb-3 align-items-start">
                                    <span class="list-label">Dealer Code</span>
                                    <span class="list-value text-break">DLR001</span>
                                </div>
                                <div class="d-flex mb-3 align-items-start">
                                    <span class="list-label">Mobile Number</span>
                                    <span class="list-value text-break">+91 98765 43210</span>
                                </div>
                                <div class="d-flex align-items-start">
                                    <span class="list-label">Points Earned</span>
                                    <span class="list-value text-success fw-bold">1,250 pts</span>
                                </div>
                            </div>
                            <img src="https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?ixlib=rb-1.2.1&auto=format&fit=crop&w=150&q=80" alt="Profile" class="winner-img rounded-3 shadow-sm flex-shrink-0 border">
                        </div>
                    </div>
                </div>

                <!-- Prize Information Card -->
                <div class="col-12 col-md-6">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden hover-card">
                        <div class="card-header bg-card-header border-0 py-3 d-flex align-items-center text-theme-green" style="background-color: aliceblue;">
                            <svg class="icon-svg me-2" viewBox="0 0 24 24"><path d="M20 6h-2.18c.11-.31.18-.65.18-1 0-1.66-1.34-3-3-3-1.05 0-1.96.54-2.5 1.35l-.5.67-.5-.68C10.96 2.54 10.05 2 9 2 7.34 2 6 3.34 6 5c0 .35.07.69.18 1H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-5-2c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm11 15H4v-2h16v2zm0-5H4V8h5.08L7 10.83 8.62 12 11 8.76l1-1.36 1 1.36L15.38 12 17 10.83 14.92 8H20v6z"></path></svg>
                            <h3 class="h6 mb-0 fw-bold" style="font-size: 0.9rem;">Prize Information</h3>
                        </div>
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-center mb-4">
                                <img src="https://images.unsplash.com/photo-1595515106969-1ce29566ff1c?ixlib=rb-1.2.1&auto=format&fit=crop&w=300&q=80" alt="Prize Item" class="prize-img rounded-3 shadow-sm border">
                            </div>
                            <div class="d-flex mb-3 align-items-start">
                                <span class="list-label">Prize Name</span>
                                <span class="list-value">Single Door Wardrobe</span>
                            </div>
                            <div class="d-flex mb-3 align-items-start">
                                <span class="list-label">Prize Value</span>
                                <span class="list-value">₹9,999</span>
                            </div>
                            <div class="d-flex mb-3 align-items-center">
                                <span class="list-label">Status</span>
                                <span class="badge badge-green px-2 py-1">Prize Distributed</span>
                            </div>
                            <div class="d-flex align-items-start">
                                <span class="list-label">Distributed Date</span>
                                <span class="list-value">30 Apr 2026</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Scheme Information Card -->
                <div class="col-12 col-md-6">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden hover-card">
                        <div class="card-header bg-card-header border-0 py-3 d-flex align-items-center text-theme-green" style="background-color:aliceblue;">
                            <svg class="icon-svg me-2" viewBox="0 0 24 24"><path d="M19 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-9 14l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
                            <h3 class="h6 mb-0 fw-bold" style="font-size: 0.9rem;">Scheme Information</h3>
                        </div>
                        <div class="card-body p-4">
                            <div class="d-flex mb-3 align-items-start">
                                <span class="list-label">Scheme Name</span>
                                <span class="list-value">Summer Bonus 2026</span>
                            </div>
                            <div class="d-flex mb-3 align-items-start">
                                <span class="list-label">Scheme Duration</span>
                                <span class="list-value">01 Feb 2026 - 31 Mar 2026</span>
                            </div>
                            <div class="d-flex mb-3 align-items-start">
                                <span class="list-label">Applicable State</span>
                                <span class="list-value">Tamil Nadu</span>
                            </div>
                            <div class="d-flex mb-3 align-items-start">
                                <span class="list-label">Draw Date</span>
                                <span class="list-value">24 Apr 2026</span>
                            </div>
                            <div class="d-flex align-items-start">
                                <span class="list-label">Selection Method</span>
                                <span class="list-value">Lucky Draw</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Activity Information Card -->
                <div class="col-12 col-md-6">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden hover-card">
                        <div class="card-header bg-card-header border-0 py-3 d-flex align-items-center text-theme-green" style="background-color: aliceblue;">
                            <svg class="icon-svg me-2" viewBox="0 0 24 24"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg>
                            <h3 class="h6 mb-0 fw-bold" style="font-size: 0.9rem;">Activity Information</h3>
                        </div>
                        <div class="card-body p-4">
                            <div class="d-flex mb-3 align-items-start">
                                <span class="list-label">Announced By</span>
                                <span class="list-value">SPIC Admin</span>
                            </div>
                            <div class="d-flex align-items-start">
                                <span class="list-label">Announced Date</span>
                                <span class="list-value">24 Apr 2026, 11:30 AM</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ✅ NEW: Better Luck Next Time Card -->
                <div class="col-12">
                    <div class="card border-0 rounded-4 overflow-hidden hover-card shadow-sm" style="background-color: #fff8f0; border: 1px solid #fde8cc !important;">
                        <div class="card-body p-4 d-flex align-items-center justify-content-between gap-3">
                            <div class="d-flex align-items-center gap-3 flex-grow-1">
                                <!-- Icon -->
                                <div class="flex-shrink-0 d-flex align-items-center justify-content-center rounded-3" style="width: 44px; height: 44px; background-color: #fde8cc;">
                                    <svg style="width:22px;height:22px;fill:#e07b1a;" viewBox="0 0 24 24"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm3.5-9c.83 0 1.5-.67 1.5-1.5S16.33 8 15.5 8 14 8.67 14 9.5s.67 1.5 1.5 1.5zm-7 0c.83 0 1.5-.67 1.5-1.5S9.33 8 8.5 8 7 8.67 7 9.5 7.67 11 8.5 11zm3.5 5c2.33 0 4.31-1.46 5.11-3.5H6.89c.8 2.04 2.78 3.5 5.11 3.5z"/></svg>
                                </div>
                                <!-- Text -->
                                <div>
                                    <div class="fw-bold mb-1" style="font-size: 0.9rem; color: #b85c00;">Better Luck Next Time!</div>
                                    <div class="text-secondary" style="font-size: 0.78rem; line-height: 1.4;">Keep participating to unlock more entries and increase your chances to win.</div>
                                </div>
                            </div>
                            <!-- Gift Illustration -->
                            <img src="https://cdn-icons-png.flaticon.com/512/4213/4213958.png" alt="Gift" style="width: 60px; height: 60px; object-fit: contain; flex-shrink: 0;">
                        </div>
                        <!-- Action Buttons -->
                        <div class="px-4 pb-4 d-flex flex-column gap-2">
                            <button class="btn fw-semibold rounded-3 py-2 w-100 d-flex align-items-center justify-content-center gap-2 shadow-sm" style="background-color: #2563eb; color: #fff; font-size: 0.9rem;">
                                <svg style="width:18px;height:18px;fill:#fff;" viewBox="0 0 24 24"><path d="M3 11h8V3H3v8zm2-6h4v4H5V5zm8-2v8h8V3h-8zm6 6h-4V5h4v4zM3 21h8v-8H3v8zm2-6h4v4H5v-4zm13 1h-2v2h-2v-2h-2v-2h2v-2h2v2h2v2zm0 4h-2v-2h2v2zm2 0h-2v-2h2v2z"/></svg>
                                Scan QR
                            </button>
                            <button class="btn fw-semibold rounded-3 py-2 w-100" style="background: transparent; color: #555; font-size: 0.85rem; border: none;">
                                View Entries
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Help Section (Visible ONLY on Mobile/Tablet at the bottom) -->
                <div class="col-12 d-block d-lg-none mt-2">
                    <div class="card border-0 bg-white rounded-4 p-3 shadow-sm hover-card">
                        <div class="d-flex align-items-start mb-3">
                            <div class="bg-card-header rounded-3 d-flex align-items-center justify-content-center me-3 flex-shrink-0" style="width: 40px; height: 40px;">
                                <svg class="icon-svg text-theme-green" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 17h-2v-2h2v2zm2.07-7.75l-.9.92C13.45 12.9 13 13.5 13 15h-2v-.5c0-1.1.45-2.1 1.17-2.83l1.24-1.26c.37-.36.59-.86.59-1.41 0-1.1-.9-2-2-2s-2 .9-2 2H8c0-2.21 1.79-4 4-4s4 1.79 4 4c0 .88-.36 1.68-.93 2.25z"/></svg>
                            </div>
                            <div>
                                <h4 class="mb-1 text-dark fw-bold" style="font-size: 0.85rem;">Need Help?</h4>
                                <p class="text-secondary mb-0" style="font-size: 0.75rem;">Contact our support team for any assistance.</p>
                            </div>
                        </div>
                        <button class="btn btn-primary w-100 fw-semibold rounded-3 py-2 shadow-sm" style="font-size: 0.85rem;">Contact Support</button>
                    </div>
                </div>

            </div>
        </div>

    </div>
</div>


