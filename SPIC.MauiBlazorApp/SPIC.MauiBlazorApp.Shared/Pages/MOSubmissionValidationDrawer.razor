                                <span class="csr-pd-pill csr-pd-pill-green">Wheat</span>
                                <span class="csr-pd-pill csr-pd-pill-green">Sugarcane</span>
                            </div>
                        </div>
                        <div class="csr-pd-stack-row">
                            <span class="csr-pd-label">Focused Products:</span>
                            <div class="csr-pd-pill-group">
                                <span class="csr-pd-pill csr-pd-pill-blue">Insecticide A</span>
                                <span class="csr-pd-pill csr-pd-pill-blue">Fungicide B</span>
                                <span class="csr-pd-pill csr-pd-pill-blue">Herbicide C</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="csr-pd-section">
                    <h3>Expense Breakdown</h3>
                    <div class="csr-pd-table-container">
                        <table class="csr-pd-expense-table">
                            <thead>
                                <tr>
                                    <th>Category</th>
                                    <th>APPROVED</th>
                                    <th>Actual</th>
                                    <th>Variance</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Train & Capacity Building</td>
                                    <td>₹ 2,50,000</td>
                                    <td>₹ 2,50,000</td>
                                    <td class="text-green">₹ 5,000</td>
                                    <td>
                                        <button class="csr-pd-icon-btn text-blue" aria-label="Download">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                                        </button>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Equipment & Machinery</td>
                                    <td>₹ 2,50,000</td>
                                    <td>₹ 2,50,000</td>
                                    <td class="text-red">+ ₹ 20,000</td>
                                    <td>
                                        <button class="csr-pd-icon-btn text-blue" aria-label="Download">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                                        </button>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Seeds & Inputs</td>
                                    <td>₹ 2,50,000</td>
                                    <td>₹ 2,50,000</td>
                                    <td class="text-green">₹ 5,000</td>
                                    <td>
                                        <button class="csr-pd-icon-btn text-blue" aria-label="Download">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                                        </button>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Infrastructure Development</td>
                                    <td>₹ 2,50,000</td>
                                    <td>₹ 2,50,000</td>
                                    <td class="text-red">₹ 30,000</td>
                                    <td>
                                        <button class="csr-pd-icon-btn text-blue" aria-label="Download">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                                        </button>
                                    </td>
                                </tr>
                                <tr>
