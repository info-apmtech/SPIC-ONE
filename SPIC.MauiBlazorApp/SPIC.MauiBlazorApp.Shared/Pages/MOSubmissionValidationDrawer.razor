@if (IsOpen)
{
    <div class="csr-pd-overlay" @onclick="CloseDrawer">
        <div class="csr-pd-drawer" @onclick:stopPropagation="true">
            
            <div class="csr-pd-header">
                <div class="csr-pd-header-titles">
                    <h2>CSR-2 Program Details</h2>
                    <p>Crop Protection Workshop</p>
                </div>
                <button class="csr-pd-close-icon" @onclick="CloseDrawer" aria-label="Close">
