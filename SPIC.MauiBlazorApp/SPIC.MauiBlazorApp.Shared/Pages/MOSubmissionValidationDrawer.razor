                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>

            <div class="csr-pd-body">
                
                <div class="csr-pd-section">
                    <h3>Program Information</h3>
                    <div class="csr-pd-info-box">
