                            <div class="data-row"><div class="data-label">Region</div><div class="data-value">@(_regionName ?? (_dealer != null ? _dealer.Region.ToString() : "-"))</div></div>
                            <div class="data-row"><div class="data-label">HQ</div><div class="data-value">@(_hqName ?? (_dealer != null ? _dealer.HQ.ToString() : "-"))</div></div>
