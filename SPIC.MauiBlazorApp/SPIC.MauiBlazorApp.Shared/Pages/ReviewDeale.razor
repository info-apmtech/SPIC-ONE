        margin-bottom: 4px;
    }
    .kpi-value {
        font-size: 0.85rem;
        color: #1F2937;
        font-weight: 700;
    }

    /* KPI Colors */
    .bg-yellow { background-color: #FEF3C7; color: #D97706; }
    .bg-blue { background-color: #E0F2FE; color: #2563EB; }
    .bg-pink { background-color: #FCE7F3; color: #DB2777; }
    .bg-green { background-color: #D1FAE5; color: #059669; }
    .bg-indigo { background-color: #E0E7FF; color: #4F46E5; }
    .bg-orange { background-color: #FFEDD5; color: #EA580C; }

    /* --- Accordions --- */
    .custom-accordion {
        background-color: #ffffff;
        border: 1px solid #E5E7EB;
        border-radius: 12px;
        margin-bottom: 12px;
        overflow: hidden;
        box-shadow: 0 1px 2px rgba(0,0,0,0.02);
        transition: all 0.3s ease;
    }
    .custom-accordion.active {
        border-left: 4px solid #059669; /* Green active border */
    }
    .accordion-header {
        padding: 16px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-weight: 700;
        color: #1F2937;
        font-size: 0.95rem;
        cursor: pointer;
        user-select: none;
    }
    .accordion-header i {
        color: #9CA3AF;
        transition: transform 0.3s ease;
    }
    .custom-accordion.active .accordion-header i {
        transform: rotate(180deg);
    }
    
    .accordion-body {
        padding: 24px;
        background-color: #F8FAFC; 
        border-top: 1px solid #E5E7EB;
        display: none; 
    }
    .custom-accordion.active .accordion-body {
        display: block; 
    }

    /* --- Inner Detail Cards --- */
    .detail-card {
        background-color: #ffffff;
        border: 1px solid #E5E7EB;
        border-radius: 12px;
        overflow: hidden;
        height: 100%;
    }
    .detail-card-header {
        background-color: #ECFDF5; /* Light green */
        padding: 12px 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #D1FAE5;
    }
    .detail-card-title {
        font-size: 0.85rem;
        font-weight: 700;
        color: #065F46;
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0;
    }
    .detail-card-title i { font-size: 1rem; }
    .edit-icon {
        color: #059669;
        font-size: 1rem;
        cursor: pointer;
    }

    .detail-card-body {
        padding: 16px;
    }
    .data-row {
        display: flex;
        margin-bottom: 12px;
        align-items: flex-start;
    }
    .data-row:last-child {
        margin-bottom: 0;
    }
    .data-label {
        width: 40%;
        font-size: 0.75rem;
        color: #6B7280;
        font-weight: 500;
        padding-right: 12px;
    }
    .data-value {
        width: 60%;
        font-size: 0.75rem;
        color: #1F2937;
        font-weight: 600;
        word-break: break-word;
    }

    /* --- Table Specific Styles --- */
    .sales-table {
        width: 100%;
        border-collapse: collapse;
        text-align: center;
    }
    .sales-table th {
        color: #065F46;
        font-weight: 600;
        font-size: 0.75rem;
        padding: 14px;
        border-bottom: 1px solid #E5E7EB;
        background-color: #ffffff;
    }
    .sales-table td {
        padding: 14px;
        font-size: 0.75rem;
        color: #4B5563;
        border-bottom: 1px solid #E5E7EB;
    }
    .sales-table tr:last-child td { border-bottom: none; }
    
    .grand-total-row {
        background: linear-gradient(to right, #D1FAE5, #A7F3D0);
        font-weight: 700;
    }
    .grand-total-row td {
        color: #065F46;
        font-weight: 700;
    }

    /* Additional Specific UI Elements */
    .company-pill {
        border: 1px solid #E5E7EB;
        border-radius: 8px;
        padding: 12px;
        text-align: center;
        font-size: 0.75rem;
        font-weight: 500;
        color: #4B5563;
        background-color: #ffffff;
    }
    .total-pill {
        background: linear-gradient(to right, #D1FAE5, #A7F3D0);
        color: #065F46;
        font-weight: 700;
        font-size: 0.8rem;
        padding: 12px 24px;
        border-radius: 8px;
        display: inline-block;
    }
    
    /* Enclosures Specific */
    .enclosure-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 12px;
        padding: 16px;
    }
    .enclosure-btn {
        background-color: #ffffff;
        border: 1px solid #E5E7EB;
        border-radius: 8px;
        padding: 10px 16px;
        font-size: 0.75rem;
        color: #4B5563;
        font-weight: 500;
        text-align: center;
        cursor: pointer;
        transition: 0.2s;
    }
    .enclosure-btn:hover {
        background-color: #F9FAFB;
        border-color: #D1D5DB;
    }

    /* --- Footer --- */
    .footer-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 24px;
        padding-top: 24px;
    }
    .btn-prev {
        background-color: transparent;
        color: #6B7280;
        border: none;
        font-size: 0.85rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 10px 0;
    }
    .btn-prev:hover { color: #1F2937; }
    
    .btn-submit {
        background-color: #3B82F6;
        color: #ffffff;
        border: none;
        font-size: 0.85rem;
        font-weight: 600;
        padding: 12px 24px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: 0.2s;
    }
    .btn-submit:hover { background-color: #2563EB; }
</style>

