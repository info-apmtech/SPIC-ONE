@page "/LocationMaster"
<div class="container-fluid">

	<h2 class="page-title">Location Master</h2>

	<div class="tabs-wrapper">
		<div class="tabs-container">
			<div class="tab-item @(ActiveTab == "Zones" ? "active" : "")" @onclick='() => SetActiveTab("Zones")'>Zones</div>
			<div class="tab-item @(ActiveTab == "States" ? "active" : "")" @onclick='() => SetActiveTab("States")'>States</div>
			<div class="tab-item @(ActiveTab == "Districts" ? "active" : "")" @onclick='() => SetActiveTab("Districts")'>Districts</div>
			<div class="tab-item @(ActiveTab == "Sub-Districts" ? "active" : "")" @onclick='() => SetActiveTab("Sub-Districts")'>Sub-Districts</div>
		</div>
	</div>

	<div class="main-card">
		<div class="section-header">
			<h3 class="section-title">Add New @ActiveTab</h3>
			<button class="btn-outline-green" style="
				width: 12%;">
				<i class="bi bi-cloud-arrow-up"></i> Bulk Upload
			</button>
		</div>

		<div class="row g-3 mb-4">
			<div class="col-md-3">
				<label class="form-lbl">@GetSingularName(ActiveTab) Name</label>
				<input type="text" class="form-control-custom w-100" placeholder="Enter @GetSingularName(ActiveTab) Name">
			</div>
			<div class="col-md-3">
				<label class="form-lbl">@GetSingularName(ActiveTab) Code</label>
				<input type="text" class="form-control-custom w-100" placeholder="Enter @GetSingularName(ActiveTab) Code">
			</div>
			<div class="col-md-4">
				<label class="form-lbl">Zone Color Code</label>
				<input type="text" class="form-control-custom w-100" placeholder="Color Code">
			</div>
			<div class="col-md-2" style="margin-top: 28px;">
				<div class="status-toggle-box">
					<span>Active</span>
					<label class="switch">
						<input type="checkbox" checked>
						<span class="slider"></span>
					</label>
				</div>
			</div>
		</div>

		<div class="d-flex justify-content-end pt-2">
			<button class="btn-cancel"><i class="bi bi-x"></i> Cancel</button>
			<button class="btn-save"><i class="bi bi-save"></i> Save</button>
		</div>
	</div>

	<div class="row g-3 mb-4">
		<div class="col-md-4">
			<div class="metric-card bg-blue-light">
				<div class="metric-header">
					<h4 class="metric-title">Total @ActiveTab</h4>
					<div class="metric-trend"><i class="bi bi-arrow-up-right"></i> 12% from last quarter</div>
				</div>
				<div class="metric-val">18</div>
			</div>
		</div>
		<div class="col-md-4">
			<div class="metric-card bg-mint-light">
				<div class="metric-header">
					<h4 class="metric-title">Active @ActiveTab</h4>
					<div class="metric-info"><i class="bi bi-exclamation-circle"></i> 6 pending review</div>
				</div>
				<div class="metric-val">24</div>
			</div>
		</div>
		<div class="col-md-4">
			<div class="metric-card bg-gray-light">
				<div class="metric-header">
					<h4 class="metric-title">Inactive @ActiveTab</h4>
					<div class="metric-info"><i class="bi bi-info-circle"></i></div>
				</div>
				<div class="metric-val">18</div>
			</div>
		</div>
	</div>

	<div class="main-card">
		<div class="section-header">
			<h3 class="section-title">Existing @ActiveTab</h3>
            
			<div class="table-controls">
				<div class="search-box">
					<i class="bi bi-search"></i>
					<input type="text" placeholder="Search @ActiveTab.ToLower()...">
				</div>
				<select class="filter-select">
					<option>All Status</option>
					@* <option>Active</option>
					<option>Inactive</option> *@
				</select>
				@*   <div class="view-toggle">
                    <button class="view-btn"><i class="bi bi-grid"></i> Card View</button>
                    <button class="view-btn active"><i class="bi bi-list-ul"></i> List View</button>
                </div> *@
			</div>
		</div>

		<div class="table-wrapper">
			<div class="table-responsive">
				<table class="spic-table">
					<thead>
						<tr>
							<th style="width: 80px;">S:No</th>
							<th>@GetSingularName(ActiveTab) Name</th>
							<th>@GetSingularName(ActiveTab) ID</th>
							<th>Status</th>
							<th>Created At</th>
							<th class="text-center">Action</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td class="text-muted">1</td>
							<td><span class="color-dot dot-blue"></span>East @GetSingularName(ActiveTab)</td>
							<td>10</td>
							<td><span class="status-pill status-active">Active</span></td>
							<td>2024-03-15</td>
							<td>
								<div class="action-icons">
									<i class="bi bi-trash icon-del"></i>
									<i class="bi bi-pencil-square icon-edit"></i>
								</div>
							</td>
						</tr>
						<tr>
							<td class="text-muted">2</td>
							<td><span class="color-dot dot-purple"></span>North @GetSingularName(ActiveTab)</td>
							<td>10</td>
							<td><span class="status-pill status-active">Active</span></td>
							<td>2024-03-15</td>
							<td>
								<div class="action-icons">
									<i class="bi bi-trash icon-del"></i>
									<i class="bi bi-pencil-square icon-edit"></i>
								</div>
							</td>
						</tr>
						<tr>
							<td class="text-muted">3</td>
							<td><span class="color-dot dot-purple"></span>South @GetSingularName(ActiveTab)</td>
							<td>10</td>
							<td><span class="status-pill status-inactive">Inactive</span></td>
							<td>2024-03-15</td>
							<td>
								<div class="action-icons">
									<i class="bi bi-trash icon-del"></i>
									<i class="bi bi-pencil-square icon-edit"></i>
								</div>
							</td>
						</tr>
						<tr>
							<td class="text-muted">4</td>
							<td><span class="color-dot dot-orange"></span>West @GetSingularName(ActiveTab)</td>
							<td>10</td>
							<td><span class="status-pill status-active">Active</span></td>
							<td>2024-03-15</td>
							<td>
								<div class="action-icons">
									<i class="bi bi-trash icon-del"></i>
									<i class="bi bi-pencil-square icon-edit"></i>
								</div>
							</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		<div class="pagination-container">
			<div class="items-per-page">
				Items Per Page
				<select>
					<option>16</option>
					<option>32</option>
					<option>50</option>
				</select>
			</div>
            
			<div class="pagination-controls">
				<div class="page-btn"><i class="bi bi-chevron-left"></i></div>
				<div class="page-btn active">1</div>
				<div class="page-btn">2</div>
				<div class="page-btn">3</div>
				<div class="page-btn ellipsis">...</div>
				<div class="page-btn">8</div>
				<div class="page-btn">9</div>
				<div class="page-btn">10</div>
				<div class="page-btn"><i class="bi bi-chevron-right"></i></div>
			</div>
		</div>

	</div>

</div>

@code {
	// State to keep track of the selected tab
	private string ActiveTab { get; set; } = "Zones";

	// Method to switch tabs
	private void SetActiveTab(string tabName)
	{
		ActiveTab = tabName;
	}

	// Helper method to remove the 's' for singular column headers/labels
	private string GetSingularName(string pluralName)
	{
		if (pluralName.EndsWith("s"))
		{
			return pluralName.Substring(0, pluralName.Length - 1);
		}
		return pluralName;
	}
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

