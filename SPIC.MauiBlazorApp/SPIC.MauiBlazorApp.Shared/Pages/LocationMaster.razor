@page "/LocationMaster"
@using System.Net.Http.Json
@using System.Text.Json
@inject HttpClient Http
@inject IJSRuntime JS

<div class="container-fluid">

	<h2 class="page-title">Location Master</h2>

	@if (!string.IsNullOrEmpty(_message))
	{
		<div class="alert @(_isError ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
			@_message
			<button type="button" class="btn-close" @onclick="() => _message = null"></button>
		</div>
	}

	<div class="tabs-wrapper">
		<div class="tabs-container">
			@foreach (var tab in TabOptions)
			{
				<div class="tab-item @(ActiveTab == tab ? "active" : "")" @onclick="() => SetActiveTab(tab)">
					@tab
				</div>
			}
		</div>
	</div>

	<div class="main-card">
		<div class="section-header">
			<h3 class="section-title">@(_isEditing ? $"Edit {GetSingularName(ActiveTab)}" : $"Add New {GetSingularName(ActiveTab)}")</h3>
			<button class="btn-outline-green" style="width: 12%;" @onclick="() => _showUploadModal = true">
				<i class="bi bi-cloud-arrow-up"></i> Bulk Upload
			</button>
		</div>

		<div class="row g-3 mb-4">
			@if (ActiveTab == "Zones")
			{
				<div class="col-md-3">
					<label class="form-label-custom">Zone Name</label>
					<input type="text" class="form-control-custom w-100" placeholder="Enter Zone Name"
						   @bind="_zoneForm.ZoneName" @ref="_firstInputRef" />
				</div>
				<div class="col-md-3">
					<label class="form-label-custom">Zone Code</label>
					<input type="text" class="form-control-custom w-100" placeholder="Enter Zone Code"
						   @bind="_zoneForm.ZoneCode" />
				</div>
				<div class="col-md-4">
					<label class="form-label-custom">Zone Color Code</label>
					<div class="color-picker-wrapper">
						<input type="color" class="color-picker-input"
							   value="@(_zoneForm.ZoneColorCode ?? "#3B82F6")"
							   @onchange="OnColorChanged" />
						<input type="text" class="form-control-custom color-picker-text"
							   placeholder="#3B82F6"
							   @bind="_zoneForm.ZoneColorCode" />
					</div>
				</div>
			}
			else if (ActiveTab == "States")
			{
				<div class="col-md-4">
					<label class="form-label-custom">State Name</label>
					<input type="text" class="form-control-custom w-100" placeholder="Enter State Name"
						   @bind="_stateForm.StateName" @ref="_firstInputRef" />
				</div>
				<div class="col-md-4">
					<label class="form-label-custom">Zone</label>
					<select class="form-control-custom w-100" @bind="_stateForm.ZoneId">
						<option value="0">Select Zone</option>
						@foreach (var z in _zonesAll)
						{
							<option value="@z.Id">@z.ZoneName</option>
						}
					</select>
				</div>
			}
			else if (ActiveTab == "Districts")
			{
				<div class="col-md-4">
					<label class="form-label-custom">District Name</label>
					<input type="text" class="form-control-custom w-100" placeholder="Enter District Name"
						   @bind="_districtForm.DistrictName" @ref="_firstInputRef" />
				</div>
				<div class="col-md-4">
					<label class="form-label-custom">State</label>
					<select class="form-control-custom w-100" @bind="_districtForm.StateId">
						<option value="0">Select State</option>
						@foreach (var s in _statesAll)
						{
							<option value="@s.Id">@s.StateName</option>
						}
					</select>
				</div>
			}
			else if (ActiveTab == "Sub-Districts")
			{
				<div class="col-md-3">
					<label class="form-label-custom">Sub-District Name</label>
					<input type="text" class="form-control-custom w-100" placeholder="Enter Sub-District Name"
						   @bind="_subDistrictForm.SubDistrictName" @ref="_firstInputRef" />
				</div>
				<div class="col-md-3">
					<label class="form-label-custom">State</label>
					<select class="form-control-custom w-100" @bind="_subDistrictSelectedStateId" @bind:after="OnSubDistrictStateChanged">
						<option value="0">Select State</option>
						@foreach (var s in _statesAll)
						{
							<option value="@s.Id">@s.StateName</option>
						}
					</select>
				</div>
				<div class="col-md-3">
					<label class="form-label-custom">District</label>
					<select class="form-control-custom w-100" @bind="_subDistrictForm.DistrictId">
						<option value="0">Select District</option>
						@foreach (var d in _subDistrictFilteredDistricts)
						{
							<option value="@d.Id">@d.DistrictName</option>
						}
					</select>
				</div>
			}
			else if (ActiveTab == "Regions")
			{
				<div class="col-md-4">
					<label class="form-label-custom">Region Name</label>
					<input type="text" class="form-control-custom w-100" placeholder="Enter Region Name"
						   @bind="_regionForm.RegionName" @ref="_firstInputRef" />
				</div>
				<div class="col-md-4">
					<label class="form-label-custom">State</label>
					<select class="form-control-custom w-100" @bind="_regionForm.StateId">
						<option value="0">Select State</option>
						@foreach (var s in _statesAll)
						{
							<option value="@s.Id">@s.StateName</option>
						}
					</select>
				</div>
			}
			else if (ActiveTab == "Headquarters")
			{
				<div class="col-md-4">
					<label class="form-label-custom">Headquarter Name</label>
					<input type="text" class="form-control-custom w-100" placeholder="Enter Headquarter Name"
						   @bind="_headquarterForm.HeadquarterName" @ref="_firstInputRef" />
				</div>
				<div class="col-md-4">
					<label class="form-label-custom">Region</label>
					<select class="form-control-custom w-100" @bind="_headquarterForm.RegionId">
						<option value="0">Select Region</option>
						@foreach (var r in _regionsAll)
						{
							<option value="@r.Id">@r.RegionName</option>
						}
					</select>
				</div>
			}

			<div class="col-md-2" style="margin-top: 28px;">
				<div class="status-toggle-box @(CurrentFormIsActive ? "" : "status-toggle-inactive")">
					<span>@(CurrentFormIsActive ? "Active" : "Inactive")</span>
					<label class="switch">
						@if (ActiveTab == "Zones")
						{
							<input type="checkbox" @bind="_zoneForm.IsActive">
						}
						else if (ActiveTab == "States")
						{
							<input type="checkbox" @bind="_stateForm.IsActive">
						}
						else if (ActiveTab == "Districts")
						{
							<input type="checkbox" @bind="_districtForm.IsActive">
						}
						else if (ActiveTab == "Regions")
						{
							<input type="checkbox" @bind="_regionForm.IsActive">
						}
						else if (ActiveTab == "Headquarters")
						{
							<input type="checkbox" @bind="_headquarterForm.IsActive">
						}
						else
						{
							<input type="checkbox" @bind="_subDistrictForm.IsActive">
						}
						<span class="slider"></span>
					</label>
				</div>
			</div>
		</div>

		<div class="d-flex justify-content-end pt-2 mt-4">
			<button class="btn-cancel mt-3" @onclick="ResetForm"><i class="bi bi-x"></i> Cancel</button>
			<button class="btn-save mt-3" @onclick="HandleSave" disabled="@_isSaving">
				<i class="bi bi-save"></i> @(_isSaving ? "Saving..." : "Save")
			</button>
		</div>
	</div>

	<div class="row g-3 mb-4">
		<div class="col-md-4">
			<div class="metric-card bg-blue-light">
				<div class="metric-header">
					<h4 class="metric-title">Total @ActiveTab</h4>
				</div>
				<div class="metric-val">@CurrentAllItems.Count</div>
			</div>
		</div>
		<div class="col-md-4">
			<div class="metric-card bg-mint-light">
				<div class="metric-header">
					<h4 class="metric-title">Active</h4>
				</div>
				<div class="metric-val">@CurrentAllItems.Count(x => x.IsActive)</div>
			</div>
		</div>
		<div class="col-md-4">
			<div class="metric-card bg-gray-light">
				<div class="metric-header">
					<h4 class="metric-title">Inactive</h4>
				</div>
				<div class="metric-val">@CurrentAllItems.Count(x => !x.IsActive)</div>
			</div>
		</div>
	</div>

	<SpicDataTable Items="_filteredItems" 
				   IsLoading="_isLoading" 
				   Title="@($"Existing {ActiveTab}")" 
				   FileName="@ActiveTab" 
				   ExportColumns="GetExportColumns()">

		<FilterControls>
			<div class="search-box">
				<i class="bi bi-search"></i>
				<input type="text" placeholder="Search @ActiveTab.ToLower()..." @bind="_searchText" @bind:event="oninput" @bind:after="ApplyFilter">
			</div>
			<select class="filter-select" @bind="_statusFilter" @bind:after="ApplyFilter">
				<option value="All">All Status</option>
				<option value="Active">Active</option>
				<option value="Inactive">Inactive</option>
			</select>
		</FilterControls>

		<TableHeader>
			<th>@GetSingularName(ActiveTab) Name</th>

			@if (ActiveTab == "Zones")
			{
				<th>Zone Code</th>
				<th>Color</th>
			}
			else if (ActiveTab == "States")
			{
				<th>Zone</th>
			}
			else if (ActiveTab == "Districts")
			{
				<th>State</th>
			}
			else if (ActiveTab == "Sub-Districts")
			{
				<th>District</th>
			}
			else if (ActiveTab == "Regions")
			{
				<th>State</th>
			}
			else if (ActiveTab == "Headquarters")
			{
				<th>Region</th>
			}

			<th>Status</th>
			<th>Created At</th>
			<th>Action</th>
		</TableHeader>

		<TableRow Context="item">
			<td>
				@if (ActiveTab == "Zones" && !string.IsNullOrEmpty(item.ZoneColorCode))
				{
					<span class="color-dot" style="background-color: @item.ZoneColorCode;"></span>
				}
				@item.Name
			</td>

			@if (ActiveTab == "Zones")
			{
				<td>@item.ZoneCode</td>
				<td>
					@if (!string.IsNullOrEmpty(item.ZoneColorCode))
					{
						<span class="color-dot" style="background-color: @item.ZoneColorCode;"></span>
						@item.ZoneColorCode
					}
				</td>
			}
			else if (ActiveTab == "States")
			{
				<td>@GetZoneName(item.ZoneId)</td>
			}
			else if (ActiveTab == "Districts")
			{
				<td>@GetStateName(item.StateId)</td>
			}
			else if (ActiveTab == "Sub-Districts")
			{
				<td>@GetDistrictName(item.DistrictId)</td>
			}
			else if (ActiveTab == "Regions")
			{
				<td>@GetStateName(item.StateId)</td>
			}
			else if (ActiveTab == "Headquarters")
			{
				<td>@GetRegionName(item.RegionId)</td>
			}

			<td>
				<span class="status-pill @(item.IsActive ? "status-active" : "status-inactive")"
					  style="cursor:pointer"
					  @onclick="() => ToggleStatus(item)">
					@(item.IsActive ? "Active" : "Inactive")
				</span>
			</td>
			<td>@item.CreatedAt.ToString("yyyy-MM-dd")</td>
			<td>
				<div class="action-icons">
					<i class="bi bi-trash icon-del" @onclick="() => DeleteItem(item)"></i>
					<i class="bi bi-pencil-square icon-edit" @onclick="() => EditItem(item)"></i>
				</div>
			</td>
		</TableRow>
	</SpicDataTable>

</div>

@if (_showDeleteConfirm)
{
	<div class="modal-backdrop fade show"></div>
	<div class="modal fade show d-block" tabindex="-1" role="dialog">
		<div class="modal-dialog modal-dialog-centered" role="document">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title">@(_dependencyWarnings.Any() ? "Cannot Delete" : "Confirm Delete")</h5>
					<button type="button" class="btn-close" @onclick="CancelDelete"></button>
				</div>
				<div class="modal-body">
					@if (_dependencyWarnings.Any())
					{
						<div class="alert alert-warning mb-0">
							<p class="mb-2"><strong>@_deleteTarget?.Name</strong> cannot be deleted because it is mapped to the following:</p>
							<ul class="mb-2" style="font-size: 0.9rem;">
								@foreach (var warning in _dependencyWarnings)
								{
									<li>@warning</li>
								}
							</ul>
							<p class="mb-0 text-muted" style="font-size: 0.85rem;">Please remove or reassign these mappings first.</p>
						</div>
					}
					else
					{
						<p>Are you sure you want to delete <strong>@_deleteTarget?.Name</strong>?</p>
						<p class="text-muted mb-0">This action cannot be undone.</p>
					}
				</div>
				<div class="modal-footer">
					<button class="btn btn-secondary" @onclick="CancelDelete">
						@(_dependencyWarnings.Any() ? "Close" : "Cancel")
					</button>
					
					@if (!_dependencyWarnings.Any())
					{
						<button class="btn btn-danger" @onclick="ConfirmDelete" disabled="@_isDeleting">
							@(_isDeleting ? "Deleting..." : "Delete")
						</button>
					}
				</div>
			</div>
		</div>
	</div>
}

@if (_showUploadModal)
{
	<div class="modal-backdrop fade show"></div>
	<div class="modal fade show d-block" tabindex="-1" role="dialog">
		<div class="modal-dialog modal-dialog-centered" role="document">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title">Bulk Upload - @ActiveTab</h5>
					<button type="button" class="btn-close" @onclick="() => _showUploadModal = false"></button>
				</div>
				<div class="modal-body">
					<InputFile OnChange="OnBulkFileSelected" accept=".xlsx,.xls" />
					<div class="upload-result" style="margin-top: 12px;">
						@if (_isUploading)
						{
							<div class="d-flex align-items-center gap-2 text-muted">
								<span class="spinner-border spinner-border-sm"></span>
								<span>Uploading, please wait...</span>
							</div>
						}
						else if (!string.IsNullOrEmpty(_uploadResult))
						{
							<div class="alert @(_uploadSuccess ? (_groupedErrors.Count > 0 ? "alert-warning" : "alert-success") : "alert-danger") mb-2 py-2">
								@_uploadResult
							</div>
							@if (_groupedErrors.Count > 0)
							{
								<div style="border: 1px solid #dee2e6; border-radius: 4px; padding: 8px;">
									<div class="d-flex justify-content-between align-items-center mb-2">
										<small class="text-muted fw-semibold">@(_uploadSuccess ? "Skipped Groups:" : "Issues:")</small>
										<button class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size: 0.75rem;"
												@onclick="CopyUploadErrors" title="Copy all errors to clipboard">
											@if (_errorsCopied)
											{
												<i class="bi bi-check2"></i> <span>Copied!</span>
											}
											else
											{
												<i class="bi bi-clipboard"></i> <span>Copy</span>
											}
										</button>
									</div>
									<div style="max-height: 280px; overflow-y: auto;">
										@foreach (var group in _groupedErrors)
										{
											<div class="mb-2">
												<div style="font-size: 0.82rem;">
													<span class="badge bg-secondary me-1">@group.Value.Count</span>
													<strong>@group.Key</strong>
												</div>
												<ul class="mb-0 ps-3 mt-1" style="font-size: 0.8rem; color: #555;">
													@foreach (var item in group.Value)
													{
														<li>@item</li>
													}
												</ul>
											</div>
										}
									</div>
								</div>
							}
						}
					</div>
				</div>
			</div>
		</div>
	</div>
}

@code {
	private readonly List<string> TabOptions = ["Zones", "States", "Districts", "Sub-Districts", "Regions", "Headquarters"];

	// Element reference for focusing
	private ElementReference _firstInputRef;

	// Tab state
	private string ActiveTab { get; set; } = "Zones";
	private string CurrentApiBase => ActiveTab switch
	{
		"Zones" => "api/Zone",
		"States" => "api/State",
		"Districts" => "api/District",
		"Sub-Districts" => "api/SubDistrict",
		"Regions" => "api/Region",
		"Headquarters" => "api/Headquarter",
		_ => ""
	};

	// Upload modal state
	private bool _showUploadModal = false;
	private bool _isUploading = false;
	private string _uploadResult = string.Empty;
	private bool _uploadSuccess = false;
	private Dictionary<string, List<string>> _groupedErrors = new();
	private bool _errorsCopied = false;

	// Data per tab
	private List<LocationItemDto> _zonesAll = new();
	private List<LocationItemDto> _statesAll = new();
	private List<LocationItemDto> _districtsAll = new();
	private List<LocationItemDto> _subDistrictsAll = new();
	private List<LocationItemDto> _regionsAll = new();
	private List<LocationItemDto> _headquartersAll = new();
	private List<LocationItemDto> _filteredItems = new();

	private List<LocationItemDto> CurrentAllItems => ActiveTab switch
	{
		"Zones" => _zonesAll,
		"States" => _statesAll,
		"Districts" => _districtsAll,
		"Sub-Districts" => _subDistrictsAll,
		"Regions" => _regionsAll,
		"Headquarters" => _headquartersAll,
		_ => new()
	};

	// Forms
	private ZoneFormModel _zoneForm = new();
	private StateFormModel _stateForm = new();
	private DistrictFormModel _districtForm = new();
	private SubDistrictFormModel _subDistrictForm = new();
	private RegionFormModel _regionForm = new();
	private HeadquarterFormModel _headquarterForm = new();
	private int _subDistrictSelectedStateId;
	private List<LocationItemDto> _subDistrictFilteredDistricts = new();
	private bool _isEditing;
	private int? _editingId;

	private bool CurrentFormIsActive => ActiveTab switch
	{
		"Zones" => _zoneForm.IsActive,
		"States" => _stateForm.IsActive,
		"Districts" => _districtForm.IsActive,
		"Sub-Districts" => _subDistrictForm.IsActive,
		"Regions" => _regionForm.IsActive,
		"Headquarters" => _headquarterForm.IsActive,
		_ => true
	};

	// UI state
	private bool _isLoading = true;
	private bool _isSaving;
	private string? _message;
	private bool _isError;

	// Delete confirmation
	private bool _showDeleteConfirm;
	private bool _isDeleting;
	private LocationItemDto? _deleteTarget;
	private List<string> _dependencyWarnings = new();

	// Search & filter
	private string _searchText = "";
	private string _statusFilter = "All";

	protected override async Task OnInitializedAsync()
	{
		try
		{
			var token = await JS.InvokeAsync<string>("sessionStorage.getItem", "jwt_token");
			if (!string.IsNullOrEmpty(token))
			{
				var uid = GetUserIdFromToken(token);
				if (!string.IsNullOrEmpty(uid)) _currentUserId = uid;
			}
		}
		catch { }

		await LoadAllLookups();
		ApplyFilter();
		_isLoading = false;
	}

	private async Task LoadAllLookups()
	{
		try
		{
			_isLoading = true;
			_zonesAll = await Http.GetFromJsonAsync<List<LocationItemDto>>("api/Zone/all") ?? new();
			_statesAll = await Http.GetFromJsonAsync<List<LocationItemDto>>("api/State/all") ?? new();
			_districtsAll = await Http.GetFromJsonAsync<List<LocationItemDto>>("api/District/all") ?? new();
			_subDistrictsAll = await Http.GetFromJsonAsync<List<LocationItemDto>>("api/SubDistrict/all") ?? new();
			_regionsAll = await Http.GetFromJsonAsync<List<LocationItemDto>>("api/Region/all") ?? new();
			_headquartersAll = await Http.GetFromJsonAsync<List<LocationItemDto>>("api/Headquarter/all") ?? new();
		}
		catch (Exception ex)
		{
			ShowMessage($"Failed to load: {ex.Message}", true);
		}
	}

	private async Task LoadTabData()
	{
		try
		{
			_isLoading = true;
			var items = await Http.GetFromJsonAsync<List<LocationItemDto>>($"{CurrentApiBase}/all") ?? new();

			switch (ActiveTab)
			{
				case "Zones": _zonesAll = items; break;
				case "States": _statesAll = items; break;
				case "Districts": _districtsAll = items; break;
				case "Sub-Districts": _subDistrictsAll = items; break;
				case "Regions": _regionsAll = items; break;
				case "Headquarters": _headquartersAll = items; break;
			}

			ApplyFilter();
		}
		catch (Exception ex)
		{
			ShowMessage($"Failed to load: {ex.Message}", true);
		}
		finally
		{
			_isLoading = false;
		}
	}

	private async Task SetActiveTab(string tabName)
	{
		if (ActiveTab == tabName) return;
		ActiveTab = tabName;
		_searchText = "";
		_statusFilter = "All";
		ResetForm();
		ApplyFilter();
	}

	private List<ExportColumn<LocationItemDto>> GetExportColumns()
	{
		var cols = new List<ExportColumn<LocationItemDto>>
		{
			new ExportColumn<LocationItemDto> { Header = "S:No", ValueSelector = item => (_filteredItems.IndexOf(item) + 1).ToString() },
			new ExportColumn<LocationItemDto> { Header = $"{GetSingularName(ActiveTab)} Name", ValueSelector = item => item.Name }
		};

		if (ActiveTab == "Zones")
		{
			cols.Add(new ExportColumn<LocationItemDto> { Header = "Zone Code", ValueSelector = item => item.ZoneCode ?? "" });
			cols.Add(new ExportColumn<LocationItemDto> { Header = "Color", ValueSelector = item => item.ZoneColorCode ?? "" });
		}
		else if (ActiveTab == "States")
			cols.Add(new ExportColumn<LocationItemDto> { Header = "Zone", ValueSelector = item => GetZoneName(item.ZoneId) });
		else if (ActiveTab == "Districts")
			cols.Add(new ExportColumn<LocationItemDto> { Header = "State", ValueSelector = item => GetStateName(item.StateId) });
		else if (ActiveTab == "Sub-Districts")
			cols.Add(new ExportColumn<LocationItemDto> { Header = "District", ValueSelector = item => GetDistrictName(item.DistrictId) });
		else if (ActiveTab == "Regions")
			cols.Add(new ExportColumn<LocationItemDto> { Header = "State", ValueSelector = item => GetStateName(item.StateId) });
		else if (ActiveTab == "Headquarters")
			cols.Add(new ExportColumn<LocationItemDto> { Header = "Region", ValueSelector = item => GetRegionName(item.RegionId) });

		cols.Add(new ExportColumn<LocationItemDto> { Header = "Status", ValueSelector = item => item.IsActive ? "Active" : "Inactive" });
		cols.Add(new ExportColumn<LocationItemDto> { Header = "Created At", ValueSelector = item => item.CreatedAt.ToString("yyyy-MM-dd") });

		return cols;
	}

	private void ApplyFilter()
	{
		_filteredItems = CurrentAllItems
			.Where(x => string.IsNullOrEmpty(_searchText)
				|| x.Name.Contains(_searchText, StringComparison.OrdinalIgnoreCase))
			.Where(x => _statusFilter switch
			{
				"Active" => x.IsActive,
				"Inactive" => !x.IsActive,
				_ => true
			})
			.OrderByDescending(x => x.CreatedAt)
			.ToList();
	}

	private async Task HandleSave()
	{
		var name = ActiveTab switch
		{
			"Zones" => _zoneForm.ZoneName,
			"States" => _stateForm.StateName,
			"Districts" => _districtForm.DistrictName,
			"Sub-Districts" => _subDistrictForm.SubDistrictName,
			"Regions" => _regionForm.RegionName,
			"Headquarters" => _headquarterForm.HeadquarterName,
			_ => ""
		};

		if (string.IsNullOrWhiteSpace(name))
		{
			ShowMessage($"{GetSingularName(ActiveTab)} name is required.", true);
			return;
		}

		try
		{
			_isSaving = true;

			object payload = ActiveTab switch
			{
				"Zones" => _isEditing
					? new { Id = _editingId!.Value, _zoneForm.ZoneName, _zoneForm.ZoneCode, _zoneForm.ZoneColorCode, _zoneForm.IsActive, UpdatedBy = (_currentUserId ?? "current-user") }
					: new { _zoneForm.ZoneName, _zoneForm.ZoneCode, _zoneForm.ZoneColorCode, _zoneForm.IsActive, CreatedAt = DateTime.Now, UpdatedAt = DateTime.Now, CreatedBy = (_currentUserId ?? "current-user"), UpdatedBy = (_currentUserId ?? "current-user") },
				"States" => _isEditing
					? (object)new { Id = _editingId!.Value, _stateForm.StateName, _stateForm.ZoneId, _stateForm.IsActive, UpdatedBy = (_currentUserId ?? "current-user") }
					: new { _stateForm.StateName, _stateForm.ZoneId, _stateForm.IsActive, CreatedAt = DateTime.Now, UpdatedAt = DateTime.Now, CreatedBy = (_currentUserId ?? "current-user"), UpdatedBy = (_currentUserId ?? "current-user") },
				"Districts" => _isEditing
					? (object)new { Id = _editingId!.Value, _districtForm.DistrictName, _districtForm.StateId, _districtForm.IsActive, UpdatedBy = (_currentUserId ?? "current-user") }
					: new { _districtForm.DistrictName, _districtForm.StateId, _districtForm.IsActive, CreatedAt = DateTime.Now, UpdatedAt = DateTime.Now, CreatedBy = (_currentUserId ?? "current-user"), UpdatedBy = (_currentUserId ?? "current-user") },
				"Sub-Districts" => _isEditing
						? (object)new { Id = _editingId!.Value, _subDistrictForm.SubDistrictName, _subDistrictForm.DistrictId, _subDistrictForm.IsActive, UpdatedBy = (_currentUserId ?? "current-user") }
						: new { _subDistrictForm.SubDistrictName, _subDistrictForm.DistrictId, _subDistrictForm.IsActive, CreatedAt = DateTime.Now, UpdatedAt = DateTime.Now, CreatedBy = (_currentUserId ?? "current-user"), UpdatedBy = (_currentUserId ?? "current-user") },
				"Regions" => _isEditing
					? (object)new { Id = _editingId!.Value, _regionForm.RegionName, _regionForm.StateId, _regionForm.IsActive, UpdatedBy = (_currentUserId ?? "current-user") }
					: new { _regionForm.RegionName, _regionForm.StateId, _regionForm.IsActive, CreatedAt = DateTime.Now, UpdatedAt = DateTime.Now, CreatedBy = (_currentUserId ?? "current-user"), UpdatedBy = (_currentUserId ?? "current-user") },
				"Headquarters" => _isEditing
					? (object)new { Id = _editingId!.Value, _headquarterForm.HeadquarterName, _headquarterForm.RegionId, _headquarterForm.IsActive, UpdatedBy = (_currentUserId ?? "current-user") }
					: new { _headquarterForm.HeadquarterName, _headquarterForm.RegionId, _headquarterForm.IsActive, CreatedAt = DateTime.Now, UpdatedAt = DateTime.Now, CreatedBy = (_currentUserId ?? "current-user"), UpdatedBy = (_currentUserId ?? "current-user") },
				_ => new { }
			};

			HttpResponseMessage response;
			if (_isEditing && _editingId.HasValue)
			{
				response = await Http.PutAsJsonAsync($"{CurrentApiBase}/{_editingId.Value}", payload);
				if (!response.IsSuccessStatusCode)
				{
					var error = await response.Content.ReadAsStringAsync();
					ShowMessage($"Update failed: {error}", true);
					return;
				}
				ShowMessage($"{GetSingularName(ActiveTab)} updated successfully.", false);
			}
			else
			{
				response = await Http.PostAsJsonAsync(CurrentApiBase, payload);
				if (!response.IsSuccessStatusCode)
				{
					var error = await response.Content.ReadAsStringAsync();
					ShowMessage($"Create failed: {error}", true);
					return;
				}
				ShowMessage($"{GetSingularName(ActiveTab)} created successfully.", false);
			}

			ResetForm();
			await LoadTabData();
		}
		catch (Exception ex)
		{
			ShowMessage($"Error: {ex.Message}", true);
		}
		finally
		{
			_isSaving = false;
		}
	}

	private async Task EditItem(LocationItemDto item)
	{
		_isEditing = true;
		_editingId = item.Id;

		switch (ActiveTab)
		{
			case "Zones":
				_zoneForm = new ZoneFormModel
				{
					ZoneName = item.Name,
					ZoneCode = item.ZoneCode,
					ZoneColorCode = item.ZoneColorCode,
					IsActive = item.IsActive
				};
				break;
			case "States":
				_stateForm = new StateFormModel
				{
					StateName = item.Name,
					ZoneId = item.ZoneId,
					IsActive = item.IsActive
				};
				break;
			case "Districts":
				_districtForm = new DistrictFormModel
				{
					DistrictName = item.Name,
					StateId = item.StateId,
					IsActive = item.IsActive
				};
				break;
			case "Sub-Districts":
				var district = _districtsAll.FirstOrDefault(d => d.Id == item.DistrictId);
				_subDistrictSelectedStateId = district?.StateId ?? 0;
				_subDistrictFilteredDistricts = _districtsAll.Where(d => d.StateId == _subDistrictSelectedStateId).ToList();
				_subDistrictForm = new SubDistrictFormModel
				{
					SubDistrictName = item.Name,
					DistrictId = item.DistrictId,
					IsActive = item.IsActive
				};
				break;
			case "Regions":
				_regionForm = new RegionFormModel
				{
					RegionName = item.Name,
					StateId = item.StateId,
					IsActive = item.IsActive
				};
				break;
			case "Headquarters":
				_headquarterForm = new HeadquarterFormModel
				{
					HeadquarterName = item.Name,
					RegionId = item.RegionId,
					IsActive = item.IsActive
				};
				break;
		}

		try
		{
			await _firstInputRef.FocusAsync();
		}
		catch { }
	}

	private void DeleteItem(LocationItemDto item)
	{
		_deleteTarget = item;
		_dependencyWarnings.Clear();

		switch (ActiveTab)
		{
			case "Zones":
				var mappedStates = _statesAll.Where(s => s.ZoneId == item.Id).Select(s => s.Name).ToList();
				if (mappedStates.Any())
					_dependencyWarnings.Add($"States: {string.Join(", ", mappedStates)}");
				break;

			case "States":
				var mappedDistricts = _districtsAll.Where(d => d.StateId == item.Id).Select(d => d.Name).ToList();
				if (mappedDistricts.Any())
					_dependencyWarnings.Add($"Districts: {string.Join(", ", mappedDistricts)}");

				var mappedRegions = _regionsAll.Where(r => r.StateId == item.Id).Select(r => r.Name).ToList();
				if (mappedRegions.Any())
					_dependencyWarnings.Add($"Regions: {string.Join(", ", mappedRegions)}");
				break;

			case "Districts":
				var mappedSubDistricts = _subDistrictsAll.Where(sd => sd.DistrictId == item.Id).Select(sd => sd.Name).ToList();
				if (mappedSubDistricts.Any())
					_dependencyWarnings.Add($"Sub-Districts: {string.Join(", ", mappedSubDistricts)}");
				break;

			case "Regions":
				var mappedHeadquarters = _headquartersAll.Where(hq => hq.RegionId == item.Id).Select(hq => hq.Name).ToList();
				if (mappedHeadquarters.Any())
					_dependencyWarnings.Add($"Headquarters: {string.Join(", ", mappedHeadquarters)}");
				break;
		}

		_showDeleteConfirm = true;
	}

	private async Task ConfirmDelete()
	{
		if (_deleteTarget is null) return;

		try
		{
			_isDeleting = true;
			var response = await Http.DeleteAsync($"{CurrentApiBase}/{_deleteTarget.Id}");
			if (response.IsSuccessStatusCode)
			{
				ShowMessage($"'{_deleteTarget.Name}' deleted successfully.", false);
				await LoadTabData();
			}
			else
			{
				var error = await response.Content.ReadAsStringAsync();
				ShowMessage($"Delete failed: {error}", true);
			}
		}
		catch (Exception ex)
		{
			ShowMessage($"Error: {ex.Message}", true);
		}
		finally
		{
			_isDeleting = false;
			CancelDelete();
		}
	}

	private void CancelDelete()
	{
		_showDeleteConfirm = false;
		_deleteTarget = null;
		_dependencyWarnings.Clear();
	}

	private async Task ToggleStatus(LocationItemDto item)
	{
		try
		{
			var newStatus = !item.IsActive;
			var response = await Http.PatchAsync($"{CurrentApiBase}/{item.Id}/status?isActive={newStatus}", null);

			if (response.IsSuccessStatusCode)
			{
				item.IsActive = newStatus;
				ApplyFilter();
			}
			else
			{
				var error = await response.Content.ReadAsStringAsync();
				ShowMessage($"Status change failed: {error}", true);
			}
		}
		catch (Exception ex)
		{
			ShowMessage($"Error: {ex.Message}", true);
		}
	}

