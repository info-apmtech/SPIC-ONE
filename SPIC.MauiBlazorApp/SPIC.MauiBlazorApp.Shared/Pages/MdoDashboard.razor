@page "/MdoDashboard"
@using System.Net.Http.Json
@inject SPIC.MauiBlazorApp.Shared.Services.ToastService Toast
@inject NavigationManager Navigation
@inject HttpClient Http

<div class="container-fluid py-4 px-0 mdo-page">

    <div class="mdo-header-row">
        <div>
            <h2 class="mdo-title">Team Dashboard</h2>
            <p class="mdo-subtitle">Overview of task creation, assignment and field progress across your region.</p>
        </div>

        <div class="mdo-header-actions">
            <button type="button" class="mdo-btn mdo-btn-outline" @onclick="Refresh">
                <i class="bi bi-arrow-clockwise"></i> Refresh
            </button>
            <button type="button" class="mdo-btn mdo-btn-primary" @onclick="OpenAllocationRequests">
                <i class="bi bi-person-check"></i> Allocation Requests
            </button>
        </div>
    </div>

    <div class="mdo-stats-grid">
        <div class="mdo-stat-card mdo-stat-total">
            <div class="mdo-stat-top">
                <span class="mdo-stat-label">Total Completed</span>
                <span class="mdo-stat-icon"><i class="bi bi-clipboard"></i></span>
            </div>
            <div class="mdo-stat-number">@(_isLoadingDealers ? "..." : _completedDealers.Count.ToString())</div>
            <div class="mdo-stat-desc">Fully registered dealers</div>
        </div>

        <div class="mdo-stat-card mdo-stat-unassigned">
            <div class="mdo-stat-top">
                <span class="mdo-stat-label">Unassigned</span>
                <span class="mdo-stat-icon"><i class="bi bi-people"></i></span>
            </div>
            <div class="mdo-stat-number">2</div>
            <div class="mdo-stat-desc">Awaiting assignment</div>
        </div>

        <div class="mdo-stat-card mdo-stat-requested">
            <div class="mdo-stat-top">
                <span class="mdo-stat-label">Requested</span>
                <span class="mdo-stat-icon"><i class="bi bi-person-check"></i></span>
            </div>
            <div class="mdo-stat-number">1</div>
            <div class="mdo-stat-desc">Needs your approval</div>
        </div>

        <div class="mdo-stat-card mdo-stat-approved">
            <div class="mdo-stat-top">
                <span class="mdo-stat-label">Approved &middot; Today</span>
                <span class="mdo-stat-icon"><i class="bi bi-check-circle"></i></span>
            </div>
            <div class="mdo-stat-number">4</div>
            <div class="mdo-stat-desc">In today's work queue</div>
        </div>

        <div class="mdo-stat-card mdo-stat-progress">
            <div class="mdo-stat-top">
                <span class="mdo-stat-label">In Progress</span>
                <span class="mdo-stat-icon"><i class="bi bi-clock"></i></span>
            </div>
            <div class="mdo-stat-number">2</div>
            <div class="mdo-stat-desc">Being worked right now</div>
        </div>

        <div class="mdo-stat-card mdo-stat-completed">
            <div class="mdo-stat-top">
                <span class="mdo-stat-label">Completed</span>
                <span class="mdo-stat-icon"><i class="bi bi-bullseye"></i></span>
            </div>
            <div class="mdo-stat-number">4</div>
            <div class="mdo-stat-desc">Closed this week</div>
        </div>
    </div>

    <div class="mdo-table-card">
        <h3 class="mdo-table-title">100% Completed Dealers</h3>
        <p class="mdo-table-subtitle">Dealers in your region who have completed all registration steps.</p>

        @if (_isLoadingDealers)
        {
            <div class="p-3 text-muted">Loading completed dealers...</div>
        }
        else if (!_completedDealers.Any())
        {
            <div class="p-3 text-muted">No fully completed dealers found in your region.</div>
        }
        else
        {
            <div class="mdo-table-scroll">
                <table class="mdo-table">
                    <thead>
                        <tr>
                            <th>Dealer Name</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var dealer in _completedDealers)
                        {
                            <tr>
                                <td class="mdo-cell-header">
                                    <div class="mdo-jmdo-name">@(string.IsNullOrWhiteSpace(dealer.FirmName) ? "Unnamed Firm" : dealer.FirmName)</div>
                                    <div class="mdo-jmdo-sub">@(string.IsNullOrWhiteSpace(dealer.DealerCode) ? "Code Pending" : $"Dealer Code: {dealer.DealerCode}")</div>
                                </td>
                                <td data-label="Status">
                                    <span class="mdo-status-pill mdo-status-active">
                                        <span class="mdo-status-dot"></span>100% Complete
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

</div>

@code {
    private void Refresh()
    {
        Toast.Info("Dashboard refreshed.");
        _ = LoadCompletedDealers();
    }

    private void OpenAllocationRequests() => Navigation.NavigateTo("/AllocationRequests");

    private class MdoDealerDto
    {
        public string? FirmName { get; set; }
        public string? DealerCode { get; set; }
        public int StepCount { get; set; }
    }

    private class MdoDashboardPageResponse
    {
        public int Total { get; set; }
        public List<MdoDealerDto> Items { get; set; } = new();
    }

    private bool _isLoadingDealers = true;
    private List<MdoDealerDto> _completedDealers = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadCompletedDealers();
    }

    private async Task LoadCompletedDealers()
    {
        _isLoadingDealers = true;
        try
        {
            var url = "api/DealerRegistration/dashboard/page?page=1&pageSize=1000&status=-1&workflowStatus=Approved&sort=recent";
            var response = await Http.GetFromJsonAsync<MdoDashboardPageResponse>(url);
            
            if (response != null && response.Items != null)
            {
                // MDO should only see dealers that have completed all 11 steps and are approved
                _completedDealers = response.Items.Where(d => d.StepCount >= 11).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading completed dealers: {ex.Message}");
        }
        finally
        {
            _isLoadingDealers = false;
            StateHasChanged();
        }
    }
}
