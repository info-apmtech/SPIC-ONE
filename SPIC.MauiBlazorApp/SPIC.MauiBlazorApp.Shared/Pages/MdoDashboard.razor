@page "/MdoDashboard"
@using System.Net.Http.Json
@inject SPIC.MauiBlazorApp.Shared.Services.ToastService Toast
@inject NavigationManager Navigation
@inject HttpClient Http

<div class="container-fluid py-4 px-0 mdo-page">

    <div class="mdo-header-row">
        <div>
            <h2 class="mdo-title">Dashboard</h2>
            <p class="mdo-subtitle">Overview of task creation, assignment and field progress across your JMDOs.</p>
        </div>

        <div class="mdo-header-actions">
            <button type="button" class="mdo-btn mdo-btn-outline" @onclick="Refresh">
                <i class="bi bi-arrow-clockwise"></i> Refresh
            </button>
            <button type="button" class="mdo-btn mdo-btn-primary" @onclick="OpenAllocationRequests">
                <i class="bi bi-person-check"></i> Allocation Requests
            </button>
        </div>
    </div>

    <div class="mdo-stats-grid">
        <div class="mdo-stat-card mdo-stat-total">
            <div class="mdo-stat-top">
                <span class="mdo-stat-label">Total Tasks</span>
                <span class="mdo-stat-icon"><i class="bi bi-clipboard"></i></span>
            </div>
            <div class="mdo-stat-number">@(_isLoadingJmdos ? "..." : TotalAssigned.ToString())</div>
            <div class="mdo-stat-desc">Across all statuses</div>
        </div>

        <div class="mdo-stat-card mdo-stat-unassigned">
            <div class="mdo-stat-top">
                <span class="mdo-stat-label">Unassigned</span>
                <span class="mdo-stat-icon"><i class="bi bi-people"></i></span>
            </div>
            <div class="mdo-stat-number">@(_isLoadingJmdos ? "..." : TotalUnassigned.ToString())</div>
            <div class="mdo-stat-desc">Awaiting assignment</div>
        </div>

        <div class="mdo-stat-card mdo-stat-requested">
            <div class="mdo-stat-top">
                <span class="mdo-stat-label">Requested by JMDO</span>
                <span class="mdo-stat-icon"><i class="bi bi-person-check"></i></span>
            </div>
            <div class="mdo-stat-number">@(_isLoadingJmdos ? "..." : TotalInProgress.ToString())</div>
            <div class="mdo-stat-desc">Needs your approval</div>
        </div>

        <div class="mdo-stat-card mdo-stat-approved">
            <div class="mdo-stat-top">
                <span class="mdo-stat-label">Approved &middot; Today</span>
                <span class="mdo-stat-icon"><i class="bi bi-check-circle"></i></span>
            </div>
            <div class="mdo-stat-number">@(_isLoadingJmdos ? "..." : TotalApprovedToday.ToString())</div>
            <div class="mdo-stat-desc">In today's work queue</div>
        </div>

        <div class="mdo-stat-card mdo-stat-progress">
            <div class="mdo-stat-top">
                <span class="mdo-stat-label">In Progress</span>
                <span class="mdo-stat-icon"><i class="bi bi-clock"></i></span>
            </div>
            <div class="mdo-stat-number">@(_isLoadingJmdos ? "..." : TotalOnDuty.ToString())</div>
            <div class="mdo-stat-desc">Being worked right now</div>
        </div>

        <div class="mdo-stat-card mdo-stat-completed">
            <div class="mdo-stat-top">
                <span class="mdo-stat-label">Completed</span>
                <span class="mdo-stat-icon"><i class="bi bi-bullseye"></i></span>
            </div>
            <div class="mdo-stat-number">@(_isLoadingJmdos ? "..." : TotalCompleted.ToString())</div>
            <div class="mdo-stat-desc">Closed this week</div>
        </div>
    </div>

    <div class="mdo-table-card">
        <h3 class="mdo-table-title">JMDO-wise summary</h3>
        <p class="mdo-table-subtitle">Task load and progress per field officer in your region.</p>

        @if (_isLoadingJmdos)
        {
            <div class="p-3 text-muted">Loading your team...</div>
        }
        else if (!_jmdos.Any())
        {
            <div class="p-3 text-muted">No JMDOs found for your headquarters.</div>
        }
        else
        {
            <div class="mdo-table-scroll">
                <table class="mdo-table">
                    <thead>
                        <tr>
                            <th>JMDO</th>
                            <th>Status</th>
                            <th>Assigned</th>
                            <th>In Progress</th>
                            <th>Completed</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var jmdo in _jmdos)
                        {
                            <tr>
                                <td class="mdo-cell-header">
                                    <div class="mdo-jmdo-name">@(string.IsNullOrWhiteSpace(jmdo.Name) ? "Unnamed" : jmdo.Name)</div>
                                    <div class="mdo-jmdo-sub">@JmdoSubLabel(jmdo)</div>
                                </td>
                                <td data-label="Status">
                                    <span class="mdo-status-pill @(jmdo.IsOnLeaveToday ? "mdo-status-leave" : "mdo-status-active")">
                                        <span class="mdo-status-dot"></span>@(jmdo.IsOnLeaveToday ? "On Leave" : "Active")
                                    </span>
                                </td>
                                <td data-label="Assigned">@jmdo.AssignedCount</td>
                                <td data-label="In Progress">@jmdo.InProgressCount</td>
                                <td data-label="Completed">@jmdo.CompletedCount</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

</div>

@code {
    private void Refresh()
    {
        Toast.Info("Dashboard refreshed.");
        _ = LoadJmdos();
    }

    private void OpenAllocationRequests() => Navigation.NavigateTo("/AllocationRequests");

    private class TeamJmdoDto
    {
        public int EmployeeLoginId { get; set; }
        public string Name { get; set; } = "";
        public string? EmployeeCode { get; set; }
        public bool IsActive { get; set; }
        public string? HeadquarterName { get; set; }
        public bool IsOnLeaveToday { get; set; }
        public bool IsOnDutyToday { get; set; }
        public int AssignedCount { get; set; }
        public int InProgressCount { get; set; }
        public int CompletedCount { get; set; }
        public int ApprovedTodayCount { get; set; }
    }

    private bool _isLoadingJmdos = true;
    private List<TeamJmdoDto> _jmdos = new();

    // Summed from each JMDO's own JmdoTaskAllocation submission counts
    // (AssignedCount/InProgressCount/CompletedCount) - see api/Team/jmdos.
    private int TotalAssigned => _jmdos.Sum(j => j.AssignedCount);
    private int TotalInProgress => _jmdos.Sum(j => j.InProgressCount);
    private int TotalCompleted => _jmdos.Sum(j => j.CompletedCount);
    private int TotalApprovedToday => _jmdos.Sum(j => j.ApprovedTodayCount);
    // JMDOs who haven't submitted any allocation yet - the closest real
    // meaning of "unassigned" this data model supports.
    private int TotalUnassigned => _jmdos.Count(j => j.AssignedCount == 0);
    // No per-task "in progress" state exists anywhere - today's attendance
    // DutyStatus (OnDuty) is used as the closest real proxy for "being worked
    // right now".
    private int TotalOnDuty => _jmdos.Count(j => j.IsOnDutyToday);

    private static string JmdoSubLabel(TeamJmdoDto jmdo)
    {
        var code = string.IsNullOrWhiteSpace(jmdo.EmployeeCode) ? "Code Pending" : jmdo.EmployeeCode;
        return string.IsNullOrWhiteSpace(jmdo.HeadquarterName) ? code : $"{code} · {jmdo.HeadquarterName}";
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadJmdos();
    }

    // There's no org-chart/reporting-line field anywhere in the data model
    // (no ManagerId/ReportsTo) - api/Team/jmdos scopes "this MDO's team" by
    // matching HeadquartersId, the only signal MDO/JMDO rows share.
    private async Task LoadJmdos()
    {
        _isLoadingJmdos = true;
        try
        {
            var result = await Http.GetFromJsonAsync<List<TeamJmdoDto>>("api/Team/jmdos");
            _jmdos = result ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading JMDO team: {ex.Message}");
        }
        finally
        {
            _isLoadingJmdos = false;
            StateHasChanged();
        }
    }
}
