        <div class="ws-scheme-card ws-theme-edu">
            <div class="ws-icon-wrap">
                <img src="_content/SPIC.MauiBlazorApp.Shared/Images/WelfareSchemes/GreenTick.png" alt="Merit Award" />
            </div>
            <h3 class="ws-scheme-title">Merit Award</h3>
            <p class="ws-scheme-desc">Recognition and reward for outstanding academic or professional achievements of dealers and their family.</p>
            
            <div class="ws-stats-container">
                <div class="ws-stat-box">
                    <span class="ws-stat-label">Documents</span>
                    <span class="ws-stat-value">3 required</span>
                </div>
                <div class="ws-stat-box">
                    <span class="ws-stat-label">Eligibility</span>
                    <span class="ws-stat-value">All Dealers</span>
                </div>
            </div>

            <div class="ws-card-actions">
                <button class="ws-btn-card ws-btn-card-outline">View Details</button>
                <button class="ws-btn-card ws-btn-card-solid" @onclick="@(() => NavigateToScheme("Merit Award"))">Apply Now</button>
            </div>
        </div>

        <div class="ws-scheme-card ws-theme-edu">
            <div class="ws-icon-wrap">
                <img src="_content/SPIC.MauiBlazorApp.Shared/Images/WelfareSchemes/GreenTick.png" alt="Distinction Award" />
            </div>
            <h3 class="ws-scheme-title">Distinction Award</h3>
            <p class="ws-scheme-desc">Distinction award for completing Professional Courses without any arrears and scoring more than 80% aggregate.</p>
            
            <div class="ws-stats-container">
                <div class="ws-stat-box">
                    <span class="ws-stat-label">Documents</span>
                    <span class="ws-stat-value">3 required</span>
                </div>
                <div class="ws-stat-box">
                    <span class="ws-stat-label">Eligibility</span>
                    <span class="ws-stat-value">Dealers & Employees (TN)</span>
                </div>
            </div>

            <div class="ws-card-actions">
                <button class="ws-btn-card ws-btn-card-outline">View Details</button>
                <button class="ws-btn-card ws-btn-card-solid" @onclick="@(() => NavigateToScheme("Distinction Award"))">Apply Now</button>
            </div>
        </div>

    </div>

    <div class="ws-help-banner">
        
        <div class="ws-help-content">
            <h2>Need help choosing a scheme?</h2>
            <p>Our team can guide you to the right benefit for your situation.</p>
        </div>

        <div class="ws-help-actions">
            
            <button class="ws-help-btn">
                <div class="ws-help-icon">
