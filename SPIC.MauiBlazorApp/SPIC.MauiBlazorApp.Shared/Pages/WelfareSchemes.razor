                <img src="_content/SPIC.MauiBlazorApp.Shared/Images/WelfareSchemes/Books.png" alt="Educational Assistance" />
            </div>
            <h3 class="ws-scheme-title">Educational Assistance</h3>
            <p class="ws-scheme-desc">Support higher education expenses for children of registered SDWA dealers.</p>
            
            <div class="ws-stats-container">
