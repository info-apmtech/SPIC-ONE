@page "/WelfareSchemes"
@inject NavigationManager NavigationManager


<div class="container-fluid py-4 px-0">
    
    <div class="ws-header-container">
        <div class="ws-header-text">
            <h1>Apply for Welfare Schemes</h1>
            <p>Select a welfare scheme and submit your application with required documents.</p>
        </div>

        </div>

    <div class="ws-schemes-grid">
        
        <div class="ws-scheme-card ws-theme-medical">
            <div class="ws-icon-wrap">
                <img src="_content/SPIC.MauiBlazorApp.Shared/Images/WelfareSchemes/MedicalAssistance.png" alt="Medical Assistance" />
            </div>
            <h3 class="ws-scheme-title">Medical Assistance</h3>
            <p class="ws-scheme-desc">Financial relief for major medical treatments, hospitalization and surgeries.</p>
            
            <div class="ws-stats-container">
          @*       <div class="ws-stat-box">
                    <span class="ws-stat-label">Max Benefit</span>
                    <span class="ws-stat-value ws-text-green">₹50,000</span>
                </div>
                <div class="ws-stat-box">
                    <span class="ws-stat-label">Processing</span>
                    <span class="ws-stat-value">3-7 Days</span>
                </div> *@
                <div class="ws-stat-box">
                    <span class="ws-stat-label">Documents</span>
                    <span class="ws-stat-value">5 required</span>
                </div>
                <div class="ws-stat-box">
                    <span class="ws-stat-label">Eligibility</span>
                    <span class="ws-stat-value">All Dealers</span>
                </div>
            </div>

            <div class="ws-card-actions">
                <button class="ws-btn-card ws-btn-card-outline">View Details</button>
                <button class="ws-btn-card ws-btn-card-solid" @onclick="@(() => NavigateToScheme("Medical Assistance"))">Apply Now</button>
            </div>
        </div>

        <div class="ws-scheme-card ws-theme-wedding">
            <div class="ws-icon-wrap">
                <img src="_content/SPIC.MauiBlazorApp.Shared/Images/WelfareSchemes/WeddingGift.png" alt="Wedding Gift" />
            </div>
            <h3 class="ws-scheme-title">Wedding Gift</h3>
            <p class="ws-scheme-desc">Financial assistance to celebrate family wedding milestones of registered dealers.</p>
            
            <div class="ws-stats-container">
            @*     <div class="ws-stat-box">
                    <span class="ws-stat-label">Max Benefit</span>
                    <span class="ws-stat-value ws-text-green">₹15,000</span>
                </div>
                <div class="ws-stat-box">
                    <span class="ws-stat-label">Processing</span>
                    <span class="ws-stat-value">7-10 Days</span>
                </div> *@
                <div class="ws-stat-box">
                    <span class="ws-stat-label">Documents</span>
                    <span class="ws-stat-value">3 required</span>
                </div>
                <div class="ws-stat-box">
                    <span class="ws-stat-label">Eligibility</span>
                    <span class="ws-stat-value">All Dealers</span>
                </div>
            </div>

            <div class="ws-card-actions">
                <button class="ws-btn-card ws-btn-card-outline">View Details</button>
                <button class="ws-btn-card ws-btn-card-solid" @onclick="@(() => NavigateToScheme("Wedding"))">Apply Now</button>
            </div>
        </div>

        <div class="ws-scheme-card ws-theme-house">
            <div class="ws-icon-wrap">
                <img src="_content/SPIC.MauiBlazorApp.Shared/Images/WelfareSchemes/House.png" alt="Grahapravesam" />
            </div>
            <h3 class="ws-scheme-title">Grahapravesam</h3>
            <p class="ws-scheme-desc">Financial support for housewarming celebrations. A small gift for a new beginning.</p>
            
            <div class="ws-stats-container">
           @*      <div class="ws-stat-box">
                    <span class="ws-stat-label">Max Benefit</span>
