                    <span class="ws-stat-label">Documents</span>
                    <span class="ws-stat-value">4 required</span>
                </div>
                <div class="ws-stat-box">
                    <span class="ws-stat-label">Eligibility</span>
                    <span class="ws-stat-value">All Dealers</span>
                </div>
            </div>

            <div class="ws-card-actions">
                <button class="ws-btn-card ws-btn-card-outline">View Details</button>
                <button class="ws-btn-card ws-btn-card-solid" @onclick="@(() => NavigateToScheme("Educational Assistance"))">Apply Now</button>
            </div>
        </div>

        <div class="ws-scheme-card ws-theme-bday">
            <div class="ws-icon-wrap">
                <img src="_content/SPIC.MauiBlazorApp.Shared/Images/WelfareSchemes/Cake.png" alt="Sathabhishekam" />
            </div>
            <h3 class="ws-scheme-title">Sathabhishekam</h3>
            <p class="ws-scheme-desc">Honour the 80th birthday milestone of a dealer or immediate family member.</p>
            
