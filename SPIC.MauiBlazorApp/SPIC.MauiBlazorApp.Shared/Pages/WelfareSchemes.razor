          @*       <div class="ws-stat-box">
                    <span class="ws-stat-label">Max Benefit</span>
                    <span class="ws-stat-value ws-text-green">₹10,000</span>
                </div>
                <div class="ws-stat-box">
                    <span class="ws-stat-label">Processing</span>
