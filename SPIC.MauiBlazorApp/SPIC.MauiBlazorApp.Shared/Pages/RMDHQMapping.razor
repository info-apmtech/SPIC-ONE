@code {
    private bool CanEntry => LoginState.Can("RMDHQMapping", "Entry");
    private bool CanUpdate => LoginState.Can("RMDHQMapping", "Update");
    private bool CanDelete => LoginState.Can("RMDHQMapping", "Delete");

    private List<LookupItem> Employees = new(), States = new(), Regions = new(), Headquarters = new();
    private List<MappingView> Mappings = new();
    private int? EmployeeId, StateId, RegionId, EditingId, DeletePendingId;
    private HashSet<int> SelectedHQ = new();
    private bool Busy, Success;
    private string Message = "";
    private bool AllSelected => Headquarters.Count > 0 && Headquarters.All(h => SelectedHQ.Contains(h.Id));
    protected override async Task OnInitializedAsync() => await Load();

    private string SearchText = "";
    private int PageSize = 16;
    private int CurrentPage = 1;
    private List<MappingView> FilteredMappings => Mappings.Where(x => string.IsNullOrWhiteSpace(SearchText) ||
        new[] { x.EmployeeName ?? "", x.StateName ?? "", x.RegionName ?? "", x.HeadquartersIds ?? "", x.CreatedBy ?? "", x.UpdatedBy ?? "", string.Join(" ", GetHeadquartersNames(x)) }
        .Any(v => v.Contains(SearchText, StringComparison.OrdinalIgnoreCase))).ToList();
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredMappings.Count / (double)PageSize));
    private IEnumerable<MappingView> VisibleMappings => FilteredMappings.Skip((Math.Min(CurrentPage, TotalPages) - 1) * PageSize).Take(PageSize);
    private void SetPageSize(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out var n) && n > 0) PageSize = n; CurrentPage = 1; }
    private bool ShowHQDropdown = false;
    private string HQSearch = "";

    private List<LookupItem> FilteredHeadquarters =>
        Headquarters
            .Where(x => string.IsNullOrWhiteSpace(HQSearch)
                || x.Name.Contains(
                    HQSearch,
                    StringComparison.OrdinalIgnoreCase))
            .ToList();

    private readonly Dictionary<int, List<LookupItem>> HQByRegion = new();

    private IEnumerable<string> GetHeadquartersNames(MappingView row)
    {
        var ids = (row.HeadquartersIds ?? "")
            .Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(x => int.TryParse(x.Trim(), out var id) ? id : 0)
            .Where(id => id > 0);

        if (!HQByRegion.TryGetValue(row.RegionId, out var options))
            return ids.Select(id => $"HQ #{id}").ToList();

        return ids.Select(id => options.FirstOrDefault(x => x.Id == id)?.Name ?? $"Unknown HQ ({id})").ToList();
    }

    private async Task LoadMappings()
    {
        Mappings = await Http.GetFromJsonAsync<List<MappingView>>("api/RMDHQMapping") ?? new();
        foreach (var regionId in Mappings.Select(x => x.RegionId).Where(x => x > 0).Distinct())
        {
            // A denied lookup must not prevent a View-only user from seeing mappings.
            try
            {
                HQByRegion[regionId] = await Http.GetFromJsonAsync<List<LookupItem>>(
                    $"api/RMDHQMapping/headquarters/{regionId}") ?? new();
            }
            catch (HttpRequestException)
            {
                HQByRegion.Remove(regionId);
                // The mapping row remains visible, with HQ IDs as fallback labels.
            }
        }
        CurrentPage = Math.Min(CurrentPage, TotalPages);
    }

    private async Task Load()
    {
        Busy = true;
        try
        {
            await LoadMappings();
            // Master lookups are needed only for creating/editing, not for viewing the list.
            if (CanEntry || CanUpdate)
            {
                try
                {
                    Employees = await Http.GetFromJsonAsync<List<LookupItem>>("api/RMDHQMapping/employees") ?? new();
                    States = await Http.GetFromJsonAsync<List<LookupItem>>("api/RMDHQMapping/states") ?? new();
                }
                catch (HttpRequestException ex)
                {
                    Error($"Mapping list loaded, but form lookups failed: {ex.Message}");
                }
            }
        }
        catch (Exception ex) { Error(ex.Message); }
        finally { Busy = false; }
    }
    private async Task OnStateChanged(ChangeEventArgs e)
    {
        if (Busy || !(EditingId.HasValue ? CanUpdate : CanEntry)) return;
        StateId = ParseId(e.Value); RegionId = null; Regions.Clear(); Headquarters.Clear(); SelectedHQ.Clear(); ShowHQDropdown = false; HQSearch = "";
        if (!StateId.HasValue) return;
        try { Regions = await Http.GetFromJsonAsync<List<LookupItem>>($"api/RMDHQMapping/regions/{StateId}") ?? new(); }
        catch (Exception ex) { Error(ex.Message); }
    }
    private async Task OnRegionChanged(ChangeEventArgs e)
    {
        if (Busy || !(EditingId.HasValue ? CanUpdate : CanEntry)) return;
        RegionId = ParseId(e.Value); Headquarters.Clear(); SelectedHQ.Clear(); ShowHQDropdown = false; HQSearch = "";
        if (!RegionId.HasValue) return;
        try { Headquarters = await Http.GetFromJsonAsync<List<LookupItem>>($"api/RMDHQMapping/headquarters/{RegionId}") ?? new(); HQByRegion[RegionId.Value] = Headquarters.ToList(); }
        catch (Exception ex) { Error(ex.Message); }
    }
    private static int? ParseId(object? v) => int.TryParse(v?.ToString(), out var id) && id > 0 ? id : null;
    private void ToggleHQ(int id, bool yes) { if (Busy || !(EditingId.HasValue ? CanUpdate : CanEntry)) return; if (yes) SelectedHQ.Add(id); else SelectedHQ.Remove(id); }
    private void ToggleAll(ChangeEventArgs e) { if (Busy || !(EditingId.HasValue ? CanUpdate : CanEntry)) return; SelectedHQ = e.Value is true ? Headquarters.Select(x => x.Id).ToHashSet() : new(); }
    private void Error(string message) { Success = false; Message = message; }
    private void Reset() { EditingId = EmployeeId = StateId = RegionId = null; Regions.Clear(); Headquarters.Clear(); SelectedHQ.Clear(); Message = ""; ShowHQDropdown = false; HQSearch = ""; }
    private async Task Save()
    {
        if (Busy) return;
        if (EditingId.HasValue ? !CanUpdate : !CanEntry)
        {
            Error("You do not have permission to save this mapping.");
            return;
        }
        if (!EmployeeId.HasValue || !StateId.HasValue || !RegionId.HasValue || SelectedHQ.Count == 0) { Error("Select employee, state, region, and at least one HQ."); return; }
        Busy = true;
        try
        {
            var request = new SaveMappingRequest { Id = EditingId, EmployeeId = EmployeeId.Value, StateId = StateId.Value, RegionId = RegionId.Value, HeadquartersIds = SelectedHQ.OrderBy(x => x).ToList() };
            using var response = await Http.PostAsJsonAsync("api/RMDHQMapping/save", request);
            if (!response.IsSuccessStatusCode) { Error(await response.Content.ReadAsStringAsync()); return; }
            Reset(); Success = true; Message = "Mapping saved successfully.";
            await LoadMappings();
        }
        catch (Exception ex) { Error(ex.Message); }
        finally { Busy = false; }
    }
    private async Task Edit(MappingView row)
    {
        if (Busy || !CanUpdate) return;
        Message = ""; EditingId = row.Id; EmployeeId = row.EmployeeId; StateId = row.StateId;
        Busy = true;
        try
        {
            Regions = await Http.GetFromJsonAsync<List<LookupItem>>($"api/RMDHQMapping/regions/{row.StateId}") ?? new();
            RegionId = row.RegionId;
            Headquarters = await Http.GetFromJsonAsync<List<LookupItem>>($"api/RMDHQMapping/headquarters/{row.RegionId}") ?? new();
            HQByRegion[row.RegionId] = Headquarters.ToList();
            SelectedHQ = row.HeadquartersIds.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(ParseId).Where(x => x.HasValue).Select(x => x!.Value).ToHashSet();
            if (SelectedHQ.Any(x => Headquarters.All(h => h.Id != x))) Error("Stored mapping contains an HQ that is no longer available. Check before saving.");
        }
        catch (Exception ex) { Error(ex.Message); }
        finally { Busy = false; }
    }
    private void Delete(MappingView row) { if (Busy || !CanDelete) return; DeletePendingId = row.Id; }
    private async Task ConfirmDelete()
    {
        if (Busy || !CanDelete || !DeletePendingId.HasValue) return;
        Busy = true;
        try
        {
            using var resp = await Http.DeleteAsync($"api/RMDHQMapping/{DeletePendingId}");
            if (!resp.IsSuccessStatusCode) { Error(await resp.Content.ReadAsStringAsync()); return; }
            DeletePendingId = null; Reset(); Success = true; Message = "Mapping deleted.";
            await LoadMappings();
        }
        catch (Exception ex) { Error(ex.Message); }
        finally { Busy = false; }
    }
}
