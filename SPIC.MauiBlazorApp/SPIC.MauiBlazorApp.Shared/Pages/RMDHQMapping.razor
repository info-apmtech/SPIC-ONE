@page "/RMDHQMapping"
@using System.Net.Http.Json
@using SPIC.Core.DTOs
@inject HttpClient Http
@inject SPIC.MauiBlazorApp.Shared.Services.LoginState LoginState

<PageTitle>RMD Headquarters Mapping</PageTitle>
<div class="container-fluid rmd-page">
    <header class="rmd-header">
        <h3>RMD Headquarters Mapping</h3>
        <p>Assign multiple headquarters to an RMD employee in one record</p>
    </header>

    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <div class="alert @(Success ? "alert-success" : "alert-danger")" role="alert">@Message</div>
    }

    @if (CanEntry || CanUpdate)
    {
        <section class="rmd-section rmd-panel">
            <div class="rmd-section-heading">@(EditingId.HasValue ? "Edit Headquarters Mapping" : "Assign Headquarters")</div>
            <div class="rmd-form-grid">
                <div class="rmd-form-field">
                    <label>Employee (RMD) <span class="text-danger">*</span></label>
                    <select class="rmd-select" @bind="EmployeeId" disabled="@Busy">
                        <option value="">Select employee</option>
                        @foreach (var x in Employees)
                        {
                            <option value="@x.Id">@x.Name</option>
                        }
                    </select>
                </div>
                <div class="rmd-form-field">
                    <label>State <span class="text-danger">*</span></label>
                    <select class="rmd-select" value="@StateId" @onchange="OnStateChanged" disabled="@Busy">
                        <option value="">Select state</option>
                        @foreach (var x in States)
                        {
                            <option value="@x.Id">@x.Name</option>
                        }
                    </select>
                </div>
                <div class="rmd-form-field">
                    <label>Region <span class="text-danger">*</span></label>
                    <select class="rmd-select" value="@RegionId" @onchange="OnRegionChanged" disabled="@(Busy || !StateId.HasValue)">
                        <option value="">Select region</option>
                        @foreach (var x in Regions)
                        {
                            <option value="@x.Id">@x.Name</option>
                        }
                    </select>
                </div>
                <div class="rmd-form-field">
                    <label>Headquarters <span class="text-danger">*</span> <span class="rmd-muted">(@SelectedHQ.Count selected)</span></label>
                    <div class="rmd-hq-field">
                        @if (SelectedHQ.Count > 0)
                        {
                            <div class="rmd-hq-chips">
                                @foreach (var h in Headquarters.Where(x => SelectedHQ.Contains(x.Id)))
                                {
                                    <span class="rmd-hq-chip" @key="h.Id">
                                        @h.Name
                                        <button type="button" title="Remove @h.Name" disabled="@Busy" @onclick="() => ToggleHQ(h.Id, false)">×</button>
                                    </span>
                                }
                            </div>
                        }
                        <button type="button" class="rmd-hq-trigger" disabled="@(Busy || !RegionId.HasValue)" @onclick="() => ShowHQDropdown = !ShowHQDropdown">
                            <span>Select Headquarters</span><span>@(ShowHQDropdown ? "⌃" : "⌄")</span>
                        </button>
                        @if (ShowHQDropdown)
                        {
                            <div class="rmd-hq-dropdown">
                                <input class="rmd-search-input w-100" placeholder="Search headquarters..." @bind="HQSearch" @bind:event="oninput" />
                                <label class="rmd-hq-option"><input type="checkbox" checked="@AllSelected" @onchange="ToggleAll" disabled="@Busy" /> <strong>Select All</strong></label>
                                @foreach (var h in FilteredHeadquarters)
                                {
                                    <label class="rmd-hq-option" @key="h.Id"><input type="checkbox" checked="@SelectedHQ.Contains(h.Id)" @onchange="e => ToggleHQ(h.Id, e.Value is true)" disabled="@Busy" /> @h.Name</label>
                                }
                                @if (FilteredHeadquarters.Count == 0)
                                {
                                    <p class="rmd-muted m-2">No headquarters found.</p>
                                }
                                <button type="button" class="rmd-btn rmd-btn-light w-100" @onclick="() => ShowHQDropdown = false">Done</button>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="rmd-form-actions">
                <span class="rmd-muted">HQ IDs: @string.Join(",", SelectedHQ.OrderBy(x => x))</span>
                <div class="rmd-action-group">
                    <button type="button" class="rmd-btn rmd-btn-light" disabled="@Busy" @onclick="Reset">Clear</button>
                    @if (EditingId.HasValue ? CanUpdate : CanEntry)
                    {
                        <button type="button" class="rmd-btn rmd-btn-primary" disabled="@Busy" @onclick="Save">@(Busy ? "Saving..." : EditingId.HasValue ? "Update Mapping" : "Save Mapping")</button>
                    }
                </div>
            </div>
        </section>
    }

    <section class="rmd-section rmd-list-section rmd-panel">
        <div class="rmd-list-top">
            <h4>Existing RMD HQ Mappings</h4>
            <input type="search" class="rmd-search-input" placeholder="⌕ Search mappings..." aria-label="Search mappings" @bind="SearchText" @bind:event="oninput" />
        </div>
        <div class="rmd-table-tools">
            <span class="rmd-muted">@FilteredMappings.Count record(s)</span>
        </div>
        <div class="rmd-table-scroll">
            <table class="rmd-table">
                <thead><tr><th>S:No</th><th>Employee</th><th>State</th><th>Region</th><th>Headquarters</th><th>Created At</th><th>Updated At</th>@if (CanUpdate || CanDelete) {
                    <th>Action</th>
                }
            </tr></thead>
            <tbody>
                @if (!VisibleMappings.Any())
                {
                    <tr><td colspan="@(CanUpdate || CanDelete ? 8 : 7)" class="rmd-empty">No mappings found.</td></tr>
                }
                @foreach (var item in VisibleMappings.Select((value, index) => new { value, index }))
                {
                    var row = item.value;
                    <tr @key="row.Id">
                        <td>@((Math.Min(CurrentPage, TotalPages) - 1) * PageSize + item.index + 1)</td>
                        <td>@row.EmployeeName</td>
                        <td>@row.StateName</td>
                        <td>@row.RegionName</td>
                        <td>
                            <div class="rmd-grid-hq-list">
                                @foreach (var hqName in GetHeadquartersNames(row))
                                {
                                    <span class="rmd-grid-hq-chip">@hqName</span>
                                }
                            </div>
                        </td>
                        <td>@row.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>

                        <td>@(row.UpdatedAt?.ToLocalTime().ToString("yyyy-MM-dd") ?? "-")</td>

                        @if (CanUpdate || CanDelete)
                        {
                            <td>
                                <div class="rmd-action-group">
                                    @if (CanUpdate)
                                    {
                                        <button type="button" class="rmd-icon-btn" title="Edit" disabled="@Busy" @onclick="() => Edit(row)">✎</button>
                                    }
                                    @if (CanDelete)
                                    {
                                        <button type="button" class="rmd-icon-btn rmd-danger" title="Delete" disabled="@Busy" @onclick="() => Delete(row)">✕</button>
                                    }
                                </div>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (CanDelete && DeletePendingId.HasValue)
    {
        <div class="alert alert-warning mt-3">
            Delete mapping #@DeletePendingId?
            <button type="button" class="rmd-btn rmd-btn-danger ms-2" disabled="@Busy" @onclick="ConfirmDelete">Confirm</button>
            <button type="button" class="rmd-btn rmd-btn-light ms-2" @onclick="() => DeletePendingId = null">Cancel</button>
        </div>
    }
    <div class="rmd-table-footer">
        <div class="rmd-action-group">
            <span>Items Per Page</span>
            <select class="rmd-page-size" value="@PageSize" @onchange="SetPageSize">
                <option value="10">10</option>
                <option value="16">16</option>
                <option value="25">25</option>
                <option value="50">50</option>
            </select>
        </div>
        <div class="rmd-action-group">
            <button type="button" class="rmd-page-btn" disabled="@(CurrentPage <= 1)" @onclick="() => CurrentPage--">‹</button>
            <span class="rmd-page-number">@Math.Min(CurrentPage, TotalPages) / @TotalPages</span>
            <button type="button" class="rmd-page-btn" disabled="@(CurrentPage >= TotalPages)" @onclick="() => CurrentPage++">›</button>
        </div>
    </div>
</section>
</div>
<style>
