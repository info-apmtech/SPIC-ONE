@page "/MOApproval/{Id:int}"
@using SPIC.Core.Entities
@inject NavigationManager Nav
@inject SPIC.MauiBlazorApp.Shared.Services.LoginState LoginState

<style>
    .mo-approval-page {
        width: 100%;
        padding: 16px 24px;
    }

    .mo-approval-topbar {
        margin-bottom: 12px;
    }

    .mo-approval-content .apd-header {
        border-radius: 16px 16px 0 0;
        padding: 16px 24px 14px 24px;
    }

    .mo-approval-content .apd-body {
        border-radius: 0;
        padding: 16px 24px;
        gap: 16px;
    }

    .mo-approval-content .apd-section {
        gap: 10px;
    }

    .mo-approval-content .apd-fields-grid {
        gap: 8px;
    }

    .mo-approval-content .apd-field {
        padding: 8px 12px;
    }

    .mo-approval-content .apd-field label {
        font-size: 10px;
    }

    .mo-approval-content .apd-doc-list {
        gap: 6px;
    }

    .mo-approval-content .apd-doc-item {
        padding: 8px 12px;
    }

    .mo-approval-content .apd-remarks-container {
        padding: 12px 16px;
        gap: 10px;
    }

    .mo-approval-content .apd-summary-box {
        padding: 12px 16px;
    }

    .mo-approval-content .apd-summary-grid {
        gap: 10px;
        margin-bottom: 8px;
    }

    .mo-approval-content .apd-box-title {
        margin: 0 0 10px 0;
    }

    .mo-approval-content .apd-footer {
        border-radius: 0 0 16px 16px;
        padding: 12px 24px;
    }

    .mo-approval-content .apd-alert {
        padding: 10px 14px;
    }

    .mo-approval-content .apd-stepper {
        padding: 0;
    }

    .mo-approval-content .rm-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 9998;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .mo-approval-content .rm-container {
        background-color: #ffffff;
        border-radius: 16px;
        padding: 24px;
        width: 100%;
        max-width: 520px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
        z-index: 9999;
    }

    .mo-approval-content .rm-icon-wrapper {
        margin-bottom: 12px;
    }

    .mo-approval-content .rm-title {
        margin-bottom: 6px;
    }

    .mo-approval-content .rm-warning {
        margin-bottom: 16px;
    }

    .mo-approval-content .rm-form-group {
        margin-bottom: 12px;
    }

    .mo-approval-content .rm-actions {
        margin-top: 16px;
    }

    .mo-approval-content .rm-btn {
        padding: 10px;
        font-size: 13px;
    }

    @@media (max-width: 768px) {
        .mo-approval-page {
            padding: 12px 8px;
        }

        .mo-approval-content .apd-header {
            padding: 12px 16px 10px 16px;
        }

        .mo-approval-content .apd-body {
            padding: 12px 16px;
            gap: 12px;
        }

        .mo-approval-content .apd-fields-grid {
            grid-template-columns: 1fr 1fr;
        }

        .mo-approval-content .apd-footer {
            padding: 10px 16px;
        }
    }

    @@media (max-width: 480px) {
        .mo-approval-content .apd-fields-grid {
            grid-template-columns: 1fr;
        }

        .mo-approval-content .apd-body {
            padding: 10px 12px;
        }
    }
</style>

<div class="mo-approval-page">
    <div class="mo-approval-topbar">
        <button class="ap-btn-outline" @onclick="GoBack">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
                <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
            Back to Approvals
        </button>
    </div>
    <div class="mo-approval-content">
        <SchemeApprovalBody ApplicationId="@Id" OnActionCompleted="OnActionCompleted" />
    </div>
</div>

@code {
    [Parameter] public int Id { get; set; }

    private void GoBack()
    {
        Nav.NavigateTo("/SchemeApproval");
    }

    private void OnActionCompleted()
    {
        Nav.NavigateTo("/SchemeApproval");
    }
}
