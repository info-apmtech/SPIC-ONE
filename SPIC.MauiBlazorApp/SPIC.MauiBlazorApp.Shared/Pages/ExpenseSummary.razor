    .exs-empty-td { text-align: center !important; padding: 32px !important; color: #9ca3af; font-style: italic; }

    .exs-badge-status { padding: 4px 12px; border-radius: 999px; font-size: 11px; font-weight: 700; }
    .exs-badge-submitted { background: #16a34a; color: #fff; }
    .exs-badge-draft { background: #fde68a; color: #92400e; }

    .exs-view-btn { width: 30px; height: 30px; border-radius: 6px; border: 1px solid #e5e7eb; background: #fff; color: #2563eb; cursor: pointer; }
    .exs-view-btn:hover { background: #eff6ff; }

    .exs-pagination { display: flex; justify-content: space-between; align-items: center; padding: 16px 20px; border-top: 1px solid #e5e7eb; }
    .exs-items-per-page { display: flex; align-items: center; gap: 8px; font-size: 12px; color: #111827; }
    .exs-items-per-page select { padding: 6px 28px 6px 12px; border: 1px solid #e5e7eb; border-radius: 6px; background: #fff; appearance: none; }
    .exs-pagination-buttons { display: flex; align-items: center; gap: 4px; }
    .exs-page-btn { min-width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; background: #fff; border: 1px solid #e5e7eb; border-radius: 6px; font-size: 13px; color: #374151; cursor: pointer; }
    .exs-page-btn:hover { background: #f3f4f6; }
    .exs-page-btn:disabled { opacity: .5; cursor: not-allowed; }
    .exs-page-active { background: #065f46; border-color: #065f46; color: #fff; }
    .exs-page-ellipsis { color: #111827; padding: 0 4px; }

    .exs-charts-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    .exs-chart-card { padding: 20px; }
    .exs-chart-head { margin-bottom: 16px; }
    .exs-chart-head h2 { margin: 0; font-size: 16px; font-weight: 700; color: #111827; display: inline; }
    .exs-chart-head p { margin: 2px 0 0; font-size: 12px; color: #6b7280; }
    .exs-trend-wrap { height: 280px; }

    .exs-cat-list { display: flex; flex-direction: column; gap: 14px; }
    .exs-cat-row { display: flex; align-items: center; gap: 10px; }
    .exs-cat-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
    .exs-cat-name { width: 130px; flex-shrink: 0; font-size: 13px; color: #374151; }
    .exs-cat-bar-track { flex: 1; height: 10px; background: #f1f5f9; border-radius: 6px; overflow: hidden; }
    .exs-cat-bar-fill { height: 100%; border-radius: 6px; }
    .exs-cat-val { width: 90px; flex-shrink: 0; text-align: right; font-size: 13px; font-weight: 600; color: #111827; }

    .exs-drawer-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 18px; }
    .exs-drawer-stats div { display: flex; flex-direction: column; gap: 2px; font-size: 12px; color: #6b7280; }
    .exs-drawer-stats strong { font-size: 15px; color: #111827; display: flex; flex-direction: column; }
    .exs-drawer-stats strong small { font-size: 11px; font-weight: 500; color: #6b7280; }
    .exs-drawer-subhead { font-size: 14px; font-weight: 700; color: #1e293b; margin: 18px 0 2px; }
    .exs-drawer-note { font-size: 11px; color: #6b7280; margin: 0 0 8px; }
    .exs-drawer-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .exs-drawer-table th { background: #f3f4f6; padding: 10px 12px; text-align: left; font-size: 11px; color: #475569; }
    .exs-drawer-table td { padding: 10px 12px; border-bottom: 1px solid #f1f5f9; }
    .exs-drawer-table td:last-child { text-align: right; font-weight: 600; }
    .exs-auto-note { display: block; font-size: 10px; color: #16a34a; font-weight: 500; }

    .exs-grand-total { display: flex; justify-content: space-between; align-items: center; margin-top: 18px; padding: 14px 18px; background: #ecfdf5; border-radius: 10px; }
    .exs-grand-total div { display: flex; flex-direction: column; }
    .exs-grand-total strong { color: #065f46; font-size: 14px; }
    .exs-grand-total span:not(.exs-grand-total-val) { font-size: 11px; color: #047857; }
    .exs-grand-total-val { font-size: 18px; font-weight: 700; color: #065f46; }

    @@media (max-width: 1100px) {
        .exs-stats-grid { grid-template-columns: repeat(2, 1fr); }
        .exs-charts-grid { grid-template-columns: 1fr; }
    }

    @@media (max-width: 640px) {
        .exs-filters-grid { grid-template-columns: 1fr; }
        .exs-stats-grid { grid-template-columns: 1fr; }
        .exs-cat-name { width: 90px; }
    }
</style>

@code {
    private bool filtersExpanded = true;
    private bool isLoading = true;
    private bool _exporting;

    private string yearFilter = "";
    private string fromMonthFilter = "";
    private string toMonthFilter = "";
    private string categoryFilter = "";

    private ExpenseSummaryResponseDto summary = new();
    private List<ExpenseReportRowDto> allRows = new();

    private int currentPage = 1;
    private int pageSize = 16;

    private int TotalPages => allRows.Count == 0 ? 1 : (int)Math.Ceiling(allRows.Count / (double)pageSize);

    private IEnumerable<(ExpenseReportRowDto Row, int Index)> PagedRows =>
        allRows.Skip((currentPage - 1) * pageSize).Select((r, i) => (r, i)).Take(pageSize);

    private IEnumerable<int> VisiblePageNumbers
    {
        get
        {
            var total = TotalPages;
            var set = new SortedSet<int> { 1, total };
            for (var i = Math.Max(1, currentPage - 1); i <= Math.Min(total, currentPage + 1); i++) set.Add(i);
            for (var i = 1; i <= Math.Min(3, total); i++) set.Add(i);
            for (var i = Math.Max(1, total - 2); i <= total; i++) set.Add(i);

            var result = new List<int>();
            int? prev = null;
            foreach (var n in set)
            {
                if (prev is { } p && n - p > 1) result.Add(-1);
                result.Add(n);
                prev = n;
            }
            return result;
        }
    }

    private static readonly string[] Palette =
        { "#065f46", "#4ade80", "#8b5cf6", "#93c5fd", "#fbbf24", "#60a5fa", "#60a5fa", "#60a5fa", "#60a5fa" };

    private static string ChartColor(int i) => Palette[i % Palette.Length];

    // NOTE: the category dropdown is informational only in this pass (it lists real categories from
    // the data, but filtering the table/charts down to a single category isn't wired server-side yet
    // - expense-summary's rows/trend are always the full per-report totals). Revisit if per-category
    // row filtering turns out to be needed.
    protected override async Task OnInitializedAsync() => await LoadSummaryAsync();

    private string CurrentQueryString()
    {
        var qp = new List<string>();
        if (int.TryParse(yearFilter, out var y)) qp.Add($"year={y}");
        if (int.TryParse(fromMonthFilter, out var fm)) qp.Add($"fromMonth={fm}");
        if (int.TryParse(toMonthFilter, out var tm)) qp.Add($"toMonth={tm}");
        return qp.Count > 0 ? "?" + string.Join("&", qp) : "";
    }

    private async Task LoadSummaryAsync()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var result = await Http.GetFromJsonAsync<ExpenseSummaryResponseDto>("api/FarmReport/expense-summary" + CurrentQueryString());
            summary = result ?? new();
            allRows = summary.Rows;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Loading expense summary failed: {ex.Message}");
            summary = new();
            allRows = new();
        }
        finally
        {
            isLoading = false;
            currentPage = 1;
            StateHasChanged();
        }

        await RenderChartAsync();
    }

    private async Task RenderChartAsync()
    {
        if (summary.MonthlyTrend.Count == 0) return;

        var data = new
        {
            labels = summary.MonthlyTrend.Select(m => m.MonthLabel).ToArray(),
            values = summary.MonthlyTrend.Select(m => m.TotalExpense).ToArray()
        };

        try { await JS.InvokeVoidAsync("loadExpenseSummaryCharts", data); }
        catch (Exception ex) { Console.WriteLine($"Chart render failed: {ex.Message}"); }
    }

    private async Task ApplyFiltersAsync() => await LoadSummaryAsync();

    private async Task ClearFiltersAsync()
    {
        yearFilter = "";
        fromMonthFilter = "";
        toMonthFilter = "";
        categoryFilter = "";
        await LoadSummaryAsync();
    }

    private static string MonthName(int m) => new DateTime(2000, m, 1).ToString("MMMM");

    private static string FormatCurrency(decimal v) => $"₹{v:N0}";

    private void GoToPage(int page)
    {
        if (page < 1 || page > TotalPages) return;
        currentPage = page;
    }

    private void GoBack() => Nav.NavigateTo("/FifteenDaysEntry");

    private void ToggleFilters() => filtersExpanded = !filtersExpanded;

    private async Task DownloadExcelAsync()
    {
        if (_exporting) return;
        _exporting = true;
        try
        {
            var response = await Http.GetAsync("api/FarmReport/expense-summary/export" + CurrentQueryString());
            if (!response.IsSuccessStatusCode)
            {
                Toast.Error("Could not generate the Excel file.");
                return;
            }

            var bytes = await response.Content.ReadAsByteArrayAsync();
            var fileName = $"ExpenseSummary_{DateTime.Now:yyyyMMdd}.xlsx";
            await JS.InvokeVoidAsync("downloadFileFromBytes", fileName,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", Convert.ToBase64String(bytes));
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Excel export failed: {ex.Message}");
            Toast.Error("Could not download the Excel file.");
        }
        finally
        {
            _exporting = false;
        }
    }

    private Task DownloadDetailExcelAsync()
    {
        Toast.Info("Use 'Download Excel' on the main report list for the full export.");
        return Task.CompletedTask;
    }

    // ---- View details drawer ----
    private bool showDetailsDrawer;
    private bool isLoadingDetail;
    private ReportDetailsDto? selectedDetail;

    private async Task ViewReportAsync(int reportId)
    {
        showDetailsDrawer = true;
        isLoadingDetail = true;
        selectedDetail = null;
        StateHasChanged();

        try
        {
            selectedDetail = await Http.GetFromJsonAsync<ReportDetailsDto>($"api/FarmReport/{reportId}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Loading report details failed: {ex.Message}");
        }
        finally
        {
            isLoadingDetail = false;
            StateHasChanged();
        }
    }

