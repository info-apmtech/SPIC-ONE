@page "/AnnualBudgeting"
@using System.Net.Http.Json
@using System.Globalization
@using DR = SPIC.Core.Entities
@inject HttpClient Http
@inject LoadingService Loading
@inject LoginState LoginState

@code {
    private List<DR.AnnualBudgeting> _budgets = new();
    private List<DR.AnnualBudgeting> _filtered = new();
    private List<FinancialYearLookup> _financialYears = new();
    private DR.AnnualBudgeting _model = new() { FinancialYearId = 0, Amount = 0, IsActive = true };

    private bool _isEditMode;
    private bool _isSaving;
    private bool _isLoading = true;
    private bool _financialYearsLoaded;
    private bool _focusFinancialYear;
    private string _searchText = "";
    private string _statusFilter = "All";
    private string? _message;
    private bool _isError;

    // Deactivate/activate confirmation modal
    private bool _showDeleteModal;
    private int _deleteId;
    private string _deleteFY = "";

    private ElementReference _firstInputRef;

    private static readonly CultureInfo _inr = CultureInfo.CreateSpecificCulture("en-IN");

    private int TotalCount => _budgets.Count;
    private int ActiveCount => _budgets.Count(b => b.IsActive);
    private int InactiveCount => _budgets.Count(b => !b.IsActive);

    // Matches the existing api/FinancialYear/all response.
    private sealed class FinancialYearLookup
    {
        public FinancialYearLookup() { }
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public DateTime StartDate { get; set; }
        public DateTime EndDate { get; set; }
        public bool IsActive { get; set; }
    }

    private string GetFinancialYearName(DR.AnnualBudgeting budget)
    {
        var name = _financialYears.FirstOrDefault(x => x.Id == budget.FinancialYearId)?.Name;
        if (!string.IsNullOrWhiteSpace(name)) return name.Trim();
        return budget.FinancialYearId > 0 ? $"Financial Year #{budget.FinancialYearId}" : "";
    }

    private DR.AnnualBudgeting CopyBudget(DR.AnnualBudgeting source) => new()
    {
        Id = source.Id,
        FinancialYearId = source.FinancialYearId,
        Amount = source.Amount,
        IsActive = source.IsActive,
        CreatedBy = source.CreatedBy,
        CreatedAt = source.CreatedAt,
        UpdatedBy = source.UpdatedBy,
        UpdatedAt = source.UpdatedAt
    };

    protected override async Task OnInitializedAsync()
    {
        Loading.Show();
        try
        {
            await LoadFinancialYears();
            await LoadBudgets();
        }
        finally
        {
            _isLoading = false;
            Loading.Hide();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusFinancialYear)
        {
            _focusFinancialYear = false;
            await _firstInputRef.FocusAsync();
        }
    }

    private async Task LoadFinancialYears()
    {
        _financialYearsLoaded = false;
        try
        {
            _financialYears = (await Http.GetFromJsonAsync<List<FinancialYearLookup>>(
                "api/FinancialYear/all") ?? new())
                .OrderByDescending(x => x.StartDate)
                .ThenByDescending(x => x.Name)
                .ToList();
            _financialYearsLoaded = true;

            if (_financialYears.Count == 0)
                ShowMessage("Add a Financial Year in Financial Master before saving an annual budget.", true);
        }
        catch (Exception ex)
        {
            ShowMessage($"Failed to load financial years: {ex.Message}", true);
        }
    }

    private async Task LoadBudgets()
    {
        try
        {
            _budgets = await Http.GetFromJsonAsync<List<DR.AnnualBudgeting>>("api/AnnualBudgeting/all") ?? new();
            ApplyFilter();
        }
        catch (Exception ex)
        {
            ShowMessage($"Failed to load annual budgeting records: {ex.Message}", true);
        }
    }

    private void ApplyFilter()
    {
        IEnumerable<DR.AnnualBudgeting> query = _budgets;

        if (!string.IsNullOrWhiteSpace(_searchText))
            query = query.Where(b => GetFinancialYearName(b).Contains(_searchText, StringComparison.OrdinalIgnoreCase));

        if (_statusFilter == "Active") query = query.Where(b => b.IsActive);
        else if (_statusFilter == "Inactive") query = query.Where(b => !b.IsActive);

        _filtered = query.OrderByDescending(b => GetFinancialYearName(b)).ToList();
    }

    private void EditBudget(DR.AnnualBudgeting b)
    {
        if (_isLoading || _isSaving || !CanEditBudget) return;
        _model = CopyBudget(b);

        _isEditMode = true;
        _message = null;
        _focusFinancialYear = true;
    }

    private void ResetForm()
    {
        _model = new DR.AnnualBudgeting { FinancialYearId = 0, Amount = 0, IsActive = true };
        _isEditMode = false;
        _focusFinancialYear = false;
        _message = null;
    }

    private void ToggleFormStatus()
    {
        if (_isLoading || _isSaving) return;
        _model.IsActive = !_model.IsActive;
    }

    private async Task SaveBudget()
    {
        if (_isLoading || _isSaving) return;
        if (_isEditMode ? !CanEditBudget : !CanAddBudget) return;

        if (!_financialYearsLoaded)
        {
            ShowMessage("Financial years could not be loaded. Reload the page and try again.", true);
            return;
        }

        var selectedYear = _financialYears.FirstOrDefault(x => x.Id == _model.FinancialYearId);
        if (_model.FinancialYearId <= 0 || selectedYear == null)
        {
            ShowMessage("Please select a Financial Year", true);
            return;
        }
        if (string.IsNullOrWhiteSpace(selectedYear.Name))
        {
            ShowMessage("The selected Financial Year has no name. Update Financial Master first.", true);
            return;
        }
        string yearName = selectedYear.Name.Trim();

        if (_model.Amount <= 0)
        {
            ShowMessage("Amount must be greater than zero", true);
            return;
        }

        // One budget per master ID, including inactive records.
        bool duplicate = _budgets.Any(b =>
            b.Id != _model.Id &&
            b.FinancialYearId == _model.FinancialYearId);
        if (duplicate)
        {
            ShowMessage($"An Annual Budgeting record for '{yearName}' already exists", true);
            return;
        }

        _isSaving = true;
        try
        {
            _model.UpdatedBy = LoginState.UserId ?? "System";
            _model.UpdatedAt = DateTime.Now;

            if (!_isEditMode)
            {
                _model.CreatedBy = LoginState.UserId ?? "System";
                _model.CreatedAt = DateTime.Now;
            }

            using var response = _isEditMode && _model.Id > 0
                ? await Http.PutAsJsonAsync($"api/AnnualBudgeting/{_model.Id}", _model)
                : await Http.PostAsJsonAsync("api/AnnualBudgeting", _model);

            if (response.IsSuccessStatusCode)
            {
                ShowMessage(_isEditMode
                    ? $"Annual Budgeting for '{yearName}' updated successfully"
                    : $"Annual Budgeting for '{yearName}' saved successfully", false);
                ResetFormKeepMessage();
                await LoadBudgets();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                ShowMessage($"Failed to save: {error}", true);
            }
        }
        catch (Exception ex)
        {
            ShowMessage($"Error: {ex.Message}", true);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void ResetFormKeepMessage()
    {
        var msg = _message;
        var err = _isError;
        ResetForm();
        _message = msg;
        _isError = err;
    }

    private void OpenDeleteModal(DR.AnnualBudgeting b)
    {
        if (_isLoading || _isSaving || !CanDeleteBudget) return;
        _deleteId = b.Id;
        _deleteFY = GetFinancialYearName(b);
        _showDeleteModal = true;
    }

    private void CancelDelete()
    {
        _showDeleteModal = false;
        _deleteId = 0;
        _deleteFY = "";
    }

    // Soft delete: deactivate instead of hard DELETE, matching Designation's convention.
    private async Task ConfirmDelete()
    {
        if (_isLoading || _isSaving || !CanDeleteBudget) return;
        var target = _budgets.FirstOrDefault(x => x.Id == _deleteId);
        if (target == null) { CancelDelete(); return; }

        var yearName = GetFinancialYearName(target);
        _isSaving = true;
        try
        {
            // Include FinancialYearId; update the list only after the API succeeds.
            var request = CopyBudget(target);
            request.IsActive = false;
            request.UpdatedBy = LoginState.UserId ?? "System";
            request.UpdatedAt = DateTime.Now;

            using var response = await Http.PutAsJsonAsync($"api/AnnualBudgeting/{target.Id}", request);
            if (response.IsSuccessStatusCode)
            {
                ShowMessage($"Annual Budgeting for '{yearName}' deactivated successfully", false);
                if (_model.Id == target.Id) ResetFormKeepMessage();
                await LoadBudgets();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                ShowMessage($"Failed to deactivate: {error}", true);
            }
        }
        catch (Exception ex)
        {
            ShowMessage($"Failed to deactivate: {ex.Message}", true);
        }
        finally
        {
            _isSaving = false;
            CancelDelete();
        }
    }

    private async Task ReactivateBudget(DR.AnnualBudgeting b)
    {
        if (_isLoading || _isSaving || !CanEditBudget) return;
        var yearName = GetFinancialYearName(b);
        _isSaving = true;
        try
        {
            var request = CopyBudget(b);
            request.IsActive = true;
            request.UpdatedBy = LoginState.UserId ?? "System";
            request.UpdatedAt = DateTime.Now;

            using var response = await Http.PutAsJsonAsync($"api/AnnualBudgeting/{b.Id}", request);
            if (response.IsSuccessStatusCode)
            {
                ShowMessage($"Annual Budgeting for '{yearName}' activated successfully", false);
                await LoadBudgets();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                ShowMessage($"Failed to activate: {error}", true);
            }
        }
        catch (Exception ex)
        {
            ShowMessage($"Failed to activate: {ex.Message}", true);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void ShowMessage(string message, bool isError)
    {
        _message = message;
        _isError = isError;
    }

    private static string FormatAmount(decimal amount) => amount.ToString("C0", _inr);

    private bool CanAddBudget => LoginState.Can("AnnualBudgeting", "Entry");
    private bool CanEditBudget => LoginState.Can("AnnualBudgeting", "Update");
    private bool CanDeleteBudget => LoginState.Can("AnnualBudgeting", "Delete");
}

<style>
