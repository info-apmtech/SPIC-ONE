    }

    .ab-list-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 16px;
    }

    .ab-list-title {
        font-size: 1.05rem;
        font-weight: 700;
