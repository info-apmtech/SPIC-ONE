    }

    .ab-stat-card {
        flex: 1;
        min-width: 220px;
        border: 1px solid #E5E7EB;
        border-radius: 12px;
        padding: 18px 20px;
    }

        .ab-stat-card.total {
            background: linear-gradient(135deg, #EEF2FF, #F8FAFF);
        }

        .ab-stat-card.active {
            background: linear-gradient(135deg, #ECFDF5, #F0FDFA);
        }

        .ab-stat-card.inactive {
            background: #F3F4F6;
        }

    .ab-stat-label {
        font-size: 0.82rem;
        color: #1F2937;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .ab-stat-value {
        font-size: 1.5rem;
