        gap: 12px;
    }

    .ab-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 9px 20px;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        transition: .2s;
        border: 1px solid transparent;
    }

    .ab-btn-cancel {
        background: #fff;
        border-color: #D1D5DB;
        color: #4B5563;
    }

        .ab-btn-cancel:hover {
            background: #F9FAFB;
        }

    .ab-btn-save {
        background: #2563EB;
        color: #fff;
    }

        .ab-btn-save:hover {
            background: #1D4ED8;
        }

        .ab-btn-save:disabled {
            opacity: .6;
            cursor: not-allowed;
        }

    /* --- Stat Cards --- */
    .ab-stats-row {
        display: flex;
        gap: 16px;
        margin-bottom: 24px;
