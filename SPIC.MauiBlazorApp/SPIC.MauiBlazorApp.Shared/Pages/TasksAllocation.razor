    private bool isLoadingPrograms = true;
    private bool programsLoadFailed;

    private readonly List<ProgramOption> Programs = new();

    // MD programs are assigned directly on the CSR1 record (ResponsiblePersonId), not something
    // the JMDO picks for themselves - api/CSR1/list?mine=true scopes the result server-side to
    // only the CSR1 rows where the signed-in JMDO IS the responsible person, so every program
    // returned here is automatically part of this week's submission.
    private async Task LoadProgramsAsync()
    {
        isLoadingPrograms = true;
        programsLoadFailed = false;

        try
        {
            // GetFromJsonAsync throws on any non-2xx before ever reading the body, which discards
            // the server's actual error message (CSR1Controller returns { message, error } on a
            // 500) - using SendAsync and reading the body on failure keeps that detail in the
            // console instead of losing it, so a future mismatch is diagnosable in seconds, not an
            // afternoon of archaeology (2026-10-24: this is exactly what happened here).
            using var response = await Http.GetAsync("api/CSR1/list?mine=true");
            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                throw new HttpRequestException(
                    $"{(int)response.StatusCode} {response.StatusCode}: {body}");
            }

            var result = await response.Content.ReadFromJsonAsync<List<CSR1ListDto>>();

            Programs.Clear();
            Programs.AddRange((result ?? new())
                .Where(p => p.IsActive)
                .Select(p => new ProgramOption
                {
                    Id = p.Id,
                    Title = p.ProgramName,
                    SanctionNo = !string.IsNullOrWhiteSpace(p.SanctionNo) ? p.SanctionNo : $"MD-{p.Id}",
                    SanctionDate = p.CSR1Date != default && p.CSR1Date != DateTime.MinValue
                        ? p.CSR1Date.ToString("dd MMM yyyy")
                        : (p.CreatedAt != default ? p.CreatedAt.ToString("dd MMM yyyy") : "—"),
                    ProgramCount = p.NumberOfPrograms,
                    TotalBudget = p.Budget > 0 ? (p.Budget % 1 == 0 ? $"₹{p.Budget:N0}" : $"₹{p.Budget:N2}") : "—",
                    TypeLabel = string.IsNullOrWhiteSpace(p.ProgramType) ? "Training" : p.ProgramType,
                    CreatedAt = p.CreatedAt
                }));
        }
        catch (Exception ex)
        {
            Console.WriteLine($"MD program list load failed: {ex.Message}");
            Toast.Error("Could not load the MD program list. Please try again.");
            programsLoadFailed = true;
        }
        finally
        {
            isLoadingPrograms = false;
        }
    }

    // Every loaded program is already assigned to this JMDO (see LoadProgramsAsync) - there is no
    // separate "selected" subset anymore, this just names the full list for the submit/summary code
    // below so that logic didn't need to change.
    private IEnumerable<ProgramOption> SelectedPrograms => Programs;

    private string FormatProgramSanctionNo(JmdoAllocationProgramRowDto program)
    {
        if (!string.IsNullOrWhiteSpace(program.SanctionNo))
            return program.SanctionNo;

        var opt = Programs.FirstOrDefault(p => p.Id == program.Csr1Id);
        if (!string.IsNullOrWhiteSpace(opt?.SanctionNo))
            return opt.SanctionNo;

        return $"MD-{program.Csr1Id}";
    }

    private string FormatProgramSanctionDate(JmdoAllocationProgramRowDto program)
    {
        if (program.SanctionDate.HasValue && program.SanctionDate.Value != default && program.SanctionDate.Value != DateTime.MinValue)
            return program.SanctionDate.Value.ToString("dd MMM yyyy");

        var opt = Programs.FirstOrDefault(p => p.Id == program.Csr1Id);
        if (!string.IsNullOrWhiteSpace(opt?.SanctionDate) && opt.SanctionDate != "—")
            return opt.SanctionDate;

        return "—";
    }

    private void GoBack()
    {
        if (NavHistory.TryGoBack())
            return;
        Navigation.NavigateTo(LoginState.LandingPage);
    }
}
