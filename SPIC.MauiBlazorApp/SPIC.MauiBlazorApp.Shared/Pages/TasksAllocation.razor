        summaryToDate = DateTime.Today;
        summaryDealerFilter = "";
        summaryStatusFilter = "";
        appliedSummaryFrom = DateTime.Today;
        appliedSummaryTo = DateTime.Today;
        appliedSummaryDealer = "";
        appliedSummaryStatus = "";
    }

    // Same week-range convention as Task History's MatchesCompletedWeekFilter - both From/To and
