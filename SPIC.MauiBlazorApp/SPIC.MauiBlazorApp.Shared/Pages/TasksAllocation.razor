    // Parses the same "dealer_{id}" / "prog_{id}" / "spcm" / "soil" / "pos" key
    // convention TaskDetail.razor builds for itself, reading status straight off
    // the currently-loaded allocation instead of a shared in-memory dictionary.
    private AllocTaskStatus GetStatus(string taskId)
    {
        if (todayAllocation is null) return AllocTaskStatus.YetToStart;

        if (taskId.StartsWith("dealer_", StringComparison.Ordinal)
            && int.TryParse(taskId.AsSpan("dealer_".Length), out var dealerId))
        {
            return todayAllocation.DealerAssignments.FirstOrDefault(d => d.DealerId == dealerId)?.Status ?? AllocTaskStatus.YetToStart;
        }

        if (taskId.StartsWith("prog_", StringComparison.Ordinal)
            && int.TryParse(taskId.AsSpan("prog_".Length), out var csr1Id))
        {
            return todayAllocation.Programs.FirstOrDefault(p => p.Csr1Id == csr1Id)?.Status ?? AllocTaskStatus.YetToStart;
        }

        return taskId switch
        {
            "spcm" => todayAllocation.SpcmStatus,
            "soil" or "soilsample" => todayAllocation.SoilSampleStatus,
            "pos" or "posliquidation" => todayAllocation.PosLiquidationStatus,
            _ => AllocTaskStatus.YetToStart
        };
    }

    // Soil Sample has no TaskDetail-style page of its own - its Start button goes straight to
    // the SAS Sample Collection wizard - so unlike Dealer/SPCM/MD Program/PoS (which only flip
    // to InProgress once the user presses "Start Task" inside TaskDetail), this is the only place
    // that can mark it InProgress at all. Safe to call every time the button is pressed: the
    // server only stamps SoilSampleStartedAt the first time (never overwritten), and this card
    // only renders for YetToStart/InProgress status, never Completed.
    private async Task StartSoilSampleTask()
    {
        // Same friendly-redirect gate as TaskDetail.StartTask - server-enforced too
        // (JmdoTaskAllocationController.UpdateMyTaskStatus), this just avoids sending the JMDO into
        // the Sample Collection wizard when the status flip below is about to be rejected anyway.
        var (loaded, todayAttendance) = await AttendanceApi.LoadTodayAsync();
        if (loaded && todayAttendance is null)
        {
            Toast.Warning("Mark today's attendance before starting a task.");
            Navigation.NavigateTo("/MarkAttendance");
            return;
        }

        try
        {
            await Http.PutAsJsonAsync("api/JmdoTaskAllocation/mine/task-status",
                new UpdateTaskStatusDto { TaskKey = "soil", Status = AllocTaskStatus.InProgress });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Could not mark Soil Sample task in-progress: {ex.Message}");
        }

        Navigation.NavigateTo("/SampleCollection/new");
    }

    private int CountByStatus(AllocTaskStatus status)
    {
        if (todayAllocation is null) return 0;
        int count = 0;
        foreach (var d in todayAllocation.DealerAssignments.Where(x => x.Day == DateTime.Today.DayOfWeek))
            if (GetStatus($"dealer_{d.DealerId}") == status) count++;
        foreach (var p in todayAllocation.Programs)
            if (GetStatus($"prog_{p.Csr1Id}") == status) count++;
        if (todayAllocation.SpcmTarget is > 0 && GetStatus("spcm") == status) count++;
        if (todayAllocation.SoilSampleTarget is > 0 && GetStatus("soil") == status) count++;
        if ((todayAllocation.UreaTarget > 0 || todayAllocation.NpsTarget > 0 || todayAllocation.DapTarget > 0 || todayAllocation.OthersTarget > 0) && GetStatus("pos") == status) count++;
        return count;
    }

