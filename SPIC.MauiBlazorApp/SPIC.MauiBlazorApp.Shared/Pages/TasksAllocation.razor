@code {
    private enum TaTab { All, Today, Completed }

    // Lets links like /TasksAllocation?tab=today (used by TaskDetail's
    // "Back to Tasks") land on the right tab instead of always resetting to
    // "All Allocations" - navigating here creates a fresh component
    // instance, so currentTab's default wouldn't otherwise remember it.
    [SupplyParameterFromQuery(Name = "tab")]
    public string? TabQuery { get; set; }

    private TaTab currentTab = TaTab.All;

    protected override void OnInitialized()
    {
        currentTab = TabQuery?.ToLowerInvariant() switch
        {
            "today" => TaTab.Today,
            "completed" => TaTab.Completed,
            _ => TaTab.All
        };
    }

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(
            LoadDealersAsync(),
            LoadProgramsAsync(),
            LookupCache.EnsureLoadedAsync(),
            CheckExistingAllocationAsync());
    }

    private string HeaderSubtitle => currentTab switch
    {
        TaTab.Today => "Pick your dealer tasks and set today's targets, then track them through to completion.",
        _ => "Everything assigned to you, what's approved for today, and what you've finished."
    };

    // Static placeholder flow: no Allocation API exists yet, so submitting
    // just flips the "All Allocations" tab from the wizard to the
    // awaiting-approval card (see TasksAllocation's original notes on the
    // pending-approval design for why that card has no live data either).
    private bool isAllocationSubmitted;
    private JmdoTaskAllocationResponseDto? todayAllocation;

    // ---------- Today's Allocation tab ----------
    // The 5 tasks shown here are the ones picked/targeted in the wizard
    // above (Hanumesh Trading Co, Crop Protection Workshop, SPCM/Soil
    // targets, PoS liquidation products) - static placeholder mirroring
    // that example data, since there's no Allocation API yet to actually
    // link "submitted" to "today's tasks".
    private enum AllocTaskStatus { YetToStart, InProgress, Completed }

    private static AllocTaskStatus todayFilter = AllocTaskStatus.YetToStart;
    private bool todayStepperCollapsed;

    private sealed record TodayFilter(int Number, string Label, AllocTaskStatus Status);

    private static readonly List<TodayFilter> TodayFilters = new()
    {
        new(1, "Yet to Start", AllocTaskStatus.YetToStart),
        new(2, "In Progress", AllocTaskStatus.InProgress),
        new(3, "Completed", AllocTaskStatus.Completed)
    };

    // Spread across all three statuses (rather than all defaulting to Yet to
    // Start) so every filter tab has a real card to show out of the box -
    // otherwise "In Progress"/"Completed" always rendered the empty state
    // until a user manually clicked Start/Continue on something first, which
    // hid the green/purple themes entirely on a fresh page load.
    private static Dictionary<string, AllocTaskStatus> _taskStatuses = new();

    private AllocTaskStatus GetStatus(string taskId) =>
        _taskStatuses.TryGetValue(taskId, out var s) ? s : AllocTaskStatus.YetToStart;

    private void StartAndNavigate(string taskId, string taskType)
    {
        var current = GetStatus(taskId);
        if (current == AllocTaskStatus.YetToStart)
        {
            _taskStatuses[taskId] = AllocTaskStatus.InProgress;
            todayFilter = AllocTaskStatus.InProgress;
        }
        Navigation.NavigateTo($"/TaskDetail?type={taskType}");
    }

    private int CountByStatus(AllocTaskStatus status)
    {
        if (todayAllocation is null || todayAllocation.Status != "Approved") return 0;
        int count = 0;
        foreach (var d in todayAllocation.DealerAssignments.Where(x => (x.PlannedDate?.Date == DateTime.Today) || (x.PlannedDate == null && x.Day == DateTime.Today.DayOfWeek)))
            if (GetStatus($"dealer_{d.DealerId}") == status) count++;
        foreach (var p in todayAllocation.Programs)
            if (GetStatus($"prog_{p.Csr1Id}") == status) count++;
        if (todayAllocation.SpcmTarget is > 0 && GetStatus("spcm") == status) count++;
        if (todayAllocation.SoilSampleTarget is > 0 && GetStatus("soil") == status) count++;
        if ((todayAllocation.UreaTarget > 0 || todayAllocation.NpsTarget > 0 || todayAllocation.DapTarget > 0 || todayAllocation.OthersTarget > 0) && GetStatus("pos") == status) count++;
        return count;
    }

    // The sidebar notification badges are the static 1 / 2 / 1 from the
    // Figma design, not a live count of the 5 example cards above (those
    // numbers don't correspond to this placeholder set - they represent
    // other tasks not shown here). CountByStatus stays live since it drives
    // which cards are actually visible under each filter.
    private int BadgeCount(AllocTaskStatus status) => CountByStatus(status);

    private string EmptyTodayTitle => todayFilter switch
    {
        AllocTaskStatus.YetToStart => "Nothing left to start",
        AllocTaskStatus.InProgress => "Nothing in progress right now",
        _ => "Nothing completed yet"
    };

    // Card theme + button label follow the task's own status, not just
    // whichever filter is currently selected (though in practice a card
    // only renders while its status matches the active filter anyway).
    private static string StatusCardClass(AllocTaskStatus status) => status switch
    {
        AllocTaskStatus.InProgress => "ta-status-inprogress",
        AllocTaskStatus.Completed => "ta-status-completed",
        _ => ""
    };

    private static string ActionLabel(AllocTaskStatus status) => status switch
    {
        AllocTaskStatus.InProgress => "Continue",
        AllocTaskStatus.Completed => "View Details",
        _ => "Start"
    };

    // The floating shortcut button jumps to whichever status comes after the
    // one currently being viewed (Yet to Start -> In Progress -> Completed),
    // and only shows if that status actually has something in it.
    private AllocTaskStatus? NextStatus => todayFilter switch
    {
        AllocTaskStatus.YetToStart => AllocTaskStatus.InProgress,
        AllocTaskStatus.InProgress => AllocTaskStatus.Completed,
        _ => null
    };

    // MD Program / Soil Sample / PoS Liquidation don't have a dedicated detail
    // page yet (only Dealer and SPCM do, via TaskDetail) - same placeholder
    // pattern as TaskDetail's own "not built yet" quick actions.
    private void ViewDetailsNotAvailable() => Toast.Info("Detailed view for this task type isn't built yet.");



    private int currentStep = 1;
    private bool stepperCollapsed;

    // Resolved from the signed-in user's own HQ via the same Headquarters
    // lookup-by-id (LocationItemDto carries both the HQ and its Region name
    // on one row) already used elsewhere in the app - falls back to the old
    // placeholder strings if the HQ isn't found yet (still loading, or the
    // user has no HQ claim), so the UI never goes blank.
    private string FieldExecRegion =>
        LookupCache.Headquarters.FirstOrDefault(h => h.Id == LoginState.HQId)?.RegionName is { Length: > 0 } region
            ? region.ToUpperInvariant()
            : "COIMBATORE";

    private const string FieldExecMoHq = "-";

    private string FieldExecJmdoHq =>
        LookupCache.Headquarters.FirstOrDefault(h => h.Id == LoginState.HQId)?.HeadquarterName is { Length: > 0 } hq
            ? hq.ToUpperInvariant()
            : "COIMBATORE";

    private string spcmTarget = "";
    private string soilTarget = "";
    private string ureaTarget = "";
    private string dapTarget = "";
    private string npsTarget = "";
    private string othersTarget = "";

    private sealed record WizardStep(int Number, string Label);

    private static readonly List<WizardStep> Steps = new()
    {
        new(1, "Dealer"),
        new(2, "SPCM"),
        new(3, "Soil Sample"),
        new(4, "MD Program"),
        new(5, "PoS liquidation")
    };

    private void GoToStep(int step)
    {
        if (step < 1 || step > Steps.Count) return;
        currentStep = step;
    }

    private void ToggleStepper() => stepperCollapsed = !stepperCollapsed;

    private string submittedSummary = "";
    private bool isSubmittingAllocation;

    private static int? ParseTargetOrNull(string value) => int.TryParse(value, out var n) ? n : null;

    private async Task SubmitAllocationAsync()
    {
        if (isSubmittingAllocation) return;
        isSubmittingAllocation = true;

        try
        {
            var dto = new JmdoTaskAllocationCreateDto
            {
                DealerAssignments = selectionsByDay
                    .SelectMany(kvp => kvp.Value.Select(dealerId => new JmdoDealerDayAssignmentDto { DealerId = dealerId, Day = kvp.Key }))
                    .ToList(),
                SpcmTarget = ParseTargetOrNull(spcmTarget),
                SoilSampleTarget = ParseTargetOrNull(soilTarget),
                ProgramIds = SelectedPrograms.Select(p => p.Id).ToList(),
                UreaTarget = ParseTargetOrNull(ureaTarget),
                DapTarget = ParseTargetOrNull(dapTarget),
                NpsTarget = ParseTargetOrNull(npsTarget),
                OthersTarget = ParseTargetOrNull(othersTarget)
            };

            var response = await Http.PostAsJsonAsync("api/JmdoTaskAllocation", dto);
            if (!response.IsSuccessStatusCode)
            {
                Toast.Error("Could not submit the allocation. Please try again.");
                return;
            }

            var saved = await response.Content.ReadFromJsonAsync<JmdoTaskAllocationResponseDto>();
            submittedSummary = BuildSubmittedSummary(saved);

            isAllocationSubmitted = true;
            currentStep = 1;
            Toast.Success("Allocation submitted for MDO approval.");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Allocation submit failed: {ex.Message}");
            Toast.Error("Could not submit the allocation. Please try again.");
        }
        finally
        {
            isSubmittingAllocation = false;
        }
    }

    private static string BuildSubmittedSummary(JmdoTaskAllocationResponseDto? saved) =>
        saved is null
            ? "Allocation submitted."
            : $"{saved.DealerCount} dealer task(s) · SPCM target {saved.SpcmTarget ?? 0} · Soil target {saved.SoilSampleTarget ?? 0} · {saved.ProgramCount} program(s)";

    // Rehydrates "already submitted today" across a page refresh, since the
    // wizard's submitted state would otherwise reset to step 1 every reload.
    private async Task CheckExistingAllocationAsync()
    {
        try
        {
            var response = await Http.GetAsync("api/JmdoTaskAllocation/mine/today");
            if (response.StatusCode == System.Net.HttpStatusCode.NoContent || !response.IsSuccessStatusCode)
                return;

            var existing = await response.Content.ReadFromJsonAsync<JmdoTaskAllocationResponseDto>();
            if (existing is null) return;
            todayAllocation = existing;

            foreach (var assignment in existing.DealerAssignments)
            {
                if (assignment.Day is { } day)
                    selectionsByDay[day].Add(assignment.DealerId);
            }

            submittedSummary = BuildSubmittedSummary(existing);
            isAllocationSubmitted = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Checking today's allocation failed: {ex.Message}");
        }
    }

    private async Task CopyCode(string code)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
            Toast.Success($"{code} copied.");
        }
        catch
        {
            // Clipboard API unavailable (e.g. no secure context): nothing to copy to.
        }
    }

    private sealed class DealerOption
    {
        public int Id { get; init; }
        public string Name { get; init; } = "";
        public string DealerCode { get; init; } = "";
        public string? IfmsId { get; init; }
        public string? PosLiquidation { get; init; }
        public int? PendingAckMt { get; init; }
        public string TypeLabel { get; init; } = "Dealer";
    }

    // Sun-Sat tabs (confirmed with the user: full weekly planning, not just a
    // filter) - DayOfWeek's own numeric order already runs Sunday(0)..Saturday(6).
    private static readonly DayOfWeek[] WeekDays =
    {
        DayOfWeek.Sunday, DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday,
        DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday
    };

    private DateTime GetDateForDay(DayOfWeek day)
    {
        var today = DateTime.Today;
        int diff = day - today.DayOfWeek;
        return today.AddDays(diff);
    }

    private string DayLabel(DayOfWeek day) => $"{day.ToString().Substring(0, 3)}, {GetDateForDay(day):dd MMM}";

    private DayOfWeek selectedDay = DateTime.Today.DayOfWeek;

    // One independent dealer-id set per weekday - a dealer can be picked for
    // more than one day, and switching tabs must not lose another day's picks.
    private readonly Dictionary<DayOfWeek, HashSet<int>> selectionsByDay =
        WeekDays.ToDictionary(d => d, _ => new HashSet<int>());

    private string dealerSearch = "";
    private bool isLoadingDealers = true;
    private bool dealersLoadFailed;

    private readonly List<DealerOption> Dealers = new();

    // Real dealer list, scoped to the signed-in JMDO/MDO/MO's HQ (falling
    // back to region/state) - same endpoint and scope-derivation pattern as
    // SubDealerList.razor's ApplyLoggedInRoleScope/LoadListAsync.
    private async Task LoadDealersAsync()
    {
        isLoadingDealers = true;
        dealersLoadFailed = false;

        try
        {
            // GetList's `status` query param binds to SubDealerRegistrationController's own
            // int? SubDealerStatus, not the string "Active" - see SubDealerRegistrationController.cs.
            var query = new List<string> { "page=1", "pageSize=1000", $"status={(int)SubDealerStatus.Active}" };

            if (LoginState.HQId > 0) query.Add($"hqId={LoginState.HQId}");
            else if (LoginState.RegionId > 0) query.Add($"regionId={LoginState.RegionId}");
            else if (LoginState.StateId > 0) query.Add($"stateId={LoginState.StateId}");

            var url = "api/SubDealerRegistration/list?" + string.Join("&", query);
            var result = await Http.GetFromJsonAsync<SubDealerPagedListResponse>(url);

            Dealers.Clear();
            Dealers.AddRange((result?.Items ?? new()).Select(item => new DealerOption
            {
                Id = item.Id,
                Name = item.FirmName,
                DealerCode = item.SubDealerCode,
                // SubDealerRegistration carries both a wholesale and a
                // retail mFMS id slot per dealer, but never both at once
                // in practice - whichever is populated is this dealer's
                // real type (replaces the old generic "Dealer" badge).
                TypeLabel = !string.IsNullOrWhiteSpace(item.WholesaleMFMSId) ? "Wholesaler"
                    : !string.IsNullOrWhiteSpace(item.RetailMFMSId) ? "Retailer"
                    : "Dealer"
                // IfmsId/PosLiquidation/PendingAckMt stay null ("—"):
                // SubDealerRegistration, the Pending Ack./LiquidationCycle
                // dealer records, and IfmsDealer are three separate identity
                // systems with no shared code or FK between them (confirmed
                // by tracing PendingAckService/LiquidationCycleService/
                // IfmsDealer) - there's no real join to fetch these from.
            }));
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Dealer list load failed: {ex.Message}");
            Toast.Error("Could not load the dealer list. Please try again.");
            dealersLoadFailed = true;
        }
        finally
        {
            isLoadingDealers = false;
        }
    }

    private IEnumerable<DealerOption> FilteredDealers =>
        string.IsNullOrWhiteSpace(dealerSearch)
            ? Dealers
            : Dealers.Where(d =>
                d.Name.Contains(dealerSearch, StringComparison.OrdinalIgnoreCase) ||
                d.DealerCode.Contains(dealerSearch, StringComparison.OrdinalIgnoreCase));

    private bool IsDealerSelected(DealerOption dealer) => selectionsByDay[selectedDay].Contains(dealer.Id);

    private IEnumerable<DealerOption> SelectedDealersFor(DayOfWeek day) =>
        Dealers.Where(d => selectionsByDay[day].Contains(d.Id));

    private void ToggleDealer(DealerOption dealer)
    {
        var set = selectionsByDay[selectedDay];
        if (!set.Add(dealer.Id))
            set.Remove(dealer.Id);
    }

    private sealed class ProgramOption
    {
        public int Id { get; init; }
        public string Title { get; init; } = "";
        // CSR1 (the real backend entity) has no Sanction No/Date columns at
        // all yet - confirmed via CSR-1Management.razor itself already
        // rendering "--" for Sanction Number against this same API. Null
        // here renders as "—" in the card, same as the dealer grid's fallbacks.
        public string? SanctionNo { get; init; }
        public string? SanctionDate { get; init; }
        public int ProgramCount { get; init; }
        public string TotalBudget { get; init; } = "";
        public string TypeLabel { get; init; } = "";
        // CSR1 has no MDO-assigned schedule date - CreatedAt (when the
        // program record was entered) is the only date available, so the
        // weekday badge is derived from that.
        public DateTime CreatedAt { get; init; }
        public bool IsSelected { get; set; }
    }

    private bool isLoadingPrograms = true;
    private bool programsLoadFailed;

    private readonly List<ProgramOption> Programs = new();

    // Real MD program list from CSR1 (api/CSR1/list has no query params or
    // server-side scoping at all - unlike SubDealerRegistration - so the
    // HQ filter happens client-side here).
    private async Task LoadProgramsAsync()
    {
        isLoadingPrograms = true;
        programsLoadFailed = false;

        try
        {
            var result = await Http.GetFromJsonAsync<List<CSR1ListDto>>("api/CSR1/list");

            Programs.Clear();
            Programs.AddRange((result ?? new())
                .Where(p => p.IsActive)
                .Select(p => new ProgramOption
                {
                    Id = p.Id,
                    Title = p.ProgramName,
                    ProgramCount = p.NumberOfPrograms,
                    TotalBudget = $"₹{p.Budget:N0}",
                    TypeLabel = string.IsNullOrWhiteSpace(p.ProgramType) ? "Training" : p.ProgramType,
                    CreatedAt = p.CreatedAt
                }));
        }
        catch (Exception ex)
        {
            Console.WriteLine($"MD program list load failed: {ex.Message}");
            Toast.Error("Could not load the MD program list. Please try again.");
            programsLoadFailed = true;
        }
        finally
        {
            isLoadingPrograms = false;
        }
    }

    private IEnumerable<ProgramOption> SelectedPrograms => Programs.Where(p => p.IsSelected);

    private void ToggleProgram(ProgramOption program) => program.IsSelected = !program.IsSelected;
}
