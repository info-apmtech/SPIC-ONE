    private DateTime? summaryFromDate = DateTime.Today;
    private DateTime? summaryToDate = DateTime.Today;
    private string summaryDealerFilter = "";
    private string summaryStatusFilter = "";

    private DateTime? appliedSummaryFrom = DateTime.Today;
    private DateTime? appliedSummaryTo = DateTime.Today;
    private string appliedSummaryDealer = "";
    private string appliedSummaryStatus = "";

    private void ApplySummaryFilters()
