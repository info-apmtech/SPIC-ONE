    private readonly List<DealerOption> Dealers = new();

    // Real dealer list, scoped to the signed-in JMDO/MDO/MO's HQ (falling
    // back to region/state) - same scope-derivation pattern as
    // SubDealerList.razor's ApplyLoggedInRoleScope/LoadListAsync, now sourced from
    // DealerRegistration (api/DealerRegistration/list) instead of SubDealerRegistration: it's
    // the same dealer master the Excel-uploaded sales/stock data is keyed to
    // (DealerRegistrationId), so a dealer picked here resolves to real iFMS ID/PoS
    // Liquidation/Pending Ack on the allocation cards below - SubDealerRegistration had no
    // relationship to that data at all.
    private async Task LoadDealersAsync()
    {
        isLoadingDealers = true;
        dealersLoadFailed = false;

        try
        {
            var query = new List<string> { "page=1", "pageSize=100" };

            if (LoginState.HQId > 0) query.Add($"hqId={LoginState.HQId}");
            else if (LoginState.RegionId > 0) query.Add($"regionId={LoginState.RegionId}");
            else if (LoginState.StateId > 0) query.Add($"stateId={LoginState.StateId}");

            var url = "api/DealerRegistration/list?" + string.Join("&", query);
            var result = await Http.GetFromJsonAsync<DealerPagedListResponse>(url);

            Dealers.Clear();
            Dealers.AddRange((result?.Items ?? new()).Select(item => new DealerOption
            {
                Id = item.Id,
                Name = item.FirmName,
                DealerCode = item.DealerCode ?? "",
                TypeLabel = item.TypeLabel,
                DistrictId = item.DistrictId,
                Taluk = item.Taluk,
                IfmsId = item.IfmsId,
                PosLiquidationQty = item.PosLiquidationQty,
                PendingAckQty = item.PendingAckQty
            }));
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Dealer list load failed: {ex.Message}");
            Toast.Error("Could not load the dealer list. Please try again.");
            dealersLoadFailed = true;
        }
        finally
        {
            isLoadingDealers = false;
        }
    }

