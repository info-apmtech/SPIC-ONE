@page "/TasksAllocation"
@using System.Net.Http.Json
@using SPIC.Core.DTOs
@using SPIC.Core.Entities
@using SPIC.MauiBlazorApp.Shared.Services
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject HttpClient Http
@inject SPIC.MauiBlazorApp.Shared.Services.LoginState LoginState
@inject SPIC.MauiBlazorApp.Shared.Services.ToastService Toast
@inject SPIC.MauiBlazorApp.Shared.Services.LookupCacheService LookupCache
@inject SPIC.MauiBlazorApp.Shared.Services.JMDOAttendanceApi AttendanceApi
@inject SPIC.MauiBlazorApp.Shared.Services.NavHistoryService NavHistory

<div class="container-fluid py-4 px-0 ta-page">

    <!-- Header card -->
    <div class="ta-header-card">
        <div class="d-flex align-items-center gap-3">
            <button type="button" class="btn btn-outline-secondary rounded-circle d-inline-flex align-items-center justify-content-center p-0 flex-shrink-0" style="width: 38px; height: 38px;" @onclick="GoBack" aria-label="Go back" title="Go back">
                <i class="bi bi-arrow-left fs-5"></i>
            </button>
            <div>
                <h2 class="ta-title mb-1">Tasks Allocation</h2>
                <p class="ta-subtitle mb-0">@HeaderSubtitle</p>
            </div>
        </div>
    </div>

    <!-- Tabs + content card -->
    <div class="ta-content-card">
        <div class="ta-tabs" role="tablist">
            <button type="button"
                    class="ta-tab @(currentTab == TaTab.All ? "active" : "")"
                    role="tab"
                    aria-selected="@(currentTab == TaTab.All ? "true" : "false")"
                    @onclick="() => currentTab = TaTab.All">
                All Allocations
            </button>
            <button type="button"
                    class="ta-tab @(currentTab == TaTab.Today ? "active" : "")"
                    role="tab"
                    aria-selected="@(currentTab == TaTab.Today ? "true" : "false")"
                    @onclick="() => currentTab = TaTab.Today">
                Today's Allocation
            </button>
            <button type="button"
                    class="ta-tab @(currentTab == TaTab.Completed ? "active" : "")"
                    role="tab"
                    aria-selected="@(currentTab == TaTab.Completed ? "true" : "false")"
                    @onclick="() => currentTab = TaTab.Completed">
                Task History
            </button>
            <button type="button"
                    class="ta-tab @(currentTab == TaTab.Summary ? "active" : "")"
                    role="tab"
                    aria-selected="@(currentTab == TaTab.Summary ? "true" : "false")"
                    @onclick="() => currentTab = TaTab.Summary">
                Task Summary
            </button>
        </div>

        @if (currentTab == TaTab.All)
        {
            <div class="ta-week-nav">
                <button type="button" class="ta-week-nav-btn" @onclick="() => ChangeWeek(-1)" disabled="@_isCheckingPlanning">
                    <i class="bi bi-chevron-left"></i> Previous Week
                </button>
                <span class="ta-week-nav-label">@WeekRangeLabel</span>
                <button type="button" class="ta-week-nav-btn" @onclick="() => ChangeWeek(1)" disabled="@_isCheckingPlanning">
                    Next Week <i class="bi bi-chevron-right"></i>
                </button>
            </div>

            @if (_isCheckingPlanning)
            {
                <EmptyState Icon="bi-hourglass-split" Title="Checking this week's allocation..." Compact="true" />
            }
            else if (isPlanningSubmitted)
            {
                @if (planningAllocation?.Status == "Approved")
                {
                    <div class="ta-status-card ta-status-completed">
                        <div class="ta-status-icon"><i class="bi bi-check-circle"></i></div>
                        <div class="ta-status-title">Allocation Approved</div>
                        <div class="ta-status-summary">@planningSummary</div>
                        @if (_weekOffset == 0)
                        {
                            <button type="button" class="ta-btn ta-btn-next mt-3" @onclick="() => currentTab = TaTab.Today">
                                Go to Today's Tasks <i class="bi bi-arrow-right"></i>
                            </button>
                        }
                    </div>
                }
                else
                {
                    <div class="ta-status-card ta-status-pending">
                        <div class="ta-status-icon"><i class="bi bi-clock-history"></i></div>
                        <div class="ta-status-title">Allocation submitted &mdash; awaiting MDO approval</div>
                        <div class="ta-status-summary">@planningSummary</div>
                    </div>
                }
            }
            else
            {
                <div class="ta-wizard">
                    <!-- Step sidebar -->
                    <div class="ta-stepper @(stepperCollapsed ? "ta-stepper-collapsed" : "")">
                        @foreach (var step in Steps)
                        {
                            <button type="button"
                                    class="ta-step-item @(currentStep == step.Number ? "active" : "")"
                                    @onclick="() => GoToStep(step.Number)">
                                <span class="ta-step-num">@step.Number</span>
                                <span class="ta-step-label">@step.Label</span>
                            </button>
                        }
                    </div>

                    <button type="button" class="ta-stepper-toggle" title="@(stepperCollapsed ? "Expand steps" : "Collapse steps")" @onclick="ToggleStepper">
                        <i class="bi @(stepperCollapsed ? "bi-chevron-right" : "bi-chevron-left")"></i>
                    </button>

                    <!-- Step content -->
                    <div class="ta-wizard-content">
                        @if (currentStep == 1)
                        {
                            <div class="ta-step-panel">
                                <p class="ta-step-instruction">Step 1 of 5 &mdash; plan which dealers you'll visit on each day of the week.</p>

                                <div class="ta-day-tabs" role="tablist">
                                    @foreach (var day in WeekDays)
                                    {
                                        var count = selectionsByDay[day].Count;
                                        <button type="button"
                                                class="ta-day-tab @(selectedDay == day ? "active" : "")"
                                                role="tab"
                                                aria-selected="@(selectedDay == day ? "true" : "false")"
                                                @onclick="() => selectedDay = day">
                                            @DayLabel(day)
                                            @if (count > 0)
                                            {
                                                <span class="ta-day-tab-count">@count</span>
                                            }
                                        </button>
                                    }
                                </div>

                                <div class="ta-step-toolbar">
                                    <div class="ta-search-box">
                                        <i class="bi bi-search"></i>
                                        <input type="text" placeholder="Search dealer name or code..." @bind="dealerSearch" @bind:event="oninput" />
                                    </div>
                                    <select class="ta-filter-select" @bind="selectedDistrictFilter" @bind:after="OnDistrictFilterChanged">
                                        <option value="0">All Districts</option>
                                        @foreach (var district in AvailableDistrictFilters)
                                        {
                                            <option value="@district.Id">@district.DistrictName</option>
                                        }
                                    </select>
                                    <select class="ta-filter-select" @bind="selectedTalukFilter" @bind:after="OnTalukFilterChanged">
                                        <option value="">All Sub Districts</option>
                                        @foreach (var taluk in AvailableTalukFilters)
                                        {
                                            <option value="@taluk">@taluk</option>
                                        }
                                    </select>
                                    <select class="ta-filter-select" @bind="selectedDealerFilter">
                                        <option value="0">All Dealers</option>
                                        @foreach (var dealer in AvailableDealerFilters)
                                        {
                                            <option value="@dealer.Id">@dealer.Name</option>
                                        }
                                    </select>
                                </div>

                                <div class="ta-dealer-grid">
                                    @if (isLoadingDealers)
                                    {
                                        <EmptyState Icon="bi-hourglass-split" Title="Loading dealers..." Compact="true" />
                                    }
                                    else if (dealersLoadFailed)
                                    {
                                        <EmptyState Icon="bi-exclamation-triangle" Title="Couldn't load dealers" Message="Please try again in a moment." Compact="true" />
                                    }
                                    else
                                    {
                                        @foreach (var dealer in FilteredDealers)
                                        {
                                            var isSelected = IsDealerSelected(dealer);
                                            <div class="ta-dealer-card @(isSelected ? "selected" : "")" @onclick="() => ToggleDealer(dealer)">
                                                <div class="ta-dealer-top">
                                                    <span class="ta-checkbox @(isSelected ? "checked" : "")">
                                                        @if (isSelected)
                                                        {
                                                            <i class="bi bi-check-lg"></i>
                                                        }
                                                    </span>
                                                    <span class="ta-type-pill"><i class="bi bi-shop"></i> @dealer.TypeLabel</span>
                                                </div>

                                                <h4 class="ta-dealer-name">@dealer.Name</h4>

                                                <div class="ta-dealer-code-row">
                                                    <i class="bi bi-person"></i> Dealer Code <strong>@dealer.DealerCode</strong>
                                                    <button type="button" class="ta-copy-btn" title="Copy dealer code" @onclick="() => CopyCode(dealer.DealerCode)" @onclick:stopPropagation="true">
                                                        <i class="bi bi-copy"></i>
                                                    </button>
                                                </div>

                                                <div class="ta-dealer-info-row">
                                                    <span>iFMS ID</span>
                                                    <strong>@(dealer.IfmsId?.ToString() ?? "—")</strong>
                                                </div>
                                                <div class="ta-dealer-info-row">
                                                    <span>PoS Liquidation</span>
                                                    <strong>@(dealer.PosLiquidationQty?.ToString("N2") ?? "—")</strong>
                                                </div>

                                                <div class="ta-dealer-stats-row ta-dealer-stats-row-single">
                                                    <div class="ta-mini-stat ta-mini-stat-pending">
                                                        <div class="ta-mini-stat-label"><i class="bi bi-clipboard-check"></i> Pending Ack.</div>
                                                        <div class="ta-mini-stat-val">
                                                            @if (dealer.PendingAckQty is decimal ack)
                                                            {
                                                                @ack.ToString("N2") <span>mT</span>
                                                            }
                                                            else
                                                            {
                                                                @:—
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }

                                        @if (!FilteredDealers.Any())
                                        {
                                            <EmptyState Icon="bi-search" Title="No dealers match your search" Compact="true" />
                                        }
                                    }
                                </div>

                                <div class="ta-step-footer">
                                    <div class="ta-selected-summary">
                                        @{ var selectedForDay = SelectedDealersFor(selectedDay).ToList(); }
                                        @if (selectedForDay.Any())
                                        {
                                            @($"{DayLabel(selectedDay)}: ") @string.Join("  ·  ", selectedForDay.Select(d => $"{d.Name} - dealer Code : {d.DealerCode}"))
                                        }
                                        else
                                        {
                                            <span>Select at least one dealer for @DayLabel(selectedDay), or switch tabs to plan another day.</span>
                                        }
                                    </div>
                                    <button type="button" class="ta-btn ta-btn-next" @onclick="() => GoToStep(2)">
                                        Next: SPCM Target <i class="bi bi-arrow-right"></i>
                                    </button>
                                </div>
                            </div>
                        }
                        else if (currentStep == 2)
                        {
                            <div class="ta-step-panel">
                                <p class="ta-step-instruction">Step 2 of 5 &mdash; how much are you targeting to achieve this week?</p>

                                <div class="ta-target-card">
                                    <div class="ta-target-header">
                                        <i class="bi bi-bullseye"></i>
                                        <h4>This Week's SPCM Target</h4>
                                    </div>
                                    <p class="ta-target-meta">Region: @FieldExecRegion &middot; MO H.Q: @FieldExecMoHq &middot; JMDO H.Q: @FieldExecJmdoHq</p>

                                    <label class="ta-target-label" for="ta-spcm-target">This Week's Target</label>
                                    <input id="ta-spcm-target" type="number" min="0" class="ta-target-input" placeholder="e.g. 100" @bind="spcmTarget" @bind:event="oninput" />
                                </div>

                                <div class="ta-step-footer ta-step-footer-simple">
                                    <button type="button" class="ta-btn ta-btn-prev" @onclick="() => GoToStep(1)">
                                        <i class="bi bi-arrow-left"></i> Back
                                    </button>
                                    <button type="button" class="ta-btn ta-btn-next" @onclick="() => GoToStep(3)">
                                        Next: Soil Sample <i class="bi bi-arrow-right"></i>
                                    </button>
                                </div>
                            </div>
                        }
                        else if (currentStep == 3)
                        {
                            <div class="ta-step-panel">
                                <p class="ta-step-instruction">Step 3 of 5 &mdash; how many soil samples are you targeting this week?</p>

                                <div class="ta-target-card">
                                    <div class="ta-target-header">
                                        <i class="bi bi-moisture"></i>
                                        <h4>Soil Sample Collection</h4>
                                    </div>
                                    <p class="ta-target-meta">Region: @FieldExecRegion &middot; MO H.Q: @FieldExecMoHq &middot; JMDO H.Q: @FieldExecJmdoHq</p>

                                    <label class="ta-target-label" for="ta-soil-target">This Week's Target</label>
                                    <input id="ta-soil-target" type="number" min="0" class="ta-target-input" placeholder="e.g. 100" @bind="soilTarget" @bind:event="oninput" />
                                </div>

                                <div class="ta-step-footer ta-step-footer-simple">
                                    <button type="button" class="ta-btn ta-btn-prev" @onclick="() => GoToStep(2)">
                                        <i class="bi bi-arrow-left"></i> Back
                                    </button>
                                    <button type="button" class="ta-btn ta-btn-next" @onclick="() => GoToStep(4)">
                                        Next: MD Program <i class="bi bi-arrow-right"></i>
                                    </button>
                                </div>
                            </div>
                        }
                        else if (currentStep == 4)
                        {
                            <div class="ta-step-panel">
                                <p class="ta-step-instruction">Step 4 of 5 &mdash; MD programs assigned to you in CSR1 are included automatically; submit for MDO approval when ready.</p>

                                <div class="ta-dealer-grid">
                                    @if (isLoadingPrograms)
                                    {
                                        <EmptyState Icon="bi-hourglass-split" Title="Loading MD programs..." Compact="true" />
                                    }
                                    else if (programsLoadFailed)
                                    {
                                        <EmptyState Icon="bi-exclamation-triangle" Title="Couldn't load MD programs" Message="Please try again in a moment." Compact="true">
                                            <button type="button" class="ta-btn ta-btn-next" @onclick="LoadProgramsAsync">
                                                <i class="bi bi-arrow-clockwise"></i> Retry
                                            </button>
                                        </EmptyState>
                                    }
                                    else if (!Programs.Any())
                                    {
                                        <EmptyState Icon="bi-easel" Title="No MD programs are assigned to you" Compact="true" />
                                    }
                                    else
                                    {
                                        @foreach (var program in Programs)
                                        {
                                            <div class="ta-dealer-card selected">
                                                <div class="ta-dealer-top">
                                                    <span class="ta-program-day-badge">@DayLabel(program.CreatedAt.DayOfWeek)</span>
                                                    <span class="ta-type-pill ta-type-pill-purple"><i class="bi bi-people"></i> @program.TypeLabel</span>
                                                </div>

                                                <h4 class="ta-dealer-name ta-program-name">@program.Title</h4>

                                                <div class="ta-dealer-code-row">
                                                    <i class="bi bi-file-earmark-text"></i> Sanction No. <strong>@(program.SanctionNo ?? "—")</strong>
                                                    @if (program.SanctionNo is not null)
                                                    {
                                                        <button type="button" class="ta-copy-btn" title="Copy sanction number" @onclick="() => CopyCode(program.SanctionNo)" @onclick:stopPropagation="true">
                                                            <i class="bi bi-copy"></i>
                                                        </button>
                                                    }
                                                </div>

                                                <div class="ta-dealer-info-row ta-program-date-row">
                                                    <span>Sanction Date</span>
                                                    <strong>@(program.SanctionDate ?? "—")</strong>
                                                </div>

                                                <div class="ta-dealer-stats-row">
                                                    <div class="ta-mini-stat ta-mini-stat-programs">
                                                        <div class="ta-mini-stat-label"><i class="bi bi-file-earmark-text"></i> Programs</div>
                                                        <div class="ta-mini-stat-val">@program.ProgramCount <span>Program</span></div>
                                                    </div>
                                                    <div class="ta-mini-stat ta-mini-stat-budget">
                                                        <div class="ta-mini-stat-label"><i class="bi bi-bullseye"></i> Total Budget</div>
                                                        <div class="ta-mini-stat-val">@program.TotalBudget</div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>

                                <div class="ta-step-footer">
                                    <div class="ta-selected-summary">
                                        @if (Programs.Any())
                                        {
                                            @string.Join("  ·  ", Programs.Select(p => $"{p.ProgramCount} Program - {p.Title}"))
                                        }
                                        else
                                        {
                                            <span>No MD programs assigned to you this week.</span>
                                        }
                                    </div>
                                    <div class="ta-step-footer-actions">
                                        <button type="button" class="ta-btn ta-btn-prev" @onclick="() => GoToStep(3)">
                                            <i class="bi bi-arrow-left"></i> Back
                                        </button>
                                        <button type="button" class="ta-btn ta-btn-next" @onclick="() => GoToStep(5)">
                                            Next: PoS liquidation <i class="bi bi-arrow-right"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="ta-step-panel">
                                <p class="ta-step-instruction">Step 5 of 5 &mdash; how much are you targeting to achieve this week?</p>

                                <div class="ta-target-card ta-target-card-wide">
                                    <div class="ta-target-header">
                                        <i class="bi bi-bullseye"></i>
                                        <h4>This Week's PoS liquidation</h4>
                                    </div>
                                    <p class="ta-target-meta">Region: @FieldExecRegion &middot; MO H.Q: @FieldExecMoHq &middot; JMDO H.Q: @FieldExecJmdoHq</p>

                                    <div class="ta-target-input-grid">
                                        <div class="ta-target-field">
                                            <label class="ta-target-label" for="ta-urea-target">Urea</label>
                                            <input id="ta-urea-target" type="number" min="0" class="ta-target-input" placeholder="e.g. 100" @bind="ureaTarget" @bind:event="oninput" />
                                        </div>
                                        <div class="ta-target-field">
                                            <label class="ta-target-label" for="ta-dap-target">DAP</label>
                                            <input id="ta-dap-target" type="number" min="0" class="ta-target-input" placeholder="e.g. 100" @bind="dapTarget" @bind:event="oninput" />
                                        </div>
                                        <div class="ta-target-field">
                                            <label class="ta-target-label" for="ta-nps-target">NPKS</label>
                                            <input id="ta-nps-target" type="number" min="0" class="ta-target-input" placeholder="e.g. 100" @bind="npsTarget" @bind:event="oninput" />
                                        </div>
                                        <div class="ta-target-field">
                                            <label class="ta-target-label" for="ta-others-target">Others</label>
                                            <input id="ta-others-target" type="number" min="0" class="ta-target-input" @bind="othersTarget" @bind:event="oninput" />
                                        </div>
                                    </div>
                                </div>

                                <div class="ta-step-footer ta-step-footer-simple">
                                    <button type="button" class="ta-btn ta-btn-prev" @onclick="() => GoToStep(4)">
                                        <i class="bi bi-arrow-left"></i> Back
                                    </button>
                                    <button type="button" class="ta-btn ta-btn-submit" disabled="@isSubmittingAllocation" @onclick="SubmitAllocationAsync">
                                        @(isSubmittingAllocation ? "Submitting..." : "Request")
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
        else if (currentTab == TaTab.Today)
        {
            <div class="ta-wizard">
                <!-- Status filter sidebar. The extra ta-stepper-wrap level (not used by the
                     steps 1-5 wizard above, which uses .ta-stepper directly) keeps the legend
                     OUTSIDE .ta-stepper itself - at phone width .ta-stepper becomes a horizontal
                     row of pill buttons with overflow: hidden (see TasksAllocation.css), so the
                     legend rendered as just another squeezed-in item in that row instead of
                     stacking below it. -->
                <div class="ta-stepper-wrap @(todayStepperCollapsed ? "ta-stepper-collapsed" : "")">
                    <div class="ta-stepper">
                        @foreach (var filter in TodayFilters)
                        {
                            var count = BadgeCount(filter.Status);
                            <button type="button"
                                    class="ta-step-item @(todayFilter == filter.Status ? "active" : "")"
                                    @onclick="() => todayFilter = filter.Status">
                                <span class="ta-step-num">@filter.Number</span>
                                <span class="ta-step-label">@filter.Label</span>
                                <span class="ta-today-bell">
                                    <i class="bi bi-bell"></i>
                                    @if (count > 0)
                                    {
                                        <span class="ta-today-badge">@count</span>
                                    }
                                </span>
                            </button>
                        }
                    </div>

                    @if (!todayStepperCollapsed)
                    {
                        <!-- Explains what each task card's colour theme means (see StatusCardClass /
                             .ta-today-card.ta-status-* below) - same 3 stages as the filters above,
                             just as a colour key instead of a clickable filter. -->
                        <div class="ta-status-legend">
                            <div class="ta-status-legend-item">
                                <span class="ta-status-legend-dot ta-legend-yettostart"></span>
                                Yet to Start
                            </div>
                            <div class="ta-status-legend-item">
                                <span class="ta-status-legend-dot ta-legend-inprogress"></span>
                                In Progress
                            </div>
                            <div class="ta-status-legend-item">
                                <span class="ta-status-legend-dot ta-legend-completed"></span>
                                Completed
                            </div>
                        </div>
                    }
                </div>

                <button type="button" class="ta-stepper-toggle" title="@(todayStepperCollapsed ? "Expand" : "Collapse")" @onclick="() => todayStepperCollapsed = !todayStepperCollapsed">
                    <i class="bi @(todayStepperCollapsed ? "bi-chevron-right" : "bi-chevron-left")"></i>
                </button>

                <!-- Task cards -->
                <div class="ta-wizard-content">
                    <div class="ta-today-grid">
                        @if (todayAllocation is null)
                        {
                            <EmptyState Icon="bi-inbox" Title="No allocation for today" Compact="true" />
                        }
                        else
                        {
                            @if (BadgeCount(todayFilter) == 0)
                            {
                                <EmptyState Icon="bi-inbox" Title="@EmptyTodayTitle" Compact="true" />
                            }
                            else
                            {
                                @foreach (var assignment in todayAllocation.DealerAssignments.Where(d => d.Day == DateTime.Today.DayOfWeek))
                                {
                                    var dStatus = GetStatus($"dealer_{assignment.DealerId}");
                                    @if (MatchesTodayFilter(dStatus))
                                    {
                                        <div class="ta-today-card @StatusCardClass(dStatus)">
                                            <div class="ta-dealer-top">
                                                <span class="ta-type-pill ta-type-pill-blue"><i class="bi bi-person"></i> Dealer</span>
                                                <span class="ta-type-pill ta-type-pill-today"><i class="bi bi-shop"></i> Retailer</span>
                                            </div>

                                            <h4 class="ta-dealer-name">@assignment.DealerName</h4>

                                            <div class="ta-dealer-code-row">
                                                <i class="bi bi-person"></i> Dealer Code <strong>@assignment.DealerCode</strong>
                                                <button type="button" class="ta-copy-btn" title="Copy dealer code" @onclick='() => CopyCode(assignment.DealerCode)' @onclick:stopPropagation="true">
                                                    <i class="bi bi-copy"></i>
                                                </button>
                                            </div>

                                            <div class="ta-dealer-info-row">
                                                <span>iFMS ID</span>
                                                <strong>@(assignment.IfmsId?.ToString() ?? "—")</strong>
                                            </div>
                                            <div class="ta-dealer-info-row">
                                                <span>PoS Liquidation</span>
                                                <strong>@(assignment.PosLiquidationQty?.ToString("N2") ?? "—")</strong>
                                            </div>

                                            <div class="ta-dealer-stats-row ta-dealer-stats-row-single">
                                                <div class="ta-mini-stat ta-mini-stat-pending">
                                                    <div class="ta-mini-stat-label"><i class="bi bi-clipboard-check"></i> Pending Ack.</div>
                                                    <div class="ta-mini-stat-val">@(assignment.PendingAckQty?.ToString("N2") ?? "—")</div>
                                                </div>
                                            </div>

                                            <button type="button" class="ta-start-btn" @onclick='() => Navigation.NavigateTo($"/TaskDetail?type=dealer&id=dealer_{assignment.DealerId}")'>
                                                @ActionLabel(dStatus) <i class="bi bi-arrow-right"></i>
                                            </button>
                                        </div>
                                    }
                                }

                                @foreach (var program in todayAllocation.Programs)
                                {
                                    var pStatus = GetStatus($"prog_{program.Csr1Id}");
                                    @if (MatchesTodayFilter(pStatus))
                                    {
                                        <div class="ta-today-card @StatusCardClass(pStatus)">
                                            <div class="ta-dealer-top">
                                                <span class="ta-type-pill ta-type-pill-purple"><i class="bi bi-easel"></i> MD Program</span>
                                                <span class="ta-type-pill ta-type-pill-outline"><i class="bi bi-people"></i> Training</span>
                                            </div>

                                            <h4 class="ta-dealer-name ta-program-name">@program.ProgramName</h4>

                                            <div class="ta-dealer-code-row">
                                                <i class="bi bi-file-earmark-text"></i> Sanction No. <strong>@FormatProgramSanctionNo(program)</strong>
                                            </div>

                                            <div class="ta-dealer-info-row">
                                                <span><i class="bi bi-calendar3"></i> Sanction Date</span>
                                                <strong>@FormatProgramSanctionDate(program)</strong>
                                            </div>

                                            <div class="ta-dealer-stats-row">
                                                <div class="ta-mini-stat ta-mini-stat-programs">
                                                    <div class="ta-mini-stat-label"><i class="bi bi-file-earmark-text"></i> Programs</div>
                                                    <div class="ta-mini-stat-val">1 <span>Program</span></div>
                                                </div>
                                                <div class="ta-mini-stat ta-mini-stat-budget">
                                                    <div class="ta-mini-stat-label"><i class="bi bi-bullseye"></i> Total Budget</div>
                                                    <div class="ta-mini-stat-val">@(program.Budget > 0 ? (program.Budget % 1 == 0 ? $"₹{program.Budget:N0}" : $"₹{program.Budget:N2}") : "—")</div>
                                                </div>
                                            </div>

                                            <button type="button" class="ta-start-btn" @onclick='() => Navigation.NavigateTo($"/TaskDetail?type=mdprogram&id=prog_{program.Csr1Id}")'>
                                                @ActionLabel(pStatus) <i class="bi bi-arrow-right"></i>
                                            </button>
                                        </div>
                                    }
                                }

                                var spcmStatus = GetStatus("spcm");
                                @if (todayAllocation.SpcmTarget is > 0 && MatchesTodayFilter(spcmStatus))
                                {
                                    <div class="ta-today-card ta-today-card-narrow @StatusCardClass(spcmStatus)">
                                        <span class="ta-type-pill ta-type-pill-teal"><i class="bi bi-bullseye"></i> SPCM</span>

                                        <div class="ta-today-target-box">
                                            <span class="ta-today-target-icon"><i class="bi bi-bullseye"></i></span>
                                            <div>
                                                <div class="ta-target-label">Today's Target</div>
                                                <div class="ta-today-target-val">@todayAllocation.SpcmTarget</div>
                                            </div>
                                        </div>

                                        <button type="button" class="ta-start-btn" @onclick='() => Navigation.NavigateTo("/TaskDetail?type=spcm")'>
                                            @ActionLabel(spcmStatus) <i class="bi bi-arrow-right"></i>
                                        </button>
                                    </div>
                                }

                                var soilStatus = GetStatus("soil");
                                @if (todayAllocation.SoilSampleTarget is > 0 && MatchesTodayFilter(soilStatus))
                                {
                                    <div class="ta-today-card ta-today-card-narrow @StatusCardClass(soilStatus)">
                                        <span class="ta-type-pill ta-type-pill-orange"><i class="bi bi-moisture"></i> Soil Sample</span>

                                        <div class="ta-today-target-box">
                                            <span class="ta-today-target-icon"><i class="bi bi-eyedropper"></i></span>
                                            <div>
                                                <div class="ta-target-label">Today's Target</div>
                                                <div class="ta-today-target-val">@todayAllocation.SoilSampleTarget</div>
                                            </div>
                                        </div>

                                        <button type="button" class="ta-start-btn" @onclick="StartSoilSampleTask">
                                            @ActionLabel(soilStatus) <i class="bi bi-arrow-right"></i>
                                        </button>
                                    </div>
                                }

                                var posStatus = GetStatus("pos");
                                @if ((todayAllocation.UreaTarget > 0 || todayAllocation.NpsTarget > 0 || todayAllocation.DapTarget > 0 || todayAllocation.OthersTarget > 0) && MatchesTodayFilter(posStatus))
                                {
                                    <div class="ta-today-card ta-today-card-wide @StatusCardClass(posStatus)">
                                        <span class="ta-type-pill ta-type-pill-grey"><i class="bi bi-box-seam"></i> PoS Liquidation</span>

                                        <div class="ta-today-products-label"><i class="bi bi-clipboard-check"></i> Products to liquidate</div>
                                        <div class="ta-today-products-row">
                                            @if (todayAllocation.UreaTarget > 0)
                                            {
                                                <div class="ta-today-product-tile">
                                                    <div class="ta-today-product-name">UREA</div>
                                                    <div class="ta-today-product-val">@todayAllocation.UreaTarget</div>
                                                </div>
                                            }
                                            @if (todayAllocation.NpsTarget > 0)
                                            {
                                                <div class="ta-today-product-tile">
                                                    <div class="ta-today-product-name">NPKS</div>
                                                    <div class="ta-today-product-val">@todayAllocation.NpsTarget</div>
                                                </div>
                                            }
                                            @if (todayAllocation.DapTarget > 0)
                                            {
                                                <div class="ta-today-product-tile">
                                                    <div class="ta-today-product-name">DAP</div>
                                                    <div class="ta-today-product-val">@todayAllocation.DapTarget</div>
                                                </div>
                                            }
                                            @if (todayAllocation.OthersTarget > 0)
                                            {
                                                <div class="ta-today-product-tile">
                                                    <div class="ta-today-product-name">OTHER</div>
                                                    <div class="ta-today-product-val">@todayAllocation.OthersTarget</div>
                                                </div>
                                            }
                                        </div>

                                        <button type="button" class="ta-start-btn" @onclick='() => Navigation.NavigateTo("/TaskDetail?type=posliquidation")'>
                                            @ActionLabel(posStatus) <i class="bi bi-arrow-right"></i>
                                        </button>
                                    </div>
                                }
                            }
                        }
                    </div>

                    @if (NextStatus is { } nextStatus && BadgeCount(nextStatus) > 0)
                    {
                        <button type="button" class="ta-today-jump-btn" @onclick="() => todayFilter = nextStatus">
                            @TodayFilters.First(f => f.Status == nextStatus).Label <i class="bi bi-arrow-right"></i>
                        </button>
                    }
                    else if (todayFilter == AllocTaskStatus.Completed)
                    {
                        <button type="button" class="ta-today-back-btn" @onclick="() => todayFilter = AllocTaskStatus.YetToStart">
                            <i class="bi bi-arrow-left"></i> Back
                        </button>
                    }
                </div>
            </div>
        }
        else if (currentTab == TaTab.Completed)
        {
            <!-- Every task across EVERY week the JMDO has ever submitted (not just
                 todayAllocation's current week - see GetMineAll), any status - defaults to
                 today's date so the tab opens on today's own tasks, with date range/dealer/status
                 filters to reach anything else. Card colour theme and the status pill both
                 reflect the task's real current status instead of always showing "completed"
                 purple. -->
            <div class="ta-completed-filters">
                <div class="ta-completed-filter-field">
                    <label class="ta-field-label" for="ta-completed-from">From</label>
                    <input id="ta-completed-from" type="date" class="ta-filter-select" @bind="completedFromDate" />
                </div>
                <div class="ta-completed-filter-field">
                    <label class="ta-field-label" for="ta-completed-to">To</label>
                    <input id="ta-completed-to" type="date" class="ta-filter-select" @bind="completedToDate" />
                </div>
                <div class="ta-completed-filter-field">
                    <label class="ta-field-label" for="ta-completed-dealer">Dealer</label>
                    <select id="ta-completed-dealer" class="ta-filter-select" @bind="completedDealerFilter">
                        <option value="">All Dealers</option>
                        @foreach (var name in CompletedDealerOptions)
                        {
                            <option value="@name">@name</option>
                        }
                    </select>
                </div>
                <div class="ta-completed-filter-field">
                    <label class="ta-field-label" for="ta-completed-status">Status</label>
                    <select id="ta-completed-status" class="ta-filter-select" @bind="completedStatusFilter">
                        <option value="">All</option>
                        <option value="@AllocTaskStatus.YetToStart">Yet to Start</option>
                        <option value="@AllocTaskStatus.InProgress">In Progress</option>
                        <option value="@AllocTaskStatus.Completed">Completed</option>
                    </select>
                </div>
                <button type="button" class="ta-filter-btn ta-filter-btn-primary" @onclick="ApplyCompletedFilters">
                    <i class="bi bi-search"></i> Search
                </button>
                <button type="button" class="ta-filter-btn" @onclick="ResetCompletedFilters">
                    <i class="bi bi-arrow-counterclockwise"></i> Today
                </button>
            </div>

            @if (_isLoadingCompleted)
            {
                <EmptyState Icon="bi-hourglass-split" Title="Loading tasks..." Compact="true" />
            }
            else if (!AnyFilteredCompletedTasks)
            {
                <EmptyState Icon="bi-check2-circle" Title="No tasks match this filter" Compact="true" />
            }
            else
            {
                <div class="ta-today-grid">
                    @foreach (var assignment in FilteredCompletedDealers)
                    {
                        <div class="ta-today-card @StatusCardClass(assignment.Status)">
                            <div class="ta-dealer-top">
                                <span class="ta-type-pill ta-type-pill-blue"><i class="bi bi-person"></i> Dealer</span>
                                <span class="ta-type-pill ta-type-pill-today"><i class="bi bi-shop"></i> Retailer</span>
                            </div>

                            <h4 class="ta-dealer-name">@assignment.DealerName</h4>

                            <div class="ta-dealer-code-row">
                                <i class="bi bi-person"></i> Dealer Code <strong>@assignment.DealerCode</strong>
                                <button type="button" class="ta-copy-btn" title="Copy dealer code" @onclick='() => CopyCode(assignment.DealerCode)' @onclick:stopPropagation="true">
                                    <i class="bi bi-copy"></i>
                                </button>
                            </div>

                            <div class="ta-dealer-info-row">
                                <span>iFMS ID</span>
                                <strong>@(assignment.IfmsId?.ToString() ?? "—")</strong>
                            </div>
                            <div class="ta-dealer-info-row">
                                <span>PoS Liquidation</span>
                                <strong>@(assignment.PosLiquidationQty?.ToString("N2") ?? "—")</strong>
                            </div>

                            <div class="ta-dealer-stats-row ta-dealer-stats-row-single">
                                <div class="ta-mini-stat ta-mini-stat-pending">
                                    <div class="ta-mini-stat-label"><i class="bi bi-clipboard-check"></i> Pending Ack.</div>
                                    <div class="ta-mini-stat-val">@(assignment.PendingAckQty?.ToString("N2") ?? "—")</div>
                                </div>
                            </div>

                            <button type="button" class="ta-start-btn" @onclick='() => Navigation.NavigateTo($"/TaskDetail?type=dealer&id=dealer_{assignment.DealerId}")'>
                                @ActionLabel(assignment.Status) <i class="bi bi-arrow-right"></i>
                            </button>
                        </div>
                    }

                    @foreach (var program in FilteredCompletedPrograms)
                    {
                        <div class="ta-today-card @StatusCardClass(program.Status)">
                            <div class="ta-dealer-top">
                                <span class="ta-type-pill ta-type-pill-purple"><i class="bi bi-easel"></i> MD Program</span>
                                <span class="ta-type-pill ta-type-pill-outline"><i class="bi bi-people"></i> Training</span>
                            </div>

                            <h4 class="ta-dealer-name ta-program-name">@program.ProgramName</h4>

                            <div class="ta-dealer-code-row">
                                <i class="bi bi-file-earmark-text"></i> Sanction No. <strong>@FormatProgramSanctionNo(program)</strong>
                            </div>

                            <div class="ta-dealer-info-row">
                                <span><i class="bi bi-calendar3"></i> Sanction Date</span>
                                <strong>@FormatProgramSanctionDate(program)</strong>
                            </div>

                            <div class="ta-dealer-stats-row">
                                <div class="ta-mini-stat ta-mini-stat-programs">
                                    <div class="ta-mini-stat-label"><i class="bi bi-file-earmark-text"></i> Programs</div>
                                    <div class="ta-mini-stat-val">1 <span>Program</span></div>
                                </div>
                                <div class="ta-mini-stat ta-mini-stat-budget">
                                    <div class="ta-mini-stat-label"><i class="bi bi-bullseye"></i> Total Budget</div>
                                    <div class="ta-mini-stat-val">@(program.Budget > 0 ? (program.Budget % 1 == 0 ? $"₹{program.Budget:N0}" : $"₹{program.Budget:N2}") : "—")</div>
                                </div>
                            </div>

                            <button type="button" class="ta-start-btn" @onclick='() => Navigation.NavigateTo($"/TaskDetail?type=mdprogram&id=prog_{program.Csr1Id}")'>
                                @ActionLabel(program.Status) <i class="bi bi-arrow-right"></i>
                            </button>
                        </div>
                    }

                    @foreach (var alloc in FilteredCompletedSpcmAllocations)
                    {
                        <div class="ta-today-card ta-today-card-narrow @StatusCardClass(alloc.SpcmStatus)">
                            <span class="ta-type-pill ta-type-pill-teal"><i class="bi bi-bullseye"></i> SPCM</span>

                            <div class="ta-today-target-box">
                                <span class="ta-today-target-icon"><i class="bi bi-bullseye"></i></span>
                                <div>
                                    <div class="ta-target-label">Today's Target</div>
                                    <div class="ta-today-target-val">@alloc.SpcmTarget</div>
                                </div>
                            </div>

                            <button type="button" class="ta-start-btn" @onclick='() => Navigation.NavigateTo("/TaskDetail?type=spcm")'>
                                @ActionLabel(alloc.SpcmStatus) <i class="bi bi-arrow-right"></i>
                            </button>
                        </div>
                    }

                    @foreach (var alloc in FilteredCompletedSoilAllocations)
                    {
                        <div class="ta-today-card ta-today-card-narrow @StatusCardClass(alloc.SoilSampleStatus)">
                            <span class="ta-type-pill ta-type-pill-orange"><i class="bi bi-moisture"></i> Soil Sample</span>

                            <div class="ta-today-target-box">
                                <span class="ta-today-target-icon"><i class="bi bi-eyedropper"></i></span>
                                <div>
                                    <div class="ta-target-label">Today's Target</div>
                                    <div class="ta-today-target-val">@alloc.SoilSampleTarget</div>
                                </div>
                            </div>

                            <button type="button" class="ta-start-btn" @onclick="ViewDetailsNotAvailable">
                                @ActionLabel(alloc.SoilSampleStatus) <i class="bi bi-arrow-right"></i>
                            </button>
                        </div>
                    }

                    @foreach (var alloc in FilteredCompletedPosAllocations)
                    {
                        <div class="ta-today-card ta-today-card-wide @StatusCardClass(alloc.PosLiquidationStatus)">
                            <span class="ta-type-pill ta-type-pill-grey"><i class="bi bi-box-seam"></i> PoS Liquidation</span>

                            <div class="ta-today-products-label"><i class="bi bi-clipboard-check"></i> Products to liquidate</div>
                            <div class="ta-today-products-row">
                                @if (alloc.UreaTarget > 0)
                                {
                                    <div class="ta-today-product-tile">
                                        <div class="ta-today-product-name">UREA</div>
                                        <div class="ta-today-product-val">@alloc.UreaTarget</div>
                                    </div>
                                }
                                @if (alloc.NpsTarget > 0)
                                {
                                    <div class="ta-today-product-tile">
                                        <div class="ta-today-product-name">NPKS</div>
                                        <div class="ta-today-product-val">@alloc.NpsTarget</div>
                                    </div>
                                }
                                @if (alloc.DapTarget > 0)
                                {
                                    <div class="ta-today-product-tile">
                                        <div class="ta-today-product-name">DAP</div>
                                        <div class="ta-today-product-val">@alloc.DapTarget</div>
                                    </div>
                                }
                                @if (alloc.OthersTarget > 0)
                                {
                                    <div class="ta-today-product-tile">
                                        <div class="ta-today-product-name">OTHER</div>
                                        <div class="ta-today-product-val">@alloc.OthersTarget</div>
                                    </div>
                                }
                            </div>

                            <button type="button" class="ta-start-btn" @onclick='() => Navigation.NavigateTo("/TaskDetail?type=posliquidation")'>
                                @ActionLabel(alloc.PosLiquidationStatus) <i class="bi bi-arrow-right"></i>
                            </button>
                        </div>
                    }
                </div>
            }
        }
        else if (currentTab == TaTab.Summary)
        {
            <!-- How much the JMDO has ever been allocated, broken down week by week: that
                 week's targets (dealer visits / MD programs / SPCM / soil sample / PoS
                 liquidation quantities) against what's actually been completed so far, plus a
                 Sun-Sat day-by-day breakdown of dealer visits - the numbers that answer "what
                 was I given this week and how much is still pending", which the flat
                 card/table views used before this didn't surface at all. Defaults to the current
                 week (same as Task History's "Today"), with From/To/Dealer/Status to reach any
                 other week. -->
            <div class="ta-summary-stats">
                <div class="ta-summary-stat-card">
                    <div class="ta-summary-stat-icon ta-summary-stat-icon-total"><i class="bi bi-list-task"></i></div>
                    <div>
                        <div class="ta-summary-stat-val">@TaskSummaryRows.Count()</div>
                        <div class="ta-summary-stat-label">Total Assigned</div>
                    </div>
                </div>
                <div class="ta-summary-stat-card">
                    <div class="ta-summary-stat-icon ta-summary-stat-icon-yettostart"><i class="bi bi-hourglass-split"></i></div>
                    <div>
                        <div class="ta-summary-stat-val">@TaskSummaryRows.Count(r => r.Status == AllocTaskStatus.YetToStart)</div>
                        <div class="ta-summary-stat-label">Yet to Start</div>
                    </div>
                </div>
                <div class="ta-summary-stat-card">
                    <div class="ta-summary-stat-icon ta-summary-stat-icon-inprogress"><i class="bi bi-arrow-repeat"></i></div>
                    <div>
                        <div class="ta-summary-stat-val">@TaskSummaryRows.Count(r => r.Status == AllocTaskStatus.InProgress)</div>
                        <div class="ta-summary-stat-label">In Progress</div>
                    </div>
                </div>
                <div class="ta-summary-stat-card">
                    <div class="ta-summary-stat-icon ta-summary-stat-icon-completed"><i class="bi bi-check-circle"></i></div>
                    <div>
                        <div class="ta-summary-stat-val">@TaskSummaryRows.Count(r => r.Status == AllocTaskStatus.Completed)</div>
                        <div class="ta-summary-stat-label">Completed &middot; @SummaryCompletionRate%</div>
                    </div>
                </div>
            </div>

            <div class="ta-completed-filters">
                <div class="ta-completed-filter-field">
                    <label class="ta-field-label" for="ta-summary-from">From</label>
                    <input id="ta-summary-from" type="date" class="ta-filter-select" @bind="summaryFromDate" />
                </div>
                <div class="ta-completed-filter-field">
                    <label class="ta-field-label" for="ta-summary-to">To</label>
                    <input id="ta-summary-to" type="date" class="ta-filter-select" @bind="summaryToDate" />
                </div>
                <div class="ta-completed-filter-field">
                    <label class="ta-field-label" for="ta-summary-dealer">Dealer</label>
                    <select id="ta-summary-dealer" class="ta-filter-select" @bind="summaryDealerFilter">
                        <option value="">All Dealers</option>
                        @foreach (var name in CompletedDealerOptions)
                        {
                            <option value="@name">@name</option>
                        }
                    </select>
                </div>
                <div class="ta-completed-filter-field">
                    <label class="ta-field-label" for="ta-summary-status">Status</label>
                    <select id="ta-summary-status" class="ta-filter-select" @bind="summaryStatusFilter">
                        <option value="">All</option>
                        <option value="@AllocTaskStatus.YetToStart">Yet to Start</option>
                        <option value="@AllocTaskStatus.InProgress">In Progress</option>
                        <option value="@AllocTaskStatus.Completed">Completed</option>
                    </select>
                </div>
                <button type="button" class="ta-filter-btn ta-filter-btn-primary" @onclick="ApplySummaryFilters">
                    <i class="bi bi-search"></i> Search
                </button>
                <button type="button" class="ta-filter-btn" @onclick="ResetSummaryFilters">
                    <i class="bi bi-arrow-counterclockwise"></i> Today
                </button>
            </div>

            @if (_isLoadingCompleted)
            {
                <EmptyState Icon="bi-hourglass-split" Title="Loading your tasks..." Compact="true" />
            }
            else if (!WeekSummaries.Any())
            {
                <EmptyState Icon="bi-calendar-week" Title="No tasks match this filter" Compact="true" />
            }
            else
            {
                <div class="ta-week-summary-list">
                    @foreach (var week in WeekSummaries)
                    {
                        <div class="ta-week-summary-card">
                            <div class="ta-week-summary-header">
                                <div>
                                    <div class="ta-week-summary-range"><i class="bi bi-calendar-week"></i> Week of @week.WeekStart.ToString("dd MMM") - @week.WeekEnd.ToString("dd MMM yyyy")</div>
                                    <span class="ta-summary-status-pill @(week.AllocationStatus == "Approved" ? "ta-summary-status-completed" : week.AllocationStatus == "Rejected" ? "ta-summary-status-yettostart" : "ta-summary-status-inprogress")">@week.AllocationStatus</span>
                                </div>
                                <div class="ta-week-summary-overall">
                                    <div class="ta-week-summary-overall-val">@week.OverallPercent%</div>
                                    <div class="ta-week-summary-overall-label">Complete</div>
                                </div>
                            </div>

                            <div class="ta-week-target-grid">
                                @if (week.DealerTotal > 0)
                                {
                                    <div class="ta-week-target-tile">
                                        <div class="ta-week-target-top">
                                            <span><i class="bi bi-person"></i> Dealer Visits</span>
                                            <span class="ta-summary-status-pill @(week.DealerPending == 0 ? "ta-summary-status-completed" : "ta-summary-status-inprogress")">@week.DealerCompleted / @week.DealerTotal</span>
                                        </div>
                                        <div class="ta-week-target-bar"><div class="ta-week-target-bar-fill" style="width:@((int)Math.Round(100.0 * week.DealerCompleted / week.DealerTotal))%"></div></div>
                                        <div class="ta-week-target-numbers">Pending <strong>@week.DealerPending</strong></div>
                                    </div>
                                }

                                @if (week.ProgramTotal > 0)
                                {
                                    <div class="ta-week-target-tile">
                                        <div class="ta-week-target-top">
                                            <span><i class="bi bi-easel"></i> MD Programs</span>
                                            <span class="ta-summary-status-pill @(week.ProgramCompleted == week.ProgramTotal ? "ta-summary-status-completed" : "ta-summary-status-inprogress")">@week.ProgramCompleted / @week.ProgramTotal</span>
                                        </div>
                                        <div class="ta-week-target-bar"><div class="ta-week-target-bar-fill" style="width:@((int)Math.Round(100.0 * week.ProgramCompleted / week.ProgramTotal))%"></div></div>
                                        <div class="ta-week-target-numbers">Budget <strong>@(week.ProgramBudget % 1 == 0 ? $"₹{week.ProgramBudget:N0}" : $"₹{week.ProgramBudget:N2}")</strong></div>
                                    </div>
                                }

                                @foreach (var target in week.Targets)
                                {
                                    <div class="ta-week-target-tile">
                                        <div class="ta-week-target-top">
                                            <span><i class="bi @target.Icon"></i> @target.Label</span>
                                            <span class="ta-summary-status-pill @SummaryStatusClass(target.EffectiveStatus)">@SummaryStatusLabel(target.EffectiveStatus)</span>
                                        </div>
                                        <div class="ta-week-target-bar"><div class="ta-week-target-bar-fill" style="width:@target.PercentDone%"></div></div>
                                        <div class="ta-week-target-numbers">Target <strong>@target.Target</strong> &middot; Achieved <strong>@target.Achieved</strong> &middot; Pending <strong>@target.Pending</strong></div>
                                    </div>
                                }
                            </div>

                            @if (week.DealerTotal > 0)
                            {
                                <div class="ta-week-day-breakdown">
                                    <div class="ta-week-day-title">Day-wise Dealer Visits</div>
                                    <div class="ta-week-day-row">
                                        @foreach (var day in week.Days)
                                        {
                                            <div class="ta-week-day-tile @(day.Total == 0 ? "ta-week-day-tile-empty" : day.Pending == 0 ? "ta-week-day-tile-done" : "")">
                                                <div class="ta-week-day-name">@(day.Day?.ToString().Substring(0, 3) ?? "N/A")</div>
