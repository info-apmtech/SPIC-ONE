    // ever" behaviour - that fallback exists for CheckExistingAllocationAsync's always-current-week
    // case (so there's always something to show), but would otherwise make it impossible to ever
    // see a genuinely empty, not-yet-submitted week once ANY allocation exists.
    private async Task CheckPlanningAllocationAsync()
    {
        _isCheckingPlanning = true;
        isPlanningSubmitted = false;
        planningAllocation = null;
        try
        {
            var response = await Http.GetAsync($"api/JmdoTaskAllocation/mine/today?weekStart={SelectedWeekStart:yyyy-MM-dd}");
            if (response.StatusCode == System.Net.HttpStatusCode.NoContent || !response.IsSuccessStatusCode)
                return;

            var existing = await response.Content.ReadFromJsonAsync<JmdoTaskAllocationResponseDto>();
            if (existing is null) return;

            planningAllocation = existing;
            planningSummary = BuildSubmittedSummary(existing);
            isPlanningSubmitted = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Checking the selected week's allocation failed: {ex.Message}");
