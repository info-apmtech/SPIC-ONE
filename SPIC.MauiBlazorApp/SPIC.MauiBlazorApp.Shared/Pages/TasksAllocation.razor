@code {
    private enum TaTab { All, Today, Completed }

    // Lets links like /TasksAllocation?tab=today (used by TaskDetail's
    // "Back to Tasks") land on the right tab instead of always resetting to
    // "All Allocations" - navigating here creates a fresh component
    // instance, so currentTab's default wouldn't otherwise remember it.
    [SupplyParameterFromQuery(Name = "tab")]
    public string? TabQuery { get; set; }

    private TaTab currentTab = TaTab.All;

    protected override void OnInitialized()
    {
        currentTab = TabQuery?.ToLowerInvariant() switch
        {
            "today" => TaTab.Today,
            "completed" => TaTab.Completed,
            _ => TaTab.All
        };
    }

    private string HeaderSubtitle => currentTab switch
    {
        TaTab.Today => "Pick your dealer tasks and set today's targets, then track them through to completion.",
        _ => "Everything assigned to you, what's approved for today, and what you've finished."
    };

    // Static placeholder flow: no Allocation API exists yet, so submitting
    // just flips the "All Allocations" tab from the wizard to the
    // awaiting-approval card (see TasksAllocation's original notes on the
    // pending-approval design for why that card has no live data either).
    private bool isAllocationSubmitted;

    // ---------- Today's Allocation tab ----------
    // The 5 tasks shown here are the ones picked/targeted in the wizard
    // above (Hanumesh Trading Co, Crop Protection Workshop, SPCM/Soil
    // targets, PoS liquidation products) - static placeholder mirroring
    // that example data, since there's no Allocation API yet to actually
    // link "submitted" to "today's tasks".
    private enum AllocTaskStatus { YetToStart, InProgress, Completed }

    private AllocTaskStatus todayFilter = AllocTaskStatus.YetToStart;
    private bool todayStepperCollapsed;

    private sealed record TodayFilter(int Number, string Label, AllocTaskStatus Status);

    private static readonly List<TodayFilter> TodayFilters = new()
    {
        new(1, "Yet to Start", AllocTaskStatus.YetToStart),
        new(2, "In Progress", AllocTaskStatus.InProgress),
        new(3, "Completed", AllocTaskStatus.Completed)
    };

    // Spread across all three statuses (rather than all defaulting to Yet to
    // Start) so every filter tab has a real card to show out of the box -
    // otherwise "In Progress"/"Completed" always rendered the empty state
    // until a user manually clicked Start/Continue on something first, which
    // hid the green/purple themes entirely on a fresh page load.
    private AllocTaskStatus dealerTaskStatus = AllocTaskStatus.Completed;
    private AllocTaskStatus programTaskStatus = AllocTaskStatus.InProgress;
    private AllocTaskStatus spcmTaskStatus = AllocTaskStatus.YetToStart;
    private AllocTaskStatus soilTaskStatus = AllocTaskStatus.InProgress;
    private AllocTaskStatus posTaskStatus = AllocTaskStatus.YetToStart;

    private int CountByStatus(AllocTaskStatus status) =>
        new[] { dealerTaskStatus, programTaskStatus, spcmTaskStatus, soilTaskStatus, posTaskStatus }
            .Count(s => s == status);

    // The sidebar notification badges are the static 1 / 2 / 1 from the
    // Figma design, not a live count of the 5 example cards above (those
    // numbers don't correspond to this placeholder set - they represent
    // other tasks not shown here). CountByStatus stays live since it drives
    // which cards are actually visible under each filter.
    private static int BadgeCount(AllocTaskStatus status) => status switch
    {
        AllocTaskStatus.YetToStart => 1,
        AllocTaskStatus.InProgress => 2,
        AllocTaskStatus.Completed => 1,
        _ => 0
    };

    private string EmptyTodayTitle => todayFilter switch
    {
        AllocTaskStatus.YetToStart => "Nothing left to start",
        AllocTaskStatus.InProgress => "Nothing in progress right now",
        _ => "Nothing completed yet"
    };

    // Card theme + button label follow the task's own status, not just
    // whichever filter is currently selected (though in practice a card
    // only renders while its status matches the active filter anyway).
    private static string StatusCardClass(AllocTaskStatus status) => status switch
    {
        AllocTaskStatus.InProgress => "ta-status-inprogress",
        AllocTaskStatus.Completed => "ta-status-completed",
        _ => ""
    };

    private static string ActionLabel(AllocTaskStatus status) => status switch
    {
        AllocTaskStatus.InProgress => "Continue",
        AllocTaskStatus.Completed => "View Details",
        _ => "Start"
    };

    // The floating shortcut button jumps to whichever status comes after the
    // one currently being viewed (Yet to Start -> In Progress -> Completed),
    // and only shows if that status actually has something in it.
    private AllocTaskStatus? NextStatus => todayFilter switch
    {
        AllocTaskStatus.YetToStart => AllocTaskStatus.InProgress,
        AllocTaskStatus.InProgress => AllocTaskStatus.Completed,
        _ => null
    };

    // MD Program / Soil Sample / PoS Liquidation don't have a dedicated detail
    // page yet (only Dealer and SPCM do, via TaskDetail) - same placeholder
    // pattern as TaskDetail's own "not built yet" quick actions.
    private void ViewDetailsNotAvailable() => Toast.Info("Detailed view for this task type isn't built yet.");

    private void AdvanceTask(AllocTaskStatus current, Action<AllocTaskStatus> setStatus)
    {
        var next = current switch
        {
            AllocTaskStatus.YetToStart => AllocTaskStatus.InProgress,
            AllocTaskStatus.InProgress => AllocTaskStatus.Completed,
            _ => current // "View" on an already-completed task: nothing to advance
        };
        if (next == current) return;

        setStatus(next);
        Toast.Success(next == AllocTaskStatus.InProgress ? "Task moved to In Progress." : "Task marked as Completed.");
    }

    private int currentStep = 1;
    private bool stepperCollapsed;

    // Static placeholder: matches Karthik Raja's profile on FieldDashboard
    // (JMDO · Coimbatore Region) - no logged-in-user hierarchy lookup exists
    // yet to drive this for real.
    private const string FieldExecRegion = "COIMBATORE";
    private const string FieldExecMoHq = "-";
    private const string FieldExecJmdoHq = "COIMBATORE";

    private string spcmTarget = "";
    private string soilTarget = "";
    private string ureaTarget = "";
    private string dapTarget = "";
    private string npsTarget = "";
    private string othersTarget = "";

    private sealed record WizardStep(int Number, string Label);

    private static readonly List<WizardStep> Steps = new()
    {
        new(1, "Dealer"),
        new(2, "SPCM"),
        new(3, "Soil Sample"),
        new(4, "MD Program"),
        new(5, "PoS liquidation")
    };

    private void GoToStep(int step)
    {
        if (step < 1 || step > Steps.Count) return;
        currentStep = step;
    }

    private void ToggleStepper() => stepperCollapsed = !stepperCollapsed;

    private string submittedSummary = "";

    private void SubmitAllocation()
    {
        var spcm = string.IsNullOrWhiteSpace(spcmTarget) ? "0" : spcmTarget;
        var soil = string.IsNullOrWhiteSpace(soilTarget) ? "0" : soilTarget;
        submittedSummary = $"{SelectedDealers.Count()} dealer task(s) · SPCM target {spcm} · Soil target {soil} · {SelectedPrograms.Count()} program(s)";

        isAllocationSubmitted = true;
        currentStep = 1;
        Toast.Success("Allocation submitted for MDO approval.");
    }

    private async Task CopyCode(string code)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
            Toast.Success($"{code} copied.");
        }
        catch
        {
            // Clipboard API unavailable (e.g. no secure context): nothing to copy to.
        }
    }

    private sealed class DealerOption
    {
        public string Name { get; init; } = "";
        public string DealerCode { get; init; } = "";
        public string IfmsId { get; init; } = "";
        public string PosLiquidation { get; init; } = "";
        public int DuesLakhs { get; init; }
        public int PendingAckMt { get; init; }
        public string TypeLabel { get; init; } = "";
        public bool IsSelected { get; set; }
    }

    private string dealerSearch = "";

    private readonly List<DealerOption> Dealers = new()
    {
        new() { Name = "Kumar Company", DealerCode = "45541152", IfmsId = "112563", PosLiquidation = "12.5 mT · 90 days", DuesLakhs = 110, PendingAckMt = 10, TypeLabel = "Retailer", IsSelected = true },
        new() { Name = "Hanumesh Trading Co", DealerCode = "41051099", IfmsId = "215361", PosLiquidation = "12.5 mT · 160 days", DuesLakhs = 99, PendingAckMt = 10, TypeLabel = "Wholesaler", IsSelected = true },
        new() { Name = "Abdul Rasheed M-Terminated", DealerCode = "41001382", IfmsId = "521364", PosLiquidation = "12.5 mT · 110 days", DuesLakhs = 99, PendingAckMt = 10, TypeLabel = "Retailer", IsSelected = false }
    };

    private IEnumerable<DealerOption> FilteredDealers =>
        string.IsNullOrWhiteSpace(dealerSearch)
            ? Dealers
            : Dealers.Where(d =>
                d.Name.Contains(dealerSearch, StringComparison.OrdinalIgnoreCase) ||
                d.DealerCode.Contains(dealerSearch, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<DealerOption> SelectedDealers => Dealers.Where(d => d.IsSelected);

    private void ToggleDealer(DealerOption dealer) => dealer.IsSelected = !dealer.IsSelected;

    private sealed class ProgramOption
    {
        public string Title { get; init; } = "";
        public string SanctionNo { get; init; } = "";
        public string SanctionDate { get; init; } = "";
        public int ProgramCount { get; init; }
        public string TotalBudget { get; init; } = "";
        public string TypeLabel { get; init; } = "";
        public bool IsSelected { get; set; }
    }

    private readonly List<ProgramOption> Programs = new()
    {
        new() { Title = "Crop Protection Workshop", SanctionNo = "CSR1-2026-045", SanctionDate = "01 May 2026", ProgramCount = 1, TotalBudget = "₹50,000", TypeLabel = "Training", IsSelected = true },
        new() { Title = "Farmer Awareness Training", SanctionNo = "CSR1-2026-046", SanctionDate = "10 May 2026", ProgramCount = 2, TotalBudget = "₹32,000", TypeLabel = "Training", IsSelected = false },
        new() { Title = "Sustainable Agriculture Workshop", SanctionNo = "CSR1-2026-047", SanctionDate = "21 May 2026", ProgramCount = 1, TotalBudget = "₹32,000", TypeLabel = "Training", IsSelected = false }
    };

    private IEnumerable<ProgramOption> SelectedPrograms => Programs.Where(p => p.IsSelected);

    private void ToggleProgram(ProgramOption program) => program.IsSelected = !program.IsSelected;
}
