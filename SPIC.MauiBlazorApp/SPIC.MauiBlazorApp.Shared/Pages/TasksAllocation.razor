                    });
                }

                if (a.UreaTarget > 0 || a.NpsTarget > 0 || a.DapTarget > 0 || a.OthersTarget > 0)
                {
                    rows.Add(new TaskSummaryRow
                    {
                        TaskType = "PoS Liquidation",
                        Title = "PoS Liquidation",
                        SubText = null,
                        Status = a.PosLiquidationStatus,
                        WeekStart = a.AllocationDate,
                        CompletedAt = a.PosLiquidationCompletedAt
                    });
                }
            }

            return rows.OrderByDescending(r => r.WeekStart).ToList();
        }
    }

