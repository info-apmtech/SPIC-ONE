    // One card per allocation (= one submitted week), each showing that week's targets against
    // what's actually been done plus a Sun-Sat day breakdown of dealer visits.
    // Day is nullable - a dealer visit added without picking a weekday (PlannedDay left unset)
    // has no slot in the Sun-Sat breakdown, so it gets collected into one "Unscheduled" bucket
    // (Day == null) instead of silently vanishing - otherwise the 7 day totals undercounted the
    // Dealer Visits tile's own total/pending by exactly however many of these existed.
    private sealed class DayBreakdown
    {
        public DayOfWeek? Day;
        public int Total;
        public int Completed;
        public int Pending => Total - Completed;
    }

    // Target vs Achieved for SPCM/Soil Sample/the 4 PoS products - Achieved comes from the
    // matching JmdoTaskCloseout row (AchievedTarget for Spcm, Urea/Nps/Dap/Other for
    // PosLiquidation) where one exists, so Pending reflects real logged quantities, not just
    // whether the task was marked Completed.
    private sealed class TargetBreakdown
    {
        public string Label = "";
        public string Icon = "";
        public int Target;
        public int Achieved;
        public AllocTaskStatus Status;
        public int Pending => Math.Max(Target - Achieved, 0);
        public int PercentDone => Target <= 0 ? 0 : Math.Min(100, (int)Math.Round(100.0 * Achieved / Target));

        // What's actually shown on the pill - derived from Target/Achieved rather than trusting
        // Status as-is. Status can be stale "Completed" for allocations marked done before the
        // backend started gating that transition on the logged count actually reaching Target
        // (see JmdoTaskAllocationController's CreateCloseout/UpdateMyTaskStatus) - showing
        // "Completed" next to "Achieved 2 - Pending 198" read as a bug even though it was really
        // just old data. Once Achieved truly reaches Target this always reads Completed, even if
        // Status itself hasn't caught up yet.
        public AllocTaskStatus EffectiveStatus =>
            Target > 0 && Achieved >= Target ? AllocTaskStatus.Completed
            : Status == AllocTaskStatus.Completed ? AllocTaskStatus.InProgress
            : Status;
    }

    private sealed class WeekSummary
    {
        public int AllocationId;
        public DateTime WeekStart;
        public DateTime WeekEnd => WeekStart.AddDays(6);
        public string AllocationStatus = "";
        public int DealerTotal;
        public int DealerCompleted;
        public int DealerPending => DealerTotal - DealerCompleted;
        public int ProgramTotal;
        public int ProgramCompleted;
        public decimal ProgramBudget;
        public List<DayBreakdown> Days { get; set; } = new();
        public List<TargetBreakdown> Targets { get; set; } = new();
        public int OverallPercent;
    }

    private static readonly DayOfWeek[] WeekDayOrder =
    {
        DayOfWeek.Sunday, DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday,
        DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday
    };

    // dealerFilter/statusFilter narrow which dealers/programs/targets count toward this week's
    // tiles - same "dealer filter hides the non-dealer sections" convention as Task History.
    // OverallPercent is always computed from the UNFILTERED allocation, not the filtered subset,
    // so it keeps meaning "how much of this whole week is done" rather than collapsing to a
    // degenerate 0%/100% whenever a specific status is selected.
    private static WeekSummary BuildWeekSummary(JmdoTaskAllocationResponseDto a, string dealerFilter, string statusFilter)
    {
        bool dealerFilterActive = !string.IsNullOrWhiteSpace(dealerFilter);
        bool MatchesStatus(AllocTaskStatus s) => string.IsNullOrEmpty(statusFilter) || s.ToString() == statusFilter;

        var dealers = a.DealerAssignments
            .Where(d => MatchesStatus(d.Status) && (!dealerFilterActive || string.Equals(d.DealerName, dealerFilter, StringComparison.OrdinalIgnoreCase)))
            .ToList();
        var programs = dealerFilterActive ? new List<JmdoAllocationProgramRowDto>() : a.Programs.Where(p => MatchesStatus(p.Status)).ToList();

        var week = new WeekSummary
        {
            AllocationId = a.Id,
            // Normalized rather than trusted as-is - AllocationDate is supposed to always be a
            // Sunday, but rows submitted before the WeekStart feature existed can hold the literal
            // (non-Sunday) submission date, which would otherwise show as a Monday-to-Sunday
            // range here instead of this app's Sunday-to-Saturday week.
            WeekStart = NormalizeToWeekStart(a.AllocationDate),
            AllocationStatus = a.Status,
            DealerTotal = dealers.Count,
            DealerCompleted = dealers.Count(d => d.Status == AllocTaskStatus.Completed),
            ProgramTotal = programs.Count,
            ProgramCompleted = programs.Count(p => p.Status == AllocTaskStatus.Completed),
            ProgramBudget = programs.Sum(p => p.Budget),
            Days = WeekDayOrder.Select(day =>
            {
                var onDay = dealers.Where(d => d.Day == day).ToList();
                return new DayBreakdown
                {
                    Day = day,
                    Total = onDay.Count,
                    Completed = onDay.Count(d => d.Status == AllocTaskStatus.Completed)
                };
            }).ToList()
        };

        var unscheduled = dealers.Where(d => d.Day == null).ToList();
        if (unscheduled.Count > 0)
        {
            week.Days.Add(new DayBreakdown
            {
                Day = null,
                Total = unscheduled.Count,
                Completed = unscheduled.Count(d => d.Status == AllocTaskStatus.Completed)
            });
        }

        if (!dealerFilterActive)
        {
            // Sum across EVERY closeout of that Kind, not just the first one - SPCM/PoS are
            // weekly count targets a JMDO can log against on several different days (see
            // JmdoTaskAllocationController's CreateCloseout), so a single FirstOrDefault()
            // under-reported "Achieved" the moment more than one record existed for the week.
            var spcmAchieved = a.Closeouts.Where(c => c.Kind == JmdoCloseoutKind.Spcm).Sum(c => c.AchievedTarget ?? 0);
            var posCloseouts = a.Closeouts.Where(c => c.Kind == JmdoCloseoutKind.PosLiquidation).ToList();

            if (a.SpcmTarget is > 0 && MatchesStatus(a.SpcmStatus))
            {
                week.Targets.Add(new TargetBreakdown { Label = "SPCM", Icon = "bi-bullseye", Target = a.SpcmTarget.Value, Achieved = spcmAchieved, Status = a.SpcmStatus });
            }

            if (a.SoilSampleTarget is > 0 && MatchesStatus(a.SoilSampleStatus))
            {
                // Soil Sample's Start button goes straight to /SampleCollection/new rather than
                // through TaskDetail's close-out form, so there's no logged achieved quantity for
                // it yet - approximate Achieved from Status alone (0 unless marked Completed).
                week.Targets.Add(new TargetBreakdown { Label = "Soil Sample", Icon = "bi-moisture", Target = a.SoilSampleTarget.Value, Achieved = a.SoilSampleStatus == AllocTaskStatus.Completed ? a.SoilSampleTarget.Value : 0, Status = a.SoilSampleStatus });
            }

            if (MatchesStatus(a.PosLiquidationStatus))
            {
                if (a.UreaTarget > 0)
                    week.Targets.Add(new TargetBreakdown { Label = "Urea", Icon = "bi-box-seam", Target = a.UreaTarget.Value, Achieved = posCloseouts.Sum(c => c.Urea ?? 0), Status = a.PosLiquidationStatus });
                if (a.NpsTarget > 0)
                    week.Targets.Add(new TargetBreakdown { Label = "NPKS", Icon = "bi-box-seam", Target = a.NpsTarget.Value, Achieved = posCloseouts.Sum(c => c.Nps ?? 0), Status = a.PosLiquidationStatus });
                if (a.DapTarget > 0)
                    week.Targets.Add(new TargetBreakdown { Label = "DAP", Icon = "bi-box-seam", Target = a.DapTarget.Value, Achieved = posCloseouts.Sum(c => c.Dap ?? 0), Status = a.PosLiquidationStatus });
                if (a.OthersTarget > 0)
                    week.Targets.Add(new TargetBreakdown { Label = "Other", Icon = "bi-box-seam", Target = a.OthersTarget.Value, Achieved = posCloseouts.Sum(c => c.Other ?? 0), Status = a.PosLiquidationStatus });
            }
        }

        // "Done" for SPCM/PoS is re-derived from the real logged count vs Target here too, same
        // as TargetBreakdown.EffectiveStatus above and for the same reason - a.SpcmStatus/
        // a.PosLiquidationStatus can be stale "Completed" from before the backend started gating
        // that transition on the count actually reaching Target, which would otherwise overstate
        // OverallPercent (e.g. crediting SPCM as done at 2 of 200 achieved).
        var allSpcmAchieved = a.Closeouts.Where(c => c.Kind == JmdoCloseoutKind.Spcm).Sum(c => c.AchievedTarget ?? 0);
        var allPosCloseouts = a.Closeouts.Where(c => c.Kind == JmdoCloseoutKind.PosLiquidation).ToList();
        var spcmDone = a.SpcmTarget is > 0 && allSpcmAchieved >= a.SpcmTarget;
        var posDone = (a.UreaTarget > 0 || a.NpsTarget > 0 || a.DapTarget > 0 || a.OthersTarget > 0)
            && (a.UreaTarget is not > 0 || allPosCloseouts.Sum(c => c.Urea ?? 0) >= a.UreaTarget)
            && (a.NpsTarget is not > 0 || allPosCloseouts.Sum(c => c.Nps ?? 0) >= a.NpsTarget)
            && (a.DapTarget is not > 0 || allPosCloseouts.Sum(c => c.Dap ?? 0) >= a.DapTarget)
            && (a.OthersTarget is not > 0 || allPosCloseouts.Sum(c => c.Other ?? 0) >= a.OthersTarget);

        var totalUnits = a.DealerAssignments.Count + a.Programs.Count
            + (a.SpcmTarget is > 0 ? 1 : 0)
            + (a.SoilSampleTarget is > 0 ? 1 : 0)
            + (a.UreaTarget > 0 || a.NpsTarget > 0 || a.DapTarget > 0 || a.OthersTarget > 0 ? 1 : 0);
        var doneUnits = a.DealerAssignments.Count(d => d.Status == AllocTaskStatus.Completed) + a.Programs.Count(p => p.Status == AllocTaskStatus.Completed)
            + (spcmDone ? 1 : 0)
            + (a.SoilSampleTarget is > 0 && a.SoilSampleStatus == AllocTaskStatus.Completed ? 1 : 0)
            + (posDone ? 1 : 0);
        week.OverallPercent = totalUnits == 0 ? 0 : (int)Math.Round(100.0 * doneUnits / totalUnits);

        return week;
    }

    private List<WeekSummary> WeekSummaries
    {
        get
        {
            var filtersActive = !string.IsNullOrWhiteSpace(appliedSummaryDealer) || !string.IsNullOrEmpty(appliedSummaryStatus);

            IEnumerable<JmdoTaskAllocationResponseDto> source = UseTodayAllocationSourceForSummary
                ? (todayAllocation != null ? new[] { todayAllocation } : Enumerable.Empty<JmdoTaskAllocationResponseDto>())
                : _allAllocations.Where(a => MatchesSummaryWeekFilter(a.AllocationDate));

            var weeks = source.Select(a => BuildWeekSummary(a, appliedSummaryDealer, appliedSummaryStatus));

            if (filtersActive)
                weeks = weeks.Where(w => w.DealerTotal > 0 || w.ProgramTotal > 0 || w.Targets.Count > 0);

            return weeks.OrderByDescending(w => w.WeekStart).ToList();
        }
    }

    private List<TaskSummaryRow> TaskSummaryRows
    {
        get
        {
            var rows = new List<TaskSummaryRow>();
            foreach (var a in _allAllocations)
            {
                foreach (var d in a.DealerAssignments)
