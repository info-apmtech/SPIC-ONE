        if (appliedSummaryFrom is { } from && normalizedWeekStart < NormalizeToWeekStart(from)) return false;
        if (appliedSummaryTo is { } to && normalizedWeekStart > NormalizeToWeekStart(to)) return false;
        return true;
    }

    // At the default "Today" range, show the SAME current-week allocation as Today's Allocation
