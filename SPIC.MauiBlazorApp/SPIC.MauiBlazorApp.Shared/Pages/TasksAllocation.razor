@page "/TasksAllocation"
@using System.Net.Http.Json
@using SPIC.Core.DTOs
@using SPIC.Core.Entities
@using SPIC.MauiBlazorApp.Shared.Services
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject HttpClient Http
@inject SPIC.MauiBlazorApp.Shared.Services.LoginState LoginState
@inject SPIC.MauiBlazorApp.Shared.Services.ToastService Toast
@inject SPIC.MauiBlazorApp.Shared.Services.LookupCacheService LookupCache

<div class="container-fluid py-4 px-0 ta-page">

    <!-- Header card -->
    <div class="ta-header-card">
        <h2 class="ta-title">Tasks Allocation</h2>
        <p class="ta-subtitle">@HeaderSubtitle</p>
    </div>

    <!-- Tabs + content card -->
    <div class="ta-content-card">
        <div class="ta-tabs" role="tablist">
            <button type="button"
                    class="ta-tab @(currentTab == TaTab.All ? "active" : "")"
                    role="tab"
                    aria-selected="@(currentTab == TaTab.All ? "true" : "false")"
                    @onclick="() => currentTab = TaTab.All">
                All Allocations
            </button>
            <button type="button"
                    class="ta-tab @(currentTab == TaTab.Today ? "active" : "")"
                    role="tab"
                    aria-selected="@(currentTab == TaTab.Today ? "true" : "false")"
                    @onclick="() => currentTab = TaTab.Today">
                Today's Allocation
            </button>
            <button type="button"
                    class="ta-tab @(currentTab == TaTab.Completed ? "active" : "")"
                    role="tab"
                    aria-selected="@(currentTab == TaTab.Completed ? "true" : "false")"
                    @onclick="() => currentTab = TaTab.Completed">
                Completed Allocations
            </button>
        </div>

        @if (currentTab == TaTab.All)
        {
            @if (isAllocationSubmitted)
            {
                @if (todayAllocation?.Status == "Approved")
                {
                    <div class="ta-status-card ta-status-completed">
                        <div class="ta-status-icon"><i class="bi bi-check-circle"></i></div>
                        <div class="ta-status-title">Allocation Approved</div>
                        <div class="ta-status-summary">@submittedSummary</div>
                        <button type="button" class="ta-btn ta-btn-next mt-3" @onclick="() => currentTab = TaTab.Today">
                            Go to Today's Tasks <i class="bi bi-arrow-right"></i>
                        </button>
                    </div>
                }
                else
                {
                    <div class="ta-status-card ta-status-pending">
                        <div class="ta-status-icon"><i class="bi bi-clock-history"></i></div>
                        <div class="ta-status-title">Allocation submitted &mdash; awaiting MDO approval</div>
                        <div class="ta-status-summary">@submittedSummary</div>
                    </div>
                }
            }
            else
            {
                <div class="ta-wizard">
                    <!-- Step sidebar -->
                    <div class="ta-stepper @(stepperCollapsed ? "ta-stepper-collapsed" : "")">
                        @foreach (var step in Steps)
                        {
                            <button type="button"
                                    class="ta-step-item @(currentStep == step.Number ? "active" : "")"
                                    @onclick="() => GoToStep(step.Number)">
                                <span class="ta-step-num">@step.Number</span>
                                <span class="ta-step-label">@step.Label</span>
                            </button>
                        }
                    </div>

                    <button type="button" class="ta-stepper-toggle" title="@(stepperCollapsed ? "Expand steps" : "Collapse steps")" @onclick="ToggleStepper">
                        <i class="bi @(stepperCollapsed ? "bi-chevron-right" : "bi-chevron-left")"></i>
                    </button>

                    <!-- Step content -->
                    <div class="ta-wizard-content">
                        @if (currentStep == 1)
                        {
                            <div class="ta-step-panel">
                                <p class="ta-step-instruction">Step 1 of 5 &mdash; plan which dealers you'll visit on each day of the week.</p>

                                <div class="ta-day-tabs" role="tablist">
                                    @foreach (var day in WeekDays)
                                    {
                                        var count = selectionsByDay[day].Count;
                                        <button type="button"
                                                class="ta-day-tab @(selectedDay == day ? "active" : "")"
                                                role="tab"
                                                aria-selected="@(selectedDay == day ? "true" : "false")"
                                                @onclick="() => selectedDay = day">
                                            @DayLabel(day)
                                            @if (count > 0)
                                            {
                                                <span class="ta-day-tab-count">@count</span>
                                            }
                                        </button>
                                    }
                                </div>

                                <div class="ta-step-toolbar">
                                    <div class="ta-search-box">
                                        <i class="bi bi-search"></i>
                                        <input type="text" placeholder="Search dealer name or code..." @bind="dealerSearch" @bind:event="oninput" />
                                    </div>
                                    <select class="ta-filter-select" @bind="selectedDistrictFilter" @bind:after="OnDistrictFilterChanged">
                                        <option value="0">All Districts</option>
                                        @foreach (var district in AvailableDistrictFilters)
                                        {
                                            <option value="@district.Id">@district.DistrictName</option>
                                        }
                                    </select>
                                    <select class="ta-filter-select" @bind="selectedTalukFilter" @bind:after="OnTalukFilterChanged">
                                        <option value="">All Sub Districts</option>
                                        @foreach (var taluk in AvailableTalukFilters)
                                        {
                                            <option value="@taluk">@taluk</option>
                                        }
                                    </select>
                                    <select class="ta-filter-select" @bind="selectedDealerFilter">
                                        <option value="0">All Dealers</option>
                                        @foreach (var dealer in AvailableDealerFilters)
                                        {
                                            <option value="@dealer.Id">@dealer.Name</option>
                                        }
                                    </select>
                                </div>

                                <div class="ta-dealer-grid">
                                    @if (isLoadingDealers)
                                    {
                                        <EmptyState Icon="bi-hourglass-split" Title="Loading dealers..." Compact="true" />
                                    }
                                    else if (dealersLoadFailed)
                                    {
                                        <EmptyState Icon="bi-exclamation-triangle" Title="Couldn't load dealers" Message="Please try again in a moment." Compact="true" />
                                    }
                                    else
                                    {
                                        @foreach (var dealer in FilteredDealers)
                                        {
                                            var isSelected = IsDealerSelected(dealer);
                                            <div class="ta-dealer-card @(isSelected ? "selected" : "")" @onclick="() => ToggleDealer(dealer)">
                                                <div class="ta-dealer-top">
                                                    <span class="ta-checkbox @(isSelected ? "checked" : "")">
                                                        @if (isSelected)
                                                        {
                                                            <i class="bi bi-check-lg"></i>
                                                        }
                                                    </span>
                                                    <span class="ta-type-pill"><i class="bi bi-shop"></i> @dealer.TypeLabel</span>
                                                </div>

                                                <h4 class="ta-dealer-name">@dealer.Name</h4>

                                                <div class="ta-dealer-code-row">
                                                    <i class="bi bi-person"></i> Dealer Code <strong>@dealer.DealerCode</strong>
                                                    <button type="button" class="ta-copy-btn" title="Copy dealer code" @onclick="() => CopyCode(dealer.DealerCode)" @onclick:stopPropagation="true">
                                                        <i class="bi bi-copy"></i>
                                                    </button>
                                                </div>

                                                <div class="ta-dealer-info-row">
                                                    <span>iFMS ID</span>
                                                    <strong>@(dealer.IfmsId ?? "—")</strong>
                                                </div>
                                                <div class="ta-dealer-info-row">
                                                    <span>PoS Liquidation</span>
                                                    <strong>@(dealer.PosLiquidation ?? "—")</strong>
                                                </div>

                                                <div class="ta-dealer-stats-row ta-dealer-stats-row-single">
                                                    <div class="ta-mini-stat ta-mini-stat-pending">
                                                        <div class="ta-mini-stat-label"><i class="bi bi-clipboard-check"></i> Pending Ack.</div>
                                                        <div class="ta-mini-stat-val">
                                                            @if (dealer.PendingAckMt is int ack)
                                                            {
                                                                @ack <span>mT</span>
                                                            }
                                                            else
                                                            {
                                                                @:—
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }

                                        @if (!FilteredDealers.Any())
                                        {
                                            <EmptyState Icon="bi-search" Title="No dealers match your search" Compact="true" />
                                        }
                                    }
                                </div>

                                <div class="ta-step-footer">
                                    <div class="ta-selected-summary">
                                        @{ var selectedForDay = SelectedDealersFor(selectedDay).ToList(); }
                                        @if (selectedForDay.Any())
                                        {
                                            @($"{DayLabel(selectedDay)}: ") @string.Join("  ·  ", selectedForDay.Select(d => $"{d.Name} - dealer Code : {d.DealerCode}"))
                                        }
                                        else
                                        {
                                            <span>Select at least one dealer for @DayLabel(selectedDay), or switch tabs to plan another day.</span>
                                        }
                                    </div>
                                    <button type="button" class="ta-btn ta-btn-next" @onclick="() => GoToStep(2)">
                                        Next: SPCM Target <i class="bi bi-arrow-right"></i>
                                    </button>
                                </div>
                            </div>
                        }
                        else if (currentStep == 2)
                        {
                            <div class="ta-step-panel">
                                <p class="ta-step-instruction">Step 2 of 5 &mdash; how much are you targeting to achieve this week?</p>

                                <div class="ta-target-card">
                                    <div class="ta-target-header">
                                        <i class="bi bi-bullseye"></i>
                                        <h4>This Week's SPCM Target</h4>
                                    </div>
                                    <p class="ta-target-meta">Region: @FieldExecRegion &middot; MO H.Q: @FieldExecMoHq &middot; JMDO H.Q: @FieldExecJmdoHq</p>

                                    <label class="ta-target-label" for="ta-spcm-target">This Week's Target</label>
                                    <input id="ta-spcm-target" type="number" min="0" class="ta-target-input" placeholder="e.g. 100" @bind="spcmTarget" @bind:event="oninput" />
                                </div>

                                <div class="ta-step-footer ta-step-footer-simple">
                                    <button type="button" class="ta-btn ta-btn-prev" @onclick="() => GoToStep(1)">
                                        <i class="bi bi-arrow-left"></i> Back
                                    </button>
                                    <button type="button" class="ta-btn ta-btn-next" @onclick="() => GoToStep(3)">
                                        Next: Soil Sample <i class="bi bi-arrow-right"></i>
                                    </button>
                                </div>
                            </div>
                        }
                        else if (currentStep == 3)
                        {
                            <div class="ta-step-panel">
                                <p class="ta-step-instruction">Step 3 of 5 &mdash; how many soil samples are you targeting this week?</p>

                                <div class="ta-target-card">
                                    <div class="ta-target-header">
                                        <i class="bi bi-moisture"></i>
                                        <h4>Soil Sample Collection</h4>
                                    </div>
                                    <p class="ta-target-meta">Region: @FieldExecRegion &middot; MO H.Q: @FieldExecMoHq &middot; JMDO H.Q: @FieldExecJmdoHq</p>

                                    <label class="ta-target-label" for="ta-soil-target">This Week's Target</label>
                                    <input id="ta-soil-target" type="number" min="0" class="ta-target-input" placeholder="e.g. 100" @bind="soilTarget" @bind:event="oninput" />
                                </div>

                                <div class="ta-step-footer ta-step-footer-simple">
                                    <button type="button" class="ta-btn ta-btn-prev" @onclick="() => GoToStep(2)">
                                        <i class="bi bi-arrow-left"></i> Back
                                    </button>
                                    <button type="button" class="ta-btn ta-btn-next" @onclick="() => GoToStep(4)">
                                        Next: MD Program <i class="bi bi-arrow-right"></i>
                                    </button>
                                </div>
                            </div>
                        }
                        else if (currentStep == 4)
                        {
                            <div class="ta-step-panel">
                                <p class="ta-step-instruction">Step 4 of 5 &mdash; MD programs assigned to you in CSR1 are included automatically; submit for MDO approval when ready.</p>

                                <div class="ta-dealer-grid">
                                    @if (isLoadingPrograms)
                                    {
                                        <EmptyState Icon="bi-hourglass-split" Title="Loading MD programs..." Compact="true" />
                                    }
                                    else if (programsLoadFailed)
                                    {
                                        <EmptyState Icon="bi-exclamation-triangle" Title="Couldn't load MD programs" Message="Please try again in a moment." Compact="true" />
                                    }
                                    else if (!Programs.Any())
                                    {
                                        <EmptyState Icon="bi-easel" Title="No MD programs are assigned to you" Compact="true" />
                                    }
                                    else
                                    {
                                        @foreach (var program in Programs)
                                        {
                                            <div class="ta-dealer-card selected">
                                                <div class="ta-dealer-top">
                                                    <span class="ta-program-day-badge">@DayLabel(program.CreatedAt.DayOfWeek)</span>
                                                    <span class="ta-type-pill ta-type-pill-purple"><i class="bi bi-people"></i> @program.TypeLabel</span>
                                                </div>

                                                <h4 class="ta-dealer-name ta-program-name">@program.Title</h4>

                                                <div class="ta-dealer-code-row">
                                                    <i class="bi bi-file-earmark-text"></i> Sanction No. <strong>@(program.SanctionNo ?? "—")</strong>
                                                    @if (program.SanctionNo is not null)
                                                    {
                                                        <button type="button" class="ta-copy-btn" title="Copy sanction number" @onclick="() => CopyCode(program.SanctionNo)" @onclick:stopPropagation="true">
                                                            <i class="bi bi-copy"></i>
                                                        </button>
                                                    }
                                                </div>

                                                <div class="ta-dealer-info-row ta-program-date-row">
                                                    <span>Sanction Date</span>
                                                    <strong>@(program.SanctionDate ?? "—")</strong>
                                                </div>

                                                <div class="ta-dealer-stats-row">
                                                    <div class="ta-mini-stat ta-mini-stat-programs">
                                                        <div class="ta-mini-stat-label"><i class="bi bi-file-earmark-text"></i> Programs</div>
                                                        <div class="ta-mini-stat-val">@program.ProgramCount <span>Program</span></div>
                                                    </div>
                                                    <div class="ta-mini-stat ta-mini-stat-budget">
                                                        <div class="ta-mini-stat-label"><i class="bi bi-bullseye"></i> Total Budget</div>
                                                        <div class="ta-mini-stat-val">@program.TotalBudget</div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>

                                <div class="ta-step-footer">
                                    <div class="ta-selected-summary">
                                        @if (Programs.Any())
                                        {
                                            @string.Join("  ·  ", Programs.Select(p => $"{p.ProgramCount} Program - {p.Title}"))
                                        }
                                        else
                                        {
                                            <span>No MD programs assigned to you this week.</span>
                                        }
                                    </div>
                                    <div class="ta-step-footer-actions">
                                        <button type="button" class="ta-btn ta-btn-prev" @onclick="() => GoToStep(3)">
                                            <i class="bi bi-arrow-left"></i> Back
                                        </button>
                                        <button type="button" class="ta-btn ta-btn-next" @onclick="() => GoToStep(5)">
                                            Next: PoS liquidation <i class="bi bi-arrow-right"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="ta-step-panel">
                                <p class="ta-step-instruction">Step 5 of 5 &mdash; how much are you targeting to achieve this week?</p>

                                <div class="ta-target-card ta-target-card-wide">
                                    <div class="ta-target-header">
                                        <i class="bi bi-bullseye"></i>
                                        <h4>This Week's PoS liquidation</h4>
                                    </div>
                                    <p class="ta-target-meta">Region: @FieldExecRegion &middot; MO H.Q: @FieldExecMoHq &middot; JMDO H.Q: @FieldExecJmdoHq</p>

                                    <div class="ta-target-input-grid">
                                        <div class="ta-target-field">
                                            <label class="ta-target-label" for="ta-urea-target">Urea</label>
                                            <input id="ta-urea-target" type="number" min="0" class="ta-target-input" placeholder="e.g. 100" @bind="ureaTarget" @bind:event="oninput" />
                                        </div>
                                        <div class="ta-target-field">
                                            <label class="ta-target-label" for="ta-dap-target">DAP</label>
                                            <input id="ta-dap-target" type="number" min="0" class="ta-target-input" placeholder="e.g. 100" @bind="dapTarget" @bind:event="oninput" />
                                        </div>
                                        <div class="ta-target-field">
                                            <label class="ta-target-label" for="ta-nps-target">NPKS</label>
                                            <input id="ta-nps-target" type="number" min="0" class="ta-target-input" placeholder="e.g. 100" @bind="npsTarget" @bind:event="oninput" />
                                        </div>
                                        <div class="ta-target-field">
                                            <label class="ta-target-label" for="ta-others-target">Others</label>
                                            <input id="ta-others-target" type="number" min="0" class="ta-target-input" @bind="othersTarget" @bind:event="oninput" />
                                        </div>
                                    </div>
                                </div>

                                <div class="ta-step-footer ta-step-footer-simple">
                                    <button type="button" class="ta-btn ta-btn-prev" @onclick="() => GoToStep(4)">
                                        <i class="bi bi-arrow-left"></i> Back
                                    </button>
                                    <button type="button" class="ta-btn ta-btn-submit" disabled="@isSubmittingAllocation" @onclick="SubmitAllocationAsync">
                                        @(isSubmittingAllocation ? "Submitting..." : "Request")
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
        else if (currentTab == TaTab.Today)
        {
            <div class="ta-wizard">
                <!-- Status filter sidebar -->
                <div class="ta-stepper @(todayStepperCollapsed ? "ta-stepper-collapsed" : "")">
                    @foreach (var filter in TodayFilters)
                    {
                        var count = BadgeCount(filter.Status);
                        <button type="button"
                                class="ta-step-item @(todayFilter == filter.Status ? "active" : "")"
                                @onclick="() => todayFilter = filter.Status">
                            <span class="ta-step-num">@filter.Number</span>
                            <span class="ta-step-label">@filter.Label</span>
                            <span class="ta-today-bell">
                                <i class="bi bi-bell"></i>
                                @if (count > 0)
                                {
                                    <span class="ta-today-badge">@count</span>
                                }
                            </span>
                        </button>
                    }
                </div>

                <button type="button" class="ta-stepper-toggle" title="@(todayStepperCollapsed ? "Expand" : "Collapse")" @onclick="() => todayStepperCollapsed = !todayStepperCollapsed">
                    <i class="bi @(todayStepperCollapsed ? "bi-chevron-right" : "bi-chevron-left")"></i>
                </button>

                <!-- Task cards -->
                <div class="ta-wizard-content">
                    <div class="ta-today-grid">
                        @if (todayAllocation is null)
                        {
                            <EmptyState Icon="bi-inbox" Title="No allocation for today" Compact="true" />
                        }
                        else
                        {
                            @if (CountByStatus(todayFilter) == 0)
                            {
                                <EmptyState Icon="bi-inbox" Title="@EmptyTodayTitle" Compact="true" />
                            }
                            else
                            {
                                @foreach (var assignment in todayAllocation.DealerAssignments.Where(d => d.Day == DateTime.Today.DayOfWeek))
                                {
                                    var dStatus = GetStatus($"dealer_{assignment.DealerId}");
                                    @if (dStatus == todayFilter)
                                    {
                                        <div class="ta-today-card @StatusCardClass(dStatus)">
                                            <div class="ta-dealer-top">
                                                <span class="ta-type-pill ta-type-pill-blue"><i class="bi bi-person"></i> Dealer</span>
                                                <span class="ta-type-pill ta-type-pill-today"><i class="bi bi-shop"></i> Retailer</span>
                                            </div>

                                            <h4 class="ta-dealer-name">@assignment.DealerName</h4>

                                            <div class="ta-dealer-code-row">
                                                <i class="bi bi-person"></i> Dealer Code <strong>@assignment.DealerCode</strong>
                                                <button type="button" class="ta-copy-btn" title="Copy dealer code" @onclick='() => CopyCode(assignment.DealerCode)' @onclick:stopPropagation="true">
                                                    <i class="bi bi-copy"></i>
                                                </button>
                                            </div>

                                            <div class="ta-dealer-info-row">
                                                <span>iFMS ID</span>
                                                <strong>@(Dealers.FirstOrDefault(x => x.Id == assignment.DealerId)?.IfmsId ?? "—")</strong>
                                            </div>
                                            <div class="ta-dealer-info-row">
                                                <span>PoS Liquidation</span>
                                                <strong>@(Dealers.FirstOrDefault(x => x.Id == assignment.DealerId)?.PosLiquidation ?? "—")</strong>
                                            </div>

                                            <div class="ta-dealer-stats-row ta-dealer-stats-row-single">
                                                <div class="ta-mini-stat ta-mini-stat-pending">
                                                    <div class="ta-mini-stat-label"><i class="bi bi-clipboard-check"></i> Pending Ack.</div>
                                                    <div class="ta-mini-stat-val">@(Dealers.FirstOrDefault(x => x.Id == assignment.DealerId)?.PendingAckMt?.ToString() ?? "—")</div>
                                                </div>
                                            </div>

                                            <button type="button" class="ta-start-btn" @onclick='() => Navigation.NavigateTo($"/TaskDetail?type=dealer&id=dealer_{assignment.DealerId}")'>
                                                @ActionLabel(dStatus) <i class="bi bi-arrow-right"></i>
                                            </button>
                                        </div>
                                    }
                                }

                                @foreach (var program in todayAllocation.Programs)
                                {
                                    var pStatus = GetStatus($"prog_{program.Csr1Id}");
                                    @if (pStatus == todayFilter)
                                    {
                                        <div class="ta-today-card @StatusCardClass(pStatus)">
                                            <div class="ta-dealer-top">
                                                <span class="ta-type-pill ta-type-pill-purple"><i class="bi bi-easel"></i> MD Program</span>
                                                <span class="ta-type-pill ta-type-pill-outline"><i class="bi bi-people"></i> Training</span>
                                            </div>

                                            <h4 class="ta-dealer-name ta-program-name">@program.ProgramName</h4>

                                            <div class="ta-dealer-code-row">
                                                <i class="bi bi-file-earmark-text"></i> Sanction No. <strong>@FormatProgramSanctionNo(program)</strong>
                                            </div>

                                            <div class="ta-dealer-info-row">
                                                <span><i class="bi bi-calendar3"></i> Sanction Date</span>
                                                <strong>@FormatProgramSanctionDate(program)</strong>
                                            </div>

                                            <div class="ta-dealer-stats-row">
                                                <div class="ta-mini-stat ta-mini-stat-programs">
                                                    <div class="ta-mini-stat-label"><i class="bi bi-file-earmark-text"></i> Programs</div>
                                                    <div class="ta-mini-stat-val">1 <span>Program</span></div>
                                                </div>
                                                <div class="ta-mini-stat ta-mini-stat-budget">
                                                    <div class="ta-mini-stat-label"><i class="bi bi-bullseye"></i> Total Budget</div>
                                                    <div class="ta-mini-stat-val">@(program.Budget > 0 ? (program.Budget % 1 == 0 ? $"₹{program.Budget:N0}" : $"₹{program.Budget:N2}") : "—")</div>
                                                </div>
                                            </div>

                                            <button type="button" class="ta-start-btn" @onclick='() => Navigation.NavigateTo($"/TaskDetail?type=mdprogram&id=prog_{program.Csr1Id}")'>
                                                @ActionLabel(pStatus) <i class="bi bi-arrow-right"></i>
                                            </button>
                                        </div>
                                    }
                                }

                                var spcmStatus = GetStatus("spcm");
                                @if (todayAllocation.SpcmTarget is > 0 && spcmStatus == todayFilter)
                                {
                                    <div class="ta-today-card ta-today-card-narrow @StatusCardClass(spcmStatus)">
                                        <span class="ta-type-pill ta-type-pill-teal"><i class="bi bi-bullseye"></i> SPCM</span>

                                        <div class="ta-today-target-box">
                                            <span class="ta-today-target-icon"><i class="bi bi-bullseye"></i></span>
                                            <div>
                                                <div class="ta-target-label">Today's Target</div>
                                                <div class="ta-today-target-val">@todayAllocation.SpcmTarget</div>
                                            </div>
                                        </div>

                                        <button type="button" class="ta-start-btn" @onclick='() => Navigation.NavigateTo("/TaskDetail?type=spcm")'>
                                            @ActionLabel(spcmStatus) <i class="bi bi-arrow-right"></i>
                                        </button>
                                    </div>
                                }

                                var soilStatus = GetStatus("soil");
                                @if (todayAllocation.SoilSampleTarget is > 0 && soilStatus == todayFilter)
                                {
                                    <div class="ta-today-card ta-today-card-narrow @StatusCardClass(soilStatus)">
                                        <span class="ta-type-pill ta-type-pill-orange"><i class="bi bi-moisture"></i> Soil Sample</span>

                                        <div class="ta-today-target-box">
                                            <span class="ta-today-target-icon"><i class="bi bi-eyedropper"></i></span>
                                            <div>
                                                <div class="ta-target-label">Today's Target</div>
                                                <div class="ta-today-target-val">@todayAllocation.SoilSampleTarget</div>
                                            </div>
                                        </div>

                                        <button type="button" class="ta-start-btn" @onclick="StartSoilSampleTask">
                                            @ActionLabel(soilStatus) <i class="bi bi-arrow-right"></i>
                                        </button>
                                    </div>
                                }

                                var posStatus = GetStatus("pos");
                                @if ((todayAllocation.UreaTarget > 0 || todayAllocation.NpsTarget > 0 || todayAllocation.DapTarget > 0 || todayAllocation.OthersTarget > 0) && posStatus == todayFilter)
                                {
                                    <div class="ta-today-card ta-today-card-wide @StatusCardClass(posStatus)">
                                        <span class="ta-type-pill ta-type-pill-grey"><i class="bi bi-box-seam"></i> PoS Liquidation</span>

                                        <div class="ta-today-products-label"><i class="bi bi-clipboard-check"></i> Products to liquidate</div>
                                        <div class="ta-today-products-row">
                                            @if (todayAllocation.UreaTarget > 0)
                                            {
                                                <div class="ta-today-product-tile">
                                                    <div class="ta-today-product-name">UREA</div>
                                                    <div class="ta-today-product-val">@todayAllocation.UreaTarget</div>
                                                </div>
                                            }
                                            @if (todayAllocation.NpsTarget > 0)
                                            {
                                                <div class="ta-today-product-tile">
                                                    <div class="ta-today-product-name">NSP</div>
                                                    <div class="ta-today-product-val">@todayAllocation.NpsTarget</div>
                                                </div>
                                            }
                                            @if (todayAllocation.DapTarget > 0)
                                            {
                                                <div class="ta-today-product-tile">
                                                    <div class="ta-today-product-name">DAP</div>
                                                    <div class="ta-today-product-val">@todayAllocation.DapTarget</div>
                                                </div>
                                            }
                                            @if (todayAllocation.OthersTarget > 0)
                                            {
                                                <div class="ta-today-product-tile">
                                                    <div class="ta-today-product-name">OTHER</div>
                                                    <div class="ta-today-product-val">@todayAllocation.OthersTarget</div>
                                                </div>
                                            }
                                        </div>

                                        <button type="button" class="ta-start-btn" @onclick='() => Navigation.NavigateTo("/TaskDetail?type=posliquidation")'>
                                            @ActionLabel(posStatus) <i class="bi bi-arrow-right"></i>
                                        </button>
                                    </div>
                                }
                            }
                        }
                    </div>

                    @if (NextStatus is { } nextStatus && BadgeCount(nextStatus) > 0)
                    {
                        <button type="button" class="ta-today-jump-btn" @onclick="() => todayFilter = nextStatus">
                            @TodayFilters.First(f => f.Status == nextStatus).Label <i class="bi bi-arrow-right"></i>
                        </button>
                    }
                    else if (todayFilter == AllocTaskStatus.Completed)
                    {
                        <button type="button" class="ta-today-back-btn" @onclick="() => todayFilter = AllocTaskStatus.YetToStart">
                            <i class="bi bi-arrow-left"></i> Back
                        </button>
                    }
                </div>
            </div>
        }
        else
        {
            <!-- Static reference list of every finished task (no filter sidebar
                 here, unlike Today's Allocation - this tab is just a flat
                 record of what's done), always in the purple "completed" theme. -->
            @if (todayAllocation == null || CountByStatus(AllocTaskStatus.Completed) == 0)
            {
                <EmptyState Icon="bi-check2-circle" Title="No completed tasks yet" Compact="true" />
            }
            else
            {
                <div class="ta-today-grid">
                    @foreach (var assignment in todayAllocation.DealerAssignments.Where(d => d.Day == DateTime.Today.DayOfWeek))
                    {
                        var dStatus = GetStatus($"dealer_{assignment.DealerId}");
                        if (dStatus == AllocTaskStatus.Completed)
                        {
                            <div class="ta-today-card ta-status-completed">
                                <div class="ta-dealer-top">
                                    <span class="ta-type-pill ta-type-pill-blue"><i class="bi bi-person"></i> Dealer</span>
                                    <span class="ta-type-pill ta-type-pill-today"><i class="bi bi-shop"></i> Retailer</span>
                                </div>

                                <h4 class="ta-dealer-name">@assignment.DealerName</h4>

                                <div class="ta-dealer-code-row">
                                    <i class="bi bi-person"></i> Dealer Code <strong>@assignment.DealerCode</strong>
                                    <button type="button" class="ta-copy-btn" title="Copy dealer code" @onclick='() => CopyCode(assignment.DealerCode)' @onclick:stopPropagation="true">
                                        <i class="bi bi-copy"></i>
                                    </button>
                                </div>

                                <div class="ta-dealer-info-row">
                                    <span>iFMS ID</span>
                                    <strong>@(Dealers.FirstOrDefault(x => x.Id == assignment.DealerId)?.IfmsId ?? "—")</strong>
                                </div>
                                <div class="ta-dealer-info-row">
                                    <span>PoS Liquidation</span>
                                    <strong>@(Dealers.FirstOrDefault(x => x.Id == assignment.DealerId)?.PosLiquidation ?? "—")</strong>
                                </div>

                                <div class="ta-dealer-stats-row ta-dealer-stats-row-single">
                                    <div class="ta-mini-stat ta-mini-stat-pending">
                                        <div class="ta-mini-stat-label"><i class="bi bi-clipboard-check"></i> Pending Ack.</div>
                                        <div class="ta-mini-stat-val">@(Dealers.FirstOrDefault(x => x.Id == assignment.DealerId)?.PendingAckMt?.ToString() ?? "—")</div>
                                    </div>
                                </div>

                                <button type="button" class="ta-start-btn" @onclick='() => Navigation.NavigateTo($"/TaskDetail?type=dealer&id=dealer_{assignment.DealerId}")'>
                                    @ActionLabel(AllocTaskStatus.Completed) <i class="bi bi-arrow-right"></i>
                                </button>
                            </div>
                        }
                    }

                    @foreach (var program in todayAllocation.Programs)
                    {
                        var pStatus = GetStatus($"prog_{program.Csr1Id}");
                        if (pStatus == AllocTaskStatus.Completed)
                        {
                            <div class="ta-today-card ta-status-completed">
                                <div class="ta-dealer-top">
                                    <span class="ta-type-pill ta-type-pill-purple"><i class="bi bi-easel"></i> MD Program</span>
                                    <span class="ta-type-pill ta-type-pill-outline"><i class="bi bi-people"></i> Training</span>
                                </div>

                                <h4 class="ta-dealer-name ta-program-name">@program.ProgramName</h4>

                                <div class="ta-dealer-code-row">
                                    <i class="bi bi-file-earmark-text"></i> Sanction No. <strong>@FormatProgramSanctionNo(program)</strong>
                                </div>

                                <div class="ta-dealer-info-row">
                                    <span><i class="bi bi-calendar3"></i> Sanction Date</span>
                                    <strong>@FormatProgramSanctionDate(program)</strong>
                                </div>

                                <div class="ta-dealer-stats-row">
                                    <div class="ta-mini-stat ta-mini-stat-programs">
                                        <div class="ta-mini-stat-label"><i class="bi bi-file-earmark-text"></i> Programs</div>
                                        <div class="ta-mini-stat-val">1 <span>Program</span></div>
                                    </div>
                                    <div class="ta-mini-stat ta-mini-stat-budget">
                                        <div class="ta-mini-stat-label"><i class="bi bi-bullseye"></i> Total Budget</div>
                                        <div class="ta-mini-stat-val">@(program.Budget > 0 ? (program.Budget % 1 == 0 ? $"₹{program.Budget:N0}" : $"₹{program.Budget:N2}") : "—")</div>
                                    </div>
                                </div>

                                <button type="button" class="ta-start-btn" @onclick='() => Navigation.NavigateTo($"/TaskDetail?type=mdprogram&id=prog_{program.Csr1Id}")'>
                                    @ActionLabel(AllocTaskStatus.Completed) <i class="bi bi-arrow-right"></i>
                                </button>
                            </div>
                        }
                    }

                    @{ var spcmStatus = GetStatus("spcm"); }
                    @if (todayAllocation.SpcmTarget is > 0 && spcmStatus == AllocTaskStatus.Completed)
                    {
                        <div class="ta-today-card ta-today-card-narrow ta-status-completed">
                            <span class="ta-type-pill ta-type-pill-teal"><i class="bi bi-bullseye"></i> SPCM</span>

                            <div class="ta-today-target-box">
                                <span class="ta-today-target-icon"><i class="bi bi-bullseye"></i></span>
                                <div>
                                    <div class="ta-target-label">Today's Target</div>
                                    <div class="ta-today-target-val">@todayAllocation.SpcmTarget</div>
                                </div>
                            </div>

                            <button type="button" class="ta-start-btn" @onclick='() => Navigation.NavigateTo("/TaskDetail?type=spcm")'>
                                @ActionLabel(AllocTaskStatus.Completed) <i class="bi bi-arrow-right"></i>
                            </button>
                        </div>
                    }

                    @{ var soilStatus = GetStatus("soil"); }
                    @if (todayAllocation.SoilSampleTarget is > 0 && soilStatus == AllocTaskStatus.Completed)
                    {
                        <div class="ta-today-card ta-today-card-narrow ta-status-completed">
                            <span class="ta-type-pill ta-type-pill-orange"><i class="bi bi-moisture"></i> Soil Sample</span>

                            <div class="ta-today-target-box">
                                <span class="ta-today-target-icon"><i class="bi bi-eyedropper"></i></span>
                                <div>
                                    <div class="ta-target-label">Today's Target</div>
                                    <div class="ta-today-target-val">@todayAllocation.SoilSampleTarget</div>
                                </div>
                            </div>

                            <button type="button" class="ta-start-btn" @onclick="ViewDetailsNotAvailable">
                                @ActionLabel(AllocTaskStatus.Completed) <i class="bi bi-arrow-right"></i>
                            </button>
                        </div>
                    }

                    @{ var posStatus = GetStatus("pos"); }
                    @if ((todayAllocation.UreaTarget > 0 || todayAllocation.NpsTarget > 0 || todayAllocation.DapTarget > 0 || todayAllocation.OthersTarget > 0) && posStatus == AllocTaskStatus.Completed)
                    {
                        <div class="ta-today-card ta-today-card-wide ta-status-completed">
                            <span class="ta-type-pill ta-type-pill-grey"><i class="bi bi-box-seam"></i> PoS Liquidation</span>

                            <div class="ta-today-products-label"><i class="bi bi-clipboard-check"></i> Products to liquidate</div>
                            <div class="ta-today-products-row">
                                @if (todayAllocation.UreaTarget > 0)
                                {
                                    <div class="ta-today-product-tile">
                                        <div class="ta-today-product-name">UREA</div>
                                        <div class="ta-today-product-val">@todayAllocation.UreaTarget</div>
                                    </div>
                                }
                                @if (todayAllocation.NpsTarget > 0)
                                {
                                    <div class="ta-today-product-tile">
                                        <div class="ta-today-product-name">NSP</div>
                                        <div class="ta-today-product-val">@todayAllocation.NpsTarget</div>
                                    </div>
                                }
                                @if (todayAllocation.DapTarget > 0)
                                {
                                    <div class="ta-today-product-tile">
                                        <div class="ta-today-product-name">DAP</div>
                                        <div class="ta-today-product-val">@todayAllocation.DapTarget</div>
                                    </div>
                                }
                                @if (todayAllocation.OthersTarget > 0)
                                {
                                    <div class="ta-today-product-tile">
                                        <div class="ta-today-product-name">OTHER</div>
                                        <div class="ta-today-product-val">@todayAllocation.OthersTarget</div>
                                    </div>
                                }
                            </div>

                            <button type="button" class="ta-start-btn" @onclick='() => Navigation.NavigateTo("/TaskDetail?type=posliquidation")'>
                                @ActionLabel(AllocTaskStatus.Completed) <i class="bi bi-arrow-right"></i>
                            </button>
                        </div>
                    }
                </div>
            }
        }
    </div>

</div>

@code {
    private enum TaTab { All, Today, Completed }

    // Lets links like /TasksAllocation?tab=today (used by TaskDetail's
    // "Back to Tasks") land on the right tab instead of always resetting to
    // "All Allocations" - navigating here creates a fresh component
    // instance, so currentTab's default wouldn't otherwise remember it.
    [SupplyParameterFromQuery(Name = "tab")]
    public string? TabQuery { get; set; }

    private TaTab currentTab = TaTab.All;

    protected override void OnInitialized()
    {
        currentTab = TabQuery?.ToLowerInvariant() switch
        {
            "today" => TaTab.Today,
            "completed" => TaTab.Completed,
            _ => TaTab.All
        };
    }

    protected override async Task OnParametersSetAsync()
    {
        var targetTab = TabQuery?.ToLowerInvariant() switch
        {
            "today" => TaTab.Today,
            "completed" => TaTab.Completed,
            _ => (TaTab?)null
        };

        if (targetTab.HasValue && targetTab.Value != currentTab)
        {
            currentTab = targetTab.Value;
        }

        if (todayAllocation != null)
        {
            await CheckExistingAllocationAsync();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(
            LoadDealersAsync(),
            LoadProgramsAsync(),
            LookupCache.EnsureLoadedAsync(),
            CheckExistingAllocationAsync());
    }

    private string HeaderSubtitle => currentTab switch
    {
        TaTab.Today => "Pick your dealer tasks and set today's targets, then track them through to completion.",
        _ => "Everything assigned to you, what's approved for today, and what you've finished."
    };

    // Static placeholder flow: no Allocation API exists yet, so submitting
    // just flips the "All Allocations" tab from the wizard to the
    // awaiting-approval card (see TasksAllocation's original notes on the
    // pending-approval design for why that card has no live data either).
    private bool isAllocationSubmitted;
    private JmdoTaskAllocationResponseDto? todayAllocation;

    // ---------- Today's Allocation tab ----------
    // The 5 task kinds shown here (dealer visits, MD programs, SPCM/Soil/PoS
    // targets) are the ones actually picked/targeted in the wizard above -
    // their Start/Stop progress is real, persisted on the backend (per-dealer
    // and per-program Status columns, plus Spcm/SoilSample/PosLiquidation
    // Status on the allocation header), not just a filter label.
    private AllocTaskStatus todayFilter = AllocTaskStatus.YetToStart;
    private bool todayStepperCollapsed;

    private sealed record TodayFilter(int Number, string Label, AllocTaskStatus Status);

    private static readonly List<TodayFilter> TodayFilters = new()
    {
        new(1, "Yet to Start", AllocTaskStatus.YetToStart),
        new(2, "In Progress", AllocTaskStatus.InProgress),
        new(3, "Completed", AllocTaskStatus.Completed)
    };

    // Parses the same "dealer_{id}" / "prog_{id}" / "spcm" / "soil" / "pos" key
    // convention TaskDetail.razor builds for itself, reading status straight off
    // the currently-loaded allocation instead of a shared in-memory dictionary.
    private AllocTaskStatus GetStatus(string taskId)
    {
        if (todayAllocation is null) return AllocTaskStatus.YetToStart;

        if (taskId.StartsWith("dealer_", StringComparison.Ordinal)
            && int.TryParse(taskId.AsSpan("dealer_".Length), out var dealerId))
        {
            return todayAllocation.DealerAssignments.FirstOrDefault(d => d.DealerId == dealerId)?.Status ?? AllocTaskStatus.YetToStart;
        }

        if (taskId.StartsWith("prog_", StringComparison.Ordinal)
            && int.TryParse(taskId.AsSpan("prog_".Length), out var csr1Id))
        {
            return todayAllocation.Programs.FirstOrDefault(p => p.Csr1Id == csr1Id)?.Status ?? AllocTaskStatus.YetToStart;
        }

        return taskId switch
        {
            "spcm" => todayAllocation.SpcmStatus,
            "soil" or "soilsample" => todayAllocation.SoilSampleStatus,
            "pos" or "posliquidation" => todayAllocation.PosLiquidationStatus,
            _ => AllocTaskStatus.YetToStart
        };
    }

    // Soil Sample has no TaskDetail-style page of its own - its Start button goes straight to
    // the SAS Sample Collection wizard - so unlike Dealer/SPCM/MD Program/PoS (which only flip
    // to InProgress once the user presses "Start Task" inside TaskDetail), this is the only place
    // that can mark it InProgress at all. Safe to call every time the button is pressed: the
    // server only stamps SoilSampleStartedAt the first time (never overwritten), and this card
    // only renders for YetToStart/InProgress status, never Completed.
    private async Task StartSoilSampleTask()
    {
        try
        {
            await Http.PutAsJsonAsync("api/JmdoTaskAllocation/mine/task-status",
                new UpdateTaskStatusDto { TaskKey = "soil", Status = AllocTaskStatus.InProgress });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Could not mark Soil Sample task in-progress: {ex.Message}");
        }

        Navigation.NavigateTo("/SampleCollection/new");
    }

    private int CountByStatus(AllocTaskStatus status)
    {
        if (todayAllocation is null) return 0;
        int count = 0;
        foreach (var d in todayAllocation.DealerAssignments.Where(x => x.Day == DateTime.Today.DayOfWeek))
            if (GetStatus($"dealer_{d.DealerId}") == status) count++;
        foreach (var p in todayAllocation.Programs)
            if (GetStatus($"prog_{p.Csr1Id}") == status) count++;
        if (todayAllocation.SpcmTarget is > 0 && GetStatus("spcm") == status) count++;
        if (todayAllocation.SoilSampleTarget is > 0 && GetStatus("soil") == status) count++;
        if ((todayAllocation.UreaTarget > 0 || todayAllocation.NpsTarget > 0 || todayAllocation.DapTarget > 0 || todayAllocation.OthersTarget > 0) && GetStatus("pos") == status) count++;
        return count;
    }

    // The sidebar notification badges are the static 1 / 2 / 1 from the
    // Figma design, not a live count of the 5 example cards above (those
    // numbers don't correspond to this placeholder set - they represent
    // other tasks not shown here). CountByStatus stays live since it drives
    // which cards are actually visible under each filter.
    private int BadgeCount(AllocTaskStatus status) => CountByStatus(status);

    private string EmptyTodayTitle => todayFilter switch
    {
        AllocTaskStatus.YetToStart => "Nothing left to start",
        AllocTaskStatus.InProgress => "Nothing in progress right now",
        _ => "Nothing completed yet"
    };

    // Card theme + button label follow the task's own status, not just
    // whichever filter is currently selected (though in practice a card
    // only renders while its status matches the active filter anyway).
    private static string StatusCardClass(AllocTaskStatus status) => status switch
    {
        AllocTaskStatus.InProgress => "ta-status-inprogress",
        AllocTaskStatus.Completed => "ta-status-completed",
        _ => ""
    };

    private static string ActionLabel(AllocTaskStatus status) => status switch
    {
        AllocTaskStatus.InProgress => "Continue",
        AllocTaskStatus.Completed => "View Details",
        _ => "Start"
    };

    // The floating shortcut button jumps to whichever status comes after the
    // one currently being viewed (Yet to Start -> In Progress -> Completed),
    // and only shows if that status actually has something in it.
    private AllocTaskStatus? NextStatus => todayFilter switch
    {
        AllocTaskStatus.YetToStart => AllocTaskStatus.InProgress,
        AllocTaskStatus.InProgress => AllocTaskStatus.Completed,
        _ => null
    };

    // MD Program / Soil Sample / PoS Liquidation don't have a dedicated detail
    // page yet (only Dealer and SPCM do, via TaskDetail) - same placeholder
    // pattern as TaskDetail's own "not built yet" quick actions.
    private void ViewDetailsNotAvailable() => Toast.Info("Detailed view for this task type isn't built yet.");

    private int currentStep = 1;
    private bool stepperCollapsed;

    // Resolved from the signed-in user's own HQ via the same Headquarters
    // lookup-by-id (LocationItemDto carries both the HQ and its Region name
    // on one row) already used elsewhere in the app - falls back to the old
    // placeholder strings if the HQ isn't found yet (still loading, or the
    // user has no HQ claim), so the UI never goes blank.
    private string FieldExecRegion =>
        LookupCache.Headquarters.FirstOrDefault(h => h.Id == LoginState.HQId)?.RegionName is { Length: > 0 } region
            ? region.ToUpperInvariant()
            : "COIMBATORE";

    private const string FieldExecMoHq = "-";

    private string FieldExecJmdoHq =>
        LookupCache.Headquarters.FirstOrDefault(h => h.Id == LoginState.HQId)?.HeadquarterName is { Length: > 0 } hq
            ? hq.ToUpperInvariant()
            : "COIMBATORE";

    private string spcmTarget = "";
    private string soilTarget = "";
    private string ureaTarget = "";
    private string dapTarget = "";
    private string npsTarget = "";
    private string othersTarget = "";

    private sealed record WizardStep(int Number, string Label);

    private static readonly List<WizardStep> Steps = new()
    {
        new(1, "Dealer"),
        new(2, "SPCM"),
        new(3, "Soil Sample"),
        new(4, "MD Program"),
        new(5, "PoS liquidation")
    };

    private void GoToStep(int step)
    {
        if (step < 1 || step > Steps.Count) return;
        currentStep = step;
    }

    private void ToggleStepper() => stepperCollapsed = !stepperCollapsed;

    private string submittedSummary = "";
    private bool isSubmittingAllocation;

    private static int? ParseTargetOrNull(string value) => int.TryParse(value, out var n) ? n : null;

    private async Task SubmitAllocationAsync()
    {
        if (isSubmittingAllocation) return;
        isSubmittingAllocation = true;

        try
        {
            var dto = new JmdoTaskAllocationCreateDto
            {
                DealerAssignments = selectionsByDay
                    .SelectMany(kvp => kvp.Value.Select(dealerId => new JmdoDealerDayAssignmentDto { DealerId = dealerId, Day = kvp.Key }))
                    .ToList(),
                SpcmTarget = ParseTargetOrNull(spcmTarget),
                SoilSampleTarget = ParseTargetOrNull(soilTarget),
                ProgramIds = SelectedPrograms.Select(p => p.Id).ToList(),
                UreaTarget = ParseTargetOrNull(ureaTarget),
                DapTarget = ParseTargetOrNull(dapTarget),
                NpsTarget = ParseTargetOrNull(npsTarget),
                OthersTarget = ParseTargetOrNull(othersTarget)
            };

            var response = await Http.PostAsJsonAsync("api/JmdoTaskAllocation", dto);
            if (!response.IsSuccessStatusCode)
            {
                Toast.Error("Could not submit the allocation. Please try again.");
                return;
            }

            var saved = await response.Content.ReadFromJsonAsync<JmdoTaskAllocationResponseDto>();
            submittedSummary = BuildSubmittedSummary(saved);

            isAllocationSubmitted = true;
            currentStep = 1;
            Toast.Success("Allocation submitted for MDO approval.");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Allocation submit failed: {ex.Message}");
            Toast.Error("Could not submit the allocation. Please try again.");
        }
        finally
        {
            isSubmittingAllocation = false;
        }
    }

    private static string BuildSubmittedSummary(JmdoTaskAllocationResponseDto? saved) =>
        saved is null
            ? "Allocation submitted."
            : $"{saved.DealerCount} dealer task(s) · SPCM target {saved.SpcmTarget ?? 0} · Soil target {saved.SoilSampleTarget ?? 0} · {saved.ProgramCount} program(s)";

    // Rehydrates "already submitted today" across a page refresh, since the
    // wizard's submitted state would otherwise reset to step 1 every reload.
    private async Task CheckExistingAllocationAsync()
    {
        try
        {
            var response = await Http.GetAsync("api/JmdoTaskAllocation/mine/today");
            if (response.StatusCode == System.Net.HttpStatusCode.NoContent || !response.IsSuccessStatusCode)
                return;

            var existing = await response.Content.ReadFromJsonAsync<JmdoTaskAllocationResponseDto>();
            if (existing is null) return;
            todayAllocation = existing;

            foreach (var assignment in existing.DealerAssignments)
            {
                if (assignment.Day is { } day)
                    selectionsByDay[day].Add(assignment.DealerId);
            }

            submittedSummary = BuildSubmittedSummary(existing);
            isAllocationSubmitted = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Checking today's allocation failed: {ex.Message}");
        }
    }

    private async Task CopyCode(string code)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
            Toast.Success($"{code} copied.");
        }
        catch
        {
            // Clipboard API unavailable (e.g. no secure context): nothing to copy to.
        }
    }

    private sealed class DealerOption
    {
        public int Id { get; init; }
        public string Name { get; init; } = "";
        public string DealerCode { get; init; } = "";
        public string? IfmsId { get; init; }
        public string? PosLiquidation { get; init; }
        public int? PendingAckMt { get; init; }
        public string TypeLabel { get; init; } = "Dealer";
        public int? DistrictId { get; init; }
        public string? Taluk { get; init; }
    }

    // Sun-Sat tabs (confirmed with the user: full weekly planning, not just a
    // filter) - DayOfWeek's own numeric order already runs Sunday(0)..Saturday(6).
    private static readonly DayOfWeek[] WeekDays =
    {
        DayOfWeek.Sunday, DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday,
        DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday
    };

    private DateTime GetDateForDay(DayOfWeek day)
    {
        var today = DateTime.Today;
        int diff = day - today.DayOfWeek;
        return today.AddDays(diff);
    }

    private string DayLabel(DayOfWeek day) => $"{day.ToString().Substring(0, 3)}, {GetDateForDay(day):dd MMM}";

    private DayOfWeek selectedDay = DateTime.Today.DayOfWeek;

    // One independent dealer-id set per weekday - a dealer can be picked for
    // more than one day, and switching tabs must not lose another day's picks.
    private readonly Dictionary<DayOfWeek, HashSet<int>> selectionsByDay =
        WeekDays.ToDictionary(d => d, _ => new HashSet<int>());

    private string dealerSearch = "";
    private bool isLoadingDealers = true;
    private bool dealersLoadFailed;

    private readonly List<DealerOption> Dealers = new();

    // Real dealer list, scoped to the signed-in JMDO/MDO/MO's HQ (falling
    // back to region/state) - same endpoint and scope-derivation pattern as
    // SubDealerList.razor's ApplyLoggedInRoleScope/LoadListAsync.
    private async Task LoadDealersAsync()
    {
        isLoadingDealers = true;
        dealersLoadFailed = false;

        try
        {
            // GetList's `status` query param binds to SubDealerRegistrationController's own
            // int? SubDealerStatus, not the string "Active" - see SubDealerRegistrationController.cs.
            var query = new List<string> { "page=1", "pageSize=100", $"status={(int)SubDealerStatus.Active}" };

            if (LoginState.HQId > 0) query.Add($"hqId={LoginState.HQId}");
            else if (LoginState.RegionId > 0) query.Add($"regionId={LoginState.RegionId}");
            else if (LoginState.StateId > 0) query.Add($"stateId={LoginState.StateId}");

            var url = "api/SubDealerRegistration/list?" + string.Join("&", query);
            var result = await Http.GetFromJsonAsync<SubDealerPagedListResponse>(url);

            Dealers.Clear();
            Dealers.AddRange((result?.Items ?? new()).Select(item => new DealerOption
            {
                Id = item.Id,
                Name = item.FirmName,
                DealerCode = item.SubDealerCode,
                // SubDealerRegistration carries both a wholesale and a
                // retail mFMS id slot per dealer, but never both at once
                // in practice - whichever is populated is this dealer's
                // real type (replaces the old generic "Dealer" badge).
                TypeLabel = !string.IsNullOrWhiteSpace(item.WholesaleMFMSId) ? "Wholesaler"
                    : !string.IsNullOrWhiteSpace(item.RetailMFMSId) ? "Retailer"
                    : "Dealer",
                DistrictId = item.DistrictId,
                Taluk = item.Taluk
                // IfmsId/PosLiquidation/PendingAckMt stay null ("—"):
                // SubDealerRegistration, the Pending Ack./LiquidationCycle
                // dealer records, and IfmsDealer are three separate identity
                // systems with no shared code or FK between them (confirmed
                // by tracing PendingAckService/LiquidationCycleService/
                // IfmsDealer) - there's no real join to fetch these from.
            }));
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Dealer list load failed: {ex.Message}");
            Toast.Error("Could not load the dealer list. Please try again.");
            dealersLoadFailed = true;
        }
        finally
        {
            isLoadingDealers = false;
        }
    }

    // 0 / "" mean "no filter" - same sentinel convention AllocationRequestReview.razor's own
    // dealer-picker dropdown already uses, rather than nullable int/string binds.
    private int selectedDistrictFilter = 0;
    private string selectedTalukFilter = "";
    private int selectedDealerFilter = 0;

    private IEnumerable<DealerOption> DistrictFilteredDealers =>
        selectedDistrictFilter > 0 ? Dealers.Where(d => d.DistrictId == selectedDistrictFilter) : Dealers;

    private IEnumerable<DealerOption> DistrictAndTalukFilteredDealers =>
        string.IsNullOrWhiteSpace(selectedTalukFilter)
            ? DistrictFilteredDealers
            : DistrictFilteredDealers.Where(d => string.Equals(d.Taluk, selectedTalukFilter, StringComparison.OrdinalIgnoreCase));

    // Only districts/taluks that actually have a dealer in them - an empty dropdown entry that
    // filters to nothing would be worse than not offering it at all.
    private IEnumerable<LocationItemDto> AvailableDistrictFilters =>
        LookupCache.Districts
            .Where(dist => Dealers.Any(d => d.DistrictId == dist.Id))
            .OrderBy(dist => dist.DistrictName);

    private IEnumerable<string> AvailableTalukFilters =>
        DistrictFilteredDealers
            .Select(d => d.Taluk)
            .Where(t => !string.IsNullOrWhiteSpace(t))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(t => t);

    private IEnumerable<DealerOption> AvailableDealerFilters =>
        DistrictAndTalukFilteredDealers.OrderBy(d => d.Name);

    private void OnDistrictFilterChanged()
    {
        // Narrowing the district can orphan whatever was picked in the two dependent filters.
        selectedTalukFilter = "";
        selectedDealerFilter = 0;
    }

    private void OnTalukFilterChanged() => selectedDealerFilter = 0;

    private IEnumerable<DealerOption> FilteredDealers =>
        DistrictAndTalukFilteredDealers
            .Where(d => selectedDealerFilter == 0 || d.Id == selectedDealerFilter)
            .Where(d => string.IsNullOrWhiteSpace(dealerSearch) ||
                d.Name.Contains(dealerSearch, StringComparison.OrdinalIgnoreCase) ||
                d.DealerCode.Contains(dealerSearch, StringComparison.OrdinalIgnoreCase));

    private bool IsDealerSelected(DealerOption dealer) => selectionsByDay[selectedDay].Contains(dealer.Id);

    private IEnumerable<DealerOption> SelectedDealersFor(DayOfWeek day) =>
        Dealers.Where(d => selectionsByDay[day].Contains(d.Id));

    private void ToggleDealer(DealerOption dealer)
    {
        var set = selectionsByDay[selectedDay];
        if (!set.Add(dealer.Id))
            set.Remove(dealer.Id);
    }

    private sealed class ProgramOption
    {
        public int Id { get; init; }
        public string Title { get; init; } = "";
        public string? SanctionNo { get; init; }
        public string? SanctionDate { get; init; }
        public int ProgramCount { get; init; }
        public string TotalBudget { get; init; } = "";
        public string TypeLabel { get; init; } = "";
        // CSR1 has no MDO-assigned schedule date - CreatedAt (when the
        // program record was entered) is the only date available, so the
        // weekday badge is derived from that.
        public DateTime CreatedAt { get; init; }
    }

    private bool isLoadingPrograms = true;
    private bool programsLoadFailed;

    private readonly List<ProgramOption> Programs = new();

    // MD programs are assigned directly on the CSR1 record (ResponsiblePersonId), not something
    // the JMDO picks for themselves - api/CSR1/list?mine=true scopes the result server-side to
    // only the CSR1 rows where the signed-in JMDO IS the responsible person, so every program
    // returned here is automatically part of this week's submission.
    private async Task LoadProgramsAsync()
    {
        isLoadingPrograms = true;
        programsLoadFailed = false;

        try
        {
            var result = await Http.GetFromJsonAsync<List<CSR1ListDto>>("api/CSR1/list?mine=true");

            Programs.Clear();
            Programs.AddRange((result ?? new())
                .Where(p => p.IsActive)
                .Select(p => new ProgramOption
                {
                    Id = p.Id,
                    Title = p.ProgramName,
                    SanctionNo = !string.IsNullOrWhiteSpace(p.SanctionNo) ? p.SanctionNo : $"MD-{p.Id}",
                    SanctionDate = p.CSR1Date != default && p.CSR1Date != DateTime.MinValue
                        ? p.CSR1Date.ToString("dd MMM yyyy")
                        : (p.CreatedAt != default ? p.CreatedAt.ToString("dd MMM yyyy") : "—"),
                    ProgramCount = p.NumberOfPrograms,
                    TotalBudget = p.Budget > 0 ? (p.Budget % 1 == 0 ? $"₹{p.Budget:N0}" : $"₹{p.Budget:N2}") : "—",
                    TypeLabel = string.IsNullOrWhiteSpace(p.ProgramType) ? "Training" : p.ProgramType,
                    CreatedAt = p.CreatedAt
                }));
        }
        catch (Exception ex)
        {
            Console.WriteLine($"MD program list load failed: {ex.Message}");
            Toast.Error("Could not load the MD program list. Please try again.");
            programsLoadFailed = true;
        }
        finally
        {
            isLoadingPrograms = false;
        }
    }

    // Every loaded program is already assigned to this JMDO (see LoadProgramsAsync) - there is no
    // separate "selected" subset anymore, this just names the full list for the submit/summary code
    // below so that logic didn't need to change.
    private IEnumerable<ProgramOption> SelectedPrograms => Programs;

    private string FormatProgramSanctionNo(JmdoAllocationProgramRowDto program)
    {
        if (!string.IsNullOrWhiteSpace(program.SanctionNo))
            return program.SanctionNo;

        var opt = Programs.FirstOrDefault(p => p.Id == program.Csr1Id);
        if (!string.IsNullOrWhiteSpace(opt?.SanctionNo))
            return opt.SanctionNo;

        return $"MD-{program.Csr1Id}";
    }

    private string FormatProgramSanctionDate(JmdoAllocationProgramRowDto program)
    {
        if (program.SanctionDate.HasValue && program.SanctionDate.Value != default && program.SanctionDate.Value != DateTime.MinValue)
            return program.SanctionDate.Value.ToString("dd MMM yyyy");

        var opt = Programs.FirstOrDefault(p => p.Id == program.Csr1Id);
        if (!string.IsNullOrWhiteSpace(opt?.SanctionDate) && opt.SanctionDate != "—")
            return opt.SanctionDate;

        return "—";
    }
}
