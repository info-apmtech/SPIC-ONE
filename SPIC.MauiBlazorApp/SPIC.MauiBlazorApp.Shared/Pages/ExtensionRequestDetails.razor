@page "/ExtensionRequestDetails"
@using System.Net.Http.Json
@using System.Globalization
@using SPIC.Core.DTOs
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Extension Request Details · SPIC ONE</PageTitle>

<div class="container-fluid py-4 px-0">
    <div class="erd-wrapper">

        @if (IsLoading)
        {
            <div class="erd-card erd-missing"><p>Loading extension request details...</p></div>
        }
        else if (Request is null)
        {
            <div class="erd-card erd-missing">
                <h3 class="erd-card-title">Request not found</h3>
                <p>@(LoadError ?? "The extension request you are looking for does not exist or is no longer available.")</p>
                <button type="button" class="erd-btn erd-btn-primary" @onclick="BackToList">Back to Request List</button>
            </div>
        }
        else if (ShowApprovedScreen && Request is not null && Request.Status.Equals("Approved", StringComparison.OrdinalIgnoreCase))
        {
            <!-- Render only after the API has confirmed and persisted approval. -->
            <div class="erd-success erd-approval-confirmation">
                <span class="erd-success-icon">
                    <SalesAuditIcon Name="badge-check" Size="34" StrokeWidth="1.8" />
                </span>
                <h2>Extension Approved Successfully</h2>
                <p>The extension request has been approved and the scheme period has been updated.</p>

                <dl class="erd-success-summary">
                    <div class="erd-success-cell">
                        <dt>Request ID</dt>
                        <dd class="erd-green">@Request.Id</dd>
                    </div>
                    <div class="erd-success-cell">
                        <dt>Approved By</dt>
                        <dd>@(string.IsNullOrWhiteSpace(Request.ApprovedBy) ? "Not recorded" : Request.ApprovedBy)</dd>
                    </div>
                    <div class="erd-success-cell">
                        <dt>New End Date &amp; Period</dt>
                        <dd>@Request.NewEndDate.ToString("dd MMM yyyy") <span class="erd-length">(@ExtensionLength)</span></dd>
                    </div>
                    <div class="erd-success-cell">
                        <dt>Approved On</dt>
                        <dd>@(Request.ApprovedDate?.ToString("dd MMM yyyy, hh:mm tt") ?? "Not recorded")</dd>
                    </div>
                    <div class="erd-success-remarks">
                        <dt>Remarks</dt>
                        <dd>@(string.IsNullOrWhiteSpace(Request.Remarks) ? "No remarks provided" : Request.Remarks)</dd>
                    </div>
                </dl>

                <button type="button" class="erd-btn erd-btn-primary erd-success-btn" @onclick="BackToList">
                    View Request Details
                    <SalesAuditIcon Name="arrow-right" Size="16" />
                </button>
            </div>
        }
        else if (ShowRejectedScreen && Request is not null && Request.Status.Equals("Rejected", StringComparison.OrdinalIgnoreCase))
        {
            <!-- Rejection confirmation: shown only after the API and GET confirm persisted status. -->
            <div class="erd-success erd-rejection-confirmation">
                <span class="erd-success-icon">
                    <SalesAuditIcon Name="x-circle" Size="34" StrokeWidth="1.8" />
                </span>
                <h2>Extension Rejected Successfully</h2>
                <p>The extension request has been rejected. The Sales Audit scheme end date remains unchanged.</p>

                <dl class="erd-success-summary">
                    <div class="erd-success-cell">
                        <dt>Request ID</dt>
                        <dd>@Request.Id</dd>
                    </div>
                    <div class="erd-success-cell">
                        <dt>Rejected By</dt>
                        <dd>@(string.IsNullOrWhiteSpace(Request.RejectedBy) ? "Not recorded" : Request.RejectedBy)</dd>
                    </div>
                    <div class="erd-success-cell">
                        <dt>Rejected On</dt>
                        <dd>@(Request.RejectedDate?.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt") ?? "Not recorded")</dd>
                    </div>
                    <div class="erd-success-cell">
                        <dt>Status</dt>
                        <dd class="erd-red">Rejected</dd>
                    </div>
                    <div class="erd-success-cell">
                        <dt>Original End Date</dt>
                        <dd>@Request.PreviousEndDate.ToString("dd MMM yyyy")</dd>
                    </div>
                    <div class="erd-success-cell">
                        <dt>Requested End Date</dt>
                        <dd>@Request.NewEndDate.ToString("dd MMM yyyy") <span class="erd-length">(@ExtensionLength)</span></dd>
                    </div>
                    <div class="erd-success-cell">
                        <dt>Request Submitted On</dt>
                        <dd>@Request.RequestedOn.ToString("dd MMM yyyy, hh:mm tt")</dd>
                    </div>
                    <div class="erd-success-cell">
                        <dt>Reason</dt>
                        <dd>@Request.Reason</dd>
                    </div>
                    <div class="erd-success-remarks">
                        <dt>Remarks</dt>
                        <dd>@(string.IsNullOrWhiteSpace(Request.Remarks) ? "No remarks provided" : Request.Remarks)</dd>
                    </div>
                </dl>

                <button type="button" class="erd-btn erd-btn-primary erd-success-btn" @onclick="BackToList">
                    View Request Details
                    <SalesAuditIcon Name="arrow-right" Size="16" />
                </button>
            </div>
        }
        else
        {
            <!-- Header -->
            <div class="erd-header">
                <div>
                    <h1>
                        Extension Request Details
                        <span class="erd-state-pill erd-state-@Request.Status.ToLowerInvariant()">@Request.Status</span>
                    </h1>
                    <p>
                        <span>Request ID: @Request.Id</span>
                        <span class="erd-sep"></span>
                        <span>Request On: @Request.RequestedOn.ToString("dd MMM yyyy, hh:mm tt")</span>
                    </p>
                </div>
                <div class="erd-header-actions">
                    <button type="button" class="erd-btn-outline-green" @onclick="BackToList">
                        <SalesAuditIcon Name="arrow-left" Size="15" />
                        Back to Request List
                    </button>
                    <!-- PDF action removed until a real export endpoint is available. -->
                </div>
            </div>

            <!-- Program Information -->
            <div class="erd-card">
                <h3 class="erd-card-title">Program Information</h3>
                <div class="erd-summary">
                    <div class="erd-summary-item">
                        <div class="erd-summary-icon erd-tone-green"><SalesAuditIcon Name="users" Size="22" StrokeWidth="1.6" /></div>
                        <div class="erd-summary-text">
                            <span class="erd-label">Program Type</span>
                            <span class="erd-summary-value">@Request.ProgramName</span>
                        </div>
                    </div>
                    <div class="erd-summary-item">
                        <div class="erd-summary-icon erd-tone-purple"><SalesAuditIcon Name="clipboard" Size="22" StrokeWidth="1.6" /></div>
                        <div class="erd-summary-text">
                            <span class="erd-label">Program Name</span>
                            <span class="erd-summary-value">@Request.ProgramName</span>
                        </div>
                    </div>
                    <div class="erd-summary-item">
                        <div class="erd-summary-icon erd-tone-blue"><SalesAuditIcon Name="stamp" Size="22" StrokeWidth="1.6" /></div>
                        <div class="erd-summary-text">
                            <span class="erd-label">Scheme Period</span>
                            <span class="erd-summary-value">@SchemePeriodText</span>
                        </div>
                    </div>
                    <div class="erd-summary-item">
                        <div class="erd-summary-icon erd-tone-green"><SalesAuditIcon Name="badge-check" Size="22" StrokeWidth="1.6" /></div>
                        <div class="erd-summary-text">
                            <span class="erd-label">Scheme Duration</span>
                            <span class="erd-summary-value erd-green">@(DurationText ?? "Not Set")</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Scheme Performance -->
            <div class="erd-card">
                <h3 class="erd-card-title">Scheme Performance (Till @Request.PreviousEndDate.ToString("dd MMM yyyy"))</h3>
                <div class="erd-kpi-grid">
                    <div class="erd-kpi erd-kpi-purple">
                        <span class="erd-label">Required Turnover (TO)</span>
                        <span class="erd-kpi-value">@Money(Request.RequiredTurnover)</span>
                        <span class="erd-kpi-sub">Minimum target to achieve</span>
                    </div>
                    <div class="erd-kpi erd-kpi-blue">
                        <span class="erd-label">Actual Turnover</span>
                        <span class="erd-kpi-value">@Money(Request.ActualTurnover)</span>
                        <span class="erd-kpi-sub">Captured from Sales Portal</span>
                    </div>
                    <div class="erd-kpi erd-kpi-grey">
                        <span class="erd-label">Achievement %</span>
                        <span class="erd-kpi-value erd-orange">@Pct(Request.AchievementPct)%</span>
                        <span class="erd-kpi-sub">Against required TO</span>
                    </div>
                    <div class="erd-kpi erd-kpi-peach">
                        <span class="erd-label">Remaining to Achieve</span>
                        <span class="erd-kpi-value erd-red">@Money(Math.Max(0m, Request.RequiredTurnover - Request.ActualTurnover))</span>
                        <span class="erd-kpi-sub">To reach required TO</span>
                    </div>
                </div>
            </div>

            <!-- Extension Request -->
            <div class="erd-card">
                <h3 class="erd-card-title">Extension Request</h3>
                <div class="erd-request-grid">
                    <div>
                        <span class="erd-label">Current Scheme Period</span>
                        <span class="erd-request-value">
                            @SchemePeriodText
                            @if (DurationText is not null)
                            {
                                <span class="erd-pill erd-pill-blue">@DurationText</span>
                            }
                        </span>
                    </div>
                    <div>
                        <span class="erd-label">Request New End Date</span>
                        <span class="erd-request-value">
                            @Request.NewEndDate.ToString("dd MMM yyyy")
                            @if (ExtraDays > 0)
                            {
                                <span class="erd-pill erd-pill-purple">+ @ExtensionLength</span>
                            }
                        </span>
                    </div>
                    <div>
                        <span class="erd-label">Requested By</span>
                        <span class="erd-request-value">
                            @Request.RequestedBy

                        </span>
                    </div>
                </div>

                <div class="erd-remarks">
                    <SalesAuditIcon Name="message" Size="18" CssClass="erd-remarks-icon" />
                    <div>
                        <strong>Reason: @Request.Reason</strong>
                        <p>@(string.IsNullOrWhiteSpace(Request.Remarks) ? "No remarks provided" : Request.Remarks)</p>
                    </div>
                </div>
            </div>

            <!-- Real saved SAP dealer sales for the selected CSR2 ID; never fabricated. -->
            <div class="erd-card">
                <h3 class="erd-card-title">Dealer-wise Actual Sales</h3>
                @if (IsSalesLoading)
                {
                    <p>Loading dealer sales...</p>
                }
                else if (!string.IsNullOrWhiteSpace(SalesError))
                {
                    <p role="alert" class="text-danger">@SalesError</p>
                }
                else if (DealerSales.Count == 0)
                {
                    <p>No saved matched dealer sales found for this scheme.</p>
                }
                else
                {
                    <div class="erd-table-wrapper">
                        <table class="erd-table">
                            <thead>
                                <tr>
                                    <th>S:NO</th>
                                    <th>Product</th>
                                    <th>Dealer Name</th>
                                    <th>Dealer Code</th>
                                    <th>Planned Value (₹)</th>
                                    <th>Actual Value (₹)</th>
                                    <th>Achievement (%)</th>
                                    <th>Balance</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var (sale, index) in DealerSales.Select((x, i) => (x, i)))
                                {
                                    <tr>
                                        <td>@(index + 1)</td>
                                        <td>@sale.ProductName</td>
                                        <td>@sale.DealerName</td>
                                        <td>@sale.DealerCode</td>
                                        <td title="No dealer-product planned allocation is supplied by this API">—</td>
                                        <td>@Money(sale.Actual)</td>
                                        <td>—</td>
                                        <td>—</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="5" class="erd-total-label">Saved invoice total</td>
                                    <td class="erd-total-value">@Money(DealerSales.Sum(x => x.Actual))</td>
                                    <td>—</td>
                                    <td>—</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    <p class="mt-2">Planned value, achievement and balance are not shown per product because this API does not supply dealer-product allocations.</p>
                }
            </div>

            <!-- Footer actions -->
            <div class="erd-footer">
                <button type="button" class="erd-btn erd-btn-back" @onclick="BackToList">
                    <SalesAuditIcon Name="chevrons-left" Size="16" />
                    Back to List
                </button>
                @if (Request.Status == "Approved")
                {
                    <span class="erd-pill erd-pill-blue">Approved by @Request.ApprovedBy on @(Request.ApprovedDate?.ToString("dd MMM yyyy") ?? "Not recorded")</span>
                }
                else if (Request.Status.Equals("Rejected", StringComparison.OrdinalIgnoreCase))
                {
                    <span class="erd-pill erd-pill-grey">Rejected by @(string.IsNullOrWhiteSpace(Request.RejectedBy) ? "Not recorded" : Request.RejectedBy) on @(Request.RejectedDate?.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt") ?? "Not recorded")</span>
                }
                else if (Request.Status.Equals("Pending", StringComparison.OrdinalIgnoreCase))
                {
                    <div class="erd-footer-right">
                        <button type="button" class="erd-btn erd-btn-reject"
                                disabled="@IsProcessing" @onclick="RejectRequest">
                            Reject Request
                        </button>
                        <button type="button" class="erd-btn erd-btn-primary"
                                disabled="@IsProcessing" @onclick="ApproveExtension">
                            @(IsProcessing ? "Approving..." : "Approve Extension")
                            <SalesAuditIcon Name="chevrons-right" Size="16" />
                        </button>
                    </div>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(ActionError))
            {
                <p class="text-danger mt-2" role="alert">@ActionError</p>
            }
            @if (!string.IsNullOrWhiteSpace(ActionSuccess))
            {
                <p class="text-success mt-2" role="status">@ActionSuccess</p>
            }
        }

    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "id")] public int? Id { get; set; }
    private ExtensionRequestDetailsDto? Request;
    private bool IsLoading = true;
    private string? LoadError;
    private bool IsProcessing;
    private bool ShowApprovedScreen;
    private bool ShowRejectedScreen;
    private string? ActionError;
    private string? ActionSuccess;
    private bool IsSalesLoading;
    private string? SalesError;
    private List<DealerSalesSummary> DealerSales = new();

    private sealed class MatchedSapSalesResponse
    {
        public List<MatchedSapSaleRow> Rows { get; set; } = new();
    }
    private sealed class MatchedSapSaleRow
    {
        public long SaleId { get; set; }
        public bool IsSaved { get; set; }
        public string DealerCode { get; set; } = "";
        public string DealerName { get; set; } = "";
        public string ProductName { get; set; } = "";
        public decimal GrossAmountRs { get; set; }
    }
    private sealed record DealerSalesSummary(string ProductName, string DealerName,
        string DealerCode, decimal Actual);

    private async Task LoadDealerSalesAsync(int csr2Id)
    {
        IsSalesLoading = true;
        SalesError = null;
        DealerSales.Clear();
        try
        {
            using var response = await Http.GetAsync(
                $"api/SalesAudit/dealer-mapping/sap-sales?csr2Id={csr2Id}");
            if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                SalesError = "The Sales Tracking API denied access to dealer sales for this login. " +
                    "The API's GET permission must be updated using the existing tracking-read authorization.";
                return;
            }
            if (!response.IsSuccessStatusCode)
            {
                SalesError = $"Dealer sales could not be loaded (HTTP {(int)response.StatusCode}).";
                return;
            }
            var sales = await response.Content.ReadFromJsonAsync<MatchedSapSalesResponse>();
            // Only invoice lines already saved to the audit, not unsaved/new SAP candidates.
            DealerSales = (sales?.Rows ?? new()).Where(x => x.IsSaved)
                .GroupBy(x => new { x.DealerCode, x.DealerName, x.ProductName })
                .Select(g => new DealerSalesSummary(g.Key.ProductName, g.Key.DealerName,
                    g.Key.DealerCode, g.Sum(x => x.GrossAmountRs)))
                .OrderBy(x => x.DealerName).ThenBy(x => x.ProductName).ToList();
        }
        catch (Exception ex)
        {
            SalesError = $"Unable to load dealer sales: {ex.Message}";
        }
        finally { IsSalesLoading = false; }
    }

    protected override async Task OnParametersSetAsync()
    {
        Request = null;
        DealerSales.Clear();
        SalesError = null;
        LoadError = null;
        ActionError = null;
        ActionSuccess = null;
        ShowApprovedScreen = false;
        ShowRejectedScreen = false;
        IsLoading = true;
        try
        {
            if (Id is not > 0)
            {
                LoadError = "Select a request from Extension Request List.";
                return;
            }
            using var response = await Http.GetAsync($"api/SalesAudit/extension/requests/{Id.Value}");
            if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
                throw new InvalidOperationException("This extension request was not found in the database.");
            if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
                throw new InvalidOperationException("You do not have permission to view this request.");
            response.EnsureSuccessStatusCode();
            Request = await response.Content.ReadFromJsonAsync<ExtensionRequestDetailsDto>()
                ?? throw new InvalidOperationException("The API returned no request details.");
            await LoadDealerSalesAsync(Request.CSRId);
        }
        catch (Exception ex) { LoadError = ex.Message; }
        finally { IsLoading = false; }
    }

    private async Task RejectRequest()
    {
        if (IsProcessing || Id is not > 0 || Request is null ||
            !string.Equals(Request.Status, "Pending", StringComparison.OrdinalIgnoreCase))
            return;

        IsProcessing = true;
        ActionError = null;
        ActionSuccess = null;
        try
        {
            using var response = await Http.PostAsync(
                $"api/SalesAudit/extension/requests/{Id.Value}/reject", null);
            if (!response.IsSuccessStatusCode)
            {
                var message = response.StatusCode switch
                {
                    System.Net.HttpStatusCode.Forbidden => "You do not have permission to reject extension requests.",
                    System.Net.HttpStatusCode.Conflict => "Only submitted requests may be rejected. Reload the details.",
                    System.Net.HttpStatusCode.NotFound => "This extension request was not found.",
                    _ => $"Rejection failed (HTTP {(int)response.StatusCode})."
                };
                throw new InvalidOperationException(message);
            }

            using var updated = await Http.GetAsync($"api/SalesAudit/extension/requests/{Id.Value}");
            updated.EnsureSuccessStatusCode();
            var refreshed = await updated.Content.ReadFromJsonAsync<ExtensionRequestDetailsDto>()
                ?? throw new InvalidOperationException("Rejection saved but details could not be loaded. Reload the page.");
            Request = refreshed;
            if (!string.Equals(Request.Status, "Rejected", StringComparison.OrdinalIgnoreCase))
                throw new InvalidOperationException("The saved status was not confirmed as Rejected. Reload the page.");
            ShowApprovedScreen = false;
            ShowRejectedScreen = true;
            ActionSuccess = null;
            try { await JS.InvokeVoidAsync("scrollPageToTop"); } catch (JSException) { }
        }
        catch (Exception ex) { ActionError = ex.Message; }
        finally { IsProcessing = false; }
    }

    private async Task ApproveExtension()
    {
        if (IsProcessing || Id is not > 0 || Request is null ||
            !string.Equals(Request.Status, "Pending", StringComparison.OrdinalIgnoreCase))
            return;

        IsProcessing = true;
        ActionError = null;
        ActionSuccess = null;
        try
        {
            using var response = await Http.PostAsync(
                $"api/SalesAudit/extension/requests/{Id.Value}/approve", null);
            if (!response.IsSuccessStatusCode)
            {
                string message = response.StatusCode switch
                {
                    System.Net.HttpStatusCode.Forbidden => "You do not have permission to approve extension requests.",
                    System.Net.HttpStatusCode.Conflict => "This request is already approved or the scheme end date has changed. Reload to review it.",
                    System.Net.HttpStatusCode.NotFound => "The request or linked Sales Audit record was not found.",
                    _ => $"Approval failed (HTTP {(int)response.StatusCode})."
                };
                throw new InvalidOperationException(message);
            }

            // Always use the persisted values returned by the existing GET endpoint.
            using var updated = await Http.GetAsync(
                $"api/SalesAudit/extension/requests/{Id.Value}");
            updated.EnsureSuccessStatusCode();
            Request = await updated.Content.ReadFromJsonAsync<ExtensionRequestDetailsDto>()
                ?? throw new InvalidOperationException("Approval saved, but updated details could not be loaded. Reload the page.");
            if (!string.Equals(Request.Status, "Approved", StringComparison.OrdinalIgnoreCase)
                || Request.ApprovedDate is null
                || string.IsNullOrWhiteSpace(Request.ApprovedBy))
            {
                throw new InvalidOperationException("Approval response was successful, but persisted approval details are incomplete. Reload and verify the request.");
            }
            ShowApprovedScreen = true;
            ShowRejectedScreen = false;
            ActionSuccess = null;
            try { await JS.InvokeVoidAsync("scrollPageToTop"); } catch (JSException) { }
        }
        catch (Exception ex)
        {
            ActionError = ex.Message;
        }
        finally { IsProcessing = false; }
    }
    private void BackToList()
    {
        Nav.NavigateTo("/ExtensionRequests");
    }
    private async Task ViewRequestDetails()
    {
        ShowApprovedScreen = false;
        ShowRejectedScreen = false;
        try { await JS.InvokeVoidAsync("scrollPageToTop"); } catch (JSException) { }
    }

    private static string Money(decimal value) => "₹ " + value.ToString("N2", CultureInfo.GetCultureInfo("en-IN"));
    private int ExtraDays => Request is null ? 0 : Math.Max(0, (Request.NewEndDate.Date - Request.PreviousEndDate.Date).Days);
    private string SchemePeriodText => Request?.SchemeFrom is DateTime start
        ? $"{start:dd MMM yyyy} - {Request.PreviousEndDate:dd MMM yyyy}"
        : Request is null ? "Not Set" : $"End date: {Request.PreviousEndDate:dd MMM yyyy}";
    private string? DurationText
    {
        get
        {
            if (Request?.SchemeFrom is not DateTime from) return null;
            var to = Request.PreviousEndDate;
            var days = (to - from).Days + 1;
            return days > 0 ? $"{days} Days" : null;
        }
    }
    private string ExtensionLength => $"{ExtraDays} Days";
    private static string Pct(decimal value) => value.ToString("0.##", CultureInfo.InvariantCulture);
}

<style>
    /* Shared confirmation layout: approval and rejection use identical geometry. */
    .erd-approval-confirmation, .erd-rejection-confirmation {
        text-align: center;
        padding: 40px 16px 55px;
        min-height: 470px;
    }

        .erd-approval-confirmation .erd-success-icon,
        .erd-rejection-confirmation .erd-success-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            width: 64px;
            height: 64px;
            color: white;
            margin-bottom: 18px;
        }

        .erd-approval-confirmation .erd-success-icon {
            background: #087840;
        }

        .erd-rejection-confirmation .erd-success-icon {
            background: #dc2626;
        }

        .erd-approval-confirmation h2, .erd-rejection-confirmation h2 {
            font-size: 24px;
            font-weight: 700;
            margin: 0 0 10px;
        }

        .erd-approval-confirmation h2 {
            color: #086f3b;
        }

        .erd-rejection-confirmation h2 {
            color: #b91c1c;
        }

        .erd-approval-confirmation > p, .erd-rejection-confirmation > p {
            color: #77848b;
            margin: 0 auto 32px;
        }

        .erd-approval-confirmation .erd-success-summary,
        .erd-rejection-confirmation .erd-success-summary {
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
            text-align: left;
            max-width: 950px;
            margin: 0 auto 36px;
            border: 1px solid #e7ecef;
            background: #fff;
            border-radius: 7px;
            overflow: hidden;
        }

        .erd-approval-confirmation .erd-success-cell,
        .erd-rejection-confirmation .erd-success-cell {
            display: grid;
            grid-template-columns: 42% 58%;
            min-width: 0;
            margin: 0;
            border-bottom: 1px solid #edf0f2;
        }

            .erd-approval-confirmation .erd-success-cell:nth-child(odd),
            .erd-rejection-confirmation .erd-success-cell:nth-child(odd) {
                border-right: 1px solid #edf0f2;
            }

        .erd-approval-confirmation dt, .erd-approval-confirmation dd,
        .erd-rejection-confirmation dt, .erd-rejection-confirmation dd {
            padding: 12px 14px;
            margin: 0;
            overflow-wrap: anywhere;
        }

        .erd-approval-confirmation dt, .erd-rejection-confirmation dt {
            color: #66757b;
            background: #fafbfc;
            font-weight: 500;
        }

        .erd-approval-confirmation dd, .erd-rejection-confirmation dd {
            font-weight: 600;
