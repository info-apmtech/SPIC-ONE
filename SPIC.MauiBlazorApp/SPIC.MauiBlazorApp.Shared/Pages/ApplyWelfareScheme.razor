        catch (Exception)
        {
            _dealer = new SDWADashboardDealerDto();
        }
        finally
        {
            _isLoadingDealer = false;
        }

        // Load sales history
        _isLoadingSalesHistory = true;
        try
        {
            var salesResult = await Http.GetFromJsonAsync<DealerSalesHistoryDto>("api/SDWADashboard/dealer-sales-history");
