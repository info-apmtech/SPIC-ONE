    private record UploadedFileInfo(string Name, string ContentType, long Size, byte[] Data);

    private Dictionary<string, UploadedFileInfo> UploadedFiles { get; set; } = new(StringComparer.OrdinalIgnoreCase);

    private async Task HandleFileUpload(string docName, InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        if (file.Size > 5 * 1024 * 1024)
        {
            return;
        }

        var ext = Path.GetExtension(file.Name).ToLowerInvariant();
        if (ext is not (".pdf" or ".jpg" or ".jpeg" or ".png"))
        {
            return;
        }

        // Buffer the bytes now: IBrowserFile references become invalid once the
        // InputFile element is re-rendered out of the DOM (_blazorFilesById error)
        await using var stream = file.OpenReadStream(maxAllowedSize: 6 * 1024 * 1024);
        using var buffer = new MemoryStream();
        await stream.CopyToAsync(buffer);

        UploadedFiles[docName] = new UploadedFileInfo(file.Name, file.ContentType, file.Size, buffer.ToArray());
        StateHasChanged();
    }

    private void RemoveUploadedFile(string docName)
    {
        UploadedFiles.Remove(docName);
        StateHasChanged();
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }

    private bool IsPreviewModalOpen { get; set; } = false;
    private bool IsSubmitModalOpen { get; set; } = false;
    private bool IsSuccessModalOpen { get; set; } = false;
    private bool ShowValidation { get; set; } = false;
    private List<string> ValidationErrors { get; set; } = new();

    private void OpenPreviewModal()
    {
        // While correcting an existing application, never allow a fresh submission
        // (a new application must NOT be created during resubmission).
        if (ResubmitId.HasValue && !IsResubmissionMode) return;

        ShowValidation = false;
        ValidationErrors.Clear();
        IsPreviewModalOpen = true;
    }

    private void ClosePreviewModal()
    {
        IsPreviewModalOpen = false;
    }

    private void OpenSubmitModal()
    {
        IsPreviewModalOpen = false;
        IsSubmitModalOpen = true;
    }

    private void CloseSubmitModal()
    {
        IsSubmitModalOpen = false;
    }

    private async Task ConfirmSubmission()
    {
        if (_isSubmitting) return;

        var errors = ValidateApplication();
        if (errors.Any())
        {
            ValidationErrors = errors;
            ShowValidation = true;
            IsSubmitModalOpen = false;
            return;
        }

        _isSubmitting = true;
        ShowValidation = false;
        ValidationErrors.Clear();
        StateHasChanged();

        try
        {
            // Resubmission updates the SAME application (same id) and restarts approval at MO;
            // a normal submission creates a new application.
            var url = IsResubmissionMode
                ? $"api/WelfareApplication/resubmit/{ResubmitId.Value}"
                : "api/WelfareApplication/submit";

            var response = await PostApplicationAsync(url, IsResubmissionMode);
            var body = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                SubmittedApplicationNumber = TryGetStringProperty(body, "applicationNumber");
                IsSubmitModalOpen = false;
                IsSuccessModalOpen = true;
            }
            else
            {
                ValidationErrors = new List<string>
                {
                    TryGetStringProperty(body, "message") ?? "Application submission failed. Please try again."
                };
                ShowValidation = true;
                IsSubmitModalOpen = false;
            }
        }
        catch (Exception)
        {
            ValidationErrors = new List<string> { "Could not reach the server. Please check your connection and try again." };
            ShowValidation = true;
            IsSubmitModalOpen = false;
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }

    private async Task SaveAsDraft()
    {
        // Drafts always create a NEW application - not allowed while correcting an existing one
        if (_isSavingDraft || _isSubmitting || ResubmitId.HasValue) return;

        _isSavingDraft = true;
        DraftMessage = string.Empty;
        StateHasChanged();

        try
        {
            var response = await PostApplicationAsync("api/WelfareApplication/draft");
            var body = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                var reference = TryGetStringProperty(body, "applicationNumber");
                DraftMessage = string.IsNullOrWhiteSpace(reference)
                    ? "Draft saved successfully."
                    : $"Draft saved successfully. Reference: {reference}";
                _draftSuccess = true;
            }
            else
            {
                DraftMessage = TryGetStringProperty(body, "message") ?? "Could not save the draft. Please try again.";
                _draftSuccess = false;
            }
        }
        catch (Exception)
        {
            DraftMessage = "Could not reach the server. Please check your connection and try again.";
            _draftSuccess = false;
        }
        finally
        {
            _isSavingDraft = false;
            StateHasChanged();
        }
    }

    private List<string> ValidateApplication()
    {
        var errors = new List<string>();

        if (string.IsNullOrWhiteSpace(QuantityLiftedInput))
            errors.Add("Quantity Lifted during Last Year (MT) is required.");
        else if (!TryGetQuantityLifted(out _))
            errors.Add("Please enter or select a valid Quantity Lifted during Last Year (MT).");

        // Beneficiary Group
        if (string.IsNullOrWhiteSpace(SelectedBeneficiaryGroup))
            errors.Add("Beneficiary Group is required.");

        if (SelectedBeneficiaryGroup == "Sub Dealer")
        {
            if (string.IsNullOrWhiteSpace(SelectedSubDealerId))
                errors.Add("Sub Dealer selection is required.");
            else if (_salesHistory != null && !_salesHistory.IsSubDealerEligible)
                errors.Add("You do not have sufficient sales quantity to apply for a Sub Dealer. A minimum average annual sales of 50,000 MT over the last 3 years is required.");
        }

        if (SelectedBeneficiaryGroup == "Approved Employee")
        {
            if (string.IsNullOrWhiteSpace(SelectedEmployeeId))
                errors.Add("Employee selection is required.");
            else if (_salesHistory != null && !_salesHistory.IsEmployeeEligible)
                errors.Add("You do not have sufficient sales quantity to apply for an Approved Employee. A minimum average annual sales of 5,000 MT over the last 3 years is required.");
        }

        // Nominee
        if (string.IsNullOrWhiteSpace(NomineeName))
            errors.Add("Nominee Name is required.");

        if (string.IsNullOrWhiteSpace(NomineeRelationship))
            errors.Add("Nominee Relationship is required.");

        // Beneficiary
        if (SelectedBeneficiaryGroup == "Direct Dealer" && string.IsNullOrWhiteSpace(SelectedExistingBeneficiary))
            errors.Add("Please select a beneficiary.");

        if (string.IsNullOrWhiteSpace(BeneficiaryName))
            errors.Add("Beneficiary Name is required.");

        var effectiveBeneficiaryRelationship = string.IsNullOrWhiteSpace(BeneficiaryRelationship) ? NomineeRelationship : BeneficiaryRelationship;
        if (string.IsNullOrWhiteSpace(effectiveBeneficiaryRelationship))
            errors.Add("Beneficiary Relationship is required.");

        // Scheme-specific fields
        switch (SelectedScheme)
        {
            case "Wedding":
            case "Sathabhishekam":
            case "Grahapravesam":
                ValidateEventDate(errors);
                if (SelectedScheme == "Grahapravesam" && string.IsNullOrWhiteSpace(OwnershipType))
                    errors.Add("Ownership Type is required.");
                break;

            case "Death Relief":
                if (DeathDateOfDeath == null)
                    errors.Add("Date of Death is required.");
                else if (DeathDateOfDeath.Value.Date > DateTime.Today)
                    errors.Add("Date of Death cannot be in the future.");

                if (string.IsNullOrWhiteSpace(LegalHeirName))
                    errors.Add("Legal Heir Name is required.");

                if (string.IsNullOrWhiteSpace(BeneficiaryRelationship))
                    errors.Add("Relationship to Dealer is required.");

                if (string.IsNullOrWhiteSpace(DeathCause))
                    errors.Add("Cause of Death is required.");
                break;

            case "Medical Assistance":
                if (string.IsNullOrWhiteSpace(MedicalTreatmentType))
                    errors.Add("Treatment / Medical Condition is required.");
                break;

            case "Educational Assistance":
                if (!EduTotalCourses.HasValue || EduTotalCourses.Value <= 0)
                    errors.Add("Total Number of Courses is required.");

                if (string.IsNullOrWhiteSpace(EduCourse))
                    errors.Add("Course is required.");

                if (string.IsNullOrWhiteSpace(EduYear))
                    errors.Add("Year is required.");

                if (string.IsNullOrWhiteSpace(EduCollegeName))
                    errors.Add("College Name is required.");
                break;

            case "Merit Award":
                if (string.IsNullOrWhiteSpace(MeritCandidateName))
                    errors.Add("Candidate Name is required.");

                if (string.IsNullOrWhiteSpace(MeritFatherName))
                    errors.Add("Candidate's Father Name is required.");

                if (string.IsNullOrWhiteSpace(MeritExamination))
                    errors.Add("Examination Appeared is required.");

                if (string.IsNullOrWhiteSpace(MeritBoardName))
                    errors.Add("Board Name is required.");

                if (MeritMaximumMarks <= 0)
                    errors.Add("Maximum Marks must be greater than zero.");

                if (MeritMarksObtained <= 0)
                    errors.Add("Marks Obtained must be greater than zero.");

                if (MeritMaximumMarks > 0 && MeritMarksObtained > MeritMaximumMarks)
                    errors.Add("Marks Obtained cannot exceed Maximum Marks.");

                if (MeritMaximumMarks > 0 && MeritPercentage < 80)
                    errors.Add("Minimum 80% marks is required for the Merit Award.");
                break;

            case "Distinction Award":
                if (string.IsNullOrWhiteSpace(DistinctionCandidateName))
                    errors.Add("Candidate Name is required.");

                if (string.IsNullOrWhiteSpace(DistinctionProfessionalCourse))
                    errors.Add("Professional Course Name is required.");

                if (DistinctionMaximumMarks <= 0)
                    errors.Add("Total / Maximum Marks must be greater than zero.");

                if (DistinctionMarksObtained <= 0)
                    errors.Add("Marks Obtained must be greater than zero.");

                if (DistinctionMaximumMarks > 0 && DistinctionMarksObtained > DistinctionMaximumMarks)
                    errors.Add("Marks Obtained cannot exceed Total / Maximum Marks.");

                if (DistinctionMaximumMarks > 0 && DistinctionAggregatePercentage <= 80)
                    errors.Add("Aggregate percentage must be more than 80% to qualify for the Distinction Award.");

                if (DistinctionHasArrears == true)
                    errors.Add("Candidates with arrears / backlogs are not eligible for the Distinction Award.");
                break;
        }

        // Document validation based on scheme requirements (kept + newly uploaded count)
        foreach (var doc in CurrentDocuments)
        {
            if (IsDocumentRequired(doc.Name) && !HasDocument(doc.Name))
                errors.Add($"{doc.Name} is required.");
        }

        // Declaration
        if (!IsDeclarationConfirmed)
            errors.Add("You must confirm the declaration before submitting.");

        return errors;
    }

    private void ValidateEventDate(List<string> errors)
    {
        if (EventDate == null)
        {
            errors.Add("Event date is required.");
            return;
        }

        if (EventDate.Value.Date < DateTime.Today.AddDays(7))
            errors.Add("Invitation must be sent at least 7 days in advance. Please choose an event date at least 7 days from today.");
    }

    private bool IsDocumentRequired(string docName)
    {
        if (SelectedScheme == "Educational Assistance")
        {
            if (docName == "Admission Certificate (First Year only)")
                return IsEduFirstApplication;
            if (docName == "Marks list of previous year / semesters duly cleared")
                return !IsEduFirstApplication;
            return true;
        }

        if (SelectedScheme == "Death Relief" &&
            (docName.StartsWith("Legal Heir Certificate") || docName == "Affidavit from other legal heirs"))
            return false;

        return true;
    }

