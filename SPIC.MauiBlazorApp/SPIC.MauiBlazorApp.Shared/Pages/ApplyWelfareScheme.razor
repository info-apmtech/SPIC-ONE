}
@code {
    [SupplyParameterFromQuery(Name = "scheme")]
    private string? Scheme { get; set; }

    // Set when the dealer opens a REJECTED application for correction/resubmission
    // (from My Applications). The SAME application is loaded, updated and resubmitted.
    [SupplyParameterFromQuery(Name = "resubmitId")]
    private int? ResubmitId { get; set; }

    private WelfareApplicationDetailDto? _resubmitDetail;
    private string? _resubmitError;

    // Documents already stored on the server for this application (keyed by document type)
    private Dictionary<string, WelfareApplicationDocumentDto> ExistingDocs { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    // Document types the dealer explicitly removed (ids are sent to the server on resubmit)
    private HashSet<string> RemovedExistingDocNames { get; set; } = new(StringComparer.OrdinalIgnoreCase);

    private SDWADashboardDealerDto _dealer = new();
    private bool _isLoadingDealer = true;

    private string? _schemeOverride;
    private string SelectedScheme => _schemeOverride ?? (string.IsNullOrWhiteSpace(Scheme) ? "Grahapravesam" : Uri.UnescapeDataString(Scheme));

    private bool IsResubmissionMode => ResubmitId.HasValue && _resubmitDetail != null;

    // Sales history
    private DealerSalesHistoryDto? _salesHistory;
    private bool _isLoadingSalesHistory = true;

    // Beneficiary group
    private string SelectedBeneficiaryGroup { get; set; } = string.Empty;
    private string BeneficiaryGroupError { get; set; } = string.Empty;

    // Sub Dealer
    private List<SubDealerDto> _subDealers = new();
    private bool _isLoadingSubDealers = false;
    private string SelectedSubDealerId { get; set; } = string.Empty;
    private string SelectedSubDealerName { get; set; } = string.Empty;

    // Employee
    private List<EmployeeDto> _employees = new();
    private bool _isLoadingEmployees = false;
    private string SelectedEmployeeId { get; set; } = string.Empty;
    private string SelectedEmployeeName { get; set; } = string.Empty;

    // Beneficiary fields (all groups)
    private string NomineeName { get; set; } = string.Empty;
    private string NomineeRelationship { get; set; } = string.Empty;
    private string BeneficiaryName { get; set; } = string.Empty;
    private string BeneficiaryRelationship { get; set; } = string.Empty;
    private DateTime? BeneficiaryDateOfBirth { get; set; }
    private string BeneficiaryAge { get; set; } = string.Empty;

    // Scheme-specific: Wedding / Sathabhishekam / Grahapravesam
    private DateTime? EventDate { get; set; }
    private string EventVenue { get; set; } = string.Empty;
    private string OwnershipType { get; set; } = string.Empty;

    // Scheme-specific: Death Relief
    private DateTime? DeathDateOfDeath { get; set; }
    private string LegalHeirName { get; set; } = string.Empty;
    private string DeathCause { get; set; } = string.Empty;

    // Declaration & submission state
    private bool IsDeclarationConfirmed { get; set; }
    private bool _isSubmitting = false;
    private bool _isSavingDraft = false;
    private bool _draftSuccess = false;
    private string DraftMessage { get; set; } = string.Empty;
    private string? SubmittedApplicationNumber { get; set; }

    private void OnDateChanged()
    {
        if (BeneficiaryDateOfBirth.HasValue)
        {
            var today = DateTime.Today;
            var age = today.Year - BeneficiaryDateOfBirth.Value.Year;
            if (BeneficiaryDateOfBirth.Value.Date > today.AddYears(-age)) age--;
            BeneficiaryAge = age > 0 ? age.ToString() : string.Empty;
        }
        else
        {
            BeneficiaryAge = string.Empty;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _isLoadingDealer = true;
        try
        {
            var result = await Http.GetFromJsonAsync<SDWADashboardDealerDto>("api/SDWADashboard/dealer-details");
            if (result != null)
                _dealer = result;
        }
        catch (Exception)
        {
            _dealer = new SDWADashboardDealerDto();
        }
        finally
        {
            _isLoadingDealer = false;
        }

        // Load sales history
        _isLoadingSalesHistory = true;
        try
        {
            var salesResult = await Http.GetFromJsonAsync<DealerSalesHistoryDto>("api/SDWADashboard/dealer-sales-history");
            if (salesResult != null)
            {
                _salesHistory = salesResult;
            }
        }
        catch (Exception)
        {
            _salesHistory = null;
        }
        finally
        {
            _isLoadingSalesHistory = false;
        }

        // Resubmission mode: load the SAME rejected application and pre-fill everything
        if (ResubmitId.HasValue)
        {
            await LoadResubmissionAsync(ResubmitId.Value);
        }
    }

    private async Task LoadResubmissionAsync(int applicationId)
    {
        _resubmitError = null;
        try
        {
            var detail = await Http.GetFromJsonAsync<WelfareApplicationDetailDto>(
                $"api/SDWAWelfareApplication/my-application/{applicationId}");

            if (detail == null)
            {
                _resubmitError = "Application not found.";
                return;
            }

            if (detail.Status != 9) // WelfareApplicationStatus.ReturnedToDealer
            {
                _resubmitError = "This application is not waiting for your resubmission. Only applications returned by MO for correction can be edited here.";
                return;
            }

            _resubmitDetail = detail;
            _schemeOverride = MapSchemeTypeToPageName(detail.SchemeType);

            // ---- Pre-fill all previously saved details (no new application is created) ----
            SelectedBeneficiaryGroup = detail.BeneficiaryGroup ?? string.Empty;
            NomineeName = detail.NomineeName ?? string.Empty;
            NomineeRelationship = detail.NomineeRelationship ?? string.Empty;
            BeneficiaryName = detail.BeneficiaryName ?? string.Empty;
            BeneficiaryRelationship = string.Empty;
            BeneficiaryDateOfBirth = detail.BeneficiaryDateOfBirth;
            OnDateChanged();

            EventDate = detail.EventDate;
            EventVenue = detail.EventVenue ?? string.Empty;
            OwnershipType = detail.OwnershipType ?? string.Empty;

            DeathDateOfDeath = detail.DateOfDeath;
            LegalHeirName = detail.LegalHeirName ?? string.Empty;
            DeathCause = detail.DeathCause ?? string.Empty;

            EduCourse = detail.Course ?? string.Empty;
            EduYear = detail.EduYear?.ToString() ?? string.Empty;
            EduCollegeName = detail.CollegeName ?? string.Empty;
            EduTotalCourses = detail.TotalNumberOfCourses;
            IsEduFirstApplication = detail.IsFirstApplication != false;

            MedicalTreatmentType = detail.MedicalTreatmentType ?? string.Empty;

            MeritCandidateName = detail.MeritCandidateName ?? string.Empty;
            MeritFatherName = detail.MeritFatherName ?? string.Empty;
            MeritExamination = detail.ExaminationAppeared ?? string.Empty;
            MeritBoardName = detail.BoardName ?? string.Empty;
            MeritMaximumMarks = detail.MaximumMarks ?? 0;
            MeritMarksObtained = detail.MarksObtained ?? 0;
            CalculatePercentage();

            DistinctionCandidateName = detail.DistinctionCandidateName ?? string.Empty;
            DistinctionFatherName = detail.DistinctionFatherName ?? string.Empty;
            DistinctionProfessionalCourse = detail.ProfessionalCourseName ?? string.Empty;
            DistinctionCourseYear = detail.CourseCompletionYear ?? string.Empty;
            DistinctionUniversityName = detail.UniversityName ?? string.Empty;
            DistinctionMaximumMarks = detail.DistinctionMaximumMarks ?? 0;
            DistinctionMarksObtained = detail.DistinctionMarksObtained ?? 0;
            CalculateDistinctionPercentage();
            DistinctionHasArrears = detail.HasArrears;
            DistinctionIsWholesaleEmployee = detail.IsWholesaleDealerEmployee;

            var qtyRangeKey = ReverseQuantityRange(detail.QuantityLifted);
            QuantityLiftedInput = !string.IsNullOrEmpty(qtyRangeKey)
                ? qtyRangeKey
                : detail.QuantityLifted?.ToString("0") ?? string.Empty;
            IsDeclarationConfirmed = detail.IsDeclarationConfirmed;

            if (SelectedBeneficiaryGroup == "Direct Dealer")
            {
                var match = _existingBeneficiaries.FirstOrDefault(b =>
                    string.Equals(b.Name, BeneficiaryName, StringComparison.OrdinalIgnoreCase));
                SelectedExistingBeneficiary = match?.Name ?? "new";
            }
            else if (SelectedBeneficiaryGroup == "Sub Dealer")
            {
                await LoadSubDealers();
                SelectedSubDealerId = detail.SubDealerId?.ToString() ?? string.Empty;
                SelectedSubDealerName = detail.SubDealerName ?? string.Empty;
            }
            else if (SelectedBeneficiaryGroup == "Approved Employee")
            {
                await LoadEmployees();
                SelectedEmployeeId = detail.EmployeeId?.ToString() ?? string.Empty;
                SelectedEmployeeName = detail.EmployeeName ?? string.Empty;
            }

            // ---- Pre-fill previously uploaded documents so they can be kept, replaced or removed ----
            ExistingDocs = new Dictionary<string, WelfareApplicationDocumentDto>(StringComparer.OrdinalIgnoreCase);
            foreach (var doc in detail.Documents.OrderByDescending(d => d.UploadedAt))
            {
                var key = doc.DocumentType?.Trim() ?? string.Empty;
                if (!string.IsNullOrEmpty(key))
                    ExistingDocs.TryAdd(key, doc);
            }
        }
        catch (Exception)
        {
            _resubmitError = "Unable to load the application for correction. Please try again.";
        }
    }

    // ------------------------------------------------------------------
    // Resubmission helpers
    // ------------------------------------------------------------------

    private WelfareApprovalStepDto? GetLatestRejection() =>
        _resubmitDetail?.Approvals
            .Where(ap => string.Equals(ap.ApprovalStatus, "Rejected", StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(ap => ap.ApprovedAt)
            .FirstOrDefault();

    private static string StageLevelName(string level) => level switch
    {
        "MO" => "MO",
        "RM" => "RM",
        "SM" => "SM",
        "AVP" => "AVP",
        _ => "the approval officer"
    };

    private static string MapSchemeTypeToPageName(int schemeType) => schemeType switch
    {
        0 => "Medical Assistance",
        1 => "Wedding",
        2 => "Grahapravesam",
        3 => "Educational Assistance",
        4 => "Sathabhishekam",
        5 => "Death Relief",
        6 => "Merit Award",
        7 => "Distinction Award",
        _ => "Grahapravesam"
    };

    private static string ReverseQuantityRange(int? quantity) => quantity switch
    {
        null => "",
        <= 0 => "lt1000",
        1001 => "gt1000",
        >= 5001 and <= 10000 => "5001-10000",
        >= 10001 and <= 25000 => "10001-25000",
        >= 25001 and <= 35000 => "25001-35000",
        >= 35001 and <= 50000 => "35001-50000",
        >= 50001 => "gt50001",
        _ => ""
    };

    private WelfareApplicationDocumentDto? GetExistingDocument(string docName) =>
        IsResubmissionMode &&
        !RemovedExistingDocNames.Contains(docName) &&
        ExistingDocs.TryGetValue(docName, out var existing)
            ? existing
            : null;

    /// <summary>Doc counts as present when newly uploaded OR still present from the previous submission.</summary>
    private bool HasDocument(string docName) =>
        UploadedFiles.ContainsKey(docName) || GetExistingDocument(docName) != null;

    private void RemoveExistingDocument(string docName)
    {
        RemovedExistingDocNames.Add(docName);
        StateHasChanged();
    }

    private async Task ViewExistingDocument(WelfareApplicationDocumentDto doc)
    {
        var baseUrl = Http.BaseAddress?.ToString().TrimEnd('/') ?? "";
        var url = $"{baseUrl}/api/SDWAWelfareApplication/document/{doc.Id}";
        await JS.InvokeVoidAsync("open", url, "_blank");
    }

    /// <summary>
    /// Comma-separated ids of previously stored documents to delete server-side:
    /// explicitly removed ones plus any that are being replaced by a new upload.
    /// </summary>
    private string BuildRemovedDocumentIds()
    {
        var ids = ExistingDocs.Values
            .Where(d =>
                RemovedExistingDocNames.Contains(d.DocumentType ?? string.Empty) ||
                UploadedFiles.ContainsKey(d.DocumentType ?? string.Empty))
            .Select(d => d.Id)
            .Distinct();

        return string.Join(",", ids);
    }

    private async Task OnBeneficiaryGroupChanged()
    {
        BeneficiaryGroupError = string.Empty;
        SelectedSubDealerId = string.Empty;
        SelectedSubDealerName = string.Empty;
        SelectedEmployeeId = string.Empty;
        SelectedEmployeeName = string.Empty;
        SelectedExistingBeneficiary = string.Empty;

        if (SelectedBeneficiaryGroup == "Sub Dealer")
        {
            if (_salesHistory != null && !_salesHistory.IsSubDealerEligible)
            {
                BeneficiaryGroupError = "You do not have sufficient sales quantity to apply for a Sub Dealer. A minimum average annual sales of 50,000 MT over the last 3 years is required.";
                return;
            }
            await LoadSubDealers();
        }
        else if (SelectedBeneficiaryGroup == "Approved Employee")
        {
            if (_salesHistory != null && !_salesHistory.IsEmployeeEligible)
            {
                BeneficiaryGroupError = "You do not have sufficient sales quantity to apply for an Approved Employee. A minimum average annual sales of 5,000 MT over the last 3 years is required.";
                return;
            }
            await LoadEmployees();
        }
    }

    private async Task LoadSubDealers()
    {
        _isLoadingSubDealers = true;
        try
        {
            var result = await Http.GetFromJsonAsync<List<SubDealerDto>>("api/SubDealerEmployee/my-sub-dealers");
            if (result != null)
                _subDealers = result;
        }
        catch (Exception)
        {
            _subDealers = new List<SubDealerDto>();
        }
        finally
        {
            _isLoadingSubDealers = false;
        }
    }

    private async Task LoadEmployees()
    {
        _isLoadingEmployees = true;
        try
        {
            var result = await Http.GetFromJsonAsync<List<EmployeeDto>>("api/SubDealerEmployee/my-employees");
            if (result != null)
                _employees = result;
        }
        catch (Exception)
        {
            _employees = new List<EmployeeDto>();
        }
        finally
        {
            _isLoadingEmployees = false;
        }
    }

    private void OnSubDealerSelected()
    {
        var selected = _subDealers.FirstOrDefault(sd => sd.Id.ToString() == SelectedSubDealerId);
        SelectedSubDealerName = selected?.FirmName ?? string.Empty;

        if (selected != null)
        {
            // Load nominee / beneficiary information dynamically from the Sub Dealer master
            if (!string.IsNullOrWhiteSpace(selected.NomineeName))
                NomineeName = selected.NomineeName;

            if (!string.IsNullOrWhiteSpace(selected.BeneficiaryName))
                BeneficiaryName = selected.BeneficiaryName;

            if (!string.IsNullOrWhiteSpace(selected.Relationship))
                BeneficiaryRelationship = selected.Relationship;

            if (selected.DOB.HasValue)
            {
                BeneficiaryDateOfBirth = selected.DOB.Value;
                OnDateChanged();
            }
        }
    }

    private void OnEmployeeSelected()
    {
        var selected = _employees.FirstOrDefault(e => e.Id.ToString() == SelectedEmployeeId);
        SelectedEmployeeName = selected?.EmployeeName ?? string.Empty;

        if (selected != null)
        {
            // Load nominee / beneficiary information dynamically from the Employee master
