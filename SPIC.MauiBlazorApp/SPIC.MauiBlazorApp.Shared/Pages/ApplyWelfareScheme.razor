        MarksObtained = MeritMarksObtained > 0 ? MeritMarksObtained : null,
        MeritPercentage = MeritPercentage > 0 ? MeritPercentage : null,
        DistinctionCandidateName = DistinctionCandidateName,
        DistinctionFatherName = DistinctionFatherName,
        ProfessionalCourseName = DistinctionProfessionalCourse,
        CourseCompletionYear = DistinctionCourseYear,
        UniversityName = DistinctionUniversityName,
        DistinctionMaximumMarks = DistinctionMaximumMarks > 0 ? DistinctionMaximumMarks : null,
        DistinctionMarksObtained = DistinctionMarksObtained > 0 ? DistinctionMarksObtained : null,
        DistinctionAggregatePercentage = DistinctionAggregatePercentage > 0 ? DistinctionAggregatePercentage : null,
        HasArrears = DistinctionHasArrears,
        IsWholesaleDealerEmployee = DistinctionIsWholesaleEmployee,
        IsDeclarationConfirmed = IsDeclarationConfirmed
    };

    private async Task<HttpResponseMessage> PostApplicationAsync(string url, bool isResubmission = false)
    {
        var dto = BuildSubmitDto();

        using var content = new MultipartFormDataContent();

        void AddField(string name, string? value) =>
            content.Add(new StringContent(value ?? string.Empty), name);

        AddField("SchemeName", dto.SchemeName);
        AddField("BeneficiaryName", dto.BeneficiaryName);
        AddField("BeneficiaryDateOfBirth", dto.BeneficiaryDateOfBirth?.ToString("yyyy-MM-dd"));
        AddField("NomineeName", dto.NomineeName);
        AddField("NomineeRelationship", dto.NomineeRelationship);
        AddField("QuantityLifted", dto.QuantityLifted?.ToString());
        AddField("BeneficiaryGroup", dto.BeneficiaryGroup);
        AddField("SubDealerId", dto.SubDealerId?.ToString());
        AddField("SubDealerName", dto.SubDealerName);
        AddField("EmployeeId", dto.EmployeeId?.ToString());
        AddField("EmployeeName", dto.EmployeeName);
        AddField("AverageQuantityLifted3Years", dto.AverageQuantityLifted3Years?.ToString(System.Globalization.CultureInfo.InvariantCulture));
        AddField("LastYearQuantityLifted", dto.LastYearQuantityLifted?.ToString(System.Globalization.CultureInfo.InvariantCulture));
        AddField("EventDate", dto.EventDate?.ToString("yyyy-MM-dd"));
        AddField("EventVenue", dto.EventVenue);
        AddField("OwnershipType", dto.OwnershipType);
        AddField("DateOfDeath", dto.DateOfDeath?.ToString("yyyy-MM-dd"));
        AddField("LegalHeirName", dto.LegalHeirName);
        AddField("DeathCause", dto.DeathCause);
        AddField("Course", dto.Course);
        AddField("EduYear", dto.EduYear?.ToString());
        AddField("CollegeName", dto.CollegeName);
        AddField("TotalNumberOfCourses", dto.TotalNumberOfCourses?.ToString());
        AddField("IsFirstApplication", dto.IsFirstApplication?.ToString());
        AddField("MedicalTreatmentType", dto.MedicalTreatmentType);
        AddField("MeritCandidateName", dto.MeritCandidateName);
        AddField("MeritFatherName", dto.MeritFatherName);
        AddField("ExaminationAppeared", dto.ExaminationAppeared);
        AddField("BoardName", dto.BoardName);
        AddField("MaximumMarks", dto.MaximumMarks?.ToString());
        AddField("MarksObtained", dto.MarksObtained?.ToString());
        AddField("MeritPercentage", dto.MeritPercentage?.ToString(System.Globalization.CultureInfo.InvariantCulture));
        AddField("DistinctionCandidateName", dto.DistinctionCandidateName);
        AddField("DistinctionFatherName", dto.DistinctionFatherName);
        AddField("ProfessionalCourseName", dto.ProfessionalCourseName);
        AddField("CourseCompletionYear", dto.CourseCompletionYear);
        AddField("UniversityName", dto.UniversityName);
        AddField("DistinctionMaximumMarks", dto.DistinctionMaximumMarks?.ToString());
        AddField("DistinctionMarksObtained", dto.DistinctionMarksObtained?.ToString());
        AddField("DistinctionAggregatePercentage", dto.DistinctionAggregatePercentage?.ToString(System.Globalization.CultureInfo.InvariantCulture));
        AddField("HasArrears", dto.HasArrears?.ToString());
        AddField("IsWholesaleDealerEmployee", dto.IsWholesaleDealerEmployee?.ToString());
        AddField("IsDeclarationConfirmed", dto.IsDeclarationConfirmed.ToString());

        if (isResubmission)
        {
            // Documents the dealer removed / replaced must be deleted from the existing application
            AddField("removedDocumentIds", BuildRemovedDocumentIds());
        }

        foreach (var entry in UploadedFiles)
        {
            var file = entry.Value;
            var fileContent = new ByteArrayContent(file.Data);
            fileContent.Headers.ContentType =
                new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType ?? "application/octet-stream");
            content.Add(fileContent, "files", file.Name);
            content.Add(new StringContent(entry.Key), "documentTypes");
        }

        return await Http.PostAsync(url, content);
    }

    private static int? MapQuantityRange(string? range) => range switch
    {
        "lt1000" => 0,
        "gt1000" => 1001,
        "5001-10000" => 5001,
        "10001-25000" => 10001,
        "25001-35000" => 25001,
        "35001-50000" => 35001,
        "gt50001" => 50001,
        _ => null
    };

    private static string FormatDisplayDate(DateTime? date) =>
        date?.ToString("dd/MM/yyyy") ?? "-";

    private static string? TryGetStringProperty(string json, string propertyName)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            return doc.RootElement.TryGetProperty(propertyName, out var element)
                ? element.GetString()
                : null;
        }
        catch
        {
            return null;
        }
    }

    private void CloseSuccessModal()
    {
        IsSuccessModalOpen = false;
    }
