@page "/ApplyWelfareScheme"
@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject IJSRuntime JS
@using SPIC.Core.DTOs

<div class="container-fluid py-4 px-0">
    
    <div class="aws-header-container">
        <h1>@(IsResubmissionMode ? $"Correct & Resubmit {SelectedScheme} Application" : $"Apply for {SelectedScheme}")</h1>
        <p>@(IsResubmissionMode
            ? "Your application was returned for correction. Update the details/documents below and resubmit - no new application will be created."
            : "Complete the form and upload required documents. Your progress is auto-saved.")</p>
    </div>
    @if (ResubmitId.HasValue)
    {
        var rejection = GetLatestRejection();
        if (!string.IsNullOrEmpty(_resubmitError))
        {
        <div class="aws-alert-info" style="border-color: #e74c3c; background: #fff5f5; margin-top: 12px;">
            <div class="aws-alert-icon" style="color: #e74c3c;">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="15" y1="9" x2="9" y2="15"></line>
                    <line x1="9" y1="9" x2="15" y2="15"></line>
                </svg>
            </div>
            <div style="color: #c0392b;">
                <div><strong>@_resubmitError</strong></div>
                <div style="margin-top: 4px;">Submission has been disabled so that a duplicate application is not created.</div>
            </div>
        </div>
        }
        else if (_resubmitDetail != null)
        {
        <div class="aws-alert-info" style="border-color: #e74c3c; background: #fff5f5; margin-top: 12px;">
            <div class="aws-alert-icon" style="color: #e74c3c;">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="15" y1="9" x2="9" y2="15"></line>
                    <line x1="9" y1="9" x2="15" y2="15"></line>
                </svg>
            </div>
            <div style="color: #c0392b;">
                @if (rejection != null)
                {
                    <div>
                        <strong>Rejected by @StageLevelName(rejection.ApprovalLevel)@(string.IsNullOrWhiteSpace(rejection.ApprovedBy) ? "" : $" ({rejection.ApprovedBy})")</strong>
                        @(rejection.ApprovedAt.HasValue ? $" on {rejection.ApprovedAt.Value:dd MMM yyyy}" : "")
                    </div>
                    @if (!string.IsNullOrWhiteSpace(rejection.Remarks))
                    {
                        <div style="margin-top: 4px;"><em>Reason:</em> @rejection.Remarks</div>
                    }
                    <div style="margin-top: 4px;">Please correct the issues below and click Resubmit. The application keeps its original ID and will restart approval from MO.</div>
                }
            </div>
        </div>
        }
    }
    @if (CurrentEligibilityConditions.Any())
    {
    <div class="aws-eligibility-box">
        <div class="aws-eligibility-header">
            
            <div class="aws-eligibility-icon">
                <img src="_content/SPIC.MauiBlazorApp.Shared/Images/WelfareSchemes/Eligible.png" />
            </div>
            
            <div class="aws-eligibility-title-group">
                <h3 class="aws-eligibility-title">Eligibility Conditions</h3>
                <p class="aws-eligibility-subtitle">Please ensure you meet all the following criteria for @SelectedScheme</p>
            </div>
        </div>
        
        <ul class="aws-eligibility-list">
            @foreach (var condition in CurrentEligibilityConditions)
            {
                <li>@condition</li>
            }
        </ul>
    </div>
    }

