    <div class="aws-section-card">
        
        <div class="aws-section-header">
            <span class="aws-step-number">2</span>
            <h2>Quantity Lifted</h2>
        </div>

        <div class="aws-form-grid-2col">
            
            <div class="aws-form-group">
                <label class="aws-form-label">Financial Year</label>
                <select class="aws-form-select">
                    <option value="2024-2025" selected>2024 - 2025</option>
                    <option value="2023-2024">2023 - 2024</option>
                </select>
            </div>
            
            <div class="aws-form-group">
                <label class="aws-form-label">Quantity Lifted (cases)</label>
                <input type="number" class="aws-form-control" placeholder="Enter quantity">
            </div>

        </div>

        <div class="aws-alert-info">
            <div class="aws-alert-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="16" x2="12" y2="12"></line>
                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                </svg>
            </div>
            <div>
                Minimum 500 cases must be lifted in the current financial year to be eligible. Your current lifted quantity will be auto-verified on submission.
            </div>
        </div>

    </div>

    <div class="aws-section-card">
        
        <div class="aws-section-header">
            <span class="aws-step-number">3</span>
            <h2>Beneficiary Details</h2>
        </div>

        <div class="aws-form-grid">
            
            <div class="aws-form-group">
                <label class="aws-form-label">Select Beneficiary</label>
                <select class="aws-form-select">
                    <option value="" selected>Add new beneficiary</option>
                </select>
            </div>
            
            <div class="aws-form-group">
                <label class="aws-form-label">Beneficiary Name</label>
                <input type="text" class="aws-form-control" placeholder="Full Name">
            </div>
            
            <div class="aws-form-group">
                <label class="aws-form-label">Relationship</label>
                <select class="aws-form-select">
                    <option value="" disabled selected hidden>Select relationship</option>
                    <option value="spouse">Spouse</option>
                    <option value="child">Child</option>
                    <option value="parent">Parent</option>
                </select>
            </div>

            <div class="aws-form-group">
                <label class="aws-form-label">Date of Birth</label>
                <div class="aws-input-with-icon">
                    <input type="text" class="aws-form-control" placeholder="dd-mm-yyyy">
                    <svg class="aws-input-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                </div>
            </div>
            
            <div class="aws-form-group">
                <label class="aws-form-label">Age</label>
                <input type="text" class="aws-form-control" placeholder="Age in years">
            </div>
            
            <div class="aws-form-group">
                <label class="aws-form-label">Nominee Name</label>
                <input type="text" class="aws-form-control" placeholder="Nominee's Full Name">
            </div>

            <div class="aws-form-group">
                <label class="aws-form-label">Nominee Relationship</label>
                <select class="aws-form-select">
                    <option value="" disabled selected hidden>Select relationship</option>
                    <option value="spouse">Spouse</option>
                    <option value="child">Child</option>
                    <option value="parent">Parent</option>
                </select>
            </div>

        </div>

    </div>
    <div class="aws-section-card">
        
        <div class="aws-section-header">
            <span class="aws-step-number">4</span>
            <h2>Grahapravesam Details</h2>
        </div>

        <div class="aws-form-grid">
            
            <div class="aws-form-group">
                <label class="aws-form-label">Housewarming Date</label>
                <div class="aws-input-with-icon">
                    <input type="text" class="aws-form-control" placeholder="dd-mm-yyyy">
                    <svg class="aws-input-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                </div>
            </div>

            <div class="aws-form-group">
                <label class="aws-form-label">Ownership Type</label>
                <select class="aws-form-select">
                    <option value="" disabled selected hidden>Select Ownership Type</option>
                    <option value="owned">Owned</option>
                    <option value="rented">Rented</option>
                </select>
            </div>

            <div class="aws-form-group">
                <label class="aws-form-label">Relationship</label>
                <select class="aws-form-select">
                    <option value="" disabled selected hidden>Select relationship</option>
                    <option value="self">Self</option>
                    <option value="spouse">Spouse</option>
                    <option value="child">Child</option>
                </select>
            </div>

        </div>

        <div class="aws-form-grid-2col" style="margin-top: 24px; margin-bottom: 0;">
            
            <div class="aws-form-group">
                <label class="aws-form-label">House Address</label>
                <textarea class="aws-form-control" placeholder="Full address of the new house" rows="3"></textarea>
            </div>

            <div class="aws-form-group">
                <label class="aws-form-label">Event Venue (if different from house address)</label>
                <textarea class="aws-form-control" placeholder="Venue name or address" rows="3"></textarea>
            </div>

        </div>

    </div>
    <div class="aws-section-card">
        
        <div class="aws-section-header">
            <span class="aws-step-number">5</span>
            <h2>Document Upload</h2>
        </div>

        <div class="aws-upload-grid">
            
            <div class="aws-drop-zone">
                <div class="aws-drop-icon-wrap">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="17 8 12 3 7 8"></polyline>
                        <line x1="12" y1="3" x2="12" y2="15"></line>
                    </svg>
                </div>
                <p class="aws-drop-title">Drag & drop files here or click to browse</p>
                <p class="aws-drop-subtitle">Accepted: PDF, JPG, PNG · Max 5MB per file</p>
            </div>

            <div class="aws-doc-list">
                
                <div class="aws-doc-item">
                    <div class="aws-doc-info">
                        <svg class="aws-doc-icon aws-icon-red" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                        <span class="aws-doc-name">Invitation / Housewarming Card Copy</span>
                    </div>
                    <div class="aws-doc-status-group">
                        <div class="aws-status-indicator aws-status-uploaded">
                            <span class="aws-status-dot"></span> Uploaded
                        </div>
                        <button class="aws-btn-upload-action">Replace</button>
                    </div>
                </div>

                <div class="aws-doc-item">
                    <div class="aws-doc-info">
                        <svg class="aws-doc-icon aws-icon-blue" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
                        <span class="aws-doc-name">House Ownership Proof</span>
                    </div>
                    <div class="aws-doc-status-group">
                        <div class="aws-status-indicator aws-status-required">
                            <span class="aws-status-dot"></span> Required
                        </div>
                        <button class="aws-btn-upload-action">Upload</button>
                    </div>
                </div>

                <div class="aws-doc-item">
                    <div class="aws-doc-info">
                        <svg class="aws-doc-icon aws-icon-green" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                        <span class="aws-doc-name">Dealer ID / Membership Card</span>
                    </div>
                    <div class="aws-doc-status-group">
                        <div class="aws-status-indicator aws-status-uploaded">
                            <span class="aws-status-dot"></span> Uploaded
                        </div>
                        <button class="aws-btn-upload-action">Replace</button>
                    </div>
                </div>

                <div class="aws-doc-item">
                    <div class="aws-doc-info">
                        <svg class="aws-doc-icon aws-icon-pink" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                        <span class="aws-doc-name">Address Proof</span>
                    </div>
                    <div class="aws-doc-status-group">
                        <div class="aws-status-indicator aws-status-uploaded">
                            <span class="aws-status-dot"></span> Uploaded
                        </div>
                        <button class="aws-btn-upload-action">Replace</button>
                    </div>
                </div>

            </div>
        </div>

    </div>
    <div class="aws-section-card">
        
        <div class="aws-section-header">
            <span class="aws-step-number">6</span>
            <h2>Declaration</h2>
        </div>

        <div class="aws-alert-warning">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                <line x1="12" y1="9" x2="12" y2="13"></line>
                <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
            <span>Please read the declaration carefully before proceeding. False information may result in rejection and future disqualification.</span>
        </div>

        <div class="aws-declaration-box">
            <input type="checkbox" class="aws-checkbox-large" id="declarationCheck">
            <label class="aws-declaration-text" for="declarationCheck">
                I, Rajesh Kumar, hereby declare that all information provided in this application is true, accurate, and complete to the best of my knowledge. I understand that any false information or suppression of facts will lead to rejection of the application and may result in appropriate action as deemed necessary by SDWA.
            </label>
        </div>

    </div>

    <div class="aws-page-actions">
        <button class="aws-btn-action aws-btn-draft">Save as Draft</button>
        <button @onclick="OpenPreviewModal" class="aws-btn-action aws-btn-primary">Preview Application</button>
    </div>

</div> 
@if (IsPreviewModalOpen)
{
