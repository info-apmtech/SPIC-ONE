    private static readonly (string Key, string Label)[] QuantityOptions = new (string Key, string Label)[]
    {
        ("lt1000", "<1,000 MT"),
        ("gt1000", ">1,000 MT"),
        ("5001-10000", "5,001 to 10,000 MT"),
        ("10001-25000", "10,001 to 25,000 MT"),
        ("25001-35000", "25,001 to 35,000 MT"),
        ("35001-50000", "35,001 to 50,000 MT"),
        ("gt50001", ">50,001 MT")
    };

    private bool ShowBeneficiaryDetails => TryGetQuantityLifted(out _);

    private string QuantityLiftedDisplay
    {
        get
        {
            var input = QuantityLiftedInput?.Trim();
            if (string.IsNullOrEmpty(input)) return "-";
            var opt = QuantityOptions.FirstOrDefault(o => string.Equals(o.Key, input, StringComparison.OrdinalIgnoreCase));
            return opt.Key != null ? opt.Label : $"{input} MT";
        }
    }

    private bool TryGetQuantityLifted(out int? quantity)
    {
        quantity = null;
        var input = QuantityLiftedInput?.Trim();
        if (string.IsNullOrEmpty(input)) return false;

        var match = QuantityOptions.FirstOrDefault(o =>
            string.Equals(o.Key, input, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(o.Label, input, StringComparison.OrdinalIgnoreCase));
        if (match.Key != null)
        {
            quantity = MapQuantityRange(match.Key);
            return quantity.HasValue;
        }

        var cleaned = input.Replace(",", string.Empty);
        if (decimal.TryParse(cleaned, out var parsed) && parsed > 0)
        {
            quantity = (int)Math.Round(parsed);
            return true;
        }

        return false;
    }

