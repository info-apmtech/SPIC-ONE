    <div class="aws-section-card">
        
        <div class="aws-section-header">
            <span class="aws-step-number">4</span>
            <h2>@SchemeDetailsTitle</h2>
        </div>

        @if (SelectedScheme == "Wedding")
        {
        <div class="aws-form-grid-2col">
            <div class="aws-form-group">
                <label class="aws-form-label">Wedding Date</label>
                <input type="date" class="aws-form-control" @bind="EventDate" min="@DateTime.Today.AddDays(7).ToString("yyyy-MM-dd")" @bind:after="OnDateChanged">
            </div>
            <div class="aws-form-group">
                <label class="aws-form-label">Event Venue</label>
                <textarea class="aws-form-control" placeholder="Venue name or address" rows="3" @bind="EventVenue"></textarea>
            </div>
        </div>
        }
        else if (SelectedScheme == "Sathabhishekam")
        {
        <div class="aws-form-grid-2col">
            <div class="aws-form-group">
                <label class="aws-form-label">Event Date</label>
                <input type="date" class="aws-form-control" @bind="EventDate" min="@DateTime.Today.AddDays(7).ToString("yyyy-MM-dd")" @bind:after="OnDateChanged">
            </div>
            <div class="aws-form-group">
                <label class="aws-form-label">Event Venue</label>
                <textarea class="aws-form-control" placeholder="Venue name or address" rows="3" @bind="EventVenue"></textarea>
            </div>
        </div>
        }
        else if (SelectedScheme == "Grahapravesam")
        {
        <div class="aws-form-grid-2col">
            <div class="aws-form-group">
                <label class="aws-form-label">Housewarming Date</label>
                <input type="date" class="aws-form-control" @bind="EventDate" min="@DateTime.Today.AddDays(7).ToString("yyyy-MM-dd")" @bind:after="OnDateChanged">
            </div>
            <div class="aws-form-group">
                <label class="aws-form-label">Ownership Type</label>
                <select class="aws-form-select" @bind="OwnershipType">
                    <option value="" disabled selected hidden>Select Ownership Type</option>
                    <option value="Owned">Owned</option>
                    <option value="Rented">Rented</option>
                </select>
            </div>
        </div>
        <div class="aws-form-grid-2col" style="margin-top: 24px; margin-bottom: 0;">
            <div class="aws-form-group">
                <label class="aws-form-label">Event Venue (if different from house address)</label>
                <textarea class="aws-form-control" placeholder="Venue name or address" rows="3" @bind="EventVenue"></textarea>
            </div>
        </div>
        }
        else if (SelectedScheme == "Death Relief")
        {
        <div class="aws-form-grid-2col">
            <div class="aws-form-group">
                <label class="aws-form-label">Date of Death</label>
                <input type="date" class="aws-form-control" @bind="DeathDateOfDeath" max="@DateTime.Today.ToString("yyyy-MM-dd")" @bind:after="OnDateChanged">
            </div>
            <div class="aws-form-group">
                <label class="aws-form-label">Legal Heir Name</label>
                <input type="text" class="aws-form-control" placeholder="Full Name of Legal Heir" @bind="LegalHeirName">
            </div>
            <div class="aws-form-group">
                <label class="aws-form-label">Relationship to Dealer</label>
                <select class="aws-form-select" @bind="BeneficiaryRelationship">
                    <option value="" disabled selected hidden>Select relationship</option>
                    <option value="Spouse">Spouse</option>
                    <option value="Child">Child</option>
                    <option value="Parent">Parent</option>
                </select>
            </div>
            <div class="aws-form-group">
                <label class="aws-form-label">Cause of Death</label>
                <input type="text" class="aws-form-control" placeholder="e.g. Natural, Illness, Accident" @bind="DeathCause">
            </div>
        </div>
        }
        else if (SelectedScheme == "Educational Assistance")
        {
        <div class="aws-form-grid">
            <div class="aws-form-group">
                <label class="aws-form-label">Application Type</label>
                <div style="display: flex; gap: 16px; margin-top: 4px;">
                    <label style="display: flex; align-items: center; gap: 6px; cursor: pointer;">
                        <input type="radio" name="eduAppType" value="first" checked="@IsEduFirstApplication" @onchange="OnEduAppTypeChanged" />
                        <span>First Application</span>
                    </label>
                    <label style="display: flex; align-items: center; gap: 6px; cursor: pointer;">
                        <input type="radio" name="eduAppType" value="renewal" checked="@(!IsEduFirstApplication)" @onchange="OnEduAppTypeChanged" />
                        <span>Renewal</span>
                    </label>
                </div>
            </div>
            <div class="aws-form-group">
                <label class="aws-form-label">Total Number of Courses (Duration in Years)</label>
                <input type="number" class="aws-form-control" placeholder="e.g. 4" @bind="EduTotalCourses" min="1" max="10">
            </div>
            <div class="aws-form-group">
                <label class="aws-form-label">Course</label>
                <input type="text" class="aws-form-control" placeholder="Enter course name" @bind="EduCourse">
            </div>
            <div class="aws-form-group">
                <label class="aws-form-label">Year</label>
                <select class="aws-form-select" @bind="EduYear">
                    <option value="" disabled selected hidden>Select year</option>
                    <option value="1">1st Year</option>
                    <option value="2">2nd Year</option>
                    <option value="3">3rd Year</option>
                    <option value="4">4th Year</option>
                    <option value="5">5th Year</option>
                    <option value="6">6th Year</option>
                </select>
            </div>
            <div class="aws-form-group">
                <label class="aws-form-label">College Name</label>
                <input type="text" class="aws-form-control" placeholder="Enter college name" @bind="EduCollegeName">
            </div>
        </div>
        }
        else if (SelectedScheme == "Medical Assistance")
        {
        <div class="aws-form-grid">
            <div class="aws-form-group">
                <label class="aws-form-label">Treatment / Medical Condition <span style="color: #e74c3c;">*</span></label>
                <input type="text" class="aws-form-control" placeholder="e.g. Surgery, Hospitalization, Cancer treatment, Kidney treatment" @bind="MedicalTreatmentType">
            </div>
        </div>
        }
        else if (SelectedScheme == "Merit Award")
        {
        <div class="aws-form-grid">
            <div class="aws-form-group">
                <label class="aws-form-label">Name of the Candidate</label>
                <input type="text" class="aws-form-control" placeholder="Candidate's full name" @bind="MeritCandidateName">
            </div>
            <div class="aws-form-group">
                <label class="aws-form-label">Candidate's Father Name</label>
                <input type="text" class="aws-form-control" placeholder="Father's name" @bind="MeritFatherName">
            </div>
            <div class="aws-form-group">
                <label class="aws-form-label">Examination Appeared (10th/12th)</label>
                <select class="aws-form-select" @bind="MeritExamination">
                    <option value="" disabled selected hidden>Select examination</option>
                    <option value="10th">10th</option>
                    <option value="12th">12th</option>
                </select>
            </div>
            <div class="aws-form-group">
                <label class="aws-form-label">Name of the Board</label>
                <input type="text" class="aws-form-control" placeholder="Enter board name" @bind="MeritBoardName">
            </div>
            <div class="aws-form-group">
                <label class="aws-form-label">Maximum Marks</label>
                <input type="number" class="aws-form-control" placeholder="Enter maximum marks" @bind="MeritMaximumMarks" @bind:event="oninput" @onchange="CalculatePercentage">
            </div>
            <div class="aws-form-group">
                <label class="aws-form-label">Marks Obtained</label>
                <input type="number" class="aws-form-control" placeholder="Enter marks obtained" @bind="MeritMarksObtained" @bind:event="oninput" @onchange="CalculatePercentage">
            </div>
            <div class="aws-form-group">
                <label class="aws-form-label">Percentage</label>
                <input type="text" class="aws-input-readonly" value="@($"{MeritPercentage:F2}%")" readonly>
            </div>
        </div>
        }
        else if (SelectedScheme == "Distinction Award")
        {
        <div class="aws-form-grid">
            <div class="aws-form-group">
                <label class="aws-form-label">Candidate Name <span style="color: #e74c3c;">*</span></label>
                <input type="text" class="aws-form-control" placeholder="Candidate's full name" @bind="DistinctionCandidateName">
            </div>
            <div class="aws-form-group">
                <label class="aws-form-label">Candidate's Father Name</label>
                <input type="text" class="aws-form-control" placeholder="Father's name" @bind="DistinctionFatherName">
            </div>
            <div class="aws-form-group">
                <label class="aws-form-label">Professional Course Name <span style="color: #e74c3c;">*</span></label>
                <input type="text" class="aws-form-control" placeholder="e.g. B.Tech, MBBS, B.Sc Agriculture" @bind="DistinctionProfessionalCourse">
            </div>
            <div class="aws-form-group">
                <label class="aws-form-label">Course Completion Year</label>
                <input type="text" class="aws-form-control" placeholder="e.g. 2025" @bind="DistinctionCourseYear">
            </div>
            <div class="aws-form-group">
                <label class="aws-form-label">University / Institution Name</label>
                <input type="text" class="aws-form-control" placeholder="Enter university or institution name" @bind="DistinctionUniversityName">
            </div>
            <div class="aws-form-group">
                <label class="aws-form-label">Total / Maximum Marks <span style="color: #e74c3c;">*</span></label>
                <input type="number" class="aws-form-control" placeholder="Enter total marks" @bind="DistinctionMaximumMarks" @bind:event="oninput" @onchange="CalculateDistinctionPercentage">
            </div>
            <div class="aws-form-group">
                <label class="aws-form-label">Marks Obtained <span style="color: #e74c3c;">*</span></label>
                <input type="number" class="aws-form-control" placeholder="Enter marks obtained" @bind="DistinctionMarksObtained" @bind:event="oninput" @onchange="CalculateDistinctionPercentage">
            </div>
            <div class="aws-form-group">
                <label class="aws-form-label">Aggregate Percentage</label>
                <input type="text" class="aws-input-readonly" value="@($"{DistinctionAggregatePercentage:F2}%")" readonly>
            </div>
            <div class="aws-form-group">
                <label class="aws-form-label">Any Arrears / Backlogs? <span style="color: #e74c3c;">*</span></label>
                <div style="display: flex; gap: 16px; margin-top: 4px;">
                    <label style="display: flex; align-items: center; gap: 6px; cursor: pointer;">
                        <input type="radio" name="distArrears" value="no" checked="@(DistinctionHasArrears == false)" @onchange="() => DistinctionHasArrears = false" />
                        <span>No</span>
                    </label>
                    <label style="display: flex; align-items: center; gap: 6px; cursor: pointer;">
                        <input type="radio" name="distArrears" value="yes" checked="@(DistinctionHasArrears == true)" @onchange="() => DistinctionHasArrears = true" />
                        <span>Yes</span>
                    </label>
                </div>
            </div>
            <div class="aws-form-group">
                <label class="aws-form-label">Are you an approved Employee of a Wholesale Dealer? (TN only)</label>
                <div style="display: flex; gap: 16px; margin-top: 4px;">
                    <label style="display: flex; align-items: center; gap: 6px; cursor: pointer;">
                        <input type="radio" name="distEmployee" value="no" checked="@(DistinctionIsWholesaleEmployee == false)" @onchange="() => DistinctionIsWholesaleEmployee = false" />
                        <span>No</span>
                    </label>
                    <label style="display: flex; align-items: center; gap: 6px; cursor: pointer;">
                        <input type="radio" name="distEmployee" value="yes" checked="@(DistinctionIsWholesaleEmployee == true)" @onchange="() => DistinctionIsWholesaleEmployee = true" />
                        <span>Yes</span>
                    </label>
                </div>
            </div>
        </div>
        @if (DistinctionAggregatePercentage > 0 && DistinctionAggregatePercentage <= 80)
        {
        <div class="aws-alert-info" style="border-color: #e74c3c; background: #fff5f5; margin-top: 16px;">
            <div class="aws-alert-icon" style="color: #e74c3c;">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="15" y1="9" x2="9" y2="15"></line>
                    <line x1="9" y1="9" x2="15" y2="15"></line>
                </svg>
            </div>
            <div style="color: #c0392b;">
                The aggregate percentage must be more than 80% to be eligible for the Distinction Award. Your current percentage is @($"{DistinctionAggregatePercentage:F2}%").
            </div>
        </div>
        }
        }
        else
        {
        <div class="aws-alert-info">
            <div class="aws-alert-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="16" x2="12" y2="12"></line>
                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                </svg>
            </div>
            <div>
                Please refer to the Eligibility Conditions section above for the benefit details and required documents for @SelectedScheme.
            </div>
        </div>
        }

    </div>
    <div class="aws-section-card">
        
        <div class="aws-section-header">
            <span class="aws-step-number">5</span>
            <h2>Document Upload</h2>
        </div>

        <div class="aws-alert-info" style="border-color: #e74c3c; background: #fff5f5;">
            <div class="aws-alert-icon" style="color: #e74c3c;">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                    <line x1="12" y1="9" x2="12" y2="13"></line>
                    <line x1="12" y1="17" x2="12.01" y2="17"></line>
                </svg>
            </div>
            <div style="color: #c0392b;">
                <strong>Mandatory Beneficiary Document:</strong> The beneficiary must upload either a <strong>Cancelled Cheque</strong> or <strong>Bank Passbook</strong>. At least one of these two documents is required for the application to be processed.
            </div>
        </div>

        <div class="aws-doc-upload-list">
            @foreach (var doc in CurrentDocuments)
            {
                var uploadedFile = UploadedFiles.TryGetValue(doc.Name, out var f) ? f : null;
                var existingFile = GetExistingDocument(doc.Name);
            <div class="aws-doc-upload-item">
                <div class="aws-doc-upload-info">
                    <svg class="aws-doc-icon @doc.IconClass" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                    <span class="aws-doc-name">@doc.Name</span>
                    @if (SelectedScheme == "Educational Assistance" && doc.Name == "Admission Certificate (First Year only)" && !IsEduFirstApplication)
                    {
                        <span class="aws-doc-skip-badge">Renewal – not required</span>
                    }
                    @if (SelectedScheme == "Educational Assistance" && doc.Name == "Marks list of previous year / semesters duly cleared" && IsEduFirstApplication)
                    {
                        <span class="aws-doc-skip-badge">First year – not required</span>
                    }
                </div>
                @if (uploadedFile != null)
                {
                <div class="aws-doc-upload-done">
                    <div class="aws-doc-upload-file-info">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#27ae60" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                        <span class="aws-doc-upload-filename">@uploadedFile.Name</span>
                        <span class="aws-doc-upload-size">(@FormatFileSize(uploadedFile.Size))</span>
                        @if (existingFile != null)
                        {
                            <span class="aws-doc-upload-size" style="color:#B45309;">(replaces previously uploaded document)</span>
                        }
                    </div>
                    <button class="aws-btn-upload-action aws-btn-upload-remove" @onclick="() => RemoveUploadedFile(doc.Name)">Remove</button>
                </div>
                }
                else if (existingFile != null)
                {
                <div class="aws-doc-upload-done">
                    <div class="aws-doc-upload-file-info">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#27ae60" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                        <span class="aws-doc-upload-filename">@existingFile.FileName</span>
                        <span class="aws-doc-upload-size">(@FormatFileSize(existingFile.FileSize ?? 0))</span>
                        <span class="aws-doc-upload-size" style="color:#2563eb;">Previously uploaded</span>
                    </div>
                    <div style="display:flex; gap:8px;">
                        <button class="aws-btn-upload-action aws-btn-upload-remove" style="color:#2563eb;" @onclick="() => ViewExistingDocument(existingFile)">View</button>
                        <button class="aws-btn-upload-action aws-btn-upload-remove" @onclick="() => RemoveExistingDocument(doc.Name)">Remove</button>
                    </div>
                </div>
                }
                else if (SelectedScheme == "Educational Assistance" && doc.Name == "Admission Certificate (First Year only)" && !IsEduFirstApplication)
                {
                <div class="aws-doc-upload-skipped">
                    <span>Skipped – only required for first-year applications</span>
                </div>
                }
                else if (SelectedScheme == "Educational Assistance" && doc.Name == "Marks list of previous year / semesters duly cleared" && IsEduFirstApplication)
                {
                <div class="aws-doc-upload-skipped">
                    <span>Skipped – only required for renewal applications</span>
                </div>
                }
                else
                {
                <div class="aws-doc-upload-zone">
                    <InputFile OnChange="e => HandleFileUpload(doc.Name, e)" accept=".pdf,.jpg,.jpeg,.png" class="aws-doc-upload-input" />
                    <div class="aws-doc-upload-placeholder">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                            <polyline points="17 8 12 3 7 8"></polyline>
                            <line x1="12" y1="3" x2="12" y2="15"></line>
                        </svg>
                        <span>Click to upload</span>
                    </div>
                </div>
                }
            </div>
            }
        </div>

        <div class="aws-alert-info" style="margin-top: 12px;">
            <div class="aws-alert-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="16" x2="12" y2="12"></line>
                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                </svg>
            </div>
            <div>
                Accepted formats: PDF, JPG, PNG. Maximum 5MB per file. All documents listed above are required for your application.
            </div>
        </div>

    </div>
    <div class="aws-section-card">
        
        <div class="aws-section-header">
            <span class="aws-step-number">6</span>
            <h2>Declaration</h2>
        </div>

        <div class="aws-alert-warning">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                <line x1="12" y1="9" x2="12" y2="13"></line>
                <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
            <span>Please read the declaration carefully before proceeding. False information may result in rejection and future disqualification.</span>
        </div>

        <div class="aws-declaration-box">
            <input type="checkbox" class="aws-checkbox-large" id="declarationCheck" @bind="IsDeclarationConfirmed">
            <label class="aws-declaration-text" for="declarationCheck">
                I, @_dealer.DealerName, hereby declare that all information provided in this application is true, accurate, and complete to the best of my knowledge. I understand that any false information or suppression of facts will lead to rejection of the application and may result in appropriate action as deemed necessary by SDWA.
            </label>
        </div>

    </div>

    <div class="aws-page-actions">
        @if (ShowValidation && ValidationErrors.Any())
        {
            <div style="width: 100%; margin-bottom: 12px; background: #fff5f5; border: 1px solid #e74c3c; border-radius: 8px; padding: 12px 16px;">
                <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#e74c3c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="15" y1="9" x2="9" y2="15"></line>
                        <line x1="9" y1="9" x2="15" y2="15"></line>
                    </svg>
                    <strong style="color: #e74c3c;">Please fix the following errors:</strong>
                </div>
                <ul style="margin: 0; padding-left: 20px; color: #c0392b; font-size: 13px;">
                    @foreach (var error in ValidationErrors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }
        @if (!string.IsNullOrEmpty(DraftMessage))
        {
            var bgColor = _draftSuccess ? "#f0fff4" : "#fff5f5";
            var borderColor = _draftSuccess ? "#27ae60" : "#e74c3c";
            var textColor = _draftSuccess ? "#1e8449" : "#c0392b";
            <div style="width: 100%; margin-bottom: 12px; background: @bgColor; border: 1px solid @borderColor; border-radius: 8px; padding: 12px 16px; color: @textColor; font-size: 13px;">
                @DraftMessage
            </div>
        }
        @if (!IsResubmissionMode)
        {
            <button class="aws-btn-action aws-btn-draft" @onclick="SaveAsDraft" disabled="@(_isSavingDraft || _isSubmitting || ResubmitId.HasValue)">@( _isSavingDraft ? "Saving..." : "Save as Draft")</button>
        }
        <button @onclick="OpenPreviewModal" class="aws-btn-action aws-btn-primary" disabled="@(ResubmitId.HasValue && !IsResubmissionMode)">@(IsResubmissionMode ? "Resubmit Application" : "Preview Application")</button>
    </div>

</div> 
@if (IsPreviewModalOpen)
{
    <div class="aws-modal-overlay" @onclick="ClosePreviewModal">
        <div class="aws-modal" @onclick:stopPropagation="true">
            
            <div class="aws-modal-header">
                <div class="aws-modal-title">
                    <h2>@(IsResubmissionMode ? "Preview Resubmission" : "Preview Application")</h2>
                    <p>@(IsResubmissionMode ? "Review your corrections before resubmitting the application." : "Review your details before submitting the application.")</p>
                </div>
                <button class="aws-modal-close" @onclick="ClosePreviewModal" aria-label="Close">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="15" y1="9" x2="9" y2="15"></line>
                        <line x1="9" y1="9" x2="15" y2="15"></line>
                    </svg>
                </button>
            </div>

            <div class="aws-modal-body">
                
                <div class="aws-modal-section">
                    <h3>Scheme</h3>
                    <div class="aws-modal-row">
                        <span class="aws-modal-label">Selected Scheme</span>
                        <span class="aws-modal-colon">:</span>
                        <span class="aws-modal-value">@SelectedScheme</span>
                    </div>
                    <div class="aws-modal-row">
                        <span class="aws-modal-label">Event Date</span>
                        <span class="aws-modal-colon">:</span>
                        <span class="aws-modal-value">@FormatDisplayDate(EventDate)</span>
                    </div>
                </div>

                <div class="aws-modal-section">
                    <h3>Dealer Details</h3>
                    <div class="aws-modal-row">
                        <span class="aws-modal-label">Dealer Code</span>
                        <span class="aws-modal-colon">:</span>
                        <span class="aws-modal-value">@_dealer.DealerCode</span>
                    </div>
                    <div class="aws-modal-row">
                        <span class="aws-modal-label">Name</span>
                        <span class="aws-modal-colon">:</span>
                        <span class="aws-modal-value">@_dealer.DealerName</span>
                    </div>
                    <div class="aws-modal-row">
                        <span class="aws-modal-label">Region</span>
                        <span class="aws-modal-colon">:</span>
                        <span class="aws-modal-value">@_dealer.State – @_dealer.Region</span>
                    </div>
                </div>

                <div class="aws-modal-section">
                    <h3>Beneficiary Details</h3>
                    <div class="aws-modal-row">
                        <span class="aws-modal-label">Beneficiary Group</span>
                        <span class="aws-modal-colon">:</span>
                        <span class="aws-modal-value">@(string.IsNullOrWhiteSpace(SelectedBeneficiaryGroup) ? "-" : SelectedBeneficiaryGroup)</span>
                    </div>
                    @if (SelectedBeneficiaryGroup == "Sub Dealer" && !string.IsNullOrWhiteSpace(SelectedSubDealerName))
                    {
                    <div class="aws-modal-row">
                        <span class="aws-modal-label">Sub Dealer</span>
                        <span class="aws-modal-colon">:</span>
                        <span class="aws-modal-value">@SelectedSubDealerName</span>
                    </div>
                    }
                    @if (SelectedBeneficiaryGroup == "Approved Employee" && !string.IsNullOrWhiteSpace(SelectedEmployeeName))
                    {
                    <div class="aws-modal-row">
                        <span class="aws-modal-label">Employee</span>
                        <span class="aws-modal-colon">:</span>
                        <span class="aws-modal-value">@SelectedEmployeeName</span>
                    </div>
                    }
                    <div class="aws-modal-row">
                        <span class="aws-modal-label">Nominee Name</span>
                        <span class="aws-modal-colon">:</span>
                        <span class="aws-modal-value">@(string.IsNullOrWhiteSpace(NomineeName) ? "-" : NomineeName)</span>
                    </div>
                    <div class="aws-modal-row">
                        <span class="aws-modal-label">Nominee Relationship</span>
                        <span class="aws-modal-colon">:</span>
                        <span class="aws-modal-value">@(string.IsNullOrWhiteSpace(NomineeRelationship) ? "-" : NomineeRelationship)</span>
                    </div>
                    @if (SelectedBeneficiaryGroup == "Direct Dealer")
                    {
                    <div class="aws-modal-row">
                        <span class="aws-modal-label">Beneficiary Name</span>
                        <span class="aws-modal-colon">:</span>
                        <span class="aws-modal-value">@(string.IsNullOrWhiteSpace(BeneficiaryName) ? "-" : BeneficiaryName)</span>
                    </div>
                    <div class="aws-modal-row">
                        <span class="aws-modal-label">Relationship</span>
                        <span class="aws-modal-colon">:</span>
                        <span class="aws-modal-value">@(string.IsNullOrWhiteSpace(BeneficiaryRelationship) ? (string.IsNullOrWhiteSpace(NomineeRelationship) ? "-" : NomineeRelationship) : BeneficiaryRelationship)</span>
                    </div>
                    }
                    <div class="aws-modal-row">
                        <span class="aws-modal-label">Quantity Lifted (Last Year)</span>
                        <span class="aws-modal-colon">:</span>
                        <span class="aws-modal-value">@QuantityLiftedDisplay</span>
                    </div>
                    <div class="aws-modal-row">
                        <span class="aws-modal-label">3-Year Average Quantity</span>
                        <span class="aws-modal-colon">:</span>
                        <span class="aws-modal-value">@(_salesHistory != null ? $"{_salesHistory.AverageQuantityLifted3Years:N2} MT" : "-")</span>
                    </div>
                </div>

                @if (SelectedScheme == "Medical Assistance")
                {
                <div class="aws-modal-section">
                    <h3>Medical Assistance Details</h3>
                    <div class="aws-modal-row">
                        <span class="aws-modal-label">Treatment / Medical Condition</span>
                        <span class="aws-modal-colon">:</span>
                        <span class="aws-modal-value">@(string.IsNullOrWhiteSpace(MedicalTreatmentType) ? "-" : MedicalTreatmentType)</span>
                    </div>
                </div>
                }

                @if (SelectedScheme == "Distinction Award")
                {
                <div class="aws-modal-section">
                    <h3>Distinction Award Details</h3>
                    <div class="aws-modal-row">
                        <span class="aws-modal-label">Candidate Name</span>
                        <span class="aws-modal-colon">:</span>
                        <span class="aws-modal-value">@(string.IsNullOrWhiteSpace(DistinctionCandidateName) ? "-" : DistinctionCandidateName)</span>
                    </div>
                    <div class="aws-modal-row">
                        <span class="aws-modal-label">Father Name</span>
                        <span class="aws-modal-colon">:</span>
                        <span class="aws-modal-value">@(string.IsNullOrWhiteSpace(DistinctionFatherName) ? "-" : DistinctionFatherName)</span>
                    </div>
                    <div class="aws-modal-row">
                        <span class="aws-modal-label">Professional Course</span>
                        <span class="aws-modal-colon">:</span>
                        <span class="aws-modal-value">@(string.IsNullOrWhiteSpace(DistinctionProfessionalCourse) ? "-" : DistinctionProfessionalCourse)</span>
                    </div>
                    <div class="aws-modal-row">
                        <span class="aws-modal-label">Course Completion Year</span>
                        <span class="aws-modal-colon">:</span>
                        <span class="aws-modal-value">@(string.IsNullOrWhiteSpace(DistinctionCourseYear) ? "-" : DistinctionCourseYear)</span>
                    </div>
                    <div class="aws-modal-row">
                        <span class="aws-modal-label">University / Institution</span>
                        <span class="aws-modal-colon">:</span>
                        <span class="aws-modal-value">@(string.IsNullOrWhiteSpace(DistinctionUniversityName) ? "-" : DistinctionUniversityName)</span>
                    </div>
                    <div class="aws-modal-row">
                        <span class="aws-modal-label">Maximum Marks</span>
                        <span class="aws-modal-colon">:</span>
                        <span class="aws-modal-value">@(DistinctionMaximumMarks > 0 ? DistinctionMaximumMarks.ToString() : "-")</span>
                    </div>
                    <div class="aws-modal-row">
                        <span class="aws-modal-label">Marks Obtained</span>
                        <span class="aws-modal-colon">:</span>
                        <span class="aws-modal-value">@(DistinctionMarksObtained > 0 ? DistinctionMarksObtained.ToString() : "-")</span>
                    </div>
                    <div class="aws-modal-row">
                        <span class="aws-modal-label">Aggregate Percentage</span>
                        <span class="aws-modal-colon">:</span>
                        <span class="aws-modal-value">@($"{DistinctionAggregatePercentage:F2}%")</span>
                    </div>
                    <div class="aws-modal-row">
                        <span class="aws-modal-label">Has Arrears</span>
                        <span class="aws-modal-colon">:</span>
                        <span class="aws-modal-value">@(DistinctionHasArrears == true ? "Yes" : "No")</span>
                    </div>
                    <div class="aws-modal-row">
                        <span class="aws-modal-label">Wholesale Dealer Employee (TN)</span>
                        <span class="aws-modal-colon">:</span>
                        <span class="aws-modal-value">@(DistinctionIsWholesaleEmployee == true ? "Yes" : "No")</span>
                    </div>
                </div>
                }

                <div class="aws-modal-section">
                    <h3>Documents Uploaded</h3>
                    @foreach (var doc in CurrentDocuments)
                    {
                        var uploaded = HasDocument(doc.Name);
                    <div class="aws-modal-row">
                        <span class="aws-modal-label">@doc.Name</span>
                        <span class="aws-modal-colon">:</span>
                        <span class="aws-modal-value">@(uploaded ? "Yes" : "No")</span>
                    </div>
                    }
                </div>

                <div class="aws-modal-section">
                    <h3>Declaration</h3>
                    <div class="aws-modal-row">
                        <span class="aws-modal-label">Confirmed</span>
                        <span class="aws-modal-colon">:</span>
                        <span class="aws-modal-value">Yes</span>
                    </div>
                </div>

            </div>

            <div class="aws-modal-footer">
                <button class="aws-btn-modal aws-btn-modal-outline" @onclick="ClosePreviewModal">Edit</button>
                <button class="aws-btn-modal aws-btn-modal-solid" @onclick="OpenSubmitModal">@(IsResubmissionMode ? "Confirm Resubmission" : "Submit Application")</button>
            </div>

        </div>
    </div>
}
@if (IsSubmitModalOpen)
{
    <div class="aws-submit-overlay" @onclick="CloseSubmitModal">
        <div class="aws-submit-modal" @onclick:stopPropagation="true">
            
