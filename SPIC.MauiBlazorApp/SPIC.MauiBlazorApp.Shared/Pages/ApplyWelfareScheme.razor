    <div class="aws-section-card">
        
        <div class="aws-section-header">
            <span class="aws-step-number">2</span>
            <h2>Quantity Lifted</h2>
        </div>

        <div class="aws-form-grid-2col">
            
     
            
            <div class="aws-form-group">
                <label class="aws-form-label">Quantity Lifted during Last Year (MT) *</label>
                @if (_isLoadingSalesHistory)
                {
                    <select class="aws-form-select" disabled>
                        <option value="" disabled selected hidden>Loading sales data...</option>
                    </select>
                }
                else
                {
                    <select class="aws-form-select" @bind="QuantityLiftedInput">
                        <option value="" disabled selected hidden>--Select--</option>
                        @if (!string.IsNullOrWhiteSpace(QuantityLiftedInput) &&
                             !QuantityOptions.Any(o => string.Equals(o.Key, QuantityLiftedInput.Trim(), StringComparison.OrdinalIgnoreCase)))
                        {
                            <option value="@QuantityLiftedInput">@QuantityLiftedInput MT</option>
                        }
                        @foreach (var opt in QuantityOptions)
                        {
                            <option value="@opt.Key">@opt.Label</option>
                        }
                    </select>
                }
            </div>

            <div class="aws-form-group">
                <label class="aws-form-label">3-Year Average Quantity (MT)</label>
                <input type="text" class="aws-input-readonly" value="@(_salesHistory != null ? $"{_salesHistory.AverageQuantityLifted3Years:N2} MT" : "-")" readonly>
            </div>

        </div>

        <div class="aws-alert-info">
            <div class="aws-alert-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="16" x2="12" y2="12"></line>
                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                </svg>
            </div>
            <div>
                Quantity is automatically calculated from your CreditLimitSales history. Your current lifted quantity will be auto-verified on submission.
            </div>
        </div>

    </div>

