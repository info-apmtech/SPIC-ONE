@code {
    private bool IsPreviewModalOpen { get; set; } = false;
    private bool IsSubmitModalOpen { get; set; } = false;
    private bool IsSuccessModalOpen { get; set; } = false;

    private void OpenPreviewModal()
    {
        IsPreviewModalOpen = true;
    }

    private void ClosePreviewModal()
    {
        IsPreviewModalOpen = false;
    }

    private void OpenSubmitModal()
    {
        IsPreviewModalOpen = false;
        IsSubmitModalOpen = true;
    }

    private void CloseSubmitModal()
    {
        IsSubmitModalOpen = false;
    }

    private void ConfirmSubmission()
    {
     
        IsSubmitModalOpen = false;
        IsSuccessModalOpen = true;
    }

    private void CloseSuccessModal()
    {
        IsSuccessModalOpen = false;
    }
}