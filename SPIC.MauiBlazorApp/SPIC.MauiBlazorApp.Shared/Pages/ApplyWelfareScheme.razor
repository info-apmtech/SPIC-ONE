        <div class="aws-modal" @onclick:stopPropagation="true">
            
            <div class="aws-modal-header">
                <div class="aws-modal-title">
                    <h2>Apply for Grahapravesam</h2>
                    <p>Review your details before submitting the application.</p>
                </div>
                <button class="aws-modal-close" @onclick="ClosePreviewModal" aria-label="Close">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="15" y1="9" x2="9" y2="15"></line>
                        <line x1="9" y1="9" x2="15" y2="15"></line>
                    </svg>
                </button>
            </div>

            <div class="aws-modal-body">
                
                <div class="aws-modal-section">
                    <h3>Scheme</h3>
                    <div class="aws-modal-row">
                        <span class="aws-modal-label">Selected Scheme</span>
                        <span class="aws-modal-value">Grahapravesam</span>
                    </div>
                    <div class="aws-modal-row">
                        <span class="aws-modal-label">Maximum Benefit</span>
                        <span class="aws-modal-value aws-text-green">₹25,000</span>
                    </div>
                </div>

                <div class="aws-modal-section">
                    <h3>Dealer Details</h3>
                    <div class="aws-modal-row">
                        <span class="aws-modal-label">Dealer Code</span>
                        <span class="aws-modal-value">DLR-TN-04782</span>
                    </div>
                    <div class="aws-modal-row">
                        <span class="aws-modal-label">Name</span>
                        <span class="aws-modal-value">Rajesh Kumar</span>
                    </div>
                    <div class="aws-modal-row">
                        <span class="aws-modal-label">Region</span>
                        <span class="aws-modal-value">Tamil Nadu - Southern</span>
                    </div>
                </div>

                <div class="aws-modal-section">
                    <h3>Documents Uploaded</h3>
                    <div class="aws-modal-row">
                        <span class="aws-modal-label">Invitation Card</span>
                        <span class="aws-modal-value">Yes</span>
                    </div>
                    <div class="aws-modal-row">
                        <span class="aws-modal-label">Ownership Proof</span>
                        <span class="aws-modal-value">Yes</span>
                    </div>
                    <div class="aws-modal-row">
                        <span class="aws-modal-label">Dealer ID</span>
                        <span class="aws-modal-value">Yes</span>
                    </div>
                    <div class="aws-modal-row">
                        <span class="aws-modal-label">Address Proof</span>
                        <span class="aws-modal-value">Yes</span>
                    </div>
                </div>

                <div class="aws-modal-section">
                    <h3>Declaration</h3>
                    <div class="aws-modal-row">
                        <span class="aws-modal-label">Confirmed</span>
                        <span class="aws-modal-value">Yes</span>
                    </div>
                </div>

            </div>

            <div class="aws-modal-footer">
                <button class="aws-btn-modal aws-btn-modal-outline" @onclick="ClosePreviewModal">Edit</button>
                <button class="aws-btn-modal aws-btn-modal-solid" @onclick="OpenSubmitModal">Submit Application</button>
            </div>

        </div>
    </div>
}
@if (IsSubmitModalOpen)
{
    <div class="aws-submit-overlay" @onclick="CloseSubmitModal">
        <div class="aws-submit-modal" @onclick:stopPropagation="true">
            
            <div class="aws-submit-icon">
                <img src="_content/SPIC.MauiBlazorApp.Shared/Images/WelfareSchemes/SubmitIcon.png" alt="Medical Assistance" />
            </div>

            <h2 class="aws-submit-title">Submit Application</h2>
            <p class="aws-submit-subtitle">Once submitted, your application will be sent to the MO for review. This action cannot be undone.</p>

            <div class="aws-submit-info-box">
                <div class="aws-submit-info-row">
                    <span class="aws-submit-info-label">Scheme</span>
                    <span class="aws-submit-info-value">Grahapravesam</span>
                </div>
                <div class="aws-submit-divider"></div>
                <div class="aws-submit-info-row">
                    <span class="aws-submit-info-label">Dealer</span>
                    <span class="aws-submit-info-value">Rajesh Kumar</span>
                </div>
            </div>

            <div class="aws-submit-actions">
                <button class="aws-submit-btn aws-submit-btn-cancel" @onclick="CloseSubmitModal">Cancel</button>
                <button class="aws-submit-btn aws-submit-btn-confirm" @onclick="ConfirmSubmission">Confirm</button>
            </div>

        </div>
    </div>
}
