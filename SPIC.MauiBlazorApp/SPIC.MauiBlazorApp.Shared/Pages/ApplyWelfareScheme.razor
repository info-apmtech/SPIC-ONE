    private Dictionary<string, IBrowserFile> UploadedFiles { get; set; } = new(StringComparer.OrdinalIgnoreCase);

    private async Task HandleFileUpload(string docName, InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        if (file.Size > 5 * 1024 * 1024)
        {
            return;
        }

        var ext = Path.GetExtension(file.Name).ToLowerInvariant();
        if (ext is not (".pdf" or ".jpg" or ".jpeg" or ".png"))
        {
            return;
        }

        UploadedFiles[docName] = file;
        StateHasChanged();
    }

    private void RemoveUploadedFile(string docName)
    {
        UploadedFiles.Remove(docName);
        StateHasChanged();
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }

    private bool IsPreviewModalOpen { get; set; } = false;
