@page "/ApplyWelfareScheme"

<div class="container-fluid py-4 px-0">
    
    <div class="aws-header-container">
        <h1>Apply for Grahapravesam</h1>
        <p>Complete the form and upload required documents. Your progress is auto-saved.</p>
    </div>
    <div class="aws-eligibility-box">
        <div class="aws-eligibility-header">
            
            <div class="aws-eligibility-icon">
                <img src="_content/SPIC.MauiBlazorApp.Shared/Images/WelfareSchemes/Eligible.png" />
            </div>
            
            <div class="aws-eligibility-title-group">
                <h3 class="aws-eligibility-title">Eligibility Conditions</h3>
                <p class="aws-eligibility-subtitle">Please ensure you meet all the following criteria for Grahapravesam</p>
            </div>
        </div>
        
        <ul class="aws-eligibility-list">
            <li>Minimum one year SPIC dealership</li>
            <li>Minimum average annual sales of 100 MT fertilizers in the last 3 years</li>
            <li>Market Share TN Dealers - 50%; KN & AP Dealers - 30%</li>
        </ul>
    </div>

    <div class="di-wrapper">
        
        <div class="di-header">
            <div class="di-header-left">
                <div class="di-main-icon">
                    <img src="_content/SPIC.MauiBlazorApp.Shared/Images/WelfareSchemes/TwoLeaf.png" alt="Dealer Icon" onerror="this.style.display='none'; this.nextElementSibling.style.display='inline';" />
                    <span style="font-size: 20px; display: none;">🌱</span>
                </div>
                <div class="di-title-group">
                    <h2 class="di-title">S S AGRO CENTRE</h2>
                    <p class="di-subtitle">Dealer Information Overview</p>
                </div>
            </div>
            <div class="di-badge">DL-223331</div>
        </div>

        <div class="di-cards-container">
            
            <div class="di-card">
                <div class="di-card-content">
                    <h3>Location Info</h3>
                    
                    <div class="di-info-row">
                        <div class="di-info-item with-divider">
                            <div class="di-icon-wrap">
                                <img src="_content/SPIC.MauiBlazorApp.Shared/Images/WelfareSchemes/State.png" />
                            </div>
                            <div class="di-info-text">
                                <span class="di-info-label">State:</span>
                                <span class="di-info-value">Tamil Nadu</span>
                            </div>
                        </div>
                        <div class="di-info-item">
                            <div class="di-icon-wrap">
                                <img src="_content/SPIC.MauiBlazorApp.Shared/Images/WelfareSchemes/Region.png" />
                            </div>
                            <div class="di-info-text">
                                <span class="di-info-label">Region:</span>
                                <span class="di-info-value">Southern</span>
                            </div>
                        </div>
                    </div>

                    <div class="di-info-row">
                        <div class="di-info-item with-divider">
                            <div class="di-icon-wrap">
                                <img src="_content/SPIC.MauiBlazorApp.Shared/Images/WelfareSchemes/District.png" />
                            </div>
                            <div class="di-info-text">
                                <span class="di-info-label">District:</span>
                                <span class="di-info-value">Chennai</span>
                            </div>
                        </div>
                        <div class="di-info-item">
                            <div class="di-icon-wrap">
                                <img src="_content/SPIC.MauiBlazorApp.Shared/Images/WelfareSchemes/HeadQuarters.png" />
                            </div>
                            <div class="di-info-text">
                                <span class="di-info-label">Head Quarters:</span>
                                <span class="di-info-value">Chennai</span>
                            </div>
                        </div>
                    </div>
                </div>

                <svg class="di-wave-bg" viewBox="0 0 500 100" preserveAspectRatio="none">
                    <path d="M0,70 C200,120 400,-10 500,70 L500,100 L0,100 Z" fill="#e0eee0" opacity="0.7"></path>
                </svg>
            </div>

            <div class="di-card">
                <div class="di-card-content">
                    <h3>Personal Info</h3>
                    
                    <div class="di-info-row">
                        <div class="di-info-item with-divider">
                            <div class="di-icon-wrap">
                                <img src="_content/SPIC.MauiBlazorApp.Shared/Images/WelfareSchemes/Profile.png" />
                            </div>
                            <div class="di-info-text">
                                <span class="di-info-label">Full Name:</span>
                                <span class="di-info-value">Rajesh</span>
                            </div>
                        </div>
                        <div class="di-info-item flex-1-5 with-divider">
                            <div class="di-icon-wrap">
                                <img src="_content/SPIC.MauiBlazorApp.Shared/Images/WelfareSchemes/Email.png" />
                            </div>
                            <div class="di-info-text">
                                <span class="di-info-label">Email:</span>
                                <span class="di-info-value" style="word-break: break-all;">example@gmail.com</span>
                            </div>
                        </div>
                        <div class="di-info-item">
                            <div class="di-icon-wrap">
                                <img src="_content/SPIC.MauiBlazorApp.Shared/Images/WelfareSchemes/Phone.png" />
                            </div>
                            <div class="di-info-text">
                                <span class="di-info-label">Phone:</span>
                                <span class="di-info-value">9876543210</span>
                            </div>
                        </div>
                    </div>

                    <div class="di-info-row">
                        <div class="di-info-item">
                            <div class="di-icon-wrap">
                                <img src="_content/SPIC.MauiBlazorApp.Shared/Images/WelfareSchemes/Location.png" />
                            </div>
                            <div class="di-info-text">
                                <span class="di-info-label">Address:</span>
                                <span class="di-info-value">No.2, SPIC House, Chennai.</span>
                            </div>
                        </div>
                    </div>
                </div>

                <svg class="di-wave-bg" viewBox="0 0 500 100" preserveAspectRatio="none">
                    <path d="M0,70 C200,120 400,-10 500,70 L500,100 L0,100 Z" fill="#e0eee0" opacity="0.7"></path>
                </svg>
            </div>

        </div>
    </div>
