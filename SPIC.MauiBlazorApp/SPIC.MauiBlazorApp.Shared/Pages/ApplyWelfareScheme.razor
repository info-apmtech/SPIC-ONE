@code {
    [SupplyParameterFromQuery(Name = "scheme")]
    private string? Scheme { get; set; }

    private string SelectedScheme => string.IsNullOrWhiteSpace(Scheme) ? "Grahapravesam" : Uri.UnescapeDataString(Scheme);

    private static readonly Dictionary<string, List<string>> EligibilityConditionsMap = new(StringComparer.OrdinalIgnoreCase)
    {
        ["Wedding"] = new List<string>
        {
            "Minimum one year SPIC dealership",
            "Minimum average annual sales of 100 MT fertilizers in the last 3 years"
        },
        ["Sathabhishekam"] = new List<string>
        {
            "Minimum one year SPIC dealership",
            "No specific volume lifting"
        },
        ["Grahapravesam"] = new List<string>
        {
            "Minimum one year SPIC dealership",
            "Minimum average annual sales of 100 MT fertilizers in the last 3 years",
            "Market Share TN Dealers - 50%; KN & AP Dealers - 30%"
        },
        ["Educational Assistance"] = new List<string>
        {
            "Minimum one year SPIC dealership",
            "Minimum average annual sales of 100 MT fertilizers in the last 3 years",
            "No arrears / backlogs for the current application",
            "Students should pass in all subjects for renewal of their Educational Assistance",
            "Proposal to be submitted within 3 months from the date of fees receipt",
            "Hostel expenses / Caution Deposit / Others/Misc. will not be considered for educational assistance",
            "Market Share TN Dealers - 50%; KN & AP Dealers - 30%"
        },
        ["Medical Assistance"] = new List<string>
        {
            "Minimum one year SPIC dealership",
            "Minimum average annual sales of 100 MT fertilizers in the last 3 years",
            "Market Share TN Dealers - 50%; KN & AP Dealers - 30%"
        },
        ["Death Relief"] = new List<string>
        {
            "Minimum one year SPIC dealership",
            "Minimum average annual sales of 100 MT in the last 3 years",
            "TN Dealers - 50%; KN & AP Dealers - 30%"
        },
        ["Distinction Award"] = new List<string>
        {
            "Distinction award for completing Professional Courses without any arrears and scored more than 80% aggregate.",
            "Wholesale Dealer's approved Employees (only for TN).",
            "Employees shall be eligible for 50% of dealer member's eligibility on their schemes."
        }
    };

    private List<string> CurrentEligibilityConditions =>
        EligibilityConditionsMap.TryGetValue(SelectedScheme, out var conditions) ? conditions : new List<string>();

    private string EduCourse { get; set; } = string.Empty;
    private string EduYear { get; set; } = string.Empty;
    private string EduCollegeName { get; set; } = string.Empty;
    private int? EduTotalCourses { get; set; }
    private bool IsEduFirstApplication { get; set; } = true;

    private string MedicalTreatmentType { get; set; } = string.Empty;
    private string QuantityLiftedValue { get; set; } = string.Empty;

    private void OnEduAppTypeChanged(ChangeEventArgs e)
    {
        IsEduFirstApplication = e.Value?.ToString() == "first";
    }

    private string MeritCandidateName { get; set; } = string.Empty;
    private string MeritFatherName { get; set; } = string.Empty;
    private string MeritExamination { get; set; } = string.Empty;
    private string MeritBoardName { get; set; } = string.Empty;
    private int MeritMaximumMarks { get; set; }
    private int MeritMarksObtained { get; set; }
    private double MeritPercentage { get; set; }

    private void CalculatePercentage()
    {
        if (MeritMaximumMarks > 0)
        {
            MeritPercentage = (double)MeritMarksObtained / MeritMaximumMarks * 100;
        }
        else
        {
            MeritPercentage = 0;
        }
    }

    private string DistinctionCandidateName { get; set; } = string.Empty;
    private string DistinctionFatherName { get; set; } = string.Empty;
    private string DistinctionProfessionalCourse { get; set; } = string.Empty;
    private string DistinctionCourseYear { get; set; } = string.Empty;
    private string DistinctionUniversityName { get; set; } = string.Empty;
    private int DistinctionMaximumMarks { get; set; }
    private int DistinctionMarksObtained { get; set; }
    private double DistinctionAggregatePercentage { get; set; }
    private bool? DistinctionHasArrears { get; set; }
    private bool? DistinctionIsWholesaleEmployee { get; set; }

    private void CalculateDistinctionPercentage()
    {
        if (DistinctionMaximumMarks > 0)
        {
            DistinctionAggregatePercentage = (double)DistinctionMarksObtained / DistinctionMaximumMarks * 100;
        }
        else
        {
            DistinctionAggregatePercentage = 0;
        }
    }

    private void SimulateAdmissionCertificateUpload()
    {
        IsAdmissionCertificateUploaded = true;
    }

    private void RemoveAdmissionCertificate()
    {
        IsAdmissionCertificateUploaded = false;
    }

    private bool IsPreviewModalOpen { get; set; } = false;
    private bool IsSubmitModalOpen { get; set; } = false;
    private bool IsSuccessModalOpen { get; set; } = false;
    private bool IsAdmissionCertificateUploaded { get; set; } = false;
    private bool ShowValidation { get; set; } = false;
    private List<string> ValidationErrors { get; set; } = new();

    private void OpenPreviewModal()
    {
        ShowValidation = false;
        ValidationErrors.Clear();
        IsPreviewModalOpen = true;
    }

    private void ClosePreviewModal()
    {
        IsPreviewModalOpen = false;
    }

    private void OpenSubmitModal()
    {
        IsPreviewModalOpen = false;
        IsSubmitModalOpen = true;
    }

    private void CloseSubmitModal()
    {
        IsSubmitModalOpen = false;
    }

    private void ConfirmSubmission()
    {
        if (SelectedScheme == "Medical Assistance")
        {
            var errors = new List<string>();

            if (string.IsNullOrWhiteSpace(MedicalTreatmentType))
                errors.Add("Treatment / Medical Condition is required.");

            if (errors.Any())
            {
                ValidationErrors = errors;
                ShowValidation = true;
                return;
            }
        }

        if (SelectedScheme == "Educational Assistance")
        {
            var errors = new List<string>();

            if (!EduTotalCourses.HasValue || EduTotalCourses.Value <= 0)
                errors.Add("Total Number of Courses is required.");

            if (string.IsNullOrWhiteSpace(EduCourse))
                errors.Add("Course is required.");

            if (string.IsNullOrWhiteSpace(EduYear))
                errors.Add("Year is required.");

            if (string.IsNullOrWhiteSpace(EduCollegeName))
                errors.Add("College Name is required.");

            if (IsEduFirstApplication && !IsAdmissionCertificateUploaded)
                errors.Add("Admission Certificate is mandatory for first-time applications.");

            if (errors.Any())
            {
                ValidationErrors = errors;
                ShowValidation = true;
                return;
            }
        }

        if (SelectedScheme == "Distinction Award")
        {
            var errors = new List<string>();

            if (string.IsNullOrWhiteSpace(DistinctionCandidateName))
                errors.Add("Candidate Name is required.");

            if (string.IsNullOrWhiteSpace(DistinctionProfessionalCourse))
                errors.Add("Professional Course Name is required.");

            if (DistinctionMaximumMarks <= 0)
                errors.Add("Total / Maximum Marks must be greater than zero.");

            if (DistinctionMarksObtained <= 0)
                errors.Add("Marks Obtained must be greater than zero.");

            if (DistinctionMaximumMarks > 0 && DistinctionMarksObtained > DistinctionMaximumMarks)
                errors.Add("Marks Obtained cannot exceed Total / Maximum Marks.");

            if (DistinctionMaximumMarks > 0 && DistinctionAggregatePercentage <= 80)
                errors.Add("Aggregate percentage must be more than 80% to qualify for the Distinction Award.");

            if (DistinctionHasArrears == true)
                errors.Add("Candidates with arrears / backlogs are not eligible for the Distinction Award.");

            if (errors.Any())
            {
                ValidationErrors = errors;
                ShowValidation = true;
                return;
            }
        }

        ShowValidation = false;
        ValidationErrors.Clear();
        IsSubmitModalOpen = false;
        IsSuccessModalOpen = true;
    }

    private void CloseSuccessModal()
    {
        IsSuccessModalOpen = false;
    }
