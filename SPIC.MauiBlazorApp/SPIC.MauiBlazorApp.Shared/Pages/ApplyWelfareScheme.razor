    <div class="aws-section-card">
        
        <div class="aws-section-header">
            <span class="aws-step-number">2</span>
            <h2>Quantity Lifted</h2>
        </div>

        <div class="aws-form-grid-2col">
            
     
            
            <div class="aws-form-group">
                <label class="aws-form-label">Quantity Lifted during Last Year (MT) *</label>
                @if (_isLoadingSalesHistory)
                {
                    <select class="aws-form-select" disabled>
                        <option value="" disabled selected hidden>Loading sales data...</option>
                    </select>
                }
                else
                {
                    <select class="aws-form-select" @bind="QuantityLiftedValue" disabled>
                        <option value="" disabled selected hidden>--Select--</option>
                        <option value="lt1000">&lt;1,000 MT</option>
                        <option value="gt1000">&gt;1,000 MT</option>
                        <option value="5001-10000">5,001 to 10,000 MT</option>
                        <option value="10001-25000">10,001 to 25,000 MT</option>
                        <option value="25001-35000">25,001 to 35,000 MT</option>
                        <option value="35001-50000">35,001 to 50,000 MT</option>
                        <option value="gt50001">&gt;50,001 MT</option>
                    </select>
                }
            </div>

            <div class="aws-form-group">
                <label class="aws-form-label">3-Year Average Quantity (MT)</label>
                <input type="text" class="aws-input-readonly" value="@(_salesHistory != null ? $"{_salesHistory.AverageQuantityLifted3Years:N2} MT" : "-")" readonly>
            </div>

        </div>

        <div class="aws-alert-info">
            <div class="aws-alert-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="16" x2="12" y2="12"></line>
                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                </svg>
            </div>
            <div>
                Quantity is automatically calculated from your CreditLimitSales history. Your current lifted quantity will be auto-verified on submission.
            </div>
        </div>

    </div>

    <div class="aws-section-card">
        
        <div class="aws-section-header">
            <span class="aws-step-number">3</span>
            <h2>Beneficiary Details</h2>
        </div>

        <div class="aws-form-grid">

            <div class="aws-form-group">
                <label class="aws-form-label">Select Beneficiary Group *</label>
                <select class="aws-form-select" @bind="SelectedBeneficiaryGroup" @bind:after="OnBeneficiaryGroupChanged">
                    <option value="" disabled selected hidden>--Select--</option>
                    <option value="Direct Dealer">Direct Dealer</option>
                    <option value="Sub Dealer">Sub Dealer</option>
                    <option value="Approved Employee">Approved Employee</option>
                </select>
            </div>

        </div>

        @if (!string.IsNullOrEmpty(BeneficiaryGroupError))
        {
        <div class="aws-alert-info" style="border-color: #e74c3c; background: #fff5f5; margin-top: 16px;">
            <div class="aws-alert-icon" style="color: #e74c3c;">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="15" y1="9" x2="9" y2="15"></line>
                    <line x1="9" y1="9" x2="15" y2="15"></line>
                </svg>
            </div>
            <div style="color: #c0392b;">
                @BeneficiaryGroupError
            </div>
        </div>
        }

        @if (SelectedBeneficiaryGroup == "Direct Dealer")
        {
        <div class="aws-form-grid">

            <div class="aws-form-group">
                <label class="aws-form-label">Nominee Name *</label>
                <input type="text" class="aws-form-control" placeholder="Nominee's Full Name" @bind="NomineeName">
            </div>

            <div class="aws-form-group">
                <label class="aws-form-label">Nominee Relationship *</label>
                <select class="aws-form-select" @bind="NomineeRelationship">
                    <option value="" disabled selected hidden>Select relationship</option>
                    <option value="Spouse">Spouse</option>
                    <option value="Child">Child</option>
                    <option value="Parent">Parent</option>
                </select>
            </div>

            <div class="aws-form-group">
                <label class="aws-form-label">Select Beneficiary</label>
                <select class="aws-form-select">
                    <option value="" selected>Add new beneficiary</option>
                </select>
            </div>
            
            <div class="aws-form-group">
                <label class="aws-form-label">Beneficiary Name *</label>
                <input type="text" class="aws-form-control" placeholder="Full Name" @bind="BeneficiaryName">
            </div>
            
            <div class="aws-form-group">
                <label class="aws-form-label">Relationship *</label>
                <select class="aws-form-select" @bind="BeneficiaryRelationship">
                    <option value="" disabled selected hidden>Select relationship</option>
                    <option value="Spouse">Spouse</option>
                    <option value="Child">Child</option>
                    <option value="Parent">Parent</option>
                </select>
            </div>

            <div class="aws-form-group">
                <label class="aws-form-label">Date of Birth</label>
                <div class="aws-input-with-icon">
                    <input type="text" class="aws-form-control" placeholder="dd-mm-yyyy" @bind="BeneficiaryDOB">
                    <svg class="aws-input-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                </div>
            </div>
            
            <div class="aws-form-group">
                <label class="aws-form-label">Age</label>
                <input type="text" class="aws-form-control" placeholder="Age in years" @bind="BeneficiaryAge">
            </div>

        </div>
        }
        else if (SelectedBeneficiaryGroup == "Sub Dealer")
        {
        <div class="aws-form-grid">

            <div class="aws-form-group">
                <label class="aws-form-label">Sub Dealer Name *</label>
                @if (_isLoadingSubDealers)
                {
                    <select class="aws-form-select" disabled>
                        <option value="" disabled selected hidden>Loading sub-dealers...</option>
                    </select>
                }
                else
                {
                    <select class="aws-form-select" @bind="SelectedSubDealerId" @bind:after="OnSubDealerSelected">
                        <option value="" disabled selected hidden>--Select Sub Dealer--</option>
                        @foreach (var sd in _subDealers)
                        {
                            <option value="@sd.Id">@sd.FirmName (@sd.SubDealerCode)</option>
                        }
                    </select>
                }
            </div>

            <div class="aws-form-group">
                <label class="aws-form-label">Nominee Name *</label>
                <input type="text" class="aws-form-control" placeholder="Nominee's Full Name" @bind="NomineeName">
            </div>

            <div class="aws-form-group">
                <label class="aws-form-label">Nominee Relationship *</label>
                <select class="aws-form-select" @bind="NomineeRelationship">
                    <option value="" disabled selected hidden>Select relationship</option>
                    <option value="Spouse">Spouse</option>
                    <option value="Child">Child</option>
                    <option value="Parent">Parent</option>
                </select>
            </div>

            <div class="aws-form-group">
                <label class="aws-form-label">Beneficiary Name *</label>
                <input type="text" class="aws-form-control" placeholder="Full Name" @bind="BeneficiaryName">
            </div>

        </div>
        }
        else if (SelectedBeneficiaryGroup == "Approved Employee")
        {
        <div class="aws-form-grid">

            <div class="aws-form-group">
                <label class="aws-form-label">Employee Name *</label>
                @if (_isLoadingEmployees)
                {
                    <select class="aws-form-select" disabled>
                        <option value="" disabled selected hidden>Loading employees...</option>
                    </select>
                }
                else
                {
                    <select class="aws-form-select" @bind="SelectedEmployeeId" @bind:after="OnEmployeeSelected">
                        <option value="" disabled selected hidden>--Select Employee--</option>
                        @foreach (var emp in _employees)
                        {
                            <option value="@emp.Id">@emp.EmployeeName (@emp.EmployeeCode)</option>
                        }
                    </select>
                }
            </div>

            <div class="aws-form-group">
                <label class="aws-form-label">Nominee Name *</label>
                <input type="text" class="aws-form-control" placeholder="Nominee's Full Name" @bind="NomineeName">
            </div>

            <div class="aws-form-group">
                <label class="aws-form-label">Nominee Relationship *</label>
                <select class="aws-form-select" @bind="NomineeRelationship">
                    <option value="" disabled selected hidden>Select relationship</option>
                    <option value="Spouse">Spouse</option>
                    <option value="Child">Child</option>
                    <option value="Parent">Parent</option>
                </select>
            </div>

            <div class="aws-form-group">
                <label class="aws-form-label">Beneficiary Name *</label>
                <input type="text" class="aws-form-control" placeholder="Full Name" @bind="BeneficiaryName">
            </div>

        </div>
        }

    </div>
    <div class="aws-section-card">
        
        <div class="aws-section-header">
            <span class="aws-step-number">4</span>
            <h2>@SchemeDetailsTitle</h2>
        </div>

        @if (SelectedScheme == "Wedding")
        {
        <div class="aws-form-grid-2col">
            <div class="aws-form-group">
                <label class="aws-form-label">Wedding Date</label>
                <div class="aws-input-with-icon">
                    <input type="text" class="aws-form-control" placeholder="dd-mm-yyyy">
                    <svg class="aws-input-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                </div>
            </div>
            <div class="aws-form-group">
                <label class="aws-form-label">Event Venue</label>
                <textarea class="aws-form-control" placeholder="Venue name or address" rows="3"></textarea>
            </div>
        </div>
        }
        else if (SelectedScheme == "Sathabhishekam")
        {
        <div class="aws-form-grid-2col">
            <div class="aws-form-group">
                <label class="aws-form-label">Event Date</label>
                <div class="aws-input-with-icon">
                    <input type="text" class="aws-form-control" placeholder="dd-mm-yyyy">
                    <svg class="aws-input-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                </div>
            </div>
            <div class="aws-form-group">
                <label class="aws-form-label">Event Venue</label>
                <textarea class="aws-form-control" placeholder="Venue name or address" rows="3"></textarea>
            </div>
        </div>
        }
        else if (SelectedScheme == "Grahapravesam")
        {
        <div class="aws-form-grid-2col">
            <div class="aws-form-group">
                <label class="aws-form-label">Housewarming Date</label>
                <div class="aws-input-with-icon">
                    <input type="text" class="aws-form-control" placeholder="dd-mm-yyyy">
                    <svg class="aws-input-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                </div>
            </div>
            <div class="aws-form-group">
                <label class="aws-form-label">Ownership Type</label>
                <select class="aws-form-select">
                    <option value="" disabled selected hidden>Select Ownership Type</option>
                    <option value="owned">Owned</option>
                    <option value="rented">Rented</option>
                </select>
            </div>
        </div>
        <div class="aws-form-grid-2col" style="margin-top: 24px; margin-bottom: 0;">
            <div class="aws-form-group">
                <label class="aws-form-label">Event Venue (if different from house address)</label>
                <textarea class="aws-form-control" placeholder="Venue name or address" rows="3"></textarea>
            </div>
        </div>
        }
        else if (SelectedScheme == "Death Relief")
        {
        <div class="aws-form-grid-2col">
            <div class="aws-form-group">
                <label class="aws-form-label">Date of Death</label>
                <div class="aws-input-with-icon">
                    <input type="text" class="aws-form-control" placeholder="dd-mm-yyyy">
                    <svg class="aws-input-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                </div>
            </div>
            <div class="aws-form-group">
                <label class="aws-form-label">Legal Heir Name</label>
                <input type="text" class="aws-form-control" placeholder="Full Name of Legal Heir">
            </div>
            <div class="aws-form-group">
                <label class="aws-form-label">Relationship to Dealer</label>
                <select class="aws-form-select">
                    <option value="" disabled selected hidden>Select relationship</option>
                    <option value="spouse">Spouse</option>
                    <option value="child">Child</option>
                    <option value="parent">Parent</option>
                </select>
            </div>
            <div class="aws-form-group">
                <label class="aws-form-label">Cause of Death</label>
                <input type="text" class="aws-form-control" placeholder="e.g. Natural, Illness, Accident">
            </div>
        </div>
        }
        else if (SelectedScheme == "Educational Assistance")
        {
        <div class="aws-form-grid">
            <div class="aws-form-group">
                <label class="aws-form-label">Application Type</label>
                <div style="display: flex; gap: 16px; margin-top: 4px;">
                    <label style="display: flex; align-items: center; gap: 6px; cursor: pointer;">
                        <input type="radio" name="eduAppType" value="first" checked="@IsEduFirstApplication" @onchange="OnEduAppTypeChanged" />
                        <span>First Application</span>
                    </label>
                    <label style="display: flex; align-items: center; gap: 6px; cursor: pointer;">
                        <input type="radio" name="eduAppType" value="renewal" checked="@(!IsEduFirstApplication)" @onchange="OnEduAppTypeChanged" />
                        <span>Renewal</span>
                    </label>
                </div>
            </div>
            <div class="aws-form-group">
                <label class="aws-form-label">Total Number of Courses (Duration in Years)</label>
                <input type="number" class="aws-form-control" placeholder="e.g. 4" @bind="EduTotalCourses" min="1" max="10">
            </div>
            <div class="aws-form-group">
                <label class="aws-form-label">Course</label>
