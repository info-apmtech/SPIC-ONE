@code {
    private string activeTab = "all";
    private bool modalOpen = false;
    private string currentModalState = "pending"; // "pending", "processing", "released", or "cancelled"
    
    // Dialog State Variables
    private bool showConfirmVerifyModal = false;
    private bool showSuccessVerifyModal = false;
    
    private bool showConfirmCancelModal = false;
    private bool showSuccessCancelModal = false;
    
    private bool showConfirmReinitiateModal = false;
    private bool showSuccessReinitiateModal = false;

    // Side Drawer Modal
    private void OpenModal(string state)
    {
        currentModalState = state;
        modalOpen = true;
    }
    private void CloseModal() => modalOpen = false;
    
    // --- VERIFICATION FLOW ---
    private void OpenConfirmVerify()
    {
        showConfirmVerifyModal = true;
        modalOpen = false;
    }
    private void CloseConfirmVerify() => showConfirmVerifyModal = false;
    private void SubmitVerification()
    {
        showConfirmVerifyModal = false;
        showSuccessVerifyModal = true;
    }
    private void CloseSuccessVerify() => showSuccessVerifyModal = false;

    // --- CANCELLATION FLOW ---
    private void OpenConfirmCancel()
    {
        showConfirmCancelModal = true;
        modalOpen = false;
    }
    private void CloseConfirmCancel()
    {
        showConfirmCancelModal = false;
        modalOpen = true; // Optionally reopen the side drawer
    }
    private void SubmitCancellation()
    {
        showConfirmCancelModal = false;
        showSuccessCancelModal = true;
    }
    private void CloseSuccessCancel() => showSuccessCancelModal = false;

    // --- RE-INITIATION FLOW ---
    private void OpenConfirmReinitiate()
    {
        showConfirmReinitiateModal = true;
        modalOpen = false;
    }
    private void CloseConfirmReinitiate()
    {
        showConfirmReinitiateModal = false;
        modalOpen = true;
    }
    private void SubmitReinitiation()
    {
        showConfirmReinitiateModal = false;
        showSuccessReinitiateModal = true;
    }
    private void CloseSuccessReinitiate() => showSuccessReinitiateModal = false;


    // Helper to map "All" tab table status -> modal state string
    private string GetStateFromStatus(string status)
    {
        if (status.Contains("Pending")) return "pending";
        if (status.Contains("Processing")) return "processing";
        if (status.Contains("Released")) return "released";
        return "cancelled";
    }

    private const string Avatar1 = "https://i.pravatar.cc/40?img=12";
    private const string Avatar2 = "https://i.pravatar.cc/40?img=33";
    private const string Avatar3 = "https://i.pravatar.cc/40?img=51";

    private string GetTitle() => activeTab switch
    {
        "pending" => "Pending Application List",
        "processing" => "Payment Processing List",
        "released" => "Released Payments List",
        "cancelled" => "Cancelled Payment List",
        _ => "Applications List"
    };

    private record AllRow(string AppId, string DealerCode, string DealerName, string Avatar, string Scheme, string Amount, string Status, string PillClass);
    private record PendingRow(string AppId, string DealerCode, string DealerName, string Avatar, string Scheme, string Amount, string ApprovedBy, string ApprovedByAvatar, string ApprovedDate, string Priority, string PriorityPillClass);
