@page "/PaymentManagement"

<div class="container-fluid py-4 px-0">
    <div class="pm-wrapper">

        <div class="pm-page-header">
            <div class="pm-title-block">
                <h1>Payment Management</h1>
                <p>Manage welfare payment verification, processing, and benefit release.</p>
            </div>
            <div class="pm-actions">
                <button class="pm-btn pm-btn-outline">
                    <i class="bi bi-file-earmark-spreadsheet" style="color:#16A34A"></i> Excel
                </button>
                <button class="pm-btn pm-btn-outline">
                    <i class="bi bi-file-earmark-pdf" style="color:#DC2626"></i> PDF
                </button>
                <button class="pm-btn pm-btn-outline">
                    <i class="bi bi-printer"></i> Print
                </button>
            </div>
        </div>

        @if (activeTab == "all")
        {
            <div class="pm-kpi-grid">
                <div class="pm-kpi-card pm-kpi-purple">
                    <div class="pm-kpi-info"><div class="pm-kpi-label">Total Applications</div><div class="pm-kpi-value">1536</div></div>
                    <div class="pm-kpi-icon"><i class="bi bi-file-earmark-text-fill"></i></div>
                </div>
                <div class="pm-kpi-card pm-kpi-pink">
                    <div class="pm-kpi-info"><div class="pm-kpi-label">Payment Processing</div><div class="pm-kpi-value">8</div></div>
                    <div class="pm-kpi-icon"><i class="bi bi-arrow-repeat"></i></div>
                </div>
                <div class="pm-kpi-card pm-kpi-green">
                    <div class="pm-kpi-info"><div class="pm-kpi-label">Payments Released</div><div class="pm-kpi-value">8</div></div>
                    <div class="pm-kpi-icon"><i class="bi bi-cash-coin"></i></div>
                </div>
                <div class="pm-kpi-card pm-kpi-orange">
                    <div class="pm-kpi-info"><div class="pm-kpi-label">Pending Payments</div><div class="pm-kpi-value">42</div></div>
                    <div class="pm-kpi-icon"><i class="bi bi-wallet2"></i></div>
                </div>
                <div class="pm-kpi-card pm-kpi-red">
                    <div class="pm-kpi-info"><div class="pm-kpi-label">Payments Rejected</div><div class="pm-kpi-value">2</div></div>
                    <div class="pm-kpi-icon"><i class="bi bi-file-earmark-x-fill"></i></div>
                </div>
            </div>
        }
        else if (activeTab == "pending")
        {
            <div class="pm-kpi-grid pm-kpi-grid-4">
                <div class="pm-kpi-card pm-kpi-purple">
                    <div class="pm-kpi-info"><div class="pm-kpi-label">Total Applications</div><div class="pm-kpi-value">1536</div></div>
                    <div class="pm-kpi-icon"><i class="bi bi-file-earmark-text-fill"></i></div>
                </div>
                <div class="pm-kpi-card pm-kpi-orange">
                    <div class="pm-kpi-info"><div class="pm-kpi-label">Total Pending</div><div class="pm-kpi-value">345</div></div>
                    <div class="pm-kpi-icon"><i class="bi bi-wallet2"></i></div>
                </div>
                <div class="pm-kpi-card pm-kpi-pink">
                    <div class="pm-kpi-info"><div class="pm-kpi-label">High Priority</div><div class="pm-kpi-value">18</div></div>
                    <div class="pm-kpi-icon"><i class="bi bi-flag-fill"></i></div>
                </div>
                <div class="pm-kpi-card pm-kpi-red">
                    <div class="pm-kpi-info"><div class="pm-kpi-label">SLA Delayed</div><div class="pm-kpi-value">42</div></div>
                    <div class="pm-kpi-icon"><i class="bi bi-clock-history"></i></div>
                </div>
            </div>
        }
        else if (activeTab == "processing")
        {
            <div class="pm-kpi-grid pm-kpi-grid-4">
                <div class="pm-kpi-card pm-kpi-purple">
                    <div class="pm-kpi-info"><div class="pm-kpi-label">Total Applications</div><div class="pm-kpi-value">1536</div></div>
                    <div class="pm-kpi-icon"><i class="bi bi-file-earmark-text-fill"></i></div>
                </div>
                <div class="pm-kpi-card pm-kpi-pink">
                    <div class="pm-kpi-info"><div class="pm-kpi-label">Payment Processing</div><div class="pm-kpi-value">8</div></div>
                    <div class="pm-kpi-icon"><i class="bi bi-arrow-repeat"></i></div>
                </div>
                <div class="pm-kpi-card pm-kpi-orange">
                    <div class="pm-kpi-info"><div class="pm-kpi-label">High Priority</div><div class="pm-kpi-value">18</div></div>
                    <div class="pm-kpi-icon"><i class="bi bi-flag-fill"></i></div>
                </div>
                <div class="pm-kpi-card pm-kpi-yellow">
                    <div class="pm-kpi-info"><div class="pm-kpi-label">Due for Release</div><div class="pm-kpi-value">42</div></div>
                    <div class="pm-kpi-icon"><i class="bi bi-calendar-check-fill"></i></div>
                </div>
            </div>
        }
        else if (activeTab == "released")
        {
            <div class="pm-kpi-grid pm-kpi-grid-3">
                <div class="pm-kpi-card pm-kpi-purple">
                    <div class="pm-kpi-info"><div class="pm-kpi-label">Total Applications</div><div class="pm-kpi-value">1536</div></div>
                    <div class="pm-kpi-icon"><i class="bi bi-file-earmark-text-fill"></i></div>
                </div>
                <div class="pm-kpi-card pm-kpi-pink">
                    <div class="pm-kpi-info"><div class="pm-kpi-label">Total Released</div><div class="pm-kpi-value">345</div></div>
                    <div class="pm-kpi-icon"><i class="bi bi-file-earmark-check-fill"></i></div>
                </div>
                <div class="pm-kpi-card pm-kpi-green">
                    <div class="pm-kpi-info"><div class="pm-kpi-label">Total Amount Released</div><div class="pm-kpi-value">₹11,50,000</div></div>
                    <div class="pm-kpi-icon"><i class="bi bi-cash-coin"></i></div>
                </div>
            </div>
        }
        else if (activeTab == "cancelled")
        {
            <div class="pm-kpi-grid">
                <div class="pm-kpi-card pm-kpi-purple">
                    <div class="pm-kpi-info"><div class="pm-kpi-label">Total Applications</div><div class="pm-kpi-value">1536</div></div>
                    <div class="pm-kpi-icon"><i class="bi bi-file-earmark-text-fill"></i></div>
                </div>
                <div class="pm-kpi-card pm-kpi-pink">
                    <div class="pm-kpi-info"><div class="pm-kpi-label">Payment Processing</div><div class="pm-kpi-value">8</div></div>
                    <div class="pm-kpi-icon"><i class="bi bi-arrow-repeat"></i></div>
                </div>
                <div class="pm-kpi-card pm-kpi-green">
                    <div class="pm-kpi-info"><div class="pm-kpi-label">Payment Released</div><div class="pm-kpi-value">345</div></div>
                    <div class="pm-kpi-icon"><i class="bi bi-cash-coin"></i></div>
                </div>
                <div class="pm-kpi-card pm-kpi-orange">
                    <div class="pm-kpi-info"><div class="pm-kpi-label">Pending Payments</div><div class="pm-kpi-value">34</div></div>
                    <div class="pm-kpi-icon"><i class="bi bi-wallet2"></i></div>
                </div>
                <div class="pm-kpi-card pm-kpi-red">
                    <div class="pm-kpi-info"><div class="pm-kpi-label">Cancelled Payments</div><div class="pm-kpi-value">4</div></div>
                    <div class="pm-kpi-icon"><i class="bi bi-file-earmark-x-fill"></i></div>
                </div>
            </div>
        }

        <div class="pm-tabs-bar">
            <button class="pm-tab @(activeTab == "all" ? "pm-tab-active" : "")" @onclick='() => activeTab = "all"'>All</button>
            <button class="pm-tab @(activeTab == "pending" ? "pm-tab-active" : "")" @onclick='() => activeTab = "pending"'>Pending Upload</button>
            <button class="pm-tab @(activeTab == "processing" ? "pm-tab-active" : "")" @onclick='() => activeTab = "processing"'>Payment Processing</button>
            <button class="pm-tab @(activeTab == "released" ? "pm-tab-active" : "")" @onclick='() => activeTab = "released"'>Released</button>
            <button class="pm-tab @(activeTab == "cancelled" ? "pm-tab-active" : "")" @onclick='() => activeTab = "cancelled"'>Payment Initiation Cancelled</button>
        </div>

        <div class="pm-card">
            <div class="pm-table-head">
                <h2 class="pm-table-title">@GetTitle()</h2>
                <div class="pm-table-tools">
                    <div class="pm-search">
                        <i class="bi bi-search"></i>
                        <input type="text" placeholder="Search zones..." />
                    </div>
                    <select class="pm-control pm-select pm-tool-select">
                        <option value="" disabled selected hidden>All Schemes</option>
                        <option>Medical Assistance</option>
                        <option>Educational Assistance</option>
                    </select>
                    <div class="pm-input-with-icon pm-tool-date">
                        <input type="text" class="pm-control" placeholder="Date Range" />
                        <i class="bi bi-calendar3 pm-input-icon"></i>
                    </div>
                </div>
            </div>

            <div class="pm-table-wrap">

                @if (activeTab == "all")
                {
                    <table class="pm-table">
                        <thead>
                            <tr>
                                <th>Application ID</th>
                                <th>Dealer Code</th>
                                <th>Dealer Name</th>
                                <th>Welfare Scheme</th>
                                <th>Amount</th>
                                <th>Payment Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in allRows)
                            {
                                <tr>
                                    <td>@row.AppId</td>
                                    <td>@row.DealerCode</td>
                                    <td>
                                        <div class="pm-avatar-cell">
                                            <img src="@row.Avatar" alt="@row.DealerName" class="pm-avatar" />
                                            <span>@row.DealerName</span>
                                        </div>
                                    </td>
                                    <td class="pm-scheme">@row.Scheme</td>
                                    <td>@row.Amount</td>
                                    <td><span class="pm-pill @row.PillClass">@row.Status</span></td>
                                    <td><button class="pm-action-btn" @onclick='() => OpenModal(GetStateFromStatus(row.Status))'><i class="bi bi-eye-fill"></i></button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else if (activeTab == "pending")
                {
                    <table class="pm-table">
                        <thead>
                            <tr>
                                <th>Application ID</th>
                                <th>Dealer Code</th>
                                <th>Dealer Name</th>
                                <th>Welfare Scheme</th>
                                <th>Amount</th>
                                <th>Approved By</th>
                                <th>Approved Date</th>
                                <th>Priority</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in pendingRows)
                            {
                                <tr>
                                    <td>@row.AppId</td>
                                    <td>@row.DealerCode</td>
                                    <td>
                                        <div class="pm-avatar-cell">
                                            <img src="@row.Avatar" alt="@row.DealerName" class="pm-avatar" />
                                            <span>@row.DealerName</span>
                                        </div>
                                    </td>
                                    <td class="pm-scheme">@row.Scheme</td>
                                    <td>@row.Amount</td>
                                    <td>
                                        <div class="pm-avatar-cell">
                                            <img src="@row.ApprovedByAvatar" alt="@row.ApprovedBy" class="pm-avatar" />
                                            <span>@row.ApprovedBy</span>
                                        </div>
                                    </td>
                                    <td>@row.ApprovedDate</td>
                                    <td><span class="pm-pill @row.PriorityPillClass">@row.Priority</span></td>
                                    <td><button class="pm-action-btn" @onclick='() => OpenModal("pending")'><i class="bi bi-eye-fill"></i></button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else if (activeTab == "processing")
                {
                    <table class="pm-table">
                        <thead>
                            <tr>
                                <th>Application ID</th>
                                <th>Dealer Code</th>
                                <th>Dealer Name</th>
                                <th>Welfare Scheme</th>
                                <th>Amount</th>
                                <th>Verified On</th>
                                <th>SLA</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in processingRows)
                            {
                                <tr>
                                    <td>@row.AppId</td>
                                    <td>@row.DealerCode</td>
                                    <td>
                                        <div class="pm-avatar-cell">
                                            <img src="@row.Avatar" alt="@row.DealerName" class="pm-avatar" />
                                            <span>@row.DealerName</span>
                                        </div>
                                    </td>
                                    <td class="pm-scheme">@row.Scheme</td>
                                    <td>@row.Amount</td>
                                    <td>@row.VerifiedOn</td>
                                    <td><span class="@row.SlaClass">@row.Sla</span></td>
                                    <td><span class="pm-pill @row.StatusPillClass">@row.Status</span></td>
                                    <td><button class="pm-action-btn" @onclick='() => OpenModal("processing")'><i class="bi bi-eye-fill"></i></button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else if (activeTab == "released")
                {
                    <table class="pm-table">
                        <thead>
                            <tr>
                                <th>Application ID</th>
                                <th>Dealer Code</th>
                                <th>Dealer Name</th>
                                <th>Welfare Scheme</th>
                                <th>Amount</th>
                                <th>Payment Mode</th>
                                <th>Released Date</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in releasedRows)
                            {
                                <tr>
                                    <td>@row.AppId</td>
                                    <td>@row.DealerCode</td>
                                    <td>
                                        <div class="pm-avatar-cell">
                                            <img src="@row.Avatar" alt="@row.DealerName" class="pm-avatar" />
                                            <span>@row.DealerName</span>
                                        </div>
                                    </td>
                                    <td class="pm-scheme">@row.Scheme</td>
                                    <td>@row.Amount</td>
                                    <td>@row.PaymentMode</td>
                                    <td>@row.ReleasedDate</td>
                                    <td><span class="pm-pill @row.StatusPillClass">@row.Status</span></td>
                                    <td><button class="pm-action-btn" @onclick='() => OpenModal("released")'><i class="bi bi-eye-fill"></i></button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else if (activeTab == "cancelled")
                {
                    <table class="pm-table">
                        <thead>
                            <tr>
                                <th>Application ID</th>
                                <th>Dealer Code</th>
                                <th>Dealer Name</th>
                                <th>Welfare Scheme</th>
                                <th>Amount</th>
                                <th>Cancelled On</th>
                                <th>Cancelled By</th>
                                <th>Reason</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in cancelledRows)
                            {
                                <tr>
                                    <td class="pm-id-red">@row.AppId</td>
                                    <td>@row.DealerCode</td>
                                    <td>
                                        <div class="pm-avatar-cell">
                                            <img src="@row.Avatar" alt="@row.DealerName" class="pm-avatar" />
                                            <span>@row.DealerName</span>
                                        </div>
                                    </td>
                                    <td class="pm-scheme">@row.Scheme</td>
                                    <td>@row.Amount</td>
                                    <td>@row.CancelledOn</td>
                                    <td>
                                        <div class="pm-avatar-cell">
                                            <img src="@row.CancelledByAvatar" alt="@row.CancelledBy" class="pm-avatar" />
                                            <span>@row.CancelledBy</span>
                                        </div>
                                    </td>
                                    <td>@row.Reason</td>
                                    <td><button class="pm-action-btn" @onclick='() => OpenModal("cancelled")'><i class="bi bi-eye-fill"></i></button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

            </div>

            <div class="pm-pagination">
                <div class="pm-page-size">
                    <span>Items Per Page</span>
                    <select class="pm-control pm-select pm-page-select">
                        <option>16</option>
                        <option>25</option>
                        <option>50</option>
                    </select>
                </div>
                <div class="pm-page-controls">
                    <button class="pm-page-btn"><i class="bi bi-chevron-left"></i></button>
                    <button class="pm-page-btn pm-page-active">1</button>
                    <button class="pm-page-btn">2</button>
                    <button class="pm-page-btn">3</button>
                    <span class="pm-page-ellipsis">..</span>
                    <button class="pm-page-btn">8</button>
                    <button class="pm-page-btn">9</button>
                    <button class="pm-page-btn">10</button>
                    <button class="pm-page-btn"><i class="bi bi-chevron-right"></i></button>
                </div>
            </div>
        </div>

    </div>
</div>

@if (modalOpen)
{
    <div class="pm-modal-backdrop" @onclick="CloseModal">
        <div class="pm-modal" @onclick:stopPropagation="true">

            <div class="pm-modal-header">
                <div>
                    <div class="pm-modal-title-row">
                        <h2 class="pm-modal-title">Payment Details</h2>
                        @if (currentModalState == "pending") { <span class="pm-pill pm-pill-orange-light">Pending</span> }
                        @if (currentModalState == "processing") { <span class="pm-pill pm-pill-purple-light">Payment Processing</span> }
                        @if (currentModalState == "released") { <span class="pm-pill pm-pill-green-light">Released</span> }
                        @if (currentModalState == "cancelled") { <span class="pm-pill pm-pill-red-light">Cancelled</span> }
                    </div>
                    <p class="pm-modal-subtitle">Application ID: WS-2024-003</p>
                </div>
                <button class="pm-modal-close" @onclick="CloseModal">
                    <i class="bi bi-x-circle"></i>
                </button>
            </div>

            <div class="pm-modal-body">

                <div class="pm-stepper-horizontal">
                    @if (currentModalState == "pending")
                    {
                        <div class="pm-step-horiz">
                            <div class="pm-step-circle-lg pm-circle-green"><i class="bi bi-check-lg"></i></div>
                            <div class="pm-step-details"><span class="pm-step-title">MO</span><span class="pm-step-subtitle">Validated</span><span class="pm-step-meta">12 May 2026<br />10:42 AM</span></div>
                        </div><div class="pm-step-line-horiz"></div>
                        <div class="pm-step-horiz">
                            <div class="pm-step-circle-lg pm-circle-green"><i class="bi bi-check-lg"></i></div>
                            <div class="pm-step-details"><span class="pm-step-title">RM</span><span class="pm-step-subtitle">Recommended</span><span class="pm-step-meta">12 May 2026<br />10:42 AM</span></div>
                        </div><div class="pm-step-line-horiz"></div>
                        <div class="pm-step-horiz">
                            <div class="pm-step-circle-lg pm-circle-green"><i class="bi bi-check-lg"></i></div>
                            <div class="pm-step-details"><span class="pm-step-title">SMM</span><span class="pm-step-subtitle">Recommended</span><span class="pm-step-meta">12 May 2026<br />10:42 AM</span></div>
                        </div><div class="pm-step-line-horiz"></div>
                        <div class="pm-step-horiz">
                            <div class="pm-step-circle-lg pm-circle-green"><i class="bi bi-check-lg"></i></div>
                            <div class="pm-step-details"><span class="pm-step-title">SDWA</span><span class="pm-step-subtitle">Approved</span><span class="pm-step-meta">12 May 2026<br />10:42 AM</span></div>
                        </div><div class="pm-step-line-horiz"></div>
                        <div class="pm-step-horiz">
                            <div class="pm-step-circle-lg pm-circle-green"><i class="bi bi-check-lg"></i></div>
                            <div class="pm-step-details"><span class="pm-step-title">Director</span><span class="pm-step-subtitle">Approved</span><span class="pm-step-meta">12 May 2026<br />10:42 AM</span></div>
                        </div>
                    }
                    else
                    {
                        <div class="pm-step-horiz">
                            <div class="pm-step-circle-lg pm-circle-green"><i class="bi bi-check-lg"></i></div>
                            <div class="pm-step-details"><span class="pm-step-title">Approved</span><span class="pm-step-subtitle">Suresh (SDWA Admin)</span><span class="pm-step-meta">12 May 2026<br />10:42 AM</span></div>
                        </div>
                        <div class="pm-step-line-horiz"></div>
                        <div class="pm-step-horiz">
                            <div class="pm-step-circle-lg pm-circle-green"><i class="bi bi-check-lg"></i></div>
                            <div class="pm-step-details"><span class="pm-step-title">Verified</span><span class="pm-step-subtitle">Suresh (SDWA Admin)</span><span class="pm-step-meta">12 May 2026<br />10:42 AM</span></div>
                        </div>
                        <div class="pm-step-line-horiz"></div>

                        @if (currentModalState == "processing")
                        {
                            <div class="pm-step-horiz">
                                <div class="pm-step-circle-lg pm-circle-purple"><i class="bi bi-arrow-repeat"></i></div>
                                <div class="pm-step-details"><span class="pm-step-title">Processing</span></div>
                            </div>
                            <div class="pm-step-line-horiz pm-step-line-gray"></div>
                            <div class="pm-step-horiz">
                                <div class="pm-step-circle-lg pm-circle-gray"><i class="bi bi-hourglass-split"></i></div>
                                <div class="pm-step-details"><span class="pm-step-title" style="color: #9CA3AF;">Released</span></div>
                            </div>
                        }
                        else if (currentModalState == "released")
                        {
                            <div class="pm-step-horiz">
                                <div class="pm-step-circle-lg pm-circle-green"><i class="bi bi-check-lg"></i></div>
                                <div class="pm-step-details"><span class="pm-step-title">Processing</span><span class="pm-step-subtitle">Suresh (SDWA Admin)</span><span class="pm-step-meta">12 May 2026<br />10:42 AM</span></div>
                            </div>
                            <div class="pm-step-line-horiz"></div>
                            <div class="pm-step-horiz">
                                <div class="pm-step-circle-lg pm-circle-green"><i class="bi bi-check-lg"></i></div>
                                <div class="pm-step-details"><span class="pm-step-title">Released</span><span class="pm-step-subtitle">Suresh (SDWA Admin)</span><span class="pm-step-meta">12 May 2026<br />10:42 AM</span></div>
                            </div>
                        }
                        else if (currentModalState == "cancelled")
                        {
                            <div class="pm-step-horiz">
                                <div class="pm-step-circle-lg pm-circle-green"><i class="bi bi-check-lg"></i></div>
                                <div class="pm-step-details"><span class="pm-step-title">Processing</span><span class="pm-step-subtitle">Suresh (SDWA Admin)</span><span class="pm-step-meta">12 May 2026<br />10:42 AM</span></div>
                            </div>
                            <div class="pm-step-line-horiz"></div>
                            <div class="pm-step-horiz">
                                <div class="pm-step-circle-lg pm-circle-red"><i class="bi bi-x-lg"></i></div>
                                <div class="pm-step-details"><span class="pm-step-title" style="color: #DC2626;">Cancelled</span><span class="pm-step-subtitle" style="color: #DC2626;">Suresh (SDWA Admin)</span><span class="pm-step-meta">12 May 2026<br />10:42 AM</span></div>
                            </div>
