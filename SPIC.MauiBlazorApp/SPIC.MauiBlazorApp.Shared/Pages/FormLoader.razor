@using SPIC.MauiBlazorApp.Shared.FormFlow
@inject NavigationManager Nav

@if (CurrentStep is not null)
{
	<div class="mb-4">
		<div class="d-flex justify-content-between align-items-center">
			<div class="step-text">Step @CurrentStep.StepNo of @TotalSteps</div>
			@if (CurrentStep.StepNo == 12)
			{
				<span class="status-badge">
					Completed
					<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/SuccessCompleteIcon.svg"
						 class="verifyicon" />
				</span>
			}
			else
			{
				<span class="status-badge">Registration In Progress</span>
			}
		</div>

		<div class="step-subtext">@CurrentStep.Title</div>

		<div class="progress-bar-custom-header">
			@for (int i = 1; i <= TotalSteps; i++)
			{
				var step = FormStepData.Steps.FirstOrDefault(x => x.StepNo == i);

				<div class="progress-segment @(i <= CurrentStep.StepNo ? "active" : "")"
					 title="@step?.Title"
					 @onclick="() => NavigateToStep(step)">
				</div>
			}
		</div>
	</div>
}

@code {
	private FormStepModel? CurrentStep;
	private int TotalSteps => FormStepData.Steps.Count;

	protected override void OnInitialized()
	{
		SetCurrentStep();
		Nav.LocationChanged += HandleLocationChanged;
	}

	private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
	{
		SetCurrentStep();
		InvokeAsync(StateHasChanged);
	}

	private void SetCurrentStep()
	{
		var relativePath = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0];
		CurrentStep = FormStepData.GetStepByRoute(relativePath);
	}

	private void NavigateToStep(FormStepModel? step)
	{
		if (step is not null)
		{
			Nav.NavigateTo(step.Route);
		}
	}

	public void Dispose()
	{
		Nav.LocationChanged -= HandleLocationChanged;
	}
}