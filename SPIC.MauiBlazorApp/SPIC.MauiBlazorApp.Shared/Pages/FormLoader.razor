@using System.Net.Http.Json
@using SPIC.MauiBlazorApp.Shared.FormFlow
@using SPIC.Core.Entities
@inject NavigationManager Nav
@inject LoadingService Loading
@inject HttpClient Http

@if (CurrentStep is not null)
{
	var steps = StepsList;
	var currentIndex = CurrentIndex;

	<div class="mb-4">
		<div class="d-flex justify-content-between align-items-center">
			<div class="step-text">Step @(currentIndex + 1) of @TotalSteps</div>

			@if (currentIndex + 1 == TotalSteps)
			{
				<span class="status-badge">
					Completed
					<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/SuccessCompleteIcon.svg"
						 class="verifyicon" />
				</span>
			}
			else
			{
				<span class="status-badge">Registration In Progress</span>
			}
		</div>

		<div class="step-subtext">@CurrentStep.Title</div>

		<div class="progress-bar-custom-header">
			@for (int idx = 0; idx < steps.Count; idx++)
			{
				var step = steps[idx];

				<div class="progress-segment @GetStepClass(idx, step)"
					 title="@step.Title"
					 @onclick="() => NavigateToStep(step)">
				</div>
			}
		</div>
	</div>
}

@code {
	private FormStepModel? CurrentStep;

	private List<FormStepModel> _visibleSteps = FormStepData.GetVisibleSteps(false);
	private bool _isRestrictedFlow;

	private List<FormStepModel> StepsList => _visibleSteps;

	private int TotalSteps => StepsList.Count;

	private int CurrentIndex
	{
		get
		{
			if (CurrentStep == null)
				return 0;

			var idx = StepsList.FindIndex(s =>
				s.Route.Equals(CurrentStep.Route, StringComparison.OrdinalIgnoreCase));

			return idx >= 0 ? idx : 0;
		}
	}

	protected override async Task OnInitializedAsync()
	{
		SetCurrentStep();

		Nav.LocationChanged += HandleLocationChanged;
		FormStepData.OnStateChanged += HandleStateChanged;

		await LoadVisibleSteps();
		await EvaluateFromQuery();
	}

	private async Task LoadVisibleSteps()
	{
		var dealerId = GetDealerIdFromQuery();
		_isRestrictedFlow = GetFlowRestricted();

		if (dealerId <= 0)
		{
			// Create mode / no dealerId yet
			// Default should be 12 steps, no GreenStar page
			_visibleSteps = FormStepData.GetVisibleSteps(false, _isRestrictedFlow);
			SetCurrentStep();
			return;
		}

		var hasGreenStar = await HasGreenStarCompany(dealerId);

		_visibleSteps = FormStepData.GetVisibleSteps(hasGreenStar, _isRestrictedFlow);

		SetCurrentStep();
	}

	private bool GetFlowRestricted()
	{
		var baseRelative = Nav.ToBaseRelativePath(Nav.Uri);
		var qIndex = baseRelative.IndexOf('?');

		if (qIndex < 0)
			return false;

		var queryString = baseRelative[(qIndex + 1)..];

		var parts = queryString.Split('&')
			.Select(p => p.Split('=', 2))
			.Where(p => p.Length == 2)
			.ToDictionary(p => p[0], p => p[1], StringComparer.OrdinalIgnoreCase);

		return parts.TryGetValue("flow", out var flow) &&
			string.Equals(flow, "restricted", StringComparison.OrdinalIgnoreCase);
	}

	private async Task<bool> HasGreenStarCompany(int dealerId)
	{
        try
		{
			var dealer = await Http.GetFromJsonAsync<SPIC.Core.Entities.DealerRegistration>($"api/DealerRegistration/{dealerId}");
			return dealer?.InGreenStar ?? false;
		}
		catch
		{
			return false;
		}
	}

	private int GetDealerIdFromQuery()
	{
		var baseRelative = Nav.ToBaseRelativePath(Nav.Uri);
		var qIndex = baseRelative.IndexOf('?');

		if (qIndex < 0)
			return 0;

		var queryString = baseRelative[(qIndex + 1)..];

		var parts = queryString.Split('&')
			.Select(p => p.Split('=', 2))
			.Where(p => p.Length == 2)
			.ToDictionary(p => p[0], p => p[1], StringComparer.OrdinalIgnoreCase);

		if (parts.TryGetValue("dealerId", out var idStr) &&
			int.TryParse(idStr, out var id) &&
			id > 0)
		{
			return id;
		}

		return 0;
	}

	private string GetStepClass(int idx, FormStepModel step)
	{
		if (idx == CurrentIndex)
			return "current";

		if (step.HasError)
			return "error";

		if (step.IsEvaluated)
			return "active";

		return "";
	}

	private async Task EvaluateFromQuery()
	{
		var dealerId = GetDealerIdFromQuery();

		FormStepData.ClearAllErrors();

		if (dealerId > 0)
		{
			await FormStepChecker.EvaluateStepsAsync(Http, dealerId);
		}
	}

	private void HandleStateChanged()
	{
		InvokeAsync(StateHasChanged);
	}

	private async void HandleLocationChanged(
		object? sender,
		Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
	{
		SetCurrentStep();

		await LoadVisibleSteps();
		await EvaluateFromQuery();

		await InvokeAsync(StateHasChanged);
	}

	private void SetCurrentStep()
	{
		var relativePath = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0];

		CurrentStep = FormStepData.GetStepByRoute(relativePath);
	}

	private void NavigateToStep(FormStepModel? step)
	{
		if (step is not null)
		{
			Loading.Show();

			var baseRelative = Nav.ToBaseRelativePath(Nav.Uri);
			var qIndex = baseRelative.IndexOf('?');
			var queryString = qIndex >= 0 ? baseRelative[qIndex..] : string.Empty;

			if (_isRestrictedFlow && !queryString.Contains("flow=restricted", StringComparison.OrdinalIgnoreCase))
				queryString += (queryString.Contains('?') ? "&" : "?") + "flow=restricted";

			Nav.NavigateTo(step.Route + queryString);
		}
	}

	public void Dispose()
	{
		Nav.LocationChanged -= HandleLocationChanged;
		FormStepData.OnStateChanged -= HandleStateChanged;
	}
}