@page "/SchemeOverview" 



<div class="container-fluid py-4 px-0">
    
    <!-- Header -->
    <h2>Scheme Overview</h2>
    <p class="subtitle">Track performance and results of the selected scheme</p>

    <!-- Top Scheme Details Card -->
    <div class="card-custom">
        <div class="scheme-title-row">
            <h3 class="scheme-title">Tamil New year Special Scheme</h3>
            <div>
                <span class="badge-dark-custom me-2">
                    <i class="bi bi-tag-fill" style="transform: rotate(45deg); display: inline-block;"></i> Both
                </span>
                <span class="badge-active">
                    <span class="dot"></span> Active
                </span>
            </div>
        </div>
        
        <div class="row">
            <div class="col-md-6">
                <div class="info-group">
                    <div class="info-icon"><i class="bi bi-geo-alt"></i></div>
                    <div>
                        <p class="info-text-label">States</p>
                        <p class="info-text-value">Tamil Nadu, Chennai</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="info-group">
                    <div class="info-icon"><i class="bi bi-calendar3"></i></div>
                    <div>
                        <p class="info-text-label">Duration</p>
                        <p class="info-text-value">1 Mar 2026 - 30 Jun 2026</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Statistics Row -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="stat-card light-green">
                <div class="stat-header">
                    <div class="stat-icon"><i class="bi bi-person-badge"></i></div>
                    <p class="stat-title">Participating dealer</p>
                </div>
                <p class="stat-number">2,450</p>
                <p class="stat-desc">Eligible for this Scheme</p>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="stat-card light-blue">
                <div class="stat-header">
                    <div class="stat-icon"><i class="bi bi-people"></i></div>
                    <p class="stat-title">Total Entries</p>
                </div>
                <p class="stat-number">8,920</p>
                <p class="stat-desc">Total lucky draw entries generated</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="stat-card light-yellow">
                <div class="stat-header">
                    <div class="stat-icon"><i class="bi bi-trophy"></i></div>
                    <p class="stat-title">Winners</p>
                </div>
                <p class="stat-number">12</p>
                <p class="stat-desc">Winner Selected</p>
            </div>
        </div>
    </div>

    <!-- Tab Navigation -->
    <div class="tab-nav">
        <button class="@(currentTab == "Overview" ? "active" : "")" @onclick="@(() => currentTab = "Overview")">Overview</button>
        <button class="@(currentTab == "Participating dealer" ? "active" : "")" @onclick="@(() => currentTab = "Participating dealer")">Participating dealer</button>
        <button class="@(currentTab == "Winners" ? "active" : "")" @onclick="@(() => currentTab = "Winners")">Winners</button>
        <button class="@(currentTab == "Draw History" ? "active" : "")" @onclick="@(() => currentTab = "Draw History")">Draw History</button>
    </div>

    <!-- TAB CONTENT: OVERVIEW -->
    @if (currentTab == "Overview")
    {
        <div class="row g-3">
            <div class="col-md-6">
                <div class="banner-card">
                    <img src="https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Wardrobe" class="banner-img">
                    <div class="banner-content">
                        <span class="reward-badge">THE GRAND REWARD</span>
                        <h4 class="reward-title">Single Wardrobe</h4>
                        <p class="reward-desc">Premium teak-finished, Royal Estate collection. A statement of prestige for your home.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="settings-card">
                    <div class="settings-header">
                        <i class="bi bi-sliders"></i> Draw Setting
                    </div>
                    
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <div class="setting-box">
                                <div class="setting-icon"><i class="bi bi-box-seam"></i></div>
                                <div>
                                    <p class="setting-label">Draw Mode</p>
                                    <p class="setting-value">Auto <span class="mini-badge">Automated</span></p>
                                </div>
                            </div>
                        </div>
                        
                        <div class="col-sm-6">
                            <div class="setting-box">
                                <div class="setting-icon"><i class="bi bi-arrow-repeat"></i></div>
                                <div>
                                    <p class="setting-label">Frequency</p>
                                    <p class="setting-value">Monthly</p>
                                </div>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="setting-box">
                                <div class="setting-icon"><i class="bi bi-calendar-event"></i></div>
                                <div>
                                    <p class="setting-label">Next Draw Date</p>
                                    <p class="setting-value">1 May 2026</p>
                                </div>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="setting-box">
                                <div class="setting-icon"><i class="bi bi-calendar-check"></i></div>
                                <div>
                                    <p class="setting-label">Last Draw Date</p>
                                    <p class="setting-value">1 April 2026</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- TAB CONTENT: PARTICIPATING DEALER -->
    @if (currentTab == "Participating dealer")
    {
        <div class="list-card-wrapper">
            <div class="row mb-4">
                <div class="col-md-8">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" class="form-control bg-light border-start-0" placeholder="Search Schemes...">
                    </div>
                </div>
                <div class="col-md-4">
                    <select class="form-select bg-light">
                        <option>All States</option>
                    </select>
                </div>
            </div>

            <div class="row g-3">
                <!-- Generating 6 placeholder cards to match the design -->
                @for(int i=0; i<6; i++)
                {
                    <div class="col-md-4" @onclick="OpenDealerDetails">
                        <div class="card-item">
                            <div class="dealer-header">
                                <div class="dealer-info">
                                    <img src="https://i.pravatar.cc/150?u=@i" alt="Avatar" class="dealer-avatar">
                                    <div>
                                        <p class="dealer-name">Rajesh Kumar Patel</p>
                                        <span class="tag-farmer"><i class="bi bi-person"></i> Farmer</span>
                                    </div>
                                </div>
                                <span class="tag-participating">Participating</span>
                            </div>
                            
                            <div class="location-box">
                                <i class="bi bi-geo-alt"></i> Pune, Maharashtra
                            </div>

                            <div class="stats-row">
                                <div class="stat-mini-box">
                                    <div class="stat-mini-icon"><i class="bi bi-graph-up-arrow"></i></div>
                                    <div>
                                        <p class="stat-mini-label">Points</p>
                                        <p class="stat-mini-val">450</p>
                                    </div>
                                </div>
                                <div class="stat-mini-box">
                                    <div class="stat-mini-icon"><i class="bi bi-ticket-perforated"></i></div>
                                    <div>
                                        <p class="stat-mini-label">Entries</p>
                                        <p class="stat-mini-val">19</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- TAB CONTENT: WINNERS -->
    @if (currentTab == "Winners")
    {
        <div class="list-card-wrapper">
            <div class="row mb-4">
                <div class="col-md-8">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" class="form-control bg-light border-start-0" placeholder="Search Schemes...">
                    </div>
                </div>
                <div class="col-md-4">
                    <select class="form-select bg-light">
                        <option>All States</option>
                    </select>
                </div>
            </div>

            <div class="row g-3">
                <!-- Generating 6 placeholder cards to match the design with varied statuses -->
                @{
                    string[] statuses = {"Claimed", "Notified", "Selected", "Claimed", "Notified", "Selected"};
                    string[] statusClasses = {"status-claimed", "status-notified", "status-selected", "status-claimed", "status-notified", "status-selected"};
                }
                
                @for(int i=0; i<6; i++)
                {
                    <div class="col-md-4" @onclick="OpenWinnerDetails">
                        <div class="card-item">
                            <div class="dealer-header">
                                <div class="dealer-info">
                                    <img src="https://i.pravatar.cc/150?u=@i" alt="Avatar" class="dealer-avatar">
                                    <div>
                                        <p class="dealer-name">Rajesh Kumar Patel</p>
                                        <span class="tag-farmer"><i class="bi bi-person"></i> Farmer</span>
                                    </div>
                                </div>
                                <span class="winner-status @statusClasses[i]">@statuses[i]</span>
                            </div>
                            
                            <div class="prize-box">
                                <img src="https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?ixlib=rb-4.0.3&w=100&q=80" alt="Prize" class="prize-img">
                                <div class="prize-details">
                                    <p class="prize-label">Prize</p>
                                    <p class="prize-name">Single Wardrobe</p>
                                </div>
                                <span class="prize-mini-badge">THE GRAND REWARD</span>
                            </div>

                            <div class="draw-date-box">
                                <i class="bi bi-calendar-check draw-date-icon"></i>
                                <div class="draw-date-text">
                                    <p class="draw-date-label">Draw Date</p>
                                    <p class="draw-date-val">1 Apr 2026</p>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- TAB CONTENT: DRAW HISTORY -->
    @if (currentTab == "Draw History")
    {
        <div class="list-card-wrapper">
            <div class="row g-3">
                <!-- Generating 6 placeholder cards for history -->
                @for(int i=0; i<6; i++)
                {
                    <div class="col-md-4">
                        <div class="card-item">
                            <div class="history-header">
                                <div class="history-date">
                                    <i class="bi bi-calendar4-week"></i>
                                    1 April 2026
                                </div>
                                <span class="tag-completed"><i class="bi bi-check-circle"></i> Completed</span>
                            </div>
                            
                            <div class="history-prize-box">
                                <img src="https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?ixlib=rb-4.0.3&w=100&q=80" alt="Prize" class="history-prize-img">
                                <div class="prize-details">
                                    <p class="prize-label">Prize</p>
                                    <p class="prize-name">Single Wardrobe</p>
                                </div>
                                <div class="history-winner-badge">
                                    <i class="bi bi-trophy"></i> 1 WINNER SELECTED
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

</div>
<DealerDetailsDrawer @bind-IsOpen="isDealerDetailsOpen" />
<WinnerDetailsDrawer @bind-IsOpen="isWinnerDetailsOpen" />
@code {
    // State to track which tab is active
    private string currentTab = "Overview";
     private bool isDealerDetailsOpen = false;
     private bool isWinnerDetailsOpen = false;

    private void OpenDealerDetails()
    {
        isDealerDetailsOpen = true;
    }
    private void OpenWinnerDetails()
    {
        isWinnerDetailsOpen = true;
    }
}