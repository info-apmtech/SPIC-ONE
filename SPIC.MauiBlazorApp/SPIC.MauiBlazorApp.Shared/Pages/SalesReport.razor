@page "/SalesReport"
@inject IJSRuntime JS


<div class="container-fluid py-4 px-0">
        
    <div class="sr-header-container">
        <div class="sr-header-text">
            <h1>Sales Report</h1>
            <p>View sales performance and liquidation movement across dealers</p>
        </div>
        <div class="sr-action-buttons">
            <button class="sr-btn sr-btn-outline"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2v6h-6"></path><path d="M3 12a9 9 0 1 0 2.13-5.88L2 9"></path></svg> Refresh Data</button>
            <button class="sr-btn sr-btn-outline"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><path d="M8 13h2"></path><path d="M8 17h2"></path><path d="M14 13h2"></path><path d="M14 17h2"></path></svg> Excel</button>
            <button class="sr-btn sr-btn-outline"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><path d="M9 15v-4"></path><path d="M12 15v-4c1 0 2 1 2 2s-1 2-2 2"></path><path d="M16 11v4"></path><path d="M16 13h2"></path></svg> PDF</button>
            <button class="sr-btn sr-btn-solid"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg> Send Mail</button>
        </div>
    </div>

    <div class="sr-stats-grid">
        <div class="sr-stat-card sr-card-green">
            <div class="sr-stat-content">
                <span class="sr-stat-title">Total Sales Quantity</span>
                <span class="sr-stat-value">15,080</span>
                <div class="sr-stat-trend sr-trend-positive"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg><span>+18% from last month</span></div>
            </div>
            <div class="sr-stat-icon-box sr-icon-green"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path><path d="m3.3 7 8.7 5 8.7-5"></path><path d="M12 22V12"></path></svg></div>
        </div>

        <div class="sr-stat-card sr-card-blue">
            <div class="sr-stat-content">
                <span class="sr-stat-title">Active Selling Dealers</span>
                <span class="sr-stat-value">15</span>
                <div class="sr-stat-trend sr-trend-positive"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg><span>+5 new dealers</span></div>
            </div>
            <div class="sr-stat-icon-box sr-icon-blue"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="2" width="12" height="10" rx="2"></rect><path d="M12 12v6"></path><path d="M16 15h.01"></path><path d="M8 15h.01"></path><path d="M20 19v2a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-2"></path><path d="M2 15h20"></path></svg></div>
        </div>

        <div class="sr-stat-card sr-card-orange">
            <div class="sr-stat-content">
                <span class="sr-stat-title">Average Liquidation</span>
                <span class="sr-stat-value">21 days</span>
                <div class="sr-stat-trend sr-trend-positive"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 17 13.5 8.5 8.5 13.5 2 7"></polyline><polyline points="16 17 22 17 22 11"></polyline></svg><span>-3 days from last month</span></div>
            </div>
            <div class="sr-stat-icon-box sr-icon-orange"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle><circle cx="12" cy="12" r="2"></circle><path d="M12 2v2"></path><path d="M12 20v2"></path><path d="M2 12h2"></path><path d="M20 12h2"></path></svg></div>
        </div>

        <div class="sr-stat-card sr-card-red">
            <div class="sr-stat-content">
                <span class="sr-stat-title">Fast Moving Dealers</span>
                <span class="sr-stat-value">7</span>
                <div class="sr-stat-trend sr-trend-negative"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg><span>+4 from last week</span></div>
            </div>
            <div class="sr-stat-icon-box sr-icon-red"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="4" width="12" height="12" rx="2"></rect><path d="M17 9h4l2 4v4h-6"></path><circle cx="9" cy="18" r="2"></circle><circle cx="17" cy="18" r="2"></circle><path d="M1 10h4"></path><path d="M3 14h2"></path></svg></div>
        </div>
    </div>

    <div class="sr-charts-grid">
        
        <div class="sr-chart-card">
            <h3>Product-wise Sales Distribution</h3>
            <div class="sr-chart-area">
                <canvas id="barChart"></canvas>
            </div>
            <div class="custom-legend">
                <div class="custom-legend-item leg-orange"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg> Total Sales (Units)</div>
                <div class="custom-legend-item leg-purple"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg> Average Liquidation (Days)</div>
            </div>
        </div>

        <div class="sr-chart-card">
            <h3>District-wise Sales Trend</h3>
            <div class="sr-chart-area">
                <canvas id="areaChart"></canvas>
            </div>
            <div class="custom-legend">
                <div class="custom-legend-item leg-blue"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg> Sales (Units)</div>
                <div class="custom-legend-item leg-green"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg> Trends %</div>
            </div>
        </div>

    </div>

    <div class="sr-filter-card">
        <div class="sr-filter-header">
            <div class="sr-filter-title">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="6" x2="20" y2="6"></line><line x1="6" y1="12" x2="18" y2="12"></line><line x1="8" y1="18" x2="16" y2="18"></line></svg> Filters
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </div>
        
        <div class="sr-filter-body">
            <div class="sr-filter-grid">
                <div class="sr-form-group"><label class="sr-form-label">State</label><select class="sr-form-select"><option>All State</option></select></div>
                <div class="sr-form-group"><label class="sr-form-label">Region</label><select class="sr-form-select"><option>All Region</option></select></div>
                <div class="sr-form-group"><label class="sr-form-label">Head Quarters</label><select class="sr-form-select"><option>All Head Quarters</option></select></div>
                <div class="sr-form-group"><label class="sr-form-label">District</label><select class="sr-form-select"><option>All District</option></select></div>
                <div class="sr-form-group"><label class="sr-form-label">Sub District</label><select class="sr-form-select"><option>All Sub Districts</option></select></div>
                <div class="sr-form-group"><label class="sr-form-label">Dealer Name</label><select class="sr-form-select"><option>Select Dealer</option></select></div>
                <div class="sr-form-group"><label class="sr-form-label">Product</label><select class="sr-form-select"><option>All Products</option></select></div>
                <div class="sr-form-group"><label class="sr-form-label">Liquidation Cycle Range</label><select class="sr-form-select"><option>All Ranges</option></select></div>
            </div>
            
            <div class="sr-filter-actions">
                <button class="sr-btn sr-btn-outline"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg> Clear All</button>
                <button class="sr-btn sr-btn-solid"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="6" x2="20" y2="6"></line><line x1="6" y1="12" x2="18" y2="12"></line><line x1="8" y1="18" x2="16" y2="18"></line></svg> Apply Filters</button>
            </div>
        </div>
    </div>

    <div class="sr-table-card">
        <div class="sr-table-top">
            <h3>Sales Report List</h3>
            <input type="text" class="sr-search-input" placeholder="Search zones...">
        </div>

        <div class="sr-table-wrapper">
            <table class="sr-table">
                <thead>
                    <tr>
                        <th><input type="checkbox" class="sr-checkbox"></th>
                        <th>Dealer Name</th>
                        <th>Product</th>
                        <th>Quantity (MT)</th>
                        <th>Liquidation Cycle(Days)</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><input type="checkbox" class="sr-checkbox"></td>
                        <td>Monsoon Agro Centre</td>
                        <td>Neem Coated Urea (45 Kg)</td>
                        <td>15.3</td>
                        <td class="txt-red">65</td>
                        <td><div class="sr-status st-red"><div class="dot"></div>High Liquidation</div></td>
                        <td><button class="sr-action-btn" @onclick="OpenSalesDetails"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path><circle cx="12" cy="12" r="3"></circle></svg></button></td>
                    </tr>
                    <tr>
                        <td><input type="checkbox" class="sr-checkbox"></td>
                        <td>Monsoon Agro Centre</td>
                        <td>Neem Coated Urea (45 Kg)</td>
                        <td>15.3</td>
                        <td class="txt-yellow">18</td>
                        <td><div class="sr-status st-yellow"><div class="dot"></div>Normal</div></td>
                        <td><button class="sr-action-btn" @onclick="OpenSalesDetails"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path><circle cx="12" cy="12" r="3"></circle></svg></button></td>
                    </tr>
                    <tr>
                        <td><input type="checkbox" class="sr-checkbox"></td>
                        <td>Monsoon Agro Centre</td>
                        <td>Neem Coated Urea (45 Kg)</td>
                        <td>15.3</td>
                        <td class="txt-green">8</td>
                        <td><div class="sr-status st-green"><div class="dot"></div>Fast Moving</div></td>
                        <td><button class="sr-action-btn" @onclick="OpenSalesDetails"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path><circle cx="12" cy="12" r="3"></circle></svg></button></td>
                    </tr>
                    <tr>
                        <td><input type="checkbox" class="sr-checkbox"></td>
                        <td>Monsoon Agro Centre</td>
                        <td>Neem Coated Urea (45 Kg)</td>
                        <td>15.3</td>
                        <td class="txt-orange">35</td>
                        <td><div class="sr-status st-orange"><div class="dot"></div>Slow Moving</div></td>
                        <td><button class="sr-action-btn" @onclick="OpenSalesDetails"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path><circle cx="12" cy="12" r="3"></circle></svg></button></td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="sr-pagination">
            <div class="sr-page-size">
                <span>Items Per Page</span>
                <select class="sr-form-select" style="padding: 6px 32px 6px 12px; width: 65px;"><option>16</option></select>
            </div>
            <div class="sr-page-controls">
                <button class="sr-page-btn"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg></button>
                <button class="sr-page-btn active">1</button>
                <button class="sr-page-btn">2</button>
                <button class="sr-page-btn">3</button>
                <button class="sr-page-btn dots">..</button>
                <button class="sr-page-btn">8</button>
                <button class="sr-page-btn">9</button>
                <button class="sr-page-btn">10</button>
                <button class="sr-page-btn"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg></button>
            </div>
        </div>
    </div>
</div>

<SalesDetailsDrawer @bind-IsOpen="isSalesDetailsOpen" />

@code {
    private bool isSalesDetailsOpen = false;

    private void OpenSalesDetails()
    {
        isSalesDetailsOpen = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(100); 
            await JS.InvokeVoidAsync("loadSalesCharts");
        }
    }
}