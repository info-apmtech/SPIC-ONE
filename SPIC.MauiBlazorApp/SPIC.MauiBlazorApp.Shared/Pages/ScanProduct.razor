@page "/ScanProduct"


    <style>
       

        /* --- Header --- */
        .page-header-row {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 24px;
            margin-top: 24px;
        }
        .page-title {
            color: #1F2937;
            font-weight: 700;
            font-size: 1.5rem;
            margin: 0;
        }
        .page-subtitle {
            font-size: 0.85rem;
            color: #6B7280;
            margin-top: 4px;
        }

        /* --- Buttons --- */
        .btn-outline-green {
            border: 1px solid #10B981;
            color: #10B981;
            background-color: transparent;
            font-size: 0.85rem;
            font-weight: 600;
            padding: 6px 12px;
            border-radius: 8px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: 0.2s;
        }
        .btn-outline-green:hover { background-color: #ECFDF5; }

        /* Ensure the header button is compact and anchored to the right */
        .page-header-row .btn-outline-green { margin-left: auto; min-width: 110px; max-width: 160px; width: auto; }

        .btn-primary-blue {
            background-color: #3B82F6;
            color: #ffffff;
            border: none;
            font-size: 0.85rem;
            font-weight: 600;
            padding: 12px 24px;
            border-radius: 8px;
            width: 100%;
            max-width: 250px;
            transition: 0.2s;
        }
        .btn-primary-blue:hover { background-color: #2563EB; }

        .btn-outline-gray {
            border: 1px solid #D1D5DB;
            color: #4B5563;
            background-color: #ffffff;
            font-size: 0.85rem;
            font-weight: 600;
            padding: 12px 24px;
            border-radius: 8px;
            width: 100%;
            max-width: 250px;
            transition: 0.2s;
            cursor: pointer;
        }
        .btn-outline-gray:hover { background-color: #F3F4F6; }

        /* --- Main Cards --- */
        .main-card {
            background: #ffffff;
            border-radius: 12px;
            border: 1px solid #E5E7EB;
            box-shadow: 0 1px 2px rgba(0,0,0,0.02);
            padding: 24px;
            margin-bottom: 24px;
        }
        
        .section-title {
            font-size: 1.1rem;
            font-weight: 700;
            color: #374151;
            margin-bottom: 16px;
        }

        /* --- Top Metric Cards --- */
        .metric-card {
            border-radius: 12px;
            padding: 20px;
            height: 100%;
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }
        
        .metric-card-title { font-size: 0.9rem; font-weight: 700; color: #4B5563; margin-bottom: 8px;}
        .metric-card-value { font-size: 1.8rem; font-weight: 700; color: #1F2937; margin: 0; line-height: 1;}
        .metric-icon-box {
            position: absolute;
            top: 20px;
            right: 20px;
            width: 44px;
            height: 44px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
        }

        /* Card 1: Total Entries */
        .card-total { background-color: #FAFAFA; border: 1px solid #F3E8FF; }
        .card-total .metric-icon-box { background-color: #F3E8FF; color: #A855F7; }
        .progress-bar-custom {
            height: 6px; background-color: #E5E7EB; border-radius: 10px; width: 100%; margin-top: 12px; overflow: hidden;
        }
        .progress-fill { height: 100%; background-color: #059669; border-radius: 10px; }
        .progress-labels { display: flex; justify-content: space-between; font-size: 0.7rem; color: #6B7280; font-weight: 600; margin-top: 6px;}

        /* Card 2: Active */
        .card-active { background: linear-gradient(135deg, #ECFDF5 0%, #D1FAE5 100%); border: 1px solid #A7F3D0; }
        .card-active .metric-icon-box { color: #059669; top: 16px; right: auto; left: 20px;}
        .card-active .metric-card-title { margin-top: 40px;}

        /* Card 3: This Month */
        .card-month { background: linear-gradient(135deg, #EFF6FF 0%, #DBEAFE 100%); border: 1px solid #BFDBFE; }
        .card-month .metric-icon-box { color: #2563EB; top: 16px; right: auto; left: 20px;}
        .card-month .metric-card-title { margin-top: 40px;}

        /* Card 4: Remaining */
        .card-remaining { background: linear-gradient(135deg, #FEF2F2 0%, #FEE2E2 100%); border: 1px solid #FECACA; }
        .card-remaining .metric-icon-box { color: #DC2626; top: 16px; right: auto; left: 20px;}
        .card-remaining .metric-card-title { margin-top: 40px;}


        /* --- Scan & Upload Areas --- */
        .scan-upload-area {
            border: 2px dashed #A7F3D0;
            border-radius: 12px;
            background-color: #FAFAFA;
            padding: 32px 18px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            box-sizing: border-box; /* ensure border and padding are inside the box */
            width: 100%;
            /* Avoid forcing full height — let the card determine height from padding and min-height */
            min-height: 260px;
        }

        .scan-icon { font-size: 4rem; color: #86EFAC; margin-bottom: 16px; }
        .upload-icon { font-size: 4rem; color: #86EFAC; margin-bottom: 16px; }

        .area-title { font-size: 1.05rem; font-weight: 700; color: #1F2937; margin-bottom: 6px; }
        .area-subtitle { font-size: 0.85rem; color: #6B7280; font-weight: 500; margin-bottom: 24px; }

        /* --- How It Works Section --- */
        .how-it-works-row {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 20px;
            margin-top: 24px;
        }
        
        .step-item {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            flex: 1;
        }
        
        .step-icon {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background-color: #F0FDF4;
            color: #059669;
            border: 1px solid #D1FAE5;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            flex-shrink: 0;
        }
        
        .step-content h4 {
            font-size: 0.85rem;
            font-weight: 700;
            color: #1F2937;
            margin: 0 0 4px 0;
        }
        
        .step-content p {
            font-size: 0.75rem;
            color: #6B7280;
            margin: 0;
            line-height: 1.4;
        }

        @@media (max-width: 992px) {
            .how-it-works-row { flex-direction: column; }
        }

    </style>

    <div class="container-fluid" style="max-width: 1200px; margin: auto;">
         
        <div class="page-header-row">
            <div>
                <h1 class="page-title">Scan Product</h1>
                <div class="page-subtitle">Scan your product QR code to earn lucky draw entries and rewards</div>
            </div>
            <button class="btn-outline-green"><i class="bi bi-search"></i> View Entries</button>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-lg-5 col-md-12">
                <div class="metric-card card-total">
                    <div class="metric-card-title">Total Entries</div>
                    <div class="metric-icon-box"><i class="bi bi-gift-fill"></i></div>
                    
                    <div class="metric-card-value mb-1">12</div>
                    <div class="area-subtitle mb-0" style="font-size: 0.75rem;">Total Lucky Draw Entries</div>
                    
                    <div class="progress-bar-custom">
                        <div class="progress-fill" style="width: 12%;"></div>
                    </div>
                    <div class="progress-labels">
                        <span>0</span>
                        <span>100 entries</span>
                    </div>
                </div>
            </div>

            <div class="col-lg-2 col-md-4">
                <div class="metric-card card-active">
                    <div class="metric-icon-box"><i class="bi bi-person-check-fill"></i></div>
                    <div class="metric-card-title">Active</div>
                    <div class="metric-card-value">12</div>
                </div>
            </div>

            <div class="col-lg-2 col-md-4">
                <div class="metric-card card-month">
                    <div class="metric-icon-box"><i class="bi bi-calendar-event-fill"></i></div>
                    <div class="metric-card-title">This Month</div>
                    <div class="metric-card-value">13</div>
                </div>
            </div>

            <div class="col-lg-3 col-md-4">
                <div class="metric-card card-remaining">
                    <div class="metric-icon-box"><i class="bi bi-hourglass-split"></i></div>
                    <div class="metric-card-title">Remaining</div>
                    <div class="metric-card-value">87</div>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-4">
            
            <div class="col-md-6">
                <div class="main-card h-100 mb-0">
                    <h3 class="section-title">QR Code Scanner</h3>
                    <div class="scan-upload-area">
                        <i class="bi bi-qr-code-scan scan-icon"></i>
                        <div class="area-title">Position QR code in frame</div>
                        <div class="area-subtitle">Camera will auto-detect</div>
                        <button class="btn-primary-blue">Start Camera Scan</button>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="main-card h-100 mb-0">
                    <h3 class="section-title">Upload Image</h3>
                    <div class="scan-upload-area">
                        <i class="bi bi-cloud-arrow-up-fill upload-icon"></i>
                        <div class="area-title">Drop image here or click to browse</div>
                        <div class="area-subtitle">Supports: JPG, PNG, PDF (Max 5MB)</div>
                        <label class="btn-outline-gray d-flex align-items-center justify-content-center m-0">
                            Browse Files
                            <input type="file" hidden accept=".jpg,.png,.pdf" />
                        </label>
                    </div>
                </div>
            </div>

        </div>

        <div class="main-card">
            <h3 class="section-title">How it Works</h3>
            
            <div class="how-it-works-row">
                <div class="step-item">
                    <div class="step-icon"><i class="bi bi-qr-code"></i></div>
                    <div class="step-content">
                        <h4>Scan product QR</h4>
                        <p>Use the scanner to read the product code</p>
                    </div>
                </div>

                <div class="step-item">
                    <div class="step-icon"><i class="bi bi-boxes"></i></div>
                    <div class="step-content">
                        <h4>Select quantity</h4>
                        <p>Choose the number of products purchased</p>
                    </div>
                </div>

                <div class="step-item">
                    <div class="step-icon"><i class="bi bi-shield-check"></i></div>
                    <div class="step-content">
                        <h4>Verify purchase</h4>
                        <p>Confirm your transaction details</p>
                    </div>
                </div>

                <div class="step-item">
                    <div class="step-icon"><i class="bi bi-ticket-perforated"></i></div>
                    <div class="step-content">
                        <h4>Get entry in lucky draw</h4>
                        <p>Automatically receive your draw entry</p>
                    </div>
                </div>
            </div>
        </div>

    </div>

   

