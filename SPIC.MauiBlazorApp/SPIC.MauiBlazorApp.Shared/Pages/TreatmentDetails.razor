@page "/TreatmentDetails"

<div class="container-fluid py-4 treatment-page">

    <PageHeader Title="Treatment 01"
                Subtitle="Track treatment details and field observation">
    </PageHeader>


    <div class="section-card">

        <h6>Visit Details</h6>

        <div class="grid-4">

            <div>
                <label>Visit Date</label>
                <input type="date" class="form-control" />
            </div>

            <div>
                <label>Field Officer / Visibility</label>
                <select class="form-control">
                    <option>Select Officer</option>
                    <option>MO</option>
                    <option>MDO</option>
                    <option>RM</option>
                </select>
            </div>

            <div>
                <label>Current Plant Stage</label>
                <select class="form-control">
                    <option>Select Stage</option>
                    <option>Seedling Stage</option>
                    <option>Vegetative Stage</option>
                    <option>Flowering Stage</option>
                    <option>Harvest Stage</option>
                </select>
            </div>

            <div>
                <label>Plant Condition</label>
                <select class="form-control">
                    <option>Select Condition</option>
                    <option>Good</option>
                    <option>Average</option>
                    <option>Poor</option>
                </select>
            </div>

        </div>

    </div>


    <div class="section-card">

        <h6>Treatment Applied</h6>

        <div class="grid-4">

            <div>
                <label>Product Used</label>
                <select class="form-control">
                    <option>Select Product</option>
                    <option>SPIC Product A</option>
                    <option>SPIC Product B</option>
                </select>
            </div>

            <div>
                <label>Dosage</label>
                <input class="form-control" placeholder="Enter dosage" />
            </div>

            <div>
                <label>Application Method</label>
                <select class="form-control">
                    <option>Select Method</option>
                    <option>Spray</option>
                    <option>Drip</option>
                    <option>Manual</option>
                </select>
            </div>

            <div>
                <label>Treatment Date</label>
                <input type="date" class="form-control" />
            </div>

            <div>
                <label>Stage of Application</label>
                <select class="form-control">
                    <option>Select Stage</option>
                    <option>Initial</option>
                    <option>Mid Stage</option>
                    <option>Final Stage</option>
                </select>
            </div>

            <div>
                <label>Remarks</label>
                <input class="form-control" />
            </div>

        </div>

    </div>


    <div class="section-card">

        <h6>Observations</h6>


        <div class="grid-2">

            <div>

                <label>
                    Physical Parameters
                </label>

                <textarea class="form-control observation-box"
                          placeholder="Plant height, leaf count, stem girth, colour...">
            </textarea>

            </div>


            <div>

                <label>
                    Yield Parameters
                </label>

                <textarea class="form-control observation-box"
                          placeholder="Tiller count, panicle length, grain filling, fruit set...">
            </textarea>

            </div>

        </div>



        <div class="mt-3">

            <label>
                Quick Observations
            </label>


            <div class="chips">

                <span>
                    Increase of More Branches
                </span>

                <span>
                    Increase of More Branches
                </span>

                <span>
                    Increase of More Branches
                </span>

                <span>
                    Increase of More Branches
                </span>

                <span>
                    Increase of More Branches
                </span>

                <span>
                    Increase of More Branches
                </span>

            </div>

        </div>




        <div class="mt-3">

            <label>
                Observation Notes
            </label>


            <textarea class="form-control observation-notes"
                      placeholder="Detailed Field Observation Notes...">
        </textarea>


        </div>


    </div>


    <div class="section-card">

        <div class="image-grid">


            <!-- Control Images -->

            <div class="image-card">

                <div class="image-header">

                    <h6>
                        Control Images
                    </h6>


                    <button class="upload-btn">
                        <i class="bi bi-plus"></i>
                        Upload Image
                    </button>

                </div>



                <div class="upload-area">

                    <i class="bi bi-cloud-upload upload-icon"></i>

                    <div>
                        Drop images or click to upload
                    </div>

                    <small>
                        JPG, PNG - Max 10MB
                    </small>

                </div>



                <div class="preview-images">


                    <img src="images/sample1.jpg" />
                    <img src="images/sample2.jpg" />
                    <img src="images/sample3.jpg" />
                    <img src="images/sample4.jpg" />
                    <img src="images/sample5.jpg" />


                </div>



                <button class="view-images-btn">

                    View All Images (15)

                    <i class="bi bi-chevron-right"></i>

                </button>


            </div>





            <!-- Treated Images -->


            <div class="image-card">

                <div class="image-header">

                    <h6>
                        Treated Images
                    </h6>


                    <button class="upload-btn">
                        <i class="bi bi-plus"></i>
                        Upload Image
                    </button>

                </div>



                <div class="upload-area">

                    <i class="bi bi-cloud-upload upload-icon"></i>

                    <div>
                        Drop images or click to upload
                    </div>

                    <small>
                        JPG, PNG - Max 10MB
                    </small>

                </div>



                <div class="preview-images">


                    <img src="images/sample6.jpg" />
                    <img src="images/sample7.jpg" />
                    <img src="images/sample8.jpg" />
                    <img src="images/sample9.jpg" />
                    <img src="images/sample10.jpg" />


                </div>



                <button class="view-images-btn">

                    View All Images (15)

                    <i class="bi bi-chevron-right"></i>

                </button>


            </div>


       
        </div>

    </div>


    <div class="section-card problem-card">

        <h6>
            Problem Identification & Recommendation
        </h6>


        <div class="problem-grid">


            <!-- Problem Observed -->

            <div>

                <label>
                    Problem Observed ?
                </label>


                <div class="toggle-group">

                    <button class="active">
                        Yes, problem identified
                    </button>


                    <button>
                        No all looks good
                    </button>

                </div>

            </div>



            <!-- Problem Category -->

            <div>

                <label>
                    Problem Category
                </label>


                <select class="form-control">

                    <option>
                        Pest Attack
                    </option>

                    <option>
                        Disease
                    </option>

                    <option>
                        Nutrient Deficiency
                    </option>

                </select>


            </div>



            <!-- Problem Description -->

            <div>

                <label>
                    Problem Description
                </label>


                <input class="form-control"
                       value="Minor fruit borer damage observed in few fruits" />

            </div>




            <!-- Severity -->

            <div>

                <label>
                    Severity
                </label>


                <select class="form-control">

                    <option>
                        Low
                    </option>

                    <option>
                        Medium
                    </option>

                    <option>
                        High
                    </option>

                </select>

            </div>




            <!-- Recommendation -->

            <div>

                <label>
                    Recommendation / Monitoring Action
                </label>


                <input class="form-control"
                       value="Continue monitoring. Use trap installation." />

            </div>





            <!-- Action Taken -->

            <div>

                <label>
                    Action Taken
                </label>


                <input class="form-control"
                       value="Field scouting and monitoring advised" />

            </div>



        </div>


    </div>


    <div class="text-end">
        <button class="btn btn-light">Save Draft</button>
        <button class="btn-success">Complete Treatment</button>
    </div>

</div>
