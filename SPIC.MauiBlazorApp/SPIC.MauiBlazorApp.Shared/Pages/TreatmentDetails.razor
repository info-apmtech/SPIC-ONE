@page "/TreatmentDetails"
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using System.IO
@inject NavigationManager NavigationManager

<div class="container-fluid py-3 px-2 treatment-page">
    <div class="treatment-heading">
        <button type="button" class="back-link" @onclick="BackToDemo"><i class="bi bi-arrow-left"></i> Back to Demo Details</button>
        <div><h4>Treatment 01 <span class="visit-badge">First Treatment</span></h4><p>CSR-2 #@CSR2Id · Field Visit Documentation</p></div>
    </div>

    <div class="treatment-section">
        <h6>Visit Details</h6>
        <div class="form-grid three-cols">
            <div class="field"><label>Visit Date</label><input type="date" class="form-control" @bind="visitDate" @bind:format="yyyy-MM-dd" /></div>
            <div class="field"><label>Field Officer / Visibility</label><select class="form-select" @bind="fieldOfficer"><option value="">Select Officer</option><option>MO</option><option>MDO</option><option>RM</option></select></div>
            <div class="field"><label>Current Plant Stage</label><select class="form-select" @bind="plantStage"><option value="">Select Stage</option><option>Seedling Stage</option><option>Vegetative Stage</option><option>Flowering Stage</option><option>Harvest Stage</option></select></div>
            <div class="field"><label>Plant Condition</label><select class="form-select" @bind="plantCondition"><option value="">Select Condition</option><option>Good</option><option>Average</option><option>Poor</option></select></div>
        </div>
    </div>

    <div class="treatment-section">
        <h6>Treatment Applied</h6>
        <div class="form-grid three-cols">
            <div class="field"><label>Product Used</label><select class="form-select" @bind="productUsed"><option value="">Select Product</option><option>SPIC Product A</option><option>SPIC Product B</option></select></div>
            <div class="field"><label>Dosage</label><input class="form-control" placeholder="e.g. 2 ml/L" @bind="dosage" /></div>
            <div class="field"><label>Application Method</label><select class="form-select" @bind="applicationMethod"><option value="">Select Method</option><option>Spray</option><option>Drip</option><option>Manual</option></select></div>
            <div class="field"><label>Treatment Date</label><input type="date" class="form-control" @bind="treatmentDate" @bind:format="yyyy-MM-dd" /></div>
            <div class="field"><label>Stage of Application</label><select class="form-select" @bind="applicationStage"><option value="">Select Stage of Application</option><option>Initial</option><option>Mid Stage</option><option>Final Stage</option></select></div>
            <div class="field"><label>Remarks</label><input class="form-control" placeholder="Any additional remarks..." @bind="treatmentRemarks" /></div>
        </div>
    </div>

    <div class="treatment-section">
        <h6>Observations</h6>
        <div class="form-grid two-cols">
            <div class="field"><label>Physical Parameters</label><textarea class="form-control observation-area" placeholder="Plant height, leaf count, stem girth, colour..." @bind="physicalParameters"></textarea></div>
            <div class="field"><label>Yield Parameters</label><textarea class="form-control observation-area" placeholder="Tiller count, panicle length, grain filling, fruit set..." @bind="yieldParameters"></textarea></div>
        </div>
        <div class="field mt-3">
            <label>Quick Observations</label>
            <div class="observation-chips">
                @foreach (var observation in quickObservationOptions)
                {
                    <button type="button" class="observation-chip @(chosenObservations.Contains(observation) ? "selected" : "")" @onclick="() => ToggleObservation(observation)">@observation</button>
                }
            </div>
        </div>
        <div class="field mt-3"><label>Observation Notes</label><textarea class="form-control notes-area" placeholder="Detailed Field Observation Notes..." @bind="observationNotes"></textarea></div>
    </div>

    <div class="treatment-section image-section">
        <div class="images-grid">
            <div class="image-panel">
                <div class="image-panel-heading"><h6>Control Images</h6><label class="upload-button" for="control-upload"><i class="bi bi-plus"></i> Upload Image</label></div>
                <div class="upload-drop"><i class="bi bi-cloud-arrow-up"></i><strong>Choose images or click to upload</strong><small>JPG, PNG · Max 10MB each</small><InputFile id="control-upload" OnChange="OnControlFiles" multiple accept="image/jpeg,image/png" /></div>
                <div class="preview-grid">@foreach (var img in controlImages.Take(5)) {
                    <img src="@img" alt="Control photo" />
                }
            </div>
            <button type="button" class="view-images" @onclick="() => showAllControls = !showAllControls">@(showAllControls ? "Hide Images" : $"View All Images ({controlImages.Count})") <i class="bi bi-chevron-right"></i></button>
            @if (showAllControls)
            {
                <div class="preview-grid expanded">@foreach (var img in controlImages) {
                    <img src="@img" alt="Control photo" />
                }
            </div>
        }
    </div>
    <div class="image-panel">
        <div class="image-panel-heading"><h6>Treated Images</h6><label class="upload-button" for="treated-upload"><i class="bi bi-plus"></i> Upload Image</label></div>
        <div class="upload-drop"><i class="bi bi-cloud-arrow-up"></i><strong>Choose images or click to upload</strong><small>JPG, PNG · Max 10MB each</small><InputFile id="treated-upload" OnChange="OnTreatedFiles" multiple accept="image/jpeg,image/png" /></div>
        <div class="preview-grid">@foreach (var img in treatedImages.Take(5)) {
            <img src="@img" alt="Treated photo" />
        }
    </div>
    <button type="button" class="view-images" @onclick="() => showAllTreated = !showAllTreated">@(showAllTreated ? "Hide Images" : $"View All Images ({treatedImages.Count})") <i class="bi bi-chevron-right"></i></button>
    @if (showAllTreated)
    {
        <div class="preview-grid expanded">@foreach (var img in treatedImages) {
            <img src="@img" alt="Treated photo" />
        }
    </div>
}
</div>
</div>
        @if (!string.IsNullOrEmpty(imageError))
{
    <p class="text-danger small mt-2">@imageError</p>
}
</div>

<div class="treatment-section">
    <h6>Problem Identification &amp; Recommendation</h6>
    <div class="form-grid three-cols">
        <div class="field"><label>Problem Observed?</label><div class="toggle-group"><button type="button" class="@(hasProblem ? "active" : "")" @onclick="() => hasProblem = true">Yes, problem identified</button><button type="button" class="@(!hasProblem ? "active okay" : "")" @onclick="() => hasProblem = false">No, all looks good</button></div></div>
        <div class="field"><label>Problem Category</label><select class="form-select" @bind="problemCategory" disabled="@(!hasProblem)"><option value="">Select Category</option><option>Pest Attack</option><option>Disease</option><option>Nutrient Deficiency</option></select></div>
        <div class="field"><label>Problem Description</label><input class="form-control" placeholder="Describe the issue observed" @bind="problemDescription" disabled="@(!hasProblem)" /></div>
        <div class="field"><label>Severity</label><select class="form-select" @bind="severity" disabled="@(!hasProblem)"><option value="">Select Severity</option><option>Low</option><option>Medium</option><option>High</option></select></div>
        <div class="field"><label>Recommendation / Monitoring Action</label><input class="form-control" placeholder="Recommended monitoring action" @bind="recommendation" /></div>
        <div class="field"><label>Action Taken</label><input class="form-control" placeholder="Field scouting and monitoring advised" @bind="actionTaken" /></div>
    </div>
</div>
<div class="form-actions"><button type="button" class="btn btn-outline-secondary" disabled title="Treatment save endpoint not yet supplied">Save Draft</button><button type="button" class="complete-btn" disabled title="Treatment completion endpoint not yet supplied">Complete First Treatment <i class="bi bi-arrow-right"></i></button></div>
<p class="text-muted small text-end mt-2">Form inputs and photo previews are local to this page. A treatment API is required to save or complete the record.</p>
</div>

<style>
    .treatment-page {
        background: #f5f8f8;
        color: #273d37;
        max-width: 1500px
    }

    .treatment-heading {
        margin: 0 0 17px 2px
    }

        .treatment-heading h4 {
            font-size: 20px;
            font-weight: 750;
            margin: 0 0 4px
        }

        .treatment-heading p {
            font-size: 11px;
            color: #929d99;
            margin: 0
        }

    .visit-badge {
        display: inline-block;
        vertical-align: middle;
        margin-left: 7px;
        border-radius: 5px;
        background: #e6efff;
        color: #4673c7;
        padding: 5px 9px;
        font-size: 10px;
        font-weight: 600
    }

    .treatment-section {
        background: #fff;
        border: 1px solid #e4ecea;
        border-radius: 9px;
        padding: 17px 19px;
        margin-bottom: 12px;
        box-shadow: 0 1px 2px #20372b08
    }

        .treatment-section > h6 {
            font-size: 14px;
            font-weight: 750;
            margin: 0 0 14px
        }

    .form-grid {
        display: grid;
        gap: 13px 17px
    }

    .three-cols {
        grid-template-columns: repeat(3,minmax(0,1fr))
    }

    .two-cols {
        grid-template-columns: repeat(2,minmax(0,1fr))
    }

    .treatment-page .field {
        min-width: 0
    }

        .treatment-page .field label {
            display: block;
            font-size: 10px;
            font-weight: 650;
            color: #55665e;
            margin-bottom: 5px
        }

    .treatment-page .form-control, .treatment-page .form-select {
        background-color: #fafafa;
        border: 1px solid #e8ecea;
        border-radius: 6px;
        min-height: 37px;
        font-size: 11px;
        color: #4a5953;
        box-shadow: none;
        padding: 7px 10px
    }

        .treatment-page .form-control:focus, .treatment-page .form-select:focus {
            border-color: #31a36d;
            background: #fff;
            box-shadow: 0 0 0 2px #31a36d15
        }

    .observation-area {
        height: 79px;
        resize: vertical
    }

    .notes-area {
        height: 77px;
        resize: vertical
    }

    .observation-chips {
        display: flex;
        gap: 7px;
        flex-wrap: wrap
    }

    .observation-chip {
        background: #fff;
        border: 1px solid #d7e0dc;
        border-radius: 5px;
        padding: 6px 11px;
        color: #52635a;
        font-size: 10px
    }

        .observation-chip.selected {
            background: #dff6e9;
            border-color: #2e9b66;
            color: #126d40
        }

    .images-grid {
        display: grid;
        grid-template-columns: repeat(2,minmax(0,1fr));
        gap: 16px
    }

    .image-section {
        padding: 12px
    }

    .image-panel {
        border: 1px solid #e8edeb;
        border-radius: 7px;
        padding: 12px;
        min-width: 0
    }

    .image-panel-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 9px
    }

        .image-panel-heading h6 {
            margin: 0;
            font-size: 13px;
            font-weight: 750
        }

    .upload-button {
        background: #087d49;
        color: white;
        font-size: 10px;
        border-radius: 4px;
        padding: 7px 12px;
        cursor: pointer
    }

    .upload-drop {
        border: 1px dashed #a8cfba;
        background: #f8fdfa;
        border-radius: 6px;
        height: 120px;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column;
        gap: 3px;
        position: relative;
        text-align: center;
        color: #1b8759
    }

        .upload-drop > i {
            font-size: 27px
        }

        .upload-drop strong {
            font-size: 10px;
            font-weight: 600
        }

        .upload-drop small {
            font-size: 9px;
            color: #a4ada7
        }

        .upload-drop input[type=file] {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            opacity: 0;
            cursor: pointer
        }

    .preview-grid {
        display: grid;
        grid-template-columns: repeat(5,minmax(0,1fr));
        gap: 5px;
        margin-top: 10px
    }

        .preview-grid img {
            height: 58px;
            object-fit: cover;
            width: 100%;
            border-radius: 4px
        }

        .preview-grid.expanded {
            grid-template-columns: repeat(auto-fill,minmax(75px,1fr))
        }

    .view-images {
        width: 100%;
        margin-top: 9px;
        background: #f2f9f5;
        border: 0;
        color: #157b49;
        font-size: 11px;
        font-weight: 650;
        padding: 9px;
        border-radius: 4px;
        display: flex;
        justify-content: center;
        gap: 8px;
        align-items: center
    }

    .toggle-group {
        display: flex;
        gap: 5px
    }

        .toggle-group button {
            flex: 1;
            border-radius: 5px;
            background: #f3f5f4;
            border: 1px solid #e4e9e6;
            font-size: 10px;
            padding: 9px 6px;
            color: #68756e
        }

            .toggle-group button.active {
                background: #fff3dd;
                border-color: #f4dcaa;
                color: #b47d1b
            }

                .toggle-group button.active.okay {
                    background: #e7f6ec;
                    border-color: #c5e9d2;
                    color: #168047
                }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin: 10px 0 0
    }

        .form-actions button {
            border-radius: 6px;
            padding: 10px 16px;
            font-size: 12px;
            font-weight: 650
        }

    .complete-btn {
        background: #087d49;
        color: #fff;
        border: none
    }

    .form-actions button:disabled {
        opacity: .55;
        cursor: not-allowed
    }
    @@media(max - width:850px)

    {
        .three-cols {
            grid-template-columns: repeat(2,minmax(0,1fr))
        }
    }
    @@media(max - width:600px)

    {
        .three-cols, .two-cols, .images-grid {
            grid-template-columns: 1fr
        }

        .treatment-section {
            padding: 14px
        }

        .form-actions {
            flex-wrap: wrap
        }

            .form-actions button {
                flex: 1
            }
    }

    .treatment-page .back-link {
        border: 0;
        background: transparent;
        color: #198754;
        padding: 0;
        margin: 0 0 10px;
        font-size: 12px;
        font-weight: 600
    }

        .treatment-page .back-link:hover {
            text-decoration: underline
        }
</style>

@code {
    [SupplyParameterFromQuery(Name = "csr2Id")] public int? CSR2Id { get; set; }
    private DateTime? visitDate = DateTime.Today, treatmentDate = DateTime.Today;
    private string fieldOfficer = "", plantStage = "", plantCondition = "", productUsed = "", dosage = "", applicationMethod = "", applicationStage = "", treatmentRemarks = "";
    private string physicalParameters = "", yieldParameters = "", observationNotes = "", problemCategory = "", problemDescription = "", severity = "", recommendation = "", actionTaken = "";
    private bool hasProblem = true, showAllControls, showAllTreated;
    private string imageError = "";
    private readonly List<string> controlImages = new();
    private readonly List<string> treatedImages = new();
    private readonly string[] quickObservationOptions = { "Increase of More Branches", "Increase of More Leaves", "Increase of More Flowers", "Increase of More Fruits", "Increase of More Tillers", "Increase of More Panicles" };
    private readonly HashSet<string> chosenObservations = new();
    private void ToggleObservation(string value) { if (!chosenObservations.Add(value)) chosenObservations.Remove(value); }
    private void BackToDemo() => NavigationManager.NavigateTo(CSR2Id is > 0 ? $"/DemoDetails?csr2Id={CSR2Id}" : "/DemoDocumentation");
    private Task OnControlFiles(InputFileChangeEventArgs e) => ReadFiles(e, controlImages);
    private Task OnTreatedFiles(InputFileChangeEventArgs e) => ReadFiles(e, treatedImages);
    private async Task ReadFiles(InputFileChangeEventArgs e, List<string> destination)
    {
        imageError = "";
        if (e.FileCount > 20) { imageError = "Select up to 20 images at a time."; return; }
        foreach (var file in e.GetMultipleFiles(20))
        {
            if (file.ContentType != "image/jpeg" && file.ContentType != "image/png") { imageError = "Only JPG and PNG images are allowed."; continue; }
            if (file.Size > 10 * 1024 * 1024) { imageError = "Each image must be 10MB or less."; continue; }
            try
            {
                await using var stream = file.OpenReadStream(10 * 1024 * 1024);
                using var memory = new MemoryStream();
                await stream.CopyToAsync(memory);
                destination.Add($"data:{file.ContentType};base64,{Convert.ToBase64String(memory.ToArray())}");
            }
            catch (Exception) { imageError = "One or more images could not be opened."; }
        }
    }
}
