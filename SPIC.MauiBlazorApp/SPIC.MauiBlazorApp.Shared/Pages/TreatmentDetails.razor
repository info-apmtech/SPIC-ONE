@code {
    [SupplyParameterFromQuery(Name = "csr2Id")] public int? CSR2Id { get; set; }
    private DateTime? visitDate = DateTime.Today, treatmentDate = DateTime.Today;
    private string fieldOfficer = "", plantStage = "", plantCondition = "", productUsed = "", dosage = "", applicationMethod = "", applicationStage = "", treatmentRemarks = "";
    private string physicalParameters = "", yieldParameters = "", observationNotes = "", problemCategory = "", problemDescription = "", severity = "", recommendation = "", actionTaken = "";
    private bool hasProblem = true, showAllControls, showAllTreated;
    private string imageError = "";
    private readonly List<string> controlImages = new();
    private List<PhotoRef> savedControlPhotos = new(), savedTreatedPhotos = new();
    private readonly List<string> treatedImages = new();
    private readonly string[] quickObservationOptions = { "Increase of More Branches", "Increase of More Leaves", "Increase of More Flowers", "Increase of More Fruits", "Increase of More Tillers", "Increase of More Panicles" };
    private readonly HashSet<string> chosenObservations = new();
    private void SetProblemObserved(bool value)
    {
        hasProblem = value;
        if (!value)
        {
            problemCategory = "";
            problemDescription = "";
            severity = "";
            recommendation = "";
            actionTaken = "";
        }
    }
    private void ToggleObservation(string value) { if (!chosenObservations.Add(value)) chosenObservations.Remove(value); }
    private sealed class LookupItem { public int Id { get; set; } public string Name { get; set; } = ""; }
    private sealed class OfficerItem { public string Id { get; set; } = ""; public string Name { get; set; } = ""; }
    private sealed class Lookups
    {
        public List<LookupItem> Stages { get; set; } = new();
        public List<LookupItem> Products { get; set; } = new();
        public List<OfficerItem> Officers { get; set; } = new();
        public string? DefaultFieldOfficerUserId { get; set; }
    }
    private sealed class PhotoRef { public int Id { get; set; } public string PhotoType { get; set; } = ""; public string FileName { get; set; } = ""; }
    private sealed class TreatmentDto
    {
        public JsonElement Status { get; set; }
        public DateTime? VisitDate { get; set; }
        public DateTime? TreatmentDate { get; set; }
        public string? FieldOfficerUserId { get; set; }
        public int? CropStageId { get; set; }
        public string? PlantCondition { get; set; }
        public int? ProductId { get; set; }
        public string? Dosage { get; set; }
        public string? ApplicationMethod { get; set; }
        public string? ApplicationStage { get; set; }
        public string? TreatmentRemarks { get; set; }
        public string? PhysicalParameters { get; set; }
        public string? YieldParameters { get; set; }
        public string? ObservationNotes { get; set; }
        public bool HasProblem { get; set; }
        public string? ProblemCategory { get; set; }
        public string? ProblemDescription { get; set; }
        public string? Severity { get; set; }
        public string? Recommendation { get; set; }
        public string? ActionTaken { get; set; }
        public List<string> QuickObservations { get; set; } = new();
        public List<PhotoRef> Photos { get; set; } = new();
    }
    private TreatmentDto? previousTreatment;
    private string previousTreatmentError = "";
    private string PreviousStageName => previousTreatment?.CropStageId is int id
        ? stageOptions.FirstOrDefault(x => x.Id == id)?.Name ?? $"Stage #{id}"
        : "-";
    private static string ReferenceDisplay(params string?[] values) =>
        values.FirstOrDefault(v => !string.IsNullOrWhiteSpace(v)) ?? "-";
    private void ViewPreviousTreatment() => NavigationManager.NavigateTo(
        $"/TreatmentDetails?csr2Id={CSR2Id}&treatmentNumber={TreatmentNumber - 1}");

    private List<OfficerItem> officerOptions = new();
    private List<LookupItem> stageOptions = new(), productOptions = new();
    private bool isSaving;
    private bool isCompleted;
    private string saveError = "", saveSuccess = "";
    [SupplyParameterFromQuery(Name = "treatmentNumber")]
    public int? RequestedTreatmentNumber { get; set; }
    private int TreatmentNumber => RequestedTreatmentNumber is > 0 ? RequestedTreatmentNumber.Value : 1;
    // Load independent API requests concurrently to reduce initial page latency.
    protected override async Task OnParametersSetAsync()
    {
        saveError = saveSuccess = previousTreatmentError = "";
        isCompleted = false;
        previousTreatment = null;
        if (CSR2Id is null or <= 0) { saveError = "Missing csr2Id."; return; }

        try
        {
            int csrId = CSR2Id.Value;
            int number = TreatmentNumber;
            var lookupTask = Http.GetFromJsonAsync<Lookups>($"api/DemoDocumentation/treatment/lookups?csr2Id={csrId}");
            var currentTask = GetTreatmentAsync(csrId, number);
            var previousTask = number > 1 ? GetTreatmentAsync(csrId, number - 1) : Task.FromResult<TreatmentDto?>(null);

            await Task.WhenAll(lookupTask, currentTask, previousTask);
            var lookup = await lookupTask;
            var t = await currentTask;
            previousTreatment = await previousTask;

            stageOptions = lookup?.Stages ?? new();
            productOptions = lookup?.Products ?? new();
            officerOptions = (lookup?.Officers ?? new())
                .Where(o => !string.IsNullOrWhiteSpace(o.Id))
                .GroupBy(o => o.Id, StringComparer.OrdinalIgnoreCase)
                .Select(g => g.First())
                .OrderBy(o => o.Name)
                .ToList();
            var defaultId = lookup?.DefaultFieldOfficerUserId;
            fieldOfficer = officerOptions.Any(o => o.Id == defaultId) ? defaultId! : "";

            // Avoid carrying data from the previous route when switching treatment numbers.
            visitDate = treatmentDate = DateTime.Today;
            plantStage = plantCondition = productUsed = dosage = applicationMethod = applicationStage = treatmentRemarks = "";
            physicalParameters = yieldParameters = observationNotes = problemCategory = problemDescription = severity = recommendation = actionTaken = "";
            hasProblem = true;
            chosenObservations.Clear();
            controlImages.Clear();
            treatedImages.Clear();
            savedControlPhotos.Clear();
            savedTreatedPhotos.Clear();
            pendingControls.Clear();
            pendingTreated.Clear();
            showAllControls = showAllTreated = false;

            if (t == null) return;
            visitDate = t.VisitDate;
            treatmentDate = t.TreatmentDate;
            if (!string.IsNullOrWhiteSpace(t.FieldOfficerUserId))
            {
                fieldOfficer = t.FieldOfficerUserId;
                if (!officerOptions.Any(o => o.Id == fieldOfficer))
                    officerOptions.Add(new OfficerItem { Id = fieldOfficer, Name = $"Assigned employee ({fieldOfficer})" });
            }
            plantStage = t.CropStageId?.ToString() ?? "";
            plantCondition = t.PlantCondition ?? "";
            productUsed = t.ProductId?.ToString() ?? "";
            dosage = t.Dosage ?? "";
            applicationMethod = t.ApplicationMethod ?? "";
            applicationStage = t.ApplicationStage ?? "";
            treatmentRemarks = t.TreatmentRemarks ?? "";
            physicalParameters = t.PhysicalParameters ?? "";
            yieldParameters = t.YieldParameters ?? "";
            observationNotes = t.ObservationNotes ?? "";
            hasProblem = t.HasProblem;
            problemCategory = t.ProblemCategory ?? "";
            problemDescription = t.ProblemDescription ?? "";
            severity = t.Severity ?? "";
            recommendation = t.Recommendation ?? "";
            actionTaken = t.ActionTaken ?? "";
            foreach (var obs in t.QuickObservations ?? new()) chosenObservations.Add(obs);
            savedControlPhotos = (t.Photos ?? new()).Where(x => x.PhotoType == "Control").ToList();
            savedTreatedPhotos = (t.Photos ?? new()).Where(x => x.PhotoType == "Treated").ToList();

            // Bounded parallel reads preserve preview order while limiting network load.
            var previews = await LoadPhotoPreviewsAsync(savedControlPhotos.Concat(savedTreatedPhotos).ToList());
            controlImages.AddRange(previews.Take(savedControlPhotos.Count));
            treatedImages.AddRange(previews.Skip(savedControlPhotos.Count));
            isCompleted = t.Status.ToString() == "Completed" || t.Status.ToString() == "1";
            if (isCompleted)
                saveSuccess = "This treatment has already been completed.";
        }
        catch (Exception ex) { saveError = $"Could not load treatment: {ex.Message}"; }
    }

    private async Task<TreatmentDto?> GetTreatmentAsync(int csr2Id, int number)
    {
        using var response = await Http.GetAsync($"api/DemoDocumentation/treatment/details?csr2Id={csr2Id}&treatmentNumber={number}");
        if (response.StatusCode == HttpStatusCode.NotFound) return null;
        response.EnsureSuccessStatusCode();
        return await response.Content.ReadFromJsonAsync<TreatmentDto>();
    }

    private async Task<string[]> LoadPhotoPreviewsAsync(List<PhotoRef> photos)
    {
        using var throttle = new SemaphoreSlim(3);
        var tasks = photos.Select(async photo =>
        {
            await throttle.WaitAsync();
            try { return await PhotoPreviewAsync(photo); }
            finally { throttle.Release(); }
        });
        return await Task.WhenAll(tasks);
    }

    private async Task SaveTreatmentAsync(bool complete)
    {
        if (isSaving) return;
        saveError = saveSuccess = "";
        if (isCompleted) { saveError = "This treatment is already completed."; return; }
        if (CSR2Id is null or <= 0) { saveError = "Invalid CSR-2 ID."; return; }
        if (complete && (!visitDate.HasValue || !treatmentDate.HasValue ||
                         !int.TryParse(plantStage, out var stageId) || stageId <= 0 ||
                         !int.TryParse(productUsed, out var productId) || productId <= 0))
        {
            saveError = "Enter Visit Date, Treatment Date, Current Plant Stage and Product Used before completing the treatment.";
            return;
        }
        isSaving = true;
        try
        {
            var payload = new
            {
                CSR2Id = CSR2Id.Value,
                TreatmentNumber,
                VisitDate = visitDate,
                FieldOfficerUserId = fieldOfficer,
                CropStageId = int.TryParse(plantStage, out var sid) ? (int?)sid : null,
                PlantCondition = plantCondition,
                ProductId = int.TryParse(productUsed, out var pid) ? (int?)pid : null,
                Dosage = dosage,
                ApplicationMethod = applicationMethod,
                TreatmentDate = treatmentDate,
                ApplicationStage = applicationStage,
                TreatmentRemarks = treatmentRemarks,
                PhysicalParameters = physicalParameters,
                YieldParameters = yieldParameters,
                ObservationNotes = observationNotes,
                HasProblem = hasProblem,
                ProblemCategory = hasProblem ? problemCategory : "",
                ProblemDescription = hasProblem ? problemDescription : "",
                Severity = hasProblem ? severity : "",
                Recommendation = hasProblem ? recommendation : "",
                ActionTaken = hasProblem ? actionTaken : "",
                QuickObservations = chosenObservations.ToList()
            };
            // New images are separate multipart uploads; for completion save the draft first.
            using var response = await Http.PostAsJsonAsync("api/DemoDocumentation/treatment/save", payload);
            if (!response.IsSuccessStatusCode) { saveError = await response.Content.ReadAsStringAsync(); return; }
            if (pendingControls.Count > 0) await UploadPendingAsync("Control", pendingControls);
            if (pendingTreated.Count > 0) await UploadPendingAsync("Treated", pendingTreated);
            if (complete)
            {
                using var completed = await Http.PostAsJsonAsync("api/DemoDocumentation/treatment/complete", payload);
                if (!completed.IsSuccessStatusCode) { saveError = await completed.Content.ReadAsStringAsync(); return; }
            }
            if (complete) isCompleted = true;
            saveSuccess = complete ? "Treatment completed successfully." : "Draft saved successfully.";
        }
        catch (Exception ex) { saveError = $"Save failed: {ex.Message}"; }
        finally { isSaving = false; }
    }
    private async Task<string> PhotoPreviewAsync(PhotoRef photo)
    {
        var bytes = await Http.GetByteArrayAsync($"api/DemoDocumentation/treatment/photo/{photo.Id}");
        var contentType = photo.FileName.EndsWith(".png", StringComparison.OrdinalIgnoreCase) ? "image/png" : "image/jpeg";
        return $"data:{contentType};base64,{Convert.ToBase64String(bytes)}";
    }
    private readonly List<(string Name, string ContentType, byte[] Bytes)> pendingControls = new(), pendingTreated = new();
    private async Task UploadPendingAsync(string kind, List<(string Name, string ContentType, byte[] Bytes)> pending)
    {
        using var form = new MultipartFormDataContent();
        form.Add(new StringContent(CSR2Id!.Value.ToString()), "csr2Id");
        form.Add(new StringContent(TreatmentNumber.ToString()), "treatmentNumber");
        form.Add(new StringContent(kind), "photoType");
        foreach (var file in pending)
        {
            var bytes = new ByteArrayContent(file.Bytes);
            bytes.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
            form.Add(bytes, "files", file.Name);
        }
        using var response = await Http.PostAsync("api/DemoDocumentation/treatment/photos", form);
        response.EnsureSuccessStatusCode();
        pending.Clear();
    }
    private void BackToDemo() => NavigationManager.NavigateTo(CSR2Id is > 0 ? $"/DemoDetails?csr2Id={CSR2Id}" : "/DemoDocumentation");
    private Task OnControlFiles(InputFileChangeEventArgs e) => ReadFiles(e, controlImages, pendingControls);
    private Task OnTreatedFiles(InputFileChangeEventArgs e) => ReadFiles(e, treatedImages, pendingTreated);
    private async Task ReadFiles(InputFileChangeEventArgs e, List<string> destination, List<(string Name, string ContentType, byte[] Bytes)> pending)
    {
        imageError = "";
        if (e.FileCount > 20) { imageError = "Select up to 20 images at a time."; return; }
        foreach (var file in e.GetMultipleFiles(20))
        {
            if (file.ContentType != "image/jpeg" && file.ContentType != "image/png") { imageError = "Only JPG and PNG images are allowed."; continue; }
            if (file.Size > 10 * 1024 * 1024) { imageError = "Each image must be 10MB or less."; continue; }
            try
            {
                await using var stream = file.OpenReadStream(10 * 1024 * 1024);
                using var memory = new MemoryStream();
                await stream.CopyToAsync(memory);
                var fileBytes = memory.ToArray();
                destination.Add($"data:{file.ContentType};base64,{Convert.ToBase64String(fileBytes)}");
                pending.Add((file.Name, file.ContentType, fileBytes));
            }
            catch (Exception) { imageError = "One or more images could not be opened."; }
        }
    }
}
