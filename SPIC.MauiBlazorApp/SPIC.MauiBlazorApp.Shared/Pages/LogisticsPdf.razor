    protected override Task OnParametersSetAsync()
    {
        var key =
            $"{RequestedTab}:{RequestedId}:{SelectedCompany}";

        if (string.Equals(
                key,
                _loadedKey,
                StringComparison.Ordinal))
        {
            return Task.CompletedTask;
        }

        _loadedKey = key;

        // Do not call protected APIs yet. On a browser refresh the shared
        // LoginState/Http authorization header is recreated only after
        // sessionStorage is available in the interactive browser.
        _pendingDataLoad = true;
        _isLoading = true;
        _errorMessage = null;
        _item = null;
        _documentEntries = new();

        return Task.CompletedTask;
    }


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_sessionReady)
        {
            var restored =
                await RestorePdfSessionAsync();

            if (!restored)
            {
                Nav.NavigateTo(
                    "/login",
                    forceLoad: false);

                return;
            }

            _sessionReady = true;
        }

        if (_pendingDataLoad)
        {
            _pendingDataLoad = false;

            await LoadPdfData();

            // Render the saved-document previews only after the data-bound
            // document cards exist in the DOM.
            _pendingSavedDocumentRender =
                _documentEntries.Count > 0;

            StateHasChanged();
            return;
        }

        if (_pendingSavedDocumentRender)
        {
            _pendingSavedDocumentRender = false;

            await RenderSavedDocumentPreviewsAsync();
        }
    }


    private async Task<bool> RestorePdfSessionAsync()
    {
        try
        {
            // Same-tab navigation normally already has LoginState.Token.
            // Direct browser refresh recreates the app, so restore it from
            // the same sessionStorage keys used by MainLayout.
            var token =
                LoginState.Token;

            if (string.IsNullOrWhiteSpace(token))
            {
                token =
                    await JS.InvokeAsync<string?>(
                        "sessionStorage.getItem",
                        "jwt_token");
            }

            if (string.IsNullOrWhiteSpace(token))
                return false;

            var rawToken =
                token.StartsWith(
                    "Bearer ",
                    StringComparison.OrdinalIgnoreCase)
                    ? token["Bearer ".Length..]
                    : token;

            Http.DefaultRequestHeaders.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue(
                    "Bearer",
                    rawToken);

            LoginState.Token =
                rawToken;

            // Restore the same optional client state MainLayout restores.
            var roleAccess =
                await JS.InvokeAsync<string?>(
                    "sessionStorage.getItem",
                    "spic_role_access");

            LoginState.SetAllowedPages(
                roleAccess);

            var expStr =
                await JS.InvokeAsync<string?>(
                    "sessionStorage.getItem",
                    "jwt_expiration");

            if (!string.IsNullOrWhiteSpace(expStr)
                && DateTime.TryParse(
                    expStr,
                    out var expiration))
            {
                LoginState.Expiration =
                    expiration;

                if (expiration <= DateTime.Now)
                    return false;
            }

            return true;
        }
        catch
        {
            return false;
        }
    }


    private async Task LoadPdfData()
    {
        _isLoading = true;

        _errorMessage = null;

        _item = null;

        _documentEntries = new();

        try
        {
            if (RequestedId <= 0)
            {
                throw new InvalidOperationException(
                    "A valid logistics record id is required.");
            }


            var api =
                RequestedTab switch
                {
                    // Same source used in Logistics.razor.
                    "Warehouse" =>
                        "api/Warehouse/all",

                    // ActiveTab == Port is Rake Point.
                    "Port" =>
                        "api/RackPoint/all",

                    // ActiveTab == PortMaster is actual Port.
                    "PortMaster" =>
                        "api/Port/all",

                    _ =>
                        throw new InvalidOperationException(
                            "Invalid logistics tab. Use Warehouse, Port, or PortMaster.")
                };


            var items =
                await Http.GetFromJsonAsync<List<LogisticsItemDto>>(
                    api)
                ?? new();


            _item =
                items.FirstOrDefault(
                    x => x.Id == RequestedId);


            if (_item is null)
            {
                throw new InvalidOperationException(
                    $"No {GetEntityDisplayName()} record was found for ID {RequestedId}.");
            }

            if (!IsActualPort && HasCompanyFilter)
            {
                if (IsSpicPdf && _item.InSpic != true)
                {
                    throw new InvalidOperationException(
                        "SPIC is not selected for this Logistics record.");
                }

                if (IsGreenStarPdf && _item.InGreenStar != true)
                {
                    throw new InvalidOperationException(
                        "GreenStar is not selected for this Logistics record.");
                }
            }


            // Lookup failures should not block the PDF itself.
            // If a lookup is unavailable, the corresponding display falls back to "-".
            var statesTask =
                SafeGetList<StateDto>(
                    "api/State/all");

            var districtsTask =
                SafeGetList<DistrictDto>(
                    "api/District/all");

            var regionsTask =
                SafeGetList<RegionDto>(
                    "api/Region/all");

            var headquartersTask =
                SafeGetList<HeadquarterDto>(
                    "api/Headquarter/all");

            var usersTask =
                SafeGetList<UserInfoLookupDto>(
                    "api/UserInfo/all");


            await Task.WhenAll(
                statesTask,
                districtsTask,
                regionsTask,
                headquartersTask,
                usersTask);


            _states =
                await statesTask;

            _districts =
                await districtsTask;

            _regions =
                await regionsTask;

            _headquarters =
                await headquartersTask;


            BuildUserNameLookup(
                await usersTask);


            if (!IsActualPort)
            {
                _documentEntries =
                    BuildDocumentEntries(
                        _item);
            }
        }
        catch (Exception ex)
        {
            _errorMessage =
                ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }


    private async Task<List<T>> SafeGetList<T>(
        string url)
    {
        try
        {
            return
                await Http.GetFromJsonAsync<List<T>>(
                    url)
                ?? new();
        }
        catch
        {
            return new();
        }
    }


    private void BuildUserNameLookup(
        List<UserInfoLookupDto> users)
    {
        _userNamesById =
            users
                .Where(
                    x =>
                        !string.IsNullOrWhiteSpace(
                            x.Id))
                .GroupBy(
                    x =>
                        x.Id.Trim(),
                    StringComparer.OrdinalIgnoreCase)
                .ToDictionary(
                    g =>
                        g.Key,
                    g =>
                    {
                        var user =
                            g.First();

                        if (!string.IsNullOrWhiteSpace(
                                user.Name))
                        {
                            return
                                user.Name.Trim();
                        }

                        if (!string.IsNullOrWhiteSpace(
                                user.UserName))
                        {
                            return
                                user.UserName.Trim();
                        }

                        return
                            user.Id.Trim();
                    },
                    StringComparer.OrdinalIgnoreCase);
    }


    private static string NormalizeCompany(
        string? value)
    {
        var normalized =
            (value ?? string.Empty)
                .Trim()
                .Replace(" ", string.Empty)
                .Replace("-", string.Empty)
                .Replace("_", string.Empty)
                .ToLowerInvariant();

        return normalized switch
        {
            "spic" =>
                "SPIC",

            "greenstar" =>
                "GreenStar",

            "gfl" =>
                "GreenStar",

            "greenstarfertilizers" =>
                "GreenStar",

            _ =>
                string.Empty
        };
    }


    private static string NormalizeTab(
        string? value)
    {
        var normalized =
            (value ?? string.Empty)
                .Trim()
                .Replace(
                    " ",
                    string.Empty)
                .Replace(
                    "-",
                    string.Empty)
                .Replace(
                    "_",
                    string.Empty)
                .ToLowerInvariant();


        return normalized switch
        {
            "warehouse" =>
                "Warehouse",

            // Existing Logistics.razor internal value.
            "port" =>
                "Port",

            // Friendly Rake Point aliases.
            "rakepoint" =>
                "Port",

            "rackpoint" =>
                "Port",

            "rake" =>
                "Port",

            // Existing Logistics.razor internal value.
            "portmaster" =>
                "PortMaster",

            // Friendly actual-Port aliases.
            "actualport" =>
                "PortMaster",

            "seaport" =>
                "PortMaster",

            _ =>
                value?.Trim()
                ?? string.Empty
        };
    }


