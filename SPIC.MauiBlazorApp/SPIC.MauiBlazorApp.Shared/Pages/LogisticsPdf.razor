            if (IsSpicPdf)
                return "SOUTHERN PETROCHEMICAL INDUSTRIES CORPORATION";

            if (IsGreenStarPdf)
                return "GREENSTAR FERTILIZERS LIMITED";

            if (_item?.InSpic == true
                && _item?.InGreenStar == true)
            {
                return "SPIC / GREEN STAR";
