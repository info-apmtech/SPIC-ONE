        get
        {
            if (_item is null)
                return "-";

            if (IsRakePoint)
            {
                if (!string.IsNullOrWhiteSpace(_item.SAPCode))
                    return _item.SAPCode!;

                return TextOrDash(_item.RailwayCode);
            }

            if (IsWarehouse)
                return TextOrDash(_item.WarehouseCode);

            return "-";
        }
    }


    private string LatitudeLongitudeDisplay
    {
        get
        {
            if (_item is null)
                return "-";

            if (!_item.Latitude.HasValue
                && !_item.Longitude.HasValue)
            {
                return "-";
            }

            if (_item.Latitude.HasValue
                && _item.Longitude.HasValue)
            {
                return
                    $"{FormatCoordinate(_item.Latitude)}, {FormatCoordinate(_item.Longitude)}";
            }

            return _item.Latitude.HasValue
                ? FormatCoordinate(_item.Latitude)
                : FormatCoordinate(_item.Longitude);
        }
    }


    protected override async Task OnParametersSetAsync()
    {
        var key =
            $"{RequestedTab}:{RequestedId}:{SelectedCompany}";

        if (string.Equals(
                key,
                _loadedKey,
                StringComparison.Ordinal))
        {
            return;
        }

        _loadedKey =
            key;

        // Parent /Logistics already has the authenticated HttpClient.
        // Reuse that working session directly.
        await LoadPdfData();

        _pendingSavedDocumentRender =
            _documentEntries.Count > 0;
    }


    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (!_pendingSavedDocumentRender)
            return;

        _pendingSavedDocumentRender =
            false;

        await RenderSavedDocumentPreviewsAsync();
    }


    private async Task LoadPdfData()
    {
        _isLoading = true;

        _errorMessage = null;

        _item = null;

        _documentEntries = new();

        try
        {
            if (RequestedId <= 0)
            {
                throw new InvalidOperationException(
                    "A valid logistics record id is required.");
            }


            var api =
                RequestedTab switch
                {
                    // Same source used in Logistics.razor.
                    "Warehouse" =>
                        "api/Warehouse/all",

                    // ActiveTab == Port is Rake Point.
                    "Port" =>
                        "api/RackPoint/all",

                    // ActiveTab == PortMaster is actual Port.
                    "PortMaster" =>
                        "api/Port/all",

                    _ =>
                        throw new InvalidOperationException(
                            "Invalid logistics tab. Use Warehouse, Port, or PortMaster.")
                };


            var items =
                await Http.GetFromJsonAsync<List<LogisticsItemDto>>(
                    api)
                ?? new();


            _item =
                items.FirstOrDefault(
                    x => x.Id == RequestedId);


            if (_item is null)
            {
                throw new InvalidOperationException(
                    $"No {GetEntityDisplayName()} record was found for ID {RequestedId}.");
            }

            if (!IsActualPort && HasCompanyFilter)
            {
                if (IsSpicPdf && _item.InSpic != true)
                {
                    throw new InvalidOperationException(
                        "SPIC is not selected for this Logistics record.");
                }

                if (IsGreenStarPdf && _item.InGreenStar != true)
                {
                    throw new InvalidOperationException(
                        "GreenStar is not selected for this Logistics record.");
                }
            }


            // Lookup failures should not block the PDF itself.
            // If a lookup is unavailable, the corresponding display falls back to "-".
            var statesTask =
                SafeGetList<StateDto>(
                    "api/State/all");

            var districtsTask =
                SafeGetList<DistrictDto>(
                    "api/District/all");

            var regionsTask =
                SafeGetList<RegionDto>(
                    "api/Region/all");

            var headquartersTask =
                SafeGetList<HeadquarterDto>(
                    "api/Headquarter/all");

            var usersTask =
                SafeGetList<UserInfoLookupDto>(
                    "api/UserInfo/all");


            await Task.WhenAll(
                statesTask,
                districtsTask,
                regionsTask,
                headquartersTask,
                usersTask);


            _states =
                await statesTask;

            _districts =
                await districtsTask;

            _regions =
                await regionsTask;

            _headquarters =
                await headquartersTask;


            BuildUserNameLookup(
                await usersTask);


            if (!IsActualPort)
            {
                _documentEntries =
                    BuildDocumentEntries(
                        _item);
            }
        }
        catch (Exception ex)
        {
            _errorMessage =
                ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }


    private async Task<List<T>> SafeGetList<T>(
        string url)
    {
        try
        {
            return
                await Http.GetFromJsonAsync<List<T>>(
                    url)
                ?? new();
        }
        catch
        {
            return new();
        }
    }


    private void BuildUserNameLookup(
        List<UserInfoLookupDto> users)
    {
        _userNamesById =
            users
                .Where(
                    x =>
                        !string.IsNullOrWhiteSpace(
                            x.Id))
                .GroupBy(
                    x =>
                        x.Id.Trim(),
                    StringComparer.OrdinalIgnoreCase)
                .ToDictionary(
                    g =>
                        g.Key,
                    g =>
                    {
                        var user =
                            g.First();

                        if (!string.IsNullOrWhiteSpace(
                                user.Name))
                        {
                            return
                                user.Name.Trim();
                        }

                        if (!string.IsNullOrWhiteSpace(
                                user.UserName))
                        {
                            return
                                user.UserName.Trim();
                        }

                        return
                            user.Id.Trim();
                    },
                    StringComparer.OrdinalIgnoreCase);
    }


    private static string NormalizeCompany(
        string? value)
    {
        var normalized =
            (value ?? string.Empty)
                .Trim()
                .Replace(" ", string.Empty)
                .Replace("-", string.Empty)
                .Replace("_", string.Empty)
                .ToLowerInvariant();

        return normalized switch
        {
            "spic" =>
                "SPIC",

            "greenstar" =>
                "GreenStar",

            "gfl" =>
                "GreenStar",

            "greenstarfertilizers" =>
                "GreenStar",

            _ =>
                string.Empty
        };
    }


    private static string NormalizeTab(
        string? value)
    {
        var normalized =
            (value ?? string.Empty)
                .Trim()
                .Replace(
                    " ",
                    string.Empty)
                .Replace(
                    "-",
                    string.Empty)
                .Replace(
                    "_",
                    string.Empty)
                .ToLowerInvariant();


        return normalized switch
        {
            "warehouse" =>
                "Warehouse",

            // Existing Logistics.razor internal value.
            "port" =>
                "Port",

            // Friendly Rake Point aliases.
            "rakepoint" =>
                "Port",

            "rackpoint" =>
                "Port",

            "rake" =>
                "Port",

            // Existing Logistics.razor internal value.
            "portmaster" =>
                "PortMaster",

            // Friendly actual-Port aliases.
            "actualport" =>
                "PortMaster",

            "seaport" =>
                "PortMaster",

            _ =>
                value?.Trim()
                ?? string.Empty
        };
    }


