    private string GetUserDisplay(
        string? userId)
    {
        if (string.IsNullOrWhiteSpace(
                userId))
        {
            return "-";
        }

        var id =
            userId.Trim();

        if (_userNamesById.TryGetValue(
                id,
                out var name)
            && !string.IsNullOrWhiteSpace(
                name))
        {
            return name;
        }

        return id;
    }


    // ===============================================================
    // DOCUMENT BINDING
    //
    // Same saved fields used by Logistics.razor:
    //
    // GstDocumentPath
    // InsuranceDocumentPath
    // FertilizerLicenseDocumentPath
    // OtherDocumentPathsJson
    //
    // Supplemental company-specific document type is detected from
    // the same folder naming convention used by Logistics.razor.
    // ===============================================================

    private List<DocumentEntry> BuildDocumentEntries(
        LogisticsItemDto item)
    {
        var entries =
            new List<DocumentEntry>();

        var seen =
            new HashSet<string>(
                StringComparer.OrdinalIgnoreCase);


        void AddEntry(
            string? path,
            string? fallbackType = null,
            string? fallbackCompany = null)
        {
            if (string.IsNullOrWhiteSpace(
                    path))
            {
                return;
            }

            var cleanPath =
                path.Trim();

            if (!seen.Add(
                    cleanPath))
            {
                return;
            }


            var fileName =
                GetFileName(
                    cleanPath);


            var detectedType =
                GetDocumentTypeName(
                    cleanPath);


            // Existing helper returns the raw filename when a folder does not
            // identify the type. Primary DB fields still have a known type,
            // so use that field meaning as the fallback.
            if (!string.IsNullOrWhiteSpace(
                    fallbackType)
                && string.Equals(
                    detectedType,
                    fileName,
                    StringComparison.OrdinalIgnoreCase))
            {
                detectedType =
                    fallbackType;
            }


            var detectedCompany =
                GetDocumentCompany(
                    cleanPath);


            entries.Add(
                new DocumentEntry
                {
                    Path =
                        cleanPath,

                    TypeName =
                        string.IsNullOrWhiteSpace(
                            detectedType)
                            ? fallbackType
                                ?? "Document"
                            : detectedType,

                    Company =
                        detectedCompany
                        ?? fallbackCompany,

                    FileName =
                        fileName
                });
        }


        if (IsWarehouse)
        {
            var category =
                item.WarehouseCategory
                ?? LogisticsWarehouseCategory.PvtWH;


            var pvtOrBoth =
                category
                    is LogisticsWarehouseCategory.PvtWH
                    or LogisticsWarehouseCategory.Both;


            AddEntry(
                item.GstDocumentPath,
                pvtOrBoth
                    && item.InSpic == true
                        ? "SPIC GST"
                        : "GST Document",
                pvtOrBoth
                    && item.InSpic == true
                        ? "SPIC"
                        : null);


            AddEntry(
                item.InsuranceDocumentPath,
                "Insurance Document");


            AddEntry(
                item.FertilizerLicenseDocumentPath,
                pvtOrBoth
                    && item.InSpic == true
                        ? "SPIC Fertilizer License"
                        : "Fertilizer License",
                pvtOrBoth
                    && item.InSpic == true
                        ? "SPIC"
                        : null);
        }
        else
        {
            AddEntry(
                item.GstDocumentPath,
                "GST Document");

            AddEntry(
                item.InsuranceDocumentPath,
                "Insurance Document");

            AddEntry(
                item.FertilizerLicenseDocumentPath,
                "Fertilizer License");
        }


        foreach (
            var path
            in DeserializeDocumentPaths(
                item.OtherDocumentPathsJson))
        {
            AddEntry(
                path);
        }


        if (!HasCompanyFilter)
            return entries;

        return entries
            .Where(entry =>
                string.IsNullOrWhiteSpace(entry.Company)
                || (IsSpicPdf
                    && string.Equals(
                        entry.Company,
                        "SPIC",
                        StringComparison.OrdinalIgnoreCase))
                || (IsGreenStarPdf
                    && string.Equals(
                        entry.Company,
                        "Green Star",
                        StringComparison.OrdinalIgnoreCase)))
            .ToList();
    }


    private static List<string> DeserializeDocumentPaths(
        string? json)
    {
        if (string.IsNullOrWhiteSpace(
                json))
        {
            return new();
        }

        try
        {
            return
                JsonSerializer
                    .Deserialize<List<string>>(
                        json)
                    ?.Where(
                        x =>
                            !string.IsNullOrWhiteSpace(
                                x))
                    .Distinct(
                        StringComparer.OrdinalIgnoreCase)
                    .ToList()
                ?? new();
        }
        catch
        {
            return new();
        }
    }


    private static string GetFileName(
        string? path)
    {
        if (string.IsNullOrWhiteSpace(
                path))
        {
            return string.Empty;
        }

        var normalized =
            path.Replace(
                '\\',
                '/');

        var lastSlash =
            normalized.LastIndexOf('/');

        return lastSlash >= 0
            ? normalized[
                (lastSlash + 1)..]
            : normalized;
    }


    private static string GetDocumentTypeName(
        string? path)
    {
        if (string.IsNullOrWhiteSpace(
                path))
        {
            return "Document";
        }

        var normalized =
            path
                .Replace(
                    '\\',
                    '/')
                .ToLowerInvariant();


        if (normalized.Contains(
                "/gst_spic/"))
        {
            return "SPIC GST";
        }

        if (normalized.Contains(
                "/gst_gfl/"))
        {
            return "GREEN STAR GST";
        }

        if (normalized.Contains(
                "/gst_trading/"))
        {
            return "Trading Document";
        }

        if (normalized.Contains(
                "/insurance_spic/"))
        {
            return "SPIC Insurance";
        }

        if (normalized.Contains(
                "/insurance_gfl/"))
        {
            return "GREEN STAR Insurance";
        }

        if (normalized.Contains(
                "/insurance/"))
        {
            return "Insurance Document";
        }

        if (normalized.Contains(
                "/fertilizerlicense_spic/"))
        {
            return "SPIC Fertilizer License";
        }

        if (normalized.Contains(
                "/fertilizerlicense_gfl/"))
        {
            return "GREEN STAR Fertilizer License";
        }

        if (normalized.Contains(
                "/other/"))
        {
            return "Other Document";
        }


        var name =
            GetFileName(
                path);


        return string.IsNullOrWhiteSpace(
                name)
            ? "Document"
            : name;
    }


    private static string? GetDocumentCompany(
        string? path)
    {
        if (string.IsNullOrWhiteSpace(
                path))
        {
            return null;
        }

        var normalized =
            path
                .Replace(
                    '\\',
                    '/')
                .ToLowerInvariant();


        if (normalized.Contains(
                "/gst_spic/")
            || normalized.Contains(
                "/insurance_spic/")
            || normalized.Contains(
                "/fertilizerlicense_spic/"))
        {
            return "SPIC";
        }


        if (normalized.Contains(
                "/gst_gfl/")
            || normalized.Contains(
                "/insurance_gfl/")
            || normalized.Contains(
                "/fertilizerlicense_gfl/"))
        {
            return "Green Star";
        }


        return null;
    }


    // ===============================================================
    // SAVED DOCUMENT PREVIEW
    //
    // Uses the same LogisticsFile/view endpoint as Logistics.razor.
    // Nothing is re-saved or changed here; this is display-only.
    // ===============================================================

    private static string ToSavedDocumentRelativePath(
        string path)
    {
        var normalized =
            (path ?? string.Empty)
                .Replace('\\', '/')
                .TrimStart('/');

        if (normalized.StartsWith(
                "uploads/",
                StringComparison.OrdinalIgnoreCase))
        {
            normalized =
                normalized["uploads/".Length..];
        }

        return normalized;
    }


    private string GetSavedDocumentViewUrl(
        string? path)
    {
        if (string.IsNullOrWhiteSpace(path))
            return string.Empty;

        if (path.StartsWith(
                "http://",
                StringComparison.OrdinalIgnoreCase)
            || path.StartsWith(
                "https://",
                StringComparison.OrdinalIgnoreCase))
        {
            return path;
        }

        var baseUrl =
            Http.BaseAddress
                ?.ToString()
                .TrimEnd('/')
            ?? string.Empty;

        var relative =
            ToSavedDocumentRelativePath(
                path);

        var url =
            $"{baseUrl}/api/LogisticsFile/view/{relative}";

        var token =
            LoginState.Token;

        if (!string.IsNullOrWhiteSpace(token))
        {
            var rawToken =
                token.StartsWith(
                    "Bearer ",
                    StringComparison.OrdinalIgnoreCase)
                    ? token["Bearer ".Length..]
                    : token;

            url +=
                $"?access_token={Uri.EscapeDataString(rawToken)}";
        }

        return url;
    }


    private static bool IsPdfDocument(
        string? path)
    {
        if (string.IsNullOrWhiteSpace(path))
            return false;

        return string.Equals(
            System.IO.Path.GetExtension(path),
            ".pdf",
            StringComparison.OrdinalIgnoreCase);
    }


    private static bool IsImageDocument(
        string? path)
    {
        if (string.IsNullOrWhiteSpace(path))
            return false;

        var ext =
            System.IO.Path
                .GetExtension(path)
                .ToLowerInvariant();

        return ext
            is ".jpg"
            or ".jpeg"
            or ".png"
            or ".gif"
            or ".webp"
            or ".bmp";
    }


    private static string GetSavedDocumentIcon(
        string? path)
    {
        if (string.IsNullOrWhiteSpace(path))
            return "bi-file-earmark";

        var ext =
            System.IO.Path
                .GetExtension(path)
                .ToLowerInvariant();

        return ext switch
        {
            ".pdf" =>
                "bi-file-earmark-pdf-fill",

            ".jpg" or ".jpeg" or ".png"
                or ".gif" or ".webp" or ".bmp" =>
                "bi-file-earmark-image-fill",

            ".doc" or ".docx" =>
                "bi-file-earmark-word-fill",

            ".xls" or ".xlsx" =>
                "bi-file-earmark-excel-fill",

            _ =>
                "bi-file-earmark-fill"
        };
    }


    private static string GetSavedDocumentViewLabel(
        string? path)
    {
        if (string.IsNullOrWhiteSpace(path))
            return "View File";

        var ext =
            System.IO.Path
                .GetExtension(path)
                .ToLowerInvariant();

        return ext switch
        {
            ".pdf" =>
                "View PDF",

            ".jpg" or ".jpeg" or ".png"
                or ".gif" or ".webp" or ".bmp" =>
                "View Image",

            ".doc" or ".docx" =>
                "View Doc",

            ".xls" or ".xlsx" =>
                "View Excel",

            _ =>
                "View File"
        };
    }


    private async Task RenderSavedDocumentPreviewsAsync()
    {
        try
        {
            await EnsureLogisticsPdfRuntimeAsync();

            await JS.InvokeVoidAsync(
                "logisticsPdfRuntime.renderSavedDocuments",
                ".logistics-saved-pdf-target");
        }
        catch (Exception ex)
        {
            // Preview failure must never affect Warehouse / Rake Point PDF data.
            Console.WriteLine(
                $"Saved document preview failed: {ex.Message}");
        }
    }


    private async Task PrintDocument()
    {
        try
        {
            await EnsureLogisticsPdfRuntimeAsync();

            await JS.InvokeVoidAsync(
                "logisticsPdfRuntime.printAllPages",
                "logistics-pdf-document",
                PageTitleText);
        }
        catch (Exception ex)
        {
            // Do not fall back to window.print() on the live /Logistics page,
            // because that prints MainLayout/search/sidebar and can clip content.
            Console.WriteLine(
                $"Logistics PDF print failed: {ex.Message}");
        }
    }


    private bool _logisticsPdfRuntimeReady;


    private async Task EnsureLogisticsPdfRuntimeAsync()
    {
        if (_logisticsPdfRuntimeReady)
            return;

        // Self-contained component runtime.
        // No App.razor modification and no local JS file are required.
        await JS.InvokeVoidAsync(
            "eval",
            LogisticsPdfRuntimeScript);

        _logisticsPdfRuntimeReady =
            true;
    }


    private const string LogisticsPdfRuntimeScript = """
(function () {
    "use strict";

    if (
        window.logisticsPdfRuntime &&
        window.logisticsPdfRuntime.version === "dealer-style-v1"
    ) {
        return;
    }

    const PDFJS_VERSION = "3.11.174";
    const PDFJS_URL =
        "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/" +
        PDFJS_VERSION +
        "/pdf.min.js";
    const PDFJS_WORKER =
        "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/" +
        PDFJS_VERSION +
        "/pdf.worker.min.js";

    let pdfJsPromise = null;

    function wait(ms) {
        return new Promise(resolve => setTimeout(resolve, ms));
    }

    function showMessage(target, title, detail, isError) {
        target.innerHTML = "";

        const box = document.createElement("div");
        box.style.padding = "20px";
        box.style.textAlign = "center";
        box.style.fontSize = "11px";
        box.style.lineHeight = "1.5";
        box.style.borderRadius = "6px";

        if (isError) {
            box.style.color = "#991b1b";
            box.style.border = "1px solid #fecaca";
            box.style.background = "#fff7f7";
        } else {
            box.style.color = "#6b7280";
        }

        const heading = document.createElement("div");
        heading.style.fontWeight = "700";
        heading.textContent = title;
        box.appendChild(heading);

        if (detail) {
            const small = document.createElement("div");
            small.style.marginTop = "4px";
            small.style.fontSize = "10px";
            small.textContent = detail;
            box.appendChild(small);
        }

        target.appendChild(box);
    }

    function loadPdfJs() {
        if (window.pdfjsLib) {
            try {
                window.pdfjsLib.GlobalWorkerOptions.workerSrc =
                    PDFJS_WORKER;
            } catch {
            }

            return Promise.resolve(window.pdfjsLib);
        }

        if (pdfJsPromise) {
            return pdfJsPromise;
        }

        pdfJsPromise = new Promise((resolve, reject) => {
            const existing = Array.from(document.scripts || [])
                .find(script =>
                    (script.src || "").includes(
                        "pdf.js/3.11.174/pdf.min.js"
                    )
                );

            const finishWhenReady = () => {
                let count = 0;

                const timer = window.setInterval(() => {
                    count++;

                    if (window.pdfjsLib) {
                        window.clearInterval(timer);

                        try {
                            window.pdfjsLib
                                .GlobalWorkerOptions
                                .workerSrc =
                                PDFJS_WORKER;
                        } catch {
                        }

                        resolve(window.pdfjsLib);
                        return;
                    }

                    if (count >= 160) {
                        window.clearInterval(timer);
                        reject(
                            new Error(
                                "PDF.js did not become available."
                            )
                        );
                    }
                }, 50);
            };

            if (existing) {
                finishWhenReady();
                return;
            }

            const script = document.createElement("script");
            script.src = PDFJS_URL;
            script.async = true;
            script.crossOrigin = "anonymous";

            script.onload = () => {
                if (!window.pdfjsLib) {
                    reject(
                        new Error(
                            "PDF.js loaded but pdfjsLib is unavailable."
                        )
                    );
                    return;
                }

                try {
                    window.pdfjsLib
                        .GlobalWorkerOptions
                        .workerSrc =
                        PDFJS_WORKER;
                } catch {
                }

                resolve(window.pdfjsLib);
            };

            script.onerror = () => {
                reject(
                    new Error(
                        "Unable to load PDF.js CDN."
                    )
                );
            };

            document.head.appendChild(script);
        });

        pdfJsPromise = pdfJsPromise.catch(error => {
            pdfJsPromise = null;
            throw error;
        });

        return pdfJsPromise;
    }

    async function fetchPdfBytes(url) {
        const response = await fetch(url, {
            method: "GET",
            credentials: "include",
            cache: "no-store"
        });

        if (!response.ok) {
            throw new Error(
                "Document request failed. HTTP " +
                response.status
            );
        }

        const contentType =
            (
                response.headers.get("content-type") ||
                ""
            ).toLowerCase();

        if (
            contentType &&
            !contentType.includes("pdf") &&
            !contentType.includes("octet-stream")
        ) {
            throw new Error(
                "Response is not a PDF (" +
                contentType +
                ")."
            );
        }

        const buffer = await response.arrayBuffer();

        if (!buffer || buffer.byteLength === 0) {
            throw new Error("PDF file is empty.");
        }

        return buffer;
    }

    async function renderPdfTarget(
        target,
        pdfjsLib,
        maxRetries
    ) {
        if (target.classList.contains("rendered")) {
            return;
        }

        if (target.dataset.rendering === "true") {
            for (let index = 0; index < 150; index++) {
                if (target.dataset.rendering !== "true") {
                    return;
                }

                await wait(100);
            }

            return;
        }

        const url = target.getAttribute("data-pdf-url");

        if (!url) {
            showMessage(
                target,
                "Unable to preview this PDF.",
                "Document URL is empty.",
                true
            );
            return;
        }

        target.dataset.rendering = "true";

        showMessage(
            target,
            "Loading document pages...",
            "",
            false
        );

        let lastError = null;

        for (
            let attempt = 1;
            attempt <= maxRetries;
            attempt++
        ) {
            try {
                /*
                 * Same core behaviour as the working DealerPDF:
                 * fetch ourselves -> pass bytes to PDF.js ->
                 * render every PDF page.
                 */
                const bytes = await fetchPdfBytes(url);

                const loadingTask =
                    pdfjsLib.getDocument({
                        data: bytes
                    });

                const pdf =
                    await loadingTask.promise;

                target.innerHTML = "";

                for (
                    let pageNumber = 1;
                    pageNumber <= pdf.numPages;
                    pageNumber++
                ) {
                    const page =
                        await pdf.getPage(pageNumber);

                    const viewport =
                        page.getViewport({
                            scale: 1.5
                        });

                    const canvas =
                        document.createElement("canvas");

                    const context =
                        canvas.getContext(
                            "2d",
                            { alpha: false }
                        );

                    if (!context) {
                        throw new Error(
                            "Canvas rendering is unavailable."
                        );
                    }

                    canvas.width =
                        Math.ceil(viewport.width);

                    canvas.height =
                        Math.ceil(viewport.height);

                    await page.render({
                        canvasContext: context,
                        viewport: viewport,
                        background: "#ffffff"
                    }).promise;

                    /*
                     * Visually identical to the DealerPDF canvas preview,
                     * but converted to <img> so cloned print documents keep
                     * the rendered PDF page.
                     */
                    const image =
                        document.createElement("img");

                    image.src =
                        canvas.toDataURL(
                            "image/jpeg",
                            0.95
                        );

                    image.alt =
                        (
                            target.dataset.documentTitle ||
                            "Attached document"
                        ) +
                        " - Page " +
                        pageNumber;

                    image.className =
                        "logistics-saved-pdf-page";

                    image.style.display = "block";
                    image.style.width = "100%";
                    image.style.maxWidth = "100%";
                    image.style.height = "auto";
                    image.style.maxHeight = "none";
                    image.style.objectFit = "contain";
                    image.style.margin =
                        "0 auto 15px auto";
                    image.style.background = "#ffffff";
                    image.style.border =
                        "1px solid #d1d5db";
                    image.style.boxShadow =
                        "0 2px 5px rgba(0,0,0,0.1)";

                    target.appendChild(image);

                    canvas.width = 1;
                    canvas.height = 1;
                }

                target.classList.add("rendered");
                target.dataset.rendered = "true";
                delete target.dataset.rendering;

                return;
            } catch (error) {
                lastError = error;

                console.error(
                    "Attempt " +
                    attempt +
                    "/" +
                    maxRetries +
                    " failed for Logistics PDF:",
                    url,
                    error
                );

                if (attempt < maxRetries) {
                    await wait(
                        attempt * 1000
                    );
                }
            }
        }

        delete target.dataset.rendering;
        target.dataset.rendered = "error";

        showMessage(
            target,
            "Unable to preview this PDF.",
            lastError?.message ||
                String(lastError || ""),
            true
        );
    }

    async function renderSavedDocuments(
        selector
    ) {
        const targets =
            Array.from(
                document.querySelectorAll(
                    selector ||
                    ".logistics-saved-pdf-target"
                )
            );

        if (targets.length === 0) {
            return;
        }

        let pdfjsLib;

        try {
            pdfjsLib = await loadPdfJs();
        } catch (error) {
            console.error(
                "Unable to initialize PDF.js.",
                error
            );

            for (const target of targets) {
                if (
                    !target.classList.contains(
                        "rendered"
                    )
                ) {
                    showMessage(
                        target,
                        "Unable to preview this PDF.",
                        error?.message ||
                            String(error),
                        true
                    );
                }
            }

            return;
        }

        for (const target of targets) {
            await renderPdfTarget(
                target,
                pdfjsLib,
                3
            );
        }
    }

    function cloneStylesForPrint() {
        return Array.from(
            document.querySelectorAll(
                'link[rel="stylesheet"], style'
            )
        )
        .map(node => node.outerHTML)
        .join("\n");
    }

    async function waitForImages(
        printDocument
    ) {
        const images =
            Array.from(
                printDocument.querySelectorAll(
                    "img"
                )
            );

        await Promise.all(
            images.map(image => {
                if (image.complete) {
                    return Promise.resolve();
                }

                return new Promise(resolve => {
                    let completed = false;

                    const done = () => {
                        if (completed) {
                            return;
                        }

                        completed = true;
                        resolve();
                    };

                    image.addEventListener(
                        "load",
                        done,
                        { once: true }
                    );

                    image.addEventListener(
                        "error",
                        done,
                        { once: true }
                    );

                    window.setTimeout(
                        done,
                        4000
                    );
                });
            })
        );
    }

    async function printAllPages(
        elementId,
        title
    ) {
        /*
         * Keep the currently-working saved-document behaviour.
         * Try to finish previews before print, but never block forever.
         */
        try {
            await Promise.race([
                renderSavedDocuments(
                    ".logistics-saved-pdf-target"
                ),
                wait(15000)
            ]);
        } catch (error) {
            console.warn(
                "Saved document rendering did not finish before print.",
                error
            );
        }

        const sourceDocument =
            document.getElementById(
                elementId
            );

        if (!sourceDocument) {
            throw new Error(
                "Print source '" +
                elementId +
                "' was not found."
            );
        }

        /*
         * VISUAL FIX:
         *
         * Clone the FULL .page-wrapper, not only .view-document.
         *
         * The real screen design defines:
         * - CSS custom properties
         * - PDF font size
         * - font family
         * - line height
         * - desktop document hierarchy
         *
         * on .page-wrapper.
         *
         * Cloning only .view-document removes that inherited context and
         * changes header text wrapping, spacing and overall PDF proportions.
         */
        const sourceRoot =
            sourceDocument.closest(
                ".page-wrapper"
            ) ||
            sourceDocument;

        const clone =
            sourceRoot.cloneNode(
                true
            );

        clone
            .querySelectorAll(
                ".screen-only, " +
                ".pdf-back-row, " +
                ".pdf-print-btn, " +
                "button"
            )
            .forEach(
                element =>
                    element.remove()
            );

        const oldFrame =
            document.getElementById(
                "logistics-pdf-print-frame"
            );

        if (oldFrame) {
            oldFrame.remove();
        }

        const iframe =
            document.createElement(
                "iframe"
            );

        iframe.id =
            "logistics-pdf-print-frame";

        /*
         * Desktop-sized print viewport:
         * prevents screen max-width media rules from switching
         * the cloned PDF to a mobile/single-column layout.
         */
        iframe.style.position =
            "fixed";

        iframe.style.left =
            "-20000px";

        iframe.style.top =
            "0";

        iframe.style.width =
            "1200px";

        iframe.style.height =
            "1000px";

        iframe.style.border =
            "0";

        iframe.style.background =
            "#ffffff";

        iframe.style.opacity =
            "0";

        iframe.style.pointerEvents =
            "none";

        document.body.appendChild(
            iframe
        );

        const printWindow =
            iframe.contentWindow;

        const printDocument =
            iframe.contentDocument ||
            printWindow?.document;

        if (
            !printWindow ||
            !printDocument
        ) {
            iframe.remove();

            throw new Error(
                "Unable to create the print document."
            );
        }

        const baseHref =
            document.baseURI;

        const allStyles =
            cloneStylesForPrint();

        /*
         * IMPORTANT:
         * Do NOT redesign the PDF for print.
         * Preserve the real screen dimensions/fonts/grids.
         *
         * Only remove:
         * - fixed viewport behaviour
         * - scroll clipping
         * - screen action buttons
         *
         * and add safe page-break rules.
         */
        const printOverrides = `
<style>
    @page {
        size: A4 portrait;
        margin: 0;
    }

    html,
    body {
        width: 100% !important;

        height: auto !important;
        min-height: 0 !important;
        max-height: none !important;

        margin: 0 !important;
        padding: 0 !important;

        overflow: visible !important;

        background: #ffffff !important;
    }

    body {
        display: block !important;
        position: static !important;
    }

    /*
     * Screen .page-wrapper is fixed/100vh/scrollable.
     * Remove ONLY those viewer restrictions.
     *
     * Keep its CSS variables, font family, font size,
     * line-height and normal child hierarchy.
     */
    .page-wrapper {
        position: static !important;
        inset: auto !important;

        width: 100% !important;

        height: auto !important;
        min-height: 0 !important;
        max-height: none !important;

        margin: 0 !important;
        padding: 0 !important;

        display: block !important;

        overflow: visible !important;
        overflow-x: visible !important;
        overflow-y: visible !important;

        background: #ffffff !important;
    }

    /*
     * Preserve the SAME document proportions used by the screen.
     * Do not change header grids, fonts, body padding or field layout.
     */
    .view-document {
        position: relative !important;

        display: block !important;

        width: 210mm !important;
        max-width: 850px !important;

        height: auto !important;
        min-height: 297mm !important;
        max-height: none !important;

        margin: 0 auto !important;

        overflow: visible !important;
        overflow-x: visible !important;
        overflow-y: visible !important;

        background: #ffffff !important;

        border: 0 !important;
        box-shadow: none !important;
    }

    .view-body,
    .view-section,
    .table-wrapper,
    .logistics-attached-documents,
    .logistics-document-preview-card,
    .logistics-saved-pdf-target {
        height: auto !important;
        min-height: 0 !important;
        max-height: none !important;

        overflow: visible !important;
        overflow-x: visible !important;
        overflow-y: visible !important;
    }

    /*
     * Allow the full Logistics content to continue naturally
     * onto page 2, page 3, etc.
     */
    .view-section {
        break-inside: auto !important;
        page-break-inside: auto !important;
    }

    .view-section-title {
        break-after: avoid-page !important;
        page-break-after: avoid !important;
    }

    .view-table {
        width: 100% !important;

        break-inside: auto !important;
        page-break-inside: auto !important;
    }

    .view-table thead {
        display:
            table-header-group !important;
    }

    .view-table tfoot {
        display:
            table-footer-group !important;
    }

    .view-table tr,
    .sub-card,
    .reservation-card,
    .remarks-box {
        break-inside:
            avoid-page !important;

        page-break-inside:
            avoid !important;
    }

    /*
     * Keep the DealerPDF-style Attached Documents section
     * on a clean page without changing its screen design.
     */
    .logistics-attached-documents {
        break-before:
            page !important;

        page-break-before:
            always !important;
    }

    .logistics-document-preview-card {
        break-inside:
            auto !important;

        page-break-inside:
            auto !important;
    }

    /*
     * Same principle as DealerPDF:
     * each saved PDF page fits safely inside A4.
     */
    .logistics-saved-pdf-page {
        display: block !important;

        width: auto !important;
        max-width: 100% !important;

        height: auto !important;
        max-height: 225mm !important;

        object-fit: contain !important;

        margin:
            0 auto 15px auto !important;

        border: 0 !important;
        box-shadow: none !important;

        break-inside:
            avoid-page !important;

        page-break-inside:
            avoid !important;
    }

    .screen-only,
    .pdf-back-row,
    .pdf-print-btn,
    button {
        display: none !important;
    }

    /*
     * Preserve SPIC / GreenStar / yellow section colours.
     */
    .view-header,
    .view-section-title,
    .view-section-icon,
    .view-table th,
    .summary-bar,
    .status-pill,
    .approval-pill,
    .company-pill {
        -webkit-print-color-adjust:
            exact !important;

        print-color-adjust:
            exact !important;
    }
</style>`;

        printDocument.open();

        printDocument.write(
            "<!doctype html>" +
            '<html><head>' +
            '<meta charset="utf-8">' +
            '<meta name="viewport" ' +
            'content="width=1200, initial-scale=1">' +
            '<base href="' +
            baseHref +
            '">' +
            "<title>" +
            String(
                title ||
                "Logistics PDF"
            )
                .replace(
                    /</g,
                    "&lt;"
                )
                .replace(
                    />/g,
                    "&gt;"
                ) +
            "</title>" +
            allStyles +
            printOverrides +
            "</head><body>" +
            clone.outerHTML +
            "</body></html>"
        );

        printDocument.close();

        /*
         * Wait for copied stylesheet links.
         */
        try {
            const styleLinks =
                Array.from(
                    printDocument
                        .querySelectorAll(
                            'link[rel="stylesheet"]'
                        )
                );

            await Promise.all(
                styleLinks.map(link => {
                    if (link.sheet) {
                        return Promise.resolve();
                    }

                    return new Promise(
                        resolve => {
                            let finished =
                                false;

                            const done = () => {
                                if (finished) {
                                    return;
                                }

                                finished = true;
                                resolve();
                            };

                            link.addEventListener(
                                "load",
                                done,
                                { once: true }
                            );

                            link.addEventListener(
                                "error",
                                done,
                                { once: true }
                            );

                            window.setTimeout(
                                done,
                                3000
                            );
                        }
                    );
                })
            );
        } catch {
        }

        await waitForImages(
            printDocument
        );

        try {
            if (
                printDocument.fonts &&
                printDocument.fonts.ready
            ) {
                await Promise.race([
                    printDocument
                        .fonts
                        .ready,
                    wait(3000)
                ]);
            }
        } catch {
        }

        /*
         * Two layout frames + short delay:
         * allows Chromium to restore the exact screen grid
         * before calculating A4 pagination.
         */
        try {
            await new Promise(
                resolve => {
                    printWindow
                        .requestAnimationFrame(
                            () => {
                                printWindow
                                    .requestAnimationFrame(
                                        resolve
                                    );
                            }
                        );
                }
            );
        } catch {
        }

        await wait(250);

        let removed = false;

        const cleanup = () => {
            if (removed) {
                return;
            }

            removed = true;

            try {
                iframe.remove();
            } catch {
            }
        };

        try {
            printWindow
                .addEventListener(
                    "afterprint",
                    cleanup,
                    { once: true }
                );
        } catch {
        }

        try {
            printWindow.focus();

            printWindow.print();

            window.setTimeout(
                cleanup,
                60000
            );
        } catch (error) {
            cleanup();
            throw error;
        }
    }

    window.logisticsPdfRuntime = {
        version: "dealer-style-v1",
        renderSavedDocuments:
            renderSavedDocuments,
        printAllPages:
            printAllPages
    };

    console.info(
        "Logistics PDF Dealer-style runtime ready."
    );
})();
""";


