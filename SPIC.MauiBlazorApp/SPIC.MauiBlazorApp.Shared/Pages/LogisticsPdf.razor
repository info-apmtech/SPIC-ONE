@using System.Net.Http.Json
@using System.Text.Json
@using System.Globalization
@using Microsoft.AspNetCore.Components
@using SPIC.Core.Entities

@inject HttpClient Http
@inject NavigationManager Nav
@inject Microsoft.JSInterop.IJSRuntime JS
@inject SPIC.MauiBlazorApp.Shared.Services.LoginState LoginState

<PageTitle>@PageTitleText</PageTitle>


<div class="page-wrapper">

    @if (_isLoading)
    {
        <div class="state-card">
            <div class="loading-spinner"></div>
            <span>Loading logistics details...</span>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="state-card error">
            <strong>Unable to load Logistics PDF view.</strong>
            <span>@_errorMessage</span>
        </div>
    }
    else if (_item is null)
    {
        <div class="state-card error">
            <strong>Logistics record not found.</strong>
        </div>
    }
    else
    {
        <div class="pdf-back-row">
            <button type="button"
                    class="pdf-back-btn"
                    @onclick="BackToLogistics">
                <i class="bi bi-arrow-left"></i>
                Back
            </button>

            <button type="button"
                    class="pdf-print-btn"
                    @onclick="PrintDocument">
                <i class="bi bi-printer-fill"></i>
                Print / Save PDF
            </button>
        </div>

        <main id="logistics-pdf-document" class="view-document">

            <!-- =====================================================
                 HEADER
                 ===================================================== -->
            <header class="view-header">

                <div class="view-logo">

                    @if (IsActualPort || ShowSpicCompanyData)
                    {
                        <img src="_content/SPIC.MauiBlazorApp.Shared/images/loginimages/logo.png"
                             alt="SPIC" />
                    }

                    @if (!IsActualPort && ShowGreenStarCompanyData)
                    {
                        <img src="_content/SPIC.MauiBlazorApp.Shared/images/loginimages/greensraticon.svg"
                             class="greenstar-pdf-logo"
                             alt="Green Star" />
                    }

                    @if (!IsActualPort &&
                                                                                     !ShowSpicCompanyData &&
                                                                                     !ShowGreenStarCompanyData)
                    {
                        <span class="logo-placeholder">LOGISTICS</span>
                    }

                </div>

                <div class="header-content">
                    <h1>LOGISTICS MASTER</h1>
                    <h2>@DocumentTitle</h2>
                    <p>@HeaderCompanyText</p>
                </div>

              @*   <div class="header-meta">
                    REF: @DocumentReference
                    <br />
                    @FormatDate(_item.CreatedAt)
                </div> *@

            </header>


            <!-- =====================================================
                 DOCUMENT BODY
                 ===================================================== -->
            <div class="view-body">

                <!-- =================================================
                     BASIC INFORMATION
                     ================================================= -->
                <section class="view-section">

                    <div class="view-section-title">
                        <div class="view-section-icon">
                            <i class="bi bi-building"></i>
                        </div>
                        <div class="view-section-text">
                            @(IsActualPort ? "Port Information" : "Basic Information")
                        </div>
                    </div>

                    @if (IsActualPort)
                    {
                        <div class="grid-2">

                            <div class="inline-field">
                                <label>Port Name</label>
                                <div class="inline-val">@TextOrDash(_item.Name)</div>
                            </div>

                            <div class="inline-field">
                                <label>Status</label>
                                <div class="inline-val">
                                    <span class="status-pill @(_item.IsActive ? "status-active" : "status-inactive")">
                                        @(_item.IsActive ? "Active" : "Inactive")
                                    </span>
                                </div>
                            </div>

                            <div class="inline-field">
                                <label>State</label>
                                <div class="inline-val">@GetStateName(_item.StateId)</div>
                            </div>

                            <div class="inline-field">
                                <label>District</label>
                                <div class="inline-val">@GetDistrictName(_item.DistrictId)</div>
                            </div>

                            <div class="inline-field grid-span-2">
                                <label>Google Map URL</label>
                                <div class="inline-val url-value">@TextOrDash(_item.GoogleURL)</div>
                            </div>

                        </div>
                    }
                    else
                    {
                        <div class="grid-2">

                            <div class="inline-field">
                                <label>Company</label>
                                <div class="inline-val">
                                    @if (ShowSpicCompanyData)
                                    {
                                        <span class="company-pill company-spic">SPIC</span>
                                    }

                                    @if (ShowGreenStarCompanyData)
                                    {
                                        <span class="company-pill company-gfl">GREEN STAR</span>
                                    }

                                    @if (!ShowSpicCompanyData && !ShowGreenStarCompanyData)
                                    {
                                        <span>-</span>
                                    }
                                </div>
                            </div>

                            <div class="inline-field">
                                <label>Status</label>
                                <div class="inline-val">
                                    <span class="status-pill @(_item.IsActive ? "status-active" : "status-inactive")">
                                        @(_item.IsActive ? "Active" : "Inactive")
                                    </span>
                                </div>
                            </div>

                            <div class="inline-field">
                                <label>State</label>
                                <div class="inline-val">@GetStateName(_item.BasicStateId)</div>
                            </div>

                            <div class="inline-field">
                                <label>Region</label>
                                <div class="inline-val">@GetRegionName(_item.RegionId)</div>
                            </div>

                            <div class="inline-field">
                                <label>HQ</label>
                                <div class="inline-val">@GetHeadquarterName(_item.HeadquarterId)</div>
                            </div>

                            <div class="inline-field">
                                <label>SAP Code</label>
                                <div class="inline-val">@DisplayCode</div>
                            </div>

                            <div class="inline-field">
                                <label>Name</label>
                                <div class="inline-val">@TextOrDash(_item.Name)</div>
                            </div>

                            <div class="inline-field">
                                <label>Operated By</label>
                                <div class="inline-val">@GetOperatedByDisplay(_item.OperatedBy)</div>
                            </div>

                            @if (IsWarehouse)
                            {
                                <div class="inline-field">
                                    <label>Warehouse Category</label>
                                    <div class="inline-val">
                                        @GetWarehouseCategoryDisplay(CurrentWarehouseCategory)
                                    </div>
                                </div>
                            }

                            @if (ShowsPvtWarehouseContent)
                            {
                                <div class="inline-field">
                                    <label>WH Type</label>
                                    <div class="inline-val">
                                        @GetWarehouseTypeDisplay(_item.WarehouseType)
                                    </div>
                                </div>
                            }

                        </div>
                    }

                </section>


                @if (IsWarehouse)
                {
                    <!-- =================================================
                         RESERVATION QUANTITY
                         ================================================= -->
                    <section class="view-section">

                        <div class="view-section-title">
                            <div class="view-section-icon">
                                <i class="bi bi-box-seam"></i>
                            </div>
                            <div class="view-section-text">Reservation Quantity</div>
                        </div>

                        @if (ShowsPvtWarehouseContent)
                        {
                            <div class="sub-card">

                                <h3 class="sub-card-title">PVT WH Reservation</h3>

                                @if (ShowSpicCompanyData || ShowGreenStarCompanyData)
                                {
                                    <div class="reservation-layout">

                                        @if (ShowSpicCompanyData)
                                        {
                                            <div class="reservation-card">

                                                <div class="reservation-card-title">
                                                    SPIC Reservation
                                                </div>

                                                <div class="grid-1">

                                                    <div class="inline-field">
                                                        <label>Approved Reservation Quantity (MT)</label>
                                                        <div class="inline-val">
                                                            @FormatQuantity(_item.SpicApprovedReservationQuantityMT)
                                                        </div>
                                                    </div>

                                                    <div class="inline-field">
                                                        <label>Additional Reservation Quantity (MT)</label>
                                                        <div class="inline-val">
                                                            @FormatQuantity(_item.SpicAdditionalReservationQuantityMT)
                                                        </div>
                                                    </div>

                                                </div>

                                            </div>
                                        }

                                        @if (ShowGreenStarCompanyData)
                                        {
                                            <div class="reservation-card">

                                                <div class="reservation-card-title">
                                                    GFL / GREEN STAR Reservation
                                                </div>

                                                <div class="grid-1">

                                                    <div class="inline-field">
                                                        <label>Approved Reservation Quantity (MT)</label>
                                                        <div class="inline-val">
                                                            @FormatQuantity(_item.GflApprovedReservationQuantityMT)
                                                        </div>
                                                    </div>

                                                    <div class="inline-field">
                                                        <label>Additional Reservation Quantity (MT)</label>
                                                        <div class="inline-val">
                                                            @FormatQuantity(_item.GflAdditionalReservationQuantityMT)
                                                        </div>
                                                    </div>

                                                </div>

                                            </div>
                                        }

                                    </div>
                                }
                                else
                                {
                                    <div class="empty-state">
                                        No SPIC / GREEN STAR company is selected for PVT reservation.
                                    </div>
                                }

                            </div>
                        }

                        @if (ShowsCandFWarehouseContent)
                        {
                            <div class="sub-card">

                                <h3 class="sub-card-title">C&amp;F WH Reservation</h3>

                                <div class="grid-2">

                                    <div class="inline-field">
                                        <label>Reservation Quantity (MT)</label>
                                        <div class="inline-val">
                                            @FormatQuantity(_item.GflReservationQuantityMT)
                                        </div>
                                    </div>

                                    <div class="inline-field">
                                        <label>Reservation Quantity (Litres)</label>
                                        <div class="inline-val">
                                            @FormatQuantity(_item.GflAdditionalReservationQuantityLitres)
                                        </div>
                                    </div>

                                </div>

                            </div>
                        }

                    </section>
                }


                @if (!IsActualPort)
                {
                    <!-- =================================================
                         PRIMARY LOCATION
                         ================================================= -->
                    <section class="view-section">

                        <div class="view-section-title">
                            <div class="view-section-icon">
                                <i class="bi bi-geo-alt-fill"></i>
                            </div>
                            <div class="view-section-text">Primary Location</div>
                        </div>

                        <div class="grid-2">

                            <div class="inline-field grid-span-2">
                                <label>Google Map URL</label>
                                <div class="inline-val url-value">
                                    @TextOrDash(_item.GoogleURL)
                                </div>
                            </div>

                            <div class="inline-field">
                                <label>Latitude &amp; Longitude</label>
                                <div class="inline-val">@LatitudeLongitudeDisplay</div>
                            </div>

                            <div class="inline-field">
                                <label>Sub Village</label>
                                <div class="inline-val">@TextOrDash(_item.SubVillage)</div>
                            </div>

                            @if (!IsRakePoint)
                            {
                                <div class="inline-field">
                                    <label>Door / Shop / Room / Block No</label>
                                    <div class="inline-val">@TextOrDash(_item.DoorNo)</div>
                                </div>

                                <div class="inline-field">
                                    <label>Street / Area / Locality</label>
                                    <div class="inline-val">@TextOrDash(_item.Street)</div>
                                </div>
                            }

                            <div class="inline-field">
                                <label>Pincode</label>
                                <div class="inline-val">@TextOrDash(_item.PinCode)</div>
                            </div>

                            <div class="inline-field">
                                <label>Village</label>
                                <div class="inline-val">@TextOrDash(_item.Village)</div>
                            </div>

                            <div class="inline-field">
                                <label>Block</label>
                                <div class="inline-val">@TextOrDash(_item.Block)</div>
                            </div>

                            <div class="inline-field">
                                <label>Taluk</label>
                                <div class="inline-val">@TextOrDash(_item.Taluk)</div>
                            </div>

                            <div class="inline-field">
                                <label>District</label>
                                <div class="inline-val">@GetDistrictName(_item.DistrictId)</div>
                            </div>

                            <div class="inline-field">
                                <label>State</label>
                                <div class="inline-val">@GetStateName(_item.StateId)</div>
                            </div>

                            <div class="inline-field">
                                <label>@ContactLabel</label>
                                <div class="inline-val">@TextOrDash(_item.ContactNumber)</div>
                            </div>

                        </div>

                    </section>


                    <!-- =================================================
                         DOCUMENTS
                         ================================================= -->
                    <section class="view-section">

                        <div class="view-section-title">
                            <div class="view-section-icon">
                                <i class="bi bi-file-earmark-text"></i>
                            </div>
                            <div class="view-section-text">Documents</div>
                        </div>

                        @if (_documentEntries.Count == 0)
                        {
                            <div class="empty-state">
                                No documents available.
                            </div>
                        }
                        else
                        {
                            <div class="table-wrapper">

                                <table class="view-table">

                                    <thead>
                                        <tr>
                                            <th>Document Type</th>
                                            <th>Company</th>
                                            <th>File Name</th>
                                        </tr>
                                    </thead>

                                    <tbody>

                                        @foreach (var document in _documentEntries)
                                        {
                                            <tr>
                                                <td class="strong-cell">
                                                    @document.TypeName
                                                </td>

                                                <td>
                                                    @if (string.Equals(document.Company, "SPIC", StringComparison.OrdinalIgnoreCase))
                                                    {
                                                        <span class="company-pill company-spic">SPIC</span>
                                                    }
                                                    else if (string.Equals(document.Company, "Green Star", StringComparison.OrdinalIgnoreCase))
                                                    {
                                                        <span class="company-pill company-gfl">GREEN STAR</span>
                                                    }
                                                    else
                                                    {
                                                        <span>-</span>
                                                    }
                                                </td>

                                                <td class="value-cell">
                                                    @TextOrDash(document.FileName)
                                                </td>

                                            </tr>
                                        }

                                    </tbody>

                                </table>

                            </div>
                        }

                    </section>



                    <!-- =================================================
                         APPROVAL DETAILS
                         ================================================= -->
                    <section class="view-section">

                        <div class="view-section-title">
                            <div class="view-section-icon">
                                <i class="bi bi-check2-circle"></i>
                            </div>
                            <div class="view-section-text">Approval Details</div>
                        </div>

                        <div class="grid-2">

                            <div class="inline-field">
                                <label>Submitted for Review</label>
                                <div class="inline-val">
                                    @(_item.IsSubmittedForReview ? "Yes" : "No")
                                </div>
                            </div>

                            <div class="inline-field">
                                <label>Approval Status</label>
                                <div class="inline-val">
                                    <span class="approval-pill @GetApprovalBadgeClass(_item)">
                                        @GetApprovalStatus(_item)
                                    </span>
                                </div>
                            </div>

                        </div>

                        <div class="table-wrapper" style="margin-top:8px;">

                            <table class="view-table">

                                <thead>
                                    <tr>
                                        <th>Approval Stage</th>
                                        <th>Status</th>
                                        <th>Action By</th>
                                        <th>Action Date</th>
                                    </tr>
                                </thead>

                                <tbody>

                                    <tr>
                                        <td class="strong-cell">RM</td>
                                        <td>@GetApprovalDecision(_item.RMApproved)</td>
                                        <td class="value-cell">@GetUserDisplay(_item.RMApprovedBy)</td>
                                        <td>@FormatNullableDateTime(_item.RMApprovedAt)</td>
                                    </tr>

                                    <tr>
                                        <td class="strong-cell">SMM</td>
                                        <td>@GetApprovalDecision(_item.SMApproved)</td>
                                        <td class="value-cell">@GetUserDisplay(_item.SMApprovedBy)</td>
                                        <td>@FormatNullableDateTime(_item.SMApprovedAt)</td>
                                    </tr>

                                    <tr>
                                        <td class="strong-cell">AVP</td>
                                        <td>@GetApprovalDecision(_item.AVPApproved)</td>
                                        <td class="value-cell">@GetUserDisplay(_item.AVPApprovedBy)</td>
                                        <td>@FormatNullableDateTime(_item.AVPApprovedAt)</td>
                                    </tr>

                                </tbody>

                            </table>

                        </div>

                        @if (!string.IsNullOrWhiteSpace(_item.ApprovalRemarks))
                        {
                            <div class="remarks-box">
                                <div class="remarks-title">Approval Remarks</div>
                                <div>@_item.ApprovalRemarks</div>
                            </div>
                        }

                    </section>
                }


                <!-- =================================================
                     AUDIT INFORMATION
                     ================================================= -->
                <section class="view-section">

                    <div class="view-section-title">
                        <div class="view-section-icon">
                            <i class="bi bi-clock-history"></i>
                        </div>
                        <div class="view-section-text">Audit Information</div>
                    </div>

                    <div class="grid-2">

                        @if (!IsActualPort)
                        {
                            <div class="inline-field">
                                <label>Created By</label>
                                <div class="inline-val">@GetCreatedByDisplay(_item)</div>
                            </div>
                        }

                        <div class="inline-field">
                            <label>Created At</label>
                            <div class="inline-val">@FormatDateTime(_item.CreatedAt)</div>
                        </div>

                        <div class="inline-field">
                            <label>Updated By</label>
                            <div class="inline-val">@GetUserDisplay(_item.UpdatedBy)</div>
                        </div>

                        <div class="inline-field">
                            <label>Updated At</label>
                            <div class="inline-val">@FormatDateTime(_item.UpdatedAt)</div>
                        </div>

                    </div>

                </section>


                <!-- =================================================
                         ATTACHED SAVED DOCUMENTS
                         DealerPDF-style inline preview.
                         Existing Documents table above is intentionally kept.
                         ================================================= -->
                @if (_documentEntries.Count > 0)
                {
                    <section class="view-section logistics-attached-documents"
                             style="page-break-before: always; break-before: page;">

                        <div class="view-section-title">
                            <div class="view-section-icon">
                                <i class="bi bi-files"></i>
                            </div>
                            <div class="view-section-text">
                                Attached Documents
                            </div>
                        </div>

                        @foreach (var document in _documentEntries)
                        {
                            var documentUrl =
                                GetSavedDocumentViewUrl(
                                    document.Path);

                            var isImage =
                                IsImageDocument(
                                    document.Path);

                            var isPdf =
                                IsPdfDocument(
                                    document.Path);

                            <div class="logistics-document-preview-card"
                                 style="
                                margin-bottom: 14px;
                                padding: 14px;
                                border: 1px solid #e5e7eb;
                                border-radius: 8px;
                                background: #ffffff;
                                overflow: visible;
                                page-break-inside: auto;
                                break-inside: auto;">

                                <div style="
                                    display: flex;
                                    align-items: center;
                                    justify-content: space-between;
                                    gap: 12px;
                                    margin-bottom: 10px;
                                    padding-bottom: 8px;
                                    border-bottom: 2px solid #e5e7eb;
                                    page-break-after: avoid;
                                    break-after: avoid;">

                                    <div style="min-width: 0;">

                                        <div style="
                                            color: #1f2937;
                                            font-size: 12px;
                                            font-weight: 700;
                                            line-height: 1.35;">
                                            @document.TypeName
                                        </div>

                                        <div style="
                                            margin-top: 3px;
                                            color: #6b7280;
                                            font-size: 10px;
                                            line-height: 1.3;
                                            overflow-wrap: anywhere;">
                                            @TextOrDash(document.FileName)
                                        </div>

                                    </div>

                                    <div class="screen-only"
                                         style="flex-shrink: 0;">

                                        <a href="@documentUrl"
                                               target="_blank"
                                               rel="noopener noreferrer"
                                               style="
                                            min-height: 26px;
                                            padding: 4px 9px;
                                            display: inline-flex;
                                            align-items: center;
                                            gap: 5px;
                                            border: 1px solid #d1d5db;
                                            border-radius: 4px;
                                            background: #ffffff;
                                            color: #1f2937;
                                            text-decoration: none;
                                            font-size: 10px;
                                            font-weight: 600;">
                                            <i class="bi @GetSavedDocumentIcon(document.Path)"></i>
                                            @GetSavedDocumentViewLabel(document.Path)
                                        </a>

                                    </div>

                                </div>

                                @if (isImage)
                                {
                                    <img src="@documentUrl"
                                         alt="@document.TypeName"
                                         style="
                                    display: block;
                                    width: auto;
                                    max-width: 100%;
                                    max-height: 250mm;
                                    height: auto;
                                    margin: 0 auto;
                                    object-fit: contain;
                                    page-break-inside: avoid;
                                    break-inside: avoid;"
                                         onerror="this.style.display='none';" />
                                }
                                else if (isPdf)
                                {
                                    <div class="logistics-saved-pdf-target"
                                         data-pdf-url="@documentUrl"
                                         data-document-title="@document.TypeName"
                                         style="
                                        width: 100%;
                                        min-height: 60px;
                                        overflow: visible;">

                                        <div class="logistics-document-loading"
                                             style="
                                            padding: 20px;
                                            text-align: center;
                                            color: #6b7280;
                                            font-size: 11px;">
                                            Loading saved PDF pages...
                                        </div>

                                    </div>
                                }
                                else
                                {
                                    <div style="
                                        padding: 14px;
                                        display: flex;
                                        align-items: center;
                                        gap: 10px;
                                        border: 1px dashed #d1d5db;
                                        border-radius: 6px;
                                        background: #f9fafb;">

                                        <i class="bi @GetSavedDocumentIcon(document.Path)"
                                           style="font-size: 20px; color: #6b7280;"></i>

                                        <div style="min-width: 0;">
                                            <div style="
                                                color: #1f2937;
                                                font-weight: 600;
                                                overflow-wrap: anywhere;">
                                                @TextOrDash(document.FileName)
                                            </div>

                                            <div style="
                                                margin-top: 2px;
                                                color: #6b7280;
                                                font-size: 10px;">
                                                Preview is not available for this file type.
                                            </div>
                                        </div>

                                    </div>
                                }

                            </div>
                        }

                    </section>
                }

            </div>

        </main>
    }

</div>


@code {

    // ===============================================================
    // ROUTE / QUERY PARAMETERS
    //
    // Current Logistics.razor mapping:
    //
    // Warehouse  -> Warehouse
    // Port       -> Rake Point
    // PortMaster -> Actual Port
    //
    // Supported examples:
    //
    // /LogisticsPdf?tab=Warehouse&id=10
    // /LogisticsPdf?tab=Port&id=20
    // /LogisticsPdf?tab=PortMaster&id=30
    //
    // Also supported:
    //
    // /LogisticsPdf/Warehouse/10
    // /LogisticsPdf/Port/20
    // /LogisticsPdf/PortMaster/30
    // ===============================================================

    [Parameter]
    public string? RouteTab { get; set; }

    [Parameter]
    public int RouteId { get; set; }

    [Parameter]
    public string? Company { get; set; }


    private bool _isLoading = true;

    private string? _errorMessage;

    private string? _loadedKey;

    // Saved-document previews render after the data-bound DOM exists.
    private bool _pendingSavedDocumentRender;

    private LogisticsItemDto? _item;

    private List<StateDto> _states = new();

    private List<DistrictDto> _districts = new();

    private List<RegionDto> _regions = new();

    private List<HeadquarterDto> _headquarters = new();

    private Dictionary<string, string> _userNamesById =
        new(StringComparer.OrdinalIgnoreCase);

    private List<DocumentEntry> _documentEntries = new();


    private string SelectedCompany =>
        NormalizeCompany(Company);


    private bool HasCompanyFilter =>
        !string.IsNullOrWhiteSpace(SelectedCompany);


    private bool IsSpicPdf =>
        string.Equals(
            SelectedCompany,
            "SPIC",
            StringComparison.OrdinalIgnoreCase);


    private bool IsGreenStarPdf =>
        string.Equals(
            SelectedCompany,
            "GreenStar",
            StringComparison.OrdinalIgnoreCase);


    private bool ShowSpicCompanyData =>
        _item?.InSpic == true
        && (!HasCompanyFilter || IsSpicPdf);


    private bool ShowGreenStarCompanyData =>
        _item?.InGreenStar == true
        && (!HasCompanyFilter || IsGreenStarPdf);


    private string RequestedTab =>
        NormalizeTab(
            string.IsNullOrWhiteSpace(RouteTab)
                ? "Warehouse"
                : RouteTab);


    private int RequestedId =>
        RouteId;


