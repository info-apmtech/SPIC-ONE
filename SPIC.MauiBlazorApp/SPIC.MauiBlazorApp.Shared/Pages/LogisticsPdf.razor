        }

        return id;
    }


    // ===============================================================
    // DOCUMENT BINDING
    //
    // Same saved fields used by Logistics.razor:
    //
    // GstDocumentPath
    // InsuranceDocumentPath
    // FertilizerLicenseDocumentPath
    // OtherDocumentPathsJson
    //
    // Supplemental company-specific document type is detected from
    // the same folder naming convention used by Logistics.razor.
    // ===============================================================

    private List<DocumentEntry> BuildDocumentEntries(
        LogisticsItemDto item)
    {
        var entries =
            new List<DocumentEntry>();

        var seen =
            new HashSet<string>(
                StringComparer.OrdinalIgnoreCase);


        void AddEntry(
            string? path,
            string? fallbackType = null,
            string? fallbackCompany = null)
        {
            if (string.IsNullOrWhiteSpace(
                    path))
            {
                return;
            }

            var cleanPath =
                path.Trim();

            if (!seen.Add(
                    cleanPath))
            {
                return;
            }


            var fileName =
                GetFileName(
                    cleanPath);


            var detectedType =
                GetDocumentTypeName(
                    cleanPath);


            // Existing helper returns the raw filename when a folder does not
            // identify the type. Primary DB fields still have a known type,
            // so use that field meaning as the fallback.
            if (!string.IsNullOrWhiteSpace(
                    fallbackType)
                && string.Equals(
                    detectedType,
                    fileName,
                    StringComparison.OrdinalIgnoreCase))
            {
                detectedType =
                    fallbackType;
            }


            var detectedCompany =
                GetDocumentCompany(
                    cleanPath);


            entries.Add(
                new DocumentEntry
                {
                    Path =
                        cleanPath,

                    TypeName =
                        string.IsNullOrWhiteSpace(
                            detectedType)
                            ? fallbackType
                                ?? "Document"
                            : detectedType,

                    Company =
                        detectedCompany
                        ?? fallbackCompany,

                    FileName =
                        fileName
                });
        }


        if (IsWarehouse)
        {
            var category =
                item.WarehouseCategory
                ?? LogisticsWarehouseCategory.PvtWH;


            var pvtOrBoth =
                category
                    is LogisticsWarehouseCategory.PvtWH
                    or LogisticsWarehouseCategory.Both;


            AddEntry(
                item.GstDocumentPath,
                pvtOrBoth
                    && item.InSpic == true
                        ? "SPIC GST"
                        : "GST Document",
                pvtOrBoth
                    && item.InSpic == true
                        ? "SPIC"
                        : null);


            AddEntry(
                item.InsuranceDocumentPath,
                "Insurance Document");


            AddEntry(
                item.FertilizerLicenseDocumentPath,
                pvtOrBoth
                    && item.InSpic == true
                        ? "SPIC Fertilizer License"
                        : "Fertilizer License",
                pvtOrBoth
                    && item.InSpic == true
                        ? "SPIC"
                        : null);
        }
        else
        {
            AddEntry(
                item.GstDocumentPath,
                "GST Document");

            AddEntry(
                item.InsuranceDocumentPath,
                "Insurance Document");

            AddEntry(
                item.FertilizerLicenseDocumentPath,
                "Fertilizer License");
        }


        foreach (
            var path
            in DeserializeDocumentPaths(
                item.OtherDocumentPathsJson))
        {
            AddEntry(
                path);
        }


        if (!HasCompanyFilter)
            return entries;

        return entries
            .Where(entry =>
                string.IsNullOrWhiteSpace(entry.Company)
                || (IsSpicPdf
                    && string.Equals(
                        entry.Company,
                        "SPIC",
                        StringComparison.OrdinalIgnoreCase))
                || (IsGreenStarPdf
                    && string.Equals(
                        entry.Company,
                        "Green Star",
                        StringComparison.OrdinalIgnoreCase)))
            .ToList();
    }


    private static List<string> DeserializeDocumentPaths(
        string? json)
    {
        if (string.IsNullOrWhiteSpace(
                json))
        {
            return new();
        }

        try
        {
            return
                JsonSerializer
                    .Deserialize<List<string>>(
                        json)
                    ?.Where(
                        x =>
                            !string.IsNullOrWhiteSpace(
                                x))
                    .Distinct(
                        StringComparer.OrdinalIgnoreCase)
                    .ToList()
                ?? new();
        }
        catch
        {
            return new();
        }
    }


    private static string GetFileName(
        string? path)
    {
        if (string.IsNullOrWhiteSpace(
                path))
        {
            return string.Empty;
        }

        var normalized =
            path.Replace(
                '\\',
                '/');

        var lastSlash =
            normalized.LastIndexOf('/');

        return lastSlash >= 0
            ? normalized[
                (lastSlash + 1)..]
            : normalized;
    }


    private static string GetDocumentTypeName(
        string? path)
    {
        if (string.IsNullOrWhiteSpace(
                path))
        {
            return "Document";
        }

        var normalized =
            path
                .Replace(
                    '\\',
                    '/')
                .ToLowerInvariant();


        if (normalized.Contains(
                "/gst_spic/"))
        {
            return "SPIC GST";
        }

        if (normalized.Contains(
                "/gst_gfl/"))
        {
            return "GREEN STAR GST";
        }

        if (normalized.Contains(
                "/gst_trading/"))
        {
            return "Trading Document";
        }

        if (normalized.Contains(
                "/insurance_spic/"))
        {
            return "SPIC Insurance";
        }

        if (normalized.Contains(
                "/insurance_gfl/"))
        {
            return "GREEN STAR Insurance";
        }

        if (normalized.Contains(
                "/insurance/"))
        {
            return "Insurance Document";
        }

        if (normalized.Contains(
                "/fertilizerlicense_spic/"))
        {
            return "SPIC Fertilizer License";
        }

        if (normalized.Contains(
                "/fertilizerlicense_gfl/"))
        {
            return "GREEN STAR Fertilizer License";
        }

        if (normalized.Contains(
                "/other/"))
        {
            return "Other Document";
        }


        var name =
            GetFileName(
                path);


        return string.IsNullOrWhiteSpace(
                name)
            ? "Document"
            : name;
    }


    private static string? GetDocumentCompany(
        string? path)
    {
        if (string.IsNullOrWhiteSpace(
                path))
        {
            return null;
        }

        var normalized =
            path
                .Replace(
                    '\\',
                    '/')
                .ToLowerInvariant();


        if (normalized.Contains(
                "/gst_spic/")
            || normalized.Contains(
                "/insurance_spic/")
            || normalized.Contains(
                "/fertilizerlicense_spic/"))
        {
            return "SPIC";
        }


        if (normalized.Contains(
                "/gst_gfl/")
            || normalized.Contains(
                "/insurance_gfl/")
            || normalized.Contains(
                "/fertilizerlicense_gfl/"))
        {
            return "Green Star";
        }


        return null;
    }


    // ===============================================================
    // SAVED DOCUMENT PREVIEW
    //
    // Uses the same LogisticsFile/view endpoint as Logistics.razor.
    // Nothing is re-saved or changed here; this is display-only.
    // ===============================================================

    private static string ToSavedDocumentRelativePath(
        string path)
    {
        var normalized =
            (path ?? string.Empty)
                .Replace('\\', '/')
                .TrimStart('/');

        if (normalized.StartsWith(
                "uploads/",
                StringComparison.OrdinalIgnoreCase))
        {
            normalized =
                normalized["uploads/".Length..];
        }

        return normalized;
    }


    private string GetSavedDocumentViewUrl(
        string? path)
    {
        if (string.IsNullOrWhiteSpace(path))
            return string.Empty;

        if (path.StartsWith(
                "http://",
                StringComparison.OrdinalIgnoreCase)
            || path.StartsWith(
                "https://",
                StringComparison.OrdinalIgnoreCase))
        {
            return path;
        }

        var baseUrl =
            Http.BaseAddress
                ?.ToString()
                .TrimEnd('/')
            ?? string.Empty;

        var relative =
            ToSavedDocumentRelativePath(
                path);

        var url =
            $"{baseUrl}/api/LogisticsFile/view/{relative}";

        var token =
            LoginState.Token;

        if (!string.IsNullOrWhiteSpace(token))
        {
            var rawToken =
                token.StartsWith(
                    "Bearer ",
                    StringComparison.OrdinalIgnoreCase)
                    ? token["Bearer ".Length..]
                    : token;

            url +=
                $"?access_token={Uri.EscapeDataString(rawToken)}";
        }

        return url;
    }


    private static bool IsPdfDocument(
        string? path)
    {
        if (string.IsNullOrWhiteSpace(path))
            return false;

        return string.Equals(
            System.IO.Path.GetExtension(path),
            ".pdf",
            StringComparison.OrdinalIgnoreCase);
    }


    private static bool IsImageDocument(
        string? path)
    {
        if (string.IsNullOrWhiteSpace(path))
            return false;

        var ext =
            System.IO.Path
                .GetExtension(path)
                .ToLowerInvariant();

        return ext
            is ".jpg"
            or ".jpeg"
            or ".png"
            or ".gif"
            or ".webp"
            or ".bmp";
    }


    private static string GetSavedDocumentIcon(
        string? path)
    {
        if (string.IsNullOrWhiteSpace(path))
            return "bi-file-earmark";

        var ext =
            System.IO.Path
                .GetExtension(path)
                .ToLowerInvariant();

        return ext switch
        {
            ".pdf" =>
                "bi-file-earmark-pdf-fill",

            ".jpg" or ".jpeg" or ".png"
                or ".gif" or ".webp" or ".bmp" =>
                "bi-file-earmark-image-fill",

            ".doc" or ".docx" =>
                "bi-file-earmark-word-fill",

            ".xls" or ".xlsx" =>
                "bi-file-earmark-excel-fill",

            _ =>
                "bi-file-earmark-fill"
        };
    }


    private static string GetSavedDocumentViewLabel(
        string? path)
    {
        if (string.IsNullOrWhiteSpace(path))
            return "View File";

        var ext =
            System.IO.Path
                .GetExtension(path)
                .ToLowerInvariant();

        return ext switch
        {
            ".pdf" =>
                "View PDF",

            ".jpg" or ".jpeg" or ".png"
                or ".gif" or ".webp" or ".bmp" =>
                "View Image",

            ".doc" or ".docx" =>
                "View Doc",

            ".xls" or ".xlsx" =>
                "View Excel",

            _ =>
                "View File"
        };
    }


    private async Task RenderSavedDocumentPreviewsAsync()
    {
        try
        {
            var module =
                await JS.InvokeAsync<Microsoft.JSInterop.IJSObjectReference>(
                    "import",
                    "./_content/SPIC.MauiBlazorApp.Shared/js/logisticsPdfDocuments.js");

            try
            {
                await module.InvokeVoidAsync(
                    "renderSavedDocuments",
                    ".logistics-saved-pdf-target");
            }
            finally
            {
                await module.DisposeAsync();
            }
        }
        catch (Exception ex)
        {
            // The Logistics PDF itself must continue to work even if a
            // particular attachment preview cannot be rendered.
            Console.WriteLine(
                $"Saved document preview failed: {ex.Message}");
        }
    }


    private async Task PrintDocument()
    {
        try
        {
            // Print from an isolated hidden frame. This removes the app's
            // 100vh/scroll-container clipping and lets the browser paginate
            // the complete Logistics document across every A4 page.
            var module =
                await JS.InvokeAsync<Microsoft.JSInterop.IJSObjectReference>(
                    "import",
                    "./_content/SPIC.MauiBlazorApp.Shared/js/logisticsPdfPrint.js");

            try
            {
                await module.InvokeVoidAsync(
                    "printAllPages",
                    "logistics-pdf-document",
                    PageTitleText);
            }
            finally
            {
                await module.DisposeAsync();
            }
        }
        catch
        {
            // Fallback for a host that does not support dynamic JS modules.
            await JS.InvokeVoidAsync("window.print");
        }
    }


