@page "/UserProfile"

<style>
    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    /* New wrapper to center the card on larger screens */
    .page-wrapper {
        min-height: 100vh;
        background-color: #f4f6f8; /* Light grey background for the whole page */
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
    }

    .phone {
        width: 100%;
        max-width: 420px; /* Responsive max-width instead of fixed width */
        background: #fff;
        display: flex;
        flex-direction: column;
        border-radius: 16px; /* Rounded corners for desktop card look */
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08); /* Soft shadow */
        overflow: hidden;
        min-height: 85vh; /* Gives it a good height on desktop */
    }

    /* On very small screens, make it completely full screen without borders */
    @@media (max-width: 480px) {
        .page-wrapper {
            padding: 0;
            background-color: #fff;
        }
        .phone {
            border-radius: 0;
            min-height: 100vh;
            box-shadow: none;
        }
    }

    /* Header */
    .header {
        padding: 16px 20px;
        display: flex;
        align-items: center;
        gap: 12px;
        border-bottom: 1px solid #e2e8f0;
    }

    .back-btn {
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        border: none;
        background: none;
        padding: 0;
    }

    .back-btn svg {
        width: 20px;
        height: 20px;
        stroke: #2c3e50;
        stroke-width: 2.5;
    }

    .header-title {
        font-size: 16px;
        font-weight: 600;
        color: #1f2937;
    }

    /* Content */
    .content {
        flex: 1;
        padding: 28px 20px;
        display: flex;
        flex-direction: column;
    }

    /* Heading */
    .heading {
        text-align: center;
        margin-bottom: 28px;
    }

    .main-title {
        font-size: 24px;
        font-weight: 700;
        color: #064e3b;
        margin-bottom: 8px;
        letter-spacing: -0.5px;
    }

    .subtitle {
        font-size: 14px;
        color: #6b7280;
        line-height: 1.5;
    }

    /* Form Container */
    .form-container {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    /* Form Group */
    .form-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .form-label {
        font-size: 14px;
        font-weight: 600;
        color: #1f2937;
    }

    .form-input {
        width: 100%;
        padding: 14px 16px;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        font-size: 14px;
        transition: all 0.2s;
        background: #fafbfc;
        color: #1f2937;
    }

    .form-input::placeholder {
        color: #d1d5db;
    }

    .form-input:focus {
        outline: none;
        border-color: #2563eb;
        background: #fff;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
    }

    /* Input Icon Container */
    .input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }

    .input-icon {
        position: absolute;
        left: 14px;
        width: 20px;
        height: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        pointer-events: none;
        color: #9ca3af;
    }

    .input-with-icon {
        padding-left: 44px;
    }

    /* Checkbox */
    .checkbox-group {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .checkbox-input {
        width: 18px;
        height: 18px;
        cursor: pointer;
        accent-color: #2563eb;
    }

    .checkbox-label {
        font-size: 13px;
        color: #6b7280;
        cursor: pointer;
    }

    /* Button Container */
    .button-container {
        margin-top: auto;
        padding-top: 30px;
    }

    .btn-continue {
        width: 100%;
        padding: 16px;
        background: #2563eb;
        color: #fff;
        border: none;
        border-radius: 10px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
        letter-spacing: 0.01em;
    }

    .btn-continue:hover {
        background: #1d4ed8;
    }

    .btn-continue:active {
        background: #1e40af;
    }

    svg {
        display: block;
    }
</style>

<div class="page-wrapper">
    <div class="phone">
        <div class="header">
            <button class="back-btn">
                <svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="15 18 9 12 15 6" />
                </svg>
            </button>
            <span class="header-title">User Details</span>
        </div>

        <div class="content">
            <div class="heading">
                <h1 class="main-title">Complete Your Profile</h1>
                <p class="subtitle">Please provide basic details to continue your purchase and rewards.</p>
            </div>

            <form class="form-container">
                <div class="form-group">
                    <label class="form-label">Full Name</label>
                    <div class="input-wrapper">
                        <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                            <circle cx="12" cy="7" r="4" />
                        </svg>
                        <input type="text" class="form-input input-with-icon" placeholder="Enter your full name" required />
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Mobile Number</label>
                    <div class="input-wrapper">
                        <input type="tel" class="form-input" placeholder="1234567890" maxlength="10" required />
                        <div class="checkbox-group" style="position: absolute; right: 14px; pointer-events: none;">
                            <input type="checkbox" class="checkbox-input" style="pointer-events: auto;" />
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Address</label>
                    <div class="input-wrapper">
                        <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                            <circle cx="12" cy="10" r="3" />
                        </svg>
                        <input type="text" class="form-input input-with-icon" placeholder="Village / Area Name" required />
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">District</label>
                    <div class="input-wrapper">
                        <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
                        </svg>
                        <input type="text" class="form-input input-with-icon" placeholder="Madurai" required />
                    </div>
                </div>

                <div class="button-container">
                    <button type="submit" class="btn-continue">Continue</button>
                </div>
            </form>
        </div>
    </div>
</div>

