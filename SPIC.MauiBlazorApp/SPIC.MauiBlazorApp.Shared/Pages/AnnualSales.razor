	private bool IsUreaProduct(Product? product)
	{
		return product?.Name != null &&
			   product.Name.Trim().Equals("Urea", StringComparison.OrdinalIgnoreCase);
	}

	private bool IsFertilizerCategory(Category? category)
	{
		return category?.Name != null &&
			   category.Name.Contains("Fertilizer", StringComparison.OrdinalIgnoreCase);
	}

	private bool IsOtherFertilizerRow(AnnualSaleDataLastFYofDealerRegistration row)
	{
		var product = _products.FirstOrDefault(p => p.Id == row.ProductId);
		var category = _categories.FirstOrDefault(c => c.Id == row.CategoryId);

		return IsFertilizerCategory(category) && !IsUreaProduct(product);
	}

	private decimal GetOtherFertilizerTotalQty()
	{
		return _allSalesData
			.Where(IsOtherFertilizerRow)
			.Sum(r => r.OwnRetailsSaleQty + r.SaleToDealerQty);
	}

	private decimal GetOtherFertilizerTotalAmount()
	{
		return _allSalesData
			.Where(IsOtherFertilizerRow)
			.Sum(r => r.OwnRetailsSaleAmount + r.SaleToDealerAmount);
	}

	private bool _showProductPopup;
	private bool _isCreatingProduct;
	private ProductPopupModel _popupProduct = new();

	private void OpenProductPopup()
	{
		_popupProduct = new ProductPopupModel();
		_showProductPopup = true;
	}

	private void CloseProductPopup()
	{
		_showProductPopup = false;
		_popupProduct = new ProductPopupModel();
	}

	private async Task HandleCreateProduct()
	{
		if (string.IsNullOrWhiteSpace(_popupProduct.Name))
		{
			ShowMessage("Product name is required.", true);
			return;
		}

		var trimmedName = _popupProduct.Name.Trim();

		if (_popupProduct.CategoryId == 0)
		{
			ShowMessage("Category is required.", true);
			return;
		}

		var isDuplicate = _products.Any(p =>
			p.Name.Equals(trimmedName, StringComparison.OrdinalIgnoreCase) &&
			p.CategoryId == _popupProduct.CategoryId);

		if (isDuplicate)
		{
			ShowMessage($"A Product with the name '{trimmedName}' already exists in this Category.", true);
			return;
		}

		try
		{
			_isCreatingProduct = true;
			var payload = new
			{
				Name = trimmedName,
				CategoryId = _popupProduct.CategoryId,
				RPU = _popupProduct.RPU,
				ProductGroupId = _popupProduct.ProductGroupId,
				IsActive = true,
				CreatedAt = DateTime.Now,
				UpdatedAt = DateTime.Now,
				CreatedBy = LoginState.UserId ?? "current-user",
				UpdatedBy = LoginState.UserId ?? "current-user"
			};

			var response = await Http.PostAsJsonAsync("api/Product", payload);
			if (response.IsSuccessStatusCode)
			{
				ShowMessage("Product created successfully.", false);
				CloseProductPopup();
				await LoadProducts();
				BuildCurrentRows();
			}
			else
			{
				var error = await response.Content.ReadAsStringAsync();
				ShowMessage($"Create failed: {error}", true);
			}
		}
		catch (Exception ex)
		{
			ShowMessage($"Error: {ex.Message}", true);
		}
		finally
		{
			_isCreatingProduct = false;
		}
	}

	private class ProductPopupModel
	{
		public int CategoryId { get; set; }
		public string Name { get; set; } = "";
		public decimal? RPU { get; set; }
		public int? ProductGroupId { get; set; }
	}
