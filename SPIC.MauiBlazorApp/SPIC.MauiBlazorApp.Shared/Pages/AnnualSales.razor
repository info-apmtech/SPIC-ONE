@page "/AnnualSales"
@using System.Net.Http.Json
@using SPIC.Core.Entities
@using SPIC.MauiBlazorApp.Shared.FormFlow
@inject HttpClient Http
@inject NavigationManager Nav
@inject LoadingService Loading

<div class="container-fluid py-4 px-0">
	<FormLoader />

	@if (!string.IsNullOrEmpty(_message))
	{
		<div class="alert @(_isError ? "alert-danger" : "alert-success") alert-dismissible fade show mb-3" role="alert">
			@_message
			<button type="button" class="btn-close" @onclick='() => _message = null'></button>
		</div>
	}

	<div class="company-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
		<h3 class="fw-bold m-0 company-title">Annual Sales Data For All Companies</h3>
	</div>

	<div class="form-card">

		<!-- Header -->
		<div class="annual-card-header d-flex justify-content-between align-items-center py-3 flex-wrap gap-2">
			<div class="card-header-title mb-0">
				<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/AddUserIcon.svg"
					 class="formicon" />
				Last Financial Year
			</div>

			<button class="btn-verified">
				<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/Verifiedicon.svg"
					 class="verifyicon" />
				Verified Units
			</button>
		</div>

		<!-- Dynamic Category Tabs -->
		<div class="custom-tabs mb-3 annual-custom-tabs">
			@foreach (var cat in _categories)
			{
				var unitName = _units.FirstOrDefault(u => u.Id == cat.UnitId)?.Name ?? "";
				<div class="tab-btn @(cat.Id == _selectedCategoryId ? "active" : "")"
					 @onclick="() => SelectCategory(cat.Id)">
					@cat.Name (@unitName/Value)
				</div>
			}
		</div>

		<!-- Table with X and Y Scroll -->
		<div class="table-wrapper annual-table-wrapper">
			<div class="table-responsive annual-table-responsive">
				<table class="spic-table annual-spic-table">
					<thead>
						<tr>
							<!-- FIRST REPEAT -->
							<th>Product Name</th>
							<th>Own Retail Qty (@_selectedUnitName)</th>
							<th>TO (₹)in Lakhs</th>
							@if (_hasWholesaleLicense)
							{
								<th>Sale to Dealer Qty (@_selectedUnitName)</th>
								<th>TO (₹)in Lakhs</th>
							}

							@*                             <!-- SECOND REPEAT -->
                            <th>Product Name</th>
                            <th>Own Retail Qty (@_selectedUnitName)</th>
                            <th>TO (₹)in Lakhs</th>
                            @if (_hasWholesaleLicense)
                            {
                                <th>Sale to Dealer Qty (@_selectedUnitName)</th>
                                <th>TO (₹)in Lakhs</th>
                            } *@

							<!-- TOTALS COMBINED -->
							<th>Total</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var row in _currentRows)
						{
							var product = _products.FirstOrDefault(p => p.Id == row.ProductId);
							<tr>
								<!-- FIRST REPEAT -->
								<td data-label="Product Name">
									<div class="product-title">@(product?.Name ?? "Unknown")</div>
								</td>
								<td data-label="Own Retail Qty (@_selectedUnitName)">
									<input class="table-input" type="number" step="0.01"
										   value="@row.OwnRetailsSaleQty"
										   @onchange="(e) => UpdateField(row, e, r => r.OwnRetailsSaleQty, (r, v) => r.OwnRetailsSaleQty = v)" />
								</td>
								<td data-label="TO (₹)in Lakhs">
									<input class="table-input" type="number" step="0.01"
										   value="@row.OwnRetailsSaleAmount"
										   @onchange="(e) => UpdateField(row, e, r => r.OwnRetailsSaleAmount, (r, v) => r.OwnRetailsSaleAmount = v)" />
								</td>
								@if (_hasWholesaleLicense)
								{
									<td data-label="Sale to Dealer Qty (@_selectedUnitName)">
										<input class="table-input" type="number" step="0.01"
											   value="@row.SaleToDealerQty"
											   @onchange="(e) => UpdateField(row, e, r => r.SaleToDealerQty, (r, v) => r.SaleToDealerQty = v)" />
									</td>
									<td data-label="TO (₹)in Lakhs">
										<input class="table-input" type="number" step="0.01"
											   value="@row.SaleToDealerAmount"
											   @onchange="(e) => UpdateField(row, e, r => r.SaleToDealerAmount, (r, v) => r.SaleToDealerAmount = v)" />
									</td>
								}

								@*  <!-- SECOND REPEAT -->
                                <td class="annual-second-repeat" data-label="Product Name">
                                    <div class="product-title">@(product?.Name ?? "Unknown")</div>
                                </td>
                                <td class="annual-second-repeat" data-label="Own Retail Qty (@_selectedUnitName)">
                                    <input class="table-input" type="number" step="0.01"
                                           value="@row.OwnRetailsSaleQty"
                                           @onchange="(e) => UpdateField(row, e, r => r.OwnRetailsSaleQty, (r, v) => r.OwnRetailsSaleQty = v)" />
                                </td>
                                <td class="annual-second-repeat" data-label="TO (₹)in Lakhs">
                                    <input class="table-input" type="number" step="0.01"
                                           value="@row.OwnRetailsSaleAmount"
                                           @onchange="(e) => UpdateField(row, e, r => r.OwnRetailsSaleAmount, (r, v) => r.OwnRetailsSaleAmount = v)" />
                                </td>
                                @if (_hasWholesaleLicense)
                                {
                                    <td class="annual-second-repeat" data-label="Sale to Dealer Qty (@_selectedUnitName)">
                                        <input class="table-input" type="number" step="0.01"
                                               value="@row.SaleToDealerQty"
                                               @onchange="(e) => UpdateField(row, e, r => r.SaleToDealerQty, (r, v) => r.SaleToDealerQty = v)" />
                                    </td>
                                    <td class="annual-second-repeat" data-label="TO (₹)in Lakhs">
                                        <input class="table-input" type="number" step="0.01"
                                               value="@row.SaleToDealerAmount"
                                               @onchange="(e) => UpdateField(row, e, r => r.SaleToDealerAmount, (r, v) => r.SaleToDealerAmount = v)" />
                                    </td>
                                } *@

								<!-- TOTALS COMBINED -->
								<td class="text-value annual-total-cell" data-label="Total">
									@((row.OwnRetailsSaleQty + row.SaleToDealerQty).ToString("N2")) / @((row.OwnRetailsSaleAmount + row.SaleToDealerAmount).ToString("N2"))
								</td>
							</tr>
						}
					</tbody>
					<tfoot>
						<tr>
							<!-- FIRST REPEAT -->
							<td>Grand Total</td>
							<td>@_currentRows.Sum(r => r.OwnRetailsSaleQty).ToString("N2")</td>
							<td>@_currentRows.Sum(r => r.OwnRetailsSaleAmount).ToString("N2")</td>
							@if (_hasWholesaleLicense)
							{
								<td>@_currentRows.Sum(r => r.SaleToDealerQty).ToString("N2")</td>
								<td>@_currentRows.Sum(r => r.SaleToDealerAmount).ToString("N2")</td>
							}

							@*  <!-- SECOND REPEAT -->
                            <td class="annual-second-repeat">Grand Total</td>
                            <td class="annual-second-repeat">@_currentRows.Sum(r => r.OwnRetailsSaleQty).ToString("N2")</td>
                            <td class="annual-second-repeat">@_currentRows.Sum(r => r.OwnRetailsSaleAmount).ToString("N2")</td>
                            @if (_hasWholesaleLicense)
                            {
                                <td class="annual-second-repeat">@_currentRows.Sum(r => r.SaleToDealerQty).ToString("N2")</td>
                                <td class="annual-second-repeat">@_currentRows.Sum(r => r.SaleToDealerAmount).ToString("N2")</td>
                            } *@

							<!-- TOTALS COMBINED -->
							<td>
								@_currentRows.Sum(r => r.OwnRetailsSaleQty + r.SaleToDealerQty).ToString("N2") MT / @_currentRows.Sum(r => r.OwnRetailsSaleAmount + r.SaleToDealerAmount).ToString("N2") Lakhs
							</td>
						</tr>
					</tfoot>
				</table>
			</div>
		</div>

	</div>

	<div class="row g-3 mb-3">
		@foreach (var cat in _categories)
		{
			var catRows = _allSalesData.Where(s => s.CategoryId == cat.Id).ToList();
			var catTotalQty = catRows.Sum(r => r.OwnRetailsSaleQty + r.SaleToDealerQty);
			var catTotalAmt = catRows.Sum(r => r.OwnRetailsSaleAmount + r.SaleToDealerAmount);
			var unitName = _units.FirstOrDefault(u => u.Id == cat.UnitId)?.Name ?? "MT";
			var retailAmt = catRows.Sum(r => r.OwnRetailsSaleAmount);
			var dealerAmt = catRows.Sum(r => r.SaleToDealerAmount);
			var ratio = catTotalAmt > 0 ? (dealerAmt / catTotalAmt * 100) : 0;

			<div class="col-12 col-sm-6 col-md-4">
				<div class="total-value-card total-value-card-bgimg category-summary-card">
					<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/GrowthForecast.svg"
						 class="total-card-bg"
						 alt="GrowthForecast" />
					<div class="total-value-title category-summary-title">@cat.Name</div>
					<div class="total-value-amount category-summary-amount">
						₹ @catTotalAmt.ToString("N0") <span class="total-value-unit">Lakhs</span>
					</div>
					<div class="category-summary-meta">
						@catTotalQty.ToString("N2") @unitName &nbsp;|&nbsp; Dealer Ratio: @ratio.ToString("N1")%
					</div>
				</div>
			</div>
		}

	</div>

	<!-- New 3 Cards Section -->
	<div class="row g-3 mb-3">
		<!-- Card 1: Urea Product - By Category -->
		<div class="col-6">
			<div class="total-value-card total-value-card-bgimg">
				<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/GrowthForecast.svg"
					 class="total-card-bg"
					 alt="Urea" />
				<div class="total-value-title">Urea Product - By Category</div>
				<div style="padding: 15px 0;">
					@{
						var ureaProduct = _products.FirstOrDefault(p => p.Name != null && p.Name.Contains("Urea", StringComparison.OrdinalIgnoreCase));
						if (ureaProduct != null)
						{
							<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px;">
								@foreach (var cat in _categories)
								{
									var ureaData = _allSalesData.FirstOrDefault(s => s.ProductId == ureaProduct.Id && s.CategoryId == cat.Id);
									if (ureaData != null)
									{
										var unitName = _units.FirstOrDefault(u => u.Id == cat.UnitId)?.Name ?? "MT";
										var totalQty = ureaData.OwnRetailsSaleQty + ureaData.SaleToDealerQty;
										var totalAmt = ureaData.OwnRetailsSaleAmount + ureaData.SaleToDealerAmount;
										<div style="border-left: 3px solid #059669; padding-left: 10px;">
											<div style="font-weight: 600; color: #374151; font-size: 12px;">@cat.Name</div>
											<div style="color: #059669; font-weight: 700; font-size: 14px;">₹ @totalAmt.ToString("N0") Lakhs</div>
											<div style="color: #6B7280; font-size: 12px;">@totalQty.ToString("N2") @unitName</div>
										</div>
									}
								}
							</div>
						}
						else
						{
							<p style="color: #6B7280; margin: 0;">No Urea data available</p>
						}
					}
				</div>
			</div>
		</div>
		<!-- Card 2: All Other Products Total -->
		<div class="col-6">
			<div class="total-value-card total-value-card-bgimg">
				<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/GrowthForecast.svg"
					 class="total-card-bg"
					 alt="Other Products" />
				<div class="total-value-title">Other Products - Total</div>
				@{
					var ureaProd = _products.FirstOrDefault(p => p.Name != null && p.Name.Contains("Urea", StringComparison.OrdinalIgnoreCase));
					var otherProducts = _allSalesData.Where(s => ureaProd == null || s.ProductId != ureaProd.Id).ToList();
					var otherTotalQty = otherProducts.Sum(r => r.OwnRetailsSaleQty + r.SaleToDealerQty);
					var otherTotalAmt = otherProducts.Sum(r => r.OwnRetailsSaleAmount + r.SaleToDealerAmount);
				}
				<div class="total-value-amount category-summary-amount">
					₹ @otherTotalAmt.ToString("N0") <span class="total-value-unit">Lakhs</span>
				</div>
				<div class="category-summary-meta">
					@otherTotalQty.ToString("N2") MT
				</div>
			</div>
		</div>
		<!-- Card 3: Specialty Products (Placeholder) -->
		@* <div class="col-4">
			<div class="total-value-card total-value-card-bgimg">
				<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/GrowthForecast.svg"
					 class="total-card-bg"
					 alt="Specialty Products" />
				<div class="total-value-title">Specialty Products</div>
				<div class="total-value-amount category-summary-amount" style="color: #9CA3AF;">
					—
				</div>
			</div>
		</div> *@
	</div>

	<div class="row g-4">
		<div class="col-12 col-md-8">
			<div class="insights-card">
				<div class="insights-title">Automated Insights</div>
				<p class="insights-text">
					@if (_allSalesData.Count > 0)
					{
						var totalRetail = _allSalesData.Sum(r => r.OwnRetailsSaleAmount);
						var totalDealer = _allSalesData.Sum(r => r.SaleToDealerAmount);
						var grandTotal = totalRetail + totalDealer;
						var ratio = grandTotal > 0 ? (totalDealer / grandTotal * 100) : 0;
						<span>Based on your entries, your overall dealer-to-retail ratio is <strong>@ratio.ToString("N1")%</strong>.</span>
					}
					else
					{
						<span>Enter your sales data to see automated insights.</span>
					}
				</p>
			</div>
		</div>

		<div class="col-12 col-md-4">
			<div class="total-value-card total-value-card-bgimg">
				<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/GrowthForecast.svg"
					 class="total-card-bg"
					 alt="GrowthForecast" />
				<div class="total-value-title">Grand Total</div>
				<div class="total-value-amount">
					₹ @_allSalesData.Sum(r => r.OwnRetailsSaleAmount + r.SaleToDealerAmount).ToString("N0")
					<span class="total-value-unit">Per Year</span>
				</div>
			</div>
		</div>
	</div>

	<CommanFooter OnNextClick="HandleNext" IsNextDisabled="@_isSaving" />
</div>

@code {
	[SupplyParameterFromQuery(Name = "dealerId")]
	public int? DealerId { get; set; }

	private List<Category> _categories = new();
	private List<Unit> _units = new();
	private List<Product> _products = new();
	private List<AnnualSaleDataLastFYofDealerRegistration> _allSalesData = new();
	private List<AnnualSaleDataLastFYofDealerRegistration> _currentRows = new();

	private int _selectedCategoryId;
	private string _selectedUnitName = "MT";
	private bool _isSaving;
	private string? _message;
	private bool _isError;
	private bool _hasWholesaleLicense;

	protected override async Task OnInitializedAsync()
	{
		Loading.Show();
		try
		{
			await LoadCategories();
			await LoadUnits();
			await LoadProducts();

			if (_categories.Count > 0)
			{
				_selectedCategoryId = _categories.First().Id;
				UpdateSelectedUnit();
			}

			if (DealerId.HasValue && DealerId.Value > 0)
			{
				await LoadDealerInfo();
				await LoadSalesData();
			}

			BuildCurrentRows();
		}
		finally
		{
			Loading.Hide();
		}
	}

	private async Task LoadCategories()
	{
		try
		{
			_categories = await Http.GetFromJsonAsync<List<Category>>("api/Category") ?? new();
		}
		catch (Exception ex)
		{
			ShowMessage($"Failed to load categories: {ex.Message}", true);
		}
	}

	private async Task LoadUnits()
	{
		try
		{
			_units = await Http.GetFromJsonAsync<List<Unit>>("api/Unit") ?? new();
		}
		catch (Exception ex)
		{
			ShowMessage($"Failed to load units: {ex.Message}", true);
		}
	}

	private async Task LoadProducts()
	{
		try
		{
			_products = await Http.GetFromJsonAsync<List<Product>>("api/Product") ?? new();
		}
		catch (Exception ex)
		{
			ShowMessage($"Failed to load products: {ex.Message}", true);
		}
	}

	private async Task LoadDealerInfo()
	{
		try
		{
			var dealer = await Http.GetFromJsonAsync<DealerBasicInfo>($"api/DealerRegistration/{DealerId!.Value}");
			if (dealer != null)
				_hasWholesaleLicense = !string.IsNullOrWhiteSpace(dealer.WholeSaleFertilizerLicenseNumber);
		}
		catch { }
	}

	private async Task LoadSalesData()
	{
		try
		{
			var all = await Http.GetFromJsonAsync<List<AnnualSaleDataLastFYofDealerRegistration>>("api/AnnualSaleDataLastFY/all") ?? new();
			_allSalesData = all.Where(s => s.DealerId == DealerId!.Value).ToList();
		}
		catch (Exception ex)
		{
			ShowMessage($"Failed to load sales data: {ex.Message}", true);
		}
	}

	private void SelectCategory(int categoryId)
	{
		_selectedCategoryId = categoryId;
		UpdateSelectedUnit();
		BuildCurrentRows();
	}

	private void UpdateSelectedUnit()
	{
		var cat = _categories.FirstOrDefault(c => c.Id == _selectedCategoryId);
		if (cat != null)
			_selectedUnitName = _units.FirstOrDefault(u => u.Id == cat.UnitId)?.Name ?? "MT";
	}

	private void BuildCurrentRows()
	{
		var categoryProducts = _products.Where(p => p.CategoryId == _selectedCategoryId).ToList();
		_currentRows = new();

		foreach (var product in categoryProducts)
		{
			var existing = _allSalesData.FirstOrDefault(s => s.ProductId == product.Id && s.CategoryId == _selectedCategoryId);
			if (existing != null)
			{
				_currentRows.Add(existing);
			}
			else
			{
				var newRow = new AnnualSaleDataLastFYofDealerRegistration
				{
					DealerId = DealerId ?? 0,
					CategoryId = _selectedCategoryId,
					ProductId = product.Id,
					OwnRetailsSaleQty = 0,
					OwnRetailsSaleAmount = 0,
					SaleToDealerQty = 0,
					SaleToDealerAmount = 0
				};
				_currentRows.Add(newRow);
				_allSalesData.Add(newRow);
			}
		}
	}

	private void UpdateField(AnnualSaleDataLastFYofDealerRegistration row, ChangeEventArgs e, Func<AnnualSaleDataLastFYofDealerRegistration, decimal> getter, Action<AnnualSaleDataLastFYofDealerRegistration, decimal> setter)
	{
		if (decimal.TryParse(e.Value?.ToString(), out var val))
			setter(row, val);
	}

	private async Task HandleNext()
	{
		if (!DealerId.HasValue || DealerId.Value <= 0)
		{
			ShowMessage("Dealer ID is required.", true);
			return;
		}

		_isSaving = true;
		try
		{
			foreach (var row in _allSalesData)
			{
				if (row.OwnRetailsSaleQty == 0 && row.OwnRetailsSaleAmount == 0 && row.SaleToDealerQty == 0 && row.SaleToDealerAmount == 0 && row.Id == 0)
					continue;

				row.DealerId = DealerId.Value;

				if (row.Id > 0)
				{
					await Http.PutAsJsonAsync($"api/AnnualSaleDataLastFY/{row.Id}", row);
				}
				else
				{
					var response = await Http.PostAsJsonAsync("api/AnnualSaleDataLastFY", row);
					if (response.IsSuccessStatusCode)
					{
						var result = await response.Content.ReadFromJsonAsync<CreateResponse>();
						if (result?.Data != null)
							row.Id = result.Data.Id;
					}
				}
			}
			var hasError = _allSalesData.All(r => r.OwnRetailsSaleQty == 0 && r.OwnRetailsSaleAmount == 0 && r.SaleToDealerQty == 0 && r.SaleToDealerAmount == 0);
			FormStepData.MarkStepError(3, hasError);
			Loading.Show();
			Nav.NavigateTo($"/Warehouse?dealerId={DealerId}");
		}
		catch (Exception ex)
		{
			Loading.Hide();
			ShowMessage($"Failed to save: {ex.Message}", true);
		}
		finally
		{
			_isSaving = false;
		}
	}

	private void ShowMessage(string message, bool isError)
	{
		_message = message;
		_isError = isError;
	}

	private class CreateResponse
	{
		public string? Message { get; set; }
		public AnnualSaleDataLastFYofDealerRegistration? Data { get; set; }
	}

	private class DealerBasicInfo
	{
		public string? WholeSaleFertilizerLicenseNumber { get; set; }
	}
}