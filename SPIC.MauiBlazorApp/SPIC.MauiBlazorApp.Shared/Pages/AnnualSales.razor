@page "/AnnualSales" 


<div class="container-fluid py-4 px-0">
	<FormLoader />
	<div class="company-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
		<h3 class="fw-bold m-0 company-title">Annual Sales Data</h3>
	</div>
	<div class="form-card">

		<!-- Header -->
		<div class="d-flex justify-content-between align-items-center py-3 flex-wrap gap-2">
			<div class="card-header-title mb-0">
				<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/AddUserIcon.svg"
					 class="formicon" />
				Last Financial Year
			</div>

			<button class="btn-verified">
				<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/Verifiedicon.svg"
					 class="verifyicon" />
				Verified Units
			</button>
		</div>

		<!-- Table -->
		<div class="table-wrapper">
			<div class="table-responsive">
				<table class="spic-table">

					<thead>
						<tr>
							<th>Product Name</th>
							<th>Own Retail Sales (MT)</th>
							<th>Sales to Dealers (MT)</th>
							<th>MT Total Values</th>
						</tr>
					</thead>

					<tbody>

						<!-- Row -->
						<tr>
							<td>
								<div class="product-cell">
									<div class="product-icon">NU</div>
									<div>
										<div class="product-title">NC UREA</div>
										<div class="product-subtitle">Nitrogen Fertilizer</div>
									</div>
								</div>
							</td>
							<td><input class="table-input" value="12450" /></td>
							<td><input class="table-input" value="12450" /></td>
							<td class="text-value">12450</td>
						</tr>

						<tr>
							<td>
								<div class="product-cell">
									<div class="product-icon">NU</div>
									<div>
										<div class="product-title">DAP</div>
										<div class="product-subtitle">18:46:0</div>
									</div>
								</div>
							</td>
							<td><input class="table-input" value="12450" /></td>
							<td><input class="table-input" value="12450" /></td>
							<td class="text-value">12450</td>
						</tr>

						<tr>
							<td>
								<div class="product-cell">
									<div class="product-icon">NU</div>
									<div>
										<div class="product-title">NPK</div>
										<div class="product-subtitle">20:20:0:13</div>
									</div>
								</div>
							</td>
							<td><input class="table-input" value="12450" /></td>
							<td><input class="table-input" value="12450" /></td>
							<td class="text-value">12450</td>
						</tr>

					</tbody>

					<tfoot>
						<tr>
							<td>Grand Total</td>
							<td>40,750 MT</td>
							<td>10,900 MT</td>
							<td>10,900 MT</td>
						</tr>
					</tfoot>

				</table>
			</div>
		</div>

	</div>

	<div class="row g-4">
		<div class="col-md-8">
			<div class="insights-card">
				<div class="insights-title">Automated Insights</div>
				<p class="insights-text">
					Based on your entries, your dealer-to-retail ratio is 26.7%. This qualifies your business for the "Regional Hub" logistics incentive program. <strong>+14%</strong> vs. Prev Year
				</p>
			</div>
		</div>
            
		<div class="col-md-4">
			<div class="total-value-card total-value-card-bgimg">
				<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/GrowthForecast.svg"
					 class="total-card-bg"
					 alt="GrowthForecast" />
				<div class="total-value-title">Growth Forecast</div>
				<div class="total-value-amount">
					+14% vs. <span class="total-value-unit">Per Year</span>
				</div>
			</div>
		</div>
	</div>
	<CommanFooter />
</div>

   