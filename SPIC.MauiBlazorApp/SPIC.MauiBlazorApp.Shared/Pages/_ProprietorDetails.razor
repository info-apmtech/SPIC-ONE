@page "/ProprietorDetails" 
  
    <div class="container py-5">
        
        <div class="page-header">
            <i class="bi bi-arrow-left"></i>
            <h2 class="page-title">Proprietor Information</h2>
        </div>

        <div class="summary-card">
            <div class="profile-section">
                <div class="profile-icon"><i class="bi bi-buildings"></i></div>
                <div>
                    <div class="profile-name">Robert</div>
                    <div class="profile-phone">8899887766</div>
                </div>
            </div>

            <div class="row g-3">
                <div class="col">
                    <div class="info-box">
                        <div class="info-label">Name of Main Products</div>
                        <div class="info-value">Robert</div>
                    </div>
                </div>
                <div class="col">
                    <div class="info-box">
                        <div class="info-label">Mobile</div>
                        <div class="info-value">567876545678</div>
                    </div>
                </div>
                <div class="col">
                    <div class="info-box">
                        <div class="info-label">Email</div>
                        <div class="info-value">gmail.com</div>
                    </div>
                </div>
                <div class="col">
                    <div class="info-box">
                        <div class="info-label">PAN</div>
                        <div class="info-value">56787654235678</div>
                        <i class="bi bi-file-earmark-text end-icon"></i>
                    </div>
                </div>
                <div class="col">
                    <div class="info-box">
                        <div class="info-label">Aadhaar</div>
                        <div class="info-value">3242425325353</div>
                        <i class="bi bi-person-vcard end-icon"></i>
                    </div>
                </div>
            </div>
        </div>

        

        <h3 class="section-title mb-3">Family Members (3)</h3>
<div class="row g-4 mb-5">
    
    @for(int i=0; i<3; i++) {
    <div class="col-md-4">
        <div class="detail-card theme-blue">
            <div class="card-header-flex">
                <div class="card-title-group">
                    <div class="icon-box">
                        <img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/FamilyIcon.svg" style="width: 24px;" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
                        <i class="bi bi-people-fill" style="display:none;"></i>
                    </div>
                    <div>
                        <div class="card-label">Family Number</div>
                        <h4 class="card-value-main">ROBERT</h4>
                    </div>
                </div>
                <div class="card-actions" style="position: relative; z-index: 3;">
                    <i class="bi bi-pencil-square icon-edit"></i>
                    <i class="bi bi-trash icon-delete"></i>
                </div>
            </div>
            
            <div class="inner-grid">
                <div class="detail-item">
                    <span class="lbl">D.O.B</span>
                    <span class="val">27/3/1985</span>
                </div>
                <div class="detail-item">
                    <span class="lbl">Age</span>
                    <span class="val">₹ 84.5</span>
                </div>
                <div class="detail-item">
                    <span class="lbl">Relationship</span>
                    <span class="val">Father</span>
                </div>
                <div class="detail-item">
                    <span class="lbl">Occupation</span>
                    <span class="val">Farmer</span>
                </div>
            </div>
        </div>
    </div>
    }

</div>

        
        <h3 class="section-title mb-3">Occupations / Agencies (3)</h3>
<div class="row g-4 mb-4">
    
    @for(int i=0; i<3; i++) {
    <div class="col-md-4">
        <div class="detail-card theme-green">
            <div class="card-header-flex">
                <div class="card-title-group">
                    <div class="icon-box">
                        <img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/businessIcon1.svg" style="width: 24px;" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
                        <i class="bi bi-buildings-fill" style="display:none;"></i>
                    </div>
                    <div>
                        <div class="card-label">COMPANY</div>
                        <h4 class="card-value-main" style="text-transform: none;">Ludhiana Junction </h4>
                    </div>
                </div>
                <div class="card-actions">
                    <i class="bi bi-pencil-square icon-edit"></i>
                    <i class="bi bi-trash icon-delete"></i>
                </div>
            </div>
            
            <div class="inner-grid">
                <div class="detail-item">
                    <span class="lbl">Name of Main Products</span>
                    <span class="val">Robert</span>
                </div>
                <div class="detail-item">
                    <span class="lbl">Annual Turnover (₹)</span>
                    <span class="val">₹ 84.5</span>
                </div>
            </div>
        </div>
    </div>
    }

</div>

    </div>

   