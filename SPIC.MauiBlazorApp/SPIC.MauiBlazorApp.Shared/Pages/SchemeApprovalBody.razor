    private sealed record DrawerStep(string Code, string Name, string State, string? By, DateTime? At);

    private List<DrawerStep> BuildSteps()
    {
        var steps = new List<DrawerStep>();
        if (_detail == null) return steps;

        var stages = new (string Code, string Name)[]
        {
            ("MO", "MO"), ("RM", "RM"), ("SM", "SM"), ("SDWA", "SDWA")
        };

        var status = _detail.Status;
        int currentIndex = status switch
        {
            1 or 2 => 0,
            3 => 1,
            4 => 2,
            8 => 3,
            5 => 4,
            _ => -1
        };

        for (int i = 0; i < stages.Length; i++)
        {
            var (code, name) = stages[i];
            var approval = _detail.Approvals.FirstOrDefault(ap =>
                string.Equals(ap.ApprovalLevel, code, StringComparison.OrdinalIgnoreCase));

            string state;
            if (approval != null && approval.ApprovalStatus == "Approved")
                state = "done";
            else if (approval != null && approval.ApprovalStatus == "Rejected")
                state = "rejected";
            else if (status == 6)
                state = currentIndex >= 0 && i <= currentIndex ? "pending" : "stopped";
            else if (currentIndex >= 0 && i < currentIndex)
                state = "done";
            else if (currentIndex >= 0 && i == currentIndex)
                state = "active";
            else
                state = "pending";

            steps.Add(new DrawerStep(code, name, state, approval?.ApprovedBy, approval?.ApprovedAt));
        }

        return steps;
    }

    private WelfareApprovalStepDto? GetRejectionStep() =>
        _detail?.Approvals.FirstOrDefault(ap => ap.ApprovalStatus == "Rejected");

    private WelfareApprovalStepDto? GetLatestRejectionStep() =>
