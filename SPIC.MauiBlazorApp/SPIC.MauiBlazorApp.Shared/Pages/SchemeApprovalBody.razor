@using SPIC.Core.DTOs
@using SPIC.Core.Entities

@if (_loading)
{
    <div class="apd-header">
        <div class="apd-header-titles"><h2>Application Details</h2><p>Loading…</p></div>
        @if (OnClose.HasDelegate)
        {
            <button class="apd-close-icon" @onclick="CloseDrawer" aria-label="Close">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="15" y1="9" x2="9" y2="15"></line>
                    <line x1="9" y1="9" x2="15" y2="15"></line>
                </svg>
            </button>
        }
    </div>
    <div class="apd-body">
        <div class="apd-section" style="display:flex; align-items:center; gap:12px;">
            <div class="spinner-border text-success" role="status"></div>
            <span>Loading application details…</span>
        </div>
    </div>
}
else if (_error != null || _detail == null)
{
    <div class="apd-header">
        <div class="apd-header-titles"><h2>Application Details</h2><p>-</p></div>
        @if (OnClose.HasDelegate)
        {
            <button class="apd-close-icon" @onclick="CloseDrawer" aria-label="Close">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="15" y1="9" x2="9" y2="15"></line>
                    <line x1="9" y1="9" x2="15" y2="15"></line>
                </svg>
            </button>
        }
    </div>
    <div class="apd-body">
        <div class="apd-alert apd-alert-danger">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <span>@(_error ?? "Application details are unavailable.")</span>
        </div>
    </div>
}
else
{
    var d = _detail;

    <div class="apd-header">
        <div class="apd-header-titles">
            <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
                <h2>Application Details</h2>
                <span class="@GetStatusBadgeClass(d.Status)">@d.StatusDisplay</span>
            </div>
            <p>@(d.ApplicationNumber ?? "-")</p>
        </div>
        @if (OnClose.HasDelegate)
        {
            <button class="apd-close-icon" @onclick="CloseDrawer" aria-label="Close">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="15" y1="9" x2="9" y2="15"></line>
                    <line x1="9" y1="9" x2="15" y2="15"></line>
                </svg>
            </button>
        }
    </div>

    <div class="apd-body">

        <!-- ===================== WORKFLOW ===================== -->
        <div class="apd-section">
            <h3>Approval Workflow (MO → RM → SM → SDWA)</h3>
            <div class="apd-stepper">
                @{ var steps = BuildSteps(); }
                @for (var i = 0; i < steps.Count; i++)
                {
                    var step = steps[i];
                    <div class="apd-step">
                        <div class="@GetStepCircleClass(step.State)">
                            @if (step.State == "done")
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                            }
                            else if (step.State == "rejected")
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="18" y1="6" x2="6" y2="18"></line>
                                    <line x1="6" y1="6" x2="18" y2="18"></line>
                                </svg>
                            }
                            else if (step.State == "active")
                            {
                                @step.Code
                            }
                            else
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M6 2h12"></path><path d="M6 22h12"></path><path d="M6 2v4c0 2 2 4 4 5 -2 1 -4 3 -4 5v4"></path><path d="M18 2v4c0 2 -2 4 -4 5 2 1 4 3 4 5v4"></path>
                                </svg>
                            }
                        </div>
                        <div class="apd-step-info">
                            <div class="apd-step-name">@step.Name</div>
                            <div class="@GetStepStatusClass(step.State)">
                                @switch (step.State)
                                {
                                    case "done":
                                        @("Approved")<br />@(step.At.HasValue ? FormatDateTime(step.At.Value) : "")
                                        break;
                                    case "rejected":
                                        @("Rejected")<br />@(step.At.HasValue ? FormatDateTime(step.At.Value) : "")
                                        break;
                                    case "active":
                                        @("Under Review")
                                        break;
                                    case "stopped":
                                        @("Stopped")
                                        break;
                                    default:
                                        @("Pending")
                                        break;
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(step.By))
                            {
                                <div class="apd-step-status">@step.By</div>
                            }
                        </div>
                    </div>
                    @if (i < steps.Count - 1)
                    {
                        <div class="apd-step-connector">
                            @if (steps[i].State == "done")
                            {
                                <div class="apd-connector-fill" style="width:100%; background-color:#16A34A;"></div>
                            }
                        </div>
                    }
                }
            </div>
        </div>

        <!-- ===================== STATUS ALERT ===================== -->
        @{
            var currentStageName = GetPendingStageName(d.Status);
        }
        @if (CanProcessCurrentStage())
        {
            <div class="apd-alert apd-alert-warning">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <span><strong>Your Action Pending:</strong> Please review and approve or reject this application (@currentStageName stage).</span>
            </div>
        }
        else if (d.Status == 5)
        {
            <div class="apd-alert apd-alert-success">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
                <span>This application has been fully approved by SDWA. The approval workflow is completed.</span>
            </div>
        }
        else if (d.Status == 6)
        {
            var rejection = GetRejectionStep();
            <div class="apd-alert apd-alert-danger">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <span>
                    This application has been rejected by @(rejection?.ApprovedBy ?? StageLevelName(rejection?.ApprovalLevel ?? "the approval officer")). The approval process has been stopped.
                </span>
            </div>
        }
        else if (d.Status == 9)
        {
            var rejection = GetLatestRejectionStep();
            <div class="apd-alert apd-alert-danger">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <span>
                    This application was rejected by @(rejection?.ApprovedBy ?? StageLevelName(rejection?.ApprovalLevel ?? "MO")) and returned to the Dealer for correction. It will restart the approval flow at MO once resubmitted.
                </span>
            </div>
        }
        else
        {
            <div class="apd-alert apd-alert-success">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
                <span>This application has cleared your stage and is awaiting the next approval level (@(currentStageName)).</span>
            </div>
        }

        <!-- ===================== APPLICANT / DEALER INFO ===================== -->
        <div class="apd-section">
            <div class="apd-section-head">
                <h3>Applicant Information</h3>
            </div>
            <div class="apd-fields-grid">
                <div class="apd-field"><label>Dealer Code</label><div class="apd-field-value">@(d.DealerCode ?? "-")</div></div>
                <div class="apd-field"><label>Dealer Name</label><div class="apd-field-value">@(d.DealerName ?? "-")</div></div>
                <div class="apd-field"><label>Welfare Scheme</label><div class="apd-field-value">@d.SchemeName</div></div>
                <div class="apd-field"><label>Submitted Date</label><div class="apd-field-value">@FormatDate(d.ApplicationDate)</div></div>
                <div class="apd-field"><label>Mobile Number</label><div class="apd-field-value">@(d.MobileNumber ?? "-")</div></div>
                <div class="apd-field"><label>Dealership Nature</label><div class="apd-field-value">@(d.DealershipNature ?? "-")</div></div>
                <div class="apd-field"><label>Region</label><div class="apd-field-value">@(d.Region ?? "-")</div></div>
                <div class="apd-field"><label>District</label><div class="apd-field-value">@(d.District ?? "-")</div></div>
            </div>
        </div>

        <!-- ===================== BENEFICIARY / NOMINEE ===================== -->
        <div class="apd-section">
            <div class="apd-section-head">
                <h3>Nominee &amp; Beneficiary Information</h3>
            </div>
            <div class="apd-fields-grid apd-fields-3">
                <div class="apd-field"><label>Nominee Name</label><div class="apd-field-value">@(d.NomineeName ?? "-")</div></div>
                <div class="apd-field"><label>Relationship</label><div class="apd-field-value">@(d.NomineeRelationship ?? "-")</div></div>
                <div class="apd-field"><label>Name as in Cheque / Passbook</label><div class="apd-field-value">@(d.BeneficiaryNameAsInCheque ?? "-")</div></div>
                <div class="apd-field"><label>Name Taken From</label><div class="apd-field-value">@(d.LeafOrBankPassbook ?? "-")</div></div>
                <div class="apd-field"><label>Beneficiary Name</label><div class="apd-field-value">@(d.BeneficiaryName ?? "-")</div></div>
            </div>
        </div>

        <!-- ===================== ELIGIBILITY ===================== -->
        <div class="apd-section">
            <h3>Eligibility Information</h3>
            <div class="apd-fields-grid apd-fields-3">
                <div class="apd-field"><label>Beneficiary Group</label><div class="apd-field-value">@(d.BeneficiaryGroup ?? "-")</div></div>
                <div class="apd-field"><label>Sub Dealer</label><div class="apd-field-value">@(d.SubDealerName ?? "-")</div></div>
                <div class="apd-field"><label>Approved Employee</label><div class="apd-field-value">@(d.EmployeeName ?? "-")</div></div>
                <div class="apd-field"><label>Total Quantity Lifted (3 Years)</label><div class="apd-field-value">@(d.AverageQuantityLifted3Years?.ToString("0.##") ?? "-") MT</div></div>
                <div class="apd-field"><label>Last Year Quantity Lifted</label><div class="apd-field-value">@(d.LastYearQuantityLifted?.ToString("0.##") ?? "-") MT</div></div>
                <div class="apd-field"><label>Declaration Confirmed</label><div class="apd-field-value">@(d.IsDeclarationConfirmed ? "Yes" : "No")</div></div>
            </div>
        </div>

        <!-- ===================== DEALER SALES / LIFTING (ALL APPROVAL ROLES) ===================== -->
        @if (IsApprovalStage && d.DealerId > 0)
        {
            <div class="apd-section">
                <div class="apd-section-head">
                    <h3>Dealer Sales / Lifting Details (Last 3 Years)</h3>
                </div>

                @if (_dealerSalesLoading)
                {
                    <div style="display:flex; align-items:center; gap:10px;">
                        <div class="spinner-border spinner-border-sm text-success" role="status"></div>
                        <span style="color:#64748B;">Loading dealer sales data…</span>
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(_dealerSalesError))
                {
                    <div class="apd-alert apd-alert-danger">@_dealerSalesError</div>
                }
                else
                {
                    <div class="mo-sales-wrap">
                        <table class="mo-sales-table">
                            <thead>
                                <tr>
                                    <th>Year</th>
                                    <th>Urea</th>
                                    <th>DAP</th>
                                    <th>20:20</th>
                                    <th>SSP</th>
                                    <th>Total</th>
                                    <th>SP Turnover<br />Rs. Lakhs</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var y in _dealerAvailableYears)
                                {
                                    <tr>
                                        <td>@y.Name</td>
                                        <td>@FormatQty(GetYearQty(y.Id, DealerSalesCalculator.SalesKind.Urea))</td>
                                        <td>@FormatQty(GetYearQty(y.Id, DealerSalesCalculator.SalesKind.DAP))</td>
                                        <td>@FormatQty(GetYearQty(y.Id, DealerSalesCalculator.SalesKind.Npk2020))</td>
                                        <td>@FormatQty(GetYearQty(y.Id, DealerSalesCalculator.SalesKind.SSP))</td>
                                        <td>@FormatQty(GetYearTotal(y.Id))</td>
                                        <td>@FormatLakhs(GetYearTurnover(y.Id))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="mo-sales-note">
                        <strong>3-Year Total:</strong> @FormatQty(GetThreeYearTotal()) MT
                        &nbsp;|&nbsp; <strong>SP Product Turnover:</strong> Rs. @FormatLakhs(GetThreeYearTurnover()) Lakhs
                    </div>
                }
            </div>
        }

        <!-- ===================== ELIGIBILITY CONDITION VERIFICATION (MO - DIRECT DEALER ONLY) ===================== -->
        @if (ShowEligibilityVerification)
        {
            <div class="apd-section">
                <div class="apd-section-head">
                    <h3>Eligibility Condition Verification</h3>
                </div>

                @if (_proprietorInfoLoading)
                {
                    <div style="display:flex; align-items:center; gap:10px;">
                        <div class="spinner-border spinner-border-sm text-success" role="status"></div>
                        <span style="color:#64748B;">Loading dealer proprietor information…</span>
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(_proprietorInfoError))
                {
                    <div class="apd-alert apd-alert-danger">@_proprietorInfoError</div>
                }
                else
                {
                    <div class="apd-fields-grid apd-fields-3">
                        <div class="apd-field"><label>Applicant Category</label><div class="apd-field-value">@ApplicantCategoryDisplay</div></div>
                        <div class="apd-field"><label>Nominee (matched)</label><div class="apd-field-value">@(string.IsNullOrWhiteSpace(d.NomineeName) ? "-" : d.NomineeName)</div></div>
                        <div class="apd-field"><label>Applicable Condition</label><div class="apd-field-value">@EligibilityCriterionDisplay</div></div>
                        <div class="apd-field"><label>Current Sales / Registration</label><div class="apd-field-value">@EligibilityActualDisplay</div></div>
                    </div>
                    @if (MeetsEligibilityCondition)
                    {
                        <div class="apd-alert apd-alert-success">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline>
                            </svg>
                            <span><strong>Meets eligibility condition.</strong> The dealer satisfies the @ApplicantCategoryDisplay condition.</span>
                        </div>
                    }
                    else
                    {
                        <div class="apd-alert apd-alert-danger">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line>
                            </svg>
                            <span><strong>Does not meet eligibility condition.</strong> The dealer does not satisfy the @ApplicantCategoryDisplay condition.</span>
                        </div>
                    }
                }
            </div>
        }

        <!-- ===================== SCHEME SPECIFIC ===================== -->
        <div class="apd-section">
            <h3>Scheme Specific Details</h3>
            <div class="apd-fields-grid apd-fields-3">
                @foreach (var field in GetSchemeSpecificFields(d))
                {
                    <div class="apd-field"><label>@field.Label</label><div class="apd-field-value">@field.Value</div></div>
                }
            </div>
        </div>

        <!-- ===================== DOCUMENTS ===================== -->
        <div class="apd-section">
            <div class="apd-section-head">
                <h3>Uploaded Documents</h3>
            </div>
            @if (d.Documents.Count == 0)
            {
                <p style="color:#94A3B8;">No documents were uploaded with this application.</p>
            }
            else
            {
                <div class="apd-doc-list">
                    @foreach (var doc in d.Documents)
                    {
                        <div class="apd-doc-item">
                            <div class="apd-doc-icon"><img src="_content/SPIC.MauiBlazorApp.Shared/Images/Gallery/PdfIcon.png" /></div>
                            <div class="apd-doc-info">
                                <div class="apd-doc-name">@(string.IsNullOrWhiteSpace(doc.DocumentName) ? doc.FileName : doc.DocumentName)</div>
                                <div class="apd-doc-status">@(doc.IsVerified ? "Verified" : "Uploaded " + FormatDate(doc.UploadedAt))</div>
                            </div>
                            <div class="apd-doc-actions">
                                @if (IsMoStage)
                                {
                                    <button class="apd-btn-download" @onclick="() => ViewDocument(doc.Id)">View</button>
                                }
                                <button class="apd-btn-download" @onclick="() => OpenDocument(doc.Id, true)">Download</button>
                                @if (IsMoStage)
                                {
                                    <label class="apd-btn-replace mb-0" style="cursor:pointer;">
                                        <i class="bi bi-arrow-repeat"></i> Replace
                                        <InputFile hidden OnChange="(e) => OnReplaceFileSelected(doc, e)" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx,.xls,.xlsx" />
                                    </label>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- ===================== PREVIOUS REMARKS ===================== -->
        @{
            var previousRemarks = d.Approvals
                .Where(ap => !string.IsNullOrWhiteSpace(ap.Remarks)
                    || !string.IsNullOrWhiteSpace(ap.Recommendation)
                    || !string.IsNullOrWhiteSpace(ap.Comment))
                .ToList();
        }
        @if (previousRemarks.Count > 0)
        {
            <div class="apd-remarks-container">
                <h4 class="apd-box-title" style="color: #64748B;">Previous Remarks</h4>
                @foreach (var ap in previousRemarks)
                {
                    <div class="apd-remark-block">
                        <h5 style="color: #3B82F6;">@(StageLevelName(ap.ApprovalLevel)) Remarks</h5>
                        @if (!string.IsNullOrWhiteSpace(ap.Remarks))
                        {
                            <p>@ap.Remarks</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(ap.Recommendation))
                        {
                            <p style="margin-bottom:2px;"><strong>Recommendation:</strong> @ap.Recommendation</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(ap.Comment))
                        {
                            <p style="margin-top:2px;"><strong>Comment:</strong> @ap.Comment</p>
                        }
                        <small>
                            @(ap.ApprovalStatus == "Rejected" ? "Rejected" : "Approved")
                            by @(ap.ApprovedBy ?? "-")
                            @(ap.ApprovedAt.HasValue ? " on " + FormatDateTime(ap.ApprovedAt.Value) : "")
                        </small>
                    </div>
                }
            </div>
        }

        <!-- ===================== FINAL APPROVAL SUMMARY ===================== -->
        @if (d.Status == 5)
        {
            var sdwa = d.Approvals.FirstOrDefault(ap => ap.ApprovalStatus == "Approved" && ap.ApprovalLevel == "SDWA");
            <div class="apd-summary-box apd-box-green">
                <h4 class="apd-box-title">Approval Details</h4>
                <div class="apd-summary-grid">
                    <div class="apd-summary-item"><label>Approved By</label><span>@(sdwa?.ApprovedBy ?? "SDWA")</span></div>
                    <div class="apd-summary-item"><label>Approved On</label><span>@(sdwa?.ApprovedAt.HasValue == true ? FormatDateTime(sdwa.ApprovedAt.Value) : "-")</span></div>
                    <div class="apd-summary-item"><label>Final Remarks</label><span>@(sdwa?.Remarks ?? "-")</span></div>
                </div>
            </div>
        }

    </div>

    <div class="apd-footer">
        @if (CanProcessCurrentStage())
        {
            <div style="display:flex; flex-direction:column; gap:12px; width:100%;">
                @if (IsMoStage || IsRmStage || IsSmmStage || IsSdwaFinalStage)
                {
                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
                        <div style="display:flex; flex-direction:column; gap:4px;">
                            <label style="font-size:12px; font-weight:600; color:#374151;">Comments *</label>
                            <select class="rm-select" @bind="_approveComment" @bind:after="OnCommentChanged" disabled="@_busy" style="width:100%;">
                                <option value="">--Select--</option>
                                @foreach (var option in CurrentLevelCommentOptions)
                                {
                                    <option value="@option">@option</option>
                                }
                            </select>
                        </div>
                        <div style="display:flex; flex-direction:column; gap:4px;">
                            <label style="font-size:12px; font-weight:600; color:#374151;">Recommendation *</label>
                            <select class="rm-select" @bind="_approveRecommendation" disabled style="width:100%;">
                                <option value="">--Select--</option>
                                <option value="Verified">Verified</option>
                                <option value="Rejected">Rejected</option>
                            </select>
                        </div>
                    </div>
                }
                else
                {
                    <div style="display:flex; flex-direction:column; gap:4px;">
                        <label style="font-size:12px; font-weight:600; color:#374151;">Approval Remarks (Optional)</label>
                        <textarea class="rm-textarea" placeholder="Add your approval remarks..." @bind="_approveRemarks" disabled="@_busy" rows="2" style="width:100%;"></textarea>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(_actionError))
                {
                    <div class="apd-alert apd-alert-danger" style="margin:0;">@_actionError</div>
                }
                <div style="display:flex; justify-content:flex-end; gap:8px;">
                    <button class="apd-btn-action apd-btn-validate" disabled="@_busy" @onclick="ConfirmSubmit">
                        @(_busy ? "Processing..." : "Submit")
                    </button>
                </div>
            </div>
        }
        else if (OnClose.HasDelegate)
        {
            <button class="apd-btn-outline" @onclick="CloseDrawer">Close</button>
        }
    </div>
}



@code {
