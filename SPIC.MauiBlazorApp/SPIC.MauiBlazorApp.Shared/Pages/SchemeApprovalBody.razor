    private sealed record FieldData(string Label, string Value);

    private static List<FieldData> GetSchemeSpecificFields(SPIC.Core.DTOs.WelfareApplicationDetailDto d)
    {
        var fields = new List<FieldData>();
        switch (d.SchemeType)
        {
            case 0:
                fields.Add(new FieldData("Treatment Type", d.MedicalTreatmentType ?? "-"));
                break;
            case 1:
                fields.Add(new FieldData("Marriage Date", FormatDateNullable(d.MarriageDate)));
                break;
            case 2:
                fields.Add(new FieldData("Event Date", FormatDateNullable(d.EventDate)));
                fields.Add(new FieldData("Ownership Type", d.OwnershipType ?? "-"));
                fields.Add(new FieldData("Event Venue", d.EventVenue ?? "-"));
                break;
            case 3:
                fields.Add(new FieldData("Course", d.Course ?? "-"));
                fields.Add(new FieldData("Year of Study", d.EduYear?.ToString() ?? "-"));
                fields.Add(new FieldData("College Name", d.CollegeName ?? "-"));
                fields.Add(new FieldData("Total Duration (Years)", d.TotalNumberOfCourses?.ToString() ?? "-"));
                fields.Add(new FieldData("First Application", d.IsFirstApplication == null ? "-" : (d.IsFirstApplication.Value ? "Yes" : "No")));
                break;
            case 4:
                fields.Add(new FieldData("Event Date", FormatDateNullable(d.EventDate)));
                fields.Add(new FieldData("Ownership Type", d.OwnershipType ?? "-"));
                fields.Add(new FieldData("Event Venue", d.EventVenue ?? "-"));
                break;
            case 5:
                fields.Add(new FieldData("Date of Death", FormatDateNullable(d.DateOfDeath)));
                fields.Add(new FieldData("Legal Heir Name", d.LegalHeirName ?? "-"));
                fields.Add(new FieldData("Cause of Death", d.DeathCause ?? "-"));
                break;
            case 6:
                fields.Add(new FieldData("Candidate Name", d.MeritCandidateName ?? "-"));
                fields.Add(new FieldData("Father's Name", d.MeritFatherName ?? "-"));
                fields.Add(new FieldData("Examination Appeared", d.ExaminationAppeared ?? "-"));
                fields.Add(new FieldData("Board", d.BoardName ?? "-"));
                fields.Add(new FieldData("Maximum Marks", d.MaximumMarks?.ToString() ?? "-"));
                fields.Add(new FieldData("Marks Obtained", d.MarksObtained?.ToString() ?? "-"));
                fields.Add(new FieldData("Percentage", d.MeritPercentage?.ToString("0.##") ?? "-"));
                break;
            case 7:
                fields.Add(new FieldData("Candidate Name", d.DistinctionCandidateName ?? "-"));
                fields.Add(new FieldData("Father's Name", d.DistinctionFatherName ?? "-"));
                fields.Add(new FieldData("Professional Course", d.ProfessionalCourseName ?? "-"));
                fields.Add(new FieldData("Course Completion Year", d.CourseCompletionYear?.ToString() ?? "-"));
                fields.Add(new FieldData("University", d.UniversityName ?? "-"));
                fields.Add(new FieldData("Maximum Marks", d.DistinctionMaximumMarks?.ToString() ?? "-"));
                fields.Add(new FieldData("Marks Obtained", d.DistinctionMarksObtained?.ToString() ?? "-"));
                fields.Add(new FieldData("Aggregate Percentage", d.DistinctionAggregatePercentage?.ToString("0.##") ?? "-"));
                fields.Add(new FieldData("Arrears", d.HasArrears == null ? "-" : (d.HasArrears.Value ? "Yes" : "No")));
                fields.Add(new FieldData("Wholesale Dealer Employee", d.IsWholesaleDealerEmployee == null ? "-" : (d.IsWholesaleDealerEmployee.Value ? "Yes" : "No")));
                break;
        }
        return fields;
    }

    private void OnCommentChanged()
    {
        if (string.IsNullOrWhiteSpace(_approveComment))
        {
            _approveRecommendation = "";
            return;
        }
        _approveRecommendation = CurrentLevelApprovalComments.Contains(_approveComment, StringComparer.Ordinal)
            ? "Verified"
            : "Rejected";
    }

    private async Task ConfirmSubmit()
    {
        if (_detail == null || _busy) return;

        var usesRecommendationFlow = IsMoStage || IsRmStage || IsSmmStage || IsSdwaFinalStage;

        if (usesRecommendationFlow && string.IsNullOrWhiteSpace(_approveComment))
        {
            _actionError = "Please select a comment.";
            return;
        }

        if (usesRecommendationFlow && !IsValidLevelComment(_approveComment))
        {
            _actionError = "Please select a valid comment.";
            return;
        }

        if (usesRecommendationFlow && string.IsNullOrWhiteSpace(_approveRecommendation))
        {
            _actionError = "Please select a recommendation.";
            return;
        }

        _busy = true;
        _actionError = null;
        try
        {
            HttpResponseMessage response;
            var hasRecommendationFlow = usesRecommendationFlow;

            if (hasRecommendationFlow && _approveRecommendation == "Verified")
            {
                response = await Http.PostAsJsonAsync(
                    $"api/WelfareSchemeApproval/applications/{_detail.Id}/approve",
                    new WelfareApprovalActionRequest
                    {
                        Recommendation = _approveRecommendation,
                        Comment = _approveComment
                    });
            }
            else if (hasRecommendationFlow && _approveRecommendation == "Rejected")
            {
                response = await Http.PostAsJsonAsync(
                    $"api/WelfareSchemeApproval/applications/{_detail.Id}/reject",
                    new WelfareApprovalActionRequest
                    {
                        Remarks = _approveComment,
                        Recommendation = _approveRecommendation,
                        Comment = _approveComment
                    });
            }
            else
            {
                response = await Http.PostAsJsonAsync(
                    $"api/WelfareSchemeApproval/applications/{_detail.Id}/approve",
                    new WelfareApprovalActionRequest
                    {
                        Remarks = _approveRemarks
                    });
            }

            if (response.IsSuccessStatusCode)
            {
                await OnActionCompleted.InvokeAsync();
            }
            else
            {
                _actionError = await ReadErrorMessageAsync(response);
            }
        }
        catch
        {
            _actionError = "Unable to reach the server. Please try again.";
        }
        finally
        {
            _busy = false;
        }
    }

    private static readonly string[] MoCommentOptions =
    {
        "Information verified and eligible for approval",
        "Documents incomplete or not valid",
        "Information mismatch found",
        "Eligibility criteria not met at verification stage"
    };

    private static readonly string[] RmCommentOptions =
    {
        "Verified and recommended as a genuine dealer",
        "Information mismatch found",
        "Verification failed at regional level"
    };

    private static readonly string[] SmmCommentOptions =
    {
        "Recommended for management approval",
        "Application does not meet approval criteria",
        "Rejected after review of verification remarks",
        "Recommendation not accepted at state level",
        "Not recommended for approval based on field reports"
    };

    // SDWA final-approval comment options - shown to the user whose DATABASE
    // Designation is SDWA, regardless of their AppRole.
    private static readonly string[] SdwaCommentOptions =
    {
        "Verified and approved for final release",
        "Documents / eligibility not satisfied at final review",
        "Rejected after final review"
    };

    // Comments that resolve to an approval recommendation for the current level.
    // SDWA (Designation-based) is checked first since a user can hold it
    // alongside an AppRole of MO/RM/SM.
    private IReadOnlyList<string> CurrentLevelApprovalComments
    {
        get
        {
            if (IsSdwaFinalStage) return new[] { "Verified and approved for final release" };
            return LoginState.UserRole switch
            {
                AppRole.MO => new[] { "Information verified and eligible for approval" },
                AppRole.RM => new[] { "Verified and recommended as a genuine dealer" },
                AppRole.SMM => new[] { "Recommended for management approval" },
                _ => Array.Empty<string>()
            };
        }
    }

    private IReadOnlyList<string> CurrentLevelCommentOptions
    {
        get
        {
            if (IsSdwaFinalStage) return SdwaCommentOptions;
            return LoginState.UserRole switch
            {
                AppRole.MO => MoCommentOptions,
                AppRole.RM => RmCommentOptions,
                AppRole.SMM => SmmCommentOptions,
                _ => Array.Empty<string>()
            };
        }
    }

    private bool IsValidLevelComment(string? value) =>
        !string.IsNullOrWhiteSpace(value) &&
        CurrentLevelCommentOptions.Contains(value, StringComparer.Ordinal);

    private static async Task<string> ReadErrorMessageAsync(HttpResponseMessage response)
    {
        try
        {
            var body = await response.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
            if (body.TryGetProperty("Message", out var msg))
                return msg.GetString() ?? "Action failed. Please try again.";
        }
        catch { }
        return response.StatusCode == System.Net.HttpStatusCode.Conflict
            ? "This application is no longer pending at your approval stage."
            : "Action failed. Please try again.";
    }

    private void ResetActionState()
    {
        _approveRemarks = null;
        _approveRecommendation = "";
        _approveComment = null;
        _actionError = null;
        _busy = false;
    }

    private async Task OpenDocument(int documentId, bool download)
    {
        var baseUrl = Http.BaseAddress?.ToString().TrimEnd('/') ?? "";
        var token = GetRawToken();
        var url = $"{baseUrl}/api/WelfareSchemeApproval/document/{documentId}";
        if (download) url += "?disposition=attachment";
        if (!string.IsNullOrWhiteSpace(token))
            url += (url.Contains('?') ? "&" : "?") + "access_token=" + Uri.EscapeDataString(token);
        await JS.InvokeVoidAsync("open", url, "_blank");
    }

    private Task ViewDocument(int documentId) => OpenDocument(documentId, false);

    // Direct replace on file selection (same pattern as Enclosures Partner/Proprietor
    // document replacement): the moment a file is picked, upload it and update the
    // existing document row in place, then reload the application.
    private async Task OnReplaceFileSelected(SPIC.Core.DTOs.WelfareApplicationDocumentDto doc, Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        if (doc == null || e.File == null || _busy) return;

        _busy = true;
        try
        {
            using var content = new MultipartFormDataContent();
            var stream = e.File.OpenReadStream(maxAllowedSize: 25 * 1024 * 1024);
            content.Add(new StreamContent(stream), "file", e.File.Name);
            content.Add(new StringContent(doc.DocumentType ?? ""), "documentType");

            var url = $"/api/WelfareSchemeApproval/document/{doc.Id}/replace";
            var response = await Http.PostAsync(url, content);
            if (response.IsSuccessStatusCode)
            {
                await LoadDetail(_detail?.Id ?? ApplicationId);
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                var msg = ExtractErrorMessage(body) ?? "Failed to replace the document.";
                _actionError = msg;
            }
        }
        catch (Exception ex)
        {
            _actionError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private static string? ExtractErrorMessage(string body)
    {
        try
        {
            var json = System.Text.Json.JsonDocument.Parse(body);
            if (json.RootElement.TryGetProperty("message", out var m) && m.ValueKind == System.Text.Json.JsonValueKind.String)
                return m.GetString();
        }
        catch
        {
        }
        return null;
    }

    private string? GetRawToken()
    {
        try
        {
            var token = LoginState.Token;
            if (string.IsNullOrWhiteSpace(token)) return null;
            return token.StartsWith("Bearer ", StringComparison.OrdinalIgnoreCase)
                ? token["Bearer ".Length..]
                : token;
        }
        catch
        {
            return null;
        }
    }

    private static string FormatDate(DateTime date) => date.ToString("dd MMM yyyy");

    private static string FormatDateNullable(DateTime? date) => date.HasValue ? date.Value.ToString("dd MMM yyyy") : "-";

    private static string FormatDateTime(DateTime dateTime) => dateTime.ToString("dd MMM yyyy, hh:mm tt");
}
