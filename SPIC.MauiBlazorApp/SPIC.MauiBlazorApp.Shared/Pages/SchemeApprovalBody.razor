    // =====================================================================
    // MO Eligibility Condition Verification (Direct Dealer applications only)
    //
    // The applicable condition depends on the applicant category, which is
    // derived exclusively from the Proprietor-page data (dealer entity type +
    // saved owner list) matched against the application's nominee:
    //   - Proprietorship        : sole proprietor whose name matches the nominee
    //   - Managing Partner      : first saved owner of a Partnership
    //   - Other Partner         : any remaining saved owner of a Partnership
    //   - Dealership            : everything else (firm itself / other entity types)
    // =====================================================================

    private enum DealerApplicantCategory
    {
        Proprietorship,
        ManagingPartner,
        OtherPartner,
        Dealership
    }

    private const decimal ProprietorshipFertilizerThresholdMt = 100m;
    private const decimal ProprietorshipSpTurnoverLakhs = 3m;
    private const decimal OtherPartnerFertilizerThresholdMt = 1000m;
    private const decimal OtherPartnerSpTurnoverLakhs = 30m;
    private const int DealershipMinimumYears = 1;

    private bool ShowEligibilityVerification =>
        IsMoStage &&
        _detail != null &&
        _detail.DealerId > 0 &&
        string.Equals(_detail.BeneficiaryGroup, "Direct Dealer", StringComparison.OrdinalIgnoreCase);

    private DealerApplicantCategory ApplicantCategory
    {
        get
        {
            var nominee = _detail?.NomineeName?.Trim() ?? string.Empty;
            var entityType = _dealer?.EntityType;

            if (entityType == EntityType.soleProprietor)
            {
                return _ownershipPartners.Any(o =>
                        string.Equals((o.Name ?? string.Empty).Trim(), nominee, StringComparison.OrdinalIgnoreCase))
                    ? DealerApplicantCategory.Proprietorship
                    : DealerApplicantCategory.Dealership;
            }

            if (entityType == EntityType.Partnership)
            {
                var firstOwner = _ownershipPartners.FirstOrDefault();
                if (firstOwner != null &&
                    string.Equals((firstOwner.Name ?? string.Empty).Trim(), nominee, StringComparison.OrdinalIgnoreCase))
                {
                    return DealerApplicantCategory.ManagingPartner;
                }
                if (_ownershipPartners.Skip(1).Any(o =>
                        string.Equals((o.Name ?? string.Empty).Trim(), nominee, StringComparison.OrdinalIgnoreCase)))
                {
                    return DealerApplicantCategory.OtherPartner;
                }
                return DealerApplicantCategory.Dealership;
            }

            // LLP / Pvt Ltd / Pub Ltd / Society / unresolvable => the dealership itself
            return DealerApplicantCategory.Dealership;
        }
    }

    // Earliest date the dealership was registered with any company (SPIC or GreenStar).
    private DateTime? DealerRegistrationDate
    {
        get
        {
            var spic = _dealer != null && _dealer.DateOfAppointment > DateTime.MinValue
                ? _dealer.DateOfAppointment
                : (DateTime?)null;
            var greenStar = _dealer?.GreenstarDateOfAppointment;

            if (spic.HasValue && greenStar.HasValue)
                return spic.Value <= greenStar.Value ? spic.Value : greenStar.Value;
            return spic ?? greenStar;
        }
    }

    private decimal FertilizerLiftingMt =>
        DealerSalesCalculator.GetThreeYearTotal(_dealerProductSales, _dealerAvailableYears);

    private decimal SpTurnoverLakhs =>
        DealerSalesCalculator.GetThreeYearTurnover(_dealerProductSales, _dealerAvailableYears);

    private bool MeetsEligibilityCondition => ApplicantCategory switch
    {
        DealerApplicantCategory.Proprietorship or DealerApplicantCategory.ManagingPartner =>
            FertilizerLiftingMt >= ProprietorshipFertilizerThresholdMt || SpTurnoverLakhs >= ProprietorshipSpTurnoverLakhs,
        DealerApplicantCategory.OtherPartner =>
            FertilizerLiftingMt >= OtherPartnerFertilizerThresholdMt || SpTurnoverLakhs >= OtherPartnerSpTurnoverLakhs,
        _ => DealerRegistrationDate.HasValue &&
             DealerRegistrationDate.Value <= DateTime.Today.AddYears(-DealershipMinimumYears)
    };

