    private async Task LoadDealerSalesIfNeeded()
    {
        if (!IsApprovalStage || _detail == null || _detail.DealerId <= 0) return;
        if (_dealerSalesLoadedForId == _detail.DealerId) return;

        _dealerSalesLoading = true;
        _dealerSalesError = null;
        try
        {
            var summary = await Http.GetFromJsonAsync<SPIC.Core.DTOs.DealerSalesSummaryDto>(
                $"api/CreditLimitSales/dealer-sales-summary/{_detail.DealerId}");
            _dealerAvailableYears = summary?.AvailableYears ?? new();
            _dealerProductSales = summary?.ProductSales ?? new();
            _dealerSalesLoadedForId = _detail.DealerId;
        }
        catch
        {
            _dealerSalesError = "Unable to load dealer sales data.";
        }
        finally
        {
            _dealerSalesLoading = false;
        }
    }

    private async Task LoadProprietorInfoIfNeeded()
    {
        if (!IsMoStage || _detail == null || _detail.DealerId <= 0) return;
        if (_proprietorLoadedForDealerId == _detail.DealerId) return;

        _proprietorInfoLoading = true;
        _proprietorInfoError = null;
        try
        {
            var dealerTask = Http.GetFromJsonAsync<DealerRegistration>($"api/DealerRegistration/{_detail.DealerId}");
            var ownersTask = Http.GetFromJsonAsync<List<DealerOwnershipInfo>>($"api/DealerOwnershipInfo/byDealer/{_detail.DealerId}");

            await Task.WhenAll(dealerTask, ownersTask);

            _dealer = dealerTask.Result;
            _ownershipPartners = ownersTask.Result ?? new();
            _proprietorLoadedForDealerId = _detail.DealerId;
