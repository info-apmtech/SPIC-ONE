@using SPIC.Core.DTOs
@using SPIC.Core.Entities

@if (_loading)
{
    <div class="apd-header">
        <div class="apd-header-titles"><h2>Application Details</h2><p>Loading…</p></div>
        @if (OnClose.HasDelegate)
        {
            <button class="apd-close-icon" @onclick="CloseDrawer" aria-label="Close">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="15" y1="9" x2="9" y2="15"></line>
                    <line x1="9" y1="9" x2="15" y2="15"></line>
                </svg>
            </button>
        }
    </div>
    <div class="apd-body">
        <div class="apd-section" style="display:flex; align-items:center; gap:12px;">
            <div class="spinner-border text-success" role="status"></div>
            <span>Loading application details…</span>
        </div>
    </div>
}
else if (_error != null || _detail == null)
{
    <div class="apd-header">
        <div class="apd-header-titles"><h2>Application Details</h2><p>-</p></div>
        @if (OnClose.HasDelegate)
        {
            <button class="apd-close-icon" @onclick="CloseDrawer" aria-label="Close">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="15" y1="9" x2="9" y2="15"></line>
                    <line x1="9" y1="9" x2="15" y2="15"></line>
                </svg>
            </button>
        }
    </div>
    <div class="apd-body">
        <div class="apd-alert apd-alert-danger">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <span>@(_error ?? "Application details are unavailable.")</span>
        </div>
    </div>
}
else
{
    var d = _detail;

    <div class="apd-header">
        <div class="apd-header-titles">
            <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
                <h2>Application Details</h2>
                <span class="@GetStatusBadgeClass(d.Status)">@d.StatusDisplay</span>
            </div>
            <p>@(d.ApplicationNumber ?? "-")</p>
        </div>
        @if (OnClose.HasDelegate)
        {
            <button class="apd-close-icon" @onclick="CloseDrawer" aria-label="Close">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="15" y1="9" x2="9" y2="15"></line>
                    <line x1="9" y1="9" x2="15" y2="15"></line>
                </svg>
            </button>
        }
    </div>

    <div class="apd-body">

        <!-- ===================== WORKFLOW ===================== -->
        <div class="apd-section">
            <h3>Approval Workflow (MO → RM → SM → AVP)</h3>
            <div class="apd-stepper">
                @{ var steps = BuildSteps(); }
                @for (var i = 0; i < steps.Count; i++)
                {
                    var step = steps[i];
                    <div class="apd-step">
                        <div class="@GetStepCircleClass(step.State)">
                            @if (step.State == "done")
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                            }
                            else if (step.State == "rejected")
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="18" y1="6" x2="6" y2="18"></line>
                                    <line x1="6" y1="6" x2="18" y2="18"></line>
                                </svg>
                            }
                            else if (step.State == "active")
                            {
                                @step.Code
                            }
                            else
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M6 2h12"></path><path d="M6 22h12"></path><path d="M6 2v4c0 2 2 4 4 5 -2 1 -4 3 -4 5v4"></path><path d="M18 2v4c0 2 -2 4 -4 5 2 1 4 3 4 5v4"></path>
                                </svg>
                            }
                        </div>
                        <div class="apd-step-info">
                            <div class="apd-step-name">@step.Name</div>
                            <div class="@GetStepStatusClass(step.State)">
                                @switch (step.State)
                                {
                                    case "done":
                                        @("Approved")<br />@(step.At.HasValue ? FormatDateTime(step.At.Value) : "")
                                        break;
                                    case "rejected":
                                        @("Rejected")<br />@(step.At.HasValue ? FormatDateTime(step.At.Value) : "")
                                        break;
                                    case "active":
                                        @("Under Review")
                                        break;
                                    case "stopped":
                                        @("Stopped")
                                        break;
                                    default:
                                        @("Pending")
                                        break;
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(step.By))
                            {
                                <div class="apd-step-status">@step.By</div>
                            }
                        </div>
                    </div>
                    @if (i < steps.Count - 1)
                    {
                        <div class="apd-step-connector">
                            @if (steps[i].State == "done")
                            {
                                <div class="apd-connector-fill" style="width:100%; background-color:#16A34A;"></div>
                            }
                        </div>
                    }
                }
            </div>
        </div>

        <!-- ===================== STATUS ALERT ===================== -->
        @{
            var currentStageName = GetPendingStageName(d.Status);
        }
        @if (CanProcessCurrentStage())
        {
            <div class="apd-alert apd-alert-warning">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <span><strong>Your Action Pending:</strong> Please review and approve or reject this application (@currentStageName stage).</span>
            </div>
        }
        else if (d.Status == 5)
        {
            <div class="apd-alert apd-alert-success">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
                <span>This application has been fully approved by AVP. The approval workflow is completed.</span>
            </div>
        }
        else if (d.Status == 6)
        {
            var rejection = GetRejectionStep();
            <div class="apd-alert apd-alert-danger">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <span>
                    This application has been rejected by @(rejection?.ApprovedBy ?? StageLevelName(rejection?.ApprovalLevel ?? "the approval officer")). The approval process has been stopped.
                </span>
            </div>
        }
        else if (d.Status == 9)
        {
            var rejection = GetLatestRejectionStep();
            <div class="apd-alert apd-alert-danger">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <span>
                    This application was rejected by @(rejection?.ApprovedBy ?? StageLevelName(rejection?.ApprovalLevel ?? "MO")) and returned to the Dealer for correction. It will restart the approval flow at MO once resubmitted.
                </span>
            </div>
        }
        else
        {
            <div class="apd-alert apd-alert-success">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
                <span>This application has cleared your stage and is awaiting the next approval level (@(currentStageName)).</span>
            </div>
        }

        <!-- ===================== APPLICANT / DEALER INFO ===================== -->
        <div class="apd-section">
            <div class="apd-section-head">
                <h3>Applicant Information</h3>
            </div>
            <div class="apd-fields-grid">
                <div class="apd-field"><label>Dealer Code</label><div class="apd-field-value">@(d.DealerCode ?? "-")</div></div>
                <div class="apd-field"><label>Dealer Name</label><div class="apd-field-value">@(d.DealerName ?? "-")</div></div>
                <div class="apd-field"><label>Welfare Scheme</label><div class="apd-field-value">@d.SchemeName</div></div>
                <div class="apd-field"><label>Submitted Date</label><div class="apd-field-value">@FormatDate(d.ApplicationDate)</div></div>
                <div class="apd-field"><label>Mobile Number</label><div class="apd-field-value">@(d.MobileNumber ?? "-")</div></div>
                <div class="apd-field"><label>Dealership Nature</label><div class="apd-field-value">@(d.DealershipNature ?? "-")</div></div>
                <div class="apd-field"><label>Region</label><div class="apd-field-value">@(d.Region ?? "-")</div></div>
                <div class="apd-field"><label>District</label><div class="apd-field-value">@(d.District ?? "-")</div></div>
            </div>
        </div>

        <!-- ===================== BENEFICIARY / NOMINEE ===================== -->
        <div class="apd-section">
            <div class="apd-section-head">
                <h3>Nominee &amp; Beneficiary Information</h3>
            </div>
            <div class="apd-fields-grid apd-fields-3">
                <div class="apd-field"><label>Nominee Name</label><div class="apd-field-value">@(d.NomineeName ?? "-")</div></div>
                <div class="apd-field"><label>Relationship</label><div class="apd-field-value">@(d.NomineeRelationship ?? "-")</div></div>
                <div class="apd-field"><label>Name as in Cheque / Passbook</label><div class="apd-field-value">@(d.BeneficiaryNameAsInCheque ?? "-")</div></div>
                <div class="apd-field"><label>Name Taken From</label><div class="apd-field-value">@(d.LeafOrBankPassbook ?? "-")</div></div>
                <div class="apd-field"><label>Beneficiary Name</label><div class="apd-field-value">@(d.BeneficiaryName ?? "-")</div></div>
            </div>
        </div>

        <!-- ===================== ELIGIBILITY ===================== -->
        <div class="apd-section">
            <h3>Eligibility Information</h3>
            <div class="apd-fields-grid apd-fields-3">
                <div class="apd-field"><label>Beneficiary Group</label><div class="apd-field-value">@(d.BeneficiaryGroup ?? "-")</div></div>
                <div class="apd-field"><label>Sub Dealer</label><div class="apd-field-value">@(d.SubDealerName ?? "-")</div></div>
                <div class="apd-field"><label>Approved Employee</label><div class="apd-field-value">@(d.EmployeeName ?? "-")</div></div>
                <div class="apd-field"><label>Avg Quantity Lifted (3 Years)</label><div class="apd-field-value">@(d.AverageQuantityLifted3Years?.ToString("0.##") ?? "-") MT</div></div>
                <div class="apd-field"><label>Last Year Quantity Lifted</label><div class="apd-field-value">@(d.LastYearQuantityLifted?.ToString("0.##") ?? "-") MT</div></div>
                <div class="apd-field"><label>Declaration Confirmed</label><div class="apd-field-value">@(d.IsDeclarationConfirmed ? "Yes" : "No")</div></div>
            </div>
        </div>

        <!-- ===================== DEALER SALES / LIFTING (MO ONLY) ===================== -->
        @if (IsMoStage && d.DealerId > 0)
        {
            <div class="apd-section">
                <div class="apd-section-head">
                    <h3>Dealer Sales / Lifting Details (Last 3 Years)</h3>
                </div>

                @if (_dealerSalesLoading)
                {
                    <div style="display:flex; align-items:center; gap:10px;">
                        <div class="spinner-border spinner-border-sm text-success" role="status"></div>
                        <span style="color:#64748B;">Loading dealer sales data…</span>
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(_dealerSalesError))
                {
                    <div class="apd-alert apd-alert-danger">@_dealerSalesError</div>
                }
                else
                {
                    <div class="mo-sales-wrap">
                        <table class="mo-sales-table">
                            <thead>
                                <tr>
                                    <th>Year</th>
                                    <th>Urea</th>
                                    <th>DAP</th>
                                    <th>20:20</th>
                                    <th>SSP</th>
                                    <th>Total</th>
                                    <th>SP Turnover<br />Rs. Lakhs</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < 3; i++)
                                {
                                    var fyId = _selectedSalesYears[i];
                                    var usedIds = _selectedSalesYears.Where(y => y.HasValue).Select(y => y!.Value).ToHashSet();
                                    var options = _dealerAvailableYears.Where(y => !usedIds.Contains(y.Id) || y.Id == fyId).ToList();
                                    <tr>
                                        <td>
                                            @if (i == 0 && !fyId.HasValue)
                                            {
                                                <span class="mo-sales-placeholder">Year 1</span>
                                            }
                                            <select class="mo-sales-year-select" value="@fyId" @onchange="(e) => OnSalesYearChanged(i, e)">
                                                <option value="">Select Year</option>
                                                @foreach (var y in options)
                                                {
                                                    <option value="@y.Id">@y.Name</option>
                                                }
                                            </select>
                                        </td>
                                        <td>@FormatQty(GetYearQty(fyId, SalesKind.Urea))</td>
                                        <td>@FormatQty(GetYearQty(fyId, SalesKind.DAP))</td>
                                        <td>@FormatQty(GetYearQty(fyId, SalesKind.Npk2020))</td>
                                        <td>@FormatQty(GetYearQty(fyId, SalesKind.SSP))</td>
                                        <td>@FormatQty(GetYearTotal(fyId))</td>
                                        <td>@FormatLakhs(GetYearTurnover(fyId))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (_selectedSalesYears.All(y => y.HasValue))
                    {
                        <div class="mo-sales-note">
                            <strong>3-Year Average Total:</strong> @FormatQty(GetThreeYearAverageTotal()) MT
                            &nbsp;|&nbsp; <strong>3-Year Average SP Turnover:</strong> Rs. @FormatLakhs(GetThreeYearAverageTurnover()) Lakhs
                        </div>
                    }
                }
            </div>
        }

        <!-- ===================== SCHEME SPECIFIC ===================== -->
        <div class="apd-section">
            <h3>Scheme Specific Details</h3>
            <div class="apd-fields-grid apd-fields-3">
                @foreach (var field in GetSchemeSpecificFields(d))
                {
                    <div class="apd-field"><label>@field.Label</label><div class="apd-field-value">@field.Value</div></div>
                }
            </div>
        </div>

        <!-- ===================== DOCUMENTS ===================== -->
        <div class="apd-section">
            <div class="apd-section-head">
                <h3>Uploaded Documents</h3>
                @if (IsMoStage)
                {
                    <button class="apd-btn-upload" @onclick="OpenUploadModal">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
                        Upload
                    </button>
                }
            </div>
            @if (d.Documents.Count == 0)
            {
                <p style="color:#94A3B8;">No documents were uploaded with this application.</p>
            }
            else
            {
                <div class="apd-doc-list">
                    @foreach (var doc in d.Documents)
                    {
                        <div class="apd-doc-item">
                            <div class="apd-doc-icon"><img src="_content/SPIC.MauiBlazorApp.Shared/Images/Gallery/PdfIcon.png" /></div>
                            <div class="apd-doc-info">
                                <div class="apd-doc-name">@(string.IsNullOrWhiteSpace(doc.DocumentName) ? doc.FileName : doc.DocumentName)</div>
                                <div class="apd-doc-status">@(doc.IsVerified ? "Verified" : "Uploaded " + FormatDate(doc.UploadedAt))</div>
                            </div>
                            <div class="apd-doc-actions">
                                @if (IsMoStage)
                                {
                                    <button class="apd-btn-download" @onclick="() => ViewDocument(doc.Id)">View</button>
                                }
                                <button class="apd-btn-download" @onclick="() => OpenDocument(doc.Id, true)">Download</button>
                                @if (IsMoStage)
                                {
                                    <button class="apd-btn-delete" @onclick="() => ConfirmDeleteDocument(doc)">Delete</button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- ===================== PREVIOUS REMARKS ===================== -->
        @{
            var previousRemarks = d.Approvals
                .Where(ap => !string.IsNullOrWhiteSpace(ap.Remarks)
                    || !string.IsNullOrWhiteSpace(ap.Recommendation)
                    || !string.IsNullOrWhiteSpace(ap.Comment))
                .ToList();
        }
        @if (previousRemarks.Count > 0)
        {
            <div class="apd-remarks-container">
                <h4 class="apd-box-title" style="color: #64748B;">Previous Remarks</h4>
                @foreach (var ap in previousRemarks)
                {
                    <div class="apd-remark-block">
                        <h5 style="color: #3B82F6;">@(StageLevelName(ap.ApprovalLevel)) Remarks</h5>
                        @if (!string.IsNullOrWhiteSpace(ap.Remarks))
                        {
                            <p>@ap.Remarks</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(ap.Recommendation))
                        {
                            <p style="margin-bottom:2px;"><strong>Recommendation:</strong> @ap.Recommendation</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(ap.Comment))
                        {
                            <p style="margin-top:2px;"><strong>Comment:</strong> @ap.Comment</p>
                        }
                        <small>
                            @(ap.ApprovalStatus == "Rejected" ? "Rejected" : "Approved")
                            by @(ap.ApprovedBy ?? "-")
                            @(ap.ApprovedAt.HasValue ? " on " + FormatDateTime(ap.ApprovedAt.Value) : "")
                        </small>
                    </div>
                }
            </div>
        }

        <!-- ===================== FINAL APPROVAL SUMMARY ===================== -->
        @if (d.Status == 5)
        {
            var avp = d.Approvals.FirstOrDefault(ap => ap.ApprovalStatus == "Approved" && ap.ApprovalLevel == "AVP");
            <div class="apd-summary-box apd-box-green">
                <h4 class="apd-box-title">Approval Details</h4>
                <div class="apd-summary-grid">
                    <div class="apd-summary-item"><label>Approved By</label><span>@(avp?.ApprovedBy ?? "AVP")</span></div>
                    <div class="apd-summary-item"><label>Approved On</label><span>@(avp?.ApprovedAt.HasValue == true ? FormatDateTime(avp.ApprovedAt.Value) : "-")</span></div>
                    <div class="apd-summary-item"><label>Final Remarks</label><span>@(avp?.Remarks ?? "-")</span></div>
                </div>
            </div>
        }

    </div>

    <div class="apd-footer">
        @if (CanProcessCurrentStage())
        {
            <button class="apd-btn-action apd-btn-reject" @onclick="HandleRejectClick">Reject</button>
            <button class="apd-btn-action apd-btn-validate" disabled="@_busy" @onclick="HandleApproveClick">Approve &amp; Forward</button>
        }
        else if (OnClose.HasDelegate)
        {
            <button class="apd-btn-outline" @onclick="CloseDrawer">Close</button>
        }
    </div>
}

<!-- ===================== APPROVE CONFIRM MODAL ===================== -->
@if (IsApproveModalOpen)
{
    <div class="rm-overlay" @onclick="CloseApproveModal">
        <div class="rm-container" @onclick:stopPropagation="true">
            <div class="rm-icon-wrapper" style="background-color:#DCFCE7; color:#16A34A;">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </div>
            <h2 class="rm-title">Approve Application?</h2>
            <p class="rm-subtitle">Are you sure you want to approve this welfare application and forward it to the next level (@NextStageName)?</p>
            <div class="rm-form">
                @if (IsMoStage)
                {
                    <div class="rm-form-group">
                        <label class="rm-label">Comments *</label>
                        <select class="rm-select" @bind="_approveComment">
                            <option value="">--Select--</option>
                            <option value="Information verified and eligible for approval">Information verified and eligible for approval</option>
                            <option value="Documents incomplete or not valid">Documents incomplete or not valid</option>
                            <option value="Information mismatch found">Information mismatch found</option>
                            <option value="Eligibility criteria not met at verification stage">Eligibility criteria not met at verification stage</option>
                        </select>
                    </div>
                    <div class="rm-form-group">
                        <label class="rm-label">Recommendation *</label>
                        <select class="rm-select" @bind="_approveRecommendation">
                            <option value="">--Select--</option>
                            <option value="Verified">Verified</option>
                            <option value="Rejected">Rejected</option>
                        </select>
                    </div>
                }
                else
                {
                    <div class="rm-form-group">
                        <label class="rm-label">Approval Remarks (Optional)</label>
                        <textarea class="rm-textarea" placeholder="Add your approval remarks..." @bind="_approveRemarks"></textarea>
                    </div>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(_actionError))
            {
                <p class="rm-warning" style="margin-top:8px;">@_actionError</p>
            }
            <div class="rm-actions">
                <button class="rm-btn rm-btn-cancel" disabled="@_busy" @onclick="CloseApproveModal">Cancel</button>
                <button class="rm-btn rm-btn-reject" style="background-color:#16A34A;" disabled="@_busy" @onclick="ConfirmApprove">
                    @(_busy ? "Processing…" : "Approve Application")
                </button>
            </div>
        </div>
    </div>
}

<!-- ===================== REJECT MODAL ===================== -->
@if (IsRejectModalOpen)
{
    <div class="rm-overlay" @onclick="CloseRejectModal">
        <div class="rm-container" @onclick:stopPropagation="true">
            <div class="rm-icon-wrapper">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
            </div>
            <h2 class="rm-title">Reject Application?</h2>
            <p class="rm-subtitle">Are you sure you want to reject this welfare application?</p>
            <p class="rm-warning">On rejection this application will be @RejectDestinationText.</p>
            <div class="rm-form">
                <div class="rm-form-group">
                    <label class="rm-label">Rejection Reason</label>
                    <select class="rm-select" @bind="_rejectReason">
                        <option value="">Select a reason</option>
                        <option value="Incomplete Application">Incomplete Application</option>
                        <option value="Invalid Documents">Invalid Documents</option>
                        <option value="Not Eligible">Not Eligible</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
                <div class="rm-form-group">
                    <label class="rm-label">Detailed Remarks *</label>
                    <textarea class="rm-textarea" placeholder="Add your detailed remarks..." @bind="_rejectRemarks"></textarea>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(_actionError))
            {
                <p class="rm-warning" style="margin-top:8px;">@_actionError</p>
            }
            <div class="rm-actions">
                <button class="rm-btn rm-btn-cancel" disabled="@_busy" @onclick="CloseRejectModal">Cancel</button>
                <button class="rm-btn rm-btn-reject" disabled="@_busy" @onclick="ConfirmReject">
                    @(_busy ? "Processing…" : "Reject Application")
                </button>
            </div>
        </div>
    </div>

    <!-- ================= MO: DELETE DOCUMENT CONFIRM ================= -->
    @if (_showDeleteModal && _docToDelete != null)
    {
        <div class="rm-overlay" @onclick="CloseDeleteModal">
            <div class="rm-container" @onclick:stopPropagation="true">
                <div class="rm-icon-wrapper">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                    </svg>
                </div>
                <h2 class="rm-title">Delete Document?</h2>
                <p class="rm-subtitle">Are you sure you want to delete this document? This action cannot be undone.</p>
                <p class="rm-warning" style="word-break:break-word;">@(string.IsNullOrWhiteSpace(_docToDelete.DocumentName) ? _docToDelete.FileName : _docToDelete.DocumentName)</p>
                @if (!string.IsNullOrWhiteSpace(_docActionError))
                {
                    <p class="rm-warning" style="margin-top:8px;">@_docActionError</p>
                }
                <div class="rm-actions">
                    <button class="rm-btn rm-btn-cancel" disabled="@_busy" @onclick="CloseDeleteModal">Cancel</button>
                    <button class="rm-btn rm-btn-reject" disabled="@_busy" @onclick="ExecuteDeleteDocument">
                        @(_busy ? "Deleting…" : "Delete Document")
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- ================= MO: UPLOAD DOCUMENT ================= -->
    @if (_showUploadModal)
    {
        <div class="rm-overlay" @onclick="CloseUploadModal">
            <div class="rm-container" @onclick:stopPropagation="true">
                <div class="rm-icon-wrapper">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5" />
                    </svg>
                </div>
                <h2 class="rm-title">Upload Document</h2>
                <p class="rm-subtitle">Add the corrected/replacement document for this application.</p>
                <div class="rm-form">
                    <div class="rm-form-group">
                        <label class="rm-label">Document Type *</label>
                        <select class="rm-select" @bind="_uploadDocType">
                            <option value="">-- Select Type --</option>
                            @foreach (var t in _appDocTypes)
                            {
                                <option value="@t">@t</option>
                            }
                        </select>
                    </div>
                    <div class="rm-form-group">
                        <label class="rm-label">Select File *</label>
                        <InputFile OnChange="@OnUploadFileSelected" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx,.xls,.xlsx" class="rm-file-input" />
                        @if (_uploadFile != null)
                        {
                            <div class="apd-file-chosen">@_uploadFile.Name (@(_uploadFile.Size > 0 ? $"{(_uploadFile.Size / 1024.0):F1} KB" : "0 KB"))</div>
                        }
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(_docActionError))
                {
                    <p class="rm-warning" style="margin-top:8px;">@_docActionError</p>
                }
                @if (!string.IsNullOrWhiteSpace(_docActionMessage))
                {
                    <p style="margin-top:8px;color:#16a34a;">@_docActionMessage</p>
                }
                <div class="rm-actions">
                    <button class="rm-btn rm-btn-cancel" disabled="@_busy" @onclick="CloseUploadModal">Cancel</button>
                    <button class="rm-btn rm-btn-reject" disabled="@_busy || _uploadFile == null" @onclick="ConfirmUploadDocument">
                        @(_busy ? "Uploading…" : "Upload Document")
                    </button>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter] public int ApplicationId { get; set; }
    [Parameter] public EventCallback OnActionCompleted { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    [Inject] private HttpClient Http { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;
    [Inject] private SPIC.MauiBlazorApp.Shared.Services.LoginState LoginState { get; set; } = default!;

    private SPIC.Core.DTOs.WelfareApplicationDetailDto? _detail;
    private bool _loading;
    private string? _error;
    private int _loadedForId;

    private bool _dealerSalesLoading;
    private string? _dealerSalesError;
    private List<SPIC.Core.DTOs.DealerSalesYearOptionDto> _dealerAvailableYears = new();
    private List<SPIC.Core.DTOs.DealerSalesProductDto> _dealerProductSales = new();
    private int?[] _selectedSalesYears = new int?[3];
    private int _dealerSalesLoadedForId;

    private bool IsApproveModalOpen { get; set; }
    private bool IsRejectModalOpen { get; set; }

    private string? _approveRemarks;
    private string _approveRecommendation = "";
    private string? _approveComment;
    private string? _rejectReason;
    private string? _rejectRemarks;
    private string? _actionError;
    private bool _busy;

    private bool _showDeleteModal;
    private SPIC.Core.DTOs.WelfareApplicationDocumentDto? _docToDelete;
    private bool _showUploadModal;
    private string _uploadDocType = "";
    private Microsoft.AspNetCore.Components.Forms.IBrowserFile? _uploadFile;
    private List<string> _appDocTypes = new();
    private string? _docActionError;
    private string? _docActionMessage;

    private bool IsMoStage => LoginState.UserRole == AppRole.MO;

    private async Task CloseDrawer()
    {
        if (OnClose.HasDelegate)
            await OnClose.InvokeAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (ApplicationId > 0 && _loadedForId != ApplicationId)
        {
            await LoadDetail(ApplicationId);
        }
    }

    private async Task LoadDetail(int id)
    {
        _loading = true;
        _error = null;
        _detail = null;
        ResetActionState();
        try
        {
            _detail = await Http.GetFromJsonAsync<SPIC.Core.DTOs.WelfareApplicationDetailDto>(
                $"api/WelfareSchemeApproval/applications/{id}");
            _loadedForId = id;
            await LoadDealerSalesIfNeeded();
        }
        catch
        {
            _error = "Unable to load application details. Please try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    private enum SalesKind { Urea, DAP, Npk2020, SSP }

    private async Task LoadDealerSalesIfNeeded()
    {
        if (!IsMoStage || _detail == null || _detail.DealerId <= 0) return;
        if (_dealerSalesLoadedForId == _detail.DealerId) return;

        _dealerSalesLoading = true;
        _dealerSalesError = null;
        try
        {
            var summary = await Http.GetFromJsonAsync<SPIC.Core.DTOs.DealerSalesSummaryDto>(
                $"api/CreditLimitSales/dealer-sales-summary/{_detail.DealerId}");
            _dealerAvailableYears = summary?.AvailableYears ?? new();
            _dealerProductSales = summary?.ProductSales ?? new();
            _selectedSalesYears = new int?[3];
            _dealerSalesLoadedForId = _detail.DealerId;
        }
        catch
        {
            _dealerSalesError = "Unable to load dealer sales data.";
        }
        finally
        {
            _dealerSalesLoading = false;
        }
    }

    private void OnSalesYearChanged(int index, ChangeEventArgs e)
    {
        if (index < 0 || index >= _selectedSalesYears.Length) return;
        int? value = int.TryParse(e.Value?.ToString(), out var v) && v > 0 ? v : null;
        _selectedSalesYears[index] = value;
    }

    private bool IsProductMatch(SalesKind kind, string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return false;
        return kind switch
        {
            SalesKind.Urea => name.Trim().Equals("Urea", StringComparison.OrdinalIgnoreCase),
            SalesKind.DAP => name.Contains("DAP", StringComparison.OrdinalIgnoreCase),
            SalesKind.Npk2020 => name.Contains("20:20", StringComparison.OrdinalIgnoreCase) || name.Contains("NPK", StringComparison.OrdinalIgnoreCase),
            SalesKind.SSP => name.Contains("SSP", StringComparison.OrdinalIgnoreCase),
            _ => false
        };
    }

    private IEnumerable<SPIC.Core.DTOs.DealerSalesProductDto> GetYearProducts(int? fyId)
    {
        if (!fyId.HasValue) return Enumerable.Empty<SPIC.Core.DTOs.DealerSalesProductDto>();
        return _dealerProductSales.Where(p => p.FinancialYearId == fyId.Value);
    }

    private decimal GetYearQty(int? fyId, SalesKind kind)
    {
        if (!fyId.HasValue) return 0;
        return GetYearProducts(fyId)
            .Where(p => IsProductMatch(kind, p.ProductName))
            .Sum(p => p.Quantity);
    }

    private decimal GetYearTotal(int? fyId) => GetYearQty(fyId, SalesKind.Urea)
        + GetYearQty(fyId, SalesKind.DAP)
        + GetYearQty(fyId, SalesKind.Npk2020)
        + GetYearQty(fyId, SalesKind.SSP);

    private decimal GetYearTurnover(int? fyId)
    {
        if (!fyId.HasValue) return 0;
        return GetYearProducts(fyId).Sum(p => p.GrossAmount) / 100000m;
    }

    private decimal GetThreeYearAverageTotal()
    {
        var totals = _selectedSalesYears.Where(y => y.HasValue).Select(y => GetYearTotal(y)).ToList();
        return totals.Count == 0 ? 0 : totals.Sum() / totals.Count;
    }

    private decimal GetThreeYearAverageTurnover()
    {
        var turnovers = _selectedSalesYears.Where(y => y.HasValue).Select(y => GetYearTurnover(y)).ToList();
        return turnovers.Count == 0 ? 0 : turnovers.Sum() / turnovers.Count;
    }

    private static string FormatQty(decimal value) => value == 0 ? "-" : value.ToString("0.##");

    private static string FormatLakhs(decimal value) => value == 0 ? "-" : value.ToString("0.##");

    private static readonly Dictionary<AppRole, int[]> StageMap = new()
    {
        [AppRole.MO] = new[] { 1, 2 },
        [AppRole.RM] = new[] { 3 },
        [AppRole.SMM] = new[] { 4 },
        [AppRole.AVP] = new[] { 8 }
    };

    private bool CanProcessCurrentStage() =>
        LoginState.UserRole != null &&
        StageMap.TryGetValue(LoginState.UserRole.Value, out var statuses) &&
        _detail != null &&
        statuses.Contains(_detail.Status);

    private string NextStageName => LoginState.UserRole switch
    {
        AppRole.MO => "RM",
        AppRole.RM => "SM",
        AppRole.SMM => "AVP",
        _ => "completion"
    };

    private string RejectDestinationText => LoginState.UserRole switch
    {
        AppRole.MO => "returned to the Dealer for correction and resubmission (the application will NOT be closed)",
        AppRole.RM => "returned to the MO for review",
        AppRole.SMM => "returned to the RM for review",
        AppRole.AVP => "returned to the SM for review",
        _ => "returned to the previous stage for review"
    };

    private static string GetPendingStageName(int status) => status switch
    {
        1 or 2 => "MO",
        3 => "RM",
        4 => "SM",
        8 => "AVP",
        _ => "-"
    };

    private static string StageLevelName(string level) => level switch
    {
        "MO" => "Marketing Officer (MO)",
        "RM" => "Regional Manager (RM)",
        "SM" => "Senior Manager (SM)",
        "AVP" => "AVP",
        _ => level
    };

    private sealed record DrawerStep(string Code, string Name, string State, string? By, DateTime? At);

    private List<DrawerStep> BuildSteps()
    {
        var steps = new List<DrawerStep>();
        if (_detail == null) return steps;

        var stages = new (string Code, string Name)[]
        {
            ("MO", "MO"), ("RM", "RM"), ("SM", "SM"), ("AVP", "AVP")
        };

        var status = _detail.Status;
        int currentIndex = status switch
        {
            1 or 2 => 0,
            3 => 1,
            4 => 2,
            8 => 3,
            5 => 4,
            _ => -1
        };

        for (int i = 0; i < stages.Length; i++)
        {
            var (code, name) = stages[i];
            var approval = _detail.Approvals.FirstOrDefault(ap =>
                string.Equals(ap.ApprovalLevel, code, StringComparison.OrdinalIgnoreCase));

            string state;
            if (approval != null && approval.ApprovalStatus == "Approved")
                state = "done";
            else if (approval != null && approval.ApprovalStatus == "Rejected")
                state = "rejected";
            else if (status == 6)
                state = currentIndex >= 0 && i <= currentIndex ? "pending" : "stopped";
            else if (currentIndex >= 0 && i < currentIndex)
                state = "done";
            else if (currentIndex >= 0 && i == currentIndex)
                state = "active";
            else
                state = "pending";

            steps.Add(new DrawerStep(code, name, state, approval?.ApprovedBy, approval?.ApprovedAt));
        }

        return steps;
    }

    private WelfareApprovalStepDto? GetRejectionStep() =>
        _detail?.Approvals.FirstOrDefault(ap => ap.ApprovalStatus == "Rejected");

    private WelfareApprovalStepDto? GetLatestRejectionStep() =>
        _detail?.Approvals
            .Where(ap => ap.ApprovalStatus == "Rejected")
            .OrderByDescending(ap => ap.ApprovedAt)
            .FirstOrDefault();

    private static string GetStepCircleClass(string state) => state switch
    {
        "done" => "apd-step-circle apd-step-success",
        "rejected" => "apd-step-circle apd-step-cyan",
        "active" => "apd-step-circle apd-step-active",
        _ => "apd-step-circle apd-step-pending"
    };

    private static string GetStepStatusClass(string state) => state switch
    {
        "done" => "apd-step-status apd-status-success",
        "rejected" => "apd-step-status apd-status-danger",
        "active" => "apd-step-status apd-status-review",
        _ => "apd-step-status"
    };

    private static string GetStatusBadgeClass(int status) => status switch
    {
        5 => "apd-badge apd-badge-green",
        6 => "apd-badge apd-badge-red",
        _ => "apd-badge apd-badge-purple"
    };

    private sealed record FieldData(string Label, string Value);

    private static List<FieldData> GetSchemeSpecificFields(SPIC.Core.DTOs.WelfareApplicationDetailDto d)
    {
        var fields = new List<FieldData>();
        switch (d.SchemeType)
        {
            case 0:
                fields.Add(new FieldData("Treatment Type", d.MedicalTreatmentType ?? "-"));
                break;
            case 1:
                fields.Add(new FieldData("Marriage Date", FormatDateNullable(d.MarriageDate)));
                break;
            case 2:
                fields.Add(new FieldData("Event Date", FormatDateNullable(d.EventDate)));
                fields.Add(new FieldData("Ownership Type", d.OwnershipType ?? "-"));
                fields.Add(new FieldData("Event Venue", d.EventVenue ?? "-"));
                break;
            case 3:
                fields.Add(new FieldData("Course", d.Course ?? "-"));
                fields.Add(new FieldData("Year of Study", d.EduYear?.ToString() ?? "-"));
                fields.Add(new FieldData("College Name", d.CollegeName ?? "-"));
                fields.Add(new FieldData("Total Duration (Years)", d.TotalNumberOfCourses?.ToString() ?? "-"));
                fields.Add(new FieldData("First Application", d.IsFirstApplication == null ? "-" : (d.IsFirstApplication.Value ? "Yes" : "No")));
                break;
            case 4:
                fields.Add(new FieldData("Event Date", FormatDateNullable(d.EventDate)));
                fields.Add(new FieldData("Ownership Type", d.OwnershipType ?? "-"));
                fields.Add(new FieldData("Event Venue", d.EventVenue ?? "-"));
                break;
            case 5:
                fields.Add(new FieldData("Date of Death", FormatDateNullable(d.DateOfDeath)));
                fields.Add(new FieldData("Legal Heir Name", d.LegalHeirName ?? "-"));
                fields.Add(new FieldData("Cause of Death", d.DeathCause ?? "-"));
                break;
            case 6:
                fields.Add(new FieldData("Candidate Name", d.MeritCandidateName ?? "-"));
                fields.Add(new FieldData("Father's Name", d.MeritFatherName ?? "-"));
                fields.Add(new FieldData("Examination Appeared", d.ExaminationAppeared ?? "-"));
                fields.Add(new FieldData("Board", d.BoardName ?? "-"));
                fields.Add(new FieldData("Maximum Marks", d.MaximumMarks?.ToString() ?? "-"));
                fields.Add(new FieldData("Marks Obtained", d.MarksObtained?.ToString() ?? "-"));
                fields.Add(new FieldData("Percentage", d.MeritPercentage?.ToString("0.##") ?? "-"));
                break;
            case 7:
                fields.Add(new FieldData("Candidate Name", d.DistinctionCandidateName ?? "-"));
                fields.Add(new FieldData("Father's Name", d.DistinctionFatherName ?? "-"));
                fields.Add(new FieldData("Professional Course", d.ProfessionalCourseName ?? "-"));
                fields.Add(new FieldData("Course Completion Year", d.CourseCompletionYear?.ToString() ?? "-"));
                fields.Add(new FieldData("University", d.UniversityName ?? "-"));
                fields.Add(new FieldData("Maximum Marks", d.DistinctionMaximumMarks?.ToString() ?? "-"));
                fields.Add(new FieldData("Marks Obtained", d.DistinctionMarksObtained?.ToString() ?? "-"));
                fields.Add(new FieldData("Aggregate Percentage", d.DistinctionAggregatePercentage?.ToString("0.##") ?? "-"));
                fields.Add(new FieldData("Arrears", d.HasArrears == null ? "-" : (d.HasArrears.Value ? "Yes" : "No")));
                fields.Add(new FieldData("Wholesale Dealer Employee", d.IsWholesaleDealerEmployee == null ? "-" : (d.IsWholesaleDealerEmployee.Value ? "Yes" : "No")));
                break;
        }
        return fields;
    }

    private void HandleApproveClick()
    {
        _actionError = null;
        _approveRemarks = null;
        _approveRecommendation = "";
        _approveComment = null;
        IsApproveModalOpen = true;
    }

    private void HandleRejectClick()
    {
        _actionError = null;
        _rejectReason = "";
        _rejectRemarks = null;
        IsRejectModalOpen = true;
    }

    private void CloseApproveModal() { if (!_busy) IsApproveModalOpen = false; }
    private void CloseRejectModal() { if (!_busy) IsRejectModalOpen = false; }

    private async Task ConfirmApprove()
    {
        if (_detail == null || _busy) return;

        if (IsMoStage && string.IsNullOrWhiteSpace(_approveComment))
        {
            _actionError = "Please select a comment before approving.";
            return;
        }

        if (IsMoStage && !IsValidMoComment(_approveComment))
        {
            _actionError = "Please select a valid comment.";
            return;
        }

        if (IsMoStage && string.IsNullOrWhiteSpace(_approveRecommendation))
        {
            _actionError = "Please select a recommendation before approving.";
            return;
        }

        _busy = true;
        _actionError = null;
        try
        {
            var response = await Http.PostAsJsonAsync(
                $"api/WelfareSchemeApproval/applications/{_detail.Id}/approve",
                new WelfareApprovalActionRequest
                {
                    Remarks = _approveRemarks,
                    Recommendation = IsMoStage ? _approveRecommendation : null,
                    Comment = IsMoStage ? _approveComment : null
                });

            if (response.IsSuccessStatusCode)
            {
                IsApproveModalOpen = false;
                await OnActionCompleted.InvokeAsync();
            }
            else
            {
                _actionError = await ReadErrorMessageAsync(response);
            }
        }
        catch
        {
            _actionError = "Unable to reach the server. Please try again.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ConfirmReject()
    {
        if (_detail == null || _busy) return;

        if (string.IsNullOrWhiteSpace(_rejectRemarks))
        {
            _actionError = "Remarks are mandatory when rejecting an application.";
            return;
        }

        _busy = true;
        _actionError = null;
        try
        {
            var response = await Http.PostAsJsonAsync(
                $"api/WelfareSchemeApproval/applications/{_detail.Id}/reject",
                new WelfareApprovalActionRequest { Reason = _rejectReason, Remarks = _rejectRemarks });

            if (response.IsSuccessStatusCode)
            {
                IsRejectModalOpen = false;
                await OnActionCompleted.InvokeAsync();
            }
            else
            {
                _actionError = await ReadErrorMessageAsync(response);
            }
        }
        catch
        {
            _actionError = "Unable to reach the server. Please try again.";
        }
        finally
        {
            _busy = false;
        }
    }

    private static readonly string[] MoCommentOptions =
    {
        "Information verified and eligible for approval",
        "Documents incomplete or not valid",
        "Information mismatch found",
        "Eligibility criteria not met at verification stage"
    };

    private static bool IsValidMoComment(string? value) =>
        !string.IsNullOrWhiteSpace(value) &&
        MoCommentOptions.Contains(value, StringComparer.Ordinal);

    private static async Task<string> ReadErrorMessageAsync(HttpResponseMessage response)
    {
        try
        {
            var body = await response.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
            if (body.TryGetProperty("Message", out var msg))
                return msg.GetString() ?? "Action failed. Please try again.";
        }
        catch { }
        return response.StatusCode == System.Net.HttpStatusCode.Conflict
            ? "This application is no longer pending at your approval stage."
            : "Action failed. Please try again.";
    }

    private void ResetActionState()
    {
        IsApproveModalOpen = false;
        IsRejectModalOpen = false;
        _approveRemarks = null;
        _approveRecommendation = "";
        _approveComment = null;
        _rejectReason = null;
        _rejectRemarks = null;
        _actionError = null;
        _busy = false;
    }

    private async Task OpenDocument(int documentId, bool download)
    {
        var baseUrl = Http.BaseAddress?.ToString().TrimEnd('/') ?? "";
        var token = GetRawToken();
        var url = $"{baseUrl}/api/WelfareSchemeApproval/document/{documentId}";
        if (download) url += "?disposition=attachment";
        if (!string.IsNullOrWhiteSpace(token))
            url += (url.Contains('?') ? "&" : "?") + "access_token=" + Uri.EscapeDataString(token);
        await JS.InvokeVoidAsync("open", url, "_blank");
    }

    private Task ViewDocument(int documentId) => OpenDocument(documentId, false);

    private void ConfirmDeleteDocument(SPIC.Core.DTOs.WelfareApplicationDocumentDto doc)
    {
        _docToDelete = doc;
        _docActionError = null;
        _docActionMessage = null;
        _showDeleteModal = true;
    }

    private void CloseDeleteModal()
    {
        _showDeleteModal = false;
        _docToDelete = null;
        _docActionError = null;
    }

    private async Task ExecuteDeleteDocument()
    {
        if (_docToDelete == null) return;
        _busy = true;
        _docActionError = null;
        try
        {
            var url = $"/api/WelfareSchemeApproval/document/{_docToDelete.Id}";
            var response = await Http.DeleteAsync(url);
            if (response.IsSuccessStatusCode)
            {
                _showDeleteModal = false;
                _docToDelete = null;
                await LoadDetail(_detail?.Id ?? ApplicationId);
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                var msg = ExtractErrorMessage(body) ?? "Failed to delete document.";
                _docActionError = msg;
            }
        }
        catch (Exception ex)
        {
            _docActionError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void OpenUploadModal()
    {
        _uploadDocType = "";
        _uploadFile = null;
        _docActionError = null;
        _docActionMessage = null;
        _appDocTypes = _detail?.Documents?
            .Where(x => !string.IsNullOrWhiteSpace(x.DocumentType))
            .Select(x => x.DocumentType!)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList() ?? new List<string>();
        _showUploadModal = true;
    }

    private void CloseUploadModal()
    {
        _showUploadModal = false;
        _uploadFile = null;
        _docActionError = null;
    }

    private void OnUploadFileSelected(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        _docActionError = null;
        _docActionMessage = null;
        var file = e.File;
        if (file != null)
        {
            _uploadFile = file;
        }
    }

    private async Task ConfirmUploadDocument()
    {
        if (_uploadFile == null || string.IsNullOrWhiteSpace(_uploadDocType)) return;
        _busy = true;
        _docActionError = null;
        _docActionMessage = null;
        try
        {
            using var content = new MultipartFormDataContent();
            using (var stream = _uploadFile.OpenReadStream(maxAllowedSize: 25 * 1024 * 1024))
            {
                var buffer = new byte[stream.Length];
                await stream.ReadAsync(buffer, 0, (int)stream.Length);
                var fileContent = new ByteArrayContent(buffer);
                fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(
                    _uploadFile.ContentType ?? "application/octet-stream");
                content.Add(fileContent, "files", _uploadFile.Name);
                content.Add(new StringContent(_uploadDocType), "documentTypes");
            }

            var url = $"/api/WelfareSchemeApproval/applications/{_detail?.Id ?? ApplicationId}/documents";
            var response = await Http.PostAsync(url, content);
            if (response.IsSuccessStatusCode)
            {
                _showUploadModal = false;
                _uploadFile = null;
                await LoadDetail(_detail?.Id ?? ApplicationId);
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                var msg = ExtractErrorMessage(body) ?? "Failed to upload document.";
                _docActionError = msg;
            }
        }
        catch (Exception ex)
        {
            _docActionError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private static string? ExtractErrorMessage(string body)
    {
        try
        {
            var json = System.Text.Json.JsonDocument.Parse(body);
            if (json.RootElement.TryGetProperty("message", out var m) && m.ValueKind == System.Text.Json.JsonValueKind.String)
                return m.GetString();
        }
        catch
        {
        }
        return null;
    }

    private string? GetRawToken()
    {
        try
        {
            var token = LoginState.Token;
            if (string.IsNullOrWhiteSpace(token)) return null;
            return token.StartsWith("Bearer ", StringComparison.OrdinalIgnoreCase)
                ? token["Bearer ".Length..]
                : token;
        }
        catch
        {
            return null;
        }
    }

    private static string FormatDate(DateTime date) => date.ToString("dd MMM yyyy");

    private static string FormatDateNullable(DateTime? date) => date.HasValue ? date.Value.ToString("dd MMM yyyy") : "-";

    private static string FormatDateTime(DateTime dateTime) => dateTime.ToString("dd MMM yyyy, hh:mm tt");
