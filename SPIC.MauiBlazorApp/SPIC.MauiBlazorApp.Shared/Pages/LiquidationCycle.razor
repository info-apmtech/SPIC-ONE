    private static string ReadLookupName(JsonElement item)
    {
        string[] properties =
        {
            "name",
            "stateName",
            "regionName",
            "headquarterName",
            "districtName",
            "subDistrictName",
            "productName"
        };

        foreach (var property in properties)
        {
            if (item.TryGetProperty(property, out var value) &&
                value.ValueKind == JsonValueKind.String)
            {
                return value.GetString() ?? "";
            }
        }

        return "";
    }

    // ---- Dashboard ----
    private void SyncSelections()
    {
        ApplyMandatoryRoleScopeToSelections();

        _filter.StateIds = _selStates.ToList();
        _filter.RegionIds = _selRegions.ToList();
        _filter.HeadQuarterIds = _selHqs.ToList();
        _filter.DistrictIds = _selDistricts.ToList();
        _filter.SubDistrictIds = _selSubDistricts.ToList();

        _filter.ProductKeys = _selProductKeys.ToList();
        _filter.ProductIds = _selProductKeys
            .Select(key => key?.Trim())
            .Where(key => !string.IsNullOrWhiteSpace(key) && key.StartsWith("P:", StringComparison.OrdinalIgnoreCase))
            .Select(key => int.TryParse(key!.Substring(2), out var id) ? id : 0)
            .Where(id => id > 0)
            .Distinct()
            .ToList();

        _filter.DealerKeys = _selDealerKeys.ToList();
        _filter.DateFrom = _dateFrom;
        _filter.DateTo = _dateTo;
    }

    private async Task LoadDashboard(bool renderLoadingState = true)
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();

        var cts = new CancellationTokenSource(TimeSpan.FromSeconds(30));
        _loadCts = cts;
        var token = cts.Token;

        _isLoading = true;
        _loadError = null;
        SyncSelections();

        if (renderLoadingState && !_disposed)
            await InvokeAsync(StateHasChanged);

        try
        {
            var response = await Http.PostAsJsonAsync(
                "api/LiquidationCycle/dashboard",
                _filter,
                token);

            if (response.IsSuccessStatusCode)
            {
                var nextDashboard = await response.Content
                    .ReadFromJsonAsync<LiqCycleDashboardDto>(cancellationToken: token);

                if (nextDashboard is not null)
                    _dashboard = nextDashboard;
                else
                    _loadError = "The server returned an empty dashboard response.";
            }
            else
            {
                _loadError =
                    $"Server returned {(int)response.StatusCode} {response.ReasonPhrase}.";
            }
        }
        catch (OperationCanceledException)
        {
            // A newer request owns the screen when this request was superseded.
            if (!ReferenceEquals(_loadCts, cts))
                return;

            _loadError = "Request timed out — the server took too long to respond.";
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
        finally
        {
            if (ReferenceEquals(_loadCts, cts))
            {
                _isLoading = false;

                if (!_disposed)
                    await InvokeAsync(StateHasChanged);
            }
        }
    }

