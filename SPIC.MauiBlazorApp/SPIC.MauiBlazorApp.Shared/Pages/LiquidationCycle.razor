                            <div class="lc-tt-divider"><span>Critical (>7 Days)</span><span class="lc-tt-bold">50</span></div>
                            <div class="lc-tt-final"><span>Fast Rate</span><span class="lc-tt-bolder">72.3%</span></div>
                        </div>
                    </div>
                    <!-- Row 4 -->
