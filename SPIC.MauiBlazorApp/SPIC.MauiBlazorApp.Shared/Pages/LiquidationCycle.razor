@page "/LiquidationCycle"

<div class="container-fluid py-4 px-0">
        
    <!-- Header Section -->
    <div class="lc-header-container">
        <div class="lc-header-text">
            <h1>Liquidation Cycle</h1>
            <p>View and monitor company sales transactions from iFMS</p>
        </div>
        
        <div class="lc-action-buttons">
            <button class="lc-btn lc-btn-outline">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2v6h-6"></path><path d="M3 12a9 9 0 1 0 2.13-5.88L2 9"></path></svg>
                Refresh Data
            </button>
            <button class="lc-btn lc-btn-outline">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><path d="M8 13h2"></path><path d="M8 17h2"></path><path d="M14 13h2"></path><path d="M14 17h2"></path></svg>
                Excel
            </button>
            <button class="lc-btn lc-btn-outline">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><path d="M9 15v-4"></path><path d="M12 15v-4c1 0 2 1 2 2s-1 2-2 2"></path><path d="M16 11v4"></path><path d="M16 13h2"></path></svg>
                PDF
            </button>
            <button class="lc-btn lc-btn-solid">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
                Send Mail
            </button>
        </div>
    </div>

    <!-- 5-Column Statistics Grid -->
    <div class="lc-stats-grid">
        
        <!-- Total Stock -->
        <div class="lc-stat-card lc-theme-green">
            <div class="lc-card-top">
                <div class="lc-stat-info">
                    <span class="lc-stat-title">Total Stock</span>
                    <span class="lc-stat-value">4,820</span>
                </div>
                <div class="lc-icon-box">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
                </div>
            </div>
            <div class="lc-stat-trend lc-text-green">
                <svg class="lc-trend-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg>
                <span>12% vs last period</span>
            </div>
        </div>

        <!-- Under Review -->
        <div class="lc-stat-card lc-theme-blue">
            <div class="lc-card-top">
                <div class="lc-stat-info">
                    <span class="lc-stat-title">Under Review (MT)</span>
                    <span class="lc-stat-value">4,820</span>
                </div>
                <div class="lc-icon-box">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><circle cx="10" cy="13" r="2"></circle><line x1="11.4" y1="14.4" x2="13.4" y2="16.4"></line></svg>
                </div>
            </div>
            <div class="lc-stat-trend lc-text-green">
                <svg class="lc-trend-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg>
                <span>3.5% vs last period</span>
            </div>
        </div>

        <!-- In Progress -->
        <div class="lc-stat-card lc-theme-orange">
            <div class="lc-card-top">
                <div class="lc-stat-info">
                    <span class="lc-stat-title">In Progress (MT)</span>
                    <span class="lc-stat-value">2,820</span>
                </div>
                <div class="lc-icon-box">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle><circle cx="12" cy="12" r="2"></circle></svg>
                </div>
            </div>
            <div class="lc-stat-trend lc-text-green">
                <svg class="lc-trend-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg>
                <span>1.2% vs last period</span>
            </div>
        </div>

        <!-- Liquidated -->
        <div class="lc-stat-card lc-theme-teal">
            <div class="lc-card-top">
                <div class="lc-stat-info">
                    <span class="lc-stat-title">Liquidated (MT)</span>
                    <span class="lc-stat-value">3,120</span>
                </div>
                <div class="lc-icon-box">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect><path d="M9 14l2 2 4-4"></path></svg>
                </div>
            </div>
            <div class="lc-stat-trend lc-text-green">
                <svg class="lc-trend-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg>
                <span>7.2% vs last period</span>
            </div>
        </div>

        <!-- Pending Ack -->
        <div class="lc-stat-card lc-theme-red">
            <div class="lc-card-top">
                <div class="lc-stat-info">
                    <span class="lc-stat-title">Pending Ack</span>
                    <span class="lc-stat-value">1,020</span>
                </div>
                <div class="lc-icon-box">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><path d="M12 22V12"></path><circle cx="12" cy="12" r="3" fill="#dc2626"></circle></svg>
                </div>
            </div>
            <div class="lc-stat-trend lc-text-red">
                <svg class="lc-trend-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 17 13.5 8.5 8.5 13.5 2 7"></polyline><polyline points="16 17 22 17 22 11"></polyline></svg>
                <span>6.10% vs last period</span>
            </div>
        </div>

    </div>

    <!-- Filters Section (5 Columns matching design) -->
    <div class="lc-filter-card">
        <div class="lc-filter-header">
            <div class="lc-filter-title">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="6" x2="20" y2="6"></line><line x1="6" y1="12" x2="18" y2="12"></line><line x1="8" y1="18" x2="16" y2="18"></line></svg>
                Filters
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </div>
        
        <div class="lc-filter-body">
            <div class="lc-filter-grid">
                <div class="lc-form-group"><label class="lc-form-label">State</label><select class="lc-form-select"><option>All</option></select></div>
                <div class="lc-form-group"><label class="lc-form-label">Region</label><select class="lc-form-select"><option>All</option></select></div>
                <div class="lc-form-group"><label class="lc-form-label">HQ</label><select class="lc-form-select"><option>All</option></select></div>
                <div class="lc-form-group"><label class="lc-form-label">District</label><select class="lc-form-select"><option>All</option></select></div>
                <div class="lc-form-group"><label class="lc-form-label">Sub District</label><select class="lc-form-select"><option>All</option></select></div>
                
                <div class="lc-form-group"><label class="lc-form-label">Dealer Name</label><select class="lc-form-select"><option>All</option></select></div>
                <div class="lc-form-group"><label class="lc-form-label">Product</label><select class="lc-form-select"><option>All</option></select></div>
                <div class="lc-form-group"><label class="lc-form-label">Liquidation Status</label><select class="lc-form-select"><option>All</option></select></div>
                <div class="lc-form-group"><label class="lc-form-label">Status</label><select class="lc-form-select"><option>All</option></select></div>
            </div>
            
            <div class="lc-filter-actions">
                <button class="lc-btn lc-btn-outline"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg> Clear All</button>
                <button class="lc-btn lc-btn-solid"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="6" x2="20" y2="6"></line><line x1="6" y1="12" x2="18" y2="12"></line><line x1="8" y1="18" x2="16" y2="18"></line></svg> Apply Filters</button>
            </div>
        </div>
    </div>

    <!-- Table Section -->
    <div class="lc-table-card">
        <div class="lc-table-top">
            <h3>Liquidation Cycle List</h3>
            <input type="text" class="lc-search-input" placeholder="Search zones...">
        </div>

        <div class="lc-table-wrapper">
            <table class="lc-main-table">
                <thead>
                    <tr>
                        <th><input type="checkbox" class="lc-checkbox"></th>
                        <th style="text-align: left;">Dealer Name</th>
                        <th>Product</th>
                        <th>Stock</th>
                        <th>Ageing in Days</th>
                        <th>Sales</th>
                        <th>Liquidation Status</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><input type="checkbox" class="lc-checkbox"></td>
                        <td style="text-align: left; color: #475569;">Sri Murugan Traders</td>
                        <td>DAP 50 KG</td>
                        <td>120.500</td>
                        <td class="lc-txt-red">28</td>
                        <td>70.600</td>
                        <td><span class="lc-outline-badge lc-outline-blue">Under Review</span></td>
                        <td><div class="lc-status lc-st-red"><div class="dot"></div>Critical</div></td>
                        <td><button class="lc-action-btn" @onclick="OpenLiquidationDetails"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path><circle cx="12" cy="12" r="3"></circle></svg></button></td>
                    </tr>
                    <tr>
                        <td><input type="checkbox" class="lc-checkbox"></td>
                        <td style="text-align: left; color: #475569;">Sri Murugan Traders</td>
                        <td>MOP 50 Kg</td>
                        <td>80.250</td>
                        <td class="lc-txt-orange">42</td>
                        <td>62.100</td>
                        <td><span class="lc-outline-badge lc-outline-pink">In Progress</span></td>
                        <td><div class="lc-status lc-st-orange"><div class="dot"></div>Monitoring</div></td>
                        <td><button class="lc-action-btn" @onclick="OpenLiquidationDetails"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path><circle cx="12" cy="12" r="3"></circle></svg></button></td>
                    </tr>
                    <tr>
                        <td><input type="checkbox" class="lc-checkbox"></td>
                        <td style="text-align: left; color: #475569;">Sri Murugan Traders</td>
                        <td>Mop 50 Kg</td>
                        <td>70.600</td>
                        <td class="lc-txt-green">78</td>
                        <td>18.600</td>
                        <td><span class="lc-outline-badge lc-outline-green">Liquidated</span></td>
                        <td><div class="lc-status lc-st-green"><div class="dot"></div>Active</div></td>
                        <td><button class="lc-action-btn" @onclick="OpenLiquidationDetails"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path><circle cx="12" cy="12" r="3"></circle></svg></button></td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="lc-pagination">
            <div class="lc-page-size">
                <span>Items Per Page</span>
                <select class="lc-form-select" style="padding: 6px 32px 6px 12px; width: 65px; margin:0; background-position: right 8px center;">
                    <option>16</option>
                </select>
            </div>
            <div class="lc-page-controls">
                <button class="lc-page-btn"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg></button>
                <button class="lc-page-btn active">1</button>
                <button class="lc-page-btn">2</button>
                <button class="lc-page-btn">3</button>
                <button class="lc-page-btn dots">..</button>
                <button class="lc-page-btn">8</button>
                <button class="lc-page-btn">9</button>
                <button class="lc-page-btn">10</button>
                <button class="lc-page-btn"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg></button>
            </div>
        </div>
    </div>
</div>
<LiquidationDetailsDrawer @bind-IsOpen="isLiquidationDetailsOpen" />
@code {
    private bool isLiquidationDetailsOpen = false;

    private void OpenLiquidationDetails()
    {
        isLiquidationDetailsOpen = true;
    }
}