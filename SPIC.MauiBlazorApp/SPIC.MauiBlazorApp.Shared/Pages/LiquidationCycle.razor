        days > 90
            ? "lc-txt-red"
            : days > 60
                ? "lc-txt-orange"
                : "lc-txt-green";

    private string StatusClass(string status) => status switch
    {
        "Critical" => "lc-st-red",
        "Monitoring" => "lc-st-orange",
        "Active" => "lc-st-green",
        _ => "lc-st-green"
    };

