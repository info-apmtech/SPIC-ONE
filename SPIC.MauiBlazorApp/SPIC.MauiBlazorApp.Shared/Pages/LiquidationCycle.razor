@page "/LiquidationCycle"
@implements IDisposable
@inject HttpClient Http
@inject SPIC.MauiBlazorApp.Shared.Services.LoginState LoginState
@inject IJSRuntime JS
@using System.Globalization
@using SPIC.Core.DTOs
@using System.Text.Json
@using System.Net.Http.Json



<div class="container-fluid py-4 px-0">
    
    <!-- Header Section -->
    <div class="lc-header-container">
        <div class="lc-header-text">
            <h1>Liquidation Cycle</h1>
            <p>View and monitor sales transactions and ageing stock</p>
        </div>
        
        <div class="lc-action-buttons">
            <button class="lc-btn lc-btn-outline" disabled="@(_isLoading)" @onclick="RefreshData"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2v6h-6"></path><path d="M3 12a9 9 0 1 0 2.13-5.88L2 9"></path></svg> Refresh Data</button>
            <button class="lc-btn lc-btn-outline" disabled="@(_dashboard is null || _isLoading)" @onclick="ExportExcel"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><path d="M8 13h2"></path><path d="M8 17h2"></path><path d="M14 13h2"></path><path d="M14 17h2"></path></svg> Excel</button>
            <button class="lc-btn lc-btn-solid" disabled title="Send Mail is not implemented for Liquidation Cycle yet"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg> Send Mail</button>
        </div>
    </div>

    <!-- Filters Section -->
    <div class="lc-filter-card">
        <div class="lc-filter-header">
            <div class="lc-filter-title">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="6" x2="20" y2="6"></line><line x1="6" y1="12" x2="18" y2="12"></line><line x1="8" y1="18" x2="16" y2="18"></line></svg>
                Filters
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </div>
        
        <div class="lc-filter-body">
            <div class="lc-filter-grid-top">
                <!-- Changed ac-form-group to lc-form-group for design consistency -->
                <div class="lc-form-group">
                    <label class="lc-form-label">Date From</label>
                    <input type="date" class="lc-form-input" @bind="_dateFrom" />
                </div>
                <div class="lc-form-group">
                    <label class="lc-form-label">Date To</label>
                    <input type="date" class="lc-form-input" @bind="_dateTo" />
                </div>
                <div class="lc-form-group">
                    <label class="lc-form-label">State</label>
                    <select id="lc-state-select" class="lc-form-select" multiple="multiple">
                        @foreach (var s in _states)
                        {
                            <option value="@s.Id" selected="@(_selStates.Contains(s.Id))">@s.Name</option>
                        }
                    </select>
                </div>
                <div class="lc-form-group">
                    <label class="lc-form-label">Region</label>
                    <select id="lc-region-select" class="lc-form-select" multiple="multiple">
                        @foreach (var r in _regions)
                        {
                            <option value="@r.Id" selected="@(_selRegions.Contains(r.Id))">@r.Name</option>
                        }
                    </select>
                </div>
                <div class="lc-form-group">
                    <label class="lc-form-label">HQ</label>
                    <select id="lc-hq-select" class="lc-form-select" multiple="multiple">
                        @foreach (var h in _hq)
                        {
                            <option value="@h.Id" selected="@(_selHqs.Contains(h.Id))">@h.Name</option>
                        }
                    </select>
                </div>
              
            </div>
            
            <div class="lc-filter-grid-bottom">
                <div class="lc-form-group">
                    <label class="lc-form-label">District</label>
                    <select id="lc-district-select" class="lc-form-select" multiple="multiple">
                        @foreach (var d in _districts)
                        {
                            <option value="@d.Id" selected="@(_selDistricts.Contains(d.Id))">@d.Name</option>
                        }
                    </select>
                </div>
                <div class="lc-form-group">
                    <label class="lc-form-label">Sub District</label>
                    <select id="lc-subdistrict-select" class="lc-form-select" multiple="multiple">
                        @foreach (var sd in _subDistricts)
                        {
                            <option value="@sd.Id" selected="@(_selSubDistricts.Contains(sd.Id))">@sd.Name</option>
                        }
                    </select>
                </div>
                <div class="lc-form-group">
                    <label class="lc-form-label">Dealer Name</label>
                    <select id="lc-dealer-select" class="lc-form-select" multiple="multiple">
                        @foreach (var d in _dealers)
                        {
                            <option value="@d.Id" selected="@(_selDealerKeys.Contains(d.Id))">@d.Name</option>
                        }
                    </select>
                </div>
                <div class="lc-form-group">
                    <label class="lc-form-label">Product</label>
                    <select id="lc-product-select" class="lc-form-select" multiple="multiple">
                        @foreach (var p in _products)
                        {
                            <option value="@p.Id" selected="@(_selProductKeys.Contains(p.Id))">@(p.Source == "IFMS" ? $"{p.Name} (IFMS)" : p.Name)</option>
                        }
                    </select>
                </div>

                <div class="lc-form-group">
                    <label class="lc-form-label">Financial Year</label>
                    <select id="lc-financialyear-select" class="lc-form-select" multiple="multiple">
                        @if (_financialYears.Count == 0)
                        {
                            <option disabled>Loading…</option>
                        }
                        @foreach (var fy in _financialYears)
                        {
                            <option value="@fy.Id" selected="@(_selFinancialYears.Contains(fy.Id))">@fy.Name</option>
                        }
                    </select>
                </div>
                
                <div class="lc-filter-actions">
                    <button class="lc-btn lc-btn-outline" disabled="@(!_masterDataReady || _isLoading)" @onclick="ClearAll"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg> Clear All</button>
                    <button class="lc-btn lc-btn-solid" disabled="@(!_masterDataReady || _isLoading)" @onclick="ApplyFilters"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="6" x2="20" y2="6"></line><line x1="6" y1="12" x2="18" y2="12"></line><line x1="8" y1="18" x2="16" y2="18"></line></svg> Apply Filters</button>
                </div>
            </div>
        </div>
    </div>

    @if (_dashboard is null)
    {
        @if (_isLoading)
        {
            <!-- Keep the complete dashboard footprint visible while the first API request runs. -->
            <div class="lc-skeleton-dashboard" aria-label="Loading liquidation dashboard">
                <div class="lc-stats-grid">
                    @for (var i = 0; i < 3; i++)
                    {
                        <div class="lc-stat-card lc-skeleton-card">
                            <div class="lc-skeleton-line lc-skeleton-label"></div>
                            <div class="lc-skeleton-line lc-skeleton-value"></div>
                        </div>
                    }
                </div>

                <div class="lc-skeleton-section-header">
                    <div class="lc-skeleton-line lc-skeleton-heading"></div>
                    <div class="lc-skeleton-line lc-skeleton-toolbar"></div>
                </div>

                <div class="lc-charts-grid">
                    @for (var chart = 0; chart < 2; chart++)
                    {
                        <div class="lc-chart-card lc-skeleton-chart-card">
                            <div class="lc-skeleton-line lc-skeleton-heading"></div>
                            <div class="lc-skeleton-line lc-skeleton-subtitle"></div>
                            @for (var row = 0; row < 5; row++)
                            {
                                <div class="lc-skeleton-chart-row">
                                    <div class="lc-skeleton-circle"></div>
                                    <div class="lc-skeleton-line lc-skeleton-name"></div>
                                    <div class="lc-skeleton-line lc-skeleton-bar"></div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="lc-table-card lc-skeleton-table-card">
                    <div class="lc-table-top">
                        <div class="lc-skeleton-line lc-skeleton-heading"></div>
                        <div class="lc-skeleton-line lc-skeleton-search"></div>
                    </div>
                    @for (var row = 0; row < 6; row++)
                    {
                        <div class="lc-skeleton-table-row">
                            @for (var col = 0; col < 8; col++)
                            {
                                <div class="lc-skeleton-line"></div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="lc-empty-state">
                @(_loadError is null ? "No Data Available" : $"Could not load report: {_loadError}")
            </div>
        }
    }
    else
    {
        <div class="lc-dashboard-content @(_isLoading ? "is-updating" : "")">
            @if (_isLoading)
            {
                <div class="lc-updating-indicator" role="status">
                    <span class="lc-mini-spinner"></span>
                    Updating…
                </div>
            }
            
            <!-- 3-Column Statistics Grid -->
            <div class="lc-stats-grid">
                <div class="lc-stat-card lc-card-green">
                    <div class="lc-card-top">
                        <div class="lc-stat-info">
                            <span class="lc-stat-title">Total Stock (MT)</span>
                            <span class="lc-stat-value">@Num(_dashboard.Summary.TotalStock)</span>
                        </div>
                        <div class="lc-icon-box"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg></div>
                    </div>
                </div>

                <div class="lc-stat-card lc-card-cyan">
                    <div class="lc-card-top">
                        <div class="lc-stat-info">
                            <span class="lc-stat-title">Liquidated (MT)</span>
                            <span class="lc-stat-value">@Num(_dashboard.Summary.Liquidated)</span>
                        </div>
                        <div class="lc-icon-box"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="14 2 14 8 20 8"></polyline><circle cx="10" cy="13" r="2"></circle></svg></div>
                    </div>
                </div>

                <div class="lc-stat-card lc-card-red">
                    <div class="lc-card-top">
                        <div class="lc-stat-info">
                            <span class="lc-stat-title">Balance Stock (MT)</span>
                            <span class="lc-stat-value">@Num(_dashboard.Summary.BalanceStock)</span>
                        </div>
                        <div class="lc-icon-box"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="3" fill="currentColor"></circle></svg></div>
                    </div>
                </div>
            </div>

            <!-- WHOLESALER LIQUIDATION SECTION WITH UNIFIED TOGGLES -->
            <div class="lc-section-header">
                <h3>Dealer Liquidation Performance</h3>
                
                <div class="lc-btn-group">
                    <!-- Single-select toolbar: only one button active at a time -->
                    <button class="lc-toggle-btn @(_activeFilter == "Top5" ? "active" : "")"
                            disabled="@(_isLoading)"
                            @onclick='() => SelectFilter("Top5")'>
                        Top 5 Performance
                    </button>
                    <button class="lc-toggle-btn @(_activeFilter == "StateWise" ? "active" : "")"
                            disabled="@(_isLoading)"
                            @onclick='() => SelectFilter("StateWise")'>
                        State-wise
                    </button>
                    <button class="lc-toggle-btn @(_activeFilter == "All" ? "active" : "")"
                            disabled="@(_isLoading)"
                            @onclick='() => SelectFilter("All")'>
                        All
                    </button>
                    <button class="lc-toggle-btn @(_activeFilter == "Company Sales" ? "active" : "")"
                            disabled="@(_isLoading)"
                            @onclick='() => SelectFilter("Company Sales")'>
                        Company Sales
                    </button>
                    <button class="lc-toggle-btn @(_activeFilter == "Wholesaler Sales" ? "active" : "")"
                            disabled="@(_isLoading)"
                            @onclick='() => SelectFilter("Wholesaler Sales")'>
                        Wholesalers
                    </button>
                    <button class="lc-toggle-btn @(_activeFilter == "Retailer Sales" ? "active" : "")"
                            disabled="@(_isLoading)"
                            @onclick='() => SelectFilter("Retailer Sales")'>
                        Retailers
                    </button>
                </div>
            </div>

            <!-- Single Row Chart Output — ONE chart format (horizontal bars) for every view -->
            <div class="lc-charts-grid">

                <!-- FAST -->
                <div class="lc-chart-card">
                    <div class="lc-chart-card-header">
                        <h4>@(chartView == "Top5" ? "Top 5 Fast Dealers" : "State-wise Fast Liquidation")</h4>
                        <p>@(chartView == "Top5" ? "High fast liquidation volume" : "States with the highest fast liquidation rate")</p>
                    </div>
                    <div class="lc-chart-scroll-wrapper">
                        <div class="lc-horiz-chart-inner">
                            @{
                                var fastData = GetFastChartData();
                            }
                            @if (fastData.Count == 0)
                            {
                                <div style="text-align:center; padding:24px; color:#94a3b8;">No data available.</div>
                            }
                            else
                            {
                                @foreach (var (item, i) in fastData.Select((d, i) => (d, i)))
                                {
                                    <div class="lc-horiz-row">
                                        <div class="lc-horiz-rank">@(i + 1)</div>
                                        <div class="lc-horiz-label" style="width:120px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">@item.Label</div>
                                        <div class="lc-horiz-track" style="flex:1;">
                                            <div class="lc-horiz-fill bg-green-400" style="width: @(item.Rate.ToString("0", Inv))%;"></div>
                                        </div>
                                        <div class="lc-horiz-val">@item.Rate.ToString("0.##")%</div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>

                <!-- SLOW -->
                <div class="lc-chart-card">
                    <div class="lc-chart-card-header">
                        <h4>@(chartView == "Top5" ? "Top 5 Slow Dealers" : "State-wise Slow Liquidation")</h4>
                        <p>@(chartView == "Top5" ? "High critical / slow volume" : "States with the highest delayed / slow liquidation rate")</p>
                    </div>
                    <div class="lc-chart-scroll-wrapper">
                        <div class="lc-horiz-chart-inner">
                            @{
                                var slowData = GetSlowChartData();
                            }
                            @if (slowData.Count == 0)
                            {
                                <div style="text-align:center; padding:24px; color:#94a3b8;">No data available.</div>
                            }
                            else
                            {
                                @foreach (var (item, i) in slowData.Select((d, i) => (d, i)))
                                {
                                    <div class="lc-horiz-row">
                                        <div class="lc-horiz-rank">@(i + 1)</div>
                                        <div class="lc-horiz-label" style="width:120px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">@item.Label</div>
                                        <div class="lc-horiz-track" style="flex:1;">
                                            <div class="lc-horiz-fill bg-red-400" style="width: @(item.Rate.ToString("0", Inv))%;"></div>
                                        </div>
                                        <div class="lc-horiz-val">@item.Rate.ToString("0.##")%</div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Table Section -->
            <div class="lc-table-card">
                <div class="lc-table-top">
                    <h3>Liquidation Cycle List</h3>
                    <input type="text" class="lc-search-input" placeholder="Search dealer, product..." disabled="@(_isLoading)" @bind="_filter.Search" @bind:event="oninput" @onkeyup="OnSearchKeyUp" />
                </div>

                <div class="lc-table-wrapper">
                    <table class="lc-main-table">
                        <thead>
                            <tr>
                                <th style="text-align: left;">Dealer Name</th>
                                <th>Dealer Type</th>
                                <th>Product</th>
                                <th>Stock (MT)</th>
                                <th>Ageing (Days)</th>
                                <th>Sales (MT)</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_dashboard.Grid.Items.Count == 0)
                            {
                                <tr><td colspan="8" style="text-align:center; padding:24px;">No records found.</td></tr>
                            }
                            else
                            {
                                @foreach (var row in _dashboard.Grid.Items)
                                {
                                    <tr>
                                        <td style="text-align: left; color: #475569;">@row.DealerName</td>
                                        <td>@row.DealerType</td>
                                        <td>@row.ProductName</td>
                                        <td>@Num(row.Stock)</td>
                                        <td class="@AgeingClass(row.AgeingDays)">@row.AgeingDays</td>
                                        <td>@Num(row.Sales)</td>
                                        <td><div class="lc-status @StatusClass(row.Status)"><div class="dot"></div>@row.Status</div></td>
                                        <td><button class="lc-action-btn" @onclick="() => OpenDetails(row)"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path><circle cx="12" cy="12" r="3"></circle></svg></button></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <div class="lc-pagination">
                    <div class="lc-page-size">
                        <span>Items Per Page</span>
                        <select class="lc-form-select" style="padding: 6px 32px 6px 12px; width: 65px;" @onchange="OnPageSizeChanged">
                            <option value="16" selected="@(_filter.PageSize == 16)">16</option>
                            <option value="50" selected="@(_filter.PageSize == 50)">50</option>
                        </select>
                    </div>
                    <div class="lc-page-controls">
                        <button class="lc-page-btn" disabled="@(_filter.Page <= 1)" @onclick="() => GoToPage(_filter.Page - 1)">‹</button>
                        <button class="lc-page-btn active">@_filter.Page</button>
                        <button class="lc-page-btn" disabled="@(_filter.Page >= TotalPages)" @onclick="() => GoToPage(_filter.Page + 1)">›</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<LiquidationDetailsDrawer @bind-IsOpen="isDrawerOpen" Row="_selectedRow" />

@code {
    private static readonly CultureInfo Inv = CultureInfo.InvariantCulture;

    private LiqCycleDashboardDto? _dashboard;
    private readonly LiqCycleFilter _filter = new();

    private bool _isLoading = true;
    private bool _masterDataReady;
    private bool _select2Initialized;
    private bool _disposed;
    private string? _loadError;

    private CancellationTokenSource? _loadCts;
    private System.Timers.Timer? _searchDebounce;

    private DateTime? _dateFrom;
    private DateTime? _dateTo;

    private bool isDrawerOpen;
    private LiqCycleRowDto? _selectedRow;

    // View toggles (content switch only — the same chart format is used for both).
    private string chartView = "Top5";

    // Values: Top5, StateWise, All, Company Sales, Wholesaler Sales, Retailer Sales.
    private string _activeFilter = "Top5";

    // ---- Master Data ----
    private List<LocationDto> _states = new();
    private List<LocationDto> _regions = new();
    private List<LocationDto> _hq = new();
    private List<LocationDto> _districts = new();
    private List<LocationDto> _subDistricts = new();

    private List<LocationDto> _allStates = new();
    private List<LocationDto> _allRegions = new();
    private List<LocationDto> _allHqs = new();
    private List<LocationDto> _allDistricts = new();
    private List<LocationDto> _allSubDistricts = new();

    private List<LiqCycleProductDto> _products = new();
    private List<AckLookupItemDto> _dealers = new();
    private List<FinancialYearDto> _financialYears = new();

    private List<int> _selStates = new();
    private List<int> _selRegions = new();
    private List<int> _selHqs = new();
    private List<int> _selDistricts = new();
    private List<int> _selSubDistricts = new();
    private List<string> _selProductKeys = new();
    private List<string> _selDealerKeys = new();
    private List<int> _selFinancialYears = new();

    private DotNetObjectReference<LiquidationCycle>? _objRef;

    public class LocationDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public int? StateId { get; set; }
        public int? RegionId { get; set; }
        public int? DistrictId { get; set; }
    }

    private class FinancialYearDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public DateTime StartDate { get; set; }
        public DateTime EndDate { get; set; }
    }

    private record ChartBar(string Label, double Rate);

    private List<ChartBar> GetFastChartData()
    {
        if (_dashboard is null)
            return new();

        var source = chartView == "Top5"
            ? _dashboard.TopFastDealers
            : _dashboard.TopFastStates;

        return source
            .Select(d => new ChartBar(d.DealerName, d.Rate))
            .ToList();
    }

    private List<ChartBar> GetSlowChartData()
    {
        if (_dashboard is null)
            return new();

        var source = chartView == "Top5"
            ? _dashboard.TopSlowDealers
            : _dashboard.TopSlowStates;

        return source
            .Select(d => new ChartBar(d.DealerName, d.Rate))
            .ToList();
    }

    private int TotalPages =>
        _dashboard is null || _dashboard.Grid.PageSize == 0
            ? 1
            : (int)Math.Ceiling(
                (double)_dashboard.Grid.TotalCount / _dashboard.Grid.PageSize);

    // ---- Lifecycle ----
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _objRef = DotNetObjectReference.Create(this);

            // Do not await here. The first render returns immediately so the skeleton
            // dashboard is visible while master data and dashboard data load in parallel.
            _ = InitializePageAsync();
            return;
        }

        if (_masterDataReady && !_select2Initialized && !_disposed)
        {
            _select2Initialized = true;

            try
            {
                await InitSelect2();
            }
            catch (Exception ex)
            {
                _select2Initialized = false;
                Console.WriteLine($"[Liquidation] Select2 initialization error: {ex}");
            }
        }
    }

    private async Task InitializePageAsync()
    {
        // Apply the mandatory login scope before the very first dashboard request.
        // This preserves the fast parallel first-load while preventing an empty-scope request.
        ApplyMandatoryRoleScopeToSelections();
        SyncSelections();

        // Start dashboard immediately instead of waiting for every lookup request.
        var dashboardTask = LoadDashboard(renderLoadingState: false);

        try
        {
            await LoadMasterData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Liquidation] Master-data error: {ex}");
        }
        finally
        {
            _masterDataReady = true;

            if (!_disposed)
                await InvokeAsync(StateHasChanged);
        }

        try
        {
            await dashboardTask;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Liquidation] Dashboard initialization error: {ex}");
        }
    }

    private async Task LoadMasterData()
    {
        var statesTask = FetchLocations("api/State/all");
        var regionsTask = FetchLocations("api/Region/all");
        var hqTask = FetchLocations("api/Headquarter/all");
        var districtsTask = FetchLocations("api/District/all");
        var subDistrictsTask = FetchLocations("api/SubDistrict/all");
        var productsTask = FetchProducts();
        var dealersTask = FetchDealers();
        var fyTask = FetchFinancialYears();

        await Task.WhenAll(
            statesTask,
            regionsTask,
            hqTask,
            districtsTask,
            subDistrictsTask,
            productsTask,
            dealersTask,
            fyTask);

        _allStates = await statesTask;
        _allRegions = await regionsTask;
        _allHqs = await hqTask;
        _allDistricts = await districtsTask;
        _allSubDistricts = await subDistrictsTask;

        // Headquarter and SubDistrict APIs do not always expose StateId directly.
        // Resolve it through their existing parent master so cascade/role filtering stays exact.
        foreach (var hq in _allHqs)
        {
            var region = _allRegions.FirstOrDefault(r => r.Id == hq.RegionId);
            if (region is not null)
                hq.StateId = region.StateId;
        }

        foreach (var subDistrict in _allSubDistricts)
        {
            var district = _allDistricts.FirstOrDefault(d => d.Id == subDistrict.DistrictId);
            if (district is not null)
                subDistrict.StateId = district.StateId;
        }

        ApplyMandatoryRoleScopeToSelections();
        ApplyRoleVisibility();

        _products = await productsTask;
        _dealers = await dealersTask;
        _financialYears = await fyTask;

        // Re-sync because master data can resolve parent State/Region values more precisely.
        SyncSelections();
    }

    private bool IsUnrestrictedRole =>
        LoginState is null || LoginState.IsAdmin || LoginState.IsDirectorOrAVP;

    private void ApplyMandatoryRoleScopeToSelections()
    {
        if (IsUnrestrictedRole || LoginState is null)
            return;

        if (LoginState.IsHQRole && LoginState.HQId > 0)
        {
            _selHqs = new List<int> { LoginState.HQId };

            var regionId = _allHqs.FirstOrDefault(h => h.Id == LoginState.HQId)?.RegionId
                ?? (LoginState.RegionId > 0 ? (int?)LoginState.RegionId : null);
            if (regionId.HasValue && regionId.Value > 0)
                _selRegions = new List<int> { regionId.Value };

            var stateId = regionId.HasValue
                ? _allRegions.FirstOrDefault(r => r.Id == regionId.Value)?.StateId
                : null;
            stateId ??= LoginState.StateId > 0 ? (int?)LoginState.StateId : null;
            if (stateId.HasValue && stateId.Value > 0)
                _selStates = new List<int> { stateId.Value };

            return;
        }

        if (LoginState.IsRegionRole && LoginState.RegionId > 0)
        {
            _selRegions = new List<int> { LoginState.RegionId };

            var stateId = _allRegions.FirstOrDefault(r => r.Id == LoginState.RegionId)?.StateId
                ?? (LoginState.StateId > 0 ? (int?)LoginState.StateId : null);
            if (stateId.HasValue && stateId.Value > 0)
                _selStates = new List<int> { stateId.Value };

            _selHqs.RemoveAll(id =>
            {
                var hq = _allHqs.FirstOrDefault(x => x.Id == id);
                return hq is null || hq.RegionId != LoginState.RegionId;
            });

            return;
        }

        if (LoginState.IsStateRole && LoginState.StateId > 0)
        {
            _selStates = new List<int> { LoginState.StateId };

            _selRegions.RemoveAll(id =>
            {
                var region = _allRegions.FirstOrDefault(x => x.Id == id);
                return region is null || region.StateId != LoginState.StateId;
            });

            _selHqs.RemoveAll(id =>
            {
                var hq = _allHqs.FirstOrDefault(x => x.Id == id);
                return hq is null || hq.StateId != LoginState.StateId;
            });
        }
    }

    private void ApplyRoleVisibility()
    {
        if (IsUnrestrictedRole || LoginState is null)
        {
            _states = _allStates;
            _regions = _selStates.Any()
                ? _allRegions.Where(r => _selStates.Contains(r.StateId ?? 0)).ToList()
                : _allRegions;
            _hq = _selRegions.Any()
                ? _allHqs.Where(h => _selRegions.Contains(h.RegionId ?? 0)).ToList()
                : (_selStates.Any()
                    ? _allHqs.Where(h => _selStates.Contains(h.StateId ?? 0)).ToList()
                    : _allHqs);
        }
        else if (LoginState.IsHQRole && LoginState.HQId > 0)
        {
            _hq = _allHqs.Where(h => h.Id == LoginState.HQId).ToList();
            var regionId = _allHqs.FirstOrDefault(h => h.Id == LoginState.HQId)?.RegionId ?? LoginState.RegionId;
            _regions = regionId > 0
                ? _allRegions.Where(r => r.Id == regionId).ToList()
                : new List<LocationDto>();
            var stateId = _regions.FirstOrDefault()?.StateId ?? LoginState.StateId;
            _states = stateId > 0
                ? _allStates.Where(s => s.Id == stateId).ToList()
                : new List<LocationDto>();
        }
        else if (LoginState.IsRegionRole && LoginState.RegionId > 0)
        {
            _regions = _allRegions.Where(r => r.Id == LoginState.RegionId).ToList();
            var stateId = _regions.FirstOrDefault()?.StateId ?? LoginState.StateId;
            _states = stateId > 0
                ? _allStates.Where(s => s.Id == stateId).ToList()
                : new List<LocationDto>();
            _hq = _allHqs.Where(h => h.RegionId == LoginState.RegionId).ToList();
        }
        else if (LoginState.IsStateRole && LoginState.StateId > 0)
        {
            _states = _allStates.Where(s => s.Id == LoginState.StateId).ToList();
            _regions = _allRegions.Where(r => r.StateId == LoginState.StateId).ToList();
            _hq = _selRegions.Any()
                ? _allHqs.Where(h => _selRegions.Contains(h.RegionId ?? 0)).ToList()
                : _allHqs.Where(h => h.StateId == LoginState.StateId).ToList();
        }
        else
        {
            _states = _allStates;
            _regions = _allRegions;
            _hq = _allHqs;
        }

        var allowedStateIds = _states.Select(x => x.Id).ToHashSet();
        _districts = _selStates.Any()
            ? _allDistricts.Where(d => _selStates.Contains(d.StateId ?? 0)).ToList()
            : (allowedStateIds.Count > 0
                ? _allDistricts.Where(d => allowedStateIds.Contains(d.StateId ?? 0)).ToList()
                : _allDistricts);

        _subDistricts = _selDistricts.Any()
            ? _allSubDistricts.Where(sd => _selDistricts.Contains(sd.DistrictId ?? 0)).ToList()
            : (_selStates.Any()
                ? _allSubDistricts.Where(sd => _selStates.Contains(sd.StateId ?? 0)).ToList()
                : (allowedStateIds.Count > 0
                    ? _allSubDistricts.Where(sd => allowedStateIds.Contains(sd.StateId ?? 0)).ToList()
                    : _allSubDistricts));
    }

    private async Task<List<LocationDto>> FetchLocations(string url)
    {
        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(20));
            var raw = await Http.GetFromJsonAsync<List<JsonElement>>(url, cts.Token);
            var list = new List<LocationDto>();

            if (raw is null)
                return list;

            foreach (var item in raw)
            {
                if (!item.TryGetProperty("id", out var idProperty) ||
                    idProperty.ValueKind != JsonValueKind.Number)
                {
                    continue;
                }

                var id = idProperty.GetInt32();
                var name = ReadLookupName(item);

                list.Add(new LocationDto
                {
                    Id = id,
                    Name = name,
                    StateId = ReadNullableInt(item, "stateId"),
                    RegionId = ReadNullableInt(item, "regionId"),
                    DistrictId = ReadNullableInt(item, "districtId")
                });
            }

            return list;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Liquidation] Could not load {url}: {ex.Message}");
            return new();
        }
    }

    private static int? ReadNullableInt(JsonElement item, string propertyName)
    {
        if (!item.TryGetProperty(propertyName, out var value) ||
            value.ValueKind != JsonValueKind.Number)
        {
            return null;
        }

        return value.TryGetInt32(out var result) ? result : null;
    }

