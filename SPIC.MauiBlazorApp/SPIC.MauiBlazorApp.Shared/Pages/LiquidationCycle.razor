
@page "/LiquidationCycle" 
<div class="container-fluid py-4 px-3 px-md-4" style="max-width: 1600px;">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="page-title">Liquidation Cycle</h1>
            <p class="page-subtitle mb-0">View and monitor company sales transactions from IFMS</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button class="btn-outline-custom"><i class="bi bi-arrow-clockwise"></i> Refresh Data</button>
            <button class="btn-outline-custom"><i class="bi bi-file-earmark-spreadsheet"></i> Excel</button>
            <button class="btn-outline-custom"><i class="bi bi-file-earmark-pdf"></i> PDF</button>
            <button class="btn-primary-custom"><i class="bi bi-envelope"></i> Send Mail</button>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-5 g-3 mb-4">
        <div class="col">
            <div class="kpi-card kpi-green">
                <div class="kpi-header">
                    <div>
                        <p class="kpi-label">Total Stock</p>
                        <h2 class="kpi-value">4,820</h2>
                    </div>
                    <div class="kpi-icon-wrapper"><i class="bi bi-box-seam"></i></div>
                </div>
                <div class="kpi-trend text-green"><i class="bi bi-arrow-up-right"></i> 12% vs last period</div>
            </div>
        </div>
        <div class="col">
            <div class="kpi-card kpi-blue">
                <div class="kpi-header">
                    <div>
                        <p class="kpi-label">Under Review (MT)</p>
                        <h2 class="kpi-value">4,820</h2>
                    </div>
                    <div class="kpi-icon-wrapper"><i class="bi bi-file-earmark-text"></i></div>
                </div>
                <div class="kpi-trend text-green"><i class="bi bi-arrow-up-right"></i> 3.5% vs last period</div>
            </div>
        </div>
        <div class="col">
            <div class="kpi-card kpi-orange">
                <div class="kpi-header">
                    <div>
                        <p class="kpi-label">In Progress (MT)</p>
                        <h2 class="kpi-value">2,820</h2>
                    </div>
                    <div class="kpi-icon-wrapper"><i class="bi bi-bullseye"></i></div>
                </div>
                <div class="kpi-trend text-green"><i class="bi bi-arrow-up-right"></i> 1.2% vs last period</div>
            </div>
        </div>
        <div class="col">
            <div class="kpi-card kpi-teal">
                <div class="kpi-header">
                    <div>
                        <p class="kpi-label">Liquidated (MT)</p>
                        <h2 class="kpi-value">3,120</h2>
                    </div>
                    <div class="kpi-icon-wrapper"><i class="bi bi-clipboard-check"></i></div>
                </div>
                <div class="kpi-trend text-green"><i class="bi bi-arrow-up-right"></i> 7.2% vs last period</div>
            </div>
        </div>
        <div class="col">
            <div class="kpi-card kpi-red">
                <div class="kpi-header">
                    <div>
                        <p class="kpi-label">Pending Ack</p>
                        <h2 class="kpi-value">1,020</h2>
                    </div>
                    <div class="kpi-icon-wrapper"><i class="bi bi-box-arrow-in-right"></i></div>
                </div>
                <div class="kpi-trend text-red"><i class="bi bi-arrow-down-right"></i> 5.10% vs last period</div>
            </div>
        </div>
    </div>

    <div class="dashboard-card mb-4">
        <div class="filter-header">
            <span><i class="bi bi-funnel"></i> Filters</span>
            <i class="bi bi-chevron-down text-muted" style="cursor: pointer;"></i>
        </div>
        <div class="row row-cols-1 row-cols-md-3 row-cols-lg-5 g-3">
            <div class="col">
                <label class="filter-label">State</label>
                <select class="form-select custom-input"><option>All</option></select>
            </div>
            <div class="col">
                <label class="filter-label">Region</label>
                <select class="form-select custom-input"><option>All</option></select>
            </div>
            <div class="col">
                <label class="filter-label">HQ</label>
                <select class="form-select custom-input"><option>All</option></select>
            </div>
            <div class="col">
                <label class="filter-label">District</label>
                <select class="form-select custom-input"><option>All</option></select>
            </div>
            <div class="col">
                <label class="filter-label">Sub District</label>
                <select class="form-select custom-input"><option>All</option></select>
            </div>
            
            <div class="col">
                <label class="filter-label">Dealer Name</label>
                <select class="form-select custom-input"><option>All</option></select>
            </div>
            <div class="col">
                <label class="filter-label">Product</label>
                <select class="form-select custom-input"><option>All</option></select>
            </div>
            <div class="col">
                <label class="filter-label">Liquidation Status</label>
                <select class="form-select custom-input"><option>All</option></select>
            </div>
            <div class="col">
                <label class="filter-label">Status</label>
                <select class="form-select custom-input"><option>All</option></select>
            </div>
        </div>
        <div class="d-flex justify-content-end mt-4 gap-2">
            <button class="btn-outline-custom"><i class="bi bi-x"></i> Clear All</button>
            <button class="btn-primary-custom"><i class="bi bi-funnel"></i> Apply Filters</button>
        </div>
    </div>

    <div class="dashboard-card pb-2">
        <div class="table-header-row">
            <h3 class="card-title">Liquidation Cycle List</h3>
            <div class="search-container">
                <i class="bi bi-search"></i>
                <input type="text" class="search-input" placeholder="Search zones...">
            </div>
        </div>
        
        <div class="table-responsive">
            <table class="table table-borderless custom-table">
                <thead>
                    <tr>
                        <th style="width: 40px;"><input class="form-check-input" type="checkbox"></th>
                        <th>Dealer Name</th>
                        <th>Product</th>
                        <th>Stock</th>
                        <th>Ageing in Days</th>
                        <th>Sales</th>
                        <th>Liquidation Status</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><input class="form-check-input" type="checkbox"></td>
                        <td class="fw-medium">Sri Murugan Traders</td>
                        <td>DAP 50 KG</td>
                        <td>120.500</td>
                        <td class="text-red">28</td>
                        <td>70.600</td>
                        <td><span class="outline-badge outline-blue">Under Review</span></td>
                        <td><div class="status-badge status-critical"><span class="status-dot"></span> Critical</div></td>
                        <td><button class="action-icon"><i class="bi bi-eye"></i></button></td>
                    </tr>
                    <tr>
                        <td><input class="form-check-input" type="checkbox"></td>
                        <td class="fw-medium">Sri Murugan Traders</td>
                        <td>MOP 50 Kg</td>
                        <td>80.250</td>
                        <td class="text-orange">42</td>
                        <td>62.100</td>
                        <td><span class="outline-badge outline-pink">In Progress</span></td>
                        <td><div class="status-badge status-monitoring"><span class="status-dot"></span> Monitoring</div></td>
                        <td><button class="action-icon"><i class="bi bi-eye"></i></button></td>
                    </tr>
                    <tr>
                        <td><input class="form-check-input" type="checkbox"></td>
                        <td class="fw-medium">Sri Murugan Traders</td>
                        <td>Mop 50 Kg</td>
                        <td>70.600</td>
                        <td class="text-green">78</td>
                        <td>18.600</td>
                        <td><span class="outline-badge outline-green">Liquidated</span></td>
                        <td><div class="status-badge status-active"><span class="status-dot"></span> Active</div></td>
                        <td><button class="action-icon"><i class="bi bi-eye"></i></button></td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="pagination-container mt-2">
            <div class="items-per-page">
                Items Per Page 
                <select class="form-select form-select-sm" style="width: 70px; background-color: #fff;">
                    <option>16</option>
                    <option>25</option>
                </select>
            </div>
            <div class="d-flex gap-1">
                <a class="page-item"><i class="bi bi-chevron-left"></i></a>
                <a class="page-item active">1</a>
                <a class="page-item">2</a>
                <a class="page-item">3</a>
                <span class="page-item dots">..</span>
                <a class="page-item">8</a>
                <a class="page-item">9</a>
                <a class="page-item">10</a>
                <a class="page-item"><i class="bi bi-chevron-right"></i></a>
            </div>
        </div>
    </div>
</div>



