    private static List<int> ParseIds(List<string>? values) =>
        (values ?? new())
            .Where(value => int.TryParse(value, out _))
            .Select(int.Parse)
            .Distinct()
            .ToList();

    [JSInvokable]
    public async Task OnStateChanged(List<string>? values)
    {
        _selStates = ParseIds(values);
        ApplyMandatoryRoleScopeToSelections();
        await Cascade("State");
    }

    [JSInvokable]
    public async Task OnRegionChanged(List<string>? values)
    {
        _selRegions = ParseIds(values);
        ApplyMandatoryRoleScopeToSelections();
        await Cascade("Region");
    }

    [JSInvokable]
    public async Task OnHqChanged(List<string>? values)
    {
        _selHqs = ParseIds(values);
        ApplyMandatoryRoleScopeToSelections();
        await Cascade("HQ");
    }

    [JSInvokable]
    public async Task OnDistrictChanged(List<string>? values)
    {
        _selDistricts = ParseIds(values);
        await Cascade("District");
    }

    [JSInvokable]
    public async Task OnSubDistrictChanged(List<string>? values)
    {
        _selSubDistricts = ParseIds(values);
        await Cascade("SubDistrict");
    }

    [JSInvokable]
    public void OnProductChanged(List<string>? values) =>
        _selProductKeys = (values ?? new())
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Select(value => value.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

    [JSInvokable]
    public void OnDealerChanged(List<string>? values) =>
        _selDealerKeys = (values ?? new())
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Distinct()
            .ToList();

    [JSInvokable]
    public async Task OnFinancialYearChanged(List<string>? values)
    {
        _selFinancialYears = ParseIds(values);

        if (_selFinancialYears.Count == 0)
        {
            _dateFrom = null;
            _dateTo = null;
        }
        else
        {
            var selectedYears = _financialYears
                .Where(item => _selFinancialYears.Contains(item.Id))
                .ToList();

            _dateFrom = selectedYears.Count == 0
                ? null
                : selectedYears.Min(item => item.StartDate);

            _dateTo = selectedYears.Count == 0
                ? null
                : selectedYears.Max(item => item.EndDate);
        }

        if (!_disposed)
            await InvokeAsync(StateHasChanged);
    }

    private async Task Cascade(string filterType)
    {
        if (filterType == "State" && _selStates.Any())
        {
            _selRegions.RemoveAll(id =>
            {
                var region = _allRegions.FirstOrDefault(x => x.Id == id);
                return region is null || !_selStates.Contains(region.StateId ?? 0);
            });
            _selHqs.RemoveAll(id =>
            {
                var hq = _allHqs.FirstOrDefault(x => x.Id == id);
                return hq is null || !_selStates.Contains(hq.StateId ?? 0);
            });
            _selDistricts.RemoveAll(id =>
            {
                var district = _allDistricts.FirstOrDefault(x => x.Id == id);
                return district is null || !_selStates.Contains(district.StateId ?? 0);
            });
            _selSubDistricts.RemoveAll(id =>
            {
                var subDistrict = _allSubDistricts.FirstOrDefault(x => x.Id == id);
                return subDistrict is null || !_selStates.Contains(subDistrict.StateId ?? 0);
            });
        }
        else if (filterType == "Region" && _selRegions.Any())
        {
            _selStates = _selStates
                .Union(_allRegions
                    .Where(r => _selRegions.Contains(r.Id) && r.StateId.HasValue)
                    .Select(r => r.StateId!.Value))
                .Distinct()
                .ToList();

            _selHqs.RemoveAll(id =>
            {
                var hq = _allHqs.FirstOrDefault(x => x.Id == id);
                return hq is null || !_selRegions.Contains(hq.RegionId ?? 0);
            });
        }
        else if (filterType == "HQ" && _selHqs.Any())
        {
            _selRegions = _selRegions
                .Union(_allHqs
                    .Where(h => _selHqs.Contains(h.Id) && h.RegionId.HasValue)
                    .Select(h => h.RegionId!.Value))
                .Distinct()
                .ToList();

            _selStates = _selStates
                .Union(_allHqs
                    .Where(h => _selHqs.Contains(h.Id) && h.StateId.HasValue)
                    .Select(h => h.StateId!.Value))
                .Distinct()
                .ToList();
        }
        else if (filterType == "District" && _selDistricts.Any())
        {
            _selStates = _selStates
                .Union(_allDistricts
                    .Where(d => _selDistricts.Contains(d.Id) && d.StateId.HasValue)
                    .Select(d => d.StateId!.Value))
                .Distinct()
                .ToList();

            _selSubDistricts.RemoveAll(id =>
            {
                var subDistrict = _allSubDistricts.FirstOrDefault(x => x.Id == id);
                return subDistrict is null || !_selDistricts.Contains(subDistrict.DistrictId ?? 0);
            });
        }
        else if (filterType == "SubDistrict" && _selSubDistricts.Any())
        {
            _selDistricts = _selDistricts
                .Union(_allSubDistricts
                    .Where(sd => _selSubDistricts.Contains(sd.Id) && sd.DistrictId.HasValue)
                    .Select(sd => sd.DistrictId!.Value))
                .Distinct()
                .ToList();

            _selStates = _selStates
                .Union(_allSubDistricts
                    .Where(sd => _selSubDistricts.Contains(sd.Id) && sd.StateId.HasValue)
                    .Select(sd => sd.StateId!.Value))
                .Distinct()
                .ToList();
        }

        ApplyMandatoryRoleScopeToSelections();
        ApplyRoleVisibility();

        if (!_disposed)
            await InvokeAsync(StateHasChanged);

        await RefreshGeoSelect2();
    }

    private async Task RefreshGeoSelect2()
    {
        if (!_select2Initialized || _objRef is null)
