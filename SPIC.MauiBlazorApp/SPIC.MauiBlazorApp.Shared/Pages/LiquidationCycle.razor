                        <div class="lc-horiz-grid-line"></div>
                        <div class="lc-horiz-grid-line" style="border: none;"></div>
                    </div>

                    <!-- Row 1 -->
                    <div class="lc-horiz-row">
                        <div class="lc-horiz-rank" style="background: #fef08a; color: #ca8a04;">👑</div>
                        <div class="lc-horiz-label">Agri Hub</div>
                        <div class="lc-horiz-track">
                            <div class="lc-horiz-fill bg-green-400" style="width: 78%;"></div>
                        </div>
                        <div class="lc-horiz-val">78%</div>
                    </div>
                    <!-- Row 2 -->
                    <div class="lc-horiz-row">
                        <div class="lc-horiz-rank" style="background: #e2e8f0; color: #64748b;">🛡️</div>
