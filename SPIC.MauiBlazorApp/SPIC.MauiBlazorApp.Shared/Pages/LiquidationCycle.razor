    private async Task SelectFilter(string key)
    {
        _activeFilter = key;

        switch (key)
        {
            case "Top5":
                chartView = "Top5";
                _filter.Source = null;
                break;

            case "StateWise":
                chartView = "StateWise";
                _filter.Source = null;
                break;

            case "All":
                chartView = "Top5";
                _filter.Source = null;
                break;

            default:
                chartView = "Top5";
                _filter.Source = key;
                break;
        }

        _filter.Page = 1;
        await LoadDashboard();
    }

    private void OnSearchKeyUp()
    {
        _searchDebounce?.Stop();
        _searchDebounce?.Dispose();

        _searchDebounce = new System.Timers.Timer(400)
        {
            AutoReset = false
        };

        _searchDebounce.Elapsed += async (_, _) =>
        {
            await InvokeAsync(async () =>
            {
                _filter.Page = 1;
                await LoadDashboard();
            });
        };

        _searchDebounce.Start();
    }

    private async Task GoToPage(int page)
    {
        if (page < 1 || page > TotalPages || page == _filter.Page)
            return;

        _filter.Page = page;
        await LoadDashboard();
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var size))
            return;

        _filter.PageSize = size;
        _filter.Page = 1;
        await LoadDashboard();
    }

