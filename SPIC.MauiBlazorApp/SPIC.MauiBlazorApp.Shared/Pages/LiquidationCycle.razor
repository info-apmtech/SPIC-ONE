                        <div class="lc-horiz-track">
                            <div class="lc-horiz-fill bg-green-400" style="width: 45%;"></div>
                        </div>
                        <div class="lc-horiz-val">58%</div>
                        
                        <!-- Hover Tooltip -->
                        <div class="lc-horiz-tooltip">
                            <div class="lc-tt-title">Surya Export</div>
                            <div class="lc-tt-row"><span>Total Transaction</span><span class="lc-tt-bold">1,248</span></div>
