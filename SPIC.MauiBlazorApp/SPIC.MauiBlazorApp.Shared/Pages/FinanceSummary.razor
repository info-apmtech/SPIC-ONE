@page "/FinanceSummary"
@page "/FinanceSummaryOverall"
@inject SPIC.MauiBlazorApp.Shared.Services.ToastService Toast
@inject NavigationManager Nav

<PageTitle>Finance Summary (Overall) · SPIC ONE</PageTitle>

<div class="container-fluid py-4 px-0 fs-page">
    <div class="fs-wrapper">

        <!-- Top Header -->
        <div class="fs-header">
            <div class="fs-header-left">
                <div class="fs-title-row">
                    <h1>Finance Summary (Overall)</h1>
                    <span class="fs-badge-ready">Ready to submit</span>
                </div>
                <p class="fs-subtitle">View overall financial performance based on 15-day reports for the selected financial year</p>
            </div>

            <div class="fs-header-actions">
                <!-- Back to List Button -->
                <button type="button" class="fs-btn-back" @onclick="GoBack">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="19" y1="12" x2="5" y2="12"></line>
                        <polyline points="12 19 5 12 12 5"></polyline>
                    </svg>
                    Back to List
                </button>

                <!-- Financial Year Select -->
                <div class="fs-select-wrapper">
                    <span class="fs-select-label">Financial Year:</span>
                    <select class="fs-header-select" @bind="SelectedFinancialYear">
                        <option value="2026-27">2026-27</option>
                        <option value="2025-26">2025-26</option>
                        <option value="2024-25">2024-25</option>
                    </select>
                </div>

                <!-- View Mode Select -->
                <div class="fs-select-wrapper">
                    <span class="fs-select-label">View:</span>
                    <select class="fs-header-select" @bind="SelectedViewMode">
                        <option value="15-day">15-Day View</option>
                        <option value="monthly">Monthly View</option>
                        <option value="quarterly">Quarterly View</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Metric KPI Cards (5 Cards) -->
        <div class="fs-stats-grid">
            <!-- 1. Annual Budget -->
            <div class="fs-stat-card">
                <div class="fs-stat-text">
                    <p class="fs-stat-title">Annual Budget</p>
                    <h2>₹23,45,000</h2>
                    <span class="fs-stat-desc">Financial Year 2026-27</span>
                </div>
                <div class="fs-stat-icon fs-tone-purple" title="Annual Budget">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                </div>
            </div>

            <!-- 2. Total Income -->
            <div class="fs-stat-card">
                <div class="fs-stat-text">
                    <p class="fs-stat-title">Total Income</p>
                    <h2>₹ 10,00,000</h2>
                    <span class="fs-stat-desc">Till Date (01 Apr - 15 Sep)</span>
                </div>
                <div class="fs-stat-icon fs-tone-green" title="Total Income">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect width="16" height="20" x="4" y="2" rx="2"></rect>
                        <path d="m9 14 3-3 3 3"></path>
                        <path d="M12 11v6"></path>
                    </svg>
                </div>
            </div>

            <!-- 3. Total Expense -->
            <div class="fs-stat-card">
                <div class="fs-stat-text">
                    <p class="fs-stat-title">Total Expense</p>
                    <h2>₹ 4,00,000</h2>
                    <span class="fs-stat-desc">Till Date ( 01 Apr - 15 Sep)</span>
                </div>
                <div class="fs-stat-icon fs-tone-red" title="Total Expense">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                </div>
            </div>

            <!-- 4. Net Profit -->
            <div class="fs-stat-card">
                <div class="fs-stat-text">
                    <p class="fs-stat-title">Net Profit</p>
                    <h2>₹ 6,00,000</h2>
                    <span class="fs-stat-desc">Till Date</span>
                </div>
                <div class="fs-stat-icon fs-tone-blue" title="Net Profit">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="16" y1="13" x2="8" y2="13"></line>
                        <line x1="16" y1="17" x2="8" y2="17"></line>
                        <polyline points="10 9 9 9 8 9"></polyline>
                    </svg>
                </div>
            </div>

            <!-- 5. ROI -->
            <div class="fs-stat-card">
                <div class="fs-stat-text">
                    <p class="fs-stat-title">ROI</p>
                    <h2>25.6%</h2>
                    <span class="fs-stat-desc">Till Date (Profit / Budget)</span>
                </div>
                <div class="fs-stat-icon fs-tone-yellow" title="ROI">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 14 10"></polyline>
                    </svg>
                </div>
            </div>
        </div>

        <!-- Analytics Validation Trend Chart Section -->
        <div class="fs-card fs-chart-card">
            <div class="fs-card-header">
                <h3>Analytics Validation Trend</h3>

                <div class="fs-chart-controls">
                    <!-- Legend -->
                    <div class="fs-chart-legend">
                        <span class="fs-legend-item">
                            <span class="fs-legend-dot fs-dot-income"></span>
                            Income
                        </span>
                        <span class="fs-legend-item">
                            <span class="fs-legend-dot fs-dot-expense"></span>
                            Expense
                        </span>
                        <span class="fs-legend-item">
                            <span class="fs-legend-dot fs-dot-profit"></span>
                            Net Profit
                        </span>
                    </div>

                    <!-- Range Selector -->
                    <select class="fs-chart-select" @bind="SelectedChartRange">
                        <option value="6m">Last 6 Months</option>
                        <option value="3m">Last 3 Months</option>
                        <option value="1y">Last 1 Year</option>
                    </select>
                </div>
            </div>

            <div class="fs-chart-container">
                <svg viewBox="0 0 1000 320" class="fs-svg-chart" preserveAspectRatio="none">
                    <!-- Grid Lines & Y-Labels -->
                    @for (int i = 0; i < YGridLevels.Length; i++)
                    {
                        var y = 20 + i * 36;
                        <line x1="50" y1="@y" x2="980" y2="@y" stroke="#f1f5f9" stroke-width="1" stroke-dasharray="3,3" />
                        @((MarkupString)$"<text x=\"40\" y=\"{y + 4}\" text-anchor=\"end\" class=\"fs-axis-label\">{YGridLevels[i]}</text>")
                    }

                    <!-- Y-Axis Title -->
                    <text x="12" y="160" transform="rotate(-90 12 160)" text-anchor="middle" class="fs-axis-title">Amount (₹)</text>

                    <!-- Baseline -->
                    <line x1="50" y1="272" x2="980" y2="272" stroke="#e2e8f0" stroke-width="1.2" />

                    <!-- Clustered Period Bars -->
                    @for (int p = 0; p < PeriodData.Count; p++)
                    {
                        var item = PeriodData[p];
                        var groupX = 75 + p * 81;
                        var incomeBarH = (item.Income / 350000.0) * 252;
                        var expenseBarH = (item.Expense / 350000.0) * 252;
                        var incomeY = 272 - incomeBarH;
                        var expenseY = 272 - expenseBarH;
                        var isHighlighted = (p == ActiveTooltipIndex);

                        <!-- Income Bar (Green) -->
                        <rect x="@(groupX - 10)" y="@incomeY" width="16" height="@incomeBarH"
                              rx="3" ry="3" class="fs-bar-income @(isHighlighted ? "fs-bar-active" : "")"
                              @onclick="() => SetActivePeriod(p)" />

                        <!-- Expense Bar (Pink/Coral) -->
                        <rect x="@(groupX + 8)" y="@expenseY" width="16" height="@expenseBarH"
                              rx="3" ry="3" class="fs-bar-expense @(isHighlighted ? "fs-bar-active" : "")"
                              @onclick="() => SetActivePeriod(p)" />

                        <!-- X Label -->
                        @((MarkupString)$"<text x=\"{groupX + 7}\" y=\"292\" text-anchor=\"middle\" class=\"fs-x-label\">{item.Period}</text>")
                    }

                    <!-- Net Profit Line Curve -->
                    <path d="@NetProfitSvgPath" fill="none" stroke="#3b82f6" stroke-width="2.5" class="fs-line-profit" />

                    <!-- Point Dots -->
                    @for (int p = 0; p < PeriodData.Count; p++)
                    {
                        var item = PeriodData[p];
                        var groupX = 75 + p * 81 + 7;
                        var profitY = 272 - (item.NetProfit / 350000.0) * 252;
                        <circle cx="@groupX" cy="@profitY" r="4" fill="#3b82f6" stroke="#ffffff" stroke-width="2"
                                class="fs-profit-point" @onclick="() => SetActivePeriod(p)" />
                    }

                    <!-- Active Tooltip Callout -->
                    @if (ActiveTooltipIndex >= 0 && ActiveTooltipIndex < PeriodData.Count)
                    {
                        var activeItem = PeriodData[ActiveTooltipIndex];
                        var tX = 75 + ActiveTooltipIndex * 81 + 7;
                        var tY = 90;

                        <g class="fs-chart-tooltip-group" transform="translate(@(tX - 52), @tY)">
                            <rect width="105" height="92" rx="6" ry="6" fill="#ffffff" stroke="#e2e8f0" filter="drop-shadow(0 4px 6px rgba(0,0,0,0.06))" />
                            @((MarkupString)$"<text x=\"12\" y=\"22\" font-size=\"11\" font-weight=\"700\" fill=\"#1e293b\">{activeItem.Period}</text>")
                            @((MarkupString)"<text x=\"12\" y=\"42\" font-size=\"10\" fill=\"#64748b\">Income</text>")
                            @((MarkupString)"<text x=\"92\" y=\"42\" text-anchor=\"end\" font-size=\"10\" font-weight=\"700\" fill=\"#10b981\">24</text>")
                            @((MarkupString)"<text x=\"12\" y=\"60\" font-size=\"10\" fill=\"#64748b\">Expense:</text>")
                            @((MarkupString)"<text x=\"92\" y=\"60\" text-anchor=\"end\" font-size=\"10\" font-weight=\"700\" fill=\"#f43f5e\">24</text>")
                            @((MarkupString)"<text x=\"12\" y=\"78\" font-size=\"10\" fill=\"#64748b\">Net Profit</text>")
                            @((MarkupString)"<text x=\"92\" y=\"78\" text-anchor=\"end\" font-size=\"10\" font-weight=\"700\" fill=\"#3b82f6\">24</text>")
                        </g>
                    }
                </svg>
            </div>
        </div>

        <!-- 15 Day Report History Table Section -->
        <div class="fs-card fs-table-card">
            <div class="fs-table-top-bar">
                <h3>15 Day Report History</h3>

                <div class="fs-table-actions">
                    <!-- From Date Picker -->
                    <div class="fs-date-picker-box">
                        <span class="fs-date-label">From Date:</span>
                        <input type="text" class="fs-date-input" value="01-04-2026" readonly />
                        <svg class="fs-chevron-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </div>

                    <!-- To Date Picker -->
                    <div class="fs-date-picker-box">
                        <span class="fs-date-label">To Date:</span>
                        <input type="text" class="fs-date-input" value="01-04-2026" readonly />
                        <svg class="fs-chevron-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </div>

                    <!-- Download Excel Button -->
                    <button type="button" class="fs-btn-download-excel" @onclick="DownloadExcel">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="8" y1="13" x2="16" y2="13"></line>
                            <line x1="8" y1="17" x2="16" y2="17"></line>
                            <polyline points="10 9 9 9 8 9"></polyline>
                        </svg>
                        Download Excel
                    </button>
                </div>
            </div>

            <div class="fs-table-wrapper">
                <table class="fs-main-table">
                    <thead>
                        <tr>
                            <th class="fs-th-sno">S:No</th>
                            <th>Reporting Period</th>
                            <th>Income (₹)</th>
                            <th>Expense (₹)</th>
                            <th>Net Result ₹</th>
                            <th>Status</th>
                            <th class="fs-th-action">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in DisplayedRows)
                        {
                            <tr>
                                <td class="fs-td-sno">@row.SNo</td>
                                <td class="fs-td-period">@row.Period</td>
                                <td class="fs-td-income">@row.Income.ToString("N0", new System.Globalization.CultureInfo("en-IN"))</td>
                                <td class="fs-td-expense">@row.Expense.ToString("N0", new System.Globalization.CultureInfo("en-IN"))</td>
                                <td class="fs-td-profit">@row.NetResult.ToString("N0", new System.Globalization.CultureInfo("en-IN"))</td>
                                <td>
                                    <span class="fs-status-pill fs-status-submitted">@row.Status</span>
                                </td>
                                <td class="fs-td-action">
                                    <button type="button" class="fs-btn-icon-action" title="View details" @onclick="() => ViewReportDetails(row)">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
                                            <circle cx="12" cy="12" r="3"></circle>
                                        </svg>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination (Reference: ExtensionRequestList.razor) -->
            <div class="fs-pagination">
                <div class="fs-page-size">
                    <span>Items Per Page</span>
                    <select class="fs-page-size-select" @bind="PageSize" @bind:after="ResetPage">
                        <option value="16">16</option>
                        <option value="32">32</option>
                        <option value="50">50</option>
                    </select>
                </div>

                <div class="fs-page-controls">
                    <button class="fs-page-btn" disabled="@(CurrentPage <= 1)" @onclick="() => GoToPage(CurrentPage - 1)" aria-label="Previous page">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="15 18 9 12 15 6"></polyline>
                        </svg>
                    </button>

                    @foreach (var p in PageNumbers)
                    {
                        if (p == -1)
                        {
                            <span class="fs-page-btn fs-dots">..</span>
                        }
                        else
                        {
                            <button class="fs-page-btn @(p == CurrentPage ? "active" : "")" @onclick="() => GoToPage(p)">@p</button>
                        }
                    }

                    <button class="fs-page-btn" disabled="@(CurrentPage >= TotalPages)" @onclick="() => GoToPage(CurrentPage + 1)" aria-label="Next page">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                    </button>
                </div>
            </div>
        </div>

    </div>
</div>

@code {
    private string SelectedFinancialYear = "2026-27";
    private string SelectedViewMode = "15-day";
    private string SelectedChartRange = "6m";
    private int ActiveTooltipIndex = 2;

    private readonly string[] YGridLevels = new[] { "3.5L", "3L", "2.5L", "2L", "1.5L", "1L", "50K", "0" };

    private record ChartPeriodItem(string Period, double Income, double Expense, double NetProfit);

    private readonly List<ChartPeriodItem> PeriodData = new()
    {
        new("01-15 Sep", 100000, 75000, 75000),
        new("01-15 Sep", 120000, 85000, 65000),
        new("01-15 Sep", 150000, 95000, 80000),
        new("01-15 Sep", 95000, 80000, 55000),
        new("01-15 Sep", 115000, 35000, 30000),
        new("01-15 Sep", 95000, 25000, 35000),
        new("01-15 Sep", 110000, 70000, 65000),
        new("01-15 Sep", 195000, 120000, 110000),
        new("01-15 Sep", 165000, 60000, 55000),
        new("01-15 Sep", 100000, 35000, 30000),
        new("01-15 Sep", 95000, 25000, 25000),
    };

    private string NetProfitSvgPath
    {
        get
        {
            var points = PeriodData.Select((item, p) =>
            {
                var x = 75 + p * 81 + 7;
                var y = 272 - (item.NetProfit / 350000.0) * 252;
                return $"{x},{y:0.#}";
            }).ToList();

            if (!points.Any()) return "";
            return "M " + string.Join(" L ", points);
        }
    }

    private void SetActivePeriod(int index) => ActiveTooltipIndex = index;

    public record ReportHistoryRow(string SNo, string Period, int Income, int Expense, int NetResult, string Status);

    private readonly List<ReportHistoryRow> AllHistoryRows = new()
    {
        new("1", "01 - 15 Jan", 80000, 45000, 35000, "Submitted"),
        new("2", "16 - 21 Jan", 80000, 45000, 35000, "Submitted"),
        new("3", "01 - 15 Feb", 80000, 45000, 35000, "Submitted"),
        new("4", "16 - 21 Feb", 80000, 45000, 35000, "Submitted"),
        new("5", "01 - 15 Mar", 80000, 45000, 35000, "Submitted"),
        new("6", "16 - 21 Mar", 80000, 45000, 35000, "Submitted"),
        new("7", "01 - 15 Apr", 80000, 45000, 35000, "Submitted"),
        new("8", "16 - 21 Apr", 80000, 45000, 35000, "Submitted"),
        new("9", "01 - 15 May", 80000, 45000, 35000, "Submitted"),
        new("10", "16 - 21 May", 80000, 45000, 35000, "Submitted"),
        new("-", "01 - 15 Jun", 80000, 45000, 35000, "Submitted"),
    };

    private int CurrentPage = 1;
    private int PageSize = 16;
    private int TotalPages => 10; // Matches mock pagination with pages up to 10

    private IEnumerable<ReportHistoryRow> DisplayedRows => AllHistoryRows;

    private IEnumerable<int> PageNumbers
    {
        get
        {
            return new List<int> { 1, 2, 3, -1, 8, 9, 10 };
        }
    }

    private void GoToPage(int page) => CurrentPage = Math.Clamp(page, 1, TotalPages);
    private void ResetPage() => CurrentPage = 1;

    private void GoBack() => Nav.NavigateTo("/FarmDashboard");

    private void DownloadExcel() => Toast.Success("Exporting 15-day report history to Excel...");

    private void ViewReportDetails(ReportHistoryRow row)
    {
        Toast.Info($"Viewing report for period: {row.Period} (Net: ₹{row.NetResult:N0})");
    }
}
