@page "/csrplandetails2"

<div class="container-fluid py-4 px-0">
    <div class="csrpd-wrapper">

        <h1 class="csrpd-heading">CSR-2 Management</h1>

        <!-- Metrics -->
        <div class="csrpd-metrics-grid">
            <div class="csrpd-metric-tile csrpd-mint">
                <div class="csrpd-metric-info">
                    <div class="csrpd-metric-caption">Approved Budget</div>
                    <div class="csrpd-metric-amount csrpd-text-mint">₹ 50,00,000</div>
                </div>
                <div class="csrpd-metric-badge csrpd-badge-mint">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="8" width="18" height="12" rx="2" />
                        <path d="M7 8V6a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v2" />
                        <line x1="12" y1="12" x2="12" y2="16" />
                        <line x1="10" y1="14" x2="14" y2="14" />
                    </svg>
                </div>
            </div>

            <div class="csrpd-metric-tile csrpd-sky">
                <div class="csrpd-metric-info">
                    <div class="csrpd-metric-caption">Actual Expense</div>
                    <div class="csrpd-metric-amount csrpd-text-sky">₹ 55,000</div>
                </div>
                <div class="csrpd-metric-badge csrpd-badge-sky">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="9" />
                        <path d="M12 8v4l3 3" />
                    </svg>
                </div>
            </div>

            <div class="csrpd-metric-tile csrpd-violet">
                <div class="csrpd-metric-info">
                    <div class="csrpd-metric-caption">Difference</div>
                    <div class="csrpd-metric-amount csrpd-text-violet csrpd-amount-sm">₹50,000 (Saved)</div>
                </div>
                <div class="csrpd-metric-badge csrpd-badge-violet">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="9" />
                        <path d="M9 12l2 2 4-4" />
                    </svg>
                </div>
            </div>
        </div>

        <!-- CSR-2 Plan Details -->
        <div class="csrpd-panel">
            <h2 class="csrpd-panel-title">CSR-2 Plan Details</h2>

            <div class="csrpd-form-grid">
                <div class="csrpd-form-group">
                    <label>Program Type</label>
                    <select class="csrpd-control csrpd-select">
                        <option value="" disabled selected hidden>Select program type</option>
                        <option>Education</option>
                        <option>Healthcare</option>
                        <option>Environment</option>
                        <option>Rural Development</option>
                    </select>
                </div>
                <div class="csrpd-form-group">
                    <label>Program Name</label>
                    <select class="csrpd-control csrpd-select">
                        <option value="" disabled selected hidden>Select program name</option>
                        <option>Crop Support Initiative</option>
                        <option>Farmer Welfare Scheme</option>
                    </select>
                </div>
                <div class="csrpd-form-group">
                    <label>Number of Programs</label>
                    <input type="number" class="csrpd-control" placeholder="Enter number of programs" min="0" />
                </div>

                <div class="csrpd-form-group">
                    <label>Budget</label>
                    <input type="number" class="csrpd-control" placeholder="Enter budget" min="0" />
                </div>
                <div class="csrpd-form-group">
                    <label>HQ</label>
                    <select class="csrpd-control csrpd-select">
                        <option value="" disabled selected hidden>Select HQ</option>
                        <option>Mumbai</option>
                        <option>Delhi</option>
                        <option>Bangalore</option>
                        <option>Chennai</option>
                    </select>
                </div>
                <div class="csrpd-form-group">
                    <label>Location</label>
                    <select class="csrpd-control csrpd-select">
                        <option value="" disabled selected hidden>select location</option>
                        <option>Maharashtra</option>
                        <option>Karnataka</option>
                        <option>Tamil Nadu</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Focus Details (3-card grid) -->
        <div class="csrpd-panel">
            <h2 class="csrpd-panel-title">Focus Details</h2>

            <div class="csrpd-focus-grid">
                @for (int i = 0; i < 3; i++)
                {
                    <div class="csrpd-focus-card">
                        <div class="csrpd-form-group">
                            <label>Focused Crop</label>
                            <select class="csrpd-control csrpd-select">
                                <option value="" disabled selected hidden>Select Crop</option>
                                <option>Rice</option>
                                <option>Wheat</option>
                                <option>Cotton</option>
                                <option>Sugarcane</option>
                            </select>
                        </div>
                        <div class="csrpd-form-group">
                            <div class="csrpd-label-row">
                                <label>Focused Product</label>
                                <span class="csrpd-chip">
                                    Product 1
                                    <button class="csrpd-chip-remove" type="button" aria-label="Remove">
                                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="18" y1="6" x2="6" y2="18"></line>
                                            <line x1="6" y1="6" x2="18" y2="18"></line>
                                        </svg>
                                    </button>
                                </span>
                            </div>
                            <select class="csrpd-control csrpd-select">
                                <option value="" disabled selected hidden>Select Crop</option>
                                <option>Fertilizer</option>
                                <option>Pesticide</option>
                                <option>Seeds</option>
                            </select>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Expense Breakdown -->
        <div class="csrpd-panel">
            <h2 class="csrpd-panel-title">Expense Breakdown</h2>

            <div class="csrpd-expense-grid">

                @foreach (var label in ExpenseCategories)
                {
                    <div class="csrpd-expense-item">
                        <div class="csrpd-expense-fields">
                            <div class="csrpd-form-group">
                                <label>@label</label>
                                <input type="number" class="csrpd-control" value="0" min="0" />
                            </div>
                            <div class="csrpd-form-group">
                                <label>Date</label>
                                <div class="csrpd-input-with-icon">
                                    <input type="text" class="csrpd-control" placeholder="dd - mm - yyyy" />
                                    <svg class="csrpd-input-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                        <line x1="16" y1="2" x2="16" y2="6"></line>
                                        <line x1="8" y1="2" x2="8" y2="6"></line>
                                        <line x1="3" y1="10" x2="21" y2="10"></line>
                                    </svg>
                                </div>
                            </div>
                        </div>
                        <button class="csrpd-upload-btn" type="button">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                                <polyline points="17 8 12 3 7 8" />
                                <line x1="12" y1="3" x2="12" y2="15" />
                            </svg>
                            Upload proof
                        </button>
                    </div>
                }

            </div>

            <div class="csrpd-others-row">
                <div class="csrpd-form-group">
                    <label>Others</label>
                    <input type="number" class="csrpd-control" value="0" min="0" />
                </div>
            </div>
        </div>

        <!-- Action Bar -->
        <div class="csrpd-actions">
            <button class="csrpd-btn csrpd-btn-ghost" type="button">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" />
                    <polyline points="17 21 17 13 7 13 7 21" />
                    <polyline points="7 3 7 8 15 8" />
                </svg>
                Save Draft
            </button>
            <button class="csrpd-btn csrpd-btn-primary" type="button">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="22" y1="2" x2="11" y2="13" />
                    <polygon points="22 2 15 22 11 13 2 9 22 2" />
                </svg>
                Submit CSR-2
            </button>
        </div>

    </div>
</div>

@code {
    private readonly string[] ExpenseCategories = new[]
    {
        "Printing & Stationary",
        "Publicity Material",
        "Stage Arrangements",
        "Service Charges – LCA",
        "Transport / Rent",
        "Jeep Running Expenses",
        "Refreshments",
        "Inputs",
        "Compliments",
        "Photography"
    };
}