    </button>
  </div>
</div>

<!-- Expense Breakdown -->
<div class="csr-panel">
  <div class="csr-panel-heading">Expense Breakdown</div>
  <div class="breakdown-grid">

    <div class="breakdown-item">
      <label>Printing &amp; Stationary</label>
      <div class="breakdown-input-row">
        <input type="number" value="0" min="0">
        <button class="proof-upload-btn" onclick="uploadProof(this)">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          Upload proof
        </button>
      </div>
    </div>

    <div class="breakdown-item">
      <label>Publicity Material</label>
      <div class="breakdown-input-row">
        <input type="number" value="0" min="0">
        <button class="proof-upload-btn" onclick="uploadProof(this)">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          Upload proof
        </button>
      </div>
    </div>

    <div class="breakdown-item">
      <label>Stage Arrangements</label>
      <div class="breakdown-input-row">
        <input type="number" value="0" min="0">
        <button class="proof-upload-btn" onclick="uploadProof(this)">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          Upload proof
        </button>
      </div>
    </div>

    <div class="breakdown-item">
      <label>Service Charges – LCA</label>
      <div class="breakdown-input-row">
        <input type="number" value="0" min="0">
        <button class="proof-upload-btn" onclick="uploadProof(this)">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          Upload proof
        </button>
      </div>
    </div>

    <div class="breakdown-item">
      <label>Transport / Rent</label>
      <div class="breakdown-input-row">
        <input type="number" value="0" min="0">
        <button class="proof-upload-btn" onclick="uploadProof(this)">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          Upload proof
        </button>
      </div>
    </div>

    <div class="breakdown-item">
      <label>Jeep Running Expenses</label>
      <div class="breakdown-input-row">
        <input type="number" value="0" min="0">
        <button class="proof-upload-btn" onclick="uploadProof(this)">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          Upload proof
        </button>
      </div>
    </div>

    <div class="breakdown-item">
      <label>Refreshments</label>
      <div class="breakdown-input-row">
        <input type="number" value="0" min="0">
        <button class="proof-upload-btn" onclick="uploadProof(this)">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          Upload proof
        </button>
      </div>
    </div>

    <div class="breakdown-item">
      <label>Inputs</label>
      <div class="breakdown-input-row">
        <input type="number" value="0" min="0">
        <button class="proof-upload-btn" onclick="uploadProof(this)">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          Upload proof
        </button>
      </div>
    </div>

    <div class="breakdown-item">
      <label>Compliments</label>
      <div class="breakdown-input-row">
        <input type="number" value="0" min="0">
        <button class="proof-upload-btn" onclick="uploadProof(this)">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          Upload proof
        </button>
      </div>
    </div>

    <div class="breakdown-item">
      <label>Photography</label>
      <div class="breakdown-input-row">
        <input type="number" value="0" min="0">
        <button class="proof-upload-btn" onclick="uploadProof(this)">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
