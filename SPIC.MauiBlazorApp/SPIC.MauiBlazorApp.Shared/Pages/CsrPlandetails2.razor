  <div class="tri-col-grid">
    <div class="input-unit">
      <label>Budget</label>
      <input type="number" placeholder="Enter budget" min="0">
    </div>
    <div class="input-unit">
      <label>HQ</label>
      <select>
        <option value="">Select HQ</option>
        <option>Mumbai</option>
        <option>Delhi</option>
        <option>Bangalore</option>
        <option>Chennai</option>
        <option>Hyderabad</option>
      </select>
    </div>
    <div class="input-unit">
      <label>Location</label>
      <select>
        <option value="">select location</option>
        <option>Maharashtra</option>
        <option>Karnataka</option>
        <option>Tamil Nadu</option>
        <option>Telangana</option>
        <option>Gujarat</option>
      </select>
    </div>
  </div>
</div>

<!-- Focus Details -->
<div class="csr-panel">
  <div class="csr-panel-heading">Focus Details</div>
  <div class="dual-crop-row">
    <div class="input-unit">
      <label>Focused Crop</label>
      <select>
        <option value="">Select Crop</option>
        <option>Rice</option>
        <option>Wheat</option>
        <option>Cotton</option>
        <option>Sugarcane</option>
        <option>Maize</option>
      </select>
    </div>
    <button class="crop-add-btn" onclick="addCrop('crop')">
      <svg viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round">
        <line x1="12" y1="5" x2="12" y2="19"/>
        <line x1="5" y1="12" x2="19" y2="12"/>
      </svg>
      Add Crop
    </button>
    <div class="input-unit">
      <label>Focused Product</label>
      <select>
        <option value="">Select Product</option>
        <option>Fertilizer</option>
        <option>Pesticide</option>
        <option>Seeds</option>
        <option>Equipment</option>
      </select>
    </div>
    <button class="crop-add-btn" onclick="addCrop('product')">
      <svg viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round">
        <line x1="12" y1="5" x2="12" y2="19"/>
        <line x1="5" y1="12" x2="19" y2="12"/>
      </svg>
