<!-- Footer -->
<div class="action-bar">
  <button class="draft-save-btn" onclick="saveDraft()">
    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
      <polyline points="17 21 17 13 7 13 7 21"/>
      <polyline points="7 3 7 8 15 8"/>
    </svg>
    Save Draft
  </button>
  <button class="form-submit-btn" onclick="submitForm()">
    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="22" y1="2" x2="11" y2="13"/>
      <polygon points="22 2 15 22 11 13 2 9 22 2"/>
    </svg>
    Submit CSR-1
  </button>
</div>

<script>
  function uploadProof(btn) {
    const inp = document.createElement('input');
    inp.type = 'file';
    inp.accept = 'image/*,.pdf,.doc,.docx';
    inp.onchange = function(e) {
      const file = e.target.files[0];
      if (file) {
        btn.style.background = '#16a34a';
        btn.innerHTML = '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg> Uploaded';
        setTimeout(() => {
          btn.style.background = '';
          btn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg> Upload proof';
        }, 3000);
      }
    };
    inp.click();
  }

  function addCrop(type) {
    alert('Add ' + (type === 'crop' ? 'Crop' : 'Product') + ' functionality triggered.');
  }

  function saveDraft() {
    const btn = document.querySelector('.draft-save-btn');
    btn.textContent = '✓ Draft Saved';
    btn.style.color = '#16a34a';
    btn.style.borderColor = '#16a34a';
    setTimeout(() => {
      btn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="15" height="15"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg> Save Draft';
      btn.style.color = '';
      btn.style.borderColor = '';
    }, 2000);
  }

  function submitForm() {
    const allSelects = document.querySelectorAll('.csr-panel select');
    let valid = true;
    allSelects.forEach(s => {
      if (!s.value) {
        s.style.borderColor = '#ef4444';
        valid = false;
        setTimeout(() => s.style.borderColor = '', 2000);
      }
    });
    if (valid) {
      const btn = document.querySelector('.form-submit-btn');
      btn.textContent = '✓ Submitted!';
      btn.style.background = '#16a34a';
      setTimeout(() => {
        btn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="15" height="15"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg> Submit CSR-1';
        btn.style.background = '';
      }, 2500);
    }
  }
</script>


