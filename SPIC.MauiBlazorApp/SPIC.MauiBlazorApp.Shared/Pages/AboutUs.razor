@page "/about-us"
    <style>
            :root {
                --page-bg: #f4f8fb;
                --card-bg: #ffffff;
                --info-bg: #eef4ff;
                --info-border: #d6e3ff;
                --primary-text: #1f2937;
                --muted-text: #6b7280;
                --brand-blue: #002574;
                --radius-lg: 24px;
                --radius-md: 18px;
            }

          /*   body {
                margin: 0;
                font-family: Arial, Helvetica, sans-serif;
                background: var(--page-bg);
                color: var(--primary-text);
            } */

            .about-section {
                padding: 28px 16px 42px;
                background: var(--page-bg);
            }

            .section-title {
                font-size: 28px;
                font-weight: 600;
                margin-bottom: 8px;
                color: #243142;
            }

            .section-subtitle {
                font-size: 15px;
                color: #3f4b5b;
                margin-bottom: 26px;
            }

            .stat-card {
                background: var(--card-bg);
                border: 1px solid #e5ebf0;
                border-radius: var(--radius-lg);
                min-height: 138px;
                display: flex;
                align-items: center;
                justify-content: center;
                text-align: center;
                box-shadow: 0 2px 6px rgba(15, 23, 42, 0.05);
                transition: transform 0.25s ease, box-shadow 0.25s ease;
            }

                .stat-card:hover {
                    transform: translateY(-4px);
                    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.09);
                }

            .stat-icon {
                width: 42px;
                height: 42px;
                object-fit: contain;
                margin-bottom: 16px;
            }

            .stat-number {
                font-size: 25px;
                font-weight: 700;
                line-height: 1;
                color: #1f2937;
                margin-bottom: 14px;
            }

            .stat-label {
                font-size: 15px;
                color: #6f5f5a;
                margin: 0;
            }

            .team-image {
                width: 100%;
                height: 100%;
                min-height: 360px;
                object-fit: cover;
                border-radius: var(--radius-lg);
                display: block;
            }

            .info-card,
            .mini-card {
                background: var(--info-bg);
                border: 1px solid var(--info-border);
                border-radius: var(--radius-lg);
                color: #354155;
            }

            .info-card {
                padding: 28px 28px 30px;
                min-height: 206px;
            }

            .mini-card {
                padding: 24px 24px 25px;
                min-height: 145px;
            }

            .card-heading {
                font-size: 16px;
                font-weight: 700;
                color: var(--brand-blue);
                margin-bottom: 24px;
            }

            .info-card .card-heading {
                margin-bottom: 24px;
            }

            .card-text {
                font-size: 13px;
                line-height: 1.45;
                color: #344054;
                margin-bottom: 18px;
            }

                .card-text:last-child {
                    margin-bottom: 0;
                }

            .mini-card .card-text {
                margin-bottom: 0;
            }

            @@media (max-width: 991.98px) {
                .section-title {
                    font-size: 25px;
                }

                .team-image {
                    min-height: 320px;
                }

                .info-card,
                .mini-card {
                    padding: 22px;
                }
            }

            @@media (max-width: 575.98px) {
                .about-section {
                    padding: 22px 12px 32px;
                }

                .section-title {
                    font-size: 23px;
                }

                .section-subtitle {
                    font-size: 14px;
                }

                .stat-card {
                    min-height: 126px;
                    border-radius: 20px;
                }

                .stat-icon {
                    width: 36px;
                    height: 36px;
                    margin-bottom: 12px;
                }

                .stat-number {
                    font-size: 22px;
                    margin-bottom: 10px;
                }

                .stat-label {
                    font-size: 14px;
                }

                .team-image {
                    min-height: 260px;
                    border-radius: 20px;
                }

                .info-card,
                .mini-card {
                    border-radius: 20px;
                    padding: 20px;
                }

                .card-heading {
                    margin-bottom: 16px;
                }
            }
    </style>
    <section class="about-section">
        <div class="container-fluid">
            <div class="mb-4">
                <h2 class="section-title">About Us</h2>
                <p class="section-subtitle">Discover the story of SPIC Dealers' Welfare Association</p>
            </div>

            <!-- Stats -->
            <div class="row g-4 mb-4">
                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="stat-card">
                        <div>
                            <img class="stat-icon" src="https://cdn-icons-png.flaticon.com/512/2583/2583344.png" alt="Happy Dealers">
                            <div class="stat-number">2100+</div>
                            <p class="stat-label">Happy Dealers</p>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="stat-card">
                        <div>
                            <img class="stat-icon" src="https://cdn-icons-png.flaticon.com/512/2382/2382533.png" alt="Welfare Schemes">
                            <div class="stat-number">5222+</div>
                            <p class="stat-label">Welfare Schemes</p>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="stat-card">
                        <div>
                            <img class="stat-icon" src="https://cdn-icons-png.flaticon.com/512/3135/3135706.png" alt="Years of Service">
                            <div class="stat-number">28</div>
                            <p class="stat-label">Years of Service</p>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="stat-card">
                        <div>
                            <img class="stat-icon" src="https://cdn-icons-png.flaticon.com/512/3063/3063822.png" alt="Hard Workers">
                            <div class="stat-number">20+</div>
                            <p class="stat-label">Hard Workers</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Main Content -->
            <div class="row g-4 align-items-stretch">
                <div class="col-12 col-lg-6">
                    <img class="team-image"
                         src="https://images.unsplash.com/photo-1529156069898-49953e39b3ac?auto=format&fit=crop&w=900&q=80"
                         alt="Team putting hands together">
                </div>

                <div class="col-12 col-lg-6">
                    <div class="row g-4 h-100">
                        <div class="col-12">
                            <div class="info-card">
                                <h3 class="card-heading">About Us</h3>
                                <p class="card-text">
                                    The SPIC Dealers' Welfare Association (SDWA) was established in 1993 following the visionary guidance of Dr. A. C. Muthaiah, who emphasized the importance of dealer welfare alongside company growth.
                                </p>
                                <p class="card-text">
                                    Today, under the leadership of Mr. Ashwin C. Muthaiah, SDWA continues to serve over 2,100 dealers across Tamil Nadu, providing comprehensive welfare schemes and fostering a community of mutual growth and prosperity.
                                </p>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="mini-card h-100">
                                <h3 class="card-heading">Our Mission</h3>
                                <p class="card-text">
                                    To ensure the welfare, growth, and prosperity of all SPIC dealers through comprehensive support and welfare schemes.
                                </p>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="mini-card h-100">
                                <h3 class="card-heading">Our Vision</h3>
                                <p class="card-text">
                                    To create a sustainable ecosystem where dealers and SPIC grow together, building long-term success and community strength.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

  
