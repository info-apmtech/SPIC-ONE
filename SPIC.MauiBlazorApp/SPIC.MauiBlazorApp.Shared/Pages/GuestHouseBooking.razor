@page "/GuestHouseBooking"
@using System.Globalization
@inject NavigationManager Navigation

<div class="container-fluid py-4 px-0">
    <div class="ghb-wrapper">

        <div class="ghb-header-text">
            <h1>Guest House Booking</h1>
            <p>Book your room and enjoy a comfortable stay at SDWA Guest House</p>
        </div>

        <div class="ghb-card">

            <div class="ghb-badge">@_houseName</div>

            <div class="ghb-form-grid">

                <div class="ghb-form-group">
                    <label class="ghb-form-label">Check-in Date</label>
                    <div class="ghb-input-with-icon">
                        <input type="text" class="ghb-form-control" placeholder="dd-mm-yyyy" @bind="_checkInDate">
                        <svg class="ghb-input-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                    </div>
                </div>

                <div class="ghb-form-group">
                    <label class="ghb-form-label">Check-in Time</label>
                    <div class="ghb-input-with-icon">
                        <input type="text" class="ghb-form-control" placeholder="--:-- AM" @bind="_checkInTime">
                        <svg class="ghb-input-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                    </div>
                </div>

                <div class="ghb-form-group">
                    <label class="ghb-form-label">Check-out Date</label>
                    <div class="ghb-input-with-icon">
                        <input type="text" class="ghb-form-control" placeholder="dd-mm-yyyy" @bind="_checkOutDate">
                        <svg class="ghb-input-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                    </div>
                </div>

                <div class="ghb-form-group">
                    <label class="ghb-form-label">Check-out Time</label>
                    <div class="ghb-input-with-icon">
                        <input type="text" class="ghb-form-control" placeholder="--:-- AM" @bind="_checkOutTime">
                        <svg class="ghb-input-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                    </div>
                </div>

            </div>

            <div style="margin-top: 24px; text-align: center;">
                <button class="gh-btn-select" @onclick="CheckAvailability">Check Availability</button>
            </div>

            @if (!string.IsNullOrEmpty(_message))
            {
                <div style="margin-top: 12px; text-align: center; font-size: 0.85rem; color: #b91c1c;">@_message</div>
            }
        </div>

        <div class="ghb-info-box">
            <div class="ghb-info-title">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="16" x2="12" y2="12"></line>
                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                </svg>
                Important Information
            </div>
            <ul class="ghb-info-list">
                <li>Valid ID proof is mandatory at check-in (Aadhaar/Passport)</li>
                <li>Smoking is strictly prohibited in all rooms</li>
                <li>Visitors are allowed only in common areas</li>
            </ul>
        </div>

    </div>
</div>

@code {
    [SupplyParameterFromQuery] public int? guestHouseId { get; set; }
    [SupplyParameterFromQuery] public string? name { get; set; }

    private int _houseId;
    private string _houseName = "";
    private string _checkInDate = "";
    private string _checkInTime = "";
    private string _checkOutDate = "";
    private string _checkOutTime = "";
    private string? _message;

    protected override void OnInitialized()
    {
        _houseId = guestHouseId ?? 0;
        _houseName = name ?? "";

        if (_houseId <= 0)
        {
            _message = "Please select a Guest House first.";
            Navigation.NavigateTo("/GuestHouse");
            return;
        }
    }

    private async Task CheckAvailability()
    {
        _message = null;

        if (!TryParseDate(_checkInDate, out var checkInDate))
        {
            _message = "Please enter a valid Check-in Date (dd-mm-yyyy).";
            return;
        }
        if (!TryParseTime(_checkInTime, out var checkInTime))
        {
            _message = "Please enter a valid Check-in Time (e.g. 2:00 PM).";
            return;
        }
        if (!TryParseDate(_checkOutDate, out var checkOutDate))
        {
            _message = "Please enter a valid Check-out Date (dd-mm-yyyy).";
            return;
        }
        if (!TryParseTime(_checkOutTime, out var checkOutTime))
        {
            _message = "Please enter a valid Check-out Time (e.g. 12:00 PM).";
            return;
        }

        var checkIn = checkInDate.Date.Add(checkInTime);
        var checkOut = checkOutDate.Date.Add(checkOutTime);

        if (checkOut <= checkIn)
        {
            _message = "Check-out must be after Check-in.";
            return;
        }

        var query = $"/Rooms?guestHouseId={_houseId}" +
                    $"&checkIn={Uri.EscapeDataString(checkIn.ToString("yyyy-MM-ddTHH:mm:ss"))}" +
                    $"&checkOut={Uri.EscapeDataString(checkOut.ToString("yyyy-MM-ddTHH:mm:ss"))}";
        Navigation.NavigateTo(query);
    }

    private static bool TryParseDate(string value, out DateTime result)
    {
        result = default;
        if (string.IsNullOrWhiteSpace(value)) return false;
        return DateTime.TryParseExact(value.Trim(), "dd-MM-yyyy", CultureInfo.InvariantCulture, DateTimeStyles.None, out result)
            || DateTime.TryParseExact(value.Trim(), "dd-MM-yy", CultureInfo.InvariantCulture, DateTimeStyles.None, out result)
            || DateTime.TryParse(value.Trim(), CultureInfo.InvariantCulture, DateTimeStyles.None, out result);
    }

    private static bool TryParseTime(string value, out TimeSpan result)
    {
        result = default;
        if (string.IsNullOrWhiteSpace(value)) return false;
        if (TimeSpan.TryParseExact(value.Trim(), new[] { "h\\:mm\\ tt", "h\\:mmtt", "H\\:mm", "HH\\:mm" }, CultureInfo.InvariantCulture, out result))
            return true;
        if (DateTime.TryParse(value.Trim(), CultureInfo.InvariantCulture, DateTimeStyles.None, out var dt))
        {
            result = dt.TimeOfDay;
            return true;
        }
        return false;
    }
}