@page "/GuestHouseBooking"

<div class="container-fluid py-4 px-0">
    <div class="ghb-wrapper">
        
        <div class="ghb-header-text">
            <h1>Guest House Booking</h1>
            <p>Book your room and enjoy a comfortable stay at SDWA Guest House</p>
        </div>

        <div class="ghb-card">
            
            <div class="ghb-badge">T-Nagar Guest House</div>

            <div class="ghb-form-grid">
                
                <div class="ghb-form-group">
                    <label class="ghb-form-label">Check-in Date</label>
                    <div class="ghb-input-with-icon">
                        <input type="text" class="ghb-form-control" placeholder="dd-mm-yyyy">
                        <svg class="ghb-input-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                    </div>
                </div>

                <div class="ghb-form-group">
                    <label class="ghb-form-label">Check-in Time</label>
                    <div class="ghb-input-with-icon">
                        <input type="text" class="ghb-form-control" placeholder="--:-- AM">
                        <svg class="ghb-input-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                    </div>
                </div>

                <div class="ghb-form-group">
                    <label class="ghb-form-label">Check-out Date</label>
                    <div class="ghb-input-with-icon">
                        <input type="text" class="ghb-form-control" placeholder="dd-mm-yyyy">
                        <svg class="ghb-input-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                    </div>
                </div>

                <div class="ghb-form-group">
                    <label class="ghb-form-label">Check-out Time</label>
                    <div class="ghb-input-with-icon">
                        <input type="text" class="ghb-form-control" placeholder="--:-- AM">
                        <svg class="ghb-input-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                    </div>
                </div>

                <div class="ghb-form-group">
                    <label class="ghb-form-label">Guests</label>
                    <input type="text" class="ghb-form-control" placeholder="Enter Number">
                </div>

                <div class="ghb-form-group">
                    <label class="ghb-form-label">Nationality</label>
                    <select class="ghb-form-control ghb-select">
                        <option value="" disabled selected hidden>Select Nationality</option>
                        <option value="indian">Indian</option>
                        <option value="nri">NRI</option>
                        <option value="foreigner">Foreigner</option>
                    </select>
                </div>

                <div></div>
                <div></div>

            </div>
        </div>

        <div class="ghb-info-box">
            <div class="ghb-info-title">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="16" x2="12" y2="12"></line>
                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                </svg>
                Important Information
            </div>
            <ul class="ghb-info-list">
                <li>Valid ID proof is mandatory at check-in (Aadhaar/Passport)</li>
                <li>Standard check-in time: 2:00 PM | Check-out time: 11:00 AM</li>
                <li>Smoking is strictly prohibited in all rooms</li>
                <li>Visitors are allowed only in common areas</li>
            </ul>
        </div>

    </div>
</div>
