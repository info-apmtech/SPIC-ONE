@page "/SalesAudit"
@inject NavigationManager Nav

<PageTitle>Sales Audit · SPIC ONE</PageTitle>
<ScrollToTop />

<div class="container-fluid py-4 px-0">
    <div class="sa-wrapper">

        <!-- Header -->
        <div class="sa-header">
            <div class="sa-header-text">
                <h1>Sales Audit</h1>
                <p>Review eligible programs and track sales achievement</p>
            </div>

            <div class="sa-info-alert">
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg>
                <span>Sales Audit records are automatically created from CSR2 Completed programs based on the configured program type</span>
            </div>
        </div>

        <!-- Filters (expandable) -->
        <div class="sa-filter-card">
            <div class="sa-filter-header" @onclick="() => FiltersOpen = !FiltersOpen">
                <div class="sa-filter-title">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M7 12h10"></path><path d="M10 18h4"></path></svg>
                    Filters
                </div>
                <svg class="sa-filter-chevron @(FiltersOpen ? "" : "sa-chevron-closed")" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#475569" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </div>

            @if (FiltersOpen)
            {
                <div class="sa-filter-body">
                    <div class="sa-filter-grid">

                        <div class="sa-form-group">
                            <label class="sa-form-label">Sanction Number</label>
                            <select class="sa-form-select @(string.IsNullOrEmpty(SelectedSanction) ? "" : "sa-has-value")" @bind="SelectedSanction">
                                <option value="">Select Sanction Number</option>
                                @foreach (var item in AuditList.Select(x => x.SanctionNumber).Distinct())
                                {
                                    <option value="@item">@item</option>
                                }
                            </select>
                        </div>

                        <div class="sa-form-group">
                            <label class="sa-form-label">Program Name</label>
                            <select class="sa-form-select @(string.IsNullOrEmpty(SelectedProgram) ? "" : "sa-has-value")" @bind="SelectedProgram">
                                <option value="">Select Program Type</option>
                                @foreach (var item in AuditList.Select(x => x.ProgramName).Distinct())
                                {
                                    <option value="@item">@item</option>
                                }
                            </select>
                        </div>

                        <div class="sa-form-group">
                            <label class="sa-form-label">Location</label>
                            <select class="sa-form-select @(string.IsNullOrEmpty(SelectedLocation) ? "" : "sa-has-value")" @bind="SelectedLocation">
                                <option value="">Select Location</option>
                                @foreach (var item in AuditList.Select(x => x.Location).Distinct())
                                {
                                    <option value="@item">@item</option>
                                }
                            </select>
                        </div>

                        <div class="sa-form-group">
                            <label class="sa-form-label">Date Range</label>
                            <div class="sa-date-range">
                                <button type="button" class="sa-form-control sa-date-input" @onclick="() => DatePickerOpen = !DatePickerOpen">
                                    <span>@FromDate.ToString("dd MMM yyyy") - @ToDate.ToString("dd MMM yyyy")</span>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                                </button>

                                @if (DatePickerOpen)
                                {
                                    <div class="sa-date-popover">
                                        <div class="sa-form-group">
                                            <label class="sa-form-label">From</label>
                                            <input type="date" class="sa-form-control sa-has-value" @bind="FromDate" />
                                        </div>
                                        <div class="sa-form-group">
                                            <label class="sa-form-label">To</label>
                                            <input type="date" class="sa-form-control sa-has-value" @bind="ToDate" />
                                        </div>
                                        <button type="button" class="sa-btn sa-btn-solid" @onclick="() => DatePickerOpen = false">Done</button>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="sa-form-group">
                            <label class="sa-form-label">Status</label>
                            <select class="sa-form-select @(string.IsNullOrEmpty(SelectedStatus) ? "" : "sa-has-value")" @bind="SelectedStatus">
                                <option value="">Select Status</option>
                                @foreach (var item in DocumentStatuses)
                                {
                                    <option value="@item">@item</option>
                                }
                            </select>
                        </div>

                        <div class="sa-filter-actions">
                            <button class="sa-btn sa-btn-outline" @onclick="ClearFilter">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                                Clear All
                            </button>
                            <button class="sa-btn sa-btn-solid" @onclick="ApplyFilter">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M7 12h10"></path><path d="M10 18h4"></path></svg>
                                Apply Filters
                            </button>
                        </div>

                    </div>
                </div>
            }
        </div>

        <!-- Summary Cards -->
        <div class="sa-stats-grid">
            @foreach (var card in SummaryCards)
            {
                <div class="sa-stat-card">
                    <div class="sa-stat-text">
                        <p class="sa-stat-title">@card.Title</p>
                        <h2>@card.Value</h2>
                        <span class="sa-stat-desc">@card.Description</span>
                    </div>
                    <div class="sa-stat-icon sa-tone-@card.Tone">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                            @switch (card.Icon)
                            {
                                case "file-chart":
                                    <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path>
                                    <path d="M14 2v4a2 2 0 0 0 2 2h4"></path>
                                    <path d="M8 18v-2"></path>
                                    <path d="M12 18v-6"></path>
                                    <path d="M16 18v-4"></path>
                                    break;
                                case "file-pen":
                                    <path d="m18 5-2.414-2.414A2 2 0 0 0 14.172 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2"></path>
                                    <path d="M21.378 12.626a1 1 0 0 0-3.004-3.004l-4.01 4.012a2 2 0 0 0-.506.854l-.837 2.87a.5.5 0 0 0 .62.62l2.87-.837a2 2 0 0 0 .854-.506z"></path>
                                    <path d="M8 18h1"></path>
                                    <path d="M8 10h6"></path>
                                    <path d="M8 14h4"></path>
                                    break;
                                case "clock":
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <polyline points="12 6 12 12 16 14"></polyline>
                                    break;
                                case "file-up":
                                    <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path>
                                    <path d="M14 2v4a2 2 0 0 0 2 2h4"></path>
                                    <path d="M12 12v6"></path>
                                    <path d="m15 15-3-3-3 3"></path>
                                    break;
                                case "badge-check":
                                    <path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"></path>
                                    <path d="m9 12 2 2 4-4"></path>
                                    break;
                            }
                        </svg>
                    </div>
                </div>
            }
        </div>

        <!-- Sales Audit Table -->
        <div class="sa-table-card">

            <div class="sa-table-top">
                <h3>Demo Documentation List</h3>
                <input type="text" class="sa-search-input" placeholder="Search zones..."
                       @bind="SearchText" @bind:event="oninput" @bind:after="ResetPage" />
            </div>

            <div class="sa-table-wrapper">
                <table class="sa-main-table">
                    <thead>
                        <tr>
                            <th>Sanction Number</th>
                            <th>Program Name</th>
                            <th>Location</th>
                            <th>Scheme Period</th>
                            <th>Required TO <span class="sa-th-muted">(Auto)</span></th>
                            <th>Actual Turnover</th>
                            <th>Achievement</th>
                            <th>Document Status</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!PagedList.Any())
                        {
                            <tr>
                                <td colspan="9" class="sa-empty-cell">No records found</td>
                            </tr>
                        }
                        @foreach (var item in PagedList)
                        {
                            <tr>
                                <td><span class="sa-sanction">@item.SanctionNumber</span></td>
                                <td>@item.ProgramName</td>
                                <td>@item.Location</td>
                                <td>
                                    <div class="sa-period">
                                        @if (item.SchemeFrom is null || item.SchemeTo is null)
                                        {
                                            <span class="sa-period-dates">Not Set</span>
                                            <span class="sa-period-pill sa-pill-muted">Not Planed</span>
                                        }
                                        else
                                        {
                                            <span class="sa-period-dates">
                                                @item.SchemeFrom.Value.ToString("dd MMM yyyy")
                                                <span class="sa-period-to">to</span>
                                                @item.SchemeTo.Value.ToString("dd MMM yyyy")
                                            </span>
                                            <span class="sa-period-pill">@MonthsLabel(item.SchemeFrom.Value, item.SchemeTo.Value)</span>
                                        }
                                    </div>
                                </td>
                                <td><span class="sa-amount">@FormatCrore(item.RequiredTurnover)</span></td>
                                <td>
                                    @if (item.ActualTurnover is null)
                                    {
                                        <span class="sa-dash">--</span>
                                    }
                                    else
                                    {
                                        <span class="sa-amount">@FormatCrore(item.ActualTurnover.Value)</span>
                                    }
                                </td>
                                <td>
                                    @if (item.Achievement is null)
                                    {
                                        <span class="sa-dash">--</span>
                                    }
                                    else
                                    {
                                        <div class="sa-achievement">
                                            <span>@item.Achievement.Value.ToString("0.00")%</span>
                                            <div class="sa-progress-track">
                                                <div class="sa-progress-fill" style="width: @(Math.Min(100m, item.Achievement.Value).ToString(System.Globalization.CultureInfo.InvariantCulture))%;"></div>
                                            </div>
                                        </div>
                                    }
                                </td>
                                <td>
                                    <span class="sa-badge sa-badge-@StatusTone(item.DocumentStatus)">
                                        <span class="sa-badge-dot"></span>
                                        @item.DocumentStatus
                                    </span>
                                </td>
                                <td>
                                    <button class="sa-action-btn @(string.IsNullOrEmpty(item.ActionTone) ? "" : "sa-action-" + item.ActionTone)" @onclick="() => OnAction(item)">@item.ActionText</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <div class="sa-pagination">
                <div class="sa-page-size">
                    <span>Items Per Page</span>
                    <select class="sa-page-size-select" @bind="PageSize" @bind:after="ResetPage">
                        <option value="16">16</option>
                        <option value="32">32</option>
                        <option value="50">50</option>
                    </select>
                </div>

                <div class="sa-page-controls">
                    <button class="sa-page-btn" disabled="@(CurrentPage <= 1)" @onclick="() => GoToPage(CurrentPage - 1)" aria-label="Previous page">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
                    </button>
                    @foreach (var pageNo in PageNumbers)
                    {
                        if (pageNo == -1)
                        {
                            <span class="sa-page-btn sa-dots">..</span>
                        }
                        else
                        {
                            <button class="sa-page-btn @(pageNo == CurrentPage ? "active" : "")" @onclick="() => GoToPage(pageNo)">@pageNo</button>
                        }
                    }
                    <button class="sa-page-btn" disabled="@(CurrentPage >= TotalPages)" @onclick="() => GoToPage(CurrentPage + 1)" aria-label="Next page">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                    </button>
                </div>
            </div>
        </div>

    </div>
</div>

@code {
    private List<SalesAuditDto> AuditList = new();
    private List<SalesAuditDto> FilteredList = new();

    private bool FiltersOpen = true;
    private bool DatePickerOpen;

    private string SearchText = "";
    private string SelectedSanction = "";
    private string SelectedProgram = "";
    private string SelectedLocation = "";
    private string SelectedStatus = "";
    private DateTime FromDate = new(2025, 4, 1);
    private DateTime ToDate = new(2025, 4, 28);

    private int CurrentPage = 1;
    private int PageSize = 16;

    private static readonly string[] DocumentStatuses =
        { "Not Started", "Sales Tracking", "Period Expired", "Extension Request", "Completed" };

    private record SummaryCard(string Title, int Value, string Description, string Icon, string Tone);

    private readonly List<SummaryCard> SummaryCards = new()
    {
        new("Total Programs", 42, "Eligible programs", "file-chart", "blue"),
        new("Not started", 7, "Audit not yet started", "file-pen", "gray"),
        new("In Progress", 22, "Plan preparation in progress", "clock", "yellow"),
        new("Sales Tracking", 2, "Period active", "file-chart", "teal"),
        new("Period expired", 22, "Target not Archived", "clock", "yellow"),
        new("Extension Request", 1, "Awaiting admin decision", "file-up", "purple"),
        new("Draft", 7, "Continue the plan", "file-pen", "gray"),
        new("Completed", 2, "Audit Completed", "badge-check", "green"),
    };

    protected override void OnInitialized()
    {
        LoadData();
    }

    private void LoadData()
    {
        var from = new DateTime(2026, 8, 17);
        var to = new DateTime(2026, 10, 31);
        const string program = "SUb Dealer Training Program";
        const string location = "Pune, Maharashtra";

        AuditList = new()
        {
            new() { SanctionNumber = "SN-2024-0412", ProgramName = program, Location = location, RequiredTurnover = 2.20m, DocumentStatus = "Not Started", ActionText = "Start Audit" },
            new() { SanctionNumber = "SN-2024-0412", ProgramName = program, Location = location, SchemeFrom = from, SchemeTo = to, RequiredTurnover = 1.50m, ActualTurnover = 0.20m, Achievement = 43.33m, DocumentStatus = "Sales Tracking", ActionText = "View Achievement" },
            new() { SanctionNumber = "SN-2024-0412", ProgramName = program, Location = location, SchemeFrom = from, SchemeTo = to, RequiredTurnover = 2.20m, ActualTurnover = 0.20m, Achievement = 43.33m, DocumentStatus = "Period Expired", ActionText = "Request Extension", ActionTone = "orange" },
            new() { SanctionNumber = "SN-2024-0412", ProgramName = program, Location = location, SchemeFrom = from, SchemeTo = to, RequiredTurnover = 2.20m, ActualTurnover = 0.20m, Achievement = 104.00m, DocumentStatus = "Completed", ActionText = "View Audit" },
            new() { SanctionNumber = "SN-2024-0412", ProgramName = program, Location = location, SchemeFrom = from, SchemeTo = to, RequiredTurnover = 2.20m, ActualTurnover = 0.20m, Achievement = 43.33m, DocumentStatus = "Extension Request", ActionText = "View Request", ActionTone = "purple" },
            new() { SanctionNumber = "SN-2024-0412", ProgramName = program, Location = location, RequiredTurnover = 2.20m, DocumentStatus = "Not Started", ActionText = "Start Audit" },
            new() { SanctionNumber = "SN-2024-0412", ProgramName = program, Location = location, SchemeFrom = from, SchemeTo = to, RequiredTurnover = 2.20m, ActualTurnover = 0.20m, Achievement = 43.33m, DocumentStatus = "Period Expired", ActionText = "Request Extension" },
            new() { SanctionNumber = "SN-2024-0412", ProgramName = program, Location = location, SchemeFrom = from, SchemeTo = to, RequiredTurnover = 2.20m, ActualTurnover = 0.20m, Achievement = 43.33m, DocumentStatus = "Completed", ActionText = "View / Continue" },
        };

        FilteredList = AuditList;
    }

    private IEnumerable<SalesAuditDto> SearchedList =>
        string.IsNullOrWhiteSpace(SearchText)
            ? FilteredList
            : FilteredList.Where(x =>
                x.SanctionNumber.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ||
                x.ProgramName.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ||
                x.Location.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ||
                x.DocumentStatus.Contains(SearchText, StringComparison.OrdinalIgnoreCase));

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(SearchedList.Count() / (double)PageSize));
    private IEnumerable<SalesAuditDto> PagedList => SearchedList.Skip((CurrentPage - 1) * PageSize).Take(PageSize);

    private IEnumerable<int> PageNumbers
    {
        get
        {
            var total = TotalPages;
            if (total <= 7) return Enumerable.Range(1, total);

            var pages = new List<int> { 1 };
            var start = Math.Max(2, CurrentPage - 1);
            var end = Math.Min(total - 1, CurrentPage + 1);

            if (start > 2) pages.Add(-1);
            for (var i = start; i <= end; i++) pages.Add(i);
            if (end < total - 1) pages.Add(-1);
            pages.Add(total);

            return pages;
        }
    }

    private void GoToPage(int page) => CurrentPage = Math.Clamp(page, 1, TotalPages);
    private void ResetPage() => CurrentPage = 1;

    private void ApplyFilter()
    {
        FilteredList = AuditList
            .Where(x =>
                (string.IsNullOrEmpty(SelectedSanction) || x.SanctionNumber == SelectedSanction) &&
                (string.IsNullOrEmpty(SelectedProgram) || x.ProgramName == SelectedProgram) &&
                (string.IsNullOrEmpty(SelectedLocation) || x.Location == SelectedLocation) &&
                (string.IsNullOrEmpty(SelectedStatus) || x.DocumentStatus == SelectedStatus))
            .ToList();
        ResetPage();
    }

    private void ClearFilter()
    {
        SelectedSanction = "";
        SelectedProgram = "";
        SelectedLocation = "";
        SelectedStatus = "";
        SearchText = "";
        FromDate = new(2025, 4, 1);
        ToDate = new(2025, 4, 28);
        FilteredList = AuditList;
        ResetPage();
    }

    // Only the audit entry points are wired for now; the other actions get their pages later.
    private void OnAction(SalesAuditDto item)
    {
        if (item.ActionText is "Start Audit" or "View / Continue")
            Nav.NavigateTo("/AuditOverview");
    }

    private static string FormatCrore(decimal value) => $"₹ {value:0.00} Cr";

    // Calendar months the scheme touches, e.g. 17 Aug - 31 Oct = 3 months.
    private static string MonthsLabel(DateTime from, DateTime to)
    {
        var months = Math.Max(1, (to.Year - from.Year) * 12 + to.Month - from.Month + 1);
        return months == 1 ? "1 month" : $"{months} months";
    }

    private static string StatusTone(string status) => status switch
    {
        "Sales Tracking" => "teal",
        "Period Expired" => "orange",
        "Completed" => "green",
        "Extension Request" => "purple",
        _ => "gray"
    };

    public class SalesAuditDto
    {
        public string SanctionNumber { get; set; } = "";
        public string ProgramName { get; set; } = "";
        public string Location { get; set; } = "";
        public DateTime? SchemeFrom { get; set; }
        public DateTime? SchemeTo { get; set; }
        /// <summary>Required turnover in crores.</summary>
        public decimal RequiredTurnover { get; set; }
        /// <summary>Actual turnover in crores; null until sales tracking starts.</summary>
        public decimal? ActualTurnover { get; set; }
        public decimal? Achievement { get; set; }
        public string DocumentStatus { get; set; } = "";
        public string ActionText { get; set; } = "";
        /// <summary>Button colour: "" (green), "orange" or "purple".</summary>
        public string ActionTone { get; set; } = "";
    }
}
