@page "/SelectPurchasedProducts"


    <div class="container-fluid py-4 px-4" style="max-width: 1400px; margin: auto;">
         
        <div class="page-header-row">
            <a href="#" class="back-btn"><i class="bi bi-arrow-left"></i></a>
            <div>
                <h1 class="page-title">Select Purchased Products</h1>
                <div class="page-subtitle">Choose the products you purchased from this dealer</div>
            </div>
        </div>

        <div class="row g-4">
            
            <div class="col-lg-8 col-md-12">
                <div class="dealer-card">
                    
                    <div class="dealer-header">
                        <img src="https://i.pravatar.cc/150?img=11" alt="Dealer Avatar" class="dealer-avatar">
                        
                        <div class="dealer-info">
                            <h3>GREEN VALLEY AGRO</h3>
                            <div class="verified-badge">
                                <i class="bi bi-patch-check-fill"></i> VERIFIED
                            </div>
                            <div class="dealer-address">
                                <i class="bi bi-shop"></i> Address Goes Here, Your City, Country Pin - 600015
                            </div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="contact-box">
                                <i class="bi bi-phone"></i> 9600994060
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="contact-box">
                                <i class="bi bi-geo-alt"></i> Company@Gmail.Com
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <div class="col-lg-4 col-md-12">
                <div class="progress-card">
                    <div class="progress-header">
                        <h4 class="progress-title">Current Progress</h4>
                        <div class="progress-trend">
                            <i class="bi bi-graph-up-arrow"></i> 88 more to grand draw
                        </div>
                    </div>
                    
                    <div class="progress-value">12</div>
                    <div class="progress-subtitle">Total Lucky Draw Entries</div>
                    
                    <div class="progress-bar-container">
                        <div class="progress-bar-fill" style="width: 12%;"></div>
                    </div>
                    <div class="progress-labels">
                        <span>0</span>
                        <span>100 entries</span>
                    </div>
                </div>
            </div>

        </div>

        <div class="products-wrapper">
            <h2 class="section-title">Available Products</h2>

            <div class="product-grid">
                
                @for (int i = 0; i < 8; i++)
                {
                    <div class="product-card">
                        <div class="product-img-box">
                            <div class="badge-category">Fertilizer</div>
                            <img src="https://cdn-icons-png.flaticon.com/512/3063/3063822.png" alt="Fertilizer Bag" style="filter: hue-rotate(320deg) brightness(1.2);">
                        </div>
                        
                        <div class="product-title">SPIC urea 45kg Bag</div>
                        
                        <div class="product-footer">
                            <span class="qty-lbl">Qty</span>
                            <div class="qty-controls">
                                <button class="qty-btn minus"><i class="bi bi-dash"></i></button>
                                <span class="qty-value">2</span>
                                <button class="qty-btn plus"><i class="bi bi-plus"></i></button>
                            </div>
                        </div>
                    </div>
                }

            </div>
        </div>

    </div>

    