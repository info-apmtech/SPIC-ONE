@page "/SelectPurchasedProducts"

<div class="container-fluid py-4 px-0">
    <div class="spp-wrapper">

        <!-- Page Header -->
        <div class="spp-page-header">
            <PageHeader Title="Select Purchased Products" Subtitle="Choose the products you purchased from this dealer" ShowBack="true" CssClass="w-100" />
        </div>

        <!-- Top Row: Dealer + Progress -->
        <div class="spp-top-grid">

            <!-- Dealer Card -->
            <div class="spp-dealer-card">
                <div class="spp-dealer-header">
                    <img src="_content/SPIC.MauiBlazorApp.Shared/Images/Schemes/img_ellipse_249.png" alt="Dealer Avatar" class="spp-dealer-avatar" loading="lazy" />
                    <div class="spp-dealer-info">
                        <h3>GREEN VALLEY AGRO</h3>
                        <div class="spp-verified-badge">
                            <i class="bi bi-patch-check-fill"></i> VERIFIED
                        </div>
                        <div class="spp-dealer-address">
                            <i class="bi bi-shop"></i>
                            Address Goes Here, Your City, Country Pin - 600015
                        </div>
                    </div>
                </div>
                <div class="spp-contact-row">
                    <div class="spp-contact-box">
                        <div class="spp-contact-icon-wrapper">
                            <i class="bi bi-phone"></i>
                        </div>
                        <span>9600994060</span>
                    </div>
                    <div class="spp-contact-box">
                        <div class="spp-contact-icon-wrapper">
                            <i class="bi bi-geo-alt"></i>
                        </div>
                        <span>Company@Gmail.Com</span>
                    </div>
                </div>
            </div>

            <!-- Progress Card -->
            <div class="spp-progress-card">
                <div class="spp-progress-head">
                    <h4>Current Progress</h4>
                    <span class="spp-progress-trend">
                        <i class="bi bi-graph-up-arrow"></i> 88 more to grand draw
                    </span>
                </div>
                <div class="spp-progress-value">12</div>
                <div class="spp-progress-subtitle">Total Lucky Draw Entries</div>
                <div class="spp-progress-track">
                    <div class="spp-progress-fill" style="width: 12%;"></div>
                </div>
                <div class="spp-progress-labels">
                    <span>0</span>
                    <span>100 entries</span>
                </div>
            </div>

        </div>

        <!-- Products Section -->
        <div class="spp-products-card">
            <h2 class="spp-products-title">Available Products</h2>
            <div class="spp-product-grid">
                @for (int i = 0; i < 10; i++)
                {
                    <div class="spp-product-card">
                        <div class="spp-product-image-area">
                            <span class="spp-product-tag">Fertilizer</span>
                            <img src="_content/SPIC.MauiBlazorApp.Shared/Images/Gallery/Urea.png" alt="SPIC urea 45kg Bag" loading="lazy" />
                        </div>
                        <div class="spp-product-name">SPIC urea 45kg Bag</div>
                        <div class="spp-product-footer">
                            <span class="spp-qty-label">Qty</span>
                            <div class="spp-qty-controls">
                                <button class="spp-qty-btn spp-qty-plus"><i class="bi bi-plus"></i></button>
                                <span class="spp-qty-value">2</span>
                                <button class="spp-qty-btn spp-qty-minus"><i class="bi bi-dash"></i></button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

    </div>
</div>

@code {

}