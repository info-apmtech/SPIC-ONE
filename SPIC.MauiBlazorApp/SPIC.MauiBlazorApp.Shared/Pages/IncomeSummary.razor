    .ics-table { width: 100%; border-collapse: collapse; text-align: center; }
    .ics-table th { padding: 14px 16px; background: #f3f4f6; font-size: 12px; font-weight: 700; color: #374151; border-bottom: 1px solid #e5e7eb; }
    .ics-table td { padding: 14px 16px; font-size: 13px; color: #4b5563; border-bottom: 1px solid #e5e7eb; }
    .ics-table td:first-child, .ics-table th:first-child,
    .ics-table td:nth-child(2), .ics-table th:nth-child(2) { text-align: left; }
    .ics-table tbody tr:last-child td { border-bottom: none; }

    .ics-empty-td { text-align: center !important; padding: 32px !important; color: #9ca3af; font-style: italic; }

    .ics-badge-status { padding: 4px 12px; border-radius: 999px; font-size: 11px; font-weight: 700; }
    .ics-badge-submitted { background: #16a34a; color: #fff; }
