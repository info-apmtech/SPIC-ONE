    .ics-drawer-meta { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 18px; }
    .ics-drawer-meta div { display: flex; flex-direction: column; gap: 2px; font-size: 12px; color: #6b7280; }
    .ics-drawer-meta strong { font-size: 14px; color: #111827; }
    .ics-drawer-subhead { font-size: 13px; font-weight: 700; color: #374151; margin: 16px 0 8px; }
    .ics-drawer-table { width: 100%; border-collapse: collapse; font-size: 12px; }
    .ics-drawer-table th { background: #f3f4f6; padding: 8px 10px; text-align: left; }
    .ics-drawer-table td { padding: 8px 10px; border-bottom: 1px solid #f1f5f9; }
