    .ics-charts-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    .ics-chart-card { padding: 20px; }
    .ics-chart-head { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px; flex-wrap: wrap; gap: 10px; }
    .ics-chart-head h2 { margin: 0; font-size: 16px; font-weight: 700; color: #111827; }
    .ics-chart-head p { margin: 2px 0 0; font-size: 12px; color: #6b7280; }
    .ics-chip { background: #ecfdf5; border: 1px solid #a7f3d0; color: #065f46; font-size: 12px; font-weight: 600; padding: 6px 12px; border-radius: 8px; white-space: nowrap; }

    .ics-chart-body { display: flex; align-items: center; gap: 24px; }
    .ics-donut-wrap { width: 180px; height: 180px; flex-shrink: 0; position: relative; }
    .ics-legend-list { flex: 1; display: flex; flex-direction: column; gap: 10px; }
    .ics-legend-row { display: flex; align-items: center; gap: 8px; font-size: 13px; }
    .ics-legend-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
    .ics-legend-name { flex: 1; color: #374151; font-weight: 500; }
    .ics-legend-val { font-weight: 600; color: #111827; }

    .ics-chart-body-bar { flex-direction: column; align-items: stretch; gap: 10px; }
    .ics-bar-legend { display: flex; flex-wrap: wrap; gap: 14px; font-size: 12px; color: #374151; }
