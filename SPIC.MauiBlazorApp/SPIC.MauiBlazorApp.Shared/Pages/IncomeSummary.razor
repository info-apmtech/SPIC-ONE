    .ics-stat-value { font-size: 22px; font-weight: 700; color: #111827; margin-bottom: 6px; }
    .ics-stat-value-sm { font-size: 16px; }
    .ics-stat-desc { font-size: 11px; color: #6b7280; }
    .ics-stat-icon { position: absolute; right: 16px; top: 16px; width: 34px; height: 34px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 16px; }
