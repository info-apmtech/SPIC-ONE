    .ics-filters-header {
        display: flex; justify-content: space-between; align-items: center;
        padding: 16px 20px; cursor: pointer; background-color: #F5F8F6;
    }
    .ics-filters-title { display: flex; align-items: center; gap: 8px; font-weight: 600; font-size: 14px; }
    .ics-filters-body { padding: 0 20px 20px 20px; background-color: #FFFFFF; }
    .ics-filters-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 20px; }
