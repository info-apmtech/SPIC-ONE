@page "/IncomeSummary"
@using System.Net.Http.Json
@using SPIC.MauiBlazorApp.Shared.Components.Feedback
@inject NavigationManager Nav
@inject HttpClient Http
@inject IJSRuntime JS
@inject SPIC.MauiBlazorApp.Shared.Services.ToastService Toast

<PageTitle>Income Summary · SPIC ONE</PageTitle>

<div class="ics-page">

    <PageHeader Title="Income Summary"
                Subtitle="Overview of farm sales income and reporting status"
                ShowBack="false">
        <Actions>
            <button type="button" class="ics-btn-back" @onclick="GoBack">
                <i class="bi bi-arrow-left"></i> Back to Income entry
            </button>
        </Actions>
    </PageHeader>

    <!-- Filters -->
    <div class="ics-card ics-filters-card">
        <div class="ics-filters-header" @onclick="ToggleFilters">
            <div class="ics-filters-title"><i class="bi bi-filter"></i> Filters</div>
            <i class="bi @(filtersExpanded ? "bi-chevron-down" : "bi-chevron-up")"></i>
        </div>

        @if (filtersExpanded)
        {
            <div class="ics-filters-body">
                <div class="ics-filters-grid">
                    <div class="ics-filter-group">
                        <label>Period Type</label>
                        <select class="ics-select-chevron">
                            <option>15 days</option>
                        </select>
                    </div>
                    <div class="ics-filter-group">
                        <label>From Month</label>
                        <select class="ics-select-date" @bind="fromMonthFilter">
                            <option value="">Any</option>
                            @for (var m = 1; m <= 12; m++)
                            {
                                <option value="@m">@MonthName(m)</option>
                            }
                        </select>
                    </div>
                    <div class="ics-filter-group">
                        <label>To Month</label>
                        <select class="ics-select-date" @bind="toMonthFilter">
                            <option value="">Any</option>
                            @for (var m = 1; m <= 12; m++)
                            {
                                <option value="@m">@MonthName(m)</option>
                            }
                        </select>
                    </div>
                    <div class="ics-filter-group">
                        <label>Income Category</label>
                        <select class="ics-select-chevron" @bind="categoryFilter">
                            <option value="">All Category</option>
                            <option value="LiveStock">Livestock</option>
                            <option value="Orchard">Orchard</option>
                        </select>
                    </div>
                </div>
                <div class="ics-filters-actions">
                    <button type="button" class="ics-btn-clear" @onclick="ClearFiltersAsync"><i class="bi bi-x"></i> Clear All</button>
                    <button type="button" class="ics-btn-primary" @onclick="ApplyFiltersAsync"><i class="bi bi-filter"></i> Apply Filters</button>
                </div>
            </div>
        }
    </div>

    @if (isLoading)
    {
        <EmptyState Icon="bi-hourglass-split" Title="Loading income summary..." Compact="true" />
    }
    else
    {
        <!-- Stat cards -->
        <div class="ics-stats-grid">
            <div class="ics-stat-card">
                <div class="ics-stat-label">Total Income Till Date</div>
                <div class="ics-stat-value">@FormatCurrency(summary.TotalIncomeTillDate)</div>
                <div class="ics-stat-desc">@(summary.EarliestPeriodStart is { } s ? $"From {s:MMM yyyy} - {(summary.LatestPeriodEnd ?? s):dd MMM yyyy}" : "No records yet")</div>
                <div class="ics-stat-icon ics-icon-green"><i class="bi bi-file-earmark-arrow-up"></i></div>
            </div>
            <div class="ics-stat-card">
                <div class="ics-stat-label">Sales Records</div>
                <div class="ics-stat-value">@summary.SalesRecordsCount</div>
                <div class="ics-stat-desc">Total income entries recorded</div>
                <div class="ics-stat-icon ics-icon-blue"><i class="bi bi-file-earmark-text"></i></div>
            </div>
            <div class="ics-stat-card">
                <div class="ics-stat-label">Products Covered</div>
                <div class="ics-stat-value">@(summary.LivestockProductsCount + summary.OrchardProductsCount) Product@((summary.LivestockProductsCount + summary.OrchardProductsCount) == 1 ? "" : "s")</div>
                <div class="ics-stat-desc">@summary.LivestockProductsCount Livestock line@(summary.LivestockProductsCount == 1 ? "" : "s") &middot; @summary.OrchardProductsCount Orchard variet@(summary.OrchardProductsCount == 1 ? "y" : "ies")</div>
                <div class="ics-stat-icon ics-icon-purple"><i class="bi bi-clock-history"></i></div>
            </div>
            <div class="ics-stat-card">
                <div class="ics-stat-label">Reporting Period</div>
                <div class="ics-stat-value ics-stat-value-sm">@(summary.LatestReportingPeriod ?? "No reports yet")</div>
                <div class="ics-stat-desc">
                    @if (summary.GraceDaysRemaining is { } g)
                    {
                        <i class="bi bi-info-circle"></i> @(g == 0 ? "Last day to update" : $"Only {g} day{(g == 1 ? "" : "s")} left to update")
                    }
                    else if (summary.LatestPeriodEnd is not null)
                    {
                        <span>Editing window closed</span>
                    }
                </div>
                <div class="ics-stat-icon ics-icon-amber"><i class="bi bi-clock-history"></i></div>
            </div>
        </div>

        <!-- Table -->
        <div class="ics-card ics-table-card">
            <div class="ics-table-top-header">
                <h2>Livestock Sales Ledger</h2>
                <button type="button" class="ics-btn-outline" disabled="@_exporting" @onclick="DownloadExcelAsync"><i class="bi bi-file-earmark-excel"></i> Download Excel</button>
            </div>

            <div class="ics-table-scroll">
                <table class="ics-table">
                    <thead>
                        <tr>
                            <th>S.NO</th>
                            <th>Reporting Period</th>
                            <th>Livestock Income</th>
                            <th>Orchard Income</th>
                            <th>Total Income</th>
                            <th>Status</th>
                            <th>View</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (allRows.Count == 0)
                        {
                            <tr><td colspan="7" class="ics-empty-td">No income reports found for this filter.</td></tr>
                        }
                        else
                        {
                            @foreach (var (row, index) in PagedRows)
                            {
                                <tr>
                                    <td>@(((currentPage - 1) * pageSize) + index + 1)</td>
                                    <td>@row.ReportingPeriod</td>
                                    <td>@FormatCurrency(row.LivestockIncome)</td>
                                    <td>@FormatCurrency(row.OrchardIncome)</td>
                                    <td>@FormatCurrency(row.TotalIncome)</td>
                                    <td><span class="@("ics-badge-status " + (row.Status == "Submitted" ? "ics-badge-submitted" : "ics-badge-draft"))">@row.Status</span></td>
                                    <td><button type="button" class="ics-view-btn" @onclick="() => ViewReportAsync(row.ReportId)" aria-label="View"><i class="bi bi-eye"></i></button></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @if (allRows.Count > 0)
            {
                <div class="ics-pagination">
                    <div class="ics-items-per-page">
                        <span>Items Per Page</span>
                        <select @bind="pageSize" @bind:after="() => GoToPage(1)">
                            <option value="10">10</option>
                            <option value="16">16</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                        </select>
                    </div>
                    <div class="ics-pagination-buttons">
                        <button type="button" class="ics-page-btn" disabled="@(currentPage == 1)" @onclick="() => GoToPage(currentPage - 1)"><i class="bi bi-chevron-left"></i></button>
                        @foreach (var pNum in VisiblePageNumbers)
                        {
                            @if (pNum == -1)
                            {
                                <span class="ics-page-ellipsis">..</span>
                            }
                            else
                            {
                                <button type="button" class="@("ics-page-btn" + (pNum == currentPage ? " ics-page-active" : ""))" @onclick="() => GoToPage(pNum)">@pNum</button>
                            }
                        }
                        <button type="button" class="ics-page-btn" disabled="@(currentPage == TotalPages)" @onclick="() => GoToPage(currentPage + 1)"><i class="bi bi-chevron-right"></i></button>
                    </div>
                </div>
            }
        </div>

        <!-- Charts -->
        <div class="ics-charts-grid">
            <div class="ics-card ics-chart-card">
                <div class="ics-chart-head">
                    <div>
                        <h2>Live Income Overview</h2>
                        <p>Top 5 Products by income</p>
                    </div>
                    <span class="ics-chip">Total Livestock Income @FormatCurrency(summary.TotalLivestockIncome)</span>
                </div>
                @if (summary.TopLivestockProducts.Count == 0)
                {
                    <EmptyState Icon="bi-pie-chart" Title="No livestock income yet" Compact="true" />
                }
                else
                {
                    <div class="ics-chart-body">
                        <div class="ics-donut-wrap"><canvas id="incLiveDonutChart"></canvas></div>
                        <div class="ics-legend-list">
                            @for (var i = 0; i < summary.TopLivestockProducts.Count; i++)
                            {
                                var p = summary.TopLivestockProducts[i];
                                <div class="ics-legend-row">
                                    <span class="ics-legend-dot" style="background:@ChartColor(i)"></span>
                                    <span class="ics-legend-name">@p.ProductName</span>
                                    <span class="ics-legend-val">@FormatCurrency(p.TotalAmount)</span>
                                </div>
                            }
                        </div>
                    </div>
                    @if (summary.OtherLivestockProductCount > 0)
                    {
                        <div class="ics-others-row">
                            <span>Others (@summary.OtherLivestockProductCount)</span>
                            <span>@FormatCurrency(summary.TotalLivestockIncome - summary.TopLivestockProducts.Sum(p => p.TotalAmount))</span>
                        </div>
                    }
                }
            </div>

            <div class="ics-card ics-chart-card">
                <div class="ics-chart-head">
                    <div>
                        <h2>Orchard Income Overview</h2>
                        <p>Top 5 Products by income</p>
                    </div>
                    <span class="ics-chip">Total Orchard Income @FormatCurrency(summary.TotalOrchardIncome)</span>
                </div>
                @if (summary.TopOrchardProducts.Count == 0)
                {
                    <EmptyState Icon="bi-bar-chart" Title="No orchard income yet" Compact="true" />
                }
                else
                {
                    <div class="ics-chart-body ics-chart-body-bar">
                        <div class="ics-bar-legend">
                            @for (var i = 0; i < summary.TopOrchardProducts.Count; i++)
                            {
                                <span class="ics-legend-dot" style="background:@ChartColor(i)"></span>
                                <span>@summary.TopOrchardProducts[i].ProductName</span>
                            }
                        </div>
                        <div class="ics-bar-wrap"><canvas id="incOrchardBarChart"></canvas></div>
                    </div>
                    @if (summary.OtherOrchardProductCount > 0)
                    {
                        <div class="ics-others-row">
                            <span>Others (@summary.OtherOrchardProductCount)</span>
                            <span>@FormatCurrency(summary.TotalOrchardIncome - summary.TopOrchardProducts.Sum(p => p.TotalAmount))</span>
                        </div>
                    }
                }
            </div>
        </div>
    }
</div>

<!-- View details drawer -->
<BottomSheet @bind-IsOpen="showDetailsDrawer" Title="Income Report Details" Subtitle="@selectedDetail?.ReportingPeriod">
    @if (isLoadingDetail)
    {
        <EmptyState Icon="bi-hourglass-split" Title="Loading..." Compact="true" />
    }
    else if (selectedDetail is null)
    {
        <EmptyState Icon="bi-exclamation-triangle" Title="Could not load this report" Compact="true" />
    }
    else
    {
        <div class="ics-drawer-meta">
            <div><span>Status</span><strong>@selectedDetail.Status</strong></div>
            <div><span>Submitted By</span><strong>@(string.IsNullOrWhiteSpace(selectedDetail.SubmittedBy) ? "-" : selectedDetail.SubmittedBy)</strong></div>
            <div><span>Submitted At</span><strong>@(selectedDetail.SubmittedAt is { } at ? at.ToString("dd MMM yyyy, hh:mm tt") : "-")</strong></div>
            <div><span>Total Income</span><strong>@FormatCurrency(selectedDetail.TotalIncome)</strong></div>
        </div>

        <h4 class="ics-drawer-subhead">Livestock</h4>
        <table class="ics-drawer-table">
            <thead><tr><th>Product</th><th>Qty</th><th>Rate</th><th>Amount</th></tr></thead>
            <tbody>
                @foreach (var item in selectedDetail.IncomeItems.Where(i => i.Group == "LiveStock"))
                {
                    <tr><td>@item.ProductName</td><td>@item.SoldQuantity @item.Uom</td><td>@FormatCurrency(item.Rate)</td><td>@FormatCurrency(item.TotalAmount)</td></tr>
                }
            </tbody>
        </table>

        <h4 class="ics-drawer-subhead">Orchard</h4>
        <table class="ics-drawer-table">
            <thead><tr><th>Product</th><th>Qty</th><th>Rate</th><th>Amount</th></tr></thead>
            <tbody>
                @foreach (var item in selectedDetail.IncomeItems.Where(i => i.Group == "Orchard"))
                {
                    <tr><td>@item.ProductName</td><td>@item.SoldQuantity @item.Uom</td><td>@FormatCurrency(item.Rate)</td><td>@FormatCurrency(item.TotalAmount)</td></tr>
                }
            </tbody>
        </table>

        @if (!string.IsNullOrWhiteSpace(selectedDetail.IncomeRemarks))
        {
            <h4 class="ics-drawer-subhead">Remarks</h4>
            <p class="ics-drawer-remarks">@selectedDetail.IncomeRemarks</p>
        }
    }
</BottomSheet>

<style>
    .ics-page { color: #1f2937; font-family: inherit; }

    .ics-btn-back {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 8px 16px; background: #fff; border: 1px solid #065f46; color: #065f46;
        border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer;
    }

    .ics-card {
        background: #fff; border: 1px solid #e5e7eb; border-radius: 12px;
