        background-repeat: no-repeat; background-position: right 12px center;
    }
    .ics-filters-actions { display: flex; justify-content: flex-end; gap: 12px; }
    .ics-btn-clear {
        padding: 8px 16px; background: #fff; border: 1px solid #e5e7eb; color: #374151;
        border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer;
        display: inline-flex; align-items: center; gap: 6px;
    }
    .ics-btn-primary {
        padding: 8px 20px; background: #4f46e5; border: none; color: #fff;
