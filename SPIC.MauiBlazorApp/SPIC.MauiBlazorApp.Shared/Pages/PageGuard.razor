@implements IDisposable
@inject NavigationManager Nav
@inject ISessionStore SessionStore
@inject SPIC.MauiBlazorApp.Shared.Services.LoginState LoginState
@inject IJSRuntime JS
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@using SPIC.Core.Entities
@using SPIC.MauiBlazorApp.Shared.Services

@code {
    // The route rules themselves live in Services/RouteAccess.cs (moved verbatim 2026-11-16) so
    // the Help Desk can ask the same "can this user open that page?" question. This component only
    // restores the session's role access, re-checks on navigation / login changes, and applies the
    // redirect RouteAccess returns.

    private bool _restored;

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        LoginState.OnChange += OnLoginStateChanged;

        // Restore role access from the session store BEFORE the first check,
        // so a hard navigation (URL typed into address bar) doesn't slip through.
        try
        {
            var roleAccess = await SessionStore.GetAsync(SessionKeys.RoleAccess);
            if (roleAccess != null)
            {
                LoginState.SetAllowedPages(roleAccess);
            }
        }
        catch { /* JS interop may not be ready yet — OnChange handler will catch up */ }

        _restored = true;
        Check(Nav.Uri);
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => Check(e.Location);

    private void OnLoginStateChanged()
    {
        // Re-check the current URL whenever LoginState changes (e.g. after login,
        // or after MainLayout restores AllowedPages from the session store).
        if (_restored) Check(Nav.Uri);
    }

    private void Check(string url)
    {
        var decision = RouteAccess.Decide(LoginState, url, Config["DataExplorer:AuthorizedEmployeeId"]);
        if (!decision.Allowed && decision.RedirectTo is not null)
        {
            Nav.NavigateTo(decision.RedirectTo, replace: true);
        }
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        LoginState.OnChange -= OnLoginStateChanged;
    }
}
