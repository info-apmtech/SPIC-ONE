@implements IDisposable
@inject NavigationManager Nav
@inject SPIC.MauiBlazorApp.Shared.Services.LoginState LoginState
@inject IJSRuntime JS
@using System.Linq
@using SPIC.Core.Entities

@code {
    private static readonly HashSet<string> _alwaysOpen = new(StringComparer.OrdinalIgnoreCase)
    {
        "",
        "login",
        "AccountSelector",
        "error",
        "notfound",
        "forbidden",
        "Dashboard"
    };

    private bool _restored;

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        LoginState.OnChange += OnLoginStateChanged;

        // Restore role access from sessionStorage BEFORE the first check,
        // so a hard navigation (URL typed into address bar) doesn't slip through.
        try
        {
            var roleAccess = await JS.InvokeAsync<string?>("sessionStorage.getItem", "spic_role_access");
            if (roleAccess != null)
            {
                LoginState.SetAllowedPages(roleAccess);
            }
        }
        catch { /* JS interop may not be ready yet — OnChange handler will catch up */ }

        _restored = true;
        Check(Nav.Uri);
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => Check(e.Location);

    private void OnLoginStateChanged()
    {
        // Re-check the current URL whenever LoginState changes (e.g. after login,
        // or after MainLayout restores AllowedPages from sessionStorage).
        if (_restored) Check(Nav.Uri);
    }

    private void Check(string url)
    {
        if (!LoginState.IsLoggedIn) return;

        // Admin group bypasses everything
        if (LoginState.IsAdmin) return;

        // Users with NO designation assigned -> full access fallback.
        // We only trust this AFTER sessionStorage restore has run.
        if (LoginState.AllowedPages.Count == 0) return;

        var path = (new Uri(url, UriKind.RelativeOrAbsolute).IsAbsoluteUri
                ? new Uri(url).AbsolutePath
                : url)
            .Split('?', '#')[0]
            .TrimStart('/')
            .TrimEnd('/');

        // Match on the FIRST path segment only, so routes WITH parameters
        var firstSegment = path
            .Split('/', StringSplitOptions.RemoveEmptyEntries)
            .FirstOrDefault() ?? "";

        if (_alwaysOpen.Contains(firstSegment)) return;

        if (!LoginState.AllowedPages.Contains(firstSegment))
        {
            Nav.NavigateTo("/Dashboard", replace: true);
        }
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        LoginState.OnChange -= OnLoginStateChanged;
    }
}