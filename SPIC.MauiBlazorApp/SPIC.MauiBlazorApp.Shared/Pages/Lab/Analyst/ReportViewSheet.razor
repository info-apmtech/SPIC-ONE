@namespace SPIC.MauiBlazorApp.Shared.Pages.Lab.Analyst
@inject LabApi Api
@implements IDisposable

@*
    One sample report (GET api/Lab/reports/{id}) in a sheet: right-side drawer on desktop, full
    height sheet on phones. Opened by Batch Report Details through ?report={id}. Body follows the
    reference PDF: farmer / sample block, Parameters / Result / Response / Optimum Range table,
    overall status, recommendations and the crop / irrigation note. Footer: Mark printed and the
    Download PDF split button (language).
*@
<BottomSheet IsOpen="ReportId is not null" IsOpenChanged="OnOpenChanged" Size="BottomSheet.SheetSize.Full"
             Title="@(_detail?.Summary.Code ?? "Sample Report")"
             Subtitle="@(_detail is null ? null : $"{_detail.Summary.SampleCode} {MiddleDot} {_detail.Summary.FarmerName}")"
             CssClass="rv-sheet">
    <ChildContent>
        @if (_loading)
        {
            <Skeleton Variant="card" Rows="2" />
        }
        else if (_detail is null)
        {
            <EmptyState Icon="bi-file-earmark-x" Title="Report not available" Message="This sample report could not be loaded." Compact="true" />
        }
        else
        {
            var s = _detail.Summary;
            var sample = _detail.Sample;
            <div class="rv">
                <div class="rv-head">
                    <LabPill Text="@AnalystText.ReportStatusText(s.Status)" Tone="@AnalystText.ReportTone(s.Status)" />
                    <span class="rv-generated">Generated @AnalystText.DateTimeText(s.GeneratedAt)</span>
                </div>

                <dl class="rv-grid">
                    <div><dt>Farmer Name</dt><dd>@s.FarmerName</dd></div>
                    <div><dt>Mobile Number</dt><dd>@AnalystText.Dash(sample.FarmerMobile)</dd></div>
                    <div><dt>Village</dt><dd>@AnalystText.Dash(s.Village)</dd></div>
                    <div><dt>Crop</dt><dd>@AnalystText.Dash(s.Crop)</dd></div>
                    <div><dt>Sample Number</dt><dd>@s.SampleCode</dd></div>
                    <div><dt>Sample Type</dt><dd>@AnalystText.SampleTypeText(s.SampleType)</dd></div>
                    <div><dt>Batch Number</dt><dd>@s.BatchCode</dd></div>
                    <div><dt>Downloads</dt><dd>@s.DownloadCount</dd></div>
                </dl>

                <h3 class="rv-title">@(s.SampleType == SampleType.Water ? "Irrigation Water Analysis" : "Soil Sample Analysis")</h3>
                @if (sample.Parameters.Count == 0)
                {
                    <p class="rv-empty">No parameter results on this report.</p>
                }
                else
                {
                    <div class="rv-table-wrap">
                        <table class="rv-table">
                            <thead>
                                <tr>
                                    <th scope="col">Parameters</th>
                                    <th scope="col">Result</th>
                                    <th scope="col">Response</th>
                                    <th scope="col">Optimum Range</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in sample.Parameters)
                                {
                                    <tr>
                                        <th scope="row">@p.Name@(string.IsNullOrWhiteSpace(p.Unit) || p.Unit == "-" ? "" : $" ({p.Unit})")</th>
                                        <td class="rv-value">@AnalystText.Dash(p.EnteredValue)</td>
                                        <td class="rv-resp rv-resp--@(p.Status?.ToString().ToLowerInvariant() ?? "none")">@AnalystText.Dash(p.ResultLabel)</td>
                                        <td>@AnalystText.Dash(p.NormalRange)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(sample.OverallStatusText))
                {
                    <div class="rv-overall">
                        <span>@AnalystText.OverallLabel(s.SampleType)</span>
                        <LabPill Text="@sample.OverallStatusText" Tone="@AnalystText.OverallTone(sample.OverallStatus)" />
                    </div>
                }

                @if (sample.Recommendations.Count > 0)
                {
                    <h3 class="rv-title">Recommendations</h3>
                    @foreach (var g in sample.Recommendations)
                    {
                        <div class="rv-reco">
                            <span class="rv-reco-title">@AnalystText.RecommendationTitle(g.Group)</span>
                            <ul>
                                @foreach (var line in g.Lines)
                                {
                                    <li>@line</li>
                                }
                            </ul>
                        </div>
                    }
                }

                @if (!string.IsNullOrWhiteSpace(sample.CropSuitabilityNote))
                {
                    <p class="rv-note"><strong>Note:</strong> @sample.CropSuitabilityNote</p>
                }

                @* Phase 2b: the adjusted schedule the soil PDF prints ("Recommendations (Kg/acre)"). *@
                @if (ScheduleColumns.Count > 0)
                {
                    <h3 class="rv-title">Fertilizer Schedule (Kg/acre)</h3>
                    <p class="rv-fs-sub">Adjusted to this sample's results: base quantity x dose factor of the nutrient's status.</p>
                    @foreach (var col in ScheduleColumns)
                    {
                        <div class="rv-fs-crop">
                            <span class="rv-reco-title">@ScheduleTitle(col)</span>

                            <div class="rv-table-wrap tablet-up">
                                <table class="rv-table">
                                    <thead>
                                        <tr>
                                            <th scope="col">Product</th>
                                            <th scope="col">Status Used</th>
                                            <th scope="col" class="rv-fs-num">Base</th>
                                            <th scope="col" class="rv-fs-num">Factor</th>
                                            <th scope="col" class="rv-fs-num">Adjusted</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var stage in col.Rows.GroupBy(r => r.Stage))
                                        {
                                            <tr class="rv-fs-stage"><th scope="colgroup" colspan="5">@StageTitle(stage.First())</th></tr>
                                            @foreach (var r in stage)
                                            {
                                                <tr>
                                                    <th scope="row">@r.Product@(string.IsNullOrWhiteSpace(r.Nutrient) ? "" : $" ({r.Nutrient})")</th>
                                                    <td class="rv-resp rv-resp--@StatusSlug(r)">@StatusText(r)</td>
                                                    <td class="rv-fs-num">@Kg(r.BaseKgPerAcre)</td>
                                                    <td class="rv-fs-num">x @Kg(r.Factor)</td>
                                                    <td class="rv-fs-num rv-value">
                                                        @Kg(r.AdjustedKgPerAcre)
                                                        @if (r.NotRequired)
                                                        {
                                                            <span class="rv-fs-nr">not required</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <div class="rv-fs-cards phone-only">
                                @foreach (var stage in col.Rows.GroupBy(r => r.Stage))
                                {
                                    <div class="rv-fs-card">
                                        <span class="rv-fs-card-title">@StageTitle(stage.First())</span>
                                        <ul>
                                            @foreach (var r in stage)
                                            {
                                                <li>
                                                    <span class="rv-fs-line">
                                                        <span>@r.Product</span>
                                                        <strong>@Kg(r.AdjustedKgPerAcre)</strong>
                                                    </span>
                                                    <span class="rv-fs-line-sub">
                                                        @Kg(r.BaseKgPerAcre) x @Kg(r.Factor) &middot; <span class="rv-resp rv-resp--@StatusSlug(r)">@StatusText(r)</span>
                                                        @if (r.NotRequired)
                                                        {
                                                            <span class="rv-fs-nr">not required</span>
                                                        }
                                                    </span>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        }
    </ChildContent>
    <Footer>
        @if (_detail is not null)
        {
            <div class="rv-foot">
                <button type="button" class="rv-btn" disabled="@(_printing || _detail.Summary.Status == LabReportStatus.Printed)" @onclick="MarkPrintedAsync"
                        title="@(_detail.Summary.Status == LabReportStatus.Printed ? "Printed" : "Mark printed")" aria-label="@(_detail.Summary.Status == LabReportStatus.Printed ? "Printed" : "Mark printed")">
                    <i class="bi bi-printer" aria-hidden="true"></i>
                    <span class="tablet-up">@(_detail.Summary.Status == LabReportStatus.Printed ? "Printed" : "Mark printed")</span>
                </button>
                <LabSplitButton Label="Download PDF" Languages="LanguagesFor" Busy="DownloadingId == _detail.Summary.Id"
                                OnPick="lang => OnDownload.InvokeAsync((_detail.Summary.Id, _detail.Summary.Code, lang))" />
            </div>
        }
    </Footer>
</BottomSheet>

@code {
    [Parameter] public int? ReportId { get; set; }
    [Parameter] public List<LabLanguageDto>? Languages { get; set; }
    [Parameter] public int? DownloadingId { get; set; }
    /// <summary>Bumped by the page after a download or a status change, so the open report reloads (download count, status).</summary>
    [Parameter] public int RefreshKey { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<(int ReportId, string Code, string Lang)> OnDownload { get; set; }
    [Parameter] public EventCallback<LabReportRowDto> OnPrinted { get; set; }

    private const char MiddleDot = (char)0xB7;

    private LabReportDetailDto? _detail;
    private int? _loadedId;
    private int _loadedKey;
    private bool _loading;
    private bool _printing;
    private readonly CancellationTokenSource _cts = new();

    /// <summary>The report's own language list when it sends one, else the configured languages.</summary>
    private List<LabLanguageDto>? LanguagesFor
    {
        get
        {
            if (_detail?.Languages is not { Count: > 0 } codes || Languages is null) return Languages;
            var offered = Languages.Where(l => codes.Contains(l.Code, StringComparer.OrdinalIgnoreCase)).ToList();
            return offered.Count > 0 ? offered : Languages;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (ReportId == _loadedId && RefreshKey == _loadedKey) return;
        var sameReport = ReportId == _loadedId;
        _loadedId = ReportId;
        _loadedKey = RefreshKey;
        if (!sameReport) _detail = null;
        if (ReportId is not int id) return;

        _loading = !sameReport;
        _detail = await Api.GetReportAsync(id, _cts.Token) ?? (sameReport ? _detail : null);
        _loading = false;
    }

    // ---------------------------------------------------------------- fertilizer schedule (phase 2b)

    /// <summary>The schedule's crop columns, once each (Crop1 comes twice when there is no Crop2, like the PDF).</summary>
    private List<LabFertilizerScheduleDto> ScheduleColumns => (_detail?.Sample.FertilizerSchedule ?? new())
        .Where(c => c.Rows.Count > 0)
        .GroupBy(c => $"{c.Crop}|{c.ScheduleCrop}|{c.IsGeneral}", StringComparer.OrdinalIgnoreCase)
        .Select(g => g.First())
        .ToList();

    private static string ScheduleTitle(LabFertilizerScheduleDto c) =>
        !c.IsGeneral ? c.Crop
        : string.IsNullOrWhiteSpace(c.Crop) ? "General (no crop on the sample)"
        : $"General (no schedule configured for {c.Crop})";

    private static string StageTitle(LabFertilizerScheduleRowDto r) =>
        r.DayNumber is int day ? $"{r.StageName} ({day}th day)" : r.StageName;

    private static string Kg(decimal v) => v.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);

    private static string StatusText(LabFertilizerScheduleRowDto r)
    {
        if (string.IsNullOrWhiteSpace(r.StatusUsed)) return "-";
        var name = string.IsNullOrWhiteSpace(r.ParameterName) ? r.StatusNutrient : r.ParameterName;
        var status = Enum.TryParse<LabResultStatus>(r.StatusUsed, out var st) ? AnalystText.ResultStatusText(st) : "not tested";
        return $"{name}: {status}";
    }

    private static string StatusSlug(LabFertilizerScheduleRowDto r) =>
        Enum.TryParse<LabResultStatus>(r.StatusUsed, out var st) ? st.ToString().ToLowerInvariant() : "none";

    private Task OnOpenChanged(bool open) => open ? Task.CompletedTask : OnClose.InvokeAsync();

    private async Task MarkPrintedAsync()
    {
        if (_detail is null || _printing) return;
        _printing = true;
        try
        {
            var updated = await Api.MarkReportPrintedAsync(_detail.Summary.Id, _cts.Token);
            if (updated is null) return;
            _detail.Summary = updated;
            await OnPrinted.InvokeAsync(updated);
        }
        finally
        {
            _printing = false;
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
