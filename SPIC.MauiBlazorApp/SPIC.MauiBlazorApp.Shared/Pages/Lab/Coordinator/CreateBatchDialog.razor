@namespace SPIC.MauiBlazorApp.Shared.Pages.Lab.Coordinator
@inject LabApi Api
@inject ToastService Toast
@implements IDisposable

@*
    Create Batch (screen 3). Batch No is generated by the API; the consignments picked on the
    list arrive as removable chips inside a searchable multi-select over the Batch Pending
    consignments; Batch Created Date (today), Assign To (analysts with open batches), Priority
    (Low / Medium / High, default Medium) and Remarks. Confirm posts api/Lab/batches and hands
    the new batch to OnCreated (the caller shows Batch Created, screen 4).
*@

<LabDialog IsOpen="IsOpen" IsOpenChanged="SetOpenAsync" Title="Create Batch"
           Subtitle="Group Batch Pending consignments into one batch for analysis." Width="640">
    <ChildContent>
        <div class="lf-form cbd">
            <div class="lf-field">
                <label class="lf-label" for="cbd-no">Batch No</label>
                <input id="cbd-no" class="lf-input cbd-readonly" value="Auto-generated" readonly />
            </div>

            <div class="lf-field">
                <label class="lf-label" for="cbd-date">Batch Created Date <span class="lf-req">*</span></label>
                <input id="cbd-date" type="date" class="lf-input" value="@_date" max="@DateTime.Today.ToString("yyyy-MM-dd")"
                       @onchange="e => _date = e.Value?.ToString() ?? string.Empty" />
            </div>

            <div class="lf-field lf-field--full">
                <label class="lf-label" for="cbd-search">Consignment No. <span class="lf-req">*</span></label>
                <div class="cbd-multi @(_showError && _picked.Count == 0 ? "is-bad" : "")">
                    @foreach (var c in _picked)
                    {
                        var row = c;
                        <span class="lf-chip">
                            @row.Code
                            <button type="button" aria-label="@($"Remove {row.Code}")" @onclick="() => Remove(row)"><i class="bi bi-x" aria-hidden="true"></i></button>
                        </span>
                    }
                    <input id="cbd-search" class="cbd-multi-input" type="search" autocomplete="off"
                           placeholder="@(_picked.Count == 0 ? "Search Batch Pending consignments" : "Add another consignment")"
                           value="@_q" @oninput="OnSearchInput" @onfocus="() => _listOpen = true" />
                </div>
                @if (_showError && _picked.Count == 0)
                {
                    <span class="lf-error">Pick at least one consignment.</span>
                }
                <span class="lf-hint">@_picked.Count consignment@(_picked.Count == 1 ? "" : "s") · @_picked.Sum(p => p.TotalSamples) samples</span>

                @if (_listOpen)
                {
                    <div class="cbd-options" role="listbox" aria-label="Batch Pending consignments">
                        @if (_optionsLoading)
                        {
                            <span class="cbd-empty">Loading...</span>
                        }
                        else if (Options.Count == 0)
                        {
                            <span class="cbd-empty">@(string.IsNullOrWhiteSpace(_q) ? "No other Batch Pending consignments." : "No Batch Pending consignment matches.")</span>
                        }
                        else
                        {
                            @foreach (var o in Options)
                            {
                                var row = o;
                                <button type="button" role="option" aria-selected="false" class="cbd-option" @onclick="() => Add(row)">
                                    <span class="cbd-option-main">
                                        <span class="cbd-option-code">@row.Code</span>
                                        <span class="cbd-option-sub">@LabText.Date(row.ShipmentDate) · @LabText.Dash(row.StateName)</span>
                                    </span>
                                    <span class="cbd-option-count">@row.TotalSamples sample@(row.TotalSamples == 1 ? "" : "s")</span>
                                </button>
                            }
                        }
                    </div>
                }
            </div>

            <div class="lf-field">
                <label class="lf-label" for="cbd-assign">Assign To</label>
                <LabAnalystPicker Id="cbd-assign" Analysts="_analysts" @bind-Value="_assignee" Placeholder="Select analyst (optional)" />
            </div>

            <div class="lf-field">
                <span class="lf-label" id="cbd-priority">Priority</span>
                <div class="cbd-priority" role="radiogroup" aria-labelledby="cbd-priority">
                    @foreach (var p in Priorities)
                    {
                        var value = p;
                        <button type="button" role="radio" aria-checked="@(_priority == value ? "true" : "false")"
                                class="cbd-prio cbd-prio--@value.ToString().ToLowerInvariant() @(_priority == value ? "is-on" : "")"
                                @onclick="() => _priority = value">@value</button>
                    }
                </div>
            </div>

            <div class="lf-field lf-field--full">
                <label class="lf-label" for="cbd-remarks">Remarks</label>
                <textarea id="cbd-remarks" class="lf-input" rows="3" maxlength="1000" placeholder="Enter remarks"
                          @bind="_remarks" @bind:event="oninput"></textarea>
            </div>
        </div>
    </ChildContent>
    <Footer>
        <div class="lf-footer">
            <button type="button" class="lf-btn lf-btn--outline" @onclick="() => SetOpenAsync(false)" disabled="@_saving">Cancel</button>
            <button type="button" class="lf-btn lf-btn--primary" @onclick="ConfirmAsync" disabled="@_saving">
                @if (_saving)
                {
                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                }
                Confirm
            </button>
        </div>
    </Footer>
</LabDialog>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    /// <summary>Consignments ticked on the list (pre-filled chips).</summary>
    [Parameter] public List<LabConsignmentRowDto> Initial { get; set; } = new();
    [Parameter] public EventCallback<LabBatchDetailDto> OnCreated { get; set; }

    private static readonly SampleBatchPriority[] Priorities = { SampleBatchPriority.Low, SampleBatchPriority.Medium, SampleBatchPriority.High };

    private readonly List<LabConsignmentRowDto> _picked = new();
    private List<LabConsignmentRowDto> _pending = new();
    private List<LabUserDto> _analysts = new();
    private string _date = "";
    private string? _assignee;
    private SampleBatchPriority _priority = SampleBatchPriority.Medium;
    private string _remarks = "";
    private string _q = "";
    private bool _listOpen;
    private bool _optionsLoading;
    private bool _saving;
    private bool _showError;
    private bool _wasOpen;
    private CancellationTokenSource? _searchCts;

    private List<LabConsignmentRowDto> Options => _pending.Where(p => _picked.All(x => x.Id != p.Id)).ToList();

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && !_wasOpen)
        {
            _wasOpen = true;
            Reset();
            var analysts = Api.GetAnalystsAsync();
            await LoadOptionsAsync();
            _analysts = await analysts ?? new();
        }
        else if (!IsOpen)
        {
            _wasOpen = false;
        }
    }

    private void Reset()
    {
        _picked.Clear();
        _picked.AddRange(Initial.OrderBy(c => c.Code));
        _date = DateTime.Today.ToString("yyyy-MM-dd");
        _assignee = null;
        _priority = SampleBatchPriority.Medium;
        _remarks = "";
        _q = "";
        _listOpen = Initial.Count == 0;
        _showError = false;
        _saving = false;
    }

    private async Task LoadOptionsAsync()
    {
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        var ct = _searchCts.Token;

        _optionsLoading = true;
        var page = await Api.GetConsignmentsAsync(status: nameof(LabConsignmentStatus.BatchPending), q: string.IsNullOrWhiteSpace(_q) ? null : _q,
            pageSize: 50, ct: ct);
        if (ct.IsCancellationRequested) return;
        _pending = page?.Items ?? new();
        _optionsLoading = false;
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        var text = e.Value?.ToString() ?? "";
        _q = text;
        _listOpen = true;
        await Task.Delay(300);
        if (_q != text) return;   // a later keystroke owns the search
        await LoadOptionsAsync();
    }

    private void Add(LabConsignmentRowDto row)
    {
        if (_picked.All(p => p.Id != row.Id)) _picked.Add(row);
        _showError = false;
    }

    private void Remove(LabConsignmentRowDto row) => _picked.RemoveAll(p => p.Id == row.Id);

    private async Task SetOpenAsync(bool open)
    {
        if (!open && _saving) return;
        IsOpen = open;
        if (!open) _wasOpen = false;
        await IsOpenChanged.InvokeAsync(open);
    }

    private async Task ConfirmAsync()
    {
        if (_picked.Count == 0)
        {
            _showError = true;
            _listOpen = true;
            return;
        }

        _saving = true;
        var dto = new LabBatchCreateDto
        {
            ConsignmentIds = _picked.Select(p => p.Id).ToList(),
            BatchDate = DateTime.TryParse(_date, out var d) ? d.Date : DateTime.Today,
            AssignedToUserId = _assignee,
            Priority = _priority,
            Remarks = string.IsNullOrWhiteSpace(_remarks) ? null : _remarks.Trim()
        };

        var created = await Api.CreateBatchAsync(dto);
        _saving = false;
        if (created is null) return;   // LabApi already showed the reason

        await SetOpenAsync(false);
        await OnCreated.InvokeAsync(created);
    }

    public void Dispose()
    {
        _searchCts?.Cancel();
        _searchCts?.Dispose();
    }
}
