@page "/DealerReviewList"

  <main class="page-wrapper">

    <!-- ── Header Section ── -->
    <section class="page-header">
      <div class="header-row">
        <div style="flex:1; min-width:0;">
          <h1 class="header-title">Dealer Applications Review</h1>
          <p class="header-desc">Review and approve dealer registration</p>
        </div>
        <span class="badge-role">Regional Manager (RM)</span>
      </div>
    </section>

    <!-- ── Dashboard Section ── -->
    <section>

      <!-- Summary Cards -->
      <div class="summary-grid mb-4">

        <!-- Total Applications -->
        <div class="summary-card card-total">
          <svg class="summary-card-icon" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="56" height="56" rx="12" fill="#ECF5FF"/>
            <path d="M20 20h16v16H20V20z" stroke="#3b82f6" stroke-width="1.5" stroke-linejoin="round"/>
            <path d="M24 24h8M24 28h8M24 32h4" stroke="#3b82f6" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <div>
            <p class="summary-card-title">Total Applications</p>
            <p class="summary-card-value">12</p>
          </div>
        </div>

        <!-- Pending Review -->
        <div class="summary-card card-pending">
          <svg class="summary-card-icon" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="56" height="56" rx="12" fill="#FFFBE8"/>
            <circle cx="28" cy="28" r="10" stroke="#e17100" stroke-width="1.5"/>
            <path d="M28 23v6l3 3" stroke="#e17100" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <div>
            <p class="summary-card-title">Pending Review</p>
            <p class="summary-card-value">08</p>
          </div>
        </div>

        <!-- Verified -->
        <div class="summary-card card-verified">
          <svg class="summary-card-icon" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="56" height="56" rx="12" fill="#F1FFF8"/>
            <path d="M20 28l6 6 10-12" stroke="#28a66c" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <div>
            <p class="summary-card-title">Verified</p>
            <p class="summary-card-value">03</p>
          </div>
        </div>

        <!-- Sent Back -->
        <div class="summary-card card-sentback">
          <svg class="summary-card-icon" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="56" height="56" rx="12" fill="#FFE8E8"/>
            <path d="M34 22l-12 12M22 22l12 12" stroke="#a62828" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <div>
            <p class="summary-card-title">Sent Back</p>
            <p class="summary-card-value">01</p>
          </div>
        </div>

      </div>

      <!-- Applications Table Card -->
      <div class="applications-card">

        <div class="applications-header">
          <h2 class="applications-title">Applications</h2>
          <div class="search-wrapper">
            <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
            </svg>
            <input class="search-input" type="text" placeholder="Search applications..." />
          </div>
        </div>

        <!-- Table -->
        <div class="table-container mb-0">
          <table class="app-table">
            <thead>
              <tr>
                <th>S:No</th>
                <th>Application ID</th>
                <th>Dealer Name</th>
                <th>Current Stage</th>
                <th>Status</th>
                <th>Credit Limit</th>
                <th>Last Updated</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>

              <!-- Row 1 -->
              <tr>
                <td><span style="font-weight:500;">1</span></td>
                <td>APP-2026-001</td>
                <td>
                  <div class="dealer-cell">
                    <div class="dealer-avatar">A</div>
                    <span>Agro Enterprises Pvt Ltd</span>
                  </div>
                </td>
                <td><span class="badge-stage badge-stage-rm">Regional Manager (RM)</span></td>
                <td><span class="badge-status badge-status-pending">Pending</span></td>
                <td>&#8377;20 L</td>
                <td>Apr 15 2026</td>
                <td>
                  <button class="btn-action" aria-label="View application APP-2026-001">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/>
                    </svg>
                  </button>
                </td>
              </tr>

              <!-- Row 2 -->
              <tr>
                <td><span style="font-weight:500;">2</span></td>
                <td>APP-2026-001</td>
                <td>
                  <div class="dealer-cell">
                    <div class="dealer-avatar">A</div>
                    <span>Agro Enterprises Pvt Ltd</span>
                  </div>
                </td>
                <td><span class="badge-stage badge-stage-rm">Regional Manager (RM)</span></td>
                <td><span class="badge-status badge-status-verified">Verified</span></td>
                <td>&#8377;20 L</td>
                <td>Apr 15 2026</td>
                <td>
                  <button class="btn-action" aria-label="View application APP-2026-001">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/>
                    </svg>
                  </button>
                </td>
              </tr>

              <!-- Row 3 -->
              <tr>
                <td><span style="font-weight:500;">3</span></td>
                <td>APP-2026-001</td>
                <td>
                  <div class="dealer-cell">
                    <div class="dealer-avatar">A</div>
                    <span>Agro Enterprises Pvt Ltd</span>
                  </div>
                </td>
                <td><span class="badge-stage badge-stage-mo">Marketing Officer (MO)</span></td>
                <td><span class="badge-status badge-status-sentback">Sent Back</span></td>
                <td>&#8377;20 L</td>
                <td>Apr 15 2026</td>
                <td>
                  <button class="btn-action" aria-label="View application APP-2026-001">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/>
                    </svg>
                  </button>
                </td>
              </tr>

              <!-- Row 4 -->
              <tr>
                <td><span style="font-weight:500;">4</span></td>
                <td>APP-2026-001</td>
                <td>
                  <div class="dealer-cell">
                    <div class="dealer-avatar">A</div>
                    <span>Agro Enterprises Pvt Ltd</span>
                  </div>
                </td>
                <td><span class="badge-stage badge-stage-rm">Regional Manager (RM)</span></td>
                <td><span class="badge-status badge-status-verified">Verified</span></td>
                <td>&#8377;20 L</td>
                <td>Apr 15 2026</td>
                <td>
                  <button class="btn-action" aria-label="View application APP-2026-001">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/>
                    </svg>
                  </button>
                </td>
              </tr>

            </tbody>
          </table>
        </div>

        <!-- Footer: Items Per Page + Pagination -->
        <div class="table-footer">

          <!-- Items Per Page -->
          <div class="items-per-page">
            <span class="items-per-page-label">Items Per Page</span>
            <button class="items-per-page-btn">
              <span>16</span>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m6 9 6 6 6-6"/>
              </svg>
            </button>
          </div>

          <!-- Pagination -->
          <nav aria-label="Page navigation">
            <div class="pagination-wrapper">

              <!-- Previous -->
              <button class="page-nav-btn" aria-label="Previous page">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m15 18-6-6 6-6"/>
                </svg>
              </button>

              <button class="page-number-btn active" aria-current="page">1</button>
              <button class="page-number-btn">2</button>
              <button class="page-number-btn">3</button>
              <button class="page-number-btn">..</button>
              <button class="page-number-btn">8</button>
              <button class="page-number-btn">9</button>
              <button class="page-number-btn">10</button>

              <!-- Next -->
              <button class="page-nav-btn" aria-label="Next page">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m9 18 6-6-6-6"/>
                </svg>
              </button>

            </div>
          </nav>

        </div>
      </div>

    </section>
  </main>
  <style>


    .page-wrapper {
      max-width: 1660px;
      margin: 0 auto;
      padding: 24px 16px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    /* ── Header ── */
    .page-header {
      display: flex;
      flex-direction: column;
      gap: 32px;
    }

    .header-row {
      display: flex;
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
    }

    .header-title {
      font-size: 28px;
      font-weight: 600;
      color: #47443f;
      letter-spacing: -0.56px;
      line-height: 40px;
      margin: 0;
    }

    .header-desc {
      font-size: 18px;
      font-weight: 400;
      color: #364153;
      line-height: 20px;
      margin: 0;
    }

    .badge-role {
      display: inline-flex;
      align-items: center;
      background-color: #dbfdfe;
      color: #3cb8ad;
      border: 1px solid #bef8ff;
      border-radius: 8px;
      padding: 4px 12px;
      font-size: 14px;
      font-weight: 400;
      line-height: 20px;
      white-space: nowrap;
      flex-shrink: 0;
    }

    /* ── Summary Cards ── */
    .summary-grid {
      display: grid;
      grid-template-columns: repeat(1, 1fr);
      gap: 24px;
    }

    @@media (min-width: 768px) {
      .summary-grid { grid-template-columns: repeat(2, 1fr); }
    }

    @@media (min-width: 1200px) {
      .summary-grid { grid-template-columns: repeat(4, 1fr); }
    }

    .summary-card {
      border-radius: 16px;
      border-width: 0.8px;
      border-style: solid;
      padding: 24px;
      display: flex;
      align-items: center;
      gap: 24px;
    }

    .summary-card.card-total {
      border-color: #d8d2e0;
      background: linear-gradient(135deg, rgba(236,245,255,1) 0%, rgba(255,254,255,1) 100%);
    }

    .summary-card.card-pending {
      border-color: #d2dee0;
      background: linear-gradient(135deg, rgba(255,251,232,1) 0%, rgba(255,254,255,1) 100%);
    }

    .summary-card.card-verified {
      border-color: #d2dee0;
      background: linear-gradient(135deg, rgba(241,255,248,1) 0%, rgba(255,254,255,1) 100%);
    }

    .summary-card.card-sentback {
      border-color: #e0d2d2;
      background: linear-gradient(135deg, rgba(255,232,232,1) 0%, rgba(255,254,255,1) 100%);
    }

    .summary-card-icon {
      width: 56px;
      height: 56px;
      flex-shrink: 0;
      object-fit: contain;
    }

    .summary-card-title {
      font-size: 22px;
      font-weight: 600;
      color: #395a45;
      line-height: 32px;
      margin: 0 0 8px 0;
    }

    .summary-card-value {
      font-size: 28px;
      font-weight: 600;
      color: #085726;
      line-height: 42px;
      margin: 0;
    }

    /* ── Main Applications Card ── */
    .applications-card {
      background: #ffffff;
      border: 1px solid #e6ece9;
      border-radius: 20px;
      padding: 32px;
      box-shadow: 4px 4px 12px rgba(233,233,233,0.25), -4px -4px 12px rgba(231,231,231,0.3);
    }

    .applications-header {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 24px;
    }

    @@media (min-width: 768px) {
      .applications-header {
        flex-direction: row;
        align-items: center;
      }
    }

    .applications-title {
      font-size: 22px;
      font-weight: 600;
      color: #36483d;
      line-height: 32px;
      margin: 0;
    }

    /* ── Search ── */
    .search-wrapper {
      position: relative;
      width: 100%;
    }

    @@media (min-width: 768px) {
      .search-wrapper { width: 315px; }
    }

    .search-icon {
      position: absolute;
      left: 12px;
      top: 50%;
      transform: translateY(-50%);
      width: 20px;
      height: 20px;
      color: #bebebe;
      pointer-events: none;
    }

    .search-input {
      width: 100%;
      height: 44px;
      border: none;
      border-radius: 10px;
      background-color: #f3f3f3;
      padding: 0 12px 0 40px;
      font-size: 12px;
      font-weight: 400;
      color: #191c1d;
      font-family: 'Inter', Helvetica, sans-serif;
      outline: none;
    }

    .search-input::placeholder { color: #bebebe; }

    /* ── Table ── */
    .table-container {
      border: 1px solid #d8ebe1;
      border-radius: 8px;
      overflow-x: auto;
      background: #ffffff;
    }

    .app-table {
      width: 100%;
      min-width: 1180px;
      border-collapse: separate;
      border-spacing: 0;
      margin: 0;
    }

    .app-table thead tr th {
      background-color: #f2f3f3;
      border-bottom: 1px solid #d0dfd8;
      padding: 18px 24px;
      text-align: center;
      vertical-align: middle;
      font-size: 16px;
      font-weight: 600;
      color: #40493d;
      white-space: nowrap;
      font-family: 'Inter', Helvetica, sans-serif;
    }

    .app-table tbody tr { background: #ffffff; }

    .app-table tbody tr td {
      border-bottom: 1px solid #e8eeeb;
      padding: 26px 24px;
      text-align: center;
      vertical-align: middle;
      height: 76px;
      font-size: 14px;
      font-weight: 400;
      color: #191c1d;
      white-space: nowrap;
      font-family: 'Inter', Helvetica, sans-serif;
    }

    .app-table tbody tr:last-child td { border-bottom: none; }

    /* ── Dealer Name cell ── */
    .dealer-cell {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
    }

    .dealer-avatar {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      overflow: hidden;
      background-color: #e2e8f0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      font-weight: 600;
      color: #64748b;
      flex-shrink: 0;
    }

    .dealer-avatar img { width: 100%; height: 100%; object-fit: cover; }

    /* ── Stage Badges ── */
    .badge-stage {
      display: inline-flex;
      align-items: center;
      border: 1px solid;
      border-radius: 8px;
      padding: 4px 12px;
      font-size: 14px;
      font-weight: 400;
      line-height: 20px;
      font-family: 'Inter', Helvetica, sans-serif;
    }

    .badge-stage-rm {
      background-color: #dbfdfe;
      color: #3cb8ad;
      border-color: #bef8ff;
    }

    .badge-stage-mo {
      background-color: #fedbfa;
      color: #b83ca3;
      border-color: #ffbefa;
    }

    /* ── Status Badges ── */
    .badge-status {
      display: inline-flex;
      align-items: center;
      border: 1px solid;
      border-radius: 100px;
      padding: 7px 16px;
      font-size: 14px;
      font-weight: 500;
      line-height: 20px;
      font-family: 'Inter', Helvetica, sans-serif;
    }

    .badge-status-pending {
      background-color: #fffceb;
      color: #e17100;
      border-color: #fff6cf;
    }

    .badge-status-verified {
      background-color: #f3fff9;
      color: #28a66c;
      border-color: #d9fce9;
    }

    .badge-status-sentback {
      background-color: #fff3f3;
      color: #a62828;
      border-color: #fcd9d9;
    }

    /* ── Eye Action Button ── */
    .btn-action {
      background: none;
      border: none;
      padding: 0;
      cursor: pointer;
      color: #6da7d9;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .btn-action:hover { color: #6da7d9; opacity: 0.8; }

    .btn-action svg { width: 16px; height: 16px; }

    /* ── Footer: Items Per Page + Pagination ── */
    .table-footer {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      align-items: flex-start;
      gap: 16px;
      margin-top: 32px;
    }

    @@media (min-width: 768px) {
      .table-footer {
        flex-direction: row;
        align-items: center;
      }
    }

    .items-per-page {
      display: inline-flex;
      align-items: center;
      gap: 16px;
    }

    .items-per-page-label {
      font-size: 16px;
      font-weight: 500;
      color: #44494d;
      white-space: nowrap;
      font-family: 'Inter', Helvetica, sans-serif;
    }

    .items-per-page-btn {
      display: inline-flex;
      align-items: center;
      justify-content: space-between;
      width: 167px;
      border: 1px solid #c6c6c6;
      border-radius: 8px;
      padding: 10px 16px;
      background: #ffffff;
      font-size: 18px;
      font-weight: 500;
      color: #44494d;
      cursor: pointer;
      font-family: 'Inter', Helvetica, sans-serif;
    }

    .items-per-page-btn svg { width: 24px; height: 24px; flex-shrink: 0; }
    .items-per-page-btn:hover { background: #ffffff; }

    /* ── Pagination ── */
    .pagination-wrapper {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .page-nav-btn {
      width: 32px;
      height: 32px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: #ffffff;
      border: 1px solid #ededed;
      border-radius: 8px;
      color: #484848;
      cursor: pointer;
      padding: 0;
    }

    .page-nav-btn svg { width: 16px; height: 16px; }
    .page-nav-btn:hover { background: #f9f9f9; }

    .page-number-btn {
      min-width: 32px;
      height: auto;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 8px;
      padding: 9px 13px;
      font-size: 16px;
      font-weight: 500;
      color: #484848;
      cursor: pointer;
      font-family: 'Inter', Helvetica, sans-serif;
      border: 1px solid #ededed;
      background: #ffffff;
    }

    .page-number-btn.active {
      background: #ececec;
      border-color: #ececec;
    }

    .page-number-btn:hover:not(.active) { background: #f9f9f9; }
  </style>