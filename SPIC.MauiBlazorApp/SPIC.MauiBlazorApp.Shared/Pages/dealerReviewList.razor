        gap: 10px;
    }

    .dealer-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        overflow: hidden;
        background-color: #e2e8f0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        font-weight: 600;
        color: #64748b;
        flex-shrink: 0;
    }

    .dealer-avatar img { width: 100%; height: 100%; object-fit: cover; }

    /* ── Stage Badges ── */
    .badge-stage {
        display: inline-flex;
        align-items: center;
        border: 1px solid;
        border-radius: 8px;
        padding: 4px 12px;
        font-size: 14px;
        font-weight: 400;
        line-height: 20px;
        font-family: 'Inter', Helvetica, sans-serif;
    }

    .badge-stage-rm {
        background-color: #dbfdfe;
        color: #3cb8ad;
        border-color: #bef8ff;
    }

    .badge-stage-mo {
        background-color: #fedbfa;
        color: #b83ca3;
        border-color: #ffbefa;
    }

    /* ── Status Badges ── */
    .badge-status {
        display: inline-flex;
        align-items: center;
        border: 1px solid;
        border-radius: 100px;
        padding: 7px 16px;
        font-size: 14px;
        font-weight: 500;
        line-height: 20px;
        font-family: 'Inter', Helvetica, sans-serif;
    }

    .badge-status-pending {
        background-color: #fffceb;
        color: #e17100;
        border-color: #fff6cf;
