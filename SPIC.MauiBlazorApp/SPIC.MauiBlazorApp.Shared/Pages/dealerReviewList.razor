@page "/DealerReviewList"
@using System.Net.Http.Json
@using SPIC.MauiBlazorApp.Shared.Services
@inject HttpClient Http
@inject NavigationManager NavManager
@inject LoginState LoginState

<main class="page-wrapper d-flex flex-column gap-3">

    <!-- ── Header Section ── -->
    <section class="page-header">
        <div class="header-row">
            <div style="flex:1; min-width:0;">
                <h1 class="header-title">Dealer Applications Review</h1>
                <p class="header-desc">Review and approve dealer registration</p>
            </div>
            <span class="badge-role">Regional Manager (RM)</span>
        </div>
    </section>

    <!-- ── Dashboard Section ── -->
    <section>

        <!-- Summary Cards -->
        <div class="summary-grid mb-4">
            <div class="summary-card card-total">
                <svg class="summary-card-icon" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect width="56" height="56" rx="12" fill="#ECF5FF"/>
                    <path d="M20 20h16v16H20V20z" stroke="#3b82f6" stroke-width="1.5" stroke-linejoin="round"/>
                    <path d="M24 24h8M24 28h8M24 32h4" stroke="#3b82f6" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
                <div>
                    <p class="summary-card-title">Total Applications</p>
                    <p class="summary-card-value">@_allDealers.Count</p>
                </div>
            </div>

            <div class="summary-card card-pending">
                <svg class="summary-card-icon" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect width="56" height="56" rx="12" fill="#FFFBE8"/>
                    <circle cx="28" cy="28" r="10" stroke="#e17100" stroke-width="1.5"/>
                    <path d="M28 23v6l3 3" stroke="#e17100" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
                <div>
                    <p class="summary-card-title">Pending Review</p>
                    <p class="summary-card-value">@_allDealers.Count(d => d.RMApproved == null || d.SMApproved == null || d.AVPApproved == null)</p>
                </div>
            </div>

            <div class="summary-card card-verified">
                <svg class="summary-card-icon" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect width="56" height="56" rx="12" fill="#F1FFF8"/>
                    <path d="M20 28l6 6 10-12" stroke="#28a66c" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <div>
                    <p class="summary-card-title">Verified</p>
                    <p class="summary-card-value">@_allDealers.Count(d => d.AVPApproved == true)</p>
                </div>
            </div>

            <div class="summary-card card-sentback">
                <svg class="summary-card-icon" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect width="56" height="56" rx="12" fill="#FFE8E8"/>
                    <path d="M34 22l-12 12M22 22l12 12" stroke="#a62828" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
                <div>
                    <p class="summary-card-title">Sent Back</p>
                    <p class="summary-card-value">@_allDealers.Count(d => d.RMApproved == false || d.SMApproved == false || d.AVPApproved == false)</p>
                </div>
            </div>
        </div>

        <!-- Applications Table Card -->
        <div class="applications-card">
            <div class="applications-header">
                <h2 class="applications-title">Applications</h2>
                <div class="table-controls">
                    <div class="search-box">
                        <i class="bi bi-search"></i>
                        <input type="text" placeholder="Search applications..." @bind="_searchText" @bind:event="oninput" @bind:after="ApplyFilter">
                    </div>
                    <select class="filter-select" @bind="_statusFilter" @bind:after="ApplyFilter">
                        <option value="All">All Status</option>
                        <option value="Pending">Pending</option>
                        <option value="Verified">Verified</option>
                        <option value="Sent Back">Sent Back</option>
                    </select>
                </div>
            </div>

            <!-- Table -->
            <div class="table-container">
                @if (_isLoading)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="text-muted mt-2">Loading applications...</p>
                    </div>
                }
                else if (!PagedItems.Any())
                {
                    <div class="text-center py-5">
                        <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
                        <p class="text-muted mt-2">No applications found.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="app-table">
                            <thead>
                                <tr>
                                    <th>S.No</th>
                                    <th>Application ID</th>
                                    <th>Dealer Name</th>
                                    <th>Current Stage</th>
                                    <th>Status</th>
                                    <th>Credit Limit</th>
                                    <th>Last Updated</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in PagedItems.Select((d, i) => new { Dealer = d, Index = (_currentPage - 1) * _pageSize + i + 1 }))
                                {
                                    <tr>
                                        <td><span style="font-weight:500;">@item.Index</span></td>
                                        <td>@(item.Dealer.DealerCode ?? $"APP-{DateTime.Now.Year}-{item.Dealer.Id:D3}")</td>
                                        <td>
                                            <div class="dealer-cell">
                                                <div class="dealer-avatar">@GetInitials(item.Dealer.FirmName)</div>
                                                <span>@(item.Dealer.FirmName ?? "Unnamed Firm")</span>
                                            </div>
                                        </td>
                                        <td><span class="@GetBadgeStageClass(item.Dealer)">@GetBadgeStageText(item.Dealer)</span></td>
                                        <td><span class="@GetBadgeStatusClass(item.Dealer)">@GetBadgeStatusText(item.Dealer)</span></td>
                                        <td>@(item.Dealer.CashCreditLimit > 0 ? $"&#8377;{item.Dealer.CashCreditLimit.ToString("N2")}" : "-")</td>
                                        <td>@item.Dealer.UpdatedAt.ToString("dd MMM yyyy")</td>
                                        <td>
                                            <button class="btn-action" aria-label="View application @(item.Dealer.DealerCode ?? item.Dealer.Id.ToString())" @onclick="() => ReviewDealer(item.Dealer.Id)">
                                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/>
                                                </svg>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <!-- Footer: Items Per Page + Pagination -->
            <div class="table-footer">
                <div class="items-per-page">
                    <span class="items-per-page-label">Items Per Page</span>
                    <select @bind="_pageSize" @bind:after="ApplyFilter">
                        <option value="16">16</option>
                        <option value="32">32</option>
                        <option value="50">50</option>
                    </select>
                </div>

                <nav aria-label="Page navigation">
                    <div class="pagination-wrapper">
                        <button class="page-nav-btn @(_currentPage <= 1 ? "disabled" : "")" aria-label="Previous page" @onclick="PreviousPage">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="m15 18-6-6 6-6"/>
                            </svg>
                        </button>

                        @foreach (var thispage in PageNumbers)
                        {
                            @if (thispage == -1)
                            {
                                <div class="page-number-btn" style="cursor:default;">...</div>
                            }
                            else
                            {
                                <button class="page-number-btn @(thispage == _currentPage ? "active" : "")" aria-current="@(thispage == _currentPage ? "page" : null)" @onclick="() => GoToPage(thispage)">@thispage</button>
                            }
                        }

                        <button class="page-nav-btn @(_currentPage >= TotalPages ? "disabled" : "")" aria-label="Next page" @onclick="NextPage">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="m9 18 6-6-6-6"/>
                            </svg>
                        </button>
                    </div>
                </nav>
            </div>
        </div>
    </section>
</main>

@code {
    private List<DealerDto> _allDealers = new();
    private List<DealerDto> _filteredDealers = new();
    private bool _isLoading = true;
    private HashSet<int> _completeDealerIds = new();

    // Search & filter
    private string _searchText = "";
    private string _statusFilter = "All";

    // Pagination
    private int _currentPage = 1;
    private int _pageSize = 16;

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_filteredDealers.Count / (double)_pageSize));
    private IEnumerable<DealerDto> PagedItems => _filteredDealers
        .Skip((_currentPage - 1) * _pageSize)
        .Take(_pageSize);

    private IEnumerable<int> PageNumbers
    {
        get
        {
            var total = TotalPages;
            if (total <= 7)
                return Enumerable.Range(1, total);

            var pages = new List<int> { 1 };
            var start = Math.Max(2, _currentPage - 1);
            var end = Math.Min(total - 1, _currentPage + 1);

            if (start > 2) pages.Add(-1);
            for (var i = start; i <= end; i++) pages.Add(i);
            if (end < total - 1) pages.Add(-1);
            pages.Add(total);

            return pages;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;
        try
        {
            _allDealers = await Http.GetFromJsonAsync<List<DealerDto>>("api/DealerRegistration/submitted") ?? new();
            BuildCompletionSet();
            ApplyRoleFilter();
            ApplyFilter();
        }
        catch { }
        finally
        {
            _isLoading = false;
        }
    }

    private void BuildCompletionSet()
    {
        _completeDealerIds = _allDealers
            .Where(d => !string.IsNullOrWhiteSpace(d.PinCode))
            .Select(d => d.Id)
            .ToHashSet();
    }

    private void ApplyRoleFilter()
    {
        if (LoginState.IsStateRole)
            _allDealers = _allDealers.Where(d => d.StateId == LoginState.StateId).ToList();
        else if (LoginState.IsRegionRole)
            _allDealers = _allDealers.Where(d => d.Region == LoginState.RegionId).ToList();
        else if (LoginState.IsHQRole)
            _allDealers = _allDealers.Where(d => d.HQ == LoginState.HQId).ToList();
    }

    private void ApplyFilter()
    {
        _filteredDealers = _allDealers
            .Where(d => IsDealerComplete(d.Id))
            .Where(d =>
                string.IsNullOrEmpty(_searchText) ||
                (d.DealerCode?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (d.FirmName?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false))
            .Where(d =>
                _statusFilter switch
                {
                    "Pending" => GetApprovalStatus(d) == "In RM" || GetApprovalStatus(d) == "In SMM" || GetApprovalStatus(d) == "In AVP",
                    "Verified" => GetApprovalStatus(d) == "Approved",
                    "Sent Back" => GetApprovalStatus(d) == "Rejected",
                    _ => true
                })
            .OrderByDescending(d => IsPendingForMe(d))
            .ThenByDescending(d => d.UpdatedAt)
            .ToList();

        if (_currentPage > TotalPages) _currentPage = 1;
    }

    private bool IsDealerComplete(int dealerId) => _completeDealerIds.Contains(dealerId);

    private string GetApprovalStatus(DealerDto d)
    {
        if (d.RMApproved == false || d.SMApproved == false || d.AVPApproved == false)
            return "Rejected";
        if (d.AVPApproved == true)
            return "Approved";
        if (!IsDealerComplete(d.Id))
            return "Draft";
        if (d.RMApproved == null)
            return "In RM";
        if (d.RMApproved == true && d.SMApproved == null)
            return "In SMM";
        if (d.RMApproved == true && d.SMApproved == true && d.AVPApproved == null)
            return "In AVP";
        return "Submitted";
    }

    private bool IsPendingForMe(DealerDto d)
    {
        if (!IsDealerComplete(d.Id)) return false;
        if (d.RMApproved == false || d.SMApproved == false || d.AVPApproved == false) return false;
        if (d.AVPApproved == true) return false;

        if (LoginState.IsRegionRole && d.RMApproved == null) return true;
        if (LoginState.IsStateRole && d.RMApproved == true && d.SMApproved == null) return true;
        if (LoginState.IsAdmin && d.RMApproved == true && d.SMApproved == true && d.AVPApproved == null) return true;
        return false;
    }

    private string GetBadgeStageClass(DealerDto d)
    {
        var status = GetApprovalStatus(d);
        return status switch
        {
            "In RM" => "badge-stage badge-stage-rm",
            "In SMM" => "badge-stage badge-stage-mo",
            _ => "badge-stage"
        };
    }

    private string GetBadgeStageText(DealerDto d)
    {
        var status = GetApprovalStatus(d);
        return status switch
        {
            "In RM" => "Regional Manager (RM)",
            "In SMM" => "State Marketing Manager (SMM)",
            "In AVP" => "AVP",
            _ => status
        };
    }

    private string GetBadgeStatusClass(DealerDto d)
    {
        var status = GetApprovalStatus(d);
        return status switch
        {
            "Pending" or "In RM" or "In SMM" or "In AVP" => "badge-status badge-status-pending rounded-pill",
            "Approved" => "badge-status badge-status-verified rounded-pill",
            "Rejected" or "Sent Back" => "badge-status badge-status-sentback rounded-pill",
            _ => "badge-status rounded-pill"
        };
    }

    private string GetBadgeStatusText(DealerDto d)
    {
        var status = GetApprovalStatus(d);
        return status switch
        {
            "In RM" or "In SMM" or "In AVP" => "Pending",
            "Approved" => "Verified",
            "Rejected" => "Sent Back",
            _ => status
        };
    }

    private string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length > 0 ? parts[0][0].ToString().ToUpper() : "?";
    }

    private void ReviewDealer(int dealerId)
    {
        NavManager.NavigateTo($"/ReviewDealer?dealerId={dealerId}");
    }

    // Pagination helpers
    private void GoToPage(int page) { _currentPage = page; }
    private void PreviousPage() { if (_currentPage > 1) _currentPage--; }
    private void NextPage() { if (_currentPage < TotalPages) _currentPage++; }

    public class DealerDto
    {
        public int Id { get; set; }
        public string? DealerCode { get; set; }
        public string? FirmName { get; set; }
        public int StateId { get; set; }
        public int Region { get; set; }
        public int HQ { get; set; }
        public string? BusinessEntityType { get; set; }
        public string? PinCode { get; set; }
        public bool? RMApproved { get; set; }
        public bool? SMApproved { get; set; }
        public bool? AVPApproved { get; set; }
        public DateTime UpdatedAt { get; set; }
        public decimal CashCreditLimit { get; set; }
    }
}
<style>
    .page-wrapper {
        max-width: 1660px;
        margin: 0 auto;
        padding: 24px 16px;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    /* ── Header ── */
    .page-header {
        display: flex;
        flex-direction: column;
        gap: 32px;
    }

    .header-row {
        display: flex;
        flex-direction: row;
        align-items: flex-start;
        justify-content: space-between;
        gap: 650px;
        flex-wrap: wrap;
    }

    .header-title {
        font-size: 28px;
        font-weight: 600;
        color: #47443f;
        letter-spacing: -0.56px;
        line-height: 40px;
        margin: 0;
    }

    .header-desc {
        font-size: 18px;
        font-weight: 400;
        color: #364153;
        line-height: 20px;
        margin: 0;
    }

    .badge-role {
        display: inline-flex;
        align-items: center;
        background-color: #dbfdfe;
        color: #3cb8ad;
        border: 1px solid #bef8ff;
        border-radius: 8px;
        padding: 4px 12px;
        font-size: 14px;
        font-weight: 400;
        line-height: 20px;
        white-space: nowrap;
        flex-shrink: 0;
    }

    /* ── Summary Cards ── */
    .summary-grid {
        display: grid;
        grid-template-columns: repeat(1, 1fr);
        gap: 24px;
    }

    @@media (min-width: 768px) {
        .summary-grid { grid-template-columns: repeat(2, 1fr); }
    }

    @@media (min-width: 1200px) {
        .summary-grid { grid-template-columns: repeat(4, 1fr); }
    }

    .summary-card {
        border-radius: 16px;
        border-width: 0.8px;
        border-style: solid;
        padding: 10px;
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 24px;
    }

    .summary-card.card-total {
        border-color: #d8d2e0;
        background: linear-gradient(135deg, rgba(236,245,255,1) 0%, rgba(255,254,255,1) 100%);
    }

    .summary-card.card-pending {
        border-color: #d2dee0;
        background: linear-gradient(135deg, rgba(255,251,232,1) 0%, rgba(255,254,255,1) 100%);
    }

    .summary-card.card-verified {
        border-color: #d2dee0;
        background: linear-gradient(135deg, rgba(241,255,248,1) 0%, rgba(255,254,255,1) 100%);
    }

    .summary-card.card-sentback {
        border-color: #e0d2d2;
        background: linear-gradient(135deg, rgba(255,232,232,1) 0%, rgba(255,254,255,1) 100%);
    }

    .summary-card-icon {
        width: 56px;
        height: 56px;
        flex-shrink: 0;
        object-fit: contain;
    }

    .summary-card-title {
        font-size: 17px;
        font-weight: 600;
        color: #395a45;
        line-height: 32px;
        margin: 0 0 8px 0;
    }

    .summary-card-value {
        font-size: 28px;
        font-weight: 600;
        color: #085726;
        line-height: 42px;
        margin: 0;
    }

    /* ── Main Applications Card ── */
    .applications-card {
        background: #ffffff;
        border: 1px solid #e6ece9;
        border-radius: 20px;
        padding: 32px;
        box-shadow: 4px 4px 12px rgba(233,233,233,0.25), -4px -4px 12px rgba(231,231,231,0.3);
    }

    .applications-header {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 24px;
    }

    @@media (min-width: 768px) {
        .applications-header {
            flex-direction: row;
            align-items: center;
        }
    }

    .applications-title {
        font-size: 22px;
        font-weight: 600;
        color: #36483d;
        line-height: 32px;
        margin: 0;
    }

    /* ── Table Controls (Search + Filter) ── */
    .table-controls {
        display: flex;
        gap: 12px;
        align-items: center;
        flex-wrap: wrap;
    }

    .search-box {
        position: relative;
        width: 100%;
        max-width: 315px;
    }

    @@media (min-width: 768px) {
        .search-box { width: 315px; }
    }

    .search-box i {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: #bebebe;
        font-size: 14px;
