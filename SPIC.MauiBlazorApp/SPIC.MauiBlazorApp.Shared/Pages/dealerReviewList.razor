    .search-box input {
        width: 100%;
        height: 44px;
        border: none;
        border-radius: 10px;
        background-color: #f3f3f3;
        padding: 0 12px 0 40px;
        font-size: 12px;
        font-weight: 400;
        color: #191c1d;
        font-family: 'Inter', Helvetica, sans-serif;
        outline: none;
    }

    .search-box input::placeholder { color: #bebebe; }

    .filter-select {
        height: 44px;
        border: 1px solid #c6c6c6;
        border-radius: 8px;
        padding: 0 12px;
        background: #ffffff;
        font-size: 14px;
        color: #44494d;
        cursor: pointer;
        font-family: 'Inter', Helvetica, sans-serif;
    }

    /* ── Table ── */
    .table-container {
        border: 1px solid #d8ebe1;
        border-radius: 8px;
        overflow-x: auto;
        background: #ffffff;
    }

    .table-responsive {
        min-width: 100%;
    }

    .app-table {
        width: 100%;
        min-width: 1180px;
        border-collapse: separate;
        border-spacing: 0;
        margin: 0;
    }

    .app-table thead tr th {
        background-color: #f2f3f3;
        border-bottom: 1px solid #d0dfd8;
        padding: 18px 24px;
        text-align: center;
        vertical-align: middle;
        font-size: 16px;
        font-weight: 600;
        color: #40493d;
