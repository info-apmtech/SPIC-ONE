        padding: 26px 24px;
        text-align: center;
        vertical-align: middle;
        height: 76px;
        font-size: 14px;
        font-weight: 400;
        color: #191c1d;
        white-space: nowrap;
        font-family: 'Inter', Helvetica, sans-serif;
    }

