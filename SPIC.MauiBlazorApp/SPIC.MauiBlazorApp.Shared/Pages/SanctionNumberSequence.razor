@page "/SanctionNumberSequence"
@using System.Net.Http.Json
@using SPIC.Core.DTOs
@inject HttpClient Http

<PageTitle>Sanction Number Sequence</PageTitle>
<div class="sns-page container-fluid">
    <header class="sns-heading">
        <h3>Sanction Number Sequence</h3>
        <p>Configure state-wise and region-wise sanction number starting values</p>
    </header>

    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <div class="alert @(Success ? "alert-success" : "alert-danger")" role="alert">@Message</div>
    }

    <section class="sns-panel">
        <h4>@(EditingId.HasValue ? "Edit Sanction Sequence" : "Add Sanction Sequence")</h4>
        <div class="sns-form-grid">
            <div class="sns-field">
                <label>Sequence Scope <span class="text-danger">*</span></label>
                <select class="sns-control" value="@Scope" @onchange="OnScopeChanged" disabled="@(Busy || EditingId.HasValue)">
                    <option value="State">State (SMM)</option>
                    <option value="Region">Region (RM / RMM)</option>
                </select>
            </div>
            <div class="sns-field">
                <label>State <span class="text-danger">*</span></label>
                <select class="sns-control" value="@StateId" @onchange="OnStateChanged" disabled="@(Busy || EditingId.HasValue)">
                    <option value="">Select State</option>
                    @foreach (var item in States)
                    {
                        <option value="@item.Id">@item.Name</option>
                    }
                </select>
            </div>
            @if (Scope == "Region")
            {
                <div class="sns-field">
                    <label>Region <span class="text-danger">*</span></label>
                    <select class="sns-control" value="@RegionId" @onchange="OnRegionChanged" disabled="@(Busy || EditingId.HasValue || !StateId.HasValue)">
                        <option value="">Select Region</option>
                        @foreach (var item in Regions)
                        {
                            <option value="@item.Id">@item.Name</option>
                        }
                    </select>
                </div>
            }
            <div class="sns-field">
                <label>State Code <span class="text-danger">*</span></label>
                <input class="sns-control" maxlength="20" placeholder="e.g. TN" @bind="Form.StateSAPCode" disabled="@Busy" />
            </div>
            @if (Scope == "Region")
            {
                <div class="sns-field">
                    <label>Region Code <span class="text-danger">*</span></label>
                    <input class="sns-control" maxlength="20" placeholder="e.g. MDUI" @bind="Form.RegionSAPCode" disabled="@Busy" />
                </div>
            }
            @if (!EditingId.HasValue)
            {
                <div class="sns-field">
                    <label>@(Scope == "Region" ? "SanctionNumber (Starting Value)" : "SanctionNumberState (Starting Value)") <span class="text-danger">*</span></label>
                    @if (Scope == "Region")
                    {
                        <input type="number" min="0" class="sns-control" @bind="Form.SanctionNumber" disabled="@Busy" />
                    }
                    else
                    {
                        <input type="number" min="0" class="sns-control" @bind="Form.SanctionNumberState" disabled="@Busy" />
                    }
                </div>
            }
            else
            {
                <div class="sns-field">
                    <label>Current Counter (Read Only)</label>
                    <input class="sns-control" value="@(Scope == "Region" ? Form.SanctionNumber.ToString("D4") : Form.SanctionNumberState.ToString("D4"))" disabled />
                </div>
            }
        </div>
        <div class="sns-actions">
            <span class="sns-muted">State counters are shared by all regions in that state. Counters cannot be changed after creation.</span>
            <div class="sns-buttons">
                <button class="sns-btn sns-btn-light" type="button" @onclick="ClearForm" disabled="@Busy">Clear</button>
                <button class="sns-btn sns-btn-primary" type="button" @onclick="SaveAsync" disabled="@Busy">@(Busy ? "Saving..." : EditingId.HasValue ? "Update Sequence" : "Save Sequence")</button>
            </div>
        </div>
    </section>

    <section class="sns-panel sns-list">
        <div class="sns-list-heading">
            <h4>Existing Sanction Number Sequences</h4>
            <input type="search" class="sns-search" placeholder="Search State / Region / Code..." @bind="Search" @bind:event="oninput" />
        </div>
        <p class="sns-muted">@FilteredRows.Count record(s)</p>
        <div class="sns-table-scroll">
            <table class="sns-table">
                <thead><tr><th>S.No</th><th>Scope</th><th>State</th><th>Region</th><th>State Code</th><th>Region Code</th><th>SanctionNumber</th><th>SanctionNumberState</th><th>Created At</th><th>Updated At</th><th>Action</th></tr></thead>
                <tbody>
                    @if (FilteredRows.Count == 0)
                    {
                        <tr><td colspan="11" class="sns-empty">@(Busy ? "Loading..." : "No sanction sequences found.")</td></tr>
                    }
                    @foreach (var entry in VisibleRows.Select((value, index) => new { value, index }))
                    {
                        var row = entry.value;
                        <tr @key="row.Id">
                            <td>@((CurrentPage - 1) * PageSize + entry.index + 1)</td>
                            <td><span class="sns-pill">@(row.RegionId.HasValue ? "Region" : "State")</span></td>
                            <td>@LookupName(States, row.StateId)</td>
                            <td>@(row.RegionId.HasValue ? LookupRegionName(row.RegionId.Value) : "-")</td>
                            <td>@row.StateSAPCode</td>
                            <td>@(row.RegionSAPCode ?? "-")</td>
                            <td>@(row.RegionId.HasValue ? row.SanctionNumber.ToString("D4") : "-")</td>
                            <td>@(!row.RegionId.HasValue ? row.SanctionNumberState.ToString("D4") : "-")</td>
                            <td>@row.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td>@(row.UpdatedAt?.ToString("dd MMM yyyy") ?? "-")</td>
                            <td><button type="button" class="sns-edit" title="Edit Codes" @onclick="() => EditAsync(row)" disabled="@Busy">✎ Edit</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="sns-pagination">
            <div class="sns-buttons"><span>Items Per Page</span><select class="sns-page-size" value="@PageSize" @onchange="SetPageSize"><option value="10">10</option><option value="16">16</option><option value="25">25</option><option value="50">50</option></select></div>
            <div class="sns-buttons"><button class="sns-btn sns-btn-light" disabled="@(CurrentPage <= 1)" @onclick="() => CurrentPage--">‹</button><span>@CurrentPage / @TotalPages</span><button class="sns-btn sns-btn-light" disabled="@(CurrentPage >= TotalPages)" @onclick="() => CurrentPage++">›</button></div>
        </div>
    </section>
</div>

@code {
    private const string Api = "api/SanctionNumberSequence";
    private List<SanctionNumberSequenceDto> Rows = new();
    private List<LookupItem> States = new();
    private List<LookupItem> Regions = new();
    private readonly Dictionary<int, List<LookupItem>> RegionsByState = new();
    private CreateSanctionNumberSequenceDto Form = new();
    private int? StateId, RegionId, EditingId;
    private string Scope = "State", Search = "", Message = "";
    private bool Busy, Success;
    private int PageSize = 16, CurrentPage = 1;
    private sealed class LookupItem { public int Id { get; set; } public string Name { get; set; } = ""; }
    private static int? ParseId(object? value) => int.TryParse(value?.ToString(), out var n) && n > 0 ? n : null;
    private static string LookupName(List<LookupItem> list, int id) => list.FirstOrDefault(x => x.Id == id)?.Name ?? $"Unknown ({id})";
    private string LookupRegionName(int id) => RegionsByState.Values.SelectMany(x => x).FirstOrDefault(x => x.Id == id)?.Name ?? $"Unknown ({id})";
    private List<SanctionNumberSequenceDto> FilteredRows => Rows.Where(x => string.IsNullOrWhiteSpace(Search) ||
        new[] { LookupName(States, x.StateId), x.RegionId.HasValue ? LookupRegionName(x.RegionId.Value) : "", x.StateSAPCode, x.RegionSAPCode ?? "", x.RegionId.HasValue ? "Region" : "State" }
            .Any(v => v.Contains(Search, StringComparison.OrdinalIgnoreCase))).ToList();
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredRows.Count / (double)PageSize));
    private IEnumerable<SanctionNumberSequenceDto> VisibleRows => FilteredRows.Skip((Math.Min(CurrentPage, TotalPages) - 1) * PageSize).Take(PageSize);
    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        Busy = true; Message = "";
        try
        {
            // Reuses the working state/region master endpoints from RMDHQMapping.
            States = await Http.GetFromJsonAsync<List<LookupItem>>("api/RMDHQMapping/states") ?? new();
            Rows = await Http.GetFromJsonAsync<List<SanctionNumberSequenceDto>>(Api) ?? new();
            foreach (var stateId in Rows.Select(x => x.StateId).Where(x => x > 0).Distinct())
                await EnsureRegionsAsync(stateId);
            CurrentPage = Math.Min(CurrentPage, TotalPages);
        }
        catch (Exception ex) { Fail($"Unable to load sanction sequences: {ex.Message}"); }
        finally { Busy = false; }
    }
    private async Task EnsureRegionsAsync(int stateId)
    {
        var list = await Http.GetFromJsonAsync<List<LookupItem>>($"api/RMDHQMapping/regions/{stateId}") ?? new();
        RegionsByState[stateId] = list;
    }
    private void OnScopeChanged(ChangeEventArgs e)
    {
        Scope = e.Value?.ToString() == "Region" ? "Region" : "State";
        RegionId = null; Form.RegionId = null; Form.RegionSAPCode = null;
        Form.SanctionNumber = 0; Form.SanctionNumberState = 0; Message = "";
    }
    private async Task OnStateChanged(ChangeEventArgs e)
    {
        StateId = ParseId(e.Value); Form.StateId = StateId ?? 0;
        RegionId = null; Form.RegionId = null; Regions.Clear(); Message = "";
        if (!StateId.HasValue) return;
        Busy = true;
        try { await EnsureRegionsAsync(StateId.Value); Regions = RegionsByState[StateId.Value]; }
        catch (Exception ex) { Fail(ex.Message); }
        finally { Busy = false; }
    }
    private void OnRegionChanged(ChangeEventArgs e) { RegionId = ParseId(e.Value); Form.RegionId = RegionId; Message = ""; }
    private async Task EditAsync(SanctionNumberSequenceDto row)
    {
        EditingId = row.Id; Scope = row.RegionId.HasValue ? "Region" : "State";
        StateId = row.StateId; RegionId = row.RegionId;
        Form = new CreateSanctionNumberSequenceDto
        {
            StateId = row.StateId,
            RegionId = row.RegionId,
            StateSAPCode = row.StateSAPCode,
            RegionSAPCode = row.RegionSAPCode,
            SanctionNumber = row.SanctionNumber,
            SanctionNumberState = row.SanctionNumberState
        };
        Message = "";
        if (RegionsByState.TryGetValue(row.StateId, out var list)) { Regions = list; return; }
        Busy = true;
        try { await EnsureRegionsAsync(row.StateId); Regions = RegionsByState[row.StateId]; }
        catch (Exception ex) { Fail(ex.Message); }
        finally { Busy = false; }
    }
    private void ClearForm()
    {
        Form = new(); StateId = RegionId = EditingId = null; Scope = "State"; Regions.Clear(); Message = "";
    }
    private void SetPageSize(ChangeEventArgs e)
    { if (int.TryParse(e.Value?.ToString(), out var size) && size > 0) PageSize = size; CurrentPage = 1; }
    private void Fail(string text) { Success = false; Message = text; }
    private async Task SaveAsync()
    {
        Message = "";
        if (!StateId.HasValue) { Fail("Please select a State."); return; }
        if (string.IsNullOrWhiteSpace(Form.StateSAPCode)) { Fail("State Code is required."); return; }
        if (Scope == "Region" && !RegionId.HasValue) { Fail("Please select a Region."); return; }
        if (Scope == "Region" && string.IsNullOrWhiteSpace(Form.RegionSAPCode)) { Fail("Region Code is required."); return; }
        Form.StateId = StateId.Value;
        Form.RegionId = Scope == "Region" ? RegionId : null;
        if (Scope == "State") { Form.RegionSAPCode = null; Form.SanctionNumber = 0; }
        else Form.SanctionNumberState = 0;
        Busy = true;
        try
        {
            using var result = EditingId.HasValue
                ? await Http.PutAsJsonAsync($"{Api}/{EditingId.Value}", new UpdateSanctionNumberSequenceDto { StateSAPCode = Form.StateSAPCode, RegionSAPCode = Form.RegionSAPCode })
                : await Http.PostAsJsonAsync(Api, Form);
            if (!result.IsSuccessStatusCode) { Fail(await result.Content.ReadAsStringAsync()); return; }
            ClearForm(); Rows = await Http.GetFromJsonAsync<List<SanctionNumberSequenceDto>>(Api) ?? new();
            Success = true; Message = "Sanction number sequence saved successfully.";
        }
        catch (Exception ex) { Fail(ex.Message); }
        finally { Busy = false; }
    }
}
