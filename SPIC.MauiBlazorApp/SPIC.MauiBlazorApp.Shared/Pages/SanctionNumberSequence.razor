@page "/SanctionNumberSequence"
@using System.Net.Http.Json
@using SPIC.Core.DTOs
@inject HttpClient Http
@inject SPIC.MauiBlazorApp.Shared.Services.LoginState LoginState

<PageTitle>Sanction Number Sequence</PageTitle>

<div class="sns-page container-fluid">
    <header class="sns-heading">
        <h3>Sanction Number Sequence</h3>
        <p>Configure state-wise and region-wise sanction number starting values</p>
    </header>

    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <div class="alert @(Success ? "alert-success" : "alert-danger")" role="alert">@Message</div>
    }

    @if (CanEntry)
    {
        <section class="sns-panel">
            <h4>Add Sanction Sequence</h4>

            <div class="sns-form-grid">
                <div class="sns-field">
                    <label for="sns-scope">Sequence Scope <span class="text-danger">*</span></label>
                    <select id="sns-scope" class="sns-control" value="@Scope" @onchange="OnScopeChanged" disabled="@Busy">
                        <option value="State">State (SMM)</option>
                        <option value="Region">Region (RM / RMM)</option>
                    </select>
                </div>

                <div class="sns-field">
                    <label for="sns-state">State <span class="text-danger">*</span></label>
                    <select id="sns-state" class="sns-control" value="@StateId" @onchange="OnStateChanged" disabled="@Busy">
                        <option value="">Select State</option>
                        @foreach (var item in States)
                        {
                            <option value="@item.Id">@item.Name</option>
                        }
                    </select>
                </div>

                @if (Scope == "Region")
                {
                    <div class="sns-field">
                        <label for="sns-region">Region <span class="text-danger">*</span></label>
                        <select id="sns-region" class="sns-control" value="@RegionId" @onchange="OnRegionChanged" disabled="@(Busy || !StateId.HasValue)">
                            <option value="">Select Region</option>
                            @foreach (var item in Regions)
                            {
                                <option value="@item.Id">@item.Name</option>
                            }
                        </select>
                    </div>
                }

                <div class="sns-field">
                    <label for="sns-state-code">State Code</label>
                    <input id="sns-state-code" class="sns-control" value="@SelectedStateCode" readonly
                           placeholder="@(StateId.HasValue ? "Code not configured in State master" : "Select State")" />
                </div>

                @if (Scope == "Region")
                {
                    <div class="sns-field">
                        <label for="sns-region-code">Region Code</label>
                        <input id="sns-region-code" class="sns-control" value="@SelectedRegionCode" readonly
                               placeholder="@(RegionId.HasValue ? "Code not configured in Region master" : "Select Region")" />
                    </div>
                }

                <div class="sns-field">
                    <label for="sns-starting-value">
                        @(Scope == "Region" ? "SanctionNumber (Starting Value)" : "SanctionNumberState (Starting Value)")
                        <span class="text-danger">*</span>
                    </label>
                    @if (Scope == "Region")
                    {
                        <input id="sns-starting-value" type="number" min="0" class="sns-control" @bind="Form.SanctionNumber" disabled="@Busy" />
                    }
                    else
                    {
                        <input id="sns-starting-value" type="number" min="0" class="sns-control" @bind="Form.SanctionNumberState" disabled="@Busy" />
                    }
                </div>
            </div>

            <div class="sns-actions">
                <span class="sns-muted">
                    Codes are maintained in the State and Region masters.
                    State counters are shared by all regions in that state.
                    Counters cannot be changed after creation.
                </span>
                <div class="sns-buttons">
                    <button class="sns-btn sns-btn-light" type="button" @onclick="ClearForm" disabled="@Busy">Clear</button>
                    <button class="sns-btn sns-btn-primary" type="button" @onclick="SaveAsync" disabled="@Busy">
                        @(Saving ? "Saving..." : "Save Sequence")
                    </button>
                </div>
            </div>
        </section>
    }

    <section class="sns-panel sns-list">
        @{
            var filteredRows = FilteredRows;
            var totalPages = Math.Max(1, (int)Math.Ceiling(filteredRows.Count / (double)PageSize));
            var displayPage = Math.Clamp(CurrentPage, 1, totalPages);
            var visibleRows = filteredRows.Skip((displayPage - 1) * PageSize).Take(PageSize).ToList();
        }

        <div class="sns-list-heading">
            <h4>Existing Sanction Number Sequences</h4>
            <input type="search" class="sns-search" placeholder="Search State / Region / Code..."
                   aria-label="Search sanction sequences" @bind="Search" @bind:event="oninput" />
        </div>
        <p class="sns-muted">@filteredRows.Count record(s)</p>

        <div class="sns-table-scroll">
            <table class="sns-table">
                <thead>
                    <tr>
                        <th>S.No</th>
                        <th>Scope</th>
                        <th>State</th>
                        <th>Region</th>
                        <th>State Code</th>
                        <th>Region Code</th>
                        <th>SanctionNumber</th>
                        <th>SanctionNumberState</th>
                        <th>Created At</th>
                        <th>Updated At</th>
                    </tr>
                </thead>
                <tbody>
                    @if (filteredRows.Count == 0)
                    {
                        <tr><td colspan="10" class="sns-empty">@(Busy ? "Loading..." : "No sanction sequences found.")</td></tr>
                    }
                    @foreach (var entry in visibleRows.Select((value, index) => new { value, index }))
                    {
                        var row = entry.value;
                        <tr @key="row.Id">
                            <td>@((displayPage - 1) * PageSize + entry.index + 1)</td>
                            <td><span class="sns-pill">@(row.RegionId.HasValue ? "Region" : "State")</span></td>
                            <td>@DisplayName(row.StateName, row.StateId)</td>
                            <td>@(row.RegionId.HasValue ? DisplayName(row.RegionName, row.RegionId.Value) : "-")</td>
                            <td>@DisplayCode(row.StateCode)</td>
                            <td>@(row.RegionId.HasValue ? DisplayCode(row.RegionCode) : "-")</td>
                            <td>@(row.RegionId.HasValue ? row.SanctionNumber.ToString("D4") : "-")</td>
                            <td>@(!row.RegionId.HasValue ? row.SanctionNumberState.ToString("D4") : "-")</td>
                            <td>@row.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td>@(row.UpdatedAt?.ToString("dd MMM yyyy") ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="sns-pagination">
            <div class="sns-buttons">
                <label for="sns-page-size">Items Per Page</label>
                <select id="sns-page-size" class="sns-page-size" value="@PageSize" @onchange="SetPageSize">
                    <option value="10">10</option>
                    <option value="16">16</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select>
            </div>
            <div class="sns-buttons">
                <button type="button" class="sns-btn sns-btn-light" aria-label="Previous page"
                        disabled="@(displayPage <= 1)" @onclick="() => CurrentPage = Math.Max(1, displayPage - 1)">
                    ‹
                </button>
                <span>@displayPage / @totalPages</span>
                <button type="button" class="sns-btn sns-btn-light" aria-label="Next page"
                        disabled="@(displayPage >= totalPages)" @onclick="() => CurrentPage = Math.Min(totalPages, displayPage + 1)">
                    ›
                </button>
            </div>
        </div>
    </section>
</div>

@code {
    private bool CanEntry => LoginState.Can(SPIC.Core.Entities.PagePermission.SanctionNumberSequence, "Entry");

    private const string Api = "api/SanctionNumberSequence";
    private const string LookupApi = Api;

    private List<SanctionNumberSequenceDto> Rows = new();
    private List<LookupItem> States = new();
    private List<LookupItem> Regions = new();
    private CreateSanctionNumberSequenceDto Form = new();

    private int? StateId, RegionId;
    private string Scope = "State", Message = "";
    private bool Busy, Saving, Success;
    private int PageSize = 16, CurrentPage = 1;
    private string search = "";

    private string Search
    {
        get => search;
        set { search = value ?? ""; CurrentPage = 1; }
    }

    // These endpoints must return Code from the corresponding master table.
    private sealed class LookupItem
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string? Code { get; set; }
    }

    private string SelectedStateCode => States.FirstOrDefault(x => x.Id == StateId)?.Code ?? "";
    private string SelectedRegionCode => Scope == "Region"
        ? Regions.FirstOrDefault(x => x.Id == RegionId)?.Code ?? ""
        : "";

    private static int? ParseId(object? value) =>
        int.TryParse(value?.ToString(), out var n) && n > 0 ? n : null;

    private static string DisplayName(string? name, int id) =>
        string.IsNullOrWhiteSpace(name) ? $"Unknown ({id})" : name;

    private static string DisplayCode(string? code) =>
        string.IsNullOrWhiteSpace(code) ? "-" : code;

    private List<SanctionNumberSequenceDto> FilteredRows => Rows.Where(x =>
        string.IsNullOrWhiteSpace(Search) ||
        new[]
        {
            DisplayName(x.StateName, x.StateId),
            x.RegionId.HasValue ? DisplayName(x.RegionName, x.RegionId.Value) : "",
            x.StateCode ?? "", x.RegionCode ?? "", x.RegionId.HasValue ? "Region" : "State"
        }.Any(v => v.Contains(Search.Trim(), StringComparison.OrdinalIgnoreCase))).ToList();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        Busy = true;
        Message = "";
        try
        {
            States = await Http.GetFromJsonAsync<List<LookupItem>>($"{LookupApi}/states") ?? new();
            Rows = await Http.GetFromJsonAsync<List<SanctionNumberSequenceDto>>(Api) ?? new();
            CurrentPage = 1;
        }
        catch (Exception ex) { Fail($"Unable to load sanction sequences: {ex.Message}"); }
        finally { Busy = false; }
    }

    private async Task OnScopeChanged(ChangeEventArgs e)
    {
        if (Busy) return;
        Scope = e.Value?.ToString() == "Region" ? "Region" : "State";
        RegionId = null;
        Form.RegionId = null;
        Regions = new();
        Form.SanctionNumber = 0;
        Form.SanctionNumberState = 0;
        Message = "";
        if (Scope == "Region" && StateId.HasValue)
            await LoadRegionsAsync(StateId.Value);
    }

    private async Task OnStateChanged(ChangeEventArgs e)
    {
        if (Busy) return;
        StateId = ParseId(e.Value);
        Form.StateId = StateId ?? 0;
        RegionId = null;
        Form.RegionId = null;
        Regions = new();
        Message = "";
        if (Scope == "Region" && StateId.HasValue)
            await LoadRegionsAsync(StateId.Value);
    }

    private async Task LoadRegionsAsync(int stateId)
    {
        Busy = true;
        try
        {
            Regions = await Http.GetFromJsonAsync<List<LookupItem>>($"{LookupApi}/regions/{stateId}") ?? new();
        }
        catch (Exception ex) { Fail($"Unable to load regions: {ex.Message}"); }
        finally { Busy = false; }
    }

    private void OnRegionChanged(ChangeEventArgs e)
    {
        if (Busy) return;
        RegionId = ParseId(e.Value);
        Form.RegionId = RegionId;
        Message = "";
    }

    private void ClearForm()
    {
        Form = new();
        StateId = RegionId = null;
        Scope = "State";
        Regions = new();
        Message = "";
    }

    private void SetPageSize(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size) && new[] { 10, 16, 25, 50 }.Contains(size))
            PageSize = size;
        CurrentPage = 1;
    }

    private void Fail(string text) { Success = false; Message = text; }

    private async Task SaveAsync()
    {
        if (!CanEntry)
        {
            Fail("You do not have permission to create sanction number sequences.");
            return;
        }
        if (Busy) return;
        Message = "";
        if (!StateId.HasValue || !States.Any(x => x.Id == StateId.Value))
        { Fail("Please select a valid State."); return; }
        if (string.IsNullOrWhiteSpace(SelectedStateCode))
        { Fail("State Code is missing. Update the selected State master, then reload this page."); return; }
        if (Scope == "Region")
        {
            if (!RegionId.HasValue || !Regions.Any(x => x.Id == RegionId.Value))
            { Fail("Please select a valid Region for the selected State."); return; }
            if (string.IsNullOrWhiteSpace(SelectedRegionCode))
            { Fail("Region Code is missing. Update the selected Region master, then reload this page."); return; }
        }
        if ((Scope == "Region" ? Form.SanctionNumber : Form.SanctionNumberState) < 0)
        { Fail("Starting value cannot be negative."); return; }

        Form.StateId = StateId.Value;
        Form.RegionId = Scope == "Region" ? RegionId : null;
        if (Scope == "State") Form.SanctionNumber = 0;
        else Form.SanctionNumberState = 0;

        Busy = true;
        Saving = true;
        try
        {
            using var result = await Http.PostAsJsonAsync(Api, Form);
            if (!result.IsSuccessStatusCode)
            {
                var error = await result.Content.ReadAsStringAsync();
                Fail(string.IsNullOrWhiteSpace(error) ? "Unable to save sanction sequence." : error);
                return;
            }

            ClearForm();
            Success = true;
            Message = "Sanction number sequence saved successfully.";
            try
            {
                Rows = await Http.GetFromJsonAsync<List<SanctionNumberSequenceDto>>(Api) ?? new();
                CurrentPage = 1;
            }
            catch
            {
                // The POST succeeded. Do not report it as a failed save.
                Message = "Sanction number sequence saved successfully. The list could not be refreshed; reload this page.";
            }
        }
        catch (Exception ex) { Fail($"Unable to save sanction sequence: {ex.Message}"); }
        finally { Busy = false; Saving = false; }
    }
}
