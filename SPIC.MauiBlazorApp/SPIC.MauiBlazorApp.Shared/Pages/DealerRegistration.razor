@page "/Register" 

<div class="container py-4">
        
	<div class="mb-4">

		<!-- TOP ROW -->
		<div class="d-flex justify-content-between align-items-center">
			<div class="step-text">Step 1 of 12</div>
			<span class="status-badge">Registration In Progress</span>
		</div>

		<!-- SUB TEXT -->
		<div class="step-subtext">Market Details & Territory Coverage</div>

		<!-- PROGRESS BAR -->
		<div class="progress-bar-custom">
			<div class="progress-segment active"></div>
			<div class="progress-segment"></div>
			<div class="progress-segment"></div>
			<div class="progress-segment"></div>
			<div class="progress-segment"></div>
			<div class="progress-segment"></div>
			<div class="progress-segment"></div>
			<div class="progress-segment"></div>
			<div class="progress-segment"></div>
			<div class="progress-segment"></div>
			<div class="progress-segment"></div>
			<div class="progress-segment"></div>
			<div class="progress-segment"></div>
			<div class="progress-segment"></div>
			<div class="progress-segment"></div>
		</div>

	</div>
	<div class="company-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

		<h3 class="fw-bold m-0 company-title">Company Details</h3>

		<div class="company-card-group d-flex flex-wrap gap-2">
			<div class="mini-company-card">
				<div class="d-flex align-items-center gap-2">
					<img src="_content/SPIC.MauiBlazorApp.Shared/images/LoginImages/logo.png" alt="SPIC Logo" class="mini-company-logo">
					<span class="mini-company-name">SPIC</span>
				</div>
				<div class="mini-check-box"></div>
			</div>

			<div class="mini-company-card">
				<div class="d-flex align-items-center gap-2">
					<img src="_content/SPIC.MauiBlazorApp.Shared/images/LoginImages/logo.png" alt="Green Star Logo" class="mini-company-logo">
					<span class="mini-company-name">Green Star</span>
				</div>
				<div class="mini-check-box"></div>
			</div>
		</div>

	</div>

	<form asp-action="SubmitStep1" asp-controller="Registration" method="post" enctype="multipart/form-data">
            
		<div class="form-card">
			<div class="card-header-title">
				<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/BasicInfoIcon.svg" alt="BasicInfo" class="formicon" /> Basic Information
			</div>
                
			<div class="row g-3">
				<div class="col-md-4">
					<label class="form-label-custom">State</label>
					<select class="form-select-custom w-100">
						<option value="1">Select State</option>
					</select>
				</div>
				<div class="col-md-4">
					<label class="form-label-custom">Region</label>
					<input type="text" class="form-control-custom w-100" placeholder="Enter Region">
				</div>
				<div class="col-md-4">
					<label class="form-label-custom">HQ</label>
					<input type="text" class="form-control-custom w-100" placeholder="Enter HQ">
				</div>
				<div class="col-md-4">
					<label class="form-label-custom">Company</label>
					<select asp-for="Company" class="form-select-custom w-100">
						<option value="">Select Company Name</option>
					</select>
				</div>
				<div class="col-md-4">
					<label class="form-label-custom">Dealer Code & Name</label>
					<input type="text" class="form-control-custom w-100" placeholder="Enter Dealer Code & Name">
				</div>
				<div class="col-md-4">
					<label class="form-label-custom">Parent Dealer</label>
					<input type="text" class="form-control-custom w-100" placeholder="Enter Parent Name">
				</div>
				<div class="col-md-4">
					<label class="form-label-custom">Firm Name(Asper Fertilizer License or GST Trade Name)</label>
					<input type="text" class="form-control-custom w-100" placeholder="Enter Firm Name">
				</div>
				
				
				<div class="col-md-4">
					<label class="form-label-custom">Date of Appointment</label>
					<input type="date" class="form-control-custom w-100">
				</div>
				<div class="col-md-4">
					<label class="form-label-custom">Business Type</label>
					<select asp-for="Company" class="form-select-custom w-100">
						<option value="">Select Business Type</option>
					</select>
				</div>
				@*
				<div class="col-md-4">
					<label class="form-label-custom d-block">Business Type</label>
					<div class="mt-2 d-flex gap-3">
						<div class="form-check">
							<input class="form-check-input" type="checkbox" id="checkWholesale" asp-for="IsWholesale">
							<label class="form-check-label text-secondary" style="font-size: 0.85rem;" for="checkWholesale">Wholesale</label>
						</div>
						<div class="form-check">
							<input class="form-check-input" type="checkbox" id="checkRetail" asp-for="IsRetail">
							<label class="form-check-label text-secondary" style="font-size: 0.85rem;" for="checkRetail">Retail</label>
						</div>
					</div>
				</div> *@
			</div>
		</div>

		<div class="form-card">
			<div class="d-flex justify-content-between align-items-center mb-3">
				<div class="card-header-title mb-0">
					<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/LocationIcon.svg" alt="Location" class="formicon" />Primary Location
				</div>
				<button type="button" class="btn btn-outline-success btn-sm rounded-pill px-3" style="font-size: 0.8rem;">
					<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/CurrentLocation.svg" alt="Current Location" class="formicon" /> Use Current Location
				</button>
			</div>

			<div class="row g-3">
				<div class="col-md-6">
					<div class="map-placeholder">
						<button type="button" class="btn-map-interactive">
							<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/PinnedLocation.svg" alt="Location" class="formicon" /> Map Interactive Area
						</button>
					</div>
				</div>
				<div class="col-md-6">
					<div class="row g-3">
						<div class="col-md-6">
							<label class="form-label-custom">Door / Shop / Block No</label>
							<input type="text" asp-for="DoorNo" class="form-control-custom w-100" placeholder="">
						</div>
						<div class="col-md-6">
							<label class="form-label-custom">Street / Area / Locality</label>
							<input type="text" asp-for="Street" class="form-control-custom w-100" placeholder="">
						</div>
						<div class="col-md-6">
							<label class="form-label-custom">Sub Village</label>
							<input type="text" asp-for="SubVillage" class="form-control-custom w-100" placeholder="Enter Sub Village">
						</div>
						<div class="col-md-6">
							<label class="form-label-custom">Village</label>
							<select asp-for="Village" class="form-select-custom w-100">
								<option value="">Enter Village</option>
							</select>
						</div>
					</div>
				</div>

				<div class="col-md-3">
					<label class="form-label-custom">Pincode</label>
					<input type="text" asp-for="Pincode" class="form-control-custom w-100" placeholder="Enter Pincode">
				</div>
				<div class="col-md-3">
					<label class="form-label-custom">Block</label>
					<select asp-for="Block" class="form-select-custom w-100">
						<option value="">Select Block</option>
					</select>
				</div>
				<div class="col-md-3">
					<label class="form-label-custom">Taluk</label>
					<select asp-for="Taluk" class="form-select-custom w-100">
						<option value="">Select Taluk</option>
					</select>
				</div>
				<div class="col-md-3">
					<label class="form-label-custom">District</label>
					<input type="text" asp-for="District" class="form-control-custom w-100" placeholder="Enter District">
				</div>

				<div class="col-md-4">
					<label class="form-label-custom">State</label>
					<input type="text" asp-for="State" class="form-control-custom w-100" placeholder="Enter State">
				</div>
				<div class="col-md-4">
					<label class="form-label-custom">WhatsApp Number</label>
					<input type="text" asp-for="WhatsAppNumber" class="form-control-custom w-100" placeholder="10-digit mobile number">
				</div>
				<div class="col-md-4">
					<label class="form-label-custom">Alternative Number</label>
					<input type="text" asp-for="AlternativeNumber" class="form-control-custom w-100" placeholder="10-digit mobile number">
				</div>
			</div>
		</div>

		<div class="form-card">
			<div class="card-header-title">
				<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/TaxComplience.svg" alt="Location" class="formicon" /> Tax & Compliance
			</div>
                
			<div class="row g-3">
				<div class="col-md-4">
					<label class="form-label-custom">GST Number</label>
					<div class="input-group upload-input-group">
						<input type="text" asp-for="GSTNumber" class="form-control form-control-custom" placeholder="15-character GST number">
						<button class="btn btn-upload" type="button">Upload PDF <i class="bi bi-upload"></i></button>
					</div>
				</div>
				<div class="col-md-4">
					<label class="form-label-custom">PAN Number</label>
					<div class="input-group upload-input-group">
						<input type="text" asp-for="PANNumber" class="form-control form-control-custom" placeholder="10-character PAN number">
						<button class="btn btn-upload" type="button">Upload PDF <i class="bi bi-upload"></i></button>
					</div>
				</div>
				<div class="col-md-4">
					<label class="form-label-custom">Aadhaar Number</label>
					<div class="input-group upload-input-group">
						<input type="text" asp-for="AadhaarNumber" class="form-control form-control-custom" placeholder="12-digit Aadhaar">
						<button class="btn btn-upload" type="button">Upload PDF <i class="bi bi-upload"></i></button>
					</div>
				</div>
			</div>
		</div>

		<div class="row g-4 mb-4">
			<div class="col-md-6">
				<div class="form-card mb-0 h-100">
					<div class="card-header-title">
						<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/WholeSale.svg" alt="WholeSale" class="formicon" /> Wholesale Details
					</div>
					<div class="row g-3">
						<div class="col-6">
							<label class="form-label-custom">License Number</label>
							<input type="text" class="form-control-custom w-100" placeholder="Enter Company Name">
						</div>
						<div class="col-6">
							<label class="form-label-custom">Expiry Date</label>
							<input type="text" class="form-control-custom w-100" placeholder="10-digit mobile number">
						</div>
						<div class="col-6">
							<label class="form-label-custom">mFMS Code</label>
							<input type="text" class="form-control-custom w-100" placeholder="15-character GST number">
						</div>
						<div class="col-6">
							<div class="file-upload-box">
								<span><i class="bi bi-upload"></i> Choose file</span>
								<small>Upload GST Certificate</small>
							</div>
						</div>
					</div>
				</div>
			</div>

			<div class="col-md-6">
				<div class="form-card mb-0 h-100">
					<div class="card-header-title">
						<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/WholeSale.svg" alt="WholeSale" class="formicon" /> Retail Details
					</div>
					<div class="row g-3">
						<div class="col-6">
							<label class="form-label-custom">License Number</label>
							<input type="text" class="form-control-custom w-100" placeholder="Enter Company Name">
						</div>
						<div class="col-6">
							<label class="form-label-custom">Expiry Date</label>
							<input type="text" class="form-control-custom w-100" placeholder="10-digit mobile number">
						</div>
						<div class="col-6">
							<label class="form-label-custom">mFMS Code</label>
							<input type="text" class="form-control-custom w-100" placeholder="15-character GST number">
						</div>
						<div class="col-6">
							<div class="file-upload-box">
								<span><i class="bi bi-upload"></i> Choose file</span>
								<small>Upload GST Certificate</small>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>

		<div class="form-card">
			<div class="card-header-title">
				<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/OfficeAutomation.svg" alt="OfficeAutomation" class="formicon" /> Office Automation
			</div>
                
			<div class="row g-3">
				<div class="col-md-4">
					<label class="form-label-custom mb-3">Do you have office automation?</label>
					<div>
						<button type="button" class="toggle-btn active">Yes</button>
						<button type="button" class="toggle-btn">No</button>
					</div>
				</div>
				<div class="col-md-8">
					<label class="form-label-custom">Please provide details about your office automation</label>
					<textarea asp-for="AutomationDetails" class="form-control-custom w-100" rows="3" placeholder="Enter details about software, systems, etc."></textarea>
				</div>
			</div>
		</div>

		<div class="d-flex justify-content-end mb-5">
			<button type="submit" class="btn btn-next">Next <i class="bi bi-chevron-right small"></i></button>
		</div>

	</form>

</div>










