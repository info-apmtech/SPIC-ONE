@page "/Register" 



<div class="container-fluid py-4 px-0">
	<FormLoader />

	<h5 class="fw-bold mb-4">Company Details</h5>

	<form method="post">
		@if (status == "Active" || status == "Inactive" || status == "Terminated")
		{
			<div class="basic-info-card">
				<div class="basic-info-header">
					<h3 class="basic-info-title">
						<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/BasicInfoIcon.svg"
							 class="formicon"
							 alt="icon" /> Basic Information
					</h3>

					<div class="btn-group-toggle">
						<button type="button"
								class="btn @(selected == "Dealer" ? "active" : "")"
								@onclick='() => Select("Dealer")'>
							Dealer
						</button>

						<button type="button"
								class="btn @(selected == "Department" ? "active" : "")"
								@onclick='() => Select("Department")'>
							Department
						</button>
					</div>
				</div>

				<div class="row g-4 align-items-center">
					<div class="col-md-5">
						<div class="row g-3 h-100">

							<!-- SPIC -->
							<div class="col-6">
								<div class="logo-card spic @(isSpic ? "active" : "")"
									 @onclick="ToggleSpic">
									<div class="card-checkbox">
										<i class="bi bi-check-lg"></i>
									</div>
									<img src="_content/SPIC.MauiBlazorApp.Shared/images/loginimages/logo.png" />
									<span>SPIC</span>
								</div>
							</div>

							<!-- GREEN STAR -->
							<div class="col-6">
								<div class="logo-card green-star @(isGreenStar ? "active" : "")"
									 @onclick="ToggleGreenStar">
									<div class="card-checkbox">
										<i class="bi bi-check-lg"></i>
									</div>
									<img src="_content/SPIC.MauiBlazorApp.Shared/images/loginimages/greensraticon.svg" />
									<span>GREEN STAR</span>
								</div>
							</div>

						</div>
					</div>


					<div class="col-md-7">
						<div class="row g-3">
							<div class="col-md-6">
								<label class="form-label-custom">State</label>
								<select class="form-select-custom w-100">
									<option>Select State</option>
								</select>
							</div>
							<div class="col-md-6">
								<label class="form-label-custom">Region</label>
								<input type="text" class="form-control-custom w-100" placeholder="Enter Region">
							</div>
							<div class="col-md-6">
								<label class="form-label-custom">HQ</label>
								<input type="text" class="form-control-custom w-100" placeholder="Enter HQ">
							</div>
							<div class="col-md-6">
								<label class="form-label-custom">Status</label>

								<div class="status-btn-group">
									<button type="button"
											class="btn btn_active @(status == "Active" ? "active" : "")"
											@onclick='() => SelectStatus("Active")'>
										Active
									</button>

									<button type="button"
											class="btn btn_inactive @(status == "Inactive" ? "active" : "")"
											@onclick='() => SelectStatus("Inactive")'>
										Inactive
									</button>

									<button type="button"
											class="btn btn_terminated @(status == "Terminated" ? "active" : "")"
											@onclick='() => SelectStatus("Terminated")'>
										Terminated
									</button>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		}
		@if (status == "Terminated")
		{
			<div class="form-section">
				<div class="section-header">
					<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/InactiveStatus.svg"
						 class="formicon"
						 alt="icon" /> Terminated Status
				</div>
				<div class="row g-3">
					<div class="col-md-4">
						<label class="form-label-custom">Last Transaction Date </label>
						<input type="date" class="form-control-custom w-100">
					</div>
					<div class="col-md-4">
						<label class="form-label-custom">Final Amount Status</label>
						<div class="status-btn-group">
							<button type="button" class="btn btn_active active">Settled</button>
							<button type="button" class="btn btn_inactive">Not Settled</button>
						</div>
					</div>
					<div class="col-md-4">
						<label class="form-label-custom">Turnover (Lakhs)</label>

						<div class="input-icon-left-wrapper">
							<span class="input-icon-left">₹</span>

							<input type="number"
								   class="form-control-custom w-100 input-with-left-icon"
								   placeholder="0.00"
								   step="0.01">
						</div>
					</div>
				</div>
			</div>
		}
		@if (status == "Active" || status == "Inactive" || status == "Terminated")
		{
			<div class="form-section">
				<div class="section-header">
					<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/BasicInfoIcon.svg"
						 class="formicon"
						 alt="icon" /> Business Information
				</div>
				<div class="row g-3">
					<div class="col-md-4">
						<label class="form-label-custom">Dealer Code & Name</label>
						<input type="text" class="form-control-custom w-100" placeholder="Enter Code">
					</div>
					<div class="col-md-4">
						<label class="form-label-custom">Parent Dealer</label>
						<input type="text" class="form-control-custom w-100" placeholder="Enter Dealer Name">
					</div>
					<div class="col-md-4">
						<label class="form-label-custom">Business Type</label>
						<input type="text" class="form-control-custom w-100" placeholder="Enter Type">
					</div>
					<div class="col-md-4">
						<label class="form-label-custom">Firm Name (Asper Fertilizer License or GST Trade Name)</label>
						<input type="text" class="form-control-custom w-100" placeholder="Enter Firm Business Name">
					</div>
					<div class="col-md-4">
						<label class="form-label-custom">Date of Appointment</label>
						<input type="date" class="form-control-custom w-100">
					</div>
				</div>
			</div>
		}
		
		@if (status == "Inactive")
		{
			<div class="form-section">
				<div class="section-header">
					<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/InactiveStatus.svg"
						 class="formicon"
						 alt="icon" /> Inactive Status
				</div>
				<div class="row g-3">
					<div class="col-md-4">
						<label class="form-label-custom">Last Transaction Date </label>
						<input type="date" class="form-control-custom w-100">
					</div>
					<div class="col-md-4">
						<label class="form-label-custom">Transaction Type</label>
						<div class="status-btn-group">
							<button type="button" class="btn btn_active active">Sales</button>
							<button type="button" class="btn btn_inactive">Collection</button>
						</div>
					</div>
				</div>
			</div>
		}

		@if (status == "Active" || status == "Inactive")
		{
			<div class="form-card">
				<div class="d-flex justify-content-between align-items-center mb-3">
					<div class="card-header-title mb-0">
						<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/LocationIcon.svg" alt="Location" class="formicon" />Primary Location
					</div>
					<button type="button" class="btn btn-outline-success btn-sm rounded-pill px-3" style="font-size: 0.8rem;">
						<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/CurrentLocation.svg" alt="Current Location" class="verifyicon" /> Use Current Location
					</button>
				</div>

				<div class="row g-3">
					<div class="col-md-4">
						<div class="map-box">
							<button type="button" class="btn btn-sm btn-success rounded-pill px-3" style="font-size: 0.6rem; position: absolute; top: 10px; right: 10px;"><i class="bi bi-crosshair"></i> Use current location</button>
							<button type="button" class="map-overlay-btn">Interactive Area</button>
						</div>
					</div>
					<div class="col-md-8">
						<div class="row g-3">
							<div class="col-md-6">
								<label class="form-label-custom">Google Map URL</label>
								<input type="text" class="form-control-custom w-100" placeholder="Enter Lat long URL">
							</div>
							<div class="col-md-6">
								<label class="form-label-custom">Shop No / Room No / Block No</label>
								<input type="text" class="form-control-custom w-100" placeholder="">
							</div>
							<div class="col-md-6">
								<label class="form-label-custom">Street / Area / Locality</label>
								<input type="text" class="form-control-custom w-100" placeholder="">
							</div>
							<div class="col-md-6">
								<label class="form-label-custom">Sub Village</label>
								<input type="text" class="form-control-custom w-100" placeholder="Enter Sub Village">
							</div>
							<div class="col-md-6">
								<label class="form-label-custom">Village</label>
								<select class="form-select-custom w-100">
									<option value="">Enter Village</option>
								</select>
							</div>
							<div class="col-md-6">
								<label class="form-label-custom">Pincode</label>
								<input type="text" class="form-control-custom w-100" placeholder="Enter Pincode">
							</div>
						</div>
					</div>


					<div class="col-md-3">
						<label class="form-label-custom">Block</label>
						<select class="form-select-custom w-100">
							<option value="">Select Block</option>
						</select>
					</div>
					<div class="col-md-3">
						<label class="form-label-custom">Taluk</label>
						<select class="form-select-custom w-100">
							<option value="">Select Taluk</option>
						</select>
					</div>
					<div class="col-md-3">
						<label class="form-label-custom">District</label>
						<select class="form-select-custom w-100">
							<option value="">Select District</option>
						</select>
					</div>

					<div class="col-md-3">
						<label class="form-label-custom">State</label>
						<select class="form-select-custom w-100">
							<option value="">Select State</option>
						</select>
					</div>
					<div class="col-md-4">
						<label class="form-label-custom">Official Contact Number</label>
						<input type="text" class="form-control-custom w-100" placeholder="10-digit mobile number">
					</div>
					<div class="col-md-4">
						<label class="form-label-custom">WhatsApp Number</label>
						<input type="text" class="form-control-custom w-100" placeholder="10-digit mobile number">
					</div>
					<div class="col-md-4">
						<label class="form-label-custom">Alternative Number</label>
						<input type="text" class="form-control-custom w-100" placeholder="10-digit mobile number">
					</div>
				</div>
			</div>
			<div class="form-section">
				<div class="section-header">
					<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/BasicInfoIcon.svg"
						 class="formicon"
						 alt="icon" /> Bank Details
				</div>
				<div class="row g-3">
					<div class="col-md-6">
						<label class="form-label-custom">Account Holder Name</label>
						<input type="text" class="form-control-custom w-100" placeholder="Enter Account Holder Name">
					</div>
					<div class="col-md-6">
						<label class="form-label-custom">Account Number</label>
						<input type="text" class="form-control-custom w-100" placeholder="Enter Account Number">
					</div>
					<div class="col-md-4">
						<label class="form-label-custom">Bank Name</label>
						<input type="text" class="form-control-custom w-100" placeholder="Enter Bank Name">
					</div>
					<div class="col-md-4">
						<label class="form-label-custom">Bank Branch</label>
						<input type="text" class="form-control-custom w-100" placeholder="Enter Bank Branch">
					</div>
					<div class="col-md-4">
						<label class="form-label-custom">IFSC Code</label>
						<input type="text" class="form-control-custom w-100" placeholder="Enter IFSC Code">
					</div>
				</div>
			</div>

			<div class="form-section">
				<div class="section-header">
					<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/TaxComplience.svg"
						 class="formicon"
						 alt="icon" /> Tax & Compliance
				</div>
				<div class="row g-3">
					<div class="col-md-4">
						<div class="compliance-card gst">
							<div class="fw-bold small mb-2"><i class="bi bi-file-earmark-text text-success me-2"></i>GST Number</div>
							<label class="form-label-custom">GST Number</label>
							<input type="text" class="form-control form-control-sm mb-3" placeholder="15-character GST Number">
							<label class="upload-area">
								<i class="bi bi-cloud-arrow-up text-success"></i>
								<span class="small text-success fw-600">Upload PDF</span>

								<InputFile OnChange="HandleGstUpload" accept=".pdf" hidden />
							</label>
						</div>
					</div>
					<div class="col-md-4">
						<div class="compliance-card pan">
							<div class="fw-bold small mb-2"><i class="bi bi-person-badge text-primary me-2"></i>PAN Number</div>
							<label class="form-label-custom">PAN Number</label>
							<input type="text" class="form-control form-control-sm mb-3" placeholder="10-character pan Number">
							<label class="upload-area">
								<i class="bi bi-cloud-arrow-up text-primary"></i>
								<span class="small text-primary fw-600">Upload PDF</span>

								<InputFile OnChange="HandlePanUpload" accept=".pdf" hidden />
							</label>
						</div>
					</div>
					<div class="col-md-4">
						<div class="compliance-card aadhaar">
							<div class="fw-bold small mb-2"><i class="bi bi-fingerprint text-danger me-2"></i>Aadhaar Number</div>
							<label class="form-label-custom">Aadhaar Number</label>
							<input type="text" class="form-control form-control-sm mb-3" placeholder="12-digit Aadhaar">
							<label class="upload-area">
								<i class="bi bi-cloud-arrow-up text-danger"></i>
								<span class="small text-danger fw-600">Upload PDF</span>

								<InputFile OnChange="HandleAadhaarUpload" accept=".pdf" hidden />
							</label>
						</div>
					</div>
				</div>
			</div>
			<div class="row g-4 mb-4">
				<div class="col-md-6">
					<div class="form-card mb-0 h-100">
						<div class="card-header-title">
							<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/WholeSale.svg" alt="WholeSale" class="formicon" /> Wholesale Fertilizer Details
						</div>
						<div class="row g-3">
							<div class="col-6">
								<label class="form-label-custom">Wholesale Fertilizer License Details</label>
								<input type="text" class="form-control-custom w-100" placeholder="Enter Wholesale Fertilizer License Details">
							</div>
							<div class="col-6">
								<label class="form-label-custom">Expiry Date</label>
								<input type="date" class="form-control-custom w-100">
							</div>
							<div class="col-6">
								<label class="form-label-custom">mFMS Code</label>
								<input type="text" class="form-control-custom w-100" placeholder="Enter mFMS Code">
							</div>
							<div class="col-6">
								<label class="file-upload-box">
									<span><i class="bi bi-upload"></i> Choose file</span>
									<small>Upload GST Certificate</small>

									<InputFile OnChange="HandleGstFile" hidden accept=".pdf" />
								</label>
							@* 	@if (!string.IsNullOrEmpty(gstFileName))
								{
									<div class="mt-2 small text-success">
										Selected: @gstFileName
									</div>
								} *@
							</div>
						</div>
					</div>
				</div>

				<div class="col-md-6">
					<div class="form-card mb-0 h-100">
						<div class="card-header-title">
							<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/WholeSale.svg" alt="WholeSale" class="formicon" /> Retail Fertilizer Details
						</div>
						<div class="row g-3">
							<div class="col-6">
								<label class="form-label-custom">Retail Fertilizer License Details</label>
								<input type="text" class="form-control-custom w-100" placeholder="Retail Fertilizer License Details">
							</div>
							<div class="col-6">
								<label class="form-label-custom">Expiry Date</label>
								<input type="date" class="form-control-custom w-100">
							</div>
							<div class="col-6">
								<label class="form-label-custom">mFMS Code</label>
								<input type="text" class="form-control-custom w-100" placeholder="Enter mFMS Code">
							</div>
							<div class="col-6">
								<label class="file-upload-box">
									<span><i class="bi bi-upload"></i> Choose file</span>
									<small>Upload GST Certificate</small>

									<InputFile OnChange="HandleGstFile" hidden accept=".pdf" />
								</label>
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="row g-3 mb-5">
				<div class="col-md-6">
					<div class="form-card h-100">
						<div class="fw-bold mb-3"><img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/OfficeAutomation.svg" alt="OfficeAutomation" class="formicon" /> Office Automation</div>
						<label class="small text-muted mb-2 d-block">Do you have office automation?</label>
						@*   <div class="btn-group btn-group-custom">
                        <button type="button" class="btn active-green">Yes</button>
                        <button type="button" class="btn">No</button>
                    </div> *@
						<div class="yes-no-group">
							<button class="btn-yes">Yes</button>
							<button class="btn-no">No</button>
						</div>
					</div>
				</div>
				<div class="col-md-6">
					<div class="small-card h-100">
						<div class="fw-bold mb-3">
							<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/EnrollmentStatus.svg"
								 class="formicon" /> Enrollment Status
						</div>
						<label class="form text-muted mb-2 d-block">Are you Enrolled in SDWA?</label>
						<div class="yes-no-group">
							<button class="btn-yes">Yes</button>
							<button class="btn-no">No</button>
						</div>
					</div>
				</div>
			</div>
		}
	</form>
	@*     	<CommanFooter />
 *@    <div class="footer-nav">
	<NavLink href="/Dashboard" class="btn btn-prev text-decoration-none">
		<i class="bi bi-chevron-left"></i>
		Previous Step
	</NavLink>

	<NavLink href="/Experience" class="btn btn-next text-decoration-none">
		Next
		<i class="bi bi-chevron-right"></i>
	</NavLink>
</div>
</div>

@code {
	private string selected = "Dealer"; // default active

	void Select(string type)
	{
		selected = type;
	}
	private string status = "Active"; // default

	void SelectStatus(string value)
	{
		status = value;
	}
	private bool isSpic = true;        // ✅ default checked
	private bool isGreenStar = true;   // ✅ default checked

	void ToggleSpic()
	{
		isSpic = !isSpic;
	}

	void ToggleGreenStar()
	{
		isGreenStar = !isGreenStar;
	}
	async Task HandleGstUpload(InputFileChangeEventArgs e)
	{
		var file = e.File;
		Console.WriteLine($"GST File: {file.Name}");
	}

	async Task HandlePanUpload(InputFileChangeEventArgs e)
	{
		var file = e.File;
		Console.WriteLine($"PAN File: {file.Name}");
	}

	async Task HandleAadhaarUpload(InputFileChangeEventArgs e)
	{
		var file = e.File;
		Console.WriteLine($"Aadhaar File: {file.Name}");
	}
	string gstFileName;

	async Task HandleGstFile(InputFileChangeEventArgs e)
	{
		var file = e.File;
		gstFileName = file.Name;
	}
	string wholesalegstFileName;

	async Task HandleGstFileForwholesale(InputFileChangeEventArgs e)
	{
		var file = e.File;
		wholesalegstFileName = file.Name;
	}
}