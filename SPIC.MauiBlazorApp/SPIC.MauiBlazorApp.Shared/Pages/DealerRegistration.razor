@page "/Register" 


    <style>
        

        
        
        .basic-info-card {
            background: #ffffff;
            border-radius: 12px;
            border: 1px solid #E5E7EB;
            box-shadow: 0 1px 2px rgba(0,0,0,0.02);
            padding: 24px;
            margin-bottom: 24px;
        }

        .basic-info-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
        }
        
        .basic-info-title {
            font-size: 1.1rem;
            font-weight: 700;
            color: #374151;
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 0;
        }
        .basic-info-title i {
            color: #059669;
            font-size: 1.2rem;
        }

        .btn-group-toggle {
            display: flex;
            background-color: #F3F4F6;
            border-radius: 8px;
            padding: 4px;
        }
        .btn-group-toggle .btn {
            border: none;
            background: transparent;
            color: #6B7280;
            font-size: 0.8rem;
            font-weight: 600;
            padding: 8px 20px;
            border-radius: 6px;
        }
        .btn-group-toggle .btn.active {
            background-color: #059669;
            color: white;
            box-shadow: 0 1px 2px rgba(0,0,0,0.1);
        }

        /* --- Logo Cards --- */
        .logo-card {
            border-radius: 12px;
            padding: 24px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100%;
            min-height: 140px;
            cursor: pointer;
            position: relative;
            transition: 0.2s;
            border: 1px solid transparent;
        }
        .logo-card img {
            max-height: 60px;
            margin-bottom: 12px;
        }
        .logo-card span {
            font-weight: 800;
            font-size: 1.1rem;
            letter-spacing: 0.5px;
        }
        
        /* Checkbox inside Logo Card */
        .card-checkbox {
            position: absolute;
            top: 12px;
            right: 12px;
            width: 20px;
            height: 20px;
            border-radius: 4px;
            border: 2px solid #D1D5DB;
            background-color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: 0.2s;
        }
        .card-checkbox i {
            color: white;
            font-size: 0.9rem;
            opacity: 0;
        }

        /* SPIC Theme */
        .logo-card.spic {
            background-color: #F5F3FF; /* Light Indigo */
            border-color: #E0E7FF;
        }
        .logo-card.spic span { color: #3730A3; }
        .logo-card.spic:hover { border-color: #A5B4FC; }

        /* Green Star Theme */
        .logo-card.green-star {
            background-color: #ECFDF5; /* Light Green */
            border-color: #D1FAE5;
        }
        .logo-card.green-star span { color: #065F46; }
        .logo-card.green-star:hover { border-color: #6EE7B7; }

        /* Active State */
        .logo-card.active .card-checkbox {
            background-color: #059669;
            border-color: #059669;
        }
        .logo-card.active .card-checkbox i { opacity: 1; }

        /* --- Status Buttons --- */
        .status-btn-group {
            display: flex;
            background-color: #F9FAFB;
            border: 1px solid #E5E7EB;
            border-radius: 8px;
            padding: 4px;
            width: 100%;
        }
        .status-btn-group .btn {
            flex: 1;
            border: none;
            background: transparent;
            color: #6B7280;
            font-size: 0.8rem;
            font-weight: 600;
            padding: 8px 0;
            border-radius: 6px;
        }
        .status-btn-group .btn.active {
            background-color: #F59E0B; /* Orange */
            color: white;
            box-shadow: 0 1px 2px rgba(0,0,0,0.1);
        }
        
        /* Containers */
        .form-section { background: #fff; border: 1px dashed #CBD5E1; border-radius: 12px; padding: 24px; margin-bottom: 24px; }
        .section-header { display: flex; align-items: center; gap: 10px; font-weight: 700; margin-bottom: 20px; color: #1F2937; }
        .section-header i { color: #059669; font-size: 1.2rem; }

        /* Inputs */
        .form-label-custom { font-size: 0.75rem; font-weight: 600; color: #64748B; margin-bottom: 6px; }
        .form-control-custom { background-color: #F1F5F9; border: 1px solid transparent; border-radius: 6px; padding: 10px; font-size: 0.85rem; }
        .form-control-custom:focus { background-color: #fff; border-color: #059669; box-shadow: none; }

        /* Logo Selection */
        .logo-box { border: 2px solid #E2E8F0; border-radius: 12px; padding: 15px; text-align: center; cursor: pointer; transition: 0.3s; background: #fff; height: 100px; display: flex; flex-direction: column; align-items: center; justify-content: center; }
        .logo-box.active { border-color: #059669; background-color: #F0FDF4; }
        .logo-box img { max-height: 40px; margin-bottom: 8px; }
        .logo-box span { font-weight: 700; font-size: 0.8rem; }

        /* Status & Toggle Buttons */
        .btn-group-custom .btn { border: 1px solid #E2E8F0; background: #F8FAFC; color: #64748B; font-size: 0.75rem; font-weight: 600; padding: 6px 15px; }
        .btn-group-custom .btn.active-green { background-color: #059669; color: white; border-color: #059669; }
        .btn-group-custom .btn.active-orange { background-color: #F59E0B; color: white; border-color: #F59E0B; }

        /* Map Placeholder */
        .map-box { background: url('https://images.unsplash.com/photo-1526778548025-fa2f459cd5c1?auto=format&fit=crop&q=80&w=500') center; background-size: cover; height: 200px; border-radius: 8px; position: relative; display: flex; align-items: center; justify-content: center; }
        .map-overlay-btn { position: absolute; bottom: 10px; right: 10px; background: white; border-radius: 20px; font-size: 0.7rem; padding: 4px 12px; border: 1px solid #ddd; }

        /* Compliance Upload Cards */
        .compliance-card { border-radius: 12px; padding: 20px; border: 1px solid #E2E8F0; height: 100%; }
        .compliance-card.gst { background-color: #F0FDF4; }
        .compliance-card.pan { background-color: #EFF6FF; }
        .compliance-card.aadhaar { background-color: #FEF2F2; }
        
        .upload-area { background: white; border: 1px dashed #CBD5E1; border-radius: 8px; padding: 15px; text-align: center; margin-top: 10px; cursor: pointer; }
        .upload-area i { font-size: 1.5rem; display: block; margin-bottom: 5px; }

        /* Footer sections */
        .small-card { background: #fff; border: 1px solid #E2E8F0; border-radius: 10px; padding: 15px; }
    </style>


<div class="container-fluid py-4 px-0">
    	<FormLoader />

    <h5 class="fw-bold mb-4">Company Details</h5>

    <form method="post">
        
       <div class="basic-info-card">
    <div class="basic-info-header">
        <h3 class="basic-info-title">
            <i class="bi bi-ui-checks"></i> Basic Information
        </h3>
        
        <div class="btn-group-toggle">
            <button type="button" class="btn active">Dealer</button>
            <button type="button" class="btn">Department</button>
        </div>
    </div>

    <div class="row g-4 align-items-center">
        <div class="col-md-5">
            <div class="row g-3 h-100">
                <div class="col-6">
                    <div class="logo-card spic active" onclick="this.classList.toggle('active')">
                        <div class="card-checkbox"><i class="bi bi-check-lg"></i></div>
                        <img src="_content/SPIC.MauiBlazorApp.Shared/images/loginimages/logo.png" alt="SPIC Logo" />
                        <span>SPIC</span>
                    </div>
                </div>
                <div class="col-6">
                    <div class="logo-card green-star" onclick="this.classList.toggle('active')">
                        <div class="card-checkbox"><i class="bi bi-check-lg"></i></div>
                        <img src="_content/SPIC.MauiBlazorApp.Shared/images/loginimages/greensraticon.svg" alt="Green Star Logo" />
                        <span>GREEN STAR</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-7">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label-custom">State</label>
                    <input type="text" class="form-control form-control-custom" placeholder="Enter Region">
                </div>
                <div class="col-md-6">
                    <label class="form-label-custom">Region</label>
                    <input type="text" class="form-control form-control-custom" placeholder="Enter Region">
                </div>
                <div class="col-md-6">
                    <label class="form-label-custom">HQ</label>
                    <input type="text" class="form-control form-control-custom" placeholder="Enter HQ">
                </div>
                <div class="col-md-6">
                    <label class="form-label-custom">Status</label>
                    <div class="status-btn-group">
                        <button type="button" class="btn">Active</button>
                        <button type="button" class="btn active">Inactive</button>
                        <button type="button" class="btn">Terminated</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

        <div class="form-section">
            <div class="section-header"><i class="bi bi-briefcase"></i> Business Information</div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label-custom">Dealer Code & Name</label>
                    <input type="text" class="form-control form-control-custom" placeholder="Enter Code">
                </div>
                <div class="col-md-4">
                    <label class="form-label-custom">Parent Dealer</label>
                    <input type="text" class="form-control form-control-custom" placeholder="Enter Name">
                </div>
                <div class="col-md-4">
                    <label class="form-label-custom">Business Type</label>
                    <input type="text" class="form-control form-control-custom" placeholder="Enter Type">
                </div>
                <div class="col-md-8">
                    <label class="form-label-custom">Firm Name</label>
                    <input type="text" class="form-control form-control-custom" placeholder="Enter Firm Name">
                </div>
                <div class="col-md-4">
                    <label class="form-label-custom">Date of Appointment</label>
                    <input type="date" class="form-control form-control-custom">
                </div>
            </div>
        </div>

        <div class="form-section">
            <div class="section-header"><i class="bi bi-geo-alt"></i> Primary Location</div>
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="map-box">
                        <button type="button" class="btn btn-sm btn-success rounded-pill px-3" style="font-size: 0.6rem; position: absolute; top: 10px; right: 10px;"><i class="bi bi-crosshair"></i> Use current location</button>
                        <button type="button" class="map-overlay-btn">Interactive Area</button>
                    </div>
                </div>
                <div class="col-md-8">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label-custom">Google Map URL</label>
                            <input type="text" class="form-control form-control-custom" placeholder="Lat, Long">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-custom">Shop / Block No.</label>
                            <input type="text" class="form-control form-control-custom">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-custom">Street / Locality</label>
                            <input type="text" class="form-control form-control-custom">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-custom">Village</label>
                            <select class="form-select form-control-custom"><option>Select Village</option></select>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-section">
            <div class="section-header"><i class="bi bi-shield-check"></i> Tax & Compliance</div>
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="compliance-card gst">
                        <div class="fw-bold small mb-2"><i class="bi bi-file-earmark-text text-success me-2"></i>GST Number</div>
                        <input type="text" class="form-control form-control-sm mb-3" placeholder="15-char GST">
                        <div class="upload-area">
                            <i class="bi bi-cloud-arrow-up text-success"></i>
                            <span class="small text-success fw-600">Upload PDF</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="compliance-card pan">
                        <div class="fw-bold small mb-2"><i class="bi bi-person-badge text-primary me-2"></i>PAN Number</div>
                        <input type="text" class="form-control form-control-sm mb-3" placeholder="10-char PAN">
                        <div class="upload-area">
                            <i class="bi bi-cloud-arrow-up text-primary"></i>
                            <span class="small text-primary fw-600">Upload PDF</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="compliance-card aadhaar">
                        <div class="fw-bold small mb-2"><i class="bi bi-fingerprint text-danger me-2"></i>Aadhaar Number</div>
                        <input type="text" class="form-control form-control-sm mb-3" placeholder="12-digit Aadhaar">
                        <div class="upload-area">
                            <i class="bi bi-cloud-arrow-up text-danger"></i>
                            <span class="small text-danger fw-600">Upload PDF</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3 mb-5">
            <div class="col-md-6">
                <div class="small-card h-100">
                    <div class="fw-bold mb-3"><i class="bi bi-pc-display me-2 text-primary"></i> Office Automation</div>
                    <label class="small text-muted mb-2 d-block">Do you have office automation?</label>
                    <div class="btn-group btn-group-custom">
                        <button type="button" class="btn active-green">Yes</button>
                        <button type="button" class="btn">No</button>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="small-card h-100">
                    <div class="fw-bold mb-3"><i class="bi bi-check-all me-2 text-success"></i> Enrollment Status</div>
                    <label class="small text-muted mb-2 d-block">Are you enrolled in ST-NA?</label>
                    <div class="btn-group btn-group-custom">
                        <button type="button" class="btn active-green">Yes</button>
                        <button type="button" class="btn">No</button>
                    </div>
                </div>
            </div>
        </div>

    </form>
    	<CommanFooter />
</div>

