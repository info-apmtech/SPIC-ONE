    @code {
    private async Task HandleAadhaarUpload(ChangeEventArgs e)
    {
        var file = (e.Value as Microsoft.AspNetCore.Components.Forms.IBrowserFile);
        if (file != null)
        {
            Console.WriteLine($"Aadhaar file selected: {file.Name}");
        }
    }

    private async Task HandlePanUpload(ChangeEventArgs e)
    {
        var file = (e.Value as Microsoft.AspNetCore.Components.Forms.IBrowserFile);
        if (file != null)
        {
            Console.WriteLine($"PAN file selected: {file.Name}");
        }
    }
     private async Task HandleImageUpload(ChangeEventArgs e)
    {
        var file = (e.Value as Microsoft.AspNetCore.Components.Forms.IBrowserFile);
        if (file != null)
        {
            Console.WriteLine($"Image file selected: {file.Name}");
        }
    }
    private bool showPopup = false;

    void OpenPopup() => showPopup = true;
    void ClosePopup() => showPopup = false;
    // Load DropDown
    private List<ProprietorItemDto> _SectorAll = new();
    private string CurrentApiBase => "api/Sector";

    private SectorFormModel _sectorForm = new();
    private string? _message;
    private bool _isError;

    protected override async Task OnInitializedAsync()
    {
        await LoadSector();
    }

    private async Task LoadSector()
    {
        try
        {
            _SectorAll = await Http.GetFromJsonAsync<List<ProprietorItemDto>>($"{CurrentApiBase}/all") ?? new();
        }
        catch (Exception ex)
        {
            ShowMessage($"Failed to load : {ex.Message}", true);
        }
    }

    private void ShowMessage(string message, bool isError)
    {
        _message = message;
        _isError = isError;
    }
    public class ProprietorItemDto
    {
        public int Id { get; set; }
        public string SectorName { get; set; } = "";
    }
    public class SectorFormModel
    {
        public int SectorId { get; set; }
    }
}
