@code {
	[SupplyParameterFromQuery(Name = "dealerId")]
	public int DealerId { get; set; }
	[SupplyParameterFromQuery(Name = "mode")]
	public string? Mode { get; set; }

	private bool IsViewOnly => string.Equals(Mode, "view", StringComparison.OrdinalIgnoreCase);
	// Entity type selection
	private EntityType? _selectedEntityType;
	private readonly List<(EntityType Value, string Label)> _entityTypes =
	[
		(EntityType.soleProprietor, "Sole Proprietor"),
		(EntityType.Partnership, "Partnership"),
		(EntityType.LLP, "LLP"),
		(EntityType.PvtLtd, "PVT LTD"),
		(EntityType.PubLtd, "PUB LTD"),
		(EntityType.Society, "Society")
	];

	// Dropdowns
	private List<Sector> _sectors = new();
	private List<RelationshipEntity> _relationships = new();
	private List<State> _statesAll = new();
	private List<District> _districtsAll = new();

	// Partner form
	private DealerOwnershipInfo _partnerForm = new() { DOB = DateTime.Today }; // Set DOB default to current date;
	private bool _isEditingPartner;
	private int _editingPartnerId;

	// File uploads
	private IBrowserFile? _aadhaarFile;
	private IBrowserFile? _panFile;
	private IBrowserFile? _imageFile;

	// Family form (in-memory per current partner)
	private PartnerFamilyDetails _familyForm = NewFamilyForm();
	private List<PartnerFamilyDetails> _currentFamilyList = new();
	private int _editingFamilyIndex = -1;

	// Occupation form (in-memory per current partner)
	private PartnerOccupation _occupationForm = new();
	private List<PartnerOccupation> _currentOccupationList = new();
	private int _editingOccupationIndex = -1;
	private bool _hasOtherOccupation;

	// Saved data
	private List<DealerOwnershipInfo> _savedPartners = new();
	private Dictionary<int, List<PartnerFamilyDetails>> _savedFamilyMap = new();
	private Dictionary<int, List<PartnerOccupation>> _savedOccupationMap = new();

	// Delete
	private bool _showDeleteConfirm;
	private DealerOwnershipInfo? _partnerToDelete;
	private bool _isDeleting;

	// Popup
	private bool _showPopup;
	private DealerOwnershipInfo? _viewPartner;

	// State
	private bool _isSavingPartner;
	private bool _isSaving;
	private string? _message;
	private bool _isError;
	private bool _isPincodeLookup;
	private string? _pincodeMessage;
	private bool _pincodeSuccess;

	protected override async Task OnInitializedAsync()
	{
		Loading.Show();
		try
		{
			await Task.WhenAll(LoadSectors(), LoadRelationships(), LoadDealerEntityType(), LoadSavedPartners(), LoadStates(), LoadDistricts());
		}
		finally
		{
			Loading.Hide();
		}
	}

	private async Task LoadSectors()
	{
		try { _sectors = await Http.GetFromJsonAsync<List<Sector>>("api/Sector/all") ?? new(); } catch { }
	}

	private async Task LoadRelationships()
	{
		try { _relationships = await Http.GetFromJsonAsync<List<RelationshipEntity>>("api/Relationship/all") ?? new(); } catch { }
	}

	private async Task LoadStates()
	{
		try { _statesAll = await Http.GetFromJsonAsync<List<State>>("api/State/all") ?? new(); } catch { }
	}

	private async Task LoadDistricts()
	{
		try { _districtsAll = await Http.GetFromJsonAsync<List<District>>("api/District/all") ?? new(); } catch { }
	}

	private async Task LoadDealerEntityType()
	{
		try
		{
			var dealer = await Http.GetFromJsonAsync<DealerReg>($"api/DealerRegistration/{DealerId}");
			if (dealer != null)
				_selectedEntityType = dealer.EntityType;
		}
		catch { }
	}

	private async Task LoadSavedPartners()
	{
		try
		{
			var partnersTask = Http.GetFromJsonAsync<List<DealerOwnershipInfo>>($"api/DealerOwnershipInfo/byDealer/{DealerId}");
			var familyTask = Http.GetFromJsonAsync<List<PartnerFamilyDetails>>("api/PartnerFamilyDetails/all");
			var occTask = Http.GetFromJsonAsync<List<PartnerOccupation>>("api/PartnerOccupation/all");

			await Task.WhenAll(partnersTask, familyTask, occTask);

			_savedPartners = partnersTask.Result ?? new();
			var allFamily = familyTask.Result   ?? new();
			var allOcc = occTask.Result       ?? new();

			_savedFamilyMap.Clear();
			_savedOccupationMap.Clear();

			foreach (var p in _savedPartners)
			{
				_savedFamilyMap[p.Id]     = allFamily.Where(f => f.OwnershipPartnerId == p.Id).ToList();
				_savedOccupationMap[p.Id] = allOcc.Where(o => o.OwnershipPartnerId == p.Id).ToList();
			}
		}
		catch (Exception ex)
		{
			ShowMessage($"Failed to load partners: {ex.Message}", true);
		}
	}

	private async Task SelectEntityType(EntityType et)
	{
		_selectedEntityType = et;
		try
		{
			var dealer = await Http.GetFromJsonAsync<DealerReg>($"api/DealerRegistration/{DealerId}");
			if (dealer != null)
			{
				dealer.EntityType = et;
				await Http.PutAsJsonAsync($"api/DealerRegistration/{DealerId}", dealer);
			}
		}
		catch (Exception ex)
		{
			ShowMessage($"Failed to update entity type: {ex.Message}", true);
		}
	}

	// File selection handlers
	private void OnAadhaarSelected(InputFileChangeEventArgs e) => _aadhaarFile = e.File;
	private void OnPanSelected(InputFileChangeEventArgs e) => _panFile = e.File;
	private void OnImageSelected(InputFileChangeEventArgs e) => _imageFile = e.File;

	// File Removal Handlers
	private void RemoveAadhaarFile()
	{
		_aadhaarFile = null;
		_partnerForm.AadhaarFilePath = null;
	}

	private void RemovePanFile()
	{
		_panFile = null;
		_partnerForm.PANFilePath = null;
	}

	private void RemoveImageFile()
	{
		_imageFile = null;
		_partnerForm.ProprietorImagePath = null;
	}

	// --- Family CRUD (in-memory) ---
	private void CalculateFamilyAge()
	{
		var dob = _familyForm.DateOfBirth;
		if (dob < DateTime.Today)
		{
			var today = DateTime.Today;
			int age = today.Year - dob.Year;
			if (dob.Date > today.AddYears(-age)) age--;
			_familyForm.Age = age;
		}
		else
		{
			_familyForm.Age = 0;
		}
	}

	private void AddOrUpdateFamily()
	{
		if (string.IsNullOrWhiteSpace(_familyForm.FamilyMemberName))
		{
			ShowMessage("Please enter family member name.", true);
			return;
		}

		if (_editingFamilyIndex >= 0)
		{
			_currentFamilyList[_editingFamilyIndex] = CloneFamily(_familyForm);
			_editingFamilyIndex = -1;
		}
		else
		{
			_currentFamilyList.Add(CloneFamily(_familyForm));
		}
		_familyForm = NewFamilyForm();
		_message = null;
	}

	private void EditFamily(int index)
	{
		_editingFamilyIndex = index;
		var src = _currentFamilyList[index];
		_familyForm = CloneFamily(src);
	}

	private void RemoveFamily(int index)
	{
		_currentFamilyList.RemoveAt(index);
		if (_editingFamilyIndex == index) { _editingFamilyIndex = -1; _familyForm = NewFamilyForm(); }
	}

	private void CancelFamilyEdit()
	{
		_editingFamilyIndex = -1;
		_familyForm = NewFamilyForm();
	}

	// --- Occupation CRUD (in-memory) ---
	private void AddOrUpdateOccupation()
	{
		if (string.IsNullOrWhiteSpace(_occupationForm.NameofCompany))
		{
			ShowMessage("Please enter company name.", true);
			return;
		}

		if (_editingOccupationIndex >= 0)
		{
			_currentOccupationList[_editingOccupationIndex] = CloneOccupation(_occupationForm);
			_editingOccupationIndex = -1;
		}
		else
		{
			_currentOccupationList.Add(CloneOccupation(_occupationForm));
		}
		_occupationForm = new();
		_message = null;
	}

	private void EditOccupation(int index)
	{
		_editingOccupationIndex = index;
		var src = _currentOccupationList[index];
		_occupationForm = CloneOccupation(src);
	}

	private void RemoveOccupation(int index)
	{
		_currentOccupationList.RemoveAt(index);
		if (_editingOccupationIndex == index) { _editingOccupationIndex = -1; _occupationForm = new(); }
	}

	private void CancelOccupationEdit()
	{
		_editingOccupationIndex = -1;
		_occupationForm = new();
	}

	// --- Save Partner (with family + occupations) ---
	private async Task SavePartnerDetails()
	{
		var validationErrors = new List<string>();

		if (string.IsNullOrWhiteSpace(_partnerForm.Name))
			validationErrors.Add("• <b>Authorized Name</b> is required.");

		if (string.IsNullOrWhiteSpace(_partnerForm.PhoneNumber))
			validationErrors.Add("• <b>Phone Number</b> is required.");
		else if (_partnerForm.PhoneNumber.Length != 10)
			validationErrors.Add("• <b>Phone Number</b> must be exactly 10 digits.");

		if (!string.IsNullOrWhiteSpace(_partnerForm.Email) &&
			!System.Text.RegularExpressions.Regex.IsMatch(_partnerForm.Email, @"^[^@\s]+@[^@\s]+\.[^@\s]+$"))
			validationErrors.Add("• <b>Email</b> is not a valid email address.");

		if (_selectedEntityType != EntityType.soleProprietor)
		{
			if (string.IsNullOrWhiteSpace(_partnerForm.AadhaarNumber))
				validationErrors.Add("• <b>Aadhaar Number</b> is required.");
			else if (_partnerForm.AadhaarNumber.Length != 12)
				validationErrors.Add("• <b>Aadhaar Number</b> must be exactly 12 digits.");

			if (string.IsNullOrWhiteSpace(_partnerForm.PANNumber))
				validationErrors.Add("• <b>PAN Number</b> is required.");
			else if (!System.Text.RegularExpressions.Regex.IsMatch(_partnerForm.PANNumber, @"^[A-Z]{5}[0-9]{4}[A-Z]$"))
				validationErrors.Add("• <b>PAN Number</b> must be in format ABCDE1234F (e.g. ABCDE1234F).");
		}

		// Enforce max partners for sole proprietor
		if (_selectedEntityType == EntityType.soleProprietor && !_isEditingPartner && _savedPartners.Count >= 1)
			validationErrors.Add("• <b>Entity Type</b>: Sole Proprietor can have only 1 partner.");

		if (validationErrors.Count > 0)
		{
			_message = string.Join("<br/>", validationErrors);
			_isError = true;
			return;
		}

		_isSavingPartner = true;
		_message = null;

		try
		{
			_partnerForm.DealerId = DealerId;

			// Upload files first
			if (_aadhaarFile != null)
			{
				var path = await UploadFileToServer(DealerId, "PartnerAadhaar", _aadhaarFile);
				if (path != null) _partnerForm.AadhaarFilePath = path;
			}
			if (_panFile != null)
			{
				var path = await UploadFileToServer(DealerId, "PartnerPAN", _panFile);
				if (path != null) _partnerForm.PANFilePath = path;
			}
			if (_imageFile != null)
			{
				var path = await UploadFileToServer(DealerId, "ProprietorImage", _imageFile);
				if (path != null) _partnerForm.ProprietorImagePath = path;
			}

			int partnerId;

			if (_isEditingPartner)
			{
				var updateResp = await Http.PutAsJsonAsync($"api/DealerOwnershipInfo/{_editingPartnerId}", _partnerForm);
				if (!updateResp.IsSuccessStatusCode)
				{
					var err = await updateResp.Content.ReadAsStringAsync();
					ShowMessage($"Failed to update partner: {err}", true);
					return;
				}
				partnerId = _editingPartnerId;

				// Delete existing family and occupations for this partner, then re-create
				if (_savedFamilyMap.ContainsKey(partnerId))
				{
					foreach (var f in _savedFamilyMap[partnerId])
						await Http.DeleteAsync($"api/PartnerFamilyDetails/{f.Id}");
				}
				if (_savedOccupationMap.ContainsKey(partnerId))
				{
					foreach (var o in _savedOccupationMap[partnerId])
						await Http.DeleteAsync($"api/PartnerOccupation/{o.Id}");
				}
			}
			else
			{
				var resp = await Http.PostAsJsonAsync("api/DealerOwnershipInfo", _partnerForm);
				if (!resp.IsSuccessStatusCode)
				{
					var err = await resp.Content.ReadAsStringAsync();
					ShowMessage($"Failed to save partner: {err}", true);
					return;
				}
				var created = await resp.Content.ReadFromJsonAsync<CreateResponse<DealerOwnershipInfo>>();
				partnerId = created?.Data?.Id ?? 0;
				if (partnerId == 0)
				{
					ShowMessage("Failed to save partner: server did not return a valid ID. Please try again.", true);
					return;
				}
			}

			// Save family details
			foreach (var fm in _currentFamilyList)
			{
				fm.OwnershipPartnerId = partnerId;
				fm.Id = 0;
				await Http.PostAsJsonAsync("api/PartnerFamilyDetails", fm);
			}

			// Save occupations
			foreach (var occ in _currentOccupationList)
			{
				occ.OwnershipPartnerId = partnerId;
				occ.Id = 0;
				await Http.PostAsJsonAsync("api/PartnerOccupation", occ);
			}

			// Reset form
			ResetPartnerForm();
			await LoadSavedPartners();
			ShowMessage(_isEditingPartner ? "Partner updated successfully!" : "Partner saved successfully!", false);
			_isEditingPartner = false;
			_editingPartnerId = 0;
		}
		catch (Exception ex)
		{
			ShowMessage($"Unexpected error: {ex.Message}", true);
		}
		finally
		{
			_isSavingPartner = false;
		}
	}

	private async Task EditPartner(DealerOwnershipInfo partner)
	{
		_isEditingPartner = true;
		_editingPartnerId = partner.Id;

		_partnerForm = new DealerOwnershipInfo
		{
			Id = partner.Id,
			DealerId = partner.DealerId,
			Name = partner.Name,
			FatherName = partner.FatherName,
			PhoneNumber = partner.PhoneNumber,
			Email = partner.Email,
			AadhaarNumber = partner.AadhaarNumber,
			AadhaarFilePath = partner.AadhaarFilePath,
			PANNumber = partner.PANNumber,
			PANFilePath = partner.PANFilePath,
			ProprietorImagePath = partner.ProprietorImagePath,
			Gender = partner.Gender,
			MaritalStatus = partner.MaritalStatus,
			ShopNoORRoomNoOrBlockNo = partner.ShopNoORRoomNoOrBlockNo,
			Street = partner.Street,
			SubVillage = partner.SubVillage,
			Village = partner.Village,
			PinCode = partner.PinCode,
			Block = partner.Block,
			Taluk = partner.Taluk,
			DistrictId = partner.DistrictId,
			StateId = partner.StateId
		};

		_currentFamilyList = _savedFamilyMap.ContainsKey(partner.Id)
			? _savedFamilyMap[partner.Id].Select(CloneFamily).ToList()
			: new();

		_currentOccupationList = _savedOccupationMap.ContainsKey(partner.Id)
			? _savedOccupationMap[partner.Id].Select(CloneOccupation).ToList()
			: new();

		_hasOtherOccupation = _currentOccupationList.Count > 0;
		_aadhaarFile = null;
		_panFile = null;
		_imageFile = null;
		_message = null;
	}

	private void CancelPartnerEdit()
	{
		_isEditingPartner = false;
		_editingPartnerId = 0;
		ResetPartnerForm();
	}

	// --- Delete Partner ---
	private void ConfirmDeletePartner(DealerOwnershipInfo partner)
	{
		_partnerToDelete = partner;
		_showDeleteConfirm = true;
	}

	private void CancelDeletePartner()
	{
		_showDeleteConfirm = false;
		_partnerToDelete = null;
	}

	private async Task ExecuteDeletePartner()
	{
		if (_partnerToDelete == null) return;
		_isDeleting = true;
		try
		{
			// Delete family details
			if (_savedFamilyMap.ContainsKey(_partnerToDelete.Id))
			{
				foreach (var f in _savedFamilyMap[_partnerToDelete.Id])
					await Http.DeleteAsync($"api/PartnerFamilyDetails/{f.Id}");
			}
			// Delete occupations
			if (_savedOccupationMap.ContainsKey(_partnerToDelete.Id))
			{
				foreach (var o in _savedOccupationMap[_partnerToDelete.Id])
					await Http.DeleteAsync($"api/PartnerOccupation/{o.Id}");
			}
			// Delete partner
			await Http.DeleteAsync($"api/DealerOwnershipInfo/{_partnerToDelete.Id}");

			_showDeleteConfirm = false;
			_partnerToDelete = null;
			await LoadSavedPartners();
			ShowMessage("Partner deleted successfully!", false);
		}
		catch (Exception ex)
		{
			ShowMessage($"Error deleting partner: {ex.Message}", true);
		}
		finally
		{
			_isDeleting = false;
		}
	}

