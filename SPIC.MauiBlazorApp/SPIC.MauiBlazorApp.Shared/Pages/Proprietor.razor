	private async Task<string?> UploadFileToServer(int dealerId, string docType, IBrowserFile file)
	{
		try
		{
			using var content = new MultipartFormDataContent();
			var stream = file.OpenReadStream(5 * 1024 * 1024);
			content.Add(new StreamContent(stream), "file", file.Name);

			var response = await Http.PostAsync($"api/DealerFile/upload/{dealerId}/{docType}", content);
			if (response.IsSuccessStatusCode)
			{
				var result = await response.Content.ReadFromJsonAsync<FileUploadResponse>();
				return result?.FilePath;
			}
		}
		catch { }
		return null;
	}

	private void SanitizePhoneNumber()
	{
		_partnerForm.PhoneNumber = new string(_partnerForm.PhoneNumber?.Where(char.IsDigit).ToArray() ?? []);
	}

	private async Task OnPincodeChanged()
{
    _pincodeMessage = null;
    _pincodeSuccess = false;

    // Strip non-digit characters
    if (!string.IsNullOrEmpty(_partnerForm.PinCode))
    {
        var digitsOnly = new string(_partnerForm.PinCode.Where(char.IsDigit).ToArray());
        if (digitsOnly != _partnerForm.PinCode)
            _partnerForm.PinCode = digitsOnly;
    }

    if (string.IsNullOrWhiteSpace(_partnerForm.PinCode) || _partnerForm.PinCode.Length != 6)
        return;

    _isPincodeLookup = true;
    StateHasChanged();

    try
    {
        using var response = await Http.GetAsync($"api/PincodeLookup/{_partnerForm.PinCode}");

        if (!response.IsSuccessStatusCode)
        {
            var body = await response.Content.ReadAsStringAsync();
            _pincodeMessage = $"Lookup failed (HTTP {(int)response.StatusCode}): {body}";
            return;
        }

        var results = await response.Content.ReadFromJsonAsync<List<PincodeApiResponse>>();
        var result = results?.FirstOrDefault();

        if (result == null
            || !string.Equals(result.Status, "Success", StringComparison.OrdinalIgnoreCase)
            || result.PostOffice == null
            || result.PostOffice.Count == 0)
        {
            _pincodeMessage = $"No data found for pincode {_partnerForm.PinCode}";
            return;
        }

        var postOffice = result.PostOffice[0];

        var apiDistrict = postOffice.District?.Trim().Replace(" ", "") ?? "";
        var matchedDistrict = _districtsAll.FirstOrDefault(d =>
            d.DistrictName.Trim().Replace(" ", "").Equals(apiDistrict, StringComparison.OrdinalIgnoreCase));
        if (matchedDistrict != null)
            _partnerForm.DistrictId = matchedDistrict.Id;

        var apiState = postOffice.State?.Trim().Replace(" ", "") ?? "";
        var matchedState = _statesAll.FirstOrDefault(s =>
            s.StateName.Trim().Replace(" ", "").Equals(apiState, StringComparison.OrdinalIgnoreCase));
        if (matchedState != null)
            _partnerForm.StateId = matchedState.Id;

        if (!string.IsNullOrWhiteSpace(postOffice.Block) && postOffice.Block != "NA")
            _partnerForm.Block = postOffice.Block;
        if (!string.IsNullOrWhiteSpace(postOffice.Division)) _partnerForm.Taluk = postOffice.Division;
        if (!string.IsNullOrWhiteSpace(postOffice.Name)) _partnerForm.Village = postOffice.Name;

        _pincodeSuccess = true;
        _pincodeMessage = $"Auto-filled: {postOffice.District}, {postOffice.State}";
    }
    catch (HttpRequestException httpEx)
    {
        _pincodeMessage = $"Network error: {httpEx.Message}";
    }
    catch (TaskCanceledException)
    {
        _pincodeMessage = "Lookup timed out — try again.";
    }
    catch (Exception ex)
    {
        _pincodeMessage = $"{ex.GetType().Name}: {ex.Message}";
    }
    finally
    {
        _isPincodeLookup = false;
    }
}

