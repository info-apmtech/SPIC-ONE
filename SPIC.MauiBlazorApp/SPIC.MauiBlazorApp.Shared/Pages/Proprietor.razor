	// --- Navigate Next ---
	private async Task HandleNext()
	{
		if (IsViewOnly)
		{
			Loading.Show();
			Nav.NavigateTo($"/SalesPlaning?dealerId={DealerId}&mode=view");
			return;
		}
		if (_selectedEntityType == null)
		{
			FormStepData.MarkStepError(7, true);
			ShowMessage("Please select a business entity type.", true);
			return;
		}

		if (_selectedEntityType == EntityType.soleProprietor && _savedPartners.Count < 1)
		{
			FormStepData.MarkStepError(7, true);
			ShowMessage("Please add at least 1 proprietor.", true);
			return;
		}

		if (_selectedEntityType != EntityType.soleProprietor && _savedPartners.Count < 2)
		{
			FormStepData.MarkStepError(7, true);
			ShowMessage("Please add at least 2 partners for the selected entity type.", true);
			return;
		}

		_isSaving = true;
		try
		{
			FormStepData.MarkStepError(7, false);
			Loading.Show();
			Nav.NavigateTo($"/SalesPlaning?dealerId={DealerId}");
		}
		finally
		{
			_isSaving = false;
		}
	}

