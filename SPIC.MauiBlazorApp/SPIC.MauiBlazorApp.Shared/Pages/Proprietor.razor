        }
        .btn-upload-attach:hover { background-color: #D1FAE5; }

        /* --- Image Upload Box --- */
        .image-upload-box {
            background-color: #F9FAFB;
            border: 1px dashed #D1D5DB;
            border-radius: 8px;
            height: 100%;
            min-height: 150px;
