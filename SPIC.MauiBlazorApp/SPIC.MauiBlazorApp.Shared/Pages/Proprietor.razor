@page "/Proprietor"
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@using RelationshipEntity = SPIC.Core.Entities.Relationship
@using DealerReg = SPIC.Core.Entities.DealerRegistration
@using SPIC.Core.Entities
@using SPIC.MauiBlazorApp.Shared.FormFlow
@inject HttpClient Http
@inject NavigationManager Nav
@inject LoadingService Loading
<style>
	fieldset:disabled .icon-delete {
		display: none !important;
	}

	fieldset:disabled .icon-edit {
		display: none !important;
	}
</style>
<div class="container-fluid py-4 px-0">
	<FormLoader />
	            	<fieldset disabled="@IsViewOnly" style="border:0;padding:0;margin:0;">

	<div class="company-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
		<h3 class="fw-bold m-0 company-title">Proprietor Details</h3>
	</div>

	@if (!string.IsNullOrEmpty(_message))
	{
		<div class="alert @(_isError ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
			@((MarkupString)_message)
			<button type="button" class="btn-close" @onclick="() => _message = null"></button>
		</div>
	}

	<div class="main-section">
		<div class="section-header mb-3">
			<h3 class="section-title">
				<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/businessIcon1.svg" class="formicon" />
				Business Entity Type
			</h3>
		</div>
		<div class="entity-grid">
			@foreach (var et in _entityTypes)
			{
				<div class="entity-card @(_selectedEntityType == et.Value ? "active" : "")"
					 style="cursor:pointer" @onclick="() => SelectEntityType(et.Value)">
					@switch (et.Value)
					{
						case EntityType.soleProprietor:
							<i class="bi bi-person"></i>
							break;
						case EntityType.Partnership:
							<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/LeaderShip.svg" class="formicon" />
							break;
						case EntityType.LLP:
							<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/LlpIcon.svg" class="formicon" />
							break;
						case EntityType.PvtLtd:
							<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/PvtIcon.svg" class="formicon" />
							break;
						case EntityType.PubLtd:
							<i class="bi bi-buildings"></i>
							break;
						case EntityType.Society:
							<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/socityIcon.svg" class="formicon" />
							break;
					}
					<span>@et.Label</span>
				</div>
			}
		</div>
	</div>

	@if (_selectedEntityType != EntityType.soleProprietor || _savedPartners.Count < 1 || _isEditingPartner)
	{
	<div class="main-section">
		<div class="section-header">
			<h3 class="section-title">
				<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/OwnerIcon.svg" class="formicon" />
				Ownership Information
			</h3>
			<span class="badge-green">@(_isEditingPartner ? "Editing Partner" : "New Partner")</span>
		</div>

        <div class="row g-4">
            <div class="col-md-9">
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="custom-label">Authorized Name</label>
                        <input type="text" class="custom-input" placeholder="Enter Full Legal Name" @bind="_partnerForm.Name" />
                    </div>
                    <div class="col-md-6">
                        <label class="custom-label">Son of / Daughter of</label>
                        <input type="text" class="custom-input" placeholder="Enter Father Name" @bind="_partnerForm.FatherName" />
                    </div>
                </div>
				<div class="row g-3 mb-3">
					<div class="col-md-3">
						<label class="custom-label">Gender</label>
						<select class="form-select-custom w-100" @bind="_partnerForm.Gender">
							@foreach (var g in Enum.GetValues<Gender>())
							{
								<option value="@g">@g</option>
							}
						</select>
					</div>
					<div class="col-md-3">
						<label class="custom-label">Marital Status</label>
						<select class="form-select-custom w-100" @bind="_partnerForm.MaritalStatus">
							@foreach (var ms in Enum.GetValues<MaritalStatus>())
							{
								<option value="@ms">@ms</option>
							}
						</select>
					</div>
					<div class="col-md-3">
						<label class="custom-label">Date Of Birth</label>
						<input type="date" class="custom-input" @bind="_partnerForm.DOB" @bind:format="yyyy-MM-dd" />
					</div>
					<div class="col-md-3">
						<label class="custom-label">Phone Number</label>
                        <input type="tel"
                               inputmode="numeric"
                               pattern="[0-9]*"
                               class="custom-input"
                               placeholder="10-digit mobile number"
                               @bind="_partnerForm.PhoneNumber"
                               @bind:after="SanitizePhoneNumber"
                               maxlength="10"
                               oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
                    </div>
                    <div class="col-md-6">
                        <label class="custom-label">Email</label>
                        <input type="email" class="custom-input" placeholder="email@example.com" @bind="_partnerForm.Email" />
                    </div>
                </div>
                <div class="row g-3">
                    @* <div class="col-md-6">
                        <label class="custom-label">Aadhaar Card Number</label>
                        <div class="upload-input-group">
                            <input type="text" class="custom-input" placeholder="XXXX XXXX XXXX" @bind="_partnerForm.AadhaarNumber" />
                            <label class="btn-upload-attach mb-0">
                                <i class="bi bi-upload"></i> @(_aadhaarFile != null ? _aadhaarFile.Name : "Upload Aadhaar")
                                <InputFile hidden OnChange="OnAadhaarSelected" accept=".pdf" />
                            </label>
                        </div>
                    </div> *@ 
					@if (_selectedEntityType != EntityType.soleProprietor)
					{
						<div class="col-md-6">
							<label class="custom-label">Aadhaar Card Number</label>
							<div class="upload-input-group">
								<input type="text"
									   class="custom-input"
									   placeholder="XXXX XXXX XXXX"
									   @bind="_partnerForm.AadhaarNumber"
									   maxlength="12"
									   oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
								<label class="btn-upload-attach mb-0">
									<i class="bi bi-upload"></i> @(_aadhaarFile != null ? _aadhaarFile.Name : "Upload Aadhaar")
									<InputFile hidden OnChange="OnAadhaarSelected" accept=".pdf" />
								</label>
							</div>
						</div>
						<div class="col-md-6">
							<label class="custom-label">PAN number</label>
							<div class="upload-input-group">
								<input type="text" class="custom-input" placeholder="ABCDE1234F" @bind="_partnerForm.PANNumber" />
								<label class="btn-upload-attach mb-0">
									<i class="bi bi-upload"></i> @(_panFile != null ? _panFile.Name : "Upload Pan PDF")
									<InputFile hidden OnChange="OnPanSelected" accept=".pdf" />
								</label>
							</div>
						</div>
					}
                </div>
            </div>
            <div class="col-md-3">
                <label class="image-upload-box mb-0" style="cursor:pointer; display:flex; flex-direction:column; align-items:center; width:100%;">
                    <i class="bi bi-image"></i>
                    <span class="btn-upload-attach">
                        @(_imageFile != null ? _imageFile.Name : "Upload Proprietor / Managing Partner Image")
                    </span>
                    <InputFile hidden OnChange="OnImageSelected" accept=".jpg,.jpeg,.png,.webp" />
                </label>
            </div>
        </div>
    </div>

    <!-- Address Details -->
    <div class="main-section">
        <div class="section-header mb-3">
            <h3 class="section-title">
                <i class="bi bi-geo-alt"></i>
                Residential Address Details
            </h3>
        </div>
        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <label class="custom-label">Shop No / Room No / Block No</label>
                <input type="text" class="custom-input" placeholder="Enter Shop/Room/Block No" @bind="_partnerForm.ShopNoORRoomNoOrBlockNo" />
            </div>
            <div class="col-md-4">
                <label class="custom-label">Street</label>
                <input type="text" class="custom-input" placeholder="Enter Street" @bind="_partnerForm.Street" />
            </div>
            <div class="col-md-4">
                <label class="custom-label">Sub Village</label>
                <input type="text" class="custom-input" placeholder="Enter Sub Village" @bind="_partnerForm.SubVillage" />
            </div>
        </div>
        <div class="row g-3 mb-3">
           
           <div class="col-md-4">
    <label class="custom-label">Pin Code</label>
    <input type="text" class="custom-input"
           placeholder="Enter Pin Code"
           @bind="_partnerForm.PinCode"
           @bind:event="oninput"
           @bind:after="OnPincodeChanged"
           maxlength="6"
           inputmode="numeric" />
    @if (_isPincodeLookup)
    {
        <div class="small text-muted mt-1"><i class="bi bi-arrow-repeat spin"></i> Looking up pincode...</div>
    }
    @if (!string.IsNullOrEmpty(_pincodeMessage))
    {
        <div class="small @(_pincodeSuccess ? "text-success" : "text-warning") mt-1">@_pincodeMessage</div>
    }
</div>
				<div class="col-md-4">
					<label class="custom-label">Village</label>
					<input type="text" class="custom-input" placeholder="Enter Village" @bind="_partnerForm.Village" />
				</div>
            <div class="col-md-4">
                <label class="custom-label">Block</label>
                <input type="text" class="custom-input" placeholder="Enter Block" @bind="_partnerForm.Block" />
            </div>
        </div>
        <div class="row g-3">
            <div class="col-md-4">
                <label class="custom-label">Taluk</label>
                <input type="text" class="custom-input" placeholder="Enter Taluk" @bind="_partnerForm.Taluk" />
            </div>
            <div class="col-md-4">
                <label class="custom-label">District</label>
                <select class="form-select-custom w-100" @bind="_partnerForm.DistrictId">
                    <option value="0">Select District</option>
                    @foreach (var d in _districtsAll.Where(d => d.StateId == _partnerForm.StateId))
                    {
                        <option value="@d.Id">@d.DistrictName</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="custom-label">State</label>
                <select class="form-select-custom w-100" @bind="_partnerForm.StateId">
                    <option value="0">Select State</option>
                    @foreach (var s in _statesAll)
                    {
                        <option value="@s.Id">@s.StateName</option>
                    }
                </select>
            </div>

		</div>
	</div>

	<div class="main-section">
		<div class="section-header">
			<h3 class="section-title"><i class="bi bi-people"></i> Family Members</h3>
			<button class="btn-outline-select" type="button">Add Family Members <i class="bi bi-chevron-down"></i></button>
		</div>

		<div class="row g-3 mb-3">
			<div class="col-md-4">
				<label class="custom-label">Family Member Name</label>
				<input type="text" class="custom-input" placeholder="Enter Name" @bind="_familyForm.FamilyMemberName" />
			</div>
			<div class="col-md-4">
				<label class="custom-label">D.O.B</label>
				<input type="date" class="custom-input" @bind="_familyForm.DateOfBirth" @bind:after="CalculateFamilyAge" />
			</div>
			<div class="col-md-4">
				<label class="custom-label">Age</label>
				<input type="number" class="custom-input" placeholder="Age" value="@_familyForm.Age" readonly />
			</div>
		</div>
		<div class="row g-3 mb-3">
			<div class="col-md-6">
				<label class="custom-label">Relationship</label>
				<select class="form-select-custom w-100" @bind="_familyForm.RelationshipId">
					<option value="0">Select Relationship</option>
					@foreach (var rel in _relationships)
					{
						<option value="@rel.Id">@rel.Name</option>
					}
				</select>
			</div>
			<div class="col-md-6">
				<label class="custom-label">Occupation</label>
				<input type="text" class="custom-input" placeholder="Enter Occupation" @bind="_familyForm.Occupation" />
			</div>
		</div>
		<div class="d-flex justify-content-end mt-2">
			<button class="btn-blue-action-Proprietor" type="button" @onclick="AddOrUpdateFamily">
				@(_editingFamilyIndex >= 0 ? "Update Family" : "Add Details")
			</button>
			@if (_editingFamilyIndex >= 0)
			{
				<button class="btn btn-outline-secondary ms-2 rounded-pill px-4" type="button" @onclick="CancelFamilyEdit">Cancel</button>
			}
		</div>
	</div>

	@if (_currentFamilyList.Count > 0)
	{
		<div class="main-section">
			<div class="section-header">
				<h3 class="section-title">
					<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/FamilyIcon.svg" class="formicon" style="width: 24px; margin-right: 8px;" />
					Added Family Details
				</h3>
				<span class="count-badge fs-5">@_currentFamilyList.Count</span>
			</div>

			<div class="row g-3">
				@for (int i = 0; i < _currentFamilyList.Count; i++)
				{
					var idx = i;
					var fm = _currentFamilyList[idx];
					<div class="col-md-4">
						<div class="added-card theme-blue">
							<div class="card-header-flex">
								<div class="card-title-group">
									<div class="icon-box">
										<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/FamilyIcon.svg" style="width: 24px;" />
									</div>
									<div>
										<div class="card-label">Family Member</div>
										<h4 class="card-value-main">@fm.FamilyMemberName</h4>
									</div>
								</div>
								<div class="card-actions">
									<i class="bi bi-pencil-square icon-edit" style="cursor:pointer" @onclick="() => EditFamily(idx)"></i>
									<i class="bi bi-trash icon-delete" style="cursor:pointer" @onclick="() => RemoveFamily(idx)"></i>
								</div>
							</div>
							<div class="detail-grid">
								<div class="detail-item">
									<span class="lbl">D.O.B</span>
									<span class="val">@fm.DateOfBirth.ToString("dd/M/yyyy")</span>
								</div>
								<div class="detail-item">
									<span class="lbl">Age</span>
									<span class="val">@fm.Age</span>
								</div>
								<div class="detail-item">
									<span class="lbl">Relationship</span>
									<span class="val">@GetRelationshipName(fm.RelationshipId)</span>
								</div>
								<div class="detail-item">
									<span class="lbl">Occupation</span>
									<span class="val">@fm.Occupation</span>
								</div>
							</div>
						</div>
					</div>
				}
			</div>
		</div>
	}

	<div class="main-section">
		<div class="section-header">
			<h3 class="section-title"><i class="bi bi-briefcase"></i> Other Occupation / Agencies</h3>
			<button class="btn-outline-select" type="button">Add Occupation Details <i class="bi bi-chevron-down"></i></button>
		</div>

		<div class="row g-3 align-items-end mb-3">
			<div class="col-md-3">
				<label class="custom-label">Do you have other occupation or agencies?</label>
				<div class="toggle-group">
					<button class="toggle-btn @(_hasOtherOccupation ? "active" : "")" type="button" @onclick="() => _hasOtherOccupation = true">Yes</button>
					<button class="toggle-btn @(!_hasOtherOccupation ? "active" : "")" type="button" @onclick="() => { _hasOtherOccupation = false; _currentOccupationList.Clear(); }">No</button>
				</div>
			</div>
			@if (_hasOtherOccupation)
			{
				<div class="col-md-3">
					<label class="custom-label">Name of Company</label>
					<input type="text" class="custom-input" placeholder="Company Name" @bind="_occupationForm.NameofCompany" />
				</div>
				<div class="col-md-3">
					<label class="custom-label">Sector</label>
					<select class="form-select-custom w-100" @bind="_occupationForm.SectorId">
						<option value="0">Select sector</option>
						@foreach (var sector in _sectors)
						{
							<option value="@sector.Id">@sector.Name</option>
						}
					</select>
				</div>
				<div class="col-md-3">
					<label class="custom-label">Amount(₹) Lakhs</label>
					<input type="number" class="custom-input" placeholder="Amount ₹" @bind="_occupationForm.AnnualTurnover" />
				</div>
			}
		</div>
		@if (_hasOtherOccupation)
		{
			<div class="d-flex justify-content-end mt-2">
				<button class="btn-blue-action-Proprietor" type="button" @onclick="AddOrUpdateOccupation">
					@(_editingOccupationIndex >= 0 ? "Update Occupation" : "Add Details")
				</button>
				@if (_editingOccupationIndex >= 0)
				{
					<button class="btn btn-outline-secondary ms-2 rounded-pill px-4" type="button" @onclick="CancelOccupationEdit">Cancel</button>
				}
			</div>
		}
	</div>

	@if (_currentOccupationList.Count > 0)
	{
		<div class="main-section">
			<div class="section-header">
				<h3 class="section-title">
					<i class="bi bi-buildings" style="color: #059669; margin-right: 8px;"></i>
					Added Other Occupation / Agencies List
				</h3>
				<span class="count-badge fs-5">@_currentOccupationList.Count</span>
			</div>

			<div class="row g-3 mb-4">
				@for (int i = 0; i < _currentOccupationList.Count; i++)
				{
					var idx = i;
					var occ = _currentOccupationList[idx];
					<div class="col-md-4">
						<div class="added-card theme-green">
							<div class="card-header-flex">
								<div class="card-title-group">
									<div class="icon-box">
										<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/businessIcon1.svg" style="width: 24px;" />
									</div>
									<div>
										<div class="card-label">Company</div>
										<div class="card-value-main" style="text-transform: none;">@occ.NameofCompany</div>
									</div>
								</div>
								<div class="card-actions">
									<i class="bi bi-pencil-square icon-edit" style="cursor:pointer" @onclick="() => EditOccupation(idx)"></i>
									<i class="bi bi-trash icon-delete" style="cursor:pointer" @onclick="() => RemoveOccupation(idx)"></i>
								</div>
							</div>
							<div class="detail-grid">
								<div class="detail-item">
									<span class="lbl">Sector</span>
									<span class="val">@GetSectorName(occ.SectorId)</span>
								</div>
								<div class="detail-item">
									<span class="lbl">Annual Turnover (₹)</span>
									<span class="val">₹ @occ.AnnualTurnover</span>
								</div>
							</div>
						</div>
					</div>
				}
			</div>
		</div>
	}

	<div class="main-section">
		<div class="d-flex justify-content-end pt-2">
			<button class="btn-blue-action-Proprietor" type="button" @onclick="SavePartnerDetails" disabled="@_isSavingPartner">
				@if (_isSavingPartner)
				{
					<span class="spinner-border spinner-border-sm me-1"></span>
				}
				@(_isEditingPartner ? "Update Partner Details" : "Save Details")
			</button>
			@if (_isEditingPartner)
			{
				<button class="btn btn-outline-secondary ms-2 rounded-pill px-4" type="button" @onclick="CancelPartnerEdit">Cancel</button>
			}
		</div>
	</div>
	}
	else
	{
		<div class="alert alert-info" role="alert">
			<i class="bi bi-info-circle me-2"></i>Sole Proprietor allows only 1 proprietor. You can edit or delete the existing one from the saved details below.
		</div>
	}

	@if (_savedPartners.Count > 0)
	{
		<div class="main-section">
			<div class="section-header mb-3 px-2">
				<h3 class="section-title">
					<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/FamilyIcon.svg" style="width: 24px;" />
					Saved Details
				</h3>
				<span class="count-badge">@_savedPartners.Count</span>
			</div>

			<div class="row g-3">
				@foreach (var partner in _savedPartners)
				{
					var p = partner;
					var familyCount = _savedFamilyMap.ContainsKey(p.Id) ? _savedFamilyMap[p.Id].Count : 0;
					var occCount = _savedOccupationMap.ContainsKey(p.Id) ? _savedOccupationMap[p.Id].Count : 0;
					<div class="col-md-4">
						<div class="saved-card">
							<div class="saved-card-header">
								<div class="d-flex gap-3 align-items-center">
									<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/Greencompany.svg" style="width: 24px;" />
									<div>
										<div class="saved-name">@p.Name</div>
										<div class="saved-phone">@p.PhoneNumber</div>
									</div>
								</div>
								<div class="saved-actions">
									<a href="javascript:void(0);" title="View Details" @onclick="() => OpenPopup(p.Id)">
										<i class="bi bi-eye icon-view"></i>
									</a>
									<i class="bi bi-pencil-square icon-edit" style="cursor:pointer" @onclick="() => EditPartner(p)"></i>
									<i class="bi bi-trash icon-delete" style="cursor:pointer" @onclick="() => ConfirmDeletePartner(p)"></i>
								</div>
							</div>
							<div class="saved-stats">
								<div class="stat-pill blue">Family @familyCount</div>
								<div class="stat-pill green">Occupation @occCount</div>
							</div>
						</div>
					</div>
				}
			</div>
		</div>
	}

	</fieldset>
	<CommanFooter OnNextClick="HandleNext" IsNextDisabled="@_isSaving" />
</div>

@if (_showDeleteConfirm)
{
	<div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.45)">
		<div class="modal-dialog modal-dialog-centered">
			<div class="modal-content border-0 shadow-lg rounded-4">
				<div class="modal-body text-center py-5 px-4">
					<div class="mb-3">
						<i class="bi bi-exclamation-triangle-fill text-danger" style="font-size:2.5rem"></i>
					</div>
					<h5 class="fw-bold mb-2">Delete Partner</h5>
					<p class="text-muted mb-4">
						Are you sure you want to delete <strong>@_partnerToDelete?.Name</strong>?
						This will also remove all family members and occupations associated with this partner.
					</p>
					<div class="d-flex justify-content-center gap-3">
						<button class="btn btn-outline-secondary rounded-pill px-4" @onclick="CancelDeletePartner" disabled="@_isDeleting">Cancel</button>
						<button class="btn btn-danger rounded-pill px-4" @onclick="ExecuteDeletePartner" disabled="@_isDeleting">
							@if (_isDeleting)
							{
								<span class="spinner-border spinner-border-sm me-1"></span>
							}
							Delete
						</button>
					</div>
				</div>
			</div>
		</div>
	</div>
}

