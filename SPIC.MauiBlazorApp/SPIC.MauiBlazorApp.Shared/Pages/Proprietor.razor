        .image-upload-box:hover { background-color: #ECFDF5; border-color: #10B981; }

        /* --- Yes/No Toggles --- */
        .toggle-group { display: flex; gap: 8px; }
        .toggle-btn {
            background-color: #F3F4F6;
            color: #4B5563;
            border: none;
            padding: 8px 24px;
