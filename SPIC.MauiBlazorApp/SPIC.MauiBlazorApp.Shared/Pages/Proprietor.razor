	private void OpenPopup(int partnerId)
	{
		_viewPartner = _savedPartners.FirstOrDefault(p => p.Id == partnerId);
		_showPopup = _viewPartner != null;
	}

	private void ClosePopup()
	{
		_showPopup = false;
