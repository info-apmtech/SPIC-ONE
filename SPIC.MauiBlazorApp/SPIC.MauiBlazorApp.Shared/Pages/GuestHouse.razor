@page "/GuestHouse"

<div class="container-fluid py-4 px-0">
    <div class="gh-wrapper">
        
        <div class="gh-header-text">
            <h1>Choose Your Guest House</h1>
            <p>Select a location for your comfortable stay</p>
        </div>

        <div class="gh-cards-grid">
            
            <div class="gh-card">
                <div class="gh-card-img-wrap">
                    <img src="_content/SPIC.MauiBlazorApp.Shared/Images/Gallery/image20.png" alt="T-Nagar Guest House" onerror="this.style.backgroundColor='#e2e8f0';" />
                </div>
                <div class="gh-card-content">
                    <h2 class="gh-card-title">T-Nagar Guest House</h2>
                    
                    <div class="gh-info-list">
                        <div class="gh-info-item">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                <circle cx="12" cy="10" r="3"></circle>
                            </svg>
                            <span>123 Anna Salai, T-Nagar, Chennai - 600017</span>
                        </div>
                        
                        <div class="gh-info-item">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                            </svg>
                            <span>+91 44 2434 5678</span>
                        </div>
                    </div>

                    <button class="gh-btn-select">Select T-Nagar</button>
                </div>
            </div>

            <div class="gh-card">
                <div class="gh-card-img-wrap">
                    <img src="_content/SPIC.MauiBlazorApp.Shared/Images/Gallery/image21.png" alt="Tirupathi Guest House" onerror="this.style.backgroundColor='#e2e8f0';" />
                </div>
                <div class="gh-card-content">
                    <h2 class="gh-card-title">Tirupathi Guest House</h2>
                    
                    <div class="gh-info-list">
                        <div class="gh-info-item">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                <circle cx="12" cy="10" r="3"></circle>
                            </svg>
                            <span>456 Temple Street, Tirupathi - 517501</span>
                        </div>
                        
                        <div class="gh-info-item">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                            </svg>
                            <span>+91 877 2250 123</span>
                        </div>
                    </div>

                    <button class="gh-btn-select">Select Tirupathi</button>
                </div>
            </div>

        </div>
    </div>
</div>