@page "/GuestHouse"
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation

<div class="container-fluid py-4 px-0">
    <div class="gh-wrapper">
        
        <div class="gh-header-text">
            <h1>Choose Your Guest House</h1>
            <p>Select a location for your comfortable stay</p>
        </div>

        <div class="gh-cards-grid">
            
            @foreach (var (house, index) in _houses.Select((h, i) => (h, i)))
            {
                <div class="gh-card">
                    <div class="gh-card-img-wrap">
                        <img src="@CardImages[index % CardImages.Length]" alt="@house.Name" onerror="this.style.backgroundColor='#e2e8f0';" />
                    </div>
                    <div class="gh-card-content">
                        <h2 class="gh-card-title">@house.Name</h2>
                        
                        <div class="gh-info-list">
                            <div class="gh-info-item">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                    <circle cx="12" cy="10" r="3"></circle>
                                </svg>
                                <span>@house.Address</span>
                            </div>
                            
                            <div class="gh-info-item">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                                </svg>
                                <span>@house.PhoneNumber</span>
                            </div>
                        </div>

                        <button class="gh-btn-select" @onclick="() => SelectHouse(house)">Select @house.Name</button>
                    </div>
                </div>
            }

        </div>
    </div>
</div>

@code {
    private List<GuestHouseDto> _houses = new();

    private static readonly string[] CardImages =
    [
        "_content/SPIC.MauiBlazorApp.Shared/Images/Gallery/image20.png",
        "_content/SPIC.MauiBlazorApp.Shared/Images/Gallery/image21.png"
    ];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var houses = await Http.GetFromJsonAsync<List<GuestHouseDto>>("api/GuestHouseBooking/houses") ?? new();
            _houses = houses.Where(h => h.IsActive).ToList();
        }
        catch
        {
            _houses = new();
        }
    }

    private void SelectHouse(GuestHouseDto house)
    {
        Navigation.NavigateTo($"/GuestHouseBooking?guestHouseId={house.Id}&name={Uri.EscapeDataString(house.Name)}");
    }

    public class GuestHouseDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string? Address { get; set; }
        public string? PhoneNumber { get; set; }
        public bool IsActive { get; set; }
    }
}