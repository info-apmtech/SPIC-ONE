@page "/CancelBooking"

<div class="container-fluid py-4 px-0">
@*     <div class="cb-wrapper">
 *@
        <div class="cb-header-row">
            <div class="cb-header-text">
                <h1>Cancel Booking</h1>
                <p>Please review your cancellation details carefully before proceeding</p>
            </div>
            <button class="cb-btn-outline">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="12" y1="18" x2="12" y2="12"></line>
                    <polyline points="9 15 12 18 15 15"></polyline>
                </svg>
                Download Invoice
            </button>
        </div>

        <div class="cb-card cb-booking-summary-card">
            <img src="https://images.unsplash.com/photo-1611892440504-42a792e24d32?auto=format&fit=crop&w=300&q=80" alt="Room" class="cb-summary-img">
            <div class="cb-summary-content">
                <div class="cb-summary-title-row">
                    <div>
                        <h2>AC Deluxe Room — SPIC Guest House</h2>
                        <span class="cb-booking-id">Booking ID: BK7A3K9XY</span>
                    </div>
                    <div class="cb-badge cb-badge-green">Confirmed</div>
                </div>

                <div class="cb-form-grid" style="margin-top: 16px;">
                    <div class="cb-form-group">
                        <label class="cb-form-label">Check-in</label>
                        <div class="cb-read-value">May 26, 2026</div>
                    </div>
                    <div class="cb-form-group">
                        <label class="cb-form-label">Check-out</label>
                        <div class="cb-read-value">May 29, 2026</div>
                    </div>
                    <div class="cb-form-group">
                        <label class="cb-form-label">Total Amount</label>
                        <div class="cb-read-value" style="color: #2563EB;">₹3367.00</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="cb-info-box cb-info-warning" style="margin-bottom: 24px;">
            <div class="cb-info-title">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                    <line x1="12" y1="9" x2="12" y2="13"></line>
                    <line x1="12" y1="17" x2="12.01" y2="17"></line>
                </svg>
                Important Notice
            </div>
            <p class="cb-info-text">Cancelling this booking may affect your refund based on the cancellation policy. Since check-in is more than 48 hours away, you qualify for a full refund minus processing charges.</p>
        </div>

        <div class="row g-4">
            <div class="col-lg-6">
                
                <div class="cb-card">
                    <h3 class="cb-card-title">Cancellation Reason</h3>
                    <div class="cb-form-group">
                        <label class="cb-form-label">Select reason for cancellation</label>
                        <select class="cb-form-control">
                            <option value="" disabled selected>Choose a reason</option>
                            <option value="change_plan">Change in travel plans</option>
                            <option value="health">Health / Medical reasons</option>
                            <option value="found_other">Found better accommodation</option>
                            <option value="other">Other</option>
                        </select>
                    </div>
                </div>

                <div class="cb-card">
                    <h3 class="cb-card-title">Refund Calculation</h3>
                    
                    <div class="cb-kv-row">
                        <span class="cb-kv-lbl">Total Paid</span>
                        <span class="cb-kv-val">₹3367</span>
                    </div>
                    <div class="cb-kv-row">
                        <span class="cb-kv-lbl">Cancellation Charges (5%)</span>
                        <span class="cb-kv-val" style="color: #DC2626;">−₹630</span>
                    </div>
                    <div class="cb-kv-row" style="margin-bottom: 0;">
                        <span class="cb-kv-lbl">Tax Adjustment (GST)</span>
                        <span class="cb-kv-val" style="color: #DC2626;">−₹130</span>
                    </div>

                    <hr class="cb-divider">

                    <div class="cb-kv-row" style="margin-bottom: 20px;">
                        <span class="cb-kv-lbl" style="font-size: 15px; font-weight: 700; color: #1F2937;">Refund Amount</span>
                        <span class="cb-kv-val" style="font-size: 18px; color: #2563EB;">₹2967.00</span>
                    </div>

                    <div class="cb-method-grid">
                        <div class="cb-method-box">
                            <span class="cb-method-lbl">Refund Method</span>
                            <span class="cb-method-val">Original Payment Method</span>
                        </div>
                        <div class="cb-method-box">
                            <span class="cb-method-lbl">Estimated Time</span>
                            <span class="cb-method-val">5–7 Business Days</span>
                        </div>
                    </div>

                    <div class="cb-info-box cb-info-warning mt-3" style="padding: 12px 16px;">
                        <p class="cb-info-text m-0" style="font-size: 12px;">Refund will be credited to your original payment method automatically once the cancellation is processed.</p>
                    </div>
                </div>

            </div>

            <div class="col-lg-6">
                
                <div class="cb-card">
                    <h3 class="cb-card-title">Guest Information</h3>
                    <div class="cb-kv-row">
                        <span class="cb-kv-lbl">Employee ID / Dealer Code</span>
                        <span class="cb-kv-val">DL-1234</span>
                    </div>
                    <div class="cb-kv-row">
                        <span class="cb-kv-lbl">Guest Name</span>
                        <span class="cb-kv-val">Rajesh</span>
                    </div>
                    <div class="cb-kv-row">
                        <span class="cb-kv-lbl">Company Name</span>
                        <span class="cb-kv-val">SPIC Pvt. ltd.,</span>
                    </div>
                    <div class="cb-kv-row">
                        <span class="cb-kv-lbl">Phone Number</span>
                        <span class="cb-kv-val">9876543210</span>
                    </div>
                    <div class="cb-kv-row">
                        <span class="cb-kv-lbl">Email ID</span>
                        <span class="cb-kv-val">hi@gmail.com</span>
                    </div>
                    <div class="cb-kv-row">
                        <span class="cb-kv-lbl">Number of Persons</span>
                        <span class="cb-kv-val">2 persons</span>
                    </div>
                    <div class="cb-kv-row">
                        <span class="cb-kv-lbl">Nationality</span>
                        <span class="cb-kv-val">Indian</span>
                    </div>
                    <div class="cb-kv-row">
                        <span class="cb-kv-lbl">Aadhaar / Passport Number</span>
                        <span class="cb-kv-val">[Aadhaar/Passport Redacted]</span>
                    </div>
                    <div class="cb-kv-row" style="margin-bottom: 0;">
                        <span class="cb-kv-lbl">Address</span>
                        <span class="cb-kv-val" style="text-align: right;">No.5, SPIC House, Guindy,<br/>Chennai-600022.</span>
                    </div>
                </div>

                <div class="cb-info-box cb-info-primary">
                    <div class="cb-info-title">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="16" x2="12" y2="12"></line>
                            <line x1="12" y1="8" x2="12.01" y2="8"></line>
                        </svg>
                        Cancellation Policy
                    </div>
                    <ul class="cb-info-list">
                        <li>Free cancellation up to 24 hours before check-in</li>
                        <li>50% refund for cancellations within 24-48 hours</li>
                        <li>No refund for cancellations within 24 hours of check-in</li>
                    </ul>
                </div>

            </div>
        </div>

        <div class="cb-bottom-actions">
            <button class="cb-btn-outline" style="padding: 10px 24px;">Back</button>
            <button class="cb-btn-danger" @onclick="OpenConfirmPopup">Continue Cancellation</button>
        </div>

@*     </div>
 *@</div>

@if (showConfirmPopup)
{
    <div class="cb-modal-overlay">
        <div class="cb-modal-container">
            <div class="cb-modal-icon-wrapper confirm">
                <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="#F59E0B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
            </div>
            
            <h2 class="cb-modal-title red">Confirm Cancellation?</h2>
            <p class="cb-modal-subtitle">Are you sure you want to cancel this booking? This action cannot be undone and your stay will be released.</p>

            <div class="cb-modal-data-box">
                <div class="cb-m-row">
                    <span class="cb-m-lbl">Booking ID</span>
                    <span class="cb-m-val">BK7A3K9XY</span>
                </div>
                <div class="cb-m-row">
                    <span class="cb-m-lbl">Room Type</span>
                    <span class="cb-m-val">AC Deluxe Room</span>
                </div>
                <div class="cb-m-row">
                    <span class="cb-m-lbl">Cancellation Charge</span>
                    <span class="cb-m-val red">−₹630</span>
                </div>
                <div class="cb-m-row">
                    <span class="cb-m-lbl">Refund Amount</span>
                    <span class="cb-m-val green">₹2967.00</span>
                </div>
            </div>

            <div class="cb-modal-actions">
                <button class="cb-btn-outline" @onclick="CloseConfirmPopup" style="flex: 1;">Keep My Booking</button>
                <button class="cb-btn-danger" @onclick="ConfirmAndCancelBooking" style="flex: 1;">Cancel Booking</button>
            </div>
        </div>
    </div>
}

@if (showSuccessPopup)
{
    <div class="cb-modal-overlay">
        <div class="cb-modal-container">
            <div class="cb-modal-icon-wrapper success">
                <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
            </div>
            
            <h2 class="cb-modal-title green">Booking Cancelled Successfully</h2>
            <p class="cb-modal-subtitle">Your cancellation request has been completed. Refund will be processed within 5–7 business days to your original payment method.</p>

            <div class="cb-modal-data-box">
                <div class="cb-m-row">
                    <span class="cb-m-lbl">Cancellation ID</span>
                    <span class="cb-m-val">CAN-2025-0089</span>
                </div>
                <div class="cb-m-row">
                    <span class="cb-m-lbl">Refund Amount</span>
                    <span class="cb-m-val green">₹2967.00</span>
                </div>
                <div class="cb-m-row">
                    <span class="cb-m-lbl">Refund Status</span>
                    <span class="cb-badge cb-badge-blue" style="padding: 4px 10px; font-size: 11px;">Processing</span>
                </div>
            </div>

            <div class="cb-info-box cb-info-primary" style="margin-bottom: 24px; text-align: left; padding: 12px 16px;">
                <p class="cb-info-text m-0" style="font-size: 12px;">Cancellation confirmation and refund details have been sent to <strong>hi@gmail.com</strong></p>
            </div>

            <div class="cb-modal-actions" style="flex-wrap: wrap;">
                <button class="cb-btn-outline" style="flex: 1 1 calc(50% - 6px);">Download Receipt</button>
                <button class="cb-btn-outline" style="flex: 1 1 calc(50% - 6px);">View Booking</button>
                <button class="cb-btn-primary" @onclick="CloseSuccessPopup" style="flex: 1 1 100%;">Go to My Bookings</button>
            </div>
        </div>
    </div>
}

@code {
    private bool showConfirmPopup = false;
    private bool showSuccessPopup = false;

    private void OpenConfirmPopup()
    {
        showConfirmPopup = true;
    }

    private void CloseConfirmPopup()
    {
        showConfirmPopup = false;
    }

    private void ConfirmAndCancelBooking()
    {
        showConfirmPopup = false;
        showSuccessPopup = true;
    }

    private void CloseSuccessPopup()
    {
        showSuccessPopup = false;
    }
}

