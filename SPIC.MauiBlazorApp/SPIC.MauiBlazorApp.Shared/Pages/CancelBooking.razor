@page "/CancelBooking"
@using System.Globalization
@inject HttpClient Http
@inject LoginState LoginState
@inject NavigationManager Navigation
@inject ToastService Toast

<div class="container-fluid py-4 px-0">
@*     <div class="cb-wrapper">
 *@
        <div class="cb-header-row">
            <PageHeader Title="Cancel Booking" Subtitle="Please review your cancellation details carefully before proceeding" BackHref="/MyBookings" CssClass="w-100">
                <Actions>
                    <button class="cb-btn-outline">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="12" y1="18" x2="12" y2="12"></line>
                            <polyline points="9 15 12 18 15 15"></polyline>
                        </svg>
                        Download Invoice
                    </button>
                </Actions>
            </PageHeader>
        </div>

    @if (_isLoading)
    {
        <Skeleton Variant="table" Rows="6" LoadingText="Loading cancellation details" />
    }
    else if (_preview == null)
    {
        <EmptyState Icon="bi-exclamation-circle" Title="Cannot cancel this booking" Message="@(_loadError ?? "We could not load the cancellation details.")">
            <button class="cb-btn-outline" @onclick="GoBack">Back to My Bookings</button>
        </EmptyState>
    }
    else
    {
        <div class="cb-card cb-booking-summary-card">
            <img src="@GetImageUrl(_preview.RoomImagePath)" alt="Room" class="cb-summary-img" loading="lazy">
            <div class="cb-summary-content">
                <div class="cb-summary-title-row">
                    <div>
                        <h2>@_preview.RoomType — @_preview.GuestHouseName</h2>
                        <span class="cb-booking-id">Booking ID: @_preview.BookingReference</span>
                    </div>
                    <div class="cb-badge cb-badge-green">@_preview.BookingStatus</div>
                </div>

                <div class="cb-form-grid" style="margin-top: 16px;">
                    <div class="cb-form-group">
                        <label class="cb-form-label">Check-in</label>
                        <div class="cb-read-value">@FormatDate(_preview.CheckInDate)</div>
                    </div>
                    <div class="cb-form-group">
                        <label class="cb-form-label">Check-out</label>
                        <div class="cb-read-value">@FormatDate(_preview.CheckOutDate)</div>
                    </div>
                    <div class="cb-form-group">
                        <label class="cb-form-label">Total Amount</label>
                        <div class="cb-read-value" style="color: #2563EB;">@Money(_preview.TotalAmount)</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="cb-info-box cb-info-warning" style="margin-bottom: 24px;">
            <div class="cb-info-title">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                    <line x1="12" y1="9" x2="12" y2="13"></line>
                    <line x1="12" y1="17" x2="12.01" y2="17"></line>
                </svg>
                Important Notice
            </div>
            @if (_preview.AlreadyRequested)
            {
                <p class="cb-info-text">A cancellation request for this booking has already been submitted (status: @ApprovalLabel(_preview.ExistingApprovalStatus)). You can track it from Refund Status.</p>
            }
            else
            {
                <p class="cb-info-text">Cancelling this booking may affect your refund based on the cancellation policy. Based on the time left before check-in, you qualify for a @Percent(_preview.RefundPercent) refund. Your request will be reviewed by the Admin before the booking is cancelled and the refund is processed.</p>
            }
        </div>

        <div class="row g-4">
            <div class="col-lg-6">

                <div class="cb-card">
                    <h3 class="cb-card-title">Cancellation Reason</h3>
                    <div class="cb-form-group">
                        <label class="cb-form-label">Select reason for cancellation</label>
                        <select class="cb-form-control" @bind="_selectedReason" disabled="@_preview.AlreadyRequested">
                            <option value="" disabled selected>Choose a reason</option>
                            @foreach (var reason in _preview.CancellationReasons)
                            {
                                <option value="@reason">@reason</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="cb-card">
                    <h3 class="cb-card-title">Refund Calculation</h3>

                    <div class="cb-kv-row">
                        <span class="cb-kv-lbl">Total Paid</span>
                        <span class="cb-kv-val">@Money(_preview.TotalAmount)</span>
                    </div>
                    <div class="cb-kv-row">
                        <span class="cb-kv-lbl">Cancellation Charges (@Percent(_preview.CancellationChargePercent))</span>
                        <span class="cb-kv-val" style="color: #DC2626;">−@Money(_preview.CancellationCharge)</span>
                    </div>
                    <div class="cb-kv-row" style="margin-bottom: 0;">
                        <span class="cb-kv-lbl">Tax Adjustment (GST)</span>
                        <span class="cb-kv-val" style="color: #DC2626;">−@Money(_preview.TaxAdjustment)</span>
                    </div>

                    <hr class="cb-divider">

                    <div class="cb-kv-row" style="margin-bottom: 20px;">
                        <span class="cb-kv-lbl" style="font-size: 15px; font-weight: 700; color: #1F2937;">Refund Amount</span>
                        <span class="cb-kv-val" style="font-size: 18px; color: #2563EB;">@Money(_preview.RefundAmount)</span>
                    </div>

                    <div class="cb-method-grid">
                        <div class="cb-method-box">
                            <span class="cb-method-lbl">Refund Method</span>
                            <span class="cb-method-val">@_preview.RefundMethod</span>
                        </div>
                        <div class="cb-method-box">
                            <span class="cb-method-lbl">Estimated Time</span>
                            <span class="cb-method-val">@_preview.EstimatedRefundWindow</span>
                        </div>
                    </div>

                    <div class="cb-info-box cb-info-warning mt-3" style="padding: 12px 16px;">
                        <p class="cb-info-text m-0" style="font-size: 12px;">Refund will be credited to your original payment source within 2 working days after Admin approval.</p>
                    </div>
                </div>

            </div>

            <div class="col-lg-6">

                <div class="cb-card">
                    <h3 class="cb-card-title">Guest Information</h3>
                    <div class="cb-kv-row">
                        <span class="cb-kv-lbl">Employee ID / Dealer Code</span>
                        <span class="cb-kv-val">@Dash(_preview.EmployeeOrDealerCode)</span>
                    </div>
                    <div class="cb-kv-row">
                        <span class="cb-kv-lbl">Guest Name</span>
                        <span class="cb-kv-val">@Dash(_preview.GuestName)</span>
                    </div>
                    <div class="cb-kv-row">
                        <span class="cb-kv-lbl">Company Name</span>
                        <span class="cb-kv-val">@Dash(_preview.CompanyName)</span>
                    </div>
                    <div class="cb-kv-row">
                        <span class="cb-kv-lbl">Phone Number</span>
                        <span class="cb-kv-val">@Dash(_preview.PhoneNumber)</span>
                    </div>
                    <div class="cb-kv-row">
                        <span class="cb-kv-lbl">Email ID</span>
                        <span class="cb-kv-val">@Dash(_preview.Email)</span>
                    </div>
                    <div class="cb-kv-row">
                        <span class="cb-kv-lbl">Number of Persons</span>
                        <span class="cb-kv-val">@(_preview.NumberOfPersons.HasValue ? $"{_preview.NumberOfPersons} persons" : "-")</span>
                    </div>
                    <div class="cb-kv-row">
                        <span class="cb-kv-lbl">Nationality</span>
                        <span class="cb-kv-val">@Dash(_preview.Nationality)</span>
                    </div>
                    <div class="cb-kv-row">
                        <span class="cb-kv-lbl">Aadhaar / Passport Number</span>
                        <span class="cb-kv-val">@Dash(_preview.AadhaarOrPassportNumber)</span>
                    </div>
                    <div class="cb-kv-row" style="margin-bottom: 0;">
                        <span class="cb-kv-lbl">Address</span>
                        <span class="cb-kv-val" style="text-align: right;">@Dash(_preview.Address)</span>
                    </div>
                </div>

                <div class="cb-info-box cb-info-primary">
                    <div class="cb-info-title">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="16" x2="12" y2="12"></line>
                            <line x1="12" y1="8" x2="12.01" y2="8"></line>
                        </svg>
                        Cancellation Policy
                    </div>
                    @* NOTE: this wording does not match the seeded GuestHouseCancellationPolicy
                       (V5p: >=48h 100%, 24-48h 50%, <24h 0%). Left unchanged pending the
                       client's confirmation of the intended policy. *@
                    <ul class="cb-info-list">
                        <li>Free cancellation up to 24 hours before check-in</li>
                        <li>50% refund for cancellations within 24-48 hours</li>
                        <li>No refund for cancellations within 24 hours of check-in</li>
                    </ul>
                </div>

            </div>
        </div>

        <div class="cb-bottom-actions">
            <ActionBar AriaLabel="Cancellation actions">
                <Secondary>
                    <button class="cb-btn-outline" style="padding: 10px 24px;" @onclick="GoBack">Back</button>
                </Secondary>
                <ChildContent>
                    @if (_preview.AlreadyRequested)
                    {
                        <button class="cb-btn-danger" @onclick="GoToRefundStatus">View Refund Status</button>
                    }
                    else
                    {
                        <button class="cb-btn-danger" @onclick="OpenConfirmPopup">Continue Cancellation</button>
                    }
                </ChildContent>
            </ActionBar>
        </div>
    }

@*     </div>
 *@</div>

<BottomSheet @bind-IsOpen="showConfirmPopup" Title="Confirm Cancellation?" Subtitle="Your request will be sent to the Admin for approval. The booking stays active until it is approved." CssClass="cb-sheet">
    <ChildContent>
        <div class="cb-modal-container cb-sheet-body">
            <div class="cb-modal-icon-wrapper confirm">
                <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="#F59E0B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
            </div>

            <p class="cb-modal-subtitle">Are you sure you want to cancel this booking?</p>

            <div class="cb-modal-data-box">
                <div class="cb-m-row">
                    <span class="cb-m-lbl">Booking ID</span>
                    <span class="cb-m-val">@_preview?.BookingReference</span>
                </div>
                <div class="cb-m-row">
                    <span class="cb-m-lbl">Room Type</span>
                    <span class="cb-m-val">@_preview?.RoomType</span>
                </div>
                <div class="cb-m-row">
                    <span class="cb-m-lbl">Cancellation Charge</span>
                    <span class="cb-m-val red">−@Money((_preview?.CancellationCharge ?? 0) + (_preview?.TaxAdjustment ?? 0))</span>
                </div>
                <div class="cb-m-row">
                    <span class="cb-m-lbl">Refund Amount</span>
                    <span class="cb-m-val green">@Money(_preview?.RefundAmount ?? 0)</span>
                </div>
            </div>

        </div>
    </ChildContent>
    <Footer>
        <button class="cb-btn-outline" @onclick="CloseConfirmPopup" style="flex: 1;" disabled="@_isSubmitting">Keep My Booking</button>
        <button class="cb-btn-danger" @onclick="ConfirmAndCancelBooking" style="flex: 1;" disabled="@_isSubmitting">@(_isSubmitting ? "Submitting..." : "Cancel Booking")</button>
    </Footer>
</BottomSheet>

<BottomSheet @bind-IsOpen="showSuccessPopup" Title="Cancellation Request Submitted" CssClass="cb-sheet">
    <ChildContent>
        <div class="cb-modal-container cb-sheet-body">
            <div class="cb-modal-icon-wrapper success">
                <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
            </div>

            <p class="cb-modal-subtitle">Your cancellation request has been submitted and is awaiting Admin approval. Refund will be credited to your original payment source within 2 working days after Admin approval.</p>

            <div class="cb-modal-data-box">
                <div class="cb-m-row">
                    <span class="cb-m-lbl">Cancellation ID</span>
                    <span class="cb-m-val">@_cancellationReference</span>
                </div>
                <div class="cb-m-row">
                    <span class="cb-m-lbl">Refund Amount</span>
                    <span class="cb-m-val green">@Money(_preview?.RefundAmount ?? 0)</span>
                </div>
                <div class="cb-m-row">
                    <span class="cb-m-lbl">Request Status</span>
                    <span class="cb-badge cb-badge-blue" style="padding: 4px 10px; font-size: 11px;">@ApprovalLabel(_approvalStatus)</span>
                </div>
            </div>

            <div class="cb-info-box cb-info-primary" style="margin-bottom: 24px; text-align: left; padding: 12px 16px;">
                <p class="cb-info-text m-0" style="font-size: 12px;">You can track the approval and refund progress anytime from <strong>Refund Status</strong>.</p>
            </div>

        </div>
    </ChildContent>
    <Footer>
        <button class="cb-btn-outline" style="flex: 1 1 calc(50% - 6px);" @onclick="GoToRefundStatus">Refund Status</button>
        <button class="cb-btn-outline" style="flex: 1 1 calc(50% - 6px);" @onclick="GoToBookingDetails">View Booking</button>
        <button class="cb-btn-primary" @onclick="CloseSuccessPopup" style="flex: 1 1 100%;">Go to My Bookings</button>
    </Footer>
</BottomSheet>

@code {
    [SupplyParameterFromQuery(Name = "bookingId")]
    public int? BookingId { get; set; }

    private CancellationPreviewDto? _preview;
    private bool _isLoading = true;
    private bool _isSubmitting;
    private string? _loadError;
    private string _selectedReason = "";
    private string? _cancellationReference;
    private string? _approvalStatus;

    private bool showConfirmPopup = false;
    private bool showSuccessPopup = false;

    private static readonly string FallbackImage =
        "_content/SPIC.MauiBlazorApp.Shared/Images/Gallery/image20.jpg";

    protected override async Task OnInitializedAsync()
    {
        if (!BookingId.HasValue)
        {
            _loadError = "No booking selected.";
            _isLoading = false;
            return;
        }

        await LoadPreviewAsync();
    }

    private async Task LoadPreviewAsync()
    {
        _isLoading = true;
        _loadError = null;
        try
        {
            var response = await Http.GetAsync($"api/GuestHouseBooking/bookings/{BookingId}/cancellation-preview");
            if (response.IsSuccessStatusCode)
            {
                _preview = await response.Content.ReadFromJsonAsync<CancellationPreviewDto>();
            }
            else
            {
                _loadError = await ReadMessageAsync(response) ?? "We could not load the cancellation details. Please try again.";
            }
        }
        catch (Exception)
        {
            _loadError = "We could not load the cancellation details. Please try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void GoBack() => Navigation.NavigateTo("/MyBookings");

    private void GoToRefundStatus() => Navigation.NavigateTo($"/RefundStatus?bookingId={BookingId}");

    private void GoToBookingDetails() => Navigation.NavigateTo($"/BookingDetails?bookingId={BookingId}");

    private void OpenConfirmPopup()
    {
        if (string.IsNullOrWhiteSpace(_selectedReason))
        {
            Toast.Warning("Please select a reason for cancellation.");
            return;
        }
        showConfirmPopup = true;
    }

    private void CloseConfirmPopup()
    {
        showConfirmPopup = false;
    }

    private async Task ConfirmAndCancelBooking()
    {
        if (_isSubmitting || _preview == null)
            return;

        _isSubmitting = true;
        try
        {
            var response = await Http.PostAsJsonAsync(
                $"api/GuestHouseBooking/bookings/{BookingId}/cancel",
                new { Reason = _selectedReason });

            if (!response.IsSuccessStatusCode)
            {
                Toast.Error(await ReadMessageAsync(response) ?? "The cancellation request could not be submitted. Please try again.");
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<CancellationResultDto>();
            _cancellationReference = result?.CancellationReference;
            _approvalStatus = result?.ApprovalStatus;
            _preview.AlreadyRequested = true;
            _preview.ExistingApprovalStatus = result?.ApprovalStatus;

            showConfirmPopup = false;
            showSuccessPopup = true;
        }
        catch (Exception)
        {
            Toast.Error("The cancellation request could not be submitted. Please try again.");
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void CloseSuccessPopup()
    {
        showSuccessPopup = false;
        Navigation.NavigateTo("/MyBookings");
    }

    private static async Task<string?> ReadMessageAsync(HttpResponseMessage response)
    {
        try
        {
            var body = await response.Content.ReadFromJsonAsync<ApiMessage>();
            return string.IsNullOrWhiteSpace(body?.Message) ? null : body.Message;
        }
        catch (Exception)
        {
            return null;
        }
    }

    private string GetImageUrl(string? path)
    {
        if (string.IsNullOrWhiteSpace(path)) return FallbackImage;

        if (path.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            path.StartsWith("https://", StringComparison.OrdinalIgnoreCase) ||
            path.StartsWith("_content/", StringComparison.OrdinalIgnoreCase))
        {
            return path;
        }

        var baseUrl = Http.BaseAddress?.ToString().TrimEnd('/') ?? "";
        var relative = Uri.EscapeDataString(path).Replace("%2F", "/").TrimStart('/');
        var token = LoginState.Token;
        if (!string.IsNullOrEmpty(token))
        {
            var rawToken = token.StartsWith("Bearer ") ? token["Bearer ".Length..] : token;
            return $"{baseUrl}/api/GuestHouseBooking/image/{relative}?access_token={Uri.EscapeDataString(rawToken)}";
        }

        return $"{baseUrl}/api/GuestHouseBooking/image/{relative}";
    }

    private static string FormatDate(DateTime? value) =>
        value.HasValue ? value.Value.ToString("MMM dd, yyyy", CultureInfo.InvariantCulture) : "-";

    private static string Money(decimal value) => "₹" + value.ToString("N2", CultureInfo.InvariantCulture);

    private static string Percent(decimal value) => value.ToString("0.##", CultureInfo.InvariantCulture) + "%";

    private static string Dash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string ApprovalLabel(string? status) => status switch
    {
        "PendingApproval" => "Pending Approval",
        "Approved" => "Approved",
        "Rejected" => "Rejected",
        _ => status ?? "-"
    };

    private sealed class ApiMessage
    {
        public string? Message { get; set; }
    }

    private sealed class CancellationResultDto
    {
        public bool Success { get; set; }
        public bool AlreadyRequested { get; set; }
        public int CancellationId { get; set; }
        public string? CancellationReference { get; set; }
        public string? ApprovalStatus { get; set; }
    }

    private sealed class CancellationPreviewDto
    {
        public int BookingId { get; set; }
        public string BookingReference { get; set; } = "";
        public string GuestHouseName { get; set; } = "";
        public string RoomType { get; set; } = "";
        public string? RoomImagePath { get; set; }
        public string BookingStatus { get; set; } = "";
        public DateTime? CheckInDate { get; set; }
        public DateTime? CheckOutDate { get; set; }
        public decimal TotalAmount { get; set; }
        public decimal CancellationChargePercent { get; set; }
        public decimal RefundPercent { get; set; }
        public decimal CancellationCharge { get; set; }
        public decimal TaxAdjustment { get; set; }
        public decimal RefundAmount { get; set; }
        public string RefundMethod { get; set; } = "";
        public string EstimatedRefundWindow { get; set; } = "";
        public bool PolicyConfigured { get; set; }
        public bool AlreadyRequested { get; set; }
        public int? ExistingCancellationId { get; set; }
        public string? ExistingApprovalStatus { get; set; }
        public List<string> CancellationReasons { get; set; } = new();
        public string? EmployeeOrDealerCode { get; set; }
        public string? GuestName { get; set; }
        public string? CompanyName { get; set; }
        public string? PhoneNumber { get; set; }
        public string? Email { get; set; }
        public int? NumberOfPersons { get; set; }
        public string? Nationality { get; set; }
        public string? AadhaarOrPassportNumber { get; set; }
        public string? Address { get; set; }
    }
}
