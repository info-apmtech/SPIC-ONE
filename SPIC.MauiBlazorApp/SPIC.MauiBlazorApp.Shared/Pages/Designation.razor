@page "/Designation"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components
@using DR = SPIC.Core.Entities
@inject HttpClient Http
@inject LoadingService Loading
@inject LoginState LoginState
@inject IJSRuntime JS

@code {
    private List<DR.Designation> _designations = new();
    private List<DR.Designation> _filtered = new();
    private DR.Designation _model = new() { Name = "", IsActive = true };

    // Selected permission tokens in "Page.Action" form, e.g. "Register.View"
    private HashSet<string> _selectedTokens = new(StringComparer.OrdinalIgnoreCase);

    private bool _isEditMode;
    private bool _isSaving;
    private string _searchText = "";
    private string _statusFilter = "All";
    private string? _message;
    private bool _isError;

    // Deactivate modal
    private bool _showDeleteModal;
    private int _deleteId;
    private string _deleteName = "";

    private ElementReference _firstInputRef;

    private static readonly string[] _allPages = Enum.GetNames(typeof(DR.PagePermission));
    private static readonly string[] _actions = { "View", "Entry", "Update", "Delete" };

    // Prettifies "AnnualSales" -> "Annual Sales" for display only.
    private static string DisplayFor(string key)
    {
        var sb = new System.Text.StringBuilder();
        for (int i = 0; i < key.Length; i++)
        {
            if (i > 0 && char.IsUpper(key[i]) && !char.IsUpper(key[i - 1])) sb.Append(' ');
            sb.Append(key[i]);
        }
        return sb.ToString();
    }

    // ---- Permission grid helpers ----
    private bool HasAction(string page, string action) => _selectedTokens.Contains($"{page}.{action}");

    private void ToggleAction(string page, string action)
    {
        var token = $"{page}.{action}";
        if (!_selectedTokens.Add(token)) _selectedTokens.Remove(token);
    }

    private bool IsRowAll(string page) => _actions.All(a => _selectedTokens.Contains($"{page}.{a}"));

    private void ToggleRowAll(string page)
    {
        if (IsRowAll(page))
            foreach (var a in _actions) _selectedTokens.Remove($"{page}.{a}");
        else
            foreach (var a in _actions) _selectedTokens.Add($"{page}.{a}");
    }

    private bool IsAllSelected => _allPages.All(IsRowAll);

    private void ToggleAllRoles()
    {
        if (IsAllSelected)
        {
            _selectedTokens.Clear();
        }
        else
        {
            _selectedTokens.Clear();
            foreach (var p in _allPages)
                foreach (var a in _actions)
                    _selectedTokens.Add($"{p}.{a}");
        }
    }

    private int TotalCount => _designations.Count;
    private int ActiveCount => _designations.Count(d => d.IsActive);
    private int InactiveCount => _designations.Count(d => !d.IsActive);

    protected override async Task OnInitializedAsync()
    {
        Loading.Show();
        try
        {
            await LoadDesignations();
        }
        finally
        {
            Loading.Hide();
        }
    }

    private async Task LoadDesignations()
    {
        try
        {
            _designations = await Http.GetFromJsonAsync<List<DR.Designation>>("api/Designation/all") ?? new();
            ApplyFilter();
        }
        catch (Exception ex)
        {
            ShowMessage($"Failed to load designations: {ex.Message}", true);
        }
    }

    private void ApplyFilter()
    {
        IEnumerable<DR.Designation> query = _designations;

        if (!string.IsNullOrWhiteSpace(_searchText))
            query = query.Where(d => d.Name.Contains(_searchText, StringComparison.OrdinalIgnoreCase));

        if (_statusFilter == "Active") query = query.Where(d => d.IsActive);
        else if (_statusFilter == "Inactive") query = query.Where(d => !d.IsActive);

        _filtered = query.OrderBy(d => d.Name).ToList();
    }

    private async Task EditDesignation(DR.Designation d)
    {
        _model = new DR.Designation
        {
            Id = d.Id,
            Name = d.Name,
            RoleAccess = d.RoleAccess,
            IsActive = d.IsActive,
            CreatedBy = d.CreatedBy,
            CreatedAt = d.CreatedAt
        };

        // Parse RoleAccess. Supports new "Page.Action" tokens AND legacy bare
        // page names (which meant full access) so old saved data still loads.
        _selectedTokens = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        if (!string.IsNullOrWhiteSpace(d.RoleAccess))
        {
            foreach (var raw in d.RoleAccess.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
            {
                if (raw.Contains('.'))
                {
                    _selectedTokens.Add(raw);
                }
                else
                {
                    // legacy bare page name => grant all actions (re-saves as dotted)
                    foreach (var a in _actions) _selectedTokens.Add($"{raw}.{a}");
                }
            }
        }

        _isEditMode = true;
        _message = null;

        // Scroll/focus the first input after a render
        await Task.Yield();
        await _firstInputRef.FocusAsync();
    }

    private void ResetForm()
    {
        _model = new DR.Designation { Name = "", IsActive = true };
        _selectedTokens = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        _isEditMode = false;
        _message = null;
    }

    private async Task SaveDesignation()
    {
        if (string.IsNullOrWhiteSpace(_model.Name))
        {
            ShowMessage("Designation Name is required", true);
            return;
        }
        if (_selectedTokens.Count == 0)
        {
            ShowMessage("Select at least one permission", true);
            return;
        }

        // Duplicate check (case-insensitive, excluding the record being edited)
        bool duplicate = _designations.Any(d =>
            d.Id != _model.Id &&
            d.Name.Trim().Equals(_model.Name.Trim(), StringComparison.OrdinalIgnoreCase));
        if (duplicate)
        {
            ShowMessage($"Designation '{_model.Name}' already exists", true);
            return;
        }

        _isSaving = true;
        try
        {
            _model.Name = _model.Name.Trim();

            // Build RoleAccess in a stable order: page order, then action order.
            _model.RoleAccess = string.Join(",",
                _allPages.SelectMany(p => _actions
                    .Where(a => _selectedTokens.Contains($"{p}.{a}"))
                    .Select(a => $"{p}.{a}")));

            _model.UpdatedBy = LoginState.UserId ?? "System";
            _model.UpdatedAt = DateTime.Now;

            HttpResponseMessage response;
            if (_isEditMode && _model.Id > 0)
            {
                response = await Http.PutAsJsonAsync($"api/Designation/{_model.Id}", _model);
            }
            else
            {
                _model.CreatedBy = LoginState.UserId ?? "System";
                _model.CreatedAt = DateTime.Now;
                response = await Http.PostAsJsonAsync("api/Designation", _model);
            }

            if (response.IsSuccessStatusCode)
            {
                ShowMessage(_isEditMode
                    ? $"'{_model.Name}' updated successfully"
                    : $"'{_model.Name}' saved successfully", false);
                ResetFormKeepMessage();
                await LoadDesignations();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                ShowMessage($"Failed to save: {error}", true);
            }
        }
        catch (Exception ex)
        {
            ShowMessage($"Error: {ex.Message}", true);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void ResetFormKeepMessage()
    {
        var msg = _message;
        var err = _isError;
        ResetForm();
        _message = msg;
        _isError = err;
    }

    private void OpenDeleteModal(DR.Designation d)
    {
        _deleteId = d.Id;
        _deleteName = d.Name;
        _showDeleteModal = true;
    }

    private void CancelDelete()
    {
        _showDeleteModal = false;
        _deleteId = 0;
        _deleteName = "";
    }

    // Soft delete: deactivate instead of hard DELETE, since UserInfo.DesignationId references this table
    private async Task ConfirmDelete()
    {
        var target = _designations.FirstOrDefault(x => x.Id == _deleteId);
        if (target == null) { CancelDelete(); return; }

        try
        {
            target.IsActive = false;
            target.UpdatedBy = LoginState.UserId ?? "System";
            target.UpdatedAt = DateTime.Now;

            var response = await Http.PutAsJsonAsync($"api/Designation/{target.Id}", target);
            if (response.IsSuccessStatusCode)
            {
                ShowMessage($"'{_deleteName}' deactivated successfully", false);
                if (_model.Id == _deleteId) ResetFormKeepMessage();
                await LoadDesignations();
            }
            else
            {
                target.IsActive = true; // revert local state on failure
                var error = await response.Content.ReadAsStringAsync();
                ShowMessage($"Failed to deactivate: {error}", true);
            }
        }
        catch (Exception ex)
        {
            ShowMessage($"Failed to deactivate: {ex.Message}", true);
        }
        finally
        {
            CancelDelete();
        }
    }

    private async Task ReactivateDesignation(DR.Designation d)
    {
        try
        {
            d.IsActive = true;
            d.UpdatedBy = LoginState.UserId ?? "System";
            d.UpdatedAt = DateTime.Now;

            var response = await Http.PutAsJsonAsync($"api/Designation/{d.Id}", d);
            if (response.IsSuccessStatusCode)
            {
                ShowMessage($"'{d.Name}' activated successfully", false);
                await LoadDesignations();
            }
            else
            {
                d.IsActive = false;
                var error = await response.Content.ReadAsStringAsync();
                ShowMessage($"Failed to activate: {error}", true);
            }
        }
        catch (Exception ex)
        {
            ShowMessage($"Failed to activate: {ex.Message}", true);
        }
    }

    private void ShowMessage(string message, bool isError)
    {
        _message = message;
        _isError = isError;
    }

    private bool CanAddDesignation => LoginState.Can("Designation", "Entry");
    private bool CanEditDesignation => LoginState.Can("Designation", "Update");
    private bool CanDeleteDesignation => LoginState.Can("Designation", "Delete");
}

<style>
    .desig-page-title { color: #1F2937; font-weight: 700; font-size: 1.4rem; margin: 24px 0; }

    /* --- Add / Edit Card --- */
    .desig-form-card { background: #fff; border: 1px solid #E5E7EB; border-radius: 14px; padding: 24px; margin-bottom: 24px; box-shadow: 0 1px 3px rgba(0,0,0,.04); }
    .desig-form-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
    .desig-form-title { font-size: 1.05rem; font-weight: 700; color: #1F2937; margin: 0; }
    .desig-form-row { display: flex; gap: 16px; flex-wrap: wrap; align-items: flex-end; margin-bottom: 20px; }
    .desig-field { display: flex; flex-direction: column; }
    .desig-field label { font-size: 0.78rem; font-weight: 600; color: #374151; margin-bottom: 6px; }
    .desig-field input[type="text"] { width: 280px; max-width: 100%; padding: 9px 12px; border: 1px solid #E5E7EB; border-radius: 8px; background: #F9FAFB; font-size: 0.85rem; color: #1F2937; outline: none; transition: border-color .2s; }
    .desig-field input[type="text"]:focus { border-color: #059669; background: #fff; box-shadow: 0 0 0 2px rgba(5,150,105,.1); }

    /* Active toggle pill */
    .desig-toggle-pill { display: flex; align-items: center; gap: 10px; background: #ECFDF5; border: 1px solid #D1FAE5; border-radius: 10px; padding: 9px 16px; cursor: pointer; user-select: none; }
    .desig-toggle-pill.inactive { background: #F3F4F6; border-color: #E5E7EB; }
    .desig-toggle-label { font-size: 0.85rem; font-weight: 600; color: #065F46; }
    .desig-toggle-pill.inactive .desig-toggle-label { color: #6B7280; }
    .desig-switch { position: relative; width: 42px; height: 22px; background: #22C55E; border-radius: 22px; transition: background .2s; flex-shrink: 0; }
    .desig-toggle-pill.inactive .desig-switch { background: #D1D5DB; }
    .desig-switch::after { content: ''; position: absolute; top: 2px; left: 22px; width: 18px; height: 18px; border-radius: 50%; background: #fff; transition: left .2s; box-shadow: 0 1px 2px rgba(0,0,0,.2); }
    .desig-toggle-pill.inactive .desig-switch::after { left: 2px; }

    /* --- Roles Permission (grid) --- */
    .desig-roles-box { border: 1px solid #E5E7EB; border-radius: 10px; padding: 16px 20px; margin-bottom: 20px; background: #F8FAFC; }
    .desig-roles-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
    .desig-roles-title { font-size: 0.88rem; font-weight: 700; color: #1F2937; }
    .desig-role-all { display: inline-flex; align-items: center; gap: 8px; font-size: 0.82rem; font-weight: 700; color: #065F46; cursor: pointer; user-select: none; }
    .desig-role-all input { accent-color: #059669; width: 15px; height: 15px; cursor: pointer; }

    .desig-perm-scroll { max-height: 460px; overflow-y: auto; border: 1px solid #E5E7EB; border-radius: 8px; background: #fff; }
    .desig-perm-table { width: 100%; border-collapse: collapse; }
    .desig-perm-table thead th { position: sticky; top: 0; z-index: 1; background: #F1F5F9; color: #374151; font-weight: 700; font-size: 0.74rem; padding: 10px 8px; border-bottom: 1px solid #E5E7EB; text-align: center; }
    .desig-perm-table td { padding: 8px; font-size: 0.8rem; color: #4B5563; border-bottom: 1px solid #F3F4F6; text-align: center; }
    .desig-perm-table tr:last-child td { border-bottom: none; }
    .desig-perm-table tbody tr:hover td { background: #F9FAFB; }
    .desig-perm-table input[type="checkbox"] { accent-color: #059669; width: 16px; height: 16px; cursor: pointer; }
    .desig-perm-page { text-align: left !important; font-weight: 600; color: #1F2937; }

    /* Form buttons */
    .desig-form-actions { display: flex; justify-content: flex-end; gap: 12px; }
    .desig-btn { display: inline-flex; align-items: center; gap: 6px; padding: 9px 20px; border-radius: 8px; font-size: 0.85rem; font-weight: 600; cursor: pointer; transition: .2s; border: 1px solid transparent; }
    .desig-btn-cancel { background: #fff; border-color: #D1D5DB; color: #4B5563; }
    .desig-btn-cancel:hover { background: #F9FAFB; }
    .desig-btn-save { background: #2563EB; color: #fff; }
    .desig-btn-save:hover { background: #1D4ED8; }
    .desig-btn-save:disabled { opacity: .6; cursor: not-allowed; }

    /* --- Stat Cards --- */
    .desig-stats-row { display: flex; gap: 16px; margin-bottom: 24px; flex-wrap: wrap; }
    .desig-stat-card { flex: 1; min-width: 220px; border: 1px solid #E5E7EB; border-radius: 12px; padding: 18px 20px; }
    .desig-stat-card.total { background: linear-gradient(135deg, #EEF2FF, #F8FAFF); }
    .desig-stat-card.active { background: linear-gradient(135deg, #ECFDF5, #F0FDFA); }
    .desig-stat-card.inactive { background: #F3F4F6; }
    .desig-stat-label { font-size: 0.82rem; color: #6B7280; font-weight: 600; margin-bottom: 8px; }
    .desig-stat-value { font-size: 1.5rem; font-weight: 700; color: #1F2937; }

    /* --- List Card --- */
    .desig-list-card { background: #fff; border: 1px solid #E5E7EB; border-radius: 14px; padding: 24px; box-shadow: 0 1px 3px rgba(0,0,0,.04); margin-bottom: 40px; }
    .desig-list-header { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }
    .desig-list-title { font-size: 1.05rem; font-weight: 700; color: #1F2937; margin: 0; }
    .desig-list-tools { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
    .desig-search { padding: 8px 12px; border: 1px solid #E5E7EB; border-radius: 8px; background: #F9FAFB; font-size: 0.8rem; outline: none; min-width: 200px; }
    .desig-search:focus { border-color: #059669; background: #fff; }
    .desig-status-select { padding: 8px 12px; border: 1px solid #E5E7EB; border-radius: 8px; background: #fff; font-size: 0.8rem; outline: none; cursor: pointer; }

    .desig-table { width: 100%; border-collapse: collapse; text-align: center; }
    .desig-table th { background: #F8FAFC; color: #374151; font-weight: 600; font-size: 0.78rem; padding: 12px 14px; border-bottom: 1px solid #E5E7EB; }
    .desig-table td { padding: 13px 14px; font-size: 0.8rem; color: #4B5563; border-bottom: 1px solid #F3F4F6; }
    .desig-table tr:last-child td { border-bottom: none; }
    .desig-table .desig-roles-cell { max-width: 420px; text-align: left; word-break: break-word; }

    .desig-badge { display: inline-block; padding: 4px 14px; border-radius: 6px; font-size: 0.72rem; font-weight: 600; }
    .desig-badge-active { background: #059669; color: #fff; }
    .desig-badge-inactive { background: #E5E7EB; color: #6B7280; }

    .desig-action-icons { display: flex; gap: 14px; justify-content: center; }
    .desig-action-icons i { font-size: 1rem; cursor: pointer; }
    .desig-icon-edit { color: #2563EB; }
    .desig-icon-delete { color: #DC2626; }
    .desig-icon-restore { color: #059669; }

    /* --- Deactivate Modal --- */
    .desig-modal-backdrop { position: fixed; inset: 0; background: rgba(0,0,0,.4); display: flex; align-items: center; justify-content: center; z-index: 1055; padding: 1rem; }
    .desig-modal { background: #fff; border-radius: 12px; padding: 28px; max-width: 420px; width: 100%; text-align: center; box-shadow: 0 8px 24px rgba(0,0,0,.15); }
    .desig-modal-icon { width: 56px; height: 56px; border-radius: 50%; background: #FEE2E2; color: #DC2626; font-size: 1.5rem; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; }
    .desig-modal-title { font-size: 1.1rem; font-weight: 700; color: #1F2937; margin-bottom: 8px; }
    .desig-modal-body { font-size: 0.85rem; color: #6B7280; margin-bottom: 4px; }
    .desig-modal-warning { font-size: 0.78rem; color: #DC2626; font-weight: 600; margin-bottom: 20px; }
    .desig-modal-actions { display: flex; gap: 12px; justify-content: center; }
    .desig-btn-delete { background: #DC2626; color: #fff; }
    .desig-btn-delete:hover { background: #B91C1C; }
</style>

<div class="container-fluid py-2 px-0">

    <h1 class="desig-page-title">Designation Master</h1>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert @(_isError ? "alert-danger" : "alert-success") alert-dismissible fade show mb-3" role="alert">
            @_message
            <button type="button" class="btn-close" @onclick='() => _message = null'></button>
        </div>
    }

    <!-- ============ Add / Edit Designation ============ -->
    @if (CanAddDesignation || _isEditMode)
    {
        <div class="desig-form-card">
        <div class="desig-form-header">
            <h3 class="desig-form-title">@(_isEditMode ? $"Edit Designation — {_model.Name}" : "Add New Designation")</h3>
        </div>

        <div class="desig-form-row">
            <div class="desig-field">
                <label>Designation Name</label>
                <input type="text" @bind="_model.Name" placeholder="Enter Designation Name" maxlength="100" @ref="_firstInputRef" />
            </div>

            <div class="desig-toggle-pill @(_model.IsActive ? "" : "inactive")" @onclick="() => _model.IsActive = !_model.IsActive">
                <span class="desig-toggle-label">@(_model.IsActive ? "Active" : "Inactive")</span>
                <span class="desig-switch"></span>
            </div>
        </div>

        <!-- Role Access grid -->
        <div class="desig-roles-box">
            <div class="desig-roles-head">
                <div class="desig-roles-title">Role Access</div>
                <label class="desig-role-all">
                    <input type="checkbox" checked="@IsAllSelected" @onchange="ToggleAllRoles" />
                    Select All
                </label>
            </div>

            <div class="desig-perm-scroll">
                <table class="desig-perm-table">
                    <thead>
                        <tr>
                            <th style="width:60px;">S.No</th>
                            <th style="text-align:left;">Page Name</th>
                            <th style="width:70px;">ALL</th>
                            <th style="width:70px;">View</th>
                            <th style="width:70px;">Entry</th>
                            <th style="width:70px;">Update</th>
                            <th style="width:70px;">Delete</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var pno = 1; }
                        @foreach (var page in _allPages)
                        {
                            <tr>
                                <td>@pno</td>
                                <td class="desig-perm-page">@DisplayFor(page)</td>
                                <td>
                                    <input type="checkbox" checked="@IsRowAll(page)"
                                           @onchange="() => ToggleRowAll(page)" />
                                </td>
                                @foreach (var action in _actions)
                                {
                                    <td>
                                        <input type="checkbox" checked="@HasAction(page, action)"
                                               @onchange="() => ToggleAction(page, action)" />
                                    </td>
                                }
                            </tr>
                            pno++;
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="desig-form-actions">
            <button type="button" class="desig-btn desig-btn-cancel" @onclick="ResetForm">
                <i class="bi bi-x-lg"></i> Cancel
            </button>
            <button type="button" class="desig-btn desig-btn-save" @onclick="SaveDesignation" disabled="@_isSaving">
                <i class="bi bi-save"></i> @(_isSaving ? "Saving..." : (_isEditMode ? "Update" : "Save"))
            </button>
        </div>
        </div>
    }

    <!-- ============ Stat Cards ============ -->
    <div class="desig-stats-row">
        <div class="desig-stat-card total">
            <div class="desig-stat-label">Total Count</div>
            <div class="desig-stat-value">@TotalCount</div>
        </div>
        <div class="desig-stat-card active">
            <div class="desig-stat-label">Active</div>
            <div class="desig-stat-value">@ActiveCount</div>
        </div>
        <div class="desig-stat-card inactive">
            <div class="desig-stat-label">Inactive</div>
            <div class="desig-stat-value">@InactiveCount</div>
        </div>
    </div>

    <!-- ============ Designation List ============ -->
    <div class="desig-list-card">
        <div class="desig-list-header">
            <h3 class="desig-list-title">Existing Designations</h3>
            <div class="desig-list-tools">
                <input type="text" class="desig-search" placeholder="Search designations..."
                       @bind="_searchText" @bind:event="oninput" @bind:after="ApplyFilter" />
                <select class="desig-status-select" @bind="_statusFilter" @bind:after="ApplyFilter">
                    <option value="All">All Status</option>
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                </select>
            </div>
        </div>

        <div class="table-responsive">
            <table class="desig-table">
                <thead>
                    <tr>
                        <th>S:No</th>
                        <th>Designation Name</th>
                        <th style="text-align:left;">Roles Permission</th>
                        <th>Status</th>
                        <th>Created At</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_filtered.Any())
                    {
                        var sno = 1;
                        foreach (var d in _filtered)
                        {
                            <tr>
                                <td>@sno</td>
                                <td>@d.Name</td>
                                <td class="desig-roles-cell">@(string.IsNullOrWhiteSpace(d.RoleAccess) ? "-" : d.RoleAccess)</td>
                                <td>
                                    <span class="desig-badge @(d.IsActive ? "desig-badge-active" : "desig-badge-inactive")">
                                        @(d.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td>@d.CreatedAt.ToString("yyyy-MM-dd")</td>
                                <td>
                                    <div class="desig-action-icons">
                                        @if (d.IsActive)
                                        {
                                            @if (CanDeleteDesignation)
                                            {
                                                <i class="bi bi-slash-circle desig-icon-delete" title="Deactivate" @onclick="() => OpenDeleteModal(d)"></i>
                                            }
                                        }
                                        else
                                        {
                                            @if (CanEditDesignation)
                                            {
                                                <i class="bi bi-arrow-counterclockwise desig-icon-restore" title="Activate" @onclick="() => ReactivateDesignation(d)"></i>
                                            }
                                        }
                                        @if (CanEditDesignation)
                                        {
                                            <i class="bi bi-pencil-square desig-icon-edit" title="Edit" @onclick="() => EditDesignation(d)"></i>
                                        }
                                    </div>
                                </td>
                            </tr>
                            sno++;
                        }
                    }
                    else
                    {
                        <tr><td colspan="6" class="text-muted">No designations found</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ============ Deactivate Confirmation Modal ============ -->
@if (_showDeleteModal)
{
    <div class="desig-modal-backdrop" @onclick="CancelDelete">
        <div class="desig-modal" @onclick:stopPropagation="true">
            <div class="desig-modal-icon">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>
            <h3 class="desig-modal-title">Deactivate Designation?</h3>
            <p class="desig-modal-body">You are about to deactivate <strong>@_deleteName</strong></p>
            <p class="desig-modal-warning">Users already assigned to it keep it, but it will be hidden from active lists. You can reactivate it anytime.</p>
            <div class="desig-modal-actions">
                <button type="button" class="desig-btn desig-btn-cancel" @onclick="CancelDelete">Cancel</button>
                <button type="button" class="desig-btn desig-btn-delete" @onclick="ConfirmDelete">
                    <i class="bi bi-slash-circle"></i> Deactivate
                </button>
            </div>
        </div>
    </div>
}