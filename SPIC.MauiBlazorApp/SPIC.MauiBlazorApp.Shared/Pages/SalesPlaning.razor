@page "/SalesPlaning"
@using System.Net.Http.Json
@using SPIC.Core.Entities
@using SPIC.MauiBlazorApp.Shared.FormFlow
@inject HttpClient Http
@inject NavigationManager Nav
@inject LoadingService Loading
<style>
    .sp-bottom-summary-card-compact {
        min-height: unset;
    }

    .sp-bottom-grid-compact {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 22px;
    }

    .sp-bottom-item-compact {
        padding-top: 6px;
        min-width: 0; 
    }

    .sp-bottom-item-compact-right {
        text-align: right;
        border-left: 1px solid #dbe4f0;
        padding-left: 22px;
    }

    .sp-speciality-compact {
        padding-top: 18px;
        min-width: 0;
    }

    @@media (max-width: 576px) {
        .sp-bottom-grid-compact {
            grid-template-columns: 1fr;
            gap: 14px;
        }

        .sp-bottom-item-compact-right {
            text-align: left;
            border-left: 0;
            border-top: 1px solid #dbe4f0;
            padding-left: 0;
            padding-top: 14px;
        }
    }
    /* Sales planning table total font fix */
    .sp-spic-table .sp-row-total-cell,
    .sp-spic-table .sp-footer-total-cell {
        font-size: 13px !important;
        font-weight: 600 !important;
        line-height: 1.35;
        color: #1f2937;
        white-space: nowrap;
        vertical-align: middle;
    }

    .sp-spic-table .sp-row-total-main {
        font-size: 14px;
        font-weight: 700;
    }

    .sp-spic-table .sp-row-total-unit {
        font-size: 12px;
        font-weight: 600;
        color: #475569;
        margin-left: 2px;
    }

    .sp-spic-table tfoot td {
        font-size: 13px !important;
        font-weight: 700 !important;
        padding: 12px 10px !important;
    }

    .sp-spic-table tfoot .sticky-first-col {
        font-size: 14px !important;
    }

    .sp-summary-inline-value {
        font-size: 17px;
        font-weight: 700;
        color: #2563eb;
        line-height: 1.3;
        margin-top: 8px;
        white-space: nowrap;
    }

    /* Darken the summary label text */
    .sp-summary-label {
        color: #1f2937;
        font-weight: 600;
    }

    @@media (max-width: 1399.98px) {
        .sp-bottom-grid-compact {
            gap: 16px;
        }

        .sp-bottom-item-compact-right {
            padding-left: 16px;
        }

        .sp-summary-inline-value {
            font-size: 15px;
        }
    }

    @@media (max-width: 1199.98px) {
        .sp-bottom-grid-compact {
            gap: 12px;
        }

        .sp-bottom-item-compact-right {
            padding-left: 12px;
        }

        .sp-summary-inline-value {
            font-size: 13px;
            white-space: normal;
            word-break: break-word;
        }
    }

   
    @@media (max-width: 991.98px) {
        .sp-bottom-grid-compact {
            gap: 22px;
        }

        .sp-bottom-item-compact-right {
            padding-left: 22px;
        }

        .sp-summary-inline-value {
            font-size: 16px;
            white-space: nowrap;
        }
    }

    @@media (max-width: 767.98px) {
        .sp-summary-inline-value {
            font-size: 15px;
            white-space: normal;
            word-break: break-word;
        }
    }

    @@media (max-width: 575.98px) {
        .sp-summary-inline-value {
            font-size: 15px;
            white-space: normal;
        }
    }
</style>
<div class="container-fluid py-4 px-0">
    <FormLoader />
    <fieldset disabled="@IsViewOnly" style="border:0;padding:0;margin:0;">

        @if (!string.IsNullOrEmpty(_message))
        {
            <div class="alert @(_isError ? "alert-danger" : "alert-success") alert-dismissible fade show mb-3" role="alert">
                @_message
                <button type="button" class="btn-close" @onclick='() => _message = null'></button>
            </div>
        }

        <div class="company-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <h3 class="fw-bold m-0 company-title">Sales Planning & Forecast</h3>
        </div>

        <div class="main-card sp-main-card">

            <div class="section-title mb-3">
                <img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/businessIcon1.svg" class="sp-section-icon" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
                Business Plan
            </div>

            <!-- Dynamic Category Tabs -->
            <div class="custom-tabs sp-custom-tabs">
                @foreach (var cat in _categories)
                {
                    var unitName = _units.FirstOrDefault(u => u.Id == cat.UnitId)?.Name ?? "";
                    <div class="tab-btn @(cat.Id == _selectedCategoryId ? "active" : "")"
                         @onclick="() => SelectCategory(cat.Id)">
                        @cat.Name (@unitName/Value)
                    </div>
                }
            </div>

            <!-- Table -->
            <div class="table-wrapper sp-table-wrapper">
                <div class="table-scroll-fixed">
                    <table class="spic-table sp-spic-table">
                        <thead>
                            <tr>
                                <th rowspan="2" class="sticky-first-col sticky-head-first">
                                    Product Name / Category
                                </th>

                                @foreach (var month in _months)
                                {
                                    <th colspan="2" class="text-center border-start">@month</th>
                                }
                                <th colspan="2" class="text-center border-start">Total</th>
                            </tr>

                            <tr>
                                @foreach (var month in _months)
                                {
                                    <th class="text-center text-muted fw-normal border-start sub-th">@_selectedUnitName</th>
                                    <th class="text-center text-muted fw-normal sub-th">Lakhs</th>
                                }
                                <th class="text-center text-muted fw-normal border-start sub-th">@_selectedUnitName</th>
                                <th class="text-center text-muted fw-normal sub-th">Lakhs</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var row in _currentRows)
                            {
                                var product = _products.FirstOrDefault(p => p.Id == row.ProductId);
                                <tr>
                                    <td class="fw-medium text-dark sticky-first-col">
                                        @(product?.Name ?? "Unknown")
                                    </td>

                                    @for (int i = 0; i < _months.Length; i++)
                                    {
                                        var monthIndex = i;

                                        <td class="border-start">
                                            <input class="table-input sp-table-input" type="number" step="0.01"
                                                   value="@GetQty(row, monthIndex)"
                                                   @onchange="(e) => SetQty(row, monthIndex, e)" />
                                        </td>

                                        <td>
                                            <input class="table-input sp-table-input" type="number" step="0.01"
                                                   value="@GetAmount(row, monthIndex)"
                                                   @onchange="(e) => SetAmount(row, monthIndex, e)" />
                                        </td>
                                    }
                                    <td class="border-start text-center sp-row-total-cell">
                                        <span class="sp-row-total-main">@GetRowTotalQty(row).ToString("N2")</span>
                                        <span class="sp-row-total-unit">@_selectedUnitName</span>
                                    </td>

                                    <td class="text-center sp-row-total-cell">
                                        <span class="sp-row-total-main">₹ @GetRowTotalAmount(row).ToString("N2")</span>
                                        <span class="sp-row-total-unit">Lakhs</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td class="fw-medium text-dark sticky-first-col">Monthly Total</td>
                                @for (int i = 0; i < _months.Length; i++)
                                {
                                    var monthIndex = i;
                                    <td class="text-center border-start bg-light sp-footer-total-cell">
                                        @GetMonthTotalQty(monthIndex).ToString("N2")
                                    </td>
                                    <td class="text-center bg-light sp-footer-total-cell">
                                        @GetMonthTotalAmount(monthIndex).ToString("N2")
                                    </td>
                                }
                                <td class="text-center border-start bg-light sp-footer-total-cell">
                                    @GetGrandTotalQty().ToString("N2")
                                </td>
                                <td class="text-center bg-light sp-footer-total-cell">
                                    @GetGrandTotalAmount().ToString("N2")
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <!-- Summary Cards — Per Category -->
            <div class="row g-3 mt-1">
                @foreach (var cat in _categories)
                {
                    var catUnit = _units.FirstOrDefault(u => u.Id == cat.UnitId)?.Name ?? "MT";
                    var catRows = _allSalesData.Where(r => r.CategoryId == cat.Id).ToList();
                    var catVolume = catRows.Sum(r => r.AprilQty + r.MayQty + r.JuneQty + r.JulyQty + r.AugustQty + r.SeptemberQty + r.OctoberQty + r.NovemberQty + r.DecemberQty + r.JanuaryQty + r.FebruaryQty + r.MarchQty);
                    var catValue = catRows.Sum(r => r.AprilAmount + r.MayAmount + r.JuneAmount + r.JulyAmount + r.AugustAmount + r.SeptemberAmount + r.OctoberAmount + r.NovemberAmount + r.DecemberAmount + r.JanuaryAmount + r.FebruaryAmount + r.MarchAmount);
                    <div class="col-12 col-sm-6 col-lg-4">
                        <div class="sp-summary-card">
                            <div class="sp-summary-header">
                                <span class="sp-summary-dot @(cat.Id == _selectedCategoryId ? "sp-dot-active" : "")"></span>
                                <span class="sp-summary-name">@cat.Name</span>
                                <span class="sp-summary-unit-pill">@catUnit</span>
                            </div>
                            <div class="sp-summary-body">
                                <div class="sp-summary-block">
                                    <div class="sp-summary-label">Volume</div>
                                    <div class="sp-summary-value">
                                        @catVolume.ToString("N2") <span class="sp-summary-suffix">@catUnit</span>
                                    </div>
                                </div>
                                <div class="sp-summary-divider"></div>
                                <div class="sp-summary-block sp-summary-block-right">
                                    <div class="sp-summary-label">Value</div>
                                    <div class="sp-summary-value sp-summary-value-blue">
                                        ₹@catValue.ToString("N2") <span class="sp-summary-suffix">Lakhs</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Bottom Summary Cards -->
            <div class="row g-3 mt-1">

                @{
                    var ureaTotals = GetFertilizerUreaTotals();
                    var otherFertTotals = GetFertilizerOtherProductTotals();
                    var specialityTotals = GetSpecialityTotals();
                }

                <!-- Fertilizer Products Summary -->
                <div class="col-12 col-lg-6">
                    <div class="sp-summary-card sp-bottom-summary-card-compact">
                        <div class="sp-summary-header">
                            <div class="d-flex align-items-center gap-2">
                                <span class="sp-summary-dot"></span>
                                <span class="sp-summary-name">Fertilizer Products Summary</span>
                            </div>
                            <span class="sp-summary-unit-pill">MT</span>
                        </div>

                        <div class="sp-bottom-grid-compact mt-3">
                            <!-- Urea Products -->
                            <div class="sp-bottom-item-compact">
                                <div class="sp-summary-label">Urea</div>

                                <div class="sp-summary-inline-value">
                                    @ureaTotals.Qty.ToString("N2") MT / ₹@ureaTotals.Amount.ToString("N2") Lakhs
                                </div>
                            </div>

                            <!-- Other Fertilizer Products -->
                            <div class="sp-bottom-item-compact sp-bottom-item-compact-right">
                                <div class="sp-summary-label">Other Fertilizer Products</div>

                                <div class="sp-summary-inline-value">
                                    @otherFertTotals.Qty.ToString("N2") MT / ₹@otherFertTotals.Amount.ToString("N2") Lakhs
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Speciality Products Summary -->
                <div class="col-12 col-lg-6">
                    <div class="sp-summary-card sp-bottom-summary-card-compact">
                        <div class="sp-summary-header">
                            <div class="d-flex align-items-center gap-2">
                                <span class="sp-summary-dot"></span>
                                <span class="sp-summary-name">Speciality Products Summary</span>
                            </div>
                            <span class="sp-summary-unit-pill">Lakhs</span>
                        </div>

                        <div class="sp-speciality-compact">
                            <div>
                                <div class="sp-summary-label">Total Specialty Products</div>

                                <div class="sp-summary-inline-value">
                                    @* @specialityTotals.Qty.ToString("N2") MT / *@ ₹@specialityTotals.Amount.ToString("N2") Lakhs
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </fieldset>
    <CommanFooter OnNextClick="HandleNext" IsNextDisabled="@_isSaving" />
</div>

@code {
    [SupplyParameterFromQuery(Name = "dealerId")]
    public int? DealerId { get; set; }
    [SupplyParameterFromQuery(Name = "mode")]
    public string? Mode { get; set; }

    private bool IsViewOnly => string.Equals(Mode, "view", StringComparison.OrdinalIgnoreCase);
    private List<Category> _categories = new();
    private List<Unit> _units = new();
    private List<Product> _products = new();
    private List<SalesPlanningInDealerRegistration> _allSalesData = new();
    private List<SalesPlanningInDealerRegistration> _currentRows = new();

    private int _selectedCategoryId;
    private string _selectedUnitName = "MT";
    private bool _isSaving;
    private string? _message;
    private bool _isError;

    private static readonly string[] _months =
        ["April", "May", "June", "July", "August", "September", "October", "November", "December", "January", "February", "March"];

    protected override async Task OnInitializedAsync()
    {
        Loading.Show();
        try
        {
            await LoadCategories();
            await LoadUnits();
            await LoadProducts();

            if (_categories.Count > 0)
            {
                _selectedCategoryId = _categories.First().Id;
                UpdateSelectedUnit();
            }

            if (DealerId.HasValue && DealerId.Value > 0)
                await LoadSalesData();

            BuildCurrentRows();
        }
        finally
        {
            Loading.Hide();
        }
    }

    private async Task LoadCategories()
    {
        try { _categories = await Http.GetFromJsonAsync<List<Category>>("api/Category") ?? new(); }
        catch (Exception ex) { ShowMessage($"Failed to load categories: {ex.Message}", true); }
    }

    private async Task LoadUnits()
    {
        try { _units = await Http.GetFromJsonAsync<List<Unit>>("api/Unit") ?? new(); }
        catch (Exception ex) { ShowMessage($"Failed to load units: {ex.Message}", true); }
    }

    private async Task LoadProducts()
    {
        try { _products = await Http.GetFromJsonAsync<List<Product>>("api/Product") ?? new(); }
        catch (Exception ex) { ShowMessage($"Failed to load products: {ex.Message}", true); }
    }

    private async Task LoadSalesData()
    {
        try
        {
            var all = await Http.GetFromJsonAsync<List<SalesPlanningInDealerRegistration>>("api/SalesPlanning/all") ?? new();
            _allSalesData = all.Where(s => s.DealerId == DealerId!.Value).ToList();
        }
        catch (Exception ex) { ShowMessage($"Failed to load sales data: {ex.Message}", true); }
    }

    private void SelectCategory(int categoryId)
    {
        _selectedCategoryId = categoryId;
        UpdateSelectedUnit();
        BuildCurrentRows();
    }

    private void UpdateSelectedUnit()
    {
        var cat = _categories.FirstOrDefault(c => c.Id == _selectedCategoryId);
        if (cat != null)
            _selectedUnitName = _units.FirstOrDefault(u => u.Id == cat.UnitId)?.Name ?? "MT";
    }

    private void BuildCurrentRows()
    {
        var categoryProducts = _products.Where(p => p.CategoryId == _selectedCategoryId).ToList();
        _currentRows = new();

        foreach (var product in categoryProducts)
        {
            var existing = _allSalesData.FirstOrDefault(s => s.ProductId == product.Id && s.CategoryId == _selectedCategoryId);
            if (existing != null)
            {
                _currentRows.Add(existing);
            }
            else
            {
                var newRow = new SalesPlanningInDealerRegistration
                {
                    DealerId = DealerId ?? 0,
                    CategoryId = _selectedCategoryId,
                    ProductId = product.Id
                };
                _currentRows.Add(newRow);
                _allSalesData.Add(newRow);
            }
        }
    }

    private static decimal GetQty(SalesPlanningInDealerRegistration row, int m) => m switch
    {
        0 => row.AprilQty,
        1 => row.MayQty,
        2 => row.JuneQty,
        3 => row.JulyQty,
        4 => row.AugustQty,
        5 => row.SeptemberQty,
        6 => row.OctoberQty,
        7 => row.NovemberQty,
        8 => row.DecemberQty,
        9 => row.JanuaryQty,
        10 => row.FebruaryQty,
        11 => row.MarchQty,
        _ => 0
    };

    private static decimal GetAmount(SalesPlanningInDealerRegistration row, int m) => m switch
    {
        0 => row.AprilAmount,
        1 => row.MayAmount,
        2 => row.JuneAmount,
        3 => row.JulyAmount,
        4 => row.AugustAmount,
        5 => row.SeptemberAmount,
        6 => row.OctoberAmount,
        7 => row.NovemberAmount,
        8 => row.DecemberAmount,
        9 => row.JanuaryAmount,
        10 => row.FebruaryAmount,
        11 => row.MarchAmount,
        _ => 0
    };

    private static void SetQty(SalesPlanningInDealerRegistration row, int m, ChangeEventArgs e)
    {
        if (!decimal.TryParse(e.Value?.ToString(), out var val)) return;
        switch (m)
        {
            case 0: row.AprilQty = val; break;
            case 1: row.MayQty = val; break;
            case 2: row.JuneQty = val; break;
            case 3: row.JulyQty = val; break;
            case 4: row.AugustQty = val; break;
            case 5: row.SeptemberQty = val; break;
            case 6: row.OctoberQty = val; break;
            case 7: row.NovemberQty = val; break;
            case 8: row.DecemberQty = val; break;
            case 9: row.JanuaryQty = val; break;
            case 10: row.FebruaryQty = val; break;
            case 11: row.MarchQty = val; break;
        }
    }

    private static void SetAmount(SalesPlanningInDealerRegistration row, int m, ChangeEventArgs e)
    {
        if (!decimal.TryParse(e.Value?.ToString(), out var val)) return;
        switch (m)
        {
            case 0: row.AprilAmount = val; break;
            case 1: row.MayAmount = val; break;
            case 2: row.JuneAmount = val; break;
            case 3: row.JulyAmount = val; break;
            case 4: row.AugustAmount = val; break;
            case 5: row.SeptemberAmount = val; break;
            case 6: row.OctoberAmount = val; break;
            case 7: row.NovemberAmount = val; break;
            case 8: row.DecemberAmount = val; break;
            case 9: row.JanuaryAmount = val; break;
            case 10: row.FebruaryAmount = val; break;
            case 11: row.MarchAmount = val; break;
        }
    }

    private async Task HandleNext()
    {
        if (IsViewOnly)
        {
            Loading.Show();
            Nav.NavigateTo($"/Investment?dealerId={DealerId}&mode=view");
            return;
        }
        if (!DealerId.HasValue || DealerId.Value <= 0)
        {
            ShowMessage("Dealer ID is required.", true);
            return;
        }

        _isSaving = true;
        try
        {
            foreach (var row in _allSalesData)
            {
                var hasData = GetRowTotalQty(row) != 0 || GetRowTotalAmount(row) != 0;
                if (row.Id == 0 && !hasData)
                    continue;

                row.DealerId = DealerId.Value;

                if (row.Id > 0)
                {
                    await Http.PutAsJsonAsync($"api/SalesPlanning/{row.Id}", row);
                }
                else
                {
                    var response = await Http.PostAsJsonAsync("api/SalesPlanning", row);
                    if (response.IsSuccessStatusCode)
                    {
                        var result = await response.Content.ReadFromJsonAsync<CreateResponse>();
                        if (result?.Data != null)
                            row.Id = result.Data.Id;
                    }
                }
            }
            var hasError = _allSalesData.All(r => GetRowTotalQty(r) == 0 && GetRowTotalAmount(r) == 0);
            FormStepData.MarkStepError(8, hasError);
            Loading.Show();
            Nav.NavigateTo($"/Investment?dealerId={DealerId}");
        }
        catch (Exception ex)
        {
            Loading.Hide();
            ShowMessage($"Failed to save: {ex.Message}", true);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private static decimal GetRowTotalQty(SalesPlanningInDealerRegistration r) =>
        r.AprilQty + r.MayQty + r.JuneQty + r.JulyQty +
        r.AugustQty + r.SeptemberQty + r.OctoberQty + r.NovemberQty +
        r.DecemberQty + r.JanuaryQty + r.FebruaryQty + r.MarchQty;

    private static decimal GetRowTotalAmount(SalesPlanningInDealerRegistration r) =>
        r.AprilAmount + r.MayAmount + r.JuneAmount + r.JulyAmount +
        r.AugustAmount + r.SeptemberAmount + r.OctoberAmount + r.NovemberAmount +
        r.DecemberAmount + r.JanuaryAmount + r.FebruaryAmount + r.MarchAmount;

    private decimal GetMonthTotalQty(int monthIndex)
    {
        return _currentRows.Sum(r => monthIndex switch
        {
            0 => r.AprilQty,
            1 => r.MayQty,
            2 => r.JuneQty,
            3 => r.JulyQty,
            4 => r.AugustQty,
            5 => r.SeptemberQty,
            6 => r.OctoberQty,
            7 => r.NovemberQty,
            8 => r.DecemberQty,
            9 => r.JanuaryQty,
            10 => r.FebruaryQty,
            11 => r.MarchQty,
            _ => 0
        });
    }

    private decimal GetMonthTotalAmount(int monthIndex)
    {
        return _currentRows.Sum(r => monthIndex switch
        {
            0 => r.AprilAmount,
            1 => r.MayAmount,
            2 => r.JuneAmount,
            3 => r.JulyAmount,
            4 => r.AugustAmount,
            5 => r.SeptemberAmount,
            6 => r.OctoberAmount,
            7 => r.NovemberAmount,
            8 => r.DecemberAmount,
            9 => r.JanuaryAmount,
            10 => r.FebruaryAmount,
            11 => r.MarchAmount,
            _ => 0
        });
    }

    private decimal GetGrandTotalQty()
    {
        return _currentRows.Sum(r => GetRowTotalQty(r));
    }

    private decimal GetGrandTotalAmount()
    {
        return _currentRows.Sum(r => GetRowTotalAmount(r));
    }

    private bool IsUreaProduct(Product product)
    {
        return product?.Name != null && product.Name.Contains("Urea", StringComparison.OrdinalIgnoreCase);
    }

    private bool IsFertilizerCategory(Category category)
    {
        return category?.Name != null && category.Name.Contains("Fertilizer", StringComparison.OrdinalIgnoreCase);
    }

    private bool IsOtherFertilizerProduct(Product product)
    {
        var cat = _categories.FirstOrDefault(c => c.Id == product.CategoryId);
        return IsFertilizerCategory(cat) && !IsUreaProduct(product);
    }

    private bool IsSpecialityCategory(Category? category)
    {
        if (string.IsNullOrWhiteSpace(category?.Name))
            return false;

        return category.Name.Contains("Specialty", StringComparison.OrdinalIgnoreCase)
            || category.Name.Contains("Speciality", StringComparison.OrdinalIgnoreCase);
    }
    private bool IsSpecialityRow(SalesPlanningInDealerRegistration row)
    {
        var category = _categories.FirstOrDefault(c => c.Id == row.CategoryId);
        return IsSpecialityCategory(category);
    }

    private (decimal Qty, decimal Amount) GetFertilizerUreaTotals()
    {
        decimal totalQty = 0;
        decimal totalAmount = 0;

        foreach (var row in _allSalesData)
        {
            var product = _products.FirstOrDefault(p => p.Id == row.ProductId);
            if (product != null && IsUreaProduct(product))
            {
                totalQty += GetRowTotalQty(row);
                totalAmount += GetRowTotalAmount(row);
            }
        }

        return (totalQty, totalAmount);
    }

    private (decimal Qty, decimal Amount) GetFertilizerOtherProductTotals()
    {
        decimal totalQty = 0;
        decimal totalAmount = 0;

        foreach (var row in _allSalesData)
        {
            var product = _products.FirstOrDefault(p => p.Id == row.ProductId);
            if (product != null && IsOtherFertilizerProduct(product))
            {
                totalQty += GetRowTotalQty(row);
                totalAmount += GetRowTotalAmount(row);
            }
        }

        return (totalQty, totalAmount);
    }

    private Dictionary<string, (decimal Qty, decimal Amount)> GetSpecialityTotalsByUnit()
    {
        var result = new Dictionary<string, (decimal Qty, decimal Amount)>();

        foreach (var row in _allSalesData)
        {
            if (!IsSpecialityRow(row))
                continue;

            var cat = _categories.FirstOrDefault(c => c.Id == row.CategoryId);
            var unit = _units.FirstOrDefault(u => u.Id == cat?.UnitId);
            var unitName = unit?.Name ?? "MT";

            if (!result.ContainsKey(unitName))
            {
                result[unitName] = (0, 0);
            }

            var currentQty = result[unitName].Qty + GetRowTotalQty(row);
            var currentAmount = result[unitName].Amount + GetRowTotalAmount(row);

            result[unitName] = (currentQty, currentAmount);
        }

        return result;
    }

    private decimal GetSpecialityTotalAmount()
    {
        return _allSalesData
            .Where(IsSpecialityRow)
            .Sum(r =>
                r.AprilAmount +
                r.MayAmount +
                r.JuneAmount +
                r.JulyAmount +
                r.AugustAmount +
                r.SeptemberAmount +
                r.OctoberAmount +
                r.NovemberAmount +
                r.DecemberAmount +
                r.JanuaryAmount +
                r.FebruaryAmount +
                r.MarchAmount
            );
    }
    private (decimal Qty, decimal Amount) GetSpecialityTotals()
    {
        var specialityRows = _allSalesData
            .Where(IsSpecialityRow)
            .ToList();

        var totalQty = specialityRows.Sum(GetRowTotalQty);
        var totalAmount = specialityRows.Sum(GetRowTotalAmount);

        return (totalQty, totalAmount);
    }
    private void ShowMessage(string message, bool isError)
    {
        _message = message;
        _isError = isError;
    }

