@page "/SalesPlaning"
@using System.Net.Http.Json
@using SPIC.Core.Entities
@inject HttpClient Http
@inject NavigationManager Nav
@inject LoadingService Loading

<div class="container-fluid py-4 px-0">
	<FormLoader />

	@if (!string.IsNullOrEmpty(_message))
	{
		<div class="alert @(_isError ? "alert-danger" : "alert-success") alert-dismissible fade show mb-3" role="alert">
			@_message
			<button type="button" class="btn-close" @onclick='() => _message = null'></button>
		</div>
	}

	<div class="company-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
		<h3 class="fw-bold m-0 company-title">Sales Planning & Forecast</h3>
	</div>
	<div class="main-card">

		<div class="section-title mb-3">
			<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/businessIcon1.svg" style="width: 24px;" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
			Business Plan
		</div>

		<!-- Dynamic Category Tabs -->
		<div class="custom-tabs">
			@foreach (var cat in _categories)
			{
				var unitName = _units.FirstOrDefault(u => u.Id == cat.UnitId)?.Name ?? "";
				<div class="tab-btn @(cat.Id == _selectedCategoryId ? "active" : "")"
					 @onclick="() => SelectCategory(cat.Id)"
					 style="cursor:pointer;">
					@cat.Name (@unitName/Value)
				</div>
			}
		</div>

		<!-- Table -->
		<div class="table-wrapper">
			<div class="table-responsive">
				<table class="spic-table">
					<thead>
						<tr>
							<th rowspan="2" style="min-width: 180px; position: sticky; left: 0; background: #fff; z-index: 2;">Product Name / Category</th>
							@foreach (var month in _months)
							{
								<th colspan="2" class="text-center border-start">@month</th>
							}
						</tr>
						<tr>
							@foreach (var month in _months)
							{
								<th class="text-center text-muted fw-normal border-start">@_selectedUnitName</th>
								<th class="text-center text-muted fw-normal">Lakhs</th>
							}
						</tr>
					</thead>
					<tbody>
						@foreach (var row in _currentRows)
						{
							var product = _products.FirstOrDefault(p => p.Id == row.ProductId);
							<tr>
								<td class="fw-medium text-dark" style="position: sticky; left: 0; background: #fff; z-index: 1;">@(product?.Name ?? "Unknown")</td>
								@for (int i = 0; i < _months.Length; i++)
								{
									var monthIndex = i;
									<td class="border-start">
										<input class="table-input" type="
" step="0.01"
											   value="@GetQty(row, monthIndex)"
											   @onchange="(e) => SetQty(row, monthIndex, e)" />
									</td>
									<td>
										<input class="table-input" type="number" step="0.01"
											   value="@GetAmount(row, monthIndex)"
											   @onchange="(e) => SetAmount(row, monthIndex, e)" />
									</td>
								}
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>

		<!-- Summary Cards -->
		<div class="row g-4 mt-2">
			<div class="col-md-6">
				<div class="summary-card pink">
					<div class="stat-label">Total Volume (@_selectedUnitName)</div>
					<div class="stat-val">
						@TotalVolume().ToString("N2") <span class="stat-unit">@_selectedUnitName</span>
					</div>
					<i class="bi bi-gear watermark-icon" style="transform: translateY(-20px) scale(0.85);"></i>
					<i class="bi bi-coin watermark-icon"></i>
				</div>
			</div>

			<div class="col-md-6">
				<div class="summary-card blue">
					<div class="stat-label">Total Forecast Value</div>
					<div class="stat-val">
						₹@TotalForecastValue().ToString("N2") <span class="stat-unit">Lakhs</span>
					</div>
					<i class="bi bi-graph-up-arrow watermark-icon"></i>
				</div>
			</div>
		</div>

	</div>
	<CommanFooter OnNextClick="HandleNext" IsNextDisabled="@_isSaving" />
</div>

@code {
	[SupplyParameterFromQuery(Name = "dealerId")]
	public int? DealerId { get; set; }

	private List<Category> _categories = new();
	private List<Unit> _units = new();
	private List<Product> _products = new();
	private List<SalesPlanningInDealerRegistration> _allSalesData = new();
	private List<SalesPlanningInDealerRegistration> _currentRows = new();

	private int _selectedCategoryId;
	private string _selectedUnitName = "MT";
	private bool _isSaving;
	private string? _message;
	private bool _isError;

	private static readonly string[] _months =
		["April", "May", "June", "July", "August", "September", "October", "November", "December", "January", "February", "March"];

	protected override async Task OnInitializedAsync()
	{
		Loading.Show();
		try
		{
			await LoadCategories();
			await LoadUnits();
			await LoadProducts();

			if (_categories.Count > 0)
			{
				_selectedCategoryId = _categories.First().Id;
				UpdateSelectedUnit();
			}

			if (DealerId.HasValue && DealerId.Value > 0)
				await LoadSalesData();

			BuildCurrentRows();
		}
		finally
		{
			Loading.Hide();
		}
	}

	private async Task LoadCategories()
	{
		try { _categories = await Http.GetFromJsonAsync<List<Category>>("api/Category") ?? new(); }
		catch (Exception ex) { ShowMessage($"Failed to load categories: {ex.Message}", true); }
	}

	private async Task LoadUnits()
	{
		try { _units = await Http.GetFromJsonAsync<List<Unit>>("api/Unit") ?? new(); }
		catch (Exception ex) { ShowMessage($"Failed to load units: {ex.Message}", true); }
	}

	private async Task LoadProducts()
	{
		try { _products = await Http.GetFromJsonAsync<List<Product>>("api/Product") ?? new(); }
		catch (Exception ex) { ShowMessage($"Failed to load products: {ex.Message}", true); }
	}

	private async Task LoadSalesData()
	{
		try
		{
			var all = await Http.GetFromJsonAsync<List<SalesPlanningInDealerRegistration>>("api/SalesPlanning/all") ?? new();
			_allSalesData = all.Where(s => s.DealerId == DealerId!.Value).ToList();
		}
		catch (Exception ex) { ShowMessage($"Failed to load sales data: {ex.Message}", true); }
	}

	private void SelectCategory(int categoryId)
	{
		_selectedCategoryId = categoryId;
		UpdateSelectedUnit();
		BuildCurrentRows();
	}

	private void UpdateSelectedUnit()
	{
		var cat = _categories.FirstOrDefault(c => c.Id == _selectedCategoryId);
		if (cat != null)
			_selectedUnitName = _units.FirstOrDefault(u => u.Id == cat.UnitId)?.Name ?? "MT";
	}

	private void BuildCurrentRows()
	{
		var categoryProducts = _products.Where(p => p.CategoryId == _selectedCategoryId).ToList();
		_currentRows = new();

		foreach (var product in categoryProducts)
		{
			var existing = _allSalesData.FirstOrDefault(s => s.ProductId == product.Id && s.CategoryId == _selectedCategoryId);
			if (existing != null)
			{
				_currentRows.Add(existing);
			}
			else
			{
				var newRow = new SalesPlanningInDealerRegistration
				{
					DealerId = DealerId ?? 0,
					CategoryId = _selectedCategoryId,
					ProductId = product.Id
				};
				_currentRows.Add(newRow);
				_allSalesData.Add(newRow);
			}
		}
	}

	private static decimal GetQty(SalesPlanningInDealerRegistration row, int m) => m switch
	{
		0 => row.AprilQty, 1 => row.MayQty, 2 => row.JuneQty, 3 => row.JulyQty,
		4 => row.AugustQty, 5 => row.SeptemberQty, 6 => row.OctoberQty, 7 => row.NovemberQty,
		8 => row.DecemberQty, 9 => row.JanuaryQty, 10 => row.FebruaryQty, 11 => row.MarchQty,
		_ => 0
	};

	private static decimal GetAmount(SalesPlanningInDealerRegistration row, int m) => m switch
	{
		0 => row.AprilAmount, 1 => row.MayAmount, 2 => row.JuneAmount, 3 => row.JulyAmount,
		4 => row.AugustAmount, 5 => row.SeptemberAmount, 6 => row.OctoberAmount, 7 => row.NovemberAmount,
		8 => row.DecemberAmount, 9 => row.JanuaryAmount, 10 => row.FebruaryAmount, 11 => row.MarchAmount,
		_ => 0
	};

	private static void SetQty(SalesPlanningInDealerRegistration row, int m, ChangeEventArgs e)
	{
		if (!decimal.TryParse(e.Value?.ToString(), out var val)) return;
		switch (m)
		{
			case 0: row.AprilQty = val; break;
			case 1: row.MayQty = val; break;
			case 2: row.JuneQty = val; break;
			case 3: row.JulyQty = val; break;
			case 4: row.AugustQty = val; break;
			case 5: row.SeptemberQty = val; break;
			case 6: row.OctoberQty = val; break;
			case 7: row.NovemberQty = val; break;
			case 8: row.DecemberQty = val; break;
			case 9: row.JanuaryQty = val; break;
			case 10: row.FebruaryQty = val; break;
			case 11: row.MarchQty = val; break;
		}
	}

	private static void SetAmount(SalesPlanningInDealerRegistration row, int m, ChangeEventArgs e)
	{
		if (!decimal.TryParse(e.Value?.ToString(), out var val)) return;
		switch (m)
		{
			case 0: row.AprilAmount = val; break;
			case 1: row.MayAmount = val; break;
			case 2: row.JuneAmount = val; break;
			case 3: row.JulyAmount = val; break;
			case 4: row.AugustAmount = val; break;
			case 5: row.SeptemberAmount = val; break;
			case 6: row.OctoberAmount = val; break;
			case 7: row.NovemberAmount = val; break;
			case 8: row.DecemberAmount = val; break;
			case 9: row.JanuaryAmount = val; break;
			case 10: row.FebruaryAmount = val; break;
			case 11: row.MarchAmount = val; break;
		}
	}

	private decimal TotalVolume() => _allSalesData.Sum(r =>
		r.AprilQty + r.MayQty + r.JuneQty + r.JulyQty +
		r.AugustQty + r.SeptemberQty + r.OctoberQty + r.NovemberQty +
		r.DecemberQty + r.JanuaryQty + r.FebruaryQty + r.MarchQty);

	private decimal TotalForecastValue() => _allSalesData.Sum(r =>
		r.AprilAmount + r.MayAmount + r.JuneAmount + r.JulyAmount +
		r.AugustAmount + r.SeptemberAmount + r.OctoberAmount + r.NovemberAmount +
		r.DecemberAmount + r.JanuaryAmount + r.FebruaryAmount + r.MarchAmount);

	private async Task HandleNext()
	{
		if (!DealerId.HasValue || DealerId.Value <= 0)
		{
			ShowMessage("Dealer ID is required.", true);
			return;
		}

		_isSaving = true;
		try
		{
			foreach (var row in _allSalesData)
			{
				var hasData = GetRowTotalQty(row) != 0 || GetRowTotalAmount(row) != 0;
				if (row.Id == 0 && !hasData)
					continue;

				row.DealerId = DealerId.Value;

				if (row.Id > 0)
				{
					await Http.PutAsJsonAsync($"api/SalesPlanning/{row.Id}", row);
				}
				else
				{
					var response = await Http.PostAsJsonAsync("api/SalesPlanning", row);
					if (response.IsSuccessStatusCode)
					{
						var result = await response.Content.ReadFromJsonAsync<CreateResponse>();
						if (result?.Data != null)
							row.Id = result.Data.Id;
					}
				}
			}
			Loading.Show();
			Nav.NavigateTo($"/Investment?dealerId={DealerId}");
		}
		catch (Exception ex)
		{
			Loading.Hide();
			ShowMessage($"Failed to save: {ex.Message}", true);
		}
		finally
		{
			_isSaving = false;
		}
	}

	private static decimal GetRowTotalQty(SalesPlanningInDealerRegistration r) =>
		r.AprilQty + r.MayQty + r.JuneQty + r.JulyQty +
		r.AugustQty + r.SeptemberQty + r.OctoberQty + r.NovemberQty +
		r.DecemberQty + r.JanuaryQty + r.FebruaryQty + r.MarchQty;

	private static decimal GetRowTotalAmount(SalesPlanningInDealerRegistration r) =>
		r.AprilAmount + r.MayAmount + r.JuneAmount + r.JulyAmount +
		r.AugustAmount + r.SeptemberAmount + r.OctoberAmount + r.NovemberAmount +
		r.DecemberAmount + r.JanuaryAmount + r.FebruaryAmount + r.MarchAmount;

	private void ShowMessage(string message, bool isError)
	{
		_message = message;
		_isError = isError;
	}

	private class CreateResponse
	{
		public string? Message { get; set; }
		public SalesPlanningInDealerRegistration? Data { get; set; }
	}
}