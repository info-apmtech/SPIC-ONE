@using SPIC.Core.DTOs
@inject IJSRuntime JS

@if (IsOpen)
{
    <div class="sd-overlay" @onclick="CloseDrawer">
        <div class="sd-drawer" @onclick:stopPropagation="true">

            <div class="sd-header">
                <div class="sd-header-titles">
                    <h2>Stock Details</h2>
                    <div class="sd-status-badge">
                        <div class="sd-dot"></div>
                        @(Row?.Status ?? "—")
                    </div>
                </div>
                <button class="sd-close-icon" @onclick="CloseDrawer" aria-label="Close">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="15" y1="9" x2="9" y2="15"></line>
                        <line x1="9" y1="9" x2="15" y2="15"></line>
                    </svg>
                </button>
            </div>

            <div class="sd-body">

                <div class="sd-section">
                    <h3>Dealer Information</h3>
                    <div class="sd-row">
                        <span class="sd-label">Dealer Name</span>
                        <span class="sd-value"><span class="sd-colon">:</span> @(Row?.DealerName)</span>
                    </div>
                    <div class="sd-row">
                        <span class="sd-label">Dealer ID</span>
                        <span class="sd-value"><span class="sd-colon">:</span> @(Row?.DealerRegistrationId?.ToString() ?? "—")</span>
                    </div>
                    <div class="sd-row">
                        <span class="sd-label">Mobile No.</span>
                        <span class="sd-value sd-val-flex">
                            <span class="sd-colon">:</span> @(string.IsNullOrWhiteSpace(Row?.MobileNo) ? "—" : Row!.MobileNo)
                            @if (!string.IsNullOrWhiteSpace(Row?.MobileNo))
                            {
                                <button class="sd-wa-icon" title="Open on WhatsApp" @onclick="ShareWhatsApp">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
                                </button>
                            }
                        </span>
                    </div>
                </div>

                <div class="sd-section">
                    <h3>Location Information</h3>
                    <div class="sd-row">
                        <span class="sd-label">State</span>
                        <span class="sd-value"><span class="sd-colon">:</span> @(Row?.StateName)</span>
                    </div>
                    <div class="sd-row">
                        <span class="sd-label">Lying With</span>
                        <span class="sd-value"><span class="sd-colon">:</span> @(Row?.LyingWith)</span>
                    </div>
                </div>

                <div class="sd-section">
                    <h3>Product Information</h3>
                    <div class="sd-row">
                        <span class="sd-label">Product</span>
                        <span class="sd-value"><span class="sd-colon">:</span> @(Row?.ProductName)</span>
                    </div>
                    <div class="sd-row">
                        <span class="sd-label">Quantity (MT)</span>
                        <span class="sd-value"><span class="sd-colon">:</span> @(Row?.Quantity)</span>
                    </div>
                </div>

                <div class="sd-section">
                    <h3>Inventory Information</h3>
                    <div class="sd-row">
                        <span class="sd-label">Ageing Days</span>
                        <span class="sd-value sd-val-flex">
                            <span class="sd-colon">:</span> @(Row?.AgeingDays) Days
                            <div class="sd-status-badge sd-badge-inline">
                                <div class="sd-dot"></div> @(Row?.Status ?? "—")
                            </div>
                        </span>
                    </div>
                </div>

            </div>

            <div class="sd-footer">
                @if (!string.IsNullOrWhiteSpace(Row?.MobileNo))
                {
                    <button class="sd-btn-whatsapp" @onclick="ShareWhatsApp">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
                        WhatsApp
                    </button>
                }
                <button class="sd-btn-close" @onclick="CloseDrawer">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                    Close
                </button>
            </div>

        </div>
    </div>
}


@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    // The clicked stock row. Nullable so the drawer is safe before a row is chosen.
    [Parameter]
    public StockRowDto? Row { get; set; }

    private async Task CloseDrawer()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(IsOpen);
    }

    // Opens the dealer's WhatsApp chat. Mirrors the grid's ShareWhatsApp:
    // digits-only phone extraction, 91 country-code prefix, blank-share fallback.
    private async Task ShareWhatsApp()
    {
        if (Row is null)
            return;

        var msg = Uri.EscapeDataString(
            $"Stock Report\nDealer: {Row.DealerName}\nState: {Row.StateName}\n" +
            $"Product: {Row.ProductName}\nQuantity: {Row.Quantity} MT\n" +
            $"Ageing: {Row.AgeingDays} days ({Row.Status})");

        var phone = new string((Row.MobileNo ?? "").Where(char.IsDigit).ToArray());
        var url = string.IsNullOrEmpty(phone)
            ? $"https://wa.me/?text={msg}"
            : $"https://wa.me/91{phone}?text={msg}";

        await JS.InvokeVoidAsync("open", url, "_blank");
    }
}
