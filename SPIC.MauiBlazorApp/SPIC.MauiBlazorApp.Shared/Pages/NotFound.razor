@page "/not-found"
@layout MainLayout
@inject SPIC.MauiBlazorApp.Shared.Services.LoginState LoginState

<PageHeader Title="Page not found" Subtitle="The link may be outdated or the page may have moved." />

<div class="nf-page">
    <EmptyState Icon="bi-compass" Title="We could not find that page" Message="Check the address, or go back to your home screen.">
        <a class="btn btn-success nf-home-btn" href="@LoginState.LandingPage">
            <i class="bi bi-house-door"></i> Go to home
        </a>
    </EmptyState>
</div>

<style>
    .nf-page { max-width: 560px; margin: 24px auto; }
    .nf-home-btn { display: inline-flex; align-items: center; gap: 8px; }

    /* native: phone */
    @@media (max-width: 767.98px) {
        .nf-page { margin: 8px auto; }
        .nf-home-btn { width: 100%; min-height: var(--tap-min, 44px); justify-content: center; }
    }
</style>
