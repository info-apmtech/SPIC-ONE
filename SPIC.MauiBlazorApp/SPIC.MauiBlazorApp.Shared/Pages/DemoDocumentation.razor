        }

    .demo-page .search-box {
        height: 32px;
        display: flex;
        align-items: center;
        gap: 8px;
        border: 1px solid #e5e7eb;
        background: #fff;
        border-radius: 6px;
        padding: 0 10px;
        color: #94a3b8;
        min-width: 180px;
    }

        .demo-page .search-box input {
