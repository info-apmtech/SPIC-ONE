@code {


    private List<DemoDocumentationDto> DemoList = new();

    private List<DemoDocumentationDto> FilteredDemoList = new();


    private string SearchText = "";

    private string SelectedSeason = "";
    private string SelectedProgram = "";
    private string SelectedProduct = "";
    private string SelectedCrop = "";
    private string SelectedDistrict = "";
    private string SelectedStage = "";
    private string SelectedStatus = "";



    private int PageSize = 16;
    private int CurrentPage = 1;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredDemoList.Count / (double)PageSize));
    private IEnumerable<DemoDocumentationDto> PagedDemoList => FilteredDemoList.Skip((CurrentPage - 1) * PageSize).Take(PageSize);
    private void ChangePage(int page) => CurrentPage = Math.Clamp(page, 1, TotalPages);

    private void OpenStartDocumentation(int csr2Id)
    {
        if (csr2Id <= 0) return;
        NavigationManager.NavigateTo($"/StartDocumentation?csr2Id={csr2Id}");
    }
    private void OnPageSizeChanged(ChangeEventArgs e)
    {
        PageSize = int.TryParse(e.Value?.ToString(), out var value) && value > 0 ? value : 16;
        CurrentPage = 1;
    }
    private bool IsLoading;
    private string LoadError = string.Empty;

    // Requires an API that returns approved CSR-2 demonstration records.
    // The server must enforce role/geographic access, approval status,
    // eligible program types and distinct CSR2 IDs (not just the UI).
    protected override async Task OnInitializedAsync() => await LoadDataAsync();

    private async Task LoadDataAsync()
    {
        IsLoading = true;
        LoadError = string.Empty;
        DemoList = new();
        FilteredDemoList = new();
        try
        {
            // API response must match DemoDocumentationDto below.
            using var response = await Http.GetAsync("api/DemoDocumentation/approved-csr2");
            if (!response.IsSuccessStatusCode)
            {
                LoadError = $"Unable to load approved CSR-2 demonstrations (HTTP {(int)response.StatusCode}).";
                return;
            }
            var data = await response.Content.ReadFromJsonAsync<List<DemoDocumentationDto>>() ?? new();
            DemoList = data;
            ApplyFilter();
        }
        catch (Exception ex)
        {
            LoadError = $"Unable to load demonstration records: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void ApplyFilter()
    {
        FilteredDemoList = DemoList.Where(x =>
            (string.IsNullOrWhiteSpace(SearchText) ||
              new[] { x.SeasonNumber, x.ProgramName, x.Product, x.Crop, x.District, x.Location, x.Status }
                .Any(s => (s ?? "").Contains(SearchText, StringComparison.OrdinalIgnoreCase))) &&
            (string.IsNullOrWhiteSpace(SelectedSeason) || x.SeasonNumber == SelectedSeason) &&
            (string.IsNullOrWhiteSpace(SelectedProgram) || x.ProgramName == SelectedProgram) &&
            (string.IsNullOrWhiteSpace(SelectedProduct) || x.Product == SelectedProduct) &&
            (string.IsNullOrWhiteSpace(SelectedCrop) || x.Crop == SelectedCrop) &&
            (string.IsNullOrWhiteSpace(SelectedDistrict) || x.District == SelectedDistrict) &&
            (string.IsNullOrWhiteSpace(SelectedStage) || x.CurrentStage == SelectedStage) &&
            (string.IsNullOrWhiteSpace(SelectedStatus) || x.Status == SelectedStatus)
        ).ToList();
        CurrentPage = 1;
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        SearchText = e.Value?.ToString() ?? "";
        ApplyFilter();
    }

    private void ClearFilter()
    {
        SelectedSeason = "";
        SelectedProgram = "";
        SelectedProduct = "";
        SelectedCrop = "";
        SelectedDistrict = "";
        SelectedStage = "";
        SelectedStatus = "";
        SearchText = "";

        ApplyFilter();
    }



    public class DemoDocumentationDto
    {

        public int Id { get; set; }

        public string SeasonNumber { get; set; } = "";

        public string ProgramName { get; set; } = "";

        public string Product { get; set; } = "";

        public string Crop { get; set; } = "";

        public string District { get; set; } = "";

        public string Location { get; set; } = "";

        public string CurrentStage { get; set; } = "";

        public DateTime? SowingDate { get; set; }

        public DateTime? HarvestDate { get; set; }

        public int TotalTreatments { get; set; }

        public int CompletedTreatments { get; set; }

        public DateTime? LastTreatmentDate { get; set; }

        public string DocumentationStatus { get; set; } = "";

        public string Status { get; set; } = "";

    }

}