@page "/DemoDocumentation"
@inject HttpClient Http
@inject NavigationManager NavigationManager
@using System.Net.Http.Json
@using System.Linq

<div class="container-fluid demo-page py-3 px-3">
    <div class="demo-page-head">
        <div>
            <h1>Demo Documentation</h1>
            <p>Track eligible field demonstrations and treatment-wise documentation</p>
        </div>
        <div class="info-alert"><i class="bi bi-info-circle"></i> Records are shown only for approved CSR-2 entries with eligible Program Types</div>
    </div>

    @if (!string.IsNullOrWhiteSpace(LoadError))
    {
        <div class="alert alert-danger" role="alert">@LoadError</div>
    }
    @if (IsLoading)
    {
        <div class="alert alert-info">Loading approved CSR-2 demonstration records...</div>
    }

    <div class="filter-card">
        <div class="filter-header"><span><i class="bi bi-funnel me-2"></i>Filters</span><i class="bi bi-chevron-down"></i></div>
        <div class="filter-body">
            <div class="filter-grid">
                <div>
                    <label>Sanction Number</label><select class="form-control" @bind="SelectedSeason">
                    <option value="">Select Sanction Number</option>
                    @foreach (var x in DemoList.Select(x => x.SeasonNumber).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x => x))
                    {
                        <option value="@x">@x</option>
                    }
                </select>
            </div>
            <div>
                <label>Program Name</label><select class="form-control" @bind="SelectedProgram">
                <option value="">Select Program Name</option>
                @foreach (var x in DemoList.Select(x => x.ProgramName).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x => x))
                {
                    <option value="@x">@x</option>
                }
            </select>
        </div>
        <div>
            <label>Product</label><select class="form-control" @bind="SelectedProduct">
            <option value="">Select Product</option>
            @foreach (var x in DemoList.Select(x => x.Product).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x => x))
            {
                <option value="@x">@x</option>
            }
        </select>
    </div>
    <div>
        <label>Crop</label><select class="form-control" @bind="SelectedCrop">
        <option value="">Select Crop</option>
        @foreach (var x in DemoList.Select(x => x.Crop).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x => x))
        {
            <option value="@x">@x</option>
        }
    </select>
</div>
<div>
    <label>District</label><select class="form-control" @bind="SelectedDistrict">
    <option value="">Select District</option>
    @foreach (var x in DemoList.Select(x => x.District).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x => x))
    {
        <option value="@x">@x</option>
    }
</select>
</div>
<div>
    <label>Stage</label><select class="form-control" @bind="SelectedStage">
    <option value="">Select Stage</option>
    @foreach (var x in DemoList.Select(x => x.CurrentStage).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x => x))
    {
        <option value="@x">@x</option>
    }
</select>
</div>
<div>
    <label>Status</label><select class="form-control" @bind="SelectedStatus">
    <option value="">Select Status</option>
    @foreach (var x in DemoList.Select(x => x.Status).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x => x))
    {
        <option value="@x">@x</option>
    }
</select>
</div>
<div class="filter-actions">
    <button type="button" class="clear-btn" @onclick="ClearFilter"><i class="bi bi-x"></i> Clear All</button>
    <button type="button" class="apply-btn" @onclick="ApplyFilter"><i class="bi bi-funnel"></i> Apply Filters</button>
</div>
</div>
</div>
</div>

<div class="demo-summary-grid">
    <div class="summary-card summary-total"><div><div class="summary-title">Total Demonstrations</div><div class="summary-value">@DemoList.Count</div><div class="summary-description">All eligible records</div></div><div class="summary-icon"><i class="bi bi-file-earmark-text"></i></div></div>
    <div class="summary-card summary-notstarted"><div><div class="summary-title">Not Started</div><div class="summary-value">@DemoList.Count(x => x.Status == "Not Started")</div><div class="summary-description">Pending First visit</div></div><div class="summary-icon"><i class="bi bi-file-earmark-check"></i></div></div>
    <div class="summary-card summary-progress"><div><div class="summary-title">In Progress</div><div class="summary-value">@DemoList.Count(x => x.Status == "In Progress")</div><div class="summary-description">Active Documentation</div></div><div class="summary-icon"><i class="bi bi-clock"></i></div></div>
    <div class="summary-card summary-completed"><div><div class="summary-title">Completed</div><div class="summary-value">@DemoList.Count(x => x.Status == "Completed")</div><div class="summary-description">Invoiced document</div></div><div class="summary-icon"><i class="bi bi-patch-check"></i></div></div>
</div>

<div class="demo-table-card">
    <div class="demo-table-toolbar">
        <h2>Demo Documentation List</h2>
        <div class="search-box"><i class="bi bi-search"></i><input type="search" placeholder="Search demo..." value="@SearchText" @oninput="OnSearchChanged" /></div>
    </div>
    <div class="demo-table-scroll">
        <table class="demo-table">
            <thead><tr><th>Sanction Number</th><th>Program Name</th><th>Product / Crop</th><th>Location</th><th>Current Stage</th><th>Date Of Sowing</th><th>Harvest Date</th><th>Treatments</th><th>Last Treatment</th><th>Documentation</th><th>Status</th><th>Action</th></tr></thead>
            <tbody>
                @if (PagedDemoList.Any())
                {
                    @foreach (var item in PagedDemoList)
                    {
                        <tr @key="item.Id">
                            <td><span class="season-text">@item.SeasonNumber</span></td>
                            <td><span class="program-text">@item.ProgramName</span></td>
                            <td><div class="product-cell"><b>@item.Product</b><small>@item.Crop</small></div></td>
                            <td><div class="location-cell"><i class="bi bi-geo-alt-fill"></i><span>@item.Location</span></div></td>
                            <td><span class="stage @(item.CurrentStage.Contains("Completed", StringComparison.OrdinalIgnoreCase) ? "completed" : item.CurrentStage.Contains("Treatment", StringComparison.OrdinalIgnoreCase) ? "progress" : "pending")"><i class="bi bi-circle-fill"></i> @item.CurrentStage</span></td>
                            <td>@(item.SowingDate?.ToString("dd-MM-yyyy") ?? "-")</td>
                            <td>@(item.HarvestDate?.ToString("dd-MM-yyyy") ?? "-")</td>
                            <td><div class="treatment"><b>@item.CompletedTreatments Completed</b><small>Out of @item.TotalTreatments</small></div></td>
                            <td>@(item.LastTreatmentDate?.ToString("dd-MM-yyyy") ?? "-")</td>
                            <td><span class="doc-status">@item.DocumentationStatus</span></td>
                            <td><span class="status @(item.Status == "Completed" ? "completed" : item.Status == "In Progress" ? "progress" : "pending")"><i class="bi bi-circle-fill"></i> @item.Status</span></td>
                            <td><div class="demo-actions"><button type="button" class="view-btn" @onclick="() => OpenStartDocumentation(item.Id)">View / Continue</button></div></td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="12" class="demo-empty">@(IsLoading ? "Loading records..." : "No eligible demonstration records found")</td></tr>
                }
            </tbody>
        </table>
    </div>
    <div class="demo-table-footer">
        <div class="demo-page-size">Rows Per Page <select value="@PageSize" @onchange="OnPageSizeChanged"><option value="8">8</option><option value="16">16</option><option value="25">25</option><option value="50">50</option></select></div>
        <div class="demo-pagination">
            <button type="button" disabled="@(CurrentPage == 1)" @onclick="() => ChangePage(CurrentPage - 1)">‹</button>
            <span>@CurrentPage / @TotalPages</span><button type="button" disabled="@(CurrentPage == TotalPages)" @onclick="() => ChangePage(CurrentPage + 1)">›</button>
        </div>
    </div>
</div>
</div>

<style>
