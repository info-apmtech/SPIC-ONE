    private async Task LoadBudgetPrograms()
    {
        isBudgetDataLoading = true;

        budgetLoadError = "";

        try
        {
            using var response =
                await Http.GetAsync(
                    "api/Budget/approved-programs"
                );

            var body =
                await response.Content
                    .ReadAsStringAsync();

            Console.WriteLine(
                $"Approved Program API => " +
                $"Status={(int)response.StatusCode} " +
                $"{response.StatusCode}"
            );

            Console.WriteLine(
                $"Approved Program Response => {body}"
            );

            if (!response.IsSuccessStatusCode)
            {
                budgetPrograms = new();

                budgetLoadError =
                    $"Unable to load approved programs. " +
                    $"HTTP {(int)response.StatusCode}. " +
                    $"{body}";

                Console.WriteLine(
                    budgetLoadError
                );

                return;
            }

            if (string.IsNullOrWhiteSpace(body))
            {
                budgetPrograms = new();

                budgetLoadError =
                    "Approved program API returned empty response.";

                Console.WriteLine(
                    budgetLoadError
                );

                return;
            }

            var options =
                new System.Text.Json.JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                };

            // Supports both numeric enum JSON (3) and string enum JSON ("Approved").
            options.Converters.Add(
                new System.Text.Json.Serialization.JsonStringEnumConverter());

            var data =
                System.Text.Json.JsonSerializer.Deserialize<
                    List<BudgetProgramFilterDto>>
                (
                    body,
                    options
                );

            // OLD CSR-1 month rule preserved:
            // day <= 26 => next month only; day >= 27 => second month only.
            // Only approved programs having a planned count for that target month are shown.
            var targetMonth = GetTargetProgramMonth();
            // Financial year filtering is already done by the API using
            // BudgetProgramMains.FinancialYearId. Do not filter again by the
            // FinancialYear display text (master value is like "FY 26-27").
            budgetPrograms = (data ?? new List<BudgetProgramFilterDto>())
                .Where(x => x.Status == BudgetProgramStatus.Approved)
                .Select(x =>
                {
                    x.NumberOfPrograms = GetTargetMonthCount(x, targetMonth.Month);
                    return x;
                })
                .Where(x => x.NumberOfPrograms > 0)
                .ToList();

            Console.WriteLine($"CSR-1 target month: {targetMonth:MMMM yyyy}, eligible programs: {budgetPrograms.Count}");

            Console.WriteLine(
                $"Approved Programs Loaded: " +
                $"{budgetPrograms.Count}"
            );

            foreach (var item in budgetPrograms)
            {
                Console.WriteLine(
                    $"Program => " +
                    $"Id={item.Id}, " +
                    $"ProgramId={item.ProgramId}, " +
                    $"Type={item.ProgramType}, " +
                    $"Name={item.ProgramName}, " +
                    $"Status={item.Status}, " +
                    $"FY={item.FinancialYear}, " +
                    $"FYId={item.FinancialYearId}, " +
                    $"Budget={item.TotalBudget}, " +
                    $"Programs={item.NumberOfPrograms}"
                );
            }

            StateHasChanged();
        }
        catch (System.Text.Json.JsonException ex)
        {
            budgetPrograms = new();

            budgetLoadError =
                $"JSON deserialize error: " +
                $"{ex.Message}";

            Console.WriteLine(
                $"Approved Program JSON Error => {ex}"
            );
        }
        catch (Exception ex)
        {
            budgetPrograms = new();

            budgetLoadError =
                ex.Message;

            Console.WriteLine(
                $"Error loading approved programs: " +
                $"{ex}"
            );
        }
        finally
        {
            isBudgetDataLoading = false;
        }
    }

    private IEnumerable<BudgetProgramFilterDto> FilteredBudgetPrograms
    {
        get
        {
            // OLD availability logic preserved: show only approved target-month programs
            // that still have remaining CSR-1 program count.
            IEnumerable<BudgetProgramFilterDto> result = budgetPrograms
                .Where(x => x.Status == BudgetProgramStatus.Approved)
                .Where(x => x.NumberOfPrograms > x.CompletedPrograms);


            // Program Type
            if (!string.IsNullOrWhiteSpace(appliedProgramType))
            {
                result = result.Where(x =>
                    x.ProgramType.Equals(
                        appliedProgramType,
                        StringComparison.OrdinalIgnoreCase));
            }


            // Program Name
            if (!string.IsNullOrWhiteSpace(appliedProgramName))
            {
                result = result.Where(x =>
                    x.ProgramName.Equals(
                        appliedProgramName,
                        StringComparison.OrdinalIgnoreCase));
            }


            // Budget
            if (!string.IsNullOrWhiteSpace(appliedBudget)
                &&
                decimal.TryParse(
                    appliedBudget,
                    NumberStyles.Any,
                    CultureInfo.InvariantCulture,
                    out decimal budget))
            {
                result = result.Where(x =>
                    x.TotalBudget == budget);
            }


            // Number of Programs
            if (appliedProgramCount.HasValue)
            {
                result = result.Where(x =>
                    x.NumberOfPrograms == appliedProgramCount.Value);
            }


            // Status (enum)
            if (appliedStatus.HasValue)
            {
                result = result.Where(x =>
                    x.Status == appliedStatus.Value);
            }


            // Search
            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                result = result.Where(x =>

                    (!string.IsNullOrWhiteSpace(x.ProgramType) &&
                     x.ProgramType.Contains(
                         searchQuery,
                         StringComparison.OrdinalIgnoreCase))

                    ||

                    (!string.IsNullOrWhiteSpace(x.ProgramName) &&
                     x.ProgramName.Contains(
                         searchQuery,
                         StringComparison.OrdinalIgnoreCase))

                    ||

                    (!string.IsNullOrWhiteSpace(x.Beneficiaries) &&
                     x.Beneficiaries.Contains(
                         searchQuery,
                         StringComparison.OrdinalIgnoreCase))

                );
            }


            return result.ToList();
        }
    }

