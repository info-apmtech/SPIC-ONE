    private async Task LoadBudgetPrograms()
    {
        isBudgetDataLoading = true;
        budgetLoadError = "";

        try
        {
            budgetPrograms =
                await Http.GetFromJsonAsync<List<BudgetProgramFilterDto>>(
                    "api/Budget/program-master-list") ?? new();
        }
        catch (Exception ex)
        {
            budgetPrograms = new();
            budgetLoadError = ex.Message;
            Console.WriteLine($"Error loading BudgetPrograms: {ex.Message}");
        }
        finally
        {
            isBudgetDataLoading = false;
        }
    }

    private IEnumerable<BudgetProgramFilterDto> FilteredBudgetPrograms
    {
        get
        {
            IEnumerable<BudgetProgramFilterDto> result = budgetPrograms;


            // Only approved records
            result = result.Where(x =>
                string.IsNullOrWhiteSpace(x.Status)
                ||
                x.Status.Equals(
                    "Approved",
                    StringComparison.OrdinalIgnoreCase));


            // Program Type
            if (!string.IsNullOrWhiteSpace(appliedProgramType))
            {
                result = result.Where(x =>
                    x.ProgramType.Equals(
                        appliedProgramType,
                        StringComparison.OrdinalIgnoreCase));
            }


            // Program Name
            if (!string.IsNullOrWhiteSpace(appliedProgramName))
            {
                result = result.Where(x =>
                    x.ProgramName.Equals(
                        appliedProgramName,
                        StringComparison.OrdinalIgnoreCase));
            }


            // Budget
            if (!string.IsNullOrWhiteSpace(appliedBudget)
                &&
                decimal.TryParse(
                    appliedBudget,
                    NumberStyles.Any,
                    CultureInfo.InvariantCulture,
                    out decimal budget))
            {
                result = result.Where(x =>
                    x.TotalBudget == budget);
            }


            // Number of Programs
            if (appliedProgramCount.HasValue)
            {
                result = result.Where(x =>
                    x.NumberOfPrograms == appliedProgramCount.Value);
            }


            // Status
            if (!string.IsNullOrWhiteSpace(appliedStatus))
            {
                result = result.Where(x =>
                    x.Status.Equals(
                        appliedStatus,
                        StringComparison.OrdinalIgnoreCase));
            }


            // Search
            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                result = result.Where(x =>

                    (!string.IsNullOrWhiteSpace(x.ProgramType) &&
                     x.ProgramType.Contains(
                         searchQuery,
                         StringComparison.OrdinalIgnoreCase))

                    ||

                    (!string.IsNullOrWhiteSpace(x.ProgramName) &&
                     x.ProgramName.Contains(
                         searchQuery,
                         StringComparison.OrdinalIgnoreCase))

                    ||

                    (!string.IsNullOrWhiteSpace(x.Beneficiaries) &&
                     x.Beneficiaries.Contains(
                         searchQuery,
                         StringComparison.OrdinalIgnoreCase))

                );
            }


            return result.ToList();
        }
    }

