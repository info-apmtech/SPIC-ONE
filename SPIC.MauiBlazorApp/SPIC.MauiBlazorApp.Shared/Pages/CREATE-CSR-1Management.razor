    private class BudgetProgram
    {
        public string ProgramType { get; set; } = "";
        public string ProgramName { get; set; } = "";
        public int ApprovedPrograms { get; set; }
        public string Beneficiaries { get; set; } = "";
        public int ApprovedBudget { get; set; }
        public bool IsSelected { get; set; }
    }

    private List<BudgetProgram> programs = new()
    {
        new BudgetProgram { ProgramType = "Farmer Program", ProgramName = "Crop Protection Workshop", ApprovedPrograms = 1, Beneficiaries = "1250 Farmers", ApprovedBudget = 250000 },
        new BudgetProgram { ProgramType = "Farmer program", ProgramName = "Crop Protection Workshop", ApprovedPrograms = 1, Beneficiaries = "1250 Farmers", ApprovedBudget = 250000 },
        new BudgetProgram { ProgramType = "Dealer Program", ProgramName = "Crop Protection Workshop", ApprovedPrograms = 1, Beneficiaries = "1250 Farmers", ApprovedBudget = 250000 },
        new BudgetProgram { ProgramType = "Farmer Program", ProgramName = "Crop Protection Workshop", ApprovedPrograms = 1, Beneficiaries = "1250 Farmers", ApprovedBudget = 250000 },
        new BudgetProgram { ProgramType = "Farmer Programs", ProgramName = "Crop Protection Workshop", ApprovedPrograms = 1, Beneficiaries = "1250 Farmers", ApprovedBudget = 250000 }
    };

    private IEnumerable<BudgetProgram> GetFilteredPrograms()
    {
        if (string.IsNullOrWhiteSpace(searchQuery))
            return programs;

        return programs.Where(p => 
            p.ProgramType.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) || 
            p.ProgramName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) || 
            p.Beneficiaries.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)
        );
    }

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        selectAllChecked = (bool)(e.Value ?? false);
        foreach (var p in GetFilteredPrograms())
        {
            p.IsSelected = selectAllChecked;
        }
    }

    private void ToggleProgramSelection(BudgetProgram program, ChangeEventArgs e)
    {
        program.IsSelected = (bool)(e.Value ?? false);
        selectAllChecked = GetFilteredPrograms().All(p => p.IsSelected);
    }

    private void PopulateFormFromProgram(BudgetProgram program)
    {
        selectedProgramType = program.ProgramType;
        selectedProgramName = program.ProgramName;
        selectedBudget = program.ApprovedBudget;
        programCount = program.ApprovedPrograms;
    }

