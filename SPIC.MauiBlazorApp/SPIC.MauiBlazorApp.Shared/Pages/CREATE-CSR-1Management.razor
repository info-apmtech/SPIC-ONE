    private const int MaxFocusProducts = 3;

    // ========================================
    // FOCUS 1 - ADD PRODUCT
    // ========================================

    private void AddFocusProduct1()
    {
        if (selectedFocusProduct1Id <= 0)
            return;

        if (!focusCrop1Ids.Any())
        {
            ShowCSRPopup("Please select Focus Crop 1 first.", false);
            selectedFocusProduct1Id = 0;
            return;
        }

        if (focusProduct1Ids.Contains(selectedFocusProduct1Id))
        {
            selectedFocusProduct1Id = 0;
            return;
        }

        if (focusProduct1Ids.Count >= MaxFocusProducts)
        {
            ShowCSRPopup("Maximum 3 products allowed for Focus Crop 1.", false);
            selectedFocusProduct1Id = 0;
            return;
        }

        focusProduct1Ids.Add(selectedFocusProduct1Id);

        selectedFocusProduct1Id = 0;
    }

    private void RemoveFocusProduct1(int productId)
    {
        focusProduct1Ids.Remove(productId);
        StateHasChanged();
    }


