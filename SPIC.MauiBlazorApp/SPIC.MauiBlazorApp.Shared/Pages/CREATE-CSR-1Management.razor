    private int programCount = 0;

    private int TotalBudget => (selectedBudget ?? 0) * programCount;

    private string TotalBudgetFormatted => TotalBudget.ToString("C0", System.Globalization.CultureInfo.CreateSpecificCulture("en-IN"));

    private string selectedBudgetStr
    {
        get => selectedBudget?.ToString() ?? "";
        set
        {
            if (int.TryParse(value, out int result))
                selectedBudget = result;
            else
                selectedBudget = null;
        }
    }

