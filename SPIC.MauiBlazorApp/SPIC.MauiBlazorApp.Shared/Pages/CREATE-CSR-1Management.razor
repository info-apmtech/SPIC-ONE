@page "/CREATE-CSR-1Management"

@using System.Linq
@using System.Globalization
@using System.Net.Http.Json
@using SPIC.Core.DTOs
@using SPIC.Core.Entities
@inject NavigationManager Navigation
@inject HttpClient Http
@inject ToastService Toast
@inject SPIC.MauiBlazorApp.Shared.Services.LoginState loginState
@if (loginState.IsAdmin)
{
    <div class="p-4">
        <div class="alert alert-info d-flex align-items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2z" />
            </svg>
            <div>
                CSR-1 creation is not available for Admin role. Redirecting to <a href="/CSR-1List" class="alert-link">CSR-1 Management</a>...
            </div>
        </div>
    </div>
}
else
{
    <div class="container-fluid py-4 px-0 csr1c-page">

        <!-- Header Section -->
        <PageHeader Title="CSR-1 Program - Wise Budget Allocation"
                    Subtitle="View Approved program - wise budget allocations and apply for CSR-1"
                    CssClass="csr-page-header">
            <Actions>
                <button class="csr-action-btn-outline">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>
                    Refresh Data
                </button>
                <button class="csr-action-btn-outline">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                    Excel
                </button>
                <button class="csr-action-btn-outline">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                    PDF
                </button>
                <button class="csr-action-btn-solid">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                    Send Mail
                </button>
            </Actions>
        </PageHeader>

        <!-- Summary Cards Grid -->
        <div class="csr-stats-grid-4">
            <!-- Farmers Programs Card -->
            <div class="csr-alloc-card theme-farmers">
                <div class="csr-alloc-content">
                    <span class="csr-alloc-label">Farmers Programs</span>
                    <span class="csr-alloc-value">18</span>
                    <span class="csr-alloc-sub">Approved Programs</span>
                </div>
                <div class="csr-alloc-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                </div>
            </div>

            <!-- Dealer Program Card -->
            <div class="csr-alloc-card theme-dealer">
                <div class="csr-alloc-content">
                    <span class="csr-alloc-label">Dealer Program</span>
                    <span class="csr-alloc-value">18</span>
                    <span class="csr-alloc-sub">Approved Programs</span>
                </div>
                <div class="csr-alloc-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                    </svg>
                </div>
            </div>

            <!-- Approved Budget Card -->
            <div class="csr-alloc-card theme-approved">
                <div class="csr-alloc-content">
                    <span class="csr-alloc-label">Approved Budget</span>
                    <span class="csr-alloc-value">₹ 50,00,000</span>
                    <span class="csr-alloc-sub">Total Approved</span>
                </div>
                <div class="csr-alloc-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="16" y1="13" x2="8" y2="13"></line>
                        <line x1="16" y1="17" x2="8" y2="17"></line>
                        <polyline points="10 9 9 9 8 9"></polyline>
                    </svg>
                </div>
            </div>

            <!-- Remaining Budget Card -->
            <div class="csr-alloc-card theme-remaining">
                <div class="csr-alloc-content">
                    <span class="csr-alloc-label">Remaining Budget</span>
                    <span class="csr-alloc-value">₹ 18,75,000</span>
                    <span class="csr-alloc-sub">Available Balance</span>
                </div>
                <div class="csr-alloc-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21.21 15.89A10 10 0 1 1 8 2.83"></path>
                        <path d="M22 12A10 10 0 0 0 12 2v10z"></path>
                    </svg>
                </div>
            </div>
        </div>

        <!-- Info Alert Banner -->
        <div class="csr-info-banner">
            <div class="csr-banner-left">
                <div class="csr-banner-icon-info">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="16" x2="12" y2="12"></line>
                        <line x1="12" y1="8" x2="12.01" y2="8"></line>
                    </svg>
                </div>
                <div class="csr-banner-text">
                    <h4>Only approved budget allocations are show below</h4>
                    <p>You can apply for CSR-1 against these approved programs. Showing plans for @GetTargetProgramMonth().ToString("MMMM yyyy", CultureInfo.GetCultureInfo("en-IN")) only.</p>
                </div>
            </div>
            <div class="csr-banner-right">
                <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                    <line x1="8" y1="14" x2="8" y2="14.01"></line>
                    <line x1="8" y1="18" x2="8" y2="18.01"></line>
                    <line x1="12" y1="14" x2="12" y2="14.01"></line>
                    <line x1="12" y1="18" x2="12" y2="18.01"></line>
                    <line x1="16" y1="14" x2="16" y2="14.01"></line>
                    <line x1="16" y1="18" x2="16" y2="18.01"></line>
                </svg>
            </div>
        </div>

        <!-- ========================= -->
        <!-- Budget Plan Filter Section -->
        <!-- ========================= -->
        @if (!isFormView)
        {
            <div class="csr-filter-card">

                <!-- Filter Header -->
                <div class="csr-filter-header">
                    <div class="csr-filter-title">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="15"
                             height="15"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round">
                            <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
                        </svg>

                        <span>Filters</span>
                    </div>

                    <button type="button"
                            class="csr-filter-collapse-btn"
                            @onclick="ToggleFilters">

                        @if (showFilters)
                        {
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 width="14"
                                 height="14"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 stroke-linecap="round"
                                 stroke-linejoin="round">
                                <polyline points="18 15 12 9 6 15"></polyline>
                            </svg>
                        }
                        else
                        {
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 width="14"
                                 height="14"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 stroke-linecap="round"
                                 stroke-linejoin="round">
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                        }

                    </button>
                </div>


                @if (showFilters)
                {
                    <div class="csr-filter-body">

                        <!-- First Row -->
                        <div class="csr-filter-grid">

                            <!-- Program Type -->
                            <div class="csr-filter-group">
                                <label>Program Type</label>

                                <select class="csr-filter-control"
                                        @bind="filterProgramType"
                                        @bind:after="OnFilterProgramTypeChanged">

                                    <option value="">Select Program Type</option>

                                    @foreach (var item in ProgramTypes)
                                    {
                                        <option value="@item">@item</option>
                                    }

                                </select>
                            </div>


                            <!-- Program Name -->
                            <div class="csr-filter-group">
                                <label>Program Name</label>

                                <select class="csr-filter-control"
                                        @bind="filterProgramName"
                                        @bind:after="OnFilterProgramNameChanged">

                                    <option value="">Select Program Name</option>

                                    @foreach (var item in ProgramNames)
                                    {
                                        <option value="@item">@item</option>
                                    }

                                </select>
                            </div>


                            <!-- Budget -->
                            <div class="csr-filter-group">
                                <label>Budget</label>

                                <select class="csr-filter-control"
                                        @bind="filterBudget">

                                    <option value="">Select Budget</option>

                                    @foreach (var budget in BudgetAmounts)
                                    {
                                        <option value="@budget">
                                            ₹@budget.ToString("N0", CultureInfo.CreateSpecificCulture("en-IN"))
                                        </option>
                                    }

                                </select>
                            </div>


                            <!-- No of Program -->
                            <div class="csr-filter-group">
                                <label>No of Program</label>

                                <input type="number"
                                       class="csr-filter-control"
                                       placeholder="Enter program count"
                                       min="0"
                                       @bind="filterProgramCount"
                                       @bind:event="oninput" />
                            </div>

                        </div>


                        <!-- Bottom Row -->
                        <div class="csr-filter-bottom">

                            <!-- Status -->
                            <div class="csr-filter-group csr-filter-status">
                                <label>Status</label>

                                <select class="csr-filter-control"
                                        @bind="filterStatus">

                                    <option value="">All Status</option>
                                    @foreach (var status in BudgetProgramStatusOptions)
                                    {
                                        <option value="@status">@status</option>
                                    }

                                </select>
                            </div>


                            <!-- Buttons -->
                            <div class="csr-filter-actions">

                                <button type="button"
                                        class="csr-filter-clear-btn"
                                        @onclick="ClearFilters">

                                    <svg xmlns="http://www.w3.org/2000/svg"
                                         width="13"
                                         height="13"
                                         viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="2"
                                         stroke-linecap="round"
                                         stroke-linejoin="round">
                                        <line x1="18" y1="6" x2="6" y2="18"></line>
                                        <line x1="6" y1="6" x2="18" y2="18"></line>
                                    </svg>

                                    Clear All
                                </button>


                                <button type="button"
                                        class="csr-filter-apply-btn"
                                        @onclick="ApplyFilters">

                                    <svg xmlns="http://www.w3.org/2000/svg"
                                         width="13"
                                         height="13"
                                         viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="2"
                                         stroke-linecap="round"
                                         stroke-linejoin="round">
                                        <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
                                    </svg>

                                    Apply Filters
                                </button>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }

        <!-- Budget Plan List Card - SpicDataTable -->
        @if (!isFormView)
        {
            @if (!string.IsNullOrWhiteSpace(budgetLoadError))
            {
                <div class="alert alert-danger mb-3" role="alert">
                    @budgetLoadError
                </div>
            }

            <SpicDataTable TItem="BudgetProgramFilterDto"
                           Items="@FilteredBudgetPrograms"
                           IsLoading="@isBudgetDataLoading"
                           Title="Budget plan list"
                           FileName="CSR1_Budget_Plan"
                           SearchText="@searchQuery"
                           EmptyTitle="No Budget Data"
                           EmptyMessage="No approved budget program records found."
                           ExportColumns="@GetBudgetPlanExportColumns()">

                <FilterControls>
                    <div class="search-box">
                        <i class="bi bi-search"></i>
                        <input type="text"
                               placeholder="Search Program..."
                               @bind="searchQuery"
                               @bind:event="oninput"
                               @bind:after="OnTableSearchChanged" />
                    </div>
                </FilterControls>

                <TableHeader>
                    <th style="width:60px;">
                        <input type="checkbox"
                               checked="@selectAllChecked"
                               @onchange="ToggleSelectAll" />
                    </th>
                    <th>Program Type</th>
                    <th>Program Name</th>
                    <th>Number of Programs</th>
                    <th>Completed Programs</th>
                    <th>Remaining Programs</th>
                    <th>Beneficiaries</th>
                    <th>Approved Budget</th>
                    <th style="text-align:right;">Action</th>
                </TableHeader>

                <TableRow Context="program">
                    <td>
                        <input type="checkbox"
                               checked="@program.IsSelected"
                               @onchange="(e) => ToggleProgramSelection(program, e)" />
                    </td>
                    <td>@program.ProgramType</td>
                    <td>@program.ProgramName</td>
                    <td>@program.NumberOfPrograms</td>
                    <td>@program.CompletedPrograms</td>
                    <td>@program.RemainingPrograms</td>
                    <td>
                        @(string.IsNullOrWhiteSpace(program.Beneficiaries)
                            ? "-"
                            : program.Beneficiaries)
                    </td>
                    <td>
                        ₹@program.TotalBudget.ToString(
                                                                                                                                                                                                                                                                                                                                                                                                                                            "N0",
                                                                                                                                                                                                                                                                                                                                                                                                                                            CultureInfo.CreateSpecificCulture("en-IN"))
                    </td>
                    <td style="text-align:right;">
                        <button type="button"
                                class="csr-apply-btn"
                                @onclick="() => PopulateFormFromProgram(program)">
                            Apply CSR 1
                        </button>
                    </td>
                </TableRow>

            </SpicDataTable>
        }

        <!-- CSR-1 Form Section (shown after "Apply CSR 1" is selected) -->
        @if (isFormView)
        {
            <!-- Back / Change Program -->
            <div class="csr-back-bar">
                <button type="button" class="csr-back-btn" @onclick="BackToProgramList">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="19" y1="12" x2="5" y2="12"></line>
                        <polyline points="12 19 5 12 12 5"></polyline>
                    </svg>
                    Back / Change Program
                </button>
                @if (!string.IsNullOrWhiteSpace(selectedProgramName))
                {
                    <span class="csr-back-context">Applying CSR-1 for <strong>@selectedProgramName</strong></span>
                }
            </div>

            <!-- Allocate Budget Form Card -->
            <div class="csr-section-card">
                <h2 class="csr-section-title">CSR-1 Plan Details</h2>

                <div class="csr-form-fields-grid">

                    <!-- Program Type -->
                    <div class="csr-form-group">
                        <label class="csr-form-label">Program Type</label>
                        <select class="csr-form-select"
                                @bind="selectedProgramType"
                                @bind:after="OnSelectedProgramTypeChanged">
                            <option value="">Select program type</option>
                            @foreach (var item in ProgramTypes)
                            {
                                <option value="@item">@item</option>
                            }
                        </select>
                    </div>

                    <!-- Program Name -->
                    <div class="csr-form-group">
                        <label class="csr-form-label">Program Name</label>
                        <select class="csr-form-select"
                                @bind="selectedProgramName"
                                @bind:after="OnSelectedProgramNameChanged">
                            <option value="">Select program name</option>
                            @foreach (var item in SelectedProgramNames)
                            {
                                <option value="@item">@item</option>
                            }
                        </select>
                    </div>

                    <!-- Number of Programs -->
                    <div class="csr-form-group">
                        <label class="csr-form-label">Number of Programs</label>
                        <input type="number"
                               class="csr-form-control"
                               placeholder="Enter number of programs"
                               @bind="programCount"
                               @bind:event="oninput"
                               min="0" />
                    </div>

                    <!-- Budget -->
                    <div class="csr-form-group">
                        <label class="csr-form-label">Budget</label>
                        <input type="number"
                               class="csr-form-control"
                               placeholder="Enter budget"
                               min="0"
                               step="0.01"
                               @bind="selectedBudget"
                               @bind:event="oninput" />
                    </div>

                    <!-- HQ -->
                    <div class="csr-form-group">
                        <label class="csr-form-label">HQ</label>
                        <select class="csr-form-select"
                                @bind="selectedHQId">

                            <option value="0">
                                Select HQ
                            </option>

                            @foreach (var item in Headquarters)
                            {
                                <option value="@item.Id">
                                    @item.HeadquarterName
                                </option>
                            }

                        </select>
                    </div>

                    <!-- Location -->
                    <div class="csr-form-group">
                        <label class="csr-form-label">Location</label>
                        <select class="csr-form-select"
                                @bind="selectedZoneId">

                            <option value="0">
                                Select location
                            </option>


                            @foreach (var item in Zones)
                            {
                                <option value="@item.Id">
                                    @item.ZoneName
                                </option>
                            }

                        </select>
                    </div>

                    <!-- Responsible Person -->
                    <div class="csr-form-group">
                        <label class="csr-form-label">Responsible Person</label>
                        <select class="csr-form-select"
                                @bind="selectedEmployeeId">

                            <option value="0">
                                Select responsible person
                            </option>


                            @foreach (var item in Employees)
                            {
                                <option value="@item.Id">
                                    @item.Name - @item.UserName
                                </option>
                            }

                        </select>
                    </div>

                    <!-- Date -->
                    <div class="csr-form-group">
                        <label class="csr-form-label">Date</label>
                        <input type="date"
                               class="csr-form-control"
                               @bind="selectedDate"
                               min="@ProgramMinDate"
                               max="@ProgramMaxDate" />
                    </div>

                </div>
            </div>

            <!-- Focus Details Section -->
            <div class="csr-section-card">
                <h2 class="csr-section-title">Focus Details</h2>
                <div class="csr-focus-grid-3">

                    <!-- Focus 1 -->
                    <div class="csr-focus-card">
                        <div class="csr-form-group">
                            <label class="csr-form-label">Focused Crop</label>

                            @if (focusCrop1Ids.Any())
                            {
                                <div class="csr-selected-products">
                                    @foreach (var cropId in focusCrop1Ids)
                                    {
                                        var crop = Crops.FirstOrDefault(x => x.Id == cropId);
                                        if (crop != null)
                                        {
                                            <span class="csr-product-chip">
                                                <span>@crop.Name</span>
                                                <button type="button"
                                                        class="csr-product-chip-remove"
                                                        title="Remove"
                                                        @onclick="() => RemoveFocusCrop1(cropId)">
                                                    <i class="bi bi-x"></i>
                                                </button>
                                            </span>
                                        }
                                    }
                                </div>
                            }

                            <select class="csr-form-select"
                                    @bind="selectedFocusCrop1Id"
                                    @bind:after="AddFocusCrop1">
                                <option value="0">Select Crop</option>
                                @foreach (var item in Crops)
                                {
                                    @if (!focusCrop1Ids.Contains(item.Id))
                                    {
                                        <option value="@item.Id">@item.Name</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="csr-form-group">
                            <label class="csr-form-label">Focused Product</label>

                            @if (focusProduct1Ids.Any())
                            {
                                <div class="csr-selected-products">
                                    @foreach (var productId in focusProduct1Ids)
                                    {
                                        var product = Products.FirstOrDefault(x => x.Id == productId);
                                        if (product != null)
                                        {
                                            <span class="csr-product-chip">
                                                <span>@product.Name</span>
                                                <button type="button"
                                                        class="csr-product-chip-remove"
                                                        title="Remove"
                                                        @onclick="() => RemoveFocusProduct1(productId)">
                                                    <i class="bi bi-x"></i>
                                                </button>
                                            </span>
                                        }
                                    }
                                </div>
                            }

                            <select class="csr-form-select"
                                    @bind="selectedFocusProduct1Id"
                                    @bind:after="AddFocusProduct1">
                                <option value="0">Select Product</option>
                                @foreach (var item in Products)
                                {
                                    @if (!focusProduct1Ids.Contains(item.Id))
                                    {
                                        <option value="@item.Id">@item.Name</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <!-- Focus 2 -->
                    <div class="csr-focus-card">
                        <div class="csr-form-group">
                            <label class="csr-form-label">Focused Crop</label>

                            @if (focusCrop2Ids.Any())
                            {
                                <div class="csr-selected-products">
                                    @foreach (var cropId in focusCrop2Ids)
                                    {
                                        var crop = Crops.FirstOrDefault(x => x.Id == cropId);
                                        if (crop != null)
                                        {
                                            <span class="csr-product-chip">
                                                <span>@crop.Name</span>
                                                <button type="button"
                                                        class="csr-product-chip-remove"
                                                        title="Remove"
                                                        @onclick="() => RemoveFocusCrop2(cropId)">
                                                    <i class="bi bi-x"></i>
                                                </button>
                                            </span>
                                        }
                                    }
                                </div>
                            }

                            <select class="csr-form-select"
                                    @bind="selectedFocusCrop2Id"
                                    @bind:after="AddFocusCrop2">
                                <option value="0">Select Crop (Optional)</option>
                                @foreach (var item in Crops)
                                {
                                    @if (!focusCrop2Ids.Contains(item.Id))
                                    {
                                        <option value="@item.Id">@item.Name</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="csr-form-group">
                            <label class="csr-form-label">Focused Product</label>

                            @if (focusProduct2Ids.Any())
                            {
                                <div class="csr-selected-products">
                                    @foreach (var productId in focusProduct2Ids)
                                    {
                                        var product = Products.FirstOrDefault(x => x.Id == productId);
                                        if (product != null)
                                        {
                                            <span class="csr-product-chip">
                                                <span>@product.Name</span>
                                                <button type="button"
                                                        class="csr-product-chip-remove"
                                                        title="Remove"
                                                        @onclick="() => RemoveFocusProduct2(productId)">
                                                    <i class="bi bi-x"></i>
                                                </button>
                                            </span>
                                        }
                                    }
                                </div>
                            }

                            <select class="csr-form-select"
                                    @bind="selectedFocusProduct2Id"
                                    @bind:after="AddFocusProduct2">
                                <option value="0">Select Product</option>
                                @foreach (var item in Products)
                                {
                                    @if (!focusProduct2Ids.Contains(item.Id))
                                    {
                                        <option value="@item.Id">@item.Name</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <!-- Focus 3 -->
                    <div class="csr-focus-card">
                        <div class="csr-form-group">
                            <label class="csr-form-label">Focused Crop</label>

                            @if (focusCrop3Ids.Any())
                            {
                                <div class="csr-selected-products">
                                    @foreach (var cropId in focusCrop3Ids)
                                    {
                                        var crop = Crops.FirstOrDefault(x => x.Id == cropId);
                                        if (crop != null)
                                        {
                                            <span class="csr-product-chip">
                                                <span>@crop.Name</span>
                                                <button type="button"
                                                        class="csr-product-chip-remove"
                                                        title="Remove"
                                                        @onclick="() => RemoveFocusCrop3(cropId)">
                                                    <i class="bi bi-x"></i>
                                                </button>
                                            </span>
                                        }
                                    }
                                </div>
                            }

                            <select class="csr-form-select"
                                    @bind="selectedFocusCrop3Id"
                                    @bind:after="AddFocusCrop3">
                                <option value="0">Select Crop (Optional)</option>
                                @foreach (var item in Crops)
                                {
                                    @if (!focusCrop3Ids.Contains(item.Id))
                                    {
                                        <option value="@item.Id">@item.Name</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="csr-form-group">
                            <label class="csr-form-label">Focused Product</label>

                            @if (focusProduct3Ids.Any())
                            {
                                <div class="csr-selected-products">
                                    @foreach (var productId in focusProduct3Ids)
                                    {
                                        var product = Products.FirstOrDefault(x => x.Id == productId);
                                        if (product != null)
                                        {
                                            <span class="csr-product-chip">
                                                <span>@product.Name</span>
                                                <button type="button"
                                                        class="csr-product-chip-remove"
                                                        title="Remove"
                                                        @onclick="() => RemoveFocusProduct3(productId)">
                                                    <i class="bi bi-x"></i>
                                                </button>
                                            </span>
                                        }
                                    }
                                </div>
                            }

                            <select class="csr-form-select"
                                    @bind="selectedFocusProduct3Id"
                                    @bind:after="AddFocusProduct3">
                                <option value="0">Select Product</option>
                                @foreach (var item in Products)
                                {
                                    @if (!focusProduct3Ids.Contains(item.Id))
                                    {
                                        <option value="@item.Id">@item.Name</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Expense Breakdown Section -->
            <!-- Expense Breakdown Section -->
            <div class="csr-section-card">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                    <h2 class="csr-section-title mb-0">Expense Breakdown</h2>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="badge @(selectedBudget.HasValue && TotalExpense > selectedBudget.Value ? "bg-danger" : "bg-primary") px-3 py-2" style="font-size: 13px;">
                            Total Expenses: ₹@TotalExpense.ToString("N2", CultureInfo.CreateSpecificCulture("en-IN"))
                        </span>
                        @if (selectedBudget.HasValue && selectedBudget.Value > 0)
                        {
                            var remaining = selectedBudget.Value - TotalExpense;
                            @if (remaining >= 0)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2" style="font-size: 13px;">
                                    Remaining: ₹@remaining.ToString("N2", CultureInfo.CreateSpecificCulture("en-IN"))
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger text-white px-3 py-2" style="font-size: 13px;">
                                    Exceeded by: ₹@Math.Abs(remaining).ToString("N2", CultureInfo.CreateSpecificCulture("en-IN"))
                                </span>
                            }
                        }
                    </div>
                </div>

                @if (selectedBudget.HasValue && selectedBudget.Value > 0 && TotalExpense > selectedBudget.Value)
                {
                    <div class="alert alert-danger py-2 mb-3 d-flex align-items-center gap-2" role="alert">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-exclamation-triangle-fill flex-shrink-0" viewBox="0 0 16 16">
                            <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z" />
                        </svg>
                        <div>
                            <strong>Budget Exceeded:</strong> Total expense breakdown (₹@TotalExpense.ToString("N2", CultureInfo.CreateSpecificCulture("en-IN"))) cannot exceed the allocated budget of ₹@selectedBudget.Value.ToString("N2", CultureInfo.CreateSpecificCulture("en-IN")). Please adjust expenses to be within budget before saving.
                        </div>
                    </div>
                }

                <!-- First two rows (4 Columns) -->
                <div class="csr-grid-4">

                    <div class="csr-form-group">
                        <label class="csr-form-label">Printing & Stationary</label>
                        <input type="number" class="csr-form-control" placeholder="0" min="0" step="0.01" @bind="printStationary" @bind:event="oninput">
                    </div>

                    <div class="csr-form-group">
                        <label class="csr-form-label">Publicity Material</label>
                        <input type="number" class="csr-form-control" placeholder="0" min="0" step="0.01" @bind="publicityMaterial" @bind:event="oninput">
                    </div>

                    <div class="csr-form-group">
                        <label class="csr-form-label">Stage Arrangements</label>
                        <input type="number" class="csr-form-control" placeholder="0" min="0" step="0.01" @bind="stageArrangements" @bind:event="oninput">
                    </div>

                    <div class="csr-form-group">
                        <label class="csr-form-label">Service Charges - LCA</label>
                        <input type="number" class="csr-form-control" placeholder="0" min="0" step="0.01" @bind="serviceCharges" @bind:event="oninput">
                    </div>

                    <div class="csr-form-group">
                        <label class="csr-form-label">Transport / Rent</label>
                        <input type="number" class="csr-form-control" placeholder="0" min="0" step="0.01" @bind="transportRent" @bind:event="oninput">
                    </div>

                    <div class="csr-form-group">
                        <label class="csr-form-label">Jeep Running Expenses</label>
                        <input type="number" class="csr-form-control" placeholder="0" min="0" step="0.01" @bind="jeepExpenses" @bind:event="oninput">
                    </div>

                    <div class="csr-form-group">
                        <label class="csr-form-label">Refreshments</label>
                        <input type="number" class="csr-form-control" placeholder="0" min="0" step="0.01" @bind="refreshments" @bind:event="oninput">
                    </div>

                    <div class="csr-form-group">
                        <label class="csr-form-label">Inputs</label>
                        <input type="number" class="csr-form-control" placeholder="0" min="0" step="0.01" @bind="inputs" @bind:event="oninput">
                    </div>

                </div>

                <!-- Last row (3 Columns) -->
                <div class="csr-grid-3">

                    <div class="csr-form-group">
                        <label class="csr-form-label">Photography</label>
                        <input type="number" class="csr-form-control" placeholder="0" min="0" step="0.01" @bind="photography" @bind:event="oninput">
                    </div>

                    <div class="csr-form-group">
                        <label class="csr-form-label">Compliments</label>
                        <input type="number" class="csr-form-control" placeholder="0" min="0" step="0.01" @bind="compliments" @bind:event="oninput">
                    </div>

                    <div class="csr-form-group">
                        <label class="csr-form-label">Others</label>
                        <input type="number" class="csr-form-control" placeholder="0" min="0" step="0.01" @bind="othersExpense" @bind:event="oninput">
                    </div>

                </div>

            </div>

            <!-- Form Actions -->
            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-danger mb-3">
                    @errorMessage
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(successMessage))
            {
                <div class="alert alert-success mb-3">
                    @successMessage
                </div>
            }
            <div class="csr-form-actions-bottom">
                <button class="csr-form-btn-secondary" @onclick="HandleSaveDraft">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                        <polyline points="17 21 17 13 7 13 7 21"></polyline>
                        <polyline points="7 3 7 8 15 8"></polyline>
                    </svg>
                    Save Draft
                </button>
                <button type="button"
                        class="csr-form-btn-primary"
                        @onclick="HandleSubmitValidation"
                        disabled="@isSubmitting">

                    @if (isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm"
                              role="status"
                              aria-hidden="true">
                        </span>

                        <span>Submitting...</span>
                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="16"
                             height="16"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <line x1="22"
                                  y1="2"
                                  x2="11"
                                  y2="13">
                            </line>

                            <polygon points="22 2 15 22 11 13 2 9 22 2">
                            </polygon>
                        </svg>

                        <span>Submit for Validation</span>
                    }
                </button>
            </div>
        }

    </div>
}

@if (showCSRPopup)
{
    <div class="csr-toast-overlay">
        <div class="csr-toast-popup" role="alertdialog" aria-modal="true"
             aria-labelledby="csr-popup-title" aria-describedby="csr-popup-message">
            <div class="csr-toast-icon @(csrPopupSuccess ? "success" : "error")" aria-hidden="true">
                <i class="bi @(csrPopupSuccess ? "bi-check-circle-fill" : "bi-x-circle-fill")"></i>
            </div>
            <h3 id="csr-popup-title">@(csrPopupSuccess ? "Success" : "Action Failed")</h3>
            <p id="csr-popup-message">@csrPopupMessage</p>
            <button type="button" class="csr-popup-confirm" @onclick="CloseCSRPopup">OK</button>
        </div>
    </div>
}

