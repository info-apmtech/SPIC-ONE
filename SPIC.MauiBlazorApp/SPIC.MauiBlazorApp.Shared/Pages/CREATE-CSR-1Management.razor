    private async Task HandleSubmitValidation()
    {
        if (isSubmitting)
            return;

        errorMessage = "";
        successMessage = "";

        try
        {
            // =========================================================
            // VALIDATION
            // =========================================================

            if (string.IsNullOrWhiteSpace(selectedProgramType))
            {
                ShowCSRPopup("Please select Program Type.", false);
                return;
            }

            if (string.IsNullOrWhiteSpace(selectedProgramName))
            {
                ShowCSRPopup("Please select Program Name.", false);
                return;
            }

            if (programCount <= 0)
            {
                ShowCSRPopup("Please enter Number of Programs.", false);
                return;
            }

            if (!selectedBudget.HasValue ||
                selectedBudget.Value <= 0)
            {
                ShowCSRPopup("Please enter Budget.", false);
                return;
            }

            // =========================================================
            // FIND SELECTED PROGRAM
            // =========================================================

            // var selectedProgram =
            //     budgetPrograms.FirstOrDefault(x =>
            //         !string.IsNullOrWhiteSpace(x.ProgramType) &&
            //         !string.IsNullOrWhiteSpace(x.ProgramName) &&
            //         x.ProgramType.Equals(
            //             selectedProgramType,
            //             StringComparison.OrdinalIgnoreCase) &&
            //         x.ProgramName.Equals(
            //             selectedProgramName,
            //             StringComparison.OrdinalIgnoreCase));
            var selectedProgram = budgetPrograms.FirstOrDefault(x =>
    x.Id == selectedBudgetProgramId);
            if (selectedProgram == null)
            {
                ShowCSRPopup(
                    "Unable to find the selected program details.", false);
                return;
            }

            if (selectedProgram.ProgramId <= 0)
            {
                ShowCSRPopup(
                    "Invalid Program Id received from Budget data.", false);
                return;
            }

            // Check if State scope (SMDO/SMD or State-level budget program without HQ)
            bool isStateScope = loginState.IsStateRole ||
                                (!selectedProgram.HeadQuartersId.HasValue || selectedProgram.HeadQuartersId.Value <= 0);

            if (!isStateScope && selectedHQId <= 0)
            {
                ShowCSRPopup("Please select HQ.", false);
                return;
            }

            if (!isStateScope && selectedZoneId <= 0)
            {
                ShowCSRPopup("Please select Location.", false);
                return;
            }

            if (selectedEmployeeId <= 0)
            {
                ShowCSRPopup("Please select Responsible Person.", false);
                return;
            }

            if (!selectedDate.HasValue || selectedDate.Value == default)
            {
                ShowCSRPopup("Please select Date.", false);
                return;
            }

            // =========================================================
            // EXPENSE BREAKDOWN VALIDATION
            // Must be within selected budget
            // =========================================================
            if (TotalExpense > selectedBudget.Value)
            {
                ShowCSRPopup($"Total Expense Breakdown (₹{TotalExpense:N2}) exceeds the allocated Budget (₹{selectedBudget.Value:N2}). Total expenses must be within ₹{selectedBudget.Value:N2}.", false);
                return;
            }
            if (TotalExpense <= 0)
            {
                ShowCSRPopup(
                    "Please enter at least one expense amount.",
                    false);
                return;
            }
            // =========================================================
            // EXPENSE BREAKDOWN VALIDATION
            // Total Expense must exactly match Selected Budget
            // =========================================================

            // if (Math.Round(TotalExpense, 2) != Math.Round(selectedBudget.Value, 2))
            // {
            //     ShowCSRPopup(
            //         $"Total Expense (₹{TotalExpense:N2}) must be equal to " +
            //         $"Selected Budget (₹{selectedBudget.Value:N2}). " +
            //         $"Difference: ₹{Math.Abs(TotalExpense - selectedBudget.Value):N2}."
            //     , false);

            //     return;
            // }


            // =========================================================
            // OPTIONAL FOCUS VALIDATION
            // If crop is selected, at least one product is required.
            // =========================================================

           
            // ------------------------------------------
            // FOCUS 1 - Both Crop and Product mandatory
            // ------------------------------------------

            if (!focusCrop1Ids.Any())
            {
                ShowCSRPopup("Please select at least one Focus Crop 1.", false);
                return;
            }

            if (focusProduct1Ids.Count == 0)
            {
                ShowCSRPopup("Please select at least one Product for Focus Crop 1.", false);
                return;
            }

            // ------------------------------------------
            // FOCUS 2 - Optional
            // If Crop 2 selected, Product 2 mandatory
            // ------------------------------------------

            if (focusCrop2Ids.Any() && focusProduct2Ids.Count == 0)
            {
                ShowCSRPopup("Please select at least one Product for Focus Crop 2.", false);
                return;
            }

            // ------------------------------------------
            // FOCUS 3 - Optional
            // If Crop 3 selected, Product 3 mandatory
            // ------------------------------------------

            if (focusCrop3Ids.Any() && focusProduct3Ids.Count == 0)
            {
                ShowCSRPopup("Please select at least one Product for Focus Crop 3.", false);
                return;
            }

            // ------------------------------------------
            // Maximum 3 crops/products per Focus section
            // ------------------------------------------

            if (focusCrop1Ids.Count > 3 || focusCrop2Ids.Count > 3 || focusCrop3Ids.Count > 3)
            {
                ShowCSRPopup("Maximum 3 crops allowed per Focus section.", false);
                return;
            }

            if (focusProduct1Ids.Count > 3 ||
                focusProduct2Ids.Count > 3 ||
                focusProduct3Ids.Count > 3)
            {
                ShowCSRPopup("Maximum 3 products allowed per Focus section.", false);
                return;
            }

            // Prevent products without a selected crop
            if ((!focusCrop2Ids.Any() && focusProduct2Ids.Any()) ||
                (!focusCrop3Ids.Any() && focusProduct3Ids.Any()))
            {
                ShowCSRPopup("Select a Focus Crop before selecting its products.", false);
                return;
            }



            // =========================================================
            // BUILD CSR1 MODEL
            // =========================================================

            csr1Model.ProgramId =
                selectedProgram.ProgramId;


            csr1Model.NumberOfPrograms =
                programCount;

            csr1Model.Budget =
                selectedBudget.Value;

            csr1Model.BudgetProgramId = selectedProgram.Id;

            var targetProgramMonth = GetTargetProgramMonth();

            csr1Model.ProgramMonth = targetProgramMonth.Month;
            csr1Model.ProgramYear = targetProgramMonth.Year;

            csr1Model.HeadquarterId =
                selectedHQId > 0 ? selectedHQId : null;

            csr1Model.LocationId =
                selectedZoneId > 0 ? selectedZoneId : null;

            csr1Model.ResponsiblePersonId =
    selectedEmployeeId > 0
        ? selectedEmployeeId.ToString()
        : null;

            csr1Model.CreatedAt = DateTime.Now;
            csr1Model.CSR1Date = selectedDate.Value;


            // =========================================================
            // IMPORTANT:
            // Crop/Product details are NOT saved directly in CSR1.
            //
            // They are passed through CSR1SaveRequest and saved in:
            //
            // CSR1Products1
            // CSRProducts2
            // CSRProducts3
            // =========================================================


            // =========================================================
            // EXPENSE DETAILS
            // =========================================================

            csr1Model.PrintingAndStationery =
                printStationary;

            csr1Model.PublicityMaterial =
                publicityMaterial;

            csr1Model.StageArrangements =
                stageArrangements;

            csr1Model.ServiceChargesLCA =
                serviceCharges;

            csr1Model.TransportRent =
                transportRent;

            csr1Model.JeepRunningExpenses =
                jeepExpenses;

            csr1Model.Refreshments =
                refreshments;

            csr1Model.Inputs =
                inputs;

            csr1Model.Photography =
                photography;

            csr1Model.Compliments =
                compliments;

            csr1Model.Others =
                othersExpense;


            // =========================================================
            // STATUS
            // =========================================================

            csr1Model.Status =
                CSR1Status.SubmittedForValidation;

            csr1Model.IsActive =
                true;

            if (string.IsNullOrWhiteSpace(csr1Model.CreatedBy))
            {
                csr1Model.CreatedBy = loginState.UserId ?? "";
            }

            csr1Model.UpdatedBy = loginState.UserId ?? "";


            // =========================================================
            // DEBUG
            // =========================================================

            Console.WriteLine(
                $"Selected Program Type: {selectedProgramType}");

            Console.WriteLine(
                $"Selected Program Name: {selectedProgramName}");

            Console.WriteLine(
                $"ProgramId Sending: {csr1Model.ProgramId}");

            Console.WriteLine(
                $"Crop1Ids Sending: {string.Join(",", focusCrop1Ids)}");

            Console.WriteLine(
                $"Crop1 Products: {string.Join(",", focusProduct1Ids)}");

            Console.WriteLine(
                $"Crop2Ids Sending: {string.Join(",", focusCrop2Ids)}");

            Console.WriteLine(
                $"Crop2 Products: {string.Join(",", focusProduct2Ids)}");

            Console.WriteLine(
                $"Crop3Ids Sending: {string.Join(",", focusCrop3Ids)}");

            Console.WriteLine(
                $"Crop3 Products: {string.Join(",", focusProduct3Ids)}");


            // =========================================================
            // BUILD REQUEST
            // =========================================================

            var request =
                new CSR1SaveRequest
                {
                    CSR1 =
                        csr1Model,

                    Crop1Ids =
                        focusCrop1Ids.ToList(),

                    Product1Ids =
                        focusProduct1Ids.ToList(),

                    Crop2Ids =
                        focusCrop2Ids.ToList(),

                    Product2Ids =
                        focusProduct2Ids.ToList(),

                    Crop3Ids =
                        focusCrop3Ids.ToList(),

                    Product3Ids =
                        focusProduct3Ids.ToList()
                };


            // =========================================================
            // SUBMIT
            // =========================================================

            isSubmitting = true;

            HttpResponseMessage response;


            if (csr1Model.Id == 0)
            {
                response =
                    await Http.PostAsJsonAsync(
                        "api/CSR1",
                        request);
            }
            else
            {
                response =
                    await Http.PutAsJsonAsync(
                        $"api/CSR1/{csr1Model.Id}",
                        request);
            }


            // =========================================================
            // RESPONSE
            // =========================================================

            if (response.IsSuccessStatusCode)
            {
                ShowCSRPopup(
                    "CSR1 saved successfully");

                ClearCSR1Form();
            }
            else
            {
                var apiError =
                    await response.Content
                        .ReadAsStringAsync();


                Console.WriteLine(
                    $"CSR1 API Error: {apiError}");


                string displayError = "Unable to submit CSR-1.";

                if (!string.IsNullOrWhiteSpace(apiError))
                {
                    try
                    {
                        using var errorJson = System.Text.Json.JsonDocument.Parse(apiError);
                        var root = errorJson.RootElement;

                        var stage = root.TryGetProperty("stage", out var stageValue)
                            ? stageValue.GetString()
                            : null;

                        var databaseError = root.TryGetProperty("databaseError", out var databaseValue)
                            ? databaseValue.GetString()
                            : null;

                        var message = root.TryGetProperty("message", out var messageValue)
                            ? messageValue.GetString()
                            : null;

                        displayError =
                            $"{message ?? "Unable to submit CSR-1."}" +
                            (!string.IsNullOrWhiteSpace(stage) ? $" Stage: {stage}." : "") +
                            (!string.IsNullOrWhiteSpace(databaseError) ? $" Database: {databaseError}" : "");
                    }
                    catch
                    {
                        displayError = $"Unable to submit CSR-1. {apiError}";
                    }
                }

                ShowCSRPopup(displayError, false);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"CSR1 Submit Error: {ex}");


            ShowCSRPopup(
                $"Error while submitting CSR-1: {ex.Message}", false);
        }
        finally
        {
            isSubmitting = false;
        }
    }

