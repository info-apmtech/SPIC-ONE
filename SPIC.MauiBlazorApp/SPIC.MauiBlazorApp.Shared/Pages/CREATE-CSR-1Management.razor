    // Cutoff rule: 1st-26th -> next month; 27th onwards -> month after next.
    // Always calculate in India time, regardless of server/client local timezone.
    private static DateTime GetTargetProgramMonth()
    {
        var indiaTime = TimeZoneInfo.ConvertTimeFromUtc(
            DateTime.UtcNow,
            TimeZoneInfo.FindSystemTimeZoneById("Asia/Kolkata"));

        return new DateTime(indiaTime.Year, indiaTime.Month, 1)
            .AddMonths(indiaTime.Day <= 26 ? 1 : 2);
    }

    private static decimal GetTargetMonthCount(BudgetProgramFilterDto program, int month) => month switch
    {
        1 => program.JanuaryCount,
        2 => program.FebruaryCount,
        3 => program.MarchCount,
        4 => program.AprilCount,
        5 => program.MayCount,
        6 => program.JuneCount,
        7 => program.JulyCount,
        8 => program.AugustCount,
        9 => program.SeptemberCount,
        10 => program.OctoberCount,
        11 => program.NovemberCount,
        12 => program.DecemberCount,
        _ => 0m
    };

