@page "/CREATE-CSR-1Management"


<div class="container-fluid py-4 px-0">
    
    <!-- Header Section -->
    <div class="csr-header-container">
        <h1>CSR-1 Management</h1>
    </div>

    <!-- Summary Cards Grid -->
    <div class="csr-stats-grid">
        
        <!-- Approved Budget -->
        <div class="csr-stat-card csr-theme-green">
            <div class="csr-stat-content">
                <span class="csr-stat-label">Approved Budget</span>
                <span class="csr-stat-value">₹ 50,00,000</span>
            </div>
            <div class="csr-stat-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <path d="M16 13H8"></path>
                    <path d="M16 17H8"></path>
                    <polyline points="10 9 9 9 8 9"></polyline>
                    <circle cx="17" cy="17" r="5" fill="#e6fcf1" stroke="currentColor"></circle>
                    <path d="M15.5 17l1 1 2-2" stroke="currentColor"></path>
                </svg>
            </div>
        </div>

        <!-- Allocated Budget -->
        <div class="csr-stat-card csr-theme-blue">
            <div class="csr-stat-content">
                <span class="csr-stat-label">Allocated Budget</span>
                <span class="csr-stat-value">₹ 55,000</span>
            </div>
            <div class="csr-stat-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    <path d="M9 10h6"></path>
                    <path d="M9 13h6"></path>
                    <path d="M11 10s2 0 2 1.5-2 1.5-2 1.5l3 3"></path>
                </svg>
            </div>
        </div>

        <!-- Remaining Budget -->
        <div class="csr-stat-card csr-theme-purple">
            <div class="csr-stat-content">
                <span class="csr-stat-label">Remaining Budget</span>
                <span class="csr-stat-value">₹ 49,45,000</span>
            </div>
            <div class="csr-stat-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2v20"></path>
                    <path d="M8 2h8"></path>
                    <path d="M8 22h8"></path>
                    <path d="M15.5 6L8.5 18"></path>
                    <path d="M8.5 6l7 12"></path>
                    <path d="M3.5 12a8.5 8.5 0 0 1 2.2-5.8"></path>
                    <path d="M20.5 12a8.5 8.5 0 0 1-2.2 5.8"></path>
                    <polygon points="5.5 4.5 5.5 8 2 8"></polygon>
                    <polygon points="18.5 19.5 18.5 16 22 16"></polygon>
                </svg>
            </div>
        </div>

    </div>

    <!-- CSR-1 Plan Details Section -->
    <div class="csr-section-card">
        <h2 class="csr-section-title">CSR-1 Plan Details</h2>
        
        <div class="csr-form-grid">
            
            <!-- Program Type -->
            <div class="csr-form-group">
                <label class="csr-form-label">Program Type</label>
                <select class="csr-form-select" required>
                    <option value="" disabled selected hidden>Select program type</option>
                    <option value="training">Training</option>
                    <option value="workshop">Workshop</option>
                </select>
            </div>

            <!-- Program Name -->
            <div class="csr-form-group">
                <label class="csr-form-label">Program Name</label>
                <select class="csr-form-select" required>
                    <option value="" disabled selected hidden>Select program name</option>
                    <option value="crop-protection">Crop Protection Workshop</option>
                </select>
            </div>

            <!-- Number of Programs -->
            <div class="csr-form-group">
                <label class="csr-form-label">Number of Programs</label>
                <input type="number" class="csr-form-control csr-form-number" placeholder="Enter number of programs">
            </div>

            <!-- Budget -->
            <div class="csr-form-group">
                <label class="csr-form-label">Budget</label>
                <input type="number" class="csr-form-control csr-form-number" placeholder="Enter budget">
            </div>

            <!-- HQ -->
            <div class="csr-form-group">
                <label class="csr-form-label">HQ</label>
                <select class="csr-form-select" required>
                    <option value="" disabled selected hidden>Select HQ</option>
                    <option value="hq1">Headquarters 1</option>
                </select>
            </div>

            <!-- Location -->
            <div class="csr-form-group">
                <label class="csr-form-label">Location</label>
                <select class="csr-form-select" required>
                    <option value="" disabled selected hidden>select location</option>
                    <option value="loc1">Location 1</option>
                </select>
            </div>

        </div>
    </div>

    <!-- Focus Details Section -->
    <div class="csr-section-card">
        
        <div class="csr-section-header-with-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <path d="M16 13H8"></path>
                <path d="M16 17H8"></path>
                <polyline points="10 9 9 9 8 9"></polyline>
                <rect x="13" y="14" width="6" height="5" fill="#e6fcf1" stroke="#10b981"></rect>
            </svg>
            <h2>Focus Details</h2>
        </div>

        <div class="csr-focus-grid">
            
            <!-- Focused Crop -->
            <div class="csr-form-group">
                <label class="csr-form-label">Focused Crop</label>
                <div class="csr-input-group">
                    <select class="csr-form-select" required>
                        <option value="" disabled selected hidden>Select Crop</option>
                    </select>
                    <button class="csr-btn-add" type="button">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                        </svg>
                        Add Crop
                    </button>
                </div>
            </div>

            <!-- Focused Product -->
            <div class="csr-form-group">
                <label class="csr-form-label">Focused Product</label>
                <div class="csr-input-group">
                    <select class="csr-form-select" required>
                        <option value="" disabled selected hidden>Select Product</option>
                    </select>
                    <button class="csr-btn-add" type="button">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                        </svg>
                        Add Crop
                    </button>
                </div>
            </div>

        </div>

    </div>

    <!-- Expense Breakdown Section -->
    <div class="csr-section-card">
        <h2 class="csr-section-title">Expense Breakdown</h2>

        <!-- First two rows (4 Columns) -->
        <div class="csr-grid-4">
            
            <div class="csr-form-group">
                <label class="csr-form-label">Printing & Stationary</label>
                <input type="number" class="csr-form-control csr-form-number" placeholder="0" min="0">
            </div>

            <div class="csr-form-group">
                <label class="csr-form-label">Publicity Material</label>
                <input type="number" class="csr-form-control csr-form-number" placeholder="0" min="0">
            </div>

            <div class="csr-form-group">
                <label class="csr-form-label">Stage Arrangements</label>
                <input type="number" class="csr-form-control csr-form-number" placeholder="0" min="0">
            </div>

            <div class="csr-form-group">
                <label class="csr-form-label">Service Charges - LCA</label>
                <input type="number" class="csr-form-control csr-form-number" placeholder="0" min="0">
            </div>

            <div class="csr-form-group">
                <label class="csr-form-label">Transport / Rent</label>
                <input type="number" class="csr-form-control csr-form-number" placeholder="0" min="0">
            </div>

            <div class="csr-form-group">
                <label class="csr-form-label">Jeep Running Expenses</label>
                <input type="number" class="csr-form-control csr-form-number" placeholder="0" min="0">
            </div>

            <div class="csr-form-group">
                <label class="csr-form-label">Refreshments</label>
                <input type="number" class="csr-form-control csr-form-number" placeholder="0" min="0">
            </div>

            <div class="csr-form-group">
                <label class="csr-form-label">Inputs</label>
                <input type="number" class="csr-form-control csr-form-number" placeholder="0" min="0">
            </div>

        </div>

        <!-- Last row (3 Columns) -->
        <div class="csr-grid-3">
            
            <div class="csr-form-group">
                <label class="csr-form-label">Photography</label>
                <input type="number" class="csr-form-control csr-form-number" placeholder="0" min="0">
            </div>

            <div class="csr-form-group">
                <label class="csr-form-label">Compliments</label>
                <input type="number" class="csr-form-control csr-form-number" placeholder="0" min="0">
            </div>

            <div class="csr-form-group">
                <label class="csr-form-label">Others</label>
                <input type="number" class="csr-form-control csr-form-number" placeholder="0" min="0">
            </div>

        </div>

    </div>

    <!-- Bottom Action Buttons -->
    <div class="csr-page-actions">
        
        <button class="csr-btn csr-btn-secondary" type="button">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <path d="M16 13H8"></path>
                <path d="M16 17H8"></path>
                <path d="M10 9H8"></path>
            </svg>
            Save Draft
        </button>

        <button class="csr-btn csr-btn-primary" type="button">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="22" y1="2" x2="11" y2="13"></line>
                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
            </svg>
            Submit CSR-1
        </button>

    </div>

</div>