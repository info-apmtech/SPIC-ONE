    private List<BudgetProgramFilterDto> budgetPrograms = new();

    // Program Type is loaded from BudgetPrograms/API data.
    private List<string> ProgramTypes =>
        budgetPrograms
            .Where(x => !string.IsNullOrWhiteSpace(x.ProgramType))
            .Select(x => x.ProgramType.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x)
            .ToList();

    // Filter Program Name depends on the selected filter Program Type.
    private List<string> ProgramNames =>
        budgetPrograms
            .Where(x =>
                string.IsNullOrWhiteSpace(filterProgramType) ||
                x.ProgramType.Equals(filterProgramType, StringComparison.OrdinalIgnoreCase))
            .Where(x => !string.IsNullOrWhiteSpace(x.ProgramName))
            .Select(x => x.ProgramName.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x)
            .ToList();

    // Filter Budget comes from BudgetPrograms.TotalBudget and depends on
    // Program Type + Program Name selected in the filter.
    private List<decimal> BudgetAmounts =>
        budgetPrograms
            .Where(x =>
                string.IsNullOrWhiteSpace(filterProgramType) ||
                x.ProgramType.Equals(filterProgramType, StringComparison.OrdinalIgnoreCase))
            .Where(x =>
                string.IsNullOrWhiteSpace(filterProgramName) ||
                x.ProgramName.Equals(filterProgramName, StringComparison.OrdinalIgnoreCase))
            .Where(x => x.TotalBudget > 0)
            .Select(x => x.TotalBudget)
            .Distinct()
            .OrderBy(x => x)
            .ToList();

    // Program Names for the CSR-1 form depend on selectedProgramType.
    private List<string> SelectedProgramNames =>
        budgetPrograms
            .Where(x =>
