@page "/EntryInfo"

<div class="container-fluid py-4 px-0">
    <div class="ei-wrapper">

        <!-- Page Header -->
        <div class="ei-page-header">
            <div class="ei-page-title">
                <button class="ei-back-btn" type="button" aria-label="Back">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="19" y1="12" x2="5" y2="12"></line>
                        <polyline points="12 19 5 12 12 5"></polyline>
                    </svg>
                </button>
                <h1>Entry Information</h1>
            </div>
        </div>

        <!-- Sub Header: Entry # + Active badge -->
        <div class="ei-subheader">
            <div class="ei-entry-id">Entry #001245</div>
            <span class="ei-badge ei-badge-active">Active</span>
        </div>

        <!-- Two-column area: Entry Info (left) + Lucky Draw (right) -->
        <div class="ei-two-col">

            <!-- Entry Information Card -->
            <div class="ei-card">
                <div class="ei-info-grid">

                    <div class="ei-info-item">
                        <div class="ei-info-icon ei-icon-red">
                            <svg viewBox="0 0 24 24" fill="none" stroke="#EF4444" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="4" width="18" height="18" rx="3"></rect>
                                <line x1="16" y1="2" x2="16" y2="6"></line>
                                <line x1="8" y1="2" x2="8" y2="6"></line>
                                <line x1="3" y1="10" x2="21" y2="10"></line>
                            </svg>
                        </div>
                        <div class="ei-info-text">
                            <div class="ei-info-label">Date</div>
                            <div class="ei-info-value">05 Apr 2026</div>
                        </div>
                    </div>

                    <div class="ei-info-item">
                        <div class="ei-info-icon ei-icon-blue">
                            <svg viewBox="0 0 24 24" fill="none" stroke="#3B82F6" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                <circle cx="12" cy="7" r="4"></circle>
                            </svg>
                        </div>
                        <div class="ei-info-text">
                            <div class="ei-info-label">Dealer Name</div>
                            <div class="ei-info-value">Green Valley Dealers</div>
                        </div>
                    </div>

                    <div class="ei-info-item">
                        <div class="ei-info-icon ei-icon-green">
                            <svg viewBox="0 0 24 24" fill="none" stroke="#16A34A" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                            </svg>
                        </div>
                        <div class="ei-info-text">
                            <div class="ei-info-label">Source</div>
                            <div class="ei-info-value">Fertilizer Purchase</div>
                        </div>
                    </div>

                    <div class="ei-info-item">
                        <div class="ei-info-icon ei-icon-violet">
                            <svg viewBox="0 0 24 24" fill="none" stroke="#8B5CF6" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                <circle cx="12" cy="10" r="3"></circle>
                            </svg>
                        </div>
                        <div class="ei-info-text">
                            <div class="ei-info-label">Location</div>
                            <div class="ei-info-value">Thanjavur</div>
                        </div>
                    </div>

                    <div class="ei-info-item">
                        <div class="ei-info-icon ei-icon-coral">
                            <svg viewBox="0 0 24 24" fill="none" stroke="#F97316" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
                                <path d="M2 17l10 5 10-5"></path>
                                <path d="M2 12l10 5 10-5"></path>
                            </svg>
                        </div>
                        <div class="ei-info-text">
                            <div class="ei-info-label">Product</div>
                            <div class="ei-info-value">Urea / DAP</div>
                        </div>
                    </div>

                    <div class="ei-info-item">
                        <div class="ei-info-icon ei-icon-gold">
                            <svg viewBox="0 0 24 24" fill="none" stroke="#D97706" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="12" y1="1" x2="12" y2="23"></line>
                                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                            </svg>
                        </div>
                        <div class="ei-info-text">
                            <div class="ei-info-label">Purchase Amount</div>
                            <div class="ei-info-value">₹2,500</div>
                        </div>
                    </div>

                </div>

                <div class="ei-divider"></div>

                <div class="ei-unlock-banner">
                    <span>30 More Entries To Unlock</span>
                    <span class="ei-text-gold">Gold Reward</span>
                    <span class="ei-trophy-emoji">🏆</span>
                </div>
            </div>

            <!-- Lucky Draw Info Card -->
            <div class="ei-card">
                <h3 class="ei-card-title">LUCKY DRAW INFO</h3>

                <ul class="ei-lucky-list">
                    <li>This Entry Is <strong>Eligible</strong> For Current Cycle Draw</li>
                    <li>Cycle Progress: <strong>45 / 100</strong></li>
                </ul>

                <div class="ei-progress-row">
                    <div class="ei-progress-count-wrap">
                        <span class="ei-progress-count">45</span>
                        <span class="ei-progress-total">/ 100</span>
                    </div>
                    <span class="ei-trophy-icon">🏆</span>
                </div>

                <div class="ei-progress-track">
                    <div class="ei-progress-fill"></div>
                    <div class="ei-milestone-marker"></div>
                </div>

                <div class="ei-progress-labels">
                    <span>25</span>
                    <span>50</span>
                    <span>75</span>
                    <span class="ei-gold-label">GOLD MILESTONE</span>
                </div>
            </div>

        </div>

        <!-- Verification Card (full width) -->
        <div class="ei-card">
            <h3 class="ei-card-title-dark">Verification</h3>

            <div class="ei-verify-row">
                <div class="ei-verify-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#8B5CF6" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="9" y1="13" x2="15" y2="13"></line>
                    </svg>
                </div>
                <div class="ei-verify-label">Invoice Number:</div>
                <a href="#" class="ei-verify-link">INV-2026-2456</a>
            </div>

            <div class="ei-verify-divider"></div>

            <div class="ei-verify-status">
                <span class="ei-status-active">Active</span>
                <span class="ei-status-arrow">→</span>
                <span class="ei-status-desc">This entry is valid and counted for the upcoming lucky draw</span>
            </div>
        </div>

        <!-- Action Button -->
        <div class="ei-actions">
            <button class="ei-btn-primary" type="button">Back to Entries</button>
        </div>

    </div>
</div>

