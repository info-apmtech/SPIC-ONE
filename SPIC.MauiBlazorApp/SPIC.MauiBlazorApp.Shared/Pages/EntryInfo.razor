@page "/EntryInfo"

<style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    /* Optional: Add a subtle background color to the whole page so the centered card pops out */
    /* body {
        background-color: #e9ecef; 
        font-family: system-ui, -apple-system, sans-serif;
    } */

    .phone {
        width: 100%;
        max-width: 420px; /* Sets max width for desktop */
        margin: 0 auto; /* Centers the container on the screen */
        min-height: 100vh;
        background: #f4f6f9;
        display: flex;
        flex-direction: column;
        box-shadow: 0 0 20px rgba(0,0,0,0.05); /* Adds a subtle shadow for desktop viewing */
    }

    /* Header */
    .header {
        padding: 16px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .back-btn {
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        border-radius: 8px;
    }

    .back-btn svg {
        width: 20px;
        height: 20px;
        stroke: #222;
    }

    .header-title {
        font-size: 17px;
        font-weight: 700;
        color: #1a1a1a;
    }

    .badge-active {
        background: #22c55e;
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        padding: 4px 12px;
        border-radius: 20px;
    }

    /* Content */
    .content {
        flex: 1;
        padding: 10px 16px 30px 16px;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    /* Section Title */
    .section-title {
        font-size: 16px;
        font-weight: 700;
        color: #2563eb;
        margin-bottom: 10px;
    }

    /* Card */
    .card {
        background: #fff;
        border-radius: 16px;
        padding: 18px 16px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        border: 1px solid #f0f0f0;
    }

    /* Info Grid */
    .info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px 12px;
    }

    .info-item {
        display: flex;
        align-items: flex-start;
        gap: 10px;
    }

    .info-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .icon-red    { background: #fff0f0; }
    .icon-blue   { background: #eff6ff; }
    .icon-green  { background: #f0fdf4; }
    .icon-orange { background: #fff7ed; }
    .icon-coral  { background: #fff1f0; }
    .icon-gold   { background: #fffbeb; }

    .info-label {
        font-size: 11px;
        color: #9ca3af;
        font-weight: 500;
        margin-bottom: 2px;
    }
    
    .info-value {
        font-size: 13px;
        font-weight: 600;
        color: #1a1a1a;
        line-height: 1.3;
    }

    .divider {
        height: 1px;
        background: #f3f4f6;
        margin: 16px 0;
    }

    /* Unlock Banner */
    .unlock-banner {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        font-size: 13px;
        color: #4b5563;
        font-weight: 500;
    }

    .gold-text {
        color: #d97706;
        font-weight: 700;
    }

    /* Lucky Draw */
    .lucky-list {
        list-style: none;
        padding: 0;
        margin-bottom: 16px;
    }

    .lucky-list li {
        font-size: 13px;
        color: #374151;
        display: flex;
        align-items: flex-start;
        gap: 8px;
        margin-bottom: 6px;
        line-height: 1.5;
    }

    .lucky-list li::before {
        content: "•";
        color: #374151;
        font-size: 16px;
        line-height: 1.3;
        flex-shrink: 0;
    }

    .bold { font-weight: 700; }

    .progress-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 10px;
    }

    .progress-count {
        font-size: 38px;
        font-weight: 800;
        color: #16a34a;
        line-height: 1;
    }

    .progress-total {
        font-size: 16px;
        font-weight: 500;
        color: #9ca3af;
        margin-left: 2px;
        align-self: flex-end;
        padding-bottom: 4px;
    }

    .trophy-icon {
        font-size: 28px;
    }

    .progress-bar-wrap {
        position: relative;
        width: 100%;
        height: 10px;
        background: #e5e7eb;
        border-radius: 99px;
        margin-bottom: 6px;
    }

    .progress-bar-fill {
        height: 100%;
        background: linear-gradient(90deg, #16a34a 0%, #22c55e 60%, #f59e0b 100%);
        border-radius: 99px;
        width: 45%;
        position: relative;
    }

    .milestone-marker {
        position: absolute;
        top: -3px;
        left: 75%;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        background: #f59e0b;
        border: 2px solid #fff;
        transform: translateX(-50%);
        z-index: 2;
    }

    .progress-labels {
        display: flex;
        justify-content: space-between;
        font-size: 11px;
        color: #9ca3af;
        padding: 0 2px;
    }

    .gold-label {
        color: #d97706;
        font-weight: 700;
        font-size: 11px;
    }

    /* Verification */
    .verify-row {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 10px;
    }

    .verify-icon {
        width: 36px;
        height: 36px;
        background: #f0fdf4;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .verify-label {
        font-size: 11px;
        color: #9ca3af;
        font-weight: 500;
    }
    
    .verify-value {
        font-size: 13px;
        font-weight: 600;
        color: #1a1a1a;
    }

    .verify-status {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        color: #374151;
        margin-top: 4px;
        padding-top: 10px;
        border-top: 1px dashed #e5e7eb;
    }

    .status-acti {
        color: #16a34a;
        font-weight: 700;
        font-size: 14px;
    }

    .status-arrow {
        color: #16a34a;
        font-weight: 600;
    }

    .status-desc {
        color: #6b7280;
        font-size: 12.5px;
    }

    /* Bottom Button */
    .btn-primary {
        background: #2563eb;
        color: #fff;
        border: none;
        border-radius: 12px;
        width: 100%;
        padding: 14px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
        margin-top: 4px;
        letter-spacing: 0.01em;
    }

    .btn-primary:hover {
        background: #1d4ed8;
    }

    svg { display: block; }
</style>

<div class="phone">
