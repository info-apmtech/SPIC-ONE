@page "/CompanySales"

<style>
    /* Global Box Sizing */
    .spic-sr-container,
    .spic-sr-container *,
    .spic-sr-container *::before,
    .spic-sr-container *::after {
        box-sizing: border-box;
    }

    /* Tooltip Hover Logic for Company Sales Chart */
    .cs-bar-group {
        width: 50px;
        height: calc(100% - 24px);
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        align-items: center;
        border-left: 1px dashed #e2e8f0;
        border-right: 1px dashed #e2e8f0;
        cursor: pointer;
        flex-shrink: 0; /* CRITICAL: Prevents bars from squishing on mobile */
    }

    .cs-chart-tooltip {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: all 0.2s ease-in-out;
        transform: translateY(5px);
        z-index: 20 !important;
    }

    .cs-bar-group:hover .cs-chart-tooltip {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }

    /* Makes the dashed background column highlight on hover */
    .cs-bar-bg {
        opacity: 0 !important;
        transition: opacity 0.2s ease;
        position: absolute; 
        top: 0; 
        bottom: 0; 
        width: 100%; 
        background-color: #fef2f2;
    }
    
    .cs-bar-group:hover .cs-bar-bg {
        opacity: 0.6 !important;
    }

    /* Chart Scroll Wrappers */
    .cs-chart-scroll-wrapper {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        padding-bottom: 15px; /* Prevents scrollbar from covering labels */
    }

    .cs-chart-inner-area {
        min-width: 800px; /* CRITICAL: Forces minimum width so it scrolls instead of squishing */
        display: flex;
        height: 320px;
        font-family: sans-serif;
        color: #94a3b8;
        font-size: 11px;
    }

    /* Table Scroll Wrapper */
    .cs-table-wrapper {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }
    
    .cs-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 1000px; /* Forces table to scroll on mobile */
    }

    /* Tabs Styling */
    .cs-table-header {
        padding: 16px 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        border-bottom: 1px solid #e2e8f0;
    }

    .cs-tabs-wrapper {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .cs-tab {
        padding: 8px 16px;
        border: 1px solid transparent;
        background: transparent;
        border-radius: 6px;
        font-size: 14px;
        font-weight: 500;
        color: #64748b;
        cursor: pointer;
        transition: all 0.2s;
    }

    .cs-tab.active {
        background: #f1f5f9;
        color: #0f172a;
        font-weight: 600;
    }
    
    .cs-tab:hover:not(.active) {
        background: #f8fafc;
    }

    /* Mobile specifically */
    @@media (max-width: 768px) {
        .cs-table-header {
            flex-direction: column;
            align-items: stretch;
        }
        .cs-search-input {
            width: 100%;
            max-width: 100%;
        }
    }
</style>

