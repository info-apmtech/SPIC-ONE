@inject IJSRuntime JS

@* Drop into a page to open it scrolled to the top (see scrollPageToTop in app-interop.js). *@

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { await JS.InvokeVoidAsync("scrollPageToTop"); } catch { }
    }
}
