@page "/ExcelFormatFileUpload"

<PageTitle>Excel Format File Upload</PageTitle>

<style>
    /* Mimicking the existing template styling */
    .fu-container {
        font-family: 'Inter', sans-serif;
    }

    .fu-header-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 30px;
    }

    .fu-header-text {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .fu-header-text h1 {
        margin: 0;
        font-size: 26px;
        font-weight: 700;
        color: #1e293b;
    }

    .fu-header-text p {
        margin: 0;
        font-size: 15px;
        color: #64748b;
    }

    /* Grid of Cards */
    .fu-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 20px;
        margin-bottom: 24px;
    }

    @@media (min-width: 992px) {
        .fu-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    .fu-card {
        border-radius: 10px;
        border: 1px solid #e2e8f0;
        background-color: #ffffff;
        box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06);
        display: flex;
        flex-direction: column;
        overflow: hidden;
        transition: box-shadow 0.2s ease;
    }

    .fu-card:hover {
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    }

    .fu-card-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 16px 20px;
        background-color: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
    }

    .fu-card-icon-box {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #e0e7ff;
        color: #4f46e5;
    }

    .fu-card-title {
        font-size: 15px;
        font-weight: 600;
        margin: 0;
        color: #1e293b;
    }

    .fu-card-body {
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .fu-form-row {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
    }

    .fu-form-group {
        flex: 1;
        min-width: 200px;
        margin-bottom: 0;
    }

    .date-group {
        flex: 0 0 150px;
    }

    .fu-form-label {
        font-size: 13px;
        font-weight: 600;
        color: #475569;
        margin-bottom: 6px;
        display: block;
    }
    
    .fu-form-control {
        width: 100%;
        padding: 8px 12px;
        font-size: 14px;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        color: #1e293b;
        background-color: #ffffff;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }
    
    .fu-form-control:focus {
        outline: none;
        border-color: #4f46e5;
        box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
    }
    
    .fu-btn-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 10px 16px;
        border-radius: 6px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        background-color: #4f46e5;
        color: #ffffff;
        border: none;
        transition: background-color 0.2s ease;
        align-self: flex-start;
    }

    .fu-btn-primary:hover {
        background-color: #4338ca;
    }
</style>

<div class="container-fluid py-4 px-0 fu-container">
    
    <div class="fu-header-container">
        <div class="fu-header-text">
            <h1>Excel Format File Upload</h1>
            <p>Select a category and upload the corresponding Excel report securely</p>
        </div>
    </div>

    <!-- Cards Grid -->
    <div class="fu-grid">
        @foreach (var item in uploadTypes)
        {
            <div class="fu-card">
                <div class="fu-card-header">
                    <div class="fu-card-icon-box">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                    </div>
                    <h3 class="fu-card-title">@item.Title</h3>
                </div>
                
                <div class="fu-card-body">
                    <div class="fu-form-row">
                        <div class="fu-form-group">
                            <label class="fu-form-label">Excel File</label>
                            <InputFile class="fu-form-control" accept=".xlsx,.xls" />
                        </div>
                        <div class="fu-form-group date-group">
                            <label class="fu-form-label">Date (Optional)</label>
                            <input type="date" class="fu-form-control" />
                        </div>
                    </div>
                    
                    <button class="fu-btn-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
                        Upload
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@code {
    public class UploadCategory
    {
        public string Id { get; set; }
        public string Title { get; set; }
    }

    private List<UploadCategory> uploadTypes = new()
    {
        new UploadCategory { Id = "One", Title = "DPT Report" },
        new UploadCategory { Id = "Two", Title = "Sales Company Sales" },
        new UploadCategory { Id = "Three", Title = "Sales and Receipt" },
        new UploadCategory { Id = "Four", Title = "Sales Wholesalers" },
        new UploadCategory { Id = "Five", Title = "Stock Wholesale Stock As On Today" },
        new UploadCategory { Id = "Six", Title = "State Wise Global Stock Reconciliation" },
        new UploadCategory { Id = "Seven", Title = "Warehouse District Wise Details Global Stock" }
    };
}

