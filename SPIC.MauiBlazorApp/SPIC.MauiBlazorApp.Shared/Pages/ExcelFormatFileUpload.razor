@page "/ExcelFormatFileUpload"
@inject HttpClient Http
@inject IJSRuntime JS
<PageTitle>Excel Format File Upload</PageTitle>

<style>
    /* Mimicking the existing template styling */
    .fu-container {
        font-family: 'Inter', sans-serif;
    }

    .fu-header-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 30px;
    }

    .fu-header-text {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .fu-header-text h1 {
        margin: 0;
        font-size: 26px;
        font-weight: 700;
        color: #1e293b;
    }

    .fu-header-text p {
        margin: 0;
        font-size: 15px;
        color: #64748b;
    }

    /* Grid of Cards */
    .fu-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 20px;
        margin-bottom: 24px;
    }

    @@media (min-width: 992px) {
        .fu-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    .fu-card {
        border-radius: 10px;
        border: 1px solid #e2e8f0;
        background-color: #ffffff;
        box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06);
        display: flex;
        flex-direction: column;
        overflow: hidden;
        transition: box-shadow 0.2s ease;
    }

    .fu-card:hover {
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    }

    .fu-card-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 16px 20px;
        background-color: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
    }

    .fu-card-icon-box {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #e0e7ff;
        color: #4f46e5;
    }

    .fu-card-title {
        font-size: 15px;
        font-weight: 600;
        margin: 0;
        color: #1e293b;
    }

    .fu-card-body {
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .fu-form-row {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
    }

    .fu-form-group {
        flex: 1;
        min-width: 200px;
        margin-bottom: 0;
    }

    .date-group {
        flex: 0 0 150px;
    }

    .fu-form-label {
        font-size: 13px;
        font-weight: 600;
        color: #475569;
        margin-bottom: 6px;
        display: block;
    }
    
    .fu-form-control {
        width: 100%;
        padding: 8px 12px;
        font-size: 14px;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        color: #1e293b;
        background-color: #ffffff;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }
    
    .fu-form-control:focus {
        outline: none;
        border-color: #4f46e5;
        box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
    }
    
    .fu-btn-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 12px 16px;
        border-radius: 6px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        background-color: #4f46e5;
        color: #ffffff;
        border: none;
        transition: background-color 0.2s ease;
        align-self: flex-end;
    }

    .fu-btn-primary:hover {
        background-color: #4338ca;
    }
</style>

<div class="container-fluid py-4 px-0 fu-container">
    
    <div class="fu-header-container">
        <div class="fu-header-text">
            <h1>Excel Format File Upload</h1>
            <p>Select a category and upload the corresponding Excel report securely</p>
        </div>
    </div>

    <!-- Cards Grid -->
    <div class="fu-grid">
        @foreach (var item in uploadTypes)
        {
            <div class="fu-card">
                <div class="fu-card-header">
                    <div class="fu-card-icon-box">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                    </div>
                    <h3 class="fu-card-title">@item.Title</h3>
                </div>
                
                <div class="fu-card-body">
                    <div class="fu-form-row" style="align-items: flex-end;">
                        <div class="fu-form-group">
                            <label class="fu-form-label">Excel File</label>
                            <InputFile class="fu-form-control" accept=".xlsx,.xls,.csv" OnChange="@(e => HandleFileSelected(e, item.Id))" />
                        </div>
                        
                        <button class="fu-btn-primary" @onclick="@(() => UploadFile(item.Id))" disabled="@(uploadingCategoryId != null)">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
                            @(uploadingCategoryId == item.Id ? "Uploading..." : "Upload")
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    public class UploadCategory
    {
        public string Id { get; set; }
        public string Title { get; set; }
    }

    private List<UploadCategory> uploadTypes = new()
    {
        new UploadCategory { Id = "One", Title = "DPT Report" },
        new UploadCategory { Id = "Two", Title = "Sales Company Sales" },
        new UploadCategory { Id = "Three", Title = "Sales and Receipt" },
        new UploadCategory { Id = "Four", Title = "Sales Wholesalers" },
        new UploadCategory { Id = "Five", Title = "Stock Wholesale Stock As On Today" },
        new UploadCategory { Id = "Six", Title = "State Wise Global Stock Reconciliation" },
        new UploadCategory { Id = "Seven", Title = "Warehouse District Wise Details Global Stock" }
    };

    private Dictionary<string, IBrowserFile> selectedFiles = new();
    private string uploadingCategoryId = null;

    private void HandleFileSelected(InputFileChangeEventArgs e, string categoryId)
    {
        selectedFiles[categoryId] = e.File;
    }

    private async Task UploadFile(string categoryId)
    {
        if (!selectedFiles.TryGetValue(categoryId, out var file) || file == null)
        {
            await JS.InvokeVoidAsync("alert", "Please select a file first.");
            return;
        }

        // For now, Wholesale Stock (Five), DPT Report (One), Sales and Receipt (Three), Sales Wholesalers (Four), Sales Company Sales (Two), State Wise (Six), and District Wise (Seven) are implemented
        if (categoryId != "Five" && categoryId != "One" && categoryId != "Three" && categoryId != "Four" && categoryId != "Two" && categoryId != "Six" && categoryId != "Seven")
        {
            await JS.InvokeVoidAsync("alert", "This category upload is not implemented yet.");
            return;
        }

        try
        {
            uploadingCategoryId = categoryId;
            StateHasChanged();
            
            using var content = new MultipartFormDataContent();
            var fileContent = new StreamContent(file.OpenReadStream(maxAllowedSize: 104857600)); // 100MB
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
            content.Add(fileContent, "file", file.Name);
            content.Add(new StringContent(categoryId), "categoryId");

            var response = await Http.PostAsync("api/ExcelBulkUpload/import", content);
            var result = await response.Content.ReadAsStringAsync();

            try 
            {
                var options = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true, AllowTrailingCommas = true };
                var cleanResult = result.Trim('\uFEFF', '\u200B'); // Remove BOM if present
                var parsed = System.Text.Json.JsonSerializer.Deserialize<UploadResult>(cleanResult, options);
                
                if (response.IsSuccessStatusCode && parsed != null && parsed.Success)
                {
                    var msg = $"Upload Successful!\n\n" +
                              $"Rows Saved: {parsed.RowsInserted}\n" +
                              $"Rows Skipped (Empty): {parsed.RowsSkipped}\n\n" +
                              $"New Masters Automatically Created:\n" +
                              $" • States: {parsed.NewMastersCreated?.States ?? 0}\n" +
                              $" • Districts: {parsed.NewMastersCreated?.Districts ?? 0}\n" +
                              $" • Sub-Districts: {parsed.NewMastersCreated?.SubDistricts ?? 0}\n" +
                              $" • Dealers: {parsed.NewMastersCreated?.IfmsDealers ?? 0}\n" +
                              $" • Dealer Types: {parsed.NewMastersCreated?.DealerTypes ?? 0}\n" +
                              $" • Dealership Natures: {parsed.NewMastersCreated?.DealershipNatures ?? 0}\n" +
                              $" • Companies: {parsed.NewMastersCreated?.Companies ?? 0}\n" +
                              $" • Plants: {parsed.NewMastersCreated?.Plants ?? 0}\n" +
                              $" • Products: {parsed.NewMastersCreated?.Products ?? 0}";
                    
                    await JS.InvokeVoidAsync("alert", msg);
                    selectedFiles.Remove(categoryId);
                }
                else
                {
                    await JS.InvokeVoidAsync("alert", $"Upload Failed:\n{parsed?.Message ?? result}");
                }
            }
            catch (System.Text.Json.JsonException parseEx)
            {
                // Fallback if parsing fails
                if (response.IsSuccessStatusCode)
                {
                    await JS.InvokeVoidAsync("alert", $"Upload Successful (Parse Error: {parseEx.Message})!\n" + result);
                    selectedFiles.Remove(categoryId);
                }
                else
                {
                    await JS.InvokeVoidAsync("alert", $"Upload Failed (Parse Error: {parseEx.Message}):\n" + result);
                }
            }
        }
        catch (System.Threading.Tasks.TaskCanceledException)
        {
            // Ignore TaskCanceledException (usually happens when alert dialog times out in Blazor Server)
        }
        catch (Exception ex)
        {
            if (ex is not System.Threading.Tasks.TaskCanceledException)
            {
                await JS.InvokeVoidAsync("alert", "Error during upload: " + ex.Message);
            }
        }
        finally
        {
            uploadingCategoryId = null;
            StateHasChanged();
        }
    }

    public class UploadResult
    {
        public bool Success { get; set; }
        public string Message { get; set; }
        public int RowsInserted { get; set; }
        public int RowsSkipped { get; set; }
        public UploadResultMasters NewMastersCreated { get; set; }
    }

    public class UploadResultMasters
    {
        public int States { get; set; }
        public int Districts { get; set; }
        public int SubDistricts { get; set; }
        public int IfmsDealers { get; set; }
        public int DealerTypes { get; set; }
        public int DealershipNatures { get; set; }
        public int Companies { get; set; }
        public int Plants { get; set; }
        public int Products { get; set; }
    }
}

