@if (IsOpen)
{
    <div class="csr-pd-overlay" @onclick="CloseDrawer">
        <div class="csr-pd-drawer" @onclick:stopPropagation="true">
            
            <div class="csr-pd-header">
                <div class="csr-pd-header-titles">
                    <h2>CSR-1 Program Details</h2>
                    <p>Crop Protection Workshop</p>
                </div>
                <button class="csr-pd-close-icon" @onclick="CloseDrawer" aria-label="Close">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>

            <div class="csr-pd-body">
                
                <div class="csr-pd-section">
                    <h3>Program Information</h3>
                    <div class="csr-pd-info-box">
                        <div class="csr-pd-row">
                            <span class="csr-pd-label">Program Type:</span>
                            <span class="csr-pd-value">Training</span>
                        </div>
                        <div class="csr-pd-row">
                            <span class="csr-pd-label">Program Name:</span>
                            <span class="csr-pd-value">Crop Protection Workshop</span>
                        </div>
                        <div class="csr-pd-row">
                            <span class="csr-pd-label">Status:</span>
                            <span class="csr-pd-value">
                                <span class="csr-pd-badge csr-pd-badge-review">Under RMD Review</span>
                            </span>
                        </div>
                    </div>
                </div>

                <div class="csr-pd-section">
                    <h3>Location Details</h3>
                    <div class="csr-pd-info-box">
                        <div class="csr-pd-row">
                            <span class="csr-pd-label">District:</span>
                            <span class="csr-pd-value">Pune</span>
                        </div>
                        <div class="csr-pd-row">
                            <span class="csr-pd-label">HQ:</span>
                            <span class="csr-pd-value">Pune, Maharashtra</span>
                        </div>
                    </div>
                </div>

                <div class="csr-pd-section">
                    <h3>Focus Areas</h3>
                    <div class="csr-pd-info-box">
                        <div class="csr-pd-stack-row">
                            <span class="csr-pd-label">Focused Crops:</span>
                            <div class="csr-pd-pill-group">
                                <span class="csr-pd-pill csr-pd-pill-green">Cotton</span>
                                <span class="csr-pd-pill csr-pd-pill-green">Wheat</span>
                                <span class="csr-pd-pill csr-pd-pill-green">Sugarcane</span>
                            </div>
                        </div>
                        <div class="csr-pd-stack-row">
                            <span class="csr-pd-label">Focused Products:</span>
                            <div class="csr-pd-pill-group">
                                <span class="csr-pd-pill csr-pd-pill-blue">Insecticide A</span>
                                <span class="csr-pd-pill csr-pd-pill-blue">Fungicide B</span>
                                <span class="csr-pd-pill csr-pd-pill-blue">Herbicide C</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="csr-pd-section">
                    <h3>Budget Details</h3>
                    <div class="csr-pd-info-box">
                        <div class="csr-pd-row">
                            <span class="csr-pd-label">Printing & Stationary:</span>
                            <span class="csr-pd-value">₹5,000</span>
                        </div>
                        <div class="csr-pd-row">
                            <span class="csr-pd-label">Publicity Material:</span>
                            <span class="csr-pd-value">₹8,000</span>
                        </div>
                        <div class="csr-pd-row">
                            <span class="csr-pd-label">Stage Arrangements:</span>
                            <span class="csr-pd-value">₹12,000</span>
                        </div>
                        <div class="csr-pd-row">
                            <span class="csr-pd-label">Service Charges - LCA:</span>
                            <span class="csr-pd-value">₹7,000</span>
                        </div>
                        <div class="csr-pd-row">
                            <span class="csr-pd-label">Transport / Rent:</span>
                            <span class="csr-pd-value">₹6,000</span>
                        </div>
                        <div class="csr-pd-row">
                            <span class="csr-pd-label">Jeep Running Expenses:</span>
                            <span class="csr-pd-value">₹4,000</span>
                        </div>
                        <div class="csr-pd-row">
                            <span class="csr-pd-label">Refreshments:</span>
                            <span class="csr-pd-value">₹5,000</span>
                        </div>
                        <div class="csr-pd-row">
                            <span class="csr-pd-label">Inputs:</span>
                            <span class="csr-pd-value">₹0</span>
                        </div>
                        <div class="csr-pd-row">
                            <span class="csr-pd-label">Photography:</span>
                            <span class="csr-pd-value">₹2,000</span>
                        </div>
                        <div class="csr-pd-row">
                            <span class="csr-pd-label">Compliments:</span>
                            <span class="csr-pd-value">₹1,000</span>
                        </div>
                        <div class="csr-pd-row">
                            <span class="csr-pd-label">Others:</span>
                            <span class="csr-pd-value">₹0</span>
                        </div>
                        <div class="csr-pd-row csr-pd-expense-total">
                            <span class="csr-pd-label" style="font-weight: 700; color: #1e293b;">Total:</span>
                            <span class="csr-pd-value csr-pd-font-bold">₹50,000</span>
                        </div>
                    </div>
                </div>

                <div class="csr-pd-section">
                    <h3>Status History</h3>
                    <div class="csr-pd-info-box">
                        <div class="csr-pd-row">
                            <span class="csr-pd-label">Submitted Date:</span>
                            <span class="csr-pd-value">May 1, 2026</span>
                        </div>
                        <div class="csr-pd-row">
                            <span class="csr-pd-label">Validation Due:</span>
                            <span class="csr-pd-value">May 10, 2026</span>
                        </div>
                    </div>
                </div>

                <div class="csr-pd-section">
                    <h3>Status Timeline</h3>
                    <div class="csr-pd-timeline">
                        <div class="csr-pd-tl-item">
                            <div class="csr-pd-tl-line"></div>
                            <div class="csr-pd-tl-icon csr-pd-tl-icon-success">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
                            </div>
                            <div class="csr-pd-tl-content">
                                <h4>CSR-1 Submitted</h4>
                                <div class="csr-pd-tl-meta-block">
                                    <span class="csr-pd-date-pill">May 1, 2026</span>
                                    <span class="csr-pd-time-pill">10:00 AM</span>
                                </div>
                                <span class="csr-pd-tl-subtext">Rajesh Kumar (Program Manager)</span>
                            </div>
                        </div>

                        <div class="csr-pd-tl-item">
                            <div class="csr-pd-tl-line csr-pd-tl-line-faded"></div>
                            <div class="csr-pd-tl-icon csr-pd-tl-icon-success">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
                            </div>
                            <div class="csr-pd-tl-content">
                                <h4>CSR-1 Under Review</h4>
                                <div class="csr-pd-tl-meta-block">
                                    <span class="csr-pd-date-pill">May 1, 2026</span>
                                    <span class="csr-pd-time-pill">10:30 AM</span>
                                </div>
                                <span class="csr-pd-pill csr-pd-pill-status-blue" style="width: fit-content; margin-top: 4px;">In Progress</span>
                            </div>
                        </div>

                        <div class="csr-pd-tl-item">
                            <div class="csr-pd-tl-icon csr-pd-tl-icon-pending">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                            </div>
                            <div class="csr-pd-tl-content" style="justify-content: center;">
                                <h4>CSR- Validated</h4>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="csr-pd-section">
                    <h3>Correction Remarks</h3>
                    <div class="csr-pd-remarks-container">
                        <textarea class="csr-pd-textarea" placeholder="Specify what needs to be corrected by the MO..." rows="3"></textarea>
                        <div class="csr-pd-remarks-actions">
                            <button class="csr-pd-btn-action csr-pd-btn-blue-solid">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
                                Send Correction to MO
                            </button>
                            <button class="csr-pd-btn-action csr-pd-btn-outline">Cancel</button>
                        </div>
                    </div>
                </div>

            </div>

            <div class="csr-pd-footer">
                <button class="csr-pd-btn-action csr-pd-btn-darkgreen">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
                    Forward to RM
                </button>
                <button class="csr-pd-btn-action csr-pd-btn-lightorange">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2v6h-6"></path><path d="M3 12a9 9 0 0 1 15-6.7L21 8"></path><path d="M3 22v-6h6"></path><path d="M21 12a9 9 0 0 1-15 6.7L3 16"></path></svg>
                    Send Correction
                </button>
                <button class="csr-pd-btn-action csr-pd-btn-lightred">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
                    Rejected
                </button>
            </div>

        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    private async Task CloseDrawer()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(IsOpen);
    }
}

