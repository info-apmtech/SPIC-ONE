@page "/ProductWiseStockAvailability"
@implements IDisposable
@inject HttpClient Http
@inject SPIC.MauiBlazorApp.Shared.Services.LoginState LoginState
@inject IJSRuntime JS
@using System.Text.Json
@using System.Net.Http.Json
@using System.Globalization
@using SPIC.Core.DTOs

<div class="container-fluid py-4 px-0">

    <!-- Header -->
    <div class="pw-header">
        <div>
            <h1>Product-wise Stock Availability</h1>
            <p>State-wise product stock availability summary</p>
        </div>
        <div class="pw-actions">
            <button class="pw-btn pw-btn-outline" @onclick="RefreshData" disabled="@(_isLoading)"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2v6h-6"></path><path d="M3 12a9 9 0 1 0 2.13-5.88L2 9"></path></svg> Refresh Data</button>
            <button class="pw-btn pw-btn-outline" @onclick="ExportExcel" disabled="@(_dashboard is null || _isLoading)"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg> Excel</button>
            <button class="pw-btn pw-btn-outline" disabled title="PDF export is not implemented yet."><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg> PDF</button>
            <button class="pw-btn pw-btn-solid" disabled title="Send mail is not implemented yet."><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg> Send Mail</button>
        </div>
    </div>

    <!-- Filters -->
    <div class="pw-filter-card">
        <div class="pw-filter-header">
            <div class="pw-filter-title">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="6" x2="20" y2="6"></line><line x1="6" y1="12" x2="18" y2="12"></line><line x1="8" y1="18" x2="16" y2="18"></line></svg>
                Filters
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </div>
        <div class="pw-filter-body">
            <div class="pw-filter-grid">
                <div class="pw-form-group">
                    <label class="pw-form-label">State</label>
                    <select id="pw-state-select" class="pw-form-select" multiple="multiple">
                        @foreach (var s in _states)
                        {
                            <option value="@s.Id" selected="@(_selStates.Contains(s.Id))">@s.Name</option>
                        }
                    </select>
                </div>
                <div class="pw-form-group">
                    <label class="pw-form-label">Region</label>
                    <select id="pw-region-select" class="pw-form-select" multiple="multiple">
                        @foreach (var r in _regions)
                        {
                            <option value="@r.Id" selected="@(_selRegions.Contains(r.Id))">@r.Name</option>
                        }
                    </select>
                </div>
                <div class="pw-form-group">
                    <label class="pw-form-label">Head Quarters</label>
                    <select id="pw-hq-select" class="pw-form-select" multiple="multiple">
                        @foreach (var h in _hq)
                        {
                            <option value="@h.Id" selected="@(_selHqs.Contains(h.Id))">@h.Name</option>
                        }
                    </select>
                </div>
                <div class="pw-form-group">
                    <label class="pw-form-label">Date From</label>
                    <input type="date" class="pw-form-input" @bind="_dateFrom" />
                </div>
                <div class="pw-form-group">
                    <label class="pw-form-label">Date To</label>
                    <input type="date" class="pw-form-input" @bind="_dateTo" />
                </div>
            </div>
            <div class="pw-filter-actions">
                <button class="pw-btn pw-btn-outline" @onclick="ClearAll" disabled="@(!_select2Initialized || _isLoading)"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg> Clear All</button>
                <button class="pw-btn pw-btn-solid" @onclick="ApplyFilters" disabled="@(!_select2Initialized || _isLoading)"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="6" x2="20" y2="6"></line><line x1="6" y1="12" x2="18" y2="12"></line><line x1="8" y1="18" x2="16" y2="18"></line></svg> Search</button>
            </div>
        </div>
    </div>



    @if (_dashboard is null)
    {
        @if (_isLoading)
        {
            <div class="pw-initial-dashboard" aria-live="polite" aria-busy="true">
                <div class="pw-loading-title">
                    <span class="pw-spinner" aria-hidden="true"></span>
                    <span>Loading dashboard…</span>
                </div>

                <div class="pw-stats-grid pw-skeleton-stats">
                    <div class="pw-stat-card pw-t-green pw-skeleton-card"><span class="pw-skeleton-line pw-skeleton-label"></span><span class="pw-skeleton-line pw-skeleton-value"></span><span class="pw-skeleton-line pw-skeleton-sub"></span></div>
                    <div class="pw-stat-card pw-t-purple pw-skeleton-card"><span class="pw-skeleton-line pw-skeleton-label"></span><span class="pw-skeleton-line pw-skeleton-value"></span><span class="pw-skeleton-line pw-skeleton-sub"></span></div>
                    <div class="pw-stat-card pw-t-blue pw-skeleton-card"><span class="pw-skeleton-line pw-skeleton-label"></span><span class="pw-skeleton-line pw-skeleton-value"></span><span class="pw-skeleton-line pw-skeleton-sub"></span></div>
                    <div class="pw-stat-card pw-t-yellow pw-skeleton-card"><span class="pw-skeleton-line pw-skeleton-label"></span><span class="pw-skeleton-line pw-skeleton-value"></span><span class="pw-skeleton-line pw-skeleton-sub"></span></div>
                    <div class="pw-stat-card pw-t-red pw-skeleton-card"><span class="pw-skeleton-line pw-skeleton-label"></span><span class="pw-skeleton-line pw-skeleton-value"></span><span class="pw-skeleton-line pw-skeleton-sub"></span></div>
                </div>

                <div class="pw-table-card pw-skeleton-table-card">
                    <div class="pw-table-top">
                        <span class="pw-skeleton-line pw-skeleton-title"></span>
                        <span class="pw-skeleton-line pw-skeleton-search"></span>
                    </div>
                    <div class="pw-skeleton-table">
                        <div class="pw-skeleton-table-header"></div>
                        <div class="pw-skeleton-table-row"></div>
                        <div class="pw-skeleton-table-row"></div>
                        <div class="pw-skeleton-table-row"></div>
                        <div class="pw-skeleton-table-row"></div>
                        <div class="pw-skeleton-table-row"></div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="pw-empty-state">
                @(_loadError is null ? "No Data Available" : $"Could not load report: {_loadError}")
            </div>
        }
    }
    else
    {
        <div class="pw-dashboard-shell @(_isLoading ? "pw-dashboard-updating" : "")" aria-busy="@_isLoading">
            @if (_isLoading)
            {
                <div class="pw-updating-indicator">
                    <span class="pw-spinner pw-spinner-small" aria-hidden="true"></span>
                    Updating…
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(_loadError))
            {
                <div class="pw-inline-error">@_loadError</div>
            }

            <!-- KPI cards -->
            <div class="pw-stats-grid">
                <div class="pw-stat-card pw-t-green">
                    <div class="pw-card-top">
                        <div>
                            <div class="pw-stat-title">Total States</div>
                            <div class="pw-stat-value">@_dashboard.Summary.TotalStates</div>
                        </div>
                        <div class="pw-icon-box"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"></path><path d="M5 21V7l8-4 8 4v14"></path><path d="M9 21v-4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v4"></path></svg></div>
                    </div>
                    <div class="pw-stat-sub">Active states</div>
                </div>

                <div class="pw-stat-card pw-t-purple">
                    <div class="pw-card-top">
                        <div>
                            <div class="pw-stat-title">Total Products</div>
                            <div class="pw-stat-value">@_dashboard.Summary.TotalProducts</div>
                        </div>
                        <div class="pw-icon-box"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg></div>
                    </div>
                    <div class="pw-stat-sub">SKUs tracked</div>
                </div>

                <div class="pw-stat-card pw-t-blue">
                    <div class="pw-card-top">
                        <div>
                            <div class="pw-stat-title">Total Quantity (MT)</div>
                            <div class="pw-stat-value">@Fmt(_dashboard.Summary.TotalQuantity)</div>
                        </div>
                        <div class="pw-icon-box"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20"></path><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg></div>
                    </div>
                    <div class="pw-stat-sub">Across all states</div>
                </div>

                <div class="pw-stat-card pw-t-yellow">
                    <div class="pw-card-top">
                        <div>
                            <div class="pw-stat-title">Highest Stock State</div>
                            <div class="pw-stat-value" style="line-height:1.2;">@_dashboard.Summary.HighestStockState</div>
                        </div>
                        <div class="pw-icon-box"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect><path d="M9 22v-4h6v4"></path><path d="M8 6h.01"></path><path d="M16 6h.01"></path><path d="M12 6h.01"></path><path d="M12 10h.01"></path><path d="M12 14h.01"></path><path d="M16 10h.01"></path><path d="M8 10h.01"></path></svg></div>
                    </div>
                    <div class="pw-stat-sub">@Fmt(_dashboard.Summary.HighestStockQuantity) MT</div>
                </div>

                <div class="pw-stat-card pw-t-red">
                    <div class="pw-card-top">
                        <div>
                            <div class="pw-stat-title">Low Stock Alerts</div>
                            <div class="pw-stat-value">@_dashboard.Summary.LowStockAlerts</div>
                        </div>
                        <div class="pw-icon-box"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg></div>
                    </div>
                    <div class="pw-stat-sub">States below threshold</div>
                </div>
            </div>

            <!-- Pivot table -->
            <div class="pw-table-card">
                <div class="pw-table-top">
                    <h3>Stock Availability List</h3>
                    <input type="text" class="pw-search-input" placeholder="Search state…"
                           @bind="_filter.Search" @bind:event="oninput" @onkeyup="OnSearchKeyUp" disabled="@(_isLoading)" />
                </div>

                <div class="pw-table-wrap">
                    <table class="pw-table">
                        <thead>
                            <tr>
                                <th rowspan="2" style="width:60px;">S.No</th>
                                <th rowspan="2" class="pw-left pw-sortable" @onclick='() => Sort("state")'>State</th>
                                @foreach (var grp in ColumnGroups())
                                {
                                    <th colspan="@grp.Count()">@grp.Key</th>
                                }
                                <th rowspan="2" class="pw-sortable" @onclick='() => Sort("total")'>Total (MT)</th>
                            </tr>
                            <tr>
                                @foreach (var col in _dashboard.Columns)
                                {
                                    <th>@col.ProductName</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @if (_dashboard.Grid.Items.Count == 0)
                            {
                                <tr><td class="pw-left" colspan="@(_dashboard.Columns.Count + 3)" style="text-align:center; padding:24px; color:#94a3b8;">No Data Available</td></tr>
                            }
                            else
                            {
                                var start = (_filter.Page - 1) * _filter.PageSize;
                                var n = 0;
                                @foreach (var row in _dashboard.Grid.Items)
                                {
                                    n++;
                                    <tr>
                                        <td>@(start + n)</td>
                                        <td class="pw-left" style="color:#334155;">@row.StateName</td>
                                        @foreach (var col in _dashboard.Columns)
                                        {
                                            <td>@Cell(row, col.ProductId)</td>
                                        }
                                        <td class="pw-total-cell">@Fmt(row.Total)</td>
                                    </tr>
                                }

                                <tr class="pw-grand">
                                    <td></td>
                                    <td class="pw-left">Grand Total</td>
                                    @foreach (var col in _dashboard.Columns)
                                    {
                                        <td>@Cell(_dashboard.GrandTotal, col.ProductId)</td>
                                    }
                                    <td class="pw-total-cell">@Fmt(_dashboard.GrandTotal.Total)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="pw-pagination">
                    <div class="pw-page-size">
                        <span>Items Per Page</span>
                        <select class="pw-form-select" style="padding:6px 32px 6px 12px; width:70px;" @onchange="OnPageSizeChanged" disabled="@(_isLoading)">
                            <option value="16" selected="@(_filter.PageSize == 16)">16</option>
                            <option value="25" selected="@(_filter.PageSize == 25)">25</option>
                            <option value="50" selected="@(_filter.PageSize == 50)">50</option>
                            <option value="100" selected="@(_filter.PageSize == 100)">100</option>
                        </select>
                    </div>
                    <div class="pw-page-controls">
                        <button type="button" class="pw-page-btn" disabled="@(_isLoading || _filter.Page <= 1)" @onclick="() => GoToPage(_filter.Page - 1)">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
                        </button>
                        @foreach (var pg in PageNumbers())
                        {
                            if (pg == -1)
                            {
                                <button type="button" class="pw-page-btn dots" disabled>..</button>
                            }
                            else
                            {
                                <button type="button" class="pw-page-btn @(pg == _filter.Page ? "active" : "")" @onclick="() => GoToPage(pg)" disabled="@(_isLoading)">@pg</button>
                            }
                        }
                        <button type="button" class="pw-page-btn" disabled="@(_isLoading || _filter.Page >= TotalPages)" @onclick="() => GoToPage(_filter.Page + 1)">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>


@code {
    private static readonly CultureInfo InIN = new("en-IN");

    private string Fmt(decimal value) => value == 0 ? "-" : value.ToString("#,##0", InIN);

    private string Cell(ProdStockStateRowDto row, int productId)
        => row.Quantities.TryGetValue(productId, out var value) ? Fmt(value) : "-";

    private ProductStockAvailabilityDto? _dashboard;
    private readonly ProductStockAvailabilityFilter _filter = new();

    private bool _isLoading = true;
    private bool _masterDataReady;
    private bool _select2Initialized;
    private string? _loadError;

    private CancellationTokenSource? _loadCts;
    private System.Timers.Timer? _searchDebounce;
    private Task? _initialDashboardTask;

    private DateTime? _dateFrom;
    private DateTime? _dateTo;

    private int TotalPages => _dashboard is null || _dashboard.Grid.PageSize == 0
        ? 1
        : (int)Math.Ceiling((double)_dashboard.Grid.TotalCount / _dashboard.Grid.PageSize);

    private IEnumerable<IGrouping<string, ProdStockColumnDto>> ColumnGroups()
        => _dashboard!.Columns.GroupBy(column => column.Group);

    // ---------- Filter master data ----------
    private List<LocationDto> _allStates = new();
    private List<LocationDto> _allRegions = new();
    private List<LocationDto> _allHqs = new();

    private List<LocationDto> _states = new();
    private List<LocationDto> _regions = new();
    private List<LocationDto> _hq = new();

    private List<int> _selStates = new();
    private List<int> _selRegions = new();
    private List<int> _selHqs = new();

    private DotNetObjectReference<ProductWiseStockAvailability>? _objRef;

    public class LocationDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public int? StateId { get; set; }
        public int? RegionId { get; set; }
    }

    // ---------- Lifecycle ----------
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _objRef = DotNetObjectReference.Create(this);

            // Apply mandatory role scope before the first dashboard request.
            // Master-data loading still runs in parallel, but the initial API call is scoped.
            ApplyMandatoryRoleScopeSelections();
            SyncSelectionsToFilter();
            _initialDashboardTask = LoadDashboard();

            try
            {
                await LoadMasterData();
                _masterDataReady = true;
                await InvokeAsync(StateHasChanged);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[PWStock] master-data error: {ex}");
            }

            return;
        }

        // Initialize Select2 only after Blazor has rendered the loaded <option> elements.
        if (_masterDataReady && !_select2Initialized)
        {
            _select2Initialized = true;

            try
            {
                await InitSelect2();
            }
            catch (Exception ex)
            {
                _select2Initialized = false;
                Console.WriteLine($"[PWStock] Select2 initialization error: {ex}");
            }
        }
    }

    private async Task LoadMasterData()
    {
        var statesTask = FetchData("api/State/all");
        var regionsTask = FetchData("api/Region/all");
        var hqTask = FetchData("api/Headquarter/all");

        await Task.WhenAll(statesTask, regionsTask, hqTask);

        _allStates = statesTask.Result;
        _allRegions = regionsTask.Result;
        _allHqs = hqTask.Result;

        foreach (var hq in _allHqs)
        {
            var region = _allRegions.FirstOrDefault(item => item.Id == hq.RegionId);
            if (region is not null)
                hq.StateId = region.StateId;
        }

        ApplyMandatoryRoleScopeSelections();
        RebuildVisibleLocationOptions();
        SyncSelectionsToFilter();
    }

    private bool HasGlobalLocationAccess =>
        LoginState == null || LoginState.IsAdmin || LoginState.IsDirectorOrAVP;

    private int ResolveRoleRegionId()
    {
        if (LoginState == null)
            return 0;

        if (LoginState.RegionId > 0)
            return LoginState.RegionId;

        return LoginState.HQId > 0
            ? _allHqs.FirstOrDefault(hq => hq.Id == LoginState.HQId)?.RegionId ?? 0
            : 0;
    }

    private int ResolveRoleStateId()
    {
        if (LoginState == null)
            return 0;

        if (LoginState.StateId > 0)
            return LoginState.StateId;

        var regionId = ResolveRoleRegionId();
        return regionId > 0
            ? _allRegions.FirstOrDefault(region => region.Id == regionId)?.StateId ?? 0
            : 0;
    }

    private void ApplyMandatoryRoleScopeSelections()
    {
        if (HasGlobalLocationAccess || LoginState == null)
            return;

        if (LoginState.IsHQRole && LoginState.HQId > 0)
        {
            var regionId = ResolveRoleRegionId();
            var stateId = ResolveRoleStateId();

            _selHqs = new List<int> { LoginState.HQId };
            _selRegions = regionId > 0 ? new List<int> { regionId } : new List<int>();
            _selStates = stateId > 0 ? new List<int> { stateId } : new List<int>();
            return;
        }

        if (LoginState.IsRegionRole && LoginState.RegionId > 0)
        {
            var stateId = ResolveRoleStateId();
            _selRegions = new List<int> { LoginState.RegionId };
            _selStates = stateId > 0 ? new List<int> { stateId } : new List<int>();

            if (_allHqs.Count > 0)
            {
                _selHqs = _selHqs
                    .Where(id => _allHqs.Any(hq => hq.Id == id && hq.RegionId == LoginState.RegionId))
                    .Distinct()
                    .ToList();
            }

            return;
        }

        if (LoginState.IsStateRole && LoginState.StateId > 0)
        {
            _selStates = new List<int> { LoginState.StateId };

            if (_allRegions.Count > 0)
            {
                _selRegions = _selRegions
                    .Where(id => _allRegions.Any(region =>
                        region.Id == id && region.StateId == LoginState.StateId))
                    .Distinct()
                    .ToList();
            }

            if (_allHqs.Count > 0)
            {
                _selHqs = _selHqs
                    .Where(id => _allHqs.Any(hq =>
                        hq.Id == id && hq.StateId == LoginState.StateId))
                    .Distinct()
                    .ToList();
            }
        }
    }

    private void RebuildVisibleLocationOptions()
    {
        IEnumerable<LocationDto> allowedStates = _allStates;
        IEnumerable<LocationDto> allowedRegions = _allRegions;
        IEnumerable<LocationDto> allowedHqs = _allHqs;

        if (!HasGlobalLocationAccess && LoginState != null)
        {
            if (LoginState.IsHQRole && LoginState.HQId > 0)
            {
                var regionId = ResolveRoleRegionId();
                var stateId = ResolveRoleStateId();

                allowedHqs = _allHqs.Where(hq => hq.Id == LoginState.HQId);
                allowedRegions = regionId > 0
                    ? _allRegions.Where(region => region.Id == regionId)
                    : Enumerable.Empty<LocationDto>();
                allowedStates = stateId > 0
                    ? _allStates.Where(state => state.Id == stateId)
                    : Enumerable.Empty<LocationDto>();
            }
            else if (LoginState.IsRegionRole && LoginState.RegionId > 0)
            {
                var stateId = ResolveRoleStateId();
                allowedRegions = _allRegions.Where(region => region.Id == LoginState.RegionId);
                allowedHqs = _allHqs.Where(hq => hq.RegionId == LoginState.RegionId);
                allowedStates = stateId > 0
                    ? _allStates.Where(state => state.Id == stateId)
                    : Enumerable.Empty<LocationDto>();
            }
            else if (LoginState.IsStateRole && LoginState.StateId > 0)
            {
                allowedStates = _allStates.Where(state => state.Id == LoginState.StateId);
                allowedRegions = _allRegions.Where(region => region.StateId == LoginState.StateId);
                allowedHqs = _allHqs.Where(hq => hq.StateId == LoginState.StateId);
            }
        }

        _states = allowedStates.ToList();
        _regions = _selStates.Any()
            ? allowedRegions.Where(region => _selStates.Contains(region.StateId ?? 0)).ToList()
            : allowedRegions.ToList();

        _hq = _selRegions.Any()
            ? allowedHqs.Where(hq => _selRegions.Contains(hq.RegionId ?? 0)).ToList()
            : _selStates.Any()
                ? allowedHqs.Where(hq => _selStates.Contains(hq.StateId ?? 0)).ToList()
                : allowedHqs.ToList();
    }

    // ---------- Dashboard ----------
    private async Task LoadDashboard()
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();

        var cts = new CancellationTokenSource(TimeSpan.FromSeconds(30));
        _loadCts = cts;
        var token = cts.Token;
        var hadDashboard = _dashboard is not null;

        _isLoading = true;
        _loadError = null;
        SyncSelectionsToFilter();
        await InvokeAsync(StateHasChanged);

        try
        {
            var response = await Http.PostAsJsonAsync(
                "api/ProductStockAvailability/dashboard",
                _filter,
                token);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ProductStockAvailabilityDto>(
                    cancellationToken: token);

                if (result is not null)
                {
                    _dashboard = result;
                }
                else
                {
                    if (!hadDashboard)
                        _dashboard = null;

                    _loadError = "The server returned an empty dashboard response.";
                }
            }
            else
            {
                if (!hadDashboard)
                    _dashboard = null;

                _loadError = $"Server returned {(int)response.StatusCode} {response.ReasonPhrase}.";
            }
        }
        catch (OperationCanceledException)
        {
            // A newer request now owns the UI.
            if (!ReferenceEquals(_loadCts, cts))
                return;

            if (!hadDashboard)
                _dashboard = null;

            _loadError = "Request timed out — the server took too long to respond.";
        }
        catch (Exception ex)
        {
            if (!hadDashboard)
                _dashboard = null;

            _loadError = ex.Message;
        }
        finally
        {
            if (ReferenceEquals(_loadCts, cts))
            {
                _isLoading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void SyncSelectionsToFilter()
    {
        _filter.StateIds = _selStates.ToList();
        _filter.RegionIds = _selRegions.ToList();
        _filter.HeadQuarterIds = _selHqs.ToList();
        _filter.DateFrom = _dateFrom;
        _filter.DateTo = _dateTo;
    }

    private async Task ApplyFilters()
    {
        SyncSelectionsToFilter();
        _filter.Page = 1;
        await LoadDashboard();
    }

    private async Task RefreshData()
    {
        SyncSelectionsToFilter();
        await LoadDashboard();
    }

    private async Task ClearAll()
    {
        _selStates.Clear();
        _selRegions.Clear();
        _selHqs.Clear();

        _dateFrom = null;
        _dateTo = null;

        ApplyMandatoryRoleScopeSelections();
        RebuildVisibleLocationOptions();

        SyncSelectionsToFilter();
        _filter.Search = null;
        _filter.Page = 1;

        await InvokeAsync(StateHasChanged);
        await RefreshSelect2();
        await LoadDashboard();
    }

    // ---------- Grid ----------
    private async Task GoToPage(int page)
    {
        if (_isLoading || page < 1 || page > TotalPages || page == _filter.Page)
            return;

        _filter.Page = page;
        await LoadDashboard();
    }

    private async Task OnPageSizeChanged(ChangeEventArgs args)
    {
        if (_isLoading)
            return;

        if (int.TryParse(args.Value?.ToString(), out var size))
        {
            _filter.PageSize = size;
            _filter.Page = 1;
            await LoadDashboard();
        }
    }

    private async Task Sort(string column)
    {
        if (_isLoading)
            return;

        if (_filter.SortColumn == column)
            _filter.SortDir = _filter.SortDir == "asc" ? "desc" : "asc";
        else
        {
            _filter.SortColumn = column;
            _filter.SortDir = "asc";
        }

        await LoadDashboard();
    }

    private void OnSearchKeyUp()
    {
        _searchDebounce?.Stop();
        _searchDebounce?.Dispose();

        _searchDebounce = new System.Timers.Timer(400)
        {
            AutoReset = false
        };

        _searchDebounce.Elapsed += async (_, _) =>
        {
            try
            {
                await InvokeAsync(async () =>
                {
                    _filter.Page = 1;
                    await LoadDashboard();
                });
            }
            catch (ObjectDisposedException)
            {
                // The page was closed while the debounce timer was waiting.
            }
        };

        _searchDebounce.Start();
    }

    private IEnumerable<int> PageNumbers()
    {
        var total = TotalPages;
        var current = _filter.Page;

        if (total <= 7)
        {
            for (var page = 1; page <= total; page++)
                yield return page;

            yield break;
        }

        yield return 1;

        if (current > 4)
            yield return -1;

        for (var page = Math.Max(2, current - 1); page <= Math.Min(total - 1, current + 1); page++)
            yield return page;

        if (current < total - 3)
            yield return -1;

        yield return total;
    }

