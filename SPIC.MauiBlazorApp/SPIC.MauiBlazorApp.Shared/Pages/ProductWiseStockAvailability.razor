    // ---------- Select2 cascade: State -> Region -> HQ ----------
    private async Task InitSelect2()
    {
        if (_objRef is null)
            return;

        var configs = new[]
        {
            new { id = "pw-state-select",  method = nameof(OnStateChanged) },
            new { id = "pw-region-select", method = nameof(OnRegionChanged) },
            new { id = "pw-hq-select",     method = nameof(OnHqChanged) }
        };

        await JS.InvokeVoidAsync("spicSelect2.initMultiple", configs, _objRef);
    }

    private static List<int> ParseIds(List<string>? values)
    {
        return (values ?? new List<string>())
            .Select(value => int.TryParse(value, out var id) ? id : 0)
            .Where(id => id > 0)
            .Distinct()
            .ToList();
    }

    [JSInvokable]
    public async Task OnStateChanged(List<string>? values)
    {
        var selected = ParseIds(values);
        if (_selStates.SequenceEqual(selected))
            return;

        _selStates = selected;
        await Cascade("State");
    }

    [JSInvokable]
    public async Task OnRegionChanged(List<string>? values)
    {
        var selected = ParseIds(values);
        if (_selRegions.SequenceEqual(selected))
            return;

        _selRegions = selected;
        await Cascade("Region");
    }

    [JSInvokable]
    public async Task OnHqChanged(List<string>? values)
    {
        var selected = ParseIds(values);
        if (_selHqs.SequenceEqual(selected))
            return;

        _selHqs = selected;
        await Cascade("HQ");
    }

    private async Task Cascade(string filterType)
    {
        if (filterType == "State" && _selStates.Any())
        {
            _selRegions.RemoveAll(id =>
            {
                var region = _allRegions.FirstOrDefault(item => item.Id == id);
                return region is null || !_selStates.Contains(region.StateId ?? 0);
            });

            _selHqs.RemoveAll(id =>
            {
                var hq = _allHqs.FirstOrDefault(item => item.Id == id);
                return hq is null || !_selStates.Contains(hq.StateId ?? 0);
            });
        }
        else if (filterType == "Region" && _selRegions.Any())
        {
            _selStates = _selStates
                .Union(_allRegions
                    .Where(region => _selRegions.Contains(region.Id) && region.StateId.HasValue)
                    .Select(region => region.StateId!.Value))
                .Distinct()
                .ToList();

            _selHqs.RemoveAll(id =>
            {
                var hq = _allHqs.FirstOrDefault(item => item.Id == id);
                return hq is null || !_selRegions.Contains(hq.RegionId ?? 0);
            });
        }
        else if (filterType == "HQ" && _selHqs.Any())
        {
            _selRegions = _selRegions
                .Union(_allHqs
                    .Where(hq => _selHqs.Contains(hq.Id) && hq.RegionId.HasValue)
                    .Select(hq => hq.RegionId!.Value))
                .Distinct()
                .ToList();

            _selStates = _selStates
                .Union(_allHqs
                    .Where(hq => _selHqs.Contains(hq.Id) && hq.StateId.HasValue)
                    .Select(hq => hq.StateId!.Value))
                .Distinct()
                .ToList();
        }

        ApplyMandatoryRoleScopeSelections();
        RebuildVisibleLocationOptions();

        await InvokeAsync(StateHasChanged);
        await RefreshSelect2();
    }

    private async Task RefreshSelect2()
    {
        if (!_select2Initialized || _objRef is null)
            return;

        var ids = new[]
        {
            "pw-state-select",
            "pw-region-select",
            "pw-hq-select"
        };

        await JS.InvokeVoidAsync("spicSelect2.destroyMultiple", ids);
        await Task.Delay(50);
        await InitSelect2();
    }

    private async Task<List<LocationDto>> FetchData(string url)
    {
        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(20));
            var raw = await Http.GetFromJsonAsync<List<JsonElement>>(url, cts.Token);
            var result = new List<LocationDto>();

            if (raw is null)
                return result;

            foreach (var item in raw)
            {
                if (!item.TryGetProperty("id", out var idProperty) || idProperty.ValueKind != JsonValueKind.Number)
                    continue;

                var id = idProperty.GetInt32();
                var name = string.Empty;

                if (item.TryGetProperty("name", out var nameProperty))
                    name = nameProperty.GetString() ?? string.Empty;
                else if (item.TryGetProperty("stateName", out nameProperty))
                    name = nameProperty.GetString() ?? string.Empty;
                else if (item.TryGetProperty("regionName", out nameProperty))
                    name = nameProperty.GetString() ?? string.Empty;
                else if (item.TryGetProperty("headquarterName", out nameProperty))
                    name = nameProperty.GetString() ?? string.Empty;

                var dto = new LocationDto
                {
                    Id = id,
                    Name = name
                };

                if (item.TryGetProperty("stateId", out var stateProperty) &&
                    stateProperty.ValueKind == JsonValueKind.Number)
                {
                    dto.StateId = stateProperty.GetInt32();
                }

                if (item.TryGetProperty("regionId", out var regionProperty) &&
                    regionProperty.ValueKind == JsonValueKind.Number)
                {
                    dto.RegionId = regionProperty.GetInt32();
                }

                result.Add(dto);
            }

            return result;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[PWStock] lookup error for {url}: {ex.Message}");
            return new List<LocationDto>();
        }
    }

    public void Dispose()
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _searchDebounce?.Dispose();
        _objRef?.Dispose();
    }
