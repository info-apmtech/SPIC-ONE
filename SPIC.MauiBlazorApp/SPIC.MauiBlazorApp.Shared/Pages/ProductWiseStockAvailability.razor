@page "/ProductWiseStockAvailability"

<div class="container-fluid py-4 px-0">
    <div class="psa-wrapper">

        <!-- Page Header -->
        <div class="psa-page-header">
            <div class="psa-title-block">
                <h1>Product-wise Stock Availability</h1>
                <p>State-wise product stock availability summary as on 01 May 2026</p>
            </div>
            <div class="psa-actions">
                <button class="psa-btn psa-btn-outline"><i class="bi bi-arrow-clockwise"></i> Refresh Data</button>
                <button class="psa-btn psa-btn-outline"><i class="bi bi-file-earmark-spreadsheet" style="color:#16A34A"></i> Excel</button>
                <button class="psa-btn psa-btn-outline"><i class="bi bi-file-earmark-pdf" style="color:#DC2626"></i> PDF</button>
                <button class="psa-btn psa-btn-primary"><i class="bi bi-envelope"></i> Send Mail</button>
            </div>
        </div>

        <!-- KPI Cards -->
        <div class="psa-kpi-grid">

            <div class="psa-kpi-card psa-kpi-green">
                <div class="psa-kpi-content">
                    <div class="psa-kpi-label">Total States</div>
                    <div class="psa-kpi-value">28</div>
                    <div class="psa-kpi-sub">Active states</div>
                </div>
                <div class="psa-kpi-icon psa-icon-green">
                    <i class="bi bi-tree-fill"></i>
                </div>
            </div>

            <div class="psa-kpi-card psa-kpi-purple">
                <div class="psa-kpi-content">
                    <div class="psa-kpi-label">Total Products</div>
                    <div class="psa-kpi-value">16</div>
                    <div class="psa-kpi-sub">SKUs tracked</div>
                </div>
                <div class="psa-kpi-icon psa-icon-purple">
                    <i class="bi bi-boxes"></i>
                </div>
            </div>

            <div class="psa-kpi-card psa-kpi-blue">
                <div class="psa-kpi-content">
                    <div class="psa-kpi-label">Total Quantity (MT)</div>
                    <div class="psa-kpi-value">1,82,798</div>
                    <div class="psa-kpi-sub">Across all states</div>
                </div>
                <div class="psa-kpi-icon psa-icon-blue">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>
            </div>

            <div class="psa-kpi-card psa-kpi-lime">
                <div class="psa-kpi-content">
                    <div class="psa-kpi-label">Highest Stock St...</div>
                    <div class="psa-kpi-value psa-kpi-value-sm">Manipur</div>
                    <div class="psa-kpi-sub">37,322 MT</div>
                </div>
                <div class="psa-kpi-icon psa-icon-lime">
                    <i class="bi bi-buildings"></i>
                </div>
            </div>

            <div class="psa-kpi-card psa-kpi-red">
                <div class="psa-kpi-content">
                    <div class="psa-kpi-label">Low Stock Alerts</div>
                    <div class="psa-kpi-value">0</div>
                    <div class="psa-kpi-sub">States below threshold</div>
                </div>
                <div class="psa-kpi-icon psa-icon-red">
                    <i class="bi bi-tools"></i>
                </div>
            </div>

        </div>

        <!-- Filters Card -->
        <div class="psa-card">
            <div class="psa-filters-header">
                <span><i class="bi bi-filter-left"></i> Filters</span>
                <i class="bi bi-chevron-down psa-toggle-icon"></i>
            </div>

            <div class="psa-filters-grid">
                <div class="psa-form-group">
                    <label>Date Range</label>
                    <div class="psa-input-with-icon">
                        <input type="text" class="psa-control" placeholder="01 Apr 2025 - 28 Apr 2025" />
                        <i class="bi bi-calendar3 psa-input-icon"></i>
                    </div>
                </div>
                <div class="psa-form-group">
                    <label>State</label>
                    <select class="psa-control psa-select">
                        <option value="" disabled selected hidden>All State</option>
                    </select>
                </div>
                <div class="psa-form-group">
                    <label>Region</label>
                    <select class="psa-control psa-select">
                        <option value="" disabled selected hidden>All Region</option>
                    </select>
                </div>
                <div class="psa-form-group">
                    <label>Head Quarters</label>
                    <select class="psa-control psa-select">
                        <option value="" disabled selected hidden>All Head Quarters</option>
                    </select>
                </div>
            </div>

            <div class="psa-filter-actions">
                <button class="psa-btn psa-btn-ghost"><i class="bi bi-x-lg"></i> Clear All</button>
                <button class="psa-btn psa-btn-primary"><i class="bi bi-funnel"></i> Apply Filters</button>
            </div>
        </div>

        <!-- Table Card -->
        <div class="psa-card">
            <div class="psa-table-head">
                <h2 class="psa-table-title">Stock Availability List</h2>
                <div class="psa-search">
                    <i class="bi bi-search"></i>
                    <input type="text" placeholder="Search zones..." />
                </div>
            </div>

            <div class="psa-table-wrap">
                <table class="psa-table">
                    <thead>
                        <tr class="psa-thead-group">
                            <th rowspan="2" class="psa-th-state">State</th>
                            <th colspan="3" class="psa-th-group-green">Normal Products</th>
                            <th colspan="3" class="psa-th-group-blue">Imported Products</th>
                            <th colspan="1" class="psa-th-group-pink"></th>
                        </tr>
                        <tr>
                            <th>Urea 45kg</th>
                            <th>Urea 50kg</th>
                            <th class="psa-cell-divider">DAP</th>
                            <th>Imp Urea 45</th>
                            <th>Imp DAP</th>
                            <th class="psa-cell-divider">Imp 10-26-26</th>
                            <th>FOM</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="psa-state-cell">Tamil Nadu</td>
                            <td>3,254</td>
                            <td>4,785</td>
                            <td class="psa-cell-divider">1,033</td>
                            <td>362</td>
                            <td>311</td>
                            <td class="psa-cell-divider">-</td>
                            <td>124</td>
                        </tr>
                        <tr>
                            <td class="psa-state-cell">Karnataka</td>
                            <td>3,254</td>
                            <td>4,785</td>
                            <td class="psa-cell-divider">-</td>
                            <td>362</td>
                            <td>311</td>
                            <td class="psa-cell-divider">-</td>
                            <td>124</td>
                        </tr>
                        <tr>
                            <td class="psa-state-cell">Kerala</td>
                            <td>3,254</td>
                            <td>4,785</td>
                            <td class="psa-cell-divider">1,033</td>
                            <td>362</td>
                            <td>-</td>
                            <td class="psa-cell-divider">-</td>
                            <td>124</td>
                        </tr>
                        <tr class="psa-grand-total">
                            <td class="psa-state-cell">Grand Total</td>
                            <td>10,254</td>
                            <td>12,785</td>
                            <td class="psa-cell-divider">2,033</td>
                            <td>10,062</td>
                            <td>622</td>
                            <td class="psa-cell-divider">-</td>
                            <td>324</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <div class="psa-pagination">
                <div class="psa-page-size">
                    <span>Items Per Page</span>
                    <select class="psa-control psa-select psa-page-select">
                        <option>16</option>
                        <option>25</option>
                    </select>
                </div>
                <div class="psa-page-controls">
                    <button class="psa-page-btn"><i class="bi bi-chevron-left"></i></button>
                    <button class="psa-page-btn psa-page-active">1</button>
                    <button class="psa-page-btn">2</button>
                    <button class="psa-page-btn">3</button>
                    <span class="psa-page-ellipsis">..</span>
                    <button class="psa-page-btn">8</button>
                    <button class="psa-page-btn">9</button>
                    <button class="psa-page-btn">10</button>
                    <button class="psa-page-btn"><i class="bi bi-chevron-right"></i></button>
                </div>
            </div>
        </div>

    </div>
</div>

