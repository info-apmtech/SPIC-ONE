                            <div class="check-val"><i class="bi bi-clock"></i> 2 PM</div>
                        </div>
                        <div class="col-6 check-box-col">
                            <div class="check-lbl">Check-out</div>
                            <div class="check-val"><i class="bi bi-calendar"></i> May 29, 2026</div>
                            <div class="check-val"><i class="bi bi-clock"></i> 12 AM</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="detail-card">
                <div class="detail-card-header">
                    <h3 class="detail-card-title">Booking Summary</h3>
                </div>
                <div class="detail-card-body">
                    <div class="kv-row">
                        <span class="kv-label">Room Type</span>
                        <span class="kv-value">AC Deluxe Room</span>
                    </div>
                    
                    <div class="summary-divider"></div>
                    
                    <div class="kv-row">
                        <span class="kv-label">Room Price</span>
                        <span class="kv-value">₹999.00</span>
                    </div>
                    <div class="kv-row">
                        <span class="kv-label">Number of nights</span>
                        <span class="kv-value">3</span>
                    </div>
                    <div class="kv-row">
                        <span class="kv-label">Extra Cot × 1</span>
                        <span class="kv-value">₹250.00</span>
                    </div>

                    <div class="summary-divider"></div>

                    <div class="kv-row">
                        <span class="kv-label">Subtotal</span>
                        <span class="kv-value">₹3247.00</span>
                    </div>
                    <div class="kv-row">
                        <span class="kv-label">Taxes (12%)</span>
                        <span class="kv-value">₹120.00</span>
                    </div>

                    <div class="summary-divider"></div>

                    <div class="kv-row mt-3">
                        <span class="kv-label total-lbl">Total</span>
                        <span class="kv-value total-val">₹3367.00</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="detail-card">
                <div class="detail-card-header">
                    <h3 class="detail-card-title">Guest Information</h3>
                </div>
                <div class="detail-card-body">
                    <div class="kv-row">
                        <span class="kv-label">Employee ID / Dealer Code</span>
                        <span class="kv-value">DL-1234</span>
                    </div>
                    <div class="kv-row">
                        <span class="kv-label">Guest Name</span>
                        <span class="kv-value">Rajesh</span>
                    </div>
                    <div class="kv-row">
                        <span class="kv-label">Company Name</span>
                        <span class="kv-value">SPIC Pvt. ltd.,</span>
                    </div>
                    <div class="kv-row">
                        <span class="kv-label">Phone Number</span>
                        <span class="kv-value">9876543210</span>
                    </div>
                    <div class="kv-row">
                        <span class="kv-label">Email ID</span>
                        <span class="kv-value">hi@gmail.com</span>
                    </div>
                    <div class="kv-row">
                        <span class="kv-label">Number of Persons</span>
                        <span class="kv-value">2 persons</span>
                    </div>
                    <div class="kv-row">
                        <span class="kv-label">Nationality</span>
                        <span class="kv-value">Indian</span>
                    </div>
                    <div class="kv-row">
                        <span class="kv-label">Aadhaar / Passport Number</span>
                        <span class="kv-value">098 765 432 109</span>
                    </div>
                    <div class="kv-row">
                        <span class="kv-label">Address</span>
                        <span class="kv-value text-wrap">No.5, SPIC House, Guindy,<br/>Chennai-600022.</span>
                    </div>
                </div>
            </div>
        </div>

    </div>

</div>

