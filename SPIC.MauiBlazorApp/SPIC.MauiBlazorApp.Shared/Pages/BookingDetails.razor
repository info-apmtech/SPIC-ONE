@page "/BookingDetails"

<style>
    :root {
        --bg-body: #f4f6f8;
        --bg-card: #ffffff;
        --text-main: #1f2937;
        --text-muted: #6b7280;
        --border-light: #e5e7eb;
        --primary-blue: #3b82f6;
        
        /* Card Theme Colors */
        --header-bg-green: #eaf0e5; /* Soft green from design */
        --header-text-green: #3f4e42;
    }

   
    /* --- Page Header --- */
    .page-header-container {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
        gap: 15px;
    }
    
    .page-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--text-main);
        margin-bottom: 0.25rem;
    }
    
    .page-subtitle {
        font-size: 0.9rem;
        color: var(--text-muted);
        margin: 0;
    }
    
    .text-blue {
        color: #2563eb;
        font-weight: 600;
    }

    /* --- Buttons --- */
    .btn-outline-custom {
        background-color: #ffffff;
        border: 1px solid var(--border-light);
        color: #374151;
        font-weight: 600;
        font-size: 0.85rem;
        padding: 8px 16px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: 0.2s;
        box-shadow: 0 1px 2px rgba(0,0,0,0.02);
    }
    .btn-outline-custom:hover { background-color: #f9fafb; color: #1f2937; }

    /* --- Review Card Base --- */
    .detail-card {
        background: var(--bg-card);
        border: 1px solid var(--border-light);
        border-radius: 12px;
        height: 100%;
        overflow: hidden; 
        box-shadow: 0 1px 2px rgba(0,0,0,0.02);
    }

    .detail-card-header {
        background-color: var(--header-bg-green);
        padding: 16px 20px;
        border-bottom: 1px solid #dce4d6;
    }

    .detail-card-title {
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--header-text-green);
        margin: 0;
    }

    .detail-card-body {
        padding: 20px;
    }

    /* --- Key Value Pairs --- */
    .kv-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 16px;
    }
    .kv-row:last-child {
        margin-bottom: 0;
    }
    .kv-label {
        font-size: 0.85rem;
        font-weight: 500;
        color: var(--text-muted);
        flex-shrink: 0;
    }
    .kv-value {
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--text-main);
        text-align: right;
        max-width: 60%;
        line-height: 1.4;
    }

    /* --- Specific Card Layouts --- */
    
    /* Room Details */
    .room-details-container {
        display: flex;
        gap: 20px;
        align-items: center;
    }
    .room-image {
        width: 130px;
        height: 85px;
        object-fit: cover;
        border-radius: 8px;
        border: 1px solid var(--border-light);
        flex-shrink: 0;
    }
    .room-info {
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    /* Check In / Out */
    .check-box-col {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
    .check-lbl {
        font-size: 0.85rem;
        font-weight: 500;
        color: var(--text-muted);
    }
    .check-val {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--text-main);
    }
    .check-val i {
        color: var(--text-muted);
        font-size: 1.1rem;
    }

    /* Booking Summary Modifiers */
    .summary-divider {
        height: 1px;
        background-color: var(--border-light);
        margin: 16px 0;
    }
    .total-val {
        color: var(--primary-blue) !important;
        font-size: 1.1rem !important;
        font-weight: 700 !important;
    }
    .total-lbl {
        font-size: 1rem !important;
        font-weight: 700 !important;
        color: var(--text-main);
    }
</style>

<div class="container-fluid py-4 px-3 px-md-4" style="max-width: 1300px; margin: auto;">
    
    <div class="page-header-container">
        <div>
            <h1 class="page-title">Booking Details</h1>
            <p class="page-subtitle">Booking ID: <span class="text-blue">BK7A3K9XY</span></p>
        </div>
        <button class="btn-outline-custom"><i class="bi bi-file-earmark-arrow-down"></i> Download Invoice</button>
    </div>

    <div class="row g-4">
        
        <div class="col-lg-6">
            <div class="detail-card">
                <div class="detail-card-header">
                    <h3 class="detail-card-title">Room Details</h3>
                </div>
                <div class="detail-card-body h-100">
                    <div class="room-details-container">
                        <img src="https://images.unsplash.com/photo-1611892440504-42a792e24d32?auto=format&fit=crop&w=300&q=80" alt="Room Image" class="room-image">
                        <div class="room-info">
                            <div class="kv-row mb-0">
                                <span class="kv-label">Guest House</span>
                                <span class="kv-value">T-Nagar</span>
                            </div>
                            <div class="kv-row mb-0">
                                <span class="kv-label">Room Type</span>
                                <span class="kv-value">AC Deluxe Room</span>
                            </div>
                            <div class="kv-row mb-0">
                                <span class="kv-label">Room Number</span>
                                <span class="kv-value">211</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="detail-card">
