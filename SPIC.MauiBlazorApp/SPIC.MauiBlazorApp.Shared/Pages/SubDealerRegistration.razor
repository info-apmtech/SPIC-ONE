    @if (!IsViewOnly)
    {
        <ActionBar CssClass="sdr-submit-bar" AriaLabel="Sub Dealer form actions">
            <button type="button"
                    class="btn btn-success px-4 py-2 fw-semibold rounded-2"
                    @onclick="HandleSubmit"
                    disabled="@(_isSaving || _isLoadingSelected || _isExtractingGst || _isGettingLocation || _isPincodeLookup || !_isEditMode || _intendedSubDealerId <= 0)">
                @if (_isLoadingSelected)
                {
                    <span class="spinner-border spinner-border-sm me-2"
                          role="status"
                          aria-hidden="true"></span>
                    <span>Loading...</span>
                }
                else if (_isSaving)
                {
                    <span class="spinner-border spinner-border-sm me-2"
                          role="status"
                          aria-hidden="true"></span>
                    <span>Submitting...</span>
                }
                else
                {
                    <i class="bi bi-check-circle me-2"></i>
                    <span>Submit</span>
                }
            </button>
        </ActionBar>
    }

    @if (_showImportModal && IsAdminMaster)
    {
        <div class="subdealer-import-backdrop" @onclick="CloseImportModal">
            <div class="subdealer-import-modal" @onclick:stopPropagation="true">
                <div class="subdealer-import-modal-header">
                    <div>
                        <h5 class="fw-bold mb-1">Import Sub Dealer Master</h5>
                        <div class="small text-muted">Upload the approved .xlsx master file.</div>
                    </div>

                    <button type="button"
                            class="btn-close"
                            aria-label="Close"
                            disabled="@_isImporting"
                            @onclick="CloseImportModal"></button>
                </div>

                <div class="subdealer-import-modal-body">
                    <div class="alert alert-light border small mb-3">
                        <div class="fw-semibold mb-1">Required Excel columns</div>
                        <div>Sub Dealer Code, Sub Dealer Name, HQ, Region, State</div>
                    </div>

                    <div class="subdealer-excel-dropzone">
                        <i class="bi bi-file-earmark-excel fs-2 text-success"></i>
                        <div class="fw-semibold mt-2">Choose Excel file</div>
                        <div class="small text-muted mb-3">Only .xlsx files, maximum 10 MB</div>

                        <InputFile OnChange="HandleImportFileSelected"
                                   accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />

                        @if (_importFile != null)
                        {
                            <div class="small text-success mt-3">
                                <i class="bi bi-check-circle me-1"></i>
                                @_importFile.Name
                            </div>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_importMessage))
                    {
                        <div class="alert @(_importHasError ? "alert-danger" : "alert-success") py-2 mt-3 mb-0 small">
                            @_importMessage
                        </div>
                    }

                    @if (_importErrors.Count > 0)
                    {
                        <div class="subdealer-import-errors alert alert-danger mb-0">
                            <div class="fw-semibold mb-1">Import validation errors</div>
                            <ul class="mb-0 ps-3">
                                @foreach (var error in _importErrors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </div>
                    }
                </div>

                <div class="subdealer-import-modal-footer">
                    <button type="button"
                            class="btn btn-outline-secondary"
                            disabled="@_isImporting"
                            @onclick="CloseImportModal">
                        Cancel
                    </button>

                    <button type="button"
                            class="btn btn-success px-4"
                            disabled="@(_isImporting || _importFile == null)"
                            @onclick="ImportSubDealersFromExcel">
                        @if (_isImporting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"
                                  role="status"
                                  aria-hidden="true"></span>
                            <span>Importing...</span>
                        }
                        else
                        {
                            <i class="bi bi-upload me-2"></i>
                            <span>Upload &amp; Import</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "subDealerId")]
    public int? SubDealerIdFromQuery { get; set; }

    [SupplyParameterFromQuery(Name = "mode")]
    public string? Mode { get; set; }

    private bool IsAdminMaster =>
        string.Equals(CurrentLoginRole, "Admin", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(CurrentLoginRole, "SuperAdmin", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(CurrentLoginRole, "CorporateAdmin", StringComparison.OrdinalIgnoreCase);

    private bool CanMaintainProfile => LoginState != null &&
        (IsAdminMaster || IsLoginMoRole || LoginState.IsDirectorOrAVP);

    private bool IsViewOnly => !CanMaintainProfile ||
        string.Equals(Mode, "view", StringComparison.OrdinalIgnoreCase);

    // Only Active Sub Dealers require the full Primary Location,
    // contact and GST information.
    private bool IsActiveSubDealer =>
        string.Equals(status, "Active", StringComparison.OrdinalIgnoreCase);

    private SubDealerFormModel _model = new()
    {
        Status = SubDealerStatus.Active
    };

    private bool _isEditMode;
    private bool _isSaving;
    private bool _isLoadingSelected;
    private string status = "Active";

    private readonly Dictionary<string, string> _errors = new();

    private List<LocationItemDto> _statesAll = new();
    private List<LocationItemDto> _districtsAll = new();
    private List<LocationItemDto> _regionsAll = new();
    private List<LocationItemDto> _headquartersAll = new();

    private List<LocationItemDto> _filteredRegions = new();
    private List<LocationItemDto> _filteredHeadquarters = new();

    private List<SubDealerLookupDto> _subDealersAll = new();
    private List<SubDealerLookupDto> _filteredSubDealers = new();

    private int _basicInfoStateId;
    private int _basicInfoRegionId;
    private int _basicInfoHqId;
    private int _subDealerId;
    private int _intendedSubDealerId;
    private int _subDealerLoadSeq;

    private bool _isStateLocked;
    private bool _isRegionLocked;
    private bool _isHqLocked;

    private string _subDealerSearchText = "";
    private bool _showSubDealerDropdown;

    private string SelectedSubDealerDisplayText =>
        !string.IsNullOrWhiteSpace(_model.SubDealerCode) && !string.IsNullOrWhiteSpace(_model.FirmName)
            ? $"{_model.SubDealerCode} - {_model.FirmName}"
            : (!string.IsNullOrWhiteSpace(_subDealerSearchText)
                ? _subDealerSearchText
                : (_model.SubDealerCode ?? string.Empty));

    private string _stateSearchText = "";
    private bool _showStateDropdown;

    private string _districtSearchText = "";
    private bool _showDistrictDropdown;

    private string _latitudeLongitudeText = "";
    private string? _message;
    private bool _isError;

    private bool _isPincodeLookup;
    private int _pincodeOperationSeq;
    private string? _pincodeMessage;
    private bool _pincodeSuccess;

    private bool _isGettingLocation;
    private string? _locationMessage;
    private bool _locationSuccess;

    private IBrowserFile? _gstFile;
    private string? _persistedGstFilePath;
    private int _gstOperationSeq;
    private bool _isDownloadingGst;
    private static string FormatAuditTime(DateTime value) => value == default
        ? "Not available" : value.ToString("dd-MMM-yyyy HH:mm:ss.fff", CultureInfo.InvariantCulture) +
            (value.Kind == DateTimeKind.Utc ? " UTC" : string.Empty);
    private bool _isExtractingGst;
    private bool _ocrPopulatedGst;
    private string? _ocrWarningGst;

    // Admin Excel import state
    private bool _showImportModal;
    private bool _isImporting;
    private IBrowserFile? _importFile;
    private string? _importMessage;
    private bool _importHasError;
    private List<string> _importErrors = new();
    private const long MaxImportFileSize = 10 * 1024 * 1024;

    private DotNetObjectReference<SubDealerRegistration>? _objRef;

    private IEnumerable<SubDealerLookupDto> FilteredSubDealersForDropdown =>
        _filteredSubDealers.Where(x =>
            string.IsNullOrWhiteSpace(_subDealerSearchText) ||
            $"{x.SubDealerCode} - {x.FirmName}"
                .Contains(_subDealerSearchText, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<LocationItemDto> FilteredStatesForDropdown =>
        _statesAll.Where(x =>
            string.IsNullOrWhiteSpace(_stateSearchText) ||
            x.StateName.Contains(_stateSearchText, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<LocationItemDto> FilteredDistrictsForDropdown =>
        _districtsAll.Where(x =>
            x.StateId == (_model.DealerStateId ?? 0) &&
            (string.IsNullOrWhiteSpace(_districtSearchText) ||
             x.DistrictName.Contains(_districtSearchText, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        _objRef = DotNetObjectReference.Create(this);

        Loading.Show();
        try
        {
            await LoadData();
            ApplyLockedEmployeeLocation();

            if (SubDealerIdFromQuery.HasValue && SubDealerIdFromQuery.Value > 0)
            {
                // Record the edit intent before the async load starts so a
                // pending or failed load can never fall through to an
                // accidental POST that inserts a duplicate record.
                _intendedSubDealerId = SubDealerIdFromQuery.Value;
                _subDealerId = SubDealerIdFromQuery.Value;
                await LoadSubDealer(SubDealerIdFromQuery.Value);
            }
        }
        catch (Exception ex)
        {
            ShowMessage($"Failed to initialize Sub Dealer form: {ex.Message}", true);
        }
        finally
        {
            Loading.Hide();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            await JS.InvokeVoidAsync("initLeafletMap", "subDealerLeafletMap", _objRef);

            if (_model.Latitude.HasValue && _model.Longitude.HasValue)
                await TriggerMapUpdate(_model.Latitude.Value, _model.Longitude.Value);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Sub Dealer map initialization failed: {ex.Message}");
        }
    }

    public void Dispose()
    {
        _subDealerLoadSeq++;
        _gstOperationSeq++;
        _objRef?.Dispose();
    }

    private async Task LoadData()
    {
        // Lookup masters and Sub Dealers can still load in parallel.
        // The Sub Dealer API is now role-scoped, so the browser no longer
        // downloads the complete SubDealerRegistrations table.
        var cacheTask = LookupCache.EnsureLoadedAsync();

        var subDealerLookupUrl = BuildRoleScopedSubDealerLookupUrl();
        var subDealerTask = Http.GetFromJsonAsync<List<SubDealerLookupDto>>(
            subDealerLookupUrl);

        await Task.WhenAll(cacheTask, subDealerTask);

        _statesAll = LookupCache.States;
        _districtsAll = LookupCache.Districts;
        _regionsAll = LookupCache.Regions;
        _headquartersAll = LookupCache.Headquarters;

        _subDealersAll = subDealerTask.Result ?? new();

        // ApplyLockedEmployeeLocation() runs immediately after LoadData().
        // It will set the correct State / Region / HQ and call this again.
        ApplySubDealerClientFilter();
    }

    private string CurrentLoginRole =>
        LoginState?.UserRole?.ToString() ?? string.Empty;

    private bool IsLoginMoRole =>
        string.Equals(CurrentLoginRole, "MO", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(CurrentLoginRole, "MDO", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(CurrentLoginRole, "JMDO", StringComparison.OrdinalIgnoreCase);

    private bool IsLoginRmRole =>
        string.Equals(CurrentLoginRole, "RM", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(CurrentLoginRole, "RMD", StringComparison.OrdinalIgnoreCase);

    private bool IsLoginSmmRole =>
        string.Equals(CurrentLoginRole, "SMM", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(CurrentLoginRole, "SMD", StringComparison.OrdinalIgnoreCase);

    private string BuildRoleScopedSubDealerLookupUrl()
    {
        const string baseUrl = "api/SubDealerRegistration/lookup";

        if (LoginState != null && (IsAdminMaster || LoginState.IsDirectorOrAVP))
        {
            return baseUrl;
        }

        // MO / MDO / JMDO: ALWAYS HQ scope.
        // Explicit UserRole check is included so an MO never falls through
        // and downloads the full Sub Dealer master.
        if ((IsLoginMoRole || LoginState.IsHQRole) && LoginState.HQId > 0)
            return $"{baseUrl}?hqId={LoginState.HQId}";

        // RM / RMD: Region scope. Do not narrow RM by a stored HQId.
        if ((IsLoginRmRole || LoginState.IsRegionRole) && LoginState.RegionId > 0)
            return $"{baseUrl}?regionId={LoginState.RegionId}";

        // SMM / SMD: State scope.
        if ((IsLoginSmmRole || LoginState.IsStateRole) && LoginState.StateId > 0)
            return $"{baseUrl}?stateId={LoginState.StateId}";

        return baseUrl;
    }

    private void ApplySubDealerClientFilter()
    {
        IEnumerable<SubDealerLookupDto> query = _subDealersAll;

        if (_basicInfoStateId > 0)
            query = query.Where(x => x.StateId == _basicInfoStateId);

        if (_basicInfoRegionId > 0)
            query = query.Where(x => x.RegionId == _basicInfoRegionId);

        if (_basicInfoHqId > 0)
            query = query.Where(x => x.HQId == _basicInfoHqId);

        _filteredSubDealers = query.ToList();
    }

    private async Task LoadSubDealer(int id)
    {
        // Each load gets a new sequence so a late response from an older
        // selection cannot overwrite a newer selection or a reset to New Entry.
        var loadSequence = ++_subDealerLoadSeq;
        _gstOperationSeq++;
        _gstFile = null;
        _isExtractingGst = false;
        _isPincodeLookup = false;
        _isGettingLocation = false;
        _isLoadingSelected = true;
        _isEditMode = false;
        await InvokeAsync(StateHasChanged);

        try
        {
            var model = await Http.GetFromJsonAsync<SubDealerFormModel>(
                $"api/SubDealerRegistration/{id}");

            if (loadSequence != _subDealerLoadSeq)
                return;

            if (model == null || model.Id != id)
            {
                // Keep the intended edit id: a failed or mismatched load must
                // stay blocked from being saved as a new record.
                ShowMessage(
                    $"The selected Sub Dealer (Id {id}) could not be loaded. Please reload and select again.",
                    true);
                return;
            }

            // Keep the saved Sub Dealer values. Do not overwrite saved State/Region/HQ
            // with the currently logged-in employee location after loading.
            _model = model;
            _persistedGstFilePath = model.GSTFilePath;
            _model.FirmName ??= string.Empty;

            _subDealerId = model.Id;
            _intendedSubDealerId = model.Id;
            _isEditMode = true;

            _basicInfoStateId = model.StateId;
            _basicInfoRegionId = model.Region;
            _basicInfoHqId = model.HQ;

            status = model.Status == SubDealerStatus.InActive
                ? "Inactive"
                : "Active";

            // Rebuild the dependent dropdown lists from the SAVED values.
            _filteredRegions = _regionsAll
                .Where(x => x.StateId == _basicInfoStateId)
                .ToList();

            _filteredHeadquarters = _headquartersAll
                .Where(x => x.RegionId == _basicInfoRegionId)
                .ToList();

            ApplySubDealerClientFilter();

            // Same behavior as Dealer selection: selected code loads the firm name.
            _subDealerSearchText =
                $"{model.SubDealerCode} - {model.FirmName}";

            InitializeLocationSearchTexts();
            SyncLatitudeLongitudeText();

            if (_model.Latitude.HasValue && _model.Longitude.HasValue)
            {
                await TriggerMapUpdate(
                    _model.Latitude.Value,
                    _model.Longitude.Value);
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            if (loadSequence != _subDealerLoadSeq)
                return;

            ShowMessage($"Failed to load Sub Dealer: {ex.Message}", true);
        }
        finally
        {
            if (loadSequence == _subDealerLoadSeq)
                _isLoadingSelected = false;

            await InvokeAsync(StateHasChanged);
        }
    }

    private void ApplyLockedEmployeeLocation()
    {
        _isStateLocked = false;
        _isRegionLocked = false;
        _isHqLocked = false;

        // Admin / Director / AVP keep the existing unrestricted behavior.
        if (LoginState != null && (IsAdminMaster || LoginState.IsDirectorOrAVP))
        {
            ApplySubDealerClientFilter();
            return;
        }

        // MO / MDO / JMDO:
        // Lock State + Region + HQ to the logged-in user's assigned HQ.
        if ((IsLoginMoRole || LoginState.IsHQRole) && LoginState.HQId > 0)
        {
            var hqId = LoginState.HQId;
            var hq = _headquartersAll.FirstOrDefault(x => x.Id == hqId);

            var regionId = hq?.RegionId ??
                (LoginState.RegionId > 0
                    ? LoginState.RegionId
                    : 0);

            var stateId = regionId > 0
                ? _regionsAll.FirstOrDefault(x => x.Id == regionId)?.StateId ?? 0
                : 0;

            if (stateId <= 0 && LoginState.StateId > 0)
                stateId = LoginState.StateId;

            _basicInfoStateId = stateId;
            _basicInfoRegionId = regionId;
            _basicInfoHqId = hqId;

            _filteredRegions = _regionsAll
                .Where(x => x.StateId == _basicInfoStateId)
                .ToList();

            _filteredHeadquarters = _headquartersAll
                .Where(x => x.RegionId == _basicInfoRegionId)
                .ToList();

            _isStateLocked = _basicInfoStateId > 0;
            _isRegionLocked = _basicInfoRegionId > 0;
            _isHqLocked = true;

            ApplySubDealerClientFilter();
            return;
        }

        // RM / RMD:
        // Lock State + Region. HQ remains selectable within that Region.
        if ((IsLoginRmRole || LoginState.IsRegionRole) && LoginState.RegionId > 0)
        {
            var regionId = LoginState.RegionId;
            var stateId = _regionsAll
                .FirstOrDefault(x => x.Id == regionId)?.StateId ?? 0;

            if (stateId <= 0 && LoginState.StateId > 0)
                stateId = LoginState.StateId;

            _basicInfoStateId = stateId;
            _basicInfoRegionId = regionId;
            _basicInfoHqId = 0;

            _filteredRegions = _regionsAll
                .Where(x => x.StateId == _basicInfoStateId)
                .ToList();

            _filteredHeadquarters = _headquartersAll
                .Where(x => x.RegionId == _basicInfoRegionId)
                .ToList();

            _isStateLocked = _basicInfoStateId > 0;
            _isRegionLocked = true;
            _isHqLocked = false;

            ApplySubDealerClientFilter();
            return;
        }

        // SMM / SMD:
        // Lock only State. Region and HQ remain selectable inside the State.
        if ((IsLoginSmmRole || LoginState.IsStateRole) && LoginState.StateId > 0)
        {
            _basicInfoStateId = LoginState.StateId;
            _basicInfoRegionId = 0;
            _basicInfoHqId = 0;

            _filteredRegions = _regionsAll
                .Where(x => x.StateId == _basicInfoStateId)
                .ToList();

            _filteredHeadquarters = new();

            _isStateLocked = true;
            _isRegionLocked = false;
            _isHqLocked = false;

            ApplySubDealerClientFilter();
            return;
        }

        // Fallback: preserve the old behavior for any custom role that does not
        // expose IsHQRole / IsRegionRole / IsStateRole.
        if (LoginState.StateId > 0)
        {
            _basicInfoStateId = LoginState.StateId;
            _filteredRegions = _regionsAll
                .Where(x => x.StateId == _basicInfoStateId)
                .ToList();
            _isStateLocked = true;
        }

        if (LoginState.RegionId > 0)
        {
            _basicInfoRegionId = LoginState.RegionId;
            _filteredHeadquarters = _headquartersAll
                .Where(x => x.RegionId == _basicInfoRegionId)
                .ToList();
            _isRegionLocked = true;
        }

        if (LoginState.HQId > 0)
        {
            _basicInfoHqId = LoginState.HQId;
            _isHqLocked = true;
        }

        ApplySubDealerClientFilter();
    }

