    private void HandleImportFileSelected(InputFileChangeEventArgs e)
    {
        _importMessage = null;
        _importHasError = false;
        _importErrors.Clear();
        _importFile = null;

        var file = e.File;
        var extension = Path.GetExtension(file.Name);

        if (!string.Equals(extension, ".xlsx", StringComparison.OrdinalIgnoreCase))
        {
            _importHasError = true;
            _importMessage = "Only .xlsx Excel files are allowed.";
            return;
        }

        if (file.Size <= 0)
        {
            _importHasError = true;
            _importMessage = "The selected Excel file is empty.";
            return;
        }

        if (file.Size > MaxImportFileSize)
        {
            _importHasError = true;
            _importMessage = "Excel file size must be less than 10 MB.";
            return;
        }

        _importFile = file;
        _importMessage = $"Ready to import {file.Name}";
    }

    private async Task ImportSubDealersFromExcel()
    {
        if (!IsAdminMaster)
        {
            _importHasError = true;
            _importMessage = "Only Admin can import the Sub Dealer master.";
            return;
        }

        if (_importFile == null || _isImporting)
            return;

        _isImporting = true;
        _importHasError = false;
        _importMessage = null;
        _importErrors.Clear();

        try
        {
            // Step 1: Read Excel rows through the API.
            using var fileContent = new MultipartFormDataContent();
            await using var stream = _importFile.OpenReadStream(MaxImportFileSize);
            fileContent.Add(new StreamContent(stream), "file", _importFile.Name);

            var parseResponse = await Http.PostAsync(
                "api/SubDealerRegistration/parse-import-excel",
                fileContent);

            if (!parseResponse.IsSuccessStatusCode)
            {
                var errorBody = await parseResponse.Content.ReadAsStringAsync();
                _importHasError = true;
                _importMessage = $"Could not read Excel file: {errorBody}";
                return;
            }

            var parsed = await parseResponse.Content
                .ReadFromJsonAsync<SubDealerExcelParseResponse>();

            if (parsed == null)
            {
                _importHasError = true;
                _importMessage = "The API returned an empty Excel import response.";
                return;
            }

            // Structural Excel problems still stop the import because these are not
            // master-mapping issues (missing columns, duplicate codes, blank required cells, etc.).
            if (parsed.Errors.Count > 0)
            {
                _importErrors.AddRange(parsed.Errors);
                _importHasError = true;
                _importMessage = "Excel validation failed. Nothing was saved.";
                return;
            }

            if (parsed.Rows.Count == 0)
            {
                _importHasError = true;
                _importMessage = "No Sub Dealer rows were found in the Excel file.";
                return;
            }

            // Step 2: Build lookup dictionaries once for fast mapping.
            // Exact hierarchy is preferred. If the Excel hierarchy differs from the
            // current application master, a globally UNIQUE Region/HQ name is allowed
            // as a safe fallback and the application's actual hierarchy is used.
            var statesByName = _statesAll
                .Where(x => !string.IsNullOrWhiteSpace(x.StateName))
                .GroupBy(x => NormalizeMasterValue(x.StateName))
                .Where(g => g.Select(x => x.Id).Distinct().Count() == 1)
                .ToDictionary(x => x.Key, x => x.First(), StringComparer.OrdinalIgnoreCase);

            var regionsByStateAndName = _regionsAll
                .Where(x => !string.IsNullOrWhiteSpace(x.RegionName))
                .GroupBy(x => $"{x.StateId}|{NormalizeMasterValue(x.RegionName)}")
                .Where(g => g.Select(x => x.Id).Distinct().Count() == 1)
                .ToDictionary(x => x.Key, x => x.First(), StringComparer.OrdinalIgnoreCase);

            var hqsByRegionAndName = _headquartersAll
                .Where(x => !string.IsNullOrWhiteSpace(x.HeadquarterName))
                .GroupBy(x => $"{x.RegionId}|{NormalizeMasterValue(x.HeadquarterName)}")
                .Where(g => g.Select(x => x.Id).Distinct().Count() == 1)
                .ToDictionary(x => x.Key, x => x.First(), StringComparer.OrdinalIgnoreCase);

            var mappedRows = new List<SubDealerBulkImportRowDto>();
            var seenCodes = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

            foreach (var row in parsed.Rows)
            {
                var code = row.SubDealerCode?.Trim() ?? string.Empty;
                var name = row.SubDealerName?.Trim() ?? string.Empty;

                if (SubDealerFormModel.CodeError(code) is string codeError)
                {
                    _importErrors.Add($"Excel row {row.RowNumber}: {codeError}");
                    continue;
                }

                if (string.IsNullOrWhiteSpace(name))
                {
                    _importErrors.Add($"Excel row {row.RowNumber}: Sub Dealer Name is empty.");
                    continue;
                }

                if (seenCodes.Contains(code))
                {
                    _importErrors.Add($"Excel row {row.RowNumber}: duplicate Sub Dealer Code '{code}'.");
                    continue;
                }

                var normalizedState = NormalizeMasterValue(row.State);
                if (!statesByName.TryGetValue(normalizedState, out var stateItem))
                {
                    _importErrors.Add(
                        $"Excel row {row.RowNumber}: State '{row.State}' was not found in State master.");
                    continue;
                }

                var normalizedRegion = NormalizeMasterValue(row.Region);
                var normalizedHq = NormalizeMasterValue(row.HQ);

                var resolvedState = stateItem;
                LocationItemDto? resolvedRegion = null;
                LocationItemDto? resolvedHq = null;

                // 1. Exact Region under Excel State.
                var exactRegionKey = $"{resolvedState.Id}|{normalizedRegion}";
                regionsByStateAndName.TryGetValue(exactRegionKey, out resolvedRegion);

                if (resolvedRegion != null)
                {
                    // 2. Exact HQ under the exact Region.
                    var exactHqKey = $"{resolvedRegion.Id}|{normalizedHq}";
                    hqsByRegionAndName.TryGetValue(exactHqKey, out resolvedHq);
                }

                // Do not substitute a globally matching HQ/Region from a different hierarchy.
                if (resolvedRegion == null)
                {
                    _importErrors.Add(
                        $"Excel row {row.RowNumber}: Region '{row.Region}' could not be matched to the application master.");
                    continue;
                }

                if (resolvedHq == null)
                {
                    _importErrors.Add(
                        $"Excel row {row.RowNumber}: HQ '{row.HQ}' could not be matched to the application master.");
                    continue;
                }

                seenCodes.Add(code);
                mappedRows.Add(new SubDealerBulkImportRowDto
                {
                    ExcelRowNumber = row.RowNumber,
                    SubDealerCode = code,
                    FirmName = name.ToUpperInvariant(),
                    StateId = resolvedState.Id,
                    RegionId = resolvedRegion.Id,
                    HQId = resolvedHq.Id
                });
            }

            // Important V5 behavior:
            // Do NOT cancel 37k valid rows because a few master rows cannot map.
            // Save all mapped rows and report only the unresolved rows as skipped.
            var skippedCount = _importErrors.Count;

            if (mappedRows.Count == 0)
            {
                _importHasError = true;
                _importMessage =
                    $"No rows could be mapped. Skipped: {skippedCount}. Nothing was saved.";
                return;
            }

            var request = new SubDealerBulkImportRequest
            {
                ImportedBy = LoginState.UserId ?? "Admin Excel Import",
                Rows = mappedRows
            };

            // Step 3: backend upserts only the successfully mapped rows.
            var saveResponse = await Http.PostAsJsonAsync(
                "api/SubDealerRegistration/bulk-import",
                request);

            if (!saveResponse.IsSuccessStatusCode)
            {
                var responseBody = await saveResponse.Content.ReadAsStringAsync();
                _importHasError = true;
                _importMessage = $"Excel import failed: {responseBody}";
                return;
            }

            var result = await saveResponse.Content
                .ReadFromJsonAsync<SubDealerBulkImportResponse>();

            if (result == null)
            {
                _importHasError = true;
                _importMessage = "Excel import completed but the API response was empty.";
                return;
            }

            if (result.Errors.Count > 0)
            {
                _importErrors.AddRange(result.Errors);
                _importHasError = true;
                _importMessage = "Excel import failed during database save.";
                return;
            }

            // Step 4: refresh dropdown immediately.
            await RefreshSubDealerLookup();
            _importFile = null;

            if (skippedCount > 0)
            {
                // Keep popup open so Admin can see which rows were skipped.
                _importHasError = true;
                _importMessage =
                    $"Import completed. Inserted: {result.Inserted}, Updated: {result.Updated}, Skipped: {skippedCount}. " +
                    "Valid rows were saved. Review the skipped rows below.";
            }
            else
            {
                _showImportModal = false;
                _importHasError = false;
                _importMessage = null;

                ShowMessage(
                    $"Sub Dealer master imported successfully. Inserted: {result.Inserted}, Updated: {result.Updated}.",
                    false);
            }
        }
        catch (Exception ex)
        {
            _importHasError = true;
            _importMessage = $"Import error: {ex.Message}";
        }
        finally
        {
            _isImporting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string NormalizeMasterValue(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return string.Empty;

        var normalized = new string(value
            .Trim()
            .Where(char.IsLetterOrDigit)
            .Select(char.ToUpperInvariant)
            .ToArray());

        // Common legacy/current naming equivalence in master files.
        // Apply this normalization to BOTH Excel values and application master values.
        return normalized switch
        {
            "PONDICHERRY" => "PUDUCHERRY",
            "PUDUCHERRY" => "PUDUCHERRY",
            _ => normalized
        };
    }

    private bool Validate()
    {
        _errors.Clear();
        if (_intendedSubDealerId <= 0 || !_isEditMode || _model.Id != _intendedSubDealerId)
            _errors["SubDealerCode"] = "Select an imported Sub Dealer before saving.";

        // Same conditional rules as the API. A locally selected PDF is uploaded before PUT;
        // never put a local file name into GSTFilePath simply to pass validation.
        foreach (var error in _model.Validate(new ValidationContext(_model)))
        {
            foreach (var field in error.MemberNames)
            {
                if (field == nameof(SubDealerFormModel.GSTFilePath) && _gstFile != null) continue;
                var key = field switch
                {
                    nameof(SubDealerFormModel.ShopNoORRoomNoOrBlockNo) => "ShopNo",
                    nameof(SubDealerFormModel.GSTFilePath) => "GSTFile",
                    _ => field
                };
                _errors.TryAdd(key, error.ErrorMessage ?? "Check this field.");
            }
        }
        return _errors.Count == 0;
    }

    private static async Task<string> ReadApiErrorAsync(HttpResponseMessage response)
    {
        var text = await response.Content.ReadAsStringAsync();
        try
        {
            using var json = JsonDocument.Parse(text);
            var root = json.RootElement;
            if (root.ValueKind == JsonValueKind.String)
                return root.GetString() ?? "Request failed.";
            if (root.ValueKind == JsonValueKind.Object)
            {
                if (root.TryGetProperty("errors", out var errors) && errors.ValueKind == JsonValueKind.Object)
                {
                    var messages = new List<string>();
                    foreach (var item in errors.EnumerateObject())
                    {
                        if (item.Value.ValueKind == JsonValueKind.Array)
                            messages.AddRange(item.Value.EnumerateArray()
                                .Where(x => x.ValueKind == JsonValueKind.String)
                                .Select(x => x.GetString() ?? "Check the submitted values."));
                    }
                    if (messages.Count > 0) return string.Join(" ", messages.Distinct());
                }
                foreach (var item in root.EnumerateObject())
                    if ((item.Name.Equals("message", StringComparison.OrdinalIgnoreCase) || item.Name == "detail") &&
                        item.Value.ValueKind == JsonValueKind.String)
                        return item.Value.GetString() ?? "Request failed.";
            }
        }
        catch (JsonException) { }
        return string.IsNullOrWhiteSpace(text) || text.TrimStart().StartsWith("<", StringComparison.Ordinal)
            ? $"Request failed (HTTP {(int)response.StatusCode}). Please retry or contact Admin."
            : text;
    }

    private async Task HandleSubmit()
    {
        if (IsViewOnly || _isSaving) return;
        if (_isLoadingSelected || _isExtractingGst || _isPincodeLookup || _isGettingLocation)
        {
            ShowMessage("Please wait for the current record/file/location operation to finish.", true);
            return;
        }
        if (_intendedSubDealerId <= 0 || !_isEditMode || _model.Id <= 0 ||
            _model.Id != _subDealerId || _model.Id != _intendedSubDealerId)
        {
            ShowMessage("Select an imported Sub Dealer and wait for its details to load. This screen never creates a new master.", true);
            return;
        }
        if (!Validate())
        {
            ShowMessage("Please correct the highlighted fields.", true);
            return;
        }
        _isSaving = true;
        _message = null;
        var requestSent = false;
        try
        {
            _model.Status = status == "Inactive" ? SubDealerStatus.InActive : SubDealerStatus.Active;
            // Existing imported Id is available, so upload BEFORE the single profile PUT.
            if (_gstFile != null)
            {
                var upload = await UploadGstToServer(_model.Id, _gstFile);
                if (upload == null || string.IsNullOrWhiteSpace(upload.FilePath)) return;
                _model.GSTFilePath = upload.FilePath;
                _gstFile = null; // keep the staged server path for a retry if profile validation fails
            }
            // Keep the UpdatedAt loaded from the API: it is the expected record version.
            // CreatedAt/CreatedBy/UpdatedBy are NOT assigned by this page.
            requestSent = true;
            using var response = await Http.PutAsJsonAsync($"api/SubDealerRegistration/{_model.Id}", _model);
            if (!response.IsSuccessStatusCode)
            {
                ShowMessage($"Sub Dealer save was not confirmed: {await ReadApiErrorAsync(response)}", true);
                return;
            }
            var saved = await response.Content.ReadFromJsonAsync<SubDealerFormModel>();
            if (saved == null)
            {
                ShowMessage("The response was empty. Reload the record to verify whether it was saved before retrying.", true);
                return;
            }
            _model = saved;
            _persistedGstFilePath = saved.GSTFilePath;
            var savedCode = saved.SubDealerCode;
            var refreshFailed = false;
            try { await RefreshSubDealerLookup(); }
            catch { refreshFailed = true; }
            ResetForNewEntry();
            ShowMessage($"Sub Dealer {savedCode} saved successfully." +
                (refreshFailed ? " Refresh the page to reload the master selection." : string.Empty), false);
        }
        catch (Exception ex)
        {
            ShowMessage(requestSent
                ? $"Save outcome could not be confirmed. Reload before retrying. {ex.Message}"
                : $"Profile was not submitted. {ex.Message}", true);
        }
        finally { _isSaving = false; }
    }

    private async Task RefreshSubDealerLookup()
    {
        _subDealersAll =
            await Http.GetFromJsonAsync<List<SubDealerLookupDto>>(
                BuildRoleScopedSubDealerLookupUrl()) ?? new();

        ApplySubDealerClientFilter();
    }

    private async Task OnPincodeChanged()
    {
        if (IsViewOnly || _isSaving) return;
        var loadSeq = _subDealerLoadSeq;
        var pincodeOperation = ++_pincodeOperationSeq;
        _isPincodeLookup = false;
        _pincodeMessage = null;
        _pincodeSuccess = false;
        _errors.Remove("PinCode");

        if (!string.IsNullOrEmpty(_model.PinCode))
        {
            var digitsOnly = new string(_model.PinCode.Where(char.IsDigit).ToArray());
            if (digitsOnly != _model.PinCode)
                _model.PinCode = digitsOnly;
        }

        if (string.IsNullOrWhiteSpace(_model.PinCode) || _model.PinCode.Length != 6)
            return;

        var requestedPincode = _model.PinCode;
        _isPincodeLookup = true;
        StateHasChanged();

        try
        {
            using var response = await Http.GetAsync($"api/PincodeLookup/{requestedPincode}");
            if (loadSeq != _subDealerLoadSeq || pincodeOperation != _pincodeOperationSeq || _model.PinCode != requestedPincode) return;

            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                _pincodeMessage = $"Lookup failed (HTTP {(int)response.StatusCode}): {body}";
                return;
            }

            var results = await response.Content.ReadFromJsonAsync<List<PincodeApiResponse>>();
            if (loadSeq != _subDealerLoadSeq || pincodeOperation != _pincodeOperationSeq || _model.PinCode != requestedPincode) return;
            var result = results?.FirstOrDefault();

            if (result == null
                || !string.Equals(result.Status, "Success", StringComparison.OrdinalIgnoreCase)
                || result.PostOffice == null
                || result.PostOffice.Count == 0)
            {
                _pincodeMessage = $"No data found for pincode {_model.PinCode}";
                return;
            }

            var postOffice = result.PostOffice[0];

            var apiState = postOffice.State?.Trim().Replace(" ", "") ?? "";
            var matchedState = _statesAll.FirstOrDefault(s =>
                s.StateName.Trim().Replace(" ", "").Equals(apiState, StringComparison.OrdinalIgnoreCase));
            if (matchedState != null)
            {
                _model.DealerStateId = matchedState.Id;
                _stateSearchText = matchedState.StateName;
                _errors.Remove("DealerStateId");
            }

            var apiDistrict = postOffice.District?.Trim().Replace(" ", "") ?? "";
            var matchedDistrict = _districtsAll.FirstOrDefault(d =>
                d.StateId == (_model.DealerStateId ?? 0) &&
                d.DistrictName.Trim().Replace(" ", "").Equals(apiDistrict, StringComparison.OrdinalIgnoreCase));
            if (matchedDistrict != null)
            {
                _model.DistrictId = matchedDistrict.Id;
                _districtSearchText = matchedDistrict.DistrictName;
                _errors.Remove("DistrictId");
            }

            if (!string.IsNullOrWhiteSpace(postOffice.Block) && postOffice.Block != "NA")
            {
                _model.Block = postOffice.Block;
                _model.Taluk = postOffice.Block;
            }
            else if (!string.IsNullOrWhiteSpace(postOffice.Division))
            {
                _model.Taluk = postOffice.Division;
            }

            if (!string.IsNullOrWhiteSpace(postOffice.Name))
            {
                _model.Village = postOffice.Name;
                _errors.Remove("Village");
            }

            var details = new List<string>();
            if (!string.IsNullOrWhiteSpace(postOffice.Name))
                details.Add($"Village: {postOffice.Name}");
            if (!string.IsNullOrWhiteSpace(postOffice.Block) && postOffice.Block != "NA")
                details.Add($"Block: {postOffice.Block}");
            if (!string.IsNullOrWhiteSpace(_model.Taluk))
                details.Add($"Taluk: {_model.Taluk}");
            if (matchedDistrict != null)
                details.Add($"District: {matchedDistrict.DistrictName}");
            if (matchedState != null)
                details.Add($"State: {matchedState.StateName}");

            _pincodeSuccess = true;
            _pincodeMessage = "Auto-filled: " + string.Join(", ", details);
        }
        catch (HttpRequestException httpEx)
        {
            if (loadSeq != _subDealerLoadSeq || pincodeOperation != _pincodeOperationSeq) return;
            _pincodeMessage = $"Network error: {httpEx.Message}";
        }
        catch (TaskCanceledException)
        {
            if (loadSeq != _subDealerLoadSeq || pincodeOperation != _pincodeOperationSeq) return;
            _pincodeMessage = "Lookup timed out - try again.";
        }
        catch (Exception ex)
        {
            if (loadSeq != _subDealerLoadSeq || pincodeOperation != _pincodeOperationSeq) return;
            _pincodeMessage = $"{ex.GetType().Name}: {ex.Message}";
        }
        finally
        {
            if (loadSeq == _subDealerLoadSeq && pincodeOperation == _pincodeOperationSeq) _isPincodeLookup = false;
        }
    }

    private async Task OnGoogleMapUrlChanged()
    {
        if (IsViewOnly || _isSaving) return;
        _locationMessage = null;
        if (string.IsNullOrWhiteSpace(_model.GoogleMapURL))
        {
            _model.Latitude = null;
            _model.Longitude = null;
            SyncLatitudeLongitudeText();
            return;
        }

        var url = _model.GoogleMapURL.Trim();

        if (url.Contains("goo.gl") || url.Contains("maps.app.goo.gl"))
        {
            _locationMessage = "Shortened URL detected. Please open the link in browser, copy the full URL from address bar, and paste it here.";
            _locationSuccess = false;
            return;
        }

        var match = Regex.Match(url, @"@(-?\d+\.\d+),(-?\d+\.\d+)");
        if (!match.Success) match = Regex.Match(url, @"[?&]q=(-?\d+\.\d+),(-?\d+\.\d+)");
        if (!match.Success) match = Regex.Match(url, @"[?&]ll=(-?\d+\.\d+),(-?\d+\.\d+)");
        if (!match.Success) match = Regex.Match(url, @"/dir//(-?\d+\.\d+),(-?\d+\.\d+)");
        if (!match.Success) match = Regex.Match(url, @"(-?\d+\.\d+),\s*(-?\d+\.\d+)");

        if (match.Success
            && double.TryParse(match.Groups[1].Value, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var lat)
            && double.TryParse(match.Groups[2].Value, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var lng))
        {
            _model.Latitude = lat;
            _model.Longitude = lng;
            SyncLatitudeLongitudeText();
            _errors.Remove("Latitude");
            _errors.Remove("Longitude");
            _locationMessage = $"Coordinates extracted: {lat:F6}, {lng:F6}";
            _locationSuccess = true;
            await TriggerMapUpdate(lat, lng);
        }
        else
        {
            _model.Latitude = null;
            _model.Longitude = null;
            SyncLatitudeLongitudeText();
            _locationMessage = "Could not extract coordinates from this URL. Try pasting the full Google Maps link.";
            _locationSuccess = false;
        }
    }

    private void OnLatitudeLongitudeChanged(ChangeEventArgs e)
    {
        if (IsViewOnly || _isSaving) return;
        _latitudeLongitudeText = e.Value?.ToString() ?? "";

        _errors.Remove("Latitude");
        _errors.Remove("Longitude");

        // Empty coordinates are allowed for Inactive Sub Dealers.
        if (!IsActiveSubDealer &&
            string.IsNullOrWhiteSpace(_latitudeLongitudeText))
        {
            _model.Latitude = null;
            _model.Longitude = null;
            return;
        }

        var parts = _latitudeLongitudeText
            .Trim()
            .Split(',', StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length >= 2 &&
            double.TryParse(
                parts[0].Trim(),
                System.Globalization.NumberStyles.Float,
                System.Globalization.CultureInfo.InvariantCulture,
                out var lat) &&
            double.TryParse(
                parts[1].Trim(),
                System.Globalization.NumberStyles.Float,
                System.Globalization.CultureInfo.InvariantCulture,
                out var lng))
        {
            _model.Latitude = lat;
            _model.Longitude = lng;
            _ = TriggerMapUpdate(lat, lng);
        }
        else
        {
            _model.Latitude = null;
            _model.Longitude = null;
            _errors["Latitude"] =
                "Enter Latitude & Longitude as e.g. 10.7905, 78.7047";
            _errors["Longitude"] =
                "Enter Latitude & Longitude as e.g. 10.7905, 78.7047";
        }
    }

    private void SyncLatitudeLongitudeText()
    {
        string Fmt(double d) => d.ToString("G17", System.Globalization.CultureInfo.InvariantCulture);

        if (_model.Latitude.HasValue && _model.Longitude.HasValue)
            _latitudeLongitudeText = $"{Fmt(_model.Latitude.Value)}, {Fmt(_model.Longitude.Value)}";
        else if (_model.Latitude.HasValue)
            _latitudeLongitudeText = Fmt(_model.Latitude.Value);
        else if (_model.Longitude.HasValue)
            _latitudeLongitudeText = Fmt(_model.Longitude.Value);
        else
            _latitudeLongitudeText = "";
    }

    private async Task UseCurrentLocation()
    {
        if (IsViewOnly || _isSaving || !_isEditMode) return;
        var loadSeq = _subDealerLoadSeq;
        _isGettingLocation = true;
        _locationMessage = null;
        StateHasChanged();

        try
        {
            var result =
                await JS.InvokeAsync<GeoLocationResult>(
                    "getCurrentPosition");
            if (loadSeq != _subDealerLoadSeq) return;

            if (!string.IsNullOrWhiteSpace(result.Error))
            {
                _locationMessage =
                    $"Location error: {result.Error}";
                _locationSuccess = false;
                return;
            }

            _model.Latitude = result.Latitude;
            _model.Longitude = result.Longitude;
            SyncLatitudeLongitudeText();

            _model.GoogleMapURL =
                $"http://maps.google.com/maps?q={result.Latitude.ToString(System.Globalization.CultureInfo.InvariantCulture)},{result.Longitude.ToString(System.Globalization.CultureInfo.InvariantCulture)}";

            _errors.Remove("Latitude");
            _errors.Remove("Longitude");

            _locationMessage =
                $"Location captured: {result.Latitude:F6}, {result.Longitude:F6}";
            _locationSuccess = true;

            await TriggerMapUpdate(
                result.Latitude,
                result.Longitude);
        }
        catch (Exception ex)
        {
            if (loadSeq != _subDealerLoadSeq) return;
            _locationMessage =
                $"Failed to get location: {ex.Message}";
            _locationSuccess = false;
        }
        finally
        {
            if (loadSeq == _subDealerLoadSeq) _isGettingLocation = false;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public void UpdateLocationFromMap(double lat, double lng)
    {
        if (IsViewOnly || _isSaving || _isLoadingSelected || !_isEditMode) return;
        if (!double.IsFinite(lat) || !double.IsFinite(lng) || lat < -90 || lat > 90 || lng < -180 || lng > 180) return;
        _model.Latitude = lat;
        _model.Longitude = lng;
        SyncLatitudeLongitudeText();

        _model.GoogleMapURL =
            $"http://maps.google.com/maps?q={lat.ToString(System.Globalization.CultureInfo.InvariantCulture)},{lng.ToString(System.Globalization.CultureInfo.InvariantCulture)}";

        _errors.Remove("Latitude");
        _errors.Remove("Longitude");

        _locationMessage =
            $"Location selected from Map: {lat:F6}, {lng:F6}";
        _locationSuccess = true;

        StateHasChanged();
    }

    private async Task TriggerMapUpdate(double lat, double lng)
    {
        try
        {
            await JS.InvokeVoidAsync(
                "updateLeafletMap",
                "subDealerLeafletMap",
                lat,
                lng);
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"Sub Dealer map update failed: {ex.Message}");
        }
    }
    private void ShowMessage(string message, bool isError)
    {
        _message = message;
        _isError = isError;
    }

