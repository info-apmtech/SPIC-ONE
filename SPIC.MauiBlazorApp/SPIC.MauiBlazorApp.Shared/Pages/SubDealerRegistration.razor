    private void OnPANNumberChanged()
    {
        _errors.Remove("PANNo");

        if (string.IsNullOrWhiteSpace(_model.PANNo))
        {
            _model.PANNo = null;
            return;
        }

        _model.PANNo = _model.PANNo
            .Trim()
            .ToUpperInvariant();

        if (Regex.IsMatch(
            _model.PANNo,
            @"^[A-Z]{5}[0-9]{4}[A-Z]$"))
        {
            _errors.Remove("PANNo");
        }
    }

    private void OnGSTNumberChanged()
    {
        if (_ocrPopulatedGst)
        {
            _ocrPopulatedGst = false;
        }
        else
        {
            _ocrWarningGst = null;
        }

        if (!string.IsNullOrWhiteSpace(_model.GSTNumber))
            _model.GSTNumber = _model.GSTNumber.ToUpperInvariant();

        if (!string.IsNullOrWhiteSpace(_model.GSTNumber) &&
            Regex.IsMatch(
                _model.GSTNumber,
                @"^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$"))
        {
            _errors.Remove("GSTNumber");
        }
    }

    private async Task HandleGstUpload(InputFileChangeEventArgs e)
    {
        if (IsViewOnly || _isSaving || !_isEditMode || _model.Id <= 0)
        {
            ShowMessage("Select an imported Sub Dealer before uploading a certificate.", true);
            return;
        }
        var file = e.File;
        _errors.Remove("GSTFile");
        if (!string.Equals(Path.GetExtension(file.Name), ".pdf", StringComparison.OrdinalIgnoreCase) ||
            file.Size <= 0 || file.Size > 5 * 1024 * 1024)
        {
            _errors["GSTFile"] = "Choose a non-empty GST PDF of 5 MB or smaller.";
            _gstFile = null;
            // Do not erase the existing saved certificate when a bad replacement is selected.
            return;
        }
        var recordId = _model.Id;
        var loadSeq = _subDealerLoadSeq;
        var operation = ++_gstOperationSeq;
        _gstFile = file;
        // GSTFilePath remains the stored/staged server path, NEVER file.Name.
        _ocrWarningGst = null;
        _isExtractingGst = true;
        try
        {
            using var content = new MultipartFormDataContent();
            await using var stream = file.OpenReadStream(5 * 1024 * 1024);
            content.Add(new StreamContent(stream), "file", file.Name);
            using var response = await Http.PostAsync("api/DealerFile/ocr-extract", content);
            if (loadSeq != _subDealerLoadSeq || operation != _gstOperationSeq || _model.Id != recordId || _gstFile != file) return;
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<GstOcrExtractResult>();
                if (loadSeq != _subDealerLoadSeq || operation != _gstOperationSeq || _model.Id != recordId || _gstFile != file) return;
                if (!string.IsNullOrWhiteSpace(result?.GSTLegalName)) _model.GSTLegalName = result.GSTLegalName;
                if (!string.IsNullOrWhiteSpace(result?.GSTTradeName)) _model.GSTTradeName = result.GSTTradeName;
                if (!string.IsNullOrWhiteSpace(result?.GSTConstitutionofBusiness)) _model.GSTConstitutionofBusiness = result.GSTConstitutionofBusiness;
                if (!string.IsNullOrWhiteSpace(result?.GST))
                {
                    _model.GSTNumber = result.GST;
                    _ocrPopulatedGst = true;
                    OnGSTNumberChanged();
                    _ocrWarningGst = "GST values were extracted from the PDF. Verify them before submitting.";
                }
                else _ocrWarningGst = "GST could not be extracted. Enter and verify the details manually.";
            }
            else _ocrWarningGst = "GST extraction is unavailable. Enter and verify the details manually.";
        }
        catch
        {
            if (loadSeq == _subDealerLoadSeq && operation == _gstOperationSeq)
                _ocrWarningGst = "GST extraction is unavailable. Enter and verify the details manually.";
        }
        finally
        {
            if (loadSeq == _subDealerLoadSeq && operation == _gstOperationSeq) _isExtractingGst = false;
        }
    }

    private Task RemoveGstFile()
    {
        if (IsViewOnly || _isSaving) return Task.CompletedTask;
        _gstOperationSeq++;
        _gstFile = null;
        _isExtractingGst = false;
        _model.GSTFilePath = null;
        _errors.Remove("GSTFile");
        ShowMessage("Certificate removal is pending. Submit to save it. Active records require a replacement GST PDF; the existing server file has not been deleted.", false);
        return Task.CompletedTask;
    }

    private async Task DownloadGstFile()
    {
        if (_isDownloadingGst || _model.Id <= 0 || string.IsNullOrWhiteSpace(_persistedGstFilePath)) return;
        _isDownloadingGst = true;
        try
        {
            var name = Path.GetFileName(_persistedGstFilePath.Replace('\\', '/'));
            using var response = await Http.GetAsync($"api/SubDealerFile/content/{_model.Id}/GST/{Uri.EscapeDataString(name)}");
            if (!response.IsSuccessStatusCode)
            {
                ShowMessage($"GST download failed: {await ReadApiErrorAsync(response)}", true);
                return;
            }
            var bytes = await response.Content.ReadAsByteArrayAsync();
            await JS.InvokeVoidAsync("downloadFileFromBytes", $"SubDealer-{_model.Id}-GST.pdf", "application/pdf", Convert.ToBase64String(bytes));
        }
        catch (Exception ex) { ShowMessage($"GST download failed: {ex.Message}", true); }
        finally { _isDownloadingGst = false; }
    }

    private async Task<SubDealerFileUploadResponse?> UploadGstToServer(
        int subDealerId,
        IBrowserFile file)
    {
        try
        {
            using var content = new MultipartFormDataContent();
            await using var stream = file.OpenReadStream(5 * 1024 * 1024);
            content.Add(new StreamContent(stream), "file", file.Name);

            var response = await Http.PostAsync(
                $"api/SubDealerFile/upload/{subDealerId}/GST",
                content);

            if (response.IsSuccessStatusCode)
            {
                return await response.Content
                    .ReadFromJsonAsync<SubDealerFileUploadResponse>();
            }

            var body = await ReadApiErrorAsync(response);
            ShowMessage($"GST upload failed: {body}", true);
        }
        catch (Exception ex)
        {
            ShowMessage($"GST upload failed: {ex.Message}", true);
        }

        return null;
    }

