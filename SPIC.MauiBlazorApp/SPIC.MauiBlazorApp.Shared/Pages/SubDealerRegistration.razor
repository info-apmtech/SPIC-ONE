    private void SelectStatus(string value)
    {
        status = value;
        _model.Status = value == "Inactive"
            ? SubDealerStatus.InActive
            : SubDealerStatus.Active;

        // If validation was already triggered while Active, remove those
        // red errors immediately when the record becomes Inactive.
        if (!IsActiveSubDealer)
        {
            ClearActiveOnlyValidationErrors();
        }
        else
        {
            // When switching to Active, immediately validate so the UI shows
            // the newly-required fields (asterisks) without waiting for submit.
            Validate();
            InvokeAsync(StateHasChanged);
        }
    }

    private void ClearActiveOnlyValidationErrors()
    {
        var activeOnlyKeys = new[]
        {
            "ShopNo",
            "Village",
            "Latitude",
            "Longitude",
            "PinCode",
            "DistrictId",
            "DealerStateId",
            "OfficialContactNumber",
            "WhatsAppNumber",
            "AlternativeNumber",
            "GoogleMapURL",
            "Street",
            "SubVillage",
            "Block",
            "Taluk",
            "WholesaleMFMSId",
            "RetailMFMSId",
            "PANNo",
            "GSTNumber",
            "GSTFile"
        };

        foreach (var key in activeOnlyKeys)
            _errors.Remove(key);
    }

    private async Task SelectSubDealer(int id, string displayText)
    {
        // Do not allow re-selection while a save is in flight.
        if (_isSaving)
            return;

        _showSubDealerDropdown = false;
        _subDealerId = id;
        _intendedSubDealerId = id;
        _subDealerSearchText = displayText;
        _errors.Clear();
        _message = null;

        if (id > 0)
        {
            // Show Firm Name immediately from the lookup, then load the full record.
            var selectedItem = _subDealersAll.FirstOrDefault(x => x.Id == id);
            if (selectedItem != null)
                _model.FirmName = selectedItem.FirmName ?? string.Empty;

            await LoadSubDealer(id);
        }
        else
        {
            ResetForNewEntry();
        }

        await InvokeAsync(StateHasChanged);
    }

    private void ResetForNewEntry()
    {
        _model = new SubDealerFormModel
        {
            Status = SubDealerStatus.Active,
            SubDealerCode = string.Empty
        };

        // Invalidate any in-flight detail load so a late response cannot
        // repopulate the form while a New Entry is being created.
        _subDealerLoadSeq++;
        _isLoadingSelected = false;

        _intendedSubDealerId = 0;
        _subDealerId = 0;
        _isEditMode = false;
        _subDealerSearchText = "";
        _showSubDealerDropdown = false;
        status = "Active";

        // File / OCR state
        _gstOperationSeq++;
        _persistedGstFilePath = null;
        _gstFile = null;
        _ocrPopulatedGst = false;
        _ocrWarningGst = null;
        _isExtractingGst = false;

        // Primary-location UI state
        _stateSearchText = "";
        _districtSearchText = "";
        _latitudeLongitudeText = "";
        _showStateDropdown = false;
        _showDistrictDropdown = false;

        _pincodeMessage = null;
        _pincodeSuccess = false;
        _isPincodeLookup = false;

        _locationMessage = null;
        _locationSuccess = false;
        _isGettingLocation = false;

        _errors.Clear();
        _message = null;
        _isError = false;

        // Keep only the logged-in user's allowed State / Region / HQ.
        ApplyLockedEmployeeLocation();
    }

