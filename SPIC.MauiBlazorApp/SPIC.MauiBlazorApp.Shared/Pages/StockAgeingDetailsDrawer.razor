@using SPIC.MauiBlazorApp.Shared.Pages
@using SPIC.Core.DTOs

@if (IsOpen)
{
    <div class="sad-overlay" @onclick="CloseDrawer">
        <div class="sad-drawer" @onclick:stopPropagation="true">
            
            <div class="sad-header">
                <div class="sad-header-titles">
                    <h2>Stock Ageing Details</h2>
                    <div class="sad-status-badge">
                        <div class="sad-dot"></div>
                        @Val(Row?.Status)
                    </div>
                </div>
                <button class="sad-close-icon" @onclick="CloseDrawer" aria-label="Close">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="15" y1="9" x2="9" y2="15"></line>
                        <line x1="9" y1="9" x2="15" y2="15"></line>
                    </svg>
                </button>
            </div>

            <div class="sad-body">
                
                <div class="sad-section">
                    <h3>Dealer Information</h3>
                    <div class="sad-row">
                        <span class="sad-label">Dealer Name</span>
                        <span class="sad-value"><span class="sad-colon">:</span> @Val(Row?.DealerName)</span>
                    </div>
                    <div class="sad-row">
                        <span class="sad-label">Dealer ID</span>
                        <span class="sad-value"><span class="sad-colon">:</span> @Val(Row?.DealerCode)</span>
                    </div>
                    <div class="sad-row">
                        <span class="sad-label">Mobile No.</span>
                        <span class="sad-value"><span class="sad-colon">:</span> @Val(Row?.MobileNo)</span>
                    </div>
                </div>

                <div class="sad-section">
                    <h3>Location Information</h3>
                    <div class="sad-row">
                        <span class="sad-label">State</span>
                        <span class="sad-value"><span class="sad-colon">:</span> @Val(Row?.StateName)</span>
                    </div>
                    <div class="sad-row">
                        <span class="sad-label">Head Quarters</span>
                        <span class="sad-value"><span class="sad-colon">:</span> @Val(Row?.HeadQuarterName)</span>
                    </div>
                    <div class="sad-row">
                        <span class="sad-label">District</span>
                        <span class="sad-value"><span class="sad-colon">:</span> @Val(Row?.DistrictName)</span>
                    </div>
                    <div class="sad-row">
                        <span class="sad-label">Sub-District</span>
                        <span class="sad-value"><span class="sad-colon">:</span> @Val(Row?.SubDistrictName)</span>
                    </div>
                </div>

                <div class="sad-section">
                    <h3>Product Information</h3>
                    <div class="sad-row">
                        <span class="sad-label">Product</span>
                        <span class="sad-value"><span class="sad-colon">:</span> @Val(Row?.ProductName)</span>
                    </div>
                    <div class="sad-row">
                        <span class="sad-label">Quantity (MT)</span>
                        <span class="sad-value"><span class="sad-colon">:</span> @Num(Row?.Quantity)</span>
                    </div>
                </div>

                <div class="sad-section">
                    <h3>Inventory Information</h3>
                    <div class="sad-row">
                        <span class="sad-label">Entry Date</span>
                        <span class="sad-value"><span class="sad-colon">:</span> @Date(Row?.EntryDate)</span>
                    </div>
                    <div class="sad-row">
                        <span class="sad-label">Ageing Days</span>
                        <span class="sad-value sad-val-flex">
                            <span class="sad-colon">:</span> @(Row?.AgeingDays ?? 0) Days
                            <div class="sad-status-badge sad-badge-inline">
                                <div class="sad-dot"></div> @Val(Row?.Status)
                            </div>
                        </span>
                    </div>
                </div>

            </div>

            <div class="sad-footer">
                <button class="sad-btn-solid" @onclick="CloseDrawer">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                    Close
                </button>
            </div>

        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public AgeingRowDto? Row { get; set; }

    // Safe formatter helpers
    private static string Val(string? s) => string.IsNullOrWhiteSpace(s) ? "-" : s;
    private static string Date(DateTime? d) => d?.ToString("dd-MM-yyyy") ?? "-";
    private static string Num(decimal? n) => (n ?? 0m).ToString("0.###");

    private async Task CloseDrawer()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(IsOpen);
    }
}