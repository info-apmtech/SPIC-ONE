@using SPIC.MauiBlazorApp.Shared.Pages
@using SPIC.Core.DTOs
@inject IJSRuntime JS

@if (IsOpen)
{
    <div class="sad-overlay" @onclick="CloseDrawer">
        <div class="sad-drawer" @onclick:stopPropagation="true">
            
            <div class="sad-header">
                <div class="sad-header-titles">
                    <h2>Stock Ageing Details</h2>
                    <div class="sad-status-badge">
                        <div class="sad-dot"></div>
                        @Val(Row?.Status)
                    </div>
                </div>
                <button class="sad-close-icon" @onclick="CloseDrawer" aria-label="Close">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="15" y1="9" x2="9" y2="15"></line>
                        <line x1="9" y1="9" x2="15" y2="15"></line>
                    </svg>
                </button>
            </div>

            <div class="sad-body">
                
                <div class="sad-section">
                    <h3>Dealer Information</h3>
                    <div class="sad-row">
                        <span class="sad-label">Dealer Name</span>
                        <span class="sad-value"><span class="sad-colon">:</span> @Val(Row?.DealerName)</span>
                    </div>
                    <div class="sad-row">
                        <span class="sad-label">Dealer ID</span>
                        <span class="sad-value"><span class="sad-colon">:</span> @Val(Row?.DealerCode)</span>
                    </div>
                    <div class="sad-row">
                        <span class="sad-label">Mobile No.</span>
                        <span class="sad-value sad-val-flex">
                            <span class="sad-colon">:</span> @Val(Row?.MobileNo)
                            @if (!string.IsNullOrWhiteSpace(Row?.MobileNo))
                            {
                                <span class="sad-contact-actions">
                                    <button class="sad-contact-btn sad-wa" title="WhatsApp" @onclick="() => OpenWhatsApp(Row!.MobileNo!)">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
                                    </button>
                                    <button class="sad-contact-btn sad-call" title="Call" @onclick="() => Call(Row!.MobileNo!)">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                                    </button>
                                    <button class="sad-contact-btn sad-sms" title="SMS" @onclick="() => SendSms(Row!.MobileNo!)">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                                    </button>
                                </span>
                            }
                        </span>
                    </div>
                </div>

                <div class="sad-section">
                    <h3>Location Information</h3>
                    <div class="sad-row">
                        <span class="sad-label">State</span>
                        <span class="sad-value"><span class="sad-colon">:</span> @Val(Row?.StateName)</span>
                    </div>
                    <div class="sad-row">
                        <span class="sad-label">Head Quarters</span>
                        <span class="sad-value"><span class="sad-colon">:</span> @Val(Row?.HeadQuarterName)</span>
                    </div>
                    <div class="sad-row">
                        <span class="sad-label">District</span>
                        <span class="sad-value"><span class="sad-colon">:</span> @Val(Row?.DistrictName)</span>
                    </div>
                    <div class="sad-row">
                        <span class="sad-label">Sub-District</span>
                        <span class="sad-value"><span class="sad-colon">:</span> @Val(Row?.SubDistrictName)</span>
                    </div>
                </div>

                <div class="sad-section">
                    <h3>Product Information</h3>
                    <div class="sad-row">
                        <span class="sad-label">Product</span>
                        <span class="sad-value"><span class="sad-colon">:</span> @Val(Row?.ProductName)</span>
                    </div>
                    <div class="sad-row">
                        <span class="sad-label">Quantity (MT)</span>
                        <span class="sad-value"><span class="sad-colon">:</span> @Num(Row?.Quantity)</span>
                    </div>
                </div>

                <div class="sad-section">
                    <h3>Inventory Information</h3>
                    <div class="sad-row">
                        <span class="sad-label">Entry Date</span>
                        <span class="sad-value"><span class="sad-colon">:</span> @Date(Row?.EntryDate)</span>
                    </div>
                    <div class="sad-row">
                        <span class="sad-label">Ageing Days</span>
                        <span class="sad-value sad-val-flex">
                            <span class="sad-colon">:</span> @(Row?.AgeingDays ?? 0) Days
                            <div class="sad-status-badge sad-badge-inline">
                                <div class="sad-dot"></div> @Val(Row?.Status)
                            </div>
                        </span>
                    </div>
                </div>

            </div>

            <div class="sad-footer">
                <button class="sad-btn-solid" @onclick="CloseDrawer">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                    Close
                </button>
            </div>

        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public AgeingRowDto? Row { get; set; }

    // Safe formatter helpers
    private static string Val(string? s) => string.IsNullOrWhiteSpace(s) ? "-" : s;
    private static string Date(DateTime? d) => d?.ToString("dd-MM-yyyy") ?? "-";
    private static string Num(decimal? n) => (n ?? 0m).ToString("0.###");

    private async Task CloseDrawer()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(IsOpen);
    }

    // ---- Contact actions (same convention as the Stock / Pending-Ack drawers) ----

    // Opens a WhatsApp chat. Indian 10-digit numbers get the 91 prefix; numbers
    // that already carry a country code are used as-is.
    private async Task OpenWhatsApp(string number)
    {
        var digits = new string((number ?? "").Where(char.IsDigit).ToArray());
        if (digits.Length == 0) return;

        var wa = digits.Length == 10 ? "91" + digits : digits;
        var msg = Uri.EscapeDataString(
            $"Ageing Report\nDealer: {Row?.DealerName}\nState: {Row?.StateName}\n" +
            $"Product: {Row?.ProductName}\nQuantity: {Row?.Quantity} MT\n" +
            $"Ageing: {Row?.AgeingDays ?? 0} days ({Row?.Status})");

        await JS.InvokeVoidAsync("open", $"https://wa.me/{wa}?text={msg}", "_blank");
    }

    // Opens the device dialer.
    private async Task Call(string number)
    {
        if (string.IsNullOrWhiteSpace(number)) return;
        await JS.InvokeVoidAsync("open", $"tel:{number}", "_self");
    }

    // Opens the device SMS composer.
    private async Task SendSms(string number)
    {
        if (string.IsNullOrWhiteSpace(number)) return;
        await JS.InvokeVoidAsync("open", $"sms:{number}", "_self");
    }
}
