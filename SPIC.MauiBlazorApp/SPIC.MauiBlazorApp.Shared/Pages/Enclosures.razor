    <!-- Pending / Additional Documents -->
    <div class="main-card">
        <h3 class="section-title">Pending / Additional Documents</h3>
        <p class="section-subtitle">Upload remaining required and additional documents</p>

        <div class="row g-3">
            <!-- IT Returns FY1 -->
            <div class="col-md-6">
                <div class="doc-card">
                    <div class="doc-header">
                        <div class="doc-icon" style="@(string.IsNullOrEmpty(_docs.FY1ITReturnFilePath) ? "background:#F3F4F6; color:#9CA3AF;" : "")">
                            <i class="bi bi-file-earmark"></i>
                        </div>
                        <div class="doc-title-row">
                            <div>
                                <div class="doc-title">IT Returns for Last Year</div>
                                <div class="doc-desc d-flex align-items-center gap-2">
                                    Income Tax Returns for FY
                                    <select class="form-select title-select" @bind="_docs.FY1">
                                        <option value="0">Select FY</option>
                                        @foreach (var fy in _financialYears)
                                        {
                                            <option value="@fy.Id">@fy.Name</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="badge-group">
                                <span class="badge-req">Required</span>
                                @if (!string.IsNullOrEmpty(_docs.FY1ITReturnFilePath))
                                {
                                    <span class="badge-up"><i class="bi bi-check2"></i> Uploaded</span>
                                }
                                else
                                {
                                    <span class="badge-miss"><i class="bi bi-search"></i> Missing</span>
                                }
                            </div>
                        </div>
