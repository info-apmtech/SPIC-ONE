									<div class="file-info">
										<i class="bi bi-file-earmark-image"></i>
										<div>
											<div class="file-name">@GetFileName(p.ProprietorImagePath) <i class="bi bi-x-circle-fill text-danger ms-2" style="cursor:pointer;" @onclick="() => RemovePartnerImageFile(p)" @onclick:preventDefault="true" @onclick:stopPropagation="true"></i></div>
