        .company-name {{ font-size: 16px; font-weight: 700; color: #0d6938; letter-spacing: 1.2px; text-transform: uppercase; margin: 0; }}
        .doc-subtitle {{ font-size: 12px; color: #374151; font-weight: 500; margin: 4px 0 0; letter-spacing: 0.3px; }}
        .doc-ref {{ font-size: 9px; color: #6B7280; margin-top: 6px; }}

        /* Info Grid */
