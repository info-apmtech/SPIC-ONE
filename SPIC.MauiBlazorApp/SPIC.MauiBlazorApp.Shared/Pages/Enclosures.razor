                : "<div class='photo-placeholder'><svg width='40' height='40' viewBox='0 0 24 24' fill='#9CA3AF'><path d='M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z'/></svg></div>";

            var encodedName = System.Net.WebUtility.HtmlEncode(p.Name);
            var encodedFather = System.Net.WebUtility.HtmlEncode(p.FatherName);

            // First row with rowspan=3 for S.No, Photo, Name
            rows.Append($@"
            <tr>
                <td rowspan='3' class='cell-center cell-sno'>{i + 1}</td>
                <td rowspan='3' class='cell-center cell-photo'>{imgHtml}</td>
                <td rowspan='3' class='cell-name'><strong>{encodedName}</strong><br/><span class='text-secondary'>S/o or D/o {encodedFather}</span></td>
                <td class='cell-center cell-signo'>1</td>
                <td class='cell-sig'>&nbsp;</td>
            </tr>
            <tr>
                <td class='cell-center cell-signo'>2</td>
                <td class='cell-sig'>&nbsp;</td>
            </tr>
            <tr>
                <td class='cell-center cell-signo'>3</td>
                <td class='cell-sig'>&nbsp;</td>
            </tr>");
        }

        var firmName = System.Net.WebUtility.HtmlEncode(_dealer.FirmName ?? "—");
        var gst = System.Net.WebUtility.HtmlEncode(_dealer.GSTNumber ?? "—");
        var partnerNames = string.Join(", ", _partners.Select(p => System.Net.WebUtility.HtmlEncode(p.Name)));
        var dateStr = DateTime.Now.ToString("dd-MM-yyyy");

        return $@"<!DOCTYPE html>
<html>
<head>
    <title>Specimen Signature — SPIC Dealer Registration</title>
    <style>
        @@page {{ size: A4 portrait; margin: 18mm 16mm 20mm 16mm; }}
        * {{ box-sizing: border-box; }}
