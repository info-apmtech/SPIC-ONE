                                </div>
                            </div>
                            <div class="file-actions">
                                <a href="@GetFileUrl(_docs.SpecimanFilePath)" target="_blank" class="btn-action-text btn-view"><i class="bi bi-eye"></i> View</a>
                                <label class="btn-action-text btn-replace mb-0" style="cursor:pointer;">
                                    <i class="bi bi-arrow-repeat"></i> Replace
                                    <InputFile hidden OnChange="OnSpecimenSelected" accept=".pdf,.jpg,.jpeg,.png" />
                                </label>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="file-missing-box">
                            <div class="missing-info">
                                <i class="bi bi-exclamation-triangle" style="color:#F59E0B;"></i>
                                <div>
                                    <div class="missing-title">Document not uploaded</div>
                                    <div class="missing-meta">Upload via the Specimen Signature section above</div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Bank Guarantee Certificate -->
            <div class="col-md-6">
                <div class="doc-card">
                    <div class="doc-header">
                        <div class="doc-icon"><i class="bi bi-bank"></i></div>
                        <div class="doc-title-row">
                            <div>
                                <div class="doc-title">Bank Guarantee Certificate</div>
                                <div class="doc-desc">Bank guarantee document</div>
                            </div>
                            <div class="badge-group">
                                <span class="badge-req">Required</span>
                                @if (!string.IsNullOrEmpty(_docs.BankGauranteeFilePath))
                                {
                                    <span class="badge-up"><i class="bi bi-check2"></i> Uploaded</span>
