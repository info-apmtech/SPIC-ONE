                            <div class="missing-info">
                                <i class="bi bi-upload"></i>
                                <div>
                                    <div class="missing-title">Click to upload</div>
                                    <div class="missing-meta">PDF only (Max 5 MB)</div>
                                </div>
                            </div>
                            <button class="btn-green-solid">
                                <i class="bi bi-upload me-1"></i>
                                <label class="btn-upload-attach-Enclosure mb-0">
                                    <InputFile hidden OnChange="OnITReturn1Selected" accept=".pdf" /> Upload Document
                                </label>
                            </button>
