@page "/Enclosures"
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@using DealerReg = SPIC.Core.Entities.DealerRegistration
@using SPIC.Core.Entities
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="container-fluid py-4 px-0">
    <FormLoader />

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert @(_isError ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
            @_message
            <button type="button" class="btn-close" @onclick="() => _message = null"></button>
        </div>
    }

    <h2 class="page-title">Enclosures</h2>

    <!-- Progress Section -->
    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="main-card mb-0 h-100">
                <div class="progress-title-row">
                    <div class="progress-title">Document Completion Progress</div>
                    <div class="progress-percent">@_progressPercent%<small>Complete</small></div>
                </div>
                <div class="progress-text">
                    <span class="text-green">@_uploadedCount of @_totalCount</span> documents uploaded •
                    <span class="text-red">@_pendingCount mandatory documents pending</span>
                </div>
                <div class="progress-bar-thin">
                    <div class="progress-fill" style="width: @_progressPercent%;"></div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="alert-card">
                <div class="alert-title"><i class="bi bi-exclamation-circle"></i> You still have</div>
                <div class="alert-large-text">@_pendingCount required document(s)</div>
                <p class="alert-desc">pending. Please complete all mandatory document uploads before proceeding to final submission.</p>
            </div>
        </div>
    </div>

    <!-- Specimen Signature Section -->
    <div class="main-card">
        <h3 class="section-title mb-3">Specimen Signature</h3>
        <div class="row g-4">
            <div class="col-md-6">
                <div class="dl-box">
                    <div class="dl-icon"><i class="bi bi-download"></i></div>
                    <div class="dl-title">Download Specimen Document</div>
                    <div class="dl-text">Download the specimen document, print it, get it signed by all required signatories.</div>
                    <button class="btn-outline-blue" @onclick="DownloadSpecimen" disabled="@(_partners.Count == 0)">
                        <i class="bi bi-file-earmark-arrow-down me-1"></i> Download Template
                    </button>
                    @if (_partners.Count == 0)
                    {
                        <div class="text-muted mt-2" style="font-size:0.85rem;">
                            <i class="bi bi-info-circle"></i> No partners found. Add partners in Proprietor step first.
                        </div>
                    }
                </div>
            </div>
            <div class="col-md-6">
                <div class="up-box">
                    @if (!string.IsNullOrEmpty(_docs.SpecimanFilePath))
                    {
                        <i class="bi bi-check-circle up-icon" style="color:#059669;"></i>
                        <div class="up-title">Specimen Uploaded</div>
                        <div class="up-text">@GetFileName(_docs.SpecimanFilePath)</div>
                        <label class="btn-upload-attach-Enclosure mb-0">
                            <i class="bi bi-arrow-repeat"></i> Replace
                            <InputFile hidden OnChange="OnSpecimenSelected" accept=".pdf,.jpg,.jpeg,.png" />
                        </label>
                    }
                    else
                    {
                        <i class="bi bi-upload up-icon"></i>
                        <div class="up-title">
                            <label class="btn-upload-attach-Enclosure mb-0">
                                Click or drag file to upload
                                <InputFile hidden OnChange="OnSpecimenSelected" accept=".pdf,.jpg,.jpeg,.png" />
                            </label>
                        </div>
                        <div class="up-text">PDF, JPG, PNG (Max 10 MB)</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- GFL Specimen Signature Section -->
    <div class="main-card">
        <h3 class="section-title mb-3">Greenstar Specimen Signature</h3>
        <div class="row g-4">
            <div class="col-md-6">
                <div class="dl-box">
                    <div class="dl-icon"><i class="bi bi-download"></i></div>
                    <div class="dl-title">Download Greenstar Specimen Document</div>
                    <div class="dl-text">Download the Greenstar specimen document, print it, get it signed by all required signatories.</div>
                    <button class="btn-outline-blue" @onclick="DownloadGreenstarSpecimen" disabled="@(_partners.Count == 0)">
                        <i class="bi bi-file-earmark-arrow-down me-1"></i> Download Template
                    </button>
                    @if (_partners.Count == 0)
                    {
                        <div class="text-muted mt-2" style="font-size:0.85rem;">
                            <i class="bi bi-info-circle"></i> No partners found. Add partners in Proprietor step first.
                        </div>
                    }
                </div>
            </div>
            <div class="col-md-6">
                <div class="up-box">
                    @if (!string.IsNullOrEmpty(_docs.GreenstarSpecimanFilePath))
                    {
                        <i class="bi bi-check-circle up-icon" style="color:#059669;"></i>
                        <div class="up-title">Greenstar Specimen Uploaded</div>
                        <div class="up-text">@GetFileName(_docs.GreenstarSpecimanFilePath)</div>
                        <label class="btn-upload-attach-Enclosure mb-0">
                            <i class="bi bi-arrow-repeat"></i> Replace
                            <InputFile hidden OnChange="OnGreenstarSpecimenSelected" accept=".pdf,.jpg,.jpeg,.png" />
                        </label>
                    }
                    else
                    {
                        <i class="bi bi-upload up-icon"></i>
                        <div class="up-title">
                            <label class="btn-upload-attach-Enclosure mb-0">
                                Click or drag file to upload
                                <InputFile hidden OnChange="OnGreenstarSpecimenSelected" accept=".pdf,.jpg,.jpeg,.png" />
                            </label>
                        </div>
                        <div class="up-text">PDF, JPG, PNG (Max 10 MB)</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Documents already added in previous steps -->
    <div class="main-card">
        <h3 class="section-title">Documents already added in previous steps</h3>
        <p class="section-subtitle">These documents were collected during earlier registration steps</p>

        <div class="row g-3">
            <!-- GST Certificate -->
            <div class="col-md-6">
                <div class="doc-card">
                    <div class="doc-header">
                        <div class="doc-icon"><i class="bi bi-file-earmark-text"></i></div>
                        <div class="doc-title-row">
                            <div>
                                <div class="doc-title">GST Certificate</div>
                                <div class="doc-desc">GST Registration Certificate</div>
                            </div>
                            <div class="badge-group">
                                <span class="badge-req">Required</span>
                                @if (!string.IsNullOrEmpty(_dealer.GSTFilePath))
                                {
                                    <span class="badge-up"><i class="bi bi-check2"></i> Uploaded</span>
                                }
                                else
                                {
                                    <span class="badge-miss"><i class="bi bi-search"></i> Missing</span>
                                }
                            </div>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(_dealer.GSTFilePath))
                    {
                        <div class="file-uploaded-box">
                            <div class="file-info">
                                <i class="bi bi-file-earmark-pdf"></i>
                                <div>
                                    <div class="file-name">@GetFileName(_dealer.GSTFilePath)</div>
                                    <div class="file-meta">GST Registration Certificate</div>
                                </div>
                            </div>
                            <div class="file-actions">
                                <a href="@GetFileUrl(_dealer.GSTFilePath)" target="_blank" class="btn-action-text btn-view"><i class="bi bi-eye"></i> View</a>
                                <label class="btn-action-text btn-replace mb-0" style="cursor:pointer;">
                                    <i class="bi bi-arrow-repeat"></i> Replace
                                    <InputFile hidden OnChange="OnGSTSelected" accept=".pdf,.jpg,.jpeg,.png" />
                                </label>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="file-missing-box">
                            <div class="missing-info">
                                <i class="bi bi-upload" style="color:#059669;"></i>
                                <div>
                                    <div class="missing-title" style="color:#059669;">Click to upload</div>
                                    <div class="missing-meta">or drag and drop PDF, JPG, PNG (Max 10 MB)</div>
                                </div>
                            </div>
                            <label class="btn-green-solid mb-0" style="cursor:pointer;">
                                <i class="bi bi-upload me-1"></i> Upload Document
                                <InputFile hidden OnChange="OnGSTSelected" accept=".pdf,.jpg,.jpeg,.png" />
                            </label>
                        </div>
                    }
                </div>
            </div>

            <!-- PAN Copy -->
            <div class="col-md-6">
                <div class="doc-card">
                    <div class="doc-header">
                        <div class="doc-icon"><i class="bi bi-person-vcard"></i></div>
                        <div class="doc-title-row">
                            <div>
                                <div class="doc-title">PAN Copy</div>
                                <div class="doc-desc">Permanent Account Number Card Copy</div>
                            </div>
                            <div class="badge-group">
                                <span class="badge-req">Required</span>
                                @if (!string.IsNullOrEmpty(_dealer.PANFilePath))
                                {
                                    <span class="badge-up"><i class="bi bi-check2"></i> Uploaded</span>
                                }
                                else
                                {
                                    <span class="badge-miss"><i class="bi bi-search"></i> Missing</span>
                                }
                            </div>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(_dealer.PANFilePath))
                    {
                        <div class="file-uploaded-box">
                            <div class="file-info">
                                <i class="bi bi-file-earmark-pdf"></i>
                                <div>
                                    <div class="file-name">@GetFileName(_dealer.PANFilePath)</div>
                                    <div class="file-meta">Permanent Account Number Card Copy</div>
                                </div>
                            </div>
                            <div class="file-actions">
                                <a href="@GetFileUrl(_dealer.PANFilePath)" target="_blank" class="btn-action-text btn-view"><i class="bi bi-eye"></i> View</a>
                                <label class="btn-action-text btn-replace mb-0" style="cursor:pointer;">
                                    <i class="bi bi-arrow-repeat"></i> Replace
                                    <InputFile hidden OnChange="OnPANSelected" accept=".pdf,.jpg,.jpeg,.png" />
                                </label>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="file-missing-box">
                            <div class="missing-info">
                                <i class="bi bi-upload" style="color:#059669;"></i>
                                <div>
                                    <div class="missing-title" style="color:#059669;">Click to upload</div>
                                    <div class="missing-meta">or drag and drop PDF, JPG, PNG (Max 10 MB)</div>
                                </div>
                            </div>
                            <label class="btn-green-solid mb-0" style="cursor:pointer;">
                                <i class="bi bi-upload me-1"></i> Upload Document
                                <InputFile hidden OnChange="OnPANSelected" accept=".pdf,.jpg,.jpeg,.png" />
                            </label>
                        </div>
                    }
                </div>
            </div>

            <!-- Aadhaar Copy -->
            <div class="col-md-6">
                <div class="doc-card">
                    <div class="doc-header">
                        <div class="doc-icon"><i class="bi bi-person-bounding-box"></i></div>
                        <div class="doc-title-row">
                            <div>
                                <div class="doc-title">Aadhaar Copy</div>
                                <div class="doc-desc">Aadhaar Card Copy of Owner</div>
                            </div>
                            <div class="badge-group">
                                <span class="badge-req">Required</span>
                                @if (!string.IsNullOrEmpty(_dealer.AadhaarFilePath))
                                {
                                    <span class="badge-up"><i class="bi bi-check2"></i> Uploaded</span>
                                }
                                else
                                {
                                    <span class="badge-miss"><i class="bi bi-search"></i> Missing</span>
                                }
                            </div>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(_dealer.AadhaarFilePath))
                    {
                        <div class="file-uploaded-box">
                            <div class="file-info">
                                <i class="bi bi-file-earmark-pdf"></i>
                                <div>
                                    <div class="file-name">@GetFileName(_dealer.AadhaarFilePath)</div>
                                    <div class="file-meta">Aadhaar Card Copy of Owner</div>
                                </div>
                            </div>
                            <div class="file-actions">
                                <a href="@GetFileUrl(_dealer.AadhaarFilePath)" target="_blank" class="btn-action-text btn-view"><i class="bi bi-eye"></i> View</a>
                                <label class="btn-action-text btn-replace mb-0" style="cursor:pointer;">
                                    <i class="bi bi-arrow-repeat"></i> Replace
                                    <InputFile hidden OnChange="OnAadhaarSelected" accept=".pdf,.jpg,.jpeg,.png" />
                                </label>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="file-missing-box">
                            <div class="missing-info">
                                <i class="bi bi-upload" style="color:#059669;"></i>
                                <div>
                                    <div class="missing-title" style="color:#059669;">Click to upload</div>
                                    <div class="missing-meta">or drag and drop PDF, JPG, PNG (Max 10 MB)</div>
                                </div>
                            </div>
                            <label class="btn-green-solid mb-0" style="cursor:pointer;">
                                <i class="bi bi-upload me-1"></i> Upload Document
                                <InputFile hidden OnChange="OnAadhaarSelected" accept=".pdf,.jpg,.jpeg,.png" />
                            </label>
                        </div>
                    }
                </div>
            </div>

            <!-- Fertilizers Sales License (Wholesale) -->
            <div class="col-md-6">
                <div class="doc-card">
                    <div class="doc-header">
                        <div class="doc-icon"><i class="bi bi-card-heading"></i></div>
                        <div class="doc-title-row">
                            <div>
                                <div class="doc-title">Fertilizers Sales License</div>
                                <div class="doc-desc">Valid fertilizers sales license</div>
                            </div>
                            <div class="badge-group">
                                <span class="badge-req">Required</span>
                                @if (!string.IsNullOrEmpty(_dealer.WholesaleLicenseFilePath))
                                {
                                    <span class="badge-up"><i class="bi bi-check2"></i> Uploaded</span>
                                }
                                else
                                {
                                    <span class="badge-miss"><i class="bi bi-search"></i> Missing</span>
                                }
                            </div>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(_dealer.WholesaleLicenseFilePath))
                    {
                        <div class="file-uploaded-box">
                            <div class="file-info">
                                <i class="bi bi-file-earmark-pdf"></i>
                                <div>
                                    <div class="file-name">@GetFileName(_dealer.WholesaleLicenseFilePath)</div>
                                    <div class="file-meta">Valid fertilizers sales license</div>
                                </div>
                            </div>
                            <div class="file-actions">
                                <a href="@GetFileUrl(_dealer.WholesaleLicenseFilePath)" target="_blank" class="btn-action-text btn-view"><i class="bi bi-eye"></i> View</a>
                                <label class="btn-action-text btn-replace mb-0" style="cursor:pointer;">
                                    <i class="bi bi-arrow-repeat"></i> Replace
                                    <InputFile hidden OnChange="OnWholesaleLicenseSelected" accept=".pdf,.jpg,.jpeg,.png" />
                                </label>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="file-missing-box">
                            <div class="missing-info">
                                <i class="bi bi-upload" style="color:#059669;"></i>
                                <div>
                                    <div class="missing-title" style="color:#059669;">Click to upload</div>
                                    <div class="missing-meta">or drag and drop PDF, JPG, PNG (Max 10 MB)</div>
                                </div>
                            </div>
                            <label class="btn-green-solid mb-0" style="cursor:pointer;">
                                <i class="bi bi-upload me-1"></i> Upload Document
                                <InputFile hidden OnChange="OnWholesaleLicenseSelected" accept=".pdf,.jpg,.jpeg,.png" />
                            </label>
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>

    <!-- Partner / Proprietor Documents -->
    @if (_partners.Count > 0)
    {
    <div class="main-card">
        <h3 class="section-title">Partner / Proprietor Documents</h3>
        <p class="section-subtitle">Documents uploaded during the Proprietor step for each partner</p>

        @foreach (var partner in _partners)
        {
            var p = partner;
            <h5 class="mt-3 mb-2" style="font-weight:600;color:#1F2937;">@p.Name <small class="text-muted">— S/o D/o @p.FatherName</small></h5>
            <div class="row g-3 mb-3">
                <!-- Partner Photo -->
                <div class="col-md-4">
                    <div class="doc-card">
                        <div class="doc-header">
                            <div class="doc-icon"><i class="bi bi-person-circle"></i></div>
                            <div class="doc-title-row">
                                <div>
                                    <div class="doc-title">Photo</div>
                                    <div class="doc-desc">Proprietor / Partner Photo</div>
                                </div>
                                <div class="badge-group">
                                    <span class="badge-req">Required</span>
                                    @if (!string.IsNullOrEmpty(p.ProprietorImagePath))
                                    {
                                        <span class="badge-up"><i class="bi bi-check2"></i> Uploaded</span>
                                    }
                                    else
                                    {
                                        <span class="badge-miss"><i class="bi bi-search"></i> Missing</span>
                                    }
                                </div>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(p.ProprietorImagePath))
                        {
                            <div class="file-uploaded-box">
                                <div class="file-info">
                                    <i class="bi bi-file-earmark-image"></i>
                                    <div>
                                        <div class="file-name">@GetFileName(p.ProprietorImagePath)</div>
                                        <div class="file-meta">Partner Photo</div>
                                    </div>
                                </div>
                                <div class="file-actions">
                                    <a href="@GetFileUrl(p.ProprietorImagePath)" target="_blank" class="btn-action-text btn-view"><i class="bi bi-eye"></i> View</a>
                                    <label class="btn-action-text btn-replace mb-0" style="cursor:pointer;">
                                        <i class="bi bi-arrow-repeat"></i> Replace
                                        <InputFile hidden OnChange="(e) => OnPartnerImageSelected(p, e)" accept=".jpg,.jpeg,.png,.webp" />
                                    </label>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="file-missing-box">
                                <div class="missing-info">
                                    <i class="bi bi-upload" style="color:#059669;"></i>
                                    <div>
                                        <div class="missing-title" style="color:#059669;">Click to upload</div>
                                        <div class="missing-meta">JPG, PNG, WEBP (Max 10 MB)</div>
                                    </div>
                                </div>
                                <label class="btn-green-solid mb-0" style="cursor:pointer;">
                                    <i class="bi bi-upload me-1"></i> Upload Photo
                                    <InputFile hidden OnChange="(e) => OnPartnerImageSelected(p, e)" accept=".jpg,.jpeg,.png,.webp" />
                                </label>
                            </div>
                        }
                    </div>
                </div>

                <!-- Partner Aadhaar -->
                <div class="col-md-4">
                    <div class="doc-card">
                        <div class="doc-header">
                            <div class="doc-icon"><i class="bi bi-person-bounding-box"></i></div>
                            <div class="doc-title-row">
                                <div>
                                    <div class="doc-title">Aadhaar Copy</div>
                                    <div class="doc-desc">Aadhaar Card of @p.Name</div>
                                </div>
                                <div class="badge-group">
                                    <span class="badge-req">Required</span>
                                    @if (!string.IsNullOrEmpty(p.AadhaarFilePath))
                                    {
                                        <span class="badge-up"><i class="bi bi-check2"></i> Uploaded</span>
                                    }
                                    else
                                    {
                                        <span class="badge-miss"><i class="bi bi-search"></i> Missing</span>
                                    }
                                </div>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(p.AadhaarFilePath))
                        {
                            <div class="file-uploaded-box">
                                <div class="file-info">
                                    <i class="bi bi-file-earmark-pdf"></i>
                                    <div>
                                        <div class="file-name">@GetFileName(p.AadhaarFilePath)</div>
                                        <div class="file-meta">Aadhaar Card Copy</div>
                                    </div>
                                </div>
                                <div class="file-actions">
                                    <a href="@GetFileUrl(p.AadhaarFilePath)" target="_blank" class="btn-action-text btn-view"><i class="bi bi-eye"></i> View</a>
                                    <label class="btn-action-text btn-replace mb-0" style="cursor:pointer;">
                                        <i class="bi bi-arrow-repeat"></i> Replace
                                        <InputFile hidden OnChange="(e) => OnPartnerAadhaarSelected(p, e)" accept=".pdf,.jpg,.jpeg,.png" />
                                    </label>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="file-missing-box">
                                <div class="missing-info">
                                    <i class="bi bi-upload" style="color:#059669;"></i>
                                    <div>
                                        <div class="missing-title" style="color:#059669;">Click to upload</div>
                                        <div class="missing-meta">PDF, JPG, PNG (Max 10 MB)</div>
                                    </div>
                                </div>
                                <label class="btn-green-solid mb-0" style="cursor:pointer;">
                                    <i class="bi bi-upload me-1"></i> Upload Document
                                    <InputFile hidden OnChange="(e) => OnPartnerAadhaarSelected(p, e)" accept=".pdf,.jpg,.jpeg,.png" />
                                </label>
                            </div>
                        }
                    </div>
                </div>

                <!-- Partner PAN -->
                <div class="col-md-4">
                    <div class="doc-card">
                        <div class="doc-header">
                            <div class="doc-icon"><i class="bi bi-person-vcard"></i></div>
                            <div class="doc-title-row">
                                <div>
                                    <div class="doc-title">PAN Copy</div>
                                    <div class="doc-desc">PAN Card of @p.Name</div>
                                </div>
                                <div class="badge-group">
                                    <span class="badge-req">Required</span>
                                    @if (!string.IsNullOrEmpty(p.PANFilePath))
                                    {
                                        <span class="badge-up"><i class="bi bi-check2"></i> Uploaded</span>
                                    }
                                    else
                                    {
                                        <span class="badge-miss"><i class="bi bi-search"></i> Missing</span>
                                    }
                                </div>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(p.PANFilePath))
                        {
                            <div class="file-uploaded-box">
                                <div class="file-info">
                                    <i class="bi bi-file-earmark-pdf"></i>
                                    <div>
                                        <div class="file-name">@GetFileName(p.PANFilePath)</div>
                                        <div class="file-meta">PAN Card Copy</div>
                                    </div>
                                </div>
                                <div class="file-actions">
                                    <a href="@GetFileUrl(p.PANFilePath)" target="_blank" class="btn-action-text btn-view"><i class="bi bi-eye"></i> View</a>
                                    <label class="btn-action-text btn-replace mb-0" style="cursor:pointer;">
                                        <i class="bi bi-arrow-repeat"></i> Replace
                                        <InputFile hidden OnChange="(e) => OnPartnerPANSelected(p, e)" accept=".pdf,.jpg,.jpeg,.png" />
                                    </label>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="file-missing-box">
                                <div class="missing-info">
                                    <i class="bi bi-upload" style="color:#059669;"></i>
                                    <div>
                                        <div class="missing-title" style="color:#059669;">Click to upload</div>
                                        <div class="missing-meta">PDF, JPG, PNG (Max 10 MB)</div>
                                    </div>
                                </div>
                                <label class="btn-green-solid mb-0" style="cursor:pointer;">
                                    <i class="bi bi-upload me-1"></i> Upload Document
                                    <InputFile hidden OnChange="(e) => OnPartnerPANSelected(p, e)" accept=".pdf,.jpg,.jpeg,.png" />
                                </label>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
    }

    <!-- Pending / Additional Documents -->
    <div class="main-card">
        <h3 class="section-title">Pending / Additional Documents</h3>
        <p class="section-subtitle">Upload remaining required and additional documents</p>

        <div class="row g-3">
            <!-- IT Returns FY1 -->
            <div class="col-md-6">
