@code {
	[SupplyParameterFromQuery(Name = "dealerId")]
	public int DealerId { get; set; }
	[SupplyParameterFromQuery(Name = "mode")]
	public string? Mode { get; set; }

	private bool IsViewOnly => string.Equals(Mode, "view", StringComparison.OrdinalIgnoreCase);
	private DealerReg _dealer = new();
	private DealerRegistrationDocuments _docs = new();
	private List<DealerOwnershipInfo> _partners = new();
	private List<FinancialYear> _financialYears = new();
	private List<DealerAssetLand> _landAssets = new();
	private List<DealerAssetBuilding> _buildingAssets = new();
	private bool _existingDocsRecord;

	private string? _message;
	private bool _isError;
	private bool _isSaving;

	// Progress
	private int _totalCount;
	private int _uploadedCount;
	private int _pendingCount;
	private int _progressPercent;

	private bool _isSoleProprietor => _dealer.EntityType == EntityType.soleProprietor;
	private bool _isDeedOfGuaranteeRequired => !_isSoleProprietor;

	private bool _hasWholesaleLicense => !string.IsNullOrEmpty(_dealer.WholeSaleFertilizerLicenseNumber);
	private bool _hasRetailLicense => !string.IsNullOrEmpty(_dealer.RetailFertilizerLicenseNumber);
	private bool _isRetailerListRequired => !_hasRetailLicense;

	// ── Delete confirmation modal state ──
	private bool _showDeleteModal = false;
	private string _deleteDisplayName = "";
	private string _deleteFileNameDisplay = "";
	private string _deleteFilePathToDelete = "";
	private Func<Task>? _deleteAction;

	// Conditional document visibility based on BusinessEntityType
	private bool _showPartnershipDeed
	{
		get
		{
			var t = _dealer.BusinessEntityType?.Trim();
			if (string.IsNullOrEmpty(t)) return false;
			return t.Contains("Partnership", StringComparison.OrdinalIgnoreCase) ||
				   t.Equals("LLP", StringComparison.OrdinalIgnoreCase);
		}
	}

	private bool _showAuthorizationLetter
	{
		get
		{
			var t = _dealer.BusinessEntityType?.Trim();
			if (string.IsNullOrEmpty(t)) return false;
			if (t.Contains("Sole", StringComparison.OrdinalIgnoreCase) ||
				t.Contains("Proprietor", StringComparison.OrdinalIgnoreCase))
				return false;
			return true;
		}
	}

	private bool _showBoardResolution
	{
		get
		{
			var t = _dealer.BusinessEntityType?.Trim();
			if (string.IsNullOrEmpty(t)) return false;
			if (t.Contains("Sole", StringComparison.OrdinalIgnoreCase) ||
				t.Contains("Proprietor", StringComparison.OrdinalIgnoreCase))
				return false;
			if (t.Contains("Partnership", StringComparison.OrdinalIgnoreCase))
				return false;
			if (t.Equals("LLP", StringComparison.OrdinalIgnoreCase))
				return false;
			return true;
		}
	}

	protected override async Task OnInitializedAsync()
	{
		Loading.Show();
		try
		{
		await Task.WhenAll(LoadDealer(), LoadPartners(), LoadFinancialYears(), LoadDocuments(), LoadLandAssets(), LoadBuildingAssets());
		CalculateProgress();
		}
		finally
		{
			Loading.Hide();
		}
	}

	private async Task LoadDealer()
	{
		try
		{
			var dealer = await Http.GetFromJsonAsync<DealerReg>($"api/DealerRegistration/{DealerId}");
			if (dealer != null) _dealer = dealer;
		}
		catch { }
	}

	private async Task LoadPartners()
	{
		try
		{
			_partners = await Http.GetFromJsonAsync<List<DealerOwnershipInfo>>($"api/DealerOwnershipInfo/byDealer/{DealerId}") ?? new();
		}
		catch { }
	}

	private async Task LoadFinancialYears()
	{
		try
		{
			_financialYears = await Http.GetFromJsonAsync<List<FinancialYear>>("api/FinancialYear/all") ?? new();
		}
		catch { }
	}

	private async Task LoadDocuments()
	{
		try
		{
			var list = await Http.GetFromJsonAsync<List<DealerRegistrationDocuments>>($"api/DealerRegistrationDocuments/byDealer/{DealerId}") ?? new();
			var existing = list.FirstOrDefault();
			if (existing != null)
			{
				_docs = existing;
				_existingDocsRecord = true;
			}
			else
			{
				_docs = new DealerRegistrationDocuments { DealerId = DealerId };
			}
		}
		catch { }
	}

	private async Task LoadLandAssets()
	{
		try
		{
			_landAssets = await Http.GetFromJsonAsync<List<DealerAssetLand>>($"api/DealerAssetLand/byDealer/{DealerId}") ?? new();
		}
		catch { }
	}

	private async Task LoadBuildingAssets()
	{
		try
		{
			_buildingAssets = await Http.GetFromJsonAsync<List<DealerAssetBuilding>>($"api/DealerAssetBuilding/byDealer/{DealerId}") ?? new();
		}
		catch { }
	}

	private void CalculateProgress()
	{
		var requiredPaths = new List<string?>
		{
			_dealer.GSTFilePath,
			_dealer.PANFilePath,
			_dealer.AadhaarFilePath,
			_docs.SpecimanFilePath,
			_docs.GreenstarSpecimanFilePath,
			_docs.BankGauranteeFilePath,
			_docs.FY1ITReturnFilePath,
			_docs.FY2ITReturnFilePath,
			// _docs.RetailerListFilePath,
				// _docs.DeedOfGuaranteeFilePath,
				_docs.AffidavitFilePath
			};

		if (_isDeedOfGuaranteeRequired)
			requiredPaths.Add(_docs.DeedOfGuaranteeFilePath);
		if (_hasWholesaleLicense)
			requiredPaths.Add(_dealer.WholesaleLicenseFilePath);

		// Retailer List is mandatory only when dealer has no retail license
		if (!_hasRetailLicense)
			requiredPaths.Add(_docs.RetailerListFilePath);


		if (_hasRetailLicense)
			requiredPaths.Add(_dealer.RetailLicenseFilePath);

		if (_showPartnershipDeed)
			requiredPaths.Add(_docs.PartnershipDeadFilePath);

		if (_showBoardResolution)
			requiredPaths.Add(_docs.BoardReasolutionFilePath);

		if (_showAuthorizationLetter)
			requiredPaths.Add(_docs.AuthorizationLetterFilePath);

		foreach (var p in _partners)
		{
			requiredPaths.Add(p.ProprietorImagePath);
			if (!_isSoleProprietor)
			{
				requiredPaths.Add(p.AadhaarFilePath);
				requiredPaths.Add(p.PANFilePath);
			}
		}

		foreach (var l in _landAssets)
		{
			requiredPaths.Add(l.UploadedECDocumentPath);
			requiredPaths.Add(l.UploadedLandDocumentPath);
			requiredPaths.Add(l.UploadedValuationCertificatePath);
		}

		foreach (var b in _buildingAssets)
		{
			requiredPaths.Add(b.UploadedECDocumentPath);
			requiredPaths.Add(b.UploadedBuildingDocumentPath);
			requiredPaths.Add(b.UploadedValuationCertificatePath);
		}

		_totalCount = requiredPaths.Count;
		_uploadedCount = requiredPaths.Count(p => !string.IsNullOrEmpty(p));
		_pendingCount = _totalCount - _uploadedCount;
		_progressPercent = _totalCount > 0 ? (int)Math.Round((double)_uploadedCount / _totalCount * 100) : 0;
	}

	// --- File Upload Handlers ---
	private void OpenDeleteModal(string displayName, string filePath, Func<Task> onConfirm)
	{
		if (string.IsNullOrEmpty(filePath)) return;
		_deleteDisplayName = displayName;
		_deleteFilePathToDelete = filePath;
		_deleteFileNameDisplay = GetFileName(filePath);
		_deleteAction = onConfirm;
		_showDeleteModal = true;
	}

	private void CancelDelete()
	{
		_showDeleteModal = false;
		_deleteAction = null;
		_deleteDisplayName = "";
		_deleteFileNameDisplay = "";
		_deleteFilePathToDelete = "";
	}

	private async Task ConfirmDelete()
	{
		try
		{
			if (_deleteAction != null)
				await _deleteAction.Invoke();
			ShowMessage($"{_deleteDisplayName} deleted successfully", false);
		}
		catch (Exception ex)
		{
			ShowMessage($"Failed to delete file: {ex.Message}", true);
		}
		finally
		{
			CancelDelete();
		}
	}

	private async Task DeleteFileFromServer(string filePath)
	{
		if (string.IsNullOrEmpty(filePath) || !filePath.Contains("/")) return;
		try
		{
			await Http.DeleteAsync($"api/DealerFile/delete?filePath={Uri.EscapeDataString(filePath)}");
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Failed to delete file from server: {ex.Message}");
		}
	}
