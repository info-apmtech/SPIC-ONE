            </div>

            <!-- IT Returns FY2 -->
            <div class="col-md-6">
                <div class="doc-card">
                    <div class="doc-header">
                        <div class="doc-icon" style="@(string.IsNullOrEmpty(_docs.FY2ITReturnFilePath) ? "background:#F3F4F6; color:#9CA3AF;" : "")">
                            <i class="bi bi-file-earmark"></i>
                        </div>
                        <div class="doc-title-row">
                            <div>
                                <div class="doc-title">IT Returns for Last 2nd Year</div>
