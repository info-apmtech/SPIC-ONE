		.doc-footer {{ display: flex; justify-content: space-between; align-items: flex-end; margin-top: 24px; padding-top: 12px; border-top: 1px solid #e5e7eb; }}
		.footer-col {{ font-size: 10px; }}
		.sig-line {{ border-bottom: 1px solid #374151; width: 180px; display: inline-block; margin-top: 24px; }}
		.sig-label {{ font-size: 9px; color: #6B7280; margin-top: 3px; }}
		.seal-box {{ text-align: center; }}
		.seal-border {{ border: 2px dashed #c4c4c4; width: 130px; height: 70px; display: flex; align-items: center; justify-content: center; color: #9CA3AF; font-size: 9px; margin: 0 auto 4px; border-radius: 4px; }}
		.seal-label {{ font-weight: 600; font-size: 9px; color: #6B7280; }}
		.doc-logo {{ height: 60px; margin-bottom: 8px; }}

		@@media print {{
			body {{ padding: 0; }}
			.doc-header {{ border-bottom-color: #0d6938 !important; }}
			.spec-table th {{ background: #0d6938 !important; color: #fff !important; }}
		}}
	</style>
</head>
<body>
	<div class='doc-header'>
		<img src='{blazorBase}/_content/SPIC.MauiBlazorApp.Shared/images/loginimages/GreenSratIcon.svg' alt='GFL Logo' class='doc-logo' />
		<div class='company-name'>Greenstar Fertilizers Limited</div>
		<div class='doc-subtitle'>Specimen Signature Document — Dealer Registration</div>
		<div class='doc-ref'>Ref: GFL/DR/{DealerId}/{DateTime.Now:yyyyMMdd} &nbsp;|&nbsp; Generated on: {dateStr}</div>
	</div>

	<div class='info-grid'>
		<div class='info-item'><span class='label'>Dealer ID</span><span class='value'>{DealerId}</span></div>
		<div class='info-item'><span class='label'>Firm Name</span><span class='value'>M/s.{firmName}</span></div>
		<div class='info-item'><span class='label'>GST Number</span><span class='value'>{gst}</span></div>
		<div class='info-item'><span class='label'>Date</span><span class='value'>{dateStr}</span></div>
	</div>

	<table class='spec-table'>
		<thead>
			<tr>
				<th>S.No</th>
				<th>Photo</th>
				<th>Partner / Proprietor Name</th>
				<th colspan='2'>Signature</th>
			</tr>
		</thead>
		<tbody>
			{rows}
		</tbody>
	</table>

	<div class='consent-section'>
		<div class='consent-title'>Declaration &amp; Consent</div>
		<div class='consent-text'>
			<p>I/We, the undersigned Partner(s)/Proprietor(s) of <strong>{firmName}</strong>, do hereby solemnly declare and affirm the following:</p>
			<ol>
				<li>The specimen signatures provided above are our genuine and authentic signatures, which shall be used for all official correspondence, agreements, and transactions with Greenstar Fertilizers Limited (GFL).</li>
				<li>All information furnished in this dealer registration application and the supporting documents submitted are true, correct, and complete to the best of our knowledge and belief.</li>
				<li>We authorise GFL to verify the authenticity of all documents, information, and signatures provided herein through any means deemed appropriate.</li>
				<li>We understand that any misrepresentation, falsification, or concealment of material facts may result in immediate cancellation of the dealership, forfeiture of any deposits or guarantees, and may attract legal proceedings.</li>
				<li>We agree to abide by the terms and conditions, policies, and guidelines of GFL as amended from time to time.</li>
				<li>We consent to GFL collecting, processing, and storing our personal data and business information for the purpose of dealer registration and ongoing business operations in accordance with applicable data protection laws.</li>
			</ol>
		</div>
	</div>

	<div class='doc-footer'>
		<div class='footer-col'>
			<div><strong>Place:</strong> <span class='sig-line'></span></div>
			<div style='margin-top:12px;'><strong>Date:</strong>&nbsp; <span class='sig-line'></span></div>
		</div>
		<div class='footer-col' style='text-align:center;'>
			<div class='sig-line'></div>
			<div class='sig-label'>Authorised Signatory in For Seal</div>
		</div>
		<div class='seal-box'>
			<div class='seal-border'>Dealer Seal / Stamp</div>
			<div class='seal-label'>Official Seal (Firm Full Address Seal)</div>
		</div>
	</div>
</body>
</html>";
	}

	// --- Save & Navigate ---
	private async Task HandleNext()
	{
		if (IsViewOnly)
		{
			Loading.Show();
			Nav.NavigateTo($"/CreditLimit?dealerId={DealerId}&mode=view");
			return;
		}
		_isSaving = true;
		_message = null;

		try
		{
			await SaveDocuments();
			FormStepData.MarkStepError(11, _pendingCount > 0);
			Nav.NavigateTo($"/FinalSubmission?dealerId={DealerId}");
		}
		catch (Exception ex)
		{
			ShowMessage($"Error saving documents: {ex.Message}", true);
		}
		finally
		{
			_isSaving = false;
		}
	}

	// --- Helpers ---
	private async Task<string?> UploadFileToServer(int dealerId, string docType, IBrowserFile file)
	{
		try
		{
			using var content = new MultipartFormDataContent();
			var stream = file.OpenReadStream(10 * 1024 * 1024);
			content.Add(new StreamContent(stream), "file", file.Name);

			var response = await Http.PostAsync($"api/DealerFile/upload/{dealerId}/{docType}", content);
			if (response.IsSuccessStatusCode)
			{
				var result = await response.Content.ReadFromJsonAsync<FileUploadResponse>();
				return result?.FilePath;
			}
			else
			{
				var error = await response.Content.ReadAsStringAsync();
				ShowMessage($"Upload failed: {error}", true);
			}
		}
		catch (Exception ex)
		{
			ShowMessage($"Upload error: {ex.Message}", true);
		}
		return null;
	}

	private string GetFileName(string? path)
	{
		if (string.IsNullOrEmpty(path)) return "";
		var idx = path.LastIndexOf('/');
		return idx >= 0 ? path[(idx + 1)..] : path;
	}

	// NEW: Ensure file urls are correctly formatted for downloading/viewing and handle encoding
	private string GetFileUrl(string? path)
	{
		if (string.IsNullOrEmpty(path)) return "";
		var baseUrl = Http.BaseAddress?.ToString().TrimEnd('/') ?? "";
		return $"{baseUrl}/api/DealerFile/view/{Uri.EscapeDataString(path).Replace("%2F", "/")}";
	}

	private void ShowMessage(string msg, bool isError)
	{
		_message = msg;
		_isError = isError;
	}

	private class CreateResponse<T>
	{
		public string? Message { get; set; }
		public T? Data { get; set; }
	}

	private class FileUploadResponse
	{
		public string? FilePath { get; set; }
	}
}
