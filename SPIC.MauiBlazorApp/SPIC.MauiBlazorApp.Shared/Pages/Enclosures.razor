    private async Task SavePartner(DealerOwnershipInfo partner)
    {
        try
        {
            var resp = await Http.PutAsJsonAsync($"api/DealerOwnershipInfo/{partner.Id}", partner);
            resp.EnsureSuccessStatusCode();
        }
        catch (Exception ex)
        {
            ShowMessage($"Error updating partner: {ex.Message}", true);
        }
    }

    private async Task SaveDealer()
    {
        try
        {
            var resp = await Http.PutAsJsonAsync($"api/DealerRegistration/{_dealer.Id}", _dealer);
            resp.EnsureSuccessStatusCode();
        }
        catch (Exception ex)
        {
            ShowMessage($"Error updating dealer: {ex.Message}", true);
        }
    }

    private async Task SaveDocuments()
    {
        try
        {
            _docs.DealerId = DealerId;
            if (_existingDocsRecord && _docs.Id > 0)
            {
                var resp = await Http.PutAsJsonAsync($"api/DealerRegistrationDocuments/{_docs.Id}", _docs);
                resp.EnsureSuccessStatusCode();
            }
            else
            {
                var resp = await Http.PostAsJsonAsync("api/DealerRegistrationDocuments", _docs);
                resp.EnsureSuccessStatusCode();
                var created = await resp.Content.ReadFromJsonAsync<CreateResponse<DealerRegistrationDocuments>>();
                if (created?.Data != null)
                {
                    _docs.Id = created.Data.Id;
                    _existingDocsRecord = true;
                }
            }
        }
        catch (Exception ex)
        {
            ShowMessage($"Error saving documents: {ex.Message}", true);
        }
    }

