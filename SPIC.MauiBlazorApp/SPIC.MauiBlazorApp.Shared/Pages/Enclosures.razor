            <!-- Valuation Certificate -->
            <div class="col-md-6">
                <div class="doc-card">
                    <div class="doc-header">
                        <div class="doc-icon"><i class="bi bi-file-earmark-check"></i></div>
                        <div class="doc-title-row">
                            <div>
                                <div class="doc-title">Valuation Certificate</div>
                                <div class="doc-desc">Property valuation certificate</div>
                            </div>
                            <div class="badge-group">
                                <span class="badge-req">Required</span>
