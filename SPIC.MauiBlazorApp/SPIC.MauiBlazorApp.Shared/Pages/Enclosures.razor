@code {
    [SupplyParameterFromQuery(Name = "dealerId")]
    public int DealerId { get; set; }

    private DealerReg _dealer = new();
    private DealerRegistrationDocuments _docs = new();
    private List<DealerOwnershipInfo> _partners = new();
    private List<FinancialYear> _financialYears = new();
    private bool _existingDocsRecord;

    private string? _message;
    private bool _isError;
    private bool _isSaving;

    // Progress
    private int _totalCount;
    private int _uploadedCount;
    private int _pendingCount;
    private int _progressPercent;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadDealer(), LoadPartners(), LoadFinancialYears(), LoadDocuments());
        CalculateProgress();
    }

    private async Task LoadDealer()
    {
        try
        {
            var dealer = await Http.GetFromJsonAsync<DealerReg>($"api/DealerRegistration/{DealerId}");
            if (dealer != null) _dealer = dealer;
        }
        catch { }
    }

    private async Task LoadPartners()
    {
        try
        {
            var all = await Http.GetFromJsonAsync<List<DealerOwnershipInfo>>("api/DealerOwnershipInfo/all") ?? new();
            _partners = all.Where(p => p.DealerId == DealerId).ToList();
        }
        catch { }
    }

    private async Task LoadFinancialYears()
    {
        try
        {
            _financialYears = await Http.GetFromJsonAsync<List<FinancialYear>>("api/FinancialYear/all") ?? new();
        }
        catch { }
    }

    private async Task LoadDocuments()
    {
        try
        {
            var all = await Http.GetFromJsonAsync<List<DealerRegistrationDocuments>>("api/DealerRegistrationDocuments/all") ?? new();
            var existing = all.FirstOrDefault(d => d.DealerId == DealerId);
            if (existing != null)
            {
                _docs = existing;
                _existingDocsRecord = true;
            }
            else
            {
                _docs = new DealerRegistrationDocuments { DealerId = DealerId };
            }
        }
        catch { }
    }

    private void CalculateProgress()
    {
        var requiredPaths = new List<string?>
        {
            _dealer.GSTFilePath,
            _dealer.PANFilePath,
            _dealer.AadhaarFilePath,
            _dealer.WholesaleLicenseFilePath,
            _docs.SpecimanFilePath,
            _docs.BankGauranteeFilePath,
            _docs.FY1ITReturnFilePath,
            _docs.FY2ITReturnFilePath,
            _docs.ValuationCertificateFilePath,
            _docs.RetailerListFilePath
        };

        _totalCount = requiredPaths.Count;
        _uploadedCount = requiredPaths.Count(p => !string.IsNullOrEmpty(p));
        _pendingCount = _totalCount - _uploadedCount;
        _progressPercent = _totalCount > 0 ? (int)Math.Round((double)_uploadedCount / _totalCount * 100) : 0;
    }

    // --- File Upload Handlers ---
    private async Task OnSpecimenSelected(InputFileChangeEventArgs e)
    {
        var path = await UploadFileToServer(DealerId, "Specimen", e.File);
        if (path != null) { _docs.SpecimanFilePath = path; CalculateProgress(); }
    }

    private async Task OnBankGuaranteeSelected(InputFileChangeEventArgs e)
    {
        var path = await UploadFileToServer(DealerId, "BankGuarantee", e.File);
        if (path != null) { _docs.BankGauranteeFilePath = path; CalculateProgress(); }
    }

    private async Task OnITReturn1Selected(InputFileChangeEventArgs e)
    {
        var path = await UploadFileToServer(DealerId, "ITReturn1", e.File);
        if (path != null) { _docs.FY1ITReturnFilePath = path; CalculateProgress(); }
    }

    private async Task OnITReturn2Selected(InputFileChangeEventArgs e)
    {
        var path = await UploadFileToServer(DealerId, "ITReturn2", e.File);
        if (path != null) { _docs.FY2ITReturnFilePath = path; CalculateProgress(); }
    }

    private async Task OnValuationCertSelected(InputFileChangeEventArgs e)
    {
        var path = await UploadFileToServer(DealerId, "ValuationCertificate", e.File);
        if (path != null) { _docs.ValuationCertificateFilePath = path; CalculateProgress(); }
    }

    private async Task OnRetailerListSelected(InputFileChangeEventArgs e)
    {
        var path = await UploadFileToServer(DealerId, "RetailerList", e.File);
        if (path != null) { _docs.RetailerListFilePath = path; CalculateProgress(); }
    }

    private async Task OnPartnershipDeedSelected(InputFileChangeEventArgs e)
    {
        var path = await UploadFileToServer(DealerId, "PartnershipDeed", e.File);
        if (path != null) { _docs.PartnershipDeadFilePath = path; }
    }

    private async Task OnBoardResolutionSelected(InputFileChangeEventArgs e)
    {
        var path = await UploadFileToServer(DealerId, "BoardResolution", e.File);
        if (path != null) { _docs.BoardReasolutionFilePath = path; }
    }

    private async Task OnAffidavitSelected(InputFileChangeEventArgs e)
    {
        var path = await UploadFileToServer(DealerId, "Affidavit", e.File);
        if (path != null) { _docs.AffidavitFilePath = path; }
    }

    // --- Specimen Download ---
    private async Task DownloadSpecimen()
    {
        if (_partners.Count == 0)
        {
            ShowMessage("No partner details found. Please add partners in the Proprietor step.", true);
            return;
        }

        var html = GenerateSpecimenHtml();
        await JS.InvokeVoidAsync("openPrintableHtml", html);
    }

    private string GenerateSpecimenHtml()
    {
        var apiBase = Http.BaseAddress?.ToString().TrimEnd('/') ?? "";
        var rows = new System.Text.StringBuilder();

        for (int i = 0; i < _partners.Count; i++)
        {
            var p = _partners[i];
            var imgHtml = !string.IsNullOrEmpty(p.ProprietorImagePath)
                ? $"<img src='{apiBase}/Uploads/{p.ProprietorImagePath}' style='width:60px;height:60px;object-fit:cover;border-radius:6px;' />"
                : "<div style='width:60px;height:60px;background:#E5E7EB;border-radius:6px;display:flex;align-items:center;justify-content:center;margin:auto;'>Photo</div>";

            rows.Append($@"
            <tr>
                <td style='padding:12px;text-align:center;'>{i + 1}</td>
                <td style='padding:12px;text-align:center;'>{imgHtml}</td>
                <td style='padding:12px;font-weight:600;'>{System.Net.WebUtility.HtmlEncode(p.Name)}<br/><small style='color:#6B7280;font-weight:normal;'>S/o D/o {System.Net.WebUtility.HtmlEncode(p.FatherName)}</small></td>
                <td style='padding:12px;min-width:140px;height:80px;'>&nbsp;</td>
                <td style='padding:12px;min-width:140px;height:80px;'>&nbsp;</td>
                <td style='padding:12px;min-width:140px;height:80px;'>&nbsp;</td>
            </tr>");
        }

        return $@"<!DOCTYPE html>
<html>
<head>
    <title>Specimen Signature - SPIC Dealer Registration</title>
    <style>
        body {{ font-family: Arial, sans-serif; padding: 30px; color: #1F2937; }}
        .header {{ text-align: center; margin-bottom: 30px; border-bottom: 2px solid #059669; padding-bottom: 15px; }}
        .header h1 {{ color: #059669; margin: 0; font-size: 22px; }}
        .header h2 {{ color: #374151; margin: 5px 0 0; font-size: 16px; font-weight: normal; }}
        table {{ width: 100%; border-collapse: collapse; margin-bottom: 30px; }}
        th {{ background: #F0FDF4; color: #059669; padding: 12px; text-align: center; font-size: 13px; }}
        td {{ border: 1px solid #D1D5DB; vertical-align: middle; }}
        .consent {{ margin-top: 30px; padding: 20px; border: 1px solid #D1D5DB; border-radius: 8px; font-size: 13px; line-height: 1.6; }}
        .seal-section {{ display: flex; justify-content: space-between; margin-top: 40px; }}
        .seal-box {{ width: 45%; text-align: center; }}
        .seal-box .box {{ border: 1px dashed #9CA3AF; height: 120px; margin-bottom: 10px; display: flex; align-items: center; justify-content: center; color: #9CA3AF; }}
        .seal-box .label {{ font-weight: 600; font-size: 13px; }}
        .date-place {{ display: flex; gap: 40px; margin-top: 30px; }}
        .date-place div {{ flex: 1; }}
        .date-place .line {{ border-bottom: 1px solid #374151; margin-top: 20px; }}
        @@media print {{ body {{ padding: 15px; }} }}
    </style>
</head>
<body>
    <div class='header'>
        <h1>SOUTHERN PETROCHEMICAL INDUSTRIES CORPORATION LIMITED (SPIC)</h1>
        <h2>Specimen Signature Document — Dealer Registration</h2>
    </div>

    <p style='margin-bottom:5px;'><strong>Dealer ID:</strong> {DealerId} &nbsp;&nbsp; <strong>Firm Name:</strong> {System.Net.WebUtility.HtmlEncode(_dealer.FirmName ?? "—")}</p>
    <p style='margin-bottom:20px;'><strong>Date:</strong> {DateTime.Now:dd-MM-yyyy}</p>

    <table>
        <thead>
            <tr>
                <th style='width:50px;'>S.No</th>
                <th style='width:80px;'>Photo</th>
                <th>Partner / Proprietor Name</th>
                <th>Signature 1</th>
                <th>Signature 2</th>
                <th>Signature 3</th>
            </tr>
        </thead>
        <tbody>
            {rows}
        </tbody>
    </table>

    <div class='consent'>
        <strong>Declaration & Consent</strong><br/><br/>
        I/We hereby declare that the above specimen signatures are genuine and belong to the authorized signatories of the dealership.
        I/We authorize SPIC to use these specimen signatures for verification purposes in all future transactions and official communications.
        Any discrepancy in signatures will be solely our responsibility.
    </div>

    <div class='seal-section'>
        <div class='seal-box'>
            <div class='box'>Affix Company Seal Here</div>
            <div class='label'>Company Seal</div>
        </div>
        <div class='seal-box'>
            <div class='box'>Authorized Signature</div>
            <div class='label'>Authorized Signatory</div>
        </div>
    </div>

    <div class='date-place'>
        <div>
            <strong>Place:</strong>
            <div class='line'></div>
        </div>
        <div>
            <strong>Date:</strong>
            <div class='line'></div>
        </div>
    </div>
</body>
</html>";
    }

    // --- Save & Navigate ---
    private async Task HandleNext()
    {
        _isSaving = true;
        _message = null;

        try
        {
            _docs.DealerId = DealerId;

            if (_existingDocsRecord && _docs.Id > 0)
            {
                var resp = await Http.PutAsJsonAsync($"api/DealerRegistrationDocuments/{_docs.Id}", _docs);
                resp.EnsureSuccessStatusCode();
            }
            else
            {
                var resp = await Http.PostAsJsonAsync("api/DealerRegistrationDocuments", _docs);
                var created = await resp.Content.ReadFromJsonAsync<CreateResponse<DealerRegistrationDocuments>>();
                if (created?.Data != null)
                {
                    _docs.Id = created.Data.Id;
                    _existingDocsRecord = true;
                }
            }

            Nav.NavigateTo($"/FinalSubmission?dealerId={DealerId}");
        }
        catch (Exception ex)
        {
            ShowMessage($"Error saving documents: {ex.Message}", true);
        }
        finally
        {
            _isSaving = false;
        }
    }

    // --- Helpers ---
    private async Task<string?> UploadFileToServer(int dealerId, string docType, IBrowserFile file)
    {
        try
        {
            using var content = new MultipartFormDataContent();
            var stream = file.OpenReadStream(5 * 1024 * 1024);
            content.Add(new StreamContent(stream), "file", file.Name);

            var response = await Http.PostAsync($"api/DealerFile/upload/{dealerId}/{docType}", content);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<FileUploadResponse>();
                return result?.FilePath;
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                ShowMessage($"Upload failed: {error}", true);
            }
        }
        catch (Exception ex)
        {
            ShowMessage($"Upload error: {ex.Message}", true);
        }
        return null;
    }

    private string GetFileName(string? path)
    {
        if (string.IsNullOrEmpty(path)) return "";
        var idx = path.LastIndexOf('/');
        return idx >= 0 ? path[(idx + 1)..] : path;
    }

    private string GetFileUrl(string? path)
    {
        if (string.IsNullOrEmpty(path)) return "";
        var baseUrl = Http.BaseAddress?.ToString().TrimEnd('/') ?? "";
        return $"{baseUrl}/Uploads/{path}";
    }

    private void ShowMessage(string msg, bool isError)
    {
        _message = msg;
        _isError = isError;
    }

    private class CreateResponse<T>
    {
        public string? Message { get; set; }
        public T? Data { get; set; }
    }

    private class FileUploadResponse
    {
        public string? FilePath { get; set; }
    }
}
