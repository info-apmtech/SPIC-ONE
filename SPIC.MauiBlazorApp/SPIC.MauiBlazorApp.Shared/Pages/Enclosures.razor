                                <i class="bi bi-upload me-1"></i>
                                <label class="btn-upload-attach-Enclosure mb-0">
                                    <InputFile hidden OnChange="OnBankGuaranteeSelected" accept=".pdf" /> Upload Document
                                </label>
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
