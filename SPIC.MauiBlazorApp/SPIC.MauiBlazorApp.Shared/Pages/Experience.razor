@page "/Experience" 
@using System.Net.Http.Json
@inject HttpClient Http

<div class="container-fluid py-4 px-0">
	<FormLoader />
	<div class="company-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
		<div class="card-header-title mb-0">
			<h3 class="fw-bold m-0 company-title">Experience In Fertilizer Trade</h3>
		</div>

		<div class="col-md-4">
			<label class="form-label-custom-outer mb-2">Year of Experience in Fertilizer Business</label>
			<input type="text" class="form-control-custom-Outer w-100" placeholder="Enter Your Experience">
		</div>
	</div>

	<div class="form-card">
		<div class="card-header-title">
			<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/AddUserIcon.svg" alt="AddExperience" class="formicon" />Add Experience
		</div>
                
		<div class="row g-3">
			<div class="col-md-6">
				<label class="form-label-custom">Company Name</label>
				<select class="form-select-custom w-100" @bind="_companyForm.CompanyId">
					<option value="">Select Company</option>
					@foreach (var company in _companyAll)
					{
						<option value="@company.Id">@company.CompanyName</option>
					}
				</select>
			</div>
			<div class="col-md-6">
				<label class="form-label-custom">Number of the years</label>

				<div class="input-icon-wrapper">
					<input type="number" class="form-control-custom w-100 input-with-icon" placeholder="0">

					<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/Calender.svg"
						 class="input-icon"
						 alt="icon" />
				</div>
			</div>
			<div class="col-md-4">
				<label class="form-label-custom">Quantity (MT)</label>
				<input type="text" class="form-control-custom w-100" placeholder="Please Enter Quantity">
			</div>
			<div class="col-md-4">
				<label class="form-label-custom">Turnover (Lakhs)</label>

				<div class="input-icon-left-wrapper">
					<span class="input-icon-left">₹</span>

					<input type="number"
						   class="form-control-custom w-100 input-with-left-icon"
						   placeholder="0.00"
						   step="0.01">
				</div>
			</div>
			<div class="col-12 col-md-4">
				<label class="form-label-custom opacity-0 d-none d-md-block">placeholder</label>
				<div class="active-box">
					<div>
						<div class="active-box-title">Still Active</div>
						<div class="active-box-sub">Is this an ongoing engagement?</div>
					</div>
					<div class="form-check form-switch m-0">
						<input class="form-check-input" type="checkbox" role="switch" checked>
					</div>
				</div>
			</div>
		</div>
		<div class="d-flex justify-content-end mt-3">
			<button class="btn btn-add" id="addExperienceBtn">
				<i class="bi bi-plus-lg"></i>
				Add Experience
			</button>
		</div>
	</div>
	<div class="form-card">
		<div class="card-header-title">
			<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/AddUserIcon.svg" alt="AddExperience" class="formicon" />Saved Experience
		</div>
                
		<div class="row g-3">
			<div class="saved-grid" id="savedGrid">

				<div class="saved-card">
					<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/Backgroundbuilding.svg" class="saved-card-bg" alt="bg" />
					<div class="saved-top">
						<div class="saved-company">
							<div class="saved-icon">
								<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/Building.svg" alt="Building" class="formicon" />
							</div>
							<div>
								<div class="saved-name">Green Grow Fertilizers Ltd</div>
								<div class="year-pill"><i class="bi bi-clock"></i> 8 Years</div>
							</div>
						</div>

						<div class="saved-actions">
							<span class="badge-active">Active</span>
							<a class="action-link" href="#"><i class="bi bi-pencil-square"></i></a>
							<a class="action-link delete" href="#"><i class="bi bi-trash"></i></a>
						</div>
					</div>

					<div class="Exp-saved-stats">
						<div class="stat-box">
							<div class="stat-label">Total Quantity</div>
							<div class="stat-value">1,450 <small>MT</small></div>
						</div>
						<div class="stat-box">
							<div class="stat-label">Annual Turnover</div>
							<div class="stat-value">₹ 84.5 <small>Lakhs</small></div>
						</div>
					</div>
				</div>

				<div class="saved-card">
					<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/Backgroundbuilding.svg" class="saved-card-bg" alt="bg" />
					<div class="saved-top">
						<div class="saved-company">
							<div class="saved-icon">
								<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/Building.svg" alt="Building" class="formicon" />
							</div>
							<div>
								<div class="saved-name">Green Grow Fertilizers Ltd</div>
								<div class="year-pill"><i class="bi bi-clock"></i> 8 Years</div>
							</div>
						</div>

						<div class="saved-actions">
							<span class="badge-active">Active</span>
							<a class="action-link" href="#"><i class="bi bi-pencil-square"></i></a>
							<a class="action-link delete" href="#"><i class="bi bi-trash"></i></a>
						</div>
					</div>

					<div class="Exp-saved-stats">
						<div class="stat-box">
							<div class="stat-label">Total Quantity</div>
							<div class="stat-value">1,450 <small>MT</small></div>
						</div>
						<div class="stat-box">
							<div class="stat-label">Annual Turnover</div>
							<div class="stat-value">₹ 84.5 <small>Lakhs</small></div>
						</div>
					</div>
				</div>

				<div class="saved-card">
					<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/Backgroundbuilding.svg" class="saved-card-bg" alt="bg" />
					<div class="saved-top">
						<div class="saved-company">
							<div class="saved-icon">
								<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/Building.svg" alt="Building" class="formicon" />
							</div>
							<div>
								<div class="saved-name">Green Grow Fertilizers Ltd</div>
								<div class="year-pill"><i class="bi bi-clock"></i> 8 Years</div>
							</div>
						</div>

						<div class="saved-actions">
							<span class="badge-active">Active</span>
							<a class="action-link" href="#"><i class="bi bi-pencil-square"></i></a>
							<a class="action-link delete" href="#"><i class="bi bi-trash"></i></a>
						</div>
					</div>

					<div class="Exp-saved-stats">
						<div class="stat-box">
							<div class="stat-label">Total Quantity</div>
							<div class="stat-value">1,450 <small>MT</small></div>
						</div>
						<div class="stat-box">
							<div class="stat-label">Annual Turnover</div>
							<div class="stat-value">₹ 84.5 <small>Lakhs</small></div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
	<CommanFooter />
</div>

@code{
	// State DropDown
	private List<ExpenceItemDto> _companyAll = new();
	private string CurrentApiBase => "api/Company";

	private CompanyFormModel _companyForm = new();
	private string? _message;
	private bool _isError;

	protected override async Task OnInitializedAsync()
	{
		await LoadCompany();
	}

	private async Task LoadCompany()
	{
		try
		{
			_companyAll = await Http.GetFromJsonAsync<List<ExpenceItemDto>>($"{CurrentApiBase}/all") ?? new();
		}
		catch (Exception ex)
		{
			ShowMessage($"Failed to load : {ex.Message}", true);
		}
	}

	private void ShowMessage(string message, bool isError)
	{
		_message = message;
		_isError = isError;
	}
	public class ExpenceItemDto
	{
		public int Id { get; set; }
		public string CompanyName { get; set; } = "";
	}
	public class CompanyFormModel
	{
		public int CompanyId { get; set; }
	}
}