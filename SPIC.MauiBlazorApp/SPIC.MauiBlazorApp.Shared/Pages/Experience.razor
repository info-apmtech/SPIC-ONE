@page "/Experience"
@using System.Net.Http.Json
@using System.Text.Json.Nodes
@using Microsoft.AspNetCore.Components
@using SPIC.Core.Entities
@inject HttpClient Http
@inject NavigationManager Nav

<div class="container-fluid py-4 px-0">
	<FormLoader />

	@if (!string.IsNullOrEmpty(_message))
	{
		<div class="alert @(_isError ? "alert-danger" : "alert-success") alert-dismissible fade show mb-3" role="alert">
			@_message
			<button type="button" class="btn-close" @onclick='() => _message = null'></button>
		</div>
	}

	<div class="company-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
		<div class="card-header-title mb-0">
			<h3 class="fw-bold m-0 company-title">Experience In Fertilizer Trade</h3>
		</div>

		<div class="col-md-4">
			<label class="form-label-custom-outer mb-2">Year of Experience in Fertilizer Business</label>
			<input type="number" class="form-control-custom-Outer w-100" placeholder="Enter Your Experience"
				   @bind="_yearsOfExperience">
		</div>
	</div>

	<div class="form-card">
		<div class="card-header-title">
			<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/AddUserIcon.svg" alt="AddExperience" class="formicon" />
			@(_isEditMode ? "Edit Experience" : "Add Experience")
		</div>

		<div class="row g-3">
			<div class="col-md-6">
				<label class="form-label-custom">Company Name</label>
				<select class="form-select-custom w-100" @bind="_form.CompanyId">
					<option value="">Select Company</option>
					@foreach (var company in _companyAll)
					{
						<option value="@company.Id">@company.Name</option>
					}
				</select>
			</div>
			<div class="col-md-6">
				<label class="form-label-custom">Number of the years</label>

				<div class="input-icon-wrapper">
					<input type="number" class="form-control-custom w-100 input-with-icon" placeholder="0"
						   @bind="_form.NoOfYears">

					<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/Calender.svg"
						 class="input-icon"
						 alt="icon" />
				</div>
			</div>
			<div class="col-md-4">
				<label class="form-label-custom">Quantity (MT)</label>
				<input type="number" class="form-control-custom w-100" placeholder="Please Enter Quantity"
					   @bind="_form.Quantity" step="0.01">
			</div>
			<div class="col-md-4">
				<label class="form-label-custom">Turnover (Lakhs)</label>

				<div class="input-icon-left-wrapper">
					<span class="input-icon-left">₹</span>

					<input type="number"
						   class="form-control-custom w-100 input-with-left-icon"
						   placeholder="0.00"
						   step="0.01"
						   @bind="_form.TurnOver">
				</div>
			</div>
			<div class="col-12 col-md-4">
				<label class="form-label-custom opacity-0 d-none d-md-block">placeholder</label>
				<div class="active-box">
					<div>
						<div class="active-box-title">Still Active</div>
						<div class="active-box-sub">Is this an ongoing engagement?</div>
					</div>
					<div class="form-check form-switch m-0">
						<input class="form-check-input" type="checkbox" role="switch"
							   @bind="_form.IsActive">
					</div>
				</div>
			</div>
		</div>
		<div class="d-flex justify-content-end mt-3 gap-2">
			@if (_isEditMode)
			{
				<button class="btn btn-prev" @onclick="CancelEdit">
					<i class="bi bi-x-lg"></i>
					Cancel
				</button>
			}
			<button class="btn btn-add" @onclick="SaveExperience" disabled="@_isSaving">
				@if (_isSaving)
				{
					<span class="spinner-border spinner-border-sm me-1"></span>
				}
				<i class="bi bi-plus-lg"></i>
				@(_isEditMode ? "Update Experience" : "Add Experience")
			</button>
		</div>
	</div>

	@if (_experiences.Count > 0)
	{
		<div class="form-card">
			<div class="card-header-title">
				<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/AddUserIcon.svg" alt="AddExperience" class="formicon" />Saved Experience
			</div>

			<div class="row g-3">
				<div class="saved-grid" id="savedGrid">
					@foreach (var exp in _experiences)
					{
						var companyName = _companyAll.FirstOrDefault(c => c.Id.ToString() == exp.CompanyId)?.Name ?? "Unknown";
						<div class="saved-card">
							<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/Backgroundbuilding.svg" class="saved-card-bg" alt="bg" />
							<div class="saved-top">
								<div class="saved-company">
									<div class="saved-icon">
										<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/Building.svg" alt="Building" class="formicon" />
									</div>
									<div>
										<div class="saved-name">@companyName</div>
										<div class="year-pill"><i class="bi bi-clock"></i> @exp.NoOfYears Years</div>
									</div>
								</div>

								<div class="saved-actions">
									@if (exp.IsActive)
									{
										<span class="badge-active">Active</span>
									}
									else
									{
										<span class="badge-active" style="background:#dc3545;">Inactive</span>
									}
									<a class="action-link" href="#" @onclick="() => EditExperience(exp)" @onclick:preventDefault><i class="bi bi-pencil-square"></i></a>
									<a class="action-link delete" href="#" @onclick="() => ConfirmDelete(exp)" @onclick:preventDefault><i class="bi bi-trash"></i></a>
								</div>
							</div>

							<div class="Exp-saved-stats">
								<div class="stat-box">
									<div class="stat-label">Total Quantity</div>
									<div class="stat-value">@exp.Quantity.ToString("N0") <small>MT</small></div>
								</div>
								<div class="stat-box">
									<div class="stat-label">Annual Turnover</div>
									<div class="stat-value">₹ @exp.TurnOver.ToString("N1") <small>Lakhs</small></div>
								</div>
							</div>
						</div>
					}
				</div>
			</div>
		</div>
	}

	@if (_showDeleteConfirm)
	{
		<div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.5)">
			<div class="modal-dialog modal-dialog-centered">
				<div class="modal-content">
					<div class="modal-header">
						<h5 class="modal-title">Confirm Delete</h5>
						<button type="button" class="btn-close" @onclick="() => _showDeleteConfirm = false"></button>
					</div>
					<div class="modal-body">
						<p>Are you sure you want to delete this experience record?</p>
					</div>
					<div class="modal-footer">
						<button class="btn btn-secondary" @onclick="() => _showDeleteConfirm = false">Cancel</button>
						<button class="btn btn-danger" @onclick="DeleteExperience" disabled="@_isDeleting">
							@if (_isDeleting)
							{
								<span class="spinner-border spinner-border-sm me-1"></span>
							}
							Delete
						</button>
					</div>
				</div>
			</div>
		</div>
	}

	<CommanFooter OnNextClick="HandleNext" IsNextDisabled="@_isSaving" />
</div>

@code {
	[SupplyParameterFromQuery(Name = "dealerId")]
	public int? DealerId { get; set; }

	private List<DealerExperience> _experiences = new();
	private List<Competitor> _companyAll = new();
	private DealerExperience _form = new() { IsActive = true };
	private int _yearsOfExperience;

	private bool _isEditMode;
	private bool _isSaving;
	private bool _isDeleting;
	private bool _showDeleteConfirm;
	private DealerExperience? _deleteTarget;
	private string? _message;
	private bool _isError;

	protected override async Task OnInitializedAsync()
	{
		await LoadCompanies();
		if (DealerId.HasValue && DealerId.Value > 0)
		{
			await LoadExperiences();
			await LoadDealerYearsOfExperience();
		}
	}

	private async Task LoadCompanies()
	{
		try
		{
			_companyAll = await Http.GetFromJsonAsync<List<Competitor>>("api/Competitor/all") ?? new();
		}
		catch (Exception ex)
		{
			ShowMessage($"Failed to load companies: {ex.Message}", true);
		}
	}

	private async Task LoadExperiences()
	{
		try
		{
			var all = await Http.GetFromJsonAsync<List<DealerExperience>>("api/DealerExperience/all") ?? new();
			_experiences = all.Where(e => e.DealerId == DealerId!.Value).ToList();
		}
		catch (Exception ex)
		{
			ShowMessage($"Failed to load experiences: {ex.Message}", true);
		}
	}

	private async Task LoadDealerYearsOfExperience()
	{
		try
		{
			var dealer = await Http.GetFromJsonAsync<JsonObject>($"api/DealerRegistration/{DealerId!.Value}");
			if (dealer != null && dealer["yearsofExperiance"] != null)
				_yearsOfExperience = dealer["yearsofExperiance"]!.GetValue<int>();
		}
		catch { }
	}

	private async Task SaveYearsOfExperience()
	{
		if (!DealerId.HasValue || DealerId.Value <= 0) return;
		try
		{
			var dealer = await Http.GetFromJsonAsync<JsonObject>($"api/DealerRegistration/{DealerId.Value}");
			if (dealer != null)
			{
				dealer["yearsofExperiance"] = _yearsOfExperience;
				await Http.PutAsJsonAsync($"api/DealerRegistration/{DealerId.Value}", dealer);
			}
		}
		catch (Exception ex)
		{
			ShowMessage($"Failed to update years of experience: {ex.Message}", true);
		}
	}

	private async Task SaveExperience()
	{
		if (!DealerId.HasValue || DealerId.Value <= 0)
		{
			ShowMessage("Dealer ID is required. Please save dealer registration first.", true);
			return;
		}

		if (string.IsNullOrEmpty(_form.CompanyId))
		{
			ShowMessage("Please select a company.", true);
			return;
		}

		_isSaving = true;
		try
		{
			_form.DealerId = DealerId.Value;

			HttpResponseMessage response;
			if (_isEditMode && _form.Id > 0)
			{
				response = await Http.PutAsJsonAsync($"api/DealerExperience/{_form.Id}", _form);
			}
			else
			{
				response = await Http.PostAsJsonAsync("api/DealerExperience", _form);
			}

			if (response.IsSuccessStatusCode)
			{
				ShowMessage(_isEditMode ? "Experience updated successfully!" : "Experience added successfully!", false);
				_form = new DealerExperience { IsActive = true };
				_isEditMode = false;
				await LoadExperiences();
			}
			else
			{
				var error = await response.Content.ReadAsStringAsync();
				ShowMessage($"Failed to save: {error}", true);
			}
		}
		catch (Exception ex)
		{
			ShowMessage($"Error: {ex.Message}", true);
		}
		finally
		{
			_isSaving = false;
		}
	}

	private void EditExperience(DealerExperience exp)
	{
		_form = new DealerExperience
		{
			Id = exp.Id,
			DealerId = exp.DealerId,
			CompanyId = exp.CompanyId,
			NoOfYears = exp.NoOfYears,
			Quantity = exp.Quantity,
			TurnOver = exp.TurnOver,
			IsActive = exp.IsActive
		};
		_isEditMode = true;
		_message = null;
	}

	private void CancelEdit()
	{
		_form = new DealerExperience { IsActive = true };
		_isEditMode = false;
		_message = null;
	}

	private void ConfirmDelete(DealerExperience exp)
	{
		_deleteTarget = exp;
		_showDeleteConfirm = true;
	}

	private async Task DeleteExperience()
	{
		if (_deleteTarget == null) return;
		_isDeleting = true;
		try
		{
			var response = await Http.DeleteAsync($"api/DealerExperience/{_deleteTarget.Id}");
			if (response.IsSuccessStatusCode)
			{
				ShowMessage("Experience deleted successfully!", false);
				await LoadExperiences();
			}
			else
			{
				ShowMessage("Failed to delete experience.", true);
			}
		}
		catch (Exception ex)
		{
			ShowMessage($"Error: {ex.Message}", true);
		}
		finally
		{
			_isDeleting = false;
			_showDeleteConfirm = false;
			_deleteTarget = null;
		}
	}

	private async Task HandleNext()
	{
		await SaveYearsOfExperience();
		Nav.NavigateTo($"/AnnualSales?dealerId={DealerId}");
	}

	private void ShowMessage(string message, bool isError)
	{
		_message = message;
		_isError = isError;
	}

	}