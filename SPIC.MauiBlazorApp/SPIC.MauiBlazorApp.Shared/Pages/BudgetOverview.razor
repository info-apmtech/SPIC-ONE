@code {
    private bool isDrawerOpen = false;
    private bool filtersOpen = true;
    private string searchQuery = "";

    private void OpenDrawer()
    {
        isDrawerOpen = true;
    }

    private class BudgetPlanRow
    {
        public string HqName { get; set; } = "";
        public string Region { get; set; } = "";
        public int Allocated { get; set; }
        public int Utilized { get; set; }
        public int Remaining { get; set; }
        public double UtilizationPercent { get; set; }
        public int PendingCsr1 { get; set; }
        public int PendingCsr2 { get; set; }
        public string Status { get; set; } = "";
        public string StatusTheme => Status switch
        {
            "Healthy" => "theme-green",
            "Near Limit" => "theme-orange",
            "Exceeded" => "theme-red",
            _ => "theme-green"
        };
        public string ProgressTheme => UtilizationPercent switch
        {
            >= 80 => "theme-green",
            >= 50 => "theme-orange",
            _ => "theme-red"
        };
    }

    private List<BudgetPlanRow> planRows = new()
    {
        new BudgetPlanRow { HqName = "Chennai HQ", Region = "South Region", Allocated = 250000, Utilized = 250000, Remaining = 250000, UtilizationPercent = 85.5, PendingCsr1 = 5, PendingCsr2 = 5, Status = "Healthy" },
        new BudgetPlanRow { HqName = "Chennai HQ", Region = "South Region", Allocated = 250000, Utilized = 250000, Remaining = 250000, UtilizationPercent = 30.60, PendingCsr1 = 2, PendingCsr2 = 2, Status = "Near Limit" },
        new BudgetPlanRow { HqName = "Chennai HQ", Region = "South Region", Allocated = 250000, Utilized = 250000, Remaining = 250000, UtilizationPercent = 65.60, PendingCsr1 = 3, PendingCsr2 = 3, Status = "Healthy" },
        new BudgetPlanRow { HqName = "Chennai HQ", Region = "South Region", Allocated = 250000, Utilized = 250000, Remaining = 250000, UtilizationPercent = 20.60, PendingCsr1 = 3, PendingCsr2 = 3, Status = "Exceeded" },
        new BudgetPlanRow { HqName = "Chennai HQ", Region = "South Region", Allocated = 250000, Utilized = 250000, Remaining = 250000, UtilizationPercent = 65.60, PendingCsr1 = 3, PendingCsr2 = 3, Status = "Healthy" }
    };

    private void ToggleFilters()
    {
        filtersOpen = !filtersOpen;
    }

    private IEnumerable<BudgetPlanRow> GetFilteredRows()
    {
        if (string.IsNullOrWhiteSpace(searchQuery))
            return planRows;

        return planRows.Where(r => 
            r.HqName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) || 
            r.Region.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) || 
            r.Status.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)
        );
    }

    private void NavigateToAllocate()
    {
        NavManager.NavigateTo("/BudgetingManagements");
    }
