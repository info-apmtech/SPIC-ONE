    private bool Validate()
    {
        _errors.Clear();

        if (_basicInfoStateId == 0) _errors["StateId"] = "State is required in Basic Information";
        if (_basicInfoRegionId == 0) _errors["Region"] = "Region is required in Basic Information";
        if (_basicInfoHqId == 0) _errors["HQ"] = "HQ is required in Basic Information";

        if (string.IsNullOrWhiteSpace(_model.FirmName)) _errors["FirmName"] = "Firm Name is required";

        if (status == "Inactive" || status == "Terminated")
        {
            if (_model.LastTransactionDate == null) _errors["LastTransactionDate"] = "Last Transaction Date is required";
        }

        if (status == "Active" || status == "Inactive")
        {
            if (string.IsNullOrWhiteSpace(_model.ShopNoORRoomNoOrBlockNo)) _errors["ShopNo"] = "Shop No / Room No / Block No is required";
            if (string.IsNullOrWhiteSpace(_model.Village)) _errors["Village"] = "Village is required";
            if (string.IsNullOrWhiteSpace(_model.PinCode)) _errors["PinCode"] = "Pincode is required";
            else if (_model.PinCode.Length != 6) _errors["PinCode"] = "Pincode must be 6 digits";
            if (_model.DistrictId == 0) _errors["DistrictId"] = "District is required in Primary Location";
            if (_model.DealerStateId == 0) _errors["DealerStateId"] = "State is required in Primary Location";
            if (string.IsNullOrWhiteSpace(_model.OfficialContactNumber)) _errors["OfficialContactNumber"] = "Official Contact Number is required";
            else if (_model.OfficialContactNumber.Length != 10) _errors["OfficialContactNumber"] = "Official Contact Number must be 10 digits";
            if (string.IsNullOrWhiteSpace(_model.WhatsAppNumber)) _errors["WhatsAppNumber"] = "WhatsApp Number is required";
            else if (_model.WhatsAppNumber.Length != 10) _errors["WhatsAppNumber"] = "WhatsApp Number must be 10 digits";

            if (string.IsNullOrWhiteSpace(_model.AccountHolderName)) _errors["AccountHolderName"] = "Account Holder Name is required";
            if (string.IsNullOrWhiteSpace(_model.AccountNumber)) _errors["AccountNumber"] = "Account Number is required";
            if (_model.BankId == 0) _errors["BankId"] = "Bank is required";
            if (string.IsNullOrWhiteSpace(_model.Branch)) _errors["Branch"] = "Bank Branch is required";
            if (string.IsNullOrWhiteSpace(_model.IFSC)) _errors["IFSC"] = "IFSC Code is required";

            if (string.IsNullOrWhiteSpace(_model.GSTNumber)) _errors["GSTNumber"] = "GST Number is required";
            else if (!Regex.IsMatch(_model.GSTNumber, @"^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$"))
                _errors["GSTNumber"] = "Invalid GST format (e.g., 22AAAAA0000A1Z5)";
            if (string.IsNullOrEmpty(_model.GSTFilePath)) _errors["GSTFile"] = "GST Certificate PDF is required";

            if (string.IsNullOrWhiteSpace(_model.PANNumber)) _errors["PANNumber"] = "PAN Number is required";
            else if (!Regex.IsMatch(_model.PANNumber, @"^[A-Z]{5}[0-9]{4}[A-Z]{1}$"))
                _errors["PANNumber"] = "Invalid PAN format (e.g., ABCDE1234F)";
            if (string.IsNullOrEmpty(_model.PANFilePath)) _errors["PANFile"] = "PAN Card PDF is required";

            if (string.IsNullOrWhiteSpace(_model.AadhaarNumber)) _errors["AadhaarNumber"] = "Aadhaar Number is required";
            else if (!Regex.IsMatch(_model.AadhaarNumber, @"^[0-9]{12}$"))
                _errors["AadhaarNumber"] = "Aadhaar must be exactly 12 digits";
            if (string.IsNullOrEmpty(_model.AadhaarFilePath)) _errors["AadhaarFile"] = "Aadhaar Card PDF is required";

            bool hasWholesale = !string.IsNullOrWhiteSpace(_model.WholeSaleFertilizerLicenseNumber);
            bool hasRetail = !string.IsNullOrWhiteSpace(_model.RetailFertilizerLicenseNumber);

            if (!hasWholesale && !hasRetail)
            {
                _errors["FertilizerLicense"] = "At least one Fertilizer License (Wholesale or Retail) is required";
            }
            else
            {
                if (hasWholesale && string.IsNullOrEmpty(_model.WholesaleLicenseFilePath))
                    _errors["WholesaleFile"] = "Wholesale License Certificate PDF is required";
                if (hasRetail && string.IsNullOrEmpty(_model.RetailLicenseFilePath))
                    _errors["RetailFile"] = "Retail License Certificate PDF is required";
            }
        }

        return _errors.Count == 0;
    }

    private async Task<bool> SaveDealer()
    {
        if (!Validate()) return false;

        _isSaving = true;
        _message = null;
        var success = false;

        try
        {
            _model.IsDealer = selected == "Dealer";
            _model.InSpic = isSpic;
            _model.InGreenStar = isGreenStar;
            _model.StateId = _basicInfoStateId;
            _model.Region = _basicInfoRegionId;
            _model.HQ = _basicInfoHqId;
            _model.ParentDealer = _parentDealerId;
            _model.Status = status switch
            {
                "Active" => 0,
                "Inactive" => 1,
                "Terminated" => 2,
                _ => 0
            };

            // _model.UserTableId = LoginState.UserId ?? "";
            _model.FirmName ??= "";
            _model.ShopNoORRoomNoOrBlockNo ??= "";
            _model.Village ??= "";
            _model.PinCode ??= "";
            _model.OfficialContactNumber ??= "";
            _model.WhatsAppNumber ??= "";
            _model.AccountHolderName ??= "";
            _model.AccountNumber ??= "";
            _model.Branch ??= "";
            _model.IFSC ??= "";
            _model.UpdatedBy = LoginState.UserId ?? "System";
            _model.UpdatedAt = DateTime.Now;

            _model.DateOfAppointment ??= DateTime.MinValue;
            _model.WholesaleLicenseExpiryDate ??= DateTime.MinValue;
            _model.RetailLicenseExpiryDate ??= DateTime.MinValue;
            _model.IsOfficeAutomation ??= false;
            _model.IsSDWA ??= false;

            HttpResponseMessage response;

            if (_isEditMode)
            {
                response = await Http.PutAsJsonAsync($"api/DealerRegistration/update-with-user/{_model.Id}", _model);
            }
            else
            {
                _model.CreatedAt = DateTime.Now;
                _model.CreatedBy = LoginState.UserId ?? "System";
                response = await Http.PostAsJsonAsync("api/DealerRegistration", _model);
            }

            if (response.IsSuccessStatusCode)
            {
                int dealerId = _model.Id;
                
                //  Capture the newly generated UserTableId from the server's response!
                if (!_isEditMode)
                {
                    var result = await response.Content.ReadFromJsonAsync<CreateResponse>();
                    if (result?.Data != null)
                    {
                        dealerId = result.Data.Id;
                        _model.Id = dealerId;
                        _model.UserTableId = result.Data.UserTableId; 
                    }
                }
                else
                {
                    // For Edit mode, grab the updated model from the server
                    var result = await response.Content.ReadFromJsonAsync<DealerFormModel>();
                    if (result != null)
                    {
                        _model.UserTableId = result.UserTableId; 
                    }
                }

                bool filesUpdated = false;
               if (dealerId > 0)
{
    var uploads = new List<Task>();

    if (_gstFile != null)
        uploads.Add(UploadFileToServer(dealerId, "GST", _gstFile)
            .ContinueWith(t => { if (t.Result != null) { _model.GSTFilePath = t.Result.FilePath; if (!string.IsNullOrEmpty(t.Result.GST) && string.IsNullOrWhiteSpace(_model.GSTNumber)) { _model.GSTNumber = t.Result.GST; OnGSTNumberChanged(); } filesUpdated = true; } }));
    if (_panFile != null)
        uploads.Add(UploadFileToServer(dealerId, "PAN", _panFile)
            .ContinueWith(t => { if (t.Result != null) { _model.PANFilePath = t.Result.FilePath; if (!string.IsNullOrEmpty(t.Result.PAN) && string.IsNullOrWhiteSpace(_model.PANNumber)) { _model.PANNumber = t.Result.PAN; OnPANNumberChanged(); } filesUpdated = true; } }));
    if (_aadhaarFile != null)
        uploads.Add(UploadFileToServer(dealerId, "Aadhaar", _aadhaarFile)
            .ContinueWith(t => { if (t.Result != null) { _model.AadhaarFilePath = t.Result.FilePath; if (!string.IsNullOrEmpty(t.Result.Aadhaar) && string.IsNullOrWhiteSpace(_model.AadhaarNumber)) { _model.AadhaarNumber = t.Result.Aadhaar; OnAadhaarNumberChanged(); } filesUpdated = true; } }));
    if (_wholesaleFile != null)
        uploads.Add(UploadFileToServer(dealerId, "WholesaleLicense", _wholesaleFile)
            .ContinueWith(t => { if (t.Result != null) { _model.WholesaleLicenseFilePath = t.Result.FilePath; filesUpdated = true; } }));
    if (_retailFile != null)
        uploads.Add(UploadFileToServer(dealerId, "RetailLicense", _retailFile)
            .ContinueWith(t => { if (t.Result != null) { _model.RetailLicenseFilePath = t.Result.FilePath; filesUpdated = true; } }));

    await Task.WhenAll(uploads);

    if (filesUpdated)
        await Http.PutAsJsonAsync($"api/DealerRegistration/update-with-user/{dealerId}", _model);
}

                _gstFile = null;
                _panFile = null;
                _aadhaarFile = null;
                _wholesaleFile = null;
                _retailFile = null;

                ShowMessage(_isEditMode ? "Dealer updated successfully!" : "Dealer registered successfully!", false);
                //await LoadData();
                success = true;
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                ShowMessage($"Failed to save: {error}", true);
            }
        }
        catch (Exception ex)
        {
            ShowMessage($"Error: {ex.Message}", true);
        }
        finally
        {
            _isSaving = false;
        }

        return success;
    }

