@page "/Register"
@implements IDisposable
@using System.Net.Http.Json
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Components
@using SPIC.MauiBlazorApp.Shared.Services
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject LoadingService Loading
@inject LoginState LoginState
@inject LookupCacheService LookupCache
<style>
    fieldset:disabled .file-remove-x {
        display: none !important;
    }
</style>
<div class="container-fluid py-4 px-0">
    <FormLoader />
   

    <fieldset disabled="@IsViewOnly" style="@(IsViewOnly ? "border:0;padding:0;margin:0;" : "border:0;padding:0;margin:0;")">


    <h5 class="fw-bold mb-4 reg-page-heading">Dealer Registration</h5>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert @(_isError ? "alert-danger" : "alert-success") alert-dismissible fade show mb-3" role="alert">
            @_message
            <button type="button" class="btn-close" @onclick='() => _message = null'></button>
        </div>
    }

    <form @onsubmit:preventDefault>
        @if (status == "Active" || status == "Inactive" || status == "Terminated")
        {
            <div class="basic-info-card">
                <div class="basic-info-header">
                    <h3 class="basic-info-title">
                        <img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/BasicInfoIcon.svg"
                             class="formicon"
                             alt="icon" /> Basic Information
                    </h3>

                    <div class="btn-group-toggle">
                        <button type="button"
                                class="btn @(selected == "Dealer" ? "active" : "")"
                                @onclick='() => Select("Dealer")'>
                            Dealer
                        </button>

                        <button type="button"
                                class="btn @(selected == "Department" ? "active" : "")"
                                @onclick='() => Select("Department")'>
                            Department
                        </button>
                    </div>
                </div>

                <div class="row g-4 align-items-center">
                    <div class="col-12 col-md-5">
                        <div class="row g-3 h-100">

                            <div class="col-6">
                                <div class="logo-card spic @(isSpic ? "active" : "")"
                                     @onclick="ToggleSpic">
                                    <div class="card-checkbox">
                                        <i class="bi bi-check-lg"></i>
                                    </div>
                                    <img src="_content/SPIC.MauiBlazorApp.Shared/images/loginimages/logo.png" />
                                    <span>SPIC</span>
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="logo-card green-star @(isGreenStar ? "active" : "")"
                                     @onclick="ToggleGreenStar">
                                    <div class="card-checkbox">
                                        <i class="bi bi-check-lg"></i>
                                    </div>
                                    <img src="_content/SPIC.MauiBlazorApp.Shared/images/loginimages/greensraticon.svg" />
                                    <span>GREEN STAR</span>
                                </div>
                            </div>

                        </div>
                    </div>

                    <div class="col-12 col-md-7">
                        <div class="row g-3">
                            <div class="col-12 col-sm-6">
                                <label class="form-label-custom">State</label>
                                <select class="form-select-custom w-100 @(_errors.ContainsKey("StateId") ? "is-invalid" : "")" @bind="_basicInfoStateId" @bind:after="OnBasicInfoStateChanged" disabled="@_isStateLocked">
                                    <option value="0">-- Select State --</option>
                                    @foreach (var state in _statesAll)
                                    {
                                        <option value="@state.Id">@state.StateName</option>
                                    }
                                </select>
                                @if (_errors.ContainsKey("StateId"))
                                {
                                    <div class="field-error">@_errors["StateId"]</div>
                                }
                            </div>
                            <div class="col-12 col-sm-6">
                                <label class="form-label-custom">Region</label>
                               <select class="form-select-custom w-100 @(_errors.ContainsKey("Region") ? "is-invalid" : "")"
        @bind="_basicInfoRegionId"
        @bind:after="OnBasicInfoRegionChanged"
        disabled="@_isRegionLocked">
    <option value="0">-- Select Region --</option>
    @foreach (var region in _filteredRegions)
    {
        <option value="@region.Id">@region.RegionName</option>
    }
</select>
                                @if (_errors.ContainsKey("Region"))
                                {
                                    <div class="field-error">@_errors["Region"]</div>
                                }
                            </div>
                            <div class="col-12 col-sm-6">
                                <label class="form-label-custom">HQ</label>
                               <select class="form-select-custom w-100 @(_errors.ContainsKey("HQ") ? "is-invalid" : "")"
        @bind="_basicInfoHqId"
        @bind:after='() => ValidateFieldOnChange("HQ", _basicInfoHqId > 0)'
        disabled="@_isHqLocked">
    <option value="0">-- Select HQ --</option>
    @foreach (var hq in _filteredHeadquarters)
    {
        <option value="@hq.Id">@hq.HeadquarterName</option>
    }
</select>
                                @if (_errors.ContainsKey("HQ"))
                                {
                                    <div class="field-error">@_errors["HQ"]</div>
                                }
                            </div>
                            <div class="col-12 col-sm-6">
                                <label class="form-label-custom">Status</label>

                                <div class="status-btn-group">
                                    <button type="button"
                                            class="btn btn_active @(status == "Active" ? "active" : "")"
                                            @onclick='() => SelectStatus("Active")'>
                                        Active
                                    </button>

                                    <button type="button"
                                            class="btn btn_inactive @(status == "Inactive" ? "active" : "")"
                                            @onclick='() => SelectStatus("Inactive")'>
                                        Inactive
                                    </button>

                                    <button type="button"
                                            class="btn btn_terminated @(status == "Terminated" ? "active" : "")"
                                            @onclick='() => SelectStatus("Terminated")'>
                                        Terminated
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (status == "Terminated")
        {
            <div class="basic-info-card">
                <div class="card-header-title mb-2">
                    <img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/InactiveStatus.svg"
                         class="formicon"
                         alt="icon" /> Terminated Status
                </div>
                <div class="row g-3">
                    <div class="col-12 col-sm-6 col-md-3">
                        <label class="form-label-custom">Final Amount Status</label>
                        <div class="status-btn-group">
                            <button type="button"
                                    class="btn btn_active @(_model.IsFinalAmountSettled == true ? "active" : "")"
                                    @onclick='() => _model.IsFinalAmountSettled = true'>
                                Settled
                            </button>
                            <button type="button"
                                    class="btn btn_inactive @(_model.IsFinalAmountSettled == false ? "active" : "")"
                                    @onclick='() => _model.IsFinalAmountSettled = false'>
                                Not Settled
                            </button>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-md-3">
                        <label class="form-label-custom">Final Approval Date</label>
                        <input type="date" class="form-control-custom w-100 @(_errors.ContainsKey("FinalApprovalDate") ? "is-invalid" : "")" @bind="_model.FinalApprovalDate" @bind:after='() => ValidateFieldOnChange("FinalApprovalDate", _model.FinalApprovalDate != null)'>
                        @if (_errors.ContainsKey("FinalApprovalDate"))
                        {
                            <div class="field-error">@_errors["FinalApprovalDate"]</div>
                        }
                    </div>
                    <div class="col-12 col-sm-6 col-md-3">
                        <label class="form-label-custom">Settlement Date</label>
                        <input type="date" class="form-control-custom w-100 @(_errors.ContainsKey("SettlementDate") ? "is-invalid" : "")" @bind="_model.SettlementDate" @bind:after='() => ValidateFieldOnChange("SettlementDate", _model.SettlementDate != null)'>
                        @if (_errors.ContainsKey("SettlementDate"))
                        {
                            <div class="field-error">@_errors["SettlementDate"]</div>
                        }
                    </div>
                    <div class="col-12 col-sm-6 col-md-3">
                        <label class="form-label-custom">Settlement Amount (Lakhs)</label>
                        <div class="input-icon-left-wrapper">
                            <span class="input-icon-left">₹</span>
                            <input type="number"
                                   class="form-control-custom w-100 input-with-left-icon"
                                   placeholder="0.00"
                                   step="0.01"
                                   @bind="_model.SettlementAmount">
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="basic-info-card business-info-card">
            <div class="business-info-header">
                <div class="d-flex align-items-center gap-2">
                    <img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/BasicInfoIcon.svg" class="formicon" alt="icon" />
                    <h5 class="fw-semibold m-0 business-info-title">Business Information</h5>
                </div>
                @if (_isEditMode)
                {
                    <span class="business-info-pill business-info-pill-edit">
                        <i class="bi bi-pencil-square me-1"></i>Editing
                    </span>
                }
                else
                {
                    <span class="business-info-pill business-info-pill-new">
                        <i class="bi bi-plus-circle me-1"></i>New Entry
                    </span>
                }
            </div>

            <div class="business-info-body">
                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label-custom">Dealer Code & Name</label>
                        <select class="form-select-custom w-100" @bind="_dealerCodeId" @bind:after="OnDealerCodeChanged">
                            <option value="0">-- New Entry --</option>
                            @foreach (var dealer in _filteredDealers)
                            {
                                <option value="@dealer.Id">@dealer.DealerCode - @dealer.FirmName</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label-custom">Parent Dealer Code & Name</label>
                        <select class="form-select-custom w-100" @bind="_parentDealerId">
                            <option value="0">-- Select Parent Dealer --</option>
                            @foreach (var dealer in _filteredDealers)
                            {
                                <option value="@dealer.Id">@dealer.DealerCode - @dealer.FirmName</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-12 col-md-8">
                        <label class="form-label-custom">Firm Name <small class="text-muted fw-normal">(As per Fertilizer License or GST Trade Name)</small></label>
                        <div class="firm-name-input-wrap">
                            <span class="firm-name-prefix">M/s.</span>
                            <input type="text" class="form-control-custom w-100 firm-name-input @(_errors.ContainsKey("FirmName") ? "is-invalid" : "")" @bind="_model.FirmName" @bind:after="SanitizeFirmName" placeholder="Enter Firm Business Name">
                        </div>
                        @if (_errors.ContainsKey("FirmName"))
                        {
                            <div class="field-error">@_errors["FirmName"]</div>
                        }
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label-custom">Date of Appointment</label>
                        <input type="date" class="form-control-custom w-100" @bind="_model.DateOfAppointment">
                    </div>
                </div>
            </div>
        </div>

        @if (status == "Inactive")
        {
            <div class="basic-info-card">
                <div class="card-header-title mb-2">
                    <img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/InactiveStatus.svg"
                         class="formicon"
                         alt="icon" /> Inactive Status
                </div>
                <div class="row g-3">
                    <div class="col-12 col-sm-6 col-md-4">
                        <label class="form-label-custom">Last Transaction Date</label>
                        <input type="date" class="form-control-custom w-100 @(_errors.ContainsKey("LastTransactionDate") ? "is-invalid" : "")" @bind="_model.LastTransactionDate" @bind:after='() => ValidateFieldOnChange("LastTransactionDate", _model.LastTransactionDate != null)'>
                        @if (_errors.ContainsKey("LastTransactionDate"))
                        {
                            <div class="field-error">@_errors["LastTransactionDate"]</div>
                        }
                    </div>
                    <div class="col-12 col-sm-6 col-md-4">
                        <label class="form-label-custom">Transaction Type</label>
                        <div class="status-btn-group">
                            <button type="button"
                                    class="btn btn_active @(_model.IsLastTransactionIsSale == true ? "active" : "")"
                                    @onclick='() => _model.IsLastTransactionIsSale = true'>
                                Sales
                            </button>
                            <button type="button"
                                    class="btn btn_inactive @(_model.IsLastTransactionIsSale == false ? "active" : "")"
                                    @onclick='() => _model.IsLastTransactionIsSale = false'>
                                Collection
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (status == "Active" || status == "Inactive")
        {
            <div class="form-card">
                <div class="primary-location-header">
                    <div class="card-header-title mb-0">
                        <img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/LocationIcon.svg" alt="Location" class="formicon" />Primary Location
                    </div>
                    <button type="button" class="btn btn-outline-success btn-sm rounded-pill px-3 card-header-title use-current-loc-btn" @onclick="UseCurrentLocation" disabled="@_isGettingLocation">
                        @if (_isGettingLocation)
                        {
                            <i class="bi bi-arrow-repeat spin"></i> <span>Getting Location...</span>
                        }
                        else
                        {
                            <img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/CurrentLocation.svg" alt="Current Location" class="verifyicon" /> <span>Use Current Location</span>
                        }
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(_locationMessage))
                {
                    <div class="alert @(_locationSuccess ? "alert-success" : "alert-warning") py-1 px-2 small mb-2">@_locationMessage</div>
                }

                <div class="row g-3">
                    <div class="col-12 col-md-4">
                        <div class="map-box-wrap">
                            <div id="leafletMap" class="leaflet-map-el"></div>
                            <button type="button" class="btn btn-sm btn-success rounded-pill px-3 shadow-sm map-loc-btn" @onclick="UseCurrentLocation" disabled="@_isGettingLocation"><i class="bi bi-crosshair"></i> Use current location</button>
                        </div>
                    </div>
                    <div class="col-12 col-md-8">
                        <div class="row g-3">
                            <div class="col-12 col-sm-6">
                                <label class="form-label-custom">Google Map URL</label>
                                <input type="text" class="form-control-custom w-100" @bind="_model.GoogleMapURL" @bind:after="OnGoogleMapUrlChanged" placeholder="Click map or Paste Google Maps link">
                            </div>
                            <div class="col-12 col-sm-6">
                                <label class="form-label-custom">Shop No / Room No / Block No</label>
                                <input type="text" class="form-control-custom w-100 @(_errors.ContainsKey("ShopNo") ? "is-invalid" : "")" @bind="_model.ShopNoORRoomNoOrBlockNo" @bind:after='() => ValidateFieldOnChange("ShopNo", !string.IsNullOrWhiteSpace(_model.ShopNoORRoomNoOrBlockNo))' placeholder="">
                                @if (_errors.ContainsKey("ShopNo"))
                                {
                                    <div class="field-error">@_errors["ShopNo"]</div>
                                }
                            </div>
                            <div class="col-12 col-sm-6">
                                <label class="form-label-custom">Street / Area / Locality</label>
                                <input type="text" class="form-control-custom w-100" @bind="_model.Street" placeholder="">
                            </div>
                            <div class="col-12 col-sm-6">
                                <label class="form-label-custom">Sub Village</label>
                                <input type="text" class="form-control-custom w-100" @bind="_model.SubVillage" placeholder="Enter Sub Village">
                            </div>

                            <div class="col-12 col-sm-6">
                                <label class="form-label-custom">Pincode</label>
<input type="text"
       class="form-control-custom w-100 @(_errors.ContainsKey("PinCode") ? "is-invalid" : "")"
       @bind="_model.PinCode"
       @bind:event="oninput"
       @bind:after="OnPincodeChanged"
       placeholder="Enter Pincode"
       maxlength="6"
       inputmode="numeric">
                                @if (_isPincodeLookup)
                                {
                                    <div class="small text-muted mt-1"><i class="bi bi-arrow-repeat spin"></i> Looking up pincode...</div>
                                }
                                @if (_errors.ContainsKey("PinCode"))
                                {
                                    <div class="field-error">@_errors["PinCode"]</div>
                                }
                                @if (!string.IsNullOrEmpty(_pincodeMessage))
                                {
                                    <div class="small @(_pincodeSuccess ? "text-success" : "text-warning") mt-1">@_pincodeMessage</div>
                                }
                            </div>
                            <div class="col-12 col-sm-6">
                                <label class="form-label-custom">Village</label>
                                <input type="text" class="form-control-custom w-100 @(_errors.ContainsKey("Village") ? "is-invalid" : "")" @bind="_model.Village" @bind:after='() => ValidateFieldOnChange("Village", !string.IsNullOrWhiteSpace(_model.Village))' placeholder="Village">
                                @if (_errors.ContainsKey("Village"))
                                {
                                    <div class="field-error">@_errors["Village"]</div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="col-6 col-sm-6 col-md-3">
                        <label class="form-label-custom">Block</label>
                        <input type="text" class="form-control-custom w-100" @bind="_model.Block" placeholder="Enter Block">
                    </div>
                    <div class="col-6 col-sm-6 col-md-3">
                        <label class="form-label-custom">Taluk</label>
                        <input type="text" class="form-control-custom w-100" @bind="_model.Taluk" placeholder="Enter Taluk">
                    </div>
                    <div class="col-12 col-sm-6 col-md-3">
                        <label class="form-label-custom">District</label>
                      <select class="form-select-custom w-100" @bind="_model.DistrictId">
    <option value="0">-- Select District --</option>
    @foreach (var district in _DistrictAll.Where(d => d.StateId == _model.DealerStateId))
    {
        <option value="@district.Id">@district.DistrictName</option>
    }
</select>
                        @if (_errors.ContainsKey("DistrictId"))
                        {
                            <div class="field-error">@_errors["DistrictId"]</div>
                        }
                    </div>

                    <div class="col-12 col-sm-6 col-md-3">
                        <label class="form-label-custom">State</label>
                       <select class="form-select-custom w-100"
        @bind="_model.DealerStateId"
        @bind:after="OnDealerStateChanged">
    <option value="0">-- Select State --</option>
    @foreach (var state in _statesAll)
    {
        <option value="@state.Id">@state.StateName</option>
    }
</select>
                        @if (_errors.ContainsKey("DealerStateId"))
                        {
                            <div class="field-error">@_errors["DealerStateId"]</div>
                        }
                    </div>

                    <div class="col-12 col-md-4">
                        <label class="form-label-custom">Official Contact Number</label>
                        <input type="tel"
                               inputmode="numeric"
                               pattern="[0-9]*"
                               class="form-control-custom w-100 @(_errors.ContainsKey("OfficialContactNumber") ? "is-invalid" : "")"
                               @bind="_model.OfficialContactNumber"
                               @bind:after="SanitizeOfficialContact"
                               placeholder="10-digit mobile number"
                               maxlength="10"
                               oninput="this.value = this.value.replace(/[^0-9]/g, '')">

                        @if (_errors.ContainsKey("OfficialContactNumber"))
                        {
                            <div class="field-error">@_errors["OfficialContactNumber"]</div>
                        }
                    </div>

                    <div class="col-12 col-md-4">
                        <label class="form-label-custom">WhatsApp Number</label>
                        <input type="tel"
                               inputmode="numeric"
                               pattern="[0-9]*"
                               class="form-control-custom w-100 @(_errors.ContainsKey("WhatsAppNumber") ? "is-invalid" : "")"
                               @bind="_model.WhatsAppNumber"
                               @bind:after="SanitizeWhatsAppNumber"
                               placeholder="10-digit mobile number"
                               maxlength="10"
                               oninput="this.value = this.value.replace(/[^0-9]/g, '')">

                        @if (_errors.ContainsKey("WhatsAppNumber"))
                        {
                            <div class="field-error">@_errors["WhatsAppNumber"]</div>
                        }
                    </div>

                    <div class="col-12 col-md-4">
                        <label class="form-label-custom">Alternative Number</label>
                        <input type="tel"
                               inputmode="numeric"
                               pattern="[0-9]*"
                               class="form-control-custom w-100"
                               @bind="_model.AlternativeNumber"
                               @bind:after="SanitizeAlternativeNumber"
                               placeholder="10-digit mobile number"
                               maxlength="10"
                               oninput="this.value = this.value.replace(/[^0-9]/g, '')">
                    </div>
                </div>
            </div>

            <div class="basic-info-card">
                <div class="card-header-title mb-2">
                    <img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/BasicInfoIcon.svg"
                         class="formicon"
                         alt="icon" /> Trade Deposit Details
                </div>
                <div class="row g-3">
                    <div class="col-12 col-sm-6 col-md-4">
                        <label class="form-label-custom">Trade Deposit Amount (₹ in lakhs)</label>
                        <div class="input-icon-left-wrapper">
                            <span class="input-icon-left">₹</span>
                            <input type="number" class="form-control-custom w-100 input-with-left-icon" placeholder="0.00" step="0.01" @bind="_model.TradeDepositAmount">
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-md-4">
                        <label class="form-label-custom">Receipt No</label>
                        <input type="text" class="form-control-custom w-100" @bind="_model.TradeDepositReceiptNo" placeholder="Enter Receipt Number">
                    </div>
                    <div class="col-12 col-sm-6 col-md-4">
                        <label class="form-label-custom">Deposit Date</label>
                        <input type="date" class="form-control-custom w-100" @bind="_model.TradeDepositDate">
                    </div>
                </div>
            </div>

            <div class="basic-info-card">
                <div class="card-header-title mb-2">
                    <img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/BasicInfoIcon.svg"
                         class="formicon"
                         alt="icon" /> Bank Details
                </div>
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label-custom">Account Holder Name</label>
                        <input type="text" class="form-control-custom w-100 @(_errors.ContainsKey("AccountHolderName") ? "is-invalid" : "")" @bind="_model.AccountHolderName" @bind:after='() => ValidateFieldOnChange("AccountHolderName", !string.IsNullOrWhiteSpace(_model.AccountHolderName))' placeholder="Enter Account Holder Name">
                        @if (_errors.ContainsKey("AccountHolderName"))
                        {
                            <div class="field-error">@_errors["AccountHolderName"]</div>
                        }
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label-custom">Account Number</label>
                        <input type="text" class="form-control-custom w-100 @(_errors.ContainsKey("AccountNumber") ? "is-invalid" : "")" @bind="_model.AccountNumber" @bind:after='() => ValidateFieldOnChange("AccountNumber", !string.IsNullOrWhiteSpace(_model.AccountNumber))' placeholder="Enter Account Number">
                        @if (_errors.ContainsKey("AccountNumber"))
                        {
                            <div class="field-error">@_errors["AccountNumber"]</div>
                        }
                    </div>
                    <div class="col-12 col-sm-6 col-md-4">
                        <label class="form-label-custom">Bank Name</label>
                        <select class="form-select-custom w-100 @(_errors.ContainsKey("BankId") ? "is-invalid" : "")" @bind="_model.BankId" @bind:after='() => ValidateFieldOnChange("BankId", _model.BankId > 0)'>
                            <option value="0">-- Select Bank --</option>
                            @foreach (var bank in _banksAll)
                            {
                                <option value="@bank.Id">@bank.Name</option>
                            }
                        </select>
                        @if (_errors.ContainsKey("BankId"))
                        {
                            <div class="field-error">@_errors["BankId"]</div>
                        }
                    </div>
                    <div class="col-12 col-sm-6 col-md-4">
                        <label class="form-label-custom">Bank Branch</label>
                        <input type="text" class="form-control-custom w-100 @(_errors.ContainsKey("Branch") ? "is-invalid" : "")" @bind="_model.Branch" @bind:after='() => ValidateFieldOnChange("Branch", !string.IsNullOrWhiteSpace(_model.Branch))' placeholder="Enter Bank Branch">
                        @if (_errors.ContainsKey("Branch"))
                        {
                            <div class="field-error">@_errors["Branch"]</div>
                        }
