    }

    private async Task ConfirmDelete()
    {
        try
        {
            bool isServerFile = !string.IsNullOrEmpty(_deleteFilePathToDelete)
                                && _deleteFilePathToDelete.Contains("/");

            if (isServerFile)
            {
                await Http.DeleteAsync($"api/DealerFile/delete?filePath={Uri.EscapeDataString(_deleteFilePathToDelete)}");
            }

            switch (_deleteDocType)
            {
                case "GST":
                    _gstFile = null;
                    _model.GSTFilePath = null;
                    _errors.Remove("GSTFile");
                    break;
                case "PAN":
                    _panFile = null;
                    _model.PANFilePath = null;
                    _errors.Remove("PANFile");
                    break;
                case "Aadhaar":
                    _aadhaarFile = null;
                    _model.AadhaarFilePath = null;
                    _errors.Remove("AadhaarFile");
                    break;
                case "WholesaleLicense":
                    _wholesaleFile = null;
                    _model.WholesaleLicenseFilePath = null;
                    _errors.Remove("WholesaleFile");
                    break;
                case "RetailLicense":
                    _retailFile = null;
                    _model.RetailLicenseFilePath = null;
                    _errors.Remove("RetailFile");
                    break;
            }

            if (_model.Id > 0)
            {
                await Http.PutAsJsonAsync($"api/DealerRegistration/{_model.Id}", _model);
            }

            ShowMessage($"{_deleteDisplayName} deleted successfully", false);
        }
        catch (Exception ex)
        {
            ShowMessage($"Failed to delete file: {ex.Message}", true);
        }
        finally
        {
            CancelDelete();
        }
    }

