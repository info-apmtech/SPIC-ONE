@code {
    [SupplyParameterFromQuery(Name = "dealerId")]
    public int? DealerIdFromQuery { get; set; }
    [SupplyParameterFromQuery(Name = "mode")]
    public string? Mode { get; set; }

    private bool IsViewOnly => string.Equals(Mode, "view", StringComparison.OrdinalIgnoreCase);

    private DealerFormModel _model = new();
    private bool _isEditMode;
    private bool _isSaving;
    private Dictionary<string, string> _errors = new();

    private string selected = "Dealer";
    private string status = "Active";
    private bool isSpic = true;
    private bool isGreenStar = true;
    private bool _isStateLocked;
    private bool _isRegionLocked;
private bool _isHqLocked;

    private IBrowserFile? _gstFile;
    private IBrowserFile? _panFile;
    private IBrowserFile? _aadhaarFile;
    private IBrowserFile? _wholesaleFile;
    private IBrowserFile? _retailFile;

    private bool _showDeleteModal = false;
    private string _deleteDocType = "";
    private string _deleteDisplayName = "";
    private string _deleteFileNameDisplay = "";
    private string _deleteFilePathToDelete = "";

    private bool _isGettingLocation;
    private string? _locationMessage;
    private bool _locationSuccess;

    private DotNetObjectReference<Register>? _objRef;

    private List<LocationItemDto> _statesAll = new();
    private List<LocationItemDto> _DistrictAll = new();
    private List<LocationItemDto> _regionsAll = new();
    private List<LocationItemDto> _headquartersAll = new();
    private List<BankItemDto> _banksAll = new();
    private List<DealerItemDto> _dealersAll = new();

    private List<LocationItemDto> _filteredRegions = new();
    private List<LocationItemDto> _filteredHeadquarters = new();
    private List<DealerItemDto> _filteredDealers = new();

    private int _basicInfoStateId;
    private int _basicInfoRegionId;
    private int _basicInfoHqId;
    private int _dealerCodeId;
    private int _parentDealerId;

    private string? _message;
    private bool _isError;
    private bool _isPincodeLookup;
    private string? _pincodeMessage;
    private bool _pincodeSuccess;

   protected override async Task OnInitializedAsync()
{
    _objRef = DotNetObjectReference.Create(this);
    Loading.Show();
    try
    {
        // If editing, start the dealer fetch concurrently with the lookups
        Task<DealerFormModel?>? dealerTask = null;
        if (DealerIdFromQuery.HasValue && DealerIdFromQuery.Value > 0)
        {
            _dealerCodeId = DealerIdFromQuery.Value;
            dealerTask = Http.GetFromJsonAsync<DealerFormModel>($"api/DealerRegistration/{_dealerCodeId}");
        }

        await LoadData();
        ApplyEmployeeLocationDefaults();

        if (dealerTask != null)
        {
            try
            {
                var dealer = await dealerTask;
                await ApplyDealerToForm(dealer);
            }
            catch (Exception ex)
            {
                ShowMessage($"Failed to load dealer: {ex.Message}", true);
                _isEditMode = false;
            }
        }
    }
    finally
    {
        Loading.Hide();
    }
}

    public void Dispose() => _objRef?.Dispose();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("initLeafletMap", "leafletMap", _objRef);
            if (_model.Latitude.HasValue && _model.Longitude.HasValue)
            {
                await TriggerMapUpdate(_model.Latitude.Value, _model.Longitude.Value);
            }
        }
    }
    private async Task ApplyDealerToForm(DealerFormModel? dealer)
{
    if (dealer == null) return;

    _model = dealer;
    _isEditMode = true;

   selected           = _model.IsDealer ? "Dealer" : "Department";
isSpic             = _model.InSpic;
isGreenStar     = _model.InGreenStar;
_basicInfoStateId  = _model.StateId;
_basicInfoRegionId = _model.Region;
_basicInfoHqId     = _model.HQ;
_parentDealerId    = _model.ParentDealer;

    status = _model.Status switch
    {
        0 => "Active",
        1 => "Inactive",
        2 => "Terminated",
        _ => "Active"
    };

    _filteredRegions       = _regionsAll.Where(r => r.StateId == _basicInfoStateId).ToList();
    _filteredHeadquarters  = _headquartersAll.Where(h => h.RegionId == _basicInfoRegionId).ToList();
    _filteredDealers       = _dealersAll.Where(d => d.StateId == _basicInfoStateId).ToList();
    ApplyLockedEmployeeLocation();
    if (_model.Latitude.HasValue && _model.Longitude.HasValue)
    {
        await TriggerMapUpdate(_model.Latitude.Value, _model.Longitude.Value);
    }
}
    private async Task TriggerMapUpdate(double lat, double lng)
    {
        try { await JS.InvokeVoidAsync("updateLeafletMap", "leafletMap", lat, lng); }
        catch (Exception ex) { Console.WriteLine($"Map update failed: {ex.Message}"); }
    }

    [JSInvokable]
    public void UpdateLocationFromMap(double lat, double lng)
    {
        _model.Latitude = lat;
        _model.Longitude = lng;
        _model.GoogleMapURL = $"http://maps.google.com/maps?q={lat.ToString(System.Globalization.CultureInfo.InvariantCulture)},{lng.ToString(System.Globalization.CultureInfo.InvariantCulture)}";
        _locationMessage = $"Location selected from Map: {lat:F6}, {lng:F6}";
        _locationSuccess = true;
        StateHasChanged();
    }

private async Task LoadData()
{ 
    try
    {
        var cacheTask   = LookupCache.EnsureLoadedAsync();
        var dealersTask = Http.GetFromJsonAsync<List<DealerItemDto>>("api/DealerRegistration/lookup");

        await Task.WhenAll(cacheTask, dealersTask);

        _statesAll       = LookupCache.States;
        _DistrictAll     = LookupCache.Districts;
        _regionsAll      = LookupCache.Regions;
        _headquartersAll = LookupCache.Headquarters;
        _banksAll        = LookupCache.Banks;
        _dealersAll      = dealersTask.Result ?? new();
    }
    catch (Exception ex)
    {
        ShowMessage($"Failed to load data: {ex.Message}", true);
    }
}

    void Select(string type) => selected = type;
    void SelectStatus(string value) => status = value;

    private void ApplyEmployeeLocationDefaults()
{
    ApplyLockedEmployeeLocation();
}

    void ToggleSpic() => isSpic = !isSpic;
    void ToggleGreenStar() => isGreenStar = !isGreenStar;

    private void OnBasicInfoStateChanged()
    {
        if (_basicInfoStateId > 0) _errors.Remove("StateId");
        _basicInfoRegionId = 0;
        _basicInfoHqId = 0;
        _dealerCodeId = 0;
        _parentDealerId = 0;
        _filteredRegions = _regionsAll.Where(r => r.StateId == _basicInfoStateId).ToList();
        _filteredHeadquarters = new();
        _filteredDealers = _dealersAll.Where(d => d.StateId == _basicInfoStateId).ToList();
        if (!_isEditMode) _model = new();
    }

    private void OnBasicInfoRegionChanged()
    {
        if (_basicInfoRegionId > 0) _errors.Remove("Region");
        _basicInfoHqId = 0;
        _filteredHeadquarters = _headquartersAll.Where(h => h.RegionId == _basicInfoRegionId).ToList();
    }

    private void ValidateFieldOnChange(string key, bool isValid) { if (isValid) _errors.Remove(key); }

    private void SanitizeOfficialContact()
    {
        _model.OfficialContactNumber = new string(_model.OfficialContactNumber?.Where(char.IsDigit).ToArray() ?? []);
        ValidateFieldOnChange("OfficialContactNumber", _model.OfficialContactNumber?.Length == 10);
    }

    private void SanitizeWhatsAppNumber()
    {
        _model.WhatsAppNumber = new string(_model.WhatsAppNumber?.Where(char.IsDigit).ToArray() ?? []);
        ValidateFieldOnChange("WhatsAppNumber", _model.WhatsAppNumber?.Length == 10);
    }

    private void SanitizeAlternativeNumber()
    {
        _model.AlternativeNumber = new string(_model.AlternativeNumber?.Where(char.IsDigit).ToArray() ?? []);
    }

    private void SanitizeFirmName()
    {
        if (!string.IsNullOrEmpty(_model.FirmName))
            _model.FirmName = _model.FirmName.ToUpperInvariant();
        ValidateFieldOnChange("FirmName", !string.IsNullOrWhiteSpace(_model.FirmName));
    }

    private void OnGSTNumberChanged()
    {
        if (!string.IsNullOrEmpty(_model.GSTNumber))
            _model.GSTNumber = _model.GSTNumber.ToUpper();
        if (!string.IsNullOrWhiteSpace(_model.GSTNumber) && Regex.IsMatch(_model.GSTNumber, @"^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$"))
            _errors.Remove("GSTNumber");
    }

    private void OnPANNumberChanged()
    {
        if (!string.IsNullOrEmpty(_model.PANNumber))
            _model.PANNumber = _model.PANNumber.ToUpper();
        if (!string.IsNullOrWhiteSpace(_model.PANNumber) && Regex.IsMatch(_model.PANNumber, @"^[A-Z]{5}[0-9]{4}[A-Z]{1}$"))
            _errors.Remove("PANNumber");
    }

    private void OnAadhaarNumberChanged()
    {
        if (!string.IsNullOrWhiteSpace(_model.AadhaarNumber) && Regex.IsMatch(_model.AadhaarNumber, @"^[0-9]{12}$"))
            _errors.Remove("AadhaarNumber");
    }

    private void OnFertilizerLicenseChanged()
    {
        if (!string.IsNullOrWhiteSpace(_model.WholeSaleFertilizerLicenseNumber) || !string.IsNullOrWhiteSpace(_model.RetailFertilizerLicenseNumber))
            _errors.Remove("FertilizerLicense");
    }

 private async Task OnPincodeChanged()
{
    _pincodeMessage = null;
    _pincodeSuccess = false;
    _errors.Remove("PinCode");

    // Strip non-digit characters
    if (!string.IsNullOrEmpty(_model.PinCode))
    {
        var digitsOnly = new string(_model.PinCode.Where(char.IsDigit).ToArray());
        if (digitsOnly != _model.PinCode)
            _model.PinCode = digitsOnly;
    }

    if (string.IsNullOrWhiteSpace(_model.PinCode) || _model.PinCode.Length != 6)
        return;

    _isPincodeLookup = true;
    StateHasChanged();

    try
    {
        // Call our own backend — no SSL/CORS/auth issues, no DefaultRequestHeaders juggling
        using var response = await Http.GetAsync($"api/PincodeLookup/{_model.PinCode}");

        if (!response.IsSuccessStatusCode)
        {
            var body = await response.Content.ReadAsStringAsync();
            _pincodeMessage = $"Lookup failed (HTTP {(int)response.StatusCode}): {body}";
            return;
        }

        var results = await response.Content.ReadFromJsonAsync<List<PincodeApiResponse>>();
        var result = results?.FirstOrDefault();

        if (result == null
            || !string.Equals(result.Status, "Success", StringComparison.OrdinalIgnoreCase)
            || result.PostOffice == null
            || result.PostOffice.Count == 0)
        {
            _pincodeMessage = $"No data found for pincode {_model.PinCode}";
            return;
        }

        var postOffice = result.PostOffice[0];

        var apiDistrict = postOffice.District?.Trim().Replace(" ", "") ?? "";
        var matchedDistrict = _DistrictAll.FirstOrDefault(d =>
            d.DistrictName.Trim().Replace(" ", "").Equals(apiDistrict, StringComparison.OrdinalIgnoreCase));
        if (matchedDistrict != null) _model.DistrictId = matchedDistrict.Id;

        var apiState = postOffice.State?.Trim().Replace(" ", "") ?? "";
        var matchedState = _statesAll.FirstOrDefault(s =>
            s.StateName.Trim().Replace(" ", "").Equals(apiState, StringComparison.OrdinalIgnoreCase));
        if (matchedState != null) _model.DealerStateId = matchedState.Id;

        if (!string.IsNullOrWhiteSpace(postOffice.Block) && postOffice.Block != "NA")
            _model.Block = postOffice.Block;
        if (!string.IsNullOrWhiteSpace(postOffice.Division)) _model.Taluk = postOffice.Division;
        if (!string.IsNullOrWhiteSpace(postOffice.Name))     _model.Village = postOffice.Name;

        _pincodeSuccess = true;
        _pincodeMessage = $"Auto-filled: {postOffice.District}, {postOffice.State}";
    }
    catch (HttpRequestException httpEx)
    {
        _pincodeMessage = $"Network error: {httpEx.Message}";
    }
    catch (TaskCanceledException)
    {
        _pincodeMessage = "Lookup timed out — try again.";
    }
    catch (Exception ex)
    {
        _pincodeMessage = $"{ex.GetType().Name}: {ex.Message}";
    }
    finally
    {
        _isPincodeLookup = false;
    }
}

