    private async Task OnGoogleMapUrlChanged()
    {
        _locationMessage = null;
        if (string.IsNullOrWhiteSpace(_model.GoogleMapURL))
        {
            _model.Latitude = null;
            _model.Longitude = null;
            return;
        }

        var url = _model.GoogleMapURL.Trim();

        if (url.Contains("goo.gl") || url.Contains("maps.app.goo.gl"))
        {
            _locationMessage = "Shortened URL detected. Please open the link in browser, copy the full URL from address bar, and paste it here.";
            _locationSuccess = false;
            return;
        }

        var match = Regex.Match(url, @"@(-?\d+\.\d+),(-?\d+\.\d+)");
        if (!match.Success) match = Regex.Match(url, @"[?&]q=(-?\d+\.\d+),(-?\d+\.\d+)");
        if (!match.Success) match = Regex.Match(url, @"[?&]ll=(-?\d+\.\d+),(-?\d+\.\d+)");
        if (!match.Success) match = Regex.Match(url, @"/dir//(-?\d+\.\d+),(-?\d+\.\d+)");
        if (!match.Success) match = Regex.Match(url, @"(-?\d+\.\d+),\s*(-?\d+\.\d+)");

        if (match.Success
            && double.TryParse(match.Groups[1].Value, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var lat)
            && double.TryParse(match.Groups[2].Value, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var lng))
        {
            _model.Latitude = lat;
            _model.Longitude = lng;
            _locationMessage = $"Coordinates extracted: {lat:F6}, {lng:F6}";
            _locationSuccess = true;
            await TriggerMapUpdate(lat, lng);
        }
        else
        {
            _model.Latitude = null;
            _model.Longitude = null;
            _locationMessage = "Could not extract coordinates from this URL. Try pasting the full Google Maps link.";
            _locationSuccess = false;
        }
    }

    private async Task UseCurrentLocation()
    {
        _isGettingLocation = true;
        _locationMessage = null;
        StateHasChanged();

        try
        {
            var result = await JS.InvokeAsync<GeoLocationResult>("getCurrentPosition");
            if (!string.IsNullOrEmpty(result.Error))
            {
                _locationMessage = $"Location error: {result.Error}";
                _locationSuccess = false;
            }
            else
            {
                _model.Latitude = result.Latitude;
                _model.Longitude = result.Longitude;
                _model.GoogleMapURL = $"http://maps.google.com/maps?q={result.Latitude.ToString(System.Globalization.CultureInfo.InvariantCulture)},{result.Longitude.ToString(System.Globalization.CultureInfo.InvariantCulture)}";
                _locationMessage = $"Location captured: {result.Latitude:F6}, {result.Longitude:F6}";
                _locationSuccess = true;
                await TriggerMapUpdate(result.Latitude, result.Longitude);
            }
        }
        catch (Exception ex)
        {
            _locationMessage = $"Failed to get location: {ex.Message}";
            _locationSuccess = false;
        }
        finally
        {
            _isGettingLocation = false;
            StateHasChanged();
        }
    }

    public static double CalculateDistanceKm(double lat1, double lng1, double lat2, double lng2)
    {
        const double R = 6371.0;
        var dLat = (lat2 - lat1) * Math.PI / 180.0;
        var dLng = (lng2 - lng1) * Math.PI / 180.0;
        var a = Math.Sin(dLat / 2) * Math.Sin(dLat / 2)
                + Math.Cos(lat1 * Math.PI / 180.0) * Math.Cos(lat2 * Math.PI / 180.0)
                * Math.Sin(dLng / 2) * Math.Sin(dLng / 2);
        return R * 2 * Math.Atan2(Math.Sqrt(a), Math.Sqrt(1 - a));
    }

