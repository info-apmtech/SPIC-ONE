    private void ApplyLockedEmployeeLocation()
    {
        if (LoginState.IsAdmin)
            return;

        if (LoginState.StateId > 0)
        {
            _basicInfoStateId = LoginState.StateId;

            _filteredRegions = _regionsAll
                .Where(r => r.StateId == _basicInfoStateId)
                .ToList();

            _filteredDealers = _dealersAll
                .Where(d => d.StateId == _basicInfoStateId)
                .ToList();
        }

        if (LoginState.RegionId > 0)
        {
            _basicInfoRegionId = LoginState.RegionId;

            _filteredHeadquarters = _headquartersAll
                .Where(h => h.RegionId == _basicInfoRegionId)
                .ToList();
        }

        if (LoginState.HQId > 0)
        {
            _basicInfoHqId = LoginState.HQId;
        }

        _isStateLocked = LoginState.StateId > 0;
        _isRegionLocked = LoginState.RegionId > 0;
        _isHqLocked = LoginState.HQId > 0;
    }

