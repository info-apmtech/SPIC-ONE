@page "/RoomDetails"

<div class="container-fluid py-4 px-0">
    <div class="rd-wrapper">
        
        <div class="rd-header">
            <h1>AC Deluxe Room</h1>
            <p>Luxury accommodation with modern amenities</p>
        </div>

        <div class="rd-main-img-wrap">
            <img src="_content/SPIC.MauiBlazorApp.Shared/Images/Rooms/ac_deluxe_main.png" alt="AC Deluxe Room Main View" onerror="this.style.backgroundColor='#cbd5e1';" />
            <button class="rd-btn-view-all">View All Medias</button>
        </div>

        <div class="rd-thumbnails-row">
            
            <div class="rd-thumb-item">
                <img src="_content/SPIC.MauiBlazorApp.Shared/Images/Rooms/ac_deluxe_thumb1.png" alt="Room View 1" onerror="this.style.backgroundColor='#e2e8f0';" />
            </div>

            <div class="rd-thumb-item">
                <img src="_content/SPIC.MauiBlazorApp.Shared/Images/Rooms/ac_deluxe_thumb2.png" alt="Room View 2" onerror="this.style.backgroundColor='#cbd5e1';" />
            </div>

            <div class="rd-thumb-item">
                <img src="_content/SPIC.MauiBlazorApp.Shared/Images/Rooms/ac_deluxe_thumb3.png" alt="Balcony View" onerror="this.style.backgroundColor='#e2e8f0';" />
            </div>

            <div class="rd-thumb-item">
                <img src="_content/SPIC.MauiBlazorApp.Shared/Images/Rooms/ac_deluxe_thumb4.png" alt="Lounge Area" onerror="this.style.backgroundColor='#cbd5e1';" />
            </div>

            <div class="rd-video-thumb-item">
                <div class="rd-video-player-area">
                    <div class="rd-play-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg>
                    </div>
                    <div class="rd-video-duration">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                        3:15
                    </div>
                </div>
                <div class="rd-video-label">
                    Room Walkthrough
                </div>
            </div>

        </div>

        <div class="rd-info-section">
            
            <div class="rd-info-card">
                <h3 class="rd-card-title">Room Information</h3>
                
                <div class="rd-stats-grid">
                    <div class="rd-stat-item">
                        <div class="rd-stat-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="15 3 21 3 21 9"></polyline>
                                <polyline points="9 21 3 21 3 15"></polyline>
                                <line x1="21" y1="3" x2="14" y2="10"></line>
                                <line x1="3" y1="21" x2="10" y2="14"></line>
                            </svg>
                        </div>
                        <div class="rd-stat-text">
                            <span class="rd-stat-label">Room Size</span>
                            <span class="rd-stat-value">280 sq ft</span>
                        </div>
                    </div>

                    <div class="rd-stat-item">
                        <div class="rd-stat-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M2 4v16"></path>
                                <path d="M2 8h18a2 2 0 0 1 2 2v10"></path>
                                <path d="M2 17h20"></path>
                                <path d="M6 8v9"></path>
                            </svg>
                        </div>
                        <div class="rd-stat-text">
                            <span class="rd-stat-label">Bed Type</span>
                            <span class="rd-stat-value">Queen Bed</span>
                        </div>
                    </div>

                    <div class="rd-stat-item">
                        <div class="rd-stat-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                <circle cx="9" cy="7" r="4"></circle>
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                            </svg>
                        </div>
                        <div class="rd-stat-text">
                            <span class="rd-stat-label">Max Occupancy</span>
                            <span class="rd-stat-value">2 Adults</span>
                        </div>
                    </div>
                </div>

                <div class="rd-extra-cot-banner">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M2 4v16"></path>
                        <path d="M2 8h18a2 2 0 0 1 2 2v10"></path>
                        <path d="M2 17h20"></path>
                        <path d="M6 8v9"></path>
                    </svg>
                    <div class="rd-stat-text">
                        <span class="rd-stat-label">Extra Cot Available</span>
                        <span class="rd-stat-value">Maximum 3 guests can get extra cot (payable)</span>
                    </div>
                </div>
            </div>

            <div class="rd-info-card">
                <h3 class="rd-card-title">Amenities</h3>
                
                <div class="rd-amenities-grid">
                    <div class="rd-amenity-pill">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 2v20"></path><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                        AC
                    </div>
                    <div class="rd-amenity-pill">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M5 12.55a11 11 0 0 1 14.08 0"></path><path d="M1.42 9a16 16 0 0 1 21.16 0"></path><path d="M8.53 16.11a6 6 0 0 1 6.95 0"></path><line x1="12" y1="20" x2="12.01" y2="20"></line></svg>
                        WiFi
                    </div>
                    <div class="rd-amenity-pill">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="2" y="7" width="20" height="15" rx="2" ry="2"></rect><polyline points="17 2 12 7 7 2"></polyline></svg>
                        TV
                    </div>
                    <div class="rd-amenity-pill">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 2v20"></path><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                        Hot Water
                    </div>
                    <div class="rd-amenity-pill">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M18 8h1a4 4 0 0 1 0 8h-1"></path><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"></path><line x1="6" y1="1" x2="6" y2="4"></line><line x1="10" y1="1" x2="10" y2="4"></line><line x1="14" y1="1" x2="14" y2="4"></line></svg>
                        Breakfast
                    </div>
                    <div class="rd-amenity-pill">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                        Parking
                    </div>
                    <div class="rd-amenity-pill">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="8" y="2" width="8" height="20" rx="1" ry="1"></rect><line x1="18" y1="4" x2="22" y2="4"></line><line x1="18" y1="8" x2="22" y2="8"></line><line x1="18" y1="12" x2="22" y2="12"></line><line x1="2" y1="12" x2="6" y2="12"></line></svg>
                        Power Backup
                    </div>
                    <div class="rd-amenity-pill">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M6 2v20"></path><path d="M18 2v20"></path><path d="M6 12h12"></path><path d="M6 7h12"></path><path d="M6 17h12"></path></svg>
                        Drinking Water
                    </div>
                    <div class="rd-amenity-pill">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 21H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2z"></path><path d="M8 21v-8"></path><path d="M16 21v-8"></path><path d="M2 9h20"></path></svg>
                        Mini Fridge
                    </div>
                </div>
            </div>

        </div>

    </div>
</div>