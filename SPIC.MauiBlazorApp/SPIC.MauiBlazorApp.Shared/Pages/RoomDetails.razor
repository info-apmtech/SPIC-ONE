@page "/RoomDetails"

<div class="container-fluid py-4 px-0">
    <div class="rd-wrapper">
        
        <div class="rd-header">
            <h1>AC Deluxe Room</h1>
            <p>Luxury accommodation with modern amenities</p>
        </div>

        <div class="rd-main-img-wrap">
            <img src="_content/SPIC.MauiBlazorApp.Shared/Images/Gallery/image12.png" alt="AC Deluxe Room Main View" onerror="this.style.backgroundColor='#cbd5e1';" />
            <button class="rd-btn-view-all">View All Medias</button>
        </div>

        <div class="rd-thumbnails-row">
            
            <div class="rd-thumb-item">
                <img src="_content/SPIC.MauiBlazorApp.Shared/Images/Gallery/image15.png" alt="Room View 1" onerror="this.style.backgroundColor='#e2e8f0';" />
            </div>

            <div class="rd-thumb-item">
                <img src="_content/SPIC.MauiBlazorApp.Shared/Images/Gallery/image16.png" alt="Room View 2" onerror="this.style.backgroundColor='#cbd5e1';" />
            </div>

            <div class="rd-thumb-item">
                <img src="_content/SPIC.MauiBlazorApp.Shared/Images/Gallery/image17.png" alt="Balcony View" onerror="this.style.backgroundColor='#e2e8f0';" />
            </div>

            <div class="rd-thumb-item">
                <img src="_content/SPIC.MauiBlazorApp.Shared/Images/Gallery/image18.png" alt="Lounge Area" onerror="this.style.backgroundColor='#cbd5e1';" />
            </div>

            <div class="rd-video-thumb-item">
                <div class="rd-video-player-area">
                    <div class="rd-play-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg>
                    </div>
                    <div class="rd-video-duration">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                        3:15
                    </div>
                </div>
                <div class="rd-video-label">
                    Room Walkthrough
                </div>
            </div>

        </div>

        <div class="rd-info-section">
            
            <div class="rd-info-card">
                <h3 class="rd-card-title">Room Information</h3>
                
                <div class="rd-stats-grid">
                    <div class="rd-stat-item">
                        <div class="rd-stat-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="15 3 21 3 21 9"></polyline>
                                <polyline points="9 21 3 21 3 15"></polyline>
                                <line x1="21" y1="3" x2="14" y2="10"></line>
                                <line x1="3" y1="21" x2="10" y2="14"></line>
                            </svg>
                        </div>
                        <div class="rd-stat-text">
                            <span class="rd-stat-label">Room Size</span>
                            <span class="rd-stat-value">280 sq ft</span>
                        </div>
                    </div>

                    <div class="rd-stat-item">
                        <div class="rd-stat-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M2 4v16"></path>
                                <path d="M2 8h18a2 2 0 0 1 2 2v10"></path>
                                <path d="M2 17h20"></path>
                                <path d="M6 8v9"></path>
                            </svg>
                        </div>
                        <div class="rd-stat-text">
                            <span class="rd-stat-label">Bed Type</span>
                            <span class="rd-stat-value">Queen Bed</span>
                        </div>
                    </div>

                    <div class="rd-stat-item">
                        <div class="rd-stat-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                <circle cx="9" cy="7" r="4"></circle>
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                            </svg>
                        </div>
                        <div class="rd-stat-text">
                            <span class="rd-stat-label">Max Occupancy</span>
                            <span class="rd-stat-value">2 Adults</span>
                        </div>
                    </div>
                </div>

                <div class="rd-extra-cot-banner">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M2 4v16"></path>
                        <path d="M2 8h18a2 2 0 0 1 2 2v10"></path>
                        <path d="M2 17h20"></path>
                        <path d="M6 8v9"></path>
                    </svg>
                    <div class="rd-stat-text">
                        <span class="rd-stat-label">Extra Cot Available</span>
                        <span class="rd-stat-value">Maximum 3 guests can get extra cot (payable)</span>
                    </div>
                </div>
            </div>

            <div class="rd-info-card">
                <h3 class="rd-card-title">Amenities</h3>
                
                <div class="rd-amenities-grid">
                    <div class="rd-amenity-pill">
                        <img src="_content/SPIC.MauiBlazorApp.Shared/Images/Gallery/AC.png" />
                        AC
                    </div>
                    <div class="rd-amenity-pill">
                        <img src="_content/SPIC.MauiBlazorApp.Shared/Images/Gallery/Wifi.png"  />
                        WiFi
                    </div>
                    <div class="rd-amenity-pill">
                        <img src="_content/SPIC.MauiBlazorApp.Shared/Images/Gallery/TV.png" />
                        TV
                    </div>
                    <div class="rd-amenity-pill">
                        <img src="_content/SPIC.MauiBlazorApp.Shared/Images/Gallery/HotWater.png" />
                        Hot Water
                    </div>
                    <div class="rd-amenity-pill">
                        <img src="_content/SPIC.MauiBlazorApp.Shared/Images/Gallery/Breakfast.png" />
                        Breakfast
                    </div>
                    <div class="rd-amenity-pill">
                        <img src="_content/SPIC.MauiBlazorApp.Shared/Images/Gallery/Parking.png" />
                        Parking
                    </div>
                    <div class="rd-amenity-pill">
                        <img src="_content/SPIC.MauiBlazorApp.Shared/Images/Gallery/PowerBackup.png" />
                        Power Backup
                    </div>
                    <div class="rd-amenity-pill">
                        <img src="_content/SPIC.MauiBlazorApp.Shared/Images/Gallery/DrinkingWater.png" />
                        Drinking Water
                    </div>
                    <div class="rd-amenity-pill">
                        <img src="_content/SPIC.MauiBlazorApp.Shared/Images/Gallery/MiniFridge.png" />
                        Mini Fridge
                    </div>
                </div>
            </div>

        </div>

        <div class="rd-house-rules">
            <h3 class="rd-card-title">House Rules</h3>
            <ul>
                <li>Valid ID proof mandatory at check-in (Aadhaar/Passport)</li>
                <li>Smoking strictly prohibited</li>
                <li>Visitors allowed only in common areas</li>
            </ul>
        </div>

        <div class="rd-bottom-grid">
            
            <div class="rd-info-card">
                <h3 class="rd-card-title">Additional Services</h3>
                
                <div class="rd-service-item">
                    <div class="rd-service-info">
                        <span class="rd-service-name">Extra Bed</span>
                        <span class="rd-service-price">₹250 per night</span>
                    </div>
                    <div class="rd-counter">
                        <button class="rd-btn-count rd-btn-minus">-</button>
                        <span class="rd-counter-value">2</span>
                        <button class="rd-btn-count rd-btn-plus">+</button>
                    </div>
                </div>
            </div>

            <div class="rd-info-card">
                <h3 class="rd-card-title">Booking Summary</h3>
                
                <div class="rd-summary-list">
                    <div class="rd-summary-row">
                        <span>Room Price</span>
                        <span>₹999</span>
                    </div>
                    <div class="rd-summary-row">
                        <span>Extra Cot × 1</span>
                        <span>₹250</span>
                    </div>
                    <div class="rd-summary-row">
                        <span>Taxes (12%)</span>
                        <span>₹120</span>
                    </div>
                </div>
                
                <div class="rd-summary-divider"></div>
                
                <div class="rd-summary-total">
                    <span>Total</span>
                    <span>₹1279</span>
                </div>
            </div>

        </div>

    </div>
</div>