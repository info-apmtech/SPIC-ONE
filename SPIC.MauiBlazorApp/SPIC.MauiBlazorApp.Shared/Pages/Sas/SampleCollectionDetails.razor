    private RenderFragment FarmerTimeline(SampleCollectionDetailDto d) => __builder =>
    {
        var steps = FarmerSteps(d);
        <section class="scd-card scd-timeline">
            <h2 class="scd-card-title">Sample Journey</h2>
            <ol class="scd-ftl" aria-label="Sample journey">
                @for (var i = 0; i < steps.Count; i++)
                {
                    var st = steps[i];
                    <li class="scd-ftl-step @(st.Done ? "is-done" : "") @(st.Current ? "is-current" : "")">
                        <div class="scd-ftl-rail" aria-hidden="true">
                            <span class="scd-ftl-dot"><i class="bi @(st.Done ? "bi-check-lg" : st.Icon)"></i></span>
                            @if (i < steps.Count - 1)
                            {
                                <span class="scd-ftl-line @(steps[i + 1].Done ? "is-done" : "")"></span>
                            }
                        </div>
                        <div class="scd-ftl-body">
                            <span class="scd-ftl-title">@st.Title</span>
                            @if (st.Done && st.At is { } at)
                            {
                                <span class="scd-ftl-when">@at.ToString("dd MMM yyyy, hh:mm tt")</span>
                            }
                            else if (st.Done)
                            {
                                <span class="scd-ftl-when">Completed</span>
                            }
                            else if (st.Current)
                            {
                                <span class="scd-ftl-when scd-ftl-now">@(st.Title == "Under Lab Analysis" ? "In progress" : "Next step")</span>
                            }
                            else
                            {
                                <span class="scd-ftl-when scd-ftl-pending">Pending</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(st.Note) && (st.Done || st.Current))
                            {
                                <span class="scd-ftl-note">@st.Note</span>
                            }
                            @if (st.Done && !string.IsNullOrWhiteSpace(st.By))
                            {
                                <span class="scd-ftl-by">by @st.By</span>
                            }
                        </div>
                    </li>
                }
            </ol>
        </section>
    };

    // ------------------------------------------------------------------ payment review

    private void OpenProof() => _proofOpen = true;

    private void CloseProof() => _proofOpen = false;

    private async Task ApprovePaymentAsync()
    {
        if (Detail?.Payment is not { } payment) return;
        if (!await Toast.ConfirmAsync("Approve payment",
                $"Approve {SasLabels.Money(payment.Amount)} against {Detail.Code}? The collection then becomes ready for consignment.",
                "Approve")) return;

        await ReviewAsync(payment.Id, SamplePaymentStatus.Approved, null, "Payment approved.");
    }

    private async Task RejectPaymentAsync()
    {
        if (Detail?.Payment is not { } payment) return;
        if (string.IsNullOrWhiteSpace(_rejectReason))
        {
            Toast.Warning("Add a reason so the collector knows what to correct.");
            return;
        }

        await ReviewAsync(payment.Id, SamplePaymentStatus.Rejected, _rejectReason.Trim(),
            "Payment rejected and sent back.");
    }

    private async Task ReviewAsync(int paymentId, SamplePaymentStatus status, string? reason, string success)
    {
        _reviewing = true;
        try
        {
            var refreshed = await Api.ReviewPaymentAsync(paymentId, Id, status, reason);
            if (refreshed is null) return;   // SasApi already raised the toast

            Detail = refreshed;
            _rejecting = false;
            _rejectReason = "";
            Toast.Success(success);
        }
        finally
        {
            _reviewing = false;
        }
    }

    // ------------------------------------------------------------------ lab results

    private async Task SaveResultsAsync(List<LabResultUpsertDto> rows)
    {
        if (SelectedItem is not { } item) return;

        var saved = await Api.SaveResultsAsync(item.Id, rows);
        if (saved is null) return;           // SasApi already raised the toast

        // The API may have moved the collection to TestInProgress or Completed, so re-read it:
        // that refreshes the status pill, the timeline and every sample's results at once.
        var (refreshed, _) = await Api.GetCollectionAsync(Id);
        if (refreshed is not null) Detail = refreshed;
        else item.Results = saved;

        Toast.Success($"Results saved for {item.Code}.");
    }

    // ------------------------------------------------------------------ export

    /// <summary>
    /// "Export" (printer): hands a self-contained page to <c>openPrintableHtml</c>. On the Web
    /// host that opens a print window; the MAUI host bridges the same JS name to the system
    /// browser (a WebView cannot open a popup, so <c>window.print()</c> alone is not enough).
    /// </summary>
    private async Task ExportPrint()
    {
        if (Detail is not { } d) return;

        var sb = new StringBuilder();
        sb.Append("<html><head><meta charset=\"utf-8\"><title>").Append(Esc(d.Code)).Append("</title><style>")
          .Append("body{font-family:Arial,Helvetica,sans-serif;color:#1f2937;margin:24px;}")
          .Append("h1{font-size:20px;margin:0 0 4px;}h2{font-size:15px;margin:22px 0 8px;color:#0b6b3a;}")
          .Append(".meta{color:#6b7684;font-size:12px;margin-bottom:16px;}")
          .Append("table{border-collapse:collapse;width:100%;margin-bottom:12px;font-size:12px;}")
          .Append("th,td{border:1px solid #d7dee7;padding:6px 8px;text-align:left;}")
          .Append("th{background:#f6f8fa;}")
          .Append("</style></head><body>");

        sb.Append("<h1>Sample Collection Details</h1>")
          .Append("<div class=\"meta\">").Append(Esc($"# {d.Code}")).Append(" &middot; ")
          .Append(Esc(d.PaymentType == SamplePaymentType.Paid ? "Paid Sample" : "Free Sample")).Append(" &middot; ")
          .Append(Esc(SasLabels.Status(d.Status))).Append(" &middot; ").Append(Esc(HeadlineWhen)).Append("</div>");

        sb.Append("<h2>Collection Information</h2><table>");
        AppendPair(sb, "Consignment ID", d.ConsignmentCode);
        AppendPair(sb, "Transaction ID", d.Payment?.TransactionId);
        AppendPair(sb, "Courier Partner", d.Consignment?.CourierService);
        AppendPair(sb, "AWB / Tracking No", d.Consignment?.TrackingNumber);
        AppendPair(sb, "Packaging Type", _consignment?.PackagingType);
        AppendPair(sb, "Collection Type", CollectionTypeText);
        AppendPair(sb, "Collected By", d.CollectedByName);
        AppendPair(sb, "Samples", d.SampleTypes);
        AppendPair(sb, "No. of Tests", TotalTests.ToString());
        AppendPair(sb, "Total Amount", SasLabels.Money(d.TotalAmount));
        AppendPair(sb, "Remarks", d.Remarks);
        sb.Append("</table>");

        sb.Append("<h2>Sample Summary</h2><table><tr><th>S.NO</th><th>Sample type</th><th>No. of Samples</th><th>No. of Tests</th></tr>");
        var index = 0;
        foreach (var g in SampleGroups)
        {
            index++;
            sb.Append("<tr><td>").Append(index).Append("</td><td>").Append(Esc(g.Label))
              .Append("</td><td>").Append(g.Samples).Append("</td><td>").Append(g.Tests).Append("</td></tr>");
        }
        sb.Append("<tr><th colspan=\"2\">Total</th><th>").Append(SampleGroups.Sum(g => g.Samples))
          .Append("</th><th>").Append(SampleGroups.Sum(g => g.Tests)).Append("</th></tr></table>");

        foreach (var item in d.Items)
        {
            sb.Append("<h2>Result Comparison - ").Append(Esc(item.Code)).Append(" (")
              .Append(Esc(item.Farmer.Name)).Append(", ").Append(Esc(SasLabels.SampleTypeName(item.SampleType))).Append(")</h2>");

            if (item.Results.Count == 0)
            {
                sb.Append("<p>Awaiting lab results.</p>");
                continue;
            }

            sb.Append("<table><tr><th>Test Parameter</th><th>Normal Range</th><th>Entered Value</th><th>Unit</th><th>Result</th><th>Status</th><th>Recommendation Hint</th></tr>");
            foreach (var r in item.Results.OrderBy(r => r.SortOrder))
            {
                sb.Append("<tr><td>").Append(Esc(r.Parameter))
                  .Append("</td><td>").Append(Esc(r.NormalRange))
                  .Append("</td><td>").Append(Esc(r.EnteredValue))
                  .Append("</td><td>").Append(Esc(r.Unit))
                  .Append("</td><td>").Append(Esc(r.ResultLabel))
                  .Append("</td><td>").Append(Esc(r.Status.ToString()))
                  .Append("</td><td>").Append(Esc(r.Hint))
                  .Append("</td></tr>");
            }
            sb.Append("</table>");
        }

        sb.Append("<h2>History / Timeline</h2><table><tr><th>Status</th><th>Date</th><th>By</th></tr>");
        foreach (var ev in d.Timeline.OrderBy(e => e.At))
        {
            sb.Append("<tr><td>").Append(Esc(ev.Status))
              .Append("</td><td>").Append(Esc(SasLabels.DateTimeText(ev.At)))
              .Append("</td><td>").Append(Esc(ev.ByName)).Append("</td></tr>");
        }
        sb.Append("</table></body></html>");

        try
        {
            await JS.InvokeVoidAsync("openPrintableHtml", sb.ToString());
        }
        catch (Exception)
        {
            Toast.Error("The print view could not be opened on this device.");
        }
    }

    /// <summary>
    /// "Export" (download): the result table of the selected sample as a PDF, through the shared
    /// api/Export/table-pdf endpoint (QuestPDF runs on the server; it cannot ship inside the
    /// Android app). Falls back to a message when there is nothing to export yet.
    /// </summary>
    private async Task ExportPdf()
    {
        if (Detail is not { } d || SelectedItem is not { } item) return;

        if (item.Results.Count == 0)
        {
            Toast.Info("There are no lab results to export yet. Use the print export for the collection summary.");
            return;
        }

        var request = new
        {
            Title = $"Result Comparison - {item.Code}",
            Headers = new List<string> { "Test Parameter", "Normal Range", "Entered Value", "Unit", "Result", "Status", "Recommendation Hint" },
            Rows = item.Results.OrderBy(r => r.SortOrder).Select(r => new List<string>
            {
                r.Parameter,
                r.NormalRange ?? "",
                r.EnteredValue ?? "",
                r.Unit ?? "",
                r.ResultLabel ?? "",
                r.Status.ToString(),
                r.Hint ?? ""
            }).ToList()
        };

        _exporting = true;
        try
        {
            await Downloads.PostAsync("api/Export/table-pdf", request, $"{d.Code}_{item.Code}_{DateTime.Now:yyyyMMdd}.pdf");
        }
        catch (Exception)
        {
            Toast.Error("The PDF export failed. Try the print export instead.");
        }
        finally
        {
            _exporting = false;
        }
    }

    private static void AppendPair(StringBuilder sb, string label, string? value) =>
        sb.Append("<tr><th>").Append(Esc(label)).Append("</th><td>")
          .Append(string.IsNullOrWhiteSpace(value) ? "-" : Esc(value)).Append("</td></tr>");

    private static string Esc(string? value) =>
        string.IsNullOrEmpty(value)
            ? ""
            : value.Replace("&", "&amp;").Replace("<", "&lt;").Replace(">", "&gt;").Replace("\"", "&quot;");
}
