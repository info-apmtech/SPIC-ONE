@page "/SampleCollection/view/{Id:int}"
@using System.Text
@using SPIC.Core.DTOs
@using SPIC.Core.Entities
@using SPIC.MauiBlazorApp.Shared.Components.Sas
@using SPIC.MauiBlazorApp.Shared.Pages.Sas.Farmer
@inject SasApi Api
@inject NavigationManager Nav
@inject ToastService Toast
@inject FileDownloadService Downloads
@inject IJSRuntime JS
@inject LoginState Login
@inject LabApi Lab
@inject SasPaymentApi PayApi

@*
    Sample Collection Details (Figma frame 14). One page for every role:

      * everyone with the page sees the chips, the summary strip, Collection Information,
        Sample Summary, Result Comparison, Consignment Details, Amount Details and the timeline;
      * write roles get the contextual button for the status they are looking at
        (Draft -> Edit, PendingPayment -> Record payment, ReadyForConsignment -> Upload consignment);
      * review roles (CanReview: Admin / CorporateAdmin) approve or reject the payment here and
        enter the lab results inline;
      * Dealer and Farmer see exactly the same page with no buttons - the server decides,
        through CanEdit / CanPay / CanConsign / CanReview on the DTO.

    Before results exist the Result Comparison card reads "Awaiting lab results" plus the status.
    A collection with several samples gets a selector above the result table.

    Farmer view (SAS Lab portal v2, screen 32; LoginState.UserRole == Farmer only): header pills
    (lab status / Paid or Free Sample / Report: Ready or Not Ready), Sample / Farmer / Payment
    Details cards, Payment Proof Preview and a farmer-worded timeline replace the staff sections;
    the Result Comparison table stays shared. Only the farmer's own samples are listed
    (SasFarmer.UserId), ?sample={itemId} preselects one (links from My Samples), and the
    farmer's report (api/Lab/reports, farmer-scoped) drives the report pill, the last timeline
    step and the Download PDF button. Payment fields added by the Payments workstream
    (PaymentMode, TransactionDate, FinanceStatus) are read by name so the page works with and
    without them.
*@

<PageHeader Title="Sample Collection Details" BackHref="@(IsFarmer ? "/Sas/MySamples" : "/SampleCollection")">
    <Actions>
        @if (Detail is not null)
        {
            @if (IsFarmer)
            {
                var headerReports = SelectedReports;
                @foreach (var headerReport in headerReports)
                {
                    <ReportDownloadButton ReportId="headerReport.Id" Languages="_languages"
                                          Label="@FarmerSamples.ReportLabel(headerReport, headerReports.Count)" />
                }
            }
            @if (Detail.Status == SampleCollectionStatus.Draft && Detail.CanEdit)
            {
                <button type="button" class="scd-btn scd-btn-primary" @onclick="@(() => Nav.NavigateTo($"/SampleCollection/new?id={Detail!.Id}"))">
                    <i class="bi bi-pencil" aria-hidden="true"></i> Edit
                </button>
            }
            @if (Detail.Status == SampleCollectionStatus.PendingPayment && Detail.CanPay)
            {
                <button type="button" class="scd-btn scd-btn-primary" @onclick="@(() => Nav.NavigateTo($"/SampleCollection/payment/{Detail!.Id}"))">
                    <i class="bi bi-credit-card" aria-hidden="true"></i> Record payment
                </button>
            }
            @if (Detail.Status == SampleCollectionStatus.ReadyForConsignment && Detail.CanConsign)
            {
                <button type="button" class="scd-btn scd-btn-primary" @onclick="@(() => Nav.NavigateTo($"/SampleCollection/consignment/{Detail!.Id}"))">
                    <i class="bi bi-box-seam" aria-hidden="true"></i> Upload consignment
                </button>
            }
            <button type="button" class="scd-btn scd-btn-outline" @onclick="ExportPrint">
                <i class="bi bi-printer" aria-hidden="true"></i> Export
            </button>
            <button type="button" class="scd-btn scd-btn-outline" @onclick="ExportPdf" disabled="@_exporting">
                <i class="bi bi-download" aria-hidden="true"></i> Export
            </button>
        }
    </Actions>
</PageHeader>

@if (_loading)
{
    <div class="scd-page">
        <Skeleton Variant="card" Rows="3" />
    </div>
}
else if (Detail is null)
{
    <EmptyState Icon="bi-droplet-half"
                Title="@(_notFound ? "Collection not found" : "The collection could not be loaded")"
                Message="@(_notFound ? "This sample collection is not available any more, or you do not have access to it." : "Check the connection and try again.")">
        <button type="button" class="scd-btn scd-btn-outline" @onclick="LoadAsync">Try again</button>
        <button type="button" class="scd-btn scd-btn-primary" @onclick="@(() => Nav.NavigateTo("/SampleCollection"))">Back to Sample Collection</button>
    </EmptyState>
}
else
{
    var d = Detail;

    <div class="scd-page">

        @if (IsFarmer)
        {
            @FarmerView(d)
        }
        else
        {
        @* --------------------------------------------------------- chips *@
        <div class="scd-chips">
            <span class="scd-chip scd-chip-code"># @d.Code</span>
            <span class="scd-chip scd-chip-type">@(d.PaymentType == SamplePaymentType.Paid ? "Paid Sample" : "Free Sample")</span>
            <span class="@SasLabels.StatusPillClass(d.Status)">@SasLabels.Status(d.Status)</span>
            <span class="scd-chip-when">@HeadlineWhen</span>
        </div>

        @* --------------------------------------------------------- summary strip *@
        <section class="scd-strip" aria-label="Collection summary">
            <div class="scd-strip-cell">
                <span class="scd-strip-label">Consignment ID</span>
                @if (d.ConsignmentId is { } consignmentId && !string.IsNullOrWhiteSpace(d.ConsignmentCode))
                {
                    <a class="scd-strip-value scd-link" href="@($"/ConsignmentHistory/view/{consignmentId}")">@d.ConsignmentCode</a>
                }
                else
                {
                    <span class="scd-strip-value">-</span>
                }
            </div>
            <div class="scd-strip-cell">
                <span class="scd-strip-label">Transaction ID</span>
                <span class="scd-strip-value">@Dash(d.Payment?.TransactionId)</span>
            </div>
            <div class="scd-strip-cell">
                <span class="scd-strip-label">Courier Partner</span>
                <span class="scd-strip-value">@Dash(d.Consignment?.CourierService)</span>
            </div>
            <div class="scd-strip-cell">
                <span class="scd-strip-label">Samples</span>
                <span class="scd-strip-value">@Dash(d.SampleTypes)</span>
            </div>
            <div class="scd-strip-cell">
                <span class="scd-strip-label">No. of Tests</span>
                <span class="scd-strip-value">@TotalTests</span>
            </div>
            <div class="scd-strip-cell">
                <span class="scd-strip-label">Payment Status</span>
                <span class="@PaymentPillClass">@PaymentPillText</span>
                <span class="scd-strip-sub">@SasLabels.StatusHint(d.Status)</span>
            </div>
        </section>

        @* --------------------------------------------------------- info + sample summary *@
        <div class="scd-row">
            <section class="scd-card scd-info">
                <h2 class="scd-card-title">Collection Information</h2>
                <div class="scd-defs">
                    <dl>
                        <div><dt>Packaging Type</dt><dd>@Dash(_consignment?.PackagingType)</dd></div>
                        <div><dt>Courier Partner</dt><dd>@Dash(d.Consignment?.CourierService)</dd></div>
                        <div>
                            <dt>AWB / Tracking No</dt>
                            <dd>
                                @if (!string.IsNullOrWhiteSpace(d.Consignment?.TrackingNumber))
                                {
                                    @if (!string.IsNullOrWhiteSpace(d.Consignment.TrackingLink))
                                    {
                                        <a class="scd-link" href="@d.Consignment.TrackingLink" target="_blank" rel="noopener">@d.Consignment.TrackingNumber</a>
                                    }
                                    else
                                    {
                                        <span class="scd-link-plain">@d.Consignment.TrackingNumber</span>
                                    }
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </dd>
                        </div>
                        <div><dt>Collection Type</dt><dd>@CollectionTypeText</dd></div>
                        <div>
                            <dt>Collected By</dt>
                            <dd>
                                @Dash(d.CollectedByName)
                                @if (!string.IsNullOrWhiteSpace(d.CollectedByRole))
                                {
                                    <span class="scd-sub">(@d.CollectedByRole)</span>
                                }
                            </dd>
                        </div>
                        <div><dt>Collection Notes</dt><dd>@Dash(_consignment?.Notes)</dd></div>
                    </dl>
                    <dl>
                        <div><dt>Contact Person</dt><dd>@Dash(_consignment?.ContactPerson)</dd></div>
                        <div>
                            <dt>Mobile</dt>
                            <dd>
                                @if (!string.IsNullOrWhiteSpace(_consignment?.ContactMobile))
                                {
                                    <a class="scd-link" href="@($"tel:{_consignment!.ContactMobile}")">@_consignment!.ContactMobile</a>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </dd>
                        </div>
                        <div>
                            <dt>Email</dt>
                            <dd>
                                @if (!string.IsNullOrWhiteSpace(_consignment?.ContactEmail))
                                {
                                    <a class="scd-link" href="@($"mailto:{_consignment!.ContactEmail}")">@_consignment!.ContactEmail</a>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </dd>
                        </div>
                        <div><dt>Dispatched By</dt><dd>@Dash(d.Consignment?.DispatchedByName)</dd></div>
                        <div><dt>Expected Delivery Date</dt><dd>@Dash(_consignment?.ExpectedDeliveryDate is { } ed ? SasLabels.LongDate(ed) : null)</dd></div>
                        <div><dt>Remarks</dt><dd>@Dash(d.Remarks)</dd></div>
                    </dl>
                </div>
            </section>

            <section class="scd-card scd-summary">
                <h2 class="scd-card-title">Sample Summary</h2>

                <div class="scd-table-wrap tablet-up">
                    <table class="scd-table">
                        <thead>
                            <tr>
                                <th scope="col">S.NO</th>
                                <th scope="col">Sample type</th>
                                <th scope="col">No. of Samples</th>
                                <th scope="col">No. of Tests</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var n = 0;
                            }
                            @foreach (var g in SampleGroups)
                            {
                                n++;
                                <tr>
                                    <td>@n</td>
                                    <th scope="row">@g.Label</th>
                                    <td>@g.Samples</td>
                                    <td>@g.Tests</td>
                                </tr>
                            }
                            <tr class="scd-total-row">
                                <td colspan="2">Total</td>
                                <td>@SampleGroups.Sum(g => g.Samples)</td>
                                <td>@SampleGroups.Sum(g => g.Tests)</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="scd-mini-cards phone-only">
                    @foreach (var g in SampleGroups)
                    {
                        <div class="scd-mini-card">
                            <span class="scd-mini-title">@g.Label</span>
                            <span class="scd-mini-line">@g.Samples sample@(g.Samples == 1 ? "" : "s") &middot; @g.Tests test@(g.Tests == 1 ? "" : "s")</span>
                        </div>
                    }
                    <div class="scd-mini-card scd-mini-card--total">
                        <span class="scd-mini-title">Total</span>
                        <span class="scd-mini-line">@SampleGroups.Sum(g => g.Samples) samples &middot; @SampleGroups.Sum(g => g.Tests) tests</span>
                    </div>
                </div>
            </section>
        </div>
        }

        @* --------------------------------------------------------- payment review *@
        @if (ShowPaymentReview)
        {
            var p = d.Payment!;
            <section class="scd-card scd-review">
                <h2 class="scd-card-title">Payment Approval</h2>
                <p class="scd-review-note">This payment is waiting for your decision. Check the proof against the transaction details.</p>

                <div class="scd-review-body">
                    <dl class="scd-review-defs">
                        <div><dt>Amount</dt><dd class="scd-strong">@SasLabels.Money(p.Amount)</dd></div>
                        <div><dt>Paid By</dt><dd>@Dash(p.PaidByName)</dd></div>
                        <div><dt>Transaction ID</dt><dd>@Dash(p.TransactionId)</dd></div>
                        <div><dt>UTR Number</dt><dd>@Dash(p.UtrNumber)</dd></div>
                        <div><dt>Bank / Gateway</dt><dd>@Dash(p.BankGateway)</dd></div>
                        <div><dt>Contact</dt><dd>@Dash(p.ContactNumber)</dd></div>
                        <div><dt>Email</dt><dd>@Dash(p.Email)</dd></div>
                        <div><dt>Recorded</dt><dd>@SasLabels.DateTimeText(p.CreatedAt)</dd></div>
                    </dl>

                    @if (!string.IsNullOrWhiteSpace(p.ProofPath))
                    {
                        <button type="button" class="scd-proof" @onclick="OpenProof" aria-label="Open the payment proof">
                            <img src="@Api.FileUrl(p.ProofPath)" alt="Payment proof" loading="lazy" />
                            <span class="scd-proof-cap"><i class="bi bi-zoom-in" aria-hidden="true"></i> View proof</span>
                        </button>
                    }
                    else
                    {
                        <div class="scd-proof scd-proof--none"><i class="bi bi-image" aria-hidden="true"></i> No proof uploaded</div>
                    }
                </div>

                @if (_rejecting)
                {
                    <div class="scd-reject">
                        <label for="scd-reject-reason">Reason for rejection</label>
                        <textarea id="scd-reject-reason" class="scd-textarea" rows="2"
                                  placeholder="Tell the collector what to correct"
                                  @bind="_rejectReason" @bind:event="oninput"></textarea>
                        <div class="scd-review-actions">
                            <button type="button" class="scd-btn scd-btn-ghost" @onclick="() => _rejecting = false" disabled="@_reviewing">Cancel</button>
                            <button type="button" class="scd-btn scd-btn-danger" @onclick="RejectPaymentAsync" disabled="@_reviewing">
                                @(_reviewing ? "Rejecting..." : "Reject payment")
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="scd-review-actions">
                        <button type="button" class="scd-btn scd-btn-ghost" @onclick="() => _rejecting = true" disabled="@_reviewing">Reject</button>
                        <button type="button" class="scd-btn scd-btn-primary" @onclick="ApprovePaymentAsync" disabled="@_reviewing">
                            @(_reviewing ? "Approving..." : "Approve payment")
                        </button>
                    </div>
                }
            </section>
        }
        else if (d.Payment is { Status: SamplePaymentStatus.Rejected } rejected && !string.IsNullOrWhiteSpace(rejected.RejectReason))
        {
            <section class="scd-card scd-rejected" role="status">
                <h2 class="scd-card-title">Payment rejected</h2>
                <p>@rejected.RejectReason</p>
                <p class="scd-sub">
                    @Dash(rejected.ReviewedByName)@(rejected.ReviewedAt is { } ra ? $" on {SasLabels.DateTimeText(ra)}" : "")
                </p>
            </section>
        }

        @* --------------------------------------------------------- result comparison *@
        <section class="scd-card scd-results">
            <h2 class="scd-card-title">Result Comparison</h2>

            @if (VisibleItems.Count > 1)
            {
                <div class="scd-tabs" role="tablist" aria-label="Samples">
                    @foreach (var item in VisibleItems)
                    {
                        var active = item.Id == SelectedItemId;
                        <button type="button" role="tab" aria-selected="@active.ToString().ToLowerInvariant()"
                                class="scd-tab @(active ? "is-active" : "")"
                                @onclick="() => SelectItem(item.Id)">
                            <span class="scd-tab-code">@item.Code</span>
                            <span class="scd-tab-sub">@item.Farmer.Name &middot; @SasLabels.SampleTypeName(item.SampleType)</span>
                            @if (item.Results.Count > 0 || item.HasResults)
                            {
                                <i class="bi bi-check-circle-fill scd-tab-ok" aria-label="Results entered"></i>
                            }
                        </button>
                    }
                </div>
            }

            @if (SelectedItem is null)
            {
                <EmptyState Icon="bi-clipboard-data" Title="No samples" Message="This collection has no sample rows." Compact="true" />
            }
            else
            {
                <LabResultsTable Results="SelectedItem.Results"
                                 CanEdit="d.CanReview"
                                 Parameters="_lookups?.LabParameters"
                                 AwaitingNote="@AwaitingNote"
                                 ResetKey="SelectedItemId"
                                 OnSave="SaveResultsAsync" />
            }
        </section>

        @if (IsFarmer)
        {
            @FarmerTimeline(d)
        }
        else
        {
        @* --------------------------------------------------------- consignment + amount *@
        <div class="scd-row">
            <section class="scd-card scd-consignment">
                <h2 class="scd-card-title">Consignments Details</h2>
                @if (d.Consignment is { } c)
                {
                    <div class="scd-defs">
                        <dl>
                            <div>
                                <dt>Consignment ID</dt>
                                <dd><a class="scd-link" href="@($"/ConsignmentHistory/view/{c.Id}")">@c.Code</a></dd>
                            </div>
                            <div><dt>Dispatched Date</dt><dd>@SasLabels.DateTimeText(c.DispatchedAt)</dd></div>
                            <div><dt>Dispatched Through</dt><dd>@Dash(c.CourierService)</dd></div>
                            <div><dt>AWB / Tracking No.</dt><dd><span class="scd-link-plain">@Dash(c.TrackingNumber)</span></dd></div>
                        </dl>
                        <dl>
                            <div><dt>No. of Package</dt><dd>@c.PackageCount</dd></div>
                            <div><dt>Package Weight</dt><dd>@(_consignment?.PackageWeightKg is { } w ? $"{w:0.##} Kg" : "-")</dd></div>
                        </dl>
                    </div>
                    <div class="scd-photos">
                        <span class="scd-photos-label">Consignment Photos</span>
                        <button type="button" class="scd-photos-btn" @onclick="@(() => Nav.NavigateTo($"/ConsignmentHistory/view/{c.Id}"))">
                            <i class="bi bi-images" aria-hidden="true"></i> Click and View Photos and Files
                        </button>
                    </div>
                }
                else
                {
                    <EmptyState Icon="bi-box-seam" Title="Not dispatched yet"
                                Message="The consignment details appear once this collection is bundled and dispatched."
                                Compact="true" />
                }
            </section>

            <section class="scd-card scd-amount">
                <h2 class="scd-card-title">Amount Details</h2>
                <div class="scd-amount-body">
                    <dl class="scd-amount-defs">
                        <div>
                            <dt>Sample Charge (@TotalTests Test@(TotalTests == 1 ? "" : "s"))</dt>
                            <dd>@SasLabels.Money(d.TotalAmount)</dd>
                        </div>
                        <div class="scd-amount-total">
                            <dt>Total Amount</dt>
                            <dd>@SasLabels.Money(d.TotalAmount)</dd>
                        </div>
                    </dl>

                    <div class="scd-paybox">
                        <dl>
                            <div><dt>Payment Mode</dt><dd>@(d.PaymentType == SamplePaymentType.Paid ? "Online" : "Free sample")</dd></div>
                            <div><dt>Payment Date</dt><dd>@(d.Payment is { } pay ? SasLabels.DateTimeText(pay.CreatedAt) : "-")</dd></div>
                            <div><dt>Transaction ID</dt><dd>@Dash(d.Payment?.TransactionId)</dd></div>
                        </dl>
                    </div>
                </div>
            </section>
        </div>

        @* --------------------------------------------------------- timeline *@
        <section class="scd-card scd-timeline">
            <h2 class="scd-card-title">History / Timeline</h2>
            <StatusTimeline Events="d.Timeline" Current="d.Status" />
        </section>
        }
    </div>

    @* --------------------------------------------------------- proof lightbox *@
    @if (_proofOpen && !string.IsNullOrWhiteSpace(Detail?.Payment?.ProofPath))
    {
        <div class="scd-lb" role="dialog" aria-modal="true" aria-label="Payment proof" @onclick="CloseProof">
            <button type="button" class="scd-lb-close" aria-label="Close" @onclick="CloseProof" @onclick:stopPropagation="true">
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
            <img class="scd-lb-img" src="@Api.FileUrl(Detail!.Payment!.ProofPath)" alt="Payment proof"
                 @onclick:stopPropagation="true" />
        </div>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    /// <summary>?sample={itemId}: the sample to open first (links from the farmer's My Samples).</summary>
    [SupplyParameterFromQuery(Name = "sample")] public int? SampleParam { get; set; }

    private SampleCollectionDetailDto? Detail { get; set; }
    private SasLookupsDto? _lookups;

    /// <summary>
    /// SampleCollectionDetailDto.Consignment is only the SUMMARY, so packaging type, the contact
    /// block, the collection notes, the expected delivery date and the package weight - all of
    /// which the design prints in Collection Information - need the consignment detail as well.
    /// Null while it is not dispatched, or when the caller may not read the consignment.
    /// </summary>
    private ConsignmentDetailDto? _consignment;

    private bool _loading = true;
    private bool _notFound;
    private int _loadedId;

    private int? _selectedItemId;
    private bool _proofOpen;
    private bool _rejecting;
    private bool _reviewing;
    private string _rejectReason = "";
    private bool _exporting;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id && Detail is not null) return;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _notFound = false;
        StateHasChanged();

        var (item, notFound) = await Api.GetCollectionAsync(Id);
        Detail = item;
        _notFound = notFound;

        if (item is not null)
        {
            _loadedId = Id;
            var visible = ItemsFor(item);
            if (_selectedItemId is null || visible.All(i => i.Id != _selectedItemId))
                _selectedItemId = SampleParam is { } wanted && visible.Any(i => i.Id == wanted)
                    ? wanted
                    : visible.FirstOrDefault()?.Id;

            // Only review roles need the default parameter list for a blank result form.
            if (_lookups is null && item.CanReview) _lookups = await Api.GetLookupsAsync();
        }

        _loading = false;
        StateHasChanged();

        // Second, optional call: the page is already usable without it.
        await LoadConsignmentAsync();

        // Farmer: the sample report (exists only once the lab completed the batch) and the
        // payment's mode / transaction date / finance status (payments API, farmer-scoped).
        await LoadFarmerReportsAsync();
        await LoadFarmerPaymentAsync();
    }

    private async Task LoadConsignmentAsync()
    {
        if (Detail?.ConsignmentId is not { } consignmentId)
        {
            _consignment = null;
            return;
        }

        if (_consignment?.Id == consignmentId) return;

        var (item, _) = await Api.GetConsignmentAsync(consignmentId);
        _consignment = item;
        StateHasChanged();
    }

    // ------------------------------------------------------------------ derived

    private int TotalTests => Detail?.Items.Sum(i => i.NoOfTests) ?? 0;

    private sealed record SampleGroup(string Label, int Samples, int Tests);

    private List<SampleGroup> SampleGroups =>
        (Detail?.Items ?? new List<SampleItemDto>())
            .GroupBy(i => i.SampleType)
            .OrderBy(g => g.Key)
            .Select(g => new SampleGroup(SasLabels.SampleTypeName(g.Key), g.Count(), g.Sum(i => i.NoOfTests)))
            .ToList();

    private int? SelectedItemId => _selectedItemId ?? VisibleItems.FirstOrDefault()?.Id;

    private SampleItemDto? SelectedItem =>
        VisibleItems.FirstOrDefault(i => i.Id == SelectedItemId) ?? VisibleItems.FirstOrDefault();

    private void SelectItem(int itemId)
    {
        _selectedItemId = itemId;
        _proofOpen = false;
    }

    private string CollectionTypeText
    {
        get
        {
            if (Detail is null) return "-";
            var text = Detail.PaymentType == SamplePaymentType.Paid ? "Paid Sample" : "Free Sample";
            var category = SasLabels.PaidCategoryName(Detail.PaidCategory);
            return string.IsNullOrWhiteSpace(category) ? text : $"{text} ({category})";
        }
    }

    /// <summary>The grey line beside the chips: the furthest milestone this collection reached.</summary>
    private string HeadlineWhen
    {
        get
        {
            if (Detail is null) return "";
            if (Detail.CompletedAt is { } completed) return $"Testing completed on {SasLabels.DateTimeText(completed)}";
            if (Detail.SubmittedAt is { } submitted) return $"Collection completed on {SasLabels.DateTimeText(submitted)}";
            return $"Collected on {SasLabels.DateTimeText(Detail.CollectionDate)}";
        }
    }

    /// <summary>Free samples never carry a payment, so the strip says so instead of showing an empty pill.</summary>
    private string PaymentPillClass =>
        Detail is { PaymentType: SamplePaymentType.Free }
            ? "sas-pill sas-pill--grey"
            : SasLabels.PaymentStatusPillClass(Detail?.Payment?.Status ?? Detail?.PaymentStatus);

    private string PaymentPillText
    {
        get
        {
            if (Detail is null) return "-";
            if (Detail.PaymentType == SamplePaymentType.Free) return "Free Sample";
            var status = Detail.Payment?.Status ?? Detail.PaymentStatus;
            return status is null ? "Not Paid" : SasLabels.PaymentStatusName(status);
        }
    }

    private bool ShowPaymentReview =>
        Detail is { CanReview: true, Status: SampleCollectionStatus.PendingApproval, Payment: not null };

    private string AwaitingNote =>
        Detail is null
            ? ""
            : Detail.Status == SampleCollectionStatus.Completed
                ? "No parameters were recorded for this sample."
                : $"The lab has not published the results yet. Current status: {SasLabels.Status(Detail.Status)}.";

    private static string Dash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    // ------------------------------------------------------------------ farmer view (screen 32)

    /// <summary>Lab analysis is expected to take this many days (Sas:Lab:DelayedAfterDays default).</summary>
    private const int ExpectedAnalysisDays = 5;

    private bool IsFarmer => Login.UserRole == AppRole.Farmer;

    private List<LabReportRowDto> _farmerReports = new();
    private List<LabLanguageDto>? _languages;

    /// <summary>Every sample for staff; the farmer's own samples (SasFarmer.UserId) for a farmer.</summary>
    private List<SampleItemDto> VisibleItems => Detail is null ? new List<SampleItemDto>() : ItemsFor(Detail);

    private List<SampleItemDto> ItemsFor(SampleCollectionDetailDto d) =>
        IsFarmer ? FarmerSamples.OwnItems(d, Login.UserId) : d.Items;

    /// <summary>The selected sample's reports, newest first (a Soil + Water sample has a soil and a water report).</summary>
    private List<LabReportRowDto> SelectedReports =>
        SelectedItem is { } item
            ? _farmerReports.Where(r => r.SampleItemId == item.Id).OrderByDescending(r => r.GeneratedAt).ThenByDescending(r => r.Id).ToList()
            : new List<LabReportRowDto>();

    private LabReportRowDto? SelectedReport => SelectedReports.FirstOrDefault();

    private async Task LoadFarmerReportsAsync()
    {
        if (!IsFarmer || Detail is not { Status: SampleCollectionStatus.Completed }) return;

        var reportsTask = FarmerSamples.ReportsAsync(Lab, CancellationToken.None);
        var languagesTask = Lab.GetLanguagesAsync();
        var ids = Detail.Items.Select(i => i.Id).ToHashSet();
        _farmerReports = (await reportsTask ?? new()).Where(r => ids.Contains(r.SampleItemId)).ToList();
        _languages = await languagesTask;
        StateHasChanged();
    }

    /// <summary>The farmer's read-only payment record (GET api/Sas/payments/{id}); null until loaded or when unavailable.</summary>
    private SasPaymentDetailDto? _paymentDetail;

    private async Task LoadFarmerPaymentAsync()
    {
        if (!IsFarmer || Detail?.Payment is not { } payment) return;
        if (_paymentDetail?.Summary.Id == payment.Id) return;

        var (item, _) = await PayApi.GetPaymentAsync(payment.Id);
        _paymentDetail = item;
        StateHasChanged();
    }

    /// <summary>Reads a payment field from the v1 DTO by name when it exists (fallback when the payments API is unavailable).</summary>
    private static object? PaymentField(SamplePaymentDto? payment, string name) =>
        payment?.GetType().GetProperty(name)?.GetValue(payment);

    private static string PaymentModeText(SamplePaymentDto p) => PaymentField(p, "PaymentMode") switch
    {
        SamplePaymentMode.Upi => "UPI",
        SamplePaymentMode.BankTransfer => "Bank Transfer",
        SamplePaymentMode.Cash => "Cash",
        int i when Enum.IsDefined(typeof(SamplePaymentMode), i) => PaymentModeText((SamplePaymentMode)i),
        string s when !string.IsNullOrWhiteSpace(s) => s,
        _ => string.IsNullOrWhiteSpace(p.BankGateway) ? "UPI" : p.BankGateway!
    };

    private static string PaymentModeText(SamplePaymentMode m) => m switch
    {
        SamplePaymentMode.BankTransfer => "Bank Transfer",
        SamplePaymentMode.Cash => "Cash",
        _ => "UPI"
    };

    /// <summary>The MO enters the transaction date without a time: print the time only when there is one.</summary>
    private static string TransactionDateText(DateTime d) =>
        d.TimeOfDay == TimeSpan.Zero ? SasLabels.LongDate(d) : SasLabels.DateTimeText(d);

    private static DateTime PaymentDate(SamplePaymentDto p) =>
        PaymentField(p, "TransactionDate") is DateTime d ? d : p.CreatedAt;

    private static (string Text, string Tone) AdminStatus(SamplePaymentStatus s) => s switch
    {
        SamplePaymentStatus.Approved => ("Admin Approved", "green"),
        SamplePaymentStatus.Rejected => ("Returned to MO", "red"),
        _ => ("Pending Review", "orange")
    };

    private static (string Text, string Tone)? FinanceStatus(SamplePaymentDto p) => PaymentField(p, "FinanceStatus") switch
    {
        SampleFinanceStatus f => FinanceStatusOf(f),
        int i when Enum.IsDefined(typeof(SampleFinanceStatus), i) => FinanceStatusOf((SampleFinanceStatus)i),
        _ => null
    };

    private static (string Text, string Tone) FinanceStatusOf(SampleFinanceStatus f) => f switch
    {
        SampleFinanceStatus.AwaitingVerification => ("Pending", "orange"),
        SampleFinanceStatus.Verified => ("Verified", "green"),
        SampleFinanceStatus.Mismatch => ("Mismatch", "red"),
        _ => ("Not Forwarded", "grey")
    };

    private SasStatusEventDto? EventOf(params string[] statuses) =>
        Detail?.Timeline
            .Where(e => statuses.Any(s => string.Equals(s, e.Status, StringComparison.OrdinalIgnoreCase)))
            .OrderBy(e => e.At)
            .FirstOrDefault();

    private sealed record FarmerStep(string Title, string Icon, bool Done, bool Current, DateTime? At, string? By, string? Note);

    /// <summary>The farmer-worded seven steps, from the v1 status events plus the sample report.</summary>
    private List<FarmerStep> FarmerSteps(SampleCollectionDetailDto d)
    {
        var s = d.Status;
        var collected = EventOf("Collected", "Submitted", "PendingPayment", "PendingApproval", "ReadyForConsignment");
        var dispatched = EventOf("Dispatched");
        var delivered = EventOf("DeliveredToLab", "Delivered");
        var testing = EventOf("TestInProgress");
        var completed = EventOf("Completed");
        var report = SelectedReport;

        string? courier = null;
        if (d.Consignment is { } c)
        {
            var parts = new List<string>();
            if (!string.IsNullOrWhiteSpace(c.CourierService)) parts.Add(c.CourierService);
            if (!string.IsNullOrWhiteSpace(c.TrackingNumber)) parts.Add($"AWB {c.TrackingNumber}");
            courier = parts.Count == 0 ? null : string.Join(" · ", parts);
        }

        string? analysisNote = null;
        if (s == SampleCollectionStatus.TestInProgress)
        {
            var started = testing?.At ?? DateTime.Now;
            var left = ExpectedAnalysisDays - (int)(DateTime.Now.Date - started.Date).TotalDays;
            analysisNote = left >= 1
                ? $"Results expected within {left} day{(left == 1 ? "" : "s")}"
                : "Taking a little longer than usual; results expected soon";
        }
        else if (s < SampleCollectionStatus.TestInProgress)
        {
            analysisNote = $"Results expected within {ExpectedAnalysisDays} days of testing";
        }

        var steps = new List<FarmerStep>
        {
            new("Sample Collected by MO", "bi-eyedropper", s >= SampleCollectionStatus.Collected, false,
                collected?.At ?? d.SubmittedAt ?? d.CollectionDate, collected?.ByName ?? d.CollectedByName, null),
            new("Sent to Lab", "bi-truck", s >= SampleCollectionStatus.Dispatched, false,
                dispatched?.At ?? d.Consignment?.DispatchedAt, dispatched?.ByName ?? d.Consignment?.DispatchedByName, courier),
            new("Lab Received", "bi-buildings", s >= SampleCollectionStatus.DeliveredToLab, false,
                delivered?.At, delivered?.ByName, null),
            new("Assigned for Testing", "bi-person-check", s >= SampleCollectionStatus.TestInProgress, false,
                testing?.At, testing?.ByName, testing?.Note),
            new("Under Lab Analysis", "bi-clipboard-pulse", s >= SampleCollectionStatus.Completed, false,
                completed?.At ?? d.CompletedAt, null, s >= SampleCollectionStatus.Completed ? "Analysis completed" : analysisNote),
            new("Report Generated", "bi-file-earmark-text", s >= SampleCollectionStatus.Completed, false,
                report?.GeneratedAt ?? completed?.At ?? d.CompletedAt, completed?.ByName, report?.Code),
            new("Report Ready for Download", "bi-cloud-arrow-down", report is not null, false,
                report?.GeneratedAt, null, report is null ? null : "Download it in Tamil or English")
        };

        var current = steps.FindIndex(x => !x.Done);
        if (current >= 0) steps[current] = steps[current] with { Current = true };
        return steps;
    }

