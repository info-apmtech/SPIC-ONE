@code {
    private bool filtersExpanded = true;
    private bool isLoadingInitial = true;
    private bool isLoading = true;
    private string? loadError;
    private bool _exporting;

    private string periodType = "15Days";
    private DateTime? fromDateFilter;
    private DateTime? toDateFilter;
    private string categoryFilter = "";
    private string? dateValidationError;

    private IncomeSummaryResponseDto summary = new();
    private List<IncomeReportRowDto> allRows = new();

    // ---- DataTables State ----
    private string tableSearchText = "";
    private string sortColumn = "Period";
    private bool sortAscending = false; // Default: latest period first
    private int currentPage = 1;
    private int pageSize = 10;

    private IEnumerable<IncomeReportRowDto> FilteredRows
    {
        get
        {
            var rows = allRows.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(tableSearchText))
            {
                var q = tableSearchText.Trim();
                rows = rows.Where(r =>
                    (r.ReportingPeriod ?? "").Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    (r.Status ?? "").Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    r.LivestockIncome.ToString("N0").Contains(q) ||
                    r.OrchardIncome.ToString("N0").Contains(q) ||
                    r.TotalIncome.ToString("N0").Contains(q));
            }

            rows = sortColumn switch
            {
                "Period" => sortAscending ? rows.OrderBy(r => r.PeriodStartDate) : rows.OrderByDescending(r => r.PeriodStartDate),
                "Livestock" => sortAscending ? rows.OrderBy(r => r.LivestockIncome) : rows.OrderByDescending(r => r.LivestockIncome),
                "Orchard" => sortAscending ? rows.OrderBy(r => r.OrchardIncome) : rows.OrderByDescending(r => r.OrchardIncome),
                "Total" => sortAscending ? rows.OrderBy(r => r.TotalIncome) : rows.OrderByDescending(r => r.TotalIncome),
                "Status" => sortAscending ? rows.OrderBy(r => r.Status) : rows.OrderByDescending(r => r.Status),
                _ => sortAscending ? rows.OrderBy(r => r.PeriodStartDate) : rows.OrderByDescending(r => r.PeriodStartDate)
            };

            return rows;
        }
    }

    private int TotalFilteredCount => FilteredRows.Count();
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(TotalFilteredCount / (double)pageSize));

    private IEnumerable<(IncomeReportRowDto Row, int Index)> PagedRows =>
        FilteredRows.Skip((currentPage - 1) * pageSize).Select((r, i) => (r, i)).Take(pageSize);

    private string ShowingEntriesText
    {
        get
        {
            var total = TotalFilteredCount;
            var grandTotal = allRows.Count;
            if (total == 0)
            {
                return grandTotal == 0
                    ? "Showing 0 to 0 of 0 entries"
                    : $"Showing 0 to 0 of 0 entries (filtered from {grandTotal} total entries)";
            }
            var start = ((currentPage - 1) * pageSize) + 1;
            var end = Math.Min(currentPage * pageSize, total);
            return total == grandTotal
                ? $"Showing {start} to {end} of {total} entries"
                : $"Showing {start} to {end} of {total} entries (filtered from {grandTotal} total entries)";
        }
    }

    private IEnumerable<int> VisiblePageNumbers
    {
        get
        {
            var total = TotalPages;
            var set = new SortedSet<int> { 1, total };
            for (var i = Math.Max(1, currentPage - 1); i <= Math.Min(total, currentPage + 1); i++) set.Add(i);
            for (var i = 1; i <= Math.Min(3, total); i++) set.Add(i);
            for (var i = Math.Max(1, total - 2); i <= total; i++) set.Add(i);

            var result = new List<int>();
            int? prev = null;
            foreach (var n in set)
            {
                if (prev is { } p && n - p > 1) result.Add(-1);
                result.Add(n);
                prev = n;
            }
            return result;
        }
    }

    private static readonly string[] Palette =
        { "#2563eb", "#16a34a", "#8b5cf6", "#f59e0b", "#ef4444", "#06b6d4", "#ec4899" };

    private static string ChartColor(int i) => Palette[i % Palette.Length];

    protected override async Task OnInitializedAsync()
    {
        isLoadingInitial = true;
        await LoadSummaryAsync();
        isLoadingInitial = false;
    }

    private string CurrentQueryString()
    {
        var qp = new List<string>();
        if (fromDateFilter.HasValue) qp.Add($"fromDate={fromDateFilter.Value:yyyy-MM-dd}");
        if (toDateFilter.HasValue) qp.Add($"toDate={toDateFilter.Value:yyyy-MM-dd}");
        if (!string.IsNullOrWhiteSpace(categoryFilter)) qp.Add($"incomeCategory={Uri.EscapeDataString(categoryFilter)}");
        if (!string.IsNullOrWhiteSpace(periodType)) qp.Add($"periodType={Uri.EscapeDataString(periodType)}");
        return qp.Count > 0 ? "?" + string.Join("&", qp) : "";
    }

    private async Task LoadSummaryAsync()
    {
        isLoading = true;
        loadError = null;
        StateHasChanged();

        try
        {
            var result = await Http.GetFromJsonAsync<IncomeSummaryResponseDto>("api/FarmReport/income-summary" + CurrentQueryString());
            summary = result ?? new();
            allRows = summary.Rows;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Loading income summary failed: {ex.Message}");
            loadError = "Unable to load income data from the server. Please try again.";
            summary = new();
            allRows = new();
        }
        finally
        {
            isLoading = false;
            currentPage = 1;
            StateHasChanged();
        }

        await RenderChartsAsync();
    }

    private void OnDatesChanged()
    {
        if (fromDateFilter.HasValue && toDateFilter.HasValue && fromDateFilter.Value.Date > toDateFilter.Value.Date)
        {
            dateValidationError = "From Date cannot be later than To Date.";
        }
        else
        {
            dateValidationError = null;
        }
    }

    private async Task OnPeriodTypeChanged()
    {
        tableSearchText = "";
        await LoadSummaryAsync();
    }

    private void SortBy(string column)
    {
        if (sortColumn == column)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
        currentPage = 1;
    }

    private string GetSortIcon(string column)
    {
        if (sortColumn != column) return "bi-arrow-down-up ics-sort-muted";
        return sortAscending ? "bi-arrow-up ics-sort-active" : "bi-arrow-down ics-sort-active";
    }

    private void OnPageSizeChanged() => currentPage = 1;

    private void OnSearchChanged() => currentPage = 1;

    private void ClearSearch()
    {
        tableSearchText = "";
        currentPage = 1;
    }

    private async Task RenderChartsAsync()
    {
        if (summary.TopLivestockProducts.Count == 0 && summary.TopOrchardProducts.Count == 0)
            return;

        var data = new
        {
            livestock = new
            {
                labels = summary.TopLivestockProducts.Select(p => p.ProductName).ToArray(),
                values = summary.TopLivestockProducts.Select(p => p.TotalAmount).ToArray(),
                colors = Enumerable.Range(0, summary.TopLivestockProducts.Count).Select(ChartColor).ToArray(),
                productCount = summary.LivestockProductsCount
            },
            orchard = new
            {
                labels = summary.TopOrchardProducts.Select(p => p.ProductName).ToArray(),
                values = summary.TopOrchardProducts.Select(p => p.TotalAmount).ToArray(),
                colors = Enumerable.Range(0, summary.TopOrchardProducts.Count).Select(ChartColor).ToArray()
            }
        };

        try { await JS.InvokeVoidAsync("loadIncomeSummaryCharts", data); }
        catch (Exception ex) { Console.WriteLine($"Chart render failed: {ex.Message}"); }
    }

    private async Task ApplyFiltersAsync()
    {
        OnDatesChanged();
        if (!string.IsNullOrEmpty(dateValidationError))
        {
            Toast.Warning(dateValidationError);
            return;
        }
        tableSearchText = "";
        await LoadSummaryAsync();
    }

    private async Task ClearFiltersAsync()
    {
        periodType = "15Days";
        fromDateFilter = null;
        toDateFilter = null;
        categoryFilter = "";
        dateValidationError = null;
        tableSearchText = "";
        await LoadSummaryAsync();
    }

    private static string FormatCurrency(decimal v) => $"₹{v:N0}";

    private void GoToPage(int page)
    {
        if (page < 1 || page > TotalPages) return;
        currentPage = page;
    }

    private void GoBack() => Nav.NavigateTo("/FifteenDaysEntry");

    private void ToggleFilters() => filtersExpanded = !filtersExpanded;

    private async Task DownloadExcelAsync()
    {
        if (_exporting) return;
        _exporting = true;
        try
        {
            var response = await Http.GetAsync("api/FarmReport/income-summary/export" + CurrentQueryString());
            if (!response.IsSuccessStatusCode)
            {
                Toast.Error("Could not generate the Excel file.");
                return;
            }

            var bytes = await response.Content.ReadAsByteArrayAsync();
            var fileName = $"IncomeSummary_{DateTime.Now:yyyyMMdd}.xlsx";
            await JS.InvokeVoidAsync("downloadFileFromBytes", fileName,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", Convert.ToBase64String(bytes));
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Excel export failed: {ex.Message}");
            Toast.Error("Could not download the Excel file.");
        }
        finally
        {
            _exporting = false;
        }
    }

    // ---- View details drawer ----
    private bool showDetailsDrawer;
    private bool isLoadingDetail;
    private ReportDetailsDto? selectedDetail;

    // A "15Days" row has one id; a merged "1Month" row has up to two - fetch every one and, when
    // there's more than one, merge them into a single combined view (summed per-product amounts,
    // a weighted-average Rate so the merged line stays mathematically consistent with the sum)
    // rather than just showing the first report and silently dropping the other.
    private async Task ViewReportAsync(IncomeReportRowDto row)
    {
        showDetailsDrawer = true;
        isLoadingDetail = true;
        selectedDetail = null;
        StateHasChanged();

        try
        {
            var ids = row.ReportIds.Count > 0 ? row.ReportIds : (row.ReportId > 0 ? new List<int> { row.ReportId } : new List<int>());
            var details = (await Task.WhenAll(ids.Select(id => Http.GetFromJsonAsync<ReportDetailsDto>($"api/FarmReport/{id}"))))
                .Where(d => d is not null).Select(d => d!).ToList();

            selectedDetail = details.Count switch
            {
                0 => null,
                1 => details[0],
                _ => MergeDetails(row, details)
            };
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Loading report details failed: {ex.Message}");
        }
        finally
        {
            isLoadingDetail = false;
            StateHasChanged();
        }
    }

    private static ReportDetailsDto MergeDetails(IncomeReportRowDto row, List<ReportDetailsDto> details)
    {
        var mergedItems = details
            .SelectMany(d => d.IncomeItems)
            .GroupBy(i => (i.Group, i.ProductName))
            .Select(g =>
            {
                var qty = g.Sum(i => i.SoldQuantity);
                var amount = g.Sum(i => i.TotalAmount);
                return new IncomeItemDto
                {
                    Group = g.Key.Group,
                    ProductName = g.Key.ProductName,
                    IconKey = g.First().IconKey,
                    SoldQuantity = qty,
                    Uom = g.First().Uom,
                    Rate = qty != 0 ? amount / qty : g.First().Rate,
                    TotalAmount = amount
                };
            })
            .ToList();

        var submittedBy = string.Join(", ", details.Select(d => d.SubmittedBy).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct());
        var remarks = string.Join(" | ", details.Select(d => d.IncomeRemarks).Where(r => !string.IsNullOrWhiteSpace(r)));

        return new ReportDetailsDto
        {
            Id = 0,
            ReportingPeriod = row.ReportingPeriod,
            Status = row.Status,
            SubmittedBy = submittedBy,
            SubmittedAt = details.Max(d => d.SubmittedAt),
            TotalIncome = details.Sum(d => d.TotalIncome),
            IncomeRemarks = string.IsNullOrWhiteSpace(remarks) ? null : remarks,
            IncomeItems = mergedItems
        };
    }

    public class IncomeReportRowDto
    {
        public int ReportId { get; set; }
        public List<int> ReportIds { get; set; } = new();
        public string ReportingPeriod { get; set; } = "";
        public DateTime PeriodStartDate { get; set; }
        public DateTime PeriodEndDate { get; set; }
        public decimal LivestockIncome { get; set; }
        public decimal OrchardIncome { get; set; }
        public decimal TotalIncome { get; set; }
        public string Status { get; set; } = "Draft";
    }

    public class ProductIncomeDto
    {
        public string ProductName { get; set; } = "";
        public decimal TotalAmount { get; set; }
    }

    public class IncomeSummaryResponseDto
    {
        public decimal TotalIncomeTillDate { get; set; }
        public DateTime? EarliestPeriodStart { get; set; }
        public int SalesRecordsCount { get; set; }
        public int LivestockProductsCount { get; set; }
        public int OrchardProductsCount { get; set; }
        public string? LatestReportingPeriod { get; set; }
        public DateTime? LatestPeriodEnd { get; set; }
        public int? GraceDaysRemaining { get; set; }
        public List<IncomeReportRowDto> Rows { get; set; } = new();
        public List<ProductIncomeDto> TopLivestockProducts { get; set; } = new();
        public decimal TotalLivestockIncome { get; set; }
        public int OtherLivestockProductCount { get; set; }
        public List<ProductIncomeDto> TopOrchardProducts { get; set; } = new();
        public decimal TotalOrchardIncome { get; set; }
        public int OtherOrchardProductCount { get; set; }
        public List<int> AvailableYears { get; set; } = new();
    }

    public class IncomeItemDto
    {
        public int Id { get; set; }
        public string Group { get; set; } = "LiveStock";
        public string ProductName { get; set; } = "";
        public string? IconKey { get; set; }
        public int SoldQuantity { get; set; }
        public string Uom { get; set; } = "";
        public decimal Rate { get; set; }
        public decimal TotalAmount { get; set; }
    }

    public class ReportDetailsDto
    {
        public int Id { get; set; }
        public string ReportingPeriod { get; set; } = "";
        public string Status { get; set; } = "Draft";
        public string SubmittedBy { get; set; } = "";
        public DateTime? SubmittedAt { get; set; }
        public decimal TotalIncome { get; set; }
        public string? IncomeRemarks { get; set; }
        public List<IncomeItemDto> IncomeItems { get; set; } = new();
    }
}
