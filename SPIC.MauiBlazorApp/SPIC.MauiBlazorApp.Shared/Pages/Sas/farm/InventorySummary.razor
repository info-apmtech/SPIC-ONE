@code {
    private bool filtersExpanded = true;
    private bool isLoadingInitial = true;
    private bool isLoadingProducts = true;
    private bool isLoadingSummary = true;
    private string? loadError;
    private bool _exporting;

    // ---- Catalog (api/FarmProduct/products) ----
    private List<CatalogProductDto> allProducts = new();

    private List<CatalogProductDto> TabProducts =>
        string.IsNullOrEmpty(categoryFilter)
            ? allProducts
            : allProducts.Where(p => string.Equals(p.Group, categoryFilter, StringComparison.OrdinalIgnoreCase)).ToList();

    // ---- Filters ----
    private DateTime? fromDateFilter;
    private DateTime? toDateFilter;
    private string categoryFilter = "";
    private string productFilter = "";
    private string? dateValidationError;

    private string? activeProduct;

    // ---- Current product's data ----
    private InventorySummaryStatsDto summary = new();
    private List<InventoryMovementRowDto> allRows = new();

    // ---- DataTables State ----
    private string tableSearchText = "";
    private string sortColumn = "Period";
    private bool sortAscending = false; // Default: latest 15-day period first
    private int currentPage = 1;
    private int pageSize = 10;

    private IEnumerable<InventoryMovementRowDto> FilteredRows
    {
        get
        {
            var rows = allRows.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(tableSearchText))
            {
                var q = tableSearchText.Trim();
                rows = rows.Where(r =>
                    FormatPeriod(r).Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    (r.ReportingPeriod ?? "").Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    (r.Status ?? "").Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    r.Opening.ToString().Contains(q) ||
                    r.Purchase.ToString().Contains(q) ||
                    r.Hatched.ToString().Contains(q) ||
                    r.Sold.ToString().Contains(q) ||
                    r.Mortality.ToString().Contains(q) ||
                    r.Closing.ToString().Contains(q));
            }

            rows = sortColumn switch
            {
                "Period" => sortAscending ? rows.OrderBy(r => r.PeriodStartDate) : rows.OrderByDescending(r => r.PeriodStartDate),
                "Opening" => sortAscending ? rows.OrderBy(r => r.Opening) : rows.OrderByDescending(r => r.Opening),
                "Purchase" => sortAscending ? rows.OrderBy(r => r.Purchase) : rows.OrderByDescending(r => r.Purchase),
                "Hatched" => sortAscending ? rows.OrderBy(r => r.Hatched) : rows.OrderByDescending(r => r.Hatched),
                "Sold" => sortAscending ? rows.OrderBy(r => r.Sold) : rows.OrderByDescending(r => r.Sold),
                "Mortality" => sortAscending ? rows.OrderBy(r => r.Mortality) : rows.OrderByDescending(r => r.Mortality),
                "Closing" => sortAscending ? rows.OrderBy(r => r.Closing) : rows.OrderByDescending(r => r.Closing),
                _ => sortAscending ? rows.OrderBy(r => r.PeriodStartDate) : rows.OrderByDescending(r => r.PeriodStartDate)
            };

            return rows;
        }
    }

    private int TotalFilteredCount => FilteredRows.Count();
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(TotalFilteredCount / (double)pageSize));

    private List<InventoryMovementRowDto> PagedRows =>
        FilteredRows.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();

    private string ShowingEntriesText
    {
        get
        {
            var total = TotalFilteredCount;
            var grandTotal = allRows.Count;
            if (total == 0)
            {
                return grandTotal == 0
                    ? "Showing 0 to 0 of 0 entries"
                    : $"Showing 0 to 0 of 0 entries (filtered from {grandTotal} total entries)";
            }
            var start = ((currentPage - 1) * pageSize) + 1;
            var end = Math.Min(currentPage * pageSize, total);
            if (total == grandTotal)
            {
                return $"Showing {start} to {end} of {total} entries";
            }
            return $"Showing {start} to {end} of {total} entries (filtered from {grandTotal} total entries)";
        }
    }

    private IEnumerable<int> VisiblePageNumbers
    {
        get
        {
            var total = TotalPages;
            if (total <= 7) return Enumerable.Range(1, total);

            var set = new SortedSet<int> { 1, total };
            for (var i = Math.Max(1, currentPage - 1); i <= Math.Min(total, currentPage + 1); i++) set.Add(i);
            for (var i = 1; i <= Math.Min(3, total); i++) set.Add(i);
            for (var i = Math.Max(1, total - 2); i <= total; i++) set.Add(i);

            var result = new List<int>();
            int? prev = null;
            foreach (var n in set)
            {
                if (prev is { } p && n - p > 1) result.Add(-1); // ellipsis marker
                result.Add(n);
                prev = n;
            }
            return result;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        isLoadingInitial = true;
        await LoadProductsAsync();
        activeProduct = TabProducts.FirstOrDefault()?.Name;
        if (!string.IsNullOrEmpty(activeProduct))
        {
            productFilter = activeProduct;
        }
        await LoadSummaryAsync();
        isLoadingInitial = false;
    }

    private async Task LoadProductsAsync()
    {
        isLoadingProducts = true;
        try
        {
            var result = await Http.GetFromJsonAsync<List<CatalogProductDto>>("api/FarmProduct/products");
            allProducts = (result ?? new()).Where(p => p.IsActive).OrderBy(p => p.Name).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Loading products failed: {ex.Message}");
            allProducts = new();
        }
        finally
        {
            isLoadingProducts = false;
        }
    }

    private async Task LoadSummaryAsync()
    {
        isLoadingSummary = true;
        loadError = null;
        StateHasChanged();

        try
        {
            var qp = new List<string>();
            if (fromDateFilter.HasValue) qp.Add($"fromDate={fromDateFilter.Value:yyyy-MM-dd}");
            if (toDateFilter.HasValue) qp.Add($"toDate={toDateFilter.Value:yyyy-MM-dd}");
            if (!string.IsNullOrWhiteSpace(activeProduct)) qp.Add($"product={Uri.EscapeDataString(activeProduct)}");

            var url = "api/FarmReport/inventory-summary" + (qp.Count > 0 ? "?" + string.Join("&", qp) : "");
            var result = await Http.GetFromJsonAsync<InventorySummaryResponseDto>(url);

            summary = result?.Summary ?? new();
            allRows = result?.Rows ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Loading inventory summary failed: {ex.Message}");
            loadError = "Unable to load inventory data from the server. Please try again.";
            summary = new();
            allRows = new();
        }
        finally
        {
            isLoadingSummary = false;
            currentPage = 1;
            StateHasChanged();
        }
    }

    private async Task SelectProductAsync(string name)
    {
        if (activeProduct == name) return;
        activeProduct = name;
        productFilter = name;
        tableSearchText = "";
        await LoadSummaryAsync();
    }

    private void OnDatesChanged()
    {
        if (fromDateFilter.HasValue && toDateFilter.HasValue && fromDateFilter.Value.Date > toDateFilter.Value.Date)
        {
            dateValidationError = "From Date cannot be later than To Date.";
        }
        else
        {
            dateValidationError = null;
        }
    }

    private async Task OnCategoryChanged()
    {
        if (!TabProducts.Any(p => p.Name == activeProduct))
        {
            activeProduct = TabProducts.FirstOrDefault()?.Name;
            productFilter = "";
            tableSearchText = "";
            await LoadSummaryAsync();
        }
    }

    private async Task ApplyFiltersAsync()
    {
        OnDatesChanged();
        if (!string.IsNullOrEmpty(dateValidationError))
        {
            Toast.Warning(dateValidationError);
            return;
        }

        if (!string.IsNullOrWhiteSpace(productFilter))
            activeProduct = productFilter;
        tableSearchText = "";
        await LoadSummaryAsync();
    }

    private async Task ClearFiltersAsync()
    {
        fromDateFilter = null;
        toDateFilter = null;
        categoryFilter = "";
        productFilter = "";
        dateValidationError = null;
        tableSearchText = "";
        activeProduct = TabProducts.FirstOrDefault()?.Name;
        await LoadSummaryAsync();
    }

    private void SortBy(string column)
    {
        if (sortColumn == column)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
        currentPage = 1;
    }

    private string GetSortIcon(string column)
    {
        if (sortColumn != column) return "bi-arrow-down-up is-sort-muted";
        return sortAscending ? "bi-arrow-up is-sort-active" : "bi-arrow-down is-sort-active";
    }

    private void OnPageSizeChanged()
    {
        currentPage = 1;
    }

    private void OnSearchChanged()
    {
        currentPage = 1;
    }

    private void ClearSearch()
    {
        tableSearchText = "";
        currentPage = 1;
    }

    private static string FormatPeriod(InventoryMovementRowDto row) =>
        $"{row.PeriodStartDate:dd} - {row.PeriodEndDate:dd} {row.PeriodStartDate:MMM}";

    private void GoToPage(int page)
    {
        if (page < 1 || page > TotalPages) return;
        currentPage = page;
    }

    private void GoBack() => Nav.NavigateTo("/FifteenDaysEntry");

    private void ToggleFilters() => filtersExpanded = !filtersExpanded;

    private string CurrentQueryString()
    {
        var qp = new List<string>();
        if (fromDateFilter.HasValue) qp.Add($"fromDate={fromDateFilter.Value:yyyy-MM-dd}");
        if (toDateFilter.HasValue) qp.Add($"toDate={toDateFilter.Value:yyyy-MM-dd}");
        if (!string.IsNullOrWhiteSpace(activeProduct)) qp.Add($"product={Uri.EscapeDataString(activeProduct)}");
        return qp.Count > 0 ? "?" + string.Join("&", qp) : "";
    }

    private async Task DownloadExcelAsync()
    {
        if (_exporting) return;
        _exporting = true;
        try
        {
            var response = await Http.GetAsync("api/FarmReport/inventory-summary/export" + CurrentQueryString());
            if (!response.IsSuccessStatusCode)
            {
                Toast.Error("Could not generate the Excel file.");
                return;
            }

            var bytes = await response.Content.ReadAsByteArrayAsync();
            var fileName = $"InventorySummary_{activeProduct}_{DateTime.Now:yyyyMMdd}.xlsx";
            await JS.InvokeVoidAsync("downloadFileFromBytes", fileName,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", Convert.ToBase64String(bytes));
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Excel export failed: {ex.Message}");
            Toast.Error("Could not download the Excel file.");
        }
        finally
        {
            _exporting = false;
        }
    }

    private async Task DownloadPdfAsync()
    {
        var rowsToExport = FilteredRows.ToList();
        var rowsHtml = string.Join("", rowsToExport.Select(r => $"""
            <tr>
                <td>{System.Net.WebUtility.HtmlEncode(FormatPeriod(r))}{(r.Status == "Draft" ? " (Draft)" : "")}</td>
                <td>{r.Opening}</td><td>{r.Purchase}</td><td>{r.Hatched}</td>
                <td>{r.Sold}</td><td>{r.Mortality}</td><td>{r.Closing}</td>
            </tr>
            """));

        const string style = """
            body { font-family: Arial, sans-serif; padding: 24px; color: #1f2937; }
            h2 { margin-bottom: 4px; }
            table { width: 100%; border-collapse: collapse; margin-top: 16px; }
            th, td { border: 1px solid #e5e7eb; padding: 8px 10px; text-align: center; font-size: 13px; }
            th { background: #f3f4f6; }
            td:first-child, th:first-child { text-align: left; }
            """;

        var productLabel = System.Net.WebUtility.HtmlEncode(activeProduct ?? "Product");
        var html = $"""
            <html>
            <head>
                <title>Inventory Summary - {productLabel}</title>
                <style>{style}</style>
            </head>
            <body>
                <h2>{productLabel} Stock Movement History</h2>
                <p>15-day reporting periods &middot; Total Purchased: {summary.TotalPurchased} {System.Net.WebUtility.HtmlEncode(summary.Uom)} &middot; Total Sold: {summary.TotalSold} &middot; Closing Stock: {summary.ClosingStock}</p>
                <table>
                    <thead>
                        <tr><th>Period</th><th>Opening Stock</th><th>Purchase</th><th>Hatched</th><th>Sales</th><th>Mortality</th><th>Closing Stock</th></tr>
                    </thead>
                    <tbody>{rowsHtml}</tbody>
                </table>
            </body>
            </html>
            """;

        await JS.InvokeVoidAsync("openPrintableHtml", html);
    }

    public class CatalogProductDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Group { get; set; } = "";
        public string Uom { get; set; } = "";
        public decimal CurrentRate { get; set; }
        public bool IsActive { get; set; }
    }

    public class InventorySummaryStatsDto
    {
        public int TotalPurchased { get; set; }
        public int TotalHatched { get; set; }
        public int TotalSold { get; set; }
        public int TotalMortality { get; set; }
        public int ClosingStock { get; set; }
        public DateTime? ClosingStockAsOf { get; set; }
        public string Uom { get; set; } = "";
    }

    public class InventoryMovementRowDto
    {
        public int ReportId { get; set; }
        public string ReportingPeriod { get; set; } = "";
        public DateTime PeriodStartDate { get; set; }
        public DateTime PeriodEndDate { get; set; }
        public string Status { get; set; } = "Draft";
        public int Opening { get; set; }
        public int Purchase { get; set; }
        public int Hatched { get; set; }
        public int Sold { get; set; }
        public int Mortality { get; set; }
        public int Others { get; set; }
        public int Closing { get; set; }
    }

    public class InventorySummaryResponseDto
    {
        public string? SelectedProduct { get; set; }
        public List<string> ReportingPeriods { get; set; } = new();
        public List<string> AvailableFinancialYears { get; set; } = new();
        public InventorySummaryStatsDto Summary { get; set; } = new();
        public List<InventoryMovementRowDto> Rows { get; set; } = new();
    }
}
