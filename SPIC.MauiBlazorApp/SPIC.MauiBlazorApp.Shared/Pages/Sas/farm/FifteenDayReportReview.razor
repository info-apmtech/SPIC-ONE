    private bool isLoading = true;
    private bool inventoryExpanded = true;
    private bool incomeExpanded = true;
    private bool expenseExpanded = true;

    private ReportDetailsDto? report;

    private List<InventoryItemRow> inventoryRows = new();
    private List<InventoryItemRow> liveStockInventoryRows = new();
    private List<InventoryItemRow> orchardInventoryRows = new();
    private List<IncomeItemRow> liveStockIncomeRows = new();
    private List<IncomeItemRow> orchardIncomeRows = new();
    private List<ExpenseItemRow> mainExpenseRows = new();
    private List<ExpenseItemRow> subExpenseRows = new();

    private string ReportingPeriodDisplay => report?.ReportingPeriod ?? "01 Apr 2026 - 15 Apr 2026";
    private string CompactPeriodDisplay =>
        report is { PeriodStartDate: var s, PeriodEndDate: var e } && s != default && e != default
            ? $"{s:dd-MMM yyyy} - {e:dd-MMM yyyy}"
            : ReportingPeriodDisplay;
    private decimal TotalIncomeDisplay => report?.TotalIncome ?? IncomeGrandTotal;
    private decimal TotalExpenseDisplay => report?.TotalExpense ?? MainCategoriesTotal;
    private decimal NetProfitDisplay => report?.NetProfit ?? (TotalIncomeDisplay - TotalExpenseDisplay);

    // Annual budget + previous-period figures, pulled live from the finance-summary endpoint for
    // this report's financial year (the by-id report endpoint doesn't carry FY-level context).
    private decimal AnnualBudgetDisplay;
    private decimal PrevIncome;
    private decimal PrevExpense;
    private decimal PrevNetResult;
    private bool hasPrevious;

    private string FinancialYearDisplay => report?.FinancialYear ?? "2026-27";
    private decimal RoiDisplay => AnnualBudgetDisplay > 0
        ? Math.Round((NetProfitDisplay / AnnualBudgetDisplay) * 100m, 2) : 0m;

    private static decimal ChangePercent(decimal current, decimal previous) =>
        previous != 0 ? Math.Round(((current - previous) / Math.Abs(previous)) * 100m, 1) : 0m;

    private decimal IncomeChangePct => ChangePercent(TotalIncomeDisplay, PrevIncome);
    private decimal ExpenseChangePct => ChangePercent(TotalExpenseDisplay, PrevExpense);
    private decimal NetChangePct => ChangePercent(NetProfitDisplay, PrevNetResult);

    private int LivestockCount => liveStockInventoryRows.Count;
    private int OrchardCount => orchardInventoryRows.Count;
    private int TotalProductsCount => LivestockCount + OrchardCount;

    private static decimal IncomeAmount(IncomeItemRow row) =>
        row.TotalAmount != 0 ? row.TotalAmount : row.SoldQuantity * row.Rate;

    private decimal LiveStockIncomeTotal => liveStockIncomeRows.Sum(IncomeAmount);
    private decimal OrchardIncomeTotal => orchardIncomeRows.Sum(IncomeAmount);

    private int LiveStockIncomeProductCount =>
        liveStockIncomeRows.Count(r => IncomeAmount(r) > 0);

    private int OrchardIncomeProductCount =>
        orchardIncomeRows.Count(r => IncomeAmount(r) > 0);

    private decimal IncomeGrandTotal =>
        LiveStockIncomeTotal + OrchardIncomeTotal;

    private decimal MainCategoriesTotal =>
        mainExpenseRows.Sum(r => r.Amount);

    private decimal SubCategoriesTotal =>
        subExpenseRows.Sum(r => r.Amount);

    private static readonly HashSet<string> OrchardProducts = new(StringComparer.OrdinalIgnoreCase)
    {
        "Mango", "Coconut", "Banana", "Papaya", "Guava", "Lemon", "Amla"
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadReportAsync();
    }

    private async Task LoadReportAsync()
    {
        try
        {
            isLoading = true;
            if (ReportIdQuery.HasValue && ReportIdQuery.Value > 0)
            {
                report = await Http.GetFromJsonAsync<ReportDetailsDto>($"api/FarmReport/{ReportIdQuery.Value}");
            }
            else
            {
                report = await Http.GetFromJsonAsync<ReportDetailsDto>("api/FarmReport/latest");
            }

            if (report != null)
            {
                PopulateReportData(report);
                await LoadFinancialContextAsync(report);
            }
            else
            {
                PopulateFallbackMockData();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching report review: {ex.Message}");
            PopulateFallbackMockData();
        }
        finally
        {
            isLoading = false;
        }
    }

    // Pulls the annual budget and the immediately-previous period's totals for this report's FY so
    // the Financial Summary card, ROI and the "Comparison with Previous" table are all live data
    // instead of hardcoded placeholders.
    private async Task LoadFinancialContextAsync(ReportDetailsDto r)
    {
        try
        {
            var fy = string.IsNullOrWhiteSpace(r.FinancialYear) ? "2026-27" : r.FinancialYear;
            var summary = await Http.GetFromJsonAsync<FinanceSummaryContextDto>(
                $"api/FarmReport/finance-summary?financialYear={Uri.EscapeDataString(fy)}");
            if (summary == null) return;

            AnnualBudgetDisplay = summary.AnnualBudget;

            // History comes back newest-first; order chronologically and find the report that sits
            // immediately before this one by period start date.
            var ordered = (summary.History ?? new())
                .OrderBy(h => h.PeriodStartDate ?? DateTime.MinValue)
                .ToList();
            var idx = ordered.FindIndex(h => h.Id == r.Id);
            if (idx > 0)
            {
                var prev = ordered[idx - 1];
                PrevIncome = prev.Income;
                PrevExpense = prev.Expense;
                PrevNetResult = prev.NetResult;
                hasPrevious = true;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading financial context: {ex.Message}");
        }
    }

