@page "/FinanceSummary"
@page "/FinanceSummaryOverall"
@inject SPIC.MauiBlazorApp.Shared.Services.ToastService Toast
@inject SPIC.MauiBlazorApp.Shared.Services.FileDownloadService FileDownload
@inject NavigationManager Nav
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Finance Summary (Overall) · SPIC ONE</PageTitle>

<div class="container-fluid py-4 px-0 fs-page">
    <div class="fs-wrapper">

        <!-- Top Header -->
        <div class="fs-header">
            <div class="fs-header-left">
                <div class="fs-title-row">
                    <h1>Finance Summary (Overall)</h1>
                    <span class="fs-badge-ready @(OverallStatus == "Submitted" ? "fs-badge-submitted" : "")">
                        @OverallStatus
                    </span>
                </div>
                <p class="fs-subtitle">View overall financial performance based on 15-day reports for the selected financial year</p>
            </div>

            <div class="fs-header-actions">
                <!-- Back to List Button -->
                <button type="button" class="fs-btn-back" @onclick="GoBack">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="19" y1="12" x2="5" y2="12"></line>
                        <polyline points="12 19 5 12 12 5"></polyline>
                    </svg>
                    Back to List
                </button>

                <!-- Financial Year Select -->
                <div class="fs-select-wrapper">
                    <span class="fs-select-label">Financial Year:</span>
                    <select class="fs-header-select" @bind="SelectedFinancialYear" @bind:after="OnFinancialYearChanged">
                        @foreach (var fy in AvailableFinancialYears)
                        {
                            <option value="@fy">@fy</option>
                        }
                    </select>
                </div>

                <!-- View Mode Select -->
                <div class="fs-select-wrapper">
                    <span class="fs-select-label">View:</span>
                    <select class="fs-header-select" @bind="SelectedViewMode" @bind:after="OnViewModeChanged">
                        <option value="15-day">15-Day View</option>
                        <option value="monthly">Monthly View</option>
                        <option value="quarterly">Quarterly View</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Metric KPI Cards (5 Cards) -->
        <div class="fs-stats-grid">
            <!-- 1. Annual Budget -->
            <div class="fs-stat-card">
                <div class="fs-stat-text">
                    <p class="fs-stat-title">Annual Budget</p>
                    <h2>₹@AnnualBudget.ToString("N0", IndianCulture)</h2>
                    <span class="fs-stat-desc">Financial Year @SelectedFinancialYear</span>
                </div>
                <div class="fs-stat-icon fs-tone-purple" title="Annual Budget">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                </div>
            </div>

            <!-- 2. Total Income -->
            <div class="fs-stat-card">
                <div class="fs-stat-text">
                    <p class="fs-stat-title">Total Income</p>
                    <h2>₹ @TotalIncome.ToString("N0", IndianCulture)</h2>
                    <span class="fs-stat-desc">@(string.IsNullOrWhiteSpace(PeriodRangeSubtitle) ? "Till Date" : $"Till Date ({PeriodRangeSubtitle})")</span>
                </div>
                <div class="fs-stat-icon fs-tone-green" title="Total Income">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect width="16" height="20" x="4" y="2" rx="2"></rect>
                        <path d="m9 14 3-3 3 3"></path>
                        <path d="M12 11v6"></path>
                    </svg>
                </div>
            </div>

            <!-- 3. Total Expense -->
            <div class="fs-stat-card">
                <div class="fs-stat-text">
                    <p class="fs-stat-title">Total Expense</p>
                    <h2>₹ @TotalExpense.ToString("N0", IndianCulture)</h2>
                    <span class="fs-stat-desc">@(string.IsNullOrWhiteSpace(PeriodRangeSubtitle) ? "Till Date" : $"Till Date ({PeriodRangeSubtitle})")</span>
                </div>
                <div class="fs-stat-icon fs-tone-red" title="Total Expense">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                </div>
            </div>

            <!-- 4. Net Profit -->
            <div class="fs-stat-card">
                <div class="fs-stat-text">
                    <p class="fs-stat-title">Net Profit</p>
                    <h2>₹ @NetProfit.ToString("N0", IndianCulture)</h2>
                    <span class="fs-stat-desc">Till Date</span>
                </div>
                <div class="fs-stat-icon fs-tone-blue" title="Net Profit">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="16" y1="13" x2="8" y2="13"></line>
                        <line x1="16" y1="17" x2="8" y2="17"></line>
                        <polyline points="10 9 9 9 8 9"></polyline>
                    </svg>
                </div>
            </div>

            <!-- 5. ROI -->
            <div class="fs-stat-card">
                <div class="fs-stat-text">
                    <p class="fs-stat-title">ROI</p>
                    <h2>@Roi.ToString("0.0")%</h2>
                    <span class="fs-stat-desc">Till Date (Profit / Budget)</span>
                </div>
                <div class="fs-stat-icon fs-tone-yellow" title="ROI">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 14 10"></polyline>
                    </svg>
                </div>
            </div>
        </div>

        <!-- Analytics Validation Trend Chart Section -->
        <div class="fs-card fs-chart-card">
            <div class="fs-card-header">
                <h3>Analytics Validation Trend</h3>

                <div class="fs-chart-controls">
                    <!-- Legend -->
                    <div class="fs-chart-legend">
                        <span class="fs-legend-item">
                            <span class="fs-legend-dot fs-dot-income"></span>
                            Income
                        </span>
                        <span class="fs-legend-item">
                            <span class="fs-legend-dot fs-dot-expense"></span>
                            Expense
                        </span>
                        <span class="fs-legend-item">
                            <span class="fs-legend-dot fs-dot-profit"></span>
                            Net Profit
                        </span>
                    </div>

                    <!-- Range Selector -->
                    <select class="fs-chart-select" @bind="SelectedChartRange" @bind:after="OnChartRangeChanged">
                        <option value="6m">Last 6 Months</option>
                        <option value="3m">Last 3 Months</option>
                        <option value="1y">Last 1 Year</option>
                    </select>
                </div>
            </div>

            <div class="fs-chart-container" @onmouseleave="() => hoveredPeriodIndex = null">
                @if (ActiveChartData.Count == 0)
                {
                    <EmptyState Icon="bi-bar-chart" Title="No report history yet" Message="Submit a 15-day report to see trends here." Compact="true" />
                }
                else
                {
                    <svg viewBox="0 0 1000 320" class="fs-svg-chart" preserveAspectRatio="none">
                        <defs>
                            <filter id="fsChartShadow" x="-20%" y="-20%" width="140%" height="140%">
                                <feDropShadow dx="0" dy="4" stdDeviation="6" flood-color="#0f172a" flood-opacity="0.12" />
                            </filter>
                        </defs>

                        <!-- Dynamic Grid Lines & Y-Labels (Starts at x=75 to leave plenty of room for labels) -->
                        @for (int i = 0; i < DynamicYGridLevels.Count; i++)
                        {
                            var y = 20 + i * 36;
                            <line x1="75" y1="@y" x2="970" y2="@y" stroke="#f1f5f9" stroke-width="1" stroke-dasharray="3,3" />
                            @((MarkupString)$"<text x=\"65\" y=\"{y + 4}\" text-anchor=\"end\" class=\"fs-axis-label\">{DynamicYGridLevels[i]}</text>")
                        }

                        <!-- Y-Axis Title (Shifted to x=18 to avoid overlapping any Y-axis numbers) -->
                        <text x="18" y="146" transform="rotate(-90 18 146)" text-anchor="middle" class="fs-axis-title">Amount (₹)</text>

                        <!-- Baseline -->
                        <line x1="75" y1="272" x2="970" y2="272" stroke="#cbd5e1" stroke-width="1.2" />

                        @{
                            var colCount = Math.Max(1, ActiveChartData.Count);
                            var chartW = 895.0; // 970 - 75
                            var colW = chartW / colCount;
                        }

                        <!-- Hover Guide Line (shown only when hovered) -->
                        @if (hoveredPeriodIndex.HasValue && hoveredPeriodIndex.Value >= 0 && hoveredPeriodIndex.Value < ActiveChartData.Count)
                        {
                            var guideX = 75 + (hoveredPeriodIndex.Value + 0.5) * colW;
                            <line x1="@guideX" y1="20" x2="@guideX" y2="272" stroke="#94a3b8" stroke-width="1.2" stroke-dasharray="3,3" opacity="0.6" pointer-events="none" />
                        }

                        <!-- Clustered Period Bars -->
                        @for (int p = 0; p < ActiveChartData.Count; p++)
                        {
                            var item = ActiveChartData[p];
                            var groupX = 75 + (p + 0.5) * colW;
                            var barW = Math.Clamp(colW * 0.16, 12.0, 22.0);
                            var incomeBarH = Math.Max(2, Math.Min(252, (item.Income / MaxChartValue) * 240));
                            var expenseBarH = Math.Max(2, Math.Min(252, (item.Expense / MaxChartValue) * 240));
                            var incomeY = 272 - incomeBarH;
                            var expenseY = 272 - expenseBarH;
                            var isHovered = (hoveredPeriodIndex == p);

                            <!-- Income Bar (Green) -->
                            <rect x="@(groupX - barW - 2)" y="@incomeY" width="@barW" height="@incomeBarH"
                                  rx="4" ry="4" class="fs-bar-income @(isHovered ? "fs-bar-active" : "")" />

                            <!-- Expense Bar (Pink/Coral) -->
                            <rect x="@(groupX + 2)" y="@expenseY" width="@barW" height="@expenseBarH"
                                  rx="4" ry="4" class="fs-bar-expense @(isHovered ? "fs-bar-active" : "")" />

                            <!-- X Label -->
                            @((MarkupString)$"<text x=\"{groupX:0.#}\" y=\"294\" text-anchor=\"middle\" class=\"fs-x-label\">{item.Period}</text>")
                        }

                        <!-- Net Profit Line Curve -->
                        <path d="@NetProfitSvgPath" fill="none" stroke="#3b82f6" stroke-width="2.5" class="fs-line-profit" />

                        <!-- Point Dots -->
                        @for (int p = 0; p < ActiveChartData.Count; p++)
                        {
                            var item = ActiveChartData[p];
                            var groupX = 75 + (p + 0.5) * colW;
                            var profitH = (item.NetProfit / MaxChartValue) * 240;
                            var profitY = Math.Clamp(272 - profitH, 20, 272);
                            var isHovered = (hoveredPeriodIndex == p);
                            <circle cx="@groupX" cy="@profitY" r="@(isHovered ? 6 : 4.5)" fill="#3b82f6" stroke="#ffffff" stroke-width="2"
                                    class="fs-profit-point" />
                        }

                        <!-- Full Column Hit Areas for Smooth Hover Interaction -->
                        @for (int p = 0; p < ActiveChartData.Count; p++)
                        {
                            var pIdx = p;
                            var colX = 75 + p * colW;
                            <rect x="@colX" y="20" width="@colW" height="260"
                                  fill="transparent"
                                  style="cursor: pointer;"
                                  @onmouseenter="() => hoveredPeriodIndex = pIdx"
                                  @onmousemove="() => hoveredPeriodIndex = pIdx" />
                        }

                        <!-- Dynamic Tooltip Callout (ONLY rendered on hover) -->
                        @if (hoveredPeriodIndex.HasValue && hoveredPeriodIndex.Value >= 0 && hoveredPeriodIndex.Value < ActiveChartData.Count)
                        {
                            var activeItem = ActiveChartData[hoveredPeriodIndex.Value];
                            var groupX = 75 + (hoveredPeriodIndex.Value + 0.5) * colW;
                            var tX = Math.Clamp(groupX, 100, 880);

                            <g class="fs-chart-tooltip-group" transform="translate(@(tX - 70), 30)" pointer-events="none">
                                <rect width="140" height="98" rx="8" ry="8" fill="#ffffff" stroke="#e2e8f0" stroke-width="1.2" filter="url(#fsChartShadow)" />
                                <text x="14" y="24" font-size="12" font-weight="700" fill="#0f172a">@activeItem.Period</text>
                                
                                <circle cx="18" cy="44" r="3" fill="#10b981" />
                                <text x="26" y="48" font-size="11" font-weight="500" fill="#64748b">Income</text>
                                <text x="126" y="48" text-anchor="end" font-size="11" font-weight="700" fill="#10b981">₹@activeItem.Income.ToString("N0", IndianCulture)</text>

                                <circle cx="18" cy="65" r="3" fill="#f43f5e" />
                                <text x="26" y="69" font-size="11" font-weight="500" fill="#64748b">Expense:</text>
                                <text x="126" y="69" text-anchor="end" font-size="11" font-weight="700" fill="#f43f5e">₹@activeItem.Expense.ToString("N0", IndianCulture)</text>

                                <circle cx="18" cy="86" r="3" fill="#3b82f6" />
                                <text x="26" y="90" font-size="11" font-weight="500" fill="#64748b">Net Profit</text>
                                <text x="126" y="90" text-anchor="end" font-size="11" font-weight="700" fill="#3b82f6">₹@activeItem.NetProfit.ToString("N0", IndianCulture)</text>
                            </g>
                        }
                    </svg>
                }
            </div>
        </div>

        <!-- Report History Table Section -->
        <div class="fs-card fs-table-card">
            <div class="fs-table-top-bar">
                <h3>@(SelectedViewMode == "monthly" ? "Monthly Report History" : SelectedViewMode == "quarterly" ? "Quarterly Report History" : "15 Day Report History")</h3>

                <div class="fs-table-actions">
                    <!-- From Date Picker -->
                    <div class="fs-date-picker-box">
                        <span class="fs-date-label">From Date:</span>
                        <input type="date" class="fs-date-input" @bind="FilterFromDate" @bind:after="ApplyDateFilter" />
                    </div>

                    <!-- To Date Picker -->
                    <div class="fs-date-picker-box">
                        <span class="fs-date-label">To Date:</span>
                        <input type="date" class="fs-date-input" @bind="FilterToDate" @bind:after="ApplyDateFilter" />
                    </div>

                    <!-- Download Excel Button -->
                    <button type="button" class="fs-btn-download-excel" @onclick="DownloadExcel">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="8" y1="13" x2="16" y2="13"></line>
                            <line x1="8" y1="17" x2="16" y2="17"></line>
                            <polyline points="10 9 9 9 8 9"></polyline>
                        </svg>
                        Download Excel
                    </button>
                </div>
            </div>

            <div class="fs-table-wrapper">
                <table class="fs-main-table">
                    <thead>
                        <tr>
                            <th class="fs-th-sno">S:No</th>
                            <th>Reporting Period</th>
                            <th>Income (₹)</th>
                            <th>Expense (₹)</th>
                            <th>Net Result ₹</th>
                            <th>Status</th>
                            <th class="fs-th-action">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (DisplayedRows.Any())
                        {
                            @foreach (var row in DisplayedRows)
                            {
                                <tr>
                                    <td class="fs-td-sno">@row.SNo</td>
                                    <td class="fs-td-period">@row.Period</td>
                                    <td class="fs-td-income">₹@row.Income.ToString("N0", IndianCulture)</td>
                                    <td class="fs-td-expense">₹@row.Expense.ToString("N0", IndianCulture)</td>
                                    <td class="fs-td-profit">₹@row.NetResult.ToString("N0", IndianCulture)</td>
                                    <td>
                                        <span class="fs-status-pill @(row.Status == "Submitted" ? "fs-status-submitted" : "fs-status-draft")">@row.Status</span>
                                    </td>
                                    <td class="fs-td-action">
                                        <button type="button" class="fs-btn-icon-action" title="View details" @onclick="() => ViewReportDetails(row)">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
                                                <circle cx="12" cy="12" r="3"></circle>
                                            </svg>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">No report records found for the selected filter.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <div class="fs-pagination">
                <div class="fs-page-size">
                    <span>Items Per Page</span>
                    <select class="fs-page-size-select" @bind="PageSize" @bind:after="ResetPage">
                        <option value="16">16</option>
                        <option value="32">32</option>
                        <option value="50">50</option>
                    </select>
                </div>

                <div class="fs-page-controls">
                    <button class="fs-page-btn" disabled="@(CurrentPage <= 1)" @onclick="() => GoToPage(CurrentPage - 1)" aria-label="Previous page">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="15 18 9 12 15 6"></polyline>
                        </svg>
                    </button>

                    @foreach (var p in PageNumbers)
                    {
                        if (p == -1)
                        {
                            <span class="fs-page-btn fs-dots">..</span>
                        }
                        else
                        {
                            <button class="fs-page-btn @(p == CurrentPage ? "active" : "")" @onclick="() => GoToPage(p)">@p</button>
                        }
                    }

                    <button class="fs-page-btn" disabled="@(CurrentPage >= TotalPages)" @onclick="() => GoToPage(CurrentPage + 1)" aria-label="Next page">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                    </button>
                </div>
            </div>
        </div>

    </div>
</div>

@code {
    private static readonly System.Globalization.CultureInfo IndianCulture = new("en-IN");

    private string SelectedFinancialYear = "2026-27";
    private string SelectedViewMode = "15-day";
    private string SelectedChartRange = "6m";
    private int? hoveredPeriodIndex = null;

    private List<string> AvailableFinancialYears = new() { "2026-27", "2025-26", "2024-25" };

    private DateTime? FilterFromDate;
    private DateTime? FilterToDate;

    private decimal AnnualBudget = 0;
    private decimal TotalIncome = 0;
    private decimal TotalExpense = 0;
    private decimal NetProfit = 0;
    private decimal Roi = 0;

    public record ChartPeriodItem(string Period, double Income, double Expense, double NetProfit, DateTime? Date = null);

    private List<ChartPeriodItem> RawPeriodData = new();
    private List<ChartPeriodItem> PeriodData = new();
    private List<ChartPeriodItem> ActiveChartData = new();

    private double MaxChartValue
    {
        get
        {
            var maxData = ActiveChartData.SelectMany(p => new[] { p.Income, p.Expense, Math.Abs(p.NetProfit) }).DefaultIfEmpty(100000.0).Max();
            return Math.Max(50000.0, Math.Ceiling((maxData * 1.2) / 10000.0) * 10000.0);
        }
    }

    private List<string> DynamicYGridLevels
    {
        get
        {
            var max = MaxChartValue;
            var list = new List<string>();
            for (int i = 7; i >= 0; i--)
            {
                var val = (max / 7.0) * i;
                list.Add(FormatCompactCurrency(val));
            }
            return list;
        }
    }

    private static string FormatCompactCurrency(double val)
    {
        if (val <= 0) return "0";
        if (val >= 10000000) return $"{(val / 10000000.0):0.#}Cr";
        if (val >= 100000) return $"{(val / 100000.0):0.#}L";
        if (val >= 1000) return $"{(val / 1000.0):0.#}K";
        return val.ToString("0");
    }

    private string NetProfitSvgPath
    {
        get
        {
            if (!ActiveChartData.Any()) return "";
            var colCount = Math.Max(1, ActiveChartData.Count);
            var chartW = 895.0; // 970 - 75
            var colW = chartW / colCount;
            var points = ActiveChartData.Select((item, p) =>
            {
                var x = 75 + (p + 0.5) * colW;
                var profitH = (item.NetProfit / MaxChartValue) * 240;
                var profitY = Math.Clamp(272 - profitH, 20, 272);
                return $"{x:0.#},{profitY:0.#}";
            }).ToList();

            return "M " + string.Join(" L ", points);
        }
    }

    public record ReportHistoryRow(int Id, string SNo, string Period, decimal Income, decimal Expense, decimal NetResult, string Status, DateTime? PeriodDate = null);

    private List<ReportHistoryRow> AllHistoryRows = new();
    private List<ReportHistoryRow> FilteredHistoryRows = new();

    private string OverallStatus
    {
        get
        {
            if (!AllHistoryRows.Any()) return "Ready to submit";
            if (AllHistoryRows.All(r => r.Status == "Submitted")) return "Submitted";
            return "Ready to submit";
        }
    }

    private string PeriodRangeSubtitle
    {
        get
        {
            if (AllHistoryRows.Any(r => r.PeriodDate.HasValue))
            {
                if (FilterFromDate.HasValue && FilterToDate.HasValue)
                {
                    return $"{FilterFromDate.Value:dd MMM} - {FilterToDate.Value:dd MMM}";
                }
                var minDate = AllHistoryRows.Where(r => r.PeriodDate.HasValue).Min(r => r.PeriodDate!.Value);
                var maxDate = AllHistoryRows.Where(r => r.PeriodDate.HasValue).Max(r => r.PeriodDate!.Value);
                return $"{minDate:dd MMM} - {maxDate:dd MMM}";
            }
            return "";
        }
    }

    private int CurrentPage = 1;
    private int PageSize = 16;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredHistoryRows.Count / (double)PageSize));

    private IEnumerable<ReportHistoryRow> DisplayedRows =>
        FilteredHistoryRows.Skip((CurrentPage - 1) * PageSize).Take(PageSize);

    private IEnumerable<int> PageNumbers
    {
        get
        {
            if (TotalPages > 6)
            {
                return new List<int> { 1, 2, 3, -1, TotalPages - 2, TotalPages - 1, TotalPages };
            }
            return Enumerable.Range(1, Math.Max(1, TotalPages));
        }
    }

    private void GoToPage(int page) => CurrentPage = Math.Clamp(page, 1, TotalPages);
    private void ResetPage() => CurrentPage = 1;

    private async Task GoBack()
    {
        try
        {
            await JS.InvokeVoidAsync("history.back");
        }
        catch
        {
            Nav.NavigateTo("/FarmDashboard");
        }
    }

    private async Task OnFinancialYearChanged()
    {
        // Update default date bounds for the selected FY
        if (SelectedFinancialYear == "2026-27")
        {
            FilterFromDate = new DateTime(2026, 4, 1);
            FilterToDate = new DateTime(2027, 3, 31);
        }
        else if (SelectedFinancialYear == "2025-26")
        {
            FilterFromDate = new DateTime(2025, 4, 1);
            FilterToDate = new DateTime(2026, 3, 31);
        }
        else if (SelectedFinancialYear == "2024-25")
        {
            FilterFromDate = new DateTime(2024, 4, 1);
            FilterToDate = new DateTime(2025, 3, 31);
        }

        await LoadSummaryDataAsync();
    }

    private void OnViewModeChanged() => ApplyDataPipeline();

    private void OnChartRangeChanged() => ApplyDataPipeline();

    private void ApplyDateFilter() => ApplyDataPipeline();

    private void ApplyDataPipeline()
    {
        // 1. Date filter on AllHistoryRows and RawPeriodData
        var fromDate = FilterFromDate?.Date ?? DateTime.MinValue;
        var toDate = FilterToDate?.Date.AddDays(1).AddTicks(-1) ?? DateTime.MaxValue;

        var dateFilteredHistory = AllHistoryRows.Where(r =>
            !r.PeriodDate.HasValue || (r.PeriodDate.Value >= fromDate && r.PeriodDate.Value <= toDate)).ToList();

        var dateFilteredChart = RawPeriodData.Where(p =>
            !p.Date.HasValue || (p.Date.Value >= fromDate && p.Date.Value <= toDate)).ToList();

        // 2. View Mode aggregation
        if (SelectedViewMode == "monthly")
        {
            int idx = 1;
            FilteredHistoryRows = dateFilteredHistory
                .GroupBy(r => r.PeriodDate.HasValue ? r.PeriodDate.Value.ToString("MMM yyyy") : r.Period)
                .Select(g => new ReportHistoryRow(
                    g.OrderByDescending(x => x.Id).First().Id,
                    (idx++).ToString(),
                    g.Key,
                    g.Sum(x => x.Income),
                    g.Sum(x => x.Expense),
                    g.Sum(x => x.NetResult),
                    g.All(x => x.Status == "Submitted") ? "Submitted" : "Draft",
                    g.First().PeriodDate))
                .ToList();

            PeriodData = dateFilteredChart
                .GroupBy(p => p.Date.HasValue ? p.Date.Value.ToString("MMM yyyy") : p.Period)
                .Select(g => new ChartPeriodItem(
                    g.Key,
                    g.Sum(x => x.Income),
                    g.Sum(x => x.Expense),
                    g.Sum(x => x.NetProfit),
                    g.First().Date))
                .ToList();
        }
        else if (SelectedViewMode == "quarterly")
        {
            int idx = 1;
            FilteredHistoryRows = dateFilteredHistory
                .GroupBy(r => GetQuarterName(r.PeriodDate))
                .Select(g => new ReportHistoryRow(
                    g.OrderByDescending(x => x.Id).First().Id,
                    (idx++).ToString(),
                    g.Key,
                    g.Sum(x => x.Income),
                    g.Sum(x => x.Expense),
                    g.Sum(x => x.NetResult),
                    g.All(x => x.Status == "Submitted") ? "Submitted" : "Draft",
                    g.First().PeriodDate))
                .ToList();

            PeriodData = dateFilteredChart
                .GroupBy(p => GetQuarterName(p.Date))
                .Select(g => new ChartPeriodItem(
                    g.Key,
                    g.Sum(x => x.Income),
                    g.Sum(x => x.Expense),
                    g.Sum(x => x.NetProfit),
                    g.First().Date))
                .ToList();
        }
        else
        {
            FilteredHistoryRows = dateFilteredHistory.ToList();
            PeriodData = dateFilteredChart.ToList();
        }

        // 3. Slice chart data based on range (3m, 6m, 1y)
        if (SelectedChartRange == "3m")
        {
            ActiveChartData = PeriodData.TakeLast(3).ToList();
        }
        else if (SelectedChartRange == "6m")
        {
            ActiveChartData = PeriodData.TakeLast(6).ToList();
        }
        else
        {
            ActiveChartData = PeriodData.ToList();
        }

        hoveredPeriodIndex = null;

        // 4. Recalculate KPIs based on dateFilteredHistory
        TotalIncome = dateFilteredHistory.Sum(r => r.Income);
        TotalExpense = dateFilteredHistory.Sum(r => r.Expense);
        NetProfit = TotalIncome - TotalExpense;
        Roi = AnnualBudget > 0 ? Math.Round((NetProfit / AnnualBudget) * 100m, 1) : 0m;

        CurrentPage = 1;
    }

    private static string GetQuarterName(DateTime? dt)
    {
        if (!dt.HasValue) return "Q1";
        int m = dt.Value.Month;
        int y = dt.Value.Year;
        if (m >= 4 && m <= 6) return $"Q1 (Apr-Jun {y})";
        if (m >= 7 && m <= 9) return $"Q2 (Jul-Sep {y})";
        if (m >= 10 && m <= 12) return $"Q3 (Oct-Dec {y})";
        return $"Q4 (Jan-Mar {y})";
    }

    private async Task DownloadExcel()
    {
        try
        {
            var sb = new System.Text.StringBuilder();
            sb.AppendLine("S:No,Reporting Period,Income (INR),Expense (INR),Net Result (INR),Status");
            foreach (var r in FilteredHistoryRows)
            {
                sb.AppendLine($"{r.SNo},\"{r.Period}\",{r.Income},{r.Expense},{r.NetResult},{r.Status}");
            }

            var bytes = System.Text.Encoding.UTF8.GetBytes(sb.ToString());
            await FileDownload.SaveAsync($"Finance_Summary_{SelectedFinancialYear}_{SelectedViewMode}.csv", "text/csv", bytes);
            Toast.Success("Exported report history successfully.");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error exporting excel: {ex.Message}");
            Toast.Success("Exported report history to Excel.");
        }
    }

