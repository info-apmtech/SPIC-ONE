    public class FinanceSummaryApiResponse
    {
        public decimal AnnualBudget { get; set; }
        public decimal TotalIncome { get; set; }
        public decimal TotalExpense { get; set; }
        public decimal NetProfit { get; set; }
        public decimal Roi { get; set; }
        public List<string> AvailableFinancialYears { get; set; } = new();
        public List<ApiChartPoint> ChartPoints { get; set; } = new();
        public List<ApiHistoryItem> History { get; set; } = new();
    }

    public class ApiChartPoint
    {
        public string PeriodLabel { get; set; } = "";
        public decimal Income { get; set; }
        public decimal Expense { get; set; }
        public decimal NetProfit { get; set; }
        public DateTime? Date { get; set; }
    }

    public class ApiHistoryItem
    {
        public int Id { get; set; }
        public string ReportingPeriod { get; set; } = "";
        public string FinancialYear { get; set; } = "";
        public decimal Income { get; set; }
        public decimal Expense { get; set; }
        public decimal NetResult { get; set; }
        public string Status { get; set; } = "";
        public DateTime? SubmittedAt { get; set; }
        public string SubmittedBy { get; set; } = "";
        public DateTime? PeriodStartDate { get; set; }
        public DateTime? PeriodEndDate { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        FilterFromDate = new DateTime(2026, 4, 1);
        FilterToDate = new DateTime(2027, 3, 31);

        await LoadSummaryDataAsync();
    }

    private async Task LoadSummaryDataAsync()
    {
        try
        {
            var res = await Http.GetFromJsonAsync<FinanceSummaryApiResponse>($"api/FarmReport/finance-summary?financialYear={Uri.EscapeDataString(SelectedFinancialYear)}");
            if (res != null)
            {
                AnnualBudget = res.AnnualBudget;
                TotalIncome = res.TotalIncome;
                TotalExpense = res.TotalExpense;
                NetProfit = res.NetProfit;
                Roi = res.Roi;

                if (res.AvailableFinancialYears != null && res.AvailableFinancialYears.Count > 0)
                {
                    AvailableFinancialYears = res.AvailableFinancialYears;
                }

                if (res.ChartPoints != null && res.ChartPoints.Count > 0)
                {
                    RawPeriodData = res.ChartPoints
                        .Select(pt => new ChartPeriodItem(
                            pt.PeriodLabel,
                            (double)pt.Income,
                            (double)pt.Expense,
                            (double)pt.NetProfit,
                            pt.Date))
                        .ToList();
                }
                else
                {
                    RawPeriodData.Clear();
                }

                if (res.History != null && res.History.Count > 0)
                {
                    AllHistoryRows = res.History
                        .Select((h, idx) => new ReportHistoryRow(
                            h.Id,
                            (idx + 1).ToString(),
                            h.ReportingPeriod,
                            h.Income,
                            h.Expense,
                            h.NetResult,
                            h.Status,
                            h.PeriodStartDate ?? h.SubmittedAt))
                        .ToList();

                    // Keep the date filter at the full financial-year bounds (set in
                    // OnInitializedAsync / OnFinancialYearChanged). Narrowing it to the min/max of
                    // the returned periods used to hide freshly-submitted reports whose period fell
                    // outside that transient window, which surfaced as an empty history table.
                    // If a report lies outside the FY bounds (e.g. a period entered for a later
                    // month), widen the window to include it rather than hiding it.
                    if (AllHistoryRows.Any(r => r.PeriodDate.HasValue))
                    {
                        var minDate = AllHistoryRows.Where(r => r.PeriodDate.HasValue).Min(r => r.PeriodDate!.Value).Date;
                        var maxDate = AllHistoryRows.Where(r => r.PeriodDate.HasValue).Max(r => r.PeriodDate!.Value).Date;
                        if (!FilterFromDate.HasValue || minDate < FilterFromDate.Value) FilterFromDate = minDate;
                        if (!FilterToDate.HasValue || maxDate > FilterToDate.Value) FilterToDate = maxDate;
                    }
                }
                else
                {
                    AllHistoryRows.Clear();
                }

                ApplyDataPipeline();
                hoveredPeriodIndex = null;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading finance summary: {ex.Message}");
        }
    }
}
