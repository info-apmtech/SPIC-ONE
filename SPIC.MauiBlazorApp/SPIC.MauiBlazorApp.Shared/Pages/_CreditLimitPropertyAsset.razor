@using DealerReg = SPIC.Core.Entities.DealerRegistration

<div class="form-card">
    <div class="d-flex justify-content-between align-items-center py-3 flex-wrap gap-2">
        <div class="card-header-title mb-0">
            <img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/PropertyAssets.svg"
                 class="formicon" />
            Property Assets (Collateral)
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="asset-box blue">
                <div class="asset-title">
                    <img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/Bank.svg"
                         class="verifyicon mb-1 mr-1" />
                    Banking
                </div>
                <div class="asset-value">₹ @BankingTotal.ToString("N0")</div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="asset-box gray">
                <div class="asset-title">
                    <img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/land.svg"
                         class="verifyicon" />
                    Land
                </div>
                <div class="asset-value">₹ @LandTotal.ToString("N0")</div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="asset-box pink">
                <div class="asset-title">
                    <img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/Building.svg"
                         class="verifyicon mb-1 mr-1" />
                    Building
                </div>
                <div class="asset-value">₹ @BuildingTotal.ToString("N0")</div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="asset-box orange">
                <div class="asset-title">
                    <img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/Movable.svg"
                         class="verifyicon" />
                    Movable
                </div>
                <div class="asset-value">₹ @Dealer.AssetValue.ToString("N0")</div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="asset-box blue">
                <div class="asset-title">Total Valuation</div>
                <div class="asset-value">₹ @TotalPropertyValue.ToString("N0")</div>
                <div class="asset-badge">TOTAL ASSETS</div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="asset-box pink">
                <div class="asset-title">Net Valuation</div>
                <div class="asset-value">
                    ₹ @((TotalPropertyValue - LoansTotal).ToString("N0"))
                </div>
                <div class="asset-badge">AFTER LIABILITIES</div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="asset-box gray">
                <div class="asset-title">LTV Ratio</div>
                <div class="asset-value">
                    @(TotalPropertyValue > 0
                        ? ((LoansTotal / TotalPropertyValue) * 100).ToString("N0")
                        : "0")%
                </div>
                <div class="asset-badge">LOAN TO VALUE</div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public DealerReg Dealer { get; set; } = new();

    [Parameter] public decimal BankingTotal { get; set; }
    [Parameter] public decimal LandTotal { get; set; }
    [Parameter] public decimal BuildingTotal { get; set; }
    [Parameter] public decimal TotalPropertyValue { get; set; }
    [Parameter] public decimal LoansTotal { get; set; }
}