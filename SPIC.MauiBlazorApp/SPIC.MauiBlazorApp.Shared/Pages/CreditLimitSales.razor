private async Task OnBulkFileSelected(InputFileChangeEventArgs e)
{
    var file = e.File;
    if (file == null) return;

    if (_bulkUploadFinancialYearId <= 0)
    {
        _uploadSuccess = false;
        _uploadResult  = "Please select a financial year before uploading.";
        return;
    }

    using var content     = new MultipartFormDataContent();
    var stream            = file.OpenReadStream(maxAllowedSize: 200 * 1024 * 1024);
    var streamContent     = new StreamContent(stream);
    streamContent.Headers.ContentType =
        new System.Net.Http.Headers.MediaTypeHeaderValue(
            file.ContentType ?? "application/octet-stream");
    content.Add(streamContent, "file", file.Name);

    _isUploading  = true;
    _uploadResult = "";
    _uploadSuccess = false;
    StateHasChanged();

    try
    {
        var response = await Http.PostAsync(
            $"api/creditlimitsales/bulk-upload?financialYearId={_bulkUploadFinancialYearId}",
            content);

        var bodyText = await response.Content.ReadAsStringAsync();

        if (response.IsSuccessStatusCode)
        {
            _uploadSuccess = true;

            // Parse JSON and build a friendly message
            try
            {
                using var doc  = JsonDocument.Parse(bodyText);
                var root       = doc.RootElement;
                var inserted   = root.TryGetProperty("insertedRows",  out var ins)  ? ins.GetInt32()  : 0;
                var skipped    = root.TryGetProperty("skippedRows",   out var skip) ? skip.GetInt32() : 0;
                var errorList  = root.TryGetProperty("invalidRows",   out var errs)
                    ? errs.EnumerateArray().Select(x => x.GetString() ?? "").ToList()
                    : new List<string>();

                // Build friendly message
                var sb = new System.Text.StringBuilder();
                sb.Append($"✓ {inserted:N0} rows uploaded successfully.");
                if (skipped > 0)
                    sb.Append($" {skipped:N0} rows skipped.");

                _uploadResult    = sb.ToString();
                _uploadErrorRows = errorList; // store for display below
            }
            catch
            {
                _uploadResult    = "Upload completed successfully.";
                _uploadErrorRows = new();
            }

            // Reset file input + financial year
            _bulkUploadFinancialYearId = 0;
            _uploadFileKey++;           // forces InputFile to re-render (clears chosen file)

            await LoadData();
        }
        else
        {
            _uploadSuccess   = false;
            _uploadErrorRows = new();

            try
            {
                using var doc = JsonDocument.Parse(bodyText);
                var root      = doc.RootElement;
                _uploadResult = root.TryGetProperty("message", out var msg)
                    ? msg.GetString() ?? "Upload failed."
                    : "Upload failed.";
            }
            catch
            {
                _uploadResult = "Upload failed. Please try again.";
            }
        }
    }
    catch (Exception ex)
    {
        _uploadSuccess   = false;
        _uploadResult    = $"Upload error: {ex.Message}";
        _uploadErrorRows = new();
    }
    finally
    {
        _isUploading = false;
        StateHasChanged();
    }
}
