@page "/CreditLimitSales"

@using System.Net.Http.Json
@using System.Text.Json
@inject HttpClient Http
@inject IJSRuntime JS

<div class="container-fluid">

    <h2 class="page-title">Credit Limit Sales</h2>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert @(_isError ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
            @_message
            <button type="button" class="btn-close" @onclick="() => _message = null"></button>
        </div>
    }

    <div class="main-card">
        <div class="section-header">
    <h3 class="section-title">@(_isEditing ? "Edit Credit Limit Sales" : "Add New Credit Limit Sales")</h3>
    <div class="d-flex gap-2">
        <button class="btn-outline-green" @onclick="DownloadSampleTemplate">
            <i class="bi bi-file-earmark-excel"></i> Sample Format
        </button>
        <button class="btn-outline-green" @onclick="() => _showUploadModal = true">
            <i class="bi bi-cloud-arrow-up"></i> Bulk Upload
        </button>
    </div>
</div>

        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <label class="form-label-custom">State</label>
                <select class="form-control-custom w-100" @bind="_form.StateId" @ref="_firstInputRef">
                    <option value="0">Select State</option>
                    @foreach (var state in _states)
                    {
                        <option value="@state.Id">@state.StateName</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
    <label class="form-label-custom">Financial Year</label>
    <select class="form-control-custom w-100" @bind="_form.FinancialYearId">
        <option value="0">Select Financial Year</option>
        @foreach (var fy in _financialYears)
        {
            <option value="@fy.Id">@fy.Name</option>
        }
    </select>
</div>
            <div class="col-md-3">
                <label class="form-label-custom">Dealer Code</label>
                <select class="form-control-custom w-100" @bind="_form.CustomerId" @bind:after="OnDealerChanged">
                    <option value="0">Select Dealer Code</option>
                    @foreach (var dealer in _dealersAll)
                    {
                        <option value="@dealer.Id">@dealer.DealerCode</option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label-custom">Dealer Name</label>
                <select class="form-control-custom w-100" @bind="_form.CustomerId" @bind:after="OnDealerChanged">
                    <option value="0">Select Dealer Name</option>
                    @foreach (var dealer in _dealersAll)
                    {
                        <option value="@dealer.Id">@dealer.FirmName</option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label-custom">Product</label>
                <select class="form-control-custom w-100" @bind="_form.ProductId">
                    <option value="0">Select Product</option>
                    @foreach (var product in _productsList)
                    {
                        <option value="@product.Id">@product.Name</option>
                    }
                </select>
            </div>

           <div class="col-md-3">
    <label class="form-label-custom">Product Group</label>
    <select class="form-control-custom w-100" @bind="_form.ProductGroupId">
        <option value="0">Select Product Group</option>
        @foreach (var group in _productGroupsList)
        {
            <option value="@group.Id">@group.Name</option>
        }
    </select>
</div>

<div class="col-md-3">
    <label class="form-label-custom">Category</label>
    <select class="form-control-custom w-100" @bind="_form.CategoryId">
        <option value="0">Select Category</option>
        @foreach (var category in _categoriesList)
        {
            <option value="@category.Id">@category.Name</option>
        }
    </select>
</div>

            <div class="col-md-3">
                <label class="form-label-custom">Quantity</label>
                <input type="number" class="form-control-custom w-100" placeholder="Enter Quantity"step="0.01"
                       @bind="_form.Quantity" />
            </div>

            <div class="col-md-3">
                <label class="form-label-custom">Gross Amount</label>
                <input type="number" step="0.01" class="form-control-custom w-100" placeholder="Enter Amount"
                       @bind="_form.GrossAmount" />
            </div>
        </div>

        <div class="d-flex justify-content-end pt-2 mt-4">
            <button class="btn-cancel mt-3" @onclick="ResetForm"><i class="bi bi-x"></i> Cancel</button>
            <button class="btn-save mt-3" @onclick="HandleSave" disabled="@_isSaving">
                <i class="bi bi-save"></i> @(_isSaving ? "Saving..." : "Save")
            </button>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-12">
            <div class="metric-card bg-blue-light">
                <div class="metric-header">
                    <h4 class="metric-title">Total Credit Limit Sales</h4>
                </div>
                <div class="metric-val">@_allItems.Count</div>
            </div>
        </div>
    </div>

<SpicDataTable Items="_filteredItems"
               IsLoading="_isLoading"
               Title="Existing Credit Limit Sales"
               FileName="CreditLimitSales"
               ExportColumns="GetExportColumns()"
               SearchText="@_searchText">

<FilterControls>
    <div class="search-box">
        <i class="bi bi-search"></i>
        <input type="text"
               placeholder="Search code/name..."
               @bind="_searchText"
               @bind:event="oninput"
               @bind:after="StateHasChanged" />
    </div>
</FilterControls>

    <TableHeader>
        <th>State</th>
        <th>Financial Year</th>
        <th>Dealer Code</th>
        <th>Dealer Name</th>
       <th>Product</th>
<th>Product Group</th>
<th>Category</th>
        <th>Quantity</th>
        <th>Gross Amount</th>
        <th>Action</th>
    </TableHeader>

    <TableRow Context="item">
        <td>@GetStateName(item.StateId)</td>
        <td>@GetFinancialYearName(item.FinancialYearId)</td>
        <td>@item.CustomerNumber</td>
        <td>@GetDealerName(item.CustomerId)</td>
        <td>@GetProductName(item.ProductId)</td>
<td>@GetProductGroupName(item.ProductGroupId)</td>
<td>@GetCategoryName(item.CategoryId)</td>
        <td>@item.Quantity</td>
        <td>@item.GrossAmount.ToString("F2")</td>
        <td>
            <div class="action-icons">
                <i class="bi bi-trash icon-del" @onclick="() => DeleteItem(item)"></i>
                <i class="bi bi-pencil-square icon-edit" @onclick="() => EditItem(item)"></i>
            </div>
        </td>
    </TableRow>
</SpicDataTable>
</div>

@if (_showDeleteConfirm)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Delete</h5>
                    <button type="button" class="btn-close" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete Dealer Code <strong>@_deleteTarget?.CustomerNumber</strong>?</p>
                    <p class="text-muted mb-0">This action cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CancelDelete">Cancel</button>
                    <button class="btn btn-danger" @onclick="ConfirmDelete" disabled="@_isDeleting">
                        @(_isDeleting ? "Deleting..." : "Delete")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showUploadModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Bulk Upload — Credit Limit Sales</h5>
                    <button type="button" class="btn-close"
                            @onclick="CloseUploadModal">✕</button>
                </div>
                <div class="modal-body">

                    <div class="mb-3">
                        <label class="form-label-custom">Financial Year</label>
                        <select class="form-control-custom w-100"
                                @bind="_bulkUploadFinancialYearId">
                            <option value="0">Select Financial Year</option>
                            @foreach (var fy in _financialYears)
                            {
                                <option value="@fy.Id">@fy.Name</option>
                            }
                        </select>
                    </div>

                    @* Key forces re-render (resets chosen file) after upload *@
                    <InputFile key="@_uploadFileKey"
                               OnChange="OnBulkFileSelected"
                               accept=".xlsx,.xls" />

                    <div style="margin-top: 14px;">

                        @if (_isUploading)
                        {
                            <div class="d-flex align-items-center gap-2"
                                 style="color:#6b7280; font-size:13px;">
                                <span class="spinner-border spinner-border-sm"></span>
                                <span>Uploading, please wait...</span>
                            </div>
                        }
                        else if (!string.IsNullOrEmpty(_uploadResult))
                        {
                            <div class="alert @(_uploadSuccess ? "alert-success" : "alert-danger")
                                         mb-2 py-2"
                                 style="font-size:13px;">
                                @_uploadResult
                            </div>

                            @* Show skipped row details if any *@
                            @if (_uploadSuccess && _uploadErrorRows.Any())
                            {
                                <details style="margin-top:6px;">
                                    <summary style="font-size:12px; color:#6b7280; cursor:pointer;">
                                        View @_uploadErrorRows.Count skipped row(s)
                                    </summary>
                                    <div style="max-height:160px; overflow-y:auto;
                                                margin-top:6px; font-size:12px;
                                                color:#991b1b; background:#fff5f5;
                                                border:1px solid #fecaca;
                                                border-radius:6px; padding:8px 10px;">
                                        @foreach (var err in _uploadErrorRows)
                                        {
                                            <div style="margin-bottom:3px;">• @err</div>
                                        }
                                    </div>
                                </details>
                            }
                        }
                    </div>
                </div>

                <div class="modal-footer">
                    <button class="btn btn-secondary"
                            @onclick="CloseUploadModal">Close</button>
                </div>
            </div>
        </div>
    </div>
}
