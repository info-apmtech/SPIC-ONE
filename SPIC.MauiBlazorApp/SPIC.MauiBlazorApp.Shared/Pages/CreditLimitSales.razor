@code {
    // Form model
    private CreditLimitSalesForm _form = new();
    private bool _isEditing = false;
    private ElementReference _firstInputRef;

    // Data 
    private List<CreditLimitSalesForm> _allItems = new();
    private List<CreditLimitSalesForm> _filteredItems = new();

    // Loaded dynamically from APIs
    private List<StateDto> _states = new();
    private List<LookupDto> _productsList = new();
    private List<LookupDto> _categoriesList = new();
    private List<DealerItemDto> _dealersAll = new(); 

    // UI state
    private bool _isLoading = true;
    private bool _isSaving = false;
    private string? _message;
    private bool _isError = false;

    // Delete confirmation
    private bool _showDeleteConfirm = false;
    private bool _isDeleting = false;
    private CreditLimitSalesForm? _deleteTarget;

    // Upload
    private bool _showUploadModal = false;
    private bool _isUploading = false;
    private string _uploadResult = string.Empty;
    private bool _uploadSuccess = false;
    // Add these alongside the other upload fields
private List<string> _uploadErrorRows = new();
private int _uploadFileKey = 0;  // incrementing this key forces InputFile to reset

    // Search & filter
    private string _searchText = "";
    private string? _currentUserId;
    private int _bulkUploadFinancialYearId = 0;
private List<FinancialYearDto> _financialYears = new();
private List<LookupDto> _productGroupsList = new(); 
public class FinancialYearDto
{
    public int Id { get; set; }
    public string Name { get; set; } = "";
}

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var token = await JS.InvokeAsync<string>("sessionStorage.getItem", "jwt_token");
            if (!string.IsNullOrEmpty(token))
            {
                var uid = GetUserIdFromToken(token);
                if (!string.IsNullOrEmpty(uid)) _currentUserId = uid;
            }
        }
        catch { }

        await LoadLookups();
        await LoadData();
        _isLoading = false;
    }

   private async Task LoadLookups()
{
    try
    {
        _states = await Http.GetFromJsonAsync<List<StateDto>>("api/State/all") ?? new();
        _productsList = await Http.GetFromJsonAsync<List<LookupDto>>("api/Product/all") ?? new();
        _categoriesList = await Http.GetFromJsonAsync<List<LookupDto>>("api/Category/all") ?? new();
        _productGroupsList = await Http.GetFromJsonAsync<List<LookupDto>>("api/ProductGroup/all") ?? new();
        _dealersAll = await Http.GetFromJsonAsync<List<DealerItemDto>>("api/DealerRegistration/all") ?? new();
        _financialYears = await Http.GetFromJsonAsync<List<FinancialYearDto>>("api/FinancialYear/all") ?? new();
    }
    catch (Exception ex)
    {
        ShowMessage($"Failed to load lookups: {ex.Message}", true);
    }
}

    private async Task LoadData()
    {
        try
        {
            _isLoading = true;
            _allItems = await Http.GetFromJsonAsync<List<CreditLimitSalesForm>>("api/creditlimitsales/all") ?? new();
            ApplyFilter();
        }
        catch (Exception ex)
        {
            ShowMessage($"Failed to load data: {ex.Message}", true);
        }
        finally
        {
            _isLoading = false;
        }
    }
    private async Task DownloadSampleTemplate()
{
    try
    {
        var bytes = await Http.GetByteArrayAsync("api/creditlimitsales/sample-template");
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("downloadFileFromBytes",
            "CreditLimitSales_Sample_Template.xlsx",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            base64);
    }
    catch (Exception ex)
    {
        ShowMessage($"Failed to download sample template: {ex.Message}", true);
    }
}
private void ApplyFilter()
{
    _filteredItems = _allItems
        .OrderByDescending(x => x.Id)
        .ToList();
}

    // Triggers when either the Dealer Code or Dealer Name dropdown is selected
    private void OnDealerChanged()
    {
        var selectedDealer = _dealersAll.FirstOrDefault(d => d.Id == _form.CustomerId);
        if (selectedDealer != null)
        {
            _form.CustomerNumber = selectedDealer.DealerCode;
        }
        else
        {
            _form.CustomerNumber = "";
        }
    }

    private async Task HandleSave()
    {
      if (_form.FinancialYearId == 0 || _form.StateId == 0 || string.IsNullOrWhiteSpace(_form.CustomerNumber) ||
    _form.CustomerId == 0 || _form.ProductId == 0 || _form.ProductGroupId == 0 || _form.CategoryId == 0)
{
    ShowMessage("All required fields must be filled.", true);
    return;
}

        try
        {
            _isSaving = true;

           object payload = _isEditing
    ? new
    {
        Id = _form.Id,
        _form.FinancialYearId,
        _form.StateId,
        _form.CustomerNumber,
        _form.CustomerId,
        _form.ProductId,
        _form.ProductGroupId,
        _form.CategoryId,
        _form.Quantity,
        _form.GrossAmount
    }
    : new
    {
        _form.FinancialYearId,
        _form.StateId,
        _form.CustomerNumber,
        _form.CustomerId,
        _form.ProductId,
        _form.ProductGroupId,
        _form.CategoryId,
        _form.Quantity,
        _form.GrossAmount
    };

            HttpResponseMessage response;
            if (_isEditing && _form.Id > 0)
            {
                response = await Http.PutAsJsonAsync($"api/creditlimitsales/{_form.Id}", payload);
                if (!response.IsSuccessStatusCode)
                {
                    var error = await response.Content.ReadAsStringAsync();
                    ShowMessage($"Update failed: {error}", true);
                    return;
                }
                ShowMessage("Credit Limit Sales updated successfully.", false);
            }
            else
            {
                response = await Http.PostAsJsonAsync("api/creditlimitsales", payload);
                if (!response.IsSuccessStatusCode)
                {
                    var error = await response.Content.ReadAsStringAsync();
                    ShowMessage($"Create failed: {error}", true);
                    return;
                }
                ShowMessage("Credit Limit Sales created successfully.", false);
            }

            ResetForm();
            await LoadData();
        }
        catch (Exception ex)
        {
            ShowMessage($"Error: {ex.Message}", true);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task EditItem(CreditLimitSalesForm item)
    {
        _isEditing = true;

    _form = new CreditLimitSalesForm
{
    Id = item.Id,
    FinancialYearId = item.FinancialYearId,
    StateId = item.StateId,
    CustomerNumber = item.CustomerNumber,
    CustomerId = item.CustomerId,
    ProductId = item.ProductId,
    ProductGroupId = item.ProductGroupId,
    CategoryId = item.CategoryId,
    Quantity = item.Quantity,
    GrossAmount = item.GrossAmount
};

        try
        {
            await _firstInputRef.FocusAsync();
        }
        catch { }
    }

    private void DeleteItem(CreditLimitSalesForm item)
    {
        _deleteTarget = item;
        _showDeleteConfirm = true;
    }

    private async Task ConfirmDelete()
    {
        if (_deleteTarget is null) return;

        try
        {
            _isDeleting = true;
            var response = await Http.DeleteAsync($"api/creditlimitsales/{_deleteTarget.Id}");
            if (response.IsSuccessStatusCode)
            {
                ShowMessage($"Dealer '{_deleteTarget.CustomerNumber}' deleted successfully.", false);
                await LoadData();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                ShowMessage($"Delete failed: {error}", true);
            }
        }
        catch (Exception ex)
        {
            ShowMessage($"Error: {ex.Message}", true);
        }
        finally
        {
            _isDeleting = false;
            CancelDelete();
        }
    }

    private void CancelDelete()
    {
        _showDeleteConfirm = false;
        _deleteTarget = null;
    }

    private void ResetForm()
    {
        _form = new CreditLimitSalesForm();
        _isEditing = false;
    }

    private void ShowMessage(string message, bool isError)
    {
        _message = message;
        _isError = isError;
