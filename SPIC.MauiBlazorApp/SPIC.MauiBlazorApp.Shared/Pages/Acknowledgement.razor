@page "/Acknowledgement"


<div class="container-fluid py-4 px-0">
        
    <!-- Header Section -->
    <div class="ac-header-container">
        <div class="ac-header-text">
            <h1>Acknowledgement Cycle</h1>
            <p>Track and monitor acknowledgement turnaround time</p>
        </div>
        
        <div class="ac-action-buttons">
            <button class="ac-btn ac-btn-outline">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2v6h-6"></path><path d="M3 12a9 9 0 1 0 2.13-5.88L2 9"></path></svg>
                Refresh Data
            </button>
            <button class="ac-btn ac-btn-outline">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><path d="M8 13h2"></path><path d="M8 17h2"></path><path d="M14 13h2"></path><path d="M14 17h2"></path></svg>
                Excel
            </button>
            <button class="ac-btn ac-btn-outline">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><path d="M9 15v-4"></path><path d="M12 15v-4c1 0 2 1 2 2s-1 2-2 2"></path><path d="M16 11v4"></path><path d="M16 13h2"></path></svg>
                PDF
            </button>
            <button class="ac-btn ac-btn-solid">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
                Send Mail
            </button>
        </div>
    </div>

    <!-- 5-Column Statistics Grid -->
    <div class="ac-stats-grid">
        
        <!-- Total Transactions -->
        <div class="ac-stat-card ac-theme-purple">
            <div class="ac-card-top">
                <div class="ac-stat-info">
                    <span class="ac-stat-title">Total Transactions</span>
                    <span class="ac-stat-value">12,480</span>
                </div>
                <div class="ac-icon-box">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 2v20l2-2 2 2 2-2 2 2 2-2 2 2 2-2 2 2V2H4z"></path><line x1="16" y1="8" x2="8" y2="8"></line><line x1="16" y1="12" x2="8" y2="12"></line><line x1="10" y1="16" x2="8" y2="16"></line></svg>
                </div>
            </div>
            <div class="ac-stat-trend ac-text-purple">
                <span>All time</span>
            </div>
        </div>

        <!-- Fast -->
        <div class="ac-stat-card ac-theme-green">
            <div class="ac-card-top">
                <div class="ac-stat-info">
                    <span class="ac-stat-title">Fast (0-2 Days)</span>
                    <span class="ac-stat-value">4,216</span>
                </div>
                <div class="ac-icon-box">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line><path d="M9 16l2 2 4-4"></path></svg>
                </div>
            </div>
            <div class="ac-stat-trend ac-text-green">
                <svg class="ac-trend-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg>
                <span>3.18 Days vs last period</span>
            </div>
        </div>

        <!-- Normal -->
        <div class="ac-stat-card ac-theme-yellow">
            <div class="ac-card-top">
                <div class="ac-stat-info">
                    <span class="ac-stat-title">Normal (3-5 Days)</span>
                    <span class="ac-stat-value">1,530</span>
                </div>
                <div class="ac-icon-box">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                </div>
            </div>
            <div class="ac-stat-trend ac-text-green">
                <svg class="ac-trend-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg>
                <span>2.15% vs last period</span>
            </div>
        </div>

        <!-- Delayed -->
        <div class="ac-stat-card ac-theme-orange">
            <div class="ac-card-top">
                <div class="ac-stat-info">
                    <span class="ac-stat-title">Delayed (6-7 Days)</span>
                    <span class="ac-stat-value">10,300</span>
                </div>
                <div class="ac-icon-box">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                </div>
            </div>
            <div class="ac-stat-trend ac-text-green">
                <svg class="ac-trend-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg>
                <span>1.85% vs last period</span>
            </div>
        </div>

        <!-- Critical -->
        <div class="ac-stat-card ac-theme-red">
            <div class="ac-card-top">
                <div class="ac-stat-info">
                    <span class="ac-stat-title">Critical (> 7 Days)</span>
                    <span class="ac-stat-value">10,300</span>
                </div>
                <div class="ac-icon-box">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="7.86 2 16.14 2 22 7.86 22 16.14 16.14 22 7.86 22 2 16.14 2 7.86 7.86 2"></polygon><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                </div>
            </div>
            <div class="ac-stat-trend ac-text-green">
                <svg class="ac-trend-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg>
                <span>1.85% vs last period</span>
            </div>
        </div>

    </div>

    <!-- Filters Section (8 fields -> 4 Columns) -->
    <div class="ac-filter-card">
        <div class="ac-filter-header">
            <div class="ac-filter-title">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="6" x2="20" y2="6"></line><line x1="6" y1="12" x2="18" y2="12"></line><line x1="8" y1="18" x2="16" y2="18"></line></svg>
                Filters
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </div>
        
        <div class="ac-filter-body">
            <div class="ac-filter-grid">
                <div class="ac-form-group">
                    <label class="ac-form-label">Date Range</label>
                    <input type="text" class="ac-form-input ac-input-calendar" placeholder="01 Apr 2025 - 28 Apr 2025">
                </div>
                <div class="ac-form-group"><label class="ac-form-label">State</label><select class="ac-form-select"><option>All State</option></select></div>
                <div class="ac-form-group"><label class="ac-form-label">Region</label><select class="ac-form-select"><option>All Region</option></select></div>
                <div class="ac-form-group"><label class="ac-form-label">Head Quarters</label><select class="ac-form-select"><option>All Head Quarters</option></select></div>
                
                <div class="ac-form-group"><label class="ac-form-label">District</label><select class="ac-form-select"><option>All District</option></select></div>
                <div class="ac-form-group"><label class="ac-form-label">Sub District</label><select class="ac-form-select"><option>All Sub Districts</option></select></div>
                <div class="ac-form-group"><label class="ac-form-label">Dealer Name</label><select class="ac-form-select"><option>Select Dealer</option></select></div>
                <div class="ac-form-group"><label class="ac-form-label">Status</label><select class="ac-form-select"><option>All Status</option></select></div>
            </div>
            
            <div class="ac-filter-actions">
                <button class="ac-btn ac-btn-outline"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg> Clear All</button>
                <button class="ac-btn ac-btn-solid"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="6" x2="20" y2="6"></line><line x1="6" y1="12" x2="18" y2="12"></line><line x1="8" y1="18" x2="16" y2="18"></line></svg> Apply Filters</button>
            </div>
        </div>
    </div>

    <!-- Table Section -->
    <div class="ac-table-card">
        <div class="ac-table-top">
            <h3>Acknowledgement Cycle List</h3>
            <input type="text" class="ac-search-input" placeholder="Search zones...">
        </div>

        <div class="ac-table-wrapper">
            <table class="ac-main-table">
                <thead>
                    <tr>
                        <th><input type="checkbox" class="ac-checkbox"></th>
                        <th style="text-align: left;">Dealer Name</th>
                        <th>Product</th>
                        <th>Invoice No.</th>
                        <th>Invoice Date</th>
                        <th>Receipt Date</th>
                        <th>Ack Cycle (Days)</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><input type="checkbox" class="ac-checkbox"></td>
                        <td style="text-align: left; color: #475569; font-weight: 500;">Monsoon Agro Centre</td>
                        <td>Neem Coated Urea (45 Kg)</td>
                        <td>SAP2527/2025-26</td>
                        <td>01-05-2026</td>
                        <td>07-05-2026</td>
                        <td class="ac-txt-orange">7</td>
                        <td><div class="ac-status ac-st-orange"><div class="dot"></div>Delayed</div></td>
                        <td><button class="ac-action-btn" @onclick="OpenAcknowledgementDetails"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path><circle cx="12" cy="12" r="3"></circle></svg></button></td>
                    </tr>
                    <tr>
                        <td><input type="checkbox" class="ac-checkbox"></td>
                        <td style="text-align: left; color: #475569; font-weight: 500;">Monsoon Agro Centre</td>
                        <td>Neem Coated Urea (45 Kg)</td>
                        <td>SAP2527/2025-26</td>
                        <td>01-05-2026</td>
                        <td>01-05-2026</td>
                        <td class="ac-txt-green">0</td>
                        <td><div class="ac-status ac-st-green"><div class="dot"></div>Fast</div></td>
                        <td><button class="ac-action-btn" @onclick="OpenAcknowledgementDetails"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path><circle cx="12" cy="12" r="3"></circle></svg></button></td>
                    </tr>
                    <tr>
                        <td><input type="checkbox" class="ac-checkbox"></td>
                        <td style="text-align: left; color: #475569; font-weight: 500;">Monsoon Agro Centre</td>
                        <td>Neem Coated Urea (45 Kg)</td>
                        <td>SAP2527/2025-26</td>
                        <td>01-05-2026</td>
                        <td>06-05-2026</td>
                        <td class="ac-txt-yellow">5</td>
                        <td><div class="ac-status ac-st-yellow"><div class="dot"></div>Normal</div></td>
                        <td><button class="ac-action-btn" @onclick="OpenAcknowledgementDetails"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path><circle cx="12" cy="12" r="3"></circle></svg></button></td>
                    </tr>
                    <tr>
                        <td><input type="checkbox" class="ac-checkbox"></td>
                        <td style="text-align: left; color: #475569; font-weight: 500;">Monsoon Agro Centre</td>
                        <td>Neem Coated Urea (45 Kg)</td>
                        <td>SAP2527/2025-26</td>
                        <td>01-05-2026</td>
                        <td>10-05-2026</td>
                        <td class="ac-txt-red">10</td>
                        <td><div class="ac-status ac-st-red"><div class="dot"></div>Critical</div></td>
                        <td><button class="ac-action-btn" @onclick="OpenAcknowledgementDetails"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path><circle cx="12" cy="12" r="3"></circle></svg></button></td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="ac-pagination">
            <div class="ac-page-size">
                <span>Items Per Page</span>
                <select class="ac-form-select" style="padding: 6px 32px 6px 12px; width: 65px; margin:0; background-position: right 8px center;">
                    <option>16</option>
                </select>
            </div>
            <div class="ac-page-controls">
                <button class="ac-page-btn"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg></button>
                <button class="ac-page-btn active">1</button>
                <button class="ac-page-btn">2</button>
                <button class="ac-page-btn">3</button>
                <button class="ac-page-btn dots">..</button>
                <button class="ac-page-btn">8</button>
                <button class="ac-page-btn">9</button>
                <button class="ac-page-btn">10</button>
                <button class="ac-page-btn"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg></button>
            </div>
        </div>
    </div>
</div>

<AcknowledgementDetailsDrawer @bind-IsOpen="isAcknowledgementDetailsOpen" />

@code {
    private bool isAcknowledgementDetailsOpen = false;

    private void OpenAcknowledgementDetails()
    {
        isAcknowledgementDetailsOpen = true;
    }
}