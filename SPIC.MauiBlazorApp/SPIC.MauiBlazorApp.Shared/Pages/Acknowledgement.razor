@page "/Acknowledgement" 

    
    

<div class="container-fluid py-4 px-3 px-md-4" style="max-width: 1500px;">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="page-title">Acknowledgement Cycle</h1>
            <p class="page-subtitle mb-0">Track and monitor acknowledgement turnaround time</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button class="btn-outline-custom"><i class="bi bi-arrow-clockwise"></i> Refresh Data</button>
            <button class="btn-outline-custom"><i class="bi bi-file-earmark-spreadsheet"></i> Excel</button>
            <button class="btn-outline-custom"><i class="bi bi-file-earmark-pdf"></i> PDF</button>
            <button class="btn-primary-custom"><i class="bi bi-envelope"></i> Send Mail</button>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-5 g-3 mb-4">
        <div class="col">
            <div class="kpi-card kpi-purple">
                <div class="kpi-header">
                    <div>
                        <p class="kpi-label">Total Transactions</p>
                        <h2 class="kpi-value">12,480</h2>
                    </div>
                    <div class="kpi-icon-wrapper"><i class="bi bi-receipt"></i></div>
                </div>
                <div class="kpi-trend text-purple">All time</div>
            </div>
        </div>
        <div class="col">
            <div class="kpi-card kpi-green">
                <div class="kpi-header">
                    <div>
                        <p class="kpi-label">Fast (0-2 Days)</p>
                        <h2 class="kpi-value">4216</h2>
                    </div>
                    <div class="kpi-icon-wrapper"><i class="bi bi-calendar-check"></i></div>
                </div>
                <div class="kpi-trend text-green"><i class="bi bi-arrow-up-right"></i> 3.18 Days vs last period</div>
            </div>
        </div>
        <div class="col">
            <div class="kpi-card kpi-yellow">
                <div class="kpi-header">
                    <div>
                        <p class="kpi-label">Normal (3-5 Days)</p>
                        <h2 class="kpi-value">1530</h2>
                    </div>
                    <div class="kpi-icon-wrapper"><i class="bi bi-stars"></i></div>
                </div>
                <div class="kpi-trend text-green"><i class="bi bi-arrow-up-right"></i> 2.15% vs last period</div>
            </div>
        </div>
        <div class="col">
            <div class="kpi-card kpi-orange">
                <div class="kpi-header">
                    <div>
                        <p class="kpi-label">Delayed (6-7 Days)</p>
                        <h2 class="kpi-value">10,300</h2>
                    </div>
                    <div class="kpi-icon-wrapper"><i class="bi bi-hourglass-split"></i></div>
                </div>
                <div class="kpi-trend text-green"><i class="bi bi-arrow-up-right"></i> 1.85% vs last period</div>
            </div>
        </div>
        <div class="col">
            <div class="kpi-card kpi-red">
                <div class="kpi-header">
                    <div>
                        <p class="kpi-label">Critical (> 7 Days)</p>
                        <h2 class="kpi-value">10,300</h2>
                    </div>
                    <div class="kpi-icon-wrapper"><i class="bi bi-exclamation-octagon"></i></div>
                </div>
                <div class="kpi-trend text-green"><i class="bi bi-arrow-up-right"></i> 1.85% vs last period</div>
            </div>
        </div>
    </div>

    <div class="dashboard-card mb-4">
        <div class="filter-header">
            <span><i class="bi bi-funnel"></i> Filters</span>
            <i class="bi bi-chevron-down text-muted" style="cursor: pointer;"></i>
        </div>
        <div class="row g-3">
            <div class="col-md-3">
                <label class="filter-label">Date Range</label>
                <div class="position-relative">
                    <input type="text" class="custom-input pe-5" placeholder="01 Apr 2025 - 28 Apr 2025">
                    <i class="bi bi-calendar3 position-absolute" style="right:12px; top:50%; transform:translateY(-50%); color:#9ca3af; font-size:0.85rem;"></i>
                </div>
            </div>
            <div class="col-md-3">
                <label class="filter-label">State</label>
                <select class="form-select custom-input"><option>All State</option></select>
            </div>
            <div class="col-md-3">
                <label class="filter-label">Region</label>
                <select class="form-select custom-input"><option>All Region</option></select>
            </div>
            <div class="col-md-3">
                <label class="filter-label">Head Quarters</label>
                <select class="form-select custom-input"><option>All Head Quarters</option></select>
            </div>
            
            <div class="col-md-3">
                <label class="filter-label">District</label>
                <select class="form-select custom-input"><option>All District</option></select>
            </div>
            <div class="col-md-3">
                <label class="filter-label">Sub District</label>
                <select class="form-select custom-input"><option>All Sub Districts</option></select>
            </div>
            <div class="col-md-3">
                <label class="filter-label">Dealer Name</label>
                <select class="form-select custom-input"><option>Select Dealer</option></select>
            </div>
            <div class="col-md-3">
                <label class="filter-label">Status</label>
                <select class="form-select custom-input"><option>All Status</option></select>
            </div>
        </div>
        <div class="d-flex justify-content-end mt-4 gap-2">
            <button class="btn-outline-custom"><i class="bi bi-x"></i> Clear All</button>
            <button class="btn-primary-custom"><i class="bi bi-funnel"></i> Apply Filters</button>
        </div>
    </div>

    <div class="dashboard-card pb-2">
        <div class="table-header-row">
            <h3 class="card-title">Acknowledgement Cycle List</h3>
            <div class="search-container">
                <i class="bi bi-search"></i>
                <input type="text" class="search-input" placeholder="Search zones...">
            </div>
        </div>
        
        <div class="table-responsive">
            <table class="table table-borderless custom-table">
                <thead>
                    <tr>
                        <th style="width: 40px;"><input class="form-check-input" type="checkbox"></th>
                        <th>Dealer Name</th>
                        <th>Product</th>
                        <th>Invoice No.</th>
                        <th>Invoice Date</th>
                        <th>Receipt Date</th>
                        <th>Ack Cycle (Days)</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><input class="form-check-input" type="checkbox"></td>
                        <td class="fw-medium">Monsoon Agro Centre</td>
                        <td>Neem Coated Urea (45 Kg)</td>
                        <td>SAP2527/2025-26</td>
                        <td>01-05-2026</td>
                        <td>07-05-2026</td>
                        <td class="ack-cycle-val" style="color: #f59e0b;">7</td>
                        <td><div class="status-badge status-delayed"><span class="status-dot"></span> Delayed</div></td>
                        <td><button class="action-icon"><i class="bi bi-eye"></i></button></td>
                    </tr>
                    <tr>
                        <td><input class="form-check-input" type="checkbox"></td>
                        <td class="fw-medium">Monsoon Agro Centre</td>
                        <td>Neem Coated Urea (45 Kg)</td>
                        <td>SAP2527/2025-26</td>
                        <td>01-05-2026</td>
                        <td>01-05-2026</td>
                        <td class="ack-cycle-val" style="color: #10b981;">0</td>
                        <td><div class="status-badge status-fast"><span class="status-dot"></span> Fast</div></td>
                        <td><button class="action-icon"><i class="bi bi-eye"></i></button></td>
                    </tr>
                    <tr>
                        <td><input class="form-check-input" type="checkbox"></td>
                        <td class="fw-medium">Monsoon Agro Centre</td>
                        <td>Neem Coated Urea (45 Kg)</td>
                        <td>SAP2527/2025-26</td>
                        <td>01-05-2026</td>
                        <td>06-05-2026</td>
                        <td class="ack-cycle-val" style="color: #eab308;">5</td>
                        <td><div class="status-badge status-normal"><span class="status-dot"></span> Normal</div></td>
                        <td><button class="action-icon"><i class="bi bi-eye"></i></button></td>
                    </tr>
                    <tr>
                        <td><input class="form-check-input" type="checkbox"></td>
                        <td class="fw-medium">Monsoon Agro Centre</td>
                        <td>Neem Coated Urea (45 Kg)</td>
                        <td>SAP2527/2025-26</td>
                        <td>01-05-2026</td>
                        <td>10-05-2026</td>
                        <td class="ack-cycle-val" style="color: #ef4444;">10</td>
                        <td><div class="status-badge status-critical"><span class="status-dot"></span> Critical</div></td>
                        <td><button class="action-icon"><i class="bi bi-eye"></i></button></td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="pagination-container mt-2">
            <div class="items-per-page">
                Items Per Page 
                <select class="form-select form-select-sm" style="width: 70px; background-color: #fff;">
                    <option>16</option>
                    <option>25</option>
                </select>
            </div>
            <div class="d-flex gap-1">
                <a class="page-item"><i class="bi bi-chevron-left"></i></a>
                <a class="page-item active">1</a>
                <a class="page-item">2</a>
                <a class="page-item">3</a>
                <span class="page-item dots">..</span>
                <a class="page-item">8</a>
                <a class="page-item">9</a>
                <a class="page-item">10</a>
                <a class="page-item"><i class="bi bi-chevron-right"></i></a>
            </div>
        </div>
    </div>
</div>

