@page "/Treatment01"

<div class="container-fluid py-4 treatment-page">

    <PageHeader Title="Treatment 01"
                Subtitle="Track treatment details and field observation">
    </PageHeader>
    <div class="treatment-header">

        <div class="header-left">

            <h5>
                Treatment 01 - Details
                <span class="completed-badge">
                    <i class="bi bi-check-circle"></i>
                    Completed
                </span>
            </h5>


            <small>
                Completed on 14 Aug 2026, 10:45 AM
            </small>

        </div>



        <div class="header-actions">

            <button class="outline-btn">
                <i class="bi bi-arrow-left"></i>
                Back to Demo Detail
            </button>


            <button class="outline-btn">
                <i class="bi bi-clock-history"></i>
                Treatment History
            </button>


            <button class="primary-btn">
                Start Next Treatment
                <i class="bi bi-arrow-right"></i>
            </button>

        </div>

    </div>





    <div class="section-card farmer-summary-card">


        <div class="farmer-grid">


            <div class="farmer-item">

                <i class="bi bi-person farmer-icon"></i>

                <div>
                    <label>Farmer</label>
                    <strong>M Kanniyappan</strong>
                </div>

            </div>



            <div class="farmer-item">

                <i class="bi bi-phone farmer-icon purple"></i>

                <div>
                    <label>Mobile Number</label>
                    <strong>7094100291</strong>
                </div>

            </div>




            <div class="farmer-item">

                <i class="bi bi-geo-alt farmer-icon blue"></i>

                <div>
                    <label>District</label>
                    <strong>Kanchipuram</strong>
                </div>

            </div>




            <div class="farmer-item">

                <i class="bi bi-building farmer-icon green"></i>

                <div>
                    <label>State</label>
                    <strong>Tamil Nadu</strong>
                </div>

            </div>




            <div class="farmer-item">

                <i class="bi bi-pin-map farmer-icon yellow"></i>

                <div>
                    <label>Pin Code</label>
                    <strong>603 207</strong>
                </div>

            </div>


        </div>




        <div class="location-box">

            <i class="bi bi-geo-alt"></i>

            Maruththattam Village, Kanchipuram Dt, Tamil Nadu St, 602 307

        </div>


    </div>

    <div class="section-card visit-summary-card">

        <h6>Visit Details</h6>

        <div class="visit-grid">

            <div class="visit-item">
                <label>Visit Date</label>
                <div class="visit-value">14 Aug 2026</div>
            </div>

            <div class="visit-item">
                <label>Field Officer / Visited By</label>
                <div class="visit-value">Aravind Kumar</div>
            </div>

            <div class="visit-item">
                <label>Current Plant Stage</label>
                <div class="visit-value">Seedling Stage</div>
            </div>

            <div class="visit-item">
                <label>Plant Condition</label>
                <div class="visit-value">Excellent</div>
            </div>

        </div>
    </div>


    <div class="section-card treatment-summary-card">

        <h6>
            Treatment Applied
        </h6>


        <div class="treatment-grid">


            <div class="treatment-item">

                <label>
                    Product Used
                </label>

                <div class="treatment-value">
                    SPICWASH (Thiamethoxam 25% WG)
                </div>

            </div>



            <div class="treatment-item">

                <label>
                    Dosage
                </label>

                <div class="treatment-value">
                    2.5 ml/l
                </div>

            </div>




            <div class="treatment-item">

                <label>
                    Application Method
                </label>

                <div class="treatment-value">
                    Foliar Spray
                </div>

            </div>




            <div class="treatment-item">

                <label>
                    Treatment
                </label>

                <div class="treatment-value">
                    Excellent
                </div>

            </div>


        </div>



        <div class="treatment-grid bottom-row">


            <div class="treatment-item">

                <label>
                    Stage of Application
                </label>

                <div class="treatment-value">
                    Crop Stage at application
                </div>

            </div>



            <div class="treatment-item remarks-box">

                <label>
                    Remarks
                </label>

                <div class="remarks-value">
                    Any Additional Remarks...
                </div>

            </div>


        </div>


    </div>


    <div class="section-card">

        <h6>Observations</h6>

        <div class="grid-2">

            <div>
                <label>Physical Parameters</label>
                <textarea class="form-control" placeholder="Plant height, leaf count, stem girth, colour..."></textarea>
            </div>

            <div>
                <label>Yield Parameters</label>
                <textarea class="form-control" placeholder="Tiller count, panicle length, grain filling..."></textarea>
            </div>

        </div>


        <label class="mt-3">Quick Observations</label>

        <div class="chips">
            <span>Increase of More Branches</span>
            <span>Increase of More Branches</span>
            <span>Increase of More Branches</span>
            <span>Increase of More Branches</span>
        </div>


        <label class="mt-3">Observation Notes</label>
        <textarea class="form-control" placeholder="Detailed Field Observation Notes..."></textarea>

    </div>


    <div class="image-grid">


        <!-- Control Images -->

        <div class="image-card">

            <h6>
                Control Images
            </h6>


            <div class="image-preview-list">

                <img src="images/control1.jpg" />
                <img src="images/control2.jpg" />
                <img src="images/control3.jpg" />
                <img src="images/control4.jpg" />
                <img src="images/control5.jpg" />

            </div>


            <button class="view-images-btn">

                <span>
                    View All Images (15)
                </span>

                <i class="bi bi-chevron-right"></i>

            </button>


        </div>




        <!-- Treated Images -->


        <div class="image-card">

            <h6>
                Treated Images
            </h6>


            <div class="image-preview-list">

                <img src="images/treated1.jpg" />
                <img src="images/treated2.jpg" />
                <img src="images/treated3.jpg" />
                <img src="images/treated4.jpg" />
                <img src="images/treated5.jpg" />

            </div>


            <button class="view-images-btn">

                <span>
                    View All Images (15)
                </span>

                <i class="bi bi-chevron-right"></i>

            </button>


        </div>


    </div>


    <div class="section-card problem-summary-card">

        <h6>
            Problem Identification & Recommendation
        </h6>


        <div class="problem-tags">

            <span class="tag warning">
                <i class="bi bi-exclamation-triangle"></i>
                Yes, problem identified
            </span>


            <span class="tag danger">
                Pest Attack
            </span>


            <span class="tag warning">
                Low Severity
            </span>

        </div>



        <div class="problem-field warning-box">

            <label>
                Problem Description
            </label>


            <div class="problem-value">
                Slight aphid infection noted on lower leaf surfaces. Limited spread.
            </div>

        </div>




        <div class="problem-field info-box">

            <label>
                Recommendation / Monitoring Action
            </label>


            <div class="problem-value">
                Continue monitoring. Use trap installation.
            </div>

        </div>


    </div>
    <div class="treatment-actions">

        <button class="save-draft-btn">

            <i class="bi bi-save"></i>

            Save Draft

        </button>



        <button class="complete-btn">

            Complete First Treatment

            <i class="bi bi-chevron-right"></i>

        </button>


    </div>
</div>
