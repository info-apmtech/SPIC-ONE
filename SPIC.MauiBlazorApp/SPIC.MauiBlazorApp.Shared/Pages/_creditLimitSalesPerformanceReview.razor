	private string GetFertilizerCategoryName()
	{
		return Categories
			.FirstOrDefault(c =>
				!string.IsNullOrWhiteSpace(c.Name) &&
				c.Name.Contains("Fertilizer", StringComparison.OrdinalIgnoreCase))
			?.Name ?? "Fertilizer";
	}

	private string GetSpecialtyMtCategoryName()
	{
		return Categories
			.FirstOrDefault(c =>
			{
				var unitName = Units.FirstOrDefault(u => u.Id == c.UnitId)?.Name ?? "";

				return !string.IsNullOrWhiteSpace(c.Name) &&
					   (
						   c.Name.Contains("Speciality", StringComparison.OrdinalIgnoreCase) ||
						   c.Name.Contains("Specialty", StringComparison.OrdinalIgnoreCase)
					   ) &&
					   (
						   unitName.Contains("MT", StringComparison.OrdinalIgnoreCase) ||
						   unitName.Contains("Gr", StringComparison.OrdinalIgnoreCase)
					   );
			})
			?.Name ?? "Specialty Products - MT";
	}

	private string GetSpecialtyLtrCategoryName()
	{
		return Categories
			.FirstOrDefault(c =>
			{
				var unitName = Units.FirstOrDefault(u => u.Id == c.UnitId)?.Name ?? "";

				return !string.IsNullOrWhiteSpace(c.Name) &&
					   (
						   c.Name.Contains("Speciality", StringComparison.OrdinalIgnoreCase) ||
						   c.Name.Contains("Specialty", StringComparison.OrdinalIgnoreCase)
					   ) &&
					   (
						   unitName.Contains("Ltr", StringComparison.OrdinalIgnoreCase) ||
						   unitName.Contains("Liq", StringComparison.OrdinalIgnoreCase) ||
						   unitName.Contains("Litre", StringComparison.OrdinalIgnoreCase) ||
						   unitName.Contains("Liter", StringComparison.OrdinalIgnoreCase)
					   );
			})
			?.Name ?? "Specialty Products - Ltr";
	}
	private static string Disp(decimal? v) => v.HasValue ? v.Value.ToString("N2") : "-";
