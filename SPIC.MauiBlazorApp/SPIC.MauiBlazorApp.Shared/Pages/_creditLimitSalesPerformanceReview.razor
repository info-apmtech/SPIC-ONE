@using SPIC.Core.Entities

<style>
	.group-row {
		cursor: pointer;
		font-weight: 600;
	}

		.group-row td {
			border-top: 2px solid #dee2e6;
		}

	.expand-icon {
		margin-right: 8px;
		font-size: 0.8em;
		display: inline-block;
		width: 12px;
	}

	.fy-breakup-card {
		border: 1px solid #E5E7EB;
		border-left: 4px solid #8A8A8A;
		border-radius: 10px;
		padding: 14px 16px;
		background: #fff;
		min-height: 230px;
	}

		.fy-breakup-card.green {
			background: #166522;
			color: #fff;
			border-left-color: #166522;
		}

	.fy-breakup-title {
		font-weight: 700;
		font-size: 14px;
		color: #111827;
		text-align: center;
		margin-bottom: 12px;
	}

	.fy-breakup-card.green .fy-breakup-title {
		color: #fff;
	}

	.fy-breakup-row {
		display: flex;
		justify-content: space-between;
		gap: 8px;
		padding: 6px 0;
		border-bottom: 1px solid #E5E7EB;
		font-size: 12px;
	}

	.fy-breakup-card.green .fy-breakup-row {
		border-bottom-color: rgba(255,255,255,0.25);
	}

	.fy-breakup-row span {
		color: #30343b;
		width: 48%;
		line-height: 1.3;
	}

	.fy-breakup-row strong {
		width: 52%;
		color: #111827;
		text-align: right;
		font-weight: 700;
		line-height: 1.3;
	}

	.fy-breakup-card.green .fy-breakup-row span {
		color: #D1FAE5;
	}

	.fy-breakup-row strong {
		color: #111827;
		text-align: right;
		font-weight: 700;
	}

	.fy-breakup-card.green .fy-breakup-row strong {
		color: #fff;
	}

	.fy-breakup-total {
		display: flex;
		justify-content: space-between;
		gap: 8px;
		margin-top: 10px;
		padding-top: 10px;
		font-size: 12px;
		font-weight: 700;
	}

		.fy-breakup-total strong {
			color: #111827;
			text-align: right;
		}

	.fy-breakup-card.green .fy-breakup-total strong,
	.fy-breakup-card.green .fy-breakup-total span {
		color: #fff;
	}
</style>
<div class="form-card">
	<div class="d-flex justify-content-between align-items-center mb-1">
    @{
		var headerTitle = !string.IsNullOrWhiteSpace(Company)
			? $"{Company} Sales Performance Review"
			: "Sales Performance Review";
	}
	<div class="section-title">
		<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/SalesPerformaReview.svg"
			 class="formicon" />
		@headerTitle
	</div>

		<button class="btn-verified">
			Values in @SelectedUnitName
		</button>
	</div>

	<div class="financial-note-box">
		<div class="financial-note-badge">
			Only last 3 completed financial years are allowed
		</div>
	</div>

	@* Prepare category list and displayed rows based on Company *@
	@{
		var fertilizerCats = Categories.Where(c => c.Name != null && c.Name.Contains("Fertilizer", StringComparison.OrdinalIgnoreCase)).ToList();
		var fertilizerCatIds = fertilizerCats.Select(c => c.Id).ToHashSet();

		var renderCategories = (Company != null && Company.Equals("SPIC", StringComparison.OrdinalIgnoreCase))
			? fertilizerCats
			: Categories;

		// Determine displayed rows based on company rules
		var displayedRows = SalesPerfRows ?? new List<SalesPerfViewRow>();

		if (!string.IsNullOrEmpty(Company) && Company.Equals("SPIC", StringComparison.OrdinalIgnoreCase))
{
    // SPIC: show only exact Urea product
    // This removes Technical Grade Urea only for SPIC
    if (SelectedCategoryId > 0 && fertilizerCatIds.Contains(SelectedCategoryId))
    {
        displayedRows = displayedRows
            .Where(r => !string.IsNullOrWhiteSpace(r.ProductName) &&
                        r.ProductName.Trim().Equals("Urea", StringComparison.OrdinalIgnoreCase))
            .ToList();
    }
    else
    {
        displayedRows = new List<SalesPerfViewRow>();
    }
}
else if (!string.IsNullOrEmpty(Company) && Company.Equals("GreenStar", StringComparison.OrdinalIgnoreCase))
{
    // GreenStar: keep Technical Grade Urea / other non-Urea products
    // Only exclude exact Urea
    if (SelectedCategoryId > 0 && fertilizerCatIds.Contains(SelectedCategoryId))
    {
        displayedRows = displayedRows
            .Where(r => string.IsNullOrWhiteSpace(r.ProductName) ||
                        !r.ProductName.Trim().Equals("Urea", StringComparison.OrdinalIgnoreCase))
            .ToList();
    }
}
	}

	<div class="custom-tabs">
		@foreach (var cat in renderCategories)
		{
			var catId = cat.Id;
			var unitName = Units.FirstOrDefault(u => u.Id == cat.UnitId)?.Name ?? "";

			<div class="tab-btn @(catId == SelectedCategoryId ? "active" : "")"
				 @onclick="async () => await OnCategoryChanged.InvokeAsync(catId)"
				 style="cursor:pointer;">
				@cat.Name (@unitName / Value)
			</div>
		}
	</div>

	<div class="table-wrapper">
		<div class="table-responsive-for-review">
			<table class="spic-table">
				<thead>
					<tr>
						<th rowspan="2" style="min-width: 180px;">
							Product Name / Category
						</th>

						@for (int fi = 0; fi < 3; fi++)
						{
							var fyIdx = fi;

							<th colspan="2" class="text-center border-start">
								<select class="form-select form-select-sm text-center"
										value="@GetSelectedFY(fyIdx)"
										disabled>
									<option value="@GetSelectedFY(fyIdx)">
										@GetFYName(fyIdx)
									</option>
								</select>
							</th>
						}
					</tr>

					<tr>
						@for (int fi = 0; fi < 3; fi++)
						{
							<th class="text-center text-muted fw-normal border-start">
								@(!string.IsNullOrEmpty(SelectedUnitName) ? SelectedUnitName : "MT")
							</th>
							<th class="text-center text-muted fw-normal">
								Lakhs
							</th>
						}
					</tr>
				</thead>

				@{
					var isFertilizerSelected = SelectedCategoryId > 0 && fertilizerCatIds.Contains(SelectedCategoryId);

					List<GroupData> groupedRows;

					if (isFertilizerSelected)
					{
						// Fertilizer -> only two buckets: Urea vs Other Products
						groupedRows = displayedRows
							.GroupBy(r => !string.IsNullOrWhiteSpace(r.ProductName) &&
										  r.ProductName.Trim().Equals("Urea", StringComparison.OrdinalIgnoreCase)) // true = Urea
							.OrderByDescending(g => g.Key) // Urea first (optional)
							.Select(g => new GroupData
							{
								ProductGroupId = g.Key ? -1 : -2, // sentinel keys for expand/collapse
								GroupName = g.Key ? "Fertilizer - Urea" : "Fertilizer - Other Products",
								Rows = g.ToList()
							})
							.ToList();
					}
					else
					{
						// Default: group by ProductGroupId (Specialty, etc.)
						groupedRows = displayedRows
							.GroupBy(r =>
							{
								var product = Products?.FirstOrDefault(p => p.Id == r.ProductId);
								return product?.ProductGroupId;
							})
							.OrderBy(g =>
							{
								if (g.Key == null) return "";
								var pg = ProductGroups?.FirstOrDefault(p => p.Id == g.Key);
								return pg?.Name ?? "";
							})
							.Select(g =>
							{
								var pg = g.Key.HasValue ? ProductGroups?.FirstOrDefault(p => p.Id == g.Key.Value) : null;
								return new GroupData
								{
									ProductGroupId = g.Key,
									GroupName = pg?.Name ?? "Uncategorized",
									Rows = g.ToList()
								};
							})
							.ToList();
					}
				}

				@foreach (var group in groupedRows)
				{
					<tbody>
						<tr class="group-row" @onclick="() => ToggleGroup(group.ProductGroupId)">
							<td class="fw-medium text-dark">
								<span class="expand-icon">@(IsExpanded(group.ProductGroupId) ? "▼" : "▶")</span>
								@group.GroupName
							</td>
							<td class="border-start fw-bold text-center">
								@(group.Rows.Any(r => r.FY1Qty.HasValue) ? group.Rows.Sum(r => r.FY1Qty ?? 0).ToString("N2") : "-")
							</td>
							<td class="fw-bold text-center">
								@(group.Rows.Any(r => r.FY1Amount.HasValue) ? group.Rows.Sum(r => r.FY1Amount ?? 0).ToString("N2") : "-")
							</td>
							<td class="border-start fw-bold text-center">
								@(group.Rows.Any(r => r.FY2Qty.HasValue) ? group.Rows.Sum(r => r.FY2Qty ?? 0).ToString("N2") : "-")
							</td>
							<td class="fw-bold text-center">
								@(group.Rows.Any(r => r.FY2Amount.HasValue) ? group.Rows.Sum(r => r.FY2Amount ?? 0).ToString("N2") : "-")
							</td>
							<td class="border-start fw-bold text-center">
								@(group.Rows.Any(r => r.FY3Qty.HasValue) ? group.Rows.Sum(r => r.FY3Qty ?? 0).ToString("N2") : "-")
							</td>
							<td class="fw-bold text-center">
								@(group.Rows.Any(r => r.FY3Amount.HasValue) ? group.Rows.Sum(r => r.FY3Amount ?? 0).ToString("N2") : "-")
							</td>
						</tr>
						@if (IsExpanded(group.ProductGroupId))
						{
							@foreach (var row in group.Rows)
							{
								<tr>
									<td class="fw-medium text-dark" style="padding-left: 24px;">@row.ProductName</td>
									<td class="border-start">
										<input class="table-input" type="text" value="@Disp(row.FY1Qty)" readonly />
									</td>
									<td>
										<input class="table-input" type="text" value="@Disp(row.FY1Amount)" readonly />
									</td>
									<td class="border-start">
										<input class="table-input" type="text" value="@Disp(row.FY2Qty)" readonly />
									</td>
									<td>
										<input class="table-input" type="text" value="@Disp(row.FY2Amount)" readonly />
									</td>
									<td class="border-start">
										<input class="table-input" type="text" value="@Disp(row.FY3Qty)" readonly />
									</td>
									<td>
										<input class="table-input" type="text" value="@Disp(row.FY3Amount)" readonly />
									</td>
								</tr>
							}
						}
					</tbody>
				}

				<tfoot>
					<tr>
						<td class="fw-bold text-end">Total</td>

						@for (int fi = 0; fi < 3; fi++)
						{
							var fyIdx = fi;

							<td class="border-start fw-bold text-center">
								@displayedRows.Sum(r => fyIdx == 0 ? (r.FY1Qty ?? 0) : fyIdx == 1 ? (r.FY2Qty ?? 0) : (r.FY3Qty ?? 0)).ToString("N2")
							</td>
							<td class="fw-bold text-center">
								@displayedRows.Sum(r => fyIdx == 0 ? (r.FY1Amount ?? 0) : fyIdx == 1 ? (r.FY2Amount ?? 0) : (r.FY3Amount ?? 0)).ToString("N2")
							</td>
						}
					</tr>
				</tfoot>
			</table>
		</div>
	</div>

	<div class="row g-3 mt-2">

		@for (int fi = 0; fi < 3; fi++)
		{
			var fyIdx = fi;
			var fyName = GetFYName(fyIdx);

			<div class="col-md-3">
				<div class="perf-card">
					<div class="perf-year">@fyName</div>
					<div class="perf-val">
						<span class="fw-bold">
							@displayedRows.Sum(r => fyIdx == 0 ? (r.FY1Qty ?? 0) : fyIdx == 1 ? (r.FY2Qty ?? 0) : (r.FY3Qty ?? 0)).ToString("N2")
						</span>
						<span class="fw-bold"> / ₹ </span>
						<span class="fw-bold">
							@displayedRows.Sum(r => fyIdx == 0 ? (r.FY1Amount ?? 0) : fyIdx == 1 ? (r.FY2Amount ?? 0) : (r.FY3Amount ?? 0)).ToString("N2")
						</span>
						<span style="font-size:0.75rem; font-weight:normal; color:#6B7280;">
							Lakhs
						</span>
					</div>
				</div>
			</div>
		}

		@if (ShowSalesPlanCard)
		{
		<div class="col-md-3">
			@{
				var salesPlanUnit = !string.IsNullOrWhiteSpace(SalesPlanUnitName)
					? SalesPlanUnitName
					: (!string.IsNullOrWhiteSpace(SelectedUnitName) ? SelectedUnitName : "MT");
			}

			<div class="perf-card green position-relative">
				<div class="perf-year">
					@(!string.IsNullOrEmpty(SalesPlanCardTitle) ? SalesPlanCardTitle : "Sales Plan (Current FY)")
				</div>

				<div class="perf-val">
					@SalesPlanTotalQty.ToString("N2")
					<span style="font-size:0.75rem; font-weight:normal; color:#A7F3D0;">
						@salesPlanUnit
					</span>
					/ ₹ @SalesPlanTotalAmount.ToString("N2")
					<span style="font-size:0.75rem; font-weight:normal; color:#A7F3D0;">
						Lakhs
					</span>
				</div>
			</div>
		</div>
		}
	</div>
	@if (!string.IsNullOrEmpty(Company) && Company.Equals("GreenStar", StringComparison.OrdinalIgnoreCase))
	{
		var fy1FertQty = FertilizerFY1Qty;
		var fy1FertAmt = FertilizerFY1Amount;
		var fy1SpGrQty = GetSpecialtyMtQty(0);
		var fy1SpGrAmt = GetSpecialtyMtAmount(0);
		var fy1SpLtrQty = GetSpecialtyLtrQty(0);
		var fy1SpLtrAmt = GetSpecialtyLtrAmount(0);
		var fy1SpLakhs = fy1SpGrAmt + fy1SpLtrAmt;
		var fy1Total = fy1FertAmt + fy1SpLakhs;

		var fy2FertQty = FertilizerFY2Qty;
		var fy2FertAmt = FertilizerFY2Amount;
		var fy2SpGrQty = GetSpecialtyMtQty(1);
		var fy2SpGrAmt = GetSpecialtyMtAmount(1);
		var fy2SpLtrQty = GetSpecialtyLtrQty(1);
		var fy2SpLtrAmt = GetSpecialtyLtrAmount(1);
		var fy2SpLakhs = fy2SpGrAmt + fy2SpLtrAmt;
		var fy2Total = fy2FertAmt + fy2SpLakhs;

		var fy3FertQty = FertilizerFY3Qty;
		var fy3FertAmt = FertilizerFY3Amount;
		var fy3SpGrQty = GetSpecialtyMtQty(2);
		var fy3SpGrAmt = GetSpecialtyMtAmount(2);
		var fy3SpLtrQty = GetSpecialtyLtrQty(2);
		var fy3SpLtrAmt = GetSpecialtyLtrAmount(2);
		var fy3SpLakhs = fy3SpGrAmt + fy3SpLtrAmt;
		var fy3Total = fy3FertAmt + fy3SpLakhs;

		var totalFertQty = fy1FertQty + fy2FertQty + fy3FertQty;
		var totalFertAmt = fy1FertAmt + fy2FertAmt + fy3FertAmt;

		var totalSpGrQty = fy1SpGrQty + fy2SpGrQty + fy3SpGrQty;
		var totalSpGrAmt = fy1SpGrAmt + fy2SpGrAmt + fy3SpGrAmt;

		var totalSpLtrQty = fy1SpLtrQty + fy2SpLtrQty + fy3SpLtrQty;
		var totalSpLtrAmt = fy1SpLtrAmt + fy2SpLtrAmt + fy3SpLtrAmt;

		var totalSpLakhs = fy1SpLakhs + fy2SpLakhs + fy3SpLakhs;
		var grandTotal = fy1Total + fy2Total + fy3Total;
		var fertilizerLabel = GetFertilizerCategoryName();
		var specialtyMtLabel = GetSpecialtyMtCategoryName();
		var specialtyLtrLabel = GetSpecialtyLtrCategoryName();
		var specialtyTotalLabel = "Total Specialty Products";

		<div class="row g-3 mt-3">

			<div class="col-md-3">
				<div class="fy-breakup-card">
					<div class="fy-breakup-title">@GetFYName(0)</div>

					<div class="fy-breakup-row">
						<span>@fertilizerLabel</span>
						<strong>@fy1FertQty.ToString("N2") MT / ₹ @fy1FertAmt.ToString("N2") Lakhs</strong>
					</div>

					<div class="fy-breakup-row">
						<span>@specialtyMtLabel</span>
						<strong>@fy1SpGrQty.ToString("N2") MT / ₹ @fy1SpGrAmt.ToString("N2") Lakhs</strong>
					</div>

					<div class="fy-breakup-row">
						<span>@specialtyLtrLabel</span>
						<strong>@fy1SpLtrQty.ToString("N2") Ltr / ₹ @fy1SpLtrAmt.ToString("N2") Lakhs</strong>
					</div>

					<div class="fy-breakup-row">
						<span>@specialtyTotalLabel</span>
						<strong>₹ @fy1SpLakhs.ToString("N2") Lakhs</strong>
					</div>

					<div class="fy-breakup-total">
						<span>@GetFYName(0) TO in Lakhs</span>
						<strong>₹ @fy1Total.ToString("N2") Lakhs</strong>
					</div>
				</div>
			</div>

			<div class="col-md-3">
				<div class="fy-breakup-card">
					<div class="fy-breakup-title">@GetFYName(1)</div>

					<div class="fy-breakup-row">
						<span>@fertilizerLabel</span>
						<strong>@fy2FertQty.ToString("N2") MT / ₹ @fy2FertAmt.ToString("N2") Lakhs</strong>
					</div>

					<div class="fy-breakup-row">
						<span>@specialtyMtLabel</span>
						<strong>@fy2SpGrQty.ToString("N2") MT / ₹ @fy2SpGrAmt.ToString("N2") Lakhs</strong>
					</div>

					<div class="fy-breakup-row">
						<span>@specialtyLtrLabel</span>
						<strong>@fy2SpLtrQty.ToString("N2") Ltr / ₹ @fy2SpLtrAmt.ToString("N2") Lakhs</strong>
					</div>

					<div class="fy-breakup-row">
						<span>@specialtyTotalLabel</span>
						<strong>₹ @fy2SpLakhs.ToString("N2") Lakhs</strong>
					</div>

					<div class="fy-breakup-total">
						<span>@GetFYName(1) TO in Lakhs</span>
						<strong>₹ @fy2Total.ToString("N2") Lakhs</strong>
					</div>
				</div>
			</div>

			<div class="col-md-3">
				<div class="fy-breakup-card">
					<div class="fy-breakup-title">@GetFYName(2)</div>

					<div class="fy-breakup-row">
						<span>@fertilizerLabel</span>
						<strong>@fy3FertQty.ToString("N2") MT / ₹ @fy3FertAmt.ToString("N2") Lakhs</strong>
					</div>

					<div class="fy-breakup-row">
						<span>@specialtyMtLabel</span>
						<strong>@fy3SpGrQty.ToString("N2") MT / ₹ @fy3SpGrAmt.ToString("N2") Lakhs</strong>
					</div>

					<div class="fy-breakup-row">
						<span>@specialtyLtrLabel</span>
						<strong>@fy3SpLtrQty.ToString("N2") Ltr / ₹ @fy3SpLtrAmt.ToString("N2") Lakhs</strong>
					</div>

					<div class="fy-breakup-row">
						<span>@specialtyTotalLabel</span>
						<strong>₹ @fy3SpLakhs.ToString("N2") Lakhs</strong>
					</div>

					<div class="fy-breakup-total">
						<span>@GetFYName(2) TO in Lakhs</span>
						<strong>₹ @fy3Total.ToString("N2") Lakhs</strong>
					</div>
				</div>
			</div>

			<div class="col-md-3">
				<div class="fy-breakup-card green">
					<div class="fy-breakup-title">@SalesPlanBreakupCardTitle</div>

					<div class="fy-breakup-row">
						<span>@fertilizerLabel</span>
						<strong>@SalesPlanFertilizerVolume.ToString("N2") MT / ₹ @SalesPlanFertilizerAmount.ToString("N2") Lakhs</strong>
					</div>

					<div class="fy-breakup-row">
						<span>@specialtyMtLabel</span>
						<strong>@SalesPlanSpecialtyGrVolume.ToString("N2") MT / ₹ @SalesPlanSpecialtyGrAmount.ToString("N2") Lakhs</strong>
					</div>

					<div class="fy-breakup-row">
						<span>@specialtyLtrLabel</span>
						<strong>@SalesPlanSpecialtyLiqVolume.ToString("N2") Ltr / ₹ @SalesPlanSpecialtyLiqAmount.ToString("N2") Lakhs</strong>
					</div>

					<div class="fy-breakup-row">
						<span>@specialtyTotalLabel</span>
						<strong>₹ @((SalesPlanSpecialtyGrAmount + SalesPlanSpecialtyLiqAmount).ToString("N2")) Lakhs</strong>
					</div>

					<div class="fy-breakup-total">
						<span>Grand Total</span>
						<strong>₹ @((SalesPlanFertilizerAmount + SalesPlanSpecialtyGrAmount + SalesPlanSpecialtyLiqAmount).ToString("N2")) Lakhs</strong>
					</div>
				</div>
			</div>

		</div>
	}
</div>

@code {
	[Parameter] public List<Category> Categories { get; set; } = new();
	[Parameter] public List<Unit> Units { get; set; } = new();
	[Parameter] public List<FinancialYear> FinancialYears { get; set; } = new();
	[Parameter] public List<Product> Products { get; set; } = new();
	[Parameter] public List<ProductGroup> ProductGroups { get; set; } = new();

	[Parameter] public List<SalesPerfViewRow> SalesPerfRows { get; set; } = new();

	[Parameter] public int SelectedCategoryId { get; set; }
	[Parameter] public string SelectedUnitName { get; set; } = "MT";
	[Parameter] public string Company { get; set; } = "";

	[Parameter] public int FY1 { get; set; }
	[Parameter] public int FY2 { get; set; }
	[Parameter] public int FY3 { get; set; }

	[Parameter] public decimal SalesPlanTotalQty { get; set; }
	[Parameter] public decimal SalesPlanTotalAmount { get; set; }
	[Parameter] public string SalesPlanCardTitle { get; set; } = "Sales Plan (Current FY)";
	[Parameter] public string SalesPlanUnitName { get; set; } = "";
	[Parameter] public decimal FertilizerFY1Qty { get; set; }
	[Parameter] public decimal FertilizerFY1Amount { get; set; }
	[Parameter] public decimal FertilizerFY2Qty { get; set; }
	[Parameter] public decimal FertilizerFY2Amount { get; set; }
	[Parameter] public decimal FertilizerFY3Qty { get; set; }
	[Parameter] public decimal FertilizerFY3Amount { get; set; }

	[Parameter] public decimal SpecialtyMtFY1Qty { get; set; }
	[Parameter] public decimal SpecialtyMtFY1Amount { get; set; }
	[Parameter] public decimal SpecialtyMtFY2Qty { get; set; }
	[Parameter] public decimal SpecialtyMtFY2Amount { get; set; }
	[Parameter] public decimal SpecialtyMtFY3Qty { get; set; }
	[Parameter] public decimal SpecialtyMtFY3Amount { get; set; }

	[Parameter] public decimal SpecialtyLtrFY1Qty { get; set; }
	[Parameter] public decimal SpecialtyLtrFY1Amount { get; set; }
	[Parameter] public decimal SpecialtyLtrFY2Qty { get; set; }
