@using SPIC.Core.Entities

<div class="form-card">
	<div class="d-flex justify-content-between align-items-center mb-1">
		<div class="section-title">
			<img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/SalesPerformaReview.svg"
				 class="formicon" />
			Sales Performance Review
		</div>

		<button class="btn-verified">
			Values in @SelectedUnitName
		</button>
	</div>

	<div class="financial-note-box">
		<div class="financial-note-badge">
			Only last 3 completed financial years are allowed
		</div>
	</div>

	@* Prepare category list and displayed rows based on Company *@
	@{
		var fertilizerCats = Categories.Where(c => c.Name != null && c.Name.Contains("Fertilizer", StringComparison.OrdinalIgnoreCase)).ToList();
		var fertilizerCatIds = fertilizerCats.Select(c => c.Id).ToHashSet();

		var renderCategories = (Company != null && Company.Equals("SPIC", StringComparison.OrdinalIgnoreCase))
			? fertilizerCats
			: Categories;

		// Determine displayed rows based on company rules
		var displayedRows = SalesPerfRows ?? new List<SalesPerfViewRow>();

		if (!string.IsNullOrEmpty(Company) && Company.Equals("SPIC", StringComparison.OrdinalIgnoreCase))
		{
			// SPIC: show only fertilizer category tabs; when showing rows, further limit to Urea products
			if (SelectedCategoryId > 0 && fertilizerCatIds.Contains(SelectedCategoryId))
			{
				displayedRows = displayedRows.Where(r => !string.IsNullOrEmpty(r.ProductName) && r.ProductName.Contains("Urea", StringComparison.OrdinalIgnoreCase)).ToList();
			}
			else
			{
				// If no fertilizer category selected (or selected category is not fertilizer), hide rows
				displayedRows = new List<SalesPerfViewRow>();
			}
		}
		else if (!string.IsNullOrEmpty(Company) && Company.Equals("GreenStar", StringComparison.OrdinalIgnoreCase))
		{
			// GreenStar: show all categories; but in fertilizer category exclude Urea products
			if (SelectedCategoryId > 0 && fertilizerCatIds.Contains(SelectedCategoryId))
			{
				displayedRows = displayedRows.Where(r => string.IsNullOrEmpty(r.ProductName) || !r.ProductName.Contains("Urea", StringComparison.OrdinalIgnoreCase)).ToList();
			}
			// else leave displayedRows as-is for other categories
		}
	}

	<div class="custom-tabs">
		@foreach (var cat in renderCategories)
		{
			var catId = cat.Id;
			var unitName = Units.FirstOrDefault(u => u.Id == cat.UnitId)?.Name ?? "";

			<div class="tab-btn @(catId == SelectedCategoryId ? "active" : "")"
				 @onclick="async () => await OnCategoryChanged.InvokeAsync(catId)"
				 style="cursor:pointer;">
				@cat.Name (@unitName / Value)
			</div>
		}
	</div>

	<div class="table-wrapper">
		<div class="table-responsive">
			<table class="spic-table">
				<thead>
					<tr>
						<th rowspan="2" style="min-width: 180px;">
							Product Name / Category
						</th>

						@for (int fi = 0; fi < 3; fi++)
						{
							var fyIdx = fi;

							<th colspan="2" class="text-center border-start">
								<select class="form-select form-select-sm text-center"
										value="@GetSelectedFY(fyIdx)"
										disabled>
									<option value="@GetSelectedFY(fyIdx)">
										@GetFYName(fyIdx)
									</option>
								</select>
							</th>
						}
					</tr>

					<tr>
						@for (int fi = 0; fi < 3; fi++)
						{
							<th class="text-center text-muted fw-normal border-start">
								@(!string.IsNullOrEmpty(SelectedUnitName) ? SelectedUnitName : "MT")
							</th>
							<th class="text-center text-muted fw-normal">
								Lakhs
							</th>
						}
					</tr>
				</thead>

				<tbody>
					@foreach (var row in displayedRows)
					{
						<tr>
							<td class="fw-medium text-dark">@row.ProductName</td>

							<td class="border-start">
								<input class="table-input"
									   type="number"
									   step="0.01"
									   value="@row.FY1Qty"
									   readonly />
							</td>
							<td>
								<input class="table-input"
									   type="number"
									   step="0.01"
									   value="@row.FY1Amount"
									   readonly />
							</td>

							<td class="border-start">
								<input class="table-input"
									   type="number"
									   step="0.01"
									   value="@row.FY2Qty"
									   readonly />
							</td>
							<td>
								<input class="table-input"
									   type="number"
									   step="0.01"
									   value="@row.FY2Amount"
									   readonly />
							</td>

							<td class="border-start">
								<input class="table-input"
									   type="number"
									   step="0.01"
									   value="@row.FY3Qty"
									   readonly />
							</td>
							<td>
								<input class="table-input"
									   type="number"
									   step="0.01"
									   value="@row.FY3Amount"
									   readonly />
							</td>
						</tr>
					}
				</tbody>

				<tfoot>
					<tr>
						<td class="fw-bold text-end">Total</td>

						@for (int fi = 0; fi < 3; fi++)
						{
							var fyIdx = fi;

							<td class="border-start fw-bold text-center">
								@displayedRows.Sum(r => fyIdx == 0 ? r.FY1Qty : fyIdx == 1 ? r.FY2Qty : r.FY3Qty).ToString("N2")
							</td>

							<td class="fw-bold text-center">
								@displayedRows.Sum(r => fyIdx == 0 ? r.FY1Amount : fyIdx == 1 ? r.FY2Amount : r.FY3Amount).ToString("N2")
							</td>
						}
					</tr>
				</tfoot>
			</table>
		</div>
	</div>

	<div class="row g-3 mt-2">

		@for (int fi = 0; fi < 3; fi++)
		{
			var fyIdx = fi;
			var fyName = GetFYName(fyIdx);

			<div class="col-md-3">
				<div class="perf-card">
					<div class="perf-year">@fyName</div>
					<div class="perf-val">
						@displayedRows.Sum(r => fyIdx == 0 ? r.FY1Qty : fyIdx == 1 ? r.FY2Qty : r.FY3Qty).ToString("N2")
						<span style="font-size:0.75rem; font-weight:normal; color:#6B7280;">
							@(!string.IsNullOrEmpty(SelectedUnitName) ? SelectedUnitName : "MT")
						</span>
						/ ₹ @displayedRows.Sum(r => fyIdx == 0 ? r.FY1Amount : fyIdx == 1 ? r.FY2Amount : r.FY3Amount).ToString("N2")
						<span style="font-size:0.75rem; font-weight:normal; color:#6B7280;">
							Lakhs
						</span>
					</div>
				</div>
			</div>
		}

		<div class="col-md-3">
			<div class="perf-card green position-relative">
				<div class="perf-year">@(!string.IsNullOrEmpty(SalesPlanCardTitle) ? SalesPlanCardTitle : "Sales Plan (Current FY)")</div>
				<div class="perf-val">
					@SalesPlanTotalQty.ToString("N2")
					<span style="font-size:0.75rem; font-weight:normal; color:#A7F3D0;">
						@(!string.IsNullOrEmpty(SelectedUnitName) ? SelectedUnitName : "MT")
					</span>
					/ ₹ @SalesPlanTotalAmount.ToString("N2")
					<span style="font-size:0.75rem; font-weight:normal; color:#A7F3D0;">
						Lakhs
					</span>
				</div>
			</div>
		</div>
	</div>
	@if (!string.IsNullOrEmpty(Company) && Company.Equals("GreenStar", StringComparison.OrdinalIgnoreCase))
	{
		var selectedUnit = !string.IsNullOrEmpty(SelectedUnitName) ? SelectedUnitName : "MT";

		var grRows = displayedRows
			.Where(r => !string.IsNullOrEmpty(r.ProductName)
				&& (
					r.ProductName.Contains("Gr", StringComparison.OrdinalIgnoreCase)
					|| r.ProductName.Contains("Granule", StringComparison.OrdinalIgnoreCase)
					|| r.ProductName.Contains("Granules", StringComparison.OrdinalIgnoreCase)
				))
			.ToList();

		var liqRows = displayedRows
			.Where(r => !string.IsNullOrEmpty(r.ProductName)
				&& (
					r.ProductName.Contains("Liq", StringComparison.OrdinalIgnoreCase)
					|| r.ProductName.Contains("Liquid", StringComparison.OrdinalIgnoreCase)
				))
			.ToList();

		var grQty = grRows.Sum(r => r.FY1Qty + r.FY2Qty + r.FY3Qty);
		var grAmount = grRows.Sum(r => r.FY1Amount + r.FY2Amount + r.FY3Amount);

		var liqQty = liqRows.Sum(r => r.FY1Qty + r.FY2Qty + r.FY3Qty);
		var liqAmount = liqRows.Sum(r => r.FY1Amount + r.FY2Amount + r.FY3Amount);

		var totalSpecialityQty = grQty + liqQty;
		var totalSpecialityAmount = grAmount + liqAmount;

		<div class="row g-3 mt-3">
			<div class="col-md-4">
				<div class="perf-card">
					<div class="perf-year">Specialty Products Gr</div>
					<div class="perf-val">
						@grQty.ToString("N2")
						<span style="font-size:0.75rem; font-weight:normal; color:#6B7280;">
							@selectedUnit
						</span>
						/ ₹@grAmount.ToString("N2")
						<span style="font-size:0.75rem; font-weight:normal; color:#6B7280;">
							Lakhs
						</span>
					</div>
				</div>
			</div>

			<div class="col-md-4">
				<div class="perf-card">
					<div class="perf-year">Specialty Products Liq</div>
					<div class="perf-val">
						@liqQty.ToString("N2")
						<span style="font-size:0.75rem; font-weight:normal; color:#6B7280;">
							@selectedUnit
						</span>
						/ ₹@liqAmount.ToString("N2")
						<span style="font-size:0.75rem; font-weight:normal; color:#6B7280;">
							Lakhs
						</span>
					</div>
				</div>
			</div>

			<div class="col-md-4">
				<div class="perf-card green">
					<div class="perf-year">Total Specialty Product</div>
					<div class="perf-val">
						@totalSpecialityQty.ToString("N2")
						<span style="font-size:0.75rem; font-weight:normal; color:#A7F3D0;">
							@selectedUnit
						</span>
						/ ₹@totalSpecialityAmount.ToString("N2")
						<span style="font-size:0.75rem; font-weight:normal; color:#A7F3D0;">
							Lakhs
						</span>
					</div>
				</div>
			</div>
		</div>
	}
</div>

@code {
	[Parameter] public List<Category> Categories { get; set; } = new();
	[Parameter] public List<Unit> Units { get; set; } = new();
	[Parameter] public List<FinancialYear> FinancialYears { get; set; } = new();

	[Parameter] public List<SalesPerfViewRow> SalesPerfRows { get; set; } = new();

	[Parameter] public int SelectedCategoryId { get; set; }
	[Parameter] public string SelectedUnitName { get; set; } = "MT";
	[Parameter] public string Company { get; set; } = "";

	[Parameter] public int FY1 { get; set; }
	[Parameter] public int FY2 { get; set; }
	[Parameter] public int FY3 { get; set; }

	[Parameter] public decimal SalesPlanTotalQty { get; set; }
	[Parameter] public decimal SalesPlanTotalAmount { get; set; }
	[Parameter] public string SalesPlanCardTitle { get; set; } = "Sales Plan (Current FY)";

	[Parameter] public EventCallback<int> OnCategoryChanged { get; set; }

	private int GetSelectedFY(int fyIdx) => fyIdx switch
	{
		0 => FY1,
		1 => FY2,
		2 => FY3,
		_ => 0
	};

	private string GetFYName(int fyIdx)
	{
		var fyId = GetSelectedFY(fyIdx);
		return FinancialYears.FirstOrDefault(f => f.Id == fyId)?.Name ?? $"FY {fyIdx + 1}";
	}
}