	private HashSet<int?> _expandedGroups = new();

	private class GroupData
	{
		public int? ProductGroupId { get; set; }
		public string GroupName { get; set; } = "";
		public List<SalesPerfViewRow> Rows { get; set; } = new();
	}

	private void ToggleGroup(int? productGroupId)
	{
		if (_expandedGroups.Contains(productGroupId))
			_expandedGroups.Remove(productGroupId);
		else
			_expandedGroups.Add(productGroupId);
	}

	private bool IsExpanded(int? productGroupId) => _expandedGroups.Contains(productGroupId);

	private int GetSelectedFY(int fyIdx) => fyIdx switch
	{
		0 => FY1,
		1 => FY2,
		2 => FY3,
		_ => 0
	};

	private string GetFYName(int fyIdx)
	{
		var fyId = GetSelectedFY(fyIdx);
		return FinancialYears.FirstOrDefault(f => f.Id == fyId)?.Name ?? $"FY {fyIdx + 1}";
	}
