@using SPIC.Core.DTOs
@using SPIC.Core.Entities
@if (IsOpen)
{
    <div class="apd-overlay" @onclick="CloseDrawer">
        <div class="apd-drawer" @onclick:stopPropagation="true">
            <SchemeApprovalBody ApplicationId="ApplicationId" OnActionCompleted="OnActionCompleted" OnClose="CloseDrawer" />
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public int ApplicationId { get; set; }
    [Parameter] public string ContextTab { get; set; } = "pending";
    [Parameter] public EventCallback<bool> OnClose { get; set; }
    [Parameter] public EventCallback OnActionCompleted { get; set; }

    private async Task CloseDrawer()
    {
        await OnClose.InvokeAsync(false);
    }
}
