    // ------------------------------------------------------------------
    // Scheme-specific fields
    // ------------------------------------------------------------------

    private sealed record FieldData(string Label, string Value);

    private static List<FieldData> GetSchemeSpecificFields(SPIC.Core.DTOs.WelfareApplicationDetailDto d)
    {
        var fields = new List<FieldData>();
        switch (d.SchemeType)
        {
            case 0: // Medical Assistance
                fields.Add(new FieldData("Treatment Type", d.MedicalTreatmentType ?? "-"));
                break;
            case 1: // Wedding
                fields.Add(new FieldData("Marriage Date", FormatDateNullable(d.MarriageDate)));
                break;
            case 2: // Grahapravesam
                fields.Add(new FieldData("Event Date", FormatDateNullable(d.EventDate)));
                fields.Add(new FieldData("Ownership Type", d.OwnershipType ?? "-"));
                fields.Add(new FieldData("Event Venue", d.EventVenue ?? "-"));
                break;
            case 3: // Educational Assistance
                fields.Add(new FieldData("Course", d.Course ?? "-"));
                fields.Add(new FieldData("Year of Study", d.EduYear?.ToString() ?? "-"));
                fields.Add(new FieldData("College Name", d.CollegeName ?? "-"));
                fields.Add(new FieldData("Total Duration (Years)", d.TotalNumberOfCourses?.ToString() ?? "-"));
                fields.Add(new FieldData("First Application", d.IsFirstApplication == null ? "-" : (d.IsFirstApplication.Value ? "Yes" : "No")));
                break;
            case 4: // Sathabhishekam
                fields.Add(new FieldData("Event Date", FormatDateNullable(d.EventDate)));
                fields.Add(new FieldData("Ownership Type", d.OwnershipType ?? "-"));
                fields.Add(new FieldData("Event Venue", d.EventVenue ?? "-"));
                break;
            case 5: // Death Relief
                fields.Add(new FieldData("Date of Death", FormatDateNullable(d.DateOfDeath)));
                fields.Add(new FieldData("Legal Heir Name", d.LegalHeirName ?? "-"));
                fields.Add(new FieldData("Cause of Death", d.DeathCause ?? "-"));
                break;
            case 6: // Merit Award
                fields.Add(new FieldData("Candidate Name", d.MeritCandidateName ?? "-"));
                fields.Add(new FieldData("Father's Name", d.MeritFatherName ?? "-"));
                fields.Add(new FieldData("Examination Appeared", d.ExaminationAppeared ?? "-"));
                fields.Add(new FieldData("Board", d.BoardName ?? "-"));
                fields.Add(new FieldData("Maximum Marks", d.MaximumMarks?.ToString() ?? "-"));
                fields.Add(new FieldData("Marks Obtained", d.MarksObtained?.ToString() ?? "-"));
                fields.Add(new FieldData("Percentage", d.MeritPercentage?.ToString("0.##") ?? "-"));
                break;
            case 7: // Distinction Award
                fields.Add(new FieldData("Candidate Name", d.DistinctionCandidateName ?? "-"));
                fields.Add(new FieldData("Father's Name", d.DistinctionFatherName ?? "-"));
                fields.Add(new FieldData("Professional Course", d.ProfessionalCourseName ?? "-"));
                fields.Add(new FieldData("Course Completion Year", d.CourseCompletionYear?.ToString() ?? "-"));
                fields.Add(new FieldData("University", d.UniversityName ?? "-"));
                fields.Add(new FieldData("Maximum Marks", d.DistinctionMaximumMarks?.ToString() ?? "-"));
                fields.Add(new FieldData("Marks Obtained", d.DistinctionMarksObtained?.ToString() ?? "-"));
                fields.Add(new FieldData("Aggregate Percentage", d.DistinctionAggregatePercentage?.ToString("0.##") ?? "-"));
                fields.Add(new FieldData("Arrears", d.HasArrears == null ? "-" : (d.HasArrears.Value ? "Yes" : "No")));
                fields.Add(new FieldData("Wholesale Dealer Employee", d.IsWholesaleDealerEmployee == null ? "-" : (d.IsWholesaleDealerEmployee.Value ? "Yes" : "No")));
                break;
        }
        return fields;
    }

    // ------------------------------------------------------------------
    // Approve / Reject actions
    // ------------------------------------------------------------------

    private void HandleApproveClick()
    {
        _actionError = null;
        _approveRemarks = null;
        _approveRecommendation = "";
        _approveComment = null;
        IsApproveModalOpen = true;
    }

    private void HandleRejectClick()
    {
        _actionError = null;
        _rejectReason = "";
        _rejectRemarks = null;
        IsRejectModalOpen = true;
    }

    private void CloseApproveModal() { if (!_busy) IsApproveModalOpen = false; }
    private void CloseRejectModal() { if (!_busy) IsRejectModalOpen = false; }

    private async Task ConfirmApprove()
    {
        if (_detail == null || _busy) return;

        if (IsMoStage && string.IsNullOrWhiteSpace(_approveRecommendation))
        {
            _actionError = "Please select your recommendation before approving.";
            return;
        }

        if (IsMoStage && string.IsNullOrWhiteSpace(_approveComment))
        {
            _actionError = "Comment is mandatory when approving an application.";
            return;
        }

        _busy = true;
        _actionError = null;
        try
        {
            var response = await Http.PostAsJsonAsync(
                $"api/WelfareSchemeApproval/applications/{_detail.Id}/approve",
                new WelfareApprovalActionRequest
                {
                    Remarks = _approveRemarks,
                    Recommendation = IsMoStage ? _approveRecommendation : null,
                    Comment = IsMoStage ? _approveComment : null
                });

            if (response.IsSuccessStatusCode)
            {
                IsApproveModalOpen = false;
                await OnActionCompleted.InvokeAsync();
            }
            else
            {
                _actionError = await ReadErrorMessageAsync(response);
            }
        }
        catch
        {
            _actionError = "Unable to reach the server. Please try again.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ConfirmReject()
    {
        if (_detail == null || _busy) return;

        if (string.IsNullOrWhiteSpace(_rejectRemarks))
        {
            _actionError = "Remarks are mandatory when rejecting an application.";
            return;
        }

        _busy = true;
        _actionError = null;
        try
        {
            var response = await Http.PostAsJsonAsync(
                $"api/WelfareSchemeApproval/applications/{_detail.Id}/reject",
                new WelfareApprovalActionRequest { Reason = _rejectReason, Remarks = _rejectRemarks });

            if (response.IsSuccessStatusCode)
            {
                IsRejectModalOpen = false;
                await OnActionCompleted.InvokeAsync();
            }
            else
            {
                _actionError = await ReadErrorMessageAsync(response);
            }
        }
        catch
        {
            _actionError = "Unable to reach the server. Please try again.";
        }
        finally
        {
            _busy = false;
        }
    }

    private static async Task<string> ReadErrorMessageAsync(HttpResponseMessage response)
    {
        try
        {
            var body = await response.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
            if (body.TryGetProperty("Message", out var msg))
                return msg.GetString() ?? "Action failed. Please try again.";
        }
        catch { }
        return response.StatusCode == System.Net.HttpStatusCode.Conflict
            ? "This application is no longer pending at your approval stage."
            : "Action failed. Please try again.";
    }

    private void ResetActionState()
    {
        IsApproveModalOpen = false;
        IsRejectModalOpen = false;
        _approveRemarks = null;
        _approveRecommendation = "";
        _approveComment = null;
        _rejectReason = null;
        _rejectRemarks = null;
        _actionError = null;
        _busy = false;
    }

    // ------------------------------------------------------------------
    // Close + document download
    // ------------------------------------------------------------------

    private async Task CloseDrawer()
    {
        await OnClose.InvokeAsync(false);
    }

    private async Task OpenDocument(int documentId, bool download)
    {
        var baseUrl = Http.BaseAddress?.ToString().TrimEnd('/') ?? "";
        var token = GetRawToken();
        var url = $"{baseUrl}/api/WelfareSchemeApproval/document/{documentId}";
        if (download) url += "?disposition=attachment";
        if (!string.IsNullOrWhiteSpace(token))
            url += (url.Contains('?') ? "&" : "?") + "access_token=" + Uri.EscapeDataString(token);
        await JS.InvokeVoidAsync("open", url, "_blank");
    }

    private string? GetRawToken()
    {
        try
        {
            var token = LoginState.Token;
            if (string.IsNullOrWhiteSpace(token)) return null;
            return token.StartsWith("Bearer ", StringComparison.OrdinalIgnoreCase)
                ? token["Bearer ".Length..]
                : token;
        }
        catch
        {
            return null;
        }
    }

