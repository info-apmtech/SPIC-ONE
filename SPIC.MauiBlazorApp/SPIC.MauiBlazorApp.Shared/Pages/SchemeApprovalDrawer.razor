@if (IsOpen)
{
    <div class="apd-overlay" @onclick="CloseDrawer">
        <div class="apd-drawer" @onclick:stopPropagation="true">

            <div class="apd-header">
                <div class="apd-header-titles">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <h2>Application Details</h2>
                        @if (Status == "Validated by MO") { <span class="apd-badge apd-badge-purple">Validated by MO</span> }
                        else if (Status == "Rejected") { <span class="apd-badge apd-badge-red">Rejected</span> }
                        else if (Status == "Completed") { <span class="apd-badge apd-badge-green">Approved</span> }
                    </div>
                    <p>WF-2026-001</p>
                </div>
                <button class="apd-close-icon" @onclick="CloseDrawer" aria-label="Close">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="15" y1="9" x2="9" y2="15"></line>
                        <line x1="9" y1="9" x2="15" y2="15"></line>
                    </svg>
                </button>
            </div>

            <div class="apd-body">

                <div class="apd-section">
                    <h3>Approval Workflow</h3>
                    <div class="apd-stepper">

                        @if (Status == "Pending")
                        {
                            <div class="apd-step">
                                <div class="apd-step-circle apd-step-active">MO</div>
                                <div class="apd-step-info">
                                    <div class="apd-step-name">MO</div>
                                    <div class="apd-step-status apd-status-review">Under Review</div>
                                </div>
                            </div>
                            <div class="apd-step-connector"><div class="apd-connector-fill"></div></div>
                            <div class="apd-step">
                                <div class="apd-step-circle apd-step-pending">@HourglassIcon()</div>
                                <div class="apd-step-info"><div class="apd-step-name">RM</div><div class="apd-step-status">Pending</div></div>
                            </div>
                            <div class="apd-step-connector"></div>
                            <div class="apd-step">
                                <div class="apd-step-circle apd-step-pending">@HourglassIcon()</div>
                                <div class="apd-step-info"><div class="apd-step-name">SMM</div><div class="apd-step-status">Pending</div></div>
                            </div>
                            <div class="apd-step-connector"></div>
                            <div class="apd-step">
                                <div class="apd-step-circle apd-step-pending">@HourglassIcon()</div>
                                <div class="apd-step-info"><div class="apd-step-name">SDWA</div><div class="apd-step-status">Pending</div></div>
                            </div>
                        }
                        else if (Status == "Validated by MO")
                        {
                            <div class="apd-step">
                                <div class="apd-step-circle apd-step-success">@CheckIcon()</div>
                                <div class="apd-step-info">
                                    <div class="apd-step-name">MO</div>
                                    <div class="apd-step-status apd-status-success">Validated<br/>12 May 2026<br/>10:42 AM</div>
                                </div>
                            </div>
                            <div class="apd-step-connector"><div class="apd-connector-fill" style="width:100%; background-color:#16A34A;"></div></div>
                            <div class="apd-step">
                                <div class="apd-step-circle apd-step-pending">@HourglassIcon()</div>
                                <div class="apd-step-info"><div class="apd-step-name">RM</div><div class="apd-step-status">Pending</div></div>
                            </div>
                            <div class="apd-step-connector"></div>
                            <div class="apd-step">
                                <div class="apd-step-circle apd-step-pending">@HourglassIcon()</div>
                                <div class="apd-step-info"><div class="apd-step-name">SMM</div><div class="apd-step-status">Pending</div></div>
                            </div>
                            <div class="apd-step-connector"></div>
                            <div class="apd-step">
                                <div class="apd-step-circle apd-step-pending">@HourglassIcon()</div>
                                <div class="apd-step-info"><div class="apd-step-name">SDWA</div><div class="apd-step-status">Pending</div></div>
                            </div>
                        }
                        else if (Status == "Rejected")
                        {
                            <div class="apd-step">
                                <div class="apd-step-circle apd-step-cyan">MO</div>
                                <div class="apd-step-info">
                                    <div class="apd-step-name">MO</div>
                                    <div class="apd-step-status apd-status-danger">Rejected<br/>12 May 2026<br/>10:42 AM</div>
                                </div>
                            </div>
                            <div class="apd-step-connector"><div class="apd-connector-fill" style="width:100%; background-color:#16A34A;"></div></div>
                            <div class="apd-step">
                                <div class="apd-step-circle apd-step-pending">@HourglassIcon()</div>
                                <div class="apd-step-info"><div class="apd-step-name">RM</div><div class="apd-step-status">Pending</div></div>
                            </div>
                            <div class="apd-step-connector"></div>
                            <div class="apd-step">
                                <div class="apd-step-circle apd-step-pending">@HourglassIcon()</div>
                                <div class="apd-step-info"><div class="apd-step-name">SMM</div><div class="apd-step-status">Pending</div></div>
                            </div>
                            <div class="apd-step-connector"></div>
                            <div class="apd-step">
                                <div class="apd-step-circle apd-step-pending">@HourglassIcon()</div>
                                <div class="apd-step-info"><div class="apd-step-name">SDWA</div><div class="apd-step-status">Pending</div></div>
                            </div>
                        }
                        else if (Status == "Completed")
                        {
                            <div class="apd-step">
                                <div class="apd-step-circle apd-step-success">@CheckIcon()</div>
                                <div class="apd-step-info"><div class="apd-step-name">MO</div><div class="apd-step-status apd-status-success">Validated<br/>12 May 2026</div></div>
                            </div>
                            <div class="apd-step-connector"><div class="apd-connector-fill" style="width:100%; background-color:#16A34A;"></div></div>
                            <div class="apd-step">
                                <div class="apd-step-circle apd-step-success">@CheckIcon()</div>
                                <div class="apd-step-info"><div class="apd-step-name">RM</div><div class="apd-step-status apd-status-success">Recommended<br/>12 May 2026</div></div>
                            </div>
                            <div class="apd-step-connector"><div class="apd-connector-fill" style="width:100%; background-color:#16A34A;"></div></div>
                            <div class="apd-step">
                                <div class="apd-step-circle apd-step-success">@CheckIcon()</div>
                                <div class="apd-step-info"><div class="apd-step-name">SMM</div><div class="apd-step-status apd-status-success">Recommended<br/>12 May 2026</div></div>
                            </div>
                            <div class="apd-step-connector"><div class="apd-connector-fill" style="width:100%; background-color:#16A34A;"></div></div>
                            <div class="apd-step">
                                <div class="apd-step-circle apd-step-success">@CheckIcon()</div>
                                <div class="apd-step-info"><div class="apd-step-name">SDWA</div><div class="apd-step-status apd-status-success">Approved<br/>12 May 2026</div></div>
                            </div>
                        }
                    </div>
                </div>

                @if (Status == "Pending")
                {
                    <div class="apd-alert apd-alert-warning">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line>
                        </svg>
                        <span><strong>Your Action Pending:</strong> Please validate this application</span>
                    </div>
                }
                else if (Status == "Validated by MO")
                {
                    <div class="apd-alert apd-alert-success">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                        <span>This application has been validated by MO and is awaiting RM review.</span>
                    </div>
                }
                else if (Status == "Rejected")
                {
                    <div class="apd-alert apd-alert-danger">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line>
                        </svg>
                        <span>This application has been rejected by MO. The approval process has been stopped.</span>
                    </div>
                }
                else if (Status == "Completed")
                {
                    <div class="apd-alert apd-alert-success">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                        <span>This application has been approved by SDWA and benefit has been released.</span>
                    </div>
                }

                <div class="apd-section">
                    <div class="apd-section-head">
                        <h3>Applicant Information</h3>
                        @if (Status == "Pending")
                        {
                            <button class="apd-btn-edit">Edit <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg></button>
                        }
                    </div>
                    <div class="apd-fields-grid">
                        <div class="apd-field"><label>Dealer code</label><div class="apd-field-value">DLR-CHN-0042</div></div>
                        <div class="apd-field"><label>Dealer name</label><div class="apd-field-value">R. Krishnamurthy</div></div>
                        <div class="apd-field"><label>Welfare Scheme</label><div class="apd-field-value">Medical Assistance</div></div>
                        <div class="apd-field"><label>Submitted Date</label><div class="apd-field-value">2026-05-08</div></div>
                        <div class="apd-field"><label>Mobile Number</label><div class="apd-field-value">98765 43210</div></div>
                        <div class="apd-field"><label>Email Address</label><div class="apd-field-value">hello@gmail.com</div></div>
                    </div>
                </div>

                <div class="apd-section">
                    <div class="apd-section-head">
                        <h3>Nominee Information</h3>
                    </div>
                    <div class="apd-fields-grid apd-fields-3">
                        <div class="apd-field"><label>Nominee Name</label><div class="apd-field-value">Keerthana</div></div>
                        <div class="apd-field"><label>Relationship</label><div class="apd-field-value">Spouse</div></div>
                        <div class="apd-field"><label>Nominee Address</label><div class="apd-field-value">123 Main Street, City, State - 123456</div></div>
                    </div>
                </div>

                <div class="apd-section">
                    <h3>Uploaded documents</h3>
                    <div class="apd-doc-list">
                        <div class="apd-doc-item">
                            <div class="apd-doc-icon"><img src="_content/SPIC.MauiBlazorApp.Shared/Images/Gallery/PdfIcon.png" /></div>
                            <div class="apd-doc-info"><div class="apd-doc-name">Bonafide</div><div class="apd-doc-status">Verified</div></div>
                            <button class="apd-btn-download">Download</button>
                        </div>
                        <div class="apd-doc-item">
                            <div class="apd-doc-icon"><img src="_content/SPIC.MauiBlazorApp.Shared/Images/Gallery/PdfIcon.png" /></div>
                            <div class="apd-doc-info"><div class="apd-doc-name">Aadhaar Card</div><div class="apd-doc-status">Verified</div></div>
                            <button class="apd-btn-download">Download</button>
                        </div>
                    </div>
                </div>

                @if (Status == "Pending")
                {
                    <div class="apd-section">
                        <h3>Your Remarks</h3>
                        <textarea class="apd-textarea" placeholder="Add your validation remarks here..."></textarea>
                    </div>
                }
                else if (Status == "Validated by MO")
                {
                    <div class="apd-summary-box apd-box-purple">
                        <h4 class="apd-box-title">MO Validation Summary</h4>
                        <div class="apd-summary-grid">
                            <div class="apd-summary-item"><label>Validated By</label><span>Rajesh Kumar (Marketing Officer (MO))</span></div>
                            <div class="apd-summary-item"><label>Validated On</label><span>12 May 2026, 10:42 AM</span></div>
                        </div>
                        <div class="apd-summary-full">
                            <label>Validation Remarks</label>
                            <p>All required documents verified and application is completed as per guidelines.</p>
                        </div>
                    </div>
                }
                else if (Status == "Rejected")
                {
                    <div class="apd-summary-box apd-box-red">
                        <h4 class="apd-box-title">Rejection Details</h4>
                        <div class="apd-summary-grid">
                            <div class="apd-summary-item"><label>Rejected By</label><span>Rajesh Kumar (Marketing Officer (MO))</span></div>
                            <div class="apd-summary-item"><label>Rejected On</label><span>12 May 2026, 10:42 AM</span></div>
                            <div class="apd-summary-item"><label>Rejection Reason</label><span>Invalid documents</span></div>
                            <div class="apd-summary-item"><label>Rejection Remarks</label><span>Bonafide certificate unclear and not attested.</span></div>
                        </div>
                    </div>
                }
                else if (Status == "Completed")
                {
                    <div class="apd-summary-box apd-box-green">
                        <h4 class="apd-box-title">Approval Details</h4>
                        <div class="apd-summary-grid">
                            <div class="apd-summary-item"><label>Approved By</label><span>Rajesh Kumar (SDWA)</span></div>
                            <div class="apd-summary-item"><label>Approved On</label><span>12 May 2026, 10:42 AM</span></div>
                            <div class="apd-summary-item"><label>Benefit Status</label><span class="apd-status-success">Released Successfully</span></div>
                            <div class="apd-summary-item"><label>Remarks</label><span>Application approved and benefit released.</span></div>
                        </div>
                    </div>

                    <div class="apd-remarks-container">
                        <h4 class="apd-box-title" style="color: #64748B;">Previous Remarks</h4>
                        
                        <div class="apd-remark-block">
                            <h5 style="color: #3B82F6;">Marketing Officer</h5>
                            <p>All documents verified. Application is valid and complete.</p>
                            <small>Validated on 2026-05-10</small>
                        </div>
                        
                        <div class="apd-remark-block">
                            <h5 style="color: #EC4899;">RM Remarks</h5>
                            <p>Application reviewed thoroughly. Applicant's profile is consistent with scheme guidelines. Recommending for SMM approval without objections.</p>
                            <small>Validated on 2026-05-10</small>
                        </div>
                        
                        <div class="apd-remark-block">
                            <h5 style="color: #EAB308;">SMM Remarks</h5>
                            <p>Application reviewed thoroughly. Applicant's profile is consistent with scheme guidelines. Recommending for SDWA approval.</p>
                            <small>Validated on 2026-05-10</small>
                        </div>
                    </div>

                    <div class="apd-section">
                        <h3>Payment Details</h3>
                        <div class="apd-payment-list">
                            <div class="apd-payment-row"><span>Approved Amount</span><strong>₹50000.00</strong></div>
                            <div class="apd-payment-row"><span>Payment Status</span><span class="apd-badge apd-badge-green">Paid</span></div>
                            <div class="apd-payment-row"><span>Transaction ID</span><strong>TXN-2026-000345</strong></div>
                            <div class="apd-payment-row"><span>Released Date</span><strong>16 May 2026</strong></div>
                            <div class="apd-payment-row" style="border:none;"><span>Payment Mode</span><strong>NEFT</strong></div>
                        </div>
                    </div>
                }

            </div>

            <div class="apd-footer">
                @if (Status == "Pending")
                {
                    <button class="apd-btn-action apd-btn-reject" @onclick="HandleRejectClick">Reject</button>
                    <button class="apd-btn-action apd-btn-validate">Validate &amp; Forward</button>
                }
                else if (Status == "Completed")
                {
                    <button class="apd-btn-outline" @onclick="CloseDrawer">Close</button>
                    <button class="apd-btn-outline">Download Payment Receipt</button>
                    <button class="apd-btn-action apd-btn-validate">Download PDF</button>
                }
                else 
                {
                    <button class="apd-btn-outline" @onclick="CloseDrawer">Close</button>
                    <button class="apd-btn-action apd-btn-validate">Download PDF</button>
                }
            </div>

        </div>
    </div>
}

@if (IsRejectModalOpen)
{
    <div class="rm-overlay" @onclick="CloseRejectModal">
        <div class="rm-container" @onclick:stopPropagation="true">
            <div class="rm-icon-wrapper">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
            </div>
            <h2 class="rm-title">Reject Application?</h2>
            <p class="rm-subtitle">Are you sure you want to reject this welfare application?</p>
            <p class="rm-warning">This action will stop the approval process and cannot be undone.</p>
            <div class="rm-form">
                <div class="rm-form-group">
                    <label class="rm-label">Rejection Reason</label>
                    <select class="rm-select">
                        <option value="" disabled selected hidden>Invalid Documents</option>
                        <option value="incomplete">Incomplete Application</option>
                        <option value="invalid">Invalid Documents</option>
                        <option value="not_eligible">Not Eligible</option>
                        <option value="other">Other</option>
                    </select>
                </div>
                <div class="rm-form-group">
                    <label class="rm-label">Detailed Remarks</label>
                    <textarea class="rm-textarea" placeholder="Add your detailed remarks..."></textarea>
                </div>
            </div>
            <div class="rm-actions">
                <button class="rm-btn rm-btn-cancel" @onclick="CloseRejectModal">Cancel</button>
                <button class="rm-btn rm-btn-reject">Reject Application</button>
            </div>
        </div>
    </div>
}


@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    
    // Pass this down from SchemeApproval.razor (e.g., Status="@ActiveTab")
    [Parameter] public string Status { get; set; } = "Pending"; 

    private bool IsRejectModalOpen { get; set; } = false;

    private async Task CloseDrawer()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(IsOpen);
    }

    private void CloseRejectModal() { IsRejectModalOpen = false; }
    
    private async Task HandleRejectClick()
    {
        await CloseDrawer();
        IsRejectModalOpen = true;
    }

    // Helper snippets for SVG icons inside the stepper
    private RenderFragment HourglassIcon() => __builder =>
    {
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2h12"></path><path d="M6 22h12"></path><path d="M6 2v4c0 2 2 4 4 5 -2 1 -4 3 -4 5v4"></path><path d="M18 2v4c0 2 -2 4 -4 5 2 1 4 3 4 5v4"></path>
        </svg>
    };

    private RenderFragment CheckIcon() => __builder =>
    {
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
    };
}