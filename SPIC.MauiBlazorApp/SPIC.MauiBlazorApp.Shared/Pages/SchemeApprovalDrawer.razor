@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    
    // Pass this down from SchemeApproval.razor (e.g., Status="@ActiveTab")
    [Parameter] public string Status { get; set; } = "Pending"; 

    private bool IsRejectModalOpen { get; set; } = false;

    private async Task CloseDrawer()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(IsOpen);
    }

    private void CloseRejectModal() { IsRejectModalOpen = false; }
    
    private async Task HandleRejectClick()
    {
        await CloseDrawer();
        IsRejectModalOpen = true;
    }

