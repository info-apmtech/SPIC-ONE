@page "/StartDocumentation"

<div class="container-fluid py-4 documentation-page">

    <PageHeader Title="Start Documentation"
                Subtitle="Complete demo details to begin documentation">

    </PageHeader>

    <div class="doc-card">
        <h6>Program Details (From CSR-2)</h6>

        <div class="row">
            <div class="doc-card program-summary-card">

                <div class="summary-item">

                    <label>Program Type</label>

                    <div class="summary-value">
                        Farmer Program
                    </div>

                </div>


                <div class="summary-item">

                    <label>Program Name</label>

                    <div class="summary-value">
                        Spot Demonstration
                    </div>

                </div>


                <div class="summary-item">

                    <label>Sanction Number</label>

                    <div class="summary-value">
                        SN-2024-0412
                    </div>

                </div>


                <div class="summary-item">

                    <label>CSR2 Status</label>

                    <div class="summary-value">
                        Completed
                    </div>

                </div>


                <div class="summary-item">

                    <label>CSR2 Completed Date</label>

                    <div class="summary-value">
                        10-Jan-2026
                    </div>

                </div>
            </div>
        </div>
    </div>


    <div class="doc-card">
        <h6>Farmer & Location Details</h6>

        <div class="row">
            <div class="col">
                <label>Farmer Name</label>
                <input class="form-control" />
            </div>

            <div class="col">
                <label>Mobile Number</label>
                <input class="form-control" />
            </div>

            <div class="col">
                <label>Place / Village</label>
                <input class="form-control" />
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-md-6">
                <label>Farmer Address</label>
                <textarea class="form-control"></textarea>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col">
                <label>Crop</label>
                <select class="form-control">
                    <option>Select Crop</option>
                </select>
            </div>

            <div class="col">
                <label>Crop Type</label>
                <select class="form-control">
                    <option>Select Type</option>
                </select>
            </div>

            <div class="col">
                <label>Pin Code</label>
                <input class="form-control" />
            </div>
        </div>

        <div class="row mt-3">
            <div class="col">
                <label>State</label>
                <select class="form-control"></select>
            </div>

            <div class="col">
                <label>District</label>
                <select class="form-control"></select>
            </div>
        </div>
    </div>


    <div class="doc-card">
        <h6>Crop Information</h6>

        <div class="row">
            <div class="col">
                <label>Date Of Sowing</label>
                <input type="date" class="form-control" />
            </div>

            <div class="col">
                <label>Current Crop Stage</label>
                <select class="form-control">
                    <option>Select Stage</option>
                </select>
            </div>

            <div class="col">
                <label>Expected Harvest Date</label>
                <input type="date" class="form-control" />
            </div>
        </div>

        <div class="row mt-3">
            <div class="col">
                <label>Remarks</label>
                <textarea class="form-control"></textarea>
            </div>
        </div>
    </div>


    <div class="text-end mt-3">
        <button class="btn btn-light">Save Draft</button>
        <button class="btn btn-success">Start Documentation</button>
    </div>

</div>
