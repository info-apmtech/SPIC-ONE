</style>
@code {
    [SupplyParameterFromQuery(Name = "csr2Id")]
    public int? CSR2Id { get; set; }

    private sealed class DemoRecord
    {
        public int Id { get; set; }
        public int CSR1Id { get; set; }
        public string ProgramType { get; set; } = "";
        public string ProgramName { get; set; } = "";
        public string SeasonNumber { get; set; } = "";
        public string CSR2Status { get; set; } = "";
        public DateTime? CSR2CompletedDate { get; set; }
        public string Product { get; set; } = "";
        public string Crop { get; set; } = "";
        public string Location { get; set; } = "";
        public string District { get; set; } = "";
    }
    private DemoRecord? selected;
    private bool isLoading;
    private bool isSaving;
    private string saveError = "", saveSuccess = "";
    private string error = "";
    private string farmerName = "", mobile = "", village = "", address = "", crop = "", cropType = "", pinCode = "", state = "", district = "", remarks = "";
    private string cropId = "", cropTypeId = "", cropStageId = "";
    private List<MasterOption> cropStages = new();
    private bool loadingCropStages;
    private int cropStageRequestVersion;
    private const string CropStagesApi = "api/DemoDocumentation/crop-stages";
    private List<MasterOption> crops = new(), cropTypes = new();
    private bool loadingCrops, loadingCropTypes;
    private int cropTypeRequestVersion;
    private const string CropsApi = "api/Crop/all";
    private const string CropTypesApi = "api/DemoDocumentation/crop-types";
    // Change these paths if the project's master controllers use different routes.
    private const string StatesApi = "api/DemoDocumentation/states";
    private const string DistrictsApi = "api/DemoDocumentation/districts";
    private sealed class MasterOption
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
    }
    private List<MasterOption> states = new();
    private List<MasterOption> districts = new();
    private string stateId = "", districtId = "", masterError = "";
    private bool loadingStates, loadingDistricts;
    private int districtRequestVersion;
    private DateTime? sowingDate, harvestDate;
    private IEnumerable<string> CropOptions => (selected?.Crop ?? "").Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).Distinct(StringComparer.OrdinalIgnoreCase);
    private static string ValueOrDash(string? s) => string.IsNullOrWhiteSpace(s) ? "-" : s;
    private void BackToList() => NavigationManager.NavigateTo("/DemoDocumentation");

    protected override async Task OnParametersSetAsync()
    {
        selected = null;
        error = "";
        if (CSR2Id is null or <= 0) { error = "Missing or invalid csr2Id in URL."; return; }
        isLoading = true;
        try
        {
            // The existing endpoint applies the same role/geographic access restrictions as the list page.
            using var response = await Http.GetAsync("api/DemoDocumentation/approved-csr2");
            if (!response.IsSuccessStatusCode) { error = $"Unable to load approved CSR-2 (HTTP {(int)response.StatusCode})."; return; }
            var records = await response.Content.ReadFromJsonAsync<List<DemoRecord>>() ?? new();
            selected = records.FirstOrDefault(x => x.Id == CSR2Id.Value);
            if (selected == null) { error = "This CSR-2 is not finally approved or is outside your permitted scope."; return; }
            village = selected.Location;
            district = selected.District;
            crop = CropOptions.FirstOrDefault() ?? "";
            await LoadCropsAsync();
            await LoadStatesAsync();
            await LoadSavedDocumentationAsync();
        }
        catch (Exception ex) { error = $"Unable to load selected CSR-2: {ex.Message}"; }
        finally { isLoading = false; }
    }

    private static string Property(JsonElement element, params string[] candidates)
    {
        if (element.ValueKind != JsonValueKind.Object) return "";
        foreach (var name in candidates)
        {
            foreach (var property in element.EnumerateObject())
            {
                if (string.Equals(property.Name, name, StringComparison.OrdinalIgnoreCase))
                    return property.Value.ValueKind == JsonValueKind.String
                        ? property.Value.GetString() ?? "" : property.Value.ToString();
            }
        }
        return "";
    }

    // Accepts simple JSON arrays; supports common Id/Name, StateId/StateName,
    // and DistrictId/DistrictName master DTO field names.
    private static async Task<List<MasterOption>> ReadOptionsAsync(HttpResponseMessage response, bool isState)
    {
        response.EnsureSuccessStatusCode();
        using var json = await JsonDocument.ParseAsync(await response.Content.ReadAsStreamAsync());
        var root = json.RootElement;
        if (root.ValueKind == JsonValueKind.Object &&
            (root.TryGetProperty("data", out var data) || root.TryGetProperty("Data", out data)))
            root = data;
        if (root.ValueKind != JsonValueKind.Array)
            throw new InvalidOperationException("Master API must return a JSON array.");
        return root.EnumerateArray().Select(e => new MasterOption
        {
            Id = isState ? Property(e, "Id", "StateId") : Property(e, "Id", "DistrictId"),
            Name = isState ? Property(e, "StateName", "Name") : Property(e, "DistrictName", "Name")
        }).Where(x => !string.IsNullOrWhiteSpace(x.Id) && !string.IsNullOrWhiteSpace(x.Name))
          .OrderBy(x => x.Name).ToList();
    }

    // Load the existing Crop master, but keep the Crop choices limited to the
    // crop names included in this final-approved CSR-2's focus products.
    private async Task LoadCropsAsync()
    {
        loadingCrops = true;
        masterError = "";
        crops.Clear();
        cropTypes.Clear();
        cropStages.Clear();
        cropStageId = "";
        ++cropStageRequestVersion;
        cropId = "";
        cropTypeId = "";
        try
        {
            using var response = await Http.GetAsync(CropsApi);
            response.EnsureSuccessStatusCode();
            using var json = await JsonDocument.ParseAsync(await response.Content.ReadAsStreamAsync());
            var root = json.RootElement;
            if (root.ValueKind == JsonValueKind.Object &&
                (root.TryGetProperty("data", out var data) || root.TryGetProperty("Data", out data)))
                root = data;
            if (root.ValueKind != JsonValueKind.Array)
                throw new InvalidOperationException("Crop API must return an array.");
            var focusNames = CropOptions.ToHashSet(StringComparer.OrdinalIgnoreCase);
            crops = root.EnumerateArray()
                .Where(e => !string.Equals(Property(e, "IsActive"), "false", StringComparison.OrdinalIgnoreCase))
                .Select(e => new MasterOption { Id = Property(e, "Id"), Name = Property(e, "Name") })
                .Where(x => !string.IsNullOrWhiteSpace(x.Id) && focusNames.Contains(x.Name))
                .OrderBy(x => x.Name)
                .ToList();
            var first = crops.FirstOrDefault();
            if (first != null)
            {
                cropId = first.Id;
                crop = first.Name;
                await Task.WhenAll(LoadCropTypesAsync(), LoadCropStagesAsync());
            }
        }
        catch (Exception ex) { masterError = $"Unable to load crops: {ex.Message}"; }
        finally { loadingCrops = false; }
    }

    private async Task OnCropChanged(ChangeEventArgs args)
    {
        cropId = args.Value?.ToString() ?? "";
        crop = crops.FirstOrDefault(x => x.Id == cropId)?.Name ?? "";
        cropTypeId = "";
        cropType = "";
        cropTypes.Clear();
        cropStageId = "";
        cropStages.Clear();
        await Task.WhenAll(LoadCropTypesAsync(), LoadCropStagesAsync());
    }

    private async Task LoadCropTypesAsync()
    {
        var version = ++cropTypeRequestVersion;
        cropTypes.Clear();
        cropTypeId = "";
        cropType = "";
        if (string.IsNullOrEmpty(cropId)) { loadingCropTypes = false; return; }
        loadingCropTypes = true;
        masterError = "";
        try
        {
            using var response = await Http.GetAsync($"{CropTypesApi}?cropId={Uri.EscapeDataString(cropId)}");
            var results = await ReadNamedOptionsAsync(response);
            if (version == cropTypeRequestVersion) cropTypes = results;
        }
        catch (Exception ex)
        {
            if (version == cropTypeRequestVersion) masterError = $"Unable to load crop types: {ex.Message}";
        }
        finally { if (version == cropTypeRequestVersion) loadingCropTypes = false; }
    }

    private async Task LoadCropStagesAsync()
    {
        var version = ++cropStageRequestVersion;
        cropStages.Clear();
        cropStageId = "";
        if (string.IsNullOrEmpty(cropId))
        {
            loadingCropStages = false;
            return;
        }
        loadingCropStages = true;
        try
        {
            using var response = await Http.GetAsync($"{CropStagesApi}?cropId={Uri.EscapeDataString(cropId)}");
            var results = await ReadNamedOptionsAsync(response);
            if (version == cropStageRequestVersion) cropStages = results;
        }
        catch (Exception ex)
        {
            if (version == cropStageRequestVersion)
                masterError = $"Unable to load crop stages: {ex.Message}";
        }
        finally
        {
            if (version == cropStageRequestVersion) loadingCropStages = false;
        }
    }

    private static async Task<List<MasterOption>> ReadNamedOptionsAsync(HttpResponseMessage response)
    {
        response.EnsureSuccessStatusCode();
        using var json = await JsonDocument.ParseAsync(await response.Content.ReadAsStreamAsync());
        if (json.RootElement.ValueKind != JsonValueKind.Array)
            throw new InvalidOperationException("Master lookup API must return an array.");
        return json.RootElement.EnumerateArray()
            .Select(e => new MasterOption { Id = Property(e, "Id"), Name = Property(e, "Name") })
            .Where(x => !string.IsNullOrWhiteSpace(x.Id) && !string.IsNullOrWhiteSpace(x.Name))
            .OrderBy(x => x.Name).ToList();
    }

    private async Task LoadStatesAsync()
    {
        loadingStates = true;
        masterError = "";
        try
        {
            using var response = await Http.GetAsync(StatesApi);
            states = await ReadOptionsAsync(response, true);
        }
        catch (Exception ex) { masterError = $"Unable to load states: {ex.Message}"; }
        finally { loadingStates = false; }
    }

    private async Task OnStateChanged(ChangeEventArgs args)
    {
        stateId = args.Value?.ToString() ?? "";
        state = states.FirstOrDefault(x => x.Id == stateId)?.Name ?? "";
        districtId = "";
        district = "";
        districts.Clear();
        masterError = "";
        var version = ++districtRequestVersion;
        if (string.IsNullOrEmpty(stateId)) { loadingDistricts = false; return; }
        loadingDistricts = true;
        try
        {
            using var response = await Http.GetAsync($"{DistrictsApi}?stateId={Uri.EscapeDataString(stateId)}");
            var results = await ReadOptionsAsync(response, false);
            if (version == districtRequestVersion) districts = results;
        }
        catch (Exception ex)
        {
            if (version == districtRequestVersion) masterError = $"Unable to load districts: {ex.Message}";
        }
        finally { if (version == districtRequestVersion) loadingDistricts = false; }
    }

    private void OnDistrictChanged(ChangeEventArgs args)
    {
        districtId = args.Value?.ToString() ?? "";
        district = districts.FirstOrDefault(x => x.Id == districtId)?.Name ?? "";
    }

    private class DocumentationPayload
    {
        public int CSR2Id { get; set; }
        public string FarmerName { get; set; } = "";
        public string MobileNumber { get; set; } = "";
        public string? Village { get; set; }
        public string? FarmerAddress { get; set; }
        public int StateId { get; set; }
        public int DistrictId { get; set; }
        public string PinCode { get; set; } = "";
        public int CropId { get; set; }
        public int CropTypeId { get; set; }
        public DateTime? SowingDate { get; set; }
        public int? CropStageId { get; set; }
        public DateTime? HarvestDate { get; set; }
        public string? Remarks { get; set; }
    }

    private sealed class SavedDocumentation : DocumentationPayload
    {
        public string Status { get; set; } = "";
    }

    private async Task LoadSavedDocumentationAsync()
    {
        if (CSR2Id is null) return;
        using var response = await Http.GetAsync($"api/DemoDocumentation/documentation-details?csr2Id={CSR2Id.Value}");
        if (response.StatusCode == HttpStatusCode.NotFound) return;
        if (!response.IsSuccessStatusCode)
        {
            masterError = $"Unable to load existing documentation (HTTP {(int)response.StatusCode}).";
            return;
        }
        var saved = await response.Content.ReadFromJsonAsync<SavedDocumentation>();
        if (saved == null) return;
        farmerName = saved.FarmerName;
        mobile = saved.MobileNumber;
        village = saved.Village ?? "";
        address = saved.FarmerAddress ?? "";
        pinCode = saved.PinCode;

        remarks = saved.Remarks ?? "";
        sowingDate = saved.SowingDate;
        harvestDate = saved.HarvestDate;
        stateId = saved.StateId.ToString();
        state = states.FirstOrDefault(x => x.Id == stateId)?.Name ?? "";
        await LoadDistrictsForSelectedStateAsync();
        districtId = saved.DistrictId.ToString();
        district = districts.FirstOrDefault(x => x.Id == districtId)?.Name ?? "";
        cropId = saved.CropId.ToString();
        crop = crops.FirstOrDefault(x => x.Id == cropId)?.Name ?? "";
        await Task.WhenAll(LoadCropTypesAsync(), LoadCropStagesAsync());
        cropStageId = saved.CropStageId.HasValue && cropStages.Any(x => x.Id == saved.CropStageId.Value.ToString())
            ? saved.CropStageId.Value.ToString() : "";
        cropTypeId = saved.CropTypeId.ToString();
        cropType = cropTypes.FirstOrDefault(x => x.Id == cropTypeId)?.Name ?? "";
    }

    private async Task LoadDistrictsForSelectedStateAsync()
    {
        districts.Clear();
        if (string.IsNullOrWhiteSpace(stateId)) return;
        loadingDistricts = true;
        try
        {
            using var response = await Http.GetAsync($"{DistrictsApi}?stateId={Uri.EscapeDataString(stateId)}");
            districts = await ReadOptionsAsync(response, false);
        }
        finally { loadingDistricts = false; }
    }

    private Task SaveDraftAsync() => SaveAsync(false);
    private Task StartDocumentationAsync() => SaveAsync(true);

    private async Task SaveAsync(bool start)
    {
        saveError = saveSuccess = "";
        if (selected == null) return;
        if (!int.TryParse(stateId, out var sid) || !int.TryParse(districtId, out var did) ||
            !int.TryParse(cropId, out var cid) || !int.TryParse(cropTypeId, out var ctid) ||
            !int.TryParse(cropStageId, out var csid))
        {
            saveError = "Select State, District, Crop, Crop Type and Current Crop Stage.";
            return;
        }
        if (string.IsNullOrWhiteSpace(farmerName) ||
            mobile.Length != 10 || !mobile.All(char.IsDigit) ||
            pinCode.Length != 6 || !pinCode.All(char.IsDigit))
        {
            saveError = "Enter farmer name, a 10-digit mobile number and a 6-digit PIN code.";
            return;
        }
        isSaving = true;
        try
        {
            var data = new DocumentationPayload
            {
                CSR2Id = selected.Id,
                FarmerName = farmerName.Trim(),
                MobileNumber = mobile,
                Village = village,
                FarmerAddress = address,
                StateId = sid,
                DistrictId = did,
                PinCode = pinCode,
                CropId = cid,
                CropTypeId = ctid,
                SowingDate = sowingDate,
                CropStageId = csid,
                HarvestDate = harvestDate,
                Remarks = remarks
            };
            var endpoint = start ? "start" : "save-draft";
            using var response = await Http.PostAsJsonAsync($"api/DemoDocumentation/{endpoint}", data);
            if (!response.IsSuccessStatusCode)
            {
                saveError = $"Unable to save documentation (HTTP {(int)response.StatusCode}): {await response.Content.ReadAsStringAsync()}";
                return;
            }
            if (start) NavigationManager.NavigateTo($"/DemoDetails?csr2Id={selected.Id}");
            else saveSuccess = "Draft saved successfully.";
        }
        catch (Exception ex) { saveError = $"Unable to save documentation: {ex.Message}"; }
        finally { isSaving = false; }
    }
}
