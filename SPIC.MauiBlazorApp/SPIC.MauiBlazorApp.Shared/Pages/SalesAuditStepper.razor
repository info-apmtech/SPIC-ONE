@inject NavigationManager Nav

@* Five-step progress bar shared by the Sales Audit flow pages.
   Planning phase: Program -> Sales Plan -> Dealers -> Plan Review -> Tracking; completed steps
   link back to their page. Tracking phase (TrackingPhase="true"): Program -> Sales Plan ->
   Dealers -> Tracking -> Period-End Review. *@
<div class="sas-root">
    <div class="sas-stepper @(TrackingPhase ? "sas-tracking" : "")">
        @foreach (var step in ActiveSteps)
        {
            var state = step.Number < CurrentStep ? "done" : step.Number == CurrentStep ? "active" : "pending";

            @* On tablet/phone most labels are hidden; keep the name available on hover / long-press. *@
            <div class="sas-step sas-step-@state @(state == "done" && step.Href is not null && EffectiveCSR2Id is > 0 ? "sas-step-link" : "")"
                 title="@step.Label" aria-current="@(state == "active" ? "step" : null)"
                 @onclick="() => GoTo(step, state)">
                <span class="sas-step-circle">
                    @if (state == "done")
                    {
                        <SalesAuditIcon Name="check-circle" Size="26" StrokeWidth="2" />
                    }
                    else
                    {
                        @step.Number.ToString("00")
                    }
                </span>
                <div class="sas-step-text">
                    <span class="sas-step-label">@step.Label</span>
                    @if (state == "done")
                    {
                        <span class="sas-step-sub">Completed</span>
                    }
                    else if (state == "active")
                    {
                        <span class="sas-step-sub">Current</span>
                    }
                </div>
            </div>

            @if (step.Number < ActiveSteps.Count)
            {
                @* Tracking phase: only lines between two completed steps are solid. *@
                var lineDone = TrackingPhase ? step.Number + 1 < CurrentStep : step.Number < CurrentStep;
                <span class="sas-step-line @(lineDone ? "sas-line-done" : "")"></span>
            }
        }
    </div>
    @if (ActiveSteps.FirstOrDefault(s => s.Number == CurrentStep) is { } current)
    {
        <p class="sas-phone-caption">Step @CurrentStep of @ActiveSteps.Count · <strong>@current.Label</strong></p>
    }
</div>

@code {
    /// <summary>1-based number of the step being shown.</summary>
    [Parameter] public int CurrentStep { get; set; } = 1;

    /// <summary>Current approved CSR-2 programme identifier; required for navigation.</summary>
    [Parameter] public int? CSR2Id { get; set; }

    /// <summary>Show the post-confirmation steps (Tracking, Period-End Review).</summary>
    [Parameter] public bool TrackingPhase { get; set; }

    private record StepInfo(int Number, string Label, string? Href);

    private List<StepInfo> ActiveSteps => TrackingPhase ? TrackingSteps : PlanningSteps;

    // After the plan is confirmed the planning steps are locked, so they carry no link.
    private static readonly List<StepInfo> TrackingSteps = new()
    {
        new(1, "Program", null),
        new(2, "Sales Plan", null),
        new(3, "Dealers", null),
        new(4, "Tracking", "/SalesTracking"),
        new(5, "Period - End Review", "/PeriodEndReview"),
    };

    private static readonly List<StepInfo> PlanningSteps = new()
    {
        new(1, "Program", "/AuditOverview"),
        new(2, "Sales Plan", "/SalesPlan"),
        new(3, "Dealers", "/DealerMapping"),
        new(4, "Plan Review", "/PlanReview"),
        new(5, "Tracking", "/SalesTracking"),
    };

    // Prefer the ID supplied by the parent, but also accept the current URL query string.
    // This keeps existing pages working even if their stepper call has not been updated yet.
    private int? EffectiveCSR2Id
    {
        get
        {
            if (CSR2Id is > 0)
                return CSR2Id;

            var query = Nav.ToAbsoluteUri(Nav.Uri).Query.TrimStart('?');
            foreach (var entry in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
            {
                var pair = entry.Split('=', 2);
                if (pair.Length != 2 ||
                    !Uri.UnescapeDataString(pair[0]).Equals("csr2Id", StringComparison.OrdinalIgnoreCase))
                    continue;

                var rawId = Uri.UnescapeDataString(pair[1]);
                if (int.TryParse(rawId, out var id) && id > 0)
                    return id;
            }

            return null;
        }
    }

    private void GoTo(StepInfo step, string state)
    {
        // Keep original behavior: only completed, linked steps are navigable.
        if (state != "done" || string.IsNullOrWhiteSpace(step.Href))
            return;

        var csr2Id = EffectiveCSR2Id;
        if (csr2Id is not > 0)
            return;

        // Preserve the programme ID when moving between workflow pages.
        Nav.NavigateTo($"{step.Href}?csr2Id={csr2Id.Value}");
    }
}
