</style>

@code {
    private bool isLoading;
    private string errorMessage = "";
    private CSR2ListResponse response = new();
    private CSR2LookupResponse lookups = new();
    private List<LocationDto> locations = new();
    private Dictionary<int, string> locationNames = new();

    private DateTime? fromDate;
    private DateTime? toDate;
    private string selectedProgramType = "";
    private int selectedProgramId;
    private int selectedLocationId;
    private string selectedStatus = "";
    private string search = "";
    private int page = 1;
    private int pageSize = 16;

    private bool workflowActionBusy;

    private int TotalCount => response.TotalCount;

    private IEnumerable<ProgramLookupDto> FilteredPrograms =>
        string.IsNullOrWhiteSpace(selectedProgramType)
            ? lookups.Programs
            : lookups.Programs.Where(x => string.Equals(x.ProgramType, selectedProgramType, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        // Lookups and list data are independent HTTP requests. Load them together
        // so the page does not pay both network waits serially.
        await Task.WhenAll(LoadLookups(), LoadList());
    }

    private async Task LoadLookups()
    {
        try
        {
            lookups = await Http.GetFromJsonAsync<CSR2LookupResponse>("api/CSR2/list/lookups") ?? new();
            locations = await Http.GetFromJsonAsync<List<LocationDto>>("api/District/all") ?? new();
            locationNames = locations
                .GroupBy(x => x.Id)
                .ToDictionary(g => g.Key, g => g.First().DistrictName);
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to load filters: {ex.Message}";
        }
    }

    private async Task LoadList()
    {
        isLoading = true;
        errorMessage = "";
        try
        {
            var parameters = new List<string>
            {
                $"page={page}",
                $"pageSize={pageSize}"
            };

            if (fromDate.HasValue) parameters.Add($"fromDate={Uri.EscapeDataString(fromDate.Value.ToString("yyyy-MM-dd"))}");
            if (toDate.HasValue) parameters.Add($"toDate={Uri.EscapeDataString(toDate.Value.ToString("yyyy-MM-dd"))}");
            if (!string.IsNullOrWhiteSpace(selectedProgramType)) parameters.Add($"programType={Uri.EscapeDataString(selectedProgramType)}");
            if (selectedProgramId > 0) parameters.Add($"programId={selectedProgramId}");
            if (selectedLocationId > 0) parameters.Add($"locationId={selectedLocationId}");
            if (!string.IsNullOrWhiteSpace(selectedStatus) && Enum.TryParse<CSR2StatusValue>(selectedStatus, true, out var parsedStatus)) parameters.Add($"status={(int)parsedStatus}");
            if (!string.IsNullOrWhiteSpace(search)) parameters.Add($"search={Uri.EscapeDataString(search.Trim())}");

            response = await Http.GetFromJsonAsync<CSR2ListResponse>("api/CSR2/list?" + string.Join("&", parameters)) ?? new();
        }
        catch (Exception ex)
        {
            response = new();
            errorMessage = $"Unable to load CSR-2 list: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private Task ApplyFilters()
    {
        page = 1;
        return LoadList();
    }

    private async Task ClearFilters()
    {
        fromDate = null;
        toDate = null;
        selectedProgramType = "";
        selectedProgramId = 0;
        selectedLocationId = 0;
        selectedStatus = "";
        search = "";
        page = 1;
        await LoadList();
    }

    private void ProgramTypeChanged()
    {
        if (selectedProgramId > 0 && !FilteredPrograms.Any(x => x.Id == selectedProgramId))
            selectedProgramId = 0;
    }

    private async Task ApplyStatusCard(string? status)
    {
        selectedStatus = status ?? "";
        page = 1;
        await LoadList();
    }

    private Task Refresh() => LoadList();

    private async Task PreviousPage()
    {
        if (page <= 1) return;
        page--;
        await LoadList();
    }

    private async Task NextPage()
    {
        if (page >= response.TotalPages) return;
        page++;
        await LoadList();
    }

    private async Task PageSizeChanged()
    {
        page = 1;
        await LoadList();
    }

    private void OpenCSR2(int csr1Id) =>
        NavigationManager.NavigateTo($"/DealerManagementTrainingProgram?csr1Id={csr1Id}");

    private int GetStatusCount(string status) =>
        response.StatusCounts.FirstOrDefault(x => string.Equals(x.Status, status, StringComparison.OrdinalIgnoreCase))?.Count ?? 0;

    private string LocationName(int? id) =>
        !id.HasValue || id <= 0
            ? "-"
            : locationNames.TryGetValue(id.Value, out var name)
                ? name
                : $"Location #{id}";

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static string Money(decimal amount) => "₹ " + amount.ToString("N2", CultureInfo.GetCultureInfo("en-IN"));

    private static string StatusClass(string status) => status.ToLowerInvariant() switch
    {
        "draft" => "status-draft",
        "submitted" => "status-submitted",
        "validated" => "status-validated",
        "approved" => "status-approved",
        "rejected" => "status-rejected",
        "level1approved" => "status-validated",
        "level2approved" => "status-validated",
        _ => "status-draft"
    };

    private enum CSR2StatusValue
    {
        Draft = 0,
        Submitted = 1,
        Validated = 2,
        Approved = 3,
        Rejected = 4,
        Level1Approved = 5,
        Level2Approved = 6
    }

    private sealed class CSR2LookupResponse
    {
        public List<string> ProgramTypes { get; set; } = new();
        public List<ProgramLookupDto> Programs { get; set; } = new();
        public List<StatusLookupDto> Statuses { get; set; } = new();
    }

    private sealed class ProgramLookupDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string ProgramType { get; set; } = "";
    }

    private sealed class StatusLookupDto
    {
        public int Value { get; set; }
        public string Name { get; set; } = "";
    }

    private sealed class LocationDto
    {
        public int Id { get; set; }
        public string DistrictName { get; set; } = "";
    }

    private sealed class CSR2ListResponse
    {
        public int TotalCount { get; set; }
        public int Page { get; set; } = 1;
        public int PageSize { get; set; } = 16;
        public int TotalPages { get; set; } = 1;
        public List<StatusCountDto> StatusCounts { get; set; } = new();
        public List<CSR2ListRowDto> Items { get; set; } = new();
    }

    private sealed class StatusCountDto
    {
        public string Status { get; set; } = "";
        public int Count { get; set; }
    }

    private sealed class CSR2ListRowDto
    {
        public int CSR2Id { get; set; }
        public int CSR1Id { get; set; }
        public string SanctionNumber { get; set; } = "";
        public string ProgramType { get; set; } = "";
        public int ProgramId { get; set; }
        public string ProgramName { get; set; } = "";
        public int? LocationId { get; set; }
        public int? HeadquarterId { get; set; }
        public string Scope { get; set; } = "";
        public bool RequiresMultiLevelApproval { get; set; }
        public bool CanValidate { get; set; }
        public bool CanApprove { get; set; }
        public string ActionLabel { get; set; } = "";
        public decimal ApprovedBudget { get; set; }
        public string Status { get; set; } = "Draft";
        public int StatusValue { get; set; }
        public DateTime? ActualEventDate { get; set; }
        public TimeOnly? StartTime { get; set; }
        public TimeOnly? EndTime { get; set; }
        public string? EventCoordinatorEmployeeId { get; set; }
        public string? ActualLocation { get; set; }
        public int? ExpectedParticipantsCount { get; set; }
        public string? Remarks { get; set; }
        public int ParticipantCount { get; set; }
        public int EmployeeCount { get; set; }
        public int PhotoCount { get; set; }
        public int VideoCount { get; set; }
        public int ExpenseCount { get; set; }
        public decimal ActualExpense { get; set; }
        public int ProofCount { get; set; }
        public int ReportCompletion { get; set; }
    }

    private string CurrentRole => LoginState.UserRole.ToString();

    private bool IsRole(params string[] roles) =>
        roles.Any(role => string.Equals(CurrentRole, role, StringComparison.OrdinalIgnoreCase));

    private bool IsState(CSR2ListRowDto row) =>
        string.Equals(row.Scope, "State", StringComparison.OrdinalIgnoreCase);

    private bool CanValidate(CSR2ListRowDto row)
    {
        // Prefer the API permission when it is available.
        if (row.CanValidate)
            return true;

        // Preserve the old working list behavior as a UI fallback.
        // Validation is required in BOTH normal and exceeded-date workflows.
        if (!string.Equals(row.Status, "Submitted", StringComparison.OrdinalIgnoreCase))
            return false;

        return IsState(row)
            ? IsRole("SMD", "SMDO")
            : IsRole("MO");
    }

    private bool CanApprove(CSR2ListRowDto row) => row.CanApprove;

    private async Task ValidateCSR2(CSR2ListRowDto row)
    {
        if (workflowActionBusy)
            return;

        if (!CanValidate(row))
        {
            errorMessage =
                "You are not authorized to validate this CSR-2.";
            return;
        }

        workflowActionBusy = true;
        errorMessage = "";

        try
        {
            using var responseMessage =
                await Http.PostAsync(
                    $"api/CSR2/{row.CSR2Id}/validate",
                    null);

            if (!responseMessage.IsSuccessStatusCode)
            {
                var message =
                    await responseMessage.Content.ReadAsStringAsync();

                errorMessage =
                    string.IsNullOrWhiteSpace(message)
                        ? "Unable to validate CSR-2."
                        : message;

                return;
            }

            await LoadList();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"CSR-2 validation failed: {ex.Message}";
        }
        finally
        {
            workflowActionBusy = false;
        }
    }

    private async Task ApproveCSR2(CSR2ListRowDto row)
    {
        if (workflowActionBusy)
            return;

        if (!CanApprove(row))
        {
            errorMessage =
                "You are not authorized to approve this CSR-2.";
            return;
        }

        workflowActionBusy = true;
        errorMessage = "";

        try
        {
            using var responseMessage =
                await Http.PostAsync(
                    $"api/CSR2/{row.CSR2Id}/approve",
                    null);

            if (!responseMessage.IsSuccessStatusCode)
            {
                var message =
                    await responseMessage.Content.ReadAsStringAsync();

                errorMessage =
                    string.IsNullOrWhiteSpace(message)
                        ? "Unable to approve CSR-2."
                        : message;

                return;
            }

            await LoadList();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"CSR-2 approval failed: {ex.Message}";
        }
        finally
        {
            workflowActionBusy = false;
        }
    }

    private static int GetReportCompletion(CSR2ListRowDto row)
    {
        return row.StatusValue switch
        {
            (int)CSR2StatusValue.Draft => 0,
            (int)CSR2StatusValue.Submitted => 20,
            (int)CSR2StatusValue.Validated => 40,
            (int)CSR2StatusValue.Level1Approved => 60,
            (int)CSR2StatusValue.Level2Approved => 80,
            (int)CSR2StatusValue.Approved => 100,
            (int)CSR2StatusValue.Rejected => 0,
            _ => 0
        };
    }
}
