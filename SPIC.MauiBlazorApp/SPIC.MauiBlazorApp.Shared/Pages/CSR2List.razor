@page "/CSR-2List"
@using System.Net.Http.Json
@using System.Globalization
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject SPIC.MauiBlazorApp.Shared.Services.LoginState LoginState
<div class="csr2-list-page">
    <div class="csr2-list-header">
        <div>
            <h2>CSR-2 Program Execution</h2>
            <p>Manage assigned CSR-2 programs, track completion, attendance, media and expenses.</p>
        </div>
    </div>

    <div class="csr2-stats-grid">
        <button class="csr2-stat-card stat-blue" @onclick="() => ApplyStatusCard(null)">
            <div><strong>@TotalCount</strong><span>Total CSR-2</span></div>
            <span class="stat-icon">▣</span>
        </button>
        <button class="csr2-stat-card stat-green" @onclick='() => ApplyStatusCard("Approved")'>
            <div><strong>@GetStatusCount("Approved")</strong><span>Approved</span></div>
            <span class="stat-icon">✓</span>
        </button>
        <button class="csr2-stat-card stat-orange" @onclick='() => ApplyStatusCard("Submitted")'>
            <div><strong>@GetStatusCount("Submitted")</strong><span>Submitted</span></div>
            <span class="stat-icon">⌛</span>
        </button>
        <button class="csr2-stat-card stat-purple" @onclick='() => ApplyStatusCard("Draft")'>
            <div><strong>@GetStatusCount("Draft")</strong><span>Drafts</span></div>
            <span class="stat-icon">▧</span>
        </button>
    </div>

    <div class="csr2-filter-card">
        <div class="csr2-filter-title">☰ Filters</div>
        <div class="csr2-filter-grid">
            <div>
                <label>Date Range - From</label>
                <input type="date" class="form-control" @bind="fromDate" />
            </div>
            <div>
                <label>Date Range - To</label>
                <input type="date" class="form-control" @bind="toDate" />
            </div>
            <div>
                <label>Program Type</label>
                <select class="form-select" @bind="selectedProgramType" @bind:after="ProgramTypeChanged">
                    <option value="">All Program Type</option>
                    @foreach (var type in lookups.ProgramTypes)
                    {
                        <option value="@type">@type</option>
                    }
                </select>
            </div>
            <div>
                <label>Program Name</label>
                <select class="form-select" @bind="selectedProgramId">
                    <option value="0">All Program Name</option>
                    @foreach (var program in FilteredPrograms)
                    {
                        <option value="@program.Id">@program.Name</option>
                    }
                </select>
            </div>
            <div>
                <label>Location</label>
                <select class="form-select" @bind="selectedLocationId">
                    <option value="0">All Location</option>
                    @foreach (var location in locations.OrderBy(x => x.DistrictName))
                    {
                        <option value="@location.Id">@location.DistrictName</option>
                    }
                </select>
            </div>
            <div>
                <label>Status</label>
                <select class="form-select" @bind="selectedStatus">
                    <option value="">All Status</option>
                    @foreach (var status in lookups.Statuses)
                    {
                        <option value="@status.Name">@status.Name</option>
                    }
                </select>
            </div>
        </div>

        <div class="csr2-filter-actions">
            <button class="btn btn-light" @onclick="ClearFilters">Clear All</button>
            <button class="btn btn-primary" @onclick="ApplyFilters">Apply Filters</button>
        </div>
    </div>

    <div class="csr2-table-card">
        <div class="csr2-table-toolbar">
            <h3>Assigned Programs</h3>
            <div class="csr2-toolbar-right">
                <input class="form-control csr2-search" placeholder="Search Program or Sanction number" @bind="search" @bind:event="oninput" />
                <button class="btn btn-outline-secondary" @onclick="Refresh">↻ Refresh Data</button>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="csr2-state-message">Loading CSR-2 records...</div>
        }
        else if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger m-3">@errorMessage</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle csr2-table">
                    <thead>
                        <tr>
                            <th>Sanction Number</th>
                            <th>Program Type</th>
                            <th>Program Name</th>
                            <th>Location</th>
                            <th>Approved Budget</th>
                            <th>Event Date</th>
                            <th>Attendance</th>
                            <th>Media</th>
                            <th>Actual Expense</th>
                            <th>Report Completion</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (response.Items.Count == 0)
                        {
                            <tr><td colspan="12" class="text-center py-4 text-muted">No CSR-2 records found.</td></tr>
                        }
                        else
                        {
                            @foreach (var row in response.Items)
                            {
                                <tr @key="row.CSR2Id">
                                    <td><strong>@Display(row.SanctionNumber)</strong></td>
                                    <td>@Display(row.ProgramType)</td>
                                    <td>@Display(row.ProgramName)</td>
                                    <td>@LocationName(row.LocationId)</td>
                                    <td>@Money(row.ApprovedBudget)</td>
                                    <td>@(row.ActualEventDate?.ToString("dd MMM yyyy") ?? "-")</td>
                                    <td>@(row.ParticipantCount + row.EmployeeCount)</td>
                                    <td>@(row.PhotoCount + row.VideoCount)</td>
                                    <td>@Money(row.ActualExpense)</td>
                                    <td>
                                        @{
                                            var completion = GetReportCompletion(row);
                                        }

                                        <div class="completion-wrap">
                                            <div class="progress completion-progress">
                                                <div class="progress-bar"
                                                     style="width:@completion%">
                                                </div>
                                            </div>

                                            <span>@completion%</span>
                                        </div>
                                    </td>
                                    <td><span class="csr2-status @StatusClass(row.Status)">@row.Status</span></td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-2">

                                            <button type="button"
                                                    class="btn csr2-view-btn"
                                                    @onclick="() => OpenCSR2(row.CSR1Id)">
                                                <i class="bi bi-eye"></i>
                                                View Details
                                            </button>

                                            @if (CanValidate(row))
                                            {
                                                <button type="button"
                                                        class="btn btn-primary btn-sm"
                                                        disabled="@workflowActionBusy"
                                                        @onclick="() => ValidateCSR2(row)">
                                                    <i class="bi bi-check-circle"></i>
                                                    Validate
                                                </button>
                                            }

                                            @if (CanApprove(row))
                                            {
                                                <button type="button"
                                                        class="btn btn-success btn-sm"
                                                        disabled="@workflowActionBusy"
                                                        @onclick="() => ApproveCSR2(row)">
                                                    <i class="bi bi-check2-circle"></i>
                                                    @(string.IsNullOrWhiteSpace(row.ActionLabel) ? "Approve" : row.ActionLabel)
                                                </button>
                                            }

                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="csr2-pager">
                <div class="d-flex align-items-center gap-2">
                    <span>Items Per Page</span>
                    <select class="form-select csr2-page-size" @bind="pageSize" @bind:after="PageSizeChanged">
                        <option value="8">8</option>
                        <option value="16">16</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                    </select>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-outline-secondary" disabled="@(page <= 1)" @onclick="PreviousPage">‹</button>
                    <span>Page @(page) of @Math.Max(1, response.TotalPages)</span>
                    <button class="btn btn-sm btn-outline-secondary" disabled="@(page >= response.TotalPages)" @onclick="NextPage">›</button>
                </div>
            </div>
        }
    </div>
</div>

<style>
