    .csr2-stat-card {
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        background: #fff;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 15px;
        text-align: left;
        cursor: pointer
    }

        .csr2-stat-card strong {
            display: block;
            font-size: 22px
        }

        .csr2-stat-card span {
            font-size: 11px;
            color: #6b7280
        }

    .stat-icon {
        font-size: 20px !important
    }

    .stat-blue {
        border-top: 3px solid #3b82f6
    }

    .stat-green {
        border-top: 3px solid #22c55e
    }

    .stat-orange {
        border-top: 3px solid #f97316
    }

    .stat-purple {
        border-top: 3px solid #8b5cf6
    }

    .csr2-filter-card, .csr2-table-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        margin-bottom: 14px;
        box-shadow: 0 2px 8px rgba(15,23,42,.03)
    }

    .csr2-filter-title {
        font-size: 12px;
        font-weight: 700;
        padding: 12px 14px;
        border-bottom: 1px solid #eef1f4
    }

    .csr2-filter-grid {
        display: grid;
        grid-template-columns: repeat(3,minmax(0,1fr));
        gap: 12px;
        padding: 14px
    }

        .csr2-filter-grid label {
            display: block;
            font-size: 10px;
            font-weight: 600;
            margin-bottom: 5px;
            color: #475569
        }

    .csr2-filter-actions {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        padding: 0 14px 14px
    }

    .csr2-table-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 14px
    }

        .csr2-table-toolbar h3 {
            font-size: 14px;
            font-weight: 700;
            margin: 0
        }

    .csr2-toolbar-right {
        display: flex;
        gap: 8px;
        align-items: center
    }

    .csr2-search {
        width: 280px
    }

    .csr2-table {
        font-size: 11px;
        margin: 0
    }

        .csr2-table th {
            font-size: 10px;
            color: #475569;
            background: #f8fafc;
            white-space: nowrap
        }

        .csr2-table td {
