            font-size: 22px;
            font-weight: 700;
            margin: 0 0 4px
        }

        .csr2-list-header p {
            font-size: 12px;
            color: #6b7280;
            margin: 0
        }

    .csr2-stats-grid {
        display: grid;
        grid-template-columns: repeat(4,minmax(0,1fr));
        gap: 12px;
