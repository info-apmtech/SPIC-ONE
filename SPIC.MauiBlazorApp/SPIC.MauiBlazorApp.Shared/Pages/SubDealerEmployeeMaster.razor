				}
				: new
				{
					_subDealerForm.BeneficiaryId,
					_subDealerForm.DealerCode,
					_subDealerForm.MainDealerFirmName,
					_subDealerForm.HQ,
					_subDealerForm.BranchDistrict,
					_subDealerForm.SubDealerCode,
					_subDealerForm.SubDealerName,
					_subDealerForm.SubDealerDistrict,
					_subDealerForm.NomineeName,
					_subDealerForm.BeneficiaryName,
					_subDealerForm.DOB,
					_subDealerForm.Relationship,
					_subDealerForm.IsActive,
					CreatedAt = DateTime.Now,
					UpdatedAt = DateTime.Now,
					CreatedBy = (_currentUserId ?? "current-user"),
					UpdatedBy = (_currentUserId ?? "current-user")
				};
		}
		else
		{
			emptyFieldError =
				string.IsNullOrWhiteSpace(_employeeForm.DealerCode) ? "Dealer Code is required." :
				string.IsNullOrWhiteSpace(_employeeForm.EmployeeName) ? "Employee Name is required." :
				string.IsNullOrWhiteSpace(_employeeForm.BeneficiaryName) ? "Beneficiary Name is required." :
				string.Empty;

			payload = _isEditing
				? new
				{
					Id = _editingId!.Value,
					_employeeForm.BeneficiaryId,
					_employeeForm.DealerCode,
					_employeeForm.EmployeeName,
					_employeeForm.BeneficiaryName,
					_employeeForm.DOB,
					_employeeForm.Relationship,
					_employeeForm.MaritalStatus,
					_employeeForm.EducationalQualification,
					_employeeForm.IsActive,
					UpdatedBy = (_currentUserId ?? "current-user")
				}
				: new
				{
					_employeeForm.BeneficiaryId,
					_employeeForm.DealerCode,
					_employeeForm.EmployeeName,
					_employeeForm.BeneficiaryName,
					_employeeForm.DOB,
					_employeeForm.Relationship,
					_employeeForm.MaritalStatus,
					_employeeForm.EducationalQualification,
					_employeeForm.IsActive,
					CreatedAt = DateTime.Now,
					UpdatedAt = DateTime.Now,
					CreatedBy = (_currentUserId ?? "current-user"),
					UpdatedBy = (_currentUserId ?? "current-user")
				};
		}

		if (!string.IsNullOrEmpty(emptyFieldError))
		{
			ShowMessage(emptyFieldError, true);
			return;
		}

		var singularName = ActiveTab == TabSubDealer ? "Sub Dealer" : "Employee";

		try
		{
			_isSaving = true;

			HttpResponseMessage response;
			if (_isEditing && _editingId.HasValue)
			{
				response = await Http.PutAsJsonAsync($"{CurrentApiBase}/{_editingId.Value}", payload);
				if (!response.IsSuccessStatusCode)
				{
					var error = await response.Content.ReadAsStringAsync();
					ShowMessage($"Update failed: {error}", true);
					return;
				}
				ShowMessage($"{singularName} updated successfully.", false);
			}
			else
			{
				response = await Http.PostAsJsonAsync(CurrentApiBase, payload);
				if (!response.IsSuccessStatusCode)
				{
					var error = await response.Content.ReadAsStringAsync();
					ShowMessage($"Create failed: {error}", true);
					return;
				}
				ShowMessage($"{singularName} created successfully.", false);
			}

			ResetForm();
			await LoadTabData();
		}
		catch (Exception ex)
		{
			ShowMessage($"Error: {ex.Message}", true);
		}
		finally
		{
			_isSaving = false;
		}
	}

