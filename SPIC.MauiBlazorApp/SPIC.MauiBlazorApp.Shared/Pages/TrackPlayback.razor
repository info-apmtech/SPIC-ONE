@page "/TrackPlayback"
@implements IAsyncDisposable
@using SPIC.Core.Entities
@using SPIC.Core.DTOs
@using SPIC.Core.Utilities
@inject NavigationManager Navigation
@inject SPIC.MauiBlazorApp.Shared.Services.ToastService Toast
@inject SPIC.MauiBlazorApp.Shared.Services.FieldAttendanceState AttendanceState
@inject SPIC.MauiBlazorApp.Shared.Services.JMDOTrackingApi TrackingApi
@inject SPIC.MauiBlazorApp.Shared.Services.IFormFactor FormFactor
@inject SPIC.MauiBlazorApp.Shared.Services.NavHistoryService NavHistory
@inject SPIC.MauiBlazorApp.Shared.Services.JmdoTrackingClientLoop TrackingLoop
@inject SPIC.MauiBlazorApp.Shared.Services.LoginState LoginState
@inject IJSRuntime JS

@*
    Split out of MarkAttendance.razor (requirement, 2026-11-05): Track Playback is its own page/
    route/component now instead of a view-state branch shared with Mark Attendance - no more
    "view=tracking" query string, no more one component juggling three unrelated screens. The
    "ma-" CSS classes are intentionally kept (wwwroot/css/MarkAttendance.css is a global
    stylesheet, not scoped to that one component) so this page's look stays pixel-identical.
*@

<div class="container-fluid py-4 px-0 ma-page">

    <div class="ma-header-row">
        <button type="button" class="ma-back-btn" @onclick="GoBack" aria-label="Go back" title="Go back">
            <i class="bi bi-arrow-left"></i>
        </button>
        <div class="ma-header-text">
            <h2 class="ma-title">Track Playback</h2>
            <p class="ma-subtitle">Your tracking history for the last 7 days.</p>
        </div>
    </div>

    @* Two views sharing this one page: Playback History (self-scoped, unchanged below) and Live
       Tracking (read-only - never starts/stops anyone's tracking; see the @code region). Playback
       History stays the default view on load. *@
    <div class="ma-session-picker mb-3">
        <button type="button" class="@("ma-session-chip" + (!_liveTabActive ? " active" : ""))" @onclick="() => SwitchTabAsync(false)">Playback History</button>
        <button type="button" class="@("ma-session-chip" + (_liveTabActive ? " active" : ""))" @onclick="() => SwitchTabAsync(true)">Live Tracking</button>
    </div>

    @if (_liveTabActive)
    {
        @if (_liveLoading)
        {
            <div class="ma-tracking-card">
                <EmptyState Icon="bi-hourglass-split" Title="Loading live tracking..." Compact="true" />
            </div>
        }
        else if (_liveRoster.Count == 0)
        {
            <div class="ma-tracking-card">
                <EmptyState Icon="bi-geo-alt"
                            Title="No one to show"
                            Message="You don't have permission to view anyone's tracking, or no one was found."
                            Compact="true" />
            </div>
        }
        else
        {
            <div class="ma-card">
                <h4 class="ma-weekly-title">@(IsSupervisorRole ? "Your team" : "Your tracking")</h4>
                <div class="ma-session-picker">
                    @foreach (var row in _liveRoster)
                    {
                        <button type="button"
                                class="@("ma-session-chip" + (row.UserId == _liveSelectedUserId ? " active" : ""))"
                                @onclick="() => SelectLiveEmployee(row)">
                            @row.JmdoName
                            <span class="tt-status @StatusClass(row.LiveStatus, row.LastPointAt) ms-1"><span class="tt-status-dot"></span>@StatusLabel(row.LiveStatus, row.LastPointAt)</span>
                        </button>
                    }
                </div>
            </div>

            @if (SelectedLiveRow is { } selected)
            {
                <div class="ma-tracking-card mt-3">
                    <div class="ma-tracking-header">
                        <div class="ma-tracking-left">
                            <span class="ma-tracking-icon"><i class="bi bi-geo-alt-fill"></i></span>
                            <div class="ma-tracking-left-text">
                                <div class="ma-tracking-title">@selected.JmdoName</div>
                                <div class="ma-tracking-sub">
                                    @(string.IsNullOrWhiteSpace(selected.Designation) ? "" : selected.Designation + " · ")<span class="tt-status @StatusClass(selected.LiveStatus, selected.LastPointAt)"><span class="tt-status-dot"></span>@StatusLabel(selected.LiveStatus, selected.LastPointAt)</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="ma-tracking-sub mt-2">
                        <div>Tracking started: @(selected.SessionStartTime?.ToString("dd MMM yyyy, hh:mm tt") ?? "—")</div>
                        <div>Last location update: @(selected.LastPointAt?.ToString("dd MMM yyyy, hh:mm tt") ?? "—")</div>
                        <div>Location: @(selected.LastLatitude is { } slat && selected.LastLongitude is { } slng ? $"{slat:0.####}, {slng:0.####}" : "—")</div>
                        <div>GPS accuracy: @(selected.LastAccuracy is { } acc ? $"±{acc:0}m" : "—")</div>
                    </div>

                    @if (selected.SessionId is not null)
                    {
                        @* Live Tracking shows the current-location marker only - no route polyline, no
                           start/end markers. Playback History (below, untouched) keeps the full route
                           view with initTrackingRouteMap/updateTrackingRouteMap; this uses its own
                           dedicated initLiveLocationMap/updateLiveLocationMarker pair instead. *@
                        <div class="ma-map ma-live-map mt-2">
                            <div id="ma-live-tracking-map" class="ma-map-canvas"></div>
                            <button type="button" class="ma-live-recenter-btn" @onclick="RecenterLiveMapAsync" title="Recenter on current location">
                                <i class="bi bi-crosshair"></i>
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="ma-tracking-sub mt-2">No tracking session to show on the map yet.</div>
                    }
                </div>
            }
        }
    }
    else if (_trackLoading)
    {
        <div class="ma-tracking-card">
            <EmptyState Icon="bi-hourglass-split" Title="Loading tracking history..." Compact="true" />
        </div>
    }
    else
    {
        @* Live Tracking card: only rendered while a session is genuinely Active AND on the native app
           - a distinct, top-of-page card (not just a status line inside the playback card) so "I'm
           tracking right now" is unmistakable, plus a one-tap way to get turn-by-turn directions to
           the most recent fix. Web is playback-only (see IsNativeApp/_liveSession) - no Stop control,
           no live-refresh polling - so this card never shows there; the active session still appears
           as a normal, non-live entry in "Other playbacks available" instead. *@
        @if (_liveSession is not null)
        {
            <div class="ma-tracking-card ma-tracking-card-live">
                <div class="ma-tracking-header">
                    <div class="ma-tracking-left">
                        <span class="ma-tracking-icon"><i class="bi bi-geo-alt-fill"></i></span>
                        <div class="ma-tracking-left-text">
                            <div class="ma-tracking-title">Tracking Active<span class="ma-tracking-dot"></span></div>
                            <div class="ma-tracking-sub">Your location is being tracked in real-time</div>
                        </div>
                    </div>

                    <div class="ma-tracking-actions">
                        <button type="button" class="ma-btn-stop" disabled="@_stopping" @onclick="StopTracking">
                            <i class="bi bi-stop-circle-fill"></i> Stop Tracking
                        </button>
                        <span class="ma-timer-badge"><i class="bi bi-stopwatch"></i> @FormatElapsed(_trackElapsed)</span>
                    </div>
                </div>

                <button type="button" class="ma-btn-submit mt-2" @onclick="OpenDirections" disabled="@(LiveLatitude is null)">
                    <i class="bi bi-signpost-2-fill"></i> Directions to live location
                </button>
            </div>
        }

        @* Other playbacks available: every OTHER session from the last 7 days (the live one, if any,
           already has its own card above) - tapping one loads its route into the map/scrubber below. *@
        @if (_otherSessions.Count > 0)
        {
            <div class="ma-card mt-3">
                <h4 class="ma-weekly-title">Other playbacks available</h4>
                <div class="ma-session-picker">
                    @foreach (var s in _otherSessions)
                    {
                        <button type="button"
                                class="@("ma-session-chip" + (s.Id == _trackSession?.Id ? " active" : ""))"
                                @onclick="() => SelectSession(s)">
                            @FormatSessionLabel(s)
                        </button>
                    }
                </div>
            </div>
        }

        @if (_trackSession is null)
        {
            <div class="ma-tracking-card mt-3">
                <EmptyState Icon="bi-geo-alt"
                            Title="No tracking sessions in the last 7 days"
                            Message="Start live tracking from the Field Dashboard to record your route."
                            Compact="true" />
            </div>
        }
        else
        {
            <div class="ma-tracking-card mt-3">
                @if (_liveSession is null)
                {
                    @* Historical playback and live tracking are conceptually separate - this heading
                       must never say "Tracking Stopped" just because the user is viewing a route or
                       because playback animation is paused. The status pill reflects the session's
                       OWN actual LiveStatus (same StatusLabel/StatusClass Live Tracking uses) instead
                       of a hardcoded label, so an Active session viewed here (e.g. on Web, where the
                       "Tracking Active" card above is native-only and never shows) still reads
                       correctly instead of falsely "Stopped". *@
                    <div class="ma-tracking-header">
                        <div class="ma-tracking-left">
                            <span class="ma-tracking-icon"><i class="bi bi-geo-alt-fill"></i></span>
                            <div class="ma-tracking-left-text">
                                <div class="ma-tracking-title">Route Playback</div>
                                <div class="ma-tracking-sub">
                                    @FormatSessionTimeRange(_trackSession)
                                    @if (_trackDistanceKm > 0)
                                    {
                                        <span> · @(_trackDistanceKm.ToString("0.0")) km</span>
                                    }
                                    ·
                                    <span class="tt-status @StatusClass(_trackSession.LiveStatus, _trackSession.LastPointAt)">
                                        <span class="tt-status-dot"></span>@StatusLabel(_trackSession.LiveStatus, _trackSession.LastPointAt)
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <div class="ma-map">
                    <div id="ma-tracking-map" class="ma-map-canvas"></div>
                </div>

                @if (_trackPoints.Count >= 2)
                {
                    <div class="ma-playback-bar">
                        <div class="ma-playback-row">
                            <button type="button" class="ma-playback-btn" @onclick="TogglePlayback" aria-label="@(_playbackPlaying ? "Pause" : "Play")">
                                <i class="bi @(_playbackPlaying ? "bi-pause-fill" : "bi-play-fill")"></i>
                            </button>

                            <input type="range" class="ma-playback-scrubber"
                                   min="0" max="@(_trackPoints.Count - 1)" value="@_playbackIndex"
                                   @oninput="OnScrubberInput" />
                        </div>

                        <div class="ma-playback-row ma-playback-row-meta">
                            <span class="ma-playback-time">@PlaybackTimeLabel</span>

                            <div class="ma-playback-speed">
                                @foreach (var speed in PlaybackSpeeds)
                                {
                                    <button type="button" class="@(speed == _playbackSpeed ? "active" : "")" @onclick="() => SetPlaybackSpeed(speed)">@speed.ToString("0.#")x</button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }

</div>

@code {
    // Unlike FieldDashboard/MarkAttendance (which gate their whole page to native, since those pages
    // start/record live tracking), Track Playback is view-only history and is open to web too.
    // IsNativeApp instead scopes down the "live" pieces specifically - the Live Tracking card
    // (Stop Tracking, Directions to live location) and the 15s live-refresh loop - so a web visitor
    // can review any recorded route but never watch/control a session in real time.
    private bool IsNativeApp => FormFactor.GetFormFactor() != "Web";

    // Same ?tab= convention TasksAllocation.razor already uses. "live" opens Live Tracking (e.g.
    // FieldDashboard's View Route, when an Active session exists); "history" or anything else/absent
    // keeps the existing default (Playback History) - a manual user visit to /TrackPlayback is
    // completely unaffected.
    [SupplyParameterFromQuery(Name = "tab")]
    public string? TabQuery { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadTrackingViewAsync();

        if (string.Equals(TabQuery, "live", StringComparison.OrdinalIgnoreCase))
            await SwitchTabAsync(true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_liveTabActive)
        {
            if (!_liveLoading && _liveSelectedSessionId is not null)
                await RenderLiveMapAsync();
        }
        else if (!_trackLoading && _trackSession is not null)
        {
            await RenderTrackingMapAsync();
        }
    }

    // ---- Tracking view: a real route map (tracking-map.js, Leaflet) for one of the last 7 days'
    // sessions - see LoadTrackingViewAsync. A JMDO can Start/Stop Live Tracking more than once a day
    // (separate site visits); _historySessions holds every one from the last 7 days (most recent
    // first) so SelectSession can switch which route is shown instead of only ever seeing the latest.
    private List<JMDOTrackingSessionDto> _historySessions = new();
    private JMDOTrackingSessionDto? _trackSession;
    private List<JMDOTrackingPointDto> _trackPoints = new();
    private List<List<JMDOTrackingPointDto>> _routeSegments = new();
    private double _trackDistanceKm;
    private bool _trackLoading = true;
    private TimeSpan _trackElapsed;
    private System.Threading.Timer? _trackElapsedTimer;
    private CancellationTokenSource? _trackRefreshCts;
    private int? _mapInitializedForSessionId;
    private bool _mapPointsDirty;

    private void SetTrackPoints(List<JMDOTrackingPointDto> points)
    {
        var cleaned = GpsTrajectoryFilter.CleanPoints(points);
        _routeSegments = GpsTrajectoryFilter.SegmentPoints(cleaned);
        _trackPoints = new List<JMDOTrackingPointDto>(cleaned.Count);
        for (var s = 0; s < _routeSegments.Count; s++)
        {
            foreach (var pt in _routeSegments[s])
            {
                pt.SegmentIndex = s;
                _trackPoints.Add(pt);
            }
        }
        _trackDistanceKm = GpsTrajectoryFilter.CalculateTravelDistanceKm(_trackPoints);
        _mapPointsDirty = true;
    }

    // The caller can have at most one Active session server-side (JMDOTrackingController.Start), but
    // it may not be the one currently selected for playback (_trackSession) - the JMDO can browse an
    // older day's route via "Other playbacks available" while their own live session keeps running
    // underneath. The Live Tracking card always reflects this, independently of what's on screen.
    // Web never gets a "live" session at all (IsNativeApp guard) - its Active session, if any, is just
    // another entry in _otherSessions, playable like any other recorded route.
    private JMDOTrackingSessionDto? _liveSession =>
        IsNativeApp ? _historySessions.FirstOrDefault(s => s.Status == JMDOTrackingSessionStatus.Active) : null;

    // Every session except the live one, which already has its own card above - keeps the live
    // session from being listed twice while still letting the JMDO switch between every other day's
    // route, including re-selecting whichever one is currently shown (highlighted "active" below).
    private List<JMDOTrackingSessionDto> _otherSessions =>
        _historySessions.Where(s => s.Id != _liveSession?.Id).ToList();

    // Freshest when the live session is also the one currently selected for playback (its points
    // refresh every 15s via RefreshLoopAsync); otherwise falls back to the snapshot LoadTrackingViewAsync
    // last loaded _historySessions with.
    private double? LiveLatitude =>
        _trackSession?.Id == _liveSession?.Id && _trackPoints.Count > 0 ? _trackPoints[^1].Latitude
        : _liveSession?.LastLatitude ?? _liveSession?.StartLatitude;

    private double? LiveLongitude =>
        _trackSession?.Id == _liveSession?.Id && _trackPoints.Count > 0 ? _trackPoints[^1].Longitude
        : _liveSession?.LastLongitude ?? _liveSession?.StartLongitude;

    // Turn-by-turn directions TO the live fix - useful for a supervisor heading to meet the JMDO, or
    // the JMDO themselves navigating back to an already-logged point. Deliberately scoped to the live
    // session only (not offered for historical playback, where "directions to where I already was"
    // has no real use).
    private async Task OpenDirections()
    {
        if (LiveLatitude is not { } lat || LiveLongitude is not { } lng)
        {
            Toast.Warning("No location captured yet for this session.");
            return;
        }

        var url = FormattableString.Invariant($"https://www.google.com/maps/dir/?api=1&destination={lat},{lng}");
        try { await JS.InvokeVoidAsync("open", url, "_blank"); }
        catch (Exception ex) { Toast.Error("Could not open directions: " + ex.Message); }
    }

    // ---- Route playback: steps a "playhead" through _trackPoints over time (tracking-map.js's
    // setPlaybackPosition draws the amber trail/marker; all timing lives here, same split of
    // responsibility as the live elapsed-timer badge). Compressed time, not real-world-accurate -
    // watching a multi-hour session back at real speed would be useless for a quick review.
    private static readonly double[] PlaybackSpeeds = { 1, 2, 4 };
    private const int BasePlaybackTickMs = 400;

    private int _playbackIndex;
    private bool _playbackPlaying;
    private double _playbackSpeed = 1;
    private System.Threading.Timer? _playbackTimer;

    private string PlaybackTimeLabel =>
        _trackPoints.Count == 0 ? "--:--:--"
        : _trackPoints[Math.Clamp(_playbackIndex, 0, _trackPoints.Count - 1)].RecordedAt.ToString("hh:mm:ss tt");

    private void TogglePlayback()
    {
        if (_playbackPlaying)
        {
            PausePlayback();
            _ = RenderPlaybackPositionAsync();
            return;
        }

        if (_trackPoints.Count < 2) return;
        if (_playbackIndex >= _trackPoints.Count - 1) _playbackIndex = 0; // replay from the start

        _playbackPlaying = true;
        _ = RenderPlaybackPositionAsync();
        _playbackTimer?.Dispose();
        _playbackTimer = new System.Threading.Timer(PlaybackTick, null,
            (int)(BasePlaybackTickMs / _playbackSpeed), (int)(BasePlaybackTickMs / _playbackSpeed));
    }

    private void PausePlayback()
    {
        _playbackPlaying = false;
        _playbackTimer?.Dispose();
        _playbackTimer = null;
    }

    private void PlaybackTick(object? _)
    {
        if (_playbackIndex >= _trackPoints.Count - 1)
        {
            InvokeAsync(PausePlayback);
            return;
        }

        _playbackIndex++;
        _ = InvokeAsync(async () =>
        {
            await RenderPlaybackPositionAsync();
            StateHasChanged();
        });
    }

    private async Task OnScrubberInput(ChangeEventArgs e)
    {
        PausePlayback(); // manual scrubbing takes over from auto-play
        if (int.TryParse(e.Value?.ToString(), out var index))
        {
            _playbackIndex = Math.Clamp(index, 0, Math.Max(0, _trackPoints.Count - 1));
            await RenderPlaybackPositionAsync();
        }
    }

    private void SetPlaybackSpeed(double speed)
    {
        _playbackSpeed = speed;
        if (_playbackPlaying)
        {
            // Restart at the new cadence rather than letting the old interval finish one more tick.
            _playbackTimer?.Dispose();
            _playbackTimer = new System.Threading.Timer(PlaybackTick, null,
                (int)(BasePlaybackTickMs / _playbackSpeed), (int)(BasePlaybackTickMs / _playbackSpeed));
        }
    }

    private async Task RenderPlaybackPositionAsync()
    {
        if (_trackPoints.Count == 0) return;
        var points = _trackPoints.Select(p => new {
            latitude = p.Latitude,
            longitude = p.Longitude,
            segmentIndex = p.SegmentIndex
        });
        try { await JS.InvokeVoidAsync("setPlaybackPosition", "ma-tracking-map", points, _playbackIndex, _playbackPlaying, _playbackSpeed); }
        catch (Exception) { /* map not ready yet - next render/tick will retry */ }
    }

    private static string FormatElapsed(TimeSpan ts) =>
        $"{(int)ts.TotalHours:D2}:{ts.Minutes:D2}:{ts.Seconds:D2}";

    // Loads every session the JMDO ran in the last 7 days, then selects the live Active one if there
    // is one, otherwise the most recently started - so a page reached via "View Tracking Details"
    // (right after Stop) still shows the route just recorded instead of an empty state. The rest of
    // the week's sessions stay available via the picker (SelectSession) instead of being discarded.
    private const int HistoryDays = 7;

    private async Task LoadTrackingViewAsync()
    {
        _trackLoading = true;
        StateHasChanged();

        _historySessions = await TrackingApi.GetMineHistoryAsync(HistoryDays);
        _trackSession = _historySessions.FirstOrDefault(s => s.Status == JMDOTrackingSessionStatus.Active)
            ?? _historySessions.FirstOrDefault(); // most-recent-first list, so First = most recently started
        var points = _trackSession is null ? new() : await TrackingApi.GetSessionPointsAsync(_trackSession.Id);
        SetTrackPoints(points);

        _trackLoading = false;
        StateHasChanged();

        StartElapsedTimer();
        StartRefreshLoopIfActive();
    }

    // Switches the map/playback to a different one of the last 7 days' sessions - everything else
    // (RenderTrackingMapAsync's own session-id guard) already resets the map/playhead correctly for
    // a changed _trackSession.Id, so this just needs to load that session's own points.
    private async Task SelectSession(JMDOTrackingSessionDto session)
    {
        if (_trackSession?.Id == session.Id) return;

        PausePlayback();
        _trackSession = session;
        var points = await TrackingApi.GetSessionPointsAsync(session.Id);
        SetTrackPoints(points);

        StartElapsedTimer();
        StartRefreshLoopIfActive();
        StateHasChanged();
    }

    // Sessions can span the last 7 days (not just today), so every chip needs a day reference -
    // "Today"/"Yesterday" for the two most recent days (the common case), an explicit date otherwise.
    private static string FormatSessionDay(DateTime startTime)
    {
        var days = (DateTime.Today - startTime.Date).Days;
        return days switch
        {
            0 => "Today",
            1 => "Yesterday",
            _ => startTime.ToString("dd MMM")
        };
    }

    private static string FormatSessionLabel(JMDOTrackingSessionDto s)
    {
        var day = FormatSessionDay(s.StartTime);
        return s.Status == JMDOTrackingSessionStatus.Active
            ? $"Live · {day} {s.StartTime:h:mm tt}"
            : s.EndTime is { } end
                ? $"{day} {s.StartTime:h:mm tt} – {end:h:mm tt}"
                : $"{day} {s.StartTime:h:mm tt}";
    }

    // Same time range as FormatSessionLabel but without its own hardcoded "Live ·" prefix - used
    // next to the Route Playback header's own accurate status pill, so the two never contradict
    // each other (e.g. "Live · ... · Signal delayed").
    private static string FormatSessionTimeRange(JMDOTrackingSessionDto s)
    {
        var day = FormatSessionDay(s.StartTime);
        return s.EndTime is { } end
            ? $"{day} {s.StartTime:h:mm tt} – {end:h:mm tt}"
            : $"{day} {s.StartTime:h:mm tt}";
    }

    private void StartElapsedTimer()
    {
        _trackElapsedTimer?.Dispose();
        _trackElapsedTimer = null;
        if (_trackSession is null) return;

        void Tick(object? _)
        {
            _trackElapsed = _trackSession.Status == JMDOTrackingSessionStatus.Active
                ? DateTime.Now - _trackSession.StartTime
                : (_trackSession.Duration ?? TimeSpan.Zero);
            _ = InvokeAsync(StateHasChanged);
        }

        Tick(null);
        _trackElapsedTimer = new System.Threading.Timer(Tick, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    // Polls for new points only while the session is genuinely still Active - stops itself the
    // moment it sees the session end (stopped from here, auto-ended server-side, or from another
    // device), so this never keeps polling a finished session forever. Native-only: web is
    // playback-only and must not watch a session update in real time (see IsNativeApp).
    private void StartRefreshLoopIfActive()
    {
        _trackRefreshCts?.Cancel();
        _trackRefreshCts = null;
        if (!IsNativeApp || _trackSession?.Status != JMDOTrackingSessionStatus.Active) return;

        var cts = new CancellationTokenSource();
        _trackRefreshCts = cts;
        _ = RefreshLoopAsync(cts.Token);
    }

    private async Task RefreshLoopAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(15));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                var latest = await TrackingApi.GetMineActiveAsync();
                if (ct.IsCancellationRequested) return;

                _trackSession = latest ?? await TrackingApi.GetMineLatestAsync();
                if (ct.IsCancellationRequested) return;

                if (_trackSession is not null)
                {
                    var points = await TrackingApi.GetSessionPointsAsync(_trackSession.Id, ct: ct);
                    SetTrackPoints(points);
                }
                if (ct.IsCancellationRequested) return;

                StartElapsedTimer(); // reflects a status change (e.g. now Stopped) in the ticking badge
                await InvokeAsync(StateHasChanged);

                if (_trackSession?.Status != JMDOTrackingSessionStatus.Active)
                    return; // session ended - nothing left to keep polling for
            }
        }
        catch (OperationCanceledException)
        {
            // Expected when this page is torn down - see DisposeAsync.
        }
    }

    private async Task StopTrackingViewLiveUpdatesAsync()
    {
        _trackElapsedTimer?.Dispose();
        _trackElapsedTimer = null;
        _trackRefreshCts?.Cancel();
        _trackRefreshCts = null;
        PausePlayback();

        if (_mapInitializedForSessionId is not null)
        {
            _mapInitializedForSessionId = null;
            try { await JS.InvokeVoidAsync("destroyTrackingRouteMap", "ma-tracking-map"); }
            catch (Exception) { /* page/circuit may already be gone */ }
        }
    }

    private async Task RenderTrackingMapAsync()
    {
        var freshSession = false;

        if (_mapInitializedForSessionId != _trackSession!.Id)
        {
            var firstValid = _trackPoints.FirstOrDefault(p => GpsTrajectoryFilter.IsValidCoordinate(p.Latitude, p.Longitude));
            var startLat = firstValid?.Latitude ?? _trackSession.StartLatitude ?? 0;
            var startLng = firstValid?.Longitude ?? _trackSession.StartLongitude ?? 0;
            try
            {
                await JS.InvokeVoidAsync("initTrackingRouteMap", "ma-tracking-map", startLat, startLng);
                _mapInitializedForSessionId = _trackSession.Id;
                _mapPointsDirty = true; // force the first draw right after init
                freshSession = true;

                // Fresh/changed session - reset the playhead instead of carrying over a previous
                // session's playback position.
                PausePlayback();
                _playbackIndex = 0;
                try { await JS.InvokeVoidAsync("clearPlayback", "ma-tracking-map"); }
                catch (Exception) { /* nothing to clear yet on a brand-new map instance */ }
            }
            catch (Exception)
            {
                return; // map element not in the DOM yet - OnAfterRenderAsync will retry next render
            }
        }

        if (_mapPointsDirty && _trackPoints.Count > 0)
        {
            var segmentsPayload = _routeSegments
                .Where(seg => seg.Count > 0)
                .Select(seg => seg.Select(p => new {
                    latitude = p.Latitude,
                    longitude = p.Longitude,
                    segmentIndex = p.SegmentIndex
                }).ToList())
                .ToList();

            await JS.InvokeVoidAsync("updateTrackingRouteMap", "ma-tracking-map", segmentsPayload);
            _mapPointsDirty = false;

            if (freshSession)
                await RenderPlaybackPositionAsync(); // shows the playhead at the start, before Play is pressed
        }
    }

    // ---- Live Tracking tab: read-only view of whoever this viewer is authorized to see - a plain
    // JMDO sees only themselves (mine/active, falling back to mine/latest for an honest Stopped/
    // NotStarted row), Admin/MO/MDO see their own HQ team (GetTeamAsync, the exact same endpoint/
    // scope TeamTracking.razor already uses). No new permission logic anywhere, client or server -
    // this only ever calls read endpoints (GetMineActiveAsync/GetMineLatestAsync/GetTeamAsync/
    // GetSessionPointsAsync), never StartAsync/StopAsync, so opening/closing this tab can never
    // affect anyone's actual tracking session. Entirely separate state from Playback History above -
    // a different map element id ("ma-live-tracking-map" vs "ma-tracking-map"), a different timer,
    // and it never reads or mutates _historySessions/_trackSession/_mapInitializedForSessionId/
    // _mapPointsDirty/_trackRefreshCts.
    private const int LiveTrackingPollSeconds = 15; // same cadence as the native RefreshLoopAsync above

    private bool _liveTabActive;
    private bool _liveLoading;
    private List<LiveRosterRow> _liveRoster = new();
    private string? _liveSelectedUserId;
    private int? _liveSelectedSessionId;
    private int? _liveMapInitializedForSessionId;
    private CancellationTokenSource? _liveRefreshCts;

    private bool IsSupervisorRole => LoginState.UserRole is AppRole.Admin or AppRole.MO or AppRole.MDO;

    private LiveRosterRow? SelectedLiveRow => _liveRoster.FirstOrDefault(r => r.UserId == _liveSelectedUserId);

    private sealed class LiveRosterRow
    {
        public required string UserId { get; init; }
        public required string JmdoName { get; init; }
        public string? Designation { get; init; }
        public JmdoTrackingLiveStatus LiveStatus { get; init; }
        public DateTime? LastPointAt { get; init; }
        public double? LastLatitude { get; init; }
        public double? LastLongitude { get; init; }
        public double? LastAccuracy { get; init; }
        public DateTime? SessionStartTime { get; init; }
        public int? SessionId { get; init; }
    }

    // Never trust LiveStatus alone as proof of "live" - ResolveLiveStatus (server-side) computes
    // Live for a just-created session using its StartTime as a stand-in for "last point" when none
    // has arrived yet, which is honest for staleness math but not for a viewer asking "is GPS
    // actually coming in". LastPointAt == null is the one case that overrides it here.
    private static string StatusLabel(JmdoTrackingLiveStatus liveStatus, DateTime? lastPointAt) => liveStatus switch
    {
        JmdoTrackingLiveStatus.Stopped => "Stopped",
        JmdoTrackingLiveStatus.AutoEnded => "Stopped",
        JmdoTrackingLiveStatus.NotStarted => "Not Started",
        _ when lastPointAt is null => "Waiting for GPS",
        JmdoTrackingLiveStatus.Live => "Live",
        JmdoTrackingLiveStatus.Stale => "Stale",
        JmdoTrackingLiveStatus.Offline => "Offline",
        _ => "Not Started"
    };

    private static string StatusClass(JmdoTrackingLiveStatus liveStatus, DateTime? lastPointAt) => liveStatus switch
    {
        JmdoTrackingLiveStatus.Stopped => "tt-status-stopped",
        JmdoTrackingLiveStatus.AutoEnded => "tt-status-autoended",
        JmdoTrackingLiveStatus.NotStarted => "tt-status-notstarted",
        _ when lastPointAt is null => "tt-status-waiting",
        JmdoTrackingLiveStatus.Live => "tt-status-live",
        JmdoTrackingLiveStatus.Stale => "tt-status-stale",
        JmdoTrackingLiveStatus.Offline => "tt-status-offline",
        _ => "tt-status-notstarted"
    };

    private async Task SwitchTabAsync(bool live)
    {
        if (_liveTabActive == live) return;
        _liveTabActive = live;

        if (live)
        {
            await LoadLiveRosterAsync();
            StartLiveRefreshLoop();
        }
        else
        {
            await StopLiveRefreshAsync();
        }

        StateHasChanged();
    }

    private List<LiveRosterRow> BuildRosterFromTeam(IEnumerable<JMDOTrackingTeamRowDto> team) =>
        team.Select(t => new LiveRosterRow
        {
            UserId = t.UserId,
            JmdoName = t.JmdoName,
            Designation = t.Designation,
            LiveStatus = t.LiveStatus,
            LastPointAt = t.LastPointAt,
            LastLatitude = t.LastLatitude,
            LastLongitude = t.LastLongitude,
            LastAccuracy = t.LastAccuracy,
            SessionStartTime = t.SessionStartTime,
            SessionId = t.SessionId
        }).ToList();

    private List<LiveRosterRow> BuildSelfRoster(JMDOTrackingSessionDto? mine) => new()
    {
        new LiveRosterRow
        {
            UserId = "me",
            JmdoName = mine?.JmdoName ?? LoginState.UserName ?? "You",
            Designation = mine?.Designation ?? LoginState.DesignationName,
            LiveStatus = mine?.LiveStatus ?? JmdoTrackingLiveStatus.NotStarted,
            LastPointAt = mine?.LastPointAt,
            LastLatitude = mine?.LastLatitude,
            LastLongitude = mine?.LastLongitude,
            LastAccuracy = mine?.LastAccuracy,
            SessionStartTime = mine?.StartTime,
            SessionId = mine?.Id
        }
    };

    private async Task LoadLiveRosterAsync()
    {
        _liveLoading = true;
        StateHasChanged();

        _liveRoster = IsSupervisorRole
            ? BuildRosterFromTeam(await TrackingApi.GetTeamAsync())
            : BuildSelfRoster(await TrackingApi.GetMineActiveAsync() ?? await TrackingApi.GetMineLatestAsync());

        if (_liveSelectedUserId is null || _liveRoster.All(r => r.UserId != _liveSelectedUserId))
            _liveSelectedUserId = _liveRoster.FirstOrDefault()?.UserId;

        _liveLoading = false;
        StateHasChanged();

        var selected = _liveRoster.FirstOrDefault(r => r.UserId == _liveSelectedUserId);
        if (selected is not null)
            SelectLiveEmployee(selected);
    }

    // Rejects exact/near-(0,0) - the universal "no GPS fix yet" sentinel value several platforms
    // return - plus anything outside valid lat/lng range. Applied to the roster row's own
    // LastLatitude/LastLongitude, which is the ONLY coordinate source Live Tracking uses now (no
    // route/point fetch at all - see the Context note below).
    private static bool IsPlausibleCoordinate(double? lat, double? lng) =>
        lat is { } la && lng is { } lo
        && la is >= -90 and <= 90 && lo is >= -180 and <= 180
        && (Math.Abs(la) > 0.01 || Math.Abs(lo) > 0.01);

    // Live Tracking shows ONLY the current-location marker now - no route polyline, no start/end
    // markers, no GetSessionPointsAsync call at all. The roster row (Team()/MineActive(), already
    // being polled every tick for the status badges) already carries LastLatitude/LastLongitude/
    // LastPointAt/LastAccuracy - exactly "the latest location information needed to update the
    // marker" - so there is nothing left to fetch separately; this is the smallest possible read
    // surface for a live-location-only view. Playback History's own GetSessionPointsAsync calls
    // (LoadTrackingViewAsync/SelectSession/RefreshLoopAsync, all far below, untouched) are a
    // completely separate code path.
    private double? _liveAnchorLat;
    private double? _liveAnchorLng;

    private void SelectLiveEmployee(LiveRosterRow row)
    {
        var sessionChanged = _liveSelectedSessionId != row.SessionId;
        _liveSelectedUserId = row.UserId;
        _liveAnchorLat = IsPlausibleCoordinate(row.LastLatitude, row.LastLongitude) ? row.LastLatitude : null;
        _liveAnchorLng = IsPlausibleCoordinate(row.LastLatitude, row.LastLongitude) ? row.LastLongitude : null;

        if (sessionChanged)
        {
            _liveSelectedSessionId = row.SessionId;
            _liveMapInitializedForSessionId = null; // force re-init (new map, new employee) on next render
        }

        StateHasChanged();
    }

    private void StartLiveRefreshLoop()
    {
        _liveRefreshCts?.Cancel();
        var cts = new CancellationTokenSource();
        _liveRefreshCts = cts;
        _ = LiveRefreshLoopAsync(cts.Token);
    }

    private async Task LiveRefreshLoopAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(LiveTrackingPollSeconds));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                // Always re-fetch the roster (cheap - one row or one HQ team) so every visible
                // status badge stays honest, not just the selected employee's - and this one call
                // already carries the latest location too, so nothing else needs fetching.
                _liveRoster = IsSupervisorRole
                    ? BuildRosterFromTeam(await TrackingApi.GetTeamAsync())
                    : BuildSelfRoster(await TrackingApi.GetMineActiveAsync() ?? await TrackingApi.GetMineLatestAsync());
                if (ct.IsCancellationRequested) return;

                var selectedRow = _liveRoster.FirstOrDefault(r => r.UserId == _liveSelectedUserId);
                if (selectedRow is not null)
                    SelectLiveEmployee(selectedRow); // updates the anchor + flags a re-init if the session changed

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Expected when the tab is switched away from or the page is torn down.
        }
    }

    private async Task StopLiveRefreshAsync()
    {
        _liveRefreshCts?.Cancel();
        _liveRefreshCts = null;

        if (_liveMapInitializedForSessionId is not null)
        {
            _liveMapInitializedForSessionId = null;
            try { await JS.InvokeVoidAsync("destroyLiveLocationMap", "ma-live-tracking-map"); }
            catch (Exception) { /* page/circuit may already be gone */ }
        }
    }

    // Current-location-only rendering: initLiveLocationMap/updateLiveLocationMarker are a dedicated
    // pair distinct from initTrackingRouteMap/updateTrackingRouteMap (tracking-map.js) - no polyline,
    // no start/end markers, no fitBounds over historical points. updateLiveLocationMarker itself
    // only recenters the camera if the user hasn't manually panned/zoomed (see its own JS comment),
    // so exploring the map is preserved; RecenterLiveMapAsync below is the explicit opt back in.
    private async Task RenderLiveMapAsync()
    {
        if (_liveSelectedSessionId is null) return;
        if (!IsPlausibleCoordinate(_liveAnchorLat, _liveAnchorLng))
            return; // no real fix yet - "Waiting for GPS" already covers this in the UI; retried
                    // automatically next render once the roster/poll loop has a valid location

        if (_liveMapInitializedForSessionId != _liveSelectedSessionId)
        {
            try
            {
                await JS.InvokeVoidAsync("initLiveLocationMap", "ma-live-tracking-map", _liveAnchorLat!.Value, _liveAnchorLng!.Value);
                _liveMapInitializedForSessionId = _liveSelectedSessionId;
            }
            catch (Exception)
            {
                // map element not in the DOM yet - OnAfterRenderAsync retries next render
            }
        }
        else
        {
            try { await JS.InvokeVoidAsync("updateLiveLocationMarker", "ma-live-tracking-map", _liveAnchorLat!.Value, _liveAnchorLng!.Value); }
            catch (Exception) { /* page/circuit may already be gone */ }
        }
    }

    private async Task RecenterLiveMapAsync()
    {
        if (!IsPlausibleCoordinate(_liveAnchorLat, _liveAnchorLng)) return;
        try { await JS.InvokeVoidAsync("recenterLiveLocationMap", "ma-live-tracking-map", _liveAnchorLat!.Value, _liveAnchorLng!.Value); }
        catch (Exception) { /* map not ready */ }
    }

    public async ValueTask DisposeAsync()
    {
        await StopTrackingViewLiveUpdatesAsync();
        await StopLiveRefreshAsync();
    }

    private sealed class GeoResult
    {
        public double Latitude { get; set; }
        public double Longitude { get; set; }
        public string? Error { get; set; }
    }

    // No confirmation modal on this button (unlike FieldDashboard's own Stop Tracking, which asks
    // first) - stops immediately and lands on Mark Attendance's post-stop summary. Goes through the
    // real api/JMDOTracking/stop (same as FieldDashboard) so Off Duty is saved, not just set locally.
    private bool _stopping;

    private async Task StopTracking()
    {
        if (_stopping) return;
        _stopping = true;
        try
        {
            GeoResult? position;
            try
            {
                position = await JS.InvokeAsync<GeoResult?>("getCurrentPosition");
            }
            catch (Exception)
            {
                position = null;
            }

            if (position is null || !string.IsNullOrWhiteSpace(position.Error))
            {
                Toast.Error(string.IsNullOrWhiteSpace(position?.Error)
                    ? "Could not get your current location. Tracking is still active - please try again."
                    : position!.Error!);
                return;
            }

            var stopped = await TrackingApi.StopAsync(position.Latitude, position.Longitude);
            if (stopped is null) return; // TrackingApi already raised an error toast; session stays Active

            AttendanceState.IsOnDuty = false;
            TrackingLoop.Stop();
            try
            {
                await JS.InvokeAsync<bool>("stopBackgroundTracking");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Native background tracking could not be stopped: {ex.Message}");
            }

            Toast.Success("Location tracking stopped successfully.");
            await LoadTrackingViewAsync();
        }
        finally
        {
            _stopping = false;
        }
    }

    private void GoBack()
    {
        if (NavHistory.TryGoBack())
            return;
        Navigation.NavigateTo("/FieldDashboard");
    }
}
