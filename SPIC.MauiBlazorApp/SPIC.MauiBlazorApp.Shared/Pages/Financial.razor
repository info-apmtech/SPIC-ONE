@page "/Financial"
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@inject HttpClient Http
@inject IJSRuntime JS
@inject SPIC.MauiBlazorApp.Shared.Services.LoginState LoginState

<div class="container-fluid">

	<h2 class="page-title">Financial Master</h2>

	@if (!string.IsNullOrEmpty(_message))
	{
		<div class="alert @(_isError ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
			@_message
			<button type="button" class="btn-close" @onclick="() => _message = null"></button>
		</div>
	}

	<div class="tabs-wrapper">
		<div class="tabs-container">
			@foreach (var tab in TabOptions)
			{
				<div class="tab-item @(ActiveTab == tab ? "active" : "")" @onclick="() => SetActiveTab(tab)">
					@tab
				</div>
			}
		</div>
	</div>

	<div class="main-card">
		<div class="section-header">
			<h3 class="section-title">@(_isEditing ? $"Edit {ActiveTab}" : $"Add New {ActiveTab}")</h3>
			@if (LoginState.Can(SPIC.Core.Entities.PagePermission.Financial, "Entry"))
			{
				<button class="btn-outline-green" style="width: 12%;">
					<i class="bi bi-cloud-arrow-up"></i> Bulk Upload
				</button>
			}
		</div>

		<div class="row g-3 mb-4">
			@if (ActiveTab == "Bank")
			{
				<div class="col-md-4">
					<label class="form-label-custom">Bank Name</label>
					<input type="text" class="form-control-custom w-100" placeholder="Enter Bank Name"
						   @bind="_bankForm.Name" @ref="_firstInputRef" />
				</div>
				<div class="col-md-3">
					<label class="form-label-custom">IFSC Prefix</label>
				<input type="text" class="form-control-custom w-100" placeholder="e.g. HDFC, ICIC, SBIN"
					   @bind="_bankForm.IFSCPrefix" @bind:after="OnIFSCPrefixChanged" maxlength="4" />
					<small class="text-danger d-block mt-1">⚠️ Please enter only the first 4 alphabetic characters of the IFSC code.</small>
				</div>
				<div class="col-md-3">
					<label class="form-label-custom">Bank Logo</label>
					<div class="d-flex align-items-center gap-3">
						@if (!string.IsNullOrEmpty(_logoPreview))
						{
							<div class="logo-preview-box">
								<img src="@_logoPreview" alt="Logo preview" class="logo-preview-img" />
								<button type="button" class="logo-remove-btn" @onclick="RemoveLogo" title="Remove logo">
									<i class="bi bi-x"></i>
								</button>
							</div>
						}
						<label class="upload-dashed-box flex-grow-1 mb-0" style="position:relative;">
							@(_logoPreview != null ? "Change Logo" : "Upload Bank Logo") <i class="bi bi-upload"></i>
							<InputFile OnChange="OnLogoSelected" accept="image/*" style="position:absolute;inset:0;opacity:0;cursor:pointer;" />
						</label>
					</div>
				</div>
			}
			else if (ActiveTab == "Financial Year")
			{
				<div class="col-md-4">
					<label class="form-label-custom">Financial Year Name</label>
					<input type="text" class="form-control-custom w-100" placeholder="Enter Financial Year Name"
						   @bind="_fyForm.Name" @ref="_firstInputRef" />
				</div>
				<div class="col-md-3">
					<label class="form-label-custom">Start Date</label>
					<input type="date" class="form-control-custom w-100"
						   @bind="_fyForm.StartDate" />
				</div>
				<div class="col-md-3">
					<label class="form-label-custom">End Date</label>
					<input type="date" class="form-control-custom w-100"
						   @bind="_fyForm.EndDate" />
				</div>
			}

			<div class="col-md-2" style="margin-top: 28px;">
				<div class="status-toggle-box @(CurrentFormIsActive ? "" : "status-toggle-inactive")">
					<span>@(CurrentFormIsActive ? "Active" : "Inactive")</span>
					<label class="switch">
						@if (ActiveTab == "Bank")
						{
							<input type="checkbox" @bind="_bankForm.IsActive">
							}
						else
							{
								<input type="checkbox" @bind="_fyForm.IsActive">
								}
								<span class="slider"></span>
							</label>
						</div>
					</div>
				</div>

				<div class="d-flex justify-content-end pt-2 mt-4">
					<button class="btn-cancel mt-3" @onclick="ResetForm"><i class="bi bi-x"></i> Cancel</button>
					@if ((!_isEditing && LoginState.Can(SPIC.Core.Entities.PagePermission.Financial, "Entry")) || (_isEditing && LoginState.Can(SPIC.Core.Entities.PagePermission.Financial, "Update")))
					{
						<button class="btn-save mt-3" @onclick="HandleSave" disabled="@_isSaving">
							<i class="bi bi-save"></i> @(_isSaving ? "Saving..." : "Save")
						</button>
					}
				</div>
			</div>

			<div class="row g-3 mb-4">
				<div class="col-md-4">
					<div class="metric-card bg-blue-light">
						<div class="metric-header">
							<h4 class="metric-title">Total @(ActiveTab == "Bank" ? "Banks" : "Financial Years")</h4>
						</div>
						<div class="metric-val">@CurrentAllItems.Count</div>
					</div>
				</div>
				<div class="col-md-4">
					<div class="metric-card bg-mint-light">
						<div class="metric-header">
							<h4 class="metric-title">Active</h4>
						</div>
						<div class="metric-val">@CurrentAllItems.Count(x => x.IsActive)</div>
					</div>
				</div>
				<div class="col-md-4">
					<div class="metric-card bg-gray-light">
						<div class="metric-header">
							<h4 class="metric-title">Inactive</h4>
						</div>
						<div class="metric-val">@CurrentAllItems.Count(x => !x.IsActive)</div>
					</div>
				</div>
			</div>

			<div class="main-card">
				<div class="section-header">
					<h3 class="section-title">Existing @(ActiveTab == "Bank" ? "Banks" : "Financial Years")</h3>

					<div class="table-controls">
						<div class="search-box">
							<i class="bi bi-search"></i>
							<input type="text" placeholder="Search @ActiveTab.ToLower()..." @bind="_searchText" @bind:event="oninput" @bind:after="ApplyFilter">
							</div>
							<select class="filter-select" @bind="_statusFilter" @bind:after="ApplyFilter">
								<option value="All">All Status</option>
								<option value="Active">Active</option>
								<option value="Inactive">Inactive</option>
							</select>
						</div>
					</div>

					@if (ActiveTab == "Bank")
					{
						@if (_isLoading)
						{
							<p class="text-center text-muted">Loading...</p>
						}
						else if (!_filteredItems.Any())
						{
							<p class="text-center text-muted">No banks found.</p>
						}
						else
						{
							<div class="bank-card-grid">
								@foreach (var item in _filteredItems)
								{
									<div class="bank-card total-value-card-bgimg">
										@if (!string.IsNullOrEmpty(item.Icon))
										{
											<img src="@item.Icon" class="total-card-financial-bg" alt="@item.Name logo" />
										}
										<div class="bank-card-content">
											<div class="d-flex justify-content-between align-items-start">
												<div class="bank-logo-placeholder">
													@if (!string.IsNullOrEmpty(item.Icon))
													{
														<img src="@item.Icon" class="bankLogo" alt="@item.Name" />
													}
													else
													{
														<i class="bi bi-bank2" style="font-size: 2rem;"></i>
													}
												</div>
												<span class="status-pill @(item.IsActive ? "status-active" : "status-inactive")"
													  style="cursor:pointer"
													  @onclick="() => ToggleStatus(item)">
													@(item.IsActive ? "Active" : "Inactive")
												</span>
											</div>
											<h4 class="bank-card-title">@item.Name</h4>
											@if (!string.IsNullOrEmpty(item.IFSCPrefix))
											{
												<div class="text-muted" style="font-size:0.85rem;">IFSC: @item.IFSCPrefix</div>
											}
										</div>
										<div class="bank-card-footer-strip mt-4">
											<div class="added-on-text">
												Added ON <strong>@item.CreatedAt.ToString("dd/MM/yyyy")</strong>
											</div>
											<div class="action-icons">
												@if (LoginState.Can(SPIC.Core.Entities.PagePermission.Financial, "Delete"))
												{
													<i class="bi bi-trash icon-del" @onclick="() => DeleteItem(item)"></i>
												}
												@if (LoginState.Can(SPIC.Core.Entities.PagePermission.Financial, "Update"))
												{
													<i class="bi bi-pencil-square icon-edit" @onclick="() => EditItem(item)"></i>
												}
											</div>
										</div>
									</div>
								}
							</div>
						}
					}
					else if (ActiveTab == "Financial Year")
					{
						<div class="table-wrapper">
							<div class="table-responsive">
								<table class="spic-table">
									<thead>
										<tr>
											<th style="width: 80px;">S:No</th>
											<th>Financial Year Name</th>
											<th>Start Date</th>
											<th>End Date</th>
											<th>Status</th>
											<th>Created At</th>
											@if (LoginState.Can(SPIC.Core.Entities.PagePermission.Financial, "Update") || LoginState.Can(SPIC.Core.Entities.PagePermission.Financial, "Delete"))
											{
												<th>Action</th>
											}
										</tr>
									</thead>
									<tbody>
										@if (_isLoading)
										{
											<tr>
												<td colspan="7" class="text-center text-muted">Loading...</td>
											</tr>
										}
										else if (!PagedItems.Any())
										{
											<tr>
												<td colspan="7" class="text-center text-muted">No financial years found.</td>
											</tr>
										}
										else
										{
											@foreach (var (item, index) in PagedItems.Select((v, i) => (v, i)))
											{
												<tr>
													<td class="text-muted">@((_currentPage - 1) * _pageSize + index + 1)</td>
													<td>@item.Name</td>
													<td>@item.StartDate.ToString("dd-MMM-yyyy")</td>
													<td>@item.EndDate.ToString("dd-MMM-yyyy")</td>
													<td>
														<span class="status-pill @(item.IsActive ? "status-active" : "status-inactive")"
															  style="cursor:pointer"
															  @onclick="() => ToggleStatus(item)">
															@(item.IsActive ? "Active" : "Inactive")
														</span>
													</td>
													<td>@item.CreatedAt.ToString("yyyy-MM-dd")</td>
													@if (LoginState.Can(SPIC.Core.Entities.PagePermission.Financial, "Update") || LoginState.Can(SPIC.Core.Entities.PagePermission.Financial, "Delete"))
													{
														<td>
															<div class="action-icons">
																@if (LoginState.Can(SPIC.Core.Entities.PagePermission.Financial, "Delete"))
																{
																	<i class="bi bi-trash icon-del" @onclick="() => DeleteItem(item)"></i>
																}
																@if (LoginState.Can(SPIC.Core.Entities.PagePermission.Financial, "Update"))
																{
																	<i class="bi bi-pencil-square icon-edit" @onclick="() => EditItem(item)"></i>
																}
															</div>
														</td>
													}
												</tr>
											}
										}
									</tbody>
								</table>
							</div>
						</div>

						<div class="pagination-container">
							<div class="items-per-page">
								Items Per Page
								<select @bind="_pageSize" @bind:after="ApplyFilter">
									<option value="16">16</option>
									<option value="32">32</option>
									<option value="50">50</option>
								</select>
							</div>

							<div class="pagination-controls">
								<div class="page-btn @(_currentPage <= 1 ? "disabled" : "")" @onclick="PreviousPage">
									<i class="bi bi-chevron-left"></i>
								</div>
								@foreach (var thispage in PageNumbers)
								{
									@if (thispage == -1)
									{
										<div class="page-btn ellipsis">...</div>
									}
									else
									{
										<div class="page-btn @(thispage == _currentPage ? "active" : "")" @onclick="() => GoToPage(thispage)">@(thispage)</div>
									}
								}
								<div class="page-btn @(_currentPage >= TotalPages ? "disabled" : "")" @onclick="NextPage">
									<i class="bi bi-chevron-right"></i>
								</div>
							</div>
						</div>
					}

				</div>

			</div>

			@if (_showDeleteConfirm)
			{
				<div class="modal-backdrop fade show"></div>
				<div class="modal fade show d-block" tabindex="-1" role="dialog">
					<div class="modal-dialog modal-dialog-centered" role="document">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title">Confirm Delete</h5>
								<button type="button" class="btn-close" @onclick="CancelDelete"></button>
							</div>
							<div class="modal-body">
								<p>Are you sure you want to delete <strong>@_deleteTarget?.Name</strong>?</p>
								<p class="text-muted mb-0">This action cannot be undone.</p>
							</div>
							<div class="modal-footer">
								<button class="btn btn-secondary" @onclick="CancelDelete">Cancel</button>
								<button class="btn btn-danger" @onclick="ConfirmDelete" disabled="@_isDeleting">
									@(_isDeleting ? "Deleting..." : "Delete")
								</button>
							</div>
						</div>
					</div>
				</div>
			}

@code {
	private readonly List<string> TabOptions = ["Bank", "Financial Year"];

	// ADDED: Element reference for focusing
	private ElementReference _firstInputRef;

	private string ActiveTab { get; set; } = "Bank";
	private string CurrentApiBase => ActiveTab switch
	{
		"Bank" => "api/Bank",
		"Financial Year" => "api/FinancialYear",
		_ => ""
	};

	// Data
	private List<FinancialItemDto> _banksAll = new();
	private List<FinancialItemDto> _fyAll = new();
	private List<FinancialItemDto> _filteredItems = new();

	private List<FinancialItemDto> CurrentAllItems => ActiveTab switch
	{
		"Bank" => _banksAll,
		"Financial Year" => _fyAll,
		_ => new()
	};

	// Forms
	private BankFormModel _bankForm = new();
	private FYFormModel _fyForm = new();
	private bool _isEditing;
	private int? _editingId;
	private string? _logoPreview;
	private long _maxLogoSize = 512 * 1024; // 512 KB

	private bool CurrentFormIsActive => ActiveTab switch
	{
		"Bank" => _bankForm.IsActive,
		"Financial Year" => _fyForm.IsActive,
		_ => true
	};

	// UI state
	private bool _isLoading = true;
	private bool _isSaving;
	private string? _message;
	private bool _isError;

	// Delete confirmation
	private bool _showDeleteConfirm;
	private bool _isDeleting;
	private FinancialItemDto? _deleteTarget;

	// Search & filter
	private string _searchText = "";
	private string _statusFilter = "All";

	// Pagination (Financial Year tab only)
	private int _currentPage = 1;
	private int _pageSize = 16;

	private int TotalPages => Math.Max(1, (int)Math.Ceiling(_filteredItems.Count / (double)_pageSize));
	private IEnumerable<FinancialItemDto> PagedItems => _filteredItems
		.Skip((_currentPage - 1) * _pageSize)
		.Take(_pageSize);

    protected override async Task OnInitializedAsync()
	{
		try
		{
			var token = await JS.InvokeAsync<string>("sessionStorage.getItem", "jwt_token");
			if (!string.IsNullOrEmpty(token))
			{
				_currentUserId = GetUserIdFromToken(token);
			}
		}
		catch { }

		await LoadAllData();
		ApplyFilter();
		_isLoading = false;
	}

	private async Task LoadAllData()
	{
		try
		{
			_isLoading = true;
			_banksAll = await Http.GetFromJsonAsync<List<FinancialItemDto>>("api/Bank/all") ?? new();
			_fyAll = await Http.GetFromJsonAsync<List<FinancialItemDto>>("api/FinancialYear/all") ?? new();
		}
		catch (Exception ex)
		{
			ShowMessage($"Failed to load: {ex.Message}", true);
		}
	}

	private async Task LoadTabData()
	{
		try
		{
			_isLoading = true;
			var items = await Http.GetFromJsonAsync<List<FinancialItemDto>>($"{CurrentApiBase}/all") ?? new();

			switch (ActiveTab)
			{
				case "Bank": _banksAll = items; break;
				case "Financial Year": _fyAll = items; break;
			}

			ApplyFilter();
		}
		catch (Exception ex)
		{
			ShowMessage($"Failed to load: {ex.Message}", true);
		}
		finally
		{
			_isLoading = false;
		}
	}

	private void SetActiveTab(string tabName)
	{
		if (ActiveTab == tabName) return;
		ActiveTab = tabName;
		_searchText = "";
		_statusFilter = "All";
		_currentPage = 1;
		ResetForm();
		ApplyFilter();
	}

	private void ApplyFilter()
	{
		_filteredItems = CurrentAllItems
			.Where(x => string.IsNullOrEmpty(_searchText)
				|| x.Name.Contains(_searchText, StringComparison.OrdinalIgnoreCase))
			.Where(x => _statusFilter switch
			{
				"Active" => x.IsActive,
				"Inactive" => !x.IsActive,
				_ => true
			})
			.OrderByDescending(x => x.CreatedAt)
			.ToList();

		if (_currentPage > TotalPages) _currentPage = 1;
	}

	private async Task HandleSave()
	{
		var name = ActiveTab switch
		{
			"Bank" => _bankForm.Name,
			"Financial Year" => _fyForm.Name,
			_ => ""
		};

		if (string.IsNullOrWhiteSpace(name))
		{
			ShowMessage($"{ActiveTab} name is required.", true);
			return;
		}

		try
		{
			_isSaving = true;

			object payload = ActiveTab switch
			{
                "Bank" => _isEditing
					? new { Id = _editingId!.Value, _bankForm.Name, _bankForm.Icon, _bankForm.IFSCPrefix, _bankForm.IsActive, UpdatedBy = (_currentUserId ?? "current-user") }
					: new { _bankForm.Name, _bankForm.Icon, _bankForm.IFSCPrefix, _bankForm.IsActive, CreatedAt = DateTime.Now, UpdatedAt = DateTime.Now, CreatedBy = (_currentUserId ?? "current-user"), UpdatedBy = (_currentUserId ?? "current-user") },
				"Financial Year" => _isEditing
					? (object)new { Id = _editingId!.Value, _fyForm.Name, _fyForm.StartDate, _fyForm.EndDate, _fyForm.IsActive, UpdatedBy = (_currentUserId ?? "current-user") }
					: new { _fyForm.Name, _fyForm.StartDate, _fyForm.EndDate, _fyForm.IsActive, CreatedAt = DateTime.Now, UpdatedAt = DateTime.Now, CreatedBy = (_currentUserId ?? "current-user"), UpdatedBy = (_currentUserId ?? "current-user") },
				_ => new { }
			};

			HttpResponseMessage response;
			if (_isEditing && _editingId.HasValue)
			{
				response = await Http.PutAsJsonAsync($"{CurrentApiBase}/{_editingId.Value}", payload);
				if (!response.IsSuccessStatusCode)
				{
					var error = await response.Content.ReadAsStringAsync();
					ShowMessage($"Update failed: {error}", true);
					return;
				}
				ShowMessage($"{ActiveTab} updated successfully.", false);
			}
			else
			{
				response = await Http.PostAsJsonAsync(CurrentApiBase, payload);
				if (!response.IsSuccessStatusCode)
				{
					var error = await response.Content.ReadAsStringAsync();
					ShowMessage($"Create failed: {error}", true);
					return;
				}
				ShowMessage($"{ActiveTab} created successfully.", false);
			}

			ResetForm();
			await LoadTabData();
		}
		catch (Exception ex)
		{
			ShowMessage($"Error: {ex.Message}", true);
		}
		finally
		{
			_isSaving = false;
		}
	}

	// CHANGED: Made this an async Task to support FocusAsync
	private async Task EditItem(FinancialItemDto item)
	{
		_isEditing = true;
		_editingId = item.Id;

		switch (ActiveTab)
		{
			case "Bank":
				_bankForm = new BankFormModel
				{
					Name = item.Name,
					Icon = item.Icon,
					IFSCPrefix = item.IFSCPrefix ?? "",
					IsActive = item.IsActive
				};
				_logoPreview = item.Icon;
				break;
			case "Financial Year":
				_fyForm = new FYFormModel
				{
					Name = item.Name,
					StartDate = item.StartDate,
					EndDate = item.EndDate,
					IsActive = item.IsActive
				};
				break;
		}

		// ADDED: Focus the input automatically
		try
		{
			await _firstInputRef.FocusAsync();
		}
		catch { }
	}

	private void DeleteItem(FinancialItemDto item)
	{
		_deleteTarget = item;
		_showDeleteConfirm = true;
	}

	private async Task ConfirmDelete()
	{
		if (_deleteTarget is null) return;

		try
		{
			_isDeleting = true;
			var response = await Http.DeleteAsync($"{CurrentApiBase}/{_deleteTarget.Id}");
			if (response.IsSuccessStatusCode)
			{
				ShowMessage($"'{_deleteTarget.Name}' deleted successfully.", false);
				await LoadTabData();
			}
			else
			{
				var error = await response.Content.ReadAsStringAsync();
				ShowMessage($"Delete failed: {error}", true);
			}
		}
		catch (Exception ex)
		{
			ShowMessage($"Error: {ex.Message}", true);
		}
		finally
		{
			_isDeleting = false;
			CancelDelete();
		}
	}

	private void CancelDelete()
	{
		_showDeleteConfirm = false;
		_deleteTarget = null;
	}

	private async Task ToggleStatus(FinancialItemDto item)
	{
		try
		{
			var newStatus = !item.IsActive;
			var response = await Http.PatchAsync($"{CurrentApiBase}/{item.Id}/status?isActive={newStatus}", null);

			if (response.IsSuccessStatusCode)
			{
				item.IsActive = newStatus;
				ApplyFilter();
			}
			else
			{
				var error = await response.Content.ReadAsStringAsync();
				ShowMessage($"Status change failed: {error}", true);
			}
		}
		catch (Exception ex)
		{
			ShowMessage($"Error: {ex.Message}", true);
		}
	}

	private void ResetForm()
	{
		_bankForm = new BankFormModel();
		_fyForm = new FYFormModel();
		_isEditing = false;
		_editingId = null;
		_logoPreview = null;
	}

	private async Task OnLogoSelected(InputFileChangeEventArgs e)
	{
		var file = e.File;
		if (file is null) return;

		if (file.Size > _maxLogoSize)
		{
			ShowMessage("Logo file must be under 512 KB.", true);
			return;
		}

		try
		{
			var buffer = new byte[file.Size];
			await using var stream = file.OpenReadStream(_maxLogoSize);
			await stream.ReadExactlyAsync(buffer);
			var base64 = Convert.ToBase64String(buffer);
			var dataUri = $"data:{file.ContentType};base64,{base64}";
			_bankForm.Icon = dataUri;
			_logoPreview = dataUri;
		}
		catch (Exception ex)
		{
			ShowMessage($"Failed to read logo: {ex.Message}", true);
		}
	}

	private void RemoveLogo()
	{
		_bankForm.Icon = null;
		_logoPreview = null;
	}

	private void OnIFSCPrefixChanged()
	{
		if (!string.IsNullOrEmpty(_bankForm.IFSCPrefix))
			_bankForm.IFSCPrefix = _bankForm.IFSCPrefix.ToUpperInvariant();
	}

	private void ShowMessage(string message, bool isError)
	{
		_message = message;
		_isError = isError;
	}

	// current user id parsed from JWT token (string because Identity user id may be non-int)
	private string? _currentUserId;

	private string? GetUserIdFromToken(string token)
	{
		try
		{
			if (string.IsNullOrWhiteSpace(token)) return null;
			var raw = token.StartsWith("Bearer ") ? token.Substring("Bearer ".Length) : token;
			var parts = raw.Split('.');
			if (parts.Length < 2) return null;
			var payload = parts[1];
			switch (payload.Length % 4)
			{
				case 2: payload += "=="; break;
				case 3: payload += "="; break;
			}
			payload = payload.Replace('-', '+').Replace('_', '/');
			var json = System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(payload));
			using var doc = System.Text.Json.JsonDocument.Parse(json);
			var root = doc.RootElement;
			if (root.TryGetProperty("sub", out var sub)) return sub.GetString();
			if (root.TryGetProperty("nameid", out var nid)) return nid.GetString();
			if (root.TryGetProperty("http://schemas.xmlsoap.org/ws/2005/05/identity/claims/nameidentifier", out var id2)) return id2.GetString();
			if (root.TryGetProperty("spic:user_id", out var sup)) return sup.GetString();
		}
		catch { }
		return null;
	}

	// Pagination helpers
	private void GoToPage(int page) { _currentPage = page; }
	private void PreviousPage() { if (_currentPage > 1) _currentPage--; }
	private void NextPage() { if (_currentPage < TotalPages) _currentPage++; }

	private IEnumerable<int> PageNumbers
	{
		get
		{
			var total = TotalPages;
			if (total <= 7)
				return Enumerable.Range(1, total);

			var pages = new List<int> { 1 };
			var start = Math.Max(2, _currentPage - 1);
			var end = Math.Min(total - 1, _currentPage + 1);

			if (start > 2) pages.Add(-1);
			for (var i = start; i <= end; i++) pages.Add(i);
			if (end < total - 1) pages.Add(-1);
			pages.Add(total);

			return pages;
		}
	}

