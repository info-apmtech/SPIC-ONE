@page "/Financial"

<div class="container-fluid">

    <h2 class="page-title">Financial Master</h2>

    <div class="tabs-wrapper">
        <div class="tabs-container">
            @foreach (var tab in TabOptions)
            {
                <div class="tab-item @(ActiveTab == tab ? "active" : "")" @onclick='() => SetActiveTab(tab)'>
                    @tab
                </div>
            }
        </div>
    </div>

    <div class="main-card">
        <div class="section-header">
            <h3 class="section-title">Add New @ActiveTab</h3>
            <button class="btn-outline-green"style="
				width: 12%;"><i class="bi bi-cloud-arrow-up"></i> Bulk Upload</button>
        </div>

        <div class="row g-3 mb-4">
            
            @if (ActiveTab == "Bank")
            {
                <div class="col-md-5">
                    <label class="form-label-custom">Bank Name</label>
                    <input type="text" class="form-control-custom w-100" placeholder="Enter Bank Name">
                </div>
                <div class="col-md-5">
                    <label class="form-label-custom" style="visibility:hidden;">Upload Bank Logo</label>
                    <div class="upload-dashed-box">
                        Upload Bank Logo <i class="bi bi-upload"></i>
                    </div>
                </div>
            }
            else if (ActiveTab == "Financial Year")
            {
                <div class="col-md-4">
                    <label class="form-label-custom">Financial Year Name</label>
                    <input type="text" class="form-control-custom w-100" placeholder="Enter Financial Year Name">
                </div>
                <div class="col-md-3">
                    <label class="form-label-custom">Start Date</label>
                    <input type="text" class="form-control-custom w-100" placeholder="Enter Start Date">
                </div>
                <div class="col-md-3">
                    <label class="form-label-custom">End Date</label>
                    <input type="text" class="form-control-custom w-100" placeholder="Enter End Date">
                </div>
            }

            <div class="col-md-2">
                <div class="status-toggle-box w-100">
                    <span>Active</span>
                    <label class="switch">
                        <input type="checkbox" checked>
                        <span class="slider"></span>
                    </label>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end pt-2">
            <button class="btn-cancel"><i class="bi bi-x"></i> Cancel</button>
            <button class="btn-save"><i class="bi bi-save"></i> Save</button>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="metric-card bg-blue-light">
                <div class="metric-header">
                    <h4 class="metric-title">Total @(ActiveTab == "Bank" ? "Banks" : ActiveTab)</h4>
                    <div class="metric-trend"><i class="bi bi-arrow-up-right"></i> 12% from last quarter</div>
                </div>
                <div class="metric-val">24</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="metric-card bg-mint-light">
                <div class="metric-header">
                    <h4 class="metric-title">Active</h4>
                    <div class="metric-info"><i class="bi bi-exclamation-circle"></i> 6 zones pending review</div>
                </div>
                <div class="metric-val">18</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="metric-card bg-gray-light">
                <div class="metric-header">
                    <h4 class="metric-title">Inactive</h4>
                    <div class="metric-info"><i class="bi bi-info-circle"></i> 6 zones pending review</div>
                </div>
                <div class="metric-val">18</div>
            </div>
        </div>
    </div>

    <div class="main-card">
        <div class="section-header">
            <h3 class="section-title">Existing @(ActiveTab == "Bank" ? "Products" : ActiveTab)</h3>
            
            <div class="table-controls">
                <div class="search-box">
                    <i class="bi bi-search"></i>
                    <input type="text" placeholder="Search zones...">
                </div>
                <select class="filter-select">
                    <option>All Status</option>
                    @* <option>Active</option>
                    <option>Inactive</option> *@
                </select>
              @*   <div class="view-toggle">
                    <button class="view-btn @(ActiveTab == "Bank" ? "active" : "")"><i class="bi bi-grid"></i> Card View</button>
                    <button class="view-btn @(ActiveTab == "Financial Year" ? "active" : "")"><i class="bi bi-list-ul"></i> List View</button>
                </div> *@
            </div>
        </div>

        @if (ActiveTab == "Bank")
        {
            <div class="bank-card-grid">
                
              <div class="bank-card total-value-card-bgimg">
    
    <!-- Background watermark -->
    <img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/SBILogo.svg"
         class="total-card-financial-bg" />

    <div class="bank-card-content">

        <div class="d-flex justify-content-between align-items-start">
            <div class="bank-logo-placeholder sbi">
                <img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/SBI.svg"
                     class="bankLogo" />
            </div>

            <span class="status-pill status-active">Active</span>
        </div>

        <h4 class="bank-card-title">State Bank</h4>

    </div>

    <!-- 🔥 NEW FOOTER -->
    <div class="bank-card-footer-strip mt-4">
        <div class="added-on-text">
            Added ON <strong>12/03/2026</strong>
        </div>

        <div class="action-icons">
            <i class="bi bi-trash icon-del"></i>
            <i class="bi bi-pencil-square icon-edit"></i>
        </div>
    </div>

</div>
                <div class="bank-card total-value-card-bgimg">
                     <img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/IndianBanklogo.svg" class="total-card-financial-bg" alt="IndianLogo">
                    <div class="bank-card-content">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="bank-logo-placeholder indian">
                               <img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/IndianBank.svg"
				 class="bankLogo"
				 alt="icon" />
                            </div>
                            <span class="status-pill status-active">Active</span>
                        </div>
                        <h4 class="bank-card-title">Indian Bank</h4>
                    </div>
                     <!-- 🔥 NEW FOOTER -->
    <div class="bank-card-footer-strip mt-4">
        <div class="added-on-text">
            Added ON <strong>12/03/2026</strong>
        </div>

        <div class="action-icons">
            <i class="bi bi-trash icon-del"></i>
            <i class="bi bi-pencil-square icon-edit"></i>
        </div>
    </div>
                </div>

                <div class="bank-card total-value-card-bgimg">
                    <img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/HDFCLogo.svg" class="total-card-financial-bg" alt="HDFCLogo">
                    <div class="bank-card-content">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="bank-logo-placeholder hdfc">
                                <img src="_content/SPIC.MauiBlazorApp.Shared/images/FormIcons/HDFC.svg"
				 class="bankLogo"
				 alt="icon" /> 
                            </div>
                            <span class="status-pill status-active">Active</span>
                        </div>
                        <h4 class="bank-card-title">HDFC Bank</h4>
                        
                         <!-- 🔥 NEW FOOTER -->
   
                    </div>
                     <div class="bank-card-footer-strip mt-4">
        <div class="added-on-text">
            Added ON <strong>12/03/2026</strong>
        </div>

        <div class="action-icons">
            <i class="bi bi-trash icon-del"></i>
            <i class="bi bi-pencil-square icon-edit"></i>
        </div>
    </div>
                </div>

            </div>
        }
        else if (ActiveTab == "Financial Year")
        {
           	<div class="table-wrapper">
			<div class="table-responsive">
				<table class="spic-table">
                    <thead>
                        <tr>
                            <th style="width: 80px;">S:No</th>
                            <th>Financial Year Name</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Status</th>
                            <th>Created At</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="text-muted">1</td>
                            <td>2024-2025</td>
                            <td>01-Apr-2024</td>
                            <td>31-Mar-2025</td>
                            <td><span class="status-pill status-active">Active</span></td>
                            <td>2026-03-15</td>
                            <td>
                                <div class="action-icons">
                                    <i class="bi bi-trash icon-del"></i>
                                    <i class="bi bi-pencil-square icon-edit"></i>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td class="text-muted">2</td>
                            <td>2024-2025</td>
                            <td>01-Apr-2024</td>
                            <td>31-Mar-2025</td>
                            <td><span class="status-pill status-active">Active</span></td>
                            <td>2026-03-15</td>
                            <td>
                                <div class="action-icons">
                                    <i class="bi bi-trash icon-del"></i>
                                    <i class="bi bi-pencil-square icon-edit"></i>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td class="text-muted">3</td>
                            <td>2024-2025</td>
                            <td>01-Apr-2024</td>
                            <td>31-Mar-2025</td>
                            <td><span class="status-pill status-inactive">Inactive</span></td>
                            <td>2024-03-15</td>
                            <td>
                                <div class="action-icons">
                                    <i class="bi bi-trash icon-del"></i>
                                    <i class="bi bi-pencil-square icon-edit"></i>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td class="text-muted">4</td>
                            <td>2024-2025</td>
                            <td>01-Apr-2024</td>
                            <td>31-Mar-2025</td>
                            <td><span class="status-pill status-active">Active</span></td>
                            <td>2026-03-15</td>
                            <td>
                                <div class="action-icons">
                                    <i class="bi bi-trash icon-del"></i>
                                    <i class="bi bi-pencil-square icon-edit"></i>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            </div>

            <div class="pagination-container">
                <div class="items-per-page">
                    Items Per Page
                    <select>
                        <option>16</option>
                        <option>32</option>
                        <option>50</option>
                    </select>
                </div>
                
                <div class="pagination-controls">
                    <div class="page-btn"><i class="bi bi-chevron-left"></i></div>
                    <div class="page-btn active">1</div>
                    <div class="page-btn">2</div>
                    <div class="page-btn">3</div>
                    <div class="page-btn ellipsis">...</div>
                    <div class="page-btn">8</div>
                    <div class="page-btn">9</div>
                    <div class="page-btn">10</div>
                    <div class="page-btn"><i class="bi bi-chevron-right"></i></div>
                </div>
            </div>
        }

    </div>

</div>

@code {
    // Define the available tabs
    private List<string> TabOptions = new List<string> { "Bank", "Financial Year" };
    
    // State to keep track of the selected tab (Defaulting to "Bank" to match first image)
    private string ActiveTab { get; set; } = "Bank";

    // Method to switch tabs
    private void SetActiveTab(string tabName)
    {
        ActiveTab = tabName;
    }
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
