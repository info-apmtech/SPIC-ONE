@page "/Rooms"
@using System.Globalization
@inject HttpClient Http
@inject NavigationManager Navigation

<div class="container-fluid py-4 px-0">
    <div class="rm-wrapper">
        
        <div class="rm-header-text">
            <PageHeader Title="Available Rooms" Subtitle="Step 2 of 5 · Select your preferred accommodation" />
        </div>

        <div class="rm-controls-row">
            
            <div class="rm-tabs">
                @foreach (var tab in _tabOptions)
                {
                    <button class="rm-tab @(tab == _activeTab ? "active" : "")" @onclick="() => SetTab(tab)">@tab</button>
                }
            </div>

            <div class="rm-search-box">
                <svg class="rm-search-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input type="text" class="rm-search-input" placeholder="Search" @bind="_searchText" @bind:event="oninput" />
            </div>

        </div>

        @if (_isLoading)
        {
            <Skeleton Variant="card" Rows="2" LoadingText="Loading available rooms" />
        }

        <div class="rm-grid">
            
            @foreach (var room in FilteredRooms)
            {
                <div class="rm-card">
                    <div class="rm-card-img-wrap">
                        <img src="@room.ImageUrl" alt="@room.RoomType" loading="lazy" onerror="this.style.backgroundColor='#cbd5e1';" />
                        
                        <div class="rm-media-badges">
                            <div class="rm-badge-dark">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                                @room.PhotoCount
                            </div>
                            <div class="rm-badge-dark">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect></svg>
                                @room.VideoCount
                            </div>
                        </div>
                        
                        <div class="rm-price-badge">₹@room.PriceDisplay<span>/night</span></div>
                    </div>

                    <div class="rm-card-body">
                        <div class="rm-card-header">
                            <h2 class="rm-room-title">@room.RoomType</h2>
                            <span class="rm-room-availability">@room.AvailableQuantity Rooms Available</span>
                        </div>

                        <div class="rm-guests">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                            @room.GuestLabel
                        </div>

                        <div class="rm-amenities">
                            @foreach (var amenity in room.Amenities)
                            {
                                <div class="rm-amenity-pill">@((MarkupString)amenity)</div>
                            }
                        </div>

                        <div class="rm-selection-section">
                            <div class="rm-selection-row">
                                <label class="rm-selection-label">Number of Rooms</label>
                                <select class="rm-select" value="@room.SelectedQuantity" @onchange="e => OnQuantityChanged(room, e)" disabled="@(room.MaxSelectableQuantity <= 0)">
                                    @if (room.MaxSelectableQuantity > 0)
                                    {
                                        @for (int i = 1; i <= room.MaxSelectableQuantity; i++)
                                        {
                                            <option value="@i">@i</option>
                                        }
                                    }
                                    else
                                    {
                                        <option value="0">0</option>
                                    }
                                </select>
                            </div>

                            @* A booking reserves ONE inventory row (POST api/GuestHouseBooking/book takes a single
                               room id and checks that row's availability), so the dropdown stops at the largest
                               single row while the badge above shows the group total. Say so instead of offering
                               a quantity the booking would reject. *@
                            @if (room.MaxSelectableQuantity > 0 && room.MaxSelectableQuantity < room.AvailableQuantity)
                            {
                                <div class="rm-selection-hint">Up to @room.MaxSelectableQuantity @(room.MaxSelectableQuantity == 1 ? "room" : "rooms") can be booked at a time for this room type.</div>
                            }

                            @if (room.ExtraCotPrice.HasValue && room.ExtraCotPrice.Value > 0)
                            {
                                <div class="rm-selection-row">
                                    <label class="rm-selection-label">
                                        <input type="checkbox" checked="@room.ExtraBedSelected" @onchange="e => OnExtraBedToggle(room, e)" class="rm-checkbox" />
                                        Additional Bed (₹@room.ExtraCotPrice.Value.ToString("N0")/night)
                                    </label>
                                </div>

                                @if (room.ExtraBedSelected)
                                {
                                    <div class="rm-selection-row">
                                        <label class="rm-selection-label">No. of Additional Beds</label>
                                        <select class="rm-select" value="@room.SelectedExtraBeds" @onchange="e => OnExtraBedsChanged(room, e)">
                                            @for (int i = 1; i <= Math.Min(room.SelectedQuantity, 5); i++)
                                            {
                                                <option value="@i">@i</option>
                                            }
                                        </select>
                                    </div>
                                }
                            }
                        </div>

                        <div class="rm-card-actions">
                            <button class="rm-btn rm-btn-outline" disabled>View Details</button>
                            <button class="rm-btn rm-btn-solid" disabled="@(room.MaxSelectableQuantity <= 0 || room.SelectedQuantity <= 0)" @onclick="() => GoToGuestDetails(room)">Book Now</button>
                        </div>
                    </div>
                </div>
            }

        </div>

        @if (!_isLoading && _rooms.Count == 0)
        {
            <EmptyState Icon="bi-door-closed" Title="@(_loadError is null ? "No rooms available" : "Could not load rooms")"
                        Message="@(_loadError ?? "No rooms are available for the selected dates. Please try different dates.")">
                <button class="rm-btn rm-btn-solid rm-btn-inline" @onclick="GoBackToDates">Change dates</button>
            </EmptyState>
        }
        else if (!_isLoading && FilteredRooms.Count == 0)
        {
            <EmptyState Icon="bi-search" Title="No matching rooms" Message="Try another room type or clear the search." Compact="true">
                <button class="rm-btn rm-btn-outline rm-btn-inline" @onclick="ClearFilters">Clear filters</button>
            </EmptyState>
        }

    </div>
</div>

@code {
    [SupplyParameterFromQuery] public int? guestHouseId { get; set; }
    [SupplyParameterFromQuery] public string? checkIn { get; set; }
    [SupplyParameterFromQuery] public string? checkOut { get; set; }

    private static readonly string[] RoomImages =
    [
        "_content/SPIC.MauiBlazorApp.Shared/Images/Gallery/image12.jpg",
        "_content/SPIC.MauiBlazorApp.Shared/Images/Gallery/image13.jpg",
        "_content/SPIC.MauiBlazorApp.Shared/Images/Gallery/image14.jpg",
        "_content/SPIC.MauiBlazorApp.Shared/Images/Gallery/image15.jpg"
    ];

    private List<RoomCardModel> _rooms = new();
    private List<string> _tabOptions = new() { "All" };
    private string _activeTab = "All";
    private string _searchText = "";
    private bool _isLoading = true;
    private string? _loadError;

    private int _guestHouseId;
    private DateTime _checkIn;
    private DateTime _checkOut;

    protected override async Task OnInitializedAsync()
    {
        _guestHouseId = guestHouseId ?? 0;
        if (_guestHouseId <= 0 ||
            !TryParseDateTime(checkIn, out _checkIn) ||
            !TryParseDateTime(checkOut, out _checkOut))
        {
            Navigation.NavigateTo("/GuestHouse");
            return;
        }

        await LoadAvailableRooms();
        _isLoading = false;
    }

    private void SetTab(string tab)
    {
        _activeTab = tab;
    }

    private void ClearFilters()
    {
        _activeTab = "All";
        _searchText = "";
    }

    private void GoBackToDates()
    {
        Navigation.NavigateTo($"/GuestHouseBooking?guestHouseId={_guestHouseId}");
    }

    private void OnQuantityChanged(RoomCardModel room, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var qty))
        {
            var max = room.MaxSelectableQuantity;
            room.SelectedQuantity = max > 0 ? Math.Clamp(qty, 1, max) : 0;
            if (room.ExtraBedSelected)
            {
                room.SelectedExtraBeds = Math.Min(room.SelectedExtraBeds, room.SelectedQuantity);
            }
        }
    }

    private void OnExtraBedToggle(RoomCardModel room, ChangeEventArgs e)
    {
        room.ExtraBedSelected = e.Value is true;
        if (!room.ExtraBedSelected)
        {
            room.SelectedExtraBeds = 0;
        }
        else
        {
            room.SelectedExtraBeds = 1;
        }
    }

    private void OnExtraBedsChanged(RoomCardModel room, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var beds))
        {
            room.SelectedExtraBeds = Math.Clamp(beds, 0, room.SelectedQuantity);
        }
    }

    private void GoToGuestDetails(RoomCardModel room)
    {
        var targetRoomId = room.GetSelectedRoomId();
        if (!targetRoomId.HasValue)
        {
            return;
        }

        var extraBeds = room.ExtraBedSelected ? room.SelectedExtraBeds : 0;
        var url = $"/GuestDetails?guestHouseId={_guestHouseId}" +
                  $"&roomTypeId={targetRoomId.Value}" +
                  $"&numberOfRooms={room.SelectedQuantity}" +
                  $"&extraBeds={extraBeds}" +
                  $"&checkIn={Uri.EscapeDataString(_checkIn.ToString("yyyy-MM-ddTHH:mm:ss"))}" +
                  $"&checkOut={Uri.EscapeDataString(_checkOut.ToString("yyyy-MM-ddTHH:mm:ss"))}";
        Navigation.NavigateTo(url);
    }

    private List<RoomCardModel> FilteredRooms
    {
        get
        {
            IEnumerable<RoomCardModel> query = _rooms;
            if (_activeTab != "All")
                query = query.Where(r => string.Equals(r.RoomType, _activeTab, StringComparison.OrdinalIgnoreCase));
            if (!string.IsNullOrWhiteSpace(_searchText))
            {
                var term = _searchText.Trim();
                query = query.Where(r =>
                    r.RoomType.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    (r.RoomNumber ?? "").Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    r.UnderlyingRooms.Any(u => (u.RoomNumber ?? "").Contains(term, StringComparison.OrdinalIgnoreCase)));
            }
            return query.ToList();
        }
    }

    // Records in one group can be booked together in a single booking (the API combines them
    // with the same rule - GuestHouseRoomInventory.AreCompatible), so the extra-bed price is part
    // of the key: records with different extra-bed prices are never combined.
    private static string GetGroupKey(int guestHouseId, AvailableRoomDto room)
    {
        var priceKey = room.PricePerNight.ToString("F2", CultureInfo.InvariantCulture);
        var cotKey = room.ExtraCotPrice.HasValue ? room.ExtraCotPrice.Value.ToString("F2", CultureInfo.InvariantCulture) : "none";
        if (room.MasterRoomTypeId.HasValue && room.MasterRoomTypeId.Value > 0)
        {
            return $"gh_{guestHouseId}:master_{room.MasterRoomTypeId.Value}:price_{priceKey}:cot_{cotKey}";
        }
        else
        {
            var normalizedType = (room.RoomType ?? "Room").Trim().ToLowerInvariant();
            return $"gh_{guestHouseId}:legacy_{normalizedType}:price_{priceKey}:cot_{cotKey}";
        }
    }

    private async Task LoadAvailableRooms()
    {
        try
        {
            var url = $"api/GuestHouseBooking/availability?guestHouseId={_guestHouseId}" +
                      $"&checkIn={Uri.EscapeDataString(_checkIn.ToString("yyyy-MM-ddTHH:mm:ss"))}" +
                      $"&checkOut={Uri.EscapeDataString(_checkOut.ToString("yyyy-MM-ddTHH:mm:ss"))}";

            var result = await Http.GetFromJsonAsync<AvailabilityResultDto>(url);
            if (result is null)
            {
                _loadError = "No availability data found.";
                _rooms = new();
                return;
            }

            var groups = result.Rooms
                .GroupBy(r => GetGroupKey(_guestHouseId, r))
                .ToList();

            var mapped = new List<RoomCardModel>();
            var index = 0;
            foreach (var g in groups)
            {
                var underlying = g.ToList();
                var first = underlying[0];
                var totalAvailable = underlying.Sum(r => r.AvailableQuantity);

                mapped.Add(new RoomCardModel
                {
                    GroupKey = g.Key,
                    MasterRoomTypeId = first.MasterRoomTypeId,
                    RoomType = first.RoomType,
                    RoomNumber = first.RoomNumber,
                    ImageUrl = RoomImages[index % RoomImages.Length],
                    PricePerNight = first.PricePerNight,
                    ExtraCotPrice = underlying.FirstOrDefault(r => r.ExtraCotPrice.HasValue)?.ExtraCotPrice ?? first.ExtraCotPrice,
                    AvailableQuantity = totalAvailable,
                    NumberOfAdults = underlying.Max(r => r.NumberOfAdults ?? r.Capacity ?? 2),
                    SelectedQuantity = totalAvailable > 0 ? 1 : 0,
                    ExtraBedSelected = false,
                    SelectedExtraBeds = 0,
                    UnderlyingRooms = underlying
                });
                index++;
            }

            _rooms = mapped;
            _tabOptions = new List<string> { "All" };
            _tabOptions.AddRange(_rooms.Select(r => r.RoomType).Distinct(StringComparer.OrdinalIgnoreCase));
            _activeTab = "All";
        }
        catch (Exception ex)
        {
            _loadError = $"Could not load available rooms: {ex.Message}";
            _rooms = new();
        }
    }

    private static bool TryParseDateTime(string? value, out DateTime result)
    {
        result = default;
        if (string.IsNullOrWhiteSpace(value)) return false;
        return DateTime.TryParseExact(value, "yyyy-MM-ddTHH:mm:ss", CultureInfo.InvariantCulture, DateTimeStyles.None, out result)
            || DateTime.TryParse(value, CultureInfo.InvariantCulture, DateTimeStyles.None, out result);
    }

    private static List<string> SelectAmenities(string roomType)
    {
        var t = (roomType ?? "").ToLowerInvariant();
        var pills = new List<string>();

        if (t.Contains("ac"))
            pills.Add($"<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M12 2v20\"></path><path d=\"M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6\"></path></svg> AC");

        pills.Add($"<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M5 12.55a11 11 0 0 1 14.08 0\"></path><path d=\"M1.42 9a16 16 0 0 1 21.16 0\"></path><path d=\"M8.53 16.11a6 6 0 0 1 6.95 0\"></path><line x1=\"12\" y1=\"20\" x2=\"12.01\" y2=\"20\"></line></svg> WIFI");

        if (!t.Contains("dorm"))
            pills.Add($"<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"2\" y=\"7\" width=\"20\" height=\"15\" rx=\"2\" ry=\"2\"></rect><polyline points=\"17 2 12 7 7 2\"></polyline></svg> TV");

        if (t.Contains("suite"))
            pills.Add($"<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M20 21H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2z\"></path><path d=\"M8 21v-8\"></path><path d=\"M16 21v-8\"></path><path d=\"M2 9h20\"></path></svg> Mini Fridge");
        else if (t.Contains("dorm"))
        {
            pills.Add($"<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"3\" y=\"11\" width=\"18\" height=\"11\" rx=\"2\" ry=\"2\"></rect><path d=\"M7 11V7a5 5 0 0 1 10 0v4\"></path></svg> Locker");
            pills.Add($"<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M18 8h1a4 4 0 0 1 0 8h-1\"></path><path d=\"M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z\"></path><line x1=\"6\" y1=\"1\" x2=\"6\" y2=\"4\"></line><line x1=\"10\" y1=\"1\" x2=\"10\" y2=\"4\"></line><line x1=\"14\" y1=\"1\" x2=\"14\" y2=\"4\"></line></svg> Common Bath");
        }
        else
        {
            pills.Add($"<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M12 2v20\"></path><path d=\"M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6\"></path></svg> Hot Water");
            if (t.Contains("non ac"))
                pills.Add($"<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"3\" y=\"11\" width=\"18\" height=\"11\" rx=\"2\" ry=\"2\"></rect><path d=\"M7 11V7a5 5 0 0 1 10 0v4\"></path></svg> Parking");
        }

        return pills;
    }

    public class RoomCardModel
    {
        public string GroupKey { get; set; } = "";
        public int? MasterRoomTypeId { get; set; }
        public string RoomType { get; set; } = "";
        public string? RoomNumber { get; set; }
        public string ImageUrl { get; set; } = "";
        public decimal PricePerNight { get; set; }
        public decimal? ExtraCotPrice { get; set; }
        public int AvailableQuantity { get; set; }
        public int NumberOfAdults { get; set; }
        public int SelectedQuantity { get; set; } = 1;
        public bool ExtraBedSelected { get; set; }
        public int SelectedExtraBeds { get; set; }
        public List<AvailableRoomDto> UnderlyingRooms { get; set; } = new();

        // One booking can take the whole group: the API reserves the selected record first and
        // the rest from the group's other records (POST api/GuestHouseBooking/book), re-checking
        // availability for every record inside its transaction.
        public int MaxSelectableQuantity => UnderlyingRooms.Sum(r => Math.Max(0, r.AvailableQuantity));

        public int RoomId => GetSelectedRoomId() ?? UnderlyingRooms.FirstOrDefault()?.RoomId ?? 0;
        public int RoomTypeId => RoomId;

        // The record with the most free rooms (the same record as before whenever one record covers
        // the selected quantity); the API takes any remainder from the other records of the group.
        public int? GetSelectedRoomId()
        {
            if (SelectedQuantity <= 0 || SelectedQuantity > MaxSelectableQuantity)
                return null;

            return UnderlyingRooms
                .Where(r => r.AvailableQuantity > 0)
                .OrderByDescending(r => r.AvailableQuantity)
                .FirstOrDefault()?.RoomId;
        }

        public List<string> Amenities => SelectAmenities(RoomType);
        public string PriceDisplay => PricePerNight.ToString("N0");
        public string GuestLabel => NumberOfAdults == 1 ? "1 Guest were allowed" : $"{NumberOfAdults} Guests were allowed";
        public int PhotoCount => 0;
        public int VideoCount => 0;
    }

    public class AvailabilityResultDto
    {
        public int GuestHouseId { get; set; }
        public string GuestHouseName { get; set; } = "";
        public DateTime CheckIn { get; set; }
        public DateTime CheckOut { get; set; }
        public List<AvailableRoomDto> Rooms { get; set; } = new();
    }

    public class AvailableRoomDto
    {
        public int RoomId { get; set; }
        public int RoomTypeId { get; set; }
        public int? MasterRoomTypeId { get; set; }
        public string RoomType { get; set; } = "";
        public string? RoomNumber { get; set; }
        public string? Description { get; set; }
        public decimal PricePerNight { get; set; }
        public decimal? ExtraCotPrice { get; set; }
        public int? Capacity { get; set; }
        public int? NumberOfAdults { get; set; }
        public int AvailableQuantity { get; set; }
    }
}
