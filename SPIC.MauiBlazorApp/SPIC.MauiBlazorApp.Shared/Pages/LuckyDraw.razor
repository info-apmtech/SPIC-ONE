@page "/Luckydraw"

<div class="container-fluid py-4 px-0">
    <div class="ld-container">

        <div class="ld-header-mobile ld-mobile-only">
            <div class="ld-check-badge-large">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
            </div>
            <div class="ld-hm-title">
                <span class="ld-emoji-left">🎉</span> 
                You're in the Lucky Draw!
            </div>
            <div class="ld-hm-subtitle">
                Your entry has been securely registered.
                <span class="ld-emoji-right">🎊</span>
            </div>
        </div>

        <div class="ld-header-desktop ld-desktop-only">
            <div class="ld-hd-left">
                <div class="ld-check-badge-medium">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                </div>
                <div class="ld-hd-text">
                    <h1 class="ld-hd-title">You're in the Lucky Draw! <span>🎉</span></h1>
                    <p class="ld-hd-subtitle">Your purchase has been verified and entry added successfully</p>
                </div>
            </div>
            <div class="ld-hd-right">
                <span class="ld-verified-pill">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                    Verified
                </span>
            </div>
        </div>


        <div class="ld-ticket-mobile ld-mobile-only">
            <div class="ld-tm-inner">
                <div class="ld-tm-title">+1 ENTRY ADDED</div>
                <div class="ld-tm-badge">TICKET ACTIVATED</div>
                <div class="ld-tm-corner ld-tm-tl"></div>
                <div class="ld-tm-corner ld-tm-tr"></div>
                <div class="ld-tm-corner ld-tm-bl"></div>
                <div class="ld-tm-corner ld-tm-br"></div>
            </div>
        </div>

        <div class="ld-ticket-desktop-wrapper ld-desktop-only">
            <div class="ld-ticket-desktop-inner">
                <div class="ld-td-left">
                    <div class="ld-td-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="10" rx="2" ry="2"></rect><path d="M12 7v10"></path><path d="M6 12h.01"></path><path d="M18 12h.01"></path></svg>
                    </div>
                    <div class="ld-td-text-group">
                        <span class="ld-td-label">NEW ENTRY ADDED</span>
                        <span class="ld-td-value">+1 Lucky Draw Entry</span>
                    </div>
                </div>
                
                <div class="ld-td-right">
                    <div class="ld-td-status-box">
                        <div class="ld-td-status-text">
                            <div class="ld-td-activated">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                                Ticket Activated
                            </div>
                            <div class="ld-td-id">Entry ID: ENT97941280 &nbsp;•&nbsp; 4/11/2026</div>
                        </div>
                        <div class="ld-td-gift">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 12 20 22 4 22 4 12"></polyline><rect x="2" y="7" width="20" height="5"></rect><line x1="12" y1="22" x2="12" y2="7"></line><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path></svg>
                        </div>
                    </div>
                </div>
            </div>
            <div class="ld-td-notch ld-td-notch-left"></div>
            <div class="ld-td-notch ld-td-notch-right"></div>
        </div>


        <div class="ld-two-col">
            <div class="ld-card-outline">
                <div class="ld-card-header">
                    <span class="ld-hdr-icon">🎁</span>
                    <span class="ld-hdr-title">Grand Prize</span>
                </div>
                <div class="ld-prize-body">
                    <div class="ld-prize-img">🪵</div>
                    <div class="ld-prize-details">
                        <div class="ld-prize-name">Single Door Wardrobe</div>
                        <div class="ld-prize-desc">Final prize for the grand draw</div>
                        <div class="ld-prize-value">₹10,500 <span>Est value</span></div>
                    </div>
                    <div class="ld-gift-icon">🎀</div>
                </div>
            </div>

            <div class="ld-card-outline">
                <div class="ld-card-header ld-flex-between">
                    <div>
                        <span class="ld-hdr-icon">🥇</span>
                        <span class="ld-hdr-title">Previous Winners</span>
                    </div>
                    <button class="ld-btn-view-all">View All</button>
                </div>
                <div class="ld-winner-body">
                    <div class="ld-winner-avatar">👨‍💼</div>
                    <div class="ld-winner-details">
                        <div class="ld-winner-name">Rajesh Kumar Patel</div>
                        <div class="ld-winner-loc">Coimbatore, Tamil Nadu</div>
                        <div class="ld-winner-meta">
                            <span>Won: TV 24 Inch</span>
                            <span>Draw Date: 20 Jan 2026</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <div class="ld-card-solid">
            <div class="ld-section-label">CURRENT CYCLE PROGRESS</div>
            
            <div class="ld-progress-top">
                <div class="ld-progress-numbers">
                    <span class="ld-prog-current">45</span>
                    <span class="ld-prog-total"> / 100</span>
                </div>
                <div class="ld-trophy">🏆</div>
            </div>

            <div class="ld-progress-bar">
                <div class="ld-progress-fill" style="width: 45%;"></div>
            </div>
            
            <div class="ld-progress-markers">
                <span>25</span>
                <span>50</span>
                <span>75</span>
                <span class="ld-gold-text">GOLD MILESTONE</span>
            </div>

            <div class="ld-milestone-grid">
                <div class="ld-ms-card ld-ms-yellow">
                    <div class="ld-ms-header">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle><circle cx="12" cy="12" r="2"></circle></svg>
                        Next Milestone
                    </div>
                    <div class="ld-ms-number">75</div>
                    <div class="ld-ms-sub">62 entries to go</div>
                </div>
                <div class="ld-ms-card ld-ms-purple">
                    <div class="ld-ms-header">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 12 20 22 4 22 4 12"></polyline><rect x="2" y="7" width="20" height="5"></rect><line x1="12" y1="22" x2="12" y2="7"></line><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path></svg>
                        Grand Draw
                    </div>
                    <div class="ld-ms-number">100</div>
                    <div class="ld-ms-sub">Final milestone</div>
                </div>
            </div>
        </div>


        <div class="ld-how-card">
            <div class="ld-how-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
            </div>
            <div class="ld-how-text">
                <h3>How It Works</h3>
                <p>Each Purchase Gives You 1 Entry. Entries Are Counted In Cycles Of 100. Reach 100 Entries To Unlock The Grand Draw.</p>
            </div>
        </div>


        <div class="ld-actions-mobile ld-mobile-only">
            <button class="ld-btn-blue">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"></rect><rect x="14" y="3" width="7" height="7" rx="1"></rect><rect x="3" y="14" width="7" height="7" rx="1"></rect><path d="M14 14h3v3h-3zM19 14v3M14 19h3M19 19h2M21 14v3"></path></svg>
                Scan QR
            </button>
            <button class="ld-btn-grey">View Entries</button>
        </div>

        <div class="ld-actions-desktop ld-desktop-only">
            <button class="ld-btn-grey">View All Entries</button>
            <button class="ld-btn-blue">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"></rect><rect x="14" y="3" width="7" height="7" rx="1"></rect><rect x="3" y="14" width="7" height="7" rx="1"></rect><path d="M14 14h3v3h-3zM19 14v3M14 19h3M19 19h2M21 14v3"></path></svg>
                Scan Another Product
            </button>
        </div>

    </div>
</div>


