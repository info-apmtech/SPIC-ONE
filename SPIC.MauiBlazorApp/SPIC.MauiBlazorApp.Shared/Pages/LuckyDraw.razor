@page "/Luckydraw"

<style>
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    /* ── CONTAINER ── */
    .lucky-container {
        max-width: 420px;
        margin: 0 auto;
        padding: 16px;
    }

    /* ── HEADER ── */
    .badge-wrap {
        display: flex;
        justify-content: center;
        margin-bottom: 14px;
    }

    .check-badge {
        width: 58px;
        height: 58px;
        background: #27ae60;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 12px rgba(39,174,96,0.4);
    }

        .check-badge svg {
            width: 28px;
            height: 28px;
            fill: none;
            stroke: #fff;
            stroke-width: 3;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .lucky-title {
        text-align: center;
        font-size: 16px;
        font-weight: 700;
        color: #222;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        margin-bottom: 5px;
    }

    .lucky-sub {
        text-align: center;
        font-size: 13px;
        color: #888;
        margin-bottom: 18px;
    }

    /* ── TICKET BANNER ── */
    .entry-banner {
        background: linear-gradient(135deg, #2e7d32, #43a047);
        border-radius: 12px;
        padding: 16px 20px 14px;
        margin-bottom: 16px;
        border: 2px dashed rgba(255,255,255,0.28);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .entry-left {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .entry-text {
        font-size: 20px;
        font-weight: 800;
        color: #fff;
        letter-spacing: 1.5px;
    }

    .ticket-badge {
        display: inline-block;
        background: #f5c518;
        color: #5a3e00;
        font-size: 10.5px;
        font-weight: 700;
        letter-spacing: 1px;
        padding: 4px 16px;
        border-radius: 20px;
        width: fit-content;
    }

    .entry-right {
        display: none;
    }

    /* ── GRAND PRIZE CARD ── */
    .grand-prize-card {
        border: 2px solid #b2dfdb;
        border-radius: 14px;
        overflow: hidden;
        margin-bottom: 16px;
    }

    .card-header-row {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 14px 8px;
        background: #fff;
        border-bottom: 1px solid #e0f2f1;
    }

        .card-header-row .hdr-icon {
            font-size: 18px;
        }

        .card-header-row .hdr-label {
            font-size: 12px;
            font-weight: 800;
            color: #1a1a1a;
            letter-spacing: 0.8px;
            text-transform: uppercase;
        }

    .prize-content {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 14px;
        background: linear-gradient(120deg, #e8f5e9 0%, #f0fdf4 60%, #fffde7 100%);
    }

    .prize-img {
        width: 80px;
        height: 80px;
        border-radius: 10px;
        background: #c8e6c9;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 36px;
    }

    .prize-info {
        flex: 1;
    }

    .prize-name {
        font-size: 15px;
        font-weight: 800;
        color: #2e7d32;
        margin-bottom: 3px;
    }

    .prize-desc {
        font-size: 12px;
        color: #666;
        margin-bottom: 6px;
    }

    .prize-value {
        font-size: 17px;
        font-weight: 900;
        color: #1a1a1a;
    }

        .prize-value span {
            font-size: 11px;
            font-weight: 500;
            color: #999;
            margin-left: 4px;
        }

    .gift-icon {
        font-size: 32px;
        flex-shrink: 0;
    }

    /* ── PREVIOUS WINNERS CARD ── */
    .prev-winners-card {
        border: 2px solid #e3e8f0;
        border-radius: 14px;
        overflow: hidden;
        margin-bottom: 16px;
    }

    .winners-header-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 14px 8px;
        background: #fff;
        border-bottom: 1px solid #f0f0f0;
    }

    .winners-title {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12px;
        font-weight: 800;
        color: #1a1a1a;
        letter-spacing: 0.8px;
        text-transform: uppercase;
    }

        .winners-title .medal {
            font-size: 18px;
        }

    .btn-view-all {
        font-size: 12px;
        font-weight: 700;
        color: #fff;
        background: #222;
        border: none;
        border-radius: 8px;
        padding: 5px 12px;
        cursor: pointer;
    }

    .winner-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 14px;
        background: linear-gradient(120deg, #fffde7 0%, #fff9f0 100%);
    }

    .winner-avatar {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: #b0bec5;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        overflow: hidden;
        border: 2px solid #e0e0e0;
    }

    .winner-info {
        flex: 1;
    }

    .winner-name {
        font-size: 14px;
        font-weight: 800;
        color: #1a1a1a;
        margin-bottom: 2px;
    }

    .winner-location {
        font-size: 12px;
        color: #888;
        margin-bottom: 8px;
    }

    .winner-meta {
        display: flex;
        justify-content: space-between;
        font-size: 11.5px;
        color: #555;
        font-weight: 600;
    }

    /* ── PROGRESS ── */
    .section-label {
        font-size: 10.5px;
        font-weight: 700;
        color: #aaa;
        letter-spacing: 1.2px;
        margin-bottom: 10px;
    }

    .progress-section {
        margin-bottom: 14px;
    }

    .progress-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        margin-bottom: 10px;
    }

    .progress-count {
        font-size: 36px;
        font-weight: 900;
        color: #111;
        line-height: 1;
    }

    .progress-total {
        font-size: 16px;
        font-weight: 500;
        color: #bbb;
    }

    .trophy-icon {
        font-size: 28px;
        margin-top: 4px;
    }

    .progress-bar-wrap {
        height: 8px;
        background: #e8e8e8;
        border-radius: 4px;
        margin-bottom: 8px;
    }

    .progress-bar-fill {
        height: 100%;
        width: 45%;
        background: #27ae60;
        border-radius: 4px;
    }

    .progress-labels {
        display: flex;
        justify-content: space-between;
        font-size: 11px;
        color: #aaa;
        margin-bottom: 14px;
        align-items: center;
    }

    .gold-milestone {
        color: #b8860b;
        font-weight: 700;
        font-size: 11px;
    }

    /* ── MILESTONE CARDS ── */
    .milestone-cards {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        margin-bottom: 14px;
    }

    .milestone-card {
        border-radius: 10px;
        padding: 12px 14px;
    }

        .milestone-card.yellow {
            background: #fffdf0;
            border: 1px solid #f0e08a;
        }

        .milestone-card.purple-light {
            background: #f8f4ff;
            border: 1px solid #ddd0ff;
        }

    .milestone-icon {
        font-size: 17px;
        margin-bottom: 5px;
    }

    .milestone-title {
        font-size: 12px;
        font-weight: 600;
        color: #555;
        margin-bottom: 3px;
    }

    .milestone-num {
        font-size: 28px;
        font-weight: 900;
        line-height: 1;
        margin-bottom: 3px;
    }

    .milestone-card.yellow .milestone-num {
        color: #c8920a;
    }

    .milestone-card.purple-light .milestone-num {
        color: #7c3aed;
    }

    .milestone-sub {
        font-size: 11px;
        color: #999;
    }

    .milestone-card.purple-light .milestone-sub {
        color: #9f7aea;
    }

    /* ── HOW IT WORKS ── */
    .how-it-works {
        background: #f5f7f5;
        border: 1px solid #dde8dd;
        border-radius: 10px;
        padding: 13px 14px;
        display: flex;
        gap: 10px;
        align-items: flex-start;
        margin-bottom: 20px;
    }

    .info-icon {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        border: 2px solid #27ae60;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        margin-top: 1px;
    }

        .info-icon span {
            font-size: 12px;
            font-weight: 700;
            color: #27ae60;
            font-style: italic;
        }

    .how-title {
        font-size: 13px;
        font-weight: 700;
        color: #333;
        margin-bottom: 5px;
    }

    .how-text {
        font-size: 12px;
        color: #777;
        line-height: 1.55;
    }

    /* ── FOOTER BUTTONS ── */
    .card-footer {
        border-top: 1px solid #f0f0f0;
        display: flex;
        flex-direction: column;
    }

    .btn-scan {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        width: 100%;
        padding: 15px;
        background: #1a73e8;
        color: #fff;
        font-size: 15px;
        font-weight: 700;
        border: none;
        cursor: pointer;
        transition: background 0.2s;
    }

        .btn-scan:hover {
            background: #1558b0;
        }

        .btn-scan svg {
            width: 20px;
            height: 20px;
            fill: #fff;
        }

    .btn-view-entries {
        display: block;
        width: 100%;
        padding: 14px;
        background: #f5f5f5;
        color: #aaa;
        font-size: 14px;
        font-weight: 600;
        border: none;
        cursor: pointer;
        text-align: center;
        transition: background 0.2s;
    }

        .btn-view-entries:hover {
            background: #ebebeb;
        }

    /* =============================================
             WEB / DESKTOP OVERRIDES (min-width: 768px)
             Mobile styles above are untouched
             ============================================= */
    @@media (min-width: 768px) {

        .lucky-container {
            max-width: 1100px;
            padding: 24px 32px;
            background: #fff;
            /*      border: 2px solid #a8c4f0; */
            border-radius: 20px;
            /*            box-shadow: 0 4px 24px rgba(0,0,0,0.09); */
            /*             margin: 24px auto; */
        }
        /* Header */
        .check-badge {
            width: 64px;
            height: 64px;
        }

        .lucky-title {
            font-size: 22px;
        }

        .lucky-sub {
            font-size: 14px;
            margin-bottom: 24px;
        }
        /* Ticket banner */
        .entry-banner {
            padding: 22px 32px;
            margin-bottom: 24px;
            border-radius: 16px;
        }

        .entry-text {
            font-size: 28px;
            letter-spacing: 2px;
        }

        .entry-right {
            display: block;
            text-align: right;
            color: rgba(255,255,255,0.85);
            font-size: 13px;
        }

            .entry-right strong {
                display: block;
                font-size: 15px;
                color: #fff;
                margin-bottom: 4px;
            }
        /* Grand Prize + Winners: side by side */
        .two-col {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 24px;
        }

        .grand-prize-card,
        .prev-winners-card {
            margin-bottom: 0;
            border-radius: 16px;
        }

        .card-header-row {
            padding: 14px 18px 12px;
        }

        .prize-content {
            padding: 18px;
            gap: 16px;
        }

        .prize-img {
            width: 90px;
            height: 90px;
            font-size: 42px;
        }

        .prize-name {
            font-size: 17px;
        }

        .prize-desc {
            font-size: 13px;
        }

        .prize-value {
            font-size: 20px;
        }

        .gift-icon {
            font-size: 38px;
        }

        .winners-header-row {
            padding: 14px 18px 12px;
        }

        .winner-item {
            padding: 18px;
            gap: 14px;
        }

        .winner-avatar {
            width: 60px;
            height: 60px;
            font-size: 28px;
        }

        .winner-name {
            font-size: 16px;
        }

        .winner-location {
            font-size: 13px;
        }

        .winner-meta {
            font-size: 12px;
        }
        /* Progress + Milestones: side by side */
        .bottom-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 24px;
        }

        .progress-card {
            background: #f8faff;
            border: 2px solid #e0e8f0;
            border-radius: 16px;
            padding: 22px 24px;
        }

        .milestones-card {
            background: #f8faff;
            border: 2px solid #e0e8f0;
            border-radius: 16px;
            padding: 22px 24px;
        }

        .progress-count {
            font-size: 48px;
        }

        .progress-total {
            font-size: 18px;
        }

        .trophy-icon {
            font-size: 32px;
        }

        .progress-bar-wrap {
            height: 10px;
        }

        .milestone-cards {
            margin-bottom: 0;
        }

        .milestone-num {
            font-size: 36px;
        }

        .milestone-card {
            padding: 16px 18px;
        }

        .milestone-icon {
            font-size: 20px;
        }
        /* How it works */
        .how-it-works {
            padding: 16px 20px;
            border-radius: 14px;
            margin-bottom: 24px;
        }

        .how-title {
            font-size: 14px;
        }

        .how-text {
            font-size: 13px;
        }
        /* Footer buttons */
        .card-footer {
            border-top: none;
            flex-direction: row;
            gap: 14px;
        }

        .btn-scan {
            flex: 1;
            border-radius: 12px;
            font-size: 16px;
            padding: 16px;
            width: auto;
        }

        .btn-view-entries {
            flex: 1;
            border-radius: 12px;
            font-size: 15px;
            padding: 16px;
            width: auto;
            display: block;
        }
    }
</style>

<div class="lucky-container">

    <!-- HEADER -->
    <div class="badge-wrap">
        <div class="check-badge">
            <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12" /></svg>
        </div>
    </div>
    <div class="lucky-title">🎉 You're in the Lucky Draw! 🎉</div>
    <div class="lucky-sub">Your entry has been securely registered.</div>

    <!-- TICKET BANNER -->
    <div class="entry-banner">
        <div class="entry-left">
            <div class="entry-text">+1 ENTRY ADDED</div>
            <span class="ticket-badge">TICKET ACTIVATED</span>
        </div>
        <div class="entry-right">
            <strong>Entry Confirmed ✓</strong>
            Entry ID: 6164549485 &nbsp;•&nbsp; 4/11/2025
        </div>
    </div>

    <!-- GRAND PRIZE + PREVIOUS WINNERS -->
    <div class="two-col">
        <div class="grand-prize-card">
            <div class="card-header-row">
                <span class="hdr-icon">🎁</span>
                <span class="hdr-label">Grand Prize</span>
            </div>
            <div class="prize-content">
                <div class="prize-img">🪵</div>
                <div class="prize-info">
                    <div class="prize-name">Single Door Wardrobe</div>
                    <div class="prize-desc">Final prize for the grand draw</div>
                    <div class="prize-value">₹10,500 <span>Est value</span></div>
                </div>
                <div class="gift-icon">🎀</div>
            </div>
        </div>

        <div class="prev-winners-card">
            <div class="winners-header-row">
                <div class="winners-title">
                    <span class="medal">🥇</span> Previous Winners
                </div>
                <button class="btn-view-all">View All</button>
            </div>
            <div class="winner-item">
                <div class="winner-avatar">👨‍💼</div>
                <div class="winner-info">
                    <div class="winner-name">Rajesh Kumar Patel</div>
                    <div class="winner-location">Coimbatore, Tamil Nadu</div>
                    <div class="winner-meta">
                        <span>Won: TV 24 Inch</span>
                        <span>Draw Date: 20 Jan 2026</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- PROGRESS + MILESTONES -->
    <div class="bottom-grid">
        <div class="progress-card">
            <div class="section-label">CURRENT CYCLE PROGRESS</div>
            <div class="progress-header">
                <div>
                    <span class="progress-count">45</span>
                    <span class="progress-total"> / 100</span>
                </div>
                <div class="trophy-icon">🏆</div>
            </div>
            <div class="progress-bar-wrap">
                <div class="progress-bar-fill"></div>
            </div>
            <div class="progress-labels">
                <span>25</span>
                <span>50</span>
                <span class="gold-milestone">75 &nbsp; GOLD MILESTONE</span>
                <span>100</span>
            </div>
        </div>

        <div class="milestones-card">
            <div class="section-label">MILESTONES</div>
            <div class="milestone-cards">
                <div class="milestone-card yellow">
                    <div class="milestone-icon">🎯</div>
                    <div class="milestone-title">Next Milestone</div>
                    <div class="milestone-num">75</div>
                    <div class="milestone-sub">62 entries to go</div>
                </div>
                <div class="milestone-card purple-light">
                    <div class="milestone-icon">🎁</div>
                    <div class="milestone-title">Grand Draw</div>
                    <div class="milestone-num">100</div>
                    <div class="milestone-sub">Final milestone</div>
                </div>
            </div>
        </div>
    </div>

    <!-- HOW IT WORKS -->
    <div class="how-it-works">
        <div class="info-icon"><span>i</span></div>
        <div>
            <div class="how-title">How It Works</div>
            <div class="how-text">Each Purchase Gives You 1 Entry. Entries Are Counted In Cycles Of 100. Reach 100 Entries To Unlock The Grand Draw.</div>
        </div>
    </div>

    <!-- FOOTER -->
    <div class="card-footer">
        <button class="btn-scan">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <rect x="3" y="3" width="7" height="7" rx="1" />
                <rect x="14" y="3" width="7" height="7" rx="1" />
                <rect x="3" y="14" width="7" height="7" rx="1" />
                <rect x="5" y="5" width="3" height="3" fill="#1a73e8" />
                <rect x="16" y="5" width="3" height="3" fill="#1a73e8" />
                <rect x="5" y="16" width="3" height="3" fill="#1a73e8" />
                <path d="M14 14h3v3h-3zM19 14v3M14 19h3M19 19h2M21 14v3" stroke="#fff" stroke-width="1.5" fill="none" stroke-linecap="round" />
            </svg>
            Scan QR
        </button>
        <button class="btn-view-entries">View Entries</button>
    </div>

</div>