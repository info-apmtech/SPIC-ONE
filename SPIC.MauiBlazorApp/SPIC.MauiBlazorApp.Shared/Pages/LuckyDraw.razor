@page "/Luckydraw"

<style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
/*         font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; */
/*         background: #d6e4f7;
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        padding: 16px; */
      }

      .card {
        background: #fff;
        border: 2px solid #a8c4f0;
        border-radius: 16px;
        width: 100%;
        max-width: 360px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0,0,0,0.1);
      }

      .card-body {
        padding: 24px 20px 0;
      }

      @@media (min-width: 992px) {
        .card {
          max-width: 700px;
        }

        .card-body {
          padding: 32px 36px 0;
        }

        .lucky-title {
          font-size: 18px;
        }

        .lucky-sub {
          font-size: 14px;
          margin-bottom: 20px;
        }

        .entry-banner {
          padding: 20px 24px 18px;
          margin-bottom: 28px;
          display: flex;
          align-items: center;
          justify-content: space-between;
        }

        .entry-banner-left {
          display: flex;
          flex-direction: column;
          align-items: flex-start;
          gap: 8px;
        }

        .entry-text {
          font-size: 22px;
        }

        .entry-banner-right {
          display: flex;
          flex-direction: column;
          align-items: flex-end;
          gap: 4px;
        }

        .section-label {
          font-size: 11px;
          margin-bottom: 14px;
        }

        .progress-header {
          margin-bottom: 14px;
        }

        .progress-count {
          font-size: 40px;
        }

        .progress-bar-wrap {
          margin-bottom: 10px;
        }

        .progress-labels {
          margin-bottom: 20px;
        }

        .milestone-cards {
          grid-template-columns: 1fr 1fr;
          gap: 16px;
          margin-bottom: 20px;
        }

        .milestone-card {
          padding: 16px 18px;
        }

        .milestone-icon {
          font-size: 20px;
          margin-bottom: 8px;
        }

        .milestone-title {
          font-size: 13px;
          margin-bottom: 6px;
        }

        .milestone-num {
          font-size: 32px;
          margin-bottom: 6px;
        }

        .milestone-sub {
          font-size: 12px;
        }

        .how-it-works {
          padding: 16px 18px;
          margin-bottom: 24px;
        }

        .how-title {
          font-size: 14px;
          margin-bottom: 6px;
        }

        .how-text {
          font-size: 13px;
        }

        .btn-scan {
          padding: 16px;
          font-size: 16px;
        }

        .btn-view {
          padding: 16px;
          font-size: 15px;
        }
      }

      .badge-wrap {
        display: flex;
        justify-content: center;
        margin-bottom: 14px;
      }

      .check-badge {
        width: 58px;
        height: 58px;
        background: #27ae60;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 12px rgba(39,174,96,0.4);
      }

      .check-badge svg {
        width: 28px;
        height: 28px;
        fill: none;
        stroke: #fff;
        stroke-width: 3;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      .lucky-title {
        text-align: center;
        font-size: 16px;
        font-weight: 700;
        color: #222;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        margin-bottom: 5px;
      }

      .lucky-sub {
        text-align: center;
        font-size: 13px;
        color: #888;
        margin-bottom: 18px;
      }

      .entry-banner {
        background: linear-gradient(135deg, #2e7d32, #43a047);
        border-radius: 12px;
        padding: 16px 20px 14px;
        text-align: center;
        margin-bottom: 20px;
        position: relative;
        border: 2px dashed rgba(255,255,255,0.28);
      }

      .entry-text {
        font-size: 20px;
        font-weight: 800;
        color: #fff;
        letter-spacing: 1.5px;
        margin-bottom: 8px;
      }

      .ticket-badge {
        display: inline-block;
        background: #f5c518;
        color: #5a3e00;
        font-size: 10.5px;
        font-weight: 700;
        letter-spacing: 1px;
        padding: 4px 16px;
        border-radius: 20px;
      }

      .section-label {
        font-size: 10.5px;
        font-weight: 700;
        color: #aaa;
        letter-spacing: 1.2px;
        margin-bottom: 10px;
      }

      .progress-section {
        margin-bottom: 14px;
      }

      .progress-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        margin-bottom: 10px;
      }

      .progress-count {
        font-size: 36px;
        font-weight: 900;
        color: #111;
        line-height: 1;
      }

      .progress-total {
        font-size: 16px;
        font-weight: 500;
        color: #bbb;
      }

      .trophy-icon {
        font-size: 28px;
        margin-top: 4px;
      }

      .progress-bar-wrap {
        height: 8px;
        background: #e8e8e8;
        border-radius: 4px;
        margin-bottom: 8px;
      }

      .progress-bar-fill {
        height: 100%;
        width: 45%;
        background: #27ae60;
        border-radius: 4px;
      }

      .progress-labels {
        display: flex;
        justify-content: space-between;
        font-size: 11px;
        color: #aaa;
        margin-bottom: 14px;
        align-items: center;
      }

      .gold-milestone {
        color: #b8860b;
        font-weight: 700;
        font-size: 11px;
      }

      .milestone-cards {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        margin-bottom: 14px;
      }

      .milestone-card {
        border-radius: 10px;
        padding: 12px 14px;
      }

      .milestone-card.yellow {
        background: #fffdf0;
        border: 1px solid #f0e08a;
      }

      .milestone-card.purple-light {
        background: #f8f4ff;
        border: 1px solid #ddd0ff;
      }

      .milestone-icon {
        font-size: 17px;
        margin-bottom: 5px;
      }

      .milestone-title {
        font-size: 12px;
        font-weight: 600;
        color: #555;
        margin-bottom: 3px;
      }

      .milestone-num {
        font-size: 28px;
        font-weight: 900;
        line-height: 1;
        margin-bottom: 3px;
      }

      .milestone-card.yellow .milestone-num {
        color: #c8920a;
      }

      .milestone-card.purple-light .milestone-num {
        color: #7c3aed;
      }

      .milestone-sub {
        font-size: 11px;
        color: #999;
      }

      .milestone-card.purple-light .milestone-sub {
        color: #9f7aea;
      }

      .how-it-works {
        background: #f5f7f5;
        border: 1px solid #dde8dd;
        border-radius: 10px;
        padding: 13px 14px;
        display: flex;
        gap: 10px;
        align-items: flex-start;
        margin-bottom: 20px;
      }

      .info-icon {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        border: 2px solid #27ae60;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        margin-top: 1px;
      }

      .info-icon span {
        font-size: 12px;
        font-weight: 700;
        color: #27ae60;
        font-style: italic;
      }

      .how-title {
        font-size: 13px;
        font-weight: 700;
        color: #333;
        margin-bottom: 5px;
      }

      .how-text {
        font-size: 12px;
        color: #777;
        line-height: 1.55;
      }

      .card-footer {
        border-top: 1px solid #f0f0f0;
      }

      .btn-scan {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        width: 100%;
        padding: 15px;
        background: #1a73e8;
        color: #fff;
        font-size: 15px;
        font-weight: 700;
        border: none;
        cursor: pointer;
        letter-spacing: 0.3px;
        transition: background 0.2s;
      }

      .btn-scan:hover {
        background: #1558b0;
      }

      .qr-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }

      .qr-icon svg {
        width: 20px;
        height: 20px;
        fill: #fff;
      }

      .btn-view {
        display: block;
        width: 100%;
        padding: 14px;
        background: #f5f5f5;
        color: #aaa;
        font-size: 14px;
        font-weight: 600;
        border: none;
        cursor: pointer;
        text-align: center;
        transition: background 0.2s;
      }

      .btn-view:hover {
        background: #ebebeb;
      }

      /* Layout container to center page and provide comfortable gutters */
      .lucky-container { max-width: 1100px; margin: 20px auto; padding: 16px; }

      /* Make card centered and responsive */
      .card { margin: 0 auto; }

      /* At larger screens, increase card width for better desktop layout */
      &#64;media (min-width: 768px) {
        .card { max-width: 820px; }
      }

      /* Card footer: stack buttons on mobile, place side-by-side on larger screens */
      .card-footer { display: flex; flex-direction: column; gap: 10px; padding: 12px; }
      &#64;media (min-width: 768px) {
        .card-footer { flex-direction: row; align-items: center; justify-content: space-between; }
        .card-footer .btn-scan, .card-footer .btn-view { width: auto; }
      }

      /* Small screens: make milestone cards single column */
      &#64;media (max-width: 480px) {
        .milestone-cards { grid-template-columns: 1fr; }
      }

      /* Larger desktops: increase max width and scale inner spacing/typography for web */
      &#64;media (min-width: 1200px) {
        .card { max-width: 960px; }
        .card-body { padding: 36px 48px 0; }
        .lucky-title { font-size: 24px; }
        .entry-text { font-size: 26px; }
        .progress-count { font-size: 56px; }
        .milestone-num { font-size: 40px; }
      }

    </style>
    <meta property="og:image" content="https://bolt.new/static/og_default.png">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:image" content="https://bolt.new/static/og_default.png">

    <div class="lucky-container">
      <div class="card">
      <div class="card-body">

        <div class="badge-wrap">
          <div class="check-badge">
            <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
        </div>

        <div class="lucky-title">
          🎉 You're in the Lucky Draw! 🎉
        </div>
        <div class="lucky-sub">Your entry has been securely registered.</div>

        <div class="entry-banner">
          <div class="entry-banner-left">
            <div class="entry-text">+1 ENTRY ADDED</div>
            <span class="ticket-badge">TICKET ACTIVATED</span>
          </div>
          <div class="entry-banner-right" style="display: none;">
            <span class="ticket-badge">Ticket Activated</span>
            <span style="font-size: 11px; color: #fff; opacity: 0.8;">Entry ID: 6164549485 • 4/11/2025</span>
          </div>
        </div>

        <div class="progress-section">
          <div class="section-label">CURRENT CYCLE PROGRESS</div>
          <div class="progress-header">
            <div>
              <span class="progress-count">45</span>
              <span class="progress-total"> / 100</span>
            </div>
            <div class="trophy-icon">🏆</div>
          </div>
          <div class="progress-bar-wrap">
            <div class="progress-bar-fill"></div>
          </div>
          <div class="progress-labels">
            <span>25</span>
            <span>50</span>
            <span class="gold-milestone">75 &nbsp; GOLD MILESTONE</span>
            <span></span>
          </div>
        </div>

        <div class="milestone-cards">
          <div class="milestone-card yellow">
            <div class="milestone-icon">🎯</div>
            <div class="milestone-title">Next Milestone</div>
            <div class="milestone-num">75</div>
            <div class="milestone-sub">62 entries to go</div>
          </div>
          <div class="milestone-card purple-light">
            <div class="milestone-icon">🎁</div>
            <div class="milestone-title">Grand Draw</div>
            <div class="milestone-num">75</div>
            <div class="milestone-sub">Final milestone</div>
          </div>
        </div>

        <div class="how-it-works">
          <div class="info-icon"><span>i</span></div>
          <div>
            <div class="how-title">How It Works</div>
            <div class="how-text">Each Purchase Gives You 1 Entry. Entries Are Counted In Cycles Of 100. Reach 100 Entries To Unlock The Grand Draw.</div>
          </div>
        </div>

      </div>

      <div class="card-footer">
        <button class="btn-scan">
          <span class="qr-icon">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <rect x="3" y="3" width="7" height="7" rx="1"/>
              <rect x="14" y="3" width="7" height="7" rx="1"/>
              <rect x="3" y="14" width="7" height="7" rx="1"/>
              <rect x="5" y="5" width="3" height="3" fill="#1a73e8"/>
              <rect x="16" y="5" width="3" height="3" fill="#1a73e8"/>
              <rect x="5" y="16" width="3" height="3" fill="#1a73e8"/>
              <line x1="14" y1="14" x2="14" y2="14" stroke="#fff" stroke-width="2" stroke-linecap="round"/>
              <path d="M14 14h3v3h-3zM19 14v3M14 19h3M19 19h2M21 14v3" stroke="#fff" stroke-width="1.5" fill="none" stroke-linecap="round"/>
            </svg>
          </span>
          Scan QR
        </button>
        <button class="btn-view">View Entries</button>
      </div>
      </div>
    </div>
