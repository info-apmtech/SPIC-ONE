	// --- Helper Methods for Product Identification ---
	private bool IsUreaProduct(Product? product)
{
    return !string.IsNullOrWhiteSpace(product?.Name) &&
           product.Name.Trim().Equals("Urea", StringComparison.OrdinalIgnoreCase);
}

private bool IsFertilizerCategory(Category? category)
{
    return category?.Name != null &&
           category.Name.Contains("Fertilizer", StringComparison.OrdinalIgnoreCase);
}
private bool IsSpecialityCategory(Category? category)
{
    return category?.Name != null &&
           (
               category.Name.Contains("Speciality", StringComparison.OrdinalIgnoreCase) ||
               category.Name.Contains("Specialty", StringComparison.OrdinalIgnoreCase)
           );
}

private bool IsOtherFertilizerProduct(Product? product)
{
    if (product == null)
        return false;

    var category = _categories.FirstOrDefault(c => c.Id == product.CategoryId);

    return IsFertilizerCategory(category) && !IsUreaProduct(product);
}
	private bool IsSpecialityProduct(Product? product)
{
    if (product == null)
        return false;

    var category = _categories.FirstOrDefault(c => c.Id == product.CategoryId);

    return IsSpecialityCategory(category);
}

private List<Product> GetOtherFertilizerProducts()
{
    return _products
        .Where(IsOtherFertilizerProduct)
        .ToList();
}
private List<Product> GetSpecialityProducts()
{
    return _products
        .Where(IsSpecialityProduct)
        .ToList();
}

	private int GetFertilizerCategoryId()
	{
		return _categories
			.FirstOrDefault(c => IsFertilizerCategory(c))
			?.Id ?? 0;
	}

