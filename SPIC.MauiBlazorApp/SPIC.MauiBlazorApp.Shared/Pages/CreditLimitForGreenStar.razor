private decimal CalculateOtherFertilizerSalesQty(int? financialYearId = null)
{
	var query = _greenstarDefaultSalesData.Where(IsOtherFertilizerCreditLimitSalesRow);
	if (financialYearId.HasValue && financialYearId.Value > 0)
		query = query.Where(r => r.FinancialYearId == financialYearId.Value);

	return query.Sum(r => r.Quantity);
}

private decimal CalculateOtherFertilizerSalesTurnover(int? financialYearId = null)
{
	var query = _greenstarDefaultSalesData.Where(IsOtherFertilizerCreditLimitSalesRow);
	if (financialYearId.HasValue && financialYearId.Value > 0)
		query = query.Where(r => r.FinancialYearId == financialYearId.Value);

	var grossAmount = query.Sum(r => r.GrossAmount);
	return ConvertToLakhs(grossAmount);
}

private decimal CalculateSpecialitySalesTurnover()
{
    var grossAmount = _greenstarDefaultSalesData
        .Where(IsSpecialityCreditLimitSalesRow)
        .Sum(r => r.GrossAmount);

    return ConvertToLakhs(grossAmount);
}
private void ComputeSpecialtyCardTotals()
{
    SpecialtyMtQty = SpecialtyMtAmount = SpecialtyLtrQty = SpecialtyLtrAmount = 0;

    var fyId = _proposal.FY3;   // latest completed FY (e.g. 2025-2026)
    if (fyId <= 0)
        return;

    foreach (var row in _greenstarDefaultSalesData.Where(r => r.FinancialYearId == fyId))
    {
        var category = _categories.FirstOrDefault(c => c.Id == row.ProductGroupId);
        if (category?.Name == null || !IsSpecialityCategory(category))
            continue;

        var amountLakhs = ConvertToLakhs(row.GrossAmount);

        if (category.Name.Contains("MT", StringComparison.OrdinalIgnoreCase))
        {
            SpecialtyMtQty += row.Quantity;
            SpecialtyMtAmount += amountLakhs;
        }
        else if (category.Name.Contains("Ltr", StringComparison.OrdinalIgnoreCase)
              || category.Name.Contains("Liq", StringComparison.OrdinalIgnoreCase))
        {
            SpecialtyLtrQty += row.Quantity;
            SpecialtyLtrAmount += amountLakhs;
        }
    }
}
	// --- Main Method to Load All GreenStar Valuation Default Values ---
	private async Task LoadGreenstarValuationDefaultValues()
{
    try
    {
        await LoadAnnualSalesDataAsync();
        await LoadGreenstarDefaultSalesPerformanceData();
		ComputeSpecialtyCardTotals();

        // Row 1: AnnualSales Other Fertilizer Qty (use selected FY3 by default)
		var otherFertAnnualQty = CalculateOtherFertilizerAnnualQty();
        if (otherFertAnnualQty > 0 && !_greenstarValueEntered[0])
        {
            _greenstarValues[0] = (double)otherFertAnnualQty;
            _greenstarValueEntered[0] = true;
        }

        // Row 2: SalesPerformance Other Fertilizer Qty
        // Use FY3 (right-most FY) to match UI column selection — change to FY1/FY2 if needed
		var fyForDefaults = _proposal.FY3 > 0 ? _proposal.FY3 : GetCompletedFYIds().FirstOrDefault();
		var otherFertSalesQty = CalculateOtherFertilizerSalesQty(fyForDefaults);
        if (otherFertSalesQty > 0 && !_greenstarValueEntered[1])
        {
            _greenstarValues[1] = (double)otherFertSalesQty;
            _greenstarValueEntered[1] = true;
        }

        // Row 3: AnnualSales Other Fertilizer Turnover in Lakhs
        var otherFertAnnualTurnover = CalculateOtherFertilizerAnnualTurnover();
        if (otherFertAnnualTurnover > 0 && !_greenstarValueEntered[2])
        {
            _greenstarValues[2] = (double)otherFertAnnualTurnover;
            _greenstarValueEntered[2] = true;
        }

        // Row 4: SalesPerformance Other Fertilizer Turnover in Lakhs (use same FY as row 2)
		var otherFertSalesTurnover = CalculateOtherFertilizerSalesTurnover(fyForDefaults);
        if (otherFertSalesTurnover > 0 && !_greenstarValueEntered[3])
        {
            _greenstarValues[3] = (double)otherFertSalesTurnover;
            _greenstarValueEntered[3] = true;
        }

       // Row 5: Total Specialty Product Turnover in Lakhs
// Load total Specialty Product amount from latest completed FY into 5th row
var totalSpecialtyProductTurnover = SpecialtyMtAmount + SpecialtyLtrAmount;

if (totalSpecialtyProductTurnover > 0 && !_greenstarValueEntered[4])
{
    _greenstarValues[4] = (double)totalSpecialtyProductTurnover;
    _greenstarValueEntered[4] = true;
}

     // Row 6: Dealership tenure with GFL - year.month format
var dealerTenure = GetDealerTenureYearMonthValue();

if (dealerTenure > 0 && !_greenstarValueEntered[5])
{
    _greenstarValues[5] = dealerTenure;
    _greenstarValueEntered[5] = true;
}
        // Row 7: Manual only
        // Do not auto-feed _greenstarValues[6]

        // Row 8: Fixed Assets = LandTotal + BuildingTotal
        var fixedAssets = LandTotal + BuildingTotal;
        if (fixedAssets > 0 && !_greenstarValueEntered[7])
        {
            _greenstarValues[7] = (double)fixedAssets;
            _greenstarValueEntered[7] = true;
        }

        // Row 9: Auto calculation only
        // Do not directly set _greenstarValues[8]

        // Row 10: GreenStar Securities total
        var securityTotal =
            _proposal.GreenstarFDAmount +
            _proposal.GreenstarBGAmount +
            _proposal.GreenstarCollateralAmount +
            _proposal.GreenstarTradeDepositAmount;

        if (securityTotal > 0 && !_greenstarValueEntered[9])
        {
            _greenstarValues[9] = (double)securityTotal;
            _greenstarValueEntered[9] = true;
        }

        // Row 11: Auto calculation only
        // Do not directly set _greenstarValues[10]

        RecalculateGreenstarPercentages();
    }
    catch (Exception ex)
    {
        System.Diagnostics.Debug.WriteLine($"Error loading GreenStar valuation defaults: {ex.Message}");
    }
}

