	private void RecalculateGreenstarPercentages()
	{
		var denominator = _greenstarValues[3] + _greenstarValues[4];
		if (denominator > 0)
		{
			_greenstarValues[8] = (_greenstarValues[7] / denominator) * 100;
			_greenstarValues[10] = (_greenstarValues[9] / denominator) * 100;
		}
		else
		{
			_greenstarValues[8] = 0;
			_greenstarValues[10] = 0;
		}
	}

	// --- Category Tab ---
private async Task SelectCategory(int categoryId)
{
	_selectedCategoryId = categoryId;
	UpdateSelectedUnit();
	await LoadCreditLimitSalesData();
}
private async Task LoadCreditLimitSalesData()
	{
		if (_dealer.Id <= 0 || _selectedCategoryId <= 0)
		{
			_creditLimitSalesData = new();
			BuildSalesPerfRows();
			return;
		}

		var fyIds = GetCompletedFYIds();

		if (fyIds.Count == 0)
		{
			_creditLimitSalesData = new();
			BuildSalesPerfRows();
			return;
		}

		var fyQuery = string.Join(",", fyIds);

		var url = $"api/creditlimitsales/by-filter" +
				  $"?customerId={_dealer.Id}" +
				  $"&categoryId={_selectedCategoryId}" +
				  $"&financialYearIds={fyQuery}";

		_creditLimitSalesData = await SafeGetAsync<List<DealerCreditLimitSales>>(url) ?? new();

		BuildSalesPerfRows();
	}
private DealerCreditLimitSales? GetCreditLimitSales(int productId, int financialYearId)
{
	if (financialYearId <= 0)
		return null;

	return _creditLimitSalesData.FirstOrDefault(x =>
		x.CustomerId == _dealer.Id &&
		x.ProductGroupId == _selectedCategoryId &&
		x.SubGroupId == productId &&
		x.FinancialYearId == financialYearId);
}

private static decimal ConvertToLakhs(decimal grossAmount)
{
	return (decimal)grossAmount / 100000;
}
	private void UpdateSelectedUnit()
	{
		var cat = _categories.FirstOrDefault(c => c.Id == _selectedCategoryId);
		if (cat != null)
			_selectedUnitName = _units.FirstOrDefault(u => u.Id == cat.UnitId)?.Name ?? "MT";
	}

	private void BuildSalesPerfRows()
{
	_salesPerfViewRows = new();

	var categoryProducts = _products
		.Where(p => p.CategoryId == _selectedCategoryId)
		.ToList();

	foreach (var product in categoryProducts)
	{
		var row = new SalesPerfViewRow
		{
			ProductId = product.Id,
			ProductName = product.Name
		};

		var fy1Data = GetCreditLimitSales(product.Id, _proposal.FY1);
		var fy2Data = GetCreditLimitSales(product.Id, _proposal.FY2);
		var fy3Data = GetCreditLimitSales(product.Id, _proposal.FY3);

		if (fy1Data != null)
		{
			row.FY1Qty = fy1Data.Quantity;
			row.FY1Amount = ConvertToLakhs(fy1Data.GrossAmount);
		}

		if (fy2Data != null)
		{
			row.FY2Qty = fy2Data.Quantity;
			row.FY2Amount = ConvertToLakhs(fy2Data.GrossAmount);
		}

		if (fy3Data != null)
		{
			row.FY3Qty = fy3Data.Quantity;
			row.FY3Amount = ConvertToLakhs(fy3Data.GrossAmount);
		}

		_salesPerfViewRows.Add(row);
	}
}

