	private static double CalculateGreenstarMark(int idx, double v) => idx switch
	{
		0 => v > 3000 ? 10 : v > 1500 ? 8 : v > 1000 ? 6 : v > 500 ? 4 : 2,
		1 => v > 500 ? 10 : v > 350 ? 8 : v > 250 ? 6 : v > 150 ? 4 : 2,
		2 => v > 700 ? 10 : v > 350 ? 8 : v > 250 ? 6 : v > 125 ? 4 : 2,
		3 => v > 125 ? 10 : v > 80 ? 8 : v > 60 ? 6 : v > 35 ? 4 : 2,
		4 => v > 100 ? 10 : v > 50 ? 8 : v > 25 ? 6 : v > 10 ? 4 : 2,
		5 => v > 10 ? 10 : v > 8 ? 8 : v > 6 ? 6 : v > 4 ? 4 : 2,
		6 => v < 1 ? 20 : v < 5 ? 16 : v < 10 ? 12 : v < 20 ? 8 : 4,
		7 => 0,
		8 => v > 50 ? 10 : v > 40 ? 8 : v > 30 ? 6 : v > 20 ? 4 : v > 10 ? 2 : 0,
		9 => 0,
		10 => v > 10 ? 10 : v > 8 ? 8 : v > 6 ? 6 : v > 4 ? 4 : 2,
		_ => 0
	};

	private double GetGreenstarMark(int idx)
	{
		if (idx == 8 || idx == 10)
		{
			bool depEntered = idx == 8
				? _greenstarValueEntered[7] && _greenstarValueEntered[3] && _greenstarValueEntered[4]
				: _greenstarValueEntered[9] && _greenstarValueEntered[3] && _greenstarValueEntered[4];
			return !depEntered ? 0 : CalculateGreenstarMark(idx, _greenstarValues[idx]);
		}
		return !_greenstarValueEntered[idx] ? 0 : CalculateGreenstarMark(idx, _greenstarValues[idx]);
	}

