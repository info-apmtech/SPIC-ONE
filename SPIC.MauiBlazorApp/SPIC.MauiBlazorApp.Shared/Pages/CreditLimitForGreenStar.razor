					<label class="form-label">Credit Limit Amount (₹) In Lakhs</label>
					<input type="number" class="form-control-custom w-100" step="0.01"
					@bind="_proposal.GSExistingCreditLimitAmount" />
				</div>
				<div class="col-md-4">
					<label class="form-label">Valid From</label>
					<input type="date" class="form-control-custom w-100"
					@bind="_proposal.GSExistingCreditLimitFrom" />
				</div>
				<div class="col-md-4">
					<label class="form-label">Valid To</label>
					<input type="date" class="form-control-custom w-100"
					@bind="_proposal.GSExistingCreditLimitTo" />
				</div>
			</div>
