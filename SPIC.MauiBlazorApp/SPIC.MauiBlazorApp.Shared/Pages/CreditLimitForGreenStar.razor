@using SPIC.Core.Entities
@using DealerReg = SPIC.Core.Entities.DealerRegistration
@using SPIC.MauiBlazorApp.Shared.FormFlow
@inject HttpClient Http
@inject NavigationManager Nav
@inject LoadingService Loading
<style>
	.table-wrapper {
		width: 100%;
		max-width: 100%;
		overflow: hidden;
	}
	
	.table-responsive {
		/*max-height: 500px; /* vertical inline scroller */
		/* Keep vertical scrolling but prevent horizontal scrolling */
		overflow-y: auto;
		overflow-x: hidden;
		width: 100%;
		border: 1px solid #E5E7EB;
		border-radius: 12px;
	}
	.table-responsive-for-review {
		max-height: 500px; /* vertical inline scroller */
		/* Keep vertical scrolling but prevent horizontal scrolling */
		overflow-y: auto;
		overflow-x: hidden;
		width: 100%;
		border: 1px solid #E5E7EB;
		border-radius: 12px;
	}

	/* Prevent table from squeezing too much */
	.spic-table {
		width: 100%;
		min-width: 0; /* allow table to shrink to container width */
		/* Use fixed layout so columns respect provided widths and avoid forcing horizontal scroll */
		table-layout: fixed;
		border-collapse: separate;
		border-spacing: 0;
	}

		/* Allow table cells to wrap long content instead of expanding horizontally */
		.spic-table th,
		.spic-table td {
			white-space: normal;
			word-break: break-word;
		}

		/* Sticky header */
		.spic-table thead th {
			position: sticky;
			top: 0;
			z-index: 5;
			background: #F9FAFB;
		}

		/* For tables with 2 header rows */
		.spic-table thead tr:nth-child(2) th {
			top: 42px; /* adjust if your first header row height differs */
			z-index: 6;
		}

		/* Keep footer visible style clean, not sticky */
		.spic-table tfoot td {
			background: #F9FAFB;
		}

		/* Tweak font-sizes for better density and legibility */
		.spic-table th {
			font-size: 13px;
			padding: 10px 8px;
		}

		.spic-table td {
			font-size: 13px;
			padding: 12px 8px;
		}

	/* Controls that show calculated values */
	.table-val-box {
		font-size: 14px;
		padding: 8px 10px;
		border-radius: 8px;
		background: #F3F4F6;
	}

	/* Better scrollbar behavior on mobile */
	.table-responsive::-webkit-scrollbar {
		height: 8px;
		width: 8px;
	}

	.table-responsive::-webkit-scrollbar-thumb {
		background: #CBD5E1;
		border-radius: 999px;
	}

	.spic-table tfoot td {
		background: #F9FAFB;
		border-top: 2px solid #E5E7EB;
		font-weight: 700;
		position: sticky;
		bottom: 0;
		z-index: 4;
	}

		/* Make the Grand Total cell wider and more prominent */
		.spic-table tfoot td:last-child {
			width: 100px; /* increased width as requested */
			text-align: center;
		}

			.spic-table tfoot td:last-child strong {
				font-size: 16px;
				color: #0f172a;
			}
</style>
@if (!_isCheckingGreenStar)
{
