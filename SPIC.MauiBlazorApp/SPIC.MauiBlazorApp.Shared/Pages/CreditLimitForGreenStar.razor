	private void SetFixedFinancialYears()
	{
		// Only completed financial years (EndDate in the past)
		var completedYears = _financialYears
			.Where(fy => fy.EndDate <= DateTime.Today)
			.OrderByDescending(fy => fy.EndDate)
			.Take(3)
			.OrderBy(fy => fy.EndDate)  // oldest → newest left to right
			.ToList();

		_proposal.FY1 = completedYears.Count > 0 ? completedYears[0].Id : 0;
		_proposal.FY2 = completedYears.Count > 1 ? completedYears[1].Id : 0;
		_proposal.FY3 = completedYears.Count > 2 ? completedYears[2].Id : 0;
	}
private async Task<bool> HasGreenStarCompany()
