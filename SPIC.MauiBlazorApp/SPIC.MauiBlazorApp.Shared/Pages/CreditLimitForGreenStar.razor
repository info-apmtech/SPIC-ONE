    {
        return await Http.GetFromJsonAsync<bool>(
            $"api/DealerCompaniesOperatingInArea/dealer/{DealerId.Value}/has-greenstar");
    }
    catch
    {
        return false;
    }
}
private async Task LoadGreenstarDefaultSalesPerformanceData()
{
    _greenstarDefaultSalesData = new();

    if (_dealer.Id <= 0)
        return;

    var fyIds = new[]
    {
        _proposal.FY1,
        _proposal.FY2,
        _proposal.FY3
    }
    .Where(x => x > 0)
    .Distinct()
    .ToList();

    if (fyIds.Count == 0)
        return;

    var categoryIds = _categories
        .Where(c => IsFertilizerCategory(c) || IsSpecialityCategory(c))
        .Select(c => c.Id)
        .Distinct()
        .ToList();

    var fyQuery = string.Join(",", fyIds);

    foreach (var categoryId in categoryIds)
    {
        var url =
            $"api/creditlimitsales/by-filter" +
            $"?customerId={_dealer.Id}" +
            $"&categoryId={categoryId}" +
            $"&financialYearIds={fyQuery}";

        var rows = await SafeGetAsync<List<DealerCreditLimitSales>>(url) ?? new();

        _greenstarDefaultSalesData.AddRange(rows);
    }
}
private List<int> GetCompletedFYIds()
	{
		return _financialYears
			.Where(fy => fy.EndDate <= DateTime.Today)
			.OrderByDescending(fy => fy.EndDate)
			.Take(3)
			.Select(fy => fy.Id)
			.ToList();
	}
	private double GetDealerTenureYearMonthValue()
{
    if (_dealer.DateOfAppointment == default || _dealer.DateOfAppointment > DateTime.Now)
        return 0;

    var today = DateTime.Now;
    var appointmentDate = _dealer.DateOfAppointment;

    var years = today.Year - appointmentDate.Year;
    var months = today.Month - appointmentDate.Month;
    var days = today.Day - appointmentDate.Day;

    if (days < 0)
    {
        months--;
    }

    if (months < 0)
    {
        years--;
        months += 12;
    }

    if (years < 0)
        return 0;

    return double.Parse($"{years}.{months}");
}
