	protected override async Task OnInitializedAsync()
{
    // Show page only when a valid dealer is provided and the dealer has InGreenStar == true
	_isCheckingGreenStar = true;

	if (!DealerId.HasValue || DealerId.Value <= 0)
	{
		Nav.NavigateTo($"/Enclosures?dealerId={DealerId}", replace: true);
		return;
	}

	Loading.Show();
	try
	{
		// Fetch dealer first and verify InGreenStar flag
		_dealer = await SafeGetAsync<DealerReg>($"api/DealerRegistration/{DealerId.Value}") ?? new DealerReg();

		if (!_dealer.InGreenStar)
		{
			Nav.NavigateTo($"/Enclosures?dealerId={DealerId}", replace: true);
			return;
		}

		_isCheckingGreenStar = false;
		SelectedCompany = "GreenStar";

		var fyTask = SafeGetAsync<List<FinancialYear>>("api/FinancialYear");
		var catTask = SafeGetAsync<List<Category>>("api/Category");
		var unitTask = SafeGetAsync<List<Unit>>("api/Unit");
		var prodTask = SafeGetAsync<List<Product>>("api/Product");

		// Dealer already fetched above; fetch other related collections in parallel
		var bankTask = SafeGetAsync<List<DealerAssetBank>>("api/DealerAssetBank/all");
		var landTask = SafeGetAsync<List<DealerAssetLand>>("api/DealerAssetLand/all");
		var buildingTask = SafeGetAsync<List<DealerAssetBuilding>>("api/DealerAssetBuilding/all");
		var loanTask = SafeGetAsync<List<DealerLoanLiabilities>>("api/DealerLoanLiabilities/all");
		var salesPlanTask = SafeGetAsync<List<SalesPlanningInDealerRegistration>>("api/SalesPlanning/all");
		var proposalTask = SafeGetAsync<List<DealerCreditLimitProposal>>("api/DealerCreditLimitProposal/all");

		await Task.WhenAll(
			fyTask, catTask, unitTask, prodTask,
			bankTask, landTask, buildingTask,
			loanTask, salesPlanTask, proposalTask
		);

		_financialYears = fyTask.Result ?? new();
		_categories = catTask.Result ?? new();
		_units = unitTask.Result ?? new();
		_products = prodTask.Result ?? new();

		var dealerId = DealerId.Value;

		_bankAssets = (bankTask.Result ?? new())
			.Where(a => a.DealerId == dealerId)
			.ToList();

		_landAssets = (landTask.Result ?? new())
			.Where(a => a.DealerId == dealerId)
			.ToList();

		_buildingAssets = (buildingTask.Result ?? new())
			.Where(a => a.DealerId == dealerId)
			.ToList();

		_loanLiabilities = (loanTask.Result ?? new())
			.Where(a => a.DealerId == dealerId)
			.ToList();

		_salesPlanData = (salesPlanTask.Result ?? new())
			.Where(s => s.DealerId == dealerId)
			.ToList();

		var proposals = proposalTask.Result ?? new();

		var existing = proposals.FirstOrDefault(p => p.DealerId == dealerId);

		if (existing != null)
			_proposal = existing;

		InitValuesFromData();

		if (_categories.Count > 0)
		{
			_selectedCategoryId = GetDefaultGreenstarCategoryId();
			UpdateSelectedUnit();
		}

		SetFixedFinancialYears();
		await LoadCreditLimitSalesData();

		// Load GreenStar Valuation default values after all data is loaded
		if (DealerId.HasValue && DealerId.Value > 0)
		{
			await LoadGreenstarValuationDefaultValues();
		}
	}
	finally
	{
		Loading.Hide();
	}
}
	
private int GetDefaultGreenstarCategoryId()
{
    var fertilizerCategory = _categories.FirstOrDefault(c =>
        !string.IsNullOrWhiteSpace(c.Name) &&
        c.Name.Contains("Fertilizer", StringComparison.OrdinalIgnoreCase));

    return fertilizerCategory?.Id ?? _categories.FirstOrDefault()?.Id ?? 0;
}
	private async Task<T?> SafeGetAsync<T>(string url)
	{
		try { return await Http.GetFromJsonAsync<T>(url); }
		catch { return default; }
	}

	private void InitValuesFromData()
	{
		// All values start at 0 — marks show 0 until user enters a value
		//RecalculateSpicPercentages();
		RecalculateGreenstarPercentages();
	}

