@page "/PublicityRequest/new"
@page "/PublicityRequest/edit/{Id:int}"
@page "/PublicityReview/edit/{Id:int}"
@using SPIC.Core.DTOs
@using SPIC.Core.Entities
@using SPIC.MauiBlazorApp.Shared.Components.Publicity
@inject PublicityApi Api
@inject NavigationManager Nav
@inject ToastService Toast
@inject IJSRuntime JS
@implements IDisposable

@* Create / edit a request (RMDO). Draft keeps it private; Submit sends it to RM review.
   /PublicityReview/edit/{id}: the approver whose turn it is edits every field ("Edit Publicity
   Material Request"); the request stays on its stage and the changes land in the history.

   The Publicity Material/Gift Articles and Specific/General Product segmented TOGGLES only apply
   to brand-new requests (Id is null) - editing an existing request never shows them (its category
   is already fixed). The multi-item Request Items TABLE, however, is shared between create
   (ShowBulk) and edit (ShowItemsEditor): a "Specific Product" Excel import creates ONE parent
   PublicityRequest with N PublicityRequestItem children (CreateBulk), and editing that same
   request (ShowItemsEditor := Id is not null && _detail.Items.Count > 0) reuses the identical
   table/Select-All/Apply-Design-to-Selected markup and row state (_bulkRows), just populated from
   the saved items instead of an Excel file, and saved via UpdateItemsAsync instead of
   CreateBulkAsync. A General Product / Gift Articles request never has Items, so it always falls
   through to the single-item form below unaffected. *@

<div class="pub-page">
    <PageHeader Title="@(Id is null ? "Create Publicity Material Request" : Approver ? "Edit Publicity Material Request" : $"Edit Request {_indent}")"
                Subtitle="@(Approver ? "Update the publicity material details. The changes are saved and reflected in the approval workflow" : "Enter the publicity material requirement and submit it for approval")">
        <Actions><a class="pub-btn pub-btn--line" href="@Back"><i class="bi bi-arrow-left"></i> Back to My Request</a></Actions>
    </PageHeader>
    @if (_detail is not null && Approver) { <PubHeader D="_detail" /> }

    @if (_lookups is null)
    {
        <Skeleton Rows="8" />
    }
    else
    {
        @if (Id is null)
        {
            <div class="pub-segment-row" data-help="pub-mode">
                <div class="pub-segment">
                    <button type="button" class="pub-segment__btn @(_mainMode == MainMode.PublicityMaterial ? "is-selected" : "")" @onclick="() => SetMainMode(MainMode.PublicityMaterial)">Publicity Material</button>
                    <button type="button" class="pub-segment__btn @(_mainMode == MainMode.GiftArticles ? "is-selected" : "")" @onclick="() => SetMainMode(MainMode.GiftArticles)">Gift Articles</button>
                </div>
                @if (_mainMode == MainMode.PublicityMaterial)
                {
                    <span class="pub-segment-row__divider"></span>
                    <div class="pub-segment">
                        <button type="button" class="pub-segment__btn @(_productMode == ProductMode.Specific ? "is-selected" : "")" @onclick="() => SetProductMode(ProductMode.Specific)">
                            <i class="bi @(_productMode == ProductMode.Specific ? "bi-record-circle" : "bi-circle")"></i> Specific Product</button>
                        <button type="button" class="pub-segment__btn @(_productMode == ProductMode.General ? "is-selected" : "")" @onclick="() => SetProductMode(ProductMode.General)">
                            <i class="bi @(_productMode == ProductMode.General ? "bi-record-circle" : "bi-circle")"></i> General Product</button>
                    </div>
                }
            </div>
        }

        @if (ShowBulk || ShowItemsEditor)
        {
            <section class="pub-card">
                <h2 class="pub-h2">Request Details</h2>
                <p class="pub-muted">Provide the publicity material, requested by and location details</p>
                <div class="pub-form pub-form--5">
                    <div class="pub-field">
                        <label class="pub-label pub-req" for="prb-mat">Type of Publicity Material</label>
                        <select id="prb-mat" class="pub-input" @bind="_dto.MaterialTypeId"><option value="0">Select Material</option>
                            @foreach (var m in VisibleMaterials) { <option value="@m.Id">@m.Name</option> }</select>
                    </div>
                    <div class="pub-field">
                        <label class="pub-label pub-req" for="prb-by">Requested By</label>
                        <select id="prb-by" class="pub-input" @onchange="e => OnNativeSelect(e, OnRequestedByChanged)">
                            @foreach (var p in _lookups.People) { <option value="@p.UserId" selected="@(_dto.RequestedByUserId == p.UserId)">@p.Name @(p.Role is null ? "" : $"({p.Role})")</option> }
                        </select>
                    </div>
                    <div class="pub-field">
                        <label class="pub-label pub-req" for="prb-state">State</label>
                        <select id="prb-state" class="pub-input" value="@_dto.StateId" @onchange="StateChanged"><option value="0">Select State</option>
                            @foreach (var s in _states) { <option value="@s.Id">@s.Name</option> }</select>
                    </div>
                    <div class="pub-field">
                        <label class="pub-label pub-req" for="prb-region">Region</label>
                        <select id="prb-region" class="pub-input" value="@_dto.RegionId" @onchange="RegionChanged"><option value="0">Select Region</option>
                            @foreach (var s in _regions) { <option value="@s.Id">@s.Name</option> }</select>
                    </div>
                    <div class="pub-field">
                        <label class="pub-label pub-req" for="prb-hq">Headquarter (HQ)</label>
                        <select id="prb-hq" class="pub-input" @bind="_dto.HeadquarterId"><option value="0">Select Headquarter</option>
                            @foreach (var s in _hqs) { <option value="@s.Id">@s.Name</option> }</select>
                    </div>
                </div>

                <div class="pub-upload-box">
                    <div class="pub-upload-box__icon"><i class="bi bi-file-earmark-excel" aria-hidden="true"></i></div>
                    <div class="pub-upload-box__text">
                        <span class="pub-upload-box__title">Upload Request Details via Excel</span>
                        <span class="pub-muted">Upload an Excel file with product, quantity, requested by and design details.</span>
                    </div>
                    <div class="pub-upload-box__action">
                        <label class="pub-btn pub-btn--primary" style="cursor:pointer">
                            @(_importing ? "Importing..." : "Choose Excel File")
                            <InputFile OnChange="OnExcelPicked" accept=".xlsx,.xls" style="display:none" disabled="@_importing" />
                        </label>
                        @if (_excelFileName is not null) { <span class="pub-muted pub-upload-box__hint">@_excelFileName</span> }
                    </div>
                </div>
            </section>

            <section class="pub-card">
                <div class="pub-card__head">
                    <div>
                        <h2 class="pub-h2">Request Items (@_bulkRows.Count)</h2>
                        <p class="pub-muted">Review the imported details, edit if needed, update design and then submit the request.</p>
                    </div>
                    <div class="pub-actions-right">
                        <label class="pub-btn pub-btn--line" style="cursor:pointer">
                            <i class="bi bi-upload"></i> Apply Design to Selected (@SelectedCount)
                            <InputFile OnChange="ApplyDesignToSelected" style="display:none" disabled="@(SelectedCount == 0)" />
                        </label>
                        <button type="button" class="pub-btn pub-btn--line" @onclick="AddRow"><i class="bi bi-plus-circle"></i> Add New</button>
                    </div>
                </div>

                @if (_bulkRows.Count == 0)
                {
                    <EmptyState Icon="bi-upload" Title="No items yet" Message="Upload an Excel file or add a row manually to get started." Compact="true" />
                }
                else
                {
                    @* The table's own thead (and the Select All checkbox inside it) is hidden on
                       phone by the shared "tables become cards" rule (.pub-table thead), so this
                       gives phone the same Select All affordance via .pub-show-sm instead of
                       reintroducing the whole column-header row there. *@
                    <label class="pub-show-sm pub-muted" style="margin-bottom:8px;">
                        <input type="checkbox" checked="@AllRowsSelected" @onchange="ToggleSelectAll" aria-label="Select all rows" /> Select All
                    </label>
                    <div class="pub-table-wrap">
                        <table class="pub-table">
                            <thead><tr>
                                <th><input type="checkbox" @ref="_selectAllCheckboxRef" checked="@AllRowsSelected" @onchange="ToggleSelectAll" aria-label="Select all rows" /></th><th>S.No</th><th>Product</th><th>Quantity</th><th>Design Document</th><th>Action</th>
                            </tr></thead>
                            <tbody>
                                @for (var i = 0; i < _bulkRows.Count; i++)
                                {
                                    var row = _bulkRows[i];
                                    var idx = i;
                                    <tr>
                                        <td><input type="checkbox" checked="@row.Selected" @onchange="e => row.Selected = e.Value is bool b && b" /></td>
                                        <td data-label="S.No">@(idx + 1)</td>
                                        <td data-label="Product">
                                            <select class="pub-input" value="@row.ProductId" @onchange="e => OnRowProductChanged(row, e)">
                                                <option value="0">Select Product</option>
                                                @foreach (var p in _lookups.Products) { <option value="@p.Id" selected="@(row.ProductId == p.Id)">@p.Name</option> }
                                            </select>
                                            @if (row.Error is not null) { <small class="pub-text-red">@row.Error</small> }
                                        </td>
                                        <td data-label="Quantity"><input type="number" min="0" class="pub-input pub-input--sm" @bind="row.Quantity" @bind:event="oninput" /></td>
                                        <td data-label="Design Document">
                                            @if (row.File is not null)
                                            {
                                                <span class="pub-doc__meta">@row.File.Name <button type="button" class="pub-icon-btn" @onclick="() => row.File = null"><i class="bi bi-x-lg"></i></button></span>
                                            }
                                            else if (row.ExistingFileName is not null)
                                            {
                                                <span class="pub-doc__meta">
                                                    @row.ExistingFileName
                                                    <a class="pub-icon-btn" href="@Api.FileUrl(row.ExistingFilePath)" target="_blank" aria-label="View @row.ExistingFileName" title="View"><i class="bi bi-eye"></i></a>
                                                    <a class="pub-icon-btn" href="@Api.FileUrl(row.ExistingFilePath, download: true)" aria-label="Download @row.ExistingFileName" title="Download"><i class="bi bi-download"></i></a>
                                                </span>
                                                <label class="pub-link-btn" style="cursor:pointer">
                                                    Replace
                                                    <InputFile OnChange="e => OnRowFilePicked(row, e)" style="display:none" />
                                                </label>
                                            }
                                            else
                                            {
                                                <label class="pub-link-btn" style="cursor:pointer">
                                                    <i class="bi bi-upload"></i> Upload Design
                                                    <InputFile OnChange="e => OnRowFilePicked(row, e)" style="display:none" />
                                                </label>
                                            }
                                        </td>
                                        <td data-label="Action"><button type="button" class="pub-icon-btn" @onclick="() => RemoveRowAsync(row)" aria-label="Remove row"><i class="bi bi-trash pub-text-red"></i></button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <div class="pub-field">
                    <label class="pub-label" for="prb-rem">Remarks</label>
                    <textarea id="prb-rem" class="pub-input pub-textarea pub-textarea--sm" rows="2" placeholder="Need to add your remarks" @bind="_dto.Remarks"></textarea>
                </div>
            </section>
        }
        else
        {
            <section class="pub-card">
                <h2 class="pub-h2">Request Details</h2>
                <p class="pub-muted">Provide the @(GiftMode ? "gift article" : "publicity material"), product, quantity and supporting file details</p>
                <div class="pub-form pub-form--4">
                    <div class="pub-field" data-help="pub-material">
                        <label class="pub-label pub-req" for="pr-mat">@(GiftMode ? "Type of Gift Article" : "Type of Publicity Material")</label>
                        <select id="pr-mat" class="pub-input" @bind="_dto.MaterialTypeId"><option value="0">Select Material</option>
                            @foreach (var m in VisibleMaterials) { <option value="@m.Id">@m.Name</option> }</select>
                    </div>
                    <div class="pub-field">
                        <label class="pub-label pub-req" for="pr-prod">@(GiftMode ? "Product / Article" : "Product")</label>
                        <select id="pr-prod" class="pub-input" @onchange="e => OnNativeSelect(e, OnProductChanged)">
                            <option value="0">Select Product</option>
                            @foreach (var p in _lookups.Products) { <option value="@p.Id" selected="@(_dto.ProductId == p.Id)">@p.Name</option> }
                        </select>
                    </div>
                    <div class="pub-field" data-help="pub-qty">
                        <label class="pub-label pub-req" for="pr-qty">Quantity</label>
                        <input id="pr-qty" class="pub-input" type="number" min="0" placeholder="Enter Required Quantity" @bind="_qty" />
                    </div>
                    <div class="pub-field">
                        <label class="pub-label pub-req" for="pr-by">Requested By</label>
                        <select id="pr-by" class="pub-input" @onchange="e => OnNativeSelect(e, OnRequestedByChanged)">
                            @foreach (var p in _lookups.People) { <option value="@p.UserId" selected="@(_dto.RequestedByUserId == p.UserId)">@p.Name @(p.Role is null ? "" : $"({p.Role})")</option> }
                        </select>
                    </div>
                </div>

                @if (_existing.Count > 0)
                {
                    <PubDocs Files="_existing" OnDelete="RemoveExisting" />
                }
                <div data-help="pub-design">
                    <PubDrop @bind-Files="_files" Multiple="false" Compact="true" Title="Upload Design (Optional)" Subtitle="@(GiftMode ? "Attach the article design if available" : "Attach the material design if available")" />
                </div>

                <div class="pub-field">
                    <label class="pub-label" for="pr-rem">Remarks</label>
                    <textarea id="pr-rem" class="pub-input pub-textarea pub-textarea--sm" rows="2" placeholder="Need to add your remarks" @bind="_dto.Remarks"></textarea>
                </div>
            </section>

            <section class="pub-card" data-help="pub-location">
                <h2 class="pub-h2">Location</h2>
                <p class="pub-muted">Select the state, region and headquarters where the material is required.</p>
                <div class="pub-form pub-form--3">
                    <div class="pub-field">
                        <label class="pub-label pub-req" for="pr-state">State</label>
                        <select id="pr-state" class="pub-input" value="@_dto.StateId" @onchange="StateChanged"><option value="0">Select State</option>
                            @foreach (var s in _states) { <option value="@s.Id">@s.Name</option> }</select>
                    </div>
                    <div class="pub-field">
                        <label class="pub-label pub-req" for="pr-region">Region</label>
                        <select id="pr-region" class="pub-input" value="@_dto.RegionId" @onchange="RegionChanged"><option value="0">Select Region</option>
                            @foreach (var s in _regions) { <option value="@s.Id">@s.Name</option> }</select>
                    </div>
                    <div class="pub-field">
                        <label class="pub-label pub-req" for="pr-hq">Headquarter (HQ)</label>
                        <select id="pr-hq" class="pub-input" @bind="_dto.HeadquarterId"><option value="0">Select Headquarter</option>
                            @foreach (var s in _hqs) { <option value="@s.Id">@s.Name</option> }</select>
                    </div>
                </div>
            </section>
        }

        <div class="pub-footer" data-help="pub-submit">
            <a class="pub-btn pub-btn--grey" href="@Back"><i class="bi bi-chevron-double-left"></i> Back to List</a>
            <span class="pub-footer__gap"></span>
            @if (!Approver)
            {
                <button type="button" class="pub-btn pub-btn--grey" disabled="@_busy" @onclick="() => SaveAsync(false)">Save as Draft</button>
            }
            <button type="button" class="pub-btn pub-btn--primary" disabled="@_busy" @onclick="() => SaveAsync(true)">
                @(Approver && _detail is not null ? (FromConsolidation ? "Save Changes" : $"Save & Forward to {PubText.Next(_detail.Stage)}") : Approver ? "Save & Forward" : "Submit Request") <i class="bi bi-chevron-double-right"></i>
            </button>
        </div>
    }
</div>

@code {
    [Parameter] public int? Id { get; set; }

    private bool Approver => Nav.ToBaseRelativePath(Nav.Uri).StartsWith("PublicityReview", StringComparison.OrdinalIgnoreCase);
    private bool FromConsolidation => Nav.Uri.Contains("back=consolidation");
    private string Back => !Approver ? "/PublicityRequest"
        : FromConsolidation ? "/PublicityReview/consolidation" : $"/PublicityReview/{Id}";
    private PubDetailDto? _detail;
    private PubLookupsDto? _lookups;
    private readonly PubUpsertDto _dto = new();
    private int? _qty;
    private string? _indent;
    private List<IBrowserFile> _files = new();
    private List<PubFileDto> _existing = new();
    private List<PubOption> _states = new(), _regions = new(), _hqs = new();
    private bool _busy;

    // ---- mode toggles (new-request only; Id is null) --------------------------------------
    private enum MainMode { PublicityMaterial, GiftArticles }
    private enum ProductMode { Specific, General }
    private MainMode _mainMode = MainMode.PublicityMaterial;
    private ProductMode _productMode = ProductMode.General;
    private bool GiftMode => Id is null && _mainMode == MainMode.GiftArticles;
    private bool ShowBulk => Id is null && _mainMode == MainMode.PublicityMaterial && _productMode == ProductMode.Specific;
    // Editing an existing Specific Product (multi-item) request - _detail.Items.Count > 0 is the one
    // authoritative signal for this (General Product/Gift Articles requests never have Items, since
    // only CreateBulk ever populates them). Shares ShowBulk's entire table/Select-All/Apply-Design
    // markup and _bulkRows state; only how the rows are loaded/saved differs (see OnParametersSetAsync
    // and SaveItemsEditAsync below).
    private bool ShowItemsEditor => Id is not null && _detail is { Items.Count: > 0 };

    // Publicity Material Master (2026-11-26): Specific Product only ever shows Category.Specific
    // materials; General Product and Gift Articles both show Category.General (Gift Articles has no
    // category of its own - it reuses the General Product-style manual-entry list, per the master
    // plan's "do not mix Gift Articles into the material type list unless the data model requires
    // it", and the data model does not). Editing an existing request (Id is not null) always shows
    // the full unfiltered list exactly as before - the Specific/General toggle only ever applies to
    // brand-new requests (see the big comment at the top of this file).
    // GiftMode forces General regardless of _productMode's current value - _productMode is only
    // ever shown/changed while _mainMode == PublicityMaterial (the Specific/General buttons are
    // hidden entirely in Gift Articles, see the segmented row above), so it can be left stale at
    // Specific from an earlier PublicityMaterial selection; without this guard, switching to Gift
    // Articles right after picking Specific Product would wrongly keep filtering to Specific.
    private PublicityMaterialCategory CurrentMaterialCategory =>
        !GiftMode && _productMode == ProductMode.Specific ? PublicityMaterialCategory.Specific : PublicityMaterialCategory.General;

    private IEnumerable<PubMaterialOption> VisibleMaterials => _lookups is null
        ? Enumerable.Empty<PubMaterialOption>()
        // Editing a multi-item request must stay Specific Product - the saved mode is never editable
        // into General (there would be nowhere for the other items to go).
        : ShowItemsEditor ? _lookups.Materials.Where(m => m.Category == PublicityMaterialCategory.Specific)
        : Id is not null ? _lookups.Materials : _lookups.Materials.Where(m => m.Category == CurrentMaterialCategory);

    // Switching to/from the bulk (Specific Product) view conditionally destroys and recreates the
    // #pr-prod/#pr-by <select> elements (Blazor @if, not just CSS hide/show) - Select2's own binding
    // on the OLD element is lost, so _select2Ready must be reset to force OnAfterRenderAsync to
    // re-initialize it against whichever new <select> actually exists once the manual form reappears.
    private void SetMainMode(MainMode mode)
    {
        if (_mainMode == mode) return;
        _mainMode = mode;
        _select2Ready = false;
        _dto.MaterialTypeId = 0;
    }

    private void SetProductMode(ProductMode mode)
    {
        if (_productMode == mode) return;
        _productMode = mode;
        _select2Ready = false;
        // VisibleMaterials just changed category (Specific <-> General) - a previously-picked
        // MaterialTypeId from the old category is no longer in the dropdown, and ValidateAsync
        // server-side only checks existence/active, not category, so a stale value could otherwise
        // slip through mismatched. Force a fresh pick.
        _dto.MaterialTypeId = 0;
    }

    // ---- "Specific Product" bulk Excel import ----------------------------------------------
    private sealed class BulkRowVm
    {
        // Edit mode only (ShowItemsEditor): the saved PublicityRequestItem.Id this row came from, so
        // SaveItemsEditAsync updates it in place instead of creating a duplicate. Null for a row that
        // doesn't exist on the server yet (AddRow, or any row from Excel import/create mode).
        public int? Id;
        public int ProductId;
        public int Quantity = 1;
        public IBrowserFile? File;
        public bool Selected;
        public string? Error;
        // Edit mode only: a design file already saved against this item (PubRequestItemDto). Picking a
        // new File doesn't delete it server-side - Upload just adds another PublicityFile row tagged
        // with the same requestItemId (see Upload's append-only design) - this field purely controls
        // what the cell shows locally before Save.
        public string? ExistingFileName;
        public string? ExistingFilePath;
    }
    private List<BulkRowVm> _bulkRows = new();
    private string? _excelFileName;
    private bool _importing;
    private int SelectedCount => _bulkRows.Count(r => r.Selected);

    // ---- Select All (Request Items table header checkbox) ---------------------------------
    // Dynamic by construction, not by any extra bookkeeping: AllRowsSelected/SelectedCount both
    // read _bulkRows live, so rows added (AddRow/Excel import) or removed (RemoveRow) automatically
    // fall in/out of "all selected" without any special-case reset code.
    private ElementReference _selectAllCheckboxRef;
    private bool AllRowsSelected => _bulkRows.Count > 0 && _bulkRows.All(r => r.Selected);

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        var select = e.Value is bool b && b;
        foreach (var row in _bulkRows) row.Selected = select;
    }

    // /PublicityRequest/new, /PublicityRequest/edit/{id} and /PublicityReview/edit/{id} all route
    // here (same component type), so the Blazor router reuses this instance across them instead of
    // recreating it - OnInitializedAsync only ever runs once per instance, so navigating from one
    // to another (e.g. editing a second request right after the first) would otherwise keep
    // showing/saving against the FIRST request's now-stale _detail (including it going null if the
    // very first load was the "new" route, which is exactly how a stray null _detail reaches the
    // Approver branch and throws). OnParametersSetAsync runs on every navigation, including the first.
    private string? _loadedPath;

    protected override async Task OnParametersSetAsync()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].TrimEnd('/');
        if (string.Equals(path, _loadedPath, StringComparison.OrdinalIgnoreCase)) return;
        _loadedPath = path;
        // Product/Requested By use Select2 (see OnAfterRenderAsync below) - once initialized, Select2
        // owns its own rendered display and stops noticing when this reused component instance later
        // renders the underlying <select> with a DIFFERENT selected option for a different request.
        // Flagging a re-sync here (consumed once, in OnAfterRenderAsync) is what actually fixes
        // "saved Product not showing" - the data was already correct, Select2's own display wasn't.
        _pendingSelect2Sync = true;

        _detail = null;
        _indent = null;
        _existing = new();
        _qty = null;
        _dto.MaterialTypeId = _dto.ProductId = 0;
        _dto.Remarks = null;
        _mainMode = MainMode.PublicityMaterial;
        _productMode = ProductMode.General;
        _bulkRows = new();
        _excelFileName = null;

        _lookups = await Api.LookupsAsync();
        _states = await Api.StatesAsync() ?? new();
        if (Id is int id)
        {
            var d = await Api.GetAsync(id);
            if (d is null) { Nav.NavigateTo(Api.Home, replace: true); return; }
            if (Approver ? !d.CanReview : !d.CanEdit) { Nav.NavigateTo($"{Api.Home}/{id}", replace: true); return; }
            _detail = d;
            // a state / region reviewer may not have the requester in their own people list
            if (_lookups is not null && d.RequestedByUserId is { } rb && _lookups.People.All(p => p.UserId != rb))
                _lookups.People.Insert(0, new PubPerson { UserId = rb, Name = d.RequestedByName ?? rb, Role = d.RequestedByRole });
            // Lookups only ever returns ACTIVE products (PublicityController.Lookups), so a saved
            // Product that's since gone inactive - or whose row is simply gone - would otherwise match
            // no <option> at all and silently render as "Select Product", indistinguishable from
            // nothing-ever-saved. d.Product already resolves the real name with no IsActive filter
            // (PublicityController.ProductMaterialPartsAsync), so reuse it here instead of guessing.
            if (_lookups is not null && d.ProductId > 0 && _lookups.Products.All(p => p.Id != d.ProductId))
                _lookups.Products.Insert(0, new PubOption
                {
                    Id = d.ProductId,
                    Name = string.IsNullOrWhiteSpace(d.Product) ? $"Product #{d.ProductId} (unavailable)" : $"{d.Product} (Inactive)"
                });
            // Same gap, same fix, for Material - Lookups only returns ACTIVE materials (so a request
            // can be edited after its material is deactivated via Publicity Material Master without
            // losing the saved value from the dropdown). Category doesn't matter here: edit mode's
            // VisibleMaterials above never filters by category, only create mode does.
            if (_lookups is not null && d.MaterialTypeId > 0 && _lookups.Materials.All(m => m.Id != d.MaterialTypeId))
                _lookups.Materials.Insert(0, new PubMaterialOption
                {
                    Id = d.MaterialTypeId,
                    Name = string.IsNullOrWhiteSpace(d.Material) ? $"Material #{d.MaterialTypeId} (unavailable)" : $"{d.Material} (Inactive)"
                });
            _indent = d.IndentNo;
            (_dto.MaterialTypeId, _dto.ProductId, _qty, _dto.RequestedByUserId, _dto.Remarks) = (d.MaterialTypeId, d.ProductId, d.Quantity, d.RequestedByUserId, d.Remarks);
            (_dto.StateId, _dto.RegionId, _dto.HeadquarterId) = (d.StateId, d.RegionId, d.HeadquarterId);
            _existing = d.Files.Where(f => f.Kind == PublicityFileKind.Design).ToList();
            // Specific Product (multi-item) request - populate _bulkRows from the saved items so
            // ShowItemsEditor's table (shared with ShowBulk) renders them, same as Excel import does
            // for a brand-new request. Empty for a General Product/Gift Articles request (d.Items is
            // always empty there), which just falls through to the single-item form below unaffected.
            _bulkRows = d.Items.Select(i => new BulkRowVm
            {
                Id = i.Id,
                ProductId = i.ProductId,
                Quantity = i.Quantity,
                ExistingFileName = i.DesignFileName,
                ExistingFilePath = i.DesignFilePath
            }).ToList();
        }
        else if (_lookups is not null)
        {
            _dto.RequestedByUserId = _lookups.MyUserId;
            (_dto.StateId, _dto.RegionId, _dto.HeadquarterId) = (_lookups.MyStateId, _lookups.MyRegionId, _lookups.MyHqId);
        }
        if (_dto.StateId > 0) _regions = await Api.RegionsAsync(_dto.StateId) ?? new();
        if (_dto.RegionId > 0) _hqs = await Api.HqsAsync(_dto.RegionId) ?? new();
    }

    // Product and Requested By become searchable (Select2) the same way every other list/filter
    // page in the app does it (see select2-interop.js) - the native <select> stays the source of
    // truth via @onchange (progressive enhancement), Select2 just also calls the same method directly.
    private DotNetObjectReference<PublicityForm>? _objRef;
    private bool _select2Ready;
    private bool _pendingSelect2Sync;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (ShowBulk || ShowItemsEditor)
        {
            // .indeterminate is a DOM property, not an HTML attribute/Blazor-bindable value, so the
            // header checkbox's "some but not all rows selected" state has to be pushed via JS after
            // every render where it could have changed (a row toggled, added or removed). Guarded on
            // _bulkRows.Count > 0 because the checkbox (and its @ref) only exists in the DOM once the
            // EmptyState ("No items yet") branch is no longer showing.
            if (_bulkRows.Count > 0)
            {
                var indeterminate = SelectedCount > 0 && SelectedCount < _bulkRows.Count;
                await JS.InvokeVoidAsync("setIndeterminate", _selectAllCheckboxRef, indeterminate);
            }
            return;
        }
        if (_lookups is null) return;
        if (!_select2Ready)
        {
            _select2Ready = true;
            _objRef ??= DotNetObjectReference.Create(this);
            var configs = new[]
            {
                new { id = "pr-prod", method = nameof(OnProductChanged), parent = (string?)null },
                new { id = "pr-by", method = nameof(OnRequestedByChanged), parent = (string?)null }
            };
            await JS.InvokeVoidAsync("spicSelect2.initMultiple", configs, _objRef);
            // Freshly initialized from the current, already-correct DOM `selected` state - nothing
            // further to sync for this first-ever render.
            _pendingSelect2Sync = false;
            return;
        }
        if (_pendingSelect2Sync)
        {
            _pendingSelect2Sync = false;
            await JS.InvokeVoidAsync("spicSelect2.setValue", "pr-prod", _dto.ProductId > 0 ? _dto.ProductId : (int?)null);
            await JS.InvokeVoidAsync("spicSelect2.setValue", "pr-by", _dto.RequestedByUserId);
        }
    }

    private static Task OnNativeSelect(ChangeEventArgs e, Action<List<string>?> handler)
    {
        handler(e.Value is string s && !string.IsNullOrEmpty(s) ? new List<string> { s } : new List<string>());
        return Task.CompletedTask;
    }

    [JSInvokable]
    public void OnProductChanged(List<string>? values)
    {
        _dto.ProductId = values is { Count: > 0 } && int.TryParse(values[0], out var v) ? v : 0;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnRequestedByChanged(List<string>? values)
    {
        _dto.RequestedByUserId = values is { Count: > 0 } ? values[0] : null;
        StateHasChanged();
    }

    public void Dispose() => _objRef?.Dispose();

    private async Task StateChanged(ChangeEventArgs e)
    {
        _dto.StateId = int.TryParse(e.Value?.ToString(), out var v) ? v : 0;
        _dto.RegionId = _dto.HeadquarterId = 0;
        _hqs = new();
        _regions = _dto.StateId > 0 ? await Api.RegionsAsync(_dto.StateId) ?? new() : new();
    }

    private async Task RegionChanged(ChangeEventArgs e)
    {
        _dto.RegionId = int.TryParse(e.Value?.ToString(), out var v) ? v : 0;
        _dto.HeadquarterId = 0;
        _hqs = _dto.RegionId > 0 ? await Api.HqsAsync(_dto.RegionId) ?? new() : new();
    }

    private async Task RemoveExisting(PubFileDto f)
    {
        if (await Api.DeleteFileAsync(f.Id)) _existing.Remove(f);
    }

    // ---- "Specific Product" bulk rows -------------------------------------------------------

    private async Task OnExcelPicked(InputFileChangeEventArgs e)
    {
        _excelFileName = e.File.Name;
        _importing = true;
        var rows = await Api.ImportExcelAsync(e.File);
        _importing = false;
        if (rows is null) return;
        foreach (var row in rows)
            _bulkRows.Add(new BulkRowVm { ProductId = row.ProductId, Quantity = row.Quantity, Error = row.Error });
        Toast.Success($"{rows.Count} row(s) imported.");
    }

    private void AddRow() => _bulkRows.Add(new BulkRowVm { Quantity = 1 });
    private void RemoveRow(BulkRowVm row) => _bulkRows.Remove(row);

    // Confirm before removing a row that's already saved server-side (ShowItemsEditor) - an unsaved
    // row from AddRow/Excel import (row.Id is null, nothing to lose yet) still removes immediately,
    // matching ShowBulk's existing create-mode behavior.
    private async Task RemoveRowAsync(BulkRowVm row)
    {
        if (row.Id is not null && !await Toast.ConfirmAsync("Delete item", "Remove this product from the request? This cannot be undone once saved.", "Delete")) return;
        _bulkRows.Remove(row);
    }

    private void OnRowProductChanged(BulkRowVm row, ChangeEventArgs e)
    {
        row.ProductId = int.TryParse(e.Value?.ToString(), out var v) ? v : 0;
        row.Error = null;
    }

    private void OnRowFilePicked(BulkRowVm row, InputFileChangeEventArgs e) => row.File = e.File;

    private void ApplyDesignToSelected(InputFileChangeEventArgs e)
    {
        var selected = _bulkRows.Where(r => r.Selected).ToList();
        foreach (var row in selected) row.File = e.File;
        if (selected.Count > 0) Toast.Success($"Design applied to {selected.Count} row(s).");
    }

    private async Task SaveBulkAsync(bool submit)
    {
        string? error = _dto.MaterialTypeId <= 0 ? "Select the type of publicity material."
            : _dto.HeadquarterId <= 0 ? "Select the state, region and headquarter."
            : _bulkRows.Count == 0 ? "Import or add at least one item." : null;
        if (error != null) { Toast.Error(error); return; }
        foreach (var row in _bulkRows)
            row.Error = row.ProductId <= 0 ? "Select the product." : row.Quantity < 0 ? "Enter a valid quantity." : null;
        if (_bulkRows.Any(r => r.Error != null)) { Toast.Error("Fix the highlighted rows before continuing."); return; }
        if (submit && !await Toast.ConfirmAsync("Submit request", $"Submit request with {_bulkRows.Count} item(s) for RM review? You cannot edit it after submission unless it is returned.", "Submit")) return;

        _busy = true;
        var bulk = new PubBulkUpsertDto
        {
            MaterialTypeId = _dto.MaterialTypeId, RequestedByUserId = _dto.RequestedByUserId,
            StateId = _dto.StateId, RegionId = _dto.RegionId, HeadquarterId = _dto.HeadquarterId,
            Remarks = _dto.Remarks, Submit = submit,
            Items = _bulkRows.Select(r => new PubBulkItemDto { ProductId = r.ProductId, Quantity = r.Quantity }).ToList()
        };
        var created = await Api.CreateBulkAsync(bulk);
        if (created is null) { _busy = false; return; }
        for (var i = 0; i < created.Items.Count && i < _bulkRows.Count; i++)
        {
            var file = _bulkRows[i].File;
            if (file is not null) await Api.UploadAsync(created.Id, PublicityFileKind.Design, new[] { file }, requestItemId: created.Items[i].Id);
        }
        _busy = false;
        Toast.Success(submit ? $"Request {created.IndentNo} with {created.Items.Count} item(s) submitted for RM review." : $"Draft {created.IndentNo} with {created.Items.Count} item(s) saved.");
        Nav.NavigateTo(submit ? $"/PublicityRequest/{created.Id}" : "/PublicityRequest");
    }

    // Editing an existing Specific Product (multi-item) request. Two separate server calls, same
    // split as the rest of this page: Api.SaveAsync(Id, _dto) updates the parent-level fields
    // (material/requested by/location/remarks) through the EXACT SAME single-item Update endpoint
    // and permission check every other edit already uses; Api.UpdateItemsAsync is the one genuinely
    // new call, touching only the PublicityRequestItem rows. Never resets RequestedByUserId - _dto
    // already holds whatever was loaded (or explicitly re-picked), same as the single-item path.
    private async Task SaveItemsEditAsync(bool submit)
    {
        string? error = _dto.MaterialTypeId <= 0 ? "Select the type of publicity material."
            : _dto.HeadquarterId <= 0 ? "Select the state, region and headquarter."
            : _bulkRows.Count == 0 ? "Keep at least one item." : null;
        if (error != null) { Toast.Error(error); return; }
        foreach (var row in _bulkRows)
            row.Error = row.ProductId <= 0 ? "Select the product." : row.Quantity < 0 ? "Enter a valid quantity." : null;
        if (_bulkRows.Any(r => r.Error != null)) { Toast.Error("Fix the highlighted rows before continuing."); return; }
        if (!Approver && submit && !await Toast.ConfirmAsync("Submit request", $"Submit request with {_bulkRows.Count} item(s) for RM review? You cannot edit it after submission unless it is returned.", "Submit")) return;

        _busy = true;
        _dto.ProductId = _bulkRows[0].ProductId;
        _dto.Quantity = _bulkRows.Sum(r => r.Quantity);
        _dto.Submit = false;
        var savedParent = await Api.SaveAsync(Id, _dto);
        if (savedParent is null) { _busy = false; return; }

        var itemsDto = new PubItemsUpdateDto { Items = _bulkRows.Select(r => new PubItemUpdateDto { Id = r.Id, ProductId = r.ProductId, Quantity = r.Quantity }).ToList() };
        var result = await Api.UpdateItemsAsync(Id!.Value, itemsDto);
        if (result is null) { _busy = false; return; }
        for (var i = 0; i < result.Items.Count && i < _bulkRows.Count; i++)
        {
            var file = _bulkRows[i].File;
            if (file is not null) await Api.UploadAsync(Id!.Value, PublicityFileKind.Design, new[] { file }, requestItemId: result.Items[i].Id);
        }

        if (Approver)
        {
            if (FromConsolidation || _detail?.Stage == PublicityStage.SmdReview)
            {
                await Api.MarkRequestReviewedAsync(Id!.Value, true);
                _busy = false;
                Toast.Success("Changes saved and marked as reviewed.");
                Nav.NavigateTo(Back);
                return;
            }
            var next = PubText.Next(_detail!.Stage);
            var ok = await Api.ReviewAsync(Id!.Value, new PubReviewDto { Action = "Approve" });
            _busy = false;
            if (!ok) return;
            Toast.Success($"Changes saved and forwarded to {next}.");
            Nav.NavigateTo(Back);
            return;
        }

        if (submit)
        {
            _dto.Submit = true;
            savedParent = await Api.SaveAsync(Id, _dto);
        }
        _busy = false;
        if (savedParent is null) return;
        Toast.Success(submit ? $"Request {savedParent.IndentNo} submitted for RM review." : $"Draft {savedParent.IndentNo} saved.");
        Nav.NavigateTo(submit ? $"/PublicityRequest/{savedParent.Id}" : "/PublicityRequest");
    }

    private async Task SaveAsync(bool submit)
    {
        if (ShowBulk) { await SaveBulkAsync(submit); return; }
        if (ShowItemsEditor) { await SaveItemsEditAsync(submit); return; }

        string? error = _dto.MaterialTypeId <= 0 ? "Select the type of publicity material."
            : _dto.ProductId <= 0 ? "Select the product."
            : _qty is not >= 0 ? "Enter the required quantity."
            : _dto.HeadquarterId <= 0 ? "Select the state, region and headquarter." : null;
        if (error != null) { Toast.Error(error); return; }
        _dto.IsGiftArticle = GiftMode;
        if (Approver)
        {
            _busy = true;
            _dto.Quantity = _qty!.Value;
            _dto.Submit = false;
            var ok = await Api.SaveAsync(Id, _dto) is not null;
            if (ok && _files.Count > 0) ok = await Api.UploadAsync(Id!.Value, PublicityFileKind.Design, _files) is not null;

            if (FromConsolidation || _detail?.Stage == PublicityStage.SmdReview)
            {
                // In SMD consolidation, individual requests are reviewed and saved, not forwarded to SMM individually.
                if (ok) await Api.MarkRequestReviewedAsync(Id!.Value, true);
                _busy = false;
                if (!ok) return;
                _files = new();
                Toast.Success("Changes saved and marked as reviewed.");
                Nav.NavigateTo(Back);
                return;
            }

            // Editing IS the approval here: no separate "Approve & Forward" click afterwards -
            // saving the change immediately forwards the request to the next stage.
            var next = PubText.Next(_detail!.Stage);
            if (ok) ok = await Api.ReviewAsync(Id!.Value, new PubReviewDto { Action = "Approve" });
            _busy = false;
            if (!ok) return;
            _files = new();
            Toast.Success($"Changes saved and forwarded to {next}.");
            Nav.NavigateTo(Back);
            return;
        }
        if (submit && !await Toast.ConfirmAsync("Submit request", "Submit this request for RM review? You cannot edit it after submission unless it is returned.", "Submit")) return;

        _busy = true;
        _dto.Quantity = _qty!.Value;
        _dto.Submit = false;
        var saved = await Api.SaveAsync(Id, _dto);
        if (saved is not null)
        {
            Id = saved.Id;
            if (_files.Count > 0)
            {
                if (await Api.UploadAsync(saved.Id, PublicityFileKind.Design, _files) is null) saved = null;
                else _files = new();
            }
        }
        if (saved is not null && submit)
        {
            _dto.Submit = true;
            saved = await Api.SaveAsync(saved.Id, _dto);
        }
        _busy = false;
        if (saved is null) return;
        Toast.Success(submit ? $"Request {saved.IndentNo} submitted for RM review." : $"Draft {saved.IndentNo} saved.");
        Nav.NavigateTo(submit ? $"/PublicityRequest/{saved.Id}" : "/PublicityRequest");
    }
}
