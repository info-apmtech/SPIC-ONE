@page "/PublicityDeliveryAddresses"
@using SPIC.Core.DTOs
@using SPIC.MauiBlazorApp.Shared.Components.Publicity
@inject PublicityApi Api
@inject ToastService Toast

@* Delivery Address Management (2026-11-26, ADMIN-MD CS only). Manages the same PublicityDeliveryAddress
   rows/table the dispatch page's "Delivery Address" dropdown + "Add Address" popup already read/write -
   no new table, no duplicate entity. Access is gated the same way on both ends: Api.CanManageDeliveryAddresses
   decides whether this page's content renders at all (menu visibility is a separate, identical check in
   NavMenu.razor), and every delivery-addresses/admin + PUT/DELETE endpoint independently re-checks
   IsAdminMdCsAsync()/IsSuper() server side - this page redirecting away never WAS the real guard. *@

<div class="pub-page">
    <PageHeader Title="Delivery Address Management" Subtitle="Manage saved delivery addresses used when creating dispatches.">
        <Actions>
            @if (Api.CanManageDeliveryAddresses)
            {
                <button type="button" class="pub-btn pub-btn--primary" @onclick="OpenAdd"><i class="bi bi-plus-lg"></i> Add Address</button>
            }
        </Actions>
    </PageHeader>

    @if (!Api.CanManageDeliveryAddresses)
    {
        <EmptyState Icon="bi-shield-lock" Title="Not available" Message="Only ADMIN-MD CS can manage delivery addresses." />
    }
    else if (_loadError is not null)
    {
        <EmptyState Icon="bi-exclamation-circle" Title="Could not load addresses" Message="@_loadError">
            <button type="button" class="pub-btn pub-btn--primary" @onclick="LoadAsync">Try Again</button>
        </EmptyState>
    }
    else
    {
        <section class="pub-card">
            <SpicDataTable TItem="PubDeliveryAddressDto"
                           Items="_all"
                           IsLoading="_isLoading"
                           Title="Delivery Addresses"
                           FileName="DeliveryAddresses"
                           ExportColumns="GetExportColumns()"
                           SearchText="@_q"
                           InitialPageSize="10"
                           PageSizeOptions="new[] { 10, 25, 50, 100 }"
                           ShowEntriesText="true"
                           EmptyTitle="No addresses found"
                           EmptyMessage="Nothing matches these filters.">
                <FilterControls>
                    <div class="pub-search"><i class="bi bi-search"></i><input class="pub-input" placeholder="Search addresses..." @bind="_q" @bind:event="oninput" aria-label="Search addresses" /></div>
                </FilterControls>

                <TableHeader>
                    <th>Address Name / Contact Person</th>
                    <th>Address</th>
                    <th>City</th>
                    <th>State</th>
                    <th>PIN Code</th>
                    <th>Mobile Number</th>
                    <th>Status</th>
                    <th>Action</th>
                </TableHeader>

                <TableRow Context="a">
                    <td><b>@a.AddressLabel</b>@(string.IsNullOrWhiteSpace(a.ContactPerson) ? "" : $" ({a.ContactPerson})")</td>
                    <td>@a.AddressLine1@(string.IsNullOrWhiteSpace(a.AddressLine2) ? "" : $", {a.AddressLine2}")</td>
                    <td>@a.City</td>
                    <td>@a.StateName</td>
                    <td>@a.PinCode</td>
                    <td>@a.MobileNumber</td>
                    <td><PubPill Text="@(a.IsActive ? "Active" : "Inactive")" Tone="@(a.IsActive ? "green" : "grey")" /></td>
                    <td class="pub-row-actions">
                        <button type="button" class="pub-icon-btn pub-icon-btn--violet" aria-label="Edit @a.AddressLabel" title="Edit" @onclick="() => OpenEdit(a)"><i class="bi bi-pencil"></i></button>
                        <button type="button" class="pub-icon-btn pub-icon-btn--red" aria-label="Delete @a.AddressLabel" title="Delete" disabled="@_busy" @onclick="() => OpenDelete(a)"><i class="bi bi-trash"></i></button>
                        <button type="button" class="pub-icon-btn @(a.IsActive ? "pub-icon-btn--red" : "")" aria-label="@(a.IsActive ? "Deactivate" : "Activate") @a.AddressLabel" title="@(a.IsActive ? "Deactivate" : "Activate")" disabled="@_busy" @onclick="() => ToggleActiveAsync(a)">
                            <i class="bi @(a.IsActive ? "bi-toggle-on" : "bi-toggle-off")"></i>
                        </button>
                    </td>
                </TableRow>

                <CardActions Context="a">
                    <button type="button" class="pub-btn pub-btn--line pub-btn--sm" @onclick="() => OpenEdit(a)"><i class="bi bi-pencil"></i> Edit</button>
                    <button type="button" class="pub-btn pub-btn--line pub-btn--sm" disabled="@_busy" @onclick="() => OpenDelete(a)"><i class="bi bi-trash pub-text-red"></i> Delete</button>
                    <button type="button" class="pub-btn @(a.IsActive ? "pub-btn--line" : "pub-btn--primary") pub-btn--sm" disabled="@_busy" @onclick="() => ToggleActiveAsync(a)">
                        <i class="bi @(a.IsActive ? "bi-toggle-on" : "bi-toggle-off")"></i> @(a.IsActive ? "Deactivate" : "Activate")
                    </button>
                </CardActions>
            </SpicDataTable>
        </section>
    }

    @* Add/Edit modal reuses the exact field set from PublicityDispatch.razor's "Add Delivery Address"
       popup (same DTO shape, same validation) - kept as the same .pub-modal markup PublicityMaterialMaster
       uses (not a BottomSheet like the dispatch page) since this page, unlike dispatch, already follows
       the DataTable-master convention end to end. *@
    @if (_showModal)
    {
    <div class="pub-modal" @onkeydown="OnModalKeyDown">
        <div class="pub-modal__backdrop" @onclick="CloseModal"></div>
        <div class="pub-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="pdam-title">
            <div class="pub-modal__header">
                <h2 class="pub-h2" id="pdam-title">@(_editingId is null ? "Add Address" : "Edit Address")</h2>
                <button type="button" class="pub-icon-btn" aria-label="Close" @onclick="CloseModal"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="pub-modal__body">
                <div class="pub-form pub-form--2">
                    <div class="pub-field"><label class="pub-label pub-req" for="pdam-label">Address Name / Label</label>
                        <input id="pdam-label" class="pub-input" @bind="_form.AddressLabel" placeholder="e.g. SPIC Regional Office - Salem" /></div>
                    <div class="pub-field"><label class="pub-label pub-req" for="pdam-recipient">Recipient / Office Name</label>
                        <input id="pdam-recipient" class="pub-input" @bind="_form.RecipientName" placeholder="e.g. SPIC Regional Office" /></div>
                    <div class="pub-field"><label class="pub-label" for="pdam-contact">Contact Person (Optional)</label>
                        <input id="pdam-contact" class="pub-input" @bind="_form.ContactPerson" /></div>
                    <div class="pub-field"><label class="pub-label pub-req" for="pdam-mobile">Mobile Number</label>
                        <input id="pdam-mobile" class="pub-input" @bind="_form.MobileNumber" placeholder="10-digit mobile number" /></div>
                    <div class="pub-field pub-field--full"><label class="pub-label pub-req" for="pdam-l1">Address Line 1</label>
                        <input id="pdam-l1" class="pub-input" @bind="_form.AddressLine1" /></div>
                    <div class="pub-field pub-field--full"><label class="pub-label" for="pdam-l2">Address Line 2 (Optional)</label>
                        <input id="pdam-l2" class="pub-input" @bind="_form.AddressLine2" /></div>
                    <div class="pub-field"><label class="pub-label" for="pdam-landmark">Landmark (Optional)</label>
                        <input id="pdam-landmark" class="pub-input" @bind="_form.Landmark" /></div>
                    <div class="pub-field"><label class="pub-label pub-req" for="pdam-state">State</label>
                        <select id="pdam-state" class="pub-input" @bind="_form.StateId">
                            <option value="0">Select State</option>
                            @foreach (var s in _states) { <option value="@s.Id">@s.Name</option> }
                        </select></div>
                    <div class="pub-field"><label class="pub-label pub-req" for="pdam-city">District / City</label>
                        <input id="pdam-city" class="pub-input" @bind="_form.City" /></div>
                    <div class="pub-field"><label class="pub-label pub-req" for="pdam-pin">PIN Code</label>
                        <input id="pdam-pin" class="pub-input" maxlength="6" @bind="_form.PinCode" placeholder="6-digit PIN code" /></div>
                    <div class="pub-field"><label class="pub-label" for="pdam-active">Active Status</label>
                        <div class="pub-switch">
                            <input id="pdam-active" type="checkbox" @bind="_form.IsActive" />
                            <span class="pub-muted">@(_form.IsActive ? "Active - available for new dispatches" : "Inactive - hidden from the dispatch dropdown")</span>
                        </div>
                    </div>
                </div>
                @if (_error is not null) { <small class="pub-text-red">@_error</small> }
            </div>
            <div class="pub-modal__footer">
                <button type="button" class="pub-btn pub-btn--line" disabled="@_busy" @onclick="CloseModal">Cancel</button>
                <button type="button" class="pub-btn pub-btn--primary" disabled="@_busy" @onclick="SaveAsync">@(_busy ? "Saving..." : "Save")</button>
            </div>
        </div>
    </div>
}

@if (_deleteTarget is { } dm)
{
    <div class="pub-modal" @onkeydown="OnDeleteModalKeyDown">
        <div class="pub-modal__backdrop" @onclick="CloseDeleteModal"></div>
        <div class="pub-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="pdam-del-title">
            <div class="pub-modal__header">
                <h2 class="pub-h2" id="pdam-del-title">Delete Address</h2>
                <button type="button" class="pub-icon-btn" aria-label="Close" @onclick="CloseDeleteModal"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="pub-modal__body">
                <p>Are you sure you want to delete this delivery address?</p>
                <p><b>@dm.AddressLabel</b></p>
                @if (_deleteError is not null) { <small class="pub-text-red">@_deleteError</small> }
            </div>
            <div class="pub-modal__footer">
                <button type="button" class="pub-btn pub-btn--line" disabled="@_busy" @onclick="CloseDeleteModal">Cancel</button>
                <button type="button" class="pub-btn pub-btn--danger" disabled="@_busy" @onclick="ConfirmDeleteAsync">@(_busy ? "Deleting..." : "Delete")</button>
            </div>
        </div>
    </div>
}
</div>

@code {
    private List<PubDeliveryAddressDto> _all = new();
    private List<PubOption> _states = new();
    private bool _isLoading = true;
    private string? _loadError;
    private string _q = "";
    private bool _busy;
    private bool _showModal;
    private int? _editingId;
    private string? _error;
    private PubDeliveryAddressUpdateDto _form = new();

    private List<ExportColumn<PubDeliveryAddressDto>> GetExportColumns() => new()
    {
        new() { Header = "Address Name / Contact Person", ValueSelector = a => a.ContactPerson is null ? a.AddressLabel : $"{a.AddressLabel} ({a.ContactPerson})" },
        new() { Header = "Address", ValueSelector = a => a.AddressLine2 is null ? a.AddressLine1 : $"{a.AddressLine1}, {a.AddressLine2}" },
        new() { Header = "City", ValueSelector = a => a.City },
        new() { Header = "State", ValueSelector = a => a.StateName ?? "" },
        new() { Header = "PIN Code", ValueSelector = a => a.PinCode },
        new() { Header = "Mobile Number", ValueSelector = a => a.MobileNumber },
        new() { Header = "Status", ValueSelector = a => a.IsActive ? "Active" : "Inactive" }
    };

    protected override async Task OnInitializedAsync()
    {
        if (!Api.CanManageDeliveryAddresses) return;
        _states = await Api.StatesAsync() ?? new();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _loadError = null;
        StateHasChanged();
        var result = await Api.DeliveryAddressesAdminAsync();
        if (result is null)
        {
            _loadError = "We couldn't load the delivery addresses. Please check your connection and try again.";
        }
        else
        {
            _all = result;
        }
        _isLoading = false;
    }

    private void OpenAdd()
    {
        _editingId = null;
        _form = new PubDeliveryAddressUpdateDto { IsActive = true };
        _error = null;
        _showModal = true;
    }

    private void OpenEdit(PubDeliveryAddressDto a)
    {
        _editingId = a.Id;
        _form = new PubDeliveryAddressUpdateDto
        {
            AddressLabel = a.AddressLabel, RecipientName = a.RecipientName, ContactPerson = a.ContactPerson,
            MobileNumber = a.MobileNumber, AddressLine1 = a.AddressLine1, AddressLine2 = a.AddressLine2,
            Landmark = a.Landmark, StateId = a.StateId, DistrictId = a.DistrictId, City = a.City,
            PinCode = a.PinCode, IsActive = a.IsActive
        };
        _error = null;
        _showModal = true;
    }

    private void CloseModal()
    {
        if (_busy) return;
        _showModal = false;
    }

    private Task OnModalKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e) =>
        e.Key == "Escape" ? Task.Run(CloseModal) : Task.CompletedTask;

    private async Task SaveAsync()
    {
        string? error = string.IsNullOrWhiteSpace(_form.AddressLabel) ? "Enter the address name / label."
            : string.IsNullOrWhiteSpace(_form.RecipientName) ? "Enter the recipient / office name."
            : !System.Text.RegularExpressions.Regex.IsMatch(_form.MobileNumber?.Trim() ?? "", @"^[6-9]\d{9}$") ? "Enter a valid 10-digit Indian mobile number."
            : string.IsNullOrWhiteSpace(_form.AddressLine1) ? "Enter address line 1."
            : _form.StateId <= 0 ? "Select the state."
            : string.IsNullOrWhiteSpace(_form.City) ? "Enter the district / city."
            : !System.Text.RegularExpressions.Regex.IsMatch(_form.PinCode?.Trim() ?? "", @"^\d{6}$") ? "Enter a valid 6-digit PIN code." : null;
        if (error != null) { _error = error; return; }
        _busy = true;
        _error = null;
        try
        {
            var saved = _editingId is int id
                ? await Api.UpdateDeliveryAddressAsync(id, _form)
                : await Api.CreateDeliveryAddressAsync(new PubDeliveryAddressCreateDto
                {
                    AddressLabel = _form.AddressLabel, RecipientName = _form.RecipientName, ContactPerson = _form.ContactPerson,
                    MobileNumber = _form.MobileNumber, AddressLine1 = _form.AddressLine1, AddressLine2 = _form.AddressLine2,
                    Landmark = _form.Landmark, StateId = _form.StateId, DistrictId = _form.DistrictId, City = _form.City, PinCode = _form.PinCode
                });
            if (saved is null) { _error = "Could not save the address."; return; }
            _showModal = false;
            await LoadAsync();
            Toast.Success(_editingId is null ? "Address added." : "Address updated.");
        }
        finally { _busy = false; }
    }

    private async Task ToggleActiveAsync(PubDeliveryAddressDto a)
    {
        _busy = true;
        try
        {
            var dto = new PubDeliveryAddressUpdateDto
            {
                AddressLabel = a.AddressLabel, RecipientName = a.RecipientName, ContactPerson = a.ContactPerson,
                MobileNumber = a.MobileNumber, AddressLine1 = a.AddressLine1, AddressLine2 = a.AddressLine2,
                Landmark = a.Landmark, StateId = a.StateId, DistrictId = a.DistrictId, City = a.City,
                PinCode = a.PinCode, IsActive = !a.IsActive
            };
            var saved = await Api.UpdateDeliveryAddressAsync(a.Id, dto);
            if (saved is null) { Toast.Error("Could not update the address status."); return; }
            await LoadAsync();
            Toast.Success(!a.IsActive ? "Address activated." : "Address deactivated.");
        }
        finally { _busy = false; }
    }

    // ---- delete (separate confirm modal from Add/Edit's _showModal, same convention as
    // PublicityMaterialMaster.razor) ----
    private PubDeliveryAddressDto? _deleteTarget;
    private string? _deleteError;

    private void OpenDelete(PubDeliveryAddressDto a)
    {
        _deleteTarget = a;
        _deleteError = null;
    }

    private void CloseDeleteModal()
    {
        if (_busy) return;
        _deleteTarget = null;
        _deleteError = null;
    }

    private Task OnDeleteModalKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e) =>
        e.Key == "Escape" ? Task.Run(CloseDeleteModal) : Task.CompletedTask;

    private async Task ConfirmDeleteAsync()
    {
        if (_deleteTarget is not { } a) return;
        _busy = true;
        _deleteError = null;
        try
        {
            var ok = await Api.DeleteDeliveryAddressAsync(a.Id);
            if (!ok) { _deleteError = "Could not delete this address. It may be in use by existing dispatches - deactivate it instead."; return; }
            _deleteTarget = null;
            await LoadAsync();
            Toast.Success("Address deleted.");
        }
        finally { _busy = false; }
    }
}
