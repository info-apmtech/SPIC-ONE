@page "/PublicityRequest/notifications"
@page "/PublicityReview/notifications"
@using SPIC.Core.DTOs
@using SPIC.Core.Entities
@using SPIC.MauiBlazorApp.Shared.Components.Publicity
@inject PublicityApi Api
@inject NavigationManager Nav
@inject FileDownloadService Downloads
@inject IJSRuntime JS
@inject PublicityNotificationState PubNotify

@* Publicity notifications (stock transfer orders, exceptions, dispatches, approvals) with the
   transfer-order drawer (Figma "Stock Transfer Order Received"). *@

<div class="pub-page">
    <PageHeader Title="Notifications" Subtitle="Stay updated with important alerts, approvals and stock transfer orders.">
        <Actions>
            <a class="pub-btn pub-btn--line" href="@Api.Home" data-help="pub-notif-back"><i class="bi bi-arrow-left"></i> Back to List Page</a>
            <button type="button" class="pub-btn pub-btn--line" @onclick="DownloadReportAsync" disabled="@(_items is null)">Download Report</button>
            <button type="button" class="pub-btn pub-btn--line" @onclick="PrintAsync"><i class="bi bi-printer"></i> Print</button>
        </Actions>
    </PageHeader>

    <section class="pub-card">
        <nav class="pub-tabs pub-tabs--inset" role="tablist" data-help="pub-notif-tabs">
            @foreach (var (label, type) in Tabs)
            {
                <button type="button" role="tab" class="pub-tab @(type == _type ? "is-active" : "")" aria-selected="@(type == _type)" @onclick="() => LoadAsync(type)">@label</button>
            }
        </nav>
        @if (_items is null)
        {
            <Skeleton Rows="5" />
        }
        else if (_items.Count == 0)
        {
            <EmptyState Icon="bi-bell" Title="No notifications" Message="Stock transfer orders, exceptions and dispatch updates appear here." />
        }
        else
        {
            <ul class="pub-notes" data-help="pub-notif-list">
                @foreach (var n in _items)
                {
                    <li>
                        <button type="button" class="pub-notice @(n.IsRead ? "" : "is-unread")" @onclick="() => OpenAsync(n)">
                            <span class="pub-notice__icon pub-tint--@(n.Type == PublicityNotificationType.Exception ? "red" : "green")"><i class="bi @Icon(n.Type)"></i></span>
                            <span class="pub-notice__body"><b>@n.Title</b><span>@n.Message</span>@if (n.SubText is not null) { <small>@n.SubText</small> }</span>
                            <span class="pub-notice__when">@if (!n.IsRead) { <i class="pub-dot" aria-label="Unread"></i> } @PubText.DateTime(n.CreatedAt)</span>
                        </button>
                    </li>
                }
            </ul>
        }
    </section>

    <BottomSheet @bind-IsOpen="_open" Size="BottomSheet.SheetSize.Full" CssClass="pub-sheet-wide" Title="@(_detail?.Notice.Title ?? "Notification")">
        <ChildContent>
            @if (_detail is not null)
            {
                var n = _detail.Notice;
                <div class="pub-card pub-notice-head">
                    <span class="pub-notice__icon pub-tint--green"><i class="bi @Icon(n.Type)"></i></span>
                    <div><PubPill Text="@TypeLabel(n.Type)" Tone="green" /><h3 class="pub-h2">@n.Title</h3><span class="pub-muted">@PubText.DateTime(n.CreatedAt)</span></div>
                </div>
                <div class="pub-banner pub-banner--green"><p>@n.Message. @n.SubText</p></div>
                @if (_detail.Notice.Type == PublicityNotificationType.Exception)
                {
                    <section class="pub-card pub-card--flush">
                        <div class="pub-card__band pub-band--red"><h2 class="pub-h2 pub-text-red">@_detail.Notice.Title</h2></div>
                        <div class="pub-grid pub-grid--3">
                            @if (!string.IsNullOrWhiteSpace(_detail.RequestIndentNo))
                            {
                                <PubInfo Label="Request ID" Value="@_detail.RequestIndentNo" />
                            }
                            @if (!string.IsNullOrWhiteSpace(_detail.DispatchNo))
                            {
                                <PubInfo Label="Dispatch ID" Value="@_detail.DispatchNo" />
                            }
                            <PubInfo Label="Product / Material" Value="@($"{_detail.Product} {_detail.Material}".Trim())" />
                            <PubInfo Label="Dispatched Quantity" Value="@($"{_detail.DispatchQty} Nos")" />
                            @if (_detail.ReceivedQty.HasValue)
                            {
                                <PubInfo Label="Received Quantity" Value="@($"{_detail.ReceivedQty} Nos")" />
                            }
                            @if (_detail.ExcessQty is > 0)
                            {
                                <PubInfo Label="Excess Quantity" Tone="pink" Value="@($"{_detail.ExcessQty} Nos")" />
                            }
                            @if (_detail.ShortageQty is > 0)
                            {
                                <PubInfo Label="Shortage Quantity" Tone="pink" Value="@($"{_detail.ShortageQty} Nos")" />
                            }
                            @if (_detail.DamagedQty is > 0)
                            {
                                <PubInfo Label="Damaged Quantity" Tone="pink" Value="@($"{_detail.DamagedQty} Nos")" />
                            }
                            @if (!string.IsNullOrWhiteSpace(_detail.ReportedByName))
                            {
                                <PubInfo Label="Reported By" Tone="green" Value="@_detail.ReportedByName" />
                            }
                            @if (_detail.ReportedDate.HasValue)
                            {
                                <PubInfo Label="Reported Date" Value="@PubText.DateTime(_detail.ReportedDate)" />
                            }
                            @if (!string.IsNullOrWhiteSpace(_detail.Status))
                            {
                                <PubInfo Label="Dispatch Status"><PubPill Text="@_detail.Status" Tone="blue" /></PubInfo>
                            }
                        </div>
                    </section>
                }
                else if (_detail.IsTransfer)
                {
                    <section class="pub-card pub-card--flush">
                        <div class="pub-card__band pub-band--green"><h2 class="pub-h2">Stock Transfer Order Details</h2></div>
                        <div class="pub-grid pub-grid--3">
                            @if (!string.IsNullOrWhiteSpace(_detail.DestinationIndentNo))
                            {
                                <PubInfo Label="Destination Request ID" Hint="Shortage" Tone="pink" Value="@_detail.DestinationIndentNo" />
                            }
                            @if (!string.IsNullOrWhiteSpace(_detail.SourceHq))
                            {
                                <PubInfo Label="From" Hint="Source HQ" Value="@_detail.SourceHq" />
                            }
                            @if (!string.IsNullOrWhiteSpace(_detail.SourceIndentNo))
                            {
                                <PubInfo Label="Source Request ID" Hint="Excess" Tone="pink" Value="@_detail.SourceIndentNo" />
                            }
                            @if (!string.IsNullOrWhiteSpace(_detail.DestinationHq))
                            {
                                <PubInfo Label="To" Hint="Destination HQ" Value="@_detail.DestinationHq" />
                            }
                            <PubInfo Label="Product / Material" Value="@($"{_detail.Product} {_detail.Material}".Trim())" />
                            <PubInfo Label="Transfer Quantity" Value="@($"{_detail.TransferQty} Nos")" />
                            @if (!string.IsNullOrWhiteSpace(_detail.Status))
                            {
                                <PubInfo Label="Current Transfer Status"><PubPill Text="@_detail.Status" Tone="blue" /></PubInfo>
                            }
                        </div>
                    </section>
                    @if (_detail.ReportedExcess > 0 || !string.IsNullOrWhiteSpace(_detail.SourceIndentNo))
                    {
                        <section class="pub-card pub-card--amber">
                            <h2 class="pub-h2 pub-text-amber">Source Excess Reference</h2>
                            <div class="pub-grid pub-grid--4">
                                <PubInfo Label="Reported Excess" Value="@($"{_detail.ReportedExcess} Nos")" />
                                <PubInfo Label="Already Transferred" Value="@($"{_detail.AlreadyTransferred} Nos")" />
                                <PubInfo Label="Remaining Excess" Value="@($"{_detail.RemainingExcess} Nos")" />
                                <PubInfo Label="Requested Now" Value="@($"{_detail.TransferQty} Nos")" />
                            </div>
                        </section>
                    }
                    @if (!string.IsNullOrWhiteSpace(_detail.Reason))
                    {
                        <section class="pub-card pub-card--blue"><h2 class="pub-h2">Reason for Transfer</h2><p>@_detail.Reason</p></section>
                    }
                }
                else if (!string.IsNullOrWhiteSpace(_detail.DispatchNo) || _detail.DispatchQty > 0 || _detail.Notice.Type == PublicityNotificationType.Dispatch)
                {
                    <section class="pub-card pub-card--flush">
                        <div class="pub-card__band pub-band--green"><h2 class="pub-h2">Dispatch Details</h2></div>
                        <div class="pub-grid pub-grid--3">
                            @if (!string.IsNullOrWhiteSpace(_detail.DispatchNo))
                            {
                                <PubInfo Label="Dispatch ID" Value="@_detail.DispatchNo" />
                            }
                            @if (!string.IsNullOrWhiteSpace(_detail.RequestIndentNo))
                            {
                                <PubInfo Label="Request ID" Value="@_detail.RequestIndentNo" />
                            }
                            <PubInfo Label="Product / Material" Value="@($"{_detail.Product} {_detail.Material}".Trim())" />
                            <PubInfo Label="Dispatch Quantity" Value="@($"{_detail.DispatchQty} Nos")" />
                            @if (_detail.DispatchDate.HasValue)
                            {
                                <PubInfo Label="Dispatch Date" Value="@PubText.Date(_detail.DispatchDate)" />
                            }
                            @if (!string.IsNullOrWhiteSpace(_detail.VendorName))
                            {
                                <PubInfo Label="Source / Vendor" Value="@_detail.VendorName" />
                            }
                            @if (!string.IsNullOrWhiteSpace(_detail.DestinationHq) || !string.IsNullOrWhiteSpace(_detail.DestinationAddress))
                            {
                                <PubInfo Label="Destination HQ / Delivery Address" Value="@(_detail.DestinationHq ?? _detail.DestinationAddress)" Sub="@(!string.IsNullOrWhiteSpace(_detail.DestinationHq) && !string.IsNullOrWhiteSpace(_detail.DestinationAddress) ? _detail.DestinationAddress : null)" />
                            }
                            @if (!string.IsNullOrWhiteSpace(_detail.Transporter))
                            {
                                <PubInfo Label="Transporter / Courier" Value="@_detail.Transporter" />
                            }
                            @if (!string.IsNullOrWhiteSpace(_detail.TrackingNo))
                            {
                                <PubInfo Label="Tracking Number" Value="@_detail.TrackingNo" />
                            }
                            @if (!string.IsNullOrWhiteSpace(_detail.Status))
                            {
                                <PubInfo Label="Dispatch Status"><PubPill Text="@_detail.Status" Tone="blue" /></PubInfo>
                            }
                        </div>
                    </section>
                }
            }
        </ChildContent>
        <Footer>
            @if (_detail is not null)
            {
                <button type="button" class="pub-btn pub-btn--grey" @onclick="() => _open = false"><i class="bi bi-chevron-double-left"></i> Back to List</button>
                <a class="pub-btn pub-btn--grey" href="@($"{Api.Home}/{_detail.Notice.RequestId}?tab=tracking")">View Details</a>
                @if (_detail.CanDispatch)
                {
                    <a class="pub-btn pub-btn--primary" href="@($"/PublicityReview/{_detail.Notice.RequestId}/dispatch")">Create Dispatch <i class="bi bi-chevron-double-right"></i></a>
                }
                @if (_detail.IsTransfer && !Api.IsDispatcher && _detail.Notice.DispatchId is > 0)
                {
                    <a class="pub-btn pub-btn--primary" href="@($"/PublicityRequest/{_detail.Notice.RequestId}/transfer/{_detail.Notice.DispatchId}")">View Transfer <i class="bi bi-chevron-double-right"></i></a>
                }
                @if (_detail.Notice.Type == PublicityNotificationType.Exception)
                {
                    <a class="pub-btn pub-btn--line" href="@($"{Api.Home}/{_detail.Notice.RequestId}?tab=acknowledgement")">View Acknowledgement</a>
                    <a class="pub-btn pub-btn--primary" href="@($"{Api.Home}/{_detail.Notice.RequestId}?tab=exception")">View Exception <i class="bi bi-chevron-double-right"></i></a>
                }
            }
        </Footer>
    </BottomSheet>
</div>

@code {
    // "Related Documents" (Figma's 4th tab) folds every non-StockTransfer/Exception notification
    // (Dispatch/Approval/General) into one place, same as the old "Dispatch & Approvals" label did -
    // nothing is lost, they still also show up under "All".
    private static readonly (string, int?)[] Tabs =
        { ("All", null), ("Stock Transfer", (int)PublicityNotificationType.StockTransfer), ("Exception", (int)PublicityNotificationType.Exception), ("Related Documents", (int)PublicityNotificationType.Dispatch) };
    private List<PubNotificationDto>? _items;
    private int? _type;
    private bool _open;
    private PubNotificationDetailDto? _detail;

    protected override Task OnInitializedAsync()
    {
        PubNotify.EnsurePolling();
        return LoadAsync(null);
    }

    private async Task LoadAsync(int? type)
    {
        _type = type;
        _items = null;
        var all = await Api.NotificationsAsync(type == (int)PublicityNotificationType.Dispatch ? null : type) ?? new();
        _items = type == (int)PublicityNotificationType.Dispatch
            ? all.Where(n => n.Type is PublicityNotificationType.Dispatch or PublicityNotificationType.Approval or PublicityNotificationType.General).ToList()
            : all;
    }

    private async Task OpenAsync(PubNotificationDto n)
    {
        var needMarkRead = !n.IsRead;
        Task<PubUnreadCountDto?>? markReadTask = null;
        if (needMarkRead)
        {
            markReadTask = Api.MarkReadAsync(n.Id);
        }

        var detailTask = Api.NotificationAsync(n.Id);

        _detail = await detailTask;
        _open = _detail is not null;

        if (markReadTask is not null)
        {
            var res = await markReadTask;
            if (res is not null)
            {
                n.IsRead = true;
                if (_detail is not null) _detail.Notice.IsRead = true;
                var row = _items?.FirstOrDefault(x => x.Id == n.Id);
                if (row is not null) row.IsRead = true;
                PubNotify.SetUnreadCount(res.Count);
                StateHasChanged();
            }
        }
    }

    private async Task PrintAsync()
    {
        try { await JS.InvokeVoidAsync("print"); } catch (Exception) { }
    }

    private async Task DownloadReportAsync()
    {
        var rows = (_items ?? new()).Select(n => new List<string>
        {
            n.Title, n.Message + (n.SubText is null ? "" : $" ({n.SubText})"), PubText.DateTime(n.CreatedAt), n.IsRead ? "Read" : "Unread"
        }).ToList();
        await Downloads.PostAsync("api/Export/table-pdf",
            new { Title = "Publicity Notifications", Headers = new[] { "Title", "Message", "Date & Time", "Status" }, Rows = rows },
            $"Publicity_Notifications_{DateTime.Now:yyyyMMdd}.pdf");
    }

    private static string Icon(PublicityNotificationType t) => t switch
    {
        PublicityNotificationType.StockTransfer => "bi-truck",
        PublicityNotificationType.Exception => "bi-exclamation-octagon",
        PublicityNotificationType.Dispatch => "bi-box-seam",
        _ => "bi-bell"
    };

    private static string TypeLabel(PublicityNotificationType t) => t switch
    {
        PublicityNotificationType.StockTransfer => "Stock Transfer Order",
        PublicityNotificationType.Exception => "Exception",
        PublicityNotificationType.Dispatch => "Dispatch",
        PublicityNotificationType.Approval => "Approval",
        _ => "General"
    };
}
