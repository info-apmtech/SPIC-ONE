@page "/PublicityRequest/{Id:int}"
@page "/PublicityReview/{Id:int}"
@using SPIC.Core.DTOs
@using SPIC.Core.Entities
@using SPIC.MauiBlazorApp.Shared.Components.Publicity
@using static SPIC.MauiBlazorApp.Shared.Components.Feedback.BottomSheet
@inject PublicityApi Api
@inject NavigationManager Nav
@inject ToastService Toast
@inject FileDownloadService Downloads
@inject IJSRuntime JS
@inject PublicityNotificationState PubNotify

@*
    One details page for every role (Figma "My Publicity Material Request Details" + the admin
    "Tracking & Delivery" variants). The API decides what the caller may do (CanEdit, CanReview,
    CanDispatch, CanResolve, CanAcknowledge, CanSubmitProof); this page renders those buttons.
    ?tab=tracking | ack | docs opens a tab directly.
*@

<div class="pub-page pub-print">
    <PageHeader Title="@(ReadOnlyReviewer ? "Request Details" : "My Publicity Material Request Details")" Subtitle="@Subtitle">
        <Actions>
            <a class="pub-btn pub-btn--line" href="@BackUrl"><i class="bi bi-arrow-left"></i> <span class="pub-hide-sm">Back to @BackLabel</span></a>
            <button type="button" class="pub-btn pub-btn--line pub-hide-sm" @onclick="DownloadReportAsync" disabled="@(_d is null)">Download Report</button>
            <button type="button" class="pub-btn pub-btn--line pub-hide-sm" @onclick="PrintAsync"><i class="bi bi-printer"></i> Print</button>
        </Actions>
    </PageHeader>

    @if (_d is null)
    {
        <Skeleton Rows="10" />
    }
    else
    {
        var d = _d;
        <PubHeader D="d" />

        @if (_tab == 0)
        {
            <section class="pub-card">
                <h2 class="pub-h2">Request Timeline</h2>
                <PubStepper Steps="d.Timeline" Label="Request timeline" />
            </section>
        }

        <nav class="pub-tabs" role="tablist">
            @foreach (var (label, i) in Tabs.Select((t, i) => (t, i)))
            {
                <button type="button" role="tab" class="pub-tab @(i == _tab ? "is-active" : "")" aria-selected="@(i == _tab)" @onclick="() => _tab = i">@label</button>
            }
        </nav>

        @switch (_tab)
        {
            case 0:
                <PubOverview D="d">
                    <HeadActions>
                        @if (d.CanDispatch) { <a class="pub-btn pub-btn--primary" href="@($"/PublicityReview/{d.Id}/dispatch")">Create Dispatch <i class="bi bi-arrow-right"></i></a> }
                    </HeadActions>
                </PubOverview>

                @if (d.Dispatches.Count > 0) { <PubSummary S="d.Summary" Title="Final Quantity Summary" /> }

                @if (Review && d.Stage <= PublicityStage.Dispatch)
                {
                    <section class="pub-card">
                        <h2 class="pub-h2">@(d.CanReview && Api.Role is AppRole.SMD ? "SMDO Remarks" : "Additional Details")</h2>
                        <label class="pub-label" for="rv-card">Additional Remarks (if any)</label>
                        @if (d.CanReview)
                        {
                            <textarea id="rv-card" rows="3" class="pub-input pub-textarea" placeholder="No additional remarks" @bind="_reviewRemarks"></textarea>
                        }
                        else
                        {
                            <div class="pub-remarks">@(d.ApproverRemarks ?? "No additional remarks")</div>
                        }
                    </section>
                }

                <section class="pub-card">
                    <h2 class="pub-h2">Approval History</h2>
                    <div class="pub-table-wrap">
                        <table class="pub-table pub-table--history">
                            <thead><tr><th>S.No</th><th>Stage</th><th>Action</th><th>Created By</th><th>Designation</th><th>Date &amp; Time</th><th>Remarks / Changes</th></tr></thead>
                            <tbody>
                                @for (var i = 0; i < d.History.Count; i++)
                                {
                                    var h = d.History[i];
                                    <tr>
                                        <td data-label="S.No"><span class="pub-hdot pub-hdot--@h.State"></span> @(i + 1)</td>
                                        <td data-label="Stage">@h.Stage</td>
                                        <td data-label="Action"><PubPill Text="@h.Action" Tone="@ActionTone(h.Action)" /></td>
                                        <td data-label="Created By">@if (h.By is not null) { <span class="pub-person pub-person--sm"><span class="pub-avatar">@h.By[..1]</span>@h.By</span> } else { <span>-</span> }</td>
                                        <td data-label="Designation">@(h.Role ?? "-")</td>
                                        <td data-label="Date">@(h.At is null ? "-" : PubText.DateTime(h.At))</td>
                                        <td data-label="Remarks">@(h.Remarks ?? "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>

                <div class="pub-footer">
                    <a class="pub-btn pub-btn--grey" href="@BackUrl"><i class="bi bi-chevron-double-left"></i> Back to @BackLabel</a>
                    <span class="pub-footer__gap"></span>
                    @if (d.CanEdit)
                    {
                        <a class="pub-btn pub-btn--line" href="@($"/PublicityRequest/edit/{d.Id}")"><i class="bi bi-pencil"></i> Edit &amp; Resubmit</a>
                    }
                    @if (d.CanReview)
                    {
                        @* DGM - MD CS (final approval) is approve-only - no Edit here, for anyone including Admin. *@
                        @if (d.Stage != PublicityStage.DgmMdCsReview)
                        {
                            <a class="pub-btn pub-btn--line-blue" href="@($"/PublicityReview/edit/{d.Id}{(FromConsolidation ? "?back=consolidation" : "")}")"><i class="bi bi-pencil-square"></i> Edit</a>
                        }
                        <button type="button" class="pub-btn pub-btn--line-red" @onclick="() => _reviewOpen = true"><i class="bi bi-x-circle"></i> Reject</button>
                        @if (d.Stage == PublicityStage.SmdReview || Api.Role == AppRole.SMD)
                        {
                            @if (d.SmdReviewedAt is null)
                            {
                                <button type="button" class="pub-btn pub-btn--primary" disabled="@_busy" @onclick="() => MarkReviewedAsync(true)"><i class="bi bi-check2-circle"></i> Mark as Reviewed</button>
                            }
                            else
                            {
                                <button type="button" class="pub-btn pub-btn--line" disabled="@_busy" @onclick="() => MarkReviewedAsync(false)"><i class="bi bi-arrow-counterclockwise"></i> Unmark Reviewed</button>
                            }
                        }
                        else
                        {
                            <button type="button" class="pub-btn pub-btn--primary" disabled="@_busy" @onclick="ApproveAsync"><i class="bi bi-check2"></i> Approve &amp; Forward to @PubText.Next(d.Stage)</button>
                        }
                    }
                    else if (ReadOnlyReviewer)
                    {
                        <button type="button" class="pub-btn pub-btn--line" @onclick="PrintAsync">Print <i class="bi bi-printer"></i></button>
                        <button type="button" class="pub-btn pub-btn--primary" @onclick="DownloadReportAsync">Download Report <i class="bi bi-download"></i></button>
                    }
                </div>
                break;

            case 1:
                <h2 class="pub-h2">Tracking &amp; Delivery <small>(View Only)</small></h2>
                <p class="pub-muted">Track the dispatch details, courier / transport information and delivery status</p>

                @if (d.Dispatches.Count == 0 && d.OutgoingTransfers.Count == 0)
                {
                    <EmptyState Icon="bi-truck" Title="Not dispatched yet" Message="Dispatch details appear here once the material is dispatched.">
                        @if (d.CanDispatch) { <a class="pub-btn pub-btn--primary" href="@($"/PublicityReview/{d.Id}/dispatch")">Create Dispatch</a> }
                    </EmptyState>
                }
                @for (var i = 0; i < d.Dispatches.Count; i++)
                {
                    var x = d.Dispatches[i];
                    if (x.Kind == PublicityDispatchKind.Transfer)
                    {
                        <PubTransferCard X="x" StartOpen="@(i == d.Dispatches.Count - 1 || d.Dispatches.Count < 3)">
                            <ProofActions>
                                @if (Api.IsDispatcher)
                                {
                                    @if (x.Status == PublicityDispatchStatus.ProofSubmitted)
                                    {
                                        <a class="pub-btn pub-btn--line-grey pub-btn--sm" href="@($"/PublicityReview/{d.Id}/transfer/{x.Id}/review")">Update Dispatch Details</a>
                                    }
                                    else
                                    {
                                        <button type="button" class="pub-btn pub-btn--line-grey pub-btn--sm" disabled>Update Dispatch Details</button>
                                    }
                                }
                            </ProofActions>
                        </PubTransferCard>
                    }
                    else
                    {
                        <PubDispatchCard X="x" D="d" Heading="@DispatchHeading(x, i)" StartOpen="@(i == d.Dispatches.Count - 1 || d.Dispatches.Count < 3)" ShowAck="false" />
                    }
                }

                @* Once a Stock Transfer OR a Re-Initiation dispatch exists for this request (either side),
                   its own card (PubTransferCard / PubDispatchCard, rendered in the loop above) already
                   shows its own current status - a second, generic "Exception Raised" read of the same
                   underlying Summary here would just repeat (and, worse, go stale next to) that dispatch's
                   own card: the old exception that dispatch was created to resolve is already being acted
                   on, so re-showing it as still "requiring action" here is misleading (2026-11-27 fix -
                   this previously only checked Transfer, so a Re-Initiation dispatch - the exact replacement
                   kind this bug was reported against - fell through and left the stale card visible). It
                   only still earns its own banner when there is a genuine, currently-actionable item for
                   THIS viewer (_ackTarget - "you personally have a delivered dispatch, original or
                   transfer, awaiting your acknowledgement") that isn't otherwise surfaced anywhere on this
                   tab. Nothing here changes d.Status/Summary.ExceptionStatus themselves (still computed by
                   SummaryAsync from the real Outstanding/acknowledgement state) or the Exception Handling
                   tab's own unconditional exception card below (tab=2) - so a FRESH exception raised on
                   THIS SAME replacement dispatch once it is acknowledged still shows there exactly as
                   before, and request completion still depends solely on that persisted state, never on
                   a replacement dispatch merely existing. *@
                @if (d.Dispatches.Count > 0 && (_ackTarget is not null || !(d.Dispatches.Any(x => x.Kind is PublicityDispatchKind.Transfer or PublicityDispatchKind.ReInitiation) || d.OutgoingTransfers.Count > 0)))
                {
                    // Full-width status banner only - the actual quantities/condition/remarks/evidence
                    // live exclusively in the Acknowledgement / Exception Handling tab (case 2 below);
                    // every value here is read straight from the same persisted request Status /
                    // Summary that tab itself is built from, never invented for display purposes.
                    // This is strictly about d.Dispatches (the ORIGINAL/ReInitiation dispatch(es) landing
                    // on THIS request) - rendered here, directly under that section and before any Stock
                    // Transfer cards below, so it is never mistaken for the transfer's own (separately
                    // tracked, independently Pending-until-acknowledged) status.
                    var anyAck = d.Dispatches.Any(x => x.Ack is { IsDraft: false });
                    var isPartial = d.Summary.Outstanding > 0 && d.Dispatches.Any(x => x.Kind != PublicityDispatchKind.Original && x.Ack is { IsDraft: false });
                    var isExcessPending = d.Status == PublicityStatus.ExcessVerificationPending || (d.Summary.Outstanding == 0 && d.Summary.Excess - d.Summary.TransferredOut > 0 && !d.Summary.ExcessVerified);
                    var isResolved = d.Summary.ExceptionStatus == "Resolved" || d.Status is PublicityStatus.ExceptionResolved or PublicityStatus.Completed;
                    string icon, heading, message, tone;
                    if (d.Status == PublicityStatus.Completed)
                    {
                        (icon, heading, tone) = ("bi-patch-check-fill", "Request Completed", "green");
                        message = d.Summary.ExcessVerified
                            ? "The material has been received and excess stock verified. It is now retained and available for future transfers."
                            : "The material has been successfully received and acknowledged. No shortage or damage was reported.";
                    }
                    else if (isExcessPending)
                    {
                        (icon, heading, tone) = ("bi-shield-check", "Excess Verification Pending", "amber");
                        message = "Shortage and damaged material fulfilled. Reported excess stock is awaiting verification by ADMIN-MD-CS.";
                    }
                    else if (isPartial)
                    {
                        (icon, heading, tone) = ("bi-hourglass-split", "Partially Resolved", "amber");
                        message = $"Some products have been fulfilled via replacement, but {d.Summary.Outstanding} Nos remain outstanding.";
                    }
                    else if (d.Summary.ExceptionStatus is "Raised" or "Reported" || d.Status == PublicityStatus.ExceptionRaised)
                    {
                        var isExcess = d.Summary.ExceptionType == "Excess";
                        (icon, heading, tone) = ("bi-exclamation-octagon-fill", isExcess ? "Excess Reported" : "Exception Raised", "red");
                        message = isExcess ? "Excess material was reported during acknowledgement." : "Shortage or damage was reported during acknowledgement.";
                    }
                    else if (isResolved)
                    {
                        (icon, heading, tone) = ("bi-patch-check-fill", "Exception Resolved", "green");
                        message = d.Summary.ExcessVerified
                            ? "The reported shortage/damage has been resolved and excess stock verified."
                            : "The reported shortage or damage has been resolved.";
                    }
                    else if (anyAck)
                    {
                        (icon, heading, tone) = ("bi-patch-check-fill", "Acknowledged", "green");
                        message = "Receipt confirmed by the assigned responsible employee.";
                    }
                    else if (_ackTarget is not null)
                    {
                        (icon, heading, tone) = ("bi-hourglass-split", "Acknowledgement Pending", "blue");
                        message = "Material delivery is awaiting receipt acknowledgement.";
                    }
                    else
                    {
                        (icon, heading, tone) = ("bi-hourglass-split", "Awaiting Acknowledgement", "blue");
                        message = "Material has been dispatched and is awaiting acknowledgement from the responsible receiving employee.";
                    }
                    <div class="pub-banner pub-banner--@tone">
                        <span class="pub-banner__icon"><i class="bi @icon"></i></span>
                        <div><h3>@heading</h3><p>@message</p></div>
                        @if (_ackTarget is not null)
                        {
                            <button type="button" class="pub-btn pub-btn--primary" @onclick="() => _tab = 2">Create Acknowledgement <i class="bi bi-arrow-right"></i></button>
                        }
                        else if (isExcessPending && d.CanResolve)
                        {
                            <a class="pub-btn pub-btn--primary" href="@($"/PublicityReview/{d.Id}/resolve-exception")">Verify Excess Stock <i class="bi bi-arrow-right"></i></a>
                        }
                        else if (isPartial && d.CanResolve)
                        {
                            <a class="pub-btn pub-btn--primary" href="@($"/PublicityReview/{d.Id}/resolve-exception")">Resolve Outstanding Items <i class="bi bi-arrow-right"></i></a>
                        }
                        else if (anyAck)
                        {
                            <button type="button" class="pub-btn pub-btn--line" @onclick="() => _tab = 2">View Acknowledgement <i class="bi bi-arrow-right"></i></button>
                        }
                    </div>
                }

                @for (var i = 0; i < d.OutgoingTransfers.Count; i++)
                {
                    var x = d.OutgoingTransfers[i];
                    <PubTransferSourceCard X="x" D="d" StartOpen="@(i == d.OutgoingTransfers.Count - 1 || d.OutgoingTransfers.Count < 3)" />
                }

                break;

            case 2:
                <h2 class="pub-h2">Acknowledgement</h2>
                <p class="pub-muted">Receipt confirmation for every dispatch of this request</p>

                @if (_ackTarget is not null)
                {
                    var x = _ackTarget;
                    <section class="pub-card">
                        <h2 class="pub-h2">Dispatch Summary</h2>
                        <div class="pub-grid pub-grid--5">
                            <PubInfo Label="Dispatch ID" Value="@x.DispatchNo" />
                            <PubInfo Label="Dispatch Date" Value="@PubText.Date(x.DispatchDate)" />
                            @if (IsMultiItemAck)
                            {
                                <PubInfo Label="Products" Tone="green" Value="@($"{x.Items.Count} Products")" />
                                <PubInfo Label="Total Dispatch Quantity" Value="@($"{x.Quantity} Nos")" />
                            }
                            else
                            {
                                <PubInfo Label="Product / Material" Value="@(!string.IsNullOrWhiteSpace(x.Product) ? x.Product : (x.Items.Count == 1 ? x.Items[0].ProductName : d.Product))" Sub="@(x.Material ?? d.Material)" />
                                <PubInfo Label="Dispatch Quantity" Value="@($"{x.Quantity} Nos")" />
                            }
                            <PubInfo Label="Expected Delivery" Value="@PubText.Date(x.ExpectedDeliveryDate ?? x.DeliveredAt)" />
                        </div>

                        @if (!IsMultiItemAck)
                        {
                            <h2 class="pub-h2">Acknowledgement Details</h2>
                            <div class="pub-form pub-form--3">
                                <div class="pub-field">
                                    <label class="pub-label pub-req" for="ack-qty">Quantity Received</label>
                                    <input id="ack-qty" type="number" min="0" class="pub-input" @bind="_ack.ReceivedQty" @bind:event="oninput" />
                                </div>
                                <div class="pub-field">
                                    <span class="pub-label pub-req">Material Condition</span>
                                    <div class="pub-radios">
                                        <label class="pub-radio @(!_ack.IsDamaged ? "is-good" : "")"><input type="radio" name="cond" checked="@(!_ack.IsDamaged)" @onchange="() => _ack.IsDamaged = false" /> In Good Condition</label>
                                        <label class="pub-radio @(_ack.IsDamaged ? "is-bad" : "")"><input type="radio" name="cond" checked="@_ack.IsDamaged" @onchange="() => _ack.IsDamaged = true" /> In Damaged Condition</label>
                                    </div>
                                </div>
                                @if (_ack.IsDamaged)
                                {
                                    <div class="pub-field">
                                        <label class="pub-label pub-req" for="ack-dmg">Damaged Quantity</label>
                                        <input id="ack-dmg" type="number" min="1" class="pub-input" @bind="_ack.DamagedQty" @bind:event="oninput" />
                                    </div>
                                }
                                <div class="pub-field">
                                    <label class="pub-label pub-req">Acknowledged By</label>
                                    @* Always the authenticated user - the server ignores any client-supplied acknowledger
                                       id and records Uid()/MyNameAsync() regardless, so this is never a choice. *@
                                    <div class="pub-remarks">@(_lookups?.MyName ?? "-")</div>
                                </div>
                                <div class="pub-field pub-field--wide">
                                    <label class="pub-label" for="ack-rem">Remarks</label>
                                    <input id="ack-rem" class="pub-input" placeholder="Received 90 posters, out of which 5 posters are damaged." @bind="_ack.Remarks" />
                                </div>
                            </div>
                            <PubDrop @bind-Files="_ackFiles" Title="Drag &amp; drop images or click to upload" />
                        }
                        else
                        {
                            <div class="pub-ack-table">
                                <SpicDataTable TItem="PubDispatchItemDto"
                                               Items="x.Items"
                                               Title="Product Acknowledgement"
                                               FileName="ProductAcknowledgement"
                                               InitialPageSize="10"
                                               PageSizeOptions="new[] { 10, 25, 50, 100 }"
                                               ShowEntriesText="true"
                                               EmptyTitle="No products"
                                               EmptyMessage="This request has no line items.">
                                    <FilterControls>
                                        <p class="pub-muted">This request has multiple products - acknowledge each one separately, with its own supporting proof if needed.</p>
                                    </FilterControls>
                                    <TableHeader>
                                        <th>S.No</th>
                                        <th>Product</th>
                                        <th>Dispatched Qty</th>
                                        <th class="pub-req">Received Quantity</th>
                                        <th class="pub-req">Material Condition</th>
                                        <th>Shortage</th>
                                        <th>Excess</th>
                                        <th>Damaged Quantity</th>
                                        <th>Remarks</th>
                                        <th>Upload Proof</th>
                                    </TableHeader>
                                    <TableRow Context="item">
                                        <td>@(x.Items.IndexOf(item) + 1)</td>
                                        <td><b>@item.ProductName</b></td>
                                        <td>@item.DispatchedQty Nos</td>
                                        <td><input type="number" min="0" class="pub-input" @bind="item.ReceivedQty" @bind:event="oninput" /></td>
                                        <td>
                                            <div class="pub-radios">
                                                <label class="pub-radio @(!item.IsDamaged ? "is-good" : "")"><input type="radio" name="@($"cond-{item.RequestItemId}")" checked="@(!item.IsDamaged)" @onchange="() => { item.IsDamaged = false; item.DamagedQty = 0; }" /> Good</label>
                                                <label class="pub-radio @(item.IsDamaged ? "is-bad" : "")"><input type="radio" name="@($"cond-{item.RequestItemId}")" checked="@item.IsDamaged" @onchange="() => item.IsDamaged = true" /> Damaged</label>
                                            </div>
                                        </td>
                                        <td>@item.ShortageQty Nos</td>
                                        <td>@item.ExcessQty Nos</td>
                                        <td>
                                            @if (item.IsDamaged)
                                            {
                                                <input type="number" min="1" class="pub-input" @bind="item.DamagedQty" @bind:event="oninput" />
                                            }
                                            else { <span class="pub-muted">-</span> }
                                        </td>
                                        <td><input class="pub-input" placeholder="Remarks" @bind="item.Remarks" /></td>
                                        <td>
                                            <label class="pub-btn pub-btn--line pub-btn--sm" style="cursor:pointer">
                                                Upload Proof
                                                <InputFile style="display:none" accept="@PublicityApi.Accept" OnChange="e => PickItemProofAsync(item, e)" />
                                            </label>
                                            @foreach (var f in ItemProofFiles(item))
                                            {
                                                <div class="pub-chip">
                                                    <i class="bi bi-paperclip"></i> @f.FileName
                                                    <a href="@Api.FileUrl(f.Path)" target="_blank" rel="noopener" title="Preview"><i class="bi bi-eye"></i></a>
                                                    <button type="button" aria-label="Remove @f.FileName" @onclick="() => RemoveItemProofAsync(item, f)"><i class="bi bi-x"></i></button>
                                                </div>
                                            }
                                        </td>
                                    </TableRow>
                                    <CardTemplate Context="item">
                                        <header class="spic-card-head"><h4 class="spic-card-title">@item.ProductName</h4></header>
                                        <div class="pub-form pub-form--2">
                                            <div class="pub-field">
                                                <span class="pub-label">Dispatched Qty</span>
                                                <div class="pub-remarks">@item.DispatchedQty Nos</div>
                                            </div>
                                            <div class="pub-field">
                                                <label class="pub-label pub-req">Received Quantity</label>
                                                <input type="number" min="0" class="pub-input" @bind="item.ReceivedQty" @bind:event="oninput" />
                                            </div>
                                            <div class="pub-field pub-field--wide">
                                                <span class="pub-label pub-req">Material Condition</span>
                                                <div class="pub-radios">
                                                    <label class="pub-radio @(!item.IsDamaged ? "is-good" : "")"><input type="radio" name="@($"cond-m-{item.RequestItemId}")" checked="@(!item.IsDamaged)" @onchange="() => { item.IsDamaged = false; item.DamagedQty = 0; }" /> Good</label>
                                                    <label class="pub-radio @(item.IsDamaged ? "is-bad" : "")"><input type="radio" name="@($"cond-m-{item.RequestItemId}")" checked="@item.IsDamaged" @onchange="() => item.IsDamaged = true" /> Damaged</label>
                                                </div>
                                            </div>
                                            @if (item.IsDamaged)
                                            {
                                                <div class="pub-field">
                                                    <label class="pub-label pub-req">Damaged Quantity</label>
                                                    <input type="number" min="1" class="pub-input" @bind="item.DamagedQty" @bind:event="oninput" />
                                                </div>
                                            }
                                            <div class="pub-field">
                                                <span class="pub-label">Shortage</span>
                                                <div class="pub-remarks">@item.ShortageQty Nos</div>
                                            </div>
                                            <div class="pub-field">
                                                <span class="pub-label">Excess</span>
                                                <div class="pub-remarks">@item.ExcessQty Nos</div>
                                            </div>
                                            <div class="pub-field pub-field--wide">
                                                <label class="pub-label">Remarks</label>
                                                <input class="pub-input" placeholder="Remarks" @bind="item.Remarks" />
                                            </div>
                                            <div class="pub-field pub-field--wide">
                                                <span class="pub-label">Upload Proof</span>
                                                <label class="pub-btn pub-btn--line" style="cursor:pointer">
                                                    Upload Proof
                                                    <InputFile style="display:none" accept="@PublicityApi.Accept" OnChange="e => PickItemProofAsync(item, e)" />
                                                </label>
                                                @foreach (var f in ItemProofFiles(item))
                                                {
                                                    <div class="pub-chip">
                                                        <i class="bi bi-paperclip"></i> @f.FileName
                                                        <a href="@Api.FileUrl(f.Path)" target="_blank" rel="noopener" title="Preview"><i class="bi bi-eye"></i></a>
                                                        <button type="button" aria-label="Remove @f.FileName" @onclick="() => RemoveItemProofAsync(item, f)"><i class="bi bi-x"></i></button>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </CardTemplate>
                                </SpicDataTable>
                                <p class="pub-muted">Upload Proof accepts PDF, JPG, PNG, DOC or DOCX files up to 10 MB each.</p>
                            </div>
                        }
                    </section>

                    @if (AckShortage > 0 || AckDamaged > 0 || AckExcess > 0)
                    {
                        <section class="pub-card pub-card--danger">
                            <h2 class="pub-h2"><i class="bi bi-exclamation-circle pub-text-red"></i> Exception Summary</h2>
                            <p class="pub-muted">Auto detected from the quantities entered above</p>
                            <div class="pub-grid pub-grid--3">
                                <PubInfo Label="Exception Type" Tone="pink" Value="@AckType" Sub="Auto detected" />
                                @if (AckShortage > 0) { <PubInfo Label="Total Shortage Quantity" Value="@($"{AckShortage} Nos")" Sub="Auto calculated" /> }
                                @if (AckExcess > 0) { <PubInfo Label="Total Excess Quantity" Value="@($"{AckExcess} Nos")" Sub="Auto calculated" /> }
                                @if (AckDamaged > 0) { <PubInfo Label="Total Damaged Quantity" Value="@($"{AckDamaged} Nos")" Sub="Auto calculated" /> }
                                @if (IsMultiItemAck)
                                {
                                    <PubInfo Label="Total Products" Value="@AckTotalProducts.ToString()" />
                                    <PubInfo Label="Products With Exceptions" Value="@AckProductsWithExceptions.ToString()" />
                                }
                            </div>
                        </section>
                    }
                    else if (IsMultiItemAck)
                    {
                        <div class="pub-banner pub-banner--green">
                            <span class="pub-banner__icon"><i class="bi bi-check-circle"></i></span>
                            <div><h3>No Exception</h3><p>Every product is in good condition with no shortage, excess, or damage.</p></div>
                        </div>
                    }

                    <div class="pub-banner pub-banner--amber">
                        <span class="pub-banner__icon"><i class="bi bi-info-circle"></i></span>
                        <div><h3>After Submission</h3>
                            <p>@(AckShortage > 0 || AckDamaged > 0 ? "Your acknowledgement will be recorded. Since there is a shortage / damage, an exception is created and sent to the ADMIN - MD CS." : "Your acknowledgement will be recorded. Any shortage, excess or damage reported is sent to the admin for further action.")</p></div>
                    </div>

                    <div class="pub-footer">
                        <span class="pub-footer__gap"></span>
                        <button type="button" class="pub-btn pub-btn--grey" disabled="@_busy" @onclick="() => SaveAckAsync(false)">Save as Draft</button>
                        <button type="button" class="pub-btn pub-btn--primary" disabled="@_busy" @onclick="() => SaveAckAsync(true)">Submit Acknowledgement <i class="bi bi-chevron-double-right"></i></button>
                    </div>
                }

                @for (var i = 0; i < d.Dispatches.Count; i++)
                {
                    var x = d.Dispatches[i];
                    // The dispatch whose form is rendered above (the one THIS viewer is personally
                    // the assigned Responsible Person for, awaiting their own action) would otherwise
                    // show its dispatch context twice - once in the form's own Dispatch Summary, once
                    // here. Skipped only for that exact dispatch, not by role: once it's acknowledged
                    // _ackTarget goes back to null (CanAcknowledge is false once Acknowledged), so the
                    // card reappears read-only here to show what was submitted - for the responsible
                    // employee themselves and for every other viewer (ADMIN-MD CS included) the same
                    // way it always has.
                    if (_ackTarget is not null && x.Id == _ackTarget.Id) continue;
                    var a = x.Ack is { IsDraft: false } ? x.Ack : null;
                    <section class="pub-card pub-card--flush">
                        <div class="pub-card__band pub-band--green">
                            <div class="pub-collapse__title">
                                <h2 class="pub-h2">Acknowledgement @(i + 1) <small>- @PubText.Kind(x.Kind)</small></h2>
                                @if (a is not null) { <PubPill Text="@(a.ExceptionType == "None" ? "Acknowledgement Completed" : $"Exception Raised ({a.ExceptionType})")" Tone="@(a.ExceptionType == "None" ? "green" : "red")" /> }
                                else { <PubPill Text="@PubText.DispatchStatus(x.Status, x.Kind)" Tone="blue" /> }
                            </div>
                            <PubPill Text="@(x.DeliveredAt is null ? "In Transit" : $"Delivered on {PubText.DateTime(x.DeliveredAt)}")" Tone="@(x.DeliveredAt is null ? "amber" : "green")" />
                        </div>
                        <div class="pub-card__body">
                            <div class="pub-grid pub-grid--5">
                                <PubInfo Label="@(x.Kind == PublicityDispatchKind.Transfer ? "Transfer ID" : "Dispatch ID")" Value="@x.DispatchNo" />
                                <PubInfo Label="Dispatch Date" Value="@PubText.Date(x.DispatchDate)" />
                                @if (x.Items.Count > 1)
                                {
                                    <PubInfo Label="Products" Tone="green" Value="@($"{x.Items.Count} Products")" />
                                }
                                else
                                {
                                    <PubInfo Label="Product / Material" Tone="green" Value="@(!string.IsNullOrWhiteSpace(x.Product) ? x.Product : (x.Items.Count == 1 ? x.Items[0].ProductName : d.Product))" Sub="@(x.Material ?? d.Material)" />
                                }
                                <PubInfo Label="Dispatch Quantity" Value="@($"{x.Quantity} Nos")" Sub="@(x.Kind == PublicityDispatchKind.Original ? null : "(Replacement Quantity)")" />
                                <PubInfo Label="Responsible Person" Value="@(x.ResponsibleName ?? x.CreatedByName)" Sub="@x.ResponsibleRole" />
                            </div>
                            @if (a is null)
                            {
                                <div class="pub-banner pub-banner--amber">
                                    <span class="pub-banner__icon"><i class="bi bi-info-circle"></i></span>
                                    <div><h3>Awaiting Delivery</h3><p>The material (@x.Quantity Nos) is on its way. The acknowledgement is available after it is delivered and received.</p></div>
                                </div>
                            }
                            else
                            {
                                @* Product-wise acknowledgement (Specific Product, multi-item requests only - 2026-11-27).
                                   x.Items is THIS dispatch's own per-product breakdown (already populated by
                                   PublicityController.DispatchDtoAsync for every dispatch, original/re-initiation/
                                   transfer alike), so each dispatch's read-only card here only ever shows the
                                   products and quantities that actually belong to IT - never another dispatch's. *@
                                @if (x.Items.Count > 1)
                                {
                                    <div class="pub-ack-table">
                                        <SpicDataTable TItem="PubDispatchItemDto"
                                                       Items="x.Items"
                                                       Title="Product-Wise Acknowledgement Details"
                                                       FileName="ProductAcknowledgement"
                                                       ExportColumns="ReadOnlyAckExportColumns()"
                                                       InitialPageSize="10"
                                                       PageSizeOptions="new[] { 10, 25, 50, 100 }"
                                                       ShowEntriesText="true"
                                                       EmptyTitle="No products"
                                                       EmptyMessage="This request has no line items.">
                                            <TableHeader>
                                                <th>S.No</th>
                                                <th>Product</th>
                                                <th>Dispatched</th>
                                                <th>Received</th>
                                                <th>Shortage</th>
                                                <th>Excess</th>
                                                <th>Damaged</th>
                                                <th>Condition</th>
                                                <th>Remarks</th>
                                            </TableHeader>
                                            <TableRow Context="pitem">
                                                <td>@(x.Items.IndexOf(pitem) + 1)</td>
                                                <td><b>@pitem.ProductName</b></td>
                                                <td>@pitem.DispatchedQty Nos</td>
                                                <td>@pitem.ReceivedQty Nos</td>
                                                <td>@(pitem.ShortageQty > 0 ? $"{pitem.ShortageQty} Nos" : "-")</td>
                                                <td>@(pitem.ExcessQty > 0 ? $"{pitem.ExcessQty} Nos" : "-")</td>
                                                <td>@(pitem.DamagedQty > 0 ? $"{pitem.DamagedQty} Nos" : "-")</td>
                                                <td><PubPill Text="@(pitem.IsDamaged ? "Damaged" : "Good")" Tone="@(pitem.IsDamaged ? "red" : "green")" /></td>
                                                <td>@(string.IsNullOrWhiteSpace(pitem.Remarks) ? "-" : pitem.Remarks)</td>
                                            </TableRow>
                                            <CardTemplate Context="pitem">
                                                <header class="spic-card-head"><h4 class="spic-card-title">@pitem.ProductName</h4></header>
                                                <dl class="spic-card-rows">
                                                    <div class="spic-card-row"><dt>Dispatched</dt><dd>@pitem.DispatchedQty Nos</dd></div>
                                                    <div class="spic-card-row"><dt>Received</dt><dd>@pitem.ReceivedQty Nos</dd></div>
                                                    @if (pitem.ShortageQty > 0) { <div class="spic-card-row"><dt>Shortage</dt><dd>@pitem.ShortageQty Nos</dd></div> }
                                                    @if (pitem.ExcessQty > 0) { <div class="spic-card-row"><dt>Excess</dt><dd>@pitem.ExcessQty Nos</dd></div> }
                                                    @if (pitem.DamagedQty > 0) { <div class="spic-card-row"><dt>Damaged</dt><dd>@pitem.DamagedQty Nos</dd></div> }
                                                    <div class="spic-card-row"><dt>Condition</dt><dd><PubPill Text="@(pitem.IsDamaged ? "Damaged" : "Good")" Tone="@(pitem.IsDamaged ? "red" : "green")" /></dd></div>
                                                    @if (!string.IsNullOrWhiteSpace(pitem.Remarks)) { <div class="spic-card-row"><dt>Remarks</dt><dd>@pitem.Remarks</dd></div> }
                                                </dl>
                                            </CardTemplate>
                                        </SpicDataTable>
                                    </div>
                                }
                                <div>
                                    <h3 class="pub-h3">@(x.Items.Count > 1 ? "Overall Acknowledgement Summary" : "Acknowledgement Details")</h3>
                                    <div class="pub-grid pub-grid--5">
                                        @if (x.Items.Count > 1)
                                        {
                                            <PubInfo Label="Total Dispatched Quantity" Value="@($"{x.Items.Sum(i => i.DispatchedQty)} Nos")" />
                                            <PubInfo Label="Total Received Quantity" Tone="green" Value="@($"{a.ReceivedQty} Nos")" />
                                            <PubInfo Label="Total Shortage Quantity" Tone="pink" Value="@($"{a.ShortageQty} Nos")" />
                                            <PubInfo Label="Total Excess Quantity" Tone="pink" Value="@($"{a.ExcessQty} Nos")" />
                                            <PubInfo Label="Total Damaged Quantity" Tone="pink" Value="@($"{a.DamagedQty} Nos")" />
                                        }
                                        else
                                        {
                                            <PubInfo Label="Received Quantity" Tone="green" Value="@($"{a.ReceivedQty} Nos")" />
                                            <PubInfo Label="@(a.ExcessQty > 0 ? "Excess Quantity" : "Shortage Quantity")" Tone="pink" Value="@($"{(a.ExcessQty > 0 ? a.ExcessQty : a.ShortageQty)} Nos")" />
                                            <PubInfo Label="Material Condition" Tone="pink" Value="@(a.IsDamaged ? "Damaged" : "Good Condition")" />
                                            <PubInfo Label="Damaged Quantity" Tone="pink" Value="@($"{a.DamagedQty} Nos")" />
                                        }
                                        <PubInfo Label="Status" Tone="pink"><PubPill Text="@(a.ExceptionType == "None" ? "Acknowledgement Completed" : "Exception Raised")" Tone="@(a.ExceptionType == "None" ? "green" : "red")" /></PubInfo>
                                        <PubInfo Label="Submitted By" Tone="green" Value="@a.AcknowledgedByName" Sub="RMDO" />
                                        <PubInfo Label="Received On" Tone="pink" Value="@PubText.DateTime(a.SubmittedAt)" />
                                        <div class="pub-grid__wide"><span class="pub-info__label">Remarks</span><b class="pub-info__value pub-info__value--sm">@(a.Remarks ?? "-")</b></div>
                                    </div>
                                    @{ var photos = x.Files.Where(f => f.Kind == PublicityFileKind.AckPhoto).ToList(); }
                                    <span class="pub-label">Uploaded Photos (@photos.Count)</span>
                                    <div class="pub-photos">
                                        @foreach (var p in photos)
                                        {
                                            <a class="pub-photo" href="@Api.FileUrl(p.Path)" target="_blank" rel="noopener" title="@p.FileName">
                                                @if (PubText.IsImage(p.FileName)) { <img src="@Api.FileUrl(p.Path)" alt="@p.FileName" loading="lazy" /> } else { <i class="bi bi-file-earmark"></i> }
                                                <span class="pub-photo__eye"><i class="bi bi-eye"></i></span>
                                            </a>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </section>
                }

                @if (IsExcessPendingTab)
                {
                    <section class="pub-card pub-card--flush">
                        <div class="pub-card__band pub-band--amber">
                            <div class="pub-collapse__title">
                                <h2 class="pub-h2 pub-text-amber">Excess Verification Pending</h2>
                                <span class="pub-muted">Shortage and damaged material fulfilled. Reported excess stock is awaiting verification by ADMIN-MD-CS.</span>
                            </div>
                            <div style="display: flex; align-items: center; gap: 10px;">
                                <PubPill Text="Verification Required" Tone="amber" />
                                @if (d.CanResolve)
                                {
                                    <a class="pub-btn pub-btn--primary" href="@($"/PublicityReview/{d.Id}/resolve-exception")">Verify Excess Stock <i class="bi bi-arrow-right"></i></a>
                                }
                            </div>
                        </div>
                        <div class="pub-grid pub-grid--3">
                            <PubInfo Label="Exception Type">
                                <PubPill Text="Excess" Tone="amber" />
                            </PubInfo>
                            <PubInfo Label="Raised By" Tone="green" Value="@d.ExceptionRaisedBy" />
                            <PubInfo Label="Raised On" Value="@PubText.DateTime(d.ExceptionRaisedAt)" />
                            <div class="pub-grid__wide"><span class="pub-info__label">Remarks</span><b class="pub-info__value pub-info__value--sm">@(d.ExceptionRemarks ?? "-")</b></div>
                            @if (d.Items.Count > 1)
                            {
                                var refs = ExceptionProductRefs().ToList();
                                if (refs.Count > 0)
                                {
                                    <div class="pub-grid__wide">
                                        <span class="pub-info__label">Product Breakdown</span>
                                        @foreach (var r in refs)
                                        {
                                            <div class="pub-muted"><b>@r.Product</b> &ndash; @r.Label: @r.Qty Nos</div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </section>
                }
                else if (IsPartialTab)
                {
                    <section class="pub-card pub-card--flush">
                        <div class="pub-card__band pub-band--amber">
                            <div class="pub-collapse__title">
                                <h2 class="pub-h2 pub-text-amber">Exception Handling (Partially Resolved)</h2>
                                <span class="pub-muted">Some products have been fulfilled via replacement, but @d.Summary.Outstanding Nos remain outstanding.</span>
                            </div>
                            <div style="display: flex; align-items: center; gap: 10px;">
                                <PubPill Text="Partially Resolved" Tone="amber" />
                                @if (d.CanResolve && d.Summary.Outstanding > 0)
                                {
                                    <a class="pub-btn pub-btn--primary" href="@($"/PublicityReview/{d.Id}/resolve-exception")">Resolve Outstanding Items <i class="bi bi-arrow-right"></i></a>
                                }
                            </div>
                        </div>
                        <div class="pub-grid pub-grid--3">
                            <PubInfo Label="Exception Type">
                                @foreach (var t in d.Summary.ExceptionType.Split(" + ")) { <PubPill Text="@t" Tone="amber" /> }
                            </PubInfo>
                            <PubInfo Label="Raised By" Tone="green" Value="@d.ExceptionRaisedBy" />
                            <PubInfo Label="Raised On" Value="@PubText.DateTime(d.ExceptionRaisedAt)" />
                            <div class="pub-grid__wide"><span class="pub-info__label">Remarks</span><b class="pub-info__value pub-info__value--sm">@(d.ExceptionRemarks ?? "-")</b></div>
                            @if (d.Items.Count > 1)
                            {
                                var refs = ExceptionProductRefs().ToList();
                                if (refs.Count > 0)
                                {
                                    <div class="pub-grid__wide">
                                        <span class="pub-info__label">Product Breakdown</span>
                                        @foreach (var r in refs)
                                        {
                                            <div class="pub-muted"><b>@r.Product</b> &ndash; @r.Label: @r.Qty Nos</div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </section>
                }
                else if (IsResolvedTab)
                {
                    <section class="pub-card pub-card--flush">
                        <div class="pub-card__band pub-band--green">
                            <div class="pub-collapse__title">
                                <h2 class="pub-h2 pub-text-green">Exception Resolved</h2>
                                <span class="pub-muted">All reported shortages and damages have been successfully fulfilled. Exception is resolved.</span>
                            </div>
                            <PubPill Text="Resolved" Tone="green" />
                        </div>
                        <div class="pub-grid pub-grid--3">
                            <PubInfo Label="Exception Status">
                                <PubPill Text="Resolved" Tone="green" />
                            </PubInfo>
                            <PubInfo Label="Raised By" Tone="pink" Value="@d.ExceptionRaisedBy" Sub="@PubText.DateTime(d.ExceptionRaisedAt)" />
                            <PubInfo Label="Resolved On" Tone="green" Value="@PubText.DateTime(d.ExceptionResolvedAt ?? d.Summary.ExcessVerifiedAt ?? d.UpdatedAt ?? d.CreatedAt)" Sub="@(d.ExceptionResolvedBy ?? "ADMIN-MD CS")" />
                            <div class="pub-grid__wide"><span class="pub-info__label">Resolution History</span><b class="pub-info__value pub-info__value--sm">@(d.ExceptionResolvedRemarks ?? d.ExceptionRemarks ?? "Resolved with replacement / stock transfer.")</b></div>
                            @if (d.Items.Count > 1)
                            {
                                var refs = ExceptionProductRefs().ToList();
                                if (refs.Count > 0)
                                {
                                    <div class="pub-grid__wide">
                                        <span class="pub-info__label">Fulfilled Products</span>
                                        @foreach (var r in refs)
                                        {
                                            <div class="pub-muted"><b>@r.Product</b> &ndash; @r.Label: @r.Qty Nos (Fulfilled)</div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </section>
                    @if (d.Summary.ExcessVerified)
                    {
                        <section class="pub-card pub-card--flush mt-3">
                            <div class="pub-card__band pub-band--green">
                                <div><h2 class="pub-h2 pub-text-green">Excess Stock Verified</h2><span class="pub-muted">Reported excess stock verified by @(d.Summary.ExcessVerifiedByName ?? "ADMIN-MD-CS") on @PubText.DateTime(d.Summary.ExcessVerifiedAt). Material retained at @d.Hq and available for future transfers.</span></div>
                                <PubPill Text="Verified &amp; Available" Tone="green" />
                            </div>
                            <div class="pub-grid pub-grid--3">
                                <PubInfo Label="Exception Type">
                                    <PubPill Text="Excess" Tone="green" />
                                </PubInfo>
                                <PubInfo Label="Verified By" Tone="green" Value="@(d.Summary.ExcessVerifiedByName ?? "ADMIN-MD-CS")" />
                                <PubInfo Label="Verified On" Value="@PubText.DateTime(d.Summary.ExcessVerifiedAt)" />
                                <div class="pub-grid__wide"><span class="pub-info__label">Holding HQ</span><b class="pub-info__value pub-info__value--sm">@d.Hq (@d.Region, @d.State)</b></div>
                            </div>
                        </section>
                    }
                }
                else if (d.Summary.ExceptionStatus is "Raised" or "Reported" || d.Status == PublicityStatus.ExceptionRaised)
                {
                    <section class="pub-card pub-card--flush">
                        <div class="pub-card__band pub-band--red">
                            <div class="pub-collapse__title">
                                <h2 class="pub-h2 pub-text-red">@(d.Summary.ExceptionType == "Excess" ? "Excess Reported" : "Exception Raised")</h2>
                                <span class="pub-muted">@d.Summary.ExceptionType reported in the acknowledgement.</span>
                            </div>
                            @* A shortage/damage requirement (Outstanding) and a leftover excess-stock
                               transfer-out obligation are both resolved through this same page - once
                               the shortage side is fully replaced, the request can already read as
                               effectively complete (ExceptionResolved) while excess still needs acting on. *@
                            @if (d.CanResolve && (d.Summary.Outstanding > 0 || (d.Summary.Excess - d.Summary.TransferredOut > 0 && !d.Summary.ExcessVerified)))
                            {
                                <a class="pub-btn pub-btn--primary" href="@($"/PublicityReview/{d.Id}/resolve-exception")">
                                    @(d.Summary.Outstanding == 0 && d.Summary.Excess > 0 ? "Verify Excess Stock" : "Resolve Exception") <i class="bi bi-arrow-right"></i>
                                </a>
                            }
                        </div>
                        <div class="pub-grid pub-grid--3">
                            <PubInfo Label="Exception Type">
                                @foreach (var t in d.Summary.ExceptionType.Split(" + ")) { <PubPill Text="@t" Tone="red" /> }
                            </PubInfo>
                            <PubInfo Label="Raised By" Tone="green" Value="@d.ExceptionRaisedBy" />
                            <PubInfo Label="Raised On" Value="@PubText.DateTime(d.ExceptionRaisedAt)" />
                            <div class="pub-grid__wide"><span class="pub-info__label">Remarks</span><b class="pub-info__value pub-info__value--sm">@(d.ExceptionRemarks ?? "-")</b></div>
                            @if (d.Items.Count > 1)
                            {
                                var refs = ExceptionProductRefs().ToList();
                                if (refs.Count > 0)
                                {
                                    <div class="pub-grid__wide">
                                        <span class="pub-info__label">Affected Products</span>
                                        @foreach (var r in refs)
                                        {
                                            <div class="pub-muted"><b>@r.Product</b> &ndash; @r.Label: @r.Qty Nos</div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </section>
                }

                @if (d.Dispatches.All(x => x.Ack is not { IsDraft: false }) && _ackTarget is null)
                {
                    <EmptyState Icon="bi-inbox" Title="No acknowledgement yet" Message="Acknowledgements appear here once the material is received." />
                }
                break;

            default:
                <section class="pub-card">
                    <h2 class="pub-h2">Related Documents</h2>
                    @foreach (var g in d.Files.GroupBy(f => f.Kind))
                    {
                        <h3 class="pub-h3">@PubText.FileKind(g.Key)</h3>
                        <PubDocs Files="g.ToList()" />
                    }
                    @if (d.Files.Count == 0) { <EmptyState Icon="bi-folder2-open" Title="No documents" Message="Files uploaded during the request, dispatch and acknowledgement appear here." /> }
                </section>
                break;
        }

        <BottomSheet @bind-IsOpen="_reviewOpen" Title="Reject Request" Subtitle="@($"{d.IndentNo} is rejected and closed - this cannot be undone.")">
            <ChildContent>
                <div class="pub-field"><label class="pub-label pub-req" for="rv-rem">Reason for rejection</label>
                    <textarea id="rv-rem" rows="5" class="pub-input pub-textarea" @bind="_reviewRemarks" placeholder="Explain why this request is being rejected"></textarea></div>
            </ChildContent>
            <Footer>
                <button type="button" class="pub-btn pub-btn--grey" @onclick="() => _reviewOpen = false">Cancel</button>
                <button type="button" class="pub-btn pub-btn--danger" disabled="@_busy" @onclick="RejectAsync">Reject</button>
            </Footer>
        </BottomSheet>

    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private string[] Tabs => new[] { "Request Details & History", "Tracking & Delivery", Review ? "Exception Handling" : "Acknowledgement", "Related Documents" };
    private bool Review => Nav.ToBaseRelativePath(Nav.Uri).StartsWith("PublicityReview", StringComparison.OrdinalIgnoreCase);
    private bool FromConsolidation => Nav.Uri.Contains("back=consolidation");
    private string BackUrl => FromConsolidation ? "/PublicityReview/consolidation" : Api.Home;
    private string BackLabel => FromConsolidation ? "Consolidation" : "List";
    /// <summary>A reviewer looking at a request that is not waiting for them (SMM "Request Details").</summary>
    private bool ReadOnlyReviewer => Review && _d is { CanReview: false, CanDispatch: false, CanResolve: false };
    private string Subtitle => _d is { CanReview: true } ? $"Review the request details, edit if required and approve to forward to {PubText.Next(_d.Stage)}"
        : ReadOnlyReviewer ? "View complete details, approval history and current status of the publicity material request."
        : "View complete details, approval history, tracking and documents.";
    private PubDetailDto? _d;
    private PubLookupsDto? _lookups;
    private int _tab;
    private bool _busy;

    private PubDispatchDto? _ackTarget;
    private PubAckUpsertDto _ack = new();
    private List<IBrowserFile> _ackFiles = new();

    private bool _reviewOpen;
    private string? _reviewRemarks;

    // Specific Product requests uploaded with multiple line items (PublicityForm's Excel bulk import)
    // get the product-wise table below instead of the single Quantity Received/Material Condition
    // fields - General Product, Gift Articles, and single-item Specific Product requests never have
    // more than one PubDispatchDto.Items row (see PublicityController.DispatchDtoAsync), so this is
    // false for every one of them and they keep the original single-field form unchanged.
    private bool IsMultiItemAck => _ackTarget is { Items.Count: > 1 };
    private bool IsExcessPendingTab => _d is not null && (_d.Status == PublicityStatus.ExcessVerificationPending || (_d.Summary.Outstanding == 0 && _d.Summary.Excess - _d.Summary.TransferredOut > 0 && !_d.Summary.ExcessVerified));
    private bool IsPartialTab => _d is not null && _d.Summary.Outstanding > 0 && _d.Dispatches.Any(x => x.Kind != PublicityDispatchKind.Original && x.Ack is { IsDraft: false });
    private bool IsResolvedTab => _d is not null && (_d.Summary.ExceptionStatus == "Resolved" || _d.Status is PublicityStatus.ExceptionResolved or PublicityStatus.Completed)
        && (_d.ExceptionRaisedAt != null || _d.Summary.ExcessVerified || _d.Dispatches.Any(x => x.Ack?.ExceptionType != "None"));
    private int AckShortage => _ackTarget is null ? 0 : IsMultiItemAck ? _ackTarget.Items.Sum(i => i.ShortageQty) : Math.Max(0, _ackTarget.Quantity - _ack.ReceivedQty);
    private int AckExcess => _ackTarget is null ? 0 : IsMultiItemAck ? _ackTarget.Items.Sum(i => i.ExcessQty) : Math.Max(0, _ack.ReceivedQty - _ackTarget.Quantity);
    private int AckDamaged => IsMultiItemAck ? _ackTarget!.Items.Sum(i => i.DamagedQty) : (_ack.IsDamaged ? _ack.DamagedQty : 0);
    private string AckType => string.Join(" + ", new[] { AckShortage > 0 ? "Shortage" : null, AckExcess > 0 ? "Excess" : null, AckDamaged > 0 ? "Damage" : null }.Where(x => x != null));

    // ---- product-wise exception breakdown (Specific Product, multi-item requests only) ----------
    // All four of these read directly from _ackTarget.Items - the FULL set of product rows, never
    // just the current SpicDataTable page - so pagination on the acknowledgement table above can
    // never under/over-count these totals.
    private int AckTotalProducts => IsMultiItemAck ? _ackTarget!.Items.Count : 0;
    private int AckProductsWithExceptions => IsMultiItemAck
        ? _ackTarget!.Items.Count(i => i.ShortageQty > 0 || i.ExcessQty > 0 || i.DamagedQty > 0)
        : 0;

    // ---- per-product acknowledgement proof uploads (Specific Product, multi-item requests only) --
    // Uploaded immediately on selection (same established pattern as PublicityForm.razor's per-item
    // design-file upload), not deferred to Save/Submit - Preview/Download need a real server path, and
    // "preserve across pagination" falls out for free this way since nothing is re-fetched: the file
    // list lives on _ackTarget.Files, the SAME PubDispatchDto instance SpicDataTable merely paginates
    // over, so switching pages never touches it.
    private List<PubFileDto> ItemProofFiles(PubDispatchItemDto item) =>
        _ackTarget?.Files.Where(f => f.Kind == PublicityFileKind.AckPhoto && f.RequestItemId == item.RequestItemId).ToList() ?? new();

    // Single-file picker behind the compact "Upload Proof" button (2026-11-27) - replaces the
    // earlier PubDrop Compact usage, which rendered a full icon+title+subtitle+hint bar per row and
    // made every row much taller than a compact DataTable needs. Same size/type validation PubDrop
    // itself already applies, just inline since there's exactly one file per pick here.
    private async Task PickItemProofAsync(PubDispatchItemDto item, InputFileChangeEventArgs e)
    {
        var f = e.File;
        if (f.Size > PublicityApi.MaxFileBytes) { Toast.Error($"\"{f.Name}\" is larger than 10 MB."); return; }
        await UploadItemProofAsync(item, new List<IBrowserFile> { f });
    }

    private async Task UploadItemProofAsync(PubDispatchItemDto item, List<IBrowserFile> files)
    {
        if (files.Count == 0 || _ackTarget is null) return;
        var saved = await Api.UploadAsync(Id, PublicityFileKind.AckPhoto, files, _ackTarget.Id, item.RequestItemId);
        if (saved is not null) { _ackTarget.Files.AddRange(saved); StateHasChanged(); }
    }

    private async Task RemoveItemProofAsync(PubDispatchItemDto item, PubFileDto f)
    {
        if (_ackTarget is null) return;
        if (await Api.DeleteFileAsync(f.Id)) { _ackTarget.Files.Remove(f); StateHasChanged(); }
    }

    private static List<ExportColumn<PubDispatchItemDto>> ReadOnlyAckExportColumns() => new()
    {
        new() { Header = "Product", ValueSelector = i => i.ProductName },
        new() { Header = "Dispatched", ValueSelector = i => i.DispatchedQty.ToString() },
        new() { Header = "Received", ValueSelector = i => i.ReceivedQty.ToString() },
        new() { Header = "Shortage", ValueSelector = i => i.ShortageQty.ToString() },
        new() { Header = "Excess", ValueSelector = i => i.ExcessQty.ToString() },
        new() { Header = "Damaged", ValueSelector = i => i.DamagedQty.ToString() },
        new() { Header = "Condition", ValueSelector = i => i.IsDamaged ? "Damaged" : "Good" },
        new() { Header = "Remarks", ValueSelector = i => i.Remarks ?? "" }
    };

    // Compact per-product reference for the request-level Exception Raised card (Specific Product,
    // multi-item requests only) - reads EVERY dispatch's own x.Items (Original/ReInitiation/Transfer
    // alike, each already scoped to its own products by DispatchDtoAsync), never just the one most
    // recently acknowledged, so a product whose exception was raised on an earlier dispatch still
    // shows up here.
    private IEnumerable<(string Product, string Label, int Qty)> ExceptionProductRefs()
    {
        if (_d is null) yield break;
        foreach (var x in _d.Dispatches)
        {
            foreach (var i in x.Items)
            {
                if (i.ShortageQty > 0) yield return (i.ProductName, "Shortage", i.ShortageQty);
                if (i.ExcessQty > 0) yield return (i.ProductName, "Excess", i.ExcessQty);
                if (i.DamagedQty > 0) yield return (i.ProductName, "Damage", i.DamagedQty);
            }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        var query = Nav.ToAbsoluteUri(Nav.Uri).Query;
        _tab = query.Contains("tab=tracking") ? 1 : (query.Contains("tab=ack") || query.Contains("tab=exception")) ? 2 : query.Contains("tab=docs") ? 3 : 0;
        _lookups = await Api.LookupsAsync();
        await LoadAsync();
    }

    // Guards MarkReadByRequestAsync below to once per Id per component instance - LoadAsync can rerun
    // for the SAME request (tab switch via OnParametersSetAsync, acknowledgement submit, etc.); the
    // server call is already idempotent (only rows still unread are touched) so a repeat would be
    // harmless, but there is no reason to re-fire it over and over for a request already acknowledged.
    private int? _markedReadForId;

    private async Task LoadAsync()
    {
        _d = await Api.GetAsync(Id);
        if (_d is null) return;
        _ackTarget = _d.Dispatches.FirstOrDefault(x => x.CanAcknowledge);
        _ackFiles = new();
        _ack = _ackTarget?.Ack is { } a
            ? new PubAckUpsertDto { ReceivedQty = a.ReceivedQty, IsDamaged = a.IsDamaged, DamagedQty = a.DamagedQty, AcknowledgedByUserId = a.AcknowledgedByUserId, Remarks = a.Remarks }
            : new PubAckUpsertDto { ReceivedQty = _ackTarget?.Quantity ?? 0, AcknowledgedByUserId = _lookups?.MyUserId };

        // Auto-mark-as-read: only after the request's own details are confirmed loaded above (a
        // failed/unauthorized load already returned before reaching here), so viewing IND-2026-0006
        // directly from the Submitted Request list - without ever opening Notifications - still
        // acknowledges that request's notifications, exactly like opening them from the Notifications
        // page already does.
        if (_markedReadForId != Id)
        {
            _markedReadForId = Id;
            var res = await Api.MarkReadByRequestAsync(Id);
            if (res is not null) PubNotify.SetUnreadCount(res.Count);
        }
    }

    // A Transfer-kind dispatch landing on this request (this request is the transfer's destination)
    // must never share the generic "Dispatch N" heading with the Original/ReInitiation dispatch it's
    // mixed alongside in d.Dispatches - that's what made a stock transfer read as "Dispatch 2 - Stock
    // Transfer" instead of its own distinct "Stock Transfer Request" section.
    private static string DispatchHeading(PubDispatchDto x, int i) => x.Kind switch
    {
        PublicityDispatchKind.Transfer => "Stock Transfer Request",
        PublicityDispatchKind.Original => "Original Dispatch Details & Exception",
        _ => $"Dispatch {i + 1}"
    };

    private static string ActionTone(string action) => action switch
    {
        "Not Started" => "grey",
        "Pending Review" or "Edited" or "Returned" or "Exception Raised" => "amber",
        "Rejected" => "red",
        "Submitted" or "Created" => "grey",
        _ => "green"
    };

    // ---- review ----------------------------------------------------------------------------

    private async Task ApproveAsync()
    {
        var next = PubText.Next(_d!.Stage);
        if (!await Toast.ConfirmAsync("Approve & forward", $"Approve {_d.IndentNo} ({_d.Quantity} Nos) and forward it to {next}?", "Approve & Forward")) return;
        await ReviewAsync("Approve", $"Request approved and forwarded to {next}.");
    }

    private async Task RejectAsync()
    {
        if (string.IsNullOrWhiteSpace(_reviewRemarks)) { Toast.Error("Enter the reason for rejection."); return; }
        await ReviewAsync("Reject", $"Request {_d!.IndentNo} rejected.");
    }

    private async Task ReviewAsync(string action, string done)
    {
        _busy = true;
        var ok = await Api.ReviewAsync(Id, new PubReviewDto { Action = action, Remarks = _reviewRemarks });
        _busy = false;
        if (!ok) return;
        _reviewOpen = false;
        Toast.Success(done);
        await PubNotify.RefreshAsync();
        Nav.NavigateTo(Api.Home);
    }

    private async Task MarkReviewedAsync(bool reviewed)
    {
        _busy = true;
        var ok = await Api.MarkRequestReviewedAsync(Id, reviewed);
        _busy = false;
        if (!ok) return;
        Toast.Success(reviewed ? "Request marked as reviewed." : "Review status cleared.");
        if (reviewed && FromConsolidation)
        {
            Nav.NavigateTo("/PublicityReview/consolidation");
            return;
        }
        await LoadAsync();
    }

    // ---- acknowledgement (RMDO) ------------------------------------------------------------

    private async Task SaveAckAsync(bool submit)
    {
        if (_ackTarget is null) return;
        if (IsMultiItemAck)
        {
            foreach (var item in _ackTarget.Items)
            {
                if (item.ReceivedQty < 0) { Toast.Error($"Enter the received quantity for {item.ProductName}."); return; }
                if (item.IsDamaged && (item.DamagedQty <= 0 || item.DamagedQty > item.ReceivedQty))
                { Toast.Error($"Damaged quantity for {item.ProductName} must be between 1 and the received quantity."); return; }
            }
            _ack.Items = _ackTarget.Items.Select(item => new PubAckItemUpsertDto
            {
                RequestItemId = item.RequestItemId ?? 0, ReceivedQty = item.ReceivedQty,
                IsDamaged = item.IsDamaged, DamagedQty = item.IsDamaged ? item.DamagedQty : 0, Remarks = item.Remarks
            }).ToList();
        }
        else
        {
            if (_ack.ReceivedQty < 0) { Toast.Error("Enter the received quantity."); return; }
            if (_ack.IsDamaged && (_ack.DamagedQty <= 0 || _ack.DamagedQty > _ack.ReceivedQty)) { Toast.Error("Damaged quantity must be between 1 and the received quantity."); return; }
            if (_ackTarget.Items.Count == 1)
            {
                _ack.Items = new List<PubAckItemUpsertDto>
                {
                    new PubAckItemUpsertDto
                    {
                        RequestItemId = _ackTarget.Items[0].RequestItemId ?? 0,
                        ReceivedQty = _ack.ReceivedQty,
                        IsDamaged = _ack.IsDamaged,
                        DamagedQty = _ack.IsDamaged ? _ack.DamagedQty : 0,
                        Remarks = _ack.Remarks
                    }
                };
            }
        }
        if (submit && !await Toast.ConfirmAsync("Submit acknowledgement", AckType.Length > 0
                ? $"{AckType} will be raised as an exception to the ADMIN - MD CS. Submit?" : "Confirm that the material is received in good condition.", "Submit")) return;
        _busy = true;
        if (_ackFiles.Count > 0 && await Api.UploadAsync(Id, PublicityFileKind.AckPhoto, _ackFiles, _ackTarget.Id) is null) { _busy = false; return; }
        _ackFiles = new();
        _ack.Submit = submit;
        var ok = await Api.AcknowledgeAsync(_ackTarget.Id, _ack);
        _busy = false;
        if (!ok) return;
        Toast.Success(submit ? "Acknowledgement submitted." : "Acknowledgement draft saved.");
        await LoadAsync();
    }

    // ---- print / report --------------------------------------------------------------------

    private async Task PrintAsync()
    {
        try { await JS.InvokeVoidAsync("print"); } catch (Exception) { Toast.Info("Printing is not available on this device."); }
    }

    private async Task DownloadReportAsync()
    {
        var d = _d!;
        var rows = new List<List<string>>
        {
            new() { "Indent No.", d.IndentNo }, new() { "Created On", PubText.DateTime(d.CreatedAt) },
            new() { "Current Stage", PubText.Stage(d.Stage) }, new() { "Status", PubText.Status(d.Status) },
            new() { "Publicity Material", d.Material }, new() { "Product", d.Product }, new() { "Quantity", $"{d.Quantity} Nos" },
            new() { "State / Region / HQ", $"{d.State} / {d.Region} / {d.Hq}" }, new() { "Requested By", $"{d.RequestedByName} ({d.RequestedByRole})" },
            new() { "Remarks", d.Remarks ?? "-" },
            new() { "Dispatched", $"{d.Summary.Dispatched} Nos" }, new() { "Received", $"{d.Summary.Received} Nos" },
            new() { "Damaged", $"{d.Summary.Damaged} Nos" }, new() { "Outstanding", $"{d.Summary.Outstanding} Nos" },
            new() { "Exception", $"{d.Summary.ExceptionType} ({d.Summary.ExceptionStatus})" }
        };
        rows.AddRange(d.History.Where(h => h.At != null).Select(h => new List<string> { h.Stage, $"{h.Action} - {h.By} ({h.Role}) {PubText.DateTime(h.At)} {h.Remarks}" }));
        rows.AddRange(d.Dispatches.Select(x => new List<string> { x.DispatchNo, $"{x.Quantity} Nos via {x.Transporter} {x.TrackingNo} - {PubText.DispatchStatus(x.Status, x.Kind)}" }));
        try
        {
            await Downloads.PostAsync("api/Export/table-pdf", new { Title = $"Publicity Request {d.IndentNo}", Headers = new[] { "Field", "Value" }, Rows = rows }, $"{d.IndentNo}.pdf");
        }
        catch (Exception)
        {
            Toast.Error("We could not build the report. Please try again.");
        }
    }
}
