@page "/PublicityReview/{Id:int}/dispatch"
@page "/PublicityRequest/{Id:int}/transfer/{DispatchId:int}"
@using SPIC.Core.DTOs
@using SPIC.Core.Entities
@using SPIC.MauiBlazorApp.Shared.Components.Publicity
@inject PublicityApi Api
@inject NavigationManager Nav
@inject ToastService Toast
@inject IJSRuntime JS
@implements IDisposable

@*
    "Create Dispatch", two modes on one page:
      /PublicityReview/{id}/dispatch[?kind=1]        ADMIN-MD CS: vendor dispatch (or re-initiation)
      /PublicityRequest/{sourceId}/transfer/{dispId} source-HQ RMDO: courier proof for a stock
                                                      transfer order; the receipt is OCR-read
*@

<div class="pub-page">
    <PageHeader Title="Create Dispatch" Subtitle="@(Proof ? "Upload the courier receipt; the details are read from the image automatically." : "Create dispatch for the approved request and provide transport details.")">
        <Actions><a class="pub-btn pub-btn--line" href="@Back"><i class="bi bi-arrow-left"></i> Back to My Request</a></Actions>
    </PageHeader>

    @if (_d is null || _lookups is null)
    {
        <Skeleton Rows="10" />
    }
    else if (Proof && _x is null)
    {
        <EmptyState Icon="bi-truck" Title="Transfer order not found" Message="This transfer order is no longer waiting for your dispatch proof." />
    }
    else if (Proof)
    {
        var x = _x!;
        <section class="pub-card pub-strip">
            <div class="pub-strip__cell"><div class="pub-strip__id">@x.DispatchNo <PubPill Text="Approved" Tone="green" /></div><span class="pub-muted">Created on @PubText.DateTime(x.CreatedAt)</span></div>
            <div class="pub-strip__cell"><span class="pub-strip__cap">Current Stage</span><PubPill Text="@PubText.DispatchStatus(x.Status, x.Kind)" Tone="amber" CssClass="pub-pill--lg" /></div>
            <div class="pub-strip__cell"><span class="pub-strip__cap">Requested By</span><b>@x.CreatedByName</b></div>
            <div class="pub-strip__cell"><span class="pub-strip__cap">Source HQ</span><b>@_d.Hq</b></div>
            <div class="pub-strip__cell"><span class="pub-strip__cap">Destination HQ</span><b>@x.DestinationHq</b></div>
        </section>

        <section class="pub-card">
            <h2 class="pub-h2">Read Information (Read Only)</h2>
            <div class="pub-grid pub-grid--3">
                <PubInfo Label="Source Request ID" Value="@_d.IndentNo"><span>@_d.IndentNo <PubPill Text="Excess" Tone="blue" /></span></PubInfo>
                <PubInfo Label="Source HQ" Tone="amber" Value="@_d.Hq" />
                <PubInfo Label="Destination Request ID" Tone="violet"><span>@x.RequestIndentNo <PubPill Text="Shortage" Tone="red" /></span></PubInfo>
                <PubInfo Label="Destination HQ" Value="@x.DestinationHq" />
                <PubInfo Label="Product / Material" Value="@(!string.IsNullOrWhiteSpace(x.Product) ? x.Product : (x.Items.Count == 1 ? x.Items[0].ProductName : _d.Product))" Sub="@(x.Material ?? _d.Material)" />
                <PubInfo Label="Transfer Quantity" Value="@($"{x.Quantity} Nos")" />
                <PubInfo Label="Verified Available Excess" Value="@($"{ (x.SourceProductAvailableExcess > 0 ? x.SourceProductAvailableExcess : Math.Max(0, _d.Summary.Excess - (_d.Summary.TransferredOut - x.Quantity))) } Nos")" />
                <PubInfo Label="Requested By" Value="@x.CreatedByName" />
                <PubInfo Label="Request Date" Value="@PubText.DateTime(x.CreatedAt)" />
            </div>
            @if (x.Items is { Count: > 1 })
            {
                <div class="pub-table-wrap mt-3">
                    <table class="pub-table">
                        <thead>
                            <tr>
                                <th style="width:60px">S.No</th>
                                <th>Product</th>
                                <th style="width:140px; text-align:right">Transfer Qty</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < x.Items.Count; i++)
                            {
                                var item = x.Items[i];
                                <tr>
                                    <td>@(i + 1)</td>
                                    <td><b>@item.ProductName</b></td>
                                    <td style="text-align:right"><PubPill Text="@($"{item.DispatchedQty} Nos")" Tone="pink" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="pub-card">
            <h2 class="pub-h2">Upload Courier / Dispatch Proof <span style="color: #e5372b;">*</span></h2>
            <p class="pub-muted">Upload the courier receipt / dispatch document. We read the details from the image automatically.</p>
            <PubDocs Files="x.Files.Where(f => f.Kind == PublicityFileKind.CourierProof).ToList()" Empty="" OnDelete="RemoveFile" />
            <PubDrop Files="_proofFiles" FilesChanged="ProofPicked" Multiple="false" Title="Drag &amp; drop file here" />
            @if (_reading) { <p class="pub-muted"><span class="spinner-border spinner-border-sm"></span> Reading the receipt...</p> }
        </section>

        <div class="pub-footer">
            <a class="pub-btn pub-btn--grey" href="@Back"><i class="bi bi-chevron-double-left"></i> Back to List</a>
            <span class="pub-footer__gap"></span>
            <a class="pub-btn pub-btn--grey" href="@Back">Cancel</a>
            <button type="button" class="pub-btn pub-btn--primary" disabled="@(_busy || _reading)" @onclick="SubmitProofAsync">
                @if (_busy)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span> Submitting...</span>
                }
                else
                {
                    <span>Submit Proof to Admin <i class="bi bi-chevron-double-right"></i></span>
                }
            </button>
        </div>
    }
    else
    {
        <PubHeader D="_d" StageText="@(Kind == PublicityDispatchKind.ReInitiation ? "Re-initiation" : null)" />
        <PubOverview D="_d" Title="Read Information (Read Only)" />

        <section class="pub-card">
            <h2 class="pub-h2">@(Kind == PublicityDispatchKind.ReInitiation ? "Re-initiation Dispatch Data" : "Feed Logistics & Dispatch Data")</h2>
            @if (Kind == PublicityDispatchKind.ReInitiation) { <p class="pub-muted">Replacement for the shortage / damage: @_d.Summary.Outstanding Nos outstanding.</p> }
            <div class="pub-form pub-form--3">
                <div class="pub-field"><label class="pub-label pub-req" for="cd-dd">Dispatch Date</label><input id="cd-dd" type="date" class="pub-input" @bind="_dto.DispatchDate" /></div>
                <div class="pub-field"><label class="pub-label pub-req" for="cd-qty">Dispatch Quantity</label><input id="cd-qty" type="number" class="pub-input" @bind="_dto.Quantity" readonly title="Locked to the final approved quantity" /></div>
                <div class="pub-field"><label class="pub-label pub-req" for="cd-vendor">Vendor</label>
                    <input id="cd-vendor" class="pub-input" list="pub-vendors" @bind="_dto.VendorName" placeholder="Select or type the vendor" />
                    <datalist id="pub-vendors">@foreach (var v in _lookups.Vendors) { <option value="@v"></option> }</datalist></div>
                <div class="pub-field"><label class="pub-label pub-req" for="cd-tr">Transporter / Courier</label>
                    <input id="cd-tr" class="pub-input" list="pub-couriers" @bind="_dto.Transporter" placeholder="e.g. Blue Dart Express" /></div>
                <div class="pub-field"><label class="pub-label" for="cd-vn">Vehicle No</label><input id="cd-vn" class="pub-input" @bind="_dto.VehicleNo" placeholder="e.g. TN 09 AB 1234" /></div>
                <div class="pub-field"><label class="pub-label" for="cd-awb">Tracking No.</label><input id="cd-awb" class="pub-input" @bind="_dto.TrackingNo" placeholder="e.g. AWB-9842019" /></div>
                <div class="pub-field"><label class="pub-label" for="cd-ed">Expected Delivery Date</label><input id="cd-ed" type="date" class="pub-input" @bind="_dto.ExpectedDeliveryDate" /></div>
                <div class="pub-field"><label class="pub-label pub-req" for="cd-resp">Responsible SMDO / RM / RMDO / MO</label>
                    <select id="cd-resp" class="pub-input" @onchange="e => OnNativeSelect(e, OnResponsibleChanged)">
                        <option value="">Select Responsible Officer</option>
                        @foreach (var p in _people) { <option value="@p.UserId" selected="@(_dto.ResponsibleUserId == p.UserId)">@p.Name @(p.Role is null ? "" : $"({p.Role})")</option> }
                    </select></div>
                <div class="pub-field"><label class="pub-label" for="cd-rem">Remarks (Optional)</label><input id="cd-rem" class="pub-input" @bind="_dto.Remarks" placeholder="Enter remarks about dispatch" /></div>
            </div>
        </section>

        @if (IsSpecificProductWithItems)
        {
            <section class="pub-card">
                <div class="pub-card__head">
                    <div>
                        <h2 class="pub-h2">Product-Wise Request, Receipt, Issue &amp; Replacement Details</h2>
                        <span class="pub-muted">
                            @(Kind == PublicityDispatchKind.ReInitiation 
                                ? $"Review quantity history across all {_itemRows.Count} product items and specify re-dispatch quantities" 
                                : $"{_itemRows.Count} product items")
                        </span>
                    </div>
                </div>

                @if (_itemRows.Count == 0)
                {
                    <div class="pub-banner pub-banner--amber">
                        <span class="pub-banner__icon"><i class="bi bi-info-circle"></i></span>
                        <div>
                            <h3>No Items Available</h3>
                            <p>@(Kind == PublicityDispatchKind.ReInitiation ? "There are no outstanding replacement quantities to dispatch." : "All approved items have already been dispatched.")</p>
                        </div>
                    </div>
                }
                else if (Kind == PublicityDispatchKind.ReInitiation)
                {
                    <div class="pub-table-wrap">
                        <table class="pub-table pub-table--items pub-table--redispatch">
                            <thead>
                                <tr>
                                    <th style="width: 50px;">S.No</th>
                                    <th style="text-align: left; min-width: 170px;">Product Name</th>
                                    <th class="pub-th-num" title="Originally requested / approved quantity">Asked</th>
                                    <th class="pub-th-num" title="Quantity originally sent">Sent</th>
                                    <th class="pub-th-num" title="Quantity actually received">Received</th>
                                    <th class="pub-th-num" title="Missing units from dispatch">Shortage</th>
                                    <th class="pub-th-num" title="Received units reported damaged">Damaged</th>
                                    <th class="pub-th-num" title="Extra units received">Excess</th>
                                    <th style="text-align: center; min-width: 130px;" title="Exception issue type">Issue</th>
                                    <th class="pub-th-num" title="Outstanding replacement quantity still requiring resolution">Pending</th>
                                    <th class="pub-th-num" style="min-width: 140px;" title="Quantity being re-dispatched in this shipment">Send Now</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < _itemRows.Count; i++)
                                {
                                    var idx = i;
                                    var row = _itemRows[idx];
                                    var isIssue = row.HasIssue;
                                    <tr class="@(isIssue ? "pub-row--issue" : "")">
                                        <td data-label="S.No">@(idx + 1)</td>
                                        <td data-label="Product Name" style="text-align: left;">
                                            <b>@row.ProductName</b>
                                            @if (isIssue)
                                            {
                                                <span class="pub-badge-alert" title="Exception reported for this product"><i class="bi bi-exclamation-triangle-fill"></i></span>
                                            }
                                        </td>
                                        <td data-label="Asked" class="pub-td-num">@row.AskedQty Nos</td>
                                        <td data-label="Sent" class="pub-td-num">@row.SentQty Nos</td>
                                        <td data-label="Received" class="pub-td-num">@row.ReceivedQty Nos</td>
                                        <td data-label="Shortage" class="pub-td-num @(row.ShortageQty > 0 ? "pub-text-red" : "")">
                                            @(row.ShortageQty > 0 ? $"{row.ShortageQty} Nos" : "-")
                                        </td>
                                        <td data-label="Damaged" class="pub-td-num @(row.DamagedQty > 0 ? "pub-text-amber" : "")">
                                            @(row.DamagedQty > 0 ? $"{row.DamagedQty} Nos" : "-")
                                        </td>
                                        <td data-label="Excess" class="pub-td-num @(row.ExcessQty > 0 ? "pub-text-blue" : "")">
                                            @(row.ExcessQty > 0 ? $"{row.ExcessQty} Nos" : "-")
                                        </td>
                                        <td data-label="Issue" style="text-align: center;">
                                            @if (row.ShortageQty > 0 && row.DamagedQty > 0)
                                            {
                                                <PubPill Text="Shortage + Damage" Tone="red" />
                                            }
                                            else if (row.ShortageQty > 0)
                                            {
                                                <PubPill Text="Shortage" Tone="red" />
                                            }
                                            else if (row.DamagedQty > 0)
                                            {
                                                <PubPill Text="Damage" Tone="amber" />
                                            }
                                            else if (row.ExcessQty > 0)
                                            {
                                                <PubPill Text="Excess" Tone="blue" />
                                            }
                                            else
                                            {
                                                <span class="pub-muted">-</span>
                                            }
                                        </td>
                                        <td data-label="Pending" class="pub-td-num @(row.OutstandingReplacementQty > 0 ? "pub-text-violet" : "")">
                                            <b>@row.OutstandingReplacementQty Nos</b>
                                        </td>
                                        <td data-label="Send Now" class="pub-td-num">
                                            @if (row.OutstandingReplacementQty > 0)
                                            {
                                                <input type="number"
                                                       class="pub-input pub-input--qty pub-input--send-now"
                                                       min="0"
                                                       max="@row.OutstandingReplacementQty"
                                                       value="@row.DispatchQty"
                                                       @oninput="(e) => OnItemQtyChanged(row, e)" />
                                            }
                                            else
                                            {
                                                <span class="pub-muted" title="No outstanding quantity to replace">0 Nos</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="pub-tfoot-total">
                                    <td colspan="2" style="text-align: left;"><b>Total</b></td>
                                    <td class="pub-td-num"><b>@TotalAsked Nos</b></td>
                                    <td class="pub-td-num"><b>@TotalSent Nos</b></td>
                                    <td class="pub-td-num"><b>@TotalReceived Nos</b></td>
                                    <td class="pub-td-num pub-text-red"><b>@TotalShortage Nos</b></td>
                                    <td class="pub-td-num pub-text-amber"><b>@TotalDamaged Nos</b></td>
                                    <td class="pub-td-num pub-text-blue"><b>@TotalExcess Nos</b></td>
                                    <td></td>
                                    <td class="pub-td-num pub-text-violet"><b>@TotalOutstandingReplacement Nos</b></td>
                                    <td class="pub-td-num pub-text-green"><b>@TotalSendingNow Nos</b></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <div class="pub-re-dispatch-summary">
                        <div class="pub-summary-card">
                            <span class="pub-summary-card__label">Total Requested</span>
                            <span class="pub-summary-card__val">@TotalAsked Nos</span>
                        </div>
                        <div class="pub-summary-card">
                            <span class="pub-summary-card__label">Total Dispatched</span>
                            <span class="pub-summary-card__val">@TotalSent Nos</span>
                        </div>
                        <div class="pub-summary-card">
                            <span class="pub-summary-card__label">Total Received</span>
                            <span class="pub-summary-card__val">@TotalReceived Nos</span>
                        </div>
                        <div class="pub-summary-card pub-summary-card--red">
                            <span class="pub-summary-card__label">Total Shortage</span>
                            <span class="pub-summary-card__val">@TotalShortage Nos</span>
                        </div>
                        <div class="pub-summary-card pub-summary-card--amber">
                            <span class="pub-summary-card__label">Total Damaged</span>
                            <span class="pub-summary-card__val">@TotalDamaged Nos</span>
                        </div>
                        <div class="pub-summary-card pub-summary-card--violet">
                            <span class="pub-summary-card__label">Total Outstanding Replacement</span>
                            <span class="pub-summary-card__val">@TotalOutstandingReplacement Nos</span>
                        </div>
                        <div class="pub-summary-card pub-summary-card--green">
                            <span class="pub-summary-card__label">Total Sending Now</span>
                            <span class="pub-summary-card__val">@TotalSendingNow Nos</span>
                        </div>
                        <div class="pub-summary-card pub-summary-card--blue">
                            <span class="pub-summary-card__label">Balance Remaining After Re-Dispatch</span>
                            <span class="pub-summary-card__val">@TotalBalanceRemaining Nos</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="pub-table-wrap">
                        <table class="pub-table pub-table--items">
                            <thead>
                                <tr>
                                    <th style="width: 60px;">S.No</th>
                                    <th style="text-align: left;">Product</th>
                                    <th class="pub-th-num" style="width: 150px;">Approved Qty</th>
                                    <th class="pub-th-num" style="width: 190px;">Previously Dispatched</th>
                                    <th class="pub-th-num" style="width: 150px;">Remaining Qty</th>
                                    <th class="pub-th-num" style="width: 180px;">Dispatch Qty</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < _itemRows.Count; i++)
                                {
                                    var idx = i;
                                    var row = _itemRows[idx];
                                    var maxQty = row.RemainingQty;
                                    <tr>
                                        <td data-label="S.No">@(idx + 1)</td>
                                        <td data-label="Product" style="text-align: left;"><b>@row.ProductName</b></td>
                                        <td data-label="Approved Qty" class="pub-td-num">@row.AskedQty Nos</td>
                                        <td data-label="Previously Dispatched" class="pub-td-num">@row.PreviouslyDispatched Nos</td>
                                        <td data-label="Remaining Qty" class="pub-td-num">@row.RemainingQty Nos</td>
                                        <td data-label="Dispatch Qty" class="pub-td-num">
                                            <input type="number"
                                                   class="pub-input pub-input--qty"
                                                   min="0"
                                                   max="@maxQty"
                                                   value="@row.DispatchQty"
                                                   disabled="@(maxQty <= 0)"
                                                   @oninput="(e) => OnItemQtyChanged(row, e)" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="pub-tfoot-total">
                                    <td colspan="2" style="text-align: left;"><b>Total</b></td>
                                    <td class="pub-td-num"><b>@_itemRows.Sum(r => r.AskedQty) Nos</b></td>
                                    <td class="pub-td-num"><b>@_itemRows.Sum(r => r.PreviouslyDispatched) Nos</b></td>
                                    <td class="pub-td-num"><b>@_itemRows.Sum(r => r.RemainingQty) Nos</b></td>
                                    <td class="pub-td-num"><b>@_dto.Quantity Nos</b></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
            </section>
        }

        <section class="pub-card">
            <h2 class="pub-h2">Dispatch / Note Approval Document @if (Kind == PublicityDispatchKind.Original) { <span class="pub-text-red">(Required)</span> }</h2>
            <p class="pub-muted">Upload the note approval / dispatch document for this dispatch</p>
            <PubDrop @bind-Files="_noteFiles" Multiple="false" />
            <h3 class="pub-h3">Transport Slip / E-Way Bill / Other Documents <small>(Optional)</small></h3>
            <PubDrop @bind-Files="_docFiles" />
        </section>

        <section class="pub-card">
            <h2 class="pub-h2">Delivery Address</h2>
            <p class="pub-muted">Select a saved delivery address, or add a new one.</p>
            <div class="pub-field">
                <div class="pub-field__head">
                    <label class="pub-label pub-req" for="cd-addr">Delivery Address</label>
                    <button type="button" class="pub-link-btn" @onclick="OpenAddAddress"><i class="bi bi-plus-circle"></i> Add Address</button>
                </div>
                <select id="cd-addr" class="pub-input" @onchange="e => OnNativeSelect(e, OnAddressChanged)">
                    <option value="">Select Delivery Address</option>
                    @foreach (var a in _addresses) { <option value="@a.Id" selected="@(_dto.DeliveryAddressId == a.Id)">@AddressOptionLabel(a)</option> }
                </select>
                @if (SelectedAddress is { } sel)
                {
                    <div class="pub-remarks">
                        <b>@sel.RecipientName</b>@(string.IsNullOrWhiteSpace(sel.ContactPerson) ? "" : $" (Attn: {sel.ContactPerson})")<br />
                        @sel.AddressLine1@(string.IsNullOrWhiteSpace(sel.AddressLine2) ? "" : $", {sel.AddressLine2}")@(string.IsNullOrWhiteSpace(sel.Landmark) ? "" : $", Near {sel.Landmark}")<br />
                        @sel.City, @sel.StateName - @sel.PinCode<br />
                        Mobile: @sel.MobileNumber
                    </div>
                }
            </div>
        </section>

        <BottomSheet @bind-IsOpen="_addAddressOpen" Title="Add Delivery Address">
            <ChildContent>
                <div class="pub-form pub-form--2">
                    <div class="pub-field"><label class="pub-label pub-req" for="na-label">Address Name / Label</label>
                        <input id="na-label" class="pub-input" @bind="_newAddr.AddressLabel" placeholder="e.g. SPIC Regional Office - Salem" /></div>
                    <div class="pub-field"><label class="pub-label pub-req" for="na-recipient">Recipient / Office Name</label>
                        <input id="na-recipient" class="pub-input" @bind="_newAddr.RecipientName" placeholder="e.g. SPIC Regional Office" /></div>
                    <div class="pub-field"><label class="pub-label" for="na-contact">Contact Person (Optional)</label>
                        <input id="na-contact" class="pub-input" @bind="_newAddr.ContactPerson" /></div>
                    <div class="pub-field"><label class="pub-label pub-req" for="na-mobile">Mobile Number</label>
                        <input id="na-mobile" class="pub-input" @bind="_newAddr.MobileNumber" placeholder="10-digit mobile number" /></div>
                    <div class="pub-field pub-field--full"><label class="pub-label pub-req" for="na-l1">Address Line 1</label>
                        <input id="na-l1" class="pub-input" @bind="_newAddr.AddressLine1" /></div>
                    <div class="pub-field pub-field--full"><label class="pub-label" for="na-l2">Address Line 2 (Optional)</label>
                        <input id="na-l2" class="pub-input" @bind="_newAddr.AddressLine2" /></div>
                    <div class="pub-field"><label class="pub-label" for="na-landmark">Landmark (Optional)</label>
                        <input id="na-landmark" class="pub-input" @bind="_newAddr.Landmark" /></div>
                    <div class="pub-field"><label class="pub-label pub-req" for="na-state">State</label>
                        <select id="na-state" class="pub-input" @bind="_newAddr.StateId">
                            <option value="0">Select State</option>
                            @foreach (var s in _states) { <option value="@s.Id">@s.Name</option> }
                        </select></div>
                    <div class="pub-field"><label class="pub-label pub-req" for="na-city">District / City</label>
                        <input id="na-city" class="pub-input" @bind="_newAddr.City" /></div>
                    <div class="pub-field"><label class="pub-label pub-req" for="na-pin">PIN Code</label>
                        <input id="na-pin" class="pub-input" maxlength="6" @bind="_newAddr.PinCode" placeholder="6-digit PIN code" /></div>
                </div>
            </ChildContent>
            <Footer>
                <button type="button" class="pub-btn pub-btn--grey" @onclick="() => _addAddressOpen = false">Cancel</button>
                <button type="button" class="pub-btn pub-btn--primary" disabled="@_savingAddr" @onclick="SaveAddressAsync">Save Address</button>
            </Footer>
        </BottomSheet>

        <div class="pub-footer">
            <a class="pub-btn pub-btn--grey" href="@Back"><i class="bi bi-chevron-double-left"></i> Back to List</a>
            <span class="pub-footer__gap"></span>
            <a class="pub-btn pub-btn--grey" href="@Back">Cancel</a>
            <button type="button" class="pub-btn pub-btn--primary" disabled="@_busy" @onclick="CreateAsync">Confirm and Create Dispatch <i class="bi bi-chevron-double-right"></i></button>
        </div>
    }
    <datalist id="pub-couriers">@foreach (var c in _lookups?.Couriers ?? new()) { <option value="@c"></option> }</datalist>
</div>

@code {
    [Parameter] public int Id { get; set; }
    [Parameter] public int? DispatchId { get; set; }

    private bool Proof => DispatchId is > 0;
    private PublicityDispatchKind Kind
    {
        get
        {
            var uri = Nav.ToAbsoluteUri(Nav.Uri);
            var q = uri.Query;
            if (q.IndexOf("kind=1", StringComparison.OrdinalIgnoreCase) >= 0 ||
                q.IndexOf("kind=reinitiation", StringComparison.OrdinalIgnoreCase) >= 0 ||
                q.IndexOf("kind=replacement", StringComparison.OrdinalIgnoreCase) >= 0)
                return PublicityDispatchKind.ReInitiation;
            if (_d is not null && (_d.Status == PublicityStatus.ExceptionRaised || _d.Stage is PublicityStage.ExceptionHandling or PublicityStage.ReInitiation))
                return PublicityDispatchKind.ReInitiation;
            return PublicityDispatchKind.Original;
        }
    }
    private string Back => Proof ? $"/PublicityRequest/{Id}?tab=tracking" : $"/PublicityReview/{Id}";

    private bool IsSpecificProductWithItems => _d?.Items is { Count: > 0 } && (_d.MaterialCategory == PublicityMaterialCategory.Specific || _d.Items.Count > 1);

    private sealed class DispatchItemRow
    {
        public int RequestItemId { get; set; }
        public int ProductId { get; set; }
        public string ProductName { get; set; } = "";
        public int AskedQty { get; set; }
        public int SentQty { get; set; }
        public int ReceivedQty { get; set; }
        public int ShortageQty { get; set; }
        public int DamagedQty { get; set; }
        public int ExcessQty { get; set; }
        public string Issue => DamagedQty > 0 && ShortageQty > 0 ? "Shortage + Damage" :
            DamagedQty > 0 && ExcessQty > 0 ? "Excess + Damage" :
            DamagedQty > 0 ? "Damage" :
            ShortageQty > 0 ? "Shortage" :
            ExcessQty > 0 ? "Excess" : "-";
        public bool HasIssue => ShortageQty > 0 || DamagedQty > 0;
        public int OutstandingReplacementQty { get; set; }
        public int PreviouslyDispatched { get; set; }
        public int RemainingQty { get; set; }
        public int DispatchQty { get; set; }
    }
    private List<DispatchItemRow> _itemRows = new();

    private int TotalAsked => _itemRows.Sum(r => r.AskedQty);
    private int TotalSent => _itemRows.Sum(r => r.SentQty);
    private int TotalReceived => _itemRows.Sum(r => r.ReceivedQty);
    private int TotalShortage => _itemRows.Sum(r => r.ShortageQty);
    private int TotalDamaged => _itemRows.Sum(r => r.DamagedQty);
    private int TotalExcess => _itemRows.Sum(r => r.ExcessQty);
    private int TotalOutstandingReplacement => _itemRows.Sum(r => r.OutstandingReplacementQty);
    private int TotalSendingNow => _itemRows.Sum(r => r.DispatchQty);
    private int TotalBalanceRemaining => Math.Max(0, TotalOutstandingReplacement - TotalSendingNow);

    private PubDetailDto? _d;
    private PubLookupsDto? _lookups;
    private List<PubPerson> _people = new();
    private PubDispatchDto? _x;
    private readonly PubDispatchCreateDto _dto = new();
    private readonly PubProofDto _proof = new();
    private List<IBrowserFile> _noteFiles = new(), _docFiles = new(), _proofFiles = new();
    private bool _busy, _reading;

    // Saved Delivery Address dropdown + Add Address popup.
    private List<PubDeliveryAddressDto> _addresses = new();
    private List<PubOption> _states = new();
    private bool _addAddressOpen, _savingAddr;
    private PubDeliveryAddressCreateDto _newAddr = new();
    private PubDeliveryAddressDto? SelectedAddress => _addresses.FirstOrDefault(a => a.Id == _dto.DeliveryAddressId);
    private static string AddressOptionLabel(PubDeliveryAddressDto a) => $"{a.RecipientName} - {a.City} - {a.PinCode}";

    protected override async Task OnInitializedAsync()
    {
        _lookups = await Api.LookupsAsync();
        _d = await Api.GetAsync(Id);
        if (_d is null) return;
        if (Proof)
        {
            _x = _d.OutgoingTransfers.FirstOrDefault(t => t.Id == DispatchId && t.CanSubmitProof);
            if (_x is not null) (_proof.Transporter, _proof.TrackingNo, _proof.DispatchDate, _proof.VehicleNo) = (_x.Transporter, _x.TrackingNo, _x.DispatchDate ?? PubText.Today, _x.VehicleNo);
            return;
        }
        _people = (await Api.LookupsAsync(_d.RegionId))?.People ?? new();
        _dto.Kind = Kind;
        _dto.DispatchDate = PubText.Today;
        _dto.ResponsibleUserId = _d.RequestedByUserId;
        _addresses = await Api.DeliveryAddressesAsync() ?? new();
        _states = await Api.StatesAsync() ?? new();

        PopulateItemRows();
    }

    private void PopulateItemRows()
    {
        if (_d is null || !IsSpecificProductWithItems)
        {
            _dto.Quantity = Kind == PublicityDispatchKind.ReInitiation ? _d?.Summary.Outstanding ?? 0 : _d?.Quantity ?? 0;
            return;
        }

        var productNames = _lookups?.Products?.ToDictionary(p => p.Id, p => p.Name) ?? new();
        _itemRows.Clear();

        if (Kind == PublicityDispatchKind.ReInitiation)
        {
            // Full quantity history of every product in the request
            foreach (var item in _d.Items)
            {
                var prodName = !string.IsNullOrEmpty(item.ProductName)
                    ? item.ProductName
                    : productNames.GetValueOrDefault(item.ProductId, $"Product #{item.ProductId}");

                var sent = _d.Dispatches
                    .Where(disp => disp.Kind == PublicityDispatchKind.Original)
                    .SelectMany(disp => disp.Items)
                    .Where(di => di.RequestItemId == item.Id)
                    .Sum(di => di.DispatchedQty);
                if (sent == 0) sent = item.Quantity; // fallback to asked if item-level original was not recorded

                var received = _d.Dispatches
                    .Where(disp => disp.Ack is { IsDraft: false })
                    .SelectMany(disp => disp.Items)
                    .Where(di => di.RequestItemId == item.Id)
                    .Sum(di => di.ReceivedQty);

                var damaged = _d.Dispatches
                    .Where(disp => disp.Ack is { IsDraft: false })
                    .SelectMany(disp => disp.Items)
                    .Where(di => di.RequestItemId == item.Id)
                    .Sum(di => di.DamagedQty);

                var shortage = Math.Max(0, sent - received);
                var excess = Math.Max(0, received - sent);

                var usable = Math.Max(0, received - damaged);
                var deficit = Math.Max(0, item.Quantity - usable);

                // Already covered by active replacement dispatches (not yet acknowledged)
                var activeReplacement = _d.Dispatches
                    .Where(disp => disp.Kind != PublicityDispatchKind.Original && (disp.Ack == null || disp.Ack.IsDraft))
                    .SelectMany(disp => disp.Items)
                    .Where(di => di.RequestItemId == item.Id)
                    .Sum(di => di.DispatchedQty);

                var outstanding = Math.Max(0, deficit - activeReplacement);

                _itemRows.Add(new DispatchItemRow
                {
                    RequestItemId = item.Id,
                    ProductId = item.ProductId,
                    ProductName = prodName,
                    AskedQty = item.Quantity,
                    SentQty = sent,
                    ReceivedQty = received,
                    ShortageQty = shortage,
                    DamagedQty = damaged,
                    ExcessQty = excess,
                    OutstandingReplacementQty = outstanding,
                    DispatchQty = outstanding
                });
            }
        }
        else
        {
            // Original dispatch: all approved items
            foreach (var item in _d.Items)
            {
                var prodName = !string.IsNullOrEmpty(item.ProductName)
                    ? item.ProductName
                    : productNames.GetValueOrDefault(item.ProductId, $"Product #{item.ProductId}");

                var prevDispatched = _d.Dispatches
                    .Where(disp => disp.Kind == PublicityDispatchKind.Original)
                    .SelectMany(disp => disp.Items)
                    .Where(di => di.RequestItemId == item.Id)
                    .Sum(di => di.DispatchedQty);

                var remaining = Math.Max(0, item.Quantity - prevDispatched);

                _itemRows.Add(new DispatchItemRow
                {
                    RequestItemId = item.Id,
                    ProductId = item.ProductId,
                    ProductName = prodName,
                    AskedQty = item.Quantity,
                    PreviouslyDispatched = prevDispatched,
                    RemainingQty = remaining,
                    DispatchQty = remaining
                });
            }
        }

        RecalculateTotalQty();
    }

    private void OnItemQtyChanged(DispatchItemRow row, ChangeEventArgs e)
    {
        var max = Kind == PublicityDispatchKind.ReInitiation ? row.OutstandingReplacementQty : row.RemainingQty;
        if (int.TryParse(e.Value?.ToString(), out var val))
        {
            if (val < 0) val = 0;
            if (val > max) val = max;
            row.DispatchQty = val;
        }
        else
        {
            row.DispatchQty = 0;
        }
        RecalculateTotalQty();
    }

    private void RecalculateTotalQty()
    {
        if (IsSpecificProductWithItems)
        {
            _dto.Quantity = _itemRows.Sum(r => Math.Max(0, r.DispatchQty));
        }
    }

    // Responsible Officer becomes searchable (Select2), same wiring as every other list/filter page
    // in the app (see select2-interop.js) - native <select> stays the source of truth via @onchange.
    private DotNetObjectReference<PublicityDispatch>? _objRef;
    private bool _select2Ready;

    // After a new address is saved, the <option> it needs is added to the DOM by THIS render pass -
    // only the NEXT OnAfterRenderAsync can safely tell Select2 to pick it up (same ordering reason as
    // PublicityForm.razor's _pendingSelect2Sync for the Product field).
    private int? _pendingAddrSyncId;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Proof || _d is null || _lookups is null) return;
        if (!_select2Ready)
        {
            _select2Ready = true;
            _objRef ??= DotNetObjectReference.Create(this);
            var configs = new[]
            {
                new { id = "cd-resp", method = nameof(OnResponsibleChanged), parent = (string?)null },
                new { id = "cd-addr", method = nameof(OnAddressChanged), parent = (string?)null }
            };
            await JS.InvokeVoidAsync("spicSelect2.initMultiple", configs, _objRef);
        }
        if (_pendingAddrSyncId is int newId)
        {
            _pendingAddrSyncId = null;
            await JS.InvokeVoidAsync("spicSelect2.setValue", "cd-addr", newId);
        }
    }

    private static Task OnNativeSelect(ChangeEventArgs e, Action<List<string>?> handler)
    {
        handler(e.Value is string s && !string.IsNullOrEmpty(s) ? new List<string> { s } : new List<string>());
        return Task.CompletedTask;
    }

    [JSInvokable]
    public void OnResponsibleChanged(List<string>? values)
    {
        _dto.ResponsibleUserId = values is { Count: > 0 } ? values[0] : null;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnAddressChanged(List<string>? values)
    {
        _dto.DeliveryAddressId = values is { Count: > 0 } && int.TryParse(values[0], out var id) ? id : null;
        StateHasChanged();
    }

    private void OpenAddAddress()
    {
        _newAddr = new PubDeliveryAddressCreateDto { StateId = _d?.StateId ?? 0 };
        _addAddressOpen = true;
    }

    private async Task SaveAddressAsync()
    {
        string? error = string.IsNullOrWhiteSpace(_newAddr.AddressLabel) ? "Enter the address name / label."
            : string.IsNullOrWhiteSpace(_newAddr.RecipientName) ? "Enter the recipient / office name."
            : !System.Text.RegularExpressions.Regex.IsMatch(_newAddr.MobileNumber.Trim(), @"^[6-9]\d{9}$") ? "Enter a valid 10-digit Indian mobile number."
            : string.IsNullOrWhiteSpace(_newAddr.AddressLine1) ? "Enter address line 1."
            : _newAddr.StateId <= 0 ? "Select the state."
            : string.IsNullOrWhiteSpace(_newAddr.City) ? "Enter the district / city."
            : !System.Text.RegularExpressions.Regex.IsMatch(_newAddr.PinCode.Trim(), @"^\d{6}$") ? "Enter a valid 6-digit PIN code." : null;
        if (error != null) { Toast.Error(error); return; }
        _savingAddr = true;
        var saved = await Api.CreateDeliveryAddressAsync(_newAddr);
        _savingAddr = false;
        if (saved is null) return; // popup stays open; ToastFailureAsync already showed the real error
        _addresses = await Api.DeliveryAddressesAsync() ?? _addresses;
        _dto.DeliveryAddressId = saved.Id;
        _pendingAddrSyncId = saved.Id;
        _addAddressOpen = false;
    }

    public void Dispose() => _objRef?.Dispose();

    private async Task CreateAsync()
    {
        if (IsSpecificProductWithItems)
        {
            if (_itemRows.Count == 0)
            {
                Toast.Error(Kind == PublicityDispatchKind.ReInitiation ? "There are no outstanding replacement items to dispatch." : "All approved items have already been dispatched.");
                return;
            }
            if (_dto.Quantity <= 0)
            {
                Toast.Error("Enter at least one product dispatch quantity greater than zero.");
                return;
            }
            _dto.Items = _itemRows
                .Where(r => r.DispatchQty > 0)
                .Select(r => new PubDispatchItemCreateDto
                {
                    RequestItemId = r.RequestItemId,
                    ProductId = r.ProductId,
                    DispatchQty = r.DispatchQty
                })
                .ToList();
        }

        string? error = _dto.DispatchDate is null ? "Select the dispatch date."
            : _dto.Quantity <= 0 ? "Enter the dispatch quantity."
            : string.IsNullOrWhiteSpace(_dto.VendorName) ? "Select the vendor."
            : string.IsNullOrWhiteSpace(_dto.Transporter) ? "Enter the transporter / courier."
            : string.IsNullOrWhiteSpace(_dto.ResponsibleUserId) ? "Select the responsible officer."
            : _dto.DeliveryAddressId is not > 0 ? "Select a delivery address."
            : Kind == PublicityDispatchKind.Original && _noteFiles.Count == 0 ? "Upload the dispatch / note approval document." : null;
        if (error != null) { Toast.Error(error); return; }
        _busy = true;
        var saved = await Api.CreateDispatchAsync(Id, _dto);
        if (saved is not null)
        {
            if (_noteFiles.Count > 0) await Api.UploadAsync(Id, PublicityFileKind.NoteApproval, _noteFiles, saved.Id);
            if (_docFiles.Count > 0) await Api.UploadAsync(Id, PublicityFileKind.DispatchDocument, _docFiles, saved.Id);
            Nav.NavigateTo($"/PublicityReview/done?type=dispatch&id={Id}&no={Uri.EscapeDataString(saved.DispatchNo ?? "")}");
        }
        _busy = false;
    }

    private async Task ProofPicked(List<IBrowserFile> files)
    {
        _proofFiles = files;
        var file = files.FirstOrDefault();
        if (file is null || _x is null) return;
        if (file.Size <= 0 || file.Size > PublicityApi.MaxFileBytes)
        {
            Toast.Error($"\"{file.Name}\" must be under 10 MB.");
            return;
        }
        var ext = System.IO.Path.GetExtension(file.Name).ToLowerInvariant();
        var allowed = new[] { ".pdf", ".jpg", ".jpeg", ".png", ".webp", ".doc", ".docx" };
        if (!allowed.Contains(ext))
        {
            Toast.Error("Only PDF, JPG, PNG, DOC and DOCX files are allowed.");
            return;
        }
        _reading = true;
        StateHasChanged();
        var uploaded = await Api.UploadAsync(Id, PublicityFileKind.CourierProof, files, _x.Id);
        if (uploaded is not null)
        {
            _x.Files.AddRange(uploaded);
            _proofFiles = new();
            if (PubText.IsImage(file.Name) && await Api.OcrAsync(file) is { Found: true } ocr)
            {
                _proof.Transporter = ocr.Transporter ?? _proof.Transporter;
                _proof.TrackingNo = ocr.TrackingNo ?? _proof.TrackingNo;
                _proof.DispatchDate = ocr.DispatchDate ?? _proof.DispatchDate;
                _proof.VehicleNo = ocr.VehicleNo ?? _proof.VehicleNo;
            }
        }
        _reading = false;
    }

    private async Task RemoveFile(PubFileDto f)
    {
        if (await Api.DeleteFileAsync(f.Id)) _x?.Files.Remove(f);
    }

    private async Task SubmitProofAsync()
    {
        if (_busy || _reading) return;
        if (_x is null || _x.Files.All(f => f.Kind != PublicityFileKind.CourierProof))
        {
            Toast.Error("Please upload the courier / dispatch proof before submitting.");
            return;
        }
        _busy = true;
        var ok = await Api.ProofAsync(_x.Id, _proof);
        _busy = false;
        if (ok) Nav.NavigateTo($"/PublicityRequest/done?type=proof&id={Id}&no={Uri.EscapeDataString(_x.DispatchNo)}");
    }
}
