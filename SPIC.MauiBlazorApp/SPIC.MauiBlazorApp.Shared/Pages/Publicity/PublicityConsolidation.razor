@page "/PublicityReview/consolidation"
@using SPIC.Core.DTOs
@using SPIC.Core.Entities
@using SPIC.MauiBlazorApp.Shared.Components.Publicity
@inject PublicityApi Api
@inject NavigationManager Nav
@inject ToastService Toast
@inject FileDownloadService Downloads

@* Approver consolidation (Figma "State Consolidation" - 3 reference screens: SMDO, SMM Review,
   ADMIN Review). Same route/data for every role (RM sees its region, SMD/SMM their state, ADMIN-MD
   CS / DGM-MD CS all states) but three different KPI/table layouts, chosen by IsSmm/IsStateBulkView
   below - the underlying PubConsolidationDto/PubRegionDto shape is identical for all of them, only
   the presentation branches. For SMD specifically, every Region in the state is listed (even ones
   with zero requirements) and must be individually Approved or Zero Confirmed before the one final
   "Submit to SMM" action is enabled. ADMIN-MD CS / DGM-MD CS instead see one row per STATE (every
   Region/HQ it covers rolled up) with a per-State forward action, matching the ADMIN Review
   screenshot - there is no separate DGM Figma, so DGM reuses this exact state-grouped view with its
   own next-stage label (see Next below). *@

<div class="pub-page">
    <PageHeader Title="@Heading" Subtitle="@Subtitle">
        <Actions>
            @if (_c is not null) { <span class="pub-pill pub-pill--green pub-pill--lg pub-hide-sm"><i class="bi bi-geo-alt"></i> @_c.Scope</span> }
            <a class="pub-btn pub-btn--primary" href="/PublicityReview">View Submitted Request <i class="bi bi-arrow-right"></i></a>
        </Actions>
    </PageHeader>

    @if (_c is null)
    {
        <Skeleton Rows="8" />
    }
    else
    {
        var ready = Ready;
        var reviewedRegionCount = ReviewedRegionCount;
        var pendingReviewRegions = _c.Regions - reviewedRegionCount;
        <div class="pub-kpis @(IsSmm ? "pub-kpis--5" : IsStateBulkView ? "pub-kpis--6" : "")">
            @if (IsSmm)
            {
                <div class="pub-kpi">
                    <span class="pub-kpi__label">Submission ID</span>
                    <span class="pub-kpi__value">@(_c.SubmissionId ?? "—")</span>
                    <span class="pub-kpi__hint">Submitted on @PubText.DateTime(_c.SubmittedAt)</span>
                    <span class="pub-kpi__icon pub-tint--blue"><i class="bi bi-file-earmark-text"></i></span>
                </div>
                <div class="pub-kpi">
                    <span class="pub-kpi__label">State</span>
                    <span class="pub-kpi__value">@CleanScope</span>
                    <span class="pub-kpi__hint">Financial Year: @Fy</span>
                    <span class="pub-kpi__icon pub-tint--amber"><i class="bi bi-file-earmark-text"></i></span>
                </div>
                <div class="pub-kpi">
                    <span class="pub-kpi__label">Total Region</span>
                    <span class="pub-kpi__value">@_c.Regions / @_c.Regions</span>
                    <span class="pub-kpi__hint">All Regions Submitted</span>
                    <span class="pub-kpi__icon pub-tint--pink"><i class="bi bi-file-earmark-plus"></i></span>
                </div>
                <div class="pub-kpi">
                    <span class="pub-kpi__label">Total Requests</span>
                    <span class="pub-kpi__value">@_c.Requests</span>
                    <span class="pub-kpi__hint">Over all request</span>
                    <span class="pub-kpi__icon pub-tint--amber"><i class="bi bi-file-earmark-text"></i></span>
                </div>
                <div class="pub-kpi">
                    <span class="pub-kpi__label">Total Requirement</span>
                    <span class="pub-kpi__value">@_c.Quantity.ToString("N0") Nos</span>
                    <span class="pub-kpi__hint">Over all Quantity</span>
                    <span class="pub-kpi__icon pub-tint--green"><i class="bi bi-clock"></i></span>
                </div>
            }
            else if (IsStateBulkView)
            {
                <div class="pub-kpi">
                    <span class="pub-kpi__label">Total States</span>
                    <span class="pub-kpi__value">@StateGroups.Count</span>
                    <span class="pub-kpi__hint">All States</span>
                    <span class="pub-kpi__icon pub-tint--blue"><i class="bi bi-file-earmark-text"></i></span>
                </div>
                <div class="pub-kpi">
                    <span class="pub-kpi__label">Total Region</span>
                    <span class="pub-kpi__value">@_c.Regions</span>
                    <span class="pub-kpi__hint">Across all regions</span>
                    <span class="pub-kpi__icon pub-tint--blue"><i class="bi bi-file-earmark-text"></i></span>
                </div>
                <div class="pub-kpi">
                    <span class="pub-kpi__label">Total HQs</span>
                    <span class="pub-kpi__value">@_c.Hqs</span>
                    <span class="pub-kpi__hint">Across all HQs</span>
                    <span class="pub-kpi__icon pub-tint--amber"><i class="bi bi-file-earmark-text"></i></span>
                </div>
                <div class="pub-kpi">
                    <span class="pub-kpi__label">Total Requests</span>
                    <span class="pub-kpi__value">@_c.Requests</span>
                    <span class="pub-kpi__hint">Approved Request</span>
                    <span class="pub-kpi__icon pub-tint--amber"><i class="bi bi-file-earmark-text"></i></span>
                </div>
                <div class="pub-kpi">
                    <span class="pub-kpi__label">Total Quantity</span>
                    <span class="pub-kpi__value">@_c.Quantity.ToString("N0")</span>
                    <span class="pub-kpi__hint">Over all Nos</span>
                    <span class="pub-kpi__icon pub-tint--amber"><i class="bi bi-file-earmark-text"></i></span>
                </div>
                <div class="pub-kpi">
                    <span class="pub-kpi__label">Reviewed</span>
                    <span class="pub-kpi__value">@ReadyStateCount/@StateGroups.Count</span>
                    <span class="pub-kpi__hint">Ready for @Next review</span>
                    <span class="pub-kpi__icon pub-tint--green"><i class="bi bi-clock"></i></span>
                </div>
            }
            else
            {
                <div class="pub-kpi">
                    <span class="pub-kpi__label">Total Regions</span>
                    <span class="pub-kpi__value">@_c.Regions</span>
                    <span class="pub-kpi__hint">in @CleanScope</span>
                    <span class="pub-kpi__icon pub-tint--blue"><i class="bi bi-file-earmark-text"></i></span>
                </div>
                <div class="pub-kpi">
                    <span class="pub-kpi__label">Total Requests</span>
                    <span class="pub-kpi__value">@_c.Requests</span>
                    <span class="pub-kpi__hint">@Prev Approved</span>
                    <span class="pub-kpi__icon pub-tint--amber"><i class="bi bi-file-earmark-text"></i></span>
                </div>
                <div class="pub-kpi">
                    <span class="pub-kpi__label">Regions Reviewed</span>
                    <span class="pub-kpi__value">@reviewedRegionCount</span>
                    <span class="pub-kpi__hint">@(reviewedRegionCount == _c.Regions ? "All Regions Reviewed" : $"{pendingReviewRegions} Region{(pendingReviewRegions == 1 ? "" : "s")} Pending")</span>
                    <span class="pub-kpi__icon pub-tint--pink"><i class="bi bi-file-earmark-plus"></i></span>
                </div>
                <div class="pub-kpi">
                    <span class="pub-kpi__label">Total Requirement</span>
                    <span class="pub-kpi__value">@_c.Quantity.ToString("N0") Nos</span>
                    <span class="pub-kpi__hint">All Regions (Approved by @Prev)</span>
                    <span class="pub-kpi__icon pub-tint--green"><i class="bi bi-clock"></i></span>
                </div>
            }
        </div>

        <section class="pub-card">
            <div class="pub-card__head">
                <h2 class="pub-h2">@(IsStateBulkView ? "Region - Wise Consolidated Requirement" : IsSmm ? "Region - Wise Requirement Consolidated Requirement" : "Region - Wise Requirement")</h2>
                <div class="pub-card__tools">
                    <div class="pub-search">
                        <i class="bi bi-search"></i>
                        <input class="pub-input" placeholder="Search zones..." @bind="_q" @bind:event="oninput" aria-label="Search" />
                    </div>
                    <button type="button" class="pub-btn--export" @onclick="ExportCsv">Export</button>
                </div>
            </div>
            @if (_c.Groups.Count == 0)
            {
                <EmptyState Icon="bi-check2-all" Title="Nothing waiting for you" Message="Requests appear here when they reach your review stage." />
            }
            else if (IsStateBulkView)
            {
                <div class="pub-table-wrap">
                    <table class="pub-table pub-table--consolidation">
                        <thead>
                            <tr>
                                <th class="text-center">S.NO</th>
                                <th class="text-start">State</th>
                                <th class="text-center">Region</th>
                                <th class="text-center">Total HQs</th>
                                <th class="text-center">Total Requests</th>
                                <th class="text-center">Total Quantity (Nos)</th>
                                <th class="text-center">Reviewed</th>
                                <th class="text-center">Status</th>
                                <th class="text-center">Last Updated</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var (sg, i) in StateGroups.Select((sg, i) => (sg, i)))
                            {
                                var open = _openStates.Contains(sg.State);
                                var stateReady = StateReady(sg);
                                <tr class="pub-master-row @(open ? "is-expanded" : "")">
                                    <td class="text-center" data-label="S.NO">@(i + 1)</td>
                                    <td class="text-start pub-region-name" data-label="State">@sg.State</td>
                                    <td class="text-center" data-label="Region">@sg.RegionCount</td>
                                    <td class="text-center" data-label="Total HQs">@sg.Hqs</td>
                                    <td class="text-center" data-label="Total Requests">@sg.Requests</td>
                                    <td class="text-center" data-label="Total Quantity (Nos)">@sg.Quantity</td>
                                    <td class="text-center" data-label="Reviewed">
                                        <span class="pub-reviewed-stat @(stateReady ? "is-done" : "is-pending")">
                                            <i class="bi bi-check-circle"></i> @sg.ReviewedCount / @sg.Requests
                                        </span>
                                    </td>
                                    <td class="text-center" data-label="Status">
                                        <span class="pub-pill pub-pill--@(stateReady ? "green" : "amber")">@(stateReady ? "Approved / Forward" : "Pending")</span>
                                    </td>
                                    <td class="text-center" data-label="Last Updated">@PubText.Date(sg.LastUpdated)</td>
                                    <td class="text-center" data-label="Action">
                                        <div class="pub-inner-actions">
                                            <button type="button" class="pub-btn pub-btn--sm pub-btn--primary" disabled="@(_busy || !stateReady)" @onclick="() => ApproveStateAsync(sg)">Approve to @Next <i class="bi bi-arrow-right"></i></button>
                                            <button type="button" class="pub-btn-chevron" aria-expanded="@open" aria-label="Show HQ requests of @sg.State" @onclick="() => ToggleState(sg.State)">
                                                <i class="bi bi-chevron-@(open ? "up" : "down")"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                @if (open)
                                {
                                    <tr class="pub-subrow">
                                        <td colspan="10">
                                            <div class="pub-inner-wrap">
                                                <h3 class="pub-inner-title">@sg.State - HQ Request (@sg.Rows.Count)</h3>
                                                @if (sg.Rows.Count == 0)
                                                {
                                                    <p class="pub-banner__sub">No requirements received from this State yet.</p>
                                                }
                                                else
                                                {
                                                    <div class="pub-table-wrap">
                                                        <table class="pub-table pub-table--inner">
                                                            <thead>
                                                                <tr>
                                                                    <th>S:No</th>
                                                                    <th>Request ID</th>
                                                                    <th>Request Date</th>
                                                                    <th>Region</th>
                                                                    <th>HQ</th>
                                                                    <th>Product</th>
                                                                    <th>Publicity Material</th>
                                                                    <th>Request Qty</th>
                                                                    <th>Approved Qty</th>
                                                                    <th>Status</th>
                                                                    <th>Action</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @foreach (var (r, j) in sg.Rows.Select((r, j) => (r, j)))
                                                                {
                                                                    <tr>
                                                                        <td data-label="S:No">@(j + 1)</td>
                                                                        <td data-label="Request ID" class="pub-req-id">@r.IndentNo</td>
                                                                        <td data-label="Request Date">@PubText.Date(r.CreatedAt)</td>
                                                                        <td data-label="Region">@r.Region</td>
                                                                        <td data-label="HQ">@r.Hq</td>
                                                                        <td data-label="Product">
                                                                            @if (r.Items.Count > 1)
                                                                            {
                                                                                <button type="button" class="pub-btn-chevron" aria-expanded="@IsRowOpen(r.Id)" aria-label="Show all products for @r.IndentNo" @onclick="() => ToggleRow(r.Id)">
                                                                                    <i class="bi bi-chevron-@(IsRowOpen(r.Id) ? "up" : "down")"></i>
                                                                                </button>
                                                                                <span>@r.Items.Count Products</span>
                                                                            }
                                                                            else
                                                                            {
                                                                                @(string.IsNullOrWhiteSpace(r.Product) ? "—" : r.Product)
                                                                            }
                                                                        </td>
                                                                        <td data-label="Publicity Material">@r.Material</td>
                                                                        <td data-label="Request Qty">@r.OriginalQuantity</td>
                                                                        <td data-label="Approved Qty">@r.Quantity</td>
                                                                        <td data-label="Status">
                                                                            <span class="pub-pill pub-pill--green">Approved by RM</span>
                                                                            @if (!string.IsNullOrWhiteSpace(r.RmApprovedByName))
                                                                            {
                                                                                <span class="pub-review-subtag pub-review-subtag--neutral">@r.RmApprovedByName</span>
                                                                            }
                                                                            @if (IsSmd)
                                                                            {
                                                                                @if (r.SmdReviewedAt is not null)
                                                                                {
                                                                                    <span class="pub-review-subtag pub-review-subtag--done"><i class="bi bi-check-circle-fill"></i> Reviewed by SMD@(string.IsNullOrWhiteSpace(r.SmdReviewedByName) ? "" : $" — {r.SmdReviewedByName}")</span>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <span class="pub-review-subtag pub-review-subtag--pending">Pending SMD Review</span>
                                                                                }
                                                                            }
                                                                        </td>
                                                                        <td data-label="Action" class="pub-inner-actions">
                                                                            <a class="pub-inner-action-link pub-action-view" href="@($"/PublicityReview/{r.Id}?back=consolidation")" title="View @r.IndentNo" aria-label="View @r.IndentNo"><i class="bi bi-eye"></i></a>
                                                                            <a class="pub-inner-action-link pub-action-edit" href="@($"/PublicityReview/edit/{r.Id}?back=consolidation")" title="Edit @r.IndentNo" aria-label="Edit @r.IndentNo"><i class="bi bi-pencil"></i></a>
                                                                        </td>
                                                                    </tr>
                                                                    @if (r.Items.Count > 1 && IsRowOpen(r.Id))
                                                                    {
                                                                        <tr class="pub-subrow">
                                                                            <td colspan="11">
                                                                                <div class="pub-inner-wrap">
                                                                                    <table class="pub-table pub-table--inner">
                                                                                        <thead><tr><th>Product</th><th>Requested Qty</th><th>Approved Qty</th><th>Design File</th></tr></thead>
                                                                                        <tbody>
                                                                                            @foreach (var item in r.Items)
                                                                                            {
                                                                                                <tr>
                                                                                                    <td data-label="Product">@item.ProductName</td>
                                                                                                    <td data-label="Requested Qty">@item.OriginalQuantity</td>
                                                                                                    <td data-label="Approved Qty">@item.Quantity</td>
                                                                                                    <td data-label="Design File">
                                                                                                        @if (!string.IsNullOrEmpty(item.DesignFilePath))
                                                                                                        {
                                                                                                            <span class="pub-muted">@(item.DesignFileName ?? "Design File")</span>
                                                                                                            <a class="pub-icon-btn" href="@Api.FileUrl(item.DesignFilePath)" target="_blank" rel="noopener" title="Preview" aria-label="Preview @item.DesignFileName"><i class="bi bi-eye"></i></a>
                                                                                                            <a class="pub-icon-btn pub-icon-btn--green" href="@Api.FileUrl(item.DesignFilePath, download: true)" target="_blank" rel="noopener" title="Download" aria-label="Download @item.DesignFileName"><i class="bi bi-download"></i></a>
                                                                                                        }
                                                                                                        else
                                                                                                        {
                                                                                                            <span class="pub-muted">—</span>
                                                                                                        }
                                                                                                    </td>
                                                                                                </tr>
                                                                                            }
                                                                                        </tbody>
                                                                                    </table>
                                                                                </div>
                                                                            </td>
                                                                        </tr>
                                                                    }
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="pub-table-wrap">
                    <table class="pub-table pub-table--consolidation">
                        <thead>
                            <tr>
                                <th class="text-center">S.NO</th>
                                @if (!Api.IsFieldApprover) { <th class="text-start">State</th> }
                                <th class="text-start">Region</th>
                                <th class="text-center">Total HQs</th>
                                <th class="text-center">Total Requests</th>
                                <th class="text-center">Total Quantity (Nos)</th>
                                <th class="text-center">Review Progress</th>
                                <th class="text-center">@(IsSmm ? "SMDO Status" : "Region Status")</th>
                                <th class="text-center">Last Updated</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var (g, i) in Groups.Select((g, i) => (g, i)))
                            {
                                var open = _open.Contains(g.Region);
                                var canFinalize = IsSmd;
                                <tr class="pub-master-row @(open ? "is-expanded" : "")">
                                    <td class="text-center" data-label="S.NO">@(i + 1)</td>
                                    @if (!Api.IsFieldApprover) { <td class="text-start" data-label="State">@g.State</td> }
                                    <td class="text-start pub-region-name" data-label="Region">@g.Region</td>
                                    <td class="text-center" data-label="Total HQs">@g.Hqs</td>
                                    <td class="text-center" data-label="Total Requests">@g.EligibleCount</td>
                                    <td class="text-center" data-label="Total Quantity (Nos)">@g.Quantity</td>
                                    <td class="text-center" data-label="Review Progress">
                                        <span class="pub-reviewed-stat @(RegionFullyArrived(g) ? "is-done" : "is-pending")">
                                            <i class="bi bi-check-circle"></i> @ReviewFraction(g)
                                        </span>
                                    </td>
                                    <td class="text-center" data-label="Status">
                                        <span class="pub-pill pub-pill--@RegionStatusTone(g)">@RegionStatusText(g)</span>
                                    </td>
                                    <td class="text-center" data-label="Last Updated">@PubText.Date(g.LastUpdated)</td>
                                    <td class="text-center" data-label="Action">
                                        <div class="pub-inner-actions">
                                            @if (canFinalize && g.Status == PubRegionStatus.Reviewed)
                                            {
                                                <button type="button" class="pub-btn pub-btn--sm pub-btn--primary" disabled="@_busy" @onclick="() => ApproveRegionAsync(g)">Mark Region as Reviewed</button>
                                            }
                                            @if (canFinalize && g.Status == PubRegionStatus.ZeroSubmittedByRm)
                                            {
                                                <button type="button" class="pub-btn pub-btn--sm pub-btn--primary" disabled="@_busy" @onclick="() => FinalizeZeroAsync(g)">Finalize</button>
                                            }
                                            @if (IsRm && g.Status == PubRegionStatus.PendingReview && g.EligibleCount == 0 && g.StillAtRmCount == 0)
                                            {
                                                <button type="button" class="pub-btn pub-btn--sm pub-btn--primary" disabled="@_busy" @onclick="() => RmSubmitZeroAsync(g)">Submit Zero Requirement</button>
                                            }
                                            <button type="button" class="pub-btn-chevron" aria-expanded="@open" aria-label="Show HQ requests of @g.Region" @onclick="() => Toggle(g.Region)">
                                                <i class="bi bi-chevron-@(open ? "up" : "down")"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                @if (open)
                                {
                                    <tr class="pub-subrow">
                                        <td colspan="@(Api.IsFieldApprover ? 9 : 10)">
                                            <div class="pub-inner-wrap">
                                                <h3 class="pub-inner-title">@g.Region - HQ Request (@g.Rows.Count)</h3>
                                                @if (g.Rows.Count == 0)
                                                {
                                                    <p class="pub-banner__sub">No requirements received from this Region yet.</p>
                                                }
                                                else
                                                {
                                                    <div class="pub-table-wrap">
                                                        <table class="pub-table pub-table--inner">
                                                            <thead>
                                                                <tr>
                                                                    <th>S:No</th>
                                                                    <th>Request ID</th>
                                                                    <th>Request Date</th>
                                                                    <th>HQ</th>
                                                                    <th>RMDO</th>
                                                                    <th>Product</th>
                                                                    <th>Publicity Material</th>
                                                                    <th>Request Qty</th>
                                                                    <th>Approved Qty</th>
                                                                    <th>Status</th>
                                                                    <th>Action</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @foreach (var (r, j) in g.Rows.Select((r, j) => (r, j)))
                                                                {
                                                                    <tr>
                                                                        <td data-label="S:No">@(j + 1)</td>
                                                                        <td data-label="Request ID" class="pub-req-id">@r.IndentNo</td>
                                                                        <td data-label="Request Date">@PubText.Date(r.CreatedAt)</td>
                                                                        <td data-label="HQ">@r.Hq</td>
                                                                        <td data-label="RMDO">@(string.IsNullOrWhiteSpace(r.CreatedByName) ? "—" : r.CreatedByName)</td>
                                                                        <td data-label="Product">
                                                                            @if (r.Items.Count > 1)
                                                                            {
                                                                                <button type="button" class="pub-btn-chevron" aria-expanded="@IsRowOpen(r.Id)" aria-label="Show all products for @r.IndentNo" @onclick="() => ToggleRow(r.Id)">
                                                                                    <i class="bi bi-chevron-@(IsRowOpen(r.Id) ? "up" : "down")"></i>
                                                                                </button>
                                                                                <span>@r.Items.Count Products</span>
                                                                            }
                                                                            else
                                                                            {
                                                                                @(string.IsNullOrWhiteSpace(r.Product) ? "—" : r.Product)
                                                                            }
                                                                        </td>
                                                                        <td data-label="Publicity Material">@r.Material</td>
                                                                        <td data-label="Request Qty">@r.OriginalQuantity</td>
                                                                        <td data-label="Approved Qty">@r.Quantity</td>
                                                                        <td data-label="Status">
                                                                            <span class="pub-pill pub-pill--green">Approved by RM</span>
                                                                            @if (!string.IsNullOrWhiteSpace(r.RmApprovedByName))
                                                                            {
                                                                                <span class="pub-review-subtag pub-review-subtag--neutral">@r.RmApprovedByName</span>
                                                                            }
                                                                            @if (IsSmd)
                                                                            {
                                                                                @if (r.SmdReviewedAt is not null)
                                                                                {
                                                                                    <span class="pub-review-subtag pub-review-subtag--done"><i class="bi bi-check-circle-fill"></i> Reviewed by SMD@(string.IsNullOrWhiteSpace(r.SmdReviewedByName) ? "" : $" — {r.SmdReviewedByName}")</span>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <span class="pub-review-subtag pub-review-subtag--pending">Pending SMD Review</span>
                                                                                }
                                                                            }
                                                                        </td>
                                                                        <td data-label="Action" class="pub-inner-actions">
                                                                            <a class="pub-inner-action-link pub-action-view" href="@($"/PublicityReview/{r.Id}?back=consolidation")" title="View @r.IndentNo" aria-label="View @r.IndentNo"><i class="bi bi-eye"></i></a>
                                                                            <a class="pub-inner-action-link pub-action-edit" href="@($"/PublicityReview/edit/{r.Id}?back=consolidation")" title="Edit @r.IndentNo" aria-label="Edit @r.IndentNo"><i class="bi bi-pencil"></i></a>
                                                                        </td>
                                                                    </tr>
                                                                    @if (r.Items.Count > 1 && IsRowOpen(r.Id))
                                                                    {
                                                                        <tr class="pub-subrow">
                                                                            <td colspan="11">
                                                                                <div class="pub-inner-wrap">
                                                                                    <table class="pub-table pub-table--inner">
                                                                                        <thead><tr><th>Product</th><th>Requested Qty</th><th>Approved Qty</th><th>Design File</th></tr></thead>
                                                                                        <tbody>
                                                                                            @foreach (var item in r.Items)
                                                                                            {
                                                                                                <tr>
                                                                                                    <td data-label="Product">@item.ProductName</td>
                                                                                                    <td data-label="Requested Qty">@item.OriginalQuantity</td>
                                                                                                    <td data-label="Approved Qty">@item.Quantity</td>
                                                                                                    <td data-label="Design File">
                                                                                                        @if (!string.IsNullOrEmpty(item.DesignFilePath))
                                                                                                        {
                                                                                                            <span class="pub-muted">@(item.DesignFileName ?? "Design File")</span>
                                                                                                            <a class="pub-icon-btn" href="@Api.FileUrl(item.DesignFilePath)" target="_blank" rel="noopener" title="Preview" aria-label="Preview @item.DesignFileName"><i class="bi bi-eye"></i></a>
                                                                                                            <a class="pub-icon-btn pub-icon-btn--green" href="@Api.FileUrl(item.DesignFilePath, download: true)" target="_blank" rel="noopener" title="Download" aria-label="Download @item.DesignFileName"><i class="bi bi-download"></i></a>
                                                                                                        }
                                                                                                        else
                                                                                                        {
                                                                                                            <span class="pub-muted">—</span>
                                                                                                        }
                                                                                                    </td>
                                                                                                </tr>
                                                                                            }
                                                                                        </tbody>
                                                                                    </table>
                                                                                </div>
                                                                            </td>
                                                                        </tr>
                                                                    }
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                @if (!IsSmm)
                {
                    <div class="pub-banner--approval @(ready ? "is-ready" : "is-pending")">
                        <div class="pub-banner__left">
                            <span class="pub-banner__icon">
                                <i class="bi bi-file-earmark-text"></i>
                            </span>
                            <div class="pub-banner__text">
                                <h3 class="pub-banner__heading">@reviewedRegionCount of @_c.Regions Regions Reviewed</h3>
                                <p class="pub-banner__sub">
                                    @if (ready)
                                    {
                                        @:All @_c.Regions region(s) accounted for and ready for @Next Review.
                                    }
                                    else if (IsSmd)
                                    {
                                        var pendingRm = _c.Groups.Count(g => g.Status == PubRegionStatus.PendingReview);
                                        @:@reviewedRegionCount of @_c.Regions Regions Reviewed@(pendingRm > 0 ? $" ({pendingRm} Region{(pendingRm == 1 ? "" : "s")} Awaiting RM Submission)" : "").
                                        @if (UnresolvedRegionDetails.Any())
                                        {
                                            @: Pending: @string.Join(", ", UnresolvedRegionDetails).
                                        }
                                    }
                                    else
                                    {
                                        @:@reviewedRegionCount of @_c.Regions regions reviewed. @pendingReviewRegions regions are pending from @Prev
                                    }
                                </p>
                            </div>
                        </div>
                        <button type="button" class="pub-btn--submit @(ready ? "pub-btn--ready" : "pub-btn--disabled")" disabled="@(_busy || !ready)" @onclick="ApproveAllAsync">
                            Approve &amp; Submit to @Next <i class="bi bi-arrow-right"></i>
                        </button>
                    </div>
                }
                else
                {
                    <div class="pub-banner--approval @(ready ? "is-ready" : "is-pending")">
                        <div class="pub-banner__left">
                            <span class="pub-banner__icon"><i class="bi bi-file-earmark-text"></i></span>
                            <div class="pub-banner__text">
                                <h3 class="pub-banner__heading">@reviewedRegionCount of @_c.Regions Regions Reviewed</h3>
                                <p class="pub-banner__sub">
                                    @if (ready)
                                    {
                                        @:All @_c.Regions region(s) reviewed and ready to forward to @Next.
                                    }
                                    else
                                    {
                                        @:@reviewedRegionCount of @_c.Regions regions reviewed. @pendingReviewRegions regions still pending.
                                    }
                                </p>
                            </div>
                        </div>
                        <button type="button" class="pub-btn--submit @(ready ? "pub-btn--ready" : "pub-btn--disabled")" disabled="@(_busy || !ready)" @onclick="ApproveAllAsync">
                            Approve &amp; Submit to @Next <i class="bi bi-arrow-right"></i>
                        </button>
                    </div>
                }
            }
        </section>
    }
</div>

@code {
    private PubConsolidationDto? _c;
    private readonly HashSet<string> _open = new();
    private readonly HashSet<string> _openStates = new();
    // Per-request product expand (RowsAsync now populates PubRowDto.Items for every request, single-
    // or multi-item alike) - a Specific Product request's inner "HQ Request" row shows just its first
    // product + a count until expanded, same two-level disclosure pattern as the Region/State groups
    // above, just one level deeper. Keyed by request Id, shared across both the State-bulk and
    // Region-grouped inner tables below since a request can only ever appear in one of them.
    private readonly HashSet<int> _openRows = new();
    private bool IsRowOpen(int id) => _openRows.Contains(id);
    private void ToggleRow(int id) { if (!_openRows.Remove(id)) _openRows.Add(id); }
    private string _q = "";
    private bool _busy;

    private bool IsSmd => Api.Role == AppRole.SMD;
    private bool IsRm => Api.Role == AppRole.RM;
    private bool IsSmm => Api.Role == AppRole.SMM;
    // No dedicated DGM-MD CS Figma exists - it reuses the ADMIN-MD CS state-grouped bulk view (same
    // underlying data shape, just a different next-stage label below), per the explicit instruction
    // to "reuse established consolidation/table design patterns" rather than invent a fourth design.
    private bool IsStateBulkView => Api.IsAdminMdCs || Api.IsDgmMdCs;
    private string Prev => Api.Role switch
    {
        AppRole.SMM => "SMDO",
        _ => Api.MyStage is { } st ? PubText.Prev(st) : "Previous level"
    };
    private string Next => Api.MyStage is { } st ? PubText.Next(st) : "next level";
    private string Heading => Api.Role switch
    {
        AppRole.RM => "Region Consolidation (RM Review)",
        AppRole.SMD => "State Consolidation (SMDO)",
        AppRole.SMM => "State Consolidation (SMM Review)",
        _ => Api.IsAdminMdCs ? "State Consolidation (ADMIN Review)" : $"State Consolidation ({Api.MyStageLabel ?? "Review"})"
    };
    private string Subtitle => Api.Role switch
    {
        AppRole.SMM => $"Review the SMDO consolidated submission for {CleanScope} and take necessary action.",
        _ => Api.IsAdminMdCs ? "Review and approve consolidated submissions for all states."
            : $"Review all region requirements, ensure all regions are accounted for (including 0), and submit the consolidated requirement to {Next}."
    };
    private string CleanScope => _c?.Scope?.Replace(" (State Level)", "").Replace(" (Region Level)", "") ?? "your area";
    private static string Fy => DateTime.Today.Month >= 4 ? $"{DateTime.Today.Year} - {DateTime.Today.Year + 1}" : $"{DateTime.Today.Year - 1} - {DateTime.Today.Year}";

    // Real, backend-enforced completion for SMD (every Region Approved or Zero Confirmed - see
    // PublicityController.ReviewBulk's own gate); for every other role this is the same "has
    // everything that will ever arrive at my stage already arrived" signal the page always showed
    // before - purely informational there, since the backend never blocked those stages on it.
    private bool Ready => IsSmd ? _c!.RegionsFinalized == _c!.Regions : _c!.Groups.All(g => g.StillAtRmCount == 0);
    // Only an explicit, persisted SMD decision counts as "reviewed" (Approved via Mark Region as
    // Reviewed, or ZeroConfirmed via Finalize) - PubRegionStatus.Reviewed on its own just means "the
    // button is now available", not that SMD has actually clicked it. Reuses the same count the
    // backend already enforces for the SMM-submission gate (Consolidation()'s RegionsFinalized), so
    // the KPI and the real readiness gate can never disagree.
    private int ReviewedRegionCount => _c?.RegionsFinalized ?? 0;
    private IEnumerable<string> UnresolvedRegionNames => _c!.Groups.Where(g => g.Status is not (PubRegionStatus.Approved or PubRegionStatus.ZeroConfirmed)).Select(g => g.Region);
    private IEnumerable<string> UnresolvedRegionDetails => _c!.Groups.Where(g => g.Status is not (PubRegionStatus.Approved or PubRegionStatus.ZeroConfirmed))
        .Select(g => g.StillAtRmCount > 0
            ? $"{g.Region} ({PubText.RegionStatus(g)} — {g.StillAtRmCount} more awaiting RM)"
            : $"{g.Region} ({PubText.RegionStatus(g)})");

    private bool RegionFullyArrived(PubRegionDto g) => g.StillAtRmCount == 0;
    // SMD: exclude not-yet-arrived requests from the denominator (the "3 of 6" confusion this page
    // was built to fix). Every other role keeps the exact fraction it always showed.
    private string ReviewFraction(PubRegionDto g) => IsSmd ? $"{g.ReviewedCount} / {g.EligibleCount}" : $"{g.EligibleCount} / {g.EligibleCount + g.StillAtRmCount}";
    private string RegionStatusText(PubRegionDto g) => PubText.RegionStatus(g);
    private string RegionStatusTone(PubRegionDto g) => PubText.RegionStatusTone(g);

    private IEnumerable<PubRegionDto> Groups => string.IsNullOrWhiteSpace(_q) ? _c!.Groups
        : _c!.Groups.Where(g => g.Region.Contains(_q, StringComparison.OrdinalIgnoreCase) || g.Rows.Any(r => r.Hq.Contains(_q, StringComparison.OrdinalIgnoreCase) || r.IndentNo.Contains(_q, StringComparison.OrdinalIgnoreCase)));

    // ADMIN-MD CS / DGM-MD CS see one row per STATE: every Region the existing per-region grouping
    // (BuildRegionGroupsAsync, unchanged server-side) already returned for that state, rolled up.
    // Nothing new is fetched or computed server-side - this is purely a client-side re-grouping of
    // the same PubRegionDto rows every other role already receives.
    private sealed record StateGroup(int StateId, string State, List<PubRegionDto> Regions)
    {
        public int RegionCount => Regions.Count;
        public int Hqs => Regions.Sum(r => r.Hqs);
        public int Requests => Regions.Sum(r => r.EligibleCount);
        public int Quantity => Regions.Sum(r => r.Quantity);
        public int ReviewedCount => Regions.Sum(r => r.ReviewedCount);
        public DateTime? LastUpdated => Regions.Select(r => r.LastUpdated).Where(d => d.HasValue).Select(d => d!.Value).DefaultIfEmpty().Cast<DateTime?>().Max();
        public List<PubRowDto> Rows => Regions.SelectMany(r => r.Rows).ToList();
    }

    private List<StateGroup> StateGroups => Groups.GroupBy(g => (g.StateId, g.State))
        .Select(grp => new StateGroup(grp.Key.StateId, grp.Key.State, grp.ToList()))
        .OrderBy(sg => sg.State).ToList();

    private bool StateReady(StateGroup sg) => sg.Requests > 0 && sg.ReviewedCount == sg.Requests && sg.Regions.All(r => r.StillAtRmCount == 0);
    private int ReadyStateCount => StateGroups.Count(StateReady);

    private void ToggleState(string state) { if (!_openStates.Remove(state)) _openStates.Add(state); }

    protected override async Task OnInitializedAsync()
    {
        // RM no longer has a Consolidation page - its own Region-level actions (bulk forward / Zero
        // Requirement) now live directly on /PublicityReview instead (see PublicityList.razor's RM
        // action banner). A direct navigation here is bounced back rather than silently rendered -
        // the underlying Consolidation()/ReviewBulk/ConfirmZeroRegion APIs are still reachable (RM
        // still needs them, just from that other page), only this page's own route is blocked.
        if (Api.Role == AppRole.RM)
        {
            Nav.NavigateTo("/PublicityReview", replace: true);
            return;
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _c = await Api.ConsolidationAsync() ?? new PubConsolidationDto();
        if (IsStateBulkView)
        {
            if (_openStates.Count == 0 && StateGroups.Count > 0) _openStates.Add(StateGroups[0].State);
        }
        else if (_open.Count == 0 && _c.Groups.Count > 0) _open.Add(_c.Groups[0].Region);
    }

    private void Toggle(string region) { if (!_open.Remove(region)) _open.Add(region); }

    private async Task ExportCsv()
    {
        if (_c is null || _c.Groups.Count == 0) return;
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("S.No,Region,Total HQs,Total Requests,Total Quantity (Nos),Review Progress,Status,Last Updated");
        var idx = 1;
        foreach (var g in Groups)
        {
            sb.AppendLine($"{idx++},\"{g.Region}\",{g.Hqs},{g.EligibleCount},{g.Quantity},\"{ReviewFraction(g)}\",\"{RegionStatusText(g)}\",\"{PubText.Date(g.LastUpdated)}\"");
        }
        var bytes = System.Text.Encoding.UTF8.GetBytes(sb.ToString());
        await Downloads.SaveAsync($"Consolidation_{DateTime.Now:yyyyMMdd}.csv", "text/csv", bytes);
    }

    private async Task ApproveRegionAsync(PubRegionDto g)
    {
        if (!await Toast.ConfirmAsync("Mark Region as Reviewed", $"Mark {g.Region} — {g.EligibleCount} request(s), {g.Quantity} Nos — as reviewed and ready for State submission?", "Mark as Reviewed")) return;
        _busy = true;
        var ok = await Api.ApproveRegionAsync(g.StateId, g.RegionId, null);
        _busy = false;
        if (!ok) return;
        Toast.Success($"{g.Region} marked as reviewed.");
        await LoadAsync();
    }

    private async Task FinalizeZeroAsync(PubRegionDto g)
    {
        if (!await Toast.ConfirmAsync("Finalize Zero Requirement", $"Acknowledge and finalize {g.Region}'s confirmed Zero Requirement for State consolidation?", "Finalize Zero")) return;
        _busy = true;
        var ok = await Api.FinalizeZeroRegionAsync(g.StateId, g.RegionId, null);
        _busy = false;
        if (!ok) return;
        Toast.Success($"{g.Region} zero requirement finalized.");
        await LoadAsync();
    }

    private async Task RmSubmitZeroAsync(PubRegionDto g)
    {
        if (!await Toast.ConfirmAsync("Submit Zero Requirement", $"Confirm that {g.Region} has no publicity material requirement this round? This will be submitted to SMD for State consolidation.", "Submit Zero Requirement")) return;
        _busy = true;
        var ok = await Api.ConfirmZeroRegionAsync(g.StateId, g.RegionId, null);
        _busy = false;
        if (!ok) return;
        Toast.Success($"Zero Requirement submitted for {g.Region}.");
        await LoadAsync();
    }

    // One State's worth of eligible requests, forwarded in a single confirmed bulk action - reuses
    // the exact same review-bulk endpoint ApproveAllAsync below calls for SMD, just scoped to this
    // State's own ids instead of every group's. ReviewOneAsync (server-side) already refuses to
    // re-advance a request that isn't still sitting at my stage, so a repeat click / double-submit
    // here can only ever re-process whatever (if anything) is genuinely still pending - never create
    // a duplicate forward of something already handled.
    private async Task ApproveStateAsync(StateGroup sg)
    {
        var ids = sg.Rows.Select(r => r.Id).ToList();
        if (!await Toast.ConfirmAsync($"Approve {sg.State}", $"Approve {ids.Count} request(s) ({sg.Quantity} Nos) for {sg.State} and forward to {Next}?", "Approve")) return;
        _busy = true;
        var result = await Api.ReviewBulkDetailedAsync(new PubBulkReviewDto { Ids = ids });
        _busy = false;
        if (result is not { Success: true }) return;
        Toast.Success(result.Approved < ids.Count
            ? $"{result.Approved} of {ids.Count} request(s) for {sg.State} forwarded to {Next} ({ids.Count - result.Approved} already processed or out of scope)."
            : $"{result.Approved} request(s) for {sg.State} forwarded to {Next}.");
        await LoadAsync();
    }

    private async Task ApproveAllAsync()
    {
        var ids = _c!.Groups.SelectMany(g => g.Rows).Select(r => r.Id).ToList();
        // "Approved" (PublicityRegionFinalizationStatus.Approved) is a Region-level workflow status,
        // never a statement about quantity - an authorized reviewer can legitimately edit a request's
        // quantity down to 0 (fully audited via PublicityEvent) and the Region is still Approved, not
        // RM-Declared Zero (that label is reserved for PublicityRegionFinalizationStatus.ZeroConfirmed,
        // which only an RM's own RmZeroSubmitted can ever produce - see ConfirmZeroRegion). So Approved
        // Regions is shown as a plain count, with the live-Quantity-based positive/zero split broken
        // out separately beneath it, computed fresh from each Region's current summed Quantity (never
        // the original requested quantity) - this is purely a label/classification fix, nothing here
        // touches Status, writes a finalization row, or alters any request.
        var approvedGroups = _c.Groups.Where(g => g.Status == PubRegionStatus.Approved).ToList();
        var positiveQtyRegions = approvedGroups.Count(g => g.Quantity > 0);
        var zeroQtyRegions = approvedGroups.Count(g => g.Quantity == 0);
        var message = IsSmd
            ? $"State: {CleanScope}\nTotal Regions: {_c.Regions}\nApproved Regions: {_c.ApprovedRegions}\nRegions with Positive Approved Quantity: {positiveQtyRegions}\nRegions with Zero Approved Quantity: {zeroQtyRegions}\nRM-Declared Zero Regions: {_c.ZeroConfirmedRegions}\nTotal Finalized Regions: {_c.RegionsFinalized}\nTotal Requests: {_c.Requests}\nFinal Consolidated Quantity: {_c.Quantity:N0} Nos\n\nSubmit the consolidated State requirement to {Next}?"
            : $"Approve {ids.Count} request(s) ({_c.Quantity} Nos) and submit them to {Next}?";
        if (!await Toast.ConfirmAsync("Approve & submit", message, "Approve & Submit")) return;
        _busy = true;
        var result = await Api.ReviewBulkDetailedAsync(new PubBulkReviewDto { Ids = ids });
        _busy = false;
        // SendAsync already toasts the actual server error and returns null on failure (see
        // ApiClientBase) - staying on this page in that case needs no extra handling here. Only on
        // confirmed backend success do we leave: the same "View Submitted Request" route the page
        // header already links to, reused rather than inventing a new one. A refreshed/re-submitted
        // consolidation can't duplicate anything either way - ReviewBulk always re-derives its ids
        // from Regions still sitting at SmdReview, and every request this call just advanced is no
        // longer at that stage, so a repeat call has nothing left to submit.
        if (result is not { Success: true }) return;
        Toast.Success(result.Approved < ids.Count
            ? $"{result.Approved} of {ids.Count} request(s) submitted to {Next} ({ids.Count - result.Approved} already processed or out of scope)."
            : $"{result.Approved} request(s) submitted to {Next}.");
        Nav.NavigateTo("/PublicityReview");
    }
}
