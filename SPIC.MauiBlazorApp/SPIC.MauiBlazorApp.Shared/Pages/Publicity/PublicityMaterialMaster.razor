@page "/PublicityMaterialMaster"
@using SPIC.Core.DTOs
@using SPIC.Core.Entities
@using SPIC.MauiBlazorApp.Shared.Components.Publicity
@inject PublicityApi Api
@inject NavigationManager Nav
@inject ToastService Toast

@* Publicity Material Master (2026-11-26, ADMIN-MD CS only). Manages the PublicityMaterialType rows
   that PublicityForm's Specific Product / General Product (and Gift Articles, which reuses the
   General list) dropdowns load from. Access is gated the same way on both ends: Api.CanManageMaterials
   decides whether this page's content renders at all (menu visibility is a separate, identical check
   in NavMenu.razor), and every materials/* endpoint independently re-checks IsAdminMdCsAsync() server
   side - this page redirecting away never WAS the real guard, just the first line of defense. *@

<div class="pub-page">
    <PageHeader Title="Publicity Material Master" Subtitle="Manage publicity material types available for employee requests.">
        <Actions>
            @if (Api.CanManageMaterials)
            {
                <button type="button" class="pub-btn pub-btn--primary" @onclick="OpenAdd"><i class="bi bi-plus-lg"></i> Add Material</button>
            }
        </Actions>
    </PageHeader>

    @if (!Api.CanManageMaterials)
    {
        <EmptyState Icon="bi-shield-lock" Title="Not available" Message="Only ADMIN-MD CS can manage publicity materials." />
    }
    else if (_loadError is not null)
    {
        <EmptyState Icon="bi-exclamation-circle" Title="Could not load materials" Message="@_loadError">
            <button type="button" class="pub-btn pub-btn--primary" @onclick="LoadAsync">Try Again</button>
        </EmptyState>
    }
    else
    {
        <section class="pub-card">
            <div class="pub-card__head">
                <div class="pub-category-filter" role="tablist" aria-label="Category filter">
                    <button type="button" class="pub-btn pub-btn--sm @(_category is null ? "is-active" : "")" @onclick="() => SetCategory(null)">All</button>
                    <button type="button" class="pub-btn pub-btn--sm @(_category == PublicityMaterialCategory.Specific ? "is-active" : "")" @onclick="() => SetCategory(PublicityMaterialCategory.Specific)">Specific Product</button>
                    <button type="button" class="pub-btn pub-btn--sm @(_category == PublicityMaterialCategory.General ? "is-active" : "")" @onclick="() => SetCategory(PublicityMaterialCategory.General)">General Product</button>
                </div>
            </div>

            <SpicDataTable TItem="PubMaterialAdminDto"
                           Items="CategoryFilteredSorted"
                           IsLoading="_isLoading"
                           Title="Publicity Materials"
                           FileName="PublicityMaterials"
                           ExportColumns="GetExportColumns()"
                           SearchText="@_q"
                           InitialPageSize="10"
                           PageSizeOptions="new[] { 10, 25, 50, 100 }"
                           ShowEntriesText="true"
                           EmptyTitle="No materials found"
                           EmptyMessage="Nothing matches these filters.">
                <FilterControls>
                    <div class="pub-search"><i class="bi bi-search"></i><input class="pub-input" placeholder="Search materials..." @bind="_q" @bind:event="oninput" aria-label="Search materials" /></div>
                </FilterControls>

                <TableHeader>
                    <th class="pub-sortable" role="button" @onclick='() => ToggleSort("name")'>Material Name @SortIcon("name")</th>
                    <th class="pub-sortable" role="button" @onclick='() => ToggleSort("category")'>Category @SortIcon("category")</th>
                    <th class="pub-sortable" role="button" @onclick='() => ToggleSort("status")'>Status @SortIcon("status")</th>
                    <th>Action</th>
                </TableHeader>

                <TableRow Context="m">
                    <td><b>@m.Name</b></td>
                    <td>@(m.Category == PublicityMaterialCategory.Specific ? "Specific Product" : "General Product")</td>
                    <td><PubPill Text="@(m.IsActive ? "Active" : "Inactive")" Tone="@(m.IsActive ? "green" : "grey")" /></td>
                    <td class="pub-row-actions">
                        <button type="button" class="pub-icon-btn pub-icon-btn--violet" aria-label="Edit @m.Name" title="Edit" @onclick="() => OpenEdit(m)"><i class="bi bi-pencil"></i></button>
                        <button type="button" class="pub-icon-btn pub-icon-btn--red" aria-label="Delete @m.Name" title="Delete" disabled="@_busy" @onclick="() => OpenDelete(m)"><i class="bi bi-trash"></i></button>
                        <button type="button" class="pub-icon-btn @(m.IsActive ? "pub-icon-btn--red" : "")" aria-label="@(m.IsActive ? "Deactivate" : "Activate") @m.Name" title="@(m.IsActive ? "Deactivate" : "Activate")" disabled="@_busy" @onclick="() => ToggleActiveAsync(m)">
                            <i class="bi @(m.IsActive ? "bi-toggle-on" : "bi-toggle-off")"></i>
                        </button>
                    </td>
                </TableRow>

                <CardActions Context="m">
                    <button type="button" class="pub-btn pub-btn--line pub-btn--sm" @onclick="() => OpenEdit(m)"><i class="bi bi-pencil"></i> Edit</button>
                    <button type="button" class="pub-btn pub-btn--line pub-btn--sm" disabled="@_busy" @onclick="() => OpenDelete(m)"><i class="bi bi-trash pub-text-red"></i> Delete</button>
                    <button type="button" class="pub-btn @(m.IsActive ? "pub-btn--line" : "pub-btn--primary") pub-btn--sm" disabled="@_busy" @onclick="() => ToggleActiveAsync(m)">
                        <i class="bi @(m.IsActive ? "bi-toggle-on" : "bi-toggle-off")"></i> @(m.IsActive ? "Deactivate" : "Activate")
                    </button>
                </CardActions>
            </SpicDataTable>
        </section>
    }

    @* Both modals render INSIDE .pub-page on purpose: every --pub-* custom property (--pub-green,
       --pub-line, etc.) is scoped to .pub-page, not :root (see Publicity.css) - a modal rendered as
       a sibling AFTER .pub-page closes falls outside that scope, so var(--pub-green) resolves to
       nothing. For .pub-btn--primary that silently drops its whole green background (background
       isn't an inherited CSS property, so an out-of-scope var() computes to transparent, not a
       fallback) while white text from the same rule still applies - the Save button was still there,
       just invisible. Keeping the modals as the last children of .pub-page is the fix; no CSS
       override needed. *@
    @if (_showModal)
    {
    <div class="pub-modal" @onkeydown="OnModalKeyDown">
        <div class="pub-modal__backdrop" @onclick="CloseModal"></div>
        <div class="pub-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="pmm-title">
            <div class="pub-modal__header">
                <h2 class="pub-h2" id="pmm-title">@(_editingId is null ? "Add Material" : "Edit Material")</h2>
                <button type="button" class="pub-icon-btn" aria-label="Close" @onclick="CloseModal"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="pub-modal__body">
                <div class="pub-field">
                    <label class="pub-label pub-req" for="pmm-name">Material Name</label>
                    <input id="pmm-name" class="pub-input" @bind="_form.Name" @bind:event="oninput" maxlength="100" placeholder="e.g. Leaflets" />
                </div>
                <div class="pub-field">
                    <label class="pub-label pub-req" for="pmm-cat">Category</label>
                    <select id="pmm-cat" class="pub-input" @bind="_form.Category">
                        <option value="@PublicityMaterialCategory.Specific">Specific Product</option>
                        <option value="@PublicityMaterialCategory.General">General Product</option>
                    </select>
                </div>
                <div class="pub-field">
                    <label class="pub-label" for="pmm-active">Active Status</label>
                    <div class="pub-switch">
                        <input id="pmm-active" type="checkbox" @bind="_form.IsActive" />
                        <span class="pub-muted">@(_form.IsActive ? "Active - visible for new requests" : "Inactive - hidden from new requests")</span>
                    </div>
                </div>
                @if (_error is not null) { <small class="pub-text-red">@_error</small> }
            </div>
            <div class="pub-modal__footer">
                <button type="button" class="pub-btn pub-btn--line" disabled="@_busy" @onclick="CloseModal">Cancel</button>
                <button type="button" class="pub-btn pub-btn--primary" disabled="@_busy" @onclick="SaveAsync">@(_busy ? "Saving..." : "Save")</button>
            </div>
        </div>
    </div>
}

@if (_deleteTarget is { } dm)
{
    <div class="pub-modal" @onkeydown="OnDeleteModalKeyDown">
        <div class="pub-modal__backdrop" @onclick="CloseDeleteModal"></div>
        <div class="pub-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="pmm-del-title">
            <div class="pub-modal__header">
                <h2 class="pub-h2" id="pmm-del-title">Delete Material</h2>
                <button type="button" class="pub-icon-btn" aria-label="Close" @onclick="CloseDeleteModal"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="pub-modal__body">
                <p>Are you sure you want to delete this publicity material?</p>
                <p><b>@dm.Name</b></p>
                @if (_deleteError is not null) { <small class="pub-text-red">@_deleteError</small> }
            </div>
            <div class="pub-modal__footer">
                <button type="button" class="pub-btn pub-btn--line" disabled="@_busy" @onclick="CloseDeleteModal">Cancel</button>
                <button type="button" class="pub-btn pub-btn--danger" disabled="@_busy" @onclick="ConfirmDeleteAsync">@(_busy ? "Deleting..." : "Delete")</button>
            </div>
        </div>
    </div>
    }
</div>

@code {
    private List<PubMaterialAdminDto> _all = new();
    private bool _isLoading = true;
    private string? _loadError;
    private PublicityMaterialCategory? _category;
    private string _q = "";
    private bool _busy;
    private bool _showModal;
    private int? _editingId;
    private string? _error;
    private PubMaterialUpsertDto _form = new();

    // Sort state for the three clickable TableHeader columns (Action is never sortable). Applied
    // BEFORE handing Items to SpicDataTable, so its own search+pagination operate on an
    // already-sorted sequence (Skip/Take preserves order) - no changes needed inside SpicDataTable
    // itself for this, since TableHeader is already a plain host-supplied RenderFragment there.
    private string? _sortColumn;
    private bool _sortAscending = true;

    private List<PubMaterialAdminDto> CategoryFilteredSorted
    {
        get
        {
            IEnumerable<PubMaterialAdminDto> q = _all.Where(m => _category is null || m.Category == _category);
            q = _sortColumn switch
            {
                "name" => _sortAscending ? q.OrderBy(m => m.Name, StringComparer.OrdinalIgnoreCase) : q.OrderByDescending(m => m.Name, StringComparer.OrdinalIgnoreCase),
                "category" => _sortAscending ? q.OrderBy(m => m.Category) : q.OrderByDescending(m => m.Category),
                "status" => _sortAscending ? q.OrderBy(m => m.IsActive) : q.OrderByDescending(m => m.IsActive),
                _ => q.OrderBy(m => m.Category).ThenBy(m => m.SortOrder).ThenBy(m => m.Name, StringComparer.OrdinalIgnoreCase)
            };
            return q.ToList();
        }
    }

    private void ToggleSort(string column)
    {
        if (_sortColumn == column) _sortAscending = !_sortAscending;
        else { _sortColumn = column; _sortAscending = true; }
    }

    private MarkupString SortIcon(string column)
    {
        var icon = _sortColumn != column ? "bi-arrow-down-up" : _sortAscending ? "bi-sort-alpha-down" : "bi-sort-alpha-up";
        return new MarkupString($"<i class=\"bi {icon} pub-sort-icon\" aria-hidden=\"true\"></i>");
    }

    private List<ExportColumn<PubMaterialAdminDto>> GetExportColumns() => new()
    {
        new() { Header = "Material Name", ValueSelector = m => m.Name },
        new() { Header = "Category", ValueSelector = m => m.Category == PublicityMaterialCategory.Specific ? "Specific Product" : "General Product" },
        new() { Header = "Status", ValueSelector = m => m.IsActive ? "Active" : "Inactive" }
    };

    protected override async Task OnInitializedAsync()
    {
        if (!Api.CanManageMaterials) return;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _loadError = null;
        StateHasChanged();
        var result = await Api.MaterialsAdminAsync();
        if (result is null)
        {
            // ApiClientBase already toasted the specific reason (offline/403/500/...) - this page
            // additionally needs a dedicated Retry affordance per spec, since a toast alone is easy
            // to miss and leaves the page looking like it loaded zero materials.
            _loadError = "We couldn't load the publicity materials. Please check your connection and try again.";
        }
        else
        {
            _all = result;
        }
        _isLoading = false;
    }

    private void SetCategory(PublicityMaterialCategory? c) => _category = c;

    private void OpenAdd()
    {
        _editingId = null;
        _form = new PubMaterialUpsertDto { Category = _category ?? PublicityMaterialCategory.General, IsActive = true };
        _error = null;
        _showModal = true;
    }

    private void OpenEdit(PubMaterialAdminDto m)
    {
        _editingId = m.Id;
        _form = new PubMaterialUpsertDto { Name = m.Name, Category = m.Category, IsActive = m.IsActive };
        _error = null;
        _showModal = true;
    }

    private void CloseModal()
    {
        if (_busy) return;
        _showModal = false;
    }

    private Task OnModalKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e) =>
        e.Key == "Escape" ? Task.Run(CloseModal) : Task.CompletedTask;

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_form.Name)) { _error = "Enter the material name."; return; }
        _busy = true;
        _error = null;
        try
        {
            var saved = _editingId is int id
                ? await Api.UpdateMaterialAsync(id, _form)
                : await Api.CreateMaterialAsync(_form);
            if (saved is null) { _error = "Could not save the material. It may already exist in this category."; return; }
            _showModal = false;
            await LoadAsync();
            Toast.Success(_editingId is null ? "Material added." : "Material updated.");
        }
        finally { _busy = false; }
    }

    private async Task ToggleActiveAsync(PubMaterialAdminDto m)
    {
        _busy = true;
        try
        {
            var dto = new PubMaterialUpsertDto { Name = m.Name, Category = m.Category, IsActive = !m.IsActive };
            var saved = await Api.UpdateMaterialAsync(m.Id, dto);
            if (saved is null) { Toast.Error("Could not update the material status."); return; }
            await LoadAsync();
            Toast.Success(saved.IsActive ? "Material activated." : "Material deactivated.");
        }
        finally { _busy = false; }
    }

    // ---- delete (separate confirm modal from Add/Edit's _showModal - both can't be open at once,
    // but they're independent concepts: one edits a form, the other just confirms a destructive
    // action on an already-known row) ----
    private PubMaterialAdminDto? _deleteTarget;
    private string? _deleteError;

    private void OpenDelete(PubMaterialAdminDto m)
    {
        _deleteTarget = m;
        _deleteError = null;
    }

    private void CloseDeleteModal()
    {
        if (_busy) return;
        _deleteTarget = null;
        _deleteError = null;
    }

    private Task OnDeleteModalKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e) =>
        e.Key == "Escape" ? Task.Run(CloseDeleteModal) : Task.CompletedTask;

    private async Task ConfirmDeleteAsync()
    {
        if (_deleteTarget is not { } m) return;
        _busy = true;
        _deleteError = null;
        try
        {
            // DeleteMaterialAsync's own ApiClientBase plumbing already toasts the server's specific
            // reason (e.g. "used by N publicity request(s)" - see PublicityController.DeleteMaterial)
            // on failure; this generic fallback just keeps the modal open with *something* visible
            // in case the toast is missed, same as SaveAsync's _error above.
            var ok = await Api.DeleteMaterialAsync(m.Id);
            if (!ok) { _deleteError = "Could not delete this material. It may be in use by existing requests - deactivate it instead."; return; }
            _deleteTarget = null;
            await LoadAsync();
            Toast.Success("Material deleted.");
        }
        finally { _busy = false; }
    }
}
