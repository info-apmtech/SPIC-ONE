                    item.JuneCount =
                        draft.JuneCount;

                    item.JuneBudget =
                        draft.June;



                    item.JulyCount =
                        draft.JulyCount;

                    item.JulyBudget =
                        draft.July;



                    item.AugustCount =
                        draft.AugustCount;

                    item.AugustBudget =
                        draft.August;



                    item.SeptemberCount =
                        draft.SeptemberCount;

                    item.SeptemberBudget =
                        draft.September;



                    item.OctoberCount =
                        draft.OctoberCount;

                    item.OctoberBudget =
                        draft.October;



                    item.NovemberCount =
                        draft.NovemberCount;

                    item.NovemberBudget =
                        draft.November;



                    item.DecemberCount =
                        draft.DecemberCount;

                    item.DecemberBudget =
