@code {
    private string GetCurrentFinancialYear()
    {
        var today = DateTime.Now;

        int startYear;

        if (today.Month >= 4) // April to December
        {
            startYear = today.Year;
        }
        else // January to March
        {
            startYear = today.Year - 1;
        }

        return $"{startYear}-{(startYear + 1).ToString().Substring(2)}";
    }

    private void ApplyBudgetFilter()
    {
        if (string.IsNullOrWhiteSpace(_searchText))
        {
            FilteredProgramPlans = programPlans.ToList();
            return;
        }


        FilteredProgramPlans =
            programPlans
            .Where(x =>
                (!string.IsNullOrEmpty(x.ProgramType) &&
                 x.ProgramType.Contains(
                     _searchText,
                     StringComparison.OrdinalIgnoreCase))
                ||
                (!string.IsNullOrEmpty(x.ProgramName) &&
                 x.ProgramName.Contains(
                     _searchText,
                     StringComparison.OrdinalIgnoreCase))
            )
            .ToList();
    }

    private List<ExportColumn<ProgramWiseBudgetDto>> GetBudgetExportColumns()
    {
        return new()
        {
            new ExportColumn<ProgramWiseBudgetDto>
            {
                Header="Program Type",
                ValueSelector=x=>x.ProgramType
            },
            new ExportColumn<ProgramWiseBudgetDto>
            {
                Header="Program Name",
                ValueSelector=x=>x.ProgramName
            },
            new ExportColumn<ProgramWiseBudgetDto>
            {
                Header="Total Budget",
                ValueSelector=x=>x.TotalBudget.ToString()
            }
        };
    }

    private void CalculateBudget(ProgramWiseBudgetDto item)
    {
        decimal baseAmount;


        if (item.IsChangeAmount)
        {
            // User entered amount
            baseAmount = item.TotalBudget;
        }
        else
        {
            // ProgramType fixed amount
            baseAmount = item.BudgetAmount;
            item.TotalBudget = item.BudgetAmount;
        }


        item.AprilBudget = baseAmount * item.AprilCount;
        item.MayBudget = baseAmount * item.MayCount;
        item.JuneBudget = baseAmount * item.JuneCount;
        item.JulyBudget = baseAmount * item.JulyCount;
        item.AugustBudget = baseAmount * item.AugustCount;
        item.SeptemberBudget = baseAmount * item.SeptemberCount;
        item.OctoberBudget = baseAmount * item.OctoberCount;
        item.NovemberBudget = baseAmount * item.NovemberCount;
        item.DecemberBudget = baseAmount * item.DecemberCount;
        item.JanuaryBudget = baseAmount * item.JanuaryCount;
        item.FebruaryBudget = baseAmount * item.FebruaryCount;
        item.MarchBudget = baseAmount * item.MarchCount;
    }

    public class ApiResponse
    {
        public string message { get; set; } = "";

        public object? data { get; set; }
    }
    private bool ValidateBudgetData()
    {
        foreach (var item in FilteredProgramPlans)
        {
            decimal baseAmount = item.IsChangeAmount
      ? item.TotalBudget
      : item.BudgetAmount;


            if (baseAmount <= 0)
            {
                Toast.Error(
                    $"Budget amount missing for {item.ProgramName}"
                );

                return false;
            }


            var missingMonths = new List<string>();

            if (item.AprilCount <= 0)
                missingMonths.Add("April");

            if (item.MayCount <= 0)
                missingMonths.Add("May");

            if (item.JuneCount <= 0)
                missingMonths.Add("June");

            if (item.JulyCount <= 0)
                missingMonths.Add("July");

            if (item.AugustCount <= 0)
                missingMonths.Add("August");

            if (item.SeptemberCount <= 0)
                missingMonths.Add("September");

            if (item.OctoberCount <= 0)
                missingMonths.Add("October");

            if (item.NovemberCount <= 0)
                missingMonths.Add("November");

            if (item.DecemberCount <= 0)
                missingMonths.Add("December");

            if (item.JanuaryCount <= 0)
                missingMonths.Add("January");

            if (item.FebruaryCount <= 0)
                missingMonths.Add("February");

            if (item.MarchCount <= 0)
                missingMonths.Add("March");


            if (missingMonths.Any())
            {
                Toast.Error(
                    $"{item.ProgramName}: Missing count for {string.Join(", ", missingMonths)}"
                );

                return false;
            }
        }

        return true;
    }

    private async Task LoadDraftBudget()
    {
        try
        {
            var drafts =
                await Http.GetFromJsonAsync<List<BudgetProgram>>
                (
                    "api/Budget/drafts"
                )
                ?? new();


            Console.WriteLine(
                $"Draft Count : {drafts.Count}"
            );


            foreach (var item in programPlans)
            {

                var draft = drafts
                    .FirstOrDefault(x =>
                        x.ProgramId == item.ProgramId
                    );


                if (draft != null)
                {

                    Console.WriteLine(
