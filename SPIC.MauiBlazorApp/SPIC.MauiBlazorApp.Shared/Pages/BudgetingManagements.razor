    private bool ValidateBudgetData()
    {
        foreach (var item in FilteredProgramPlans)
        {
            CalculateBudget(item);
        }

        decimal availableBudget = SMMAllocatedBudget;

        decimal allocatedBudget = TotalAllocatedProgramBudget;

        if (availableBudget <= 0)
        {
            Toast.Error(
                "SMM allotted budget is not available."
            );

            return false;
        }

        if (allocatedBudget <= 0)
        {
            Toast.Error(
                "Please allocate budget for at least one program."
            );

            return false;
        }

        if (allocatedBudget > availableBudget)
        {
            Toast.Error(
                $"Program allocation ₹{allocatedBudget:N0} " +
                $"cannot exceed SMM allotted budget ₹{availableBudget:N0}."
            );

            return false;
        }

        return true;
    }

