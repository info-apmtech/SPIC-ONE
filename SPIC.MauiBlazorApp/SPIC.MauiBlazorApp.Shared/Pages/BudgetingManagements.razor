                            FebruaryCount =
                                item.FebruaryCount,

                            February =
                                item.FebruaryBudget,

                            MarchCount =
                                item.MarchCount,

                            March =
                                item.MarchBudget
                        })
                        .ToList()
            };

            // =====================================================
            // SAVE
            // =====================================================

            using var response =
                await Http.PostAsJsonAsync(
                    "api/Budget",
                    request
                );
            if (!response.IsSuccessStatusCode)
            {
                var errorBody =
                    await response.Content
                        .ReadAsStringAsync();

                Console.WriteLine(
                    $"Budget save error ({(int)response.StatusCode}): " +
                    errorBody
                );

                Toast.Error(
                    $"Budget save was not successful " +
                    $"(HTTP {(int)response.StatusCode})."
                );

                return;
            }

            Toast.Success(
                "Budget created successfully."
            );

            // Small delay so success toast is visible
            await Task.Delay(800);

            // Refresh current page
            Navigation.NavigateTo(
                Navigation.Uri,
                forceLoad: true
            );
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);

            Toast.Error(
                "Budget save could not be confirmed. " +
                "Check the saved budget list before retrying."
            );
        }
        finally
        {
            _isSavingBudget = false;
        }
    }
}


