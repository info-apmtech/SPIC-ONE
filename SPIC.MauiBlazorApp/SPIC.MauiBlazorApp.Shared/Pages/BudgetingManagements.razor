    private void CalculateBudget(ProgramWiseBudgetDto item)
    {
        decimal baseAmount;


        if (item.IsChangeAmount)
        {
            // User entered amount
            baseAmount = item.TotalBudget;
        }
        else
        {
            // ProgramType fixed amount
            baseAmount = item.BudgetAmount;
            item.TotalBudget = item.BudgetAmount;
        }


        item.AprilBudget = baseAmount * item.AprilCount;
        item.MayBudget = baseAmount * item.MayCount;
        item.JuneBudget = baseAmount * item.JuneCount;
        item.JulyBudget = baseAmount * item.JulyCount;
        item.AugustBudget = baseAmount * item.AugustCount;
        item.SeptemberBudget = baseAmount * item.SeptemberCount;
        item.OctoberBudget = baseAmount * item.OctoberCount;
        item.NovemberBudget = baseAmount * item.NovemberCount;
        item.DecemberBudget = baseAmount * item.DecemberCount;
        item.JanuaryBudget = baseAmount * item.JanuaryCount;
        item.FebruaryBudget = baseAmount * item.FebruaryCount;
        item.MarchBudget = baseAmount * item.MarchCount;

        StateHasChanged();
    }

