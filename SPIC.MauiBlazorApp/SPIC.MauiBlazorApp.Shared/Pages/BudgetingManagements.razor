    {
        "April", "May", "June", "July", "August", "September",
        "October", "November", "December", "January", "February", "March"
    };


    protected override async Task OnInitializedAsync()
    {
        await LoadFinancialYearsAsync();
        await LoadBudgetDashboard();
        await LoadProgramBudget();
    }

    private async Task OnFYChangedAsync()
    {
        await LoadBudgetDashboard();

        await LoadProgramBudget();

        StateHasChanged();
    }


    private async Task LoadBudgetDashboard()
    {
        SMMAllocatedBudget = 0;
        SMDOAllocatedBudget = 0;
        StateTotalBudget = 0;
        RoleBudgetLabel = "Available Budget";
        RoleBudgetSource = string.Empty;

        // Load dashboard independently.
        // IMPORTANT: an empty/204 dashboard response must NOT stop role-budget from loading.
        try
        {
            using var dashboardResponse =
                await Http.GetAsync("api/Budget/dashboard");

            if (dashboardResponse.IsSuccessStatusCode)
            {
                var dashboardJson =
                    await dashboardResponse.Content.ReadAsStringAsync();

                if (!string.IsNullOrWhiteSpace(dashboardJson))
                {
                    dashboard =
                        System.Text.Json.JsonSerializer.Deserialize<BudgetDashboardDto>(
                            dashboardJson,
                            new System.Text.Json.JsonSerializerOptions
                            {
                                PropertyNameCaseInsensitive = true
                            }) ?? new();
                }
                else
                {
                    dashboard = new();
                    Console.WriteLine(
                        $"Dashboard API returned empty body. Status={(int)dashboardResponse.StatusCode}");
                }
            }
            else
            {
                dashboard = new();

                var dashboardError =
                    await dashboardResponse.Content.ReadAsStringAsync();

                Console.WriteLine(
                    $"Dashboard API failed. Status={(int)dashboardResponse.StatusCode}, Body={dashboardError}");
            }
        }
        catch (Exception ex)
        {
            // Do not return here. Role budget must still be loaded.
            dashboard = new();
            Console.WriteLine($"Dashboard load error: {ex.Message}");
        }

        if (string.IsNullOrWhiteSpace(_selectedFY))
        {
            Console.WriteLine("Selected FY is empty.");
            return;
        }

        var role =
            LoginState.UserRole?.ToString() ?? string.Empty;

        Console.WriteLine(
            $"Budget Load => Role: {role}, " +
            $"StateId: {LoginState.StateId}, " +
            $"RegionId: {LoginState.RegionId}, " +
            $"FY: {_selectedFY}"
        );

        try
        {
            // Single role-budget API call for SMM / SMD / RM / RMD.
            using var response =
                await Http.GetAsync(
                    $"api/Budget/role-budget?fy={Uri.EscapeDataString(_selectedFY)}"
                );

            var body =
                await response.Content.ReadAsStringAsync();

            Console.WriteLine(
                $"Role Budget API => Status={(int)response.StatusCode} {response.StatusCode}, Body={body}"
            );

            if (!response.IsSuccessStatusCode)
            {
                Console.WriteLine(
                    $"Role budget API failed for role {role}."
                );
                return;
            }

            if (string.IsNullOrWhiteSpace(body))
            {
                Console.WriteLine(
                    $"Role budget API returned empty body for role {role}."
                );
                return;
            }

            var result =
                System.Text.Json.JsonSerializer.Deserialize<RoleBudgetDto>(
                    body,
                    new System.Text.Json.JsonSerializerOptions
                    {
                        PropertyNameCaseInsensitive = true
                    }
                );

            if (result == null)
            {
                Console.WriteLine("RoleBudgetDto deserialization returned null.");
                return;
            }

            RoleBudgetLabel =
                string.IsNullOrWhiteSpace(result.BudgetLabel)
                    ? "Available Budget"
                    : result.BudgetLabel;

            RoleBudgetSource =
                result.Source ?? string.Empty;

            switch (role)
            {
                case "SMM":
                    SMMAllocatedBudget = result.BudgetAmount;
                    StateTotalBudget = result.BudgetAmount;
                    break;

                case "SMD":
                    // Existing validation/save logic uses SMMAllocatedBudget as the
                    // available-budget variable, so mirror the SMD budget into it.
                    SMDOAllocatedBudget = result.BudgetAmount;
                    SMMAllocatedBudget = result.BudgetAmount;
                    StateTotalBudget = result.BudgetAmount;
                    break;

                case "RM":
                    SMMAllocatedBudget = result.BudgetAmount;
                    StateTotalBudget = result.BudgetAmount;
                    break;

                case "RMD":
                    SMMAllocatedBudget = result.BudgetAmount;
                    StateTotalBudget = result.BudgetAmount;
                    break;
                case "MO":
                    // MO budget comes from HeadquarterBudgetAllocation.Amount
                    // Keep using SMMAllocatedBudget as the common validation/save variable
                    SMMAllocatedBudget = result.BudgetAmount;
                    StateTotalBudget = result.BudgetAmount;
                    break;
                default:
                    Console.WriteLine($"Unsupported Budget Role: {role}");
                    break;
            }

            Console.WriteLine(
                $"Budget Loaded => Role={role}, FY={_selectedFY}, " +
                $"Budget={result.BudgetAmount}, Label={result.BudgetLabel}, Source={result.Source}"
            );
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Role budget load error: {ex}");

            StateTotalBudget = 0;
            SMMAllocatedBudget = 0;
            SMDOAllocatedBudget = 0;
            RoleBudgetLabel = "Available Budget";
            RoleBudgetSource = string.Empty;
        }
    }


