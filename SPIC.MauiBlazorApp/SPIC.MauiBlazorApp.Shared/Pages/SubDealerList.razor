@code {
    private sealed class StateWiseSubDealerSummaryRow
    {
        public int StateId { get; init; }
        public string StateName { get; init; } = string.Empty;
        public int TotalSubDealers { get; init; }
        public int SavedSubDealers { get; init; }
        public int ActiveSubDealers { get; init; }
        public int InactiveSubDealers { get; init; }
    }

    private sealed class SubDealerExportRow
    {
        public string SubDealerCode { get; init; } = string.Empty;
        public string FirmName { get; init; } = string.Empty;
        public string State { get; init; } = string.Empty;
        public string Region { get; init; } = string.Empty;
        public string Hq { get; init; } = string.Empty;
        public string GstNumber { get; init; } = string.Empty;
        public string PanNumber { get; init; } = string.Empty;
        public string OfficialContactNumber { get; init; } = string.Empty;
        public string WhatsAppNumber { get; init; } = string.Empty;
        public string Status { get; init; } = string.Empty;
        // New export fields
        public string Latitude { get; init; } = string.Empty;
        public string Longitude { get; init; } = string.Empty;
        public string Address { get; init; } = string.Empty;
    }

    private SubDealerPagedListResponse _response = new()
    {
        Page = 1,
        PageSize = 20
    };

    private List<LocationItemDto> _states = new();
    private List<LocationItemDto> _regions = new();
    private List<LocationItemDto> _hqs = new();
    private readonly Dictionary<int, LocationItemDto> _statesById = new();
    private readonly Dictionary<int, LocationItemDto> _regionsById = new();
    private readonly Dictionary<int, LocationItemDto> _hqsById = new();
    private readonly Dictionary<int, List<LocationItemDto>> _regionsByStateId = new();
    private readonly Dictionary<int, List<LocationItemDto>> _hqsByRegionId = new();
    private List<StateWiseSubDealerSummaryRow> _stateWiseSummary = new();
    private List<StateWiseSubDealerSummaryRow> _filteredStateWiseSummary = new();
    private List<StateWiseSubDealerSummaryRow> _pagedStateWiseSummary = new();

    private bool _isStateSummaryLoading;
    private string? _stateSummaryError;
    private string _stateSummarySearchText = string.Empty;
    private string _stateSummarySortColumn = "State";
    private bool _stateSummarySortAscending = true;
    private int _stateSummaryPage = 1;
    private int _stateSummaryPageSize = 10;

    private const int StateSummaryMaxConcurrentRequests = 4;

    private string _searchText = string.Empty;
    private string _statusFilter = string.Empty;

    private int _stateId;
    private int _regionId;
    private int _hqId;

    private int _page = 1;
    private int _pageSize = 20;

    private bool _isLoading;
    private bool _isExporting;
    private CancellationTokenSource? _searchCts;
    private CancellationTokenSource? _listLoadCts;
    private CancellationTokenSource? _stateSummaryLoadCts;
    private CancellationTokenSource? _exportCts;
    private long _listLoadRequestId;
    private bool _isDisposed;

    private const int ExportPageSize = 100;
    private const string ExcelContentType =
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";
    private const string ExcelSpreadsheetNamespace =
        "http://schemas.openxmlformats.org/spreadsheetml/2006/main";

    // Admin / MO Excel import state
    private bool _showImportModal;
    private bool _isImporting;
    private IBrowserFile? _importFile;
    private string? _importMessage;
    private bool _importHasError;
    private readonly List<string> _importErrors = new();
    private const long MaxImportFileSize = 10 * 1024 * 1024;

    private string? _pageMessage;
    private bool _pageMessageIsError;

    private string CurrentRole =>
        LoginState?.UserRole?.ToString() ?? string.Empty;

    private bool IsMoRole =>
        string.Equals(CurrentRole, "MO", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(CurrentRole, "MDO", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(CurrentRole, "JMDO", StringComparison.OrdinalIgnoreCase) ||
        (LoginState?.IsHQRole ?? false);

    private bool IsRmRole =>
        string.Equals(CurrentRole, "RM", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(CurrentRole, "RMD", StringComparison.OrdinalIgnoreCase) ||
        (LoginState?.IsRegionRole ?? false);

    private bool IsSmmRole =>
        string.Equals(CurrentRole, "SMM", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(CurrentRole, "SMD", StringComparison.OrdinalIgnoreCase) ||
        (LoginState?.IsStateRole ?? false);

    private bool IsUnrestricted =>
        LoginState == null ||
        LoginState.IsAdmin ||
        LoginState.IsDirectorOrAVP;

    private bool CanCreateSubDealer =>
        IsMoRole || IsUnrestricted;

    private bool CanImportSubDealers =>
        LoginState.IsAdmin || IsMoRole;

    private bool CanEditSubDealer =>
        IsMoRole || IsUnrestricted;

    private bool IsStateLocked =>
        !IsUnrestricted && (IsMoRole || IsRmRole || IsSmmRole);

    private bool IsRegionLocked =>
        !IsUnrestricted && (IsMoRole || IsRmRole);

    private bool IsHqLocked =>
        !IsUnrestricted && IsMoRole;

    private IEnumerable<LocationItemDto> AllowedStates
    {
        get
        {
            if (IsUnrestricted)
                return _states;

            if (_stateId > 0)
                return _states.Where(x => x.Id == _stateId);

            return Enumerable.Empty<LocationItemDto>();
        }
    }

    private IEnumerable<LocationItemDto> FilteredRegions =>
        _stateId <= 0
            ? _regions
            : _regionsByStateId.TryGetValue(_stateId, out var regions)
                ? regions
                : Enumerable.Empty<LocationItemDto>();

    private IEnumerable<LocationItemDto> FilteredHqs =>
        _regionId <= 0
            ? _hqs
            : _hqsByRegionId.TryGetValue(_regionId, out var hqs)
                ? hqs
                : Enumerable.Empty<LocationItemDto>();

    private int FirstVisibleRecord =>
        _response.TotalCount == 0
            ? 0
            : ((_response.Page - 1) * _response.PageSize) + 1;

    private int LastVisibleRecord =>
        _response.TotalCount == 0
            ? 0
            : Math.Min(
                _response.Page * _response.PageSize,
                _response.TotalCount);

    private IEnumerable<int> VisiblePageNumbers
    {
        get
        {
            if (_response.TotalPages <= 0)
                return Enumerable.Empty<int>();

            var start = Math.Max(1, _response.Page - 2);
            var end = Math.Min(_response.TotalPages, start + 4);

            if (end - start < 4)
                start = Math.Max(1, end - 4);

            return Enumerable.Range(start, end - start + 1);
        }
    }

    private int StateSummaryTotalPages =>
        _filteredStateWiseSummary.Count == 0
            ? 0
            : (int)Math.Ceiling(
                _filteredStateWiseSummary.Count / (double)_stateSummaryPageSize);

    private int StateSummaryFirstVisibleRecord =>
        _filteredStateWiseSummary.Count == 0
            ? 0
            : ((_stateSummaryPage - 1) * _stateSummaryPageSize) + 1;

    private int StateSummaryLastVisibleRecord =>
        _filteredStateWiseSummary.Count == 0
            ? 0
            : Math.Min(
                _stateSummaryPage * _stateSummaryPageSize,
                _filteredStateWiseSummary.Count);

    private IEnumerable<int> VisibleStateSummaryPageNumbers
    {
        get
        {
            if (StateSummaryTotalPages <= 0)
                return Enumerable.Empty<int>();

            var start = Math.Max(1, _stateSummaryPage - 2);
            var end = Math.Min(StateSummaryTotalPages, start + 4);

            if (end - start < 4)
                start = Math.Max(1, end - 4);

            return Enumerable.Range(start, end - start + 1);
        }
    }

    private string RoleScopeMessage
    {
        get
        {
            if (IsMoRole && _hqId > 0)
                return $"Showing saved/updated Sub Dealers for your HQ: {HqName(_hqId)}.";

            if (IsRmRole && _regionId > 0)
                return $"Showing saved/updated Sub Dealers for your Region: {RegionName(_regionId)}.";

            if (IsSmmRole && _stateId > 0)
                return $"Showing saved/updated Sub Dealers for your State: {StateName(_stateId)}.";

            return string.Empty;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LookupCache.EnsureLoadedAsync();

        _states = LookupCache.States;
        _regions = LookupCache.Regions;
        _hqs = LookupCache.Headquarters;

        BuildLocationIndexes();
        ApplyLoggedInRoleScope();

        await Task.WhenAll(
            LoadListAsync(),
            LoadStateWiseSummaryAsync());
    }

    private void BuildLocationIndexes()
    {
        _statesById.Clear();
        _regionsById.Clear();
        _hqsById.Clear();
        _regionsByStateId.Clear();
        _hqsByRegionId.Clear();

        foreach (var state in _states)
            _statesById.TryAdd(state.Id, state);

        foreach (var region in _regions)
        {
            _regionsById.TryAdd(region.Id, region);

            if (!_regionsByStateId.TryGetValue(region.StateId, out var items))
            {
                items = new List<LocationItemDto>();
                _regionsByStateId[region.StateId] = items;
            }

            items.Add(region);
        }

        foreach (var hq in _hqs)
        {
            _hqsById.TryAdd(hq.Id, hq);

            if (!_hqsByRegionId.TryGetValue(hq.RegionId, out var items))
            {
                items = new List<LocationItemDto>();
                _hqsByRegionId[hq.RegionId] = items;
            }

            items.Add(hq);
        }
    }

    private void ApplyLoggedInRoleScope()
    {
        if (IsUnrestricted)
            return;

        if (IsMoRole && LoginState.HQId > 0)
        {
            _hqId = LoginState.HQId;

            _hqsById.TryGetValue(_hqId, out var hq);
            _regionId = hq?.RegionId ?? LoginState.RegionId;

            _regionsById.TryGetValue(_regionId, out var region);
            _stateId = region?.StateId ?? LoginState.StateId;

            return;
        }

        if (IsRmRole && LoginState.RegionId > 0)
        {
            _regionId = LoginState.RegionId;

            _regionsById.TryGetValue(_regionId, out var region);
            _stateId = region?.StateId ?? LoginState.StateId;

            _hqId = 0;
            return;
        }

        if (IsSmmRole && LoginState.StateId > 0)
        {
            _stateId = LoginState.StateId;
            _regionId = 0;
            _hqId = 0;
            return;
        }

        // Backward-compatible fallback for a restricted custom role.
        _stateId = LoginState.StateId;
        _regionId = LoginState.RegionId;
        _hqId = LoginState.HQId;
    }

    private async Task LoadListAsync()
    {
        if (_isDisposed)
            return;

        _listLoadCts?.Cancel();

        var requestCts = new CancellationTokenSource();
        _listLoadCts = requestCts;
        var requestId = ++_listLoadRequestId;
        _isLoading = true;

        try
        {
            var query = new List<string>
            {
                $"page={_page}",
                $"pageSize={_pageSize}"
            };

            if (!string.IsNullOrWhiteSpace(_searchText))
                query.Add($"search={Uri.EscapeDataString(_searchText.Trim())}");

            if (!string.IsNullOrWhiteSpace(_statusFilter))
                query.Add($"status={Uri.EscapeDataString(_statusFilter)}");

            if (_stateId > 0)
                query.Add($"stateId={_stateId}");

            if (_regionId > 0)
                query.Add($"regionId={_regionId}");

            if (_hqId > 0)
                query.Add($"hqId={_hqId}");

            var url =
                "api/SubDealerRegistration/list?" +
                string.Join("&", query);

            var result =
                await Http.GetFromJsonAsync<SubDealerPagedListResponse>(
                    url,
                    requestCts.Token);

            if (requestId != _listLoadRequestId || requestCts.IsCancellationRequested)
                return;

            _response = result ?? new SubDealerPagedListResponse
            {
                Page = _page,
                PageSize = _pageSize
            };

            _page = _response.Page <= 0
                ? 1
                : _response.Page;
        }
        catch (OperationCanceledException) when (requestCts.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            if (requestId != _listLoadRequestId)
                return;

            Console.WriteLine($"Sub Dealer list load failed: {ex.Message}");

            _response = new SubDealerPagedListResponse
            {
                Page = _page,
                PageSize = _pageSize
            };
        }
        finally
        {
            if (requestId == _listLoadRequestId)
            {
                _isLoading = false;

                if (ReferenceEquals(_listLoadCts, requestCts))
                    _listLoadCts = null;
            }

            requestCts.Dispose();
        }
    }

    private async Task LoadStateWiseSummaryAsync()
    {
        if (_isStateSummaryLoading || _isDisposed)
            return;

        var requestCts = new CancellationTokenSource();
        _stateSummaryLoadCts = requestCts;
        _isStateSummaryLoading = true;
        _stateSummaryError = null;

        try
        {
            var masterRows =
                await Http.GetFromJsonAsync<List<SubDealerLookupDto>>(
                    BuildRoleScopedSubDealerLookupUrl(),
                    requestCts.Token) ?? new();

            var masterCountByState = new Dictionary<int, int>();
            foreach (var row in masterRows)
            {
                masterCountByState.TryGetValue(row.StateId, out var count);
                masterCountByState[row.StateId] = count + 1;
            }

            var summaryStates = AllowedStates
                .Where(x => !IsUnrestricted || masterCountByState.ContainsKey(x.Id))
                .OrderBy(x => x.StateName)
                .ToList();

            using var requestGate =
                new SemaphoreSlim(StateSummaryMaxConcurrentRequests);

            var stateTasks = summaryStates.Select(async state =>
            {
                await requestGate.WaitAsync(requestCts.Token);

                try
                {
                    var savedResponse =
                        await Http.GetFromJsonAsync<SubDealerPagedListResponse>(
                            BuildStateSummaryListUrl(state.Id),
                            requestCts.Token) ?? new();

                    var activeCount = savedResponse.ActiveCount;
                    var inactiveCount = savedResponse.InactiveCount;

                    return new StateWiseSubDealerSummaryRow
                    {
                        StateId = state.Id,
                        StateName = state.StateName,
                        TotalSubDealers = masterCountByState.GetValueOrDefault(state.Id),
                        SavedSubDealers = activeCount + inactiveCount,
                        ActiveSubDealers = activeCount,
                        InactiveSubDealers = inactiveCount
                    };
                }
                finally
                {
                    requestGate.Release();
                }
            });

            _stateWiseSummary = (await Task.WhenAll(stateTasks)).ToList();
            _stateSummaryPage = 1;
            UpdateStateSummaryView();
        }
        catch (OperationCanceledException) when (requestCts.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            Console.WriteLine($"State-wise Sub Dealer summary load failed: {ex.Message}");
            _stateWiseSummary.Clear();
            _filteredStateWiseSummary.Clear();
            _pagedStateWiseSummary.Clear();
            _stateSummaryError =
                "Could not load the state-wise Sub Dealer summary. Please refresh and try again.";
        }
        finally
        {
            _isStateSummaryLoading = false;

            if (ReferenceEquals(_stateSummaryLoadCts, requestCts))
                _stateSummaryLoadCts = null;

            requestCts.Dispose();
        }
    }

    private string BuildRoleScopedSubDealerLookupUrl()
    {
        const string baseUrl = "api/SubDealerRegistration/lookup";

        if (IsUnrestricted)
            return baseUrl;

        if (IsMoRole && LoginState.HQId > 0)
            return $"{baseUrl}?hqId={LoginState.HQId}";

        if (IsRmRole && LoginState.RegionId > 0)
            return $"{baseUrl}?regionId={LoginState.RegionId}";

        if (IsSmmRole && LoginState.StateId > 0)
            return $"{baseUrl}?stateId={LoginState.StateId}";

        return baseUrl;
    }

    private string BuildStateSummaryListUrl(int stateId)
    {
        var query = new List<string>
        {
            "page=1",
            "pageSize=1",
            $"stateId={stateId}"
        };

        if (!IsUnrestricted)
        {
            if (IsMoRole && LoginState.HQId > 0)
            {
                query.Add($"hqId={LoginState.HQId}");
            }
            else if (IsRmRole && LoginState.RegionId > 0)
            {
                query.Add($"regionId={LoginState.RegionId}");
            }
            else if (!IsSmmRole)
            {
                if (LoginState.RegionId > 0)
                    query.Add($"regionId={LoginState.RegionId}");

                if (LoginState.HQId > 0)
                    query.Add($"hqId={LoginState.HQId}");
            }
        }

        return "api/SubDealerRegistration/list?" + string.Join("&", query);
    }

    private void UpdateStateSummaryView()
    {
        IEnumerable<StateWiseSubDealerSummaryRow> query = _stateWiseSummary;

        if (!string.IsNullOrWhiteSpace(_stateSummarySearchText))
        {
            var search = _stateSummarySearchText.Trim();
            query = query.Where(x =>
                x.StateName.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase) ||
                x.TotalSubDealers.ToString().Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase) ||
                x.SavedSubDealers.ToString().Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase) ||
                x.ActiveSubDealers.ToString().Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase) ||
                x.InactiveSubDealers.ToString().Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase));
        }

        query = _stateSummarySortColumn switch
        {
            "Total" => _stateSummarySortAscending
                ? query.OrderBy(x => x.TotalSubDealers)
                : query.OrderByDescending(x => x.TotalSubDealers),
            "Saved" => _stateSummarySortAscending
                ? query.OrderBy(x => x.SavedSubDealers)
                : query.OrderByDescending(x => x.SavedSubDealers),
            "Active" => _stateSummarySortAscending
                ? query.OrderBy(x => x.ActiveSubDealers)
                : query.OrderByDescending(x => x.ActiveSubDealers),
            "Inactive" => _stateSummarySortAscending
                ? query.OrderBy(x => x.InactiveSubDealers)
                : query.OrderByDescending(x => x.InactiveSubDealers),
            _ => _stateSummarySortAscending
                ? query.OrderBy(
                    x => x.StateName,
                    StringComparer.OrdinalIgnoreCase)
                : query.OrderByDescending(
                    x => x.StateName,
                    StringComparer.OrdinalIgnoreCase)
        };

        _filteredStateWiseSummary = query.ToList();

        var totalPages = StateSummaryTotalPages;
        if (totalPages == 0)
        {
            _stateSummaryPage = 1;
        }
        else if (_stateSummaryPage > totalPages)
        {
            _stateSummaryPage = totalPages;
        }

        UpdateStateSummaryPage();
    }

    private void UpdateStateSummaryPage()
    {
        _pagedStateWiseSummary = _filteredStateWiseSummary
            .Skip((_stateSummaryPage - 1) * _stateSummaryPageSize)
            .Take(_stateSummaryPageSize)
            .ToList();
    }

    private void OnStateSummarySearchInput(ChangeEventArgs e)
    {
        _stateSummarySearchText = e.Value?.ToString() ?? string.Empty;
        _stateSummaryPage = 1;
        UpdateStateSummaryView();
    }

    private void OnStateSummaryPageSizeChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var value) || value <= 0)
            value = 10;

        _stateSummaryPageSize = value;
        _stateSummaryPage = 1;
        UpdateStateSummaryView();
    }

    private void SortStateSummary(string column)
    {
        if (string.Equals(
            _stateSummarySortColumn,
            column,
            StringComparison.Ordinal))
        {
            _stateSummarySortAscending = !_stateSummarySortAscending;
        }
        else
        {
            _stateSummarySortColumn = column;
            _stateSummarySortAscending = true;
        }

        _stateSummaryPage = 1;
        UpdateStateSummaryView();
    }

    private string StateSummarySortIcon(string column)
    {
        if (!string.Equals(
            _stateSummarySortColumn,
            column,
            StringComparison.Ordinal))
        {
            return "bi-arrow-down-up";
        }

        return _stateSummarySortAscending
            ? "bi-chevron-up"
            : "bi-chevron-down";
    }

    private string StateSummaryAriaSort(string column)
    {
        if (!string.Equals(
            _stateSummarySortColumn,
            column,
            StringComparison.Ordinal))
        {
            return "none";
        }

        return _stateSummarySortAscending
            ? "ascending"
            : "descending";
    }

    private void PreviousStateSummaryPage()
    {
        if (_stateSummaryPage > 1)
        {
            _stateSummaryPage--;
            UpdateStateSummaryPage();
        }
    }

    private void NextStateSummaryPage()
    {
        if (_stateSummaryPage < StateSummaryTotalPages)
        {
            _stateSummaryPage++;
            UpdateStateSummaryPage();
        }
    }

    private void GoToStateSummaryPage(int pageNo)
    {
        if (pageNo >= 1 && pageNo <= StateSummaryTotalPages)
        {
            _stateSummaryPage = pageNo;
            UpdateStateSummaryPage();
        }
    }

    private async Task RefreshAsync()
    {
        _page = 1;
        await Task.WhenAll(
            LoadListAsync(),
            LoadStateWiseSummaryAsync());
    }

    private async Task ExportAllSavedSubDealersAsync()
    {
        if (_isExporting || _isDisposed)
            return;

        var requestCts = new CancellationTokenSource();
        _exportCts = requestCts;
        _isExporting = true;
        _pageMessage = null;

        try
        {
            var exportRows = new List<SubDealerExportRow>();
            var exportPage = 1;

            while (true)
            {
                var result =
                    await Http.GetFromJsonAsync<SubDealerPagedListResponse>(
                        BuildAllSavedSubDealerExportUrl(
                            exportPage,
                            ExportPageSize),
                        requestCts.Token);

                if (result == null || result.Items.Count == 0)
                    break;

                foreach (var item in result.Items)
                {
                    exportRows.Add(new SubDealerExportRow
                    {
                        SubDealerCode = item.SubDealerCode ?? string.Empty,
                        FirmName = item.FirmName ?? string.Empty,

                        State = StateName(item.StateId),
                        Region = RegionName(item.RegionId),
                        Hq = HqName(item.HQId),

                        GstNumber = item.GSTNumber ?? string.Empty,
                        PanNumber = item.PANNo ?? string.Empty,

                        OfficialContactNumber =
         item.OfficialContactNumber ?? string.Empty,

                        WhatsAppNumber =
         item.WhatsAppNumber ?? string.Empty,

                        Status = item.Status == SubDealerStatus.Active
         ? "Active"
         : "Inactive",

                        // New location columns
                        Latitude = item.Latitude.HasValue
         ? item.Latitude.Value.ToString(
             "0.000000",
             System.Globalization.CultureInfo.InvariantCulture)
         : string.Empty,

                        Longitude = item.Longitude.HasValue
         ? item.Longitude.Value.ToString(
             "0.000000",
             System.Globalization.CultureInfo.InvariantCulture)
         : string.Empty,

                        Address = BuildSubDealerExportAddress(item)
                    });
                }

                if (result.TotalPages <= exportPage)
                    break;

                exportPage++;
            }

            if (exportRows.Count == 0)
            {
                _pageMessageIsError = true;
                _pageMessage = "No saved Sub Dealer records are available to export.";
                return;
            }

            var workbookBytes = CreateSubDealerExcelWorkbook(exportRows);
            var fileName =
                $"Saved_Sub_Dealers_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx";

            await JS.InvokeVoidAsync(
                "downloadFileFromBytes",
                fileName,
                ExcelContentType,
                Convert.ToBase64String(workbookBytes));

            _pageMessageIsError = false;
            _pageMessage =
                $"Export completed successfully. {exportRows.Count} saved Sub Dealer record(s) exported.";
        }
        catch (OperationCanceledException) when (requestCts.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Sub Dealer Excel export failed: {ex.Message}");
            _pageMessageIsError = true;
            _pageMessage = "Could not export the saved Sub Dealer records. Please try again.";
        }
        finally
        {
            _isExporting = false;

            if (ReferenceEquals(_exportCts, requestCts))
                _exportCts = null;

            requestCts.Dispose();
        }
    }

    private string BuildAllSavedSubDealerExportUrl(
        int page,
        int pageSize)
    {
        var query = new List<string>
        {
            $"page={page}",
            $"pageSize={pageSize}"
        };

        // Export every saved record available to the logged-in role. Current
        // screen search/status/geography filters intentionally stay independent.
        if (!IsUnrestricted)
        {
            if (IsMoRole && LoginState.HQId > 0)
            {
                query.Add($"hqId={LoginState.HQId}");
            }
            else if (IsRmRole && LoginState.RegionId > 0)
            {
                query.Add($"regionId={LoginState.RegionId}");
            }
            else if (IsSmmRole && LoginState.StateId > 0)
            {
                query.Add($"stateId={LoginState.StateId}");
            }
            else
            {
                if (LoginState.StateId > 0)
                    query.Add($"stateId={LoginState.StateId}");

                if (LoginState.RegionId > 0)
                    query.Add($"regionId={LoginState.RegionId}");

                if (LoginState.HQId > 0)
                    query.Add($"hqId={LoginState.HQId}");
            }
        }

        return "api/SubDealerRegistration/list?" + string.Join("&", query);
    }

    private static byte[] CreateSubDealerExcelWorkbook(
        IReadOnlyList<SubDealerExportRow> rows)
    {
        const string contentTypesXml =
            "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>" +
            "<Types xmlns=\"http://schemas.openxmlformats.org/package/2006/content-types\">" +
            "<Default Extension=\"rels\" ContentType=\"application/vnd.openxmlformats-package.relationships+xml\"/>" +
            "<Default Extension=\"xml\" ContentType=\"application/xml\"/>" +
            "<Override PartName=\"/xl/workbook.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml\"/>" +
            "<Override PartName=\"/xl/worksheets/sheet1.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml\"/>" +
            "<Override PartName=\"/xl/styles.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.spreadsheetml.styles+xml\"/>" +
            "</Types>";

        const string rootRelationshipsXml =
            "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>" +
            "<Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\">" +
            "<Relationship Id=\"rId1\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument\" Target=\"xl/workbook.xml\"/>" +
            "</Relationships>";

        const string workbookXml =
            "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>" +
            "<workbook xmlns=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\" " +
            "xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\">" +
            "<sheets><sheet name=\"Saved Sub Dealers\" sheetId=\"1\" r:id=\"rId1\"/></sheets>" +
            "</workbook>";

        const string workbookRelationshipsXml =
            "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>" +
            "<Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\">" +
            "<Relationship Id=\"rId1\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet\" Target=\"worksheets/sheet1.xml\"/>" +
            "<Relationship Id=\"rId2\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/styles\" Target=\"styles.xml\"/>" +
            "</Relationships>";

        const string stylesXml =
            "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>" +
            "<styleSheet xmlns=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\">" +
            "<fonts count=\"2\">" +
            "<font><sz val=\"11\"/><name val=\"Calibri\"/><family val=\"2\"/><scheme val=\"minor\"/></font>" +
            "<font><b/><color rgb=\"FFFFFFFF\"/><sz val=\"11\"/><name val=\"Calibri\"/></font>" +
            "</fonts>" +
            "<fills count=\"3\">" +
            "<fill><patternFill patternType=\"none\"/></fill>" +
            "<fill><patternFill patternType=\"gray125\"/></fill>" +
            "<fill><patternFill patternType=\"solid\"><fgColor rgb=\"FF07864F\"/><bgColor indexed=\"64\"/></patternFill></fill>" +
            "</fills>" +
            "<borders count=\"2\">" +
            "<border><left/><right/><top/><bottom/><diagonal/></border>" +
            "<border><left style=\"thin\"><color rgb=\"FFD9E1E7\"/></left>" +
            "<right style=\"thin\"><color rgb=\"FFD9E1E7\"/></right>" +
            "<top style=\"thin\"><color rgb=\"FFD9E1E7\"/></top>" +
            "<bottom style=\"thin\"><color rgb=\"FFD9E1E7\"/></bottom><diagonal/></border>" +
            "</borders>" +
            "<cellStyleXfs count=\"1\"><xf numFmtId=\"0\" fontId=\"0\" fillId=\"0\" borderId=\"0\"/></cellStyleXfs>" +
            "<cellXfs count=\"2\">" +
            "<xf numFmtId=\"0\" fontId=\"0\" fillId=\"0\" borderId=\"0\" xfId=\"0\"/>" +
            "<xf numFmtId=\"0\" fontId=\"1\" fillId=\"2\" borderId=\"1\" xfId=\"0\" applyFont=\"1\" applyFill=\"1\" applyBorder=\"1\" applyAlignment=\"1\">" +
            "<alignment horizontal=\"center\" vertical=\"center\"/></xf>" +
            "</cellXfs>" +
            "<cellStyles count=\"1\"><cellStyle name=\"Normal\" xfId=\"0\" builtinId=\"0\"/></cellStyles>" +
            "</styleSheet>";

        using var workbookStream = new MemoryStream();

        using (var archive = new ZipArchive(
            workbookStream,
            ZipArchiveMode.Create,
            leaveOpen: true))
        {
            WriteExcelTextEntry(
                archive,
                "[Content_Types].xml",
                contentTypesXml);
            WriteExcelTextEntry(
                archive,
                "_rels/.rels",
                rootRelationshipsXml);
            WriteExcelTextEntry(
                archive,
                "xl/workbook.xml",
                workbookXml);
            WriteExcelTextEntry(
                archive,
                "xl/_rels/workbook.xml.rels",
                workbookRelationshipsXml);
            WriteExcelTextEntry(
                archive,
                "xl/styles.xml",
                stylesXml);
            WriteSubDealerWorksheet(archive, rows);
        }

        return workbookStream.ToArray();
    }

    private static void WriteExcelTextEntry(
        ZipArchive archive,
        string entryName,
        string content)
    {
        var entry = archive.CreateEntry(
            entryName,
            CompressionLevel.Fastest);

        using var writer = new StreamWriter(
            entry.Open(),
            new UTF8Encoding(encoderShouldEmitUTF8Identifier: false));
        writer.Write(content);
    }

    private static void WriteSubDealerWorksheet(
        ZipArchive archive,
        IReadOnlyList<SubDealerExportRow> rows)
    {
        var entry = archive.CreateEntry(
            "xl/worksheets/sheet1.xml",
            CompressionLevel.Fastest);

        using var entryStream = entry.Open();
        using var writer = XmlWriter.Create(
            entryStream,
            new XmlWriterSettings
            {
                Encoding = new UTF8Encoding(
                    encoderShouldEmitUTF8Identifier: false),
                Indent = false,
                CloseOutput = false
            });

        var headers = new[]
        {
            "S.No",
            "Sub Dealer Code",
            "Firm Name",
            "State",
            "Region",
            "HQ",
            "GST Number",
            "PAN Number",
            "Official Contact Number",
            "WhatsApp Number",
            "Status",
            "Latitude",
            "Longitude",
            "Address"
        };

        var columnLetters = new[]
 {
    "A", "B", "C", "D", "E", "F",
    "G", "H", "I", "J", "K", "L",
    "M", "N"
};

        var columnWidths = new[]
 {
    8d,     // S.No
    20d,    // Sub Dealer Code
    32d,    // Firm Name
    20d,    // State
    22d,    // Region
    22d,    // HQ
    20d,    // GST
    16d,    // PAN
    23d,    // Official Contact
    21d,    // WhatsApp
    14d,    // Status

    16d,    // Latitude
    16d,    // Longitude
    55d     // Address
};

        writer.WriteStartDocument(standalone: true);
        writer.WriteStartElement(
            "worksheet",
            ExcelSpreadsheetNamespace);

        writer.WriteStartElement(
            "dimension",
            ExcelSpreadsheetNamespace);
        writer.WriteAttributeString(
            "ref",
           $"A1:N{Math.Max(1, rows.Count + 1)}");
        writer.WriteEndElement();

        writer.WriteStartElement(
            "sheetViews",
            ExcelSpreadsheetNamespace);
        writer.WriteStartElement(
            "sheetView",
            ExcelSpreadsheetNamespace);
        writer.WriteAttributeString("workbookViewId", "0");
        writer.WriteStartElement(
            "pane",
            ExcelSpreadsheetNamespace);
        writer.WriteAttributeString("ySplit", "1");
        writer.WriteAttributeString("topLeftCell", "A2");
        writer.WriteAttributeString("activePane", "bottomLeft");
        writer.WriteAttributeString("state", "frozen");
        writer.WriteEndElement();
        writer.WriteEndElement();
        writer.WriteEndElement();

        writer.WriteStartElement(
            "sheetFormatPr",
            ExcelSpreadsheetNamespace);
        writer.WriteAttributeString("defaultRowHeight", "15");
        writer.WriteEndElement();

        writer.WriteStartElement(
            "cols",
            ExcelSpreadsheetNamespace);

        for (var index = 0; index < columnWidths.Length; index++)
        {
            writer.WriteStartElement(
                "col",
                ExcelSpreadsheetNamespace);
            writer.WriteAttributeString(
                "min",
                (index + 1).ToString(
                    System.Globalization.CultureInfo.InvariantCulture));
            writer.WriteAttributeString(
                "max",
                (index + 1).ToString(
                    System.Globalization.CultureInfo.InvariantCulture));
            writer.WriteAttributeString(
                "width",
                columnWidths[index].ToString(
                    System.Globalization.CultureInfo.InvariantCulture));
            writer.WriteAttributeString("customWidth", "1");
            writer.WriteEndElement();
        }

        writer.WriteEndElement();
        writer.WriteStartElement(
            "sheetData",
            ExcelSpreadsheetNamespace);

        writer.WriteStartElement(
            "row",
            ExcelSpreadsheetNamespace);
        writer.WriteAttributeString("r", "1");
        writer.WriteAttributeString("ht", "22");
        writer.WriteAttributeString("customHeight", "1");

        for (var index = 0; index < headers.Length; index++)
        {
            WriteExcelTextCell(
                writer,
                $"{columnLetters[index]}1",
                headers[index],
                styleIndex: 1);
        }

        writer.WriteEndElement();

        for (var index = 0; index < rows.Count; index++)
        {
            var excelRowNumber = index + 2;
            var row = rows[index];
            var values = new[]
 {
    row.SubDealerCode,
    row.FirmName,
    row.State,
    row.Region,
    row.Hq,
    row.GstNumber,
    row.PanNumber,
    row.OfficialContactNumber,
    row.WhatsAppNumber,
    row.Status,

    // New values
    row.Latitude,
    row.Longitude,
    row.Address
};

            writer.WriteStartElement(
                "row",
                ExcelSpreadsheetNamespace);
            writer.WriteAttributeString(
                "r",
                excelRowNumber.ToString(
                    System.Globalization.CultureInfo.InvariantCulture));

            WriteExcelNumberCell(
                writer,
                $"A{excelRowNumber}",
                index + 1);

            for (var valueIndex = 0;
                valueIndex < values.Length;
                valueIndex++)
            {
                WriteExcelTextCell(
                    writer,
                    $"{columnLetters[valueIndex + 1]}{excelRowNumber}",
                    values[valueIndex]);
            }

            writer.WriteEndElement();
        }

        writer.WriteEndElement();

        writer.WriteStartElement(
            "autoFilter",
            ExcelSpreadsheetNamespace);
        writer.WriteAttributeString(
            "ref",
           $"A1:N{Math.Max(1, rows.Count + 1)}");
        writer.WriteEndElement();

        writer.WriteEndElement();
        writer.WriteEndDocument();
    }

    private static void WriteExcelTextCell(
        XmlWriter writer,
        string cellReference,
        string? value,
        int styleIndex = 0)
    {
        var safeValue = NormalizeExcelCellText(value);

        writer.WriteStartElement(
            "c",
            ExcelSpreadsheetNamespace);
        writer.WriteAttributeString("r", cellReference);
        writer.WriteAttributeString("t", "inlineStr");

        if (styleIndex > 0)
        {
            writer.WriteAttributeString(
                "s",
                styleIndex.ToString(
                    System.Globalization.CultureInfo.InvariantCulture));
        }

        writer.WriteStartElement(
            "is",
            ExcelSpreadsheetNamespace);
        writer.WriteStartElement(
            "t",
            ExcelSpreadsheetNamespace);

        if (safeValue.Length > 0 &&
            (char.IsWhiteSpace(safeValue[0]) ||
             char.IsWhiteSpace(safeValue[safeValue.Length - 1])))
        {
            writer.WriteAttributeString(
                "xml",
                "space",
                "http://www.w3.org/XML/1998/namespace",
                "preserve");
        }

        writer.WriteString(safeValue);
        writer.WriteEndElement();
        writer.WriteEndElement();
        writer.WriteEndElement();
    }

    private static void WriteExcelNumberCell(
        XmlWriter writer,
        string cellReference,
        int value)
    {
        writer.WriteStartElement(
            "c",
            ExcelSpreadsheetNamespace);
        writer.WriteAttributeString("r", cellReference);
        writer.WriteStartElement(
            "v",
            ExcelSpreadsheetNamespace);
        writer.WriteString(
            value.ToString(
                System.Globalization.CultureInfo.InvariantCulture));
        writer.WriteEndElement();
        writer.WriteEndElement();
    }

    private static string NormalizeExcelCellText(string? value)
    {
        if (string.IsNullOrEmpty(value))
            return string.Empty;

        const int excelCellCharacterLimit = 32767;
        var normalized = new StringBuilder(
            Math.Min(value.Length, excelCellCharacterLimit));

        foreach (var character in value)
        {
            var isValidXmlCharacter =
                character == '\t' ||
                character == '\n' ||
                character == '\r' ||
                (character >= '\u0020' && character <= '\uD7FF') ||
                (character >= '\uE000' && character <= '\uFFFD');

            if (!isValidXmlCharacter)
                continue;

            normalized.Append(character);

            if (normalized.Length == excelCellCharacterLimit)
                break;
        }

        return normalized.ToString();
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _searchText = e.Value?.ToString() ?? string.Empty;

        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();

        var token = _searchCts.Token;

        try
        {
            await Task.Delay(350, token);

            if (token.IsCancellationRequested)
                return;

            _page = 1;
            await LoadListAsync();
        }
        catch (TaskCanceledException)
        {
        }
    }

    private async Task OnStateChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var value))
            value = 0;

        _stateId = value;
        _regionId = 0;
        _hqId = 0;
        _page = 1;

        await LoadListAsync();
    }

    private async Task OnRegionChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var value))
            value = 0;

        _regionId = value;
        _hqId = 0;
        _page = 1;

        await LoadListAsync();
    }

    private async Task OnHqChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var value))
            value = 0;

        _hqId = value;
        _page = 1;

        await LoadListAsync();
    }

    private async Task OnStatusChanged(ChangeEventArgs e)
    {
        _statusFilter = e.Value?.ToString() ?? string.Empty;
        _page = 1;

        await LoadListAsync();
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var value))
            value = 20;

        _pageSize = value;
        _page = 1;

        await LoadListAsync();
    }

    private async Task PreviousPage()
    {
        if (_page <= 1)
            return;

        _page--;
        await LoadListAsync();
    }

    private async Task NextPage()
    {
        if (_response.TotalPages <= 0 ||
            _page >= _response.TotalPages)
        {
            return;
        }

        _page++;
        await LoadListAsync();
    }

    private async Task GoToPage(int pageNo)
    {
        if (pageNo < 1 ||
            pageNo > _response.TotalPages ||
            pageNo == _page)
        {
            return;
        }

        _page = pageNo;
        await LoadListAsync();
    }

    private void OpenImportModal()
    {
        if (!CanImportSubDealers)
            return;

        _showImportModal = true;
        _importFile = null;
        _importMessage = null;
        _importHasError = false;
        _importErrors.Clear();
    }

    private void CloseImportModal()
    {
        if (_isImporting)
            return;

        _showImportModal = false;
        _importFile = null;
        _importMessage = null;
        _importHasError = false;
        _importErrors.Clear();
    }

    private void HandleImportFileSelected(InputFileChangeEventArgs e)
    {
        _importMessage = null;
        _importHasError = false;
        _importErrors.Clear();
        _importFile = null;

        var file = e.File;
        var extension = Path.GetExtension(file.Name);

        if (!string.Equals(extension, ".xlsx", StringComparison.OrdinalIgnoreCase))
        {
            _importHasError = true;
            _importMessage = "Only .xlsx Excel files are allowed.";
            return;
        }

        if (file.Size <= 0)
        {
            _importHasError = true;
            _importMessage = "The selected Excel file is empty.";
            return;
        }

        if (file.Size > MaxImportFileSize)
        {
            _importHasError = true;
            _importMessage = "Excel file size must be less than 10 MB.";
            return;
        }

        _importFile = file;
        _importMessage = $"Ready to import {file.Name}";
    }

    private async Task ImportSubDealersFromExcel()
    {
        if (!CanImportSubDealers)
        {
            _importHasError = true;
            _importMessage = "Only Admin or MO roles can import the Sub Dealer master.";
            return;
        }

        if (_importFile == null || _isImporting)
            return;

        _isImporting = true;
        _importHasError = false;
        _importMessage = null;
        _importErrors.Clear();

        try
        {
            using var fileContent = new MultipartFormDataContent();
            await using var stream = _importFile.OpenReadStream(MaxImportFileSize);
            fileContent.Add(new StreamContent(stream), "file", _importFile.Name);

            var parseResponse = await Http.PostAsync(
                "api/SubDealerRegistration/parse-import-excel",
                fileContent);

            if (!parseResponse.IsSuccessStatusCode)
            {
                var errorBody = await parseResponse.Content.ReadAsStringAsync();
                _importHasError = true;
                _importMessage = $"Could not read Excel file: {errorBody}";
                return;
            }

            var parsed = await parseResponse.Content
                .ReadFromJsonAsync<SubDealerExcelParseResponse>();

            if (parsed == null)
            {
                _importHasError = true;
                _importMessage = "The API returned an empty Excel import response.";
                return;
            }

            if (parsed.Errors.Count > 0)
            {
                _importErrors.AddRange(parsed.Errors);
                _importHasError = true;
                _importMessage = "Excel validation failed. Nothing was saved.";
                return;
            }

            if (parsed.Rows.Count == 0)
            {
                _importHasError = true;
                _importMessage = "No Sub Dealer rows were found in the Excel file.";
                return;
            }

            var statesByName = _states
                .Where(x => !string.IsNullOrWhiteSpace(x.StateName))
                .GroupBy(x => NormalizeMasterValue(x.StateName))
                .ToDictionary(x => x.Key, x => x.First(), StringComparer.OrdinalIgnoreCase);

            var statesById = _statesById;

            var regionsByStateAndName = _regions
                .Where(x => !string.IsNullOrWhiteSpace(x.RegionName))
                .GroupBy(x => $"{x.StateId}|{NormalizeMasterValue(x.RegionName)}")
                .ToDictionary(x => x.Key, x => x.First(), StringComparer.OrdinalIgnoreCase);

            var regionsById = _regionsById;

            var uniqueRegionsByName = _regions
                .Where(x => !string.IsNullOrWhiteSpace(x.RegionName))
                .GroupBy(x => NormalizeMasterValue(x.RegionName), StringComparer.OrdinalIgnoreCase)
                .Where(g => g.Select(x => x.Id).Distinct().Count() == 1)
                .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);

            var hqsByRegionAndName = _hqs
                .Where(x => !string.IsNullOrWhiteSpace(x.HeadquarterName))
                .GroupBy(x => $"{x.RegionId}|{NormalizeMasterValue(x.HeadquarterName)}")
                .ToDictionary(x => x.Key, x => x.First(), StringComparer.OrdinalIgnoreCase);

            var uniqueHqsByName = _hqs
                .Where(x => !string.IsNullOrWhiteSpace(x.HeadquarterName))
                .GroupBy(x => NormalizeMasterValue(x.HeadquarterName), StringComparer.OrdinalIgnoreCase)
                .Where(g => g.Select(x => x.Id).Distinct().Count() == 1)
                .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);

            var mappedRows = new List<SubDealerBulkImportRowDto>();
            var seenCodes = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

            foreach (var row in parsed.Rows)
            {
                var code = row.SubDealerCode?.Trim() ?? string.Empty;
                var name = row.SubDealerName?.Trim() ?? string.Empty;

                if (string.IsNullOrWhiteSpace(code))
                {
                    _importErrors.Add($"Excel row {row.RowNumber}: Sub Dealer Code is empty.");
                    continue;
                }

                if (string.IsNullOrWhiteSpace(name))
                {
                    _importErrors.Add($"Excel row {row.RowNumber}: Sub Dealer Name is empty.");
                    continue;
                }

                if (!seenCodes.Add(code))
                {
                    _importErrors.Add($"Excel row {row.RowNumber}: duplicate Sub Dealer Code '{code}'.");
                    continue;
                }

                var normalizedState = NormalizeMasterValue(row.State);
                if (!statesByName.TryGetValue(normalizedState, out var stateItem))
                {
                    _importErrors.Add(
                        $"Excel row {row.RowNumber}: State '{row.State}' was not found in State master.");
                    continue;
                }

                var normalizedRegion = NormalizeMasterValue(row.Region);
                var normalizedHq = NormalizeMasterValue(row.HQ);

                var resolvedState = stateItem;
                LocationItemDto? resolvedRegion = null;
                LocationItemDto? resolvedHq = null;

                var exactRegionKey = $"{resolvedState.Id}|{normalizedRegion}";
                regionsByStateAndName.TryGetValue(exactRegionKey, out resolvedRegion);

                if (resolvedRegion != null)
                {
                    var exactHqKey = $"{resolvedRegion.Id}|{normalizedHq}";
                    hqsByRegionAndName.TryGetValue(exactHqKey, out resolvedHq);
                }

                if (resolvedHq == null &&
                    uniqueHqsByName.TryGetValue(normalizedHq, out var uniqueHq) &&
                    regionsById.TryGetValue(uniqueHq.RegionId, out var hqRegion) &&
                    statesById.TryGetValue(hqRegion.StateId, out var hqState))
                {
                    resolvedHq = uniqueHq;
                    resolvedRegion = hqRegion;
                    resolvedState = hqState;
                }

                if (resolvedRegion == null &&
                    uniqueRegionsByName.TryGetValue(normalizedRegion, out var uniqueRegion) &&
                    statesById.TryGetValue(uniqueRegion.StateId, out var regionState))
                {
                    resolvedRegion = uniqueRegion;
                    resolvedState = regionState;

                    var hqKey = $"{resolvedRegion.Id}|{normalizedHq}";
                    hqsByRegionAndName.TryGetValue(hqKey, out resolvedHq);
                }

                if (resolvedRegion == null)
                {
                    _importErrors.Add(
                        $"Excel row {row.RowNumber}: Region '{row.Region}' could not be matched to the application master.");
                    continue;
                }

                if (resolvedHq == null)
                {
                    _importErrors.Add(
                        $"Excel row {row.RowNumber}: HQ '{row.HQ}' could not be matched to the application master.");
                    continue;
                }

                mappedRows.Add(new SubDealerBulkImportRowDto
                {
                    ExcelRowNumber = row.RowNumber,
                    SubDealerCode = code.ToUpperInvariant(),
                    FirmName = name.ToUpperInvariant(),
                    StateId = resolvedState.Id,
                    RegionId = resolvedRegion.Id,
                    HQId = resolvedHq.Id
                });
            }

            var skippedCount = _importErrors.Count;

            if (mappedRows.Count == 0)
            {
                _importHasError = true;
                _importMessage =
                    $"No rows could be mapped. Skipped: {skippedCount}. Nothing was saved.";
                return;
            }

            var request = new SubDealerBulkImportRequest
            {
                ImportedBy = LoginState.UserId ?? (IsMoRole ? "MO Excel Import" : "Admin Excel Import"),
                Rows = mappedRows
            };

            var saveResponse = await Http.PostAsJsonAsync(
                "api/SubDealerRegistration/bulk-import",
                request);

            if (!saveResponse.IsSuccessStatusCode)
            {
                var responseBody = await saveResponse.Content.ReadAsStringAsync();
                _importHasError = true;
                _importMessage = $"Excel import failed: {responseBody}";
                return;
            }

            var result = await saveResponse.Content
                .ReadFromJsonAsync<SubDealerBulkImportResponse>();

            if (result == null)
            {
                _importHasError = true;
                _importMessage = "Excel import completed but the API response was empty.";
                return;
            }

            if (result.Errors.Count > 0)
            {
                _importErrors.AddRange(result.Errors);
                _importHasError = true;
                _importMessage = "Excel import failed during database save.";
                return;
            }

            // Refresh the maintained list. Untouched imported master rows remain
            // hidden by the existing list endpoint visibility rule.
            _page = 1;
            await Task.WhenAll(
                LoadListAsync(),
                LoadStateWiseSummaryAsync());
            _importFile = null;

            if (skippedCount > 0)
            {
                _importHasError = true;
                _importMessage =
                    $"Import completed. Inserted: {result.Inserted}, Updated: {result.Updated}, Skipped: {skippedCount}. " +
                    "Valid rows were saved. Review the skipped rows below.";
            }
            else
            {
                _showImportModal = false;
                _importHasError = false;
                _importMessage = null;
                _pageMessageIsError = false;
                _pageMessage =
                    $"Sub Dealer master imported successfully. Inserted: {result.Inserted}, Updated: {result.Updated}.";
            }
        }
        catch (Exception ex)
        {
            _importHasError = true;
            _importMessage = $"Import error: {ex.Message}";
        }
        finally
        {
            _isImporting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string NormalizeMasterValue(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return string.Empty;

        var trimmed = value.Trim();
        var buffer = new char[trimmed.Length];
        var length = 0;

        foreach (var character in trimmed)
        {
            if (!char.IsLetterOrDigit(character))
                continue;

            buffer[length++] = char.ToUpperInvariant(character);
        }

        var normalized = new string(buffer, 0, length);

        return normalized switch
        {
            "PONDICHERRY" => "PUDUCHERRY",
            "PUDUCHERRY" => "PUDUCHERRY",
            _ => normalized
        };
    }

