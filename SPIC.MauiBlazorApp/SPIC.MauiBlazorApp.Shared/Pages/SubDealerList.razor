    private static string BuildSubDealerExportAddress(
    SubDealerListItemDto item)
    {
        var addressParts = new[]
        {
        item.ShopNoORRoomNoOrBlockNo,
        item.Street,
        item.SubVillage,
        item.Village,
        item.Block,
        item.Taluk,
        !string.IsNullOrWhiteSpace(item.PinCode)
            ? $"Pincode - {item.PinCode}"
            : null
    };

        return string.Join(
            ", ",
            addressParts
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Select(x => x!.Trim()));
    }
