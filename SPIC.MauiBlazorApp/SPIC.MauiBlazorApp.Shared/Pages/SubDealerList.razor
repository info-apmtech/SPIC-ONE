@page "/SubDealerList"
@implements IDisposable
@using System.IO.Compression
@using System.Net.Http.Json
@using System.Text
@using System.Xml
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using SPIC.Core.DTOs
@using SPIC.Core.Entities
@using SPIC.MauiBlazorApp.Shared.Services

@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject LoginState LoginState
@inject LookupCacheService LookupCache

<style>
    .sd-list-page {
        padding: 24px 0 36px;
    }

    .sd-page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 18px;
    }

    .sd-page-title-wrap {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .sd-page-icon {
        width: 42px;
        height: 42px;
        display: grid;
        place-items: center;
        border-radius: 12px;
        background: #eaf8f0;
        color: #07864f;
        font-size: 20px;
    }

    .sd-page-title {
        margin: 0;
        font-size: 1.35rem;
        font-weight: 700;
        color: #172033;
    }

    .sd-page-subtitle {
        margin-top: 2px;
        font-size: .82rem;
        color: #6b7280;
    }

    .sd-header-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .sd-btn {
        height: 38px;
        padding: 0 15px;
        border-radius: 9px;
        border: 1px solid #d9e1e7;
        background: #fff;
        color: #374151;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        font-size: .86rem;
        font-weight: 600;
        transition: .16s ease;
    }

        .sd-btn:hover {
            background: #f7faf8;
        }

        .sd-btn.primary {
            background: #07864f;
            border-color: #07864f;
            color: #fff;
        }

            .sd-btn.primary:hover {
                background: #057744;
            }

    .sd-summary-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
        margin-bottom: 16px;
    }

    .sd-summary-card {
        background: #fff;
        border: 1px solid #e2e8e5;
        border-radius: 12px;
        padding: 16px 18px;
        display: flex;
        align-items: center;
        gap: 13px;
    }

    .sd-summary-icon {
        width: 40px;
        height: 40px;
        border-radius: 11px;
        display: grid;
        place-items: center;
        font-size: 18px;
        background: #f1f6f3;
        color: #07864f;
    }

    .sd-summary-card.active .sd-summary-icon {
        background: #e9f8ef;
        color: #07864f;
    }

    .sd-summary-card.inactive .sd-summary-icon {
        background: #fff5e8;
        color: #d97706;
    }

    .sd-summary-label {
        font-size: .78rem;
        color: #6b7280;
    }

    .sd-summary-value {
        margin-top: 2px;
        font-size: 1.25rem;
        font-weight: 700;
        color: #172033;
    }

    .sd-filter-card {
        background: #fff;
        border: 1px solid #e2e8e5;
        border-radius: 13px;
        padding: 16px;
        margin-bottom: 16px;
    }

    .sd-filter-grid {
        display: grid;
        grid-template-columns: minmax(240px, 1.6fr) repeat(4, minmax(145px, 1fr));
        gap: 12px;
        align-items: end;
    }

    .sd-label {
        display: block;
        margin-bottom: 6px;
        font-size: .76rem;
        font-weight: 600;
        color: #475569;
    }

    .sd-input,
    .sd-select {
        width: 100%;
        height: 39px;
        border: 1px solid #dce4e0;
        border-radius: 8px;
        background: #f8faf9;
        color: #334155;
        padding: 0 12px;
        outline: none;
        font-size: .84rem;
    }

        .sd-input:focus,
        .sd-select:focus {
            border-color: #55b98a;
            box-shadow: 0 0 0 2px rgba(7, 134, 79, .08);
            background: #fff;
        }

    .sd-search-wrap {
        position: relative;
    }

        .sd-search-wrap i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: .86rem;
        }

        .sd-search-wrap .sd-input {
            padding-left: 34px;
        }

    .sd-table-card {
        background: #fff;
        border: 1px solid #e2e8e5;
        border-radius: 13px;
        overflow: hidden;
    }

    .sd-table-head {
        padding: 14px 16px;
        border-bottom: 1px solid #edf1ef;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .sd-result-text {
        font-size: .82rem;
        color: #64748b;
    }

        .sd-result-text strong {
            color: #172033;
        }

    .sd-table-scroll {
        overflow-x: auto;
    }

    .sd-table {
        width: 100%;
        min-width: 1080px;
        border-collapse: collapse;
    }

        .sd-table th {
            padding: 11px 13px;
            background: #f8faf9;
            border-bottom: 1px solid #e8eeeb;
            font-size: .74rem;
            font-weight: 700;
            color: #536273;
            text-align: center;
            white-space: nowrap;
        }

        .sd-table td {
            padding: 12px 13px;
            border-bottom: 1px solid #edf1ef;
            font-size: .81rem;
            color: #334155;
            vertical-align: middle;
        }

        .sd-table tbody tr:hover {
            background: #fbfdfc;
        }

    .sd-code {
        font-weight: 700;
        color: #08784a;
        white-space: nowrap;
    }

    .sd-name {
        min-width: 200px;
        font-weight: 600;
        color: #1f2937;
    }

    .sd-small-value {
        color: #64748b;
        font-size: .77rem;
    }

    .sd-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 999px;
        padding: 5px 9px;
        font-size: .72rem;
        font-weight: 700;
        white-space: nowrap;
    }

        .sd-status.active {
            color: #08784a;
            background: #eaf8f0;
        }

        .sd-status.inactive {
            color: #b76500;
            background: #fff3df;
        }

    .sd-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
    }

    .sd-action-wrap {
        display: flex;
        gap: 6px;
        justify-content: flex-end;
    }

    .sd-action-btn {
        width: 31px;
        height: 31px;
        border-radius: 8px;
        border: 1px solid #dfe6e2;
        background: #fff;
        color: #596878;
        display: grid;
        place-items: center;
        transition: .15s ease;
    }

        .sd-action-btn:hover {
            background: #edf8f2;
            color: #07864f;
            border-color: #b7ddc8;
        }

    .sd-loading,
    .sd-empty {
        min-height: 260px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 10px;
        color: #64748b;
    }

        .sd-empty i {
            font-size: 30px;
            color: #a1ada7;
        }

    .sd-pagination {
        padding: 14px 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        border-top: 1px solid #edf1ef;
    }

    .sd-page-size {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: .78rem;
        color: #64748b;
    }

        .sd-page-size select {
            height: 32px;
            min-width: 68px;
            border: 1px solid #dce4e0;
            border-radius: 7px;
            padding: 0 8px;
            background: #fff;
            color: #334155;
        }

    .sd-page-buttons {
        display: flex;
        gap: 5px;
        align-items: center;
    }

    .sd-page-button {
        min-width: 32px;
        height: 32px;
        border-radius: 7px;
        border: 1px solid #dfe6e2;
        background: #fff;
        color: #64748b;
        font-size: .78rem;
    }

        .sd-page-button.active {
            background: #07864f;
            border-color: #07864f;
            color: #fff;
        }

        .sd-page-button:disabled {
            opacity: .45;
            cursor: not-allowed;
        }

    .sd-scope-note {
        margin-bottom: 12px;
        padding: 9px 12px;
        border-radius: 9px;
        background: #eff8f3;
        border: 1px solid #d7ede1;
        color: #32644d;
        font-size: .78rem;
    }

    .sd-state-summary-card {
        margin-top: 18px;
    }

    .sd-state-summary-title {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 3px;
        font-size: .92rem;
        font-weight: 700;
        color: #172033;
    }

        .sd-state-summary-title i {
            color: #07864f;
        }

    .sd-state-summary-table {
        min-width: 720px;
    }

        .sd-state-summary-table th:nth-child(n+3),
        .sd-state-summary-table td:nth-child(n+3) {
            text-align: center;
        }

        .sd-state-summary-table tfoot td {
            border-bottom: 0;
            background: #eff8f3;
            color: #172033;
            font-weight: 700;
        }

    .sd-state-count {
        font-weight: 700;
        color: #334155;
    }

    .sd-state-summary-card .sd-loading,
    .sd-state-summary-card .sd-empty {
        min-height: 150px;
    }

    .sd-state-summary-error {
        margin: 14px 16px;
    }

    .sd-state-datatable-tools {
        padding: 12px 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        border-bottom: 1px solid #edf1ef;
        background: #fbfdfc;
    }

    .sd-state-search-wrap {
        width: min(320px, 100%);
    }

    .sd-state-page-size {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #64748b;
        font-size: .78rem;
        white-space: nowrap;
    }

        .sd-state-page-size select {
            height: 34px;
            min-width: 70px;
            border: 1px solid #dce4e0;
            border-radius: 7px;
            padding: 0 8px;
            background: #fff;
            color: #334155;
        }

    .sd-state-sort-button {
        /* width: 100%; */
        padding: 0;
        border: 0;
        background: transparent;
        color: inherit;
        display: inline-flex;
        align-items: center;
        justify-content: inherit;
        gap: 6px;
        font: inherit;
        font-weight: inherit;
        text-align: inherit;
        white-space: nowrap;
        cursor: pointer;
    }

    .sd-state-summary-table th:nth-child(n+3) .sd-state-sort-button {
        justify-content: center;
    }

    .sd-state-sort-button i {
        color: #07864f;
        font-size: .68rem;
    }

    .sd-state-summary-pagination {
        background: #fff;
    }

    .sd-state-datatable-empty {
        height: 90px;
        text-align: center !important;
        color: #64748b !important;
    }

    @@media (max-width: 1200px) {
        .sd-filter-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 768px) {
        .sd-page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .sd-summary-grid {
            grid-template-columns: 1fr;
        }

        .sd-filter-grid {
            grid-template-columns: 1fr;
        }

        .sd-pagination {
            align-items: flex-start;
            flex-direction: column;
        }

        .sd-state-datatable-tools {
            align-items: stretch;
            flex-direction: column;
        }

        .sd-state-search-wrap {
            width: 100%;
        }
    }


    .sd-btn.import {
        background: #ffffff;
        border-color: #8bc9a8;
        color: #07864f;
    }

        .sd-btn.import:hover {
            background: #edf9f2;
            border-color: #54ae7d;
        }

    .subdealer-import-backdrop {
        position: fixed;
        inset: 0;
        z-index: 2100;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 18px;
        background: rgba(15, 23, 42, .48);
    }

    .subdealer-import-modal {
        width: min(650px, 100%);
        max-height: 88vh;
        overflow-y: auto;
        background: #fff;
        border-radius: 14px;
        box-shadow: 0 24px 60px rgba(15, 23, 42, .22);
    }

    .subdealer-import-modal-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
        padding: 18px 20px;
        border-bottom: 1px solid #e5e7eb;
    }

    .subdealer-import-modal-body {
        padding: 20px;
    }

    .subdealer-import-modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        padding: 16px 20px;
        border-top: 1px solid #e5e7eb;
    }

    .subdealer-excel-dropzone {
        padding: 24px;
        text-align: center;
        border: 1px dashed #86b79d;
        border-radius: 10px;
        background: #f6fbf8;
    }

    .subdealer-import-errors {
        max-height: 190px;
        overflow-y: auto;
        margin-top: 12px;
        font-size: .82rem;
    }
</style>

<div class="container-fluid sd-list-page">

    <div class="sd-page-header">
        <div class="sd-page-title-wrap">
            <div class="sd-page-icon">
                <i class="bi bi-people"></i>
            </div>

            <div>
                <h4 class="sd-page-title">Sub Dealer Master</h4>
                <div class="sd-page-subtitle">
                    View Sub Dealers saved or updated through the Sub Dealer form in your assigned geography.
                </div>
            </div>
        </div>

        <div class="sd-header-actions">
            <button type="button"
                    class="sd-btn"
                    @onclick="RefreshAsync"
                    disabled="@_isLoading">
                <i class="bi bi-arrow-clockwise"></i>
                Refresh
            </button>

            <button type="button"
                    class="sd-btn"
                    @onclick="ExportAllSavedSubDealersAsync"
                    disabled="@_isExporting">
                @if (_isExporting)
                {
                    <span class="spinner-border spinner-border-sm"
                          role="status"
                          aria-hidden="true"></span>
                    <span>Exporting...</span>
                }
                else
                {
                    <i class="bi bi-file-earmark-excel"></i>
                    <span>Export All Saved</span>
                }
            </button>

            @if (CanImportSubDealers)
            {
                <button type="button"
                        class="sd-btn import"
                        @onclick="OpenImportModal">
                    <i class="bi bi-file-earmark-excel"></i>
                    Import Sub Dealers
                </button>
            }

            @if (CanCreateSubDealer)
            {
                <button type="button"
                        class="sd-btn primary"
                        @onclick="CreateSubDealer">
                    <i class="bi bi-plus-lg"></i>
                    Create Sub Dealer
                </button>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_pageMessage))
    {
        <div class="alert @(_pageMessageIsError ? "alert-danger" : "alert-success") alert-dismissible fade show py-2 mb-3" role="alert">
            @_pageMessage
            <button type="button" class="btn-close" @onclick='() => _pageMessage = null'></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(RoleScopeMessage))
    {
        <div class="sd-scope-note">
            <i class="bi bi-geo-alt me-1"></i>
            @RoleScopeMessage
        </div>
    }

    <div class="sd-summary-grid">
        <div class="sd-summary-card">
            <div class="sd-summary-icon">
                <i class="bi bi-people"></i>
            </div>
            <div>
                <div class="sd-summary-label">Total Sub Dealers</div>
                <div class="sd-summary-value">@(_response.ActiveCount + _response.InactiveCount)</div>
            </div>
        </div>

        <div class="sd-summary-card active">
            <div class="sd-summary-icon">
                <i class="bi bi-check-circle"></i>
            </div>
            <div>
                <div class="sd-summary-label">Active</div>
                <div class="sd-summary-value">@_response.ActiveCount</div>
            </div>
        </div>

        <div class="sd-summary-card inactive">
            <div class="sd-summary-icon">
                <i class="bi bi-pause-circle"></i>
            </div>
            <div>
                <div class="sd-summary-label">Inactive</div>
                <div class="sd-summary-value">@_response.InactiveCount</div>
            </div>
        </div>
    </div>

    <div class="sd-filter-card">
        <div class="sd-filter-grid">

            <div>
                <label class="sd-label">Search</label>
                <div class="sd-search-wrap">
                    <i class="bi bi-search"></i>
                    <input class="sd-input"
                           value="@_searchText"
                           @oninput="OnSearchInput"
                           placeholder="Code, name, mobile, GST, PAN or mFMS ID" />
                </div>
            </div>

            <div>
                <label class="sd-label">State</label>
                <select class="sd-select"
                        value="@_stateId"
                        @onchange="OnStateChanged"
                        disabled="@IsStateLocked">
                    <option value="0">All States</option>
                    @foreach (var state in AllowedStates)
                    {
                        <option value="@state.Id">@state.StateName</option>
                    }
                </select>
            </div>

            <div>
                <label class="sd-label">Region</label>
                <select class="sd-select"
                        value="@_regionId"
                        @onchange="OnRegionChanged"
                        disabled="@IsRegionLocked">
                    <option value="0">All Regions</option>
                    @foreach (var region in FilteredRegions)
                    {
                        <option value="@region.Id">@region.RegionName</option>
                    }
                </select>
            </div>

            <div>
                <label class="sd-label">HQ</label>
                <select class="sd-select"
                        value="@_hqId"
                        @onchange="OnHqChanged"
                        disabled="@IsHqLocked">
                    <option value="0">All HQs</option>
                    @foreach (var hq in FilteredHqs)
                    {
                        <option value="@hq.Id">@hq.HeadquarterName</option>
                    }
                </select>
            </div>

            <div>
                <label class="sd-label">Status</label>
                <select class="sd-select"
                        value="@_statusFilter"
                        @onchange="OnStatusChanged">
                    <option value="">All Status</option>
                    <option value="0">Active</option>
                    <option value="1">Inactive</option>
                </select>
            </div>

        </div>
    </div>

    <div class="sd-table-card">
        <div class="sd-table-head">
            <div class="sd-result-text">
                @if (_response.TotalCount == 0)
                {
                    <span>No records</span>
                }
                else
                {
                    <span>
                        Showing <strong>@FirstVisibleRecord</strong>–<strong>@LastVisibleRecord</strong>
                        of <strong>@_response.TotalCount</strong>
                    </span>
                }
            </div>
        </div>

        @if (_isLoading)
        {
            <div class="sd-loading">
                <div class="spinner-border spinner-border-sm text-success" role="status"></div>
                <div>Loading Sub Dealers...</div>
            </div>
        }
        else if (_response.Items.Count == 0)
        {
            <div class="sd-empty">
                <i class="bi bi-inbox"></i>
                <div class="fw-semibold">No saved Sub Dealers found</div>
                <div class="small">
                    Untouched bulk-upload master rows are not shown here.
                </div>
            </div>
        }
        else
        {
            <div class="sd-table-scroll">
                <table class="sd-table">
                    <thead>
                        <tr>
                            <th style="width:55px;">#</th>
                            <th>Sub Dealer Code</th>
                            <th>Sub Dealer Name</th>
                            <th>State</th>
                            <th>Region</th>
                            <th>HQ</th>
                            <th>GST / PAN</th>
                            <th>Contact</th>
                            <th>Status</th>
                            <th style="text-align:right;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var rowIndex = 0;
                        }
                        @foreach (var item in _response.Items)
                        {
                            <tr @key="item.Id">
                                <td>
                                    @((_response.Page - 1) * _response.PageSize + rowIndex + 1)
                                </td>

                                <td>
                                    <span class="sd-code">
                                        @(string.IsNullOrWhiteSpace(item.SubDealerCode)
                                            ? "-"
                                            : item.SubDealerCode)
                                    </span>
                                </td>

                                <td>
                                    <div class="sd-name">
                                        @(string.IsNullOrWhiteSpace(item.FirmName)
                                            ? "-"
                                            : item.FirmName)
                                    </div>
                                </td>

                                <td>@StateName(item.StateId)</td>
                                <td>@RegionName(item.RegionId)</td>
                                <td>@HqName(item.HQId)</td>

                                <td>
                                    <div>
                                        @(string.IsNullOrWhiteSpace(item.GSTNumber)
                                            ? "-"
                                            : item.GSTNumber)
                                    </div>
                                    <div class="sd-small-value mt-1">
                                        PAN:
                                        @(string.IsNullOrWhiteSpace(item.PANNo)
                                            ? "-"
                                            : item.PANNo)
                                    </div>
                                </td>

                                <td>
                                    <div>
                                        @(string.IsNullOrWhiteSpace(item.OfficialContactNumber)
                                            ? "-"
                                            : item.OfficialContactNumber)
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(item.WhatsAppNumber))
                                    {
                                        <div class="sd-small-value mt-1">
                                            WA: @item.WhatsAppNumber
                                        </div>
                                    }
                                </td>

                                <td>
                                    @if (item.Status == SubDealerStatus.Active)
                                    {
                                        <span class="sd-status active">
                                            <span class="sd-dot"></span>
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="sd-status inactive">
                                            <span class="sd-dot"></span>
                                            Inactive
                                        </span>
                                    }
                                </td>

                                <td>
                                    <div class="sd-action-wrap">
                                        <button type="button"
                                                class="sd-action-btn"
                                                title="View"
                                                @onclick="() => ViewSubDealer(item.Id)">
                                            <i class="bi bi-eye"></i>
                                        </button>

                                        @if (CanEditSubDealer)
                                        {
                                            <button type="button"
                                                    class="sd-action-btn"
                                                    title="Edit"
                                                    @onclick="() => EditSubDealer(item.Id)">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                        }
                                    </div>
