@page "/Schemes"
@inject NavigationManager Navigation


<div class="container-fluid py-4 px-0">
    <!-- Header Section -->
    <header class="header-section">
        <div class="header-top">
            <div class="header-left">
                <h1 class="page-title">Schemes</h1>
                <p class="page-subtitle">Manage and track all lucky draw schemes</p>
            </div>
            <button class="create-btn" aria-label="Create new scheme">
                <img src="_content/SPIC.MauiBlazorApp.Shared/Images/Schemes/img_container.svg" alt="" width="20" height="20">
                Create Scheme
            </button>
        </div>
    </header>

    <!-- Statistics Cards -->
    <section class="stats-grid" aria-label="Scheme statistics">
        <div class="stat-card stat-card-purple">
            <div class="stat-icon stat-icon-purple">
                <img src="_content/SPIC.MauiBlazorApp.Shared/Images/Schemes/img_frame_2147229547.svg" alt="" width="64" height="64">
            </div>
            <div class="stat-content">
                <div class="stat-label">Total Schemes</div>
                <div class="stat-value">12</div>
            </div>
        </div>

        <div class="stat-card stat-card-blue">
            <div class="stat-icon stat-icon-blue">
                <img src="_content/SPIC.MauiBlazorApp.Shared/Images/Schemes/img_frame.svg" alt="" width="64" height="64">
            </div>
            <div class="stat-content">
                <div class="stat-label">Overall Dealer</div>
                <div class="stat-value">3200</div>
            </div>
        </div>

        <div class="stat-card stat-card-green">
            <div class="stat-icon stat-icon-green">
                <img src="_content/SPIC.MauiBlazorApp.Shared/Images/Schemes/img_frame_teal_400.svg" alt="" width="64" height="64">
            </div>
            <div class="stat-content">
                <div class="stat-label">Participating dealer</div>
                <div class="stat-value">1800</div>
            </div>
        </div>

        <div class="stat-card stat-card-yellow">
            <div class="stat-icon stat-icon-yellow">
                <img src="_content/SPIC.MauiBlazorApp.Shared/Images/Schemes/img_frame_orange_800.svg" alt="" width="64" height="64">
            </div>
            <div class="stat-content">
                <div class="stat-label">Winners</div>
                <div class="stat-value">10</div>
            </div>
        </div>
    </section>

    <!-- Filter Section -->
    <section class="filter-section">
        <div class="filter-container">
            <input type="search" class="search-input" placeholder="Search Schemes...." aria-label="Search schemes">
            <select class="dropdown" aria-label="Filter by type">
                <option>Both</option>
            </select>
            <select class="dropdown" aria-label="Filter by status">
                <option>All Status</option>
            </select>
            <select class="dropdown" aria-label="Filter by state">
                <option>All States</option>
            </select>
        </div>
    </section>

    <!-- Schemes Grid -->
    <section class="schemes-grid" aria-label="Scheme cards">
        
        <!-- Scheme Card 1 -->
        <article class="scheme-card">
            <div class="scheme-header">
                <div class="scheme-title-row">
                    <h2 class="scheme-title">Tamil Newyear Special Scheme</h2>
                    <div class="scheme-badges">
                        <span class="badge badge-dark">Both</span>
                        <span class="badge badge-green">Active</span>
                    </div>
                </div>

                <div class="scheme-meta">
                    <div class="meta-row">
                        <div class="meta-item">
                            <img src="_content/SPIC.MauiBlazorApp.Shared/Images/Schemes/img_frame_teal_900.svg" alt="" class="meta-icon" width="24" height="24">
                            <span class="meta-text">Apr 1, 2026 - Jun 30, 2026</span>
                        </div>
                        <div class="meta-item">
                            <img src="_content/SPIC.MauiBlazorApp.Shared/Images/Schemes/img_frame_black_900.svg" alt="" class="meta-icon" width="24" height="24">
                            <span class="meta-text">TamilNadu (State), Chennai (District)</span>
                        </div>
                    </div>

                    <div class="scheme-stats">
                        <div class="stat-item">
                            <div class="stat-item-content">
                                <div class="stat-item-label stat-item-label-green">Participating dealer</div>
                                <div class="stat-item-value stat-item-value-green">620</div>
                            </div>
                            <div class="stat-item-icon stat-item-icon-green">
                                <img src="_content/SPIC.MauiBlazorApp.Shared/Images/Schemes/img_frame_2147229547_lime_900.svg" alt="" width="48" height="48">
                            </div>
                        </div>

                        <div class="stat-item">
                            <div class="stat-item-content">
                                <div class="stat-item-label stat-item-label-red">Winners</div>
                                <div class="stat-item-value stat-item-value-red">18</div>
                            </div>
                            <img src="_content/SPIC.MauiBlazorApp.Shared/Images/Schemes/img_frame_2147229547_deep_orange_50.svg" alt="" class="stat-item-icon" width="48" height="48">
                        </div>
                    </div>
                </div>
            </div>

            <!-- Reward Showcase -->
            <div class="reward-showcase">
                <div class="reward-bg-shapes">
                    <div class="reward-curve-overlay"></div>
                    <div class="shape-circle-1"></div>
                    <div class="shape-circle-2"></div>
                    <svg class="shape-gift" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect x="10" y="40" width="80" height="60" rx="6" fill="#fef08a" />
                        <rect x="10" y="65" width="80" height="10" fill="#eab308" opacity="0.4" />
                        <rect x="45" y="40" width="10" height="60" fill="#eab308" opacity="0.4" />
                        <path d="M50 40 C 35 25, 20 40, 45 45 Z" fill="#eab308" opacity="0.4" />
                        <path d="M50 40 C 65 25, 80 40, 55 45 Z" fill="#eab308" opacity="0.4" />
                        <path d="M48 45 L 35 60 L 42 62 Z" fill="#eab308" opacity="0.4" />
                        <path d="M52 45 L 65 60 L 58 62 Z" fill="#eab308" opacity="0.4" />
                        <rect x="20" y="75" width="16" height="12" rx="2" fill="#eab308" opacity="0.2" />
                    </svg>
                </div>

                <div class="reward-image-container">
                    <img src="_content/SPIC.MauiBlazorApp.Shared/Images/Schemes/img_image_93.png" alt="Single Wardrobe" class="reward-image">
                </div>

                <div class="reward-text">
                    <span class="reward-badge">THE GRAND REWARD</span>
                    <h3 class="reward-title">Single Wardrobe</h3>
                    <p class="reward-description">Premium teak-finished, Royal Estate collection. A statement of prestige for your home.</p>
                </div>
            </div>

            <button class="view-details-btn" @onclick="NavigateToReview">
                View Details
            </button>
        </article>

