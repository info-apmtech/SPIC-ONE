@page "/BudgetSubmissions"


<div class="container-fluid py-4 px-0">
    
    <!-- Header Section -->
    <div class="bs-header-container">
        <div class="bs-header-text">
            <h1>Budget Submissions</h1>
            <p>Track and manage your submitted budgets</p>
        </div>
    </div>

    <!-- Summary Cards Grid -->
    <div class="bs-stats-grid">
        
        <div class="bs-stat-card bs-theme-blue">
            <div class="bs-card-body">
                <div class="bs-stat-text">
                    <h2>12</h2>
                    <p>Total Budget</p>
                </div>
                <div class="bs-stat-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <ellipse cx="16" cy="7" rx="4" ry="2"></ellipse>
                        <path d="M12 7v4c0 1.1 1.8 2 4 2s4-.9 4-2V7"></path>
                        <path d="M12 11v4c0 1.1 1.8 2 4 2s4-.9 4-2v-4"></path>
                        <path d="M4 14l3.5 2.5a4 4 0 0 0 2.5.5H16"></path>
                        <path d="M2 17l4 3h12a2 2 0 0 0 2-2v-2"></path>
                        <path d="M7 11V3"></path>
                        <path d="M4 6l3-3 3 3"></path>
                    </svg>
                </div>
            </div>
            <div class="bs-card-footer">
                <span>View all budget</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
            </div>
        </div>

        <div class="bs-stat-card bs-theme-green">
            <div class="bs-card-body">
                <div class="bs-stat-text">
                    <h2>5</h2>
                    <p>Approved</p>
                </div>
                <div class="bs-stat-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.76 4 4 0 0 1-4.78 4.78 4 4 0 0 1-6.74 0 4 4 0 0 1-4.78-4.78 4 4 0 0 1 0-6.76Z"></path>
                        <path d="m9 12 2 2 4-4"></path>
                    </svg>
                </div>
            </div>
            <div class="bs-card-footer">
                <span>View approved</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
            </div>
        </div>

        <div class="bs-stat-card bs-theme-orange">
            <div class="bs-card-body">
                <div class="bs-stat-text">
                    <h2>3</h2>
                    <p>Pending validation</p>
                </div>
                <div class="bs-stat-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2v4a2 2 0 0 0 2 2h4"></path>
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <circle cx="12" cy="14" r="4"></circle>
                        <polyline points="12 12 12 14 13.5 15.5"></polyline>
                    </svg>
                </div>
            </div>
            <div class="bs-card-footer">
                <span>View Pending</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
            </div>
        </div>

        <div class="bs-stat-card bs-theme-red">
            <div class="bs-card-body">
                <div class="bs-stat-text">
                    <h2>2</h2>
                    <p>Rejected</p>
                </div>
                <div class="bs-stat-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2v4a2 2 0 0 0 2 2h4"></path>
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <path d="m10 12 4 4"></path>
                        <path d="m14 12-4 4"></path>
                    </svg>
                </div>
            </div>
            <div class="bs-card-footer">
                <span>View Rejected</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
            </div>
        </div>

        <div class="bs-stat-card bs-theme-gray">
            <div class="bs-card-body">
                <div class="bs-stat-text">
                    <h2>2</h2>
                    <p>Drafts</p>
                </div>
                <div class="bs-stat-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2v4a2 2 0 0 0 2 2h4"></path>
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <path d="M10.5 17.5 9 18l.5-1.5L15 11l1.5 1.5-6 5.5Z"></path>
                    </svg>
                </div>
            </div>
            <div class="bs-card-footer">
                <span>View drafts</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
            </div>
        </div>

    </div>

    <!-- Filters Section -->
    <div class="bs-filter-card">
        <div class="bs-filter-header">
            <div class="bs-filter-title">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="4" y1="6" x2="20" y2="6"></line><line x1="6" y1="12" x2="18" y2="12"></line><line x1="8" y1="18" x2="16" y2="18"></line>
                </svg>
                Filters
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
        </div>
        
        <div class="bs-filter-body">
            <div class="bs-filter-grid">
                
                <div class="bs-form-group">
                    <label class="bs-form-label">Date Range</label>
                    <div class="bs-input-wrapper">
                        <input type="text" class="bs-form-control" placeholder="01 Apr 2025 - 28 Apr 2025" readonly style="padding-right: 36px;">
                        <svg class="bs-input-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                    </div>
                </div>

                <div class="bs-form-group">
                    <label class="bs-form-label">Program Type</label>
                    <select class="bs-form-select">
                        <option value="" disabled selected hidden>All Program Type</option>
                    </select>
                </div>

                <div class="bs-form-group">
                    <label class="bs-form-label">Program Name</label>
                    <select class="bs-form-select">
                        <option value="" disabled selected hidden>All Program Name</option>
                    </select>
                </div>

                <div class="bs-form-group">
                    <label class="bs-form-label">Status</label>
                    <select class="bs-form-select">
                        <option value="" disabled selected hidden>All District</option>
                    </select>
                </div>

            </div>
            
            <div class="bs-filter-actions">
                <button class="bs-btn bs-btn-outline">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                    Clear All
                </button>
                <button class="bs-btn bs-btn-solid">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="4" y1="6" x2="20" y2="6"></line><line x1="6" y1="12" x2="18" y2="12"></line><line x1="8" y1="18" x2="16" y2="18"></line>
                    </svg>
                    Apply Filters
                </button>
            </div>
        </div>
    </div>

    <!-- Table Section -->
    <div class="bs-table-card">
        <div class="bs-table-top">
            <h3>Budget plan list</h3>
            <input type="text" class="bs-search-input" placeholder="Search zones...">
        </div>

        <div class="bs-table-wrapper">
            <table class="bs-main-table">
                <thead>
                    <tr>
                        <th><input type="checkbox" class="bs-checkbox"></th>
                        <th>Program Type</th>
                        <th>Program Name</th>
                        <th>Total Budget</th>
                        <th>Submitted Date</th>
                        <th>Status</th>
                        <th>Validation Due</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Row 1: Approved -->
                    <tr>
                        <td><input type="checkbox" class="bs-checkbox"></td>
                        <td>Training</td>
                        <td>Crop Protection Workshop</td>
                        <td>₹2,50,000</td>
                        <td>May 1, 2026</td>
                        <td><span class="bs-badge bs-badge-approved">Approved</span></td>
                        <td>May 10, 2026</td>
                        <td>
                            <div class="bs-actions-cell">
                                <button class="bs-action-btn bs-icon-view" @onclick="OpenBudgetSubmissionsDrawer"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path><circle cx="12" cy="12" r="3"></circle></svg></button>
                                <button class="bs-action-btn bs-icon-approve"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg></button>
                                <button class="bs-action-btn bs-icon-delete"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg></button>
                            </div>
                        </td>
                    </tr>
                    
                    <!-- Row 2: Validated -->
                    <tr>
                        <td><input type="checkbox" class="bs-checkbox"></td>
                        <td>Training</td>
                        <td>Crop Protection Workshop</td>
                        <td>₹2,50,000</td>
                        <td>May 1, 2026</td>
                        <td><span class="bs-badge bs-badge-validated">Validated</span></td>
                        <td>May 10, 2026</td>
                        <td>
                            <div class="bs-actions-cell">
                                <button class="bs-action-btn bs-icon-view" @onclick="OpenBudgetSubmissionsDrawer"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path><circle cx="12" cy="12" r="3"></circle></svg></button>
                                <button class="bs-action-btn bs-icon-validate"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg></button>
                                <button class="bs-action-btn bs-icon-delete"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg></button>
                            </div>
                        </td>
                    </tr>

                    <!-- Row 3: Rejected -->
                    <tr>
                        <td><input type="checkbox" class="bs-checkbox"></td>
                        <td>Training</td>
                        <td>Crop Protection Workshop</td>
                        <td>₹2,50,000</td>
                        <td>May 1, 2026</td>
                        <td><span class="bs-badge bs-badge-rejected">Rejected</span></td>
                        <td>May 10, 2026</td>
                        <td>
                            <div class="bs-actions-cell">
                                <button class="bs-action-btn bs-icon-view" @onclick="OpenBudgetSubmissionsDrawer"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path><circle cx="12" cy="12" r="3"></circle></svg></button>
                                <button class="bs-action-btn bs-icon-reject"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg></button>
                                <button class="bs-action-btn bs-icon-delete"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg></button>
                            </div>
                        </td>
                    </tr>

                    <!-- Row 4: Submitted -->
                    <tr>
                        <td><input type="checkbox" class="bs-checkbox"></td>
                        <td>Training</td>
                        <td>Crop Protection Workshop</td>
                        <td>₹2,50,000</td>
                        <td>May 1, 2026</td>
                        <td><span class="bs-badge bs-badge-submitted">Submitted</span></td>
                        <td>May 10, 2026</td>
                        <td>
                            <div class="bs-actions-cell">
                                <button class="bs-action-btn bs-icon-view" @onclick="OpenBudgetSubmissionsDrawer"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path><circle cx="12" cy="12" r="3"></circle></svg></button>
                                <button class="bs-action-btn bs-icon-submit"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><path d="M14 2v6h6"></path><path d="M9 15l2 2 4-4"></path></svg></button>
                                <button class="bs-action-btn bs-icon-delete"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg></button>
                            </div>
                        </td>
                    </tr>

                    <!-- Row 5: Draft -->
                    <tr>
                        <td><input type="checkbox" class="bs-checkbox"></td>
                        <td>Training</td>
                        <td>Crop Protection Workshop</td>
                        <td>₹2,50,000</td>
                        <td>May 1, 2026</td>
                        <td><span class="bs-badge bs-badge-draft">Draft</span></td>
                        <td>May 10, 2026</td>
                        <td>
                            <div class="bs-actions-cell">
                                <button class="bs-action-btn bs-icon-view" @onclick="OpenBudgetSubmissionsDrawer"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path><circle cx="12" cy="12" r="3"></circle></svg></button>
                                <button class="bs-action-btn bs-icon-draft"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><path d="M14 2v6h6"></path><path d="M10.5 17.5 9 18l.5-1.5L15 11l1.5 1.5-6 5.5Z"></path></svg></button>
                                <button class="bs-action-btn bs-icon-delete"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg></button>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="bs-pagination">
            <div class="bs-page-size">
                <span>Items Per Page</span>
                <select class="bs-form-select" style="padding: 6px 32px 6px 12px; width: 65px; margin:0; background-position: right 8px center;">
                    <option>16</option>
                </select>
            </div>
            <div class="bs-page-controls">
                <button class="bs-page-btn"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg></button>
                <button class="bs-page-btn active">1</button>
                <button class="bs-page-btn">2</button>
                <button class="bs-page-btn">3</button>
                <button class="bs-page-btn dots">..</button>
                <button class="bs-page-btn">8</button>
                <button class="bs-page-btn">9</button>
                <button class="bs-page-btn">10</button>
                <button class="bs-page-btn"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg></button>
            </div>
        </div>
    </div>

    <!-- Rejection Alert Banner -->
    <div class="bs-rejection-alert">
        <div class="bs-rejection-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
        </div>
        <div class="bs-rejection-text">
            <strong>Rejection Reason:</strong> Budget exceeds approved limit. Please revise and resubmit with detailed breakdown.
        </div>
    </div>
</div>

<BudgetSubmissionsDrawer @bind-IsOpen="isBudgetSubmissionsDrawerOpen" />
@code {
    private bool isBudgetSubmissionsDrawerOpen = false;

    private void OpenBudgetSubmissionsDrawer()
    {
        isBudgetSubmissionsDrawerOpen = true;
    }
}