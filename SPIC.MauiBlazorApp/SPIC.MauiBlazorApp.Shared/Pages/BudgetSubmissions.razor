@page "/BudgetSubmissions"

@using System.Net.Http.Json
@using SPIC.Core.DTOs
@inject HttpClient Http


<PageHeader Title="Budget Submissions"
            Subtitle="Track and manage your submitted budgets"
            CssClass="bs-page-header" />


<div class="container-fluid py-4 px-0">


    <!-- Summary Cards -->
    <div class="bs-stats-grid">

        <div class="bs-stat-card bs-theme-blue">
            <div class="bs-card-body">
                <div class="bs-stat-text">
                    <h2>@summary.Total</h2>
                    <p>Total Budget</p>
                </div>
            </div>
        </div>

        <div class="bs-stat-card bs-theme-green">
            <div class="bs-card-body">
                <div class="bs-stat-text">
                    <h2>@summary.Approved</h2>
                    <p>Approved</p>
                </div>
            </div>
        </div>

        <div class="bs-stat-card bs-theme-orange">
            <div class="bs-card-body">
                <div class="bs-stat-text">
                    <h2>@summary.Pending</h2>
                    <p>Pending validation</p>
                </div>
            </div>
        </div>

        <div class="bs-stat-card bs-theme-red">
            <div class="bs-card-body">
                <div class="bs-stat-text">
                    <h2>@summary.Rejected</h2>
                    <p>Rejected</p>
                </div>
            </div>
        </div>

        <div class="bs-stat-card bs-theme-gray">
            <div class="bs-card-body">
                <div class="bs-stat-text">
                    <h2>@summary.Draft</h2>
                    <p>Drafts</p>
                </div>
            </div>
        </div>

    </div>



    <!-- External Filter Card -->
    <div class="bs-filter-card">

        <div class="bs-filter-grid">


            <div class="bs-form-group">

                <label>Date Range</label>

                <div class="date-range-wrapper">

                    <input type="date"
                           class="bs-form-control"
                           @bind="FromDate" />


                    <span class="date-separator">
                        -
                    </span>


                    <input type="date"
                           class="bs-form-control"
                           @bind="ToDate" />

                </div>

            </div>



            <div class="bs-form-group">
                <label>Program Type</label>

                <select class="bs-form-select"
                        @bind="selectedProgramType"
                        @bind:after="OnProgramTypeChanged">

                    <option value="">
                        All Program Type
                    </option>

                    @foreach (var item in ProgramTypes)
                    {
                        <option value="@item">@item</option>
                    }

                </select>
            </div>



            <div class="bs-form-group">
                <label>Program Name</label>

                <select class="bs-form-select"
                        @bind="selectedProgramName">

                    <option value="">
                        All Program Name
                    </option>

                    @foreach (var item in ProgramNames)
                    {
                        <option value="@item">@item</option>
                    }

                </select>
            </div>



            <div class="bs-form-group">
                <label>Status</label>

                <select class="bs-form-select"
                        @bind="selectedStatus">

                    <option value="">
                        All Status
                    </option>

                    @foreach (var item in StatusList)
                    {
                        <option value="@item">@item</option>
                    }

                </select>
            </div>


        </div>


        <div class="bs-filter-actions">

            <button class="bs-btn bs-btn-outline"
                    @onclick="ClearFilters">
                Clear All
            </button>


            <button class="bs-btn bs-btn-solid"
                    @onclick="ApplyFilter">
                Apply Filters
            </button>

        </div>

    </div>



    <!-- SpicDataTable -->

    <SpicDataTable Items="FilteredSubmissions"
                   IsLoading="_isLoading"
                   Title="Budget plan list"
                   FileName="Budget_Submissions"
                   SearchText="@_searchText"
                   EmptyTitle="No Budget Data"
                   EmptyMessage="No budget submission records found."
                   ExportColumns="GetExportColumns()">



        <FilterControls>

            <div class="search-box">

                <i class="bi bi-search"></i>

                <input type="text"
                       placeholder="Search Program..."
                       @bind="_searchText"
                       @bind:event="oninput"
                       @bind:after="ApplyFilter" />

            </div>

        </FilterControls>



        <TableHeader>

            <th>Select</th>
            <th>Program Type</th>
            <th>Program Name</th>
            <th>Total Budget</th>
            <th>Submitted Date</th>
            <th>Status</th>
            <th>Validation Due</th>
            <th>Action</th>

        </TableHeader>



        <TableRow Context="item">

            <td>
                <input type="checkbox" />
            </td>

            <td>@item.ProgramType</td>

            <td>@item.ProgramName</td>

            <td>
                ₹@item.TotalBudget.ToString("N0")
            </td>

            <td>
                @item.SubmittedDate.ToString("dd MMM yyyy")
            </td>

            <td>
                <span class="@GetStatusClass(item.Status)">
                    @item.Status
                </span>
            </td>

            <td>
                @(item.ValidationDue?.ToString("dd MMM yyyy") ?? "-")
            </td>

            <td>
                <button class="bs-action-btn"
                        @onclick="() => OpenBudgetSubmissionsDrawer(item)">

                    <i class="bi bi-eye"></i>

                </button>
            </td>

        </TableRow>


    </SpicDataTable>


</div>



<BudgetSubmissionsDrawer @bind-IsOpen="isBudgetSubmissionsDrawerOpen"
                         Submission="selectedSubmission" />


@code {
    private DateTime? FromDate { get; set; } =
        new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);


    private DateTime? ToDate { get; set; } =
        DateTime.Now;
    private bool _isLoading = false;

    private bool isBudgetSubmissionsDrawerOpen = false;
    private BudgetSubmissionDto? selectedSubmission;

    private string _searchText = "";


    private List<BudgetSubmissionDto> submissions = new();

    private BudgetSubmissionSummaryDto summary = new();


    private string selectedProgramType = "";

    private string selectedProgramName = "";

    private string selectedStatus = "";


    protected override async Task OnInitializedAsync()
    {
        submissions =
            await Http.GetFromJsonAsync<List<BudgetSubmissionDto>>
            ("api/Budget/submissions") ?? new();


        summary =
            await Http.GetFromJsonAsync<BudgetSubmissionSummaryDto>
            ("api/Budget/submission-summary") ?? new();
    }


    private IEnumerable<BudgetSubmissionDto> FilteredSubmissions =>
      submissions

      .Where(x =>
          string.IsNullOrEmpty(selectedProgramType)
          ||
          x.ProgramType == selectedProgramType)

      .Where(x =>
          string.IsNullOrEmpty(selectedProgramName)
          ||
          x.ProgramName == selectedProgramName)

      .Where(x =>
          string.IsNullOrEmpty(selectedStatus)
          ||
          x.Status == selectedStatus)

      .Where(x =>
          !FromDate.HasValue
          ||
          x.SubmittedDate.Date >= FromDate.Value.Date)

      .Where(x =>
          !ToDate.HasValue
          ||
          x.SubmittedDate.Date <= ToDate.Value.Date)

      .Where(x =>
          string.IsNullOrEmpty(_searchText)
          ||
          x.ProgramName.Contains(
              _searchText,
              StringComparison.OrdinalIgnoreCase)
          ||
          x.ProgramType.Contains(
              _searchText,
              StringComparison.OrdinalIgnoreCase));


    private List<string> ProgramTypes =>
        submissions.Select(x => x.ProgramType).Distinct().ToList();


    private List<string> ProgramNames =>
    submissions
        .Where(x =>
            string.IsNullOrEmpty(selectedProgramType)
            || x.ProgramType == selectedProgramType)
        .Select(x => x.ProgramName)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct()
        .OrderBy(x => x)
        .ToList();


    private List<string> StatusList =>
        submissions.Select(x => x.Status).Distinct().ToList();


    private void ApplyFilter()
    {
        StateHasChanged();
    }


    private void ClearFilters()
    {
        selectedProgramType = "";
        selectedProgramName = "";
        selectedStatus = "";
        _searchText = "";
        FromDate = null;
        ToDate = null;
    }


    private string GetStatusClass(string status)
    {
        return status switch
        {
            "Approved" => "bs-badge bs-badge-approved",
            "Rejected" => "bs-badge bs-badge-rejected",
            "Draft" => "bs-badge bs-badge-draft",
            "Submitted" => "bs-badge bs-badge-submitted",
            "Validated" => "bs-badge bs-badge-validated",
            _ => "bs-badge"
        };
    }


    private List<ExportColumn<BudgetSubmissionDto>> GetExportColumns()
    {
        return new()
        {
            new ExportColumn<BudgetSubmissionDto>
            {
                Header="Program Type",
                ValueSelector=x=>x.ProgramType
            },

            new ExportColumn<BudgetSubmissionDto>
            {
                Header="Program Name",
                ValueSelector=x=>x.ProgramName
            },

            new ExportColumn<BudgetSubmissionDto>
            {
                Header="Total Budget",
                ValueSelector=x=>x.TotalBudget.ToString()
            },

            new ExportColumn<BudgetSubmissionDto>
            {
                Header="Status",
                ValueSelector=x=>x.Status
            }
        };
    }


    private void OpenBudgetSubmissionsDrawer(BudgetSubmissionDto item)
    {
        selectedSubmission = item;
        isBudgetSubmissionsDrawerOpen = true;
    }
    private void OnProgramTypeChanged()
    {
        selectedProgramName = "";
    }
}
