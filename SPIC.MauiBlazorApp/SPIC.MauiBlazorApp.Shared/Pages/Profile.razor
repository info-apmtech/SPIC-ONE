                            <button type="button" class="dp-btn-outline-green" @onclick="OpenEditModalAsync">
                                <i class="bi bi-pencil-square"></i> Edit Profile
                            </button>
                        }
                    </div>
                </div>
                @if (_isAdmin)
                {
                    @if (_adminProfile != null)
                    {
                        <div class="dp-card-body">
                            <div class="dp-info-row">
                                <div class="dp-info-box flex-1-8">
                                    <div class="dp-box-lbl">Name</div>
                                    <div class="dp-box-val">@TextOrDash(_adminProfile.Name)</div>
                                </div>
                                <div class="dp-info-box flex-1-8">
                                    <div class="dp-box-lbl">Email</div>
                                    <div class="dp-box-val">@TextOrDash(_adminProfile.Email)</div>
                                </div>
                                <div class="dp-info-box flex-1">
                                    <div class="dp-box-lbl">User Name</div>
                                    <div class="dp-box-val">@TextOrDash(_adminProfile.UserName)</div>
                                </div>
                            </div>
                            <div class="dp-info-row">
                                <div class="dp-info-box flex-1">
                                    <div class="dp-box-lbl">Role</div>
                                    <div class="dp-box-val">@RoleDisplayText(_adminProfile.Role)</div>
                                </div>
                                <div class="dp-info-box flex-1-2">
                                    <div class="dp-box-lbl">Designation</div>
                                    <div class="dp-box-val">@(LoginState.DesignationName ?? "—")</div>
                                </div>
                                <div class="dp-info-box flex-1">
                                    <div class="dp-box-lbl">Status</div>
                                    <div class="dp-box-val">@(_adminProfile.IsActive ? "Active" : "Inactive")</div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="dp-empty-state"><div class="dp-empty-state-icon"><i class="bi bi-person-badge"></i></div>No admin profile information available.</div>
                    }
                }
                else if (_employee != null && _employeeLogin != null)
                {
                    <div class="dp-card-body">
                        <div class="dp-info-row">
                            <div class="dp-info-box flex-1-2">
                                <div class="dp-box-lbl">Employee Code</div>
                                <div class="dp-box-val">@TextOrDash(_employee.EmployeeCode)</div>
                            </div>
                            <div class="dp-info-box flex-1-8">
                                <div class="dp-box-lbl">Name</div>
                                <div class="dp-box-val">@TextOrDash(_employee.Name)</div>
                            </div>
                            <div class="dp-info-box flex-1">
                                <div class="dp-box-lbl">Role</div>
                                <div class="dp-box-val">@RoleDisplayText(_employeeLogin.Role)</div>
                            </div>
                        </div>
                        <div class="dp-info-row">
                            <div class="dp-info-box flex-1-2">
                                <div class="dp-box-lbl">Designation</div>
                                <div class="dp-box-val">@(LoginState.DesignationName ?? "—")</div>
                            </div>
                            <div class="dp-info-box flex-1-8">
                                <div class="dp-box-lbl">Email</div>
                                <div class="dp-box-val">@TextOrDash(_employee.Email)</div>
                            </div>
                            <div class="dp-info-box flex-1">
                                <div class="dp-box-lbl">Personal Phone</div>
                                <div class="dp-box-val">@TextOrDash(_employee.PersonalPhoneNumber)</div>
                            </div>
                            <div class="dp-info-box flex-1">
                                <div class="dp-box-lbl">Official Phone</div>
                                <div class="dp-box-val">@TextOrDash(_employee.OfficialPhoneNumber)</div>
                            </div>
                        </div>
                        <div class="dp-info-row">
                            <div class="dp-info-box flex-1">
                                <div class="dp-box-lbl">Zone</div>
                                <div class="dp-box-val">@EmployeeZoneName</div>
                            </div>
                            <div class="dp-info-box flex-1">
                                <div class="dp-box-lbl">State</div>
                                <div class="dp-box-val">@EmployeeStateName</div>
                            </div>
                            <div class="dp-info-box flex-1">
                                <div class="dp-box-lbl">Region</div>
                                <div class="dp-box-val">@EmployeeRegionName</div>
                            </div>
                            <div class="dp-info-box flex-1">
                                <div class="dp-box-lbl">Headquarter</div>
                                <div class="dp-box-val">@EmployeeHQName</div>
                            </div>
                        </div>
                        <div class="dp-info-row">
                            <div class="dp-info-box flex-1">
                                <div class="dp-box-lbl">Status</div>
                                <div class="dp-box-val">@(_employeeLogin.IsActive ? "Active" : "Inactive")</div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="dp-empty-state"><div class="dp-empty-state-icon"><i class="bi bi-person-badge"></i></div>No employee profile information available.</div>
                }
            </div>
        }

        @if (activeTab == "DealerInfo")
        {
            <div class="dp-info-card">
                <div class="dp-card-header">
                    <div class="dp-icon-box dp-icon-purple"><i class="bi bi-person-badge"></i></div>
                    <h3 class="dp-card-title">Dealer Information</h3>
                </div>
                @if (_hasDealer)
                {
                    <div class="dp-card-body">
                        <div class="dp-info-row">
                            <div class="dp-info-box flex-1"><div class="dp-box-lbl">State</div><div class="dp-box-val">@(_headerInfo?.State ?? "—")</div></div>
                            <div class="dp-info-box flex-1"><div class="dp-box-lbl">Region</div><div class="dp-box-val">@(_headerInfo?.Region ?? "—")</div></div>
                            <div class="dp-info-box flex-1"><div class="dp-box-lbl">District</div><div class="dp-box-val">@(_headerInfo?.District ?? "—")</div></div>
                            <div class="dp-info-box flex-1"><div class="dp-box-lbl">HQ</div><div class="dp-box-val">@(_headerInfo?.HQ ?? "—")</div></div>
                            <div class="dp-info-box flex-1"><div class="dp-box-lbl">Taluk</div><div class="dp-box-val">@(_registration?.Taluk ?? "—")</div></div>
                        </div>
                        <div class="dp-info-row">
                            <div class="dp-info-box flex-1-2"><div class="dp-box-lbl">Firm Name</div><div class="dp-box-val">@(_registration?.FirmName ?? "—")</div></div>
                            <div class="dp-info-box flex-1-8"><div class="dp-box-lbl">Address</div><div class="dp-box-val">@(_headerInfo?.Address ?? "—")</div></div>
                            <div class="dp-info-box flex-1"><div class="dp-box-lbl">Pincode</div><div class="dp-box-val">@(_registration?.PinCode ?? "—")</div></div>
                            <div class="dp-info-box flex-1"><div class="dp-box-lbl">Official Contact</div><div class="dp-box-val">@(_registration?.OfficialContactNumber ?? "—")</div></div>
                        </div>
                        <div class="dp-info-row">
                            <div class="dp-info-box flex-1"><div class="dp-box-lbl">WhatsApp Number</div><div class="dp-box-val">@(_registration?.WhatsAppNumber ?? "—")</div></div>
                            <div class="dp-info-box flex-1"><div class="dp-box-lbl">Alternative Number</div><div class="dp-box-val">@(_registration?.AlternativeNumber ?? "—")</div></div>
                            <div class="dp-info-box flex-1"><div class="dp-box-lbl">Email</div><div class="dp-box-val">@(_headerInfo?.Email ?? "—")</div></div>
                            <div class="dp-info-box flex-1">
                                <div class="dp-box-lbl">Entity Type</div>
                                <div class="dp-pill-blue mt-1">@(_headerInfo?.EntityType ?? "—")</div>
                            </div>
                            <div class="dp-info-box flex-1"><div class="dp-box-lbl">FMS ID</div><div class="dp-box-val">@(_fmsId ?? "—")</div></div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="dp-empty-state"><div class="dp-empty-state-icon"><i class="bi bi-person-badge"></i></div>No dealer registration data available.</div>
                }
            </div>
        }

        @if (activeTab == "Proprietorship")
        {
            <div class="dp-info-card">
                <div class="dp-card-header">
                    <div class="dp-icon-box dp-icon-yellow"><i class="bi bi-person-fill"></i></div>
                    <h3 class="dp-card-title">Sole Proprietorship Details</h3>
                </div>
                @if (_hasDealer && _owners.Any())
                {
                    <div class="dp-card-body">
                        @foreach (var owner in _owners)
                        {
                            <div class="dp-info-row">
                                <div class="dp-info-box flex-1">
                                    <div class="dp-box-lbl">Proprietor Name</div>
                                    <div class="dp-box-val">@owner.Name</div>
                                </div>
                                <div class="dp-info-box flex-1">
                                    <div class="dp-box-lbl">Father / Mother Name</div>
                                    <div class="dp-box-val">@(owner.FatherName ?? "—")</div>
                                </div>
                                <div class="dp-info-box flex-1">
                                    <div class="dp-box-lbl">Gender</div>
                                    <div class="dp-box-val">@owner.Gender</div>
                                </div>
                            </div>
                            <div class="dp-info-row">
                                <div class="dp-info-box flex-1">
                                    <div class="dp-box-lbl">Age</div>
                                    <div class="dp-box-val">@GetAge(owner.DOB) Years</div>
                                </div>
                                <div class="dp-info-box flex-1">
                                    <div class="dp-box-lbl">Date of Birth</div>
                                    <div class="dp-box-val">@owner.DOB.ToString("dd MMM yyyy")</div>
                                </div>
                                <div class="dp-info-box flex-1">
                                    <div class="dp-box-lbl">Marital Status</div>
                                    <div class="dp-box-val">@owner.MaritalStatus</div>
                                </div>
                                <div class="dp-info-box flex-1">
                                    <div class="dp-box-lbl">Educational Qualification</div>
                                    <div class="dp-box-val">@(owner.EducationalQualification ?? "—")</div>
                                </div>
                            </div>
                            <div class="dp-info-row">
                                <div class="dp-info-box flex-1">
                                    <div class="dp-box-lbl">Phone Number</div>
                                    <div class="dp-box-val">@(owner.PhoneNumber ?? "—")</div>
                                </div>
                                <div class="dp-info-box flex-1">
                                    <div class="dp-box-lbl">Email</div>
                                    <div class="dp-box-val">@(owner.Email ?? "—")</div>
                                </div>
                                <div class="dp-info-box flex-1-8">
                                    <div class="dp-box-lbl">Residential Address</div>
                                    <div class="dp-box-val">@BuildOwnerAddress(owner)</div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else if (_hasDealer)
                {
                    <div class="dp-empty-state"><div class="dp-empty-state-icon"><i class="bi bi-person"></i></div>No proprietorship information available.</div>
                }
                else
                {
                    <div class="dp-empty-state"><div class="dp-empty-state-icon"><i class="bi bi-person"></i></div>No dealer registration data available.</div>
                }
            </div>
        }

        @if (activeTab == "Nominees")
        {
            <div class="dp-info-card">
                <div class="dp-card-header">
                    <div class="dp-icon-box dp-icon-pink"><i class="bi bi-people-fill"></i></div>
                    <h3 class="dp-card-title">Nominee Details</h3>
                </div>
                @if (_hasDealer && _familyMembers.Any())
                {
                    <div class="dp-card-body">
                        <div class="dp-info-row" style="flex-wrap:wrap;">
                            @foreach (var fm in _familyMembers)
                            {
                                <div class="dp-sub-card">
                                    <div class="dp-profile-row">
                                        <div class="dp-mini-avatar" style="display:flex;align-items:center;justify-content:center;background:#fce7f3;color:#c026d3;font-weight:700;font-size:1.1rem;">
                                            @GetInitials(fm.FamilyMemberName)
                                        </div>
                                        <div>
                                            <h4 class="dp-profile-name">@fm.FamilyMemberName</h4>
                                            <p class="dp-profile-relation">@GetRelationshipName(fm.RelationshipId)</p>
                                        </div>
                                    </div>
                                    <div class="dp-info-row">
                                        <div class="dp-info-box flex-1"><div class="dp-box-lbl">Beneficiary</div><div class="dp-box-val">@fm.FamilyMemberName</div></div>
                                        <div class="dp-info-box flex-1"><div class="dp-box-lbl">Date of Birth</div><div class="dp-box-val">@fm.DateOfBirth.ToString("dd MMM yyyy")</div></div>
                                    </div>
                                    <div class="dp-info-row">
                                        <div class="dp-info-box flex-1"><div class="dp-box-lbl">Age</div><div class="dp-box-val">@fm.Age Years</div></div>
                                        <div class="dp-info-box flex-1"><div class="dp-box-lbl">Marital Status</div><div class="dp-box-val">@(fm.MaritalStatus?.ToString() ?? "—")</div></div>
                                        <div class="dp-info-box flex-1"><div class="dp-box-lbl">Education</div><div class="dp-box-val">@(fm.EducationalQualification ?? "—")</div></div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
                else if (_hasDealer)
                {
                    <div class="dp-empty-state"><div class="dp-empty-state-icon"><i class="bi bi-people"></i></div>No nominee information available.</div>
                }
                else
                {
                    <div class="dp-empty-state"><div class="dp-empty-state-icon"><i class="bi bi-people"></i></div>No dealer registration data available.</div>
                }
            </div>
        }

        @if (activeTab == "Trade")
        {
            <div class="dp-info-card">
                <div class="dp-card-header">
                    <div class="dp-icon-box dp-icon-green"><i class="bi bi-briefcase"></i></div>
                    <h3 class="dp-card-title">Fertilizer Trade Experience</h3>
                </div>
                @if (_hasDealer && _experiences.Any())
                {
                    <div class="dp-card-body">
                        <div class="dp-trade-banner">
                            <div class="dp-trade-stat">
                                <div class="dp-trade-stat-icon"><i class="bi bi-building"></i></div>
                                <div>
                                    <div class="dp-trade-stat-lbl">Total Companies</div>
                                    <div class="dp-trade-stat-val">@_experiences.Count</div>
                                </div>
                            </div>
                            <div class="dp-trade-stat">
                                <div class="dp-trade-stat-icon"><i class="bi bi-calendar-check"></i></div>
                                <div>
                                    <div class="dp-trade-stat-lbl">Total Experience</div>
                                    <div class="dp-trade-stat-val">@_experiences.Sum(e => e.NoOfYears) Years</div>
                                </div>
                            </div>
                            <div class="dp-trade-stat">
                                <div class="dp-trade-stat-icon"><i class="bi bi-currency-rupee"></i></div>
                                <div>
                                    <div class="dp-trade-stat-lbl">Total Turnover</div>
                                    <div class="dp-trade-stat-val">₹@FormatCurrency(_experiences.Sum(e => e.TurnOver))</div>
                                </div>
                            </div>
                        </div>

                        <div class="dp-info-row" style="flex-wrap:wrap;">
                            @foreach (var exp in _experiences)
                            {
                                <div class="dp-trade-subcard">
                                    <h4 class="dp-trade-subcard-title">@(GetCompanyName(exp.CompanyId))</h4>
                                    <div class="dp-trade-kv-row"><span class="dp-trade-kv-lbl">Principal</span><span class="dp-trade-kv-val">@(GetCompanyName(exp.CompanyId))</span></div>
                                    <div class="dp-trade-kv-row"><span class="dp-trade-kv-lbl">Experience</span><span class="dp-trade-kv-val">@exp.NoOfYears Years</span></div>
                                    <div class="dp-trade-kv-row"><span class="dp-trade-kv-lbl">Quantity</span><span class="dp-trade-kv-val">@FormatCurrency(exp.Quantity) MT</span></div>
                                    <div class="dp-trade-kv-row"><span class="dp-trade-kv-lbl">Turnover</span><span class="dp-trade-kv-val">₹@FormatCurrency(exp.TurnOver)</span></div>
                                </div>
                            }
                        </div>
                    </div>
                }
                else if (_hasDealer)
                {
                    <div class="dp-empty-state"><div class="dp-empty-state-icon"><i class="bi bi-briefcase"></i></div>No trade experience information available.</div>
                }
                else
                {
                    <div class="dp-empty-state"><div class="dp-empty-state-icon"><i class="bi bi-briefcase"></i></div>No dealer registration data available.</div>
                }
            </div>
        }

        @if (activeTab == "Turnover")
        {
            <div class="dp-info-card">
                <div class="dp-tabs-container">
                    <div class="dp-tab-item @(turnoverSubTab == "SPIC" ? "active" : "")" @onclick='() => SetTurnoverTab("SPIC")'>SPIC</div>
                    <div class="dp-tab-item @(turnoverSubTab == "GreenStar" ? "active" : "")" @onclick='() => SetTurnoverTab("GreenStar")'>Green Star</div>
                </div>
                <div class="dp-card-body">
                    <h5 class="dp-trade-subcard-title">Business Turnover Details</h5>
                    @if (_turnoverLoading)
                    {
                        <div class="dp-empty-state"><div class="dp-empty-state-icon"><i class="bi bi-hourglass-split"></i></div>Loading turnover details...</div>
                    }
                    else
                    {
                        var tabRows = TurnoverRowsForTab;
                        if (tabRows.Count == 0)
                        {
                            <div class="dp-empty-state"><div class="dp-empty-state-icon"><i class="bi bi-graph-up"></i></div>No turnover data available.</div>
                        }
                        else
                        {
                            <div class="dp-table-wrapper" style="width:100%;">
                                <table class="dp-turnover-table">
                                    <thead>
                                        <tr>
                                            <th>Product Name</th>
                                            @for (int i = 0; i < _turnoverFYIds.Count; i++)
                                            {
                                                <th class="text-end">@GetTurnoverFYName(i) (MT)</th>
                                            }
                                            <th class="text-end">Growth</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in tabRows)
                                        {
                                            <tr>
                                                <td>@row.ProductName</td>
                                                @for (int i = 0; i < _turnoverFYIds.Count; i++)
                                                {
                                                    <td class="text-end">@QtyOrDash(row.Qty?[i])</td>
                                                }
                                                <td class="text-end">@GrowthForRow(row)</td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr class="dp-grand-total">
                                            <td>Grand Total</td>
                                            @for (int i = 0; i < _turnoverFYIds.Count; i++)
                                            {
                                                <td class="text-end">@QtyOrDash(TotalForIndex(i, tabRows))</td>
                                            }
                                            <td class="text-end">@GrowthForTotal(tabRows)</td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        }
                    }
                </div>
            </div>
        }

        @if (activeTab == "Assets")
        {
            <div class="dp-info-card">
                <div class="dp-card-header">
                    <div class="dp-icon-box dp-icon-purple"><i class="bi bi-house"></i></div>
                    <h3 class="dp-card-title">Assets Eligible for Benefits</h3>
                </div>
                @if (_hasDealer)
                {
                    var movableVal = _registration?.AssetValue ?? 0;
                    var immovableVal = _landAssets.Sum(l => l.PropertyValue) + _buildingAssets.Sum(b => b.PropertyValue);
                    var totalVal = movableVal + immovableVal;
                    <div class="dp-card-body">
                        @if (movableVal > 0 || immovableVal > 0)
                        {
                            <div class="dp-info-row">
                                @if (movableVal > 0)
                                {
                                    <div class="dp-asset-card">
                                        <div class="dp-asset-icon" style="background:#e0e7ff;color:#4f46e5;"><i class="bi bi-truck"></i></div>
                                        <div>
                                            <div class="dp-asset-lbl">Movable Assets</div>
                                            <div class="dp-asset-val">₹@FormatCurrency(movableVal)</div>
                                            <p class="dp-asset-desc">Vehicles, machinery, equipment</p>
                                        </div>
                                    </div>
                                }
                                @if (immovableVal > 0)
                                {
                                    <div class="dp-asset-card">
                                        <div class="dp-asset-icon" style="background:#dcfce7;color:#16a34a;"><i class="bi bi-building"></i></div>
                                        <div>
                                            <div class="dp-asset-lbl">Immovable Assets</div>
                                            <div class="dp-asset-val">₹@FormatCurrency(immovableVal)</div>
                                            <p class="dp-asset-desc">Land (@_landAssets.Count), Buildings (@_buildingAssets.Count)</p>
                                        </div>
                                    </div>
                                }
                            </div>
                            <div class="dp-total-banner">
                                <span class="dp-total-banner-lbl">Total Assets</span>
                                <span class="dp-total-banner-val">₹@FormatCurrency(totalVal)</span>
                            </div>
                        }
                        else
                        {
                            <div class="dp-empty-state"><div class="dp-empty-state-icon"><i class="bi bi-house"></i></div>No asset information available.</div>
                        }
                    </div>
                }
                else
                {
                    <div class="dp-empty-state"><div class="dp-empty-state-icon"><i class="bi bi-house"></i></div>No dealer registration data available.</div>
                }
            </div>
        }

        @if (activeTab == "Welfare")
        {
            <div class="dp-info-card">
                <div class="dp-card-header">
                    <div class="dp-icon-box dp-icon-red"><i class="bi bi-shield-heart"></i></div>
                    <h3 class="dp-card-title">Availed Welfare Schemes</h3>
                </div>

                <div class="dp-card-body">
                    @if (_isLoadingWelfare)
                    {
                        <Skeleton Variant="card" Rows="2" LoadingText="Loading welfare schemes..." />
                    }
                    else if (_hasDealer && _welfareApps.Any())
                    {
                        @foreach (var app in _welfareApps)
                        {
                            <div class="dp-scheme-card">
                                <div class="dp-scheme-header">
                                    <div class="dp-scheme-title-area">
                                        <div class="dp-scheme-icon"><i class="bi bi-shield-check"></i></div>
                                        <div>
                                            <h4 class="dp-scheme-name">@app.SchemeName</h4>
                                            <p class="dp-scheme-id">@(app.ApplicationNumber ?? "—")</p>
                                        </div>
                                    </div>
                                    <div>@GetWelfareStatusPill(app.Status)</div>
                                </div>
                                <div class="dp-scheme-detail">
                                    <span>Beneficiary: @(app.BeneficiaryName ?? "—")</span>
                                    <span style="margin-left:16px;">Applied: @app.ApplicationDate.ToString("dd MMM yyyy")</span>
                                    @if (app.DocumentCount > 0)
                                    {
                                        <span style="margin-left:16px;">@app.DocumentCount document(s)</span>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else if (_hasDealer)
                    {
                        <div class="dp-empty-state"><div class="dp-empty-state-icon"><i class="bi bi-shield"></i></div>No welfare scheme applications found.</div>
                    }
                    else
                    {
                        <div class="dp-empty-state"><div class="dp-empty-state-icon"><i class="bi bi-shield"></i></div>No dealer registration data available.</div>
                    }
                </div>
            </div>
        }
    }

</div>

@if (_showEditModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block emp-modal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-person-badge me-2"></i>Edit Profile</h5>
                    <button type="button" class="btn-close" @onclick="CloseEditModal" disabled="@_isSavingProfile"></button>
                </div>
                <div class="modal-body">
                    @if (_isAdmin)
                    {
                        <p class="text-muted small mb-3">
                            You can update your <strong>Name</strong>, <strong>Email</strong> and
                            <strong>Designation</strong>. Role, User Name and Status are not editable here.
                        </p>
                    }
                    else
                    {
                        <p class="text-muted small mb-3">
                            You can update your own employee profile. Changing your <strong>Role</strong>,
                            <strong>Designation</strong>, <strong>Zone</strong>, <strong>State</strong>,
                            <strong>Region</strong>, <strong>Headquarter</strong> or <strong>Status</strong>
                            affects your permissions and data scope, so you will be signed out and asked to log in
                            again once the change is saved.
                        </p>
                    }

                    @if (_editFormError is not null)
                    {
                        <div class="alert alert-danger py-2">@_editFormError</div>
                    }

                    @if (_isLoadingEditForm)
                    {
                        <div class="text-muted py-3"><span class="spinner-border spinner-border-sm me-2"></span>Loading your details...</div>
                    }
                    else if (_isAdmin)
                    {
                        <p class="text-muted small mb-2 fw-semibold">Personal Details</p>
                        <div class="row g-4">
                            <div class="col-md-6">
                                <label class="form-lbl">Name</label>
                                <input type="text" class="form-inp" placeholder="Enter Name"
                                       @bind="_edit.Name" disabled="@_editDisabled" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-lbl">Email</label>
                                <input type="email" class="form-inp" placeholder="Enter Email"
                                       @bind="_edit.Email" disabled="@_editDisabled" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-lbl">Designation</label>
                                <select class="form-inp" @bind="_edit.DesignationId" disabled="@_editDisabled">
                                    <option value="0">-- No Designation --</option>
                                    @foreach (var d in _editDesignations)
                                    {
                                        <option value="@d.Id">@d.Name</option>
                                    }
                                </select>
                            </div>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small mb-2 fw-semibold">Personal Details</p>
                        <div class="row g-4">
                            <div class="col-md-6">
                                <label class="form-lbl">Employee Code</label>
                                <input type="text" class="form-inp" placeholder="Enter Employee ID"
                                       @bind="_edit.EmployeeCode" disabled="@_editDisabled" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-lbl">Name</label>
                                <input type="text" class="form-inp" placeholder="Enter Name"
                                       @bind="_edit.Name" disabled="@_editDisabled" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-lbl">Email</label>
                                <input type="email" class="form-inp" placeholder="Enter Email"
                                       @bind="_edit.Email" disabled="@_editDisabled" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-lbl">Personal Phone Number</label>
                                <input type="text" class="form-inp" placeholder="Enter 10 digit mobile number"
                                       @bind="_edit.PersonalPhoneNumber" maxlength="10" disabled="@_editDisabled"
                                       oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-lbl">Official Phone Number</label>
                                <input type="text" class="form-inp" placeholder="Enter 10 digit official number"
                                       @bind="_edit.OfficialPhoneNumber" maxlength="10" disabled="@_editDisabled"
                                       oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
                            </div>
                        </div>

                        <hr class="my-4" />
                        <p class="text-muted small mb-2 fw-semibold">Role &amp; Access</p>
                        <div class="row g-4">
                            <div class="col-md-6">
                                <label class="form-lbl">Role</label>
                                <select class="form-inp" @bind="_edit.Role" disabled="@_editDisabled">
                                    <option value="">Select Role</option>
                                    @foreach (var r in EditableRoles)
                                    {
                                        <option value="@r">@r</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-lbl">Designation</label>
                                <select class="form-inp" @bind="_edit.DesignationId" disabled="@_editDisabled">
                                    <option value="0">-- No Designation (full access) --</option>
                                    @foreach (var d in _editDesignations)
                                    {
                                        <option value="@d.Id">@d.Name</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <hr class="my-4" />
                        <p class="text-muted small mb-2 fw-semibold">Role Specification</p>
                        <div class="row g-4">
                            @* AVP -> Zone only. Every list below is the flat, unfiltered
                               lookup list, exactly as EmployeeRegistration binds them;
                               there is no Region-by-State or Headquarter-by-Region
                               filtering and no onchange handler. *@
                            @if (NeedsZone(SelectedEditRole))
                            {
                                <div class="col-md-3">
                                    <label class="form-lbl">Zone</label>
                                    <select class="form-inp" @bind="_edit.ZoneId" disabled="@_editDisabled">
                                        <option value="0">Select Zone</option>
                                        @foreach (var z in _editZones)
                                        {
                                            <option value="@z.Id">@z.Name</option>
                                        }
                                    </select>
                                </div>
                            }

                            @* SMD, SMM -> State only *@
                            @if (NeedsState(SelectedEditRole) && !NeedsRegion(SelectedEditRole))
                            {
                                <div class="col-md-3">
                                    <label class="form-lbl">State</label>
                                    <select class="form-inp" @bind="_edit.StateId" disabled="@_editDisabled">
                                        <option value="0">Select State</option>
                                        @foreach (var s in _editStates)
                                        {
                                            <option value="@s.Id">@s.Name</option>
                                        }
                                    </select>
                                </div>
                            }

                            @* RM, RMD, MO, MDO, JMDO -> State + Region *@
                            @if (NeedsState(SelectedEditRole) && NeedsRegion(SelectedEditRole))
                            {
                                <div class="col-md-3">
                                    <label class="form-lbl">State</label>
                                    <select class="form-inp" @bind="_edit.StateId" disabled="@_editDisabled">
                                        <option value="0">Select State</option>
                                        @foreach (var s in _editStates)
                                        {
                                            <option value="@s.Id">@s.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-lbl">Region</label>
                                    <select class="form-inp" @bind="_edit.RegionId" disabled="@_editDisabled">
                                        <option value="0">Select Region</option>
                                        @foreach (var r in _editRegions)
                                        {
                                            <option value="@r.Id">@r.Name</option>
                                        }
                                    </select>
                                </div>
                            }

                            @* MDO, MO, JMDO -> Headquarter *@
                            @if (NeedsHeadquarter(SelectedEditRole))
                            {
                                <div class="col-md-3">
                                    <label class="form-lbl">Headquarters</label>
                                    <select class="form-inp" @bind="_edit.HeadquartersId" disabled="@_editDisabled">
                                        <option value="0">Select Headquarters</option>
                                        @foreach (var h in _editHeadquarters)
                                        {
                                            <option value="@h.Id">@h.Name</option>
                                        }
                                    </select>
                                </div>
                            }

                            @if (IsLocationlessRole(SelectedEditRole) && !string.IsNullOrEmpty(SelectedEditRole))
                            {
                                <div class="col-12">
                                    <p class="text-muted small"><i class="bi bi-info-circle me-1"></i>No location specification required for this role.</p>
                                </div>
                            }
                        </div>

                        <hr class="my-4" />
                        <p class="text-muted small mb-2 fw-semibold">Status</p>
                        <div class="d-flex gap-4 align-items-center">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="editStatus" id="editStatusActive"
                                       value="active" checked="@_edit.IsActive"
                                       @onchange="() => _edit.IsActive = true" disabled="@_editDisabled" />
                                <label class="form-check-label" for="editStatusActive">Active</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="editStatus" id="editStatusInactive"
                                       value="inactive" checked="@(!_edit.IsActive)"
                                       @onchange="() => _edit.IsActive = false" disabled="@_editDisabled" />
                                <label class="form-check-label" for="editStatusInactive">Inactive</label>
                            </div>
                        </div>

                        @if (!_edit.IsActive)
                        {
                            <div class="alert alert-warning py-2 mt-3 mb-0 small">
                                <i class="bi bi-exclamation-triangle me-1"></i>
                                Setting your status to <strong>Inactive</strong> will save the change and then
                                immediately sign you out. Contact your administrator to reactivate the account.
                            </div>
                        }
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm rounded-pill px-4"
                            @onclick="CloseEditModal" disabled="@_isSavingProfile">Cancel</button>
                    <button type="button" class="btn btn-success btn-sm rounded-pill px-4"
                            @onclick="SaveProfileAsync" disabled="@(_isSavingProfile || _isLoadingEditForm || _editFormLoadFailed)">
                        @if (_isSavingProfile)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Save Changes
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string activeTab = "DealerInfo";
    private bool _isLoading = true;
    private bool _isLoadingWelfare = false;
    private bool _hasDealer = false;

    private SDWADashboardDealerDto? _headerInfo;
    private DealerRegistration? _registration;
    private string? _profileImageUrl;
    private string? _fmsId;

    private List<DealerOwnershipInfo> _owners = new();
    private List<PartnerFamilyDetails> _familyMembers = new();
    private List<RelationshipEntity> _relationships = new();
    private List<DealerExperience> _experiences = new();
    private List<Competitor> _competitors = new();
    private List<AnnualSaleDataLastFYofDealerRegistration> _annualSales = new();
    private List<Product> _products = new();
    private List<Category> _categories = new();
    private List<Unit> _units = new();
    private List<DealerAssetLand> _landAssets = new();
    private List<DealerAssetBuilding> _buildingAssets = new();
    private List<DealerAssetBank> _bankAssets = new();
    private List<WelfareApplicationSummaryDto> _welfareApps = new();
    private string turnoverSubTab = "SPIC";
    private DealerCreditLimitProposal? _creditProposal;
    private List<CreditLimitHistory> _creditHistories = new();
    private List<FinancialYear> _financialYears = new();
    private List<int> _turnoverFYIds = new();
    private List<TurnoverSalesRow> _turnoverRows = new();
    private bool _turnoverLoading = true;

    private class TurnoverSalesRow
    {
        public int ProductId { get; set; }
        public string ProductName { get; set; } = "";
        public decimal?[]? Qty { get; set; }
    }

    private List<TurnoverSalesRow> TurnoverRowsForTab =>
        turnoverSubTab == "GreenStar"
            ? _turnoverRows.Where(r => !IsUreaProductName(r.ProductName)).ToList()
            : _turnoverRows.Where(r => IsUreaProductName(r.ProductName)).ToList();

    private static bool IsUreaProductName(string productName) =>
        !string.IsNullOrWhiteSpace(productName) &&
        productName.Trim().Equals("Urea", StringComparison.OrdinalIgnoreCase);

    private bool _isDealer = false;
    private bool _isAdmin = false;
    private EmployeeInformation? _employee;
    private Employeelogin? _employeeLogin;
    private ProfileDto? _adminProfile;
    private List<LocationItemDto> _zones = new();

    // Edit Profile (employee branch only). All 12 fields shown on the Employee tab
    // are editable and are persisted by the self-scoped api/Profile endpoint.
    private bool _showEditModal;
    private bool _isLoadingEditForm;
    private bool _isSavingProfile;
    private bool _editFormLoadFailed;
    private string? _editFormError;
    private ProfileUpdateDto _edit = new();

    // Master lists backing the edit dropdowns. Loaded from the same lookup APIs
    // EmployeeManagementList/EmployeeRegistration use, never hard-coded.
    //
    // All four levels share one superset DTO (the pattern already used by
    // EmployeeManagementList.LocationItemDto) so every row carries IsActive and
    // its parent foreign key: State.ZoneId, Region.StateId, Headquarter.RegionId.
    private List<LocationItemDto> _editZones = new();
    private List<LocationItemDto> _editStates = new();
    private List<LocationItemDto> _editRegions = new();
    private List<LocationItemDto> _editHeadquarters = new();
    private List<DesignationEntity> _editDesignations = new();

    /// <summary>The explicit role list EmployeeRegistration.AllowedRoles uses, so the
    /// Profile Edit role dropdown offers exactly the roles the employee editor
    /// offers. Not derived from Enum.GetValues so a new enum member can never
    /// appear here before it is deliberately allowed.</summary>
    private static readonly AppRole[] EditableRoles = new[]
    {
        AppRole.CorporateAdmin,
        AppRole.Director,
        AppRole.AVP,
        AppRole.SMD,
        AppRole.SMM,
        AppRole.RM,
        AppRole.RMD,
        AppRole.MDO,
        AppRole.MO,
        AppRole.JMDO,
        AppRole.SpecialAdmin
    };

    private bool _editDisabled => _isSavingProfile || _editFormLoadFailed;

    // The location block is rendered from the selected role exactly as
    // EmployeeRegistration does, via a computed property, so there is no
    // @bind:after / onchange handler anywhere in Profile Edit.
    private string SelectedEditRole => _edit.Role.ToString();

    private static bool NeedsZone(string role) => role == "AVP";

    private static bool NeedsState(string role) =>
        role == "SMD" || role == "SMM"
        || role == "RM" || role == "RMD" || role == "MO" || role == "MDO" || role == "JMDO";

    private static bool NeedsRegion(string role) =>
        role == "RM" || role == "RMD" || role == "MO" || role == "MDO" || role == "JMDO";

    private static bool NeedsHeadquarter(string role) => role == "MDO" || role == "MO" || role == "JMDO";

    private static bool IsLocationlessRole(string role) =>
        !NeedsZone(role) && !NeedsState(role) && !NeedsRegion(role) && !NeedsHeadquarter(role);


    private void SetTab(string tabName)
    {
        if (!_isDealer && tabName != "Employee") return;
        activeTab = tabName;
        if (tabName == "Welfare" && !_welfareApps.Any() && !_isLoadingWelfare && _hasDealer)
        {
            _ = LoadWelfareData();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!LoginState.IsLoggedIn) { _isLoading = false; return; }

        _isDealer = LoginState.UserRole == AppRole.Dealer;
        _isAdmin = LoginState.UserRole is AppRole.Admin or AppRole.SuperAdmin;
        activeTab = _isDealer ? "DealerInfo" : "Employee";

        if (_isAdmin)
        {
            await LoadAdminProfileAsync();
            _isLoading = false;
            return;
        }

        if (!_isDealer)
        {
            await LoadEmployeeProfileAsync();
            _isLoading = false;
            return;
        }

        try
        {
            _headerInfo = await Http.GetFromJsonAsync<SDWADashboardDealerDto>("api/SDWADashboard/dealer-details");
        }
        catch { _headerInfo = null; }

        if (_headerInfo != null && _headerInfo.DealerId > 0)
        {
            _hasDealer = true;
            var dealerId = _headerInfo.DealerId;

            try
            {
                _registration = await Http.GetFromJsonAsync<DealerRegistration>($"api/DealerRegistration/{dealerId}");
            }
            catch { }

            _fmsId = _registration?.TnCode ?? _registration?.RetailmFMSCode ?? _registration?.WholesalemFMSCode;

            var ownersTask = SafeGetAsync<List<DealerOwnershipInfo>>($"api/DealerOwnershipInfo/byDealer/{dealerId}");
            var expTask = SafeGetAsync<List<DealerExperience>>($"api/DealerExperience/byDealer/{dealerId}");
            var annualTask = SafeGetAsync<List<AnnualSaleDataLastFYofDealerRegistration>>($"api/AnnualSaleDataLastFY/byDealer/{dealerId}");
            var landTask = SafeGetAsync<List<DealerAssetLand>>($"api/DealerAssetLand/byDealer/{dealerId}");
            var buildingTask = SafeGetAsync<List<DealerAssetBuilding>>($"api/DealerAssetBuilding/byDealer/{dealerId}");
            var bankTask = SafeGetAsync<List<DealerAssetBank>>($"api/DealerAssetBank/byDealer/{dealerId}");
            var competitorsTask = SafeGetAsync<List<Competitor>>("api/Competitor/all");
            var productsTask = SafeGetAsync<List<Product>>("api/Product");
            var categoriesTask = SafeGetAsync<List<Category>>("api/Category");
            var unitsTask = SafeGetAsync<List<Unit>>("api/Unit");
            var relationshipsTask = SafeGetAsync<List<RelationshipEntity>>("api/Relationship/all");
            var financialYearsTask = SafeGetAsync<List<FinancialYear>>("api/FinancialYear");
            var creditProposalTask = SafeGetAsync<List<DealerCreditLimitProposal>>($"api/DealerCreditLimitProposal/byDealer/{dealerId}");
            var creditHistoryTask = SafeGetAsync<List<CreditLimitHistory>>($"api/CreditLimitHistory/byDealer/{dealerId}");

            await Task.WhenAll(ownersTask, expTask, annualTask, landTask, buildingTask, bankTask,
                competitorsTask, productsTask, categoriesTask, unitsTask, relationshipsTask,
                financialYearsTask, creditProposalTask, creditHistoryTask);

            _owners = (await ownersTask ?? new()).ToList();
            _experiences = (await expTask ?? new()).ToList();
            _annualSales = (await annualTask ?? new()).ToList();
            _landAssets = (await landTask ?? new()).ToList();
            _buildingAssets = (await buildingTask ?? new()).ToList();
            _bankAssets = (await bankTask ?? new()).ToList();
            _competitors = (await competitorsTask ?? new()).ToList();
            _products = (await productsTask ?? new()).ToList();
            _categories = (await categoriesTask ?? new()).ToList();
            _units = (await unitsTask ?? new()).ToList();
            _relationships = (await relationshipsTask ?? new()).ToList();
            _financialYears = (await financialYearsTask ?? new()).ToList();
            _creditProposal = (await creditProposalTask ?? new()).FirstOrDefault();
            _creditHistories = (await creditHistoryTask ?? new()).ToList();

            await LoadTurnoverRowsAsync(dealerId);

            var ownerIds = _owners.Select(o => o.Id).ToList();
            if (ownerIds.Any())
            {
                var allFamily = await SafeGetAsync<List<PartnerFamilyDetails>>("api/PartnerFamilyDetails/all");
                _familyMembers = (allFamily ?? new()).Where(f => ownerIds.Contains(f.OwnershipPartnerId)).ToList();
            }

            if (_owners.Any())
            {
                var proprietorImage = _owners.FirstOrDefault(o => !string.IsNullOrWhiteSpace(o.ProprietorImagePath))?.ProprietorImagePath;
                if (!string.IsNullOrWhiteSpace(proprietorImage))
                    _profileImageUrl = GetFileUrl(proprietorImage);
            }
        }
        else
        {
            _hasDealer = false;
        }

        _isLoading = false;
    }

    private async Task LoadWelfareData()
    {
        _isLoadingWelfare = true;
        try
        {
            _welfareApps = await Http.GetFromJsonAsync<List<WelfareApplicationSummaryDto>>("api/SDWAWelfareApplication/my-applications") ?? new();
        }
        catch { _welfareApps = new(); }
        _isLoadingWelfare = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task<T?> SafeGetAsync<T>(string url)
    {
        try { return await Http.GetFromJsonAsync<T>(url); }
        catch { return default; }
    }

    private string GetFileUrl(string? filePath)
    {
        if (string.IsNullOrWhiteSpace(filePath)) return "";
        var baseUrl = Nav.BaseUri.TrimEnd('/');
        var escaped = Uri.EscapeDataString(filePath.TrimStart('/'));
        return $"{baseUrl}/api/DealerFile/view/{escaped}?token={Uri.EscapeDataString(LoginState.Token ?? "")}";
    }

    private string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpperInvariant();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }

    private string GetCompanyName(string? companyId)
    {
        if (string.IsNullOrWhiteSpace(companyId)) return "Unknown";
        if (int.TryParse(companyId, out var id))
            return _competitors.FirstOrDefault(c => c.Id == id)?.Name ?? "Unknown";
        return companyId;
    }

    private string GetProductName(int productId) => _products.FirstOrDefault(p => p.Id == productId)?.Name ?? "Unknown";
    private string GetCategoryName(int categoryId) => _categories.FirstOrDefault(c => c.Id == categoryId)?.Name ?? "Unknown";
    private string GetRelationshipName(int relationshipId) => _relationships.FirstOrDefault(r => r.Id == relationshipId)?.Name ?? "—";

    private string GetProductInitials(int productId)
    {
        var name = GetProductName(productId);
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpperInvariant();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }

    private static int GetAge(DateTime dob)
    {
        var today = DateTime.Today;
        var age = today.Year - dob.Year;
        if (dob.Date > today.AddYears(-age)) age--;
        return age;
    }

    private string BuildOwnerAddress(DealerOwnershipInfo owner)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(owner.ShopNoORRoomNoOrBlockNo)) parts.Add(owner.ShopNoORRoomNoOrBlockNo);
        if (!string.IsNullOrWhiteSpace(owner.Street)) parts.Add(owner.Street);
        if (!string.IsNullOrWhiteSpace(owner.SubVillage)) parts.Add(owner.SubVillage);
        if (!string.IsNullOrWhiteSpace(owner.Village)) parts.Add(owner.Village);
        if (!string.IsNullOrWhiteSpace(owner.Taluk)) parts.Add(owner.Taluk);
        if (!string.IsNullOrWhiteSpace(owner.Block)) parts.Add(owner.Block);
        if (!string.IsNullOrWhiteSpace(owner.PinCode)) parts.Add(owner.PinCode);
        return parts.Any() ? string.Join(", ", parts) : "—";
    }

    private static string FormatCurrency(decimal value) => value == 0 ? "0" : value.ToString("N0");

    private void SetTurnoverTab(string tabName) => turnoverSubTab = tabName;

    private async Task LoadTurnoverRowsAsync(int dealerId)
    {
        _turnoverLoading = true;
        _turnoverRows = new();
        _turnoverFYIds = new();

        if (_creditProposal != null)
        {
            var fyIds = new[] { _creditProposal.FY1, _creditProposal.FY2, _creditProposal.FY3 }
                .Where(id => id > 0)
                .Distinct()
                .ToList();
            _turnoverFYIds = fyIds;
        }

        if (_turnoverFYIds.Count == 0)
        {
            var fallback = GetReviewFinancialYears();
            _turnoverFYIds = fallback.Select(f => f.Id).ToList();
        }

        try
        {
            if (_turnoverFYIds.Count == 0)
            {
                _turnoverLoading = false;
                return;
            }

            var summary = await Http.GetFromJsonAsync<DealerSalesSummaryDto>(
                $"api/creditlimitsales/dealer-sales-summary/{dealerId}");

            if (summary?.ProductSales == null || summary.ProductSales.Count == 0)
            {
                _turnoverLoading = false;
                return;
            }

            var grouped = summary.ProductSales
                .GroupBy(p => p.ProductId)
                .ToList();

            foreach (var group in grouped.OrderBy(g => g.FirstOrDefault()?.ProductName))
            {
                var row = new TurnoverSalesRow
                {
                    ProductId = group.Key,
                    ProductName = group.FirstOrDefault()?.ProductName ?? GetProductName(group.Key),
                    Qty = new decimal?[_turnoverFYIds.Count]
                };

                for (int i = 0; i < _turnoverFYIds.Count; i++)
                {
                    var fyId = _turnoverFYIds[i];
                    var match = group.FirstOrDefault(p => p.FinancialYearId == fyId);
                    if (match != null)
                        row.Qty![i] = match.Quantity;
                }

                _turnoverRows.Add(row);
            }
        }
        catch { }
        finally
        {
            _turnoverLoading = false;
        }
    }

    private List<FinancialYear> GetReviewFinancialYears()
    {
        var today = DateTime.Today;
        int currentFyStartYear = today.Month >= 4 ? today.Year : today.Year - 1;

        var wantedStartYears = new[]
        {
            currentFyStartYear - 3,
            currentFyStartYear - 2,
            currentFyStartYear - 1
        };

        var matched = _financialYears
            .Where(fy => wantedStartYears.Contains(GetFyStartYear(fy)))
            .OrderBy(fy => GetFyStartYear(fy))
            .ToList();

        if (matched.Count == 0)
        {
            matched = _financialYears
                .OrderByDescending(fy => fy.EndDate)
                .ThenByDescending(fy => fy.Id)
                .Take(3)
                .OrderBy(fy => fy.EndDate)
                .ThenBy(fy => fy.Id)
                .ToList();
        }

        return matched;
    }

    private int GetFyStartYear(FinancialYear fy)
    {
        if (fy.StartDate != default && fy.StartDate.Year > 1)
            return fy.StartDate.Year;

        if (!string.IsNullOrWhiteSpace(fy.Name))
        {
            var m = System.Text.RegularExpressions.Regex.Match(fy.Name, @"(\d{4})");
            if (m.Success && int.TryParse(m.Groups[1].Value, out var y))
                return y;
        }

        if (fy.EndDate != default && fy.EndDate.Year > 1)
            return fy.EndDate.Year - 1;

        return 0;
    }

    private string GetTurnoverFYName(int index)
    {
        if (index < 0 || index >= _turnoverFYIds.Count) return "—";
        var fyId = _turnoverFYIds[index];
        return _financialYears.FirstOrDefault(f => f.Id == fyId)?.Name ?? $"FY {index + 1}";
    }

    private static string QtyOrDash(decimal? value) => value.HasValue ? value.Value.ToString("N2") : "—";

    private string GrowthForRow(TurnoverSalesRow row)
    {
        if (row.Qty == null) return "—";
        return GrowthFromSeries(row.Qty);
    }

    private string GrowthForTotal(List<TurnoverSalesRow> rows)
    {
        if (_turnoverFYIds.Count < 2) return "—";
        var totals = new List<decimal?>();
        for (int i = 0; i < _turnoverFYIds.Count; i++)
            totals.Add(TotalForIndex(i, rows));
        return GrowthFromSeries(totals.ToArray());
    }

    private decimal? TotalForIndex(int index, List<TurnoverSalesRow> rows)
    {
        if (index < 0 || index >= _turnoverFYIds.Count) return null;
        decimal sum = 0m;
        var any = false;
        foreach (var row in rows)
        {
            if (row.Qty != null && row.Qty[index].HasValue)
            {
                sum += row.Qty[index]!.Value;
                any = true;
            }
        }
        return any ? sum : null;
    }

    private static string GrowthFromSeries(decimal?[] series)
    {
        var values = series.Where(v => v.HasValue).Select(v => v!.Value).ToList();
        if (values.Count < 2) return "—";

        var prev = values[values.Count - 2];
        var latest = values[values.Count - 1];
        if (prev == 0) return "—";

        var pct = (latest - prev) / prev * 100m;
        return pct >= 0 ? $"+{pct.ToString("N2")}%" : $"{pct.ToString("N2")}%";
    }

