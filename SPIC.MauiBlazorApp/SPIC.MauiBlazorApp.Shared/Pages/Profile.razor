        !string.IsNullOrWhiteSpace(p.GreenstarFDNumber) || p.GreenstarFDAmount != 0 ||
        !string.IsNullOrWhiteSpace(p.GreenstarBGNumber) || p.GreenstarBGAmount != 0 ||
        !string.IsNullOrWhiteSpace(p.GreenstarCollateralNumber) || p.GreenstarCollateralAmount != 0 ||
