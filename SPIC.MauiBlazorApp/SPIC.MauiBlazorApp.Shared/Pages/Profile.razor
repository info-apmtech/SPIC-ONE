    private async Task LoadEmployeeProfileAsync()
    {
        if (string.IsNullOrWhiteSpace(LoginState.UserId)) return;

        try
        {
            // The card is populated from api/Profile, which resolves the current
            // Employeelogin row with the same shared rule the JWT and the PUT use.
            // This page used to select the row itself from api/Employeelogin/all,
            // which (a) applied its own ordering and (b) only ever returned ACTIVE
            // rows, so for a user with a deactivated login the card went blank while
            // the API still resolved an inactive row. Driving both the card and the
            // Edit modal from this one response makes divergence impossible.
            var profile = await SafeGetAsync<ProfileDto>("api/Profile");
            if (profile == null || profile.EmployeeInformationId <= 0) return;

            _employeeLogin = new Employeelogin
            {
                Id = profile.LoginId,
                UserId = LoginState.UserId ?? string.Empty,
                EmployeeInformationID = profile.EmployeeInformationId,
                Role = profile.Role,
                ZoneId = profile.ZoneId,
                StateId = profile.StateId,
                RegionId = profile.RegionId,
                HeadquartersId = profile.HeadquartersId,
                IsActive = profile.IsActive
            };

            if (ProfileSaveDebug)
                Console.WriteLine($"Selected LoginId = {_employeeLogin.Id} " +
                                  $"(EmployeeInformationId={_employeeLogin.EmployeeInformationID}) " +
                                  $"- must equal the PROFILESAVE Resolved LoginId from the API");

            _employee = await SafeGetAsync<EmployeeInformation>($"api/EmployeeRegistration/{profile.EmployeeInformationId}");
            if (_employee == null) return;

            await LookupCache.EnsureLoadedAsync();
            _zones = (await SafeGetAsync<List<LocationItemDto>>("api/Zone/all")) ?? new();
        }
        catch { }
    }

    /// <summary>
    /// Loads the masters that back the edit dropdowns from the same APIs
    /// EmployeeRegistration uses. Zone/State/Region/Headquarter are deserialized
    /// into the real entities (not LocationItemDto) so the cascade can read both
    /// the parent foreign key and IsActive.
    /// </summary>
    private async Task LoadEditLookupsAsync()
    {
        // The same four lookup endpoints EmployeeRegistration loads in its
        // OnInitializedAsync, deserialised into the same LocationItemDto shape and
        // used as flat, unfiltered option lists.
        var zonesTask = SafeGetAsync<List<LocationItemDto>>("api/Zone/all");
        var statesTask = SafeGetAsync<List<LocationItemDto>>("api/State/all");
        var regionsTask = SafeGetAsync<List<LocationItemDto>>("api/Region/all");
        var hqsTask = SafeGetAsync<List<LocationItemDto>>("api/Headquarter/all");
        var desigTask = SafeGetAsync<List<DesignationEntity>>("api/Designation");

        await Task.WhenAll(zonesTask, statesTask, regionsTask, hqsTask, desigTask);

        _editZones = zonesTask.Result ?? new();
        _editStates = statesTask.Result ?? new();
        _editRegions = regionsTask.Result ?? new();
        _editHeadquarters = hqsTask.Result ?? new();
        _editDesignations = desigTask.Result ?? new();

        if (ProfileSaveDebug)
            Console.WriteLine($"[ProfileSave] lookups: zones={_editZones.Count} states={_editStates.Count} " +
                              $"regions={_editRegions.Count} hqs={_editHeadquarters.Count} designations={_editDesignations.Count}");
    }

    private async Task OpenEditModalAsync()
    {
        if (_isDealer) return;

        _showEditModal = true;
        _editFormError = null;
        _editFormLoadFailed = false;
        _isLoadingEditForm = true;
        _edit = new ProfileUpdateDto();

        await LoadEditLookupsAsync();

        // Prefill from the self-scoped API, so every dropdown binds to the current
        // stored value. The values are assigned straight onto the DTO and are never
        // filtered or cleared: EmployeeRegistration likewise populates vm.Login from
        // the stored row, and its selects are not allowed to reset a value.
        var profile = await SafeGetAsync<ProfileDto>("api/Profile");
        if (profile != null)
        {
            _edit = new ProfileUpdateDto
            {
                EmployeeCode = profile.EmployeeCode,
                Name = profile.Name,
                Email = profile.Email,
                PersonalPhoneNumber = profile.PersonalPhoneNumber,
                OfficialPhoneNumber = profile.OfficialPhoneNumber,
                Role = profile.Role,
                DesignationId = profile.DesignationId,
                ZoneId = profile.ZoneId,
                StateId = profile.StateId,
                RegionId = profile.RegionId,
                HeadquartersId = profile.HeadquartersId,
                IsActive = profile.IsActive
            };

            if (ProfileSaveDebug)
            {
                Console.WriteLine($"StateId = {_edit.StateId}");
                Console.WriteLine($"RegionId = {_edit.RegionId}");
                Console.WriteLine($"ZoneId = {_edit.ZoneId}");
                Console.WriteLine($"HeadquartersId = {_edit.HeadquartersId}");
                Console.WriteLine($"[ProfileSave] initial binding -> LoginId={profile.LoginId} " +
                                  $"State={_edit.StateId} Region={_edit.RegionId} " +
                                  $"Zone={_edit.ZoneId} Hq={_edit.HeadquartersId} " +
                                  $"DesignationId={_edit.DesignationId} Role={_edit.Role} IsActive={_edit.IsActive} " +
                                  $"| role={SelectedEditRole} " +
                                  $"| showsZone={NeedsZone(SelectedEditRole)} " +
                                  $"showsState={NeedsState(SelectedEditRole)} " +
                                  $"showsRegion={NeedsRegion(SelectedEditRole)} " +
                                  $"showsHq={NeedsHeadquarter(SelectedEditRole)}");
            }
        }
        else
        {
            // The client cannot know UserInfo.DesignationId (the page only ever
            // held the designation *name* from the JWT claim). Prefilling a guess
            // would silently clear the designation on save, so block the save
            // instead of risking a wrong write.
            _editFormLoadFailed = true;
            _editFormError = "Your details could not be loaded, so the form has been locked to avoid " +
                             "overwriting your Role, Designation, Location or Status. Please cancel and try again.";
        }

        _isLoadingEditForm = false;
        await InvokeAsync(StateHasChanged);
    }

    private void CloseEditModal()
    {
        if (_isSavingProfile) return;
        _showEditModal = false;
        _editFormError = null;
        _editFormLoadFailed = false;
    }

