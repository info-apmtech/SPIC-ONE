    private async Task SaveProfileAsync()
    {
        if (_isSavingProfile || _editFormLoadFailed) return;

        _isSavingProfile = true;
        _editFormError = null;

        try
        {
            DumpEditModel("before PUT");

            var outcome = await SafePutAsync("api/Profile", _edit);

            if (ProfileSaveDebug)
            {
                Console.WriteLine($"[ProfileSave] StatusCode={outcome.StatusCode} Success={outcome.Success}");
                Console.WriteLine($"[ProfileSave] RawBody={outcome.RawBody}");
                Console.WriteLine($"[ProfileSave] Error={outcome.Error}");
            }

            if (!outcome.Success)
            {
                _editFormError = outcome.Error ?? "Your profile could not be saved. Please try again.";
                return;
            }

            _showEditModal = false;

            if (outcome.Payload?.RequiresReauthentication == true)
            {
                // Role / Designation / location / Status changed, so the current
                // JWT claims, RoleAccess -> AllowedPages and designation name are
                // stale. Drop the session and force a fresh sign-in.
                Toast.Success("Profile updated successfully. Please sign in again to apply your new access.");
                await ForceReloginAsync();
                return;
            }

            Toast.Success("Profile updated successfully.");

            // Only the non security-scoped fields changed, so the token is still
            // valid — reload the display straight from the API.
            if (_isAdmin)
                await LoadAdminProfileAsync();
            else
                await LoadEmployeeProfileAsync();
        }
        catch (Exception)
        {
            _editFormError = "Your profile could not be saved. Please try again.";
        }
        finally
        {
            _isSavingProfile = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>
    /// Clears every trace of the current session and sends the user back to the
    /// login page. LoginState.Logout() drops the parsed claims, AllowedPages and
    /// the designation name; the session store purge stops MainLayout from
    /// restoring the stale token on reload.
    /// </summary>
    private async Task ForceReloginAsync()
    {
        await SessionStore.ClearAsync();
        LoginState.Expiration = default;
        LoginState.Logout();
        Nav.NavigateTo("/login", forceLoad: true);
    }

    private async Task<PutOutcome> SafePutAsync(string url, ProfileUpdateDto body)
    {
        try
        {
            var response = await Http.PutAsJsonAsync(url, body);
            var raw = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                var payload = string.IsNullOrWhiteSpace(raw)
                    ? new ProfileSaveResult()
                    : JsonSerializer.Deserialize<ProfileSaveResult>(raw, ProfileJsonOptions);

                return new PutOutcome
                {
                    Success = true,
                    StatusCode = (int)response.StatusCode,
                    RawBody = raw,
                    Payload = payload ?? new ProfileSaveResult()
                };
            }

            return new PutOutcome
            {
                Success = false,
                StatusCode = (int)response.StatusCode,
                RawBody = raw,
                Error = ExtractErrorMessage(raw)
                         ?? $"Your profile could not be saved. Please try again. (HTTP {(int)response.StatusCode})"
            };
        }
        catch (Exception ex)
        {
            return new PutOutcome
            {
                Success = false,
                StatusCode = 0,
                Error = $"Your profile could not be saved. Please try again. ({ex.GetType().Name}: {ex.Message})"
            };
        }
    }

    /// <summary>
    /// Pulls a human-readable error out of a failure body. Handles the
    /// { "message": "..." } shape returned by the ProfileController and the
    /// ValidationProblemDetails shape that [ApiController] produces for
    /// DataAnnotation failures, so a validation problem is never shown as a
    /// generic "could not save" message.
    /// </summary>
    private static string? ExtractErrorMessage(string raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return null;

        try
        {
            var api = JsonSerializer.Deserialize<ApiMessage>(raw, ProfileJsonOptions);
            if (!string.IsNullOrWhiteSpace(api?.Message)) return api!.Message;

            var problem = JsonSerializer.Deserialize<ValidationProblem>(raw, ProfileJsonOptions);
            if (problem?.Errors is { Count: > 0 })
            {
                var flattened = problem.Errors
                    .SelectMany(kv => kv.Value ?? Array.Empty<string>())
                    .Select(m => m?.Trim())
                    .Where(m => !string.IsNullOrWhiteSpace(m))
                    .Distinct()
                    .ToList();
                if (flattened.Count > 0) return string.Join(" ", flattened);
            }
        }
        catch (Exception)
        {
            // Fall through to the raw body below.
        }

        return raw.Length <= 300 ? raw : raw[..300];
    }

    private static readonly JsonSerializerOptions ProfileJsonOptions = new(JsonSerializerDefaults.Web);

    /// <summary>Full outcome of the PUT: success flag, status, raw body, payload.</summary>
    private sealed class PutOutcome
    {
        public bool Success { get; init; }
        public int StatusCode { get; init; }
        public string RawBody { get; init; } = "";
        public ProfileSaveResult? Payload { get; init; }
        public string? Error { get; init; }
    }

