        {
            0 => ("dp-pill-draft", "Draft"),
            1 => ("dp-pill-submitted", "Submitted"),
            2 => ("dp-pill-submitted", "MO Review"),
            3 => ("dp-pill-submitted", "RM Review"),
            4 => ("dp-pill-submitted", "SMM Review"),
            5 => ("dp-pill-approved", "Approved"),
            6 => ("dp-pill-rejected", "Rejected"),
            7 => ("dp-pill-draft", "Cancelled"),
            8 => ("dp-pill-submitted", "SDWA Review"),
            9 => ("dp-pill-rejected", "Returned"),
            10 => ("dp-pill-submitted", "SDWA Admin Review"),
            _ => ("dp-pill-draft", "Unknown")
