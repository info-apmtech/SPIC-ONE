        p.SpicExistingCreditLimitAmount != 0 ||
        p.AdditionalCreditLimit != 0 ||
        p.Q11Mark > 0 ||
        p.SpicMonthlyAvgNetOverdues.HasValue ||
        !string.IsNullOrWhiteSpace(p.SpicFDNumber) || p.SpicFDAmount != 0 ||
        !string.IsNullOrWhiteSpace(p.SpicBGNumber) || p.SpicBGAmount != 0 ||
        !string.IsNullOrWhiteSpace(p.SpicCollateralNumber) || p.SpicCollateralAmount != 0 ||
        !string.IsNullOrWhiteSpace(p.SpicTradeDepositNumber) || p.SpicTradeDepositAmount != 0;

