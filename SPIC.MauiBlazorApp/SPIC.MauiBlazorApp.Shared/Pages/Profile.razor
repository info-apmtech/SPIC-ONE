    private async Task LoadTurnoverRowsAsync(int dealerId)
    {
        _turnoverLoading = true;
        _turnoverRows = new();
        _turnoverFYIds = new();

        if (_creditProposal != null)
        {
            var fyIds = new[] { _creditProposal.FY1, _creditProposal.FY2, _creditProposal.FY3 }
                .Where(id => id > 0)
                .Distinct()
                .ToList();
            _turnoverFYIds = fyIds;
        }

        if (_turnoverFYIds.Count == 0)
        {
            var fallback = GetReviewFinancialYears();
            _turnoverFYIds = fallback.Select(f => f.Id).ToList();
        }

        try
        {
            if (_turnoverFYIds.Count == 0)
            {
                _turnoverLoading = false;
                return;
            }

            var summary = await Http.GetFromJsonAsync<DealerSalesSummaryDto>(
                $"api/creditlimitsales/dealer-sales-summary/{dealerId}");

            if (summary?.ProductSales == null || summary.ProductSales.Count == 0)
            {
                _turnoverLoading = false;
                return;
            }

            var grouped = summary.ProductSales
                .GroupBy(p => p.ProductId)
                .ToList();

            foreach (var group in grouped.OrderBy(g => g.FirstOrDefault()?.ProductName))
            {
                var row = new TurnoverSalesRow
                {
                    ProductId = group.Key,
                    ProductName = group.FirstOrDefault()?.ProductName ?? GetProductName(group.Key),
                    Qty = new decimal?[_turnoverFYIds.Count]
                };

                for (int i = 0; i < _turnoverFYIds.Count; i++)
                {
                    var fyId = _turnoverFYIds[i];
                    var match = group.FirstOrDefault(p => p.FinancialYearId == fyId);
                    if (match != null)
                        row.Qty![i] = match.Quantity;
                }

                _turnoverRows.Add(row);
            }
        }
        catch { }
        finally
        {
            _turnoverLoading = false;
        }
    }

    private List<FinancialYear> GetReviewFinancialYears()
    {
        var today = DateTime.Today;
        int currentFyStartYear = today.Month >= 4 ? today.Year : today.Year - 1;

        var wantedStartYears = new[]
        {
            currentFyStartYear - 3,
            currentFyStartYear - 2,
            currentFyStartYear - 1
        };

        var matched = _financialYears
            .Where(fy => wantedStartYears.Contains(GetFyStartYear(fy)))
            .OrderBy(fy => GetFyStartYear(fy))
            .ToList();

        if (matched.Count == 0)
        {
            matched = _financialYears
                .OrderByDescending(fy => fy.EndDate)
                .ThenByDescending(fy => fy.Id)
                .Take(3)
                .OrderBy(fy => fy.EndDate)
                .ThenBy(fy => fy.Id)
                .ToList();
        }

        return matched;
    }

    private int GetFyStartYear(FinancialYear fy)
    {
        if (fy.StartDate != default && fy.StartDate.Year > 1)
            return fy.StartDate.Year;

        if (!string.IsNullOrWhiteSpace(fy.Name))
        {
            var m = System.Text.RegularExpressions.Regex.Match(fy.Name, @"(\d{4})");
            if (m.Success && int.TryParse(m.Groups[1].Value, out var y))
                return y;
        }

        if (fy.EndDate != default && fy.EndDate.Year > 1)
            return fy.EndDate.Year - 1;

        return 0;
    }

    private string GetTurnoverFYName(int index)
    {
        if (index < 0 || index >= _turnoverFYIds.Count) return "—";
        var fyId = _turnoverFYIds[index];
        return _financialYears.FirstOrDefault(f => f.Id == fyId)?.Name ?? $"FY {index + 1}";
    }

    private static string QtyOrDash(decimal? value) => value.HasValue ? value.Value.ToString("N2") : "—";

    private string GrowthForRow(TurnoverSalesRow row)
    {
        if (row.Qty == null) return "—";
        return GrowthFromSeries(row.Qty);
    }

    private string GrowthForTotal(List<TurnoverSalesRow> rows)
    {
        if (_turnoverFYIds.Count < 2) return "—";
        var totals = new List<decimal?>();
        for (int i = 0; i < _turnoverFYIds.Count; i++)
            totals.Add(TotalForIndex(i, rows));
        return GrowthFromSeries(totals.ToArray());
    }

    private decimal? TotalForIndex(int index, List<TurnoverSalesRow> rows)
    {
        if (index < 0 || index >= _turnoverFYIds.Count) return null;
        decimal sum = 0m;
        var any = false;
        foreach (var row in rows)
        {
            if (row.Qty != null && row.Qty[index].HasValue)
            {
                sum += row.Qty[index]!.Value;
                any = true;
            }
        }
        return any ? sum : null;
    }

    private static string GrowthFromSeries(decimal?[] series)
    {
        var values = series.Where(v => v.HasValue).Select(v => v!.Value).ToList();
        if (values.Count < 2) return "—";

        var prev = values[values.Count - 2];
        var latest = values[values.Count - 1];
        if (prev == 0) return "—";

        var pct = (latest - prev) / prev * 100m;
        return pct >= 0 ? $"+{pct.ToString("N2")}%" : $"{pct.ToString("N2")}%";
    }

    private async Task LoadEmployeeProfileAsync()
    {
        if (string.IsNullOrWhiteSpace(LoginState.UserId)) return;

        try
        {
            var logins = await Http.GetFromJsonAsync<List<Employeelogin>>("api/Employeelogin/all");
            _employeeLogin = logins?.FirstOrDefault(l => l.UserId == LoginState.UserId);

            if (_employeeLogin == null || _employeeLogin.EmployeeInformationID <= 0) return;

            _employee = await SafeGetAsync<EmployeeInformation>($"api/EmployeeRegistration/{_employeeLogin.EmployeeInformationID}");
            if (_employee == null) return;

            await LookupCache.EnsureLoadedAsync();
            _zones = (await SafeGetAsync<List<ZoneItemDto>>("api/Zone/all")) ?? new();
        }
        catch { }
    }

