                    @(IsEditMode ? "Update Employee" : "Save Employee") <i class="bi bi-floppy"></i>
                </button>
            }
        </ChildContent>
    </ActionBar>
</div>

@code {
    private string ErrorMessage { get; set; } = string.Empty;
    private string SelectedRole => vm.Login.Role.ToString();
    private readonly Dictionary<string, string> _fieldErrors = new(StringComparer.OrdinalIgnoreCase);

    private string FieldError(string key) =>
        _fieldErrors.TryGetValue(key, out var message) ? message : string.Empty;

    private SPIC.Core.Entities.Designation? SelectedDesignation =>
        Designations.FirstOrDefault(d => d.Id == vm.SelectedDesignationId);

    private EmployeeRegistrationVM vm = new();
    private List<LocationItemDto> Zones = new();
    private List<LocationItemDto> States = new();
    private List<LocationItemDto> Regions = new();
    private List<LocationItemDto> Headquarters = new();
    private List<SPIC.Core.Entities.Designation> Designations = new();

    private bool IsEditMode = false;
    private int EditingEmployeeId = 0;
    private int EditingLoginId = 0;
    private string OriginalUserName = string.Empty;
    private string UserNameError = string.Empty;

    private void OnUserNameInput(ChangeEventArgs e)
    {
        vm.Account.UserName = e.Value?.ToString() ?? string.Empty;
        ValidateUserName();
    }

    private bool ValidateUserName()
    {
        UserNameError = string.Empty;
        
        // Skip validation if editing and username is unchanged
        if (IsEditMode && vm.Account.UserName == OriginalUserName)
            return true;

        if (string.IsNullOrWhiteSpace(vm.Account.UserName) || !System.Text.RegularExpressions.Regex.IsMatch(vm.Account.UserName, @"\A[\x21-\x7E]+\z"))
        {
            UserNameError = "Username must not contain spaces or invisible characters.";
            return false;
        }
        return true;
    }

    private void OnRoleChanged()
    {
        _fieldErrors.Clear();
        SanitizeGeographyForRole();
    }

    private void OnDesignationChanged()
    {
        _fieldErrors.Clear();
        SanitizeGeographyForRole();
    }

    // Keeps geography values aligned with the selected role. Hidden dropdown values
    // from a previous role must never be saved and accidentally widen data scope.
    private void SanitizeGeographyForRole()
    {
        switch (vm.Login.Role)
        {
            case AppRole.AVP:
                vm.Login.StateId = 0;
                vm.Login.RegionId = 0;
                vm.Login.HeadquartersId = 0;
                SelectedMultiRegions.Clear();
                SelectedMultiHeadquarters.Clear();
                break;

            case AppRole.SMD:
            case AppRole.SMM:
            case AppRole.MDAdmin:
            case AppRole.MDHOD:
                vm.Login.ZoneId = 0;
                vm.Login.RegionId = 0;
                vm.Login.HeadquartersId = 0;
                SelectedMultiRegions.Clear();
                SelectedMultiHeadquarters.Clear();
                break;

            case AppRole.RM:
            case AppRole.RMD:
                vm.Login.ZoneId = 0;
                vm.Login.HeadquartersId = 0;
                SelectedMultiHeadquarters.Clear();
                break;

            case AppRole.MO:
            case AppRole.MDO:
            case AppRole.JMDO:
                vm.Login.ZoneId = 0;
                SelectedMultiRegions.Clear();
                break;

            case AppRole.CommonRole:
                break;

            case AppRole.SpecialAdmin:
                SelectedMultiRegions.Clear();
                SelectedMultiHeadquarters.Clear();
                break;

            default:
                vm.Login.ZoneId = 0;
                vm.Login.StateId = 0;
                vm.Login.RegionId = 0;
                vm.Login.HeadquartersId = 0;
                SelectedMultiRegions.Clear();
                SelectedMultiHeadquarters.Clear();
                break;
        }
    }

    private bool ValidateEmployeeForm()
    {
        _fieldErrors.Clear();
        UserNameError = string.Empty;

        if (!AllowedRoles.Contains(vm.Login.Role))
            _fieldErrors["Role"] = "Select a role.";

        if (vm.Login.Role == AppRole.CommonRole)
        {
            if (vm.SelectedDesignationId <= 0)
                _fieldErrors["DesignationId"] = "Select a designation for CommonRole.";
            else if (SelectedDesignation == null)
                _fieldErrors["DesignationId"] = "The selected designation is not active.";
        }

        if (!ValidateUserName())
            _fieldErrors["UserName"] = UserNameError;

        if (!IsEditMode && string.IsNullOrWhiteSpace(vm.Account.Password))
            _fieldErrors["Password"] = "Password is required.";

        if (string.IsNullOrWhiteSpace(vm.Employee.Name))
            _fieldErrors["Name"] = "Employee Name is required.";

        if (string.IsNullOrWhiteSpace(vm.Employee.EmployeeCode))
            _fieldErrors["EmployeeCode"] = "Employee ID is required.";

        var personalPhone = (vm.Employee.PersonalPhoneNumber ?? string.Empty).Trim();
        if (personalPhone.Length == 0)
            _fieldErrors["PersonalPhoneNumber"] = "Personal Phone Number is required.";
        else if (!Regex.IsMatch(personalPhone, @"^\d{10}$"))
            _fieldErrors["PersonalPhoneNumber"] = "Personal Phone Number must be 10 digits.";

        var email = (vm.Employee.Email ?? string.Empty).Trim();
        if (email.Length == 0)
            _fieldErrors["Email"] = "Email ID is required.";
        else if (!Regex.IsMatch(email, @"^[^@\s]+@[^@\s]+\.[^@\s]+$"))
            _fieldErrors["Email"] = "Enter a valid Email ID.";

        switch (vm.Login.Role)
        {
            case AppRole.AVP:
                if (vm.Login.ZoneId <= 0)
                    _fieldErrors["ZoneId"] = "Zone is required.";
                break;

            case AppRole.SMD:
            case AppRole.SMM:
            case AppRole.MDAdmin:
            case AppRole.MDHOD:
                if (vm.Login.StateId <= 0)
                    _fieldErrors["StateId"] = "State is required.";
                break;

            case AppRole.RM:
            case AppRole.RMD:
                if (vm.Login.StateId <= 0)
                    _fieldErrors["StateId"] = "State is required.";
                if (SelectedMultiRegions.Count == 0 && vm.Login.RegionId <= 0)
                    _fieldErrors["RegionId"] = "Region is required.";
                break;

            case AppRole.MO:
            case AppRole.MDO:
            case AppRole.JMDO:
                if (vm.Login.StateId <= 0)
                    _fieldErrors["StateId"] = "State is required.";
                if (vm.Login.RegionId <= 0)
                    _fieldErrors["RegionId"] = "Region is required.";
                if (SelectedMultiHeadquarters.Count == 0 && vm.Login.HeadquartersId <= 0)
                    _fieldErrors["HeadquartersId"] = "Headquarters is required.";
                break;

            case AppRole.CommonRole:
                ValidateCommonRoleGeographySelection();
                break;
        }

        if (_fieldErrors.Count == 0)
            return true;

        ErrorMessage = "Please correct the highlighted fields and try again.";
        return false;
    }

    // CommonRole geography is optional, but any supplied combination must be
    // internally consistent. Lower-level selections do not require a parent.
    private void ValidateCommonRoleGeographySelection()
    {
        var state = vm.Login.StateId > 0
            ? States.FirstOrDefault(s => s.Id == vm.Login.StateId)
            : null;

        var checkRegionIds = SelectedMultiRegions.Count > 0
            ? SelectedMultiRegions
            : (vm.Login.RegionId > 0 ? new HashSet<int> { vm.Login.RegionId } : new HashSet<int>());

        var checkHqIds = SelectedMultiHeadquarters.Count > 0
            ? SelectedMultiHeadquarters
            : (vm.Login.HeadquartersId > 0 ? new HashSet<int> { vm.Login.HeadquartersId } : new HashSet<int>());

        if (state != null && checkRegionIds.Count > 0)
        {
            foreach (var rId in checkRegionIds)
            {
                var r = Regions.FirstOrDefault(x => x.Id == rId);
                if (r != null && r.StateId != state.Id)
                {
                    _fieldErrors["RegionId"] = "Selected Region does not belong to the selected State.";
                    break;
                }
            }
        }

        if (checkRegionIds.Count > 0 && checkHqIds.Count > 0)
        {
            foreach (var hId in checkHqIds)
            {
                var h = Headquarters.FirstOrDefault(x => x.Id == hId);
                if (h != null && !checkRegionIds.Contains(h.RegionId))
                {
                    _fieldErrors["HeadquartersId"] = "Selected Headquarters does not belong to the selected Region.";
                    break;
                }
            }
        }
        else if (state != null && checkHqIds.Count > 0)
        {
            foreach (var hId in checkHqIds)
            {
                var h = Headquarters.FirstOrDefault(x => x.Id == hId);
                var hr = h != null ? Regions.FirstOrDefault(x => x.Id == h.RegionId) : null;
                if (hr != null && hr.StateId != state.Id)
                {
                    _fieldErrors["HeadquartersId"] = "Selected Headquarters does not belong to the selected State.";
                    break;
                }
            }
        }

        if (vm.Login.ZoneId > 0)
        {
            var selectedZoneId = vm.Login.ZoneId;
            if (state != null && state.ZoneId > 0 && state.ZoneId != selectedZoneId)
                _fieldErrors["StateId"] = "Selected State does not belong to the selected Zone.";

            if (state == null && checkRegionIds.Count > 0)
            {
                foreach (var rId in checkRegionIds)
                {
                    var r = Regions.FirstOrDefault(x => x.Id == rId);
                    var rs = r != null ? States.FirstOrDefault(x => x.Id == r.StateId) : null;
                    if (rs != null && rs.ZoneId > 0 && rs.ZoneId != selectedZoneId)
                    {
                        _fieldErrors["RegionId"] = "Selected Region does not belong to the selected Zone.";
                        break;
                    }
                }
            }

            if (state == null && checkRegionIds.Count == 0 && checkHqIds.Count > 0)
            {
                foreach (var hId in checkHqIds)
                {
                    var h = Headquarters.FirstOrDefault(x => x.Id == hId);
                    var hr = h != null ? Regions.FirstOrDefault(x => x.Id == h.RegionId) : null;
                    var hs = hr != null ? States.FirstOrDefault(x => x.Id == hr.StateId) : null;
                    if (hs != null && hs.ZoneId > 0 && hs.ZoneId != selectedZoneId)
                    {
                        _fieldErrors["HeadquartersId"] = "Selected Headquarters does not belong to the selected Zone.";
                        break;
                    }
                }
            }
        }
    }

    // Multi-Region & Multi-HQ selection state for standard roles and CommonRole
    private HashSet<int> SelectedMultiRegions = new();
    private HashSet<int> SelectedMultiHeadquarters = new();
    private bool IsMultiRegionOpen = false;
    private bool IsMultiHqOpen = false;
    private string MultiRegionSearch = "";
    private string MultiHqSearch = "";

    private void ToggleMultiRegionDropdown()
    {
        IsMultiRegionOpen = !IsMultiRegionOpen;
        if (!IsMultiRegionOpen) MultiRegionSearch = "";
    }

    private void ToggleMultiHqDropdown()
    {
        IsMultiHqOpen = !IsMultiHqOpen;
        if (!IsMultiHqOpen) MultiHqSearch = "";
    }

    private void CloseMultiDropdowns()
    {
        IsMultiRegionOpen = false;
        IsMultiHqOpen = false;
        MultiRegionSearch = "";
        MultiHqSearch = "";
    }

    private IEnumerable<LocationItemDto> AvailableMultiRegions
    {
        get
        {
            if (SelectedRole is "RM" or "RMD")
                return vm.Login.StateId > 0 ? Regions.Where(r => r.StateId == vm.Login.StateId) : Regions;
            if (SelectedRole == "CommonRole")
            {
                if (vm.Login.StateId > 0)
                    return Regions.Where(r => r.StateId == vm.Login.StateId);
                if (vm.Login.ZoneId > 0)
                {
                    var zoneStateIds = States.Where(s => s.ZoneId == vm.Login.ZoneId).Select(s => s.Id).ToHashSet();
                    return Regions.Where(r => zoneStateIds.Contains(r.StateId));
                }
                return Regions;
            }
            return Regions;
        }
    }

    private IEnumerable<LocationItemDto> FilteredMultiRegions =>
        string.IsNullOrWhiteSpace(MultiRegionSearch)
            ? AvailableMultiRegions
            : AvailableMultiRegions.Where(r => r.Name.Contains(MultiRegionSearch, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<LocationItemDto> AvailableMultiHeadquarters
    {
        get
        {
            if (SelectedRole is "MO" or "MDO" or "JMDO")
                return vm.Login.RegionId > 0 ? Headquarters.Where(h => h.RegionId == vm.Login.RegionId) : Headquarters;
            if (SelectedRole == "CommonRole")
            {
                if (SelectedMultiRegions.Count > 0)
                    return Headquarters.Where(h => SelectedMultiRegions.Contains(h.RegionId));
                if (vm.Login.StateId > 0)
                {
                    var stateRegionIds = Regions.Where(r => r.StateId == vm.Login.StateId).Select(r => r.Id).ToHashSet();
                    return Headquarters.Where(h => stateRegionIds.Contains(h.RegionId));
                }
                if (vm.Login.ZoneId > 0)
                {
                    var zoneStateIds = States.Where(s => s.ZoneId == vm.Login.ZoneId).Select(s => s.Id).ToHashSet();
                    var zoneRegionIds = Regions.Where(r => zoneStateIds.Contains(r.StateId)).Select(r => r.Id).ToHashSet();
                    return Headquarters.Where(h => zoneRegionIds.Contains(h.RegionId));
                }
                return Headquarters;
            }
            return Headquarters;
        }
    }

    private IEnumerable<LocationItemDto> FilteredMultiHeadquarters =>
        string.IsNullOrWhiteSpace(MultiHqSearch)
            ? AvailableMultiHeadquarters
            : AvailableMultiHeadquarters.Where(h => h.Name.Contains(MultiHqSearch, StringComparison.OrdinalIgnoreCase));

    private void ClearMultiRegions()
    {
        SelectedMultiRegions.Clear();
        if (SelectedRole == "CommonRole")
            PurgeOrphanedMultiHqs();
    }

    private void ClearMultiHqs()
    {
        SelectedMultiHeadquarters.Clear();
    }

    private void SelectAllMultiRegions()
    {
        foreach (var r in AvailableMultiRegions)
            SelectedMultiRegions.Add(r.Id);
    }

    private void SelectAllMultiHqs()
    {
        foreach (var h in AvailableMultiHeadquarters)
            SelectedMultiHeadquarters.Add(h.Id);
    }

    private void ToggleMultiRegion(int regionId, bool isSelected)
    {
        if (isSelected)
            SelectedMultiRegions.Add(regionId);
        else
        {
            SelectedMultiRegions.Remove(regionId);
            if (SelectedRole == "CommonRole")
                PurgeOrphanedMultiHqs();
        }
    }

    private void ToggleMultiHq(int hqId, bool isSelected)
    {
        if (isSelected)
            SelectedMultiHeadquarters.Add(hqId);
        else
            SelectedMultiHeadquarters.Remove(hqId);
    }

    private void PurgeOrphanedMultiHqs()
    {
        if (SelectedMultiRegions.Count > 0)
        {
            var validHqIds = Headquarters.Where(h => SelectedMultiRegions.Contains(h.RegionId)).Select(h => h.Id).ToHashSet();
            SelectedMultiHeadquarters.RemoveWhere(h => !validHqIds.Contains(h));
        }
    }

    private void OnStateChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var sid))
        {
            vm.Login.StateId = sid;
            if (sid > 0)
            {
                var validRegionIds = Regions.Where(r => r.StateId == sid).Select(r => r.Id).ToHashSet();
                SelectedMultiRegions.RemoveWhere(r => !validRegionIds.Contains(r));
                if (vm.Login.RegionId > 0 && !validRegionIds.Contains(vm.Login.RegionId))
                {
                    vm.Login.RegionId = 0;
                    SelectedMultiHeadquarters.Clear();
                }
            }
            PurgeOrphanedMultiHqs();
        }
    }

    private void OnRegionChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var rid))
        {
            vm.Login.RegionId = rid;
            if (rid > 0)
            {
                var validHqIds = Headquarters.Where(h => h.RegionId == rid).Select(h => h.Id).ToHashSet();
                SelectedMultiHeadquarters.RemoveWhere(h => !validHqIds.Contains(h));
            }
            else
            {
                SelectedMultiHeadquarters.Clear();
            }
        }
    }

    private void OnZoneChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var zid))
        {
            vm.Login.ZoneId = zid;
            if (zid > 0 && vm.Login.StateId > 0)
            {
                var state = States.FirstOrDefault(s => s.Id == vm.Login.StateId);
                if (state != null && state.ZoneId != zid)
                {
                    vm.Login.StateId = 0;
                    SelectedMultiRegions.Clear();
                    SelectedMultiHeadquarters.Clear();
                }
            }
        }
    }

    // SpecialAdmin multi-location selection state
    private HashSet<int> SelectedSpecialStates = new();
    private HashSet<int> SelectedSpecialRegions = new();
    private HashSet<int> SelectedSpecialHQs = new();
    private List<LocationItemDto> AvailableSpecialRegions = new();
    private List<LocationItemDto> AvailableSpecialHeadquarters = new();

    // Full-access intent: set ONLY by an explicit "Select All" action (or restored
    // from a compact row when editing). A State in SpecialFullAccessStates saves as
    // {State,0,0} (State -> All Regions -> All HQs); a Region in
    // SpecialFullAccessRegions saves as {State,Region,0} (Region -> All HQs).
    // Merely selecting a State/Region/RQ never adds these, so no access is granted
    // beyond what the user explicitly narrowed.
    private HashSet<int> SpecialFullAccessStates = new();
    private HashSet<int> SpecialFullAccessRegions = new();

    // SpecialAdmin multi-select dropdown open/close state
    private bool IsSpecialStateOpen = false;
    private bool IsSpecialRegionOpen = false;
    private bool IsSpecialHqOpen = false;

    // SpecialAdmin search queries (filters only the already-loaded options)
    private string SpecialStateSearch = "";
    private string SpecialRegionSearch = "";
    private string SpecialHqSearch = "";

    private static readonly AppRole[] AllowedRoles = new[]
    {
        AppRole.CorporateAdmin,
        AppRole.Director,
        AppRole.AVP,
        AppRole.SMD,
        AppRole.SMM,
        AppRole.RM,
        AppRole.RMD,
        AppRole.MDO,
        AppRole.MO,
        AppRole.JMDO,
        AppRole.SpecialAdmin,
        AppRole.CommonRole,
        AppRole.MDAdmin,
        AppRole.MDHOD
    };

    protected override async Task OnInitializedAsync()
    {
        Zones = await Http.GetFromJsonAsync<List<LocationItemDto>>("api/Zone/all") ?? new();
        States = await Http.GetFromJsonAsync<List<LocationItemDto>>("api/State/all") ?? new();
        Regions = await Http.GetFromJsonAsync<List<LocationItemDto>>("api/Region/all") ?? new();
        Headquarters = await Http.GetFromJsonAsync<List<LocationItemDto>>("api/Headquarter/all") ?? new();

        try
        {
            Designations = await Http.GetFromJsonAsync<List<SPIC.Core.Entities.Designation>>("api/Designation") ?? new();
        }
        catch
        {
            Designations = new();
        }

        var uri = new Uri(Nav.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var editLoginIdValue = query["editLoginId"];

        if (int.TryParse(editLoginIdValue, out var loginId))
        {
            await LoadForEdit(loginId);
        }
    }

    private async Task SaveEmployee()
    {
        ErrorMessage = string.Empty;

        if (!ValidateEmployeeForm())
        {
            await ScrollToErrorAsync();
            return;
        }

        try
        {
            Loading.Show();

            // Never persist values belonging to a role/designation the user moved away from.
            SanitizeGeographyForRole();

            var currentUser = LoginState.UserId ?? "System";
            vm.Employee.CreatedBy ??= currentUser;
            vm.Employee.UpdatedBy = currentUser;

            // 0 in the dropdown means "no designation" -> send null to backend
            int? designationId = vm.SelectedDesignationId > 0 ? vm.SelectedDesignationId : null;

            var specialLocations = BuildSpecialAdminLocations();

            // SpecialAdmin validation: at least one state required, and every state
            // must narrow SOMETHING (selecting a State alone grants nothing now).
            if (vm.Login.Role == AppRole.SpecialAdmin)
            {
                if (SelectedSpecialStates.Count == 0)
                    throw new Exception("At least one State is required for SpecialAdmin.");

                foreach (var stateId in SelectedSpecialStates)
                {
                    if (SpecialFullAccessStates.Contains(stateId))
                        continue;
                    var hasCoverage = AvailableSpecialRegions
                        .Where(r => r.StateId == stateId && SelectedSpecialRegions.Contains(r.Id))
                        .Any(r => SpecialFullAccessRegions.Contains(r.Id) ||
                                  AvailableSpecialHeadquarters.Any(h => h.RegionId == r.Id && SelectedSpecialHQs.Contains(h.Id)));
                    if (!hasCoverage)
                    {
                        var stateName = States.FirstOrDefault(s => s.Id == stateId)?.StateName ?? $"State {stateId}";
                        throw new Exception($"For {stateName}, select at least one Region + one Headquarters, or use \"Select All Regions\" / \"Select All Headquarters\" to grant access.");
                    }
                }
            }

            if (!IsEditMode)
            {
                var empResponse = await Http.PostAsJsonAsync("api/EmployeeRegistration", vm.Employee);

                if (!empResponse.IsSuccessStatusCode)
                {
                    var error = await empResponse.Content.ReadAsStringAsync();
                    PopulateFieldErrorsFromJson(error);
                    throw new ApiCallFailedException(ExtractErrorMessage(error, "Employee save failed."));
                }

                var empResult = await empResponse.Content.ReadFromJsonAsync<ApiResponse<EmployeeInformation>>();

                if (empResult?.data == null)
                    throw new ApiCallFailedException("Employee save failed: the server returned an unexpected response.");

                var regionIdsArray = SelectedRole switch
                {
                    "RM" or "RMD" or "CommonRole" => SelectedMultiRegions.ToArray(),
                    "MO" or "MDO" or "JMDO" => vm.Login.RegionId > 0 ? new[] { vm.Login.RegionId } : Array.Empty<int>(),
                    _ => Array.Empty<int>()
                };

                var hqIdsArray = SelectedRole switch
                {
                    "MO" or "MDO" or "JMDO" or "CommonRole" => SelectedMultiHeadquarters.ToArray(),
                    _ => Array.Empty<int>()
                };

                var primaryRegionId = SelectedRole switch
                {
                    "RM" or "RMD" or "CommonRole" => SelectedMultiRegions.FirstOrDefault(),
                    _ => vm.Login.RegionId
                };

                var primaryHqId = SelectedRole switch
                {
                    "MO" or "MDO" or "JMDO" or "CommonRole" => SelectedMultiHeadquarters.FirstOrDefault(),
                    _ => vm.Login.HeadquartersId
                };

                var loginRequest = new EmployeeLoginCreateRequest
                {
                    EmployeeInformationID = empResult.data.Id,
                    UserName = vm.Account.UserName,
                    Password = vm.Account.Password,
                    Email = vm.Employee.Email,
                    Name = vm.Employee.Name,
                    DesignationId = designationId,
                    Role = vm.Login.Role,
                    ZoneId = vm.Login.ZoneId,
                    StateId = vm.Login.StateId,
                    RegionId = primaryRegionId,
                    HeadquartersId = primaryHqId,
                    RegionIds = regionIdsArray,
                    HeadquartersIds = hqIdsArray,
                    IsActive = vm.Login.IsActive,
                    CreatedBy = currentUser,
                    UpdatedBy = currentUser,
                    SpecialAdminLocations = specialLocations
                };

                var loginResponse = await Http.PostAsJsonAsync("api/EmployeeLoginSetup", loginRequest);

                if (!loginResponse.IsSuccessStatusCode)
                {
                    // Clean up partial EmployeeInformation record when login creation fails
                    try
                    {
                        await Http.DeleteAsync($"api/EmployeeRegistration/{empResult.data.Id}");
                    }
                    catch { }

                    var error = await loginResponse.Content.ReadAsStringAsync();
                    PopulateFieldErrorsFromJson(error);
                    throw new ApiCallFailedException(ExtractErrorMessage(error, "Login save failed."));
                }
            }
            else
            {
                var employeeUpdateResponse = await Http.PutAsJsonAsync($"api/EmployeeRegistration/{EditingEmployeeId}", vm.Employee);

                if (!employeeUpdateResponse.IsSuccessStatusCode)
                {
                    var error = await employeeUpdateResponse.Content.ReadAsStringAsync();
                    PopulateFieldErrorsFromJson(error);
                    throw new ApiCallFailedException(ExtractErrorMessage(error, "Employee update failed."));
                }

                var regionIdsArray = SelectedRole switch
                {
                    "RM" or "RMD" or "CommonRole" => SelectedMultiRegions.ToArray(),
                    "MO" or "MDO" or "JMDO" => vm.Login.RegionId > 0 ? new[] { vm.Login.RegionId } : Array.Empty<int>(),
                    _ => Array.Empty<int>()
                };

                var hqIdsArray = SelectedRole switch
                {
                    "MO" or "MDO" or "JMDO" or "CommonRole" => SelectedMultiHeadquarters.ToArray(),
                    _ => Array.Empty<int>()
                };

                var primaryRegionId = SelectedRole switch
                {
                    "RM" or "RMD" or "CommonRole" => SelectedMultiRegions.FirstOrDefault(),
                    _ => vm.Login.RegionId
                };

                var primaryHqId = SelectedRole switch
                {
                    "MO" or "MDO" or "JMDO" or "CommonRole" => SelectedMultiHeadquarters.FirstOrDefault(),
                    _ => vm.Login.HeadquartersId
                };

                var loginRequest = new EmployeeLoginCreateRequest
                {
                    EmployeeInformationID = EditingEmployeeId,
                    UserName = vm.Account.UserName,
                    Password = vm.Account.Password,
                    Email = vm.Employee.Email,
                    Name = vm.Employee.Name,
                    DesignationId = designationId,
                    Role = vm.Login.Role,
                    ZoneId = vm.Login.ZoneId,
                    StateId = vm.Login.StateId,
                    RegionId = primaryRegionId,
                    HeadquartersId = primaryHqId,
                    RegionIds = regionIdsArray,
                    HeadquartersIds = hqIdsArray,
                    IsActive = vm.Login.IsActive,
                    UpdatedBy = currentUser,
                    SpecialAdminLocations = specialLocations
                };

                var loginUpdateResponse = await Http.PutAsJsonAsync($"api/EmployeeLoginSetup/login/{EditingLoginId}", loginRequest);
                if (!loginUpdateResponse.IsSuccessStatusCode)
                {
                    var error = await loginUpdateResponse.Content.ReadAsStringAsync();
                    PopulateFieldErrorsFromJson(error);
                    throw new ApiCallFailedException(ExtractErrorMessage(error, "Login update failed."));
                }
            }

            Nav.NavigateTo("/EmployeeManagement");
            return;
        }
        catch (ApiCallFailedException ex)
        {
            // The server already returned a clean, human-readable reason (password policy,
            // duplicate username, "EmployeeInformation not found", etc.) - show it as-is instead
            // of running it through the keyword-matching below, which only recognizes a few
            // hardcoded phrases and silently replaces anything else with a useless generic
            // message (this is exactly what hid a plain "Passwords must be at least 6
            // characters." error behind "contact support").
            Console.WriteLine($"Error in SaveEmployee: {ex.Message}");
            ErrorMessage = ex.Message;
            await ScrollToErrorAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in SaveEmployee: {ex.ToString()}");

            string msg = ex.Message.ToLower();

            if (msg.Contains("duplicate") || msg.Contains("already exist") || msg.Contains("unique"))
            {
                ErrorMessage = "A user or employee with these details already exists. Please check User Name, Employee ID, or Email.";
            }
            else if (ex.Message.Contains("At least one State is required for SpecialAdmin") ||
                     ex.Message.Contains("select at least one Region + one Headquarters"))
            {
                ErrorMessage = ex.Message;
            }
            else if (msg.Contains("validation") || msg.Contains("invalid") || msg.Contains("required"))
            {
                ErrorMessage = "Validation failed. Please ensure all required fields are correctly filled.";
                if (ex.Message.Length < 150 && !msg.Contains("sql") && !msg.Contains("database") && !msg.Contains("exception"))
                {
                    ErrorMessage = ex.Message;
                }
            }
            else
            {
                ErrorMessage = "An unexpected error occurred while saving. Please try again later or contact support.";
            }

            await ScrollToErrorAsync();
        }
        finally
        {
            Loading.Hide();
        }
    }

    // The error banner renders at the top of the page, but this form is long enough that the
    // Save button at the bottom is scrolled well out of view - without this, a failed save looked
    // like nothing happened at all unless the user scrolled up themselves.
    private async Task ScrollToErrorAsync()
    {
        try { await JS.InvokeVoidAsync("scrollPageToTop"); } catch (JSException) { }
    }

    // Marks a failed-HTTP-response error (already a clean, server-authored message) so the
    // catch block above can show it directly instead of running it through the generic
    // keyword-matching meant for genuinely unexpected .NET exceptions.
    private sealed class ApiCallFailedException : Exception
    {
        public ApiCallFailedException(string message) : base(message) { }
    }

    // Server error bodies come in three shapes depending on which BadRequest(...) overload the
    // controller used: a plain JSON string ("Username already exists"), a JSON array of strings
    // (identityResult.Errors.Select(x => x.Description) - e.g. password policy failures), or an
    // ASP.NET ValidationProblemDetails object (BadRequest(ModelState), with messages nested under
    // "errors"). Falls back to the raw body (or fallbackContext) if it's none of those - e.g. an
    // actual unhandled server exception, which won't be valid JSON at all.
    private static string ExtractErrorMessage(string rawBody, string fallbackContext)
    {
        if (string.IsNullOrWhiteSpace(rawBody)) return fallbackContext;

        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(rawBody);
            var root = doc.RootElement;

            if (root.ValueKind == System.Text.Json.JsonValueKind.String)
                return root.GetString() is { Length: > 0 } s ? s : fallbackContext;

            if (root.ValueKind == System.Text.Json.JsonValueKind.Array)
            {
                var messages = root.EnumerateArray()
                    .Select(e => e.ValueKind == System.Text.Json.JsonValueKind.String ? e.GetString() : null)
                    .Where(s => !string.IsNullOrWhiteSpace(s));
                var joined = string.Join(" ", messages);
                return joined.Length > 0 ? joined : fallbackContext;
            }

            if (root.ValueKind == System.Text.Json.JsonValueKind.Object && root.TryGetProperty("errors", out var errorsEl)
                && errorsEl.ValueKind == System.Text.Json.JsonValueKind.Object)
            {
                var messages = errorsEl.EnumerateObject()
                    .SelectMany(p => p.Value.ValueKind == System.Text.Json.JsonValueKind.Array
                        ? p.Value.EnumerateArray().Select(e => e.GetString())
                        : Enumerable.Empty<string?>())
                    .Where(s => !string.IsNullOrWhiteSpace(s));
                var joined = string.Join(" ", messages);
                return joined.Length > 0 ? joined : fallbackContext;
            }
        }
        catch (System.Text.Json.JsonException)
        {
            // Not JSON at all - most likely a raw ASP.NET exception page/stack trace from an
            // actual unhandled server error, not a clean validation message worth showing as-is.
        }

        return fallbackContext;
    }

    private void PopulateFieldErrorsFromJson(string rawBody)
    {
        if (string.IsNullOrWhiteSpace(rawBody)) return;
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(rawBody);
            var root = doc.RootElement;
            if (root.ValueKind == System.Text.Json.JsonValueKind.Object && root.TryGetProperty("errors", out var errorsEl)
                && errorsEl.ValueKind == System.Text.Json.JsonValueKind.Object)
            {
                foreach (var prop in errorsEl.EnumerateObject())
                {
                    if (prop.Value.ValueKind == System.Text.Json.JsonValueKind.Array)
                    {
                        var first = prop.Value.EnumerateArray().FirstOrDefault().GetString();
                        if (!string.IsNullOrWhiteSpace(first))
                            _fieldErrors[prop.Name] = first;
                    }
                    else if (prop.Value.ValueKind == System.Text.Json.JsonValueKind.String)
                    {
                        var msg = prop.Value.GetString();
                        if (!string.IsNullOrWhiteSpace(msg))
                            _fieldErrors[prop.Name] = msg;
                    }
                }
            }
        }
        catch { }
    }

    private async Task LoadForEdit(int loginId)
    {
        try
        {
            Loading.Show();

            // 1. Fetch the specific login first
            var loginData = await Http.GetFromJsonAsync<EmployeeLoginCreateRequest>($"api/EmployeeLoginSetup/by-login/{loginId}");

            if (loginData == null) throw new Exception("Unable to load login data");

            // 2. Fetch the shared employee info based on the ID inside the login data
            var employee = await Http.GetFromJsonAsync<EmployeeInformation>($"api/EmployeeRegistration/{loginData.EmployeeInformationID}");

            if (employee == null) throw new Exception("Unable to load employee data");

            vm.Employee = employee;
            vm.Login = new Employeelogin
            {
                EmployeeInformationID = employee.Id,
                Role = loginData.Role,
                ZoneId = loginData.ZoneId,
                StateId = loginData.StateId,
                RegionId = loginData.RegionId,
                HeadquartersId = loginData.HeadquartersId,
                RegionIds = loginData.RegionIds,
                HeadquartersIds = loginData.HeadquartersIds,
                IsActive = loginData.IsActive
            };

            SelectedMultiRegions.Clear();
            if (loginData.RegionIds != null && loginData.RegionIds.Length > 0)
            {
                foreach (var rId in loginData.RegionIds)
                    SelectedMultiRegions.Add(rId);
            }
            else if (loginData.RegionId > 0)
            {
                SelectedMultiRegions.Add(loginData.RegionId);
            }

            SelectedMultiHeadquarters.Clear();
            if (loginData.HeadquartersIds != null && loginData.HeadquartersIds.Length > 0)
            {
                foreach (var hId in loginData.HeadquartersIds)
                    SelectedMultiHeadquarters.Add(hId);
            }
            else if (loginData.HeadquartersId > 0)
            {
                SelectedMultiHeadquarters.Add(loginData.HeadquartersId);
            }

            vm.Account = new UserAccountVM
            {
                UserName = loginData.UserName,
                Password = loginData.Password
            };
            OriginalUserName = loginData.UserName;

            vm.SelectedDesignationId = loginData.DesignationId ?? 0;

            // SpecialAdmin: load multi-location assignments
            if (loginData.Role == AppRole.SpecialAdmin)
            {
                await LoadSpecialAdminForEdit(loginData.EmployeeInformationID, loginData.SpecialAdminLocations);
            }

            EditingEmployeeId = employee.Id;
            EditingLoginId = loginId;
            IsEditMode = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            Loading.Hide();
        }
    }
