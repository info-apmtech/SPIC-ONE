                       placeholder="Enter User Name">
                @if (!string.IsNullOrEmpty(UserNameError))
                {
                    <div class="text-danger small mt-1">@UserNameError</div>
                }
            </div>
            <div class="col-md-4">
                <label class="form-lbl">Password</label>
                <input type="text" class="form-inp @(FieldError("Password").Length > 0 ? "border-danger" : "")"
                       @bind="vm.Account.Password" placeholder="Enter Password">
                @if (FieldError("Password") is { Length: > 0 } passwordError)
                {
                    <div class="text-danger small mt-1">@passwordError</div>
