@page "/EmployeeRegistration"
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components
@using SPIC.Core.Entities
@using static SPIC.Core.Entities.EmployeeRegistration
@inject HttpClient Http
@inject NavigationManager Nav
@inject LoadingService Loading
@inject SPIC.MauiBlazorApp.Shared.Services.LoginState LoginState

<div class="container-fluid py-4 px-0">

    <div class="page-header-row mb-4">
        <div>
            <h1 class="page-title" style="color: #1F2937; font-weight: 700; font-size: 1.5rem; margin: 0;">
                @(IsEditMode ? "Edit Employee" : "Employee Registration")
            </h1>
            <div class="page-subtitle" style="font-size: 0.85rem; color: #6B7280; margin-top: 4px;">
                Create and assign employee to role and location
            </div>
        </div>
        <div class="badge-director">@(!string.IsNullOrEmpty(SelectedRole) ? SelectedRole : "Director")</div>
    </div>

    <div class="main-card">
        <div class="section-header">
            <h3 class="section-title"><i class="bi bi-person-gear"></i> Role & Authority</h3>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <label class="form-lbl">Role</label>
                <select class="form-inp" @bind="vm.Login.Role">
                    <option value="">Select Role</option>
                    @foreach (var role in AllowedRoles)
                    {
                        <option value="@role">@role</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-lbl">
                    Designation
                    <small class="text-muted fw-normal" style="font-size:0.72rem;">(optional — controls page access)</small>
                </label>
                <select class="form-inp" @bind="vm.SelectedDesignationId">
                    <option value="0">-- No Designation (full access) --</option>
                    @foreach (var d in Designations)
                    {
                        <option value="@d.Id">@d.Name</option>
                    }
                </select>
            </div>
        </div>
    </div>

    <div class="main-card">
        <div class="section-header">
            <h3 class="section-title"><i class="bi bi-buildings"></i> Role Specification</h3>
        </div>
        <div class="row g-4 align-items-end">

            @* AVP → Zone only *@
            @if (SelectedRole == "AVP")
            {
                <div class="col-md-3">
                    <label class="form-lbl">Zone</label>
                    <select class="form-inp" @bind="vm.Login.ZoneId">
                        <option value="0">Select Zone</option>
                        @foreach (var z in Zones)
                        {
                            <option value="@z.Id">@z.Name</option>
                        }
                    </select>
                </div>
            }

            @* SMD, SMM → State only *@
            @if (SelectedRole == "SMD" || SelectedRole == "SMM")
            {
                <div class="col-md-3">
                    <label class="form-lbl">State</label>
                    <select class="form-inp" @bind="vm.Login.StateId">
                        <option value="0">Select State</option>
                        @foreach (var s in States)
                        {
                            <option value="@s.Id">@s.Name</option>
                        }
                    </select>
                </div>
            }

            @* RM, RMD → State + Region *@
            @if (SelectedRole == "RM" || SelectedRole == "RMD" || SelectedRole == "MO" || SelectedRole == "MDO" || SelectedRole == "JMDO")
            {
                <div class="col-md-3">
                    <label class="form-lbl">State</label>
                    <select class="form-inp" @bind="vm.Login.StateId">
                        <option value="0">Select State</option>
                        @foreach (var s in States)
                        {
                            <option value="@s.Id">@s.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-lbl">Region</label>
                    <select class="form-inp" @bind="vm.Login.RegionId">
                        <option value="0">Select Region</option>
                        @foreach (var r in Regions)
                        {
                            <option value="@r.Id">@r.Name</option>
                        }
                    </select>
                </div>
            }

            @* MDO, MO, JMDO → HQ only *@
            @if (SelectedRole == "MDO" || SelectedRole == "MO" || SelectedRole == "JMDO")
            {
                <div class="col-md-3">
                    <label class="form-lbl">Headquarters</label>
                    <select class="form-inp" @bind="vm.Login.HeadquartersId">
                        <option value="0">Select Headquarters</option>
                        @foreach (var h in Headquarters)
                        {
                            <option value="@h.Id">@h.Name</option>
                        }
                    </select>
                </div>
            }

            @* SpecialAdmin → multi-select dropdowns (States → Regions → HQs cascade) *@
            @if (SelectedRole == "SpecialAdmin")
            {
                <div class="col-md-4">
                    <label class="form-lbl">States</label>
                    <div class="samulti">
                        <div class="samulti-box @(IsSpecialStateOpen ? "open" : "")" @onclick="ToggleSpecialStateDropdown">
                            <div class="samulti-selected">
                                @if (SelectedSpecialStates.Count == 0)
                                {
                                    <span class="samulti-placeholder">Select States</span>
                                }
                                else
                                {
                                    @foreach (var s in States.Where(x => SelectedSpecialStates.Contains(x.Id)))
                                    {
                                        <span class="samulti-tag">
                                            @s.StateName
                                            <i class="bi bi-x" @onclick="() => ToggleState(s.Id, false)" @onclick:stopPropagation="true"></i>
                                        </span>
                                    }
                                }
                            </div>
                            <div class="samulti-actions">
                                @if (SelectedSpecialStates.Count > 0)
                                {
                                    <i class="bi bi-x-circle-fill samulti-clear" title="Clear all states"
                                       @onclick="ClearSpecialStates" @onclick:stopPropagation="true"></i>
                                }
                                <i class="bi @(IsSpecialStateOpen ? "bi-chevron-up" : "bi-chevron-down") samulti-chevron"></i>
                            </div>
                        </div>
                        @if (IsSpecialStateOpen)
                        {
                            <div class="samulti-overlay" @onclick="CloseSpecialDropdowns"></div>
                            <div class="samulti-panel" @onclick:stopPropagation="true">
                                <div class="samulti-search">
                                    <i class="bi bi-search samulti-search-icon"></i>
                                    <input type="text" class="samulti-search-input" placeholder="Search states..."
                                           @bind="SpecialStateSearch" @bind:event="oninput" />
                                </div>
                                <div class="samulti-select-all" @onclick="SelectAllSpecialStates">Select All States</div>
                                <div class="samulti-list">
                                    @if (!FilteredSpecialStates.Any())
                                    {
                                        <div class="samulti-empty">No states found</div>
                                    }
                                    else
                                    {
                                        @foreach (var s in FilteredSpecialStates)
                                        {
                                            var isSel = SelectedSpecialStates.Contains(s.Id);
                                                <div class="samulti-option @(isSel ? "selected" : "")"
                                                     @onclick="() => ToggleState(s.Id, !isSel)">
                                                <span>@s.StateName</span>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="col-md-4">
                    <label class="form-lbl">Regions</label>
                    <div class="samulti">
                        <div class="samulti-box @(IsSpecialRegionOpen ? "open" : "")" @onclick="ToggleSpecialRegionDropdown">
                            <div class="samulti-selected">
                                @if (SelectedSpecialRegions.Count == 0)
                                {
                                    <span class="samulti-placeholder">Select Regions</span>
                                }
                                else
                                {
                                    @foreach (var r in AvailableSpecialRegions.Where(x => SelectedSpecialRegions.Contains(x.Id)))
                                    {
                                        <span class="samulti-tag">
                                            @r.RegionName
                                            <i class="bi bi-x" @onclick="() => ToggleRegion(r.Id, false)" @onclick:stopPropagation="true"></i>
                                        </span>
                                    }
                                }
                            </div>
                            <div class="samulti-actions">
                                @if (SelectedSpecialRegions.Count > 0)
                                {
                                    <i class="bi bi-x-circle-fill samulti-clear" title="Clear all regions"
                                       @onclick="ClearSpecialRegions" @onclick:stopPropagation="true"></i>
                                }
                                <i class="bi @(IsSpecialRegionOpen ? "bi-chevron-up" : "bi-chevron-down") samulti-chevron"></i>
                            </div>
                        </div>
                        @if (IsSpecialRegionOpen)
                        {
                            <div class="samulti-overlay" @onclick="CloseSpecialDropdowns"></div>
                            <div class="samulti-panel" @onclick:stopPropagation="true">
                                @if (AvailableSpecialRegions.Count == 0)
                                {
                                    <div class="samulti-empty">Select States first to load Regions.</div>
                                }
                                else
                                {
                                    <div class="samulti-search">
                                        <i class="bi bi-search samulti-search-icon"></i>
                                        <input type="text" class="samulti-search-input" placeholder="Search regions..."
                                               @bind="SpecialRegionSearch" @bind:event="oninput" />
                                    </div>
                                    <div class="samulti-select-all" @onclick="SelectAllSpecialRegions">Select All Regions</div>
                                    <div class="samulti-list">
                                        @if (!FilteredSpecialRegions.Any())
                                        {
                                            <div class="samulti-empty">No regions found</div>
                                        }
                                        else
                                        {
                                            @foreach (var r in FilteredSpecialRegions)
                                            {
                                                var rSel = SelectedSpecialRegions.Contains(r.Id);
                                                <div class="samulti-option @(rSel ? "selected" : "")"
                                                     @onclick="() => ToggleRegion(r.Id, !rSel)">
                                                <span>@r.RegionName</span>
                                            </div>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="col-md-4">
                    <label class="form-lbl">Headquarters</label>
                    <div class="samulti">
                        <div class="samulti-box @(IsSpecialHqOpen ? "open" : "")" @onclick="ToggleSpecialHqDropdown">
                            <div class="samulti-selected">
                                @if (SelectedSpecialHQs.Count == 0)
                                {
                                    <span class="samulti-placeholder">Select Headquarters</span>
                                }
                                else
                                {
                                    @foreach (var h in AvailableSpecialHeadquarters.Where(x => SelectedSpecialHQs.Contains(x.Id)))
                                    {
                                        <span class="samulti-tag">
                                            @h.HeadquarterName
                                            <i class="bi bi-x" @onclick="() => ToggleHQ(h.Id, false)" @onclick:stopPropagation="true"></i>
                                        </span>
                                    }
                                }
                            </div>
                            <div class="samulti-actions">
                                @if (SelectedSpecialHQs.Count > 0)
                                {
                                    <i class="bi bi-x-circle-fill samulti-clear" title="Clear all headquarters"
                                       @onclick="ClearSpecialHQs" @onclick:stopPropagation="true"></i>
                                }
                                <i class="bi @(IsSpecialHqOpen ? "bi-chevron-up" : "bi-chevron-down") samulti-chevron"></i>
                            </div>
                        </div>
                        @if (IsSpecialHqOpen)
                        {
                            <div class="samulti-overlay" @onclick="CloseSpecialDropdowns"></div>
                            <div class="samulti-panel" @onclick:stopPropagation="true">
                                @if (AvailableSpecialHeadquarters.Count == 0)
                                {
                                    <div class="samulti-empty">Select Regions first to load Headquarters.</div>
                                }
                                else
                                {
                                    <div class="samulti-search">
                                        <i class="bi bi-search samulti-search-icon"></i>
                                        <input type="text" class="samulti-search-input" placeholder="Search headquarters..."
                                               @bind="SpecialHqSearch" @bind:event="oninput" />
                                    </div>
                                    <div class="samulti-select-all" @onclick="SelectAllSpecialHQs">Select All Headquarters</div>
                                    <div class="samulti-list">
                                        @if (!FilteredSpecialHQs.Any())
                                        {
                                            <div class="samulti-empty">No headquarters found</div>
                                        }
                                        else
                                        {
                                            @foreach (var h in FilteredSpecialHQs)
                                            {
                                                var hSel = SelectedSpecialHQs.Contains(h.Id);
                                                <div class="samulti-option @(hSel ? "selected" : "")"
                                                     @onclick="() => ToggleHQ(h.Id, !hSel)">
                                                <span>@h.HeadquarterName</span>
                                            </div>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            @if (SelectedRole != "AVP" && SelectedRole != "SMD" && SelectedRole != "SMM" && SelectedRole != "RM" && SelectedRole != "RMD" &&
                 SelectedRole != "MDO" && SelectedRole != "MO" && SelectedRole != "JMDO" && SelectedRole != "SpecialAdmin" && !string.IsNullOrEmpty(SelectedRole))
            {
                <div class="col-12">
                    <p class="text-muted small"><i class="bi bi-info-circle me-1"></i>No location specification required for this role.</p>
                </div>
            }
        </div>
    </div>

    <div class="main-card">
        <div class="section-header">
            <h3 class="section-title"><i class="bi bi-shield-lock"></i> Login Details</h3>
        </div>
        <div class="row g-4 align-items-end">
            <div class="col-md-4">
                <label class="form-lbl">User Name</label>
                <input type="text" class="form-inp" @bind="vm.Account.UserName" placeholder="Enter User Name">
            </div>
            <div class="col-md-4">
                <label class="form-lbl">Password</label>
                <input type="text" class="form-inp" @bind="vm.Account.Password" placeholder="Enter Password">
            </div>
            <div class="col-md-4">
                <div class="status-toggle-box">
                    <div class="status-toggle-text">
                        <strong>Status</strong>
                        <small>Active / Inactive</small>
                    </div>
                    <label class="switch">
                        <input type="checkbox" @bind="vm.Login.IsActive">
                        <span class="slider"></span>
                    </label>
                </div>
            </div>
        </div>
    </div>

    <div class="main-card">
        <div class="section-header">
            <h3 class="section-title"><i class="bi bi-person-badge"></i> Employee Details</h3>
        </div>
        <div class="row g-4">
            <div class="col-md-6">
                <label class="form-lbl">Employee Name</label>
                <input type="text" class="form-inp" placeholder="Enter Employee Name" @bind="vm.Employee.Name">
            </div>
            <div class="col-md-6">
                <label class="form-lbl">Employee ID</label>
                <input type="text" class="form-inp" placeholder="Enter Employee ID" @bind="vm.Employee.EmployeeCode">
            </div>
            <div class="col-md-6">
                <label class="form-lbl">Personal Phone Number</label>
                <input type="text" class="form-inp" placeholder="Enter Personal Phone Number"
                       @bind="vm.Employee.PersonalPhoneNumber"
                       maxlength="10"
                       oninput="this.value = this.value.replace(/[^0-9]/g, '')">
            </div>
            <div class="col-md-6">
                <label class="form-lbl">Official Phone Number</label>
                <input type="text" class="form-inp" placeholder="Enter Official Phone Number"
                       @bind="vm.Employee.OfficialPhoneNumber"
                       maxlength="10"
                       oninput="this.value = this.value.replace(/[^0-9]/g, '')">
            </div>
            <div class="col-md-6">
                <label class="form-lbl">Email ID</label>
                <input type="email" class="form-inp" placeholder="Enter Email ID" @bind="vm.Employee.Email">
            </div>
        </div>
    </div>

    <div class="footer-actions">
        <button type="button" class="btn-cancel" @onclick="Cancel">
            <i class="bi bi-x"></i> Cancel
        </button>
        @if ((!IsEditMode && LoginState.Can(PagePermission.EmployeeRegistration, "Entry")) || (IsEditMode && LoginState.Can(PagePermission.EmployeeRegistration, "Update")))
        {
            <button type="button" class="btn-save" @onclick="SaveEmployee">
                @(IsEditMode ? "Update Employee" : "Save Employee") <i class="bi bi-floppy"></i>
            </button>
        }
    </div>
</div>

@code {
    private string SelectedRole => vm.Login.Role.ToString();

    private EmployeeRegistrationVM vm = new();
    private List<LocationItemDto> Zones = new();
    private List<LocationItemDto> States = new();
    private List<LocationItemDto> Regions = new();
    private List<LocationItemDto> Headquarters = new();
    private List<SPIC.Core.Entities.Designation> Designations = new();

    private bool IsEditMode = false;
    private int EditingEmployeeId = 0;
    private int EditingLoginId = 0;

    // SpecialAdmin multi-location selection state
    private HashSet<int> SelectedSpecialStates = new();
    private HashSet<int> SelectedSpecialRegions = new();
    private HashSet<int> SelectedSpecialHQs = new();
    private List<LocationItemDto> AvailableSpecialRegions = new();
    private List<LocationItemDto> AvailableSpecialHeadquarters = new();

    // Full-access intent: set ONLY by an explicit "Select All" action (or restored
    // from a compact row when editing). A State in SpecialFullAccessStates saves as
    // {State,0,0} (State -> All Regions -> All HQs); a Region in
    // SpecialFullAccessRegions saves as {State,Region,0} (Region -> All HQs).
    // Merely selecting a State/Region/RQ never adds these, so no access is granted
    // beyond what the user explicitly narrowed.
    private HashSet<int> SpecialFullAccessStates = new();
    private HashSet<int> SpecialFullAccessRegions = new();

    // SpecialAdmin multi-select dropdown open/close state
    private bool IsSpecialStateOpen = false;
    private bool IsSpecialRegionOpen = false;
    private bool IsSpecialHqOpen = false;

    // SpecialAdmin search queries (filters only the already-loaded options)
    private string SpecialStateSearch = "";
    private string SpecialRegionSearch = "";
    private string SpecialHqSearch = "";

    private static readonly AppRole[] AllowedRoles = new[]
    {
        AppRole.CorporateAdmin,
        AppRole.Director,
        AppRole.AVP,
        AppRole.SMD,
        AppRole.SMM,
        AppRole.RM,
        AppRole.RMD,
        AppRole.MDO,
        AppRole.MO,
        AppRole.JMDO,
        AppRole.SpecialAdmin
    };

    protected override async Task OnInitializedAsync()
    {
        Zones = await Http.GetFromJsonAsync<List<LocationItemDto>>("api/Zone/all") ?? new();
        States = await Http.GetFromJsonAsync<List<LocationItemDto>>("api/State/all") ?? new();
        Regions = await Http.GetFromJsonAsync<List<LocationItemDto>>("api/Region/all") ?? new();
        Headquarters = await Http.GetFromJsonAsync<List<LocationItemDto>>("api/Headquarter/all") ?? new();

        try
        {
            Designations = await Http.GetFromJsonAsync<List<SPIC.Core.Entities.Designation>>("api/Designation") ?? new();
        }
        catch
        {
            Designations = new();
        }

        var uri = new Uri(Nav.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var editLoginIdValue = query["editLoginId"];

        if (int.TryParse(editLoginIdValue, out var loginId))
        {
            await LoadForEdit(loginId);
        }
    }

    private async Task SaveEmployee()
    {
        try
        {
            Loading.Show();

            var currentUser = LoginState.UserId ?? "System";
            vm.Employee.CreatedBy ??= currentUser;
            vm.Employee.UpdatedBy = currentUser;

            // 0 in the dropdown means "no designation" -> send null to backend
            int? designationId = vm.SelectedDesignationId > 0 ? vm.SelectedDesignationId : null;

            var specialLocations = BuildSpecialAdminLocations();

            // SpecialAdmin validation: at least one state required, and every state
            // must narrow SOMETHING (selecting a State alone grants nothing now).
            if (vm.Login.Role == AppRole.SpecialAdmin)
            {
                if (SelectedSpecialStates.Count == 0)
                    throw new Exception("At least one State is required for SpecialAdmin.");

                foreach (var stateId in SelectedSpecialStates)
                {
                    if (SpecialFullAccessStates.Contains(stateId))
                        continue;
                    var hasCoverage = AvailableSpecialRegions
                        .Where(r => r.StateId == stateId && SelectedSpecialRegions.Contains(r.Id))
                        .Any(r => SpecialFullAccessRegions.Contains(r.Id) ||
                                  AvailableSpecialHeadquarters.Any(h => h.RegionId == r.Id && SelectedSpecialHQs.Contains(h.Id)));
                    if (!hasCoverage)
                    {
                        var stateName = States.FirstOrDefault(s => s.Id == stateId)?.StateName ?? $"State {stateId}";
                        throw new Exception($"For {stateName}, select at least one Region + one Headquarters, or use \"Select All Regions\" / \"Select All Headquarters\" to grant access.");
                    }
                }
            }

            if (!IsEditMode)
            {
                var empResponse = await Http.PostAsJsonAsync("api/EmployeeRegistration", vm.Employee);

                if (!empResponse.IsSuccessStatusCode)
                {
                    var error = await empResponse.Content.ReadAsStringAsync();
                    throw new Exception($"Employee save failed: {error}");
                }

                var empResult = await empResponse.Content.ReadFromJsonAsync<ApiResponse<EmployeeInformation>>();

                if (empResult?.data == null)
                    throw new Exception("Employee save failed: invalid response");

                var loginRequest = new EmployeeLoginCreateRequest
                {
                    EmployeeInformationID = empResult.data.Id,
                    UserName = vm.Account.UserName,
                    Password = vm.Account.Password,
                    Email = vm.Employee.Email,
                    Name = vm.Employee.Name,
                    DesignationId = designationId,
                    Role = vm.Login.Role,
                    ZoneId = vm.Login.ZoneId,
                    StateId = vm.Login.StateId,
                    RegionId = vm.Login.RegionId,
                    HeadquartersId = vm.Login.HeadquartersId,
                    IsActive = vm.Login.IsActive,
                    CreatedBy = currentUser,
                    UpdatedBy = currentUser,
                    SpecialAdminLocations = specialLocations
                };

                var loginResponse = await Http.PostAsJsonAsync("api/EmployeeLoginSetup", loginRequest);

                if (!loginResponse.IsSuccessStatusCode)
                {
                    var error = await loginResponse.Content.ReadAsStringAsync();
                    throw new Exception($"Login save failed: {error}");
                }
            }
            else
            {
                var employeeUpdateResponse = await Http.PutAsJsonAsync($"api/EmployeeRegistration/{EditingEmployeeId}", vm.Employee);

                if (!employeeUpdateResponse.IsSuccessStatusCode)
                {
                    var error = await employeeUpdateResponse.Content.ReadAsStringAsync();
                    throw new Exception($"Employee update failed: {error}");
                }

                var loginRequest = new EmployeeLoginCreateRequest
                {
                    EmployeeInformationID = EditingEmployeeId,
                    UserName = vm.Account.UserName,
                    Password = vm.Account.Password,
                    Email = vm.Employee.Email,
                    Name = vm.Employee.Name,
                    DesignationId = designationId,
                    Role = vm.Login.Role,
                    ZoneId = vm.Login.ZoneId,
                    StateId = vm.Login.StateId,
                    RegionId = vm.Login.RegionId,
                    HeadquartersId = vm.Login.HeadquartersId,
                    IsActive = vm.Login.IsActive,
                    UpdatedBy = currentUser,
                    SpecialAdminLocations = specialLocations
                };

                var loginUpdateResponse = await Http.PutAsJsonAsync($"api/EmployeeLoginSetup/login/{EditingLoginId}", loginRequest);
                if (!loginUpdateResponse.IsSuccessStatusCode)
                {
                    var error = await loginUpdateResponse.Content.ReadAsStringAsync();
                    throw new Exception($"Login update failed: {error}");
                }
            }

            ResetForm();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            Loading.Hide();
        }
    }

    private async Task LoadForEdit(int loginId)
    {
        try
        {
            Loading.Show();

            // 1. Fetch the specific login first
            var loginData = await Http.GetFromJsonAsync<EmployeeLoginCreateRequest>($"api/EmployeeLoginSetup/by-login/{loginId}");

            if (loginData == null) throw new Exception("Unable to load login data");

            // 2. Fetch the shared employee info based on the ID inside the login data
            var employee = await Http.GetFromJsonAsync<EmployeeInformation>($"api/EmployeeRegistration/{loginData.EmployeeInformationID}");

            if (employee == null) throw new Exception("Unable to load employee data");

            vm.Employee = employee;
            vm.Login = new Employeelogin
            {
                EmployeeInformationID = employee.Id,
                Role = loginData.Role,
                ZoneId = loginData.ZoneId,
                StateId = loginData.StateId,
                RegionId = loginData.RegionId,
                HeadquartersId = loginData.HeadquartersId,
                IsActive = loginData.IsActive
            };

            vm.Account = new UserAccountVM
            {
                UserName = loginData.UserName,
                Password = loginData.Password
            };

            vm.SelectedDesignationId = loginData.DesignationId ?? 0;

            // SpecialAdmin: load multi-location assignments
            if (loginData.Role == AppRole.SpecialAdmin)
            {
                await LoadSpecialAdminForEdit(loginData.EmployeeInformationID, loginData.SpecialAdminLocations);
            }

            EditingEmployeeId = employee.Id;
            EditingLoginId = loginId;
            IsEditMode = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            Loading.Hide();
        }
    }
    private void ResetForm()
    {
        vm = new EmployeeRegistrationVM();
        EditingEmployeeId = 0;
        EditingLoginId = 0;
        IsEditMode = false;
        SelectedSpecialStates.Clear();
        SelectedSpecialRegions.Clear();
        SelectedSpecialHQs.Clear();
        SpecialFullAccessStates.Clear();
        SpecialFullAccessRegions.Clear();
        AvailableSpecialRegions = new();
        AvailableSpecialHeadquarters = new();
        IsSpecialStateOpen = false;
        IsSpecialRegionOpen = false;
        IsSpecialHqOpen = false;
        SpecialStateSearch = "";
        SpecialRegionSearch = "";
        SpecialHqSearch = "";
    }

