@page "/EmployeeRegistration"
@using System.Net.Http.Json
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components
@using SPIC.Core.Entities
@using static SPIC.Core.Entities.EmployeeRegistration
@inject HttpClient Http
@inject NavigationManager Nav
@inject LoadingService Loading
@inject SPIC.MauiBlazorApp.Shared.Services.LoginState LoginState
@inject IJSRuntime JS

<div class="container-fluid py-4 px-0 emp-reg-page">

    <PageHeader Title="@(IsEditMode ? "Edit Employee" : "Employee Registration")"
                Subtitle="Create and assign employee to role and location"
                CssClass="mb-4">
        <Actions>
            <div class="badge-director">@(!string.IsNullOrEmpty(SelectedRole) ? SelectedRole : "Director")</div>
        </Actions>
    </PageHeader>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @ErrorMessage
            <button type="button" class="btn-close" @onclick="() => ErrorMessage = string.Empty" aria-label="Close"></button>
        </div>
    }

    <div class="main-card">
        <div class="section-header">
            <h3 class="section-title"><i class="bi bi-person-gear"></i> Role & Authority</h3>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <label class="form-lbl">Role</label>
                <select class="form-inp" @bind="vm.Login.Role" @bind:after="OnRoleChanged">
                    @* AppRole.Admin (enum value 0) is Login.Role's default and isn't itself a
                       pickable option below - using it as this placeholder's value (rather than
                       "") keeps the bound value always matching a real <option>, so a fresh form
                       shows "Select Role" instead of a blank/unselected native select. *@
                    <option value="@AppRole.Admin">Select Role</option>
                    @foreach (var role in AllowedRoles)
                    {
                        <option value="@role">@role</option>
                    }
                </select>
                @if (FieldError("Role") is { Length: > 0 } roleError)
                {
                    <div class="text-danger small mt-1">@roleError</div>
                }
            </div>
            <div class="col-md-4">
                <label class="form-lbl">
                    Designation
                    <small class="text-muted fw-normal" style="font-size:0.72rem;">(controls page access)</small>
                </label>
                <select class="form-inp" @bind="vm.SelectedDesignationId" @bind:after="OnDesignationChanged">
                    <option value="0">-- No Designation --  @* (No access) *@ </option>
                    @foreach (var d in Designations)
                    {
                        <option value="@d.Id">@d.Name</option>
                    }
                </select>
                @if (FieldError("DesignationId") is { Length: > 0 } designationError)
                {
                    <div class="text-danger small mt-1">@designationError</div>
                }
            </div>
        </div>
    </div>

    <div class="main-card">
        <div class="section-header">
            <h3 class="section-title"><i class="bi bi-buildings"></i> Role Specification</h3>
        </div>
        <div class="row g-4 align-items-end">

            @* AVP → Zone only *@
            @if (SelectedRole == "AVP")
            {
                <div class="col-md-3">
                    <label class="form-lbl">Zone</label>
                    <select class="form-inp" @bind="vm.Login.ZoneId">
                        <option value="0">Select Zone</option>
                        @foreach (var z in Zones)
                        {
                            <option value="@z.Id">@z.Name</option>
                        }
                    </select>
                    @if (FieldError("ZoneId") is { Length: > 0 } zoneError)
                    {
                        <div class="text-danger small mt-1">@zoneError</div>
                    }
                </div>
            }

            @* SMD, SMM → State only *@
            @if (SelectedRole == "SMD" || SelectedRole == "SMM" || SelectedRole == "MDAdmin" || SelectedRole == "MDHOD")
            {
                <div class="col-md-3">
                    <label class="form-lbl">State</label>
                    <select class="form-inp" @bind="vm.Login.StateId">
                        <option value="0">Select State</option>
                        @foreach (var s in States)
                        {
                            <option value="@s.Id">@s.Name</option>
                        }
                    </select>
                    @if (FieldError("StateId") is { Length: > 0 } stateError)
                    {
                        <div class="text-danger small mt-1">@stateError</div>
                    }
                </div>
            }

            @* RM, RMD → State (single) + Regions (multi-select) *@
            @if (SelectedRole == "RM" || SelectedRole == "RMD")
            {
                <div class="col-md-3">
                    <label class="form-lbl">State</label>
                    <select class="form-inp" value="@vm.Login.StateId" @onchange="OnStateChanged">
                        <option value="0">Select State</option>
                        @foreach (var s in States)
                        {
                            <option value="@s.Id">@s.Name</option>
                        }
                    </select>
                    @if (FieldError("StateId") is { Length: > 0 } stateError)
                    {
                        <div class="text-danger small mt-1">@stateError</div>
                    }
                </div>
                <div class="col-md-5">
                    <label class="form-lbl">Regions</label>
                    <div class="samulti">
                        <div class="samulti-box @(IsMultiRegionOpen ? "open" : "")" @onclick="ToggleMultiRegionDropdown">
                            <div class="samulti-selected">
                                @if (SelectedMultiRegions.Count == 0)
                                {
                                    <span class="samulti-placeholder">Select Regions</span>
                                }
                                else
                                {
                                    @foreach (var r in Regions.Where(x => SelectedMultiRegions.Contains(x.Id)))
                                    {
                                        <span class="samulti-tag">
                                            @r.Name
                                            <i class="bi bi-x" @onclick="() => ToggleMultiRegion(r.Id, false)" @onclick:stopPropagation="true"></i>
                                        </span>
                                    }
                                }
                            </div>
                            <div class="samulti-actions">
                                @if (SelectedMultiRegions.Count > 0)
                                {
                                    <i class="bi bi-x-circle-fill samulti-clear" title="Clear all regions"
                                       @onclick="ClearMultiRegions" @onclick:stopPropagation="true"></i>
                                }
                                <i class="bi @(IsMultiRegionOpen ? "bi-chevron-up" : "bi-chevron-down") samulti-chevron"></i>
                            </div>
                        </div>
                        @if (IsMultiRegionOpen)
                        {
                            <div class="samulti-overlay" @onclick="CloseMultiDropdowns"></div>
                            <div class="samulti-panel" @onclick:stopPropagation="true">
                                <div class="samulti-search">
                                    <i class="bi bi-search samulti-search-icon"></i>
                                    <input type="text" class="samulti-search-input" placeholder="Search regions..."
                                           @bind="MultiRegionSearch" @bind:event="oninput" />
                                </div>
                                <div class="samulti-select-all" @onclick="SelectAllMultiRegions">Select All Regions</div>
                                <div class="samulti-list">
                                    @if (!FilteredMultiRegions.Any())
                                    {
                                        <div class="samulti-empty">No regions found</div>
                                    }
                                    else
                                    {
                                        @foreach (var r in FilteredMultiRegions)
                                        {
                                            var isSel = SelectedMultiRegions.Contains(r.Id);
                                            <div class="samulti-option @(isSel ? "selected" : "")"
                                                 @onclick="() => ToggleMultiRegion(r.Id, !isSel)">
                                                <span>@r.Name</span>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        }
                    </div>
                    @if (FieldError("RegionId") is { Length: > 0 } regionError)
                    {
                        <div class="text-danger small mt-1">@regionError</div>
                    }
                </div>
            }

            @* MO, MDO, JMDO → State (single) + Region (single) + Headquarters (multi-select) *@
            @if (SelectedRole == "MO" || SelectedRole == "MDO" || SelectedRole == "JMDO")
            {
                <div class="col-md-3">
                    <label class="form-lbl">State</label>
                    <select class="form-inp" value="@vm.Login.StateId" @onchange="OnStateChanged">
                        <option value="0">Select State</option>
                        @foreach (var s in States)
                        {
                            <option value="@s.Id">@s.Name</option>
                        }
                    </select>
                    @if (FieldError("StateId") is { Length: > 0 } stateError)
                    {
                        <div class="text-danger small mt-1">@stateError</div>
                    }
                </div>
                <div class="col-md-3">
                    <label class="form-lbl">Region</label>
                    <select class="form-inp" value="@vm.Login.RegionId" @onchange="OnRegionChanged">
                        <option value="0">Select Region</option>
                        @foreach (var r in (vm.Login.StateId > 0 ? Regions.Where(x => x.StateId == vm.Login.StateId) : Regions))
                        {
                            <option value="@r.Id">@r.Name</option>
                        }
                    </select>
                    @if (FieldError("RegionId") is { Length: > 0 } regionError)
                    {
                        <div class="text-danger small mt-1">@regionError</div>
                    }
                </div>
                <div class="col-md-4">
                    <label class="form-lbl">Headquarters</label>
                    <div class="samulti">
                        <div class="samulti-box @(IsMultiHqOpen ? "open" : "")" @onclick="ToggleMultiHqDropdown">
                            <div class="samulti-selected">
                                @if (SelectedMultiHeadquarters.Count == 0)
                                {
                                    <span class="samulti-placeholder">Select Headquarters</span>
                                }
                                else
                                {
                                    @foreach (var h in Headquarters.Where(x => SelectedMultiHeadquarters.Contains(x.Id)))
                                    {
                                        <span class="samulti-tag">
                                            @h.Name
                                            <i class="bi bi-x" @onclick="() => ToggleMultiHq(h.Id, false)" @onclick:stopPropagation="true"></i>
                                        </span>
                                    }
                                }
                            </div>
                            <div class="samulti-actions">
                                @if (SelectedMultiHeadquarters.Count > 0)
                                {
                                    <i class="bi bi-x-circle-fill samulti-clear" title="Clear all headquarters"
                                       @onclick="ClearMultiHqs" @onclick:stopPropagation="true"></i>
                                }
                                <i class="bi @(IsMultiHqOpen ? "bi-chevron-up" : "bi-chevron-down") samulti-chevron"></i>
                            </div>
                        </div>
                        @if (IsMultiHqOpen)
                        {
                            <div class="samulti-overlay" @onclick="CloseMultiDropdowns"></div>
                            <div class="samulti-panel" @onclick:stopPropagation="true">
                                <div class="samulti-search">
                                    <i class="bi bi-search samulti-search-icon"></i>
                                    <input type="text" class="samulti-search-input" placeholder="Search headquarters..."
                                           @bind="MultiHqSearch" @bind:event="oninput" />
                                </div>
                                <div class="samulti-select-all" @onclick="SelectAllMultiHqs">Select All Headquarters</div>
                                <div class="samulti-list">
                                    @if (!FilteredMultiHeadquarters.Any())
                                    {
                                        <div class="samulti-empty">No headquarters found</div>
                                    }
                                    else
                                    {
                                        @foreach (var h in FilteredMultiHeadquarters)
                                        {
                                            var isSel = SelectedMultiHeadquarters.Contains(h.Id);
                                            <div class="samulti-option @(isSel ? "selected" : "")"
                                                 @onclick="() => ToggleMultiHq(h.Id, !isSel)">
                                                <span>@h.Name</span>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        }
                    </div>
                    @if (FieldError("HeadquartersId") is { Length: > 0 } hqError)
                    {
                        <div class="text-danger small mt-1">@hqError</div>
                    }
                </div>
            }

            @* CommonRole → optional Zone + State + Region (multi) + HQ (multi) *@
            @if (SelectedRole == "CommonRole")
            {
                <div class="col-md-2">
                    <label class="form-lbl">Zone</label>
                    <select class="form-inp" value="@vm.Login.ZoneId" @onchange="OnZoneChanged">
                        <option value="0">Select Zone</option>
                        @foreach (var z in Zones)
                        {
                            <option value="@z.Id">@z.Name</option>
                        }
                    </select>
                    @if (FieldError("ZoneId") is { Length: > 0 } zoneError)
                    {
                        <div class="text-danger small mt-1">@zoneError</div>
                    }
                </div>
                <div class="col-md-2">
                    <label class="form-lbl">State</label>
                    <select class="form-inp" value="@vm.Login.StateId" @onchange="OnStateChanged">
                        <option value="0">Select State</option>
                        @foreach (var s in (vm.Login.ZoneId > 0 ? States.Where(x => x.ZoneId == vm.Login.ZoneId) : States))
                        {
                            <option value="@s.Id">@s.Name</option>
                        }
                    </select>
                    @if (FieldError("StateId") is { Length: > 0 } stateError)
                    {
                        <div class="text-danger small mt-1">@stateError</div>
                    }
                </div>
                <div class="col-md-4">
                    <label class="form-lbl">Regions</label>
                    <div class="samulti">
                        <div class="samulti-box @(IsMultiRegionOpen ? "open" : "")" @onclick="ToggleMultiRegionDropdown">
                            <div class="samulti-selected">
                                @if (SelectedMultiRegions.Count == 0)
                                {
                                    <span class="samulti-placeholder">Select Regions (Optional)</span>
                                }
                                else
                                {
                                    @foreach (var r in Regions.Where(x => SelectedMultiRegions.Contains(x.Id)))
                                    {
                                        <span class="samulti-tag">
                                            @r.Name
                                            <i class="bi bi-x" @onclick="() => ToggleMultiRegion(r.Id, false)" @onclick:stopPropagation="true"></i>
                                        </span>
                                    }
                                }
                            </div>
                            <div class="samulti-actions">
                                @if (SelectedMultiRegions.Count > 0)
                                {
                                    <i class="bi bi-x-circle-fill samulti-clear" title="Clear all regions"
                                       @onclick="ClearMultiRegions" @onclick:stopPropagation="true"></i>
                                }
                                <i class="bi @(IsMultiRegionOpen ? "bi-chevron-up" : "bi-chevron-down") samulti-chevron"></i>
                            </div>
                        </div>
                        @if (IsMultiRegionOpen)
                        {
                            <div class="samulti-overlay" @onclick="CloseMultiDropdowns"></div>
                            <div class="samulti-panel" @onclick:stopPropagation="true">
                                <div class="samulti-search">
                                    <i class="bi bi-search samulti-search-icon"></i>
                                    <input type="text" class="samulti-search-input" placeholder="Search regions..."
                                           @bind="MultiRegionSearch" @bind:event="oninput" />
                                </div>
                                <div class="samulti-select-all" @onclick="SelectAllMultiRegions">Select All Regions</div>
                                <div class="samulti-list">
                                    @if (!FilteredMultiRegions.Any())
                                    {
                                        <div class="samulti-empty">No regions found</div>
                                    }
                                    else
                                    {
                                        @foreach (var r in FilteredMultiRegions)
                                        {
                                            var isSel = SelectedMultiRegions.Contains(r.Id);
                                            <div class="samulti-option @(isSel ? "selected" : "")"
                                                 @onclick="() => ToggleMultiRegion(r.Id, !isSel)">
                                                <span>@r.Name</span>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        }
                    </div>
                    @if (FieldError("RegionId") is { Length: > 0 } regionError)
                    {
                        <div class="text-danger small mt-1">@regionError</div>
                    }
                </div>
                <div class="col-md-4">
                    <label class="form-lbl">Headquarters</label>
                    <div class="samulti">
                        <div class="samulti-box @(IsMultiHqOpen ? "open" : "")" @onclick="ToggleMultiHqDropdown">
                            <div class="samulti-selected">
                                @if (SelectedMultiHeadquarters.Count == 0)
                                {
                                    <span class="samulti-placeholder">Select Headquarters (Optional)</span>
                                }
                                else
                                {
                                    @foreach (var h in Headquarters.Where(x => SelectedMultiHeadquarters.Contains(x.Id)))
                                    {
                                        <span class="samulti-tag">
                                            @h.Name
                                            <i class="bi bi-x" @onclick="() => ToggleMultiHq(h.Id, false)" @onclick:stopPropagation="true"></i>
                                        </span>
                                    }
                                }
                            </div>
                            <div class="samulti-actions">
                                @if (SelectedMultiHeadquarters.Count > 0)
                                {
                                    <i class="bi bi-x-circle-fill samulti-clear" title="Clear all headquarters"
                                       @onclick="ClearMultiHqs" @onclick:stopPropagation="true"></i>
                                }
                                <i class="bi @(IsMultiHqOpen ? "bi-chevron-up" : "bi-chevron-down") samulti-chevron"></i>
                            </div>
                        </div>
                        @if (IsMultiHqOpen)
                        {
                            <div class="samulti-overlay" @onclick="CloseMultiDropdowns"></div>
                            <div class="samulti-panel" @onclick:stopPropagation="true">
                                <div class="samulti-search">
                                    <i class="bi bi-search samulti-search-icon"></i>
                                    <input type="text" class="samulti-search-input" placeholder="Search headquarters..."
                                           @bind="MultiHqSearch" @bind:event="oninput" />
                                </div>
                                <div class="samulti-select-all" @onclick="SelectAllMultiHqs">Select All Headquarters</div>
                                <div class="samulti-list">
                                    @if (!FilteredMultiHeadquarters.Any())
                                    {
                                        <div class="samulti-empty">No headquarters found</div>
                                    }
                                    else
                                    {
                                        @foreach (var h in FilteredMultiHeadquarters)
                                        {
                                            var isSel = SelectedMultiHeadquarters.Contains(h.Id);
                                            <div class="samulti-option @(isSel ? "selected" : "")"
                                                 @onclick="() => ToggleMultiHq(h.Id, !isSel)">
                                                <span>@h.Name</span>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        }
                    </div>
                    @if (FieldError("HeadquartersId") is { Length: > 0 } hqError)
                    {
                        <div class="text-danger small mt-1">@hqError</div>
                    }
                </div>
                <div class="col-12">
                    <p class="text-muted small"><i class="bi bi-info-circle me-1"></i>All location fields are optional. Leave any dropdown unselected when no location applies.</p>
                </div>
            }

            @* SpecialAdmin → multi-select dropdowns (States → Regions → HQs cascade) *@
            @if (SelectedRole == "SpecialAdmin")
            {
                <div class="col-md-4">
                    <label class="form-lbl">States</label>
                    <div class="samulti">
                        <div class="samulti-box @(IsSpecialStateOpen ? "open" : "")" @onclick="ToggleSpecialStateDropdown">
                            <div class="samulti-selected">
                                @if (SelectedSpecialStates.Count == 0)
                                {
                                    <span class="samulti-placeholder">Select States</span>
                                }
                                else
                                {
                                    @foreach (var s in States.Where(x => SelectedSpecialStates.Contains(x.Id)))
                                    {
                                        <span class="samulti-tag">
                                            @s.StateName
                                            <i class="bi bi-x" @onclick="() => ToggleState(s.Id, false)" @onclick:stopPropagation="true"></i>
                                        </span>
                                    }
                                }
                            </div>
                            <div class="samulti-actions">
                                @if (SelectedSpecialStates.Count > 0)
                                {
                                    <i class="bi bi-x-circle-fill samulti-clear" title="Clear all states"
                                       @onclick="ClearSpecialStates" @onclick:stopPropagation="true"></i>
                                }
                                <i class="bi @(IsSpecialStateOpen ? "bi-chevron-up" : "bi-chevron-down") samulti-chevron"></i>
                            </div>
                        </div>
                        @if (IsSpecialStateOpen)
                        {
                            <div class="samulti-overlay" @onclick="CloseSpecialDropdowns"></div>
                            <div class="samulti-panel" @onclick:stopPropagation="true">
                                <div class="samulti-search">
                                    <i class="bi bi-search samulti-search-icon"></i>
                                    <input type="text" class="samulti-search-input" placeholder="Search states..."
                                           @bind="SpecialStateSearch" @bind:event="oninput" />
                                </div>
                                <div class="samulti-select-all" @onclick="SelectAllSpecialStates">Select All States</div>
                                <div class="samulti-list">
                                    @if (!FilteredSpecialStates.Any())
                                    {
                                        <div class="samulti-empty">No states found</div>
                                    }
                                    else
                                    {
                                        @foreach (var s in FilteredSpecialStates)
                                        {
                                            var isSel = SelectedSpecialStates.Contains(s.Id);
                                                <div class="samulti-option @(isSel ? "selected" : "")"
                                                     @onclick="() => ToggleState(s.Id, !isSel)">
                                                <span>@s.StateName</span>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="col-md-4">
                    <label class="form-lbl">Regions</label>
                    <div class="samulti">
                        <div class="samulti-box @(IsSpecialRegionOpen ? "open" : "")" @onclick="ToggleSpecialRegionDropdown">
                            <div class="samulti-selected">
                                @if (SelectedSpecialRegions.Count == 0)
                                {
                                    <span class="samulti-placeholder">Select Regions</span>
                                }
                                else
                                {
                                    @foreach (var r in AvailableSpecialRegions.Where(x => SelectedSpecialRegions.Contains(x.Id)))
                                    {
                                        <span class="samulti-tag">
                                            @r.RegionName
                                            <i class="bi bi-x" @onclick="() => ToggleRegion(r.Id, false)" @onclick:stopPropagation="true"></i>
                                        </span>
                                    }
                                }
                            </div>
                            <div class="samulti-actions">
                                @if (SelectedSpecialRegions.Count > 0)
                                {
                                    <i class="bi bi-x-circle-fill samulti-clear" title="Clear all regions"
                                       @onclick="ClearSpecialRegions" @onclick:stopPropagation="true"></i>
                                }
                                <i class="bi @(IsSpecialRegionOpen ? "bi-chevron-up" : "bi-chevron-down") samulti-chevron"></i>
                            </div>
                        </div>
                        @if (IsSpecialRegionOpen)
                        {
                            <div class="samulti-overlay" @onclick="CloseSpecialDropdowns"></div>
                            <div class="samulti-panel" @onclick:stopPropagation="true">
                                @if (AvailableSpecialRegions.Count == 0)
                                {
                                    <div class="samulti-empty">Select States first to load Regions.</div>
                                }
                                else
                                {
                                    <div class="samulti-search">
                                        <i class="bi bi-search samulti-search-icon"></i>
                                        <input type="text" class="samulti-search-input" placeholder="Search regions..."
                                               @bind="SpecialRegionSearch" @bind:event="oninput" />
                                    </div>
                                    <div class="samulti-select-all" @onclick="SelectAllSpecialRegions">Select All Regions</div>
                                    <div class="samulti-list">
                                        @if (!FilteredSpecialRegions.Any())
                                        {
                                            <div class="samulti-empty">No regions found</div>
                                        }
                                        else
                                        {
                                            @foreach (var r in FilteredSpecialRegions)
                                            {
                                                var rSel = SelectedSpecialRegions.Contains(r.Id);
                                                <div class="samulti-option @(rSel ? "selected" : "")"
                                                     @onclick="() => ToggleRegion(r.Id, !rSel)">
                                                <span>@r.RegionName</span>
                                            </div>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="col-md-4">
                    <label class="form-lbl">Headquarters</label>
                    <div class="samulti">
                        <div class="samulti-box @(IsSpecialHqOpen ? "open" : "")" @onclick="ToggleSpecialHqDropdown">
                            <div class="samulti-selected">
                                @if (SelectedSpecialHQs.Count == 0)
                                {
                                    <span class="samulti-placeholder">Select Headquarters</span>
                                }
                                else
                                {
                                    @foreach (var h in AvailableSpecialHeadquarters.Where(x => SelectedSpecialHQs.Contains(x.Id)))
                                    {
                                        <span class="samulti-tag">
                                            @h.HeadquarterName
                                            <i class="bi bi-x" @onclick="() => ToggleHQ(h.Id, false)" @onclick:stopPropagation="true"></i>
                                        </span>
                                    }
                                }
                            </div>
                            <div class="samulti-actions">
                                @if (SelectedSpecialHQs.Count > 0)
                                {
                                    <i class="bi bi-x-circle-fill samulti-clear" title="Clear all headquarters"
                                       @onclick="ClearSpecialHQs" @onclick:stopPropagation="true"></i>
                                }
                                <i class="bi @(IsSpecialHqOpen ? "bi-chevron-up" : "bi-chevron-down") samulti-chevron"></i>
                            </div>
                        </div>
                        @if (IsSpecialHqOpen)
                        {
                            <div class="samulti-overlay" @onclick="CloseSpecialDropdowns"></div>
                            <div class="samulti-panel" @onclick:stopPropagation="true">
                                @if (AvailableSpecialHeadquarters.Count == 0)
                                {
                                    <div class="samulti-empty">Select Regions first to load Headquarters.</div>
                                }
                                else
                                {
                                    <div class="samulti-search">
                                        <i class="bi bi-search samulti-search-icon"></i>
                                        <input type="text" class="samulti-search-input" placeholder="Search headquarters..."
                                               @bind="SpecialHqSearch" @bind:event="oninput" />
                                    </div>
                                    <div class="samulti-select-all" @onclick="SelectAllSpecialHQs">Select All Headquarters</div>
                                    <div class="samulti-list">
                                        @if (!FilteredSpecialHQs.Any())
                                        {
                                            <div class="samulti-empty">No headquarters found</div>
                                        }
                                        else
                                        {
                                            @foreach (var h in FilteredSpecialHQs)
                                            {
                                                var hSel = SelectedSpecialHQs.Contains(h.Id);
                                                <div class="samulti-option @(hSel ? "selected" : "")"
                                                     @onclick="() => ToggleHQ(h.Id, !hSel)">
                                                <span>@h.HeadquarterName</span>
                                            </div>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            @if (SelectedRole != "AVP" && SelectedRole != "SMD" && SelectedRole != "SMM" && SelectedRole != "RM" && SelectedRole != "RMD" &&
                 SelectedRole != "MDO" && SelectedRole != "MO" && SelectedRole != "JMDO" && SelectedRole != "SpecialAdmin" && SelectedRole != "CommonRole" && SelectedRole != "MDAdmin" && SelectedRole != "MDHOD" && !string.IsNullOrEmpty(SelectedRole))
            {
                <div class="col-12">
                    <p class="text-muted small"><i class="bi bi-info-circle me-1"></i>No location specification required for this role.</p>
                </div>
            }
        </div>
    </div>

    <div class="main-card">
        <div class="section-header">
            <h3 class="section-title"><i class="bi bi-shield-lock"></i> Login Details</h3>
        </div>
        <div class="row g-4 align-items-end">
            <div class="col-md-4">
                <label class="form-lbl">User Name</label>
                <input type="text" class="form-inp @(!string.IsNullOrEmpty(UserNameError) ? "border-danger" : "")" 
