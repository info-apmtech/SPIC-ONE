    // Removes an (already) selected State so that it no longer grants anything,
    // including any full-access grant it may have had.
    private async Task ToggleState(int stateId, object? value)
    {
        var add = value is bool b && b;
        if (add) SelectedSpecialStates.Add(stateId);
        else
        {
            SelectedSpecialStates.Remove(stateId);
            SpecialFullAccessStates.Remove(stateId);
            foreach (var r in AvailableSpecialRegions.Where(x => x.StateId == stateId))
                SpecialFullAccessRegions.Remove(r.Id);
        }

        // re-compute the region pool from the freshly selected states
        await RefreshAvailableRegions();

        // remove orphaned regions/HQs that no longer belong to the selected states
        var validRegionIds = AvailableSpecialRegions.Select(r => r.Id).ToHashSet();
        SelectedSpecialRegions.RemoveWhere(r => !validRegionIds.Contains(r));
        await RefreshAvailableHeadquarters();
        SelectedSpecialHQs.RemoveWhere(h => !AvailableSpecialHeadquarters.Any(x => x.Id == h));
    }

    private async Task ToggleRegion(int regionId, object? value)
    {
        var add = value is bool b && b;
        if (add) SelectedSpecialRegions.Add(regionId);
        else
        {
            SelectedSpecialRegions.Remove(regionId);

            // The region itself is no longer "Region -> All HQs"...
            SpecialFullAccessRegions.Remove(regionId);

            // ...and its State is no longer "All Regions" either, so it must fall
            // back to partial access (full access is granted only via Select All).
            var stateId = AvailableSpecialRegions.FirstOrDefault(r => r.Id == regionId)?.StateId;
            if (stateId != null)
            {
                SpecialFullAccessStates.Remove(stateId.Value);
                foreach (var r in AvailableSpecialRegions.Where(x => x.StateId == stateId.Value))
                    SpecialFullAccessRegions.Remove(r.Id);
            }
        }

        await RefreshAvailableHeadquarters();
        SelectedSpecialHQs.RemoveWhere(h => !AvailableSpecialHeadquarters.Any(x => x.Id == h));
    }

    private void ToggleHQ(int hqId, object? value)
    {
        var add = value is bool b && b;
        if (add) SelectedSpecialHQs.Add(hqId);
        else
        {
            SelectedSpecialHQs.Remove(hqId);

            // Removing an HQ narrows access, so its Region is no longer
            // "Region -> All HQs" and, if that region belonged to a full State,
            // the State is no longer "All Regions -> All HQs" either.
            var regionId = AvailableSpecialHeadquarters.FirstOrDefault(h => h.Id == hqId)?.RegionId;
            if (regionId != null)
            {
                SpecialFullAccessRegions.Remove(regionId.Value);
                var stateId = AvailableSpecialRegions.FirstOrDefault(r => r.Id == regionId.Value)?.StateId;
                if (stateId != null) SpecialFullAccessStates.Remove(stateId.Value);
            }
        }
    }

    private async Task SelectAllSpecialStates()
    {
        var allIds = States.Select(s => s.Id).ToHashSet();
        SelectedSpecialStates = new HashSet<int>(allIds);

        // Global "Select All States" = full access for every State; on save this
        // enumerates one {State,0,0} row per State (no schema change required).
        SpecialFullAccessStates = new HashSet<int>(allIds);

        await RefreshAvailableRegions();
        SelectedSpecialRegions.RemoveWhere(r => !AvailableSpecialRegions.Any(x => x.Id == r));
        SpecialFullAccessRegions = new HashSet<int>(AvailableSpecialRegions.Select(r => r.Id));
        await RefreshAvailableHeadquarters();
        SelectedSpecialHQs.RemoveWhere(h => !AvailableSpecialHeadquarters.Any(x => x.Id == h));
        SelectedSpecialHQs = new HashSet<int>(AvailableSpecialHeadquarters.Select(h => h.Id));
    }

    private async Task SelectAllSpecialRegions()
    {
        // "Select All Regions" for the currently selected State(s) = full access
        // for those States -> State -> All Regions -> All HQs.
        SpecialFullAccessStates.UnionWith(SelectedSpecialStates);
        SelectedSpecialRegions = new HashSet<int>(AvailableSpecialRegions.Select(r => r.Id));
        SpecialFullAccessRegions.UnionWith(AvailableSpecialRegions.Select(r => r.Id));

        await RefreshAvailableHeadquarters();
        SelectedSpecialHQs.RemoveWhere(h => !AvailableSpecialHeadquarters.Any(x => x.Id == h));
        SelectedSpecialHQs = new HashSet<int>(AvailableSpecialHeadquarters.Select(h => h.Id));
    }

    private void SelectAllSpecialHQs()
    {
        // "Select All Headquarters" for the loaded Regions = Region -> All HQs.
        SpecialFullAccessRegions.UnionWith(AvailableSpecialRegions.Select(r => r.Id));
        SelectedSpecialHQs = new HashSet<int>(AvailableSpecialHeadquarters.Select(h => h.Id));
    }

    // Mirrors the Register page's State -> Region -> HQ cascade: the full
    // Regions/Headquarters master lists (api/Region/all, api/Headquarter/all)
    // are filtered in-memory by StateId/RegionId, exactly like Register.razor.
    private Task RefreshAvailableRegions()
    {
        if (SelectedSpecialStates.Count == 0)
        {
            AvailableSpecialRegions = new();
            return Task.CompletedTask;
        }
        AvailableSpecialRegions = Regions
            .Where(r => SelectedSpecialStates.Contains(r.StateId))
            .ToList();
        return Task.CompletedTask;
    }

    private Task RefreshAvailableHeadquarters()
    {
        if (SelectedSpecialRegions.Count == 0)
        {
            AvailableSpecialHeadquarters = new();
            return Task.CompletedTask;
        }
        AvailableSpecialHeadquarters = Headquarters
            .Where(h => SelectedSpecialRegions.Contains(h.RegionId))
            .ToList();
        return Task.CompletedTask;
    }

    private List<SpecialAdminLocationItem>? BuildSpecialAdminLocations()
    {
        if (vm.Login.Role != AppRole.SpecialAdmin)
            return null;

        // Compact-row encoding matching the existing SpecialAdminLocations schema:
        //   {State, 0, 0}        -> State -> All Regions -> All HQs
        //   {State, Region, 0}   -> State -> Region -> All HQs
        //   {State, Region, HQ}  -> specific HQ under a Region
        // RegionId/HeadquarterId = 0 is exactly how reports already interpret
        // "not narrowed / all".
        //
        // The full-access rows are emitted ONLY for explicit "Select All" intent
        // (tracked in SpecialFullAccessStates / SpecialFullAccessRegions). A State
        // merely selected, or a Region merely selected, produces individual rows
        // and is never widened to "all" automatically.
        var list = new List<SpecialAdminLocationItem>();
        foreach (var stateId in SelectedSpecialStates)
        {
            if (SpecialFullAccessStates.Contains(stateId))
            {
                list.Add(new SpecialAdminLocationItem { StateId = stateId, RegionId = 0, HeadquarterId = 0 });
                continue;
            }

            var selectedRegions = AvailableSpecialRegions
                .Where(r => r.StateId == stateId && SelectedSpecialRegions.Contains(r.Id));
            foreach (var region in selectedRegions)
            {
                if (SpecialFullAccessRegions.Contains(region.Id))
                {
                    list.Add(new SpecialAdminLocationItem { StateId = stateId, RegionId = region.Id, HeadquarterId = 0 });
                    continue;
                }

                foreach (var hq in AvailableSpecialHeadquarters.Where(h => h.RegionId == region.Id && SelectedSpecialHQs.Contains(h.Id)))
                {
                    list.Add(new SpecialAdminLocationItem { StateId = stateId, RegionId = region.Id, HeadquarterId = hq.Id });
                }
            }
        }
        return list;
    }

    private async Task LoadSpecialAdminForEdit(int employeeInfoId, List<SpecialAdminLocationItem>? locations)
    {
        SelectedSpecialStates.Clear();
        SelectedSpecialRegions.Clear();
        SelectedSpecialHQs.Clear();
        SpecialFullAccessStates.Clear();
        SpecialFullAccessRegions.Clear();

        if (locations == null || locations.Count == 0)
        {
            AvailableSpecialRegions = new();
            AvailableSpecialHeadquarters = new();
            return;
        }

        // 1. Restore exact State selections, then load the State->Region pool.
        foreach (var loc in locations)
        {
            if (loc.StateId > 0) SelectedSpecialStates.Add(loc.StateId);
        }
        await RefreshAvailableRegions();

        // 2. Restore exact Region selections; a State-level ALL row ({State,0,0})
        //    means every Region of that State, so select the full Region pool and
        //    restore its full-access intent. A Region-level ALL row ({State,Region,0})
        //    likewise restores that Region's full-access intent.
        foreach (var loc in locations)
        {
            if (loc.StateId > 0 && loc.RegionId == 0 && loc.HeadquarterId == 0)
            {
                SpecialFullAccessStates.Add(loc.StateId);
                foreach (var r in AvailableSpecialRegions.Where(x => x.StateId == loc.StateId))
                    SelectedSpecialRegions.Add(r.Id);
            }
            else if (loc.StateId > 0 && loc.RegionId > 0)
            {
                if (loc.HeadquarterId == 0)
                    SpecialFullAccessRegions.Add(loc.RegionId);
                SelectedSpecialRegions.Add(loc.RegionId);
            }
        }
        await RefreshAvailableHeadquarters();

        // 3. Restore exact HQ selections; Region-level ALL ({State,Region,0}) or
        //    State-level ALL ({State,0,0}) select the full matching HQ pool.
        //    A State-level ALL row only selects HQs belonging to that State's own
        //    Regions, so selections never leak into other States' regions.
        foreach (var loc in locations)
        {
            if (loc.StateId > 0 && loc.RegionId == 0 && loc.HeadquarterId == 0)
            {
                var stateRegionIds = AvailableSpecialRegions
                    .Where(x => x.StateId == loc.StateId)
                    .Select(x => x.Id)
                    .ToHashSet();
                foreach (var h in AvailableSpecialHeadquarters.Where(x => stateRegionIds.Contains(x.RegionId)))
                    SelectedSpecialHQs.Add(h.Id);
            }
            else if (loc.StateId > 0 && loc.RegionId > 0 && loc.HeadquarterId == 0)
            {
                foreach (var h in AvailableSpecialHeadquarters.Where(x => x.RegionId == loc.RegionId))
                    SelectedSpecialHQs.Add(h.Id);
            }
            else if (loc.StateId > 0 && loc.RegionId > 0 && loc.HeadquarterId > 0)
            {
                SelectedSpecialHQs.Add(loc.HeadquarterId);
            }
        }
    }

    private void Cancel()
    {
        ResetForm();
    }

