                        <input type="checkbox" @bind="vm.Login.IsActive">
                        <span class="slider"></span>
                    </label>
                </div>
            </div>
        </div>
    </div>

    <div class="main-card">
        <div class="section-header">
            <h3 class="section-title"><i class="bi bi-person-badge"></i> Employee Details</h3>
        </div>
        <div class="row g-4">
            <div class="col-md-6">
                <label class="form-lbl">Employee Name</label>
                <input type="text" class="form-inp @(FieldError("Name").Length > 0 ? "border-danger" : "")"
                       placeholder="Enter Employee Name" @bind="vm.Employee.Name">
                @if (FieldError("Name") is { Length: > 0 } nameError)
                {
                    <div class="text-danger small mt-1">@nameError</div>
                }
            </div>
            <div class="col-md-6">
                <label class="form-lbl">Employee ID</label>
                <input type="text" class="form-inp @(FieldError("EmployeeCode").Length > 0 ? "border-danger" : "")"
                       placeholder="Enter Employee ID" @bind="vm.Employee.EmployeeCode">
                @if (FieldError("EmployeeCode") is { Length: > 0 } codeError)
                {
                    <div class="text-danger small mt-1">@codeError</div>
                }
            </div>
            <div class="col-md-6">
                <label class="form-lbl">Personal Phone Number</label>
                <input type="text" class="form-inp @(FieldError("PersonalPhoneNumber").Length > 0 ? "border-danger" : "")"
                       placeholder="Enter Personal Phone Number"
