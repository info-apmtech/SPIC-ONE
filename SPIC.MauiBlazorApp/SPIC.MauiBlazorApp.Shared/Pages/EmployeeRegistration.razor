</div>
         
        <div class="page-header-row">
             <FormLoader />
            <h1 class="page-title">Employee Registration</h1>
        </div>

        <div class="main-card">
            <div class="section-header border-bottom pb-3 mb-4">
                <h3 class="section-title"><i class="bi bi-person-badge"></i> Add New Employee</h3>
            </div>

            <div class="row g-4">
                <div class="col-md-4">
                    <label class="form-lbl">Employee Code *</label>
                    <input type="text" class="form-inp" placeholder="e.g., EMP-1001">
                </div>

                <div class="col-md-4">
                    <label class="form-lbl">Full Name *</label>
                    <input type="text" class="form-inp" placeholder="Enter employee name">
                </div>

                <div class="col-md-4">
                    <label class="form-lbl">Designation *</label>
                    <input type="text" class="form-inp" placeholder="Enter designation">
                </div>

                <div class="col-md-4">
                    <label class="form-lbl">State *</label>
                    <select class="form-inp">
                        <option value="" disabled selected>Select State</option>
                        <option value="Tamil Nadu">Tamil Nadu</option>
                        <option value="Kerala">Kerala</option>
                        <option value="Karnataka">Karnataka</option>
                        <option value="Andhra Pradesh">Andhra Pradesh</option>
                        <option value="Maharashtra">Maharashtra</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-lbl">Registration Date *</label>
                    <input type="date" class="form-inp">
                </div>

                <div class="col-md-4">
                    <label class="form-lbl">Head Quarters *</label>
                    <input type="text" class="form-inp" placeholder="Enter HQ location">
                </div>
            </div>

            <div class="d-flex justify-content-end mt-4 pt-4 border-top">
                <button class="btn-cancel">Cancel</button>
                <button class="btn-save"><i class="bi bi-check2-circle"></i> Register Employee</button>
            </div>
        </div>

        <div class="main-card">
            <div class="section-header">
                <h3 class="section-title"><i class="bi bi-people"></i> Existing Employees</h3>
                
                <div class="table-controls">
                    <div class="search-box">
                        <i class="bi bi-search"></i>
                        <input type="text" placeholder="Search by name or code...">
                    </div>
                    <button class="btn-outline-green" style="margin: 0;"><i class="bi bi-download"></i> Export CSV</button>
                </div>
            </div>

            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th style="width: 60px;">S.No</th>
                            <th>Emp Code</th>
                            <th>Full Name</th>
                            <th>Designation</th>
                            <th>State</th>
                            <th>Head Quarters</th>
                            <th>Reg. Date</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="text-muted">1</td>
                            <td>EMP-1001</td>
                            <td class="fw-bold" style="color:#059669;">Rahul Sharma</td>
                            <td>Regional Manager</td>
                            <td>Maharashtra</td>
                            <td>Mumbai</td>
                            <td>2024-01-15</td>
                            <td>
                                <div class="action-icons">
                                    <i class="bi bi-trash icon-del"></i>
                                    <i class="bi bi-pencil-square icon-edit"></i>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td class="text-muted">2</td>
                            <td>EMP-1002</td>
                            <td class="fw-bold" style="color:#059669;">Priya Patel</td>
                            <td>Sales Executive</td>
                            <td>Gujarat</td>
                            <td>Ahmedabad</td>
                            <td>2024-02-10</td>
                            <td>
                                <div class="action-icons">
                                    <i class="bi bi-trash icon-del"></i>
                                    <i class="bi bi-pencil-square icon-edit"></i>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td class="text-muted">3</td>
                            <td>EMP-1003</td>
                            <td class="fw-bold" style="color:#059669;">Amit Kumar</td>
                            <td>Area Supervisor</td>
                            <td>Karnataka</td>
                            <td>Bengaluru</td>
                            <td>2024-03-05</td>
                            <td>
                                <div class="action-icons">
                                    <i class="bi bi-trash icon-del"></i>
                                    <i class="bi bi-pencil-square icon-edit"></i>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td class="text-muted">4</td>
                            <td>EMP-1004</td>
                            <td class="fw-bold" style="color:#059669;">Sneha Reddy</td>
