@page "/"
@page "/login"
@layout SPIC.MauiBlazorApp.Shared.Layout.EmptyLayout
@using System.Globalization
@inject SPIC.MauiBlazorApp.Shared.Services.PlatformService Platform
@inject ISessionStore SessionStore
@inject LoginState LoginState
@inject NavigationManager Nav

<div class="@(Platform.IsWeb ? "login-page web-bg" : "login-page app-bg")">

    @if (!_sessionChecked)
    {
        @* Checking the secure store for a saved session; avoids flashing the form
           at a user who is about to be taken straight to their dashboard. *@
        <main class="login-wrapper"></main>
    }
    else
    {
        @if (Platform.IsWeb)
        {
            <header class="top-header">
                <h1 class="brand-logo">SPIC</h1>
                <button type="button" class="btn-contact">Contact Us</button>
            </header>
        }

        <main class="login-wrapper @(Platform.IsWeb ? "" : "app-only-wrapper")">
            <div class="login-logo-circle">
                <img src="_content/SPIC.MauiBlazorApp.Shared/Images/LoginImages/logo.png"
                     alt="Logo"
                     class="login-logo-img" />
            </div>

            <div class="login-header-text">
                <h1>Glad to See you Again</h1>
                <p>Authenticate to continue to the operations Dashboard</p>
            </div>

            <LoginCard />
        </main>

        @if (Platform.IsWeb)
        {
            <LoginFooter Brand="SPIC ONE"
                         FooterText="2026 SPIC ONE. Industrial System Engineered with Excellence"
                         Links="_webLinks" />
        }
        else
        {
            <LoginFooter Brand="SPIC ONE"
                         FooterText="2026 SPIC ONE. Industrial System Engineered with Excellence" />
        }
    }
</div>

@code {
    private bool _sessionChecked;

    private readonly List<string> _webLinks = new()
    {
        "Compliance & security",
        "Data Protection",
        "Live System Monitor"
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // A session saved by a previous run (SecureStorage on the app, sessionStorage on
        // the web) is restored here so the app opens where the user left off instead of
        // on the login form. Anything invalid or expired falls through to the form.
        try
        {
            if (!LoginState.IsLoggedIn)
            {
                var token = await SessionStore.GetAsync(SessionKeys.Token);
                var expirationText = await SessionStore.GetAsync(SessionKeys.Expiration);

                if (!string.IsNullOrWhiteSpace(token)
                    && DateTime.TryParse(expirationText, CultureInfo.InvariantCulture, DateTimeStyles.RoundtripKind, out var expiration)
                    && expiration.ToUniversalTime() > DateTime.UtcNow.AddMinutes(1))
                {
                    LoginState.Token = token;
                    LoginState.Expiration = expiration;
                    LoginState.SetAllowedPages(await SessionStore.GetAsync(SessionKeys.RoleAccess));
                    LoginState.SetDesignationName(await SessionStore.GetAsync(SessionKeys.DesignationName));
                }
            }

            if (LoginState.IsLoggedIn && !LoginState.IsTokenExpired)
            {
                Nav.NavigateTo(LoginState.LandingPage, replace: true);
                return;
            }
        }
        catch
        {
            // Fall through to the login form.
        }

        _sessionChecked = true;
        StateHasChanged();
    }
}
