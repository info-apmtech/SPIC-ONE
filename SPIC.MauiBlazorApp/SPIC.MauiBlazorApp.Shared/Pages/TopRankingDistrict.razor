                    <h2 class="kpi-value">1</h2>
                     <div class="kpi-trend text-purple">All time</div>
            </div>
            <div class="sr-stat-icon-box sr-icon-red"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="4" width="12" height="12" rx="2"></rect><path d="M17 9h4l2 4v4h-6"></path><circle cx="9" cy="18" r="2"></circle><circle cx="17" cy="18" r="2"></circle><path d="M1 10h4"></path><path d="M3 14h2"></path></svg></div>
