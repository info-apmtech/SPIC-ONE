<footer class="footer">
    <div class="footer-brand">@Brand</div>

    @if (Links is not null && Links.Count > 0)
    {
        <ul class="footer-links">
            @foreach (var item in Links)
            {
                <li>@item</li>
            }
            <li><a class="footer-privacy" href="@PrivacyPolicyUrl">Privacy Policy</a></li>
        </ul>
    }
    else
    {
        <a class="footer-privacy" href="@PrivacyPolicyUrl">Privacy Policy</a>
    }

    <div class="footer-text">@FooterText</div>
</footer>

@code {
    [Parameter] public string Brand { get; set; } = "SPIC ONE";
    [Parameter] public string FooterText { get; set; } = string.Empty;
    [Parameter] public List<string>? Links { get; set; }

    /// <summary>
    /// The same page is served by the Web host at https://spicone.in/privacy, which is the
    /// URL to give Google Play and the App Store. Inside the app it opens in-app.
    /// </summary>
    [Parameter] public string PrivacyPolicyUrl { get; set; } = "privacy";
}
