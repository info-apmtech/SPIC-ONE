@page "/DigitalLibrary/{Section}"
@inject NavigationManager Nav

@*
    Placeholder for the Digital Library sub-pages (videos, products, brochures, chat, add).
    Each becomes its own page as its Figma design is implemented; until then the links from
    the landing page open this screen instead of a 404.
*@

<PageHeader Title="@Title" Subtitle="Digital Library" ShowBack="true" BackHref="/DigitalLibrary" />

<EmptyState Icon="@Icon" Title="@($"{Title} is being built")" Message="This section of the Digital Library is designed and will be available in an upcoming release.">
    <button type="button" class="btn btn-success" @onclick='() => Nav.NavigateTo("/DigitalLibrary")'>
        <i class="bi bi-arrow-left"></i> Back to the library
    </button>
</EmptyState>

@code {
    [Parameter] public string Section { get; set; } = "";

    [SupplyParameterFromQuery(Name = "q")] public string? Query { get; set; }
    [SupplyParameterFromQuery(Name = "id")] public string? Id { get; set; }

    private string Title => Section.ToLowerInvariant() switch
    {
        "videos" => "AI Videos",
        "products" => "Product Information",
        "brochures" => "Product Brochures",
        "chat" => "Library Assistant Chat",
        "add" => "Add Content",
        _ => "Digital Library"
    };

    private string Icon => Section.ToLowerInvariant() switch
    {
        "videos" => "bi-camera-video",
        "products" => "bi-clipboard2-data",
        "brochures" => "bi-journal-bookmark",
        "chat" => "bi-chat-dots",
        "add" => "bi-plus-square",
        _ => "bi-collection"
    };
}
