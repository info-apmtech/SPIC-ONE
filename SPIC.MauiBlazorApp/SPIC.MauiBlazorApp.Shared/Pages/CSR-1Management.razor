@page "/CSR-1List"
@using System.Net.Http.Json
@using System.Globalization
@using SPIC.Core.DTOs

@inject HttpClient Http

<div class="container-fluid py-4 px-0">

    <PageHeader Title="CSR-1 Management" CssClass="csrm-page-header" />

    <div class="csrm-stats-grid">

        <div class="csrm-stat-card csrm-theme-blue">
            <div class="csrm-card-body">
                <div class="csrm-stat-text">
                    <h2>@TotalCSR1</h2>
                    <p>Total CSR -1</p>
                </div>
                <div class="csrm-stat-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
                        <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
                        <path d="M9 12h6"></path>
                        <path d="M9 16h6"></path>
                        <circle cx="15.5" cy="15.5" r="3.5" fill="#f4f8ff"></circle>
                        <path d="M14 14l3 3m0-3l-3 3" stroke="currentColor"></path>
                    </svg>
                </div>
            </div>
            <div class="csrm-card-footer">
                <span>View all</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
            </div>
        </div>

        <div class="csrm-stat-card csrm-theme-green">
            <div class="csrm-card-body">
                <div class="csrm-stat-text">
                    <h2>@ApprovedCount</h2>
                    <p>Approved</p>
                </div>
                <div class="csrm-stat-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.76 4 4 0 0 1-4.78 4.78 4 4 0 0 1-6.74 0 4 4 0 0 1-4.78-4.78 4 4 0 0 1 0-6.76Z"></path>
                        <path d="m9 12 2 2 4-4"></path>
                    </svg>
                </div>
            </div>
            <div class="csrm-card-footer">
                <span>View approved</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
            </div>
        </div>

        <div class="csrm-stat-card csrm-theme-orange">
            <div class="csrm-card-body">
                <div class="csrm-stat-text">
                    <h2>@PendingCount</h2>
                    <p>Pending</p>
                </div>
                <div class="csrm-stat-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <circle cx="16" cy="16" r="5" fill="#fff9ea"></circle>
                        <polyline points="16 14 16 16 17.5 17.5"></polyline>
                    </svg>
                </div>
            </div>
            <div class="csrm-card-footer">
                <span>View Pending</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
            </div>
        </div>

        <div class="csrm-stat-card csrm-theme-red">
            <div class="csrm-card-body">
                <div class="csrm-stat-text">
                    <h2>@RejectedCount</h2>
                    <p>Rejected</p>
                </div>
                <div class="csrm-stat-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <circle cx="16" cy="16" r="5" fill="#fff0f0"></circle>
                        <path d="M14 14l4 4m0-4l-4 4" stroke="currentColor"></path>
                    </svg>
                </div>
            </div>
            <div class="csrm-card-footer">
                <span>View Rejected</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
            </div>
        </div>

        <div class="csrm-stat-card csrm-theme-gray">
            <div class="csrm-card-body">
                <div class="csrm-stat-text">
                    <h2>@DraftCount</h2>
                    <p>Drafts</p>
                </div>
                <div class="csrm-stat-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <path d="M16.5 17.5 15 18l.5-1.5L21 11l1.5 1.5-6 5.5Z" fill="#f1f5f9"></path>
                    </svg>
                </div>
            </div>
            <div class="csrm-card-footer">
                <span>View drafts</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
            </div>
        </div>

    </div>

    <div class="csrm-filter-card">

        <div class="csrm-filter-header">
            <div class="csrm-filter-title">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="4" y1="6" x2="20" y2="6"></line>
                    <line x1="6" y1="12" x2="18" y2="12"></line>
                    <line x1="8" y1="18" x2="16" y2="18"></line>
                </svg>
                Filters
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
        </div>

        <div class="csrm-filter-body">
            <div class="csrm-filter-grid">

                <div class="csrm-form-group">
                    <label class="csrm-form-label">Date Range</label>
                    <div class="csrm-input-wrapper">
                        <input type="text" class="csrm-form-control" placeholder="01 Apr 2025 - 28 Apr 2025" readonly style="padding-right: 36px;">
                        <svg class="csrm-input-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                    </div>
                </div>

                <div class="csrm-form-group">

                    <label class="csrm-form-label">
                        Program Type
                    </label>

                    <select class="csrm-form-select"
                            @bind="selectedProgramType"
                            @bind:after="OnProgramTypeChanged">

                        <option value="">
                            All Program Type
                        </option>

                        @foreach (var item in ProgramTypes)
                        {
                            <option value="@item">
                                @item
                            </option>
                        }

                    </select>

                </div>

                <div class="csrm-form-group">

                    <label class="csrm-form-label">
                        Program Name
                    </label>

                    <select class="csrm-form-select"
                            @bind="selectedProgramName">

                        <option value="">
                            All Program Name
                        </option>

                        @foreach (var item in ProgramNames)
                        {
                            <option value="@item">
                                @item
                            </option>
                        }

                    </select>

                </div>

                <div class="csrm-form-group">
                    <label class="csrm-form-label">Status</label>
                    <select class="csrm-form-select"
                            @bind="selectedStatus">

                        <option value="">
                            All Status
                        </option>

                        @foreach (var status in Statuses)
                        {
                            <option value="@status">
                                @status
                            </option>
                        }

                    </select>
                </div>

            </div>

            <div class="csrm-filter-actions">
                <button type="button" class="csrm-btn csrm-btn-outline" @onclick="ClearFilters">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                    Clear All
                </button>
                <button type="button" class="csrm-btn csrm-btn-solid" @onclick="ApplyFilters">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="4" y1="6" x2="20" y2="6"></line>
                        <line x1="6" y1="12" x2="18" y2="12"></line>
                        <line x1="8" y1="18" x2="16" y2="18"></line>
                    </svg>
                    Apply Filters
                </button>
            </div>
        </div>
    </div>

    <div class="csrm-table-card">

        <div class="csrm-table-top">
            <h3>CSR-1 plan list</h3>

            <div class="csrm-table-actions">
                <input type="text"
                       class="csrm-search-input"
                       placeholder="Search Program..."
                       @bind="searchText"
                       @bind:event="oninput">

                <button type="button" class="csrm-btn-outline" @onclick="LoadCSR1">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2v6h-6"></path><path d="M3 12a9 9 0 1 0 2.13-5.88L2 9"></path></svg>
                    Refresh Data
                </button>
                <button class="csrm-btn-outline">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><path d="M8 13h2"></path><path d="M8 17h2"></path><path d="M14 13h2"></path><path d="M14 17h2"></path></svg>
                    Excel
                </button>
                <button class="csrm-btn-outline">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><path d="M9 15v-4"></path><path d="M12 15v-4c1 0 2 1 2 2s-1 2-2 2"></path><path d="M16 11v4"></path><path d="M16 13h2"></path></svg>
                    PDF
                </button>
                <button class="csrm-btn-solid">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2L11 13"></path><path d="M22 2l-7 20-4-9-9-4 20-7z"></path></svg>
                    Send Mail
                </button>
            </div>
        </div>

        <div class="csrm-table-wrapper">
            <table class="csrm-main-table">
                <thead>
                    <tr>
                        <th><input type="checkbox" class="csrm-checkbox"></th>
                        <th>Program Type</th>
                        <th>Program Name</th>
                        <th>Submitted Date</th>
                        <th>Total Budget</th>
                        <th>Status</th>
                        <th>Sanction Number</th>
                        <th>CSR-2 Eligibility</th>
                        <th>Validation Due</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="10" class="text-center py-4">Loading CSR-1 records...</td>
                        </tr>
                    }
                    else if (!FilteredCSR1List.Any())
                    {
                        <tr>
                            <td colspan="10" class="text-center py-4">No CSR-1 records found.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in FilteredCSR1List)
                        {
                            <tr>
                                <td class="csrm-cell-select" data-label="">
                                    <input type="checkbox" class="csrm-checkbox" />
                                </td>
                                <td data-label="Program Type">@item.ProgramType</td>
                                <td data-label="Program Name">@item.ProgramName</td>
                                <td data-label="Submitted Date">@item.CreatedAt.ToString("dd MMM yyyy")</td>
                                <td data-label="Total Budget">
                                    ₹@item.Budget.ToString("N2", CultureInfo.CreateSpecificCulture("en-IN"))
                                </td>
                                <td data-label="Status">
                                    <span class="@GetStatusClass(item.Status)">@GetStatusDisplay(item.Status)</span>
                                </td>
                                <td data-label="Sanction Number">--</td>
                                <td data-label="CSR-2 Eligibility">
                                    @if (string.Equals(item.Status, "Approved", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <div class="csrm-badge-outline-green">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                            Eligible for CSR-2
                                        </div>
                                    }
                                    else
                                    {
                                        <span>--</span>
                                    }
                                </td>
                                <td data-label="Validation Due">--</td>
                                <td class="csrm-cell-actions" data-label="Action">
                                    <div class="csrm-actions-cell">
                                        <button type="button"
                                                class="csrm-action-btn csrm-icon-view"
                                                title="View"
                                                @onclick="() => OpenCSR1Details(item.Id)">
                                            <svg xmlns="http://www.w3.org/2000/svg"  width="18" height="18"   viewBox="0 0 24 24"   fill="none" stroke="currentColor"  stroke-width="2"  stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
                                                <circle cx="12" cy="12" r="3"></circle>
                                            </svg>
                                        </button>
                                        <button type="button"
                                                class="csrm-action-btn csrm-icon-delete"
                                                title="Delete"
                                                @onclick="() => DeleteCSR1(item.Id)">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                                        </button>
                                        <button type="button"
                                                class="csrm-btn-csr2 @(string.Equals(item.Status, "Approved", StringComparison.OrdinalIgnoreCase) ? "" : "disabled")"
                                                disabled="@(!string.Equals(item.Status, "Approved", StringComparison.OrdinalIgnoreCase))">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                                            CSR-2
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="csrm-pagination">
            <div class="csrm-page-size">
                <span>Items Per Page</span>
                <select class="csrm-form-select" style="padding: 6px 32px 6px 12px; width: 65px; margin:0; background-position: right 8px center;">
                    <option>16</option>
                </select>
            </div>
            <div class="csrm-page-controls">
                <button class="csrm-page-btn"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg></button>
                <button class="csrm-page-btn active">1</button>
                <button class="csrm-page-btn">2</button>
                <button class="csrm-page-btn">3</button>
                <button class="csrm-page-btn dots">..</button>
                <button class="csrm-page-btn">8</button>
                <button class="csrm-page-btn">9</button>
                <button class="csrm-page-btn">10</button>
                <button class="csrm-page-btn"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg></button>
            </div>
        </div>
    </div>

    @if (RejectedItems.Any(x => !string.IsNullOrWhiteSpace(x.Remarks)))
    {
        var rejectedItem = RejectedItems.First(x => !string.IsNullOrWhiteSpace(x.Remarks));
        <div class="csrm-rejection-alert">
            <div class="csrm-rejection-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
            </div>
            <div class="csrm-rejection-text">
                <strong>Rejection Reason:</strong> @rejectedItem.Remarks
            </div>
        </div>
    }
</div>

<CSR1ProgramDetailsDrawer @bind-IsOpen="isCSR1ProgramDetailsDrawerOpen"
                          CSR1Id="@selectedCSR1Id" />
@code {
    private bool isCSR1ProgramDetailsDrawerOpen = false;
    private int selectedCSR1Id = 0;

    private void OpenCSR1Details(int id)
{
    selectedCSR1Id = id;
    isCSR1ProgramDetailsDrawerOpen = true;
}

    private List<CSR1ListDto> csr1List = new();
    private bool isLoading = false;

    private string selectedProgramType = "";
    private string selectedProgramName = "";
    private string selectedStatus = "";
    private string searchText = "";

    private string appliedProgramType = "";
    private string appliedProgramName = "";
    private string appliedStatus = "";

    private int TotalCSR1 => csr1List.Count;

    private int ApprovedCount => csr1List.Count(x =>
        string.Equals(x.Status, "Approved", StringComparison.OrdinalIgnoreCase));

    private int PendingCount => csr1List.Count(x =>
        string.Equals(x.Status, "Pending", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(x.Status, "Submitted", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(x.Status, "SubmittedForValidation", StringComparison.OrdinalIgnoreCase));

    private int RejectedCount => csr1List.Count(x =>
        string.Equals(x.Status, "Rejected", StringComparison.OrdinalIgnoreCase));

    private int DraftCount => csr1List.Count(x =>
        string.Equals(x.Status, "Draft", StringComparison.OrdinalIgnoreCase));

    private IEnumerable<CSR1ListDto> RejectedItems => csr1List.Where(x =>
        string.Equals(x.Status, "Rejected", StringComparison.OrdinalIgnoreCase));

    private List<string> ProgramTypes => csr1List
        .Where(x => !string.IsNullOrWhiteSpace(x.ProgramType))
        .Select(x => x.ProgramType.Trim())
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x)
        .ToList();

    private List<string> ProgramNames => csr1List
        .Where(x =>
            string.IsNullOrWhiteSpace(selectedProgramType) ||
            string.Equals(x.ProgramType, selectedProgramType, StringComparison.OrdinalIgnoreCase))
        .Where(x => !string.IsNullOrWhiteSpace(x.ProgramName))
        .Select(x => x.ProgramName.Trim())
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x)
        .ToList();

    private List<string> Statuses => csr1List
        .Where(x => !string.IsNullOrWhiteSpace(x.Status))
        .Select(x => x.Status.Trim())
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadCSR1();
    }

    private async Task LoadCSR1()
    {
        try
        {
            isLoading = true;

            csr1List = await Http.GetFromJsonAsync<List<CSR1ListDto>>(
                "api/CSR1/list") ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"CSR1 Load Error: {ex.Message}");
            csr1List = new();
        }
        finally
        {
            isLoading = false;
        }
    }

    private IEnumerable<CSR1ListDto> FilteredCSR1List
    {
        get
        {
            IEnumerable<CSR1ListDto> result = csr1List;

            if (!string.IsNullOrWhiteSpace(appliedProgramType))
            {
                result = result.Where(x =>
                    string.Equals(x.ProgramType, appliedProgramType, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(appliedProgramName))
            {
                result = result.Where(x =>
                    string.Equals(x.ProgramName, appliedProgramName, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(appliedStatus))
            {
                result = result.Where(x =>
                    string.Equals(x.Status, appliedStatus, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                result = result.Where(x =>
                    (!string.IsNullOrWhiteSpace(x.ProgramType) &&
                     x.ProgramType.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                    (!string.IsNullOrWhiteSpace(x.ProgramName) &&
                     x.ProgramName.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                    (!string.IsNullOrWhiteSpace(x.Status) &&
                     x.Status.Contains(searchText, StringComparison.OrdinalIgnoreCase)));
            }

            return result.ToList();
        }
    }

    private void OnProgramTypeChanged()
    {
        selectedProgramName = "";
    }

    private void ApplyFilters()
    {
        appliedProgramType = selectedProgramType;
        appliedProgramName = selectedProgramName;
        appliedStatus = selectedStatus;
    }

    private void ClearFilters()
    {
        selectedProgramType = "";
        selectedProgramName = "";
        selectedStatus = "";
        searchText = "";

        appliedProgramType = "";
        appliedProgramName = "";
        appliedStatus = "";
    }

