    private async Task DeleteCSR1(int id)
    {
        try
        {
            using var response = await Http.DeleteAsync($"api/CSR1/{id}");

            if (response.IsSuccessStatusCode)
            {
                await LoadCSR1();
                ShowCSRPopup("CSR-1 deleted successfully.");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"CSR1 Delete Error: {error}");
                ShowCSRPopup(
                    string.IsNullOrWhiteSpace(error)
                        ? "Unable to delete CSR-1."
                        : $"Unable to delete CSR-1. {error}", false);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"CSR1 Delete Error: {ex.Message}");
            ShowCSRPopup($"Unable to delete CSR-1. {ex.Message}", false);
        }
    }

    // The list DTO intentionally uses a string status. Resolve its enum meaning
    // here, so the page handles both enum names and numeric enum values.
    private static bool TryGetCSR1Status(string? raw, out CSR1Status status)
    {
        status = default;
        if (string.IsNullOrWhiteSpace(raw) ||
            !Enum.TryParse(raw.Trim(), true, out status) ||
            !Enum.IsDefined(typeof(CSR1Status), status))
            return false;
        return true;
    }

    private static bool HasCSR1Status(string? raw, CSR1Status expected) =>
        TryGetCSR1Status(raw, out var actual) && actual == expected;

    private static string NormalizeStatus(string? raw) =>
        TryGetCSR1Status(raw, out var status)
            ? status.ToString()
            : raw?.Trim() ?? string.Empty;

    private static string GetStatusClass(string? status)
    {
        if (!TryGetCSR1Status(status, out var current))
            return "csrm-badge csrm-badge-submitted";
        return current switch
        {
            CSR1Status.Approved => "csrm-badge csrm-badge-approved",
            CSR1Status.Validated => "csrm-badge csrm-badge-validated",
            CSR1Status.Rejected => "csrm-badge csrm-badge-rejected",
            CSR1Status.Draft => "csrm-badge csrm-badge-draft",
            _ => "csrm-badge csrm-badge-submitted"
        };
    }

    private static string GetStatusDisplay(string? status)
    {
        if (!TryGetCSR1Status(status, out var current))
            return string.IsNullOrWhiteSpace(status) ? "--" : status.Trim();
        return current == CSR1Status.SubmittedForValidation
            ? "Submitted"
            : current.ToString();
    }

