    private List<CSR1ListDto> csr1List = new();
    private bool isLoading = false;
    private string csr1LoadError = "";

    private DateTime? selectedFromDate;
    private DateTime? selectedToDate;
    private DateTime? appliedFromDate;
    private DateTime? appliedToDate;
    private string filterErrorMessage = "";

    private string selectedProgramType = "";
    private string selectedProgramName = "";
    private string selectedStatus = "";
    private string searchText = "";

    private string appliedProgramType = "";
    private string appliedProgramName = "";
    private string appliedStatus = "";

    private int TotalCSR1 => csr1List.Count;

    private int ApprovedCount => csr1List.Count(x =>
        HasCSR1Status(x.Status, CSR1Status.Approved));

    private int PendingCount => csr1List.Count(x =>
        HasCSR1Status(x.Status, CSR1Status.Pending) ||
        HasCSR1Status(x.Status, CSR1Status.Submitted) ||
        HasCSR1Status(x.Status, CSR1Status.SubmittedForValidation) ||
        HasCSR1Status(x.Status, CSR1Status.Validated));

    private int RejectedCount => csr1List.Count(x =>
        HasCSR1Status(x.Status, CSR1Status.Rejected));

    private int DraftCount => csr1List.Count(x =>
        HasCSR1Status(x.Status, CSR1Status.Draft));

    private IEnumerable<CSR1ListDto> RejectedItems => csr1List.Where(x =>
        HasCSR1Status(x.Status, CSR1Status.Rejected));

    private List<string> ProgramTypes => csr1List
        .Where(x => !string.IsNullOrWhiteSpace(x.ProgramType))
        .Select(x => x.ProgramType.Trim())
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x)
        .ToList();

    private List<string> ProgramNames => csr1List
        .Where(x =>
            string.IsNullOrWhiteSpace(selectedProgramType) ||
            string.Equals(x.ProgramType, selectedProgramType, StringComparison.OrdinalIgnoreCase))
        .Where(x => !string.IsNullOrWhiteSpace(x.ProgramName))
        .Select(x => x.ProgramName.Trim())
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x)
        .ToList();

    private List<string> Statuses => csr1List
        .Where(x => !string.IsNullOrWhiteSpace(x.Status))
        .Select(x => NormalizeStatus(x.Status))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadCSR1();
    }

    private async Task LoadCSR1()
    {
        try
        {
            isLoading = true;
            csr1LoadError = "";

            using var response = await Http.GetAsync("api/CSR1/list");
            var body = await response.Content.ReadAsStringAsync();

            if (!response.IsSuccessStatusCode)
            {
                csr1List = new();
                csr1LoadError =
                    $"Unable to load CSR-1 list. HTTP {(int)response.StatusCode}: {body}";
                Console.WriteLine(csr1LoadError);
                return;
            }

            csr1List = System.Text.Json.JsonSerializer.Deserialize<List<CSR1ListDto>>(
                body,
                new System.Text.Json.JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                }) ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"CSR1 Load Error: {ex.Message}");
            csr1LoadError = $"CSR1 Load Error: {ex.Message}";
            csr1List = new();
        }
        finally
        {
            isLoading = false;
        }
    }

    private IEnumerable<CSR1ListDto> FilteredCSR1List
    {
        get
        {
            IEnumerable<CSR1ListDto> result = csr1List;

            if (appliedFromDate.HasValue)
                result = result.Where(x => x.CSR1Date != default &&
                    x.CSR1Date.Date >= appliedFromDate.Value.Date);

            if (appliedToDate.HasValue)
                result = result.Where(x => x.CSR1Date != default &&
                    x.CSR1Date.Date <= appliedToDate.Value.Date);

            if (!string.IsNullOrWhiteSpace(appliedProgramType))
            {
                result = result.Where(x =>
                    string.Equals(x.ProgramType, appliedProgramType, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(appliedProgramName))
            {
                result = result.Where(x =>
                    string.Equals(x.ProgramName, appliedProgramName, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(appliedStatus))
            {
                result = result.Where(x =>
                    string.Equals(NormalizeStatus(x.Status), NormalizeStatus(appliedStatus), StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                result = result.Where(x =>
                    (!string.IsNullOrWhiteSpace(x.ProgramType) &&
                     x.ProgramType.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                    (!string.IsNullOrWhiteSpace(x.ProgramName) &&
                     x.ProgramName.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                    (!string.IsNullOrWhiteSpace(x.Status) &&
                     NormalizeStatus(x.Status).Contains(searchText, StringComparison.OrdinalIgnoreCase)));
            }

            return result.ToList();
        }
    }

    private void OnProgramTypeChanged()
    {
        selectedProgramName = "";
    }

    private void ApplyFilters()
    {
        filterErrorMessage = "";
        if (selectedFromDate.HasValue && selectedToDate.HasValue &&
            selectedFromDate.Value.Date > selectedToDate.Value.Date)
        {
            filterErrorMessage = "From Date cannot be later than To Date.";
            ShowCSRPopup(filterErrorMessage, false);
            return;
        }

        appliedFromDate = selectedFromDate;
        appliedToDate = selectedToDate;
        appliedProgramType = selectedProgramType;
        appliedProgramName = selectedProgramName;
        appliedStatus = selectedStatus;
    }

    private void ClearFilters()
    {
        selectedFromDate = null;
        selectedToDate = null;
        appliedFromDate = null;
        appliedToDate = null;
        filterErrorMessage = "";
        selectedProgramType = "";
        selectedProgramName = "";
        selectedStatus = "";
        searchText = "";

        appliedProgramType = "";
        appliedProgramName = "";
        appliedStatus = "";
    }

