    private async Task DeleteCSR1(int id)
    {
        try
        {
            var response = await Http.DeleteAsync($"api/CSR1/{id}");

            if (response.IsSuccessStatusCode)
            {
                await LoadCSR1();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"CSR1 Delete Error: {error}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"CSR1 Delete Error: {ex.Message}");
        }
    }

    private static string GetStatusClass(string? status)
    {
        return status?.Trim().ToLowerInvariant() switch
        {
            "approved" => "csrm-badge csrm-badge-approved",
            "validated" => "csrm-badge csrm-badge-validated",
            "rejected" => "csrm-badge csrm-badge-rejected",
            "draft" => "csrm-badge csrm-badge-draft",
            "pending" => "csrm-badge csrm-badge-submitted",
            "submitted" => "csrm-badge csrm-badge-submitted",
            "submittedforvalidation" => "csrm-badge csrm-badge-submitted",
            _ => "csrm-badge csrm-badge-submitted"
        };
    }

    private static string GetStatusDisplay(string? status)
    {
        if (string.Equals(status, "SubmittedForValidation", StringComparison.OrdinalIgnoreCase))
            return "Pending";

        return string.IsNullOrWhiteSpace(status) ? "--" : status;
    }
