@*
    One content card of the Digital Library (AI video, product information or brochure),
    shared by the landing page and the All Content list. Design: Figma "Digital Library".
*@

<article class="dlc-card">
    <a class="dlc-card-imglink" href="@ViewHref" aria-label="@Item.Title">
        <img class="dlc-card-img" src="@Item.Image" alt="" loading="lazy" />
    </a>
    <div class="dlc-card-body">
        <div class="dlc-card-meta">
            <span class="dlc-tag dlc-tag-type">@Item.TypeLabel</span>
            <span class="dlc-tag @(Item.Published ? "dlc-tag-pub" : "dlc-tag-draft")">@(Item.Published ? "Published" : "Draft")</span>
            @if (ShowActions)
            {
                <span class="dlc-card-actions">
                    <button type="button" class="dlc-icon-btn" title="Edit" aria-label="Edit" @onclick="() => OnEdit.InvokeAsync(Item)"><i class="bi bi-pencil"></i></button>
                    <button type="button" class="dlc-icon-btn dlc-icon-danger" title="Delete" aria-label="Delete" @onclick="() => OnDelete.InvokeAsync(Item)"><i class="bi bi-trash"></i></button>
                    <button type="button" class="dlc-icon-btn dlc-icon-archive" title="Archive" aria-label="Archive" @onclick="() => OnArchive.InvokeAsync(Item)"><i class="bi bi-archive"></i></button>
                </span>
            }
        </div>
        <h3 class="dlc-card-title"><a href="@ViewHref">@Item.Title</a></h3>
        <p class="dlc-card-desc">@Item.Description</p>
        <div class="dlc-card-foot">
            <span class="dlc-card-author">@Item.Author <small>@Item.Date.ToString("dd MMM yyyy")</small></span>
            @if (ShowActions)
            {
                <button type="button" class="dlc-btn-publish" @onclick="() => OnTogglePublish.InvokeAsync(Item)">
                    @(Item.Published ? "Unpublish" : "Publish")
                </button>
            }
        </div>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public DigitalLibraryItem Item { get; set; } = default!;
    [Parameter] public bool ShowActions { get; set; } = true;
    [Parameter] public EventCallback<DigitalLibraryItem> OnEdit { get; set; }
    [Parameter] public EventCallback<DigitalLibraryItem> OnDelete { get; set; }
    [Parameter] public EventCallback<DigitalLibraryItem> OnArchive { get; set; }
    [Parameter] public EventCallback<DigitalLibraryItem> OnTogglePublish { get; set; }

    private string ViewHref => $"DigitalLibrary/{Item.Type.ToString().ToLowerInvariant()}?id={Item.Id}";
}
