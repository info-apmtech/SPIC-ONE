@page "/CancelledBookingDetails"

<div class="container-fluid py-4 px-0">
    <div class="cbd-header">
        <div class="cbd-title-group">
            <h1>Cancelled Booking Details <span class="cbd-badge-cancelled">Cancelled</span></h1>
            <p class="cbd-subtitle">Cancellation ID: <span class="cbd-text-red">CAN-2025-0089</span></p>
        </div>
        
        <button class="cbd-btn-outline">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m.75 12 3 3m0 0 3-3m-3 3v-6m-1.5-9H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
            </svg>
            Download Cancellation Receipt
        </button>
    </div>

    <div class="cbd-main-grid">
        
        <div class="cbd-col-left">
            
            <div class="cbd-card">
                <div class="cbd-card-header">
                    <h3>Room Details</h3>
                </div>
                <div class="cbd-card-body">
                    <div class="cbd-room-info">
                        <img src="_content/SPIC.MauiBlazorApp.Shared/Images/Gallery/image12.png" alt="Room" class="cbd-room-img" onerror="this.style.backgroundColor='#cbd5e1';" />
                        <div class="cbd-room-stats">
                            <div class="cbd-row">
                                <span class="cbd-label">Guest House</span>
                                <span class="cbd-value">T-Nagar</span>
                            </div>
                            <div class="cbd-row">
                                <span class="cbd-label">Room Type</span>
                                <span class="cbd-value">AC Deluxe Room</span>
                            </div>
                            <div class="cbd-row">
                                <span class="cbd-label">Room Number</span>
                                <span class="cbd-value">211</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="cbd-card">
                <div class="cbd-card-header">
                    <h3>Check-in & Check-out</h3>
                </div>
                <div class="cbd-card-body">
                    <div class="cbd-check-grid">
                        <div class="cbd-check-col">
                            <h4>Check-in</h4>
                            <div class="cbd-icon-text">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
                                </svg>
                                May 26, 2026
                            </div>
                            <div class="cbd-icon-text">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                                </svg>
                                2 PM
                            </div>
                        </div>
                        <div class="cbd-check-col">
                            <h4>Check-out</h4>
                            <div class="cbd-icon-text">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
                                </svg>
                                May 29, 2026
                            </div>
                            <div class="cbd-icon-text">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                                </svg>
                                12 AM
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="cbd-card">
                <div class="cbd-card-header">
                    <h3>Original Booking Summary</h3>
                </div>
                <div class="cbd-card-body">
                    <div class="cbd-row">
                        <span class="cbd-label">Room Type</span>
                        <span class="cbd-value">AC Deluxe Room</span>
                    </div>
                    <div class="cbd-divider"></div>
                    <div class="cbd-row">
                        <span class="cbd-label">Room Price</span>
                        <span class="cbd-value">₹999.00</span>
                    </div>
                    <div class="cbd-row">
                        <span class="cbd-label">Number of nights</span>
                        <span class="cbd-value">3</span>
                    </div>
                    <div class="cbd-row">
                        <span class="cbd-label">Extra Cot × 1</span>
                        <span class="cbd-value">₹250.00</span>
                    </div>
                    <div class="cbd-divider"></div>
                    <div class="cbd-row">
                        <span class="cbd-label">Subtotal</span>
                        <span class="cbd-value">₹3247.00</span>
                    </div>
                    <div class="cbd-row">
                        <span class="cbd-label">Taxes (12%)</span>
                        <span class="cbd-value">₹120.00</span>
                    </div>
                    <div class="cbd-divider"></div>
                    <div class="cbd-row">
                        <span class="cbd-label">Total</span>
                        <span class="cbd-value cbd-text-blue">₹3367.00</span>
                    </div>
                </div>
            </div>

        </div>

        <div class="cbd-col-right">
            
            <div class="cbd-card">
                <div class="cbd-card-header">
                    <h3>Guest Information</h3>
                </div>
                <div class="cbd-card-body">
                    <div class="cbd-row">
                        <span class="cbd-label">Employee ID / Dealer Code</span>
                        <span class="cbd-value">DL-1234</span>
                    </div>
                    <div class="cbd-row">
                        <span class="cbd-label">Guest Name</span>
                        <span class="cbd-value">Rajesh</span>
                    </div>
                    <div class="cbd-row">
                        <span class="cbd-label">Company Name</span>
                        <span class="cbd-value">SPIC Pvt. ltd.,</span>
                    </div>
                    <div class="cbd-row">
                        <span class="cbd-label">Phone Number</span>
                        <span class="cbd-value">9876543210</span>
                    </div>
                    <div class="cbd-row">
                        <span class="cbd-label">Email ID</span>
                        <span class="cbd-value">hi@gmail.com</span>
                    </div>
                    <div class="cbd-row">
                        <span class="cbd-label">Number of Persons</span>
                        <span class="cbd-value">2 persons</span>
                    </div>
                    <div class="cbd-row">
                        <span class="cbd-label">Nationality</span>
                        <span class="cbd-value">Indian</span>
                    </div>
                    <div class="cbd-row">
                        <span class="cbd-label">Aadhaar / Passport Number</span>
                        <span class="cbd-value">098 765 432 109</span>
                    </div>
                    <div class="cbd-row">
                        <span class="cbd-label">Address</span>
                        <span class="cbd-value" style="max-width: 60%;">No.5, SPIC House, Guindy,<br>Chennai-600022.</span>
                    </div>
                </div>
            </div>

            <div class="cbd-card">
                <div class="cbd-card-header">
                    <h3>Cancellation Details</h3>
                </div>
                <div class="cbd-card-body">
                    <div class="cbd-row">
                        <span class="cbd-label">Cancellation ID</span>
                        <span class="cbd-value cbd-text-red">CAN-2025-0089</span>
                    </div>
                    <div class="cbd-row">
                        <span class="cbd-label">Cancellation Date</span>
                        <span class="cbd-value">27 May 2026 at 10:42 AM</span>
                    </div>
                    <div class="cbd-row">
                        <span class="cbd-label">Cancellation Reason</span>
                        <span class="cbd-value">Change of Plans</span>
                    </div>
                    <div class="cbd-row">
                        <span class="cbd-label">Cancelled By</span>
                        <span class="cbd-value">Rajesh Kumar (Self)</span>
                    </div>
                    <div class="cbd-divider"></div>
                    <div class="cbd-row">
                        <span class="cbd-label">Cancellation Charges</span>
                        <span class="cbd-value cbd-text-red">-₹630</span>
                    </div>
                    <div class="cbd-row">
                        <span class="cbd-label">Refund Amount</span>
                        <span class="cbd-value cbd-text-green">₹2967.00</span>
                    </div>
                    <div class="cbd-row" style="margin-top: 8px; align-items: center;">
                        <span class="cbd-label">Refund Status</span>
                        <span class="cbd-value">
                            <span class="cbd-badge-processing">Processing</span>
                        </span>
                    </div>
                </div>
            </div>

        </div>
    </div>

</div>

