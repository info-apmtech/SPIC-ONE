@code {
    [SupplyParameterFromQuery(Name = "csr2Id")]
    public int? CSR2Id { get; set; }

    // The existing approved-csr2 endpoint already powers StartDocumentation.
    private sealed class DemoProgram
    {
        public int Id { get; set; }
        public int CSR1Id { get; set; }
        public string? ProgramType { get; set; }
        public string? ProgramName { get; set; }
        public string? SeasonNumber { get; set; }
        public string? CSR2Status { get; set; }
        public DateTime? CSR2CompletedDate { get; set; }
        public string? Product { get; set; }
        public string? Crop { get; set; }
        public string? Location { get; set; }
        public string? District { get; set; }
    }

    // API contract needed for saved StartDocumentation data:
    // GET api/DemoDocumentation/documentation-details?csr2Id=26
    // The API must scope this record to the authenticated user and return null/404 if absent.
    private sealed class DocumentationDetails
    {
        public string? Status { get; set; }
        public string? FarmerName { get; set; }
        public string? MobileNumber { get; set; }
        public string? Village { get; set; }
        public string? FarmerAddress { get; set; }
        public string? Crop { get; set; }
        public string? CropType { get; set; }
        public string? State { get; set; }
        public string? District { get; set; }
        public string? PinCode { get; set; }
        public DateTime? SowingDate { get; set; }
        public string? CropStage { get; set; }
        public DateTime? HarvestDate { get; set; }
        public string? Remarks { get; set; }
        public int TreatmentCount { get; set; }
    }


    private sealed class JourneyTreatment
    {
        public int Id { get; set; }
        public int TreatmentNumber { get; set; }
        public string Status { get; set; } = "Draft";
        public DateTime? VisitDate { get; set; }
        public DateTime? TreatmentDate { get; set; }
        public string? FieldOfficerName { get; set; }
        public string? CropStageName { get; set; }
        public string? ProductName { get; set; }
        public string? PlantCondition { get; set; }
        public string? Dosage { get; set; }
        public string? ApplicationMethod { get; set; }
        public string? ApplicationStage { get; set; }
        public string? TreatmentRemarks { get; set; }
        public string? PhysicalParameters { get; set; }
        public string? YieldParameters { get; set; }
        public string? ObservationNotes { get; set; }
        public bool HasProblem { get; set; }
        public string? ProblemCategory { get; set; }
        public string? ProblemDescription { get; set; }
        public string? Severity { get; set; }
        public string? Recommendation { get; set; }
        public string? ActionTaken { get; set; }
        public int ControlPhotoCount { get; set; }
        public int TreatedPhotoCount { get; set; }
        public List<string> QuickObservations { get; set; } = new();
    }

    private readonly List<JourneyTreatment> treatments = new();
    private string journeyError = "";
    private JourneyTreatment? LatestTreatment =>
        treatments.OrderByDescending(t => t.TreatmentNumber).FirstOrDefault();

    private bool IsDocumentationCompleted =>
        string.Equals(doc?.Status, "Completed", StringComparison.OrdinalIgnoreCase);

    private bool CanStartNextTreatment =>
        doc != null && !IsDocumentationCompleted && string.IsNullOrWhiteSpace(journeyError) &&
        LatestTreatment != null &&
        string.Equals(LatestTreatment.Status, "Completed", StringComparison.OrdinalIgnoreCase);

    private void OpenTreatment(int number) =>
        NavigationManager.NavigateTo($"/TreatmentDetails?csr2Id={CSR2Id}&treatmentNumber={number}");

    private void StartNextTreatment()
    {
        if (!CanStartNextTreatment || CSR2Id is null or <= 0) return;
        var nextNumber = LatestTreatment!.TreatmentNumber + 1;
        OpenTreatment(nextNumber);
    }

    private DemoProgram? program;
    private DocumentationDetails? doc;
    private bool isLoading;
    private string error = "";

    private static string Display(params string?[] values) =>
        values.FirstOrDefault(v => !string.IsNullOrWhiteSpace(v)) ?? "-";
    private static string DateText(DateTime? date) => date?.ToString("dd MMM yyyy") ?? "-";
    private void BackToList() => NavigationManager.NavigateTo("/DemoDocumentation");

    protected override async Task OnParametersSetAsync()
    {
        program = null;
        doc = null;
        treatments.Clear();
        journeyError = "";
        error = "";
        if (CSR2Id is null or <= 0) { error = "Missing or invalid csr2Id in the URL."; return; }
        isLoading = true;
        try
        {
            using var response = await Http.GetAsync("api/DemoDocumentation/approved-csr2");
            if (!response.IsSuccessStatusCode)
            {
                error = $"Unable to load approved CSR-2 (HTTP {(int)response.StatusCode}).";
                return;
            }
            var programs = await response.Content.ReadFromJsonAsync<List<DemoProgram>>() ?? new();
            program = programs.FirstOrDefault(x => x.Id == CSR2Id.Value);
            if (program == null)
            {
                error = "CSR-2 not found, not finally approved, or outside your permitted scope.";
                return;
            }

            // Separate endpoint: StartDocumentation data is not included in approved-csr2.
            // 404 is a missing saved record; it is not an excuse to show example farmer values.
            using var detailsResponse = await Http.GetAsync($"api/DemoDocumentation/documentation-details?csr2Id={CSR2Id.Value}");
            if (detailsResponse.IsSuccessStatusCode)
            {
                doc = await detailsResponse.Content.ReadFromJsonAsync<DocumentationDetails>();
                if (doc != null)
                {
                    using var journeyResponse = await Http.GetAsync($"api/DemoDocumentation/treatment/journey?csr2Id={CSR2Id.Value}");
                    if (journeyResponse.IsSuccessStatusCode)
                        treatments.AddRange(await journeyResponse.Content.ReadFromJsonAsync<List<JourneyTreatment>>() ?? new());
                    else
                        journeyError = $"Unable to load Treatment Journey (HTTP {(int)journeyResponse.StatusCode}).";
                }
            }
            else if (detailsResponse.StatusCode != HttpStatusCode.NotFound)
            {
                error = $"Unable to load saved documentation (HTTP {(int)detailsResponse.StatusCode}).";
            }
        }
        catch (Exception ex) { error = $"Unable to load demo details: {ex.Message}"; }
        finally { isLoading = false; }
    }

    private void StartFirstTreatment()
    {
        if (program == null || IsDocumentationCompleted) return;
        // Update this route to the actual treatment page route when available.
        OpenTreatment(1);
    }
}
