@page "/DemoDetails"

<div class="container-fluid py-4 demo-details-page">

    <PageHeader Title="Demo Details"
                Subtitle="Review demo summary and start the first treatment during field visit">
    </PageHeader>


    <div class="demo-card">

        <div class="demo-title-row">
            <span>Farmer / Field Owner</span>
            <span class="tag green">Farmer Program</span>
            <span class="tag blue">Spot Demonstration</span>
        </div>


        <h5>SPIC GRANOZ</h5>


        <div class="info-grid">

            <div>
                <label>Sanction Number</label>
                <b>CSR/2024/TN/0847</b>
            </div>

            <div>
                <label>Crop</label>
                <b>Brinjal</b>
            </div>

            <div>
                <label>Date of Sowing</label>
                <b>15 March 2026</b>
            </div>

            <div>
                <label>Crop Stage</label>
                <span class="stage">Fruit Stage</span>
            </div>

            <div>
                <label>Expected Harvest</label>
                <b>20 Jul 2026</b>
            </div>

        </div>

    </div>



    <div class="demo-card farmer-card">

        <div class="farmer-grid">

            <div>
                <label>Farmer</label>
                <b>M Kanniyappan</b>
            </div>

            <div>
                <label>Mobile Number</label>
                <b>7094100291</b>
            </div>

            <div>
                <label>District</label>
                <b>Kanchipuram</b>
            </div>

            <div>
                <label>State</label>
                <b>Tamil Nadu</b>
            </div>

            <div>
                <label>Pin Code</label>
                <b>603207</b>
            </div>

        </div>


        <div class="location">
            <label>Location</label>
            Maruthamthattam Village, Kanchipuram DT, Tamil Nadu St, 602 307
        </div>

    </div>



    <div class="demo-card treatment-card">

        <h6>Treatment Journey</h6>


        <div class="empty-state">

            <div class="empty-icon">
                <i class="bi bi-flower1"></i>
            </div>


            <h5>
                No Treatment Recorded Yet
            </h5>


            <p>
                Start the first field visit to document treatment details and begin the demo journey.
            </p>


            <button class="btn-start">
                Start First Treatment
            </button>

        </div>


    </div>

</div>
