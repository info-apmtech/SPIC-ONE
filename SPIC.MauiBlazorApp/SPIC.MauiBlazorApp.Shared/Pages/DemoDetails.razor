@page "/DemoDetails"
@inject HttpClient Http
@inject NavigationManager NavigationManager
@using System.Net.Http.Json
@using System.Net
@using Microsoft.AspNetCore.Components

<div class="container-fluid py-4 px-0 demo-details-page">
    <div class="mb-3">
        <h3>Demo Details</h3>
        <p class="text-muted">Review demo summary and start the first treatment during field visit</p>
    </div>

    @if (isLoading)
    {
        <div class="alert alert-info">Loading demo details...</div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger">@error</div>
        <button class="btn btn-outline-secondary" @onclick="BackToList">Back to Demo Documentation</button>
    }
    else if (program != null)
    {
        <div class="demo-card demo-summary-card">
            <div class="demo-title-row">
                <span class="summary-heading">Farmer / Field Owner</span>
                <span class="tag green"><i class="bi bi-circle-fill" aria-hidden="true"></i> @Display(program.ProgramType)</span>
                <span class="tag blue"><i class="bi bi-circle-fill" aria-hidden="true"></i> @Display(program.ProgramName)</span>
            </div>
            <h5>@Display(program.Product)</h5>
            <div class="info-grid">
                <div class="info-item">
                    <i class="bi bi-tools info-icon" aria-hidden="true"></i>
                    <div class="info-content"><label>Sanction Number</label><b>@Display(program.SeasonNumber)</b></div>
                </div>
                <div class="info-item">
                    <i class="bi bi-flower1 info-icon" aria-hidden="true"></i>
                    <div class="info-content"><label>Crop</label><b>@Display(doc?.Crop, program.Crop)</b></div>
                </div>
                <div class="info-item">
                    <i class="bi bi-calendar3 info-icon" aria-hidden="true"></i>
                    <div class="info-content"><label>Date of Sowing:</label><b>@DateText(doc?.SowingDate)</b></div>
                </div>
                <div class="info-item">
                    <i class="bi bi-bullseye info-icon" aria-hidden="true"></i>
                    <div class="info-content"><label>Crop Stage:</label><span class="stage">@Display(doc?.CropStage)</span></div>
                </div>
                <div class="info-item">
                    <i class="bi bi-calendar3 info-icon" aria-hidden="true"></i>
                    <div class="info-content"><label>Expected Harvest:</label><b>@DateText(doc?.HarvestDate)</b></div>
                </div>
            </div>
        </div>

        <div class="demo-card farmer-card">
            @if (doc == null)
            {
                <div class="alert alert-warning mb-3">Farmer and crop documentation is not available yet. The Start Documentation form must save its inputs to the backend before these values can appear here.</div>
            }
            <div class="farmer-grid">
                <div><label>Farmer</label><b>@Display(doc?.FarmerName)</b></div>
                <div><label>Mobile Number</label><b>@Display(doc?.MobileNumber)</b></div>
                <div><label>District</label><b>@Display(doc?.District, program.District)</b></div>
                <div><label>State</label><b>@Display(doc?.State)</b></div>
                <div><label>Pin Code</label><b>@Display(doc?.PinCode)</b></div>
            </div>
            <div class="location">
                <label>Location</label>
                <div class="location-value">@Display(doc?.FarmerAddress, doc?.Village, program.Location)</div>
            </div>
        </div>

        <div class="demo-card treatment-card">
            <h6>Treatment Journey</h6>
            @if (doc == null)
            {
                <div class="empty-state">
                    <p>Treatment history is unavailable until the documentation details endpoint returns a record.</p>
                </div>
            }
            else if (doc.TreatmentCount == 0)
            {
                <div class="empty-state">
                    <div class="empty-icon"><i class="bi bi-flower1"></i></div>
                    <h5>No Treatment Recorded Yet</h5>
                    <p>Start the first field visit to document treatment details and begin the demo journey.</p>
                    <button type="button" class="btn-start" @onclick="StartFirstTreatment">Start First Treatment</button>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <h5>@doc.TreatmentCount treatment(s) recorded</h5>
                    <p>Continue to the treatment journey to review or add field visits.</p>
                    <button type="button" class="btn-start" @onclick="StartFirstTreatment">View Treatments</button>
                </div>
            }
        </div>
    }
</div>

