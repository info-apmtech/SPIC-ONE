@page "/DemoDetails"
@inject HttpClient Http
@inject NavigationManager NavigationManager
@using System.Net.Http.Json
@using System.Net
@using Microsoft.AspNetCore.Components

<div class="container-fluid py-4 px-0 demo-details-page">
    <div class="demo-page-heading mb-3" id="demo-page-top">
        <div>
            <h3>Demo Details</h3>
            <p class="text-muted">Review demo summary and start the first treatment during field visit</p>
        </div>
        @if (!isLoading && string.IsNullOrWhiteSpace(error) && doc != null &&
             string.IsNullOrWhiteSpace(journeyError) && treatments.Count > 0 && !IsDocumentationCompleted)
        {
            <div class="demo-heading-actions">
                <a class="demo-outline-action" href="/DemoDocumentation">
                    <i class="bi bi-arrow-left" aria-hidden="true"></i>
                    Back to Demo Details
                </a>
                <a class="demo-outline-action" href="/DemoDocumentation">
                    <i class="bi bi-clock-history" aria-hidden="true"></i> Treatment History
                </a>
                @if (CanStartNextTreatment)
                {
                    <button type="button" class="demo-primary-action" @onclick="StartNextTreatment">
                        Start Next Treatment <i class="bi bi-arrow-right" aria-hidden="true"></i>
                    </button>
                }
            </div>
        }
    </div>

    @if (isLoading)
    {
        <div class="alert alert-info">Loading demo details...</div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger">@error</div>
        <button class="btn btn-outline-secondary" @onclick="BackToList">Back to Demo Documentation</button>
    }
    else if (program != null)
    {
        <div id="demo-summary" class="demo-card demo-summary-card">
            <div class="demo-title-row">
                <span class="summary-heading">Farmer / Field Owner</span>
                <span class="tag green"><i class="bi bi-circle-fill" aria-hidden="true"></i> @Display(program.ProgramType)</span>
                <span class="tag blue"><i class="bi bi-circle-fill" aria-hidden="true"></i> @Display(program.ProgramName)</span>
            </div>
            <h5>@Display(program.Product)</h5>
            <div class="info-grid">
                <div class="info-item">
                    <i class="bi bi-tools info-icon" aria-hidden="true"></i>
                    <div class="info-content"><label>Sanction Number</label><b>@Display(program.SeasonNumber)</b></div>
                </div>
                <div class="info-item">
                    <i class="bi bi-flower1 info-icon" aria-hidden="true"></i>
                    <div class="info-content"><label>Crop</label><b>@Display(doc?.Crop, program.Crop)</b></div>
                </div>
                <div class="info-item">
                    <i class="bi bi-calendar3 info-icon" aria-hidden="true"></i>
                    <div class="info-content"><label>Date of Sowing:</label><b>@DateText(doc?.SowingDate)</b></div>
                </div>
                <div class="info-item">
                    <i class="bi bi-bullseye info-icon" aria-hidden="true"></i>
                    <div class="info-content"><label>Crop Stage:</label><span class="stage">@Display(doc?.CropStage)</span></div>
                </div>
                <div class="info-item">
                    <i class="bi bi-calendar3 info-icon" aria-hidden="true"></i>
                    <div class="info-content"><label>Expected Harvest:</label><b>@DateText(doc?.HarvestDate)</b></div>
                </div>
            </div>
        </div>

        <div class="demo-card farmer-card">
            @if (doc == null)
            {
                <div class="alert alert-warning mb-3">Farmer and crop documentation is not available yet. The Start Documentation form must save its inputs to the backend before these values can appear here.</div>
            }
            <div class="farmer-grid">
                <div><label>Farmer</label><b>@Display(doc?.FarmerName)</b></div>
                <div><label>Mobile Number</label><b>@Display(doc?.MobileNumber)</b></div>
                <div><label>District</label><b>@Display(doc?.District, program.District)</b></div>
                <div><label>State</label><b>@Display(doc?.State)</b></div>
                <div><label>Pin Code</label><b>@Display(doc?.PinCode)</b></div>
            </div>
            <div class="location">
                <label>Location</label>
                <div class="location-value">@Display(doc?.FarmerAddress, doc?.Village, program.Location)</div>
            </div>
        </div>

        <div id="treatment-journey" class="demo-card treatment-card">
            <div class="treatment-journey-header">
                <h6>Treatment Journey</h6>
                <span class="treatments-done-badge">Treatments Done <strong>@treatments.Count(t => t.Status == "Completed").ToString("00")</strong></span>
            </div>
            @if (doc == null)
            {
                <div class="empty-state"><p>Treatment history is unavailable until documentation details have been saved.</p></div>
            }
            else if (!string.IsNullOrWhiteSpace(journeyError))
            {
                <div class="alert alert-warning">@journeyError</div>
            }
            else if (treatments.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-icon"><i class="bi bi-flower1"></i></div>
                    <h5>No Treatment Recorded Yet</h5>
                    <p>Start the first field visit to document treatment details and begin the demo journey.</p>
                    <button type="button" class="btn-start" @onclick="StartFirstTreatment">Start First Treatment</button>
                </div>
            }
            else
            {
                <div class="treatment-journey-list">
                    @foreach (var item in treatments.OrderBy(t => t.TreatmentNumber))
                    {
                        <div class="journey-row" @key="item.Id">
                            <div class="journey-number">@item.TreatmentNumber.ToString("00")</div>
                            <div class="journey-body">
                                <div class="journey-title-row">
                                    <div class="journey-title-wrap">
                                        <strong>Treatment @item.TreatmentNumber.ToString("00")</strong>
                                        <span class="journey-status @(item.Status == "Completed" ? "completed" : "draft")">@item.Status</span>
                                    </div>
                                    <button type="button" class="journey-view-btn" @onclick="() => OpenTreatment(item.TreatmentNumber)">View Details</button>
                                </div>
                                <div class="journey-info-grid">
                                    <div class="journey-info-item"><label>Visit Date</label><div>@DateText(item.VisitDate)</div></div>
                                    <div class="journey-info-item"><label>Plant Stage</label><div>@Display(item.CropStageName)</div></div>
                                    <div class="journey-info-item"><label>Dosage</label><div>@Display(item.Dosage)</div></div>
                                    <div class="journey-info-item"><label>Remarks</label><div>@Display(item.TreatmentRemarks)</div></div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

