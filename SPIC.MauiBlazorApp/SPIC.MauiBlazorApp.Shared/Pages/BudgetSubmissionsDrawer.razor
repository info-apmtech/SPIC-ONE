@using SPIC.Core.DTOs
@* native: BottomSheet = bottom sheet on phone, right-side drawer on tablet/desktop.
   The former .pd-overlay/.pd-drawer/.pd-header markup is replaced by the sheet's own chrome;
   the body sections and footer buttons are unchanged. *@
@using SPIC.Core.DTOs

<BottomSheet IsOpen="IsOpen"
             IsOpenChanged="OnSheetOpenChanged"
             Title="Budget Submission Details"
             Subtitle="@(Submission?.ProgramName ?? "")"
             Size="BottomSheet.SheetSize.Full"
             CssClass="pd-sheet">

    <ChildContent>

        <div class="pd-body pd-body--sheet">

            @if (Submission == null)
            {
                <div class="pd-section">
                    <div class="pd-info-card">
                        <span class="pd-value">
                            No submission selected.
                        </span>
                    </div>
                </div>
            }
            else
            {
                <!-- Program Information -->
                <div class="pd-section">

                    <h3>Program Information</h3>

                    <div class="pd-info-card">

                        <div class="pd-row">
                            <span class="pd-label">Program Type:</span>

                            <span class="pd-value">
                                @Submission.ProgramType
                            </span>
                        </div>


                        <div class="pd-row">
                            <span class="pd-label">Program Name:</span>

                            <span class="pd-value">
                                @Submission.ProgramName
                            </span>
                        </div>


                        <div class="pd-row">
                            <span class="pd-label">Total Budget:</span>

                            <span class="pd-value">
                                ₹@Submission.TotalBudget.ToString("N0")
                            </span>
                        </div>


                        <div class="pd-row">
                            <span class="pd-label">Submitted Date:</span>

                            <span class="pd-value">
                                @Submission.SubmittedDate.ToString("dd MMM yyyy")
                            </span>
                        </div>


                        <div class="pd-row">
                            <span class="pd-label">Validation Due:</span>

                            <span class="pd-value">
                                @(Submission.ValidationDue?.ToString("dd MMM yyyy") ?? "-")
                            </span>
                        </div>


                        <div class="pd-row">

                            <span class="pd-label">Status:</span>

                            <span class="pd-value">

                                <span class="@GetDrawerStatusClass(Submission.Status)">
                                    @Submission.Status
                                </span>

                            </span>

                        </div>

                    </div>

                </div>


                <!-- Budget Validation -->
                <div class="pd-section">

                    <h3>Budget Details</h3>

                    <div class="pd-validation-grid">

                        <div class="pd-val-card">

                            <span class="pd-val-label">
                                Total Budget
                            </span>

                            <span class="pd-val-value">
                                ₹@Submission.TotalBudget.ToString("N0")
                            </span>

                        </div>


                        <div class="pd-val-card">

                            <span class="pd-val-label">
                                Status
                            </span>

                            <span class="pd-val-value">
                                @Submission.Status
                            </span>

                        </div>


                        <div class="pd-val-card">

                            <span class="pd-val-label">
                                Submitted Date
                            </span>

                            <span class="pd-val-value">
                                @Submission.SubmittedDate.ToString("dd MMM yyyy")
                            </span>

                        </div>


                        <div class="pd-val-card">

                            <span class="pd-val-label">
                                Validation Due
                            </span>

                            <span class="pd-val-value">
                                @(Submission.ValidationDue?.ToString("dd MMM yyyy") ?? "-")
                            </span>

                        </div>

                    </div>

                </div>
            }

        </div>

    </ChildContent>


    <Footer>

        <button type="button"
                class="pd-btn-action pd-btn-print">

            <svg xmlns="http://www.w3.org/2000/svg"
                 width="16"
                 height="16"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 stroke-linecap="round"
                 stroke-linejoin="round">

                <polyline points="6 9 6 2 18 2 18 9"></polyline>

                <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2">
                </path>

                <rect x="6"
                      y="14"
                      width="12"
                      height="8">
                </rect>

            </svg>

            Print

        </button>


        <button type="button"
                class="pd-btn-action pd-btn-export">

            <svg xmlns="http://www.w3.org/2000/svg"
                 width="16"
                 height="16"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 stroke-linecap="round"
                 stroke-linejoin="round">

                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4">
                </path>

                <polyline points="7 10 12 15 17 10">
                </polyline>

                <line x1="12"
                      y1="15"
                      x2="12"
                      y2="3">
                </line>

            </svg>

            Export PDF

        </button>

    </Footer>

</BottomSheet>


@code {

    [Parameter]
    public bool IsOpen { get; set; }


    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }


    [Parameter]
    public BudgetSubmissionDto? Submission { get; set; }


    private async Task OnSheetOpenChanged(bool open)
    {
        IsOpen = open;

        await IsOpenChanged.InvokeAsync(IsOpen);
    }


    private string GetDrawerStatusClass(string? status)
    {
        return status switch
        {
            "Approved" =>
                "pd-badge pd-badge-approved",

            "Rejected" =>
                "pd-badge pd-badge-rejected",

            "Draft" =>
                "pd-badge pd-badge-draft",

            "Submitted" =>
                "pd-badge pd-badge-submitted",

            "Validated" =>
                "pd-badge pd-badge-approved",

            _ =>
                "pd-badge"
        };
    }
}
