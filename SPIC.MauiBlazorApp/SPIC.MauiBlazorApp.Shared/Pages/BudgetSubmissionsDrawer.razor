                    </div>
                </div>

                <!-- Expense Breakdown -->
                <div class="pd-section">
                    <h3>Expense Breakdown</h3>
                    <div class="pd-table-container">
                        <table class="pd-table">
                            <thead>
                                <tr>
                                    <th>Category</th>
                                    <th>APPROVED</th>
                                    <th>Actual</th>
                                    <th>Variance</th>
                                    <th>Act</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="pd-cat-name">Train & Capacity Building</td>
                                    <td>₹ 3,32,3232</td>
                                    <td>₹ 3,32,3232</td>
                                    <td class="pd-var-green">₹ 5,000</td>
                                    <td>
                                        <button class="pd-table-btn" title="Download">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                                        </button>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="pd-cat-name">Equipment & Machinery</td>
                                    <td>₹ 3,32,3232</td>
                                    <td>₹ 3,32,3232</td>
                                    <td class="pd-var-red">+ ₹ 20,000</td>
                                    <td>
                                        <button class="pd-table-btn" title="Download">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                                        </button>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="pd-cat-name">Sends & Inputs</td>
                                    <td>₹ 3,32,3232</td>
                                    <td>₹ 3,32,3232</td>
                                    <td class="pd-var-green">₹ 5,000</td>
                                    <td>
                                        <button class="pd-table-btn" title="Download">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                                        </button>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="pd-cat-name">Infrastructure Development</td>
                                    <td>₹ 3,32,3232</td>
                                    <td>₹ 3,32,3232</td>
                                    <td class="pd-var-red">₹ 30,000</td>
                                    <td>
                                        <button class="pd-table-btn" title="Download">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                                        </button>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="pd-cat-name">Marketing & Outreach</td>
                                    <td>₹ 3,32,3232</td>
                                    <td>₹ 3,32,3232</td>
                                    <td class="pd-var-green">₹ 5,000</td>
                                    <td>
                                        <button class="pd-table-btn" title="Download">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Budget Validation -->
                <div class="pd-section">
                    <h3>Budget Validation</h3>
                    <div class="pd-validation-grid">
                        <div class="pd-val-card">
                            <span class="pd-val-label">Approved Budget</span>
                            <span class="pd-val-value">₹ 8,00,000</span>
                        </div>
                        <div class="pd-val-card">
                            <span class="pd-val-label">Total Expense</span>
                            <span class="pd-val-value">₹ 7,25,500</span>
                        </div>
                        <div class="pd-val-card">
                            <span class="pd-val-label">Remainder Amount</span>
                            <span class="pd-val-value pd-val-green">₹ 74,500</span>
                        </div>
                        <div class="pd-val-card">
                            <span class="pd-val-label">Budget Utilization</span>
                            <span class="pd-val-util-value">96.69%</span>
                            <div class="pd-val-progress-bar">
                                <div class="pd-val-progress-fill" style="width: 96.69%;"></div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Drawer Footer -->
            <div class="pd-footer">
                <button class="pd-btn-action pd-btn-print">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 6 2 18 2 18 9"></polyline>
                        <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
