@page "/farmer/login"
@layout SPIC.MauiBlazorApp.Shared.Layout.EmptyLayout
@implements IDisposable
@using SPIC.Core.FarmerPortal
@inject FarmerApi Api
@inject FarmerSession Farmer
@inject HttpClient Http
@inject ISessionStore SessionStore
@inject LoginState LoginState
@inject NavigationManager Nav

@*
    Farmer sign-in (docs/farmer-portal.md): step 1 mobile number, step 2 the 6-digit code from the
    SMS. The session is stored exactly like the normal login (Services/SessionPersistence), then
    the farmer goes to onboarding (first time) or the farmer home. Staff and dealers use /login.
    Layout (Task 1b): desktop / tablet brand panel left + card right; phone brand band on top with
    the card overlapping it.
*@

<PageTitle>Farmer sign in | SPIC ONE</PageTitle>

<div class="fp fp-page fpl">
    @if (!_sessionChecked)
    {
        @* Checking for a saved session first, so a signed-in farmer is not shown the form. *@
        <main class="fpl-main" aria-busy="true"></main>
    }
    else
    {
        <aside class="fpl-brand" aria-label="SPIC ONE for farmers">
            <div class="fpl-brand__mark">
                <img src="_content/SPIC.MauiBlazorApp.Shared/Images/LoginImages/logo.png" alt="SPIC" class="fpl-logo" />
                <div class="fpl-wordmark">
                    <span class="fpl-wordmark__name">SPIC <strong>ONE</strong></span>
                    <span class="fpl-wordmark__tag">for farmers</span>
                </div>
            </div>

            <div class="fpl-brand__body">
                <h1 class="fpl-brand__title">Better soil. <br />Better harvest.</h1>
                <p class="fpl-brand__text">Advice for your soil and crop, SPIC dealers near you and help from SPIC experts, in one app.</p>
                <FpArt Kind="FpArtKind.Field" CssClass="fpl-art" />
                <ul class="fpl-points">
                    <li>
                        <span class="fpl-points__icon" aria-hidden="true"><i class="bi bi-moisture"></i></span>
                        <span><strong>Soil advice</strong><small>Soil test reports and fertilizer advice for your field</small></span>
                    </li>
                    <li>
                        <span class="fpl-points__icon" aria-hidden="true"><i class="bi bi-shop"></i></span>
                        <span><strong>Dealers near you</strong><small>Find SPIC dealers close to your village</small></span>
                    </li>
                    <li>
                        <span class="fpl-points__icon" aria-hidden="true"><i class="bi bi-person-badge"></i></span>
                        <span><strong>Expert help</strong><small>Reach your SPIC field team when you need them</small></span>
                    </li>
                </ul>
            </div>

            <p class="fpl-brand__foot">Southern Petrochemical Industries Corporation</p>
        </aside>

        <main class="fpl-main">
            <section class="fpl-card fp-fade-up" aria-labelledby="fpl-title">
                <FpSteps Steps="@StepNames" Current="@(_step == Step.Phone ? 0 : 1)" CssClass="fpl-steps" AriaLabel="Sign-in progress" />

                @if (_step == Step.Phone)
                {
                    <h2 id="fpl-title" class="fpl-title">Sign in with your mobile</h2>
                    <p class="fpl-sub">We will send a 6-digit code by SMS. No password needed.</p>

                    <form @onsubmit="SendCodeAsync" @onsubmit:preventDefault novalidate>
                        <label for="fpl-phone" class="fp-label">Mobile number</label>
                        <div class="fp-input-group fpl-phone @(_error is not null ? "is-invalid" : null)">
                            <span class="fp-input-addon fpl-prefix" aria-hidden="true">+91</span>
                            <input id="fpl-phone" class="fp-input fpl-phone-input" type="tel" inputmode="numeric"
                                   autocomplete="tel-national" maxlength="14" placeholder="98765 43210"
                                   value="@_phoneInput" @oninput="e => _phoneInput = e.Value?.ToString() ?? string.Empty"
                                   aria-invalid="@(_error is not null ? "true" : "false")" aria-describedby="fpl-error" />
                        </div>

                        @if (_error is not null)
                        {
                            <p id="fpl-error" class="fp-field-error fpl-error" role="alert"><i class="bi bi-exclamation-circle-fill" aria-hidden="true"></i> @_error</p>
                        }

                        <label class="fp-check fpl-remember">
                            <input type="checkbox" @bind="_remember" />
                            Keep me signed in on this device
                        </label>

                        <button type="submit" class="fp-btn fp-btn--primary fp-btn--block fpl-submit" disabled="@_busy">
                            @if (_busy)
                            {
                                <span class="fp-spinner" aria-hidden="true"></span>
                                <span>Sending code...</span>
                            }
                            else
                            {
                                <span>Send code</span>
                                <i class="bi bi-arrow-right" aria-hidden="true"></i>
                            }
                        </button>
                    </form>
                }
                else
                {
                    <h2 id="fpl-title" class="fpl-title">Enter the code</h2>
                    <p class="fpl-sub">
                        Sent by SMS to <strong class="fp-num">+91 @FormatPhone(_phone)</strong>
                        <button type="button" class="fp-link-btn fpl-change" @onclick="ChangeNumber">Change</button>
                    </p>

                    @if (_devCode is not null)
                    {
                        <p class="fp-alert fp-alert--dev fpl-dev" role="note" data-dev-code="@_devCode">
                            <i class="bi bi-wrench-adjustable" aria-hidden="true"></i>
                            <span>Development only: your code is <strong class="fp-num">@_devCode</strong></span>
                        </p>
                    }

                    <form @onsubmit="VerifyAsync" @onsubmit:preventDefault novalidate>
                        <label for="fpl-code" class="fp-label">6-digit code</label>
                        <FpOtpInput @ref="_otp" Id="fpl-code" Value="@_code" ValueChanged="OnCodeChanged" OnComplete="OnCodeComplete"
                                    Invalid="@(_error is not null)" Disabled="@_busy" AriaDescribedBy="fpl-error" />

                        @if (_error is not null)
                        {
                            <p id="fpl-error" class="fp-field-error fpl-error" role="alert"><i class="bi bi-exclamation-circle-fill" aria-hidden="true"></i> @_error</p>
                        }
                        @if (_info is not null)
                        {
                            <p class="fp-hint fp-hint--ok fpl-info" aria-live="polite"><i class="bi bi-check-circle-fill" aria-hidden="true"></i> @_info</p>
                        }

                        <button type="submit" class="fp-btn fp-btn--primary fp-btn--block fpl-submit" disabled="@(_busy || _code.Length != FarmerOtpRules.CodeLength)">
                            @if (_busy)
                            {
                                <span class="fp-spinner" aria-hidden="true"></span>
                                <span>Checking...</span>
                            }
                            else
                            {
                                <span>Verify and sign in</span>
                            }
                        </button>
                    </form>

                    <div class="fpl-resend" aria-live="polite">
                        @if (_resendLeft > 0)
                        {
                            <span class="fp-countdown">
                                <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true">
                                    <circle class="fp-countdown__track" cx="11" cy="11" r="9" />
                                    <circle class="fp-countdown__value" cx="11" cy="11" r="9"
                                            stroke-dasharray="56.55" stroke-dashoffset="@CountdownOffset" />
                                </svg>
                                <span>New code in <strong>@FpUi.Countdown(_resendLeft)</strong></span>
                            </span>
                        }
                        else
                        {
                            <span>Did not get the SMS?</span>
                            <button type="button" class="fp-link-btn" @onclick="ResendAsync" disabled="@_busy">Send a new code</button>
                        }
                    </div>
                }

                <p class="fpl-staff">
                    <i class="bi bi-building" aria-hidden="true"></i>
                    SPIC staff or dealer? <a href="/login">Use the staff login</a>
                </p>
            </section>
        </main>
    }
</div>

@code {
    private enum Step { Phone, Code }

    private static readonly string[] StepNames = { "Mobile number", "Verify code" };

    private bool _sessionChecked;
    private Step _step = Step.Phone;
    private string _phoneInput = "";
    private string _phone = "";
    private string _code = "";
    private string? _error;
    private string? _info;
    private string? _devCode;
    private bool _busy;
    private bool _remember = true;
    private int _resendLeft;
    private int _resendTotal = 30;
    private Timer? _timer;
    private FpOtpInput? _otp;
    private bool _focusCode;

    // 56.55 = circumference of the r=9 countdown ring; the ring empties as the seconds run out.
    private string CountdownOffset =>
        (56.55 * (1 - (double)_resendLeft / Math.Max(1, _resendTotal))).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // Same restore as the normal login page: a signed-in user goes straight to their home.
                if (await SessionPersistence.TryRestoreAsync(SessionStore, LoginState))
                {
                    Nav.NavigateTo(LoginState.LandingPage, replace: true);
                    return;
                }
            }
            catch
            {
                // Fall through to the form.
            }
            _sessionChecked = true;
            StateHasChanged();
            return;
        }

        if (_focusCode && _otp is not null)
        {
            _focusCode = false;
            await _otp.FocusAsync();
        }
    }

    private async Task SendCodeAsync()
    {
        if (_busy) return;
        _error = null;
        _info = null;

        var phone = FarmerPhone.Normalise(_phoneInput);
        if (!FarmerPhone.IsValid(phone))
        {
            _error = "Please enter your 10-digit mobile number. It starts with 6, 7, 8 or 9.";
            return;
        }

        _busy = true;
        try
        {
            var result = await Api.RequestOtpAsync(phone);
            if (!result.Ok)
            {
                // A code already went to this number moments ago: let the farmer type it.
                if (result.ResendInSeconds is > 0 and <= 30 && phone == _phone)
                {
                    ShowCodeStep(phone, result.ResendInSeconds, devCode: _devCode);
                    _info = result.Message;
                    return;
                }
                _error = result.Message;
                return;
            }
            ShowCodeStep(phone, result.ResendInSeconds, result.DevCode);
        }
        finally
        {
            _busy = false;
        }
    }

    private void ShowCodeStep(string phone, int resendIn, string? devCode)
    {
        _phone = phone;
        _code = "";
        _devCode = devCode;
        _step = Step.Code;
        _focusCode = true;
        StartCountdown(resendIn);
    }

    private async Task ResendAsync()
    {
        if (_busy || _resendLeft > 0) return;
        _error = null;
        _info = null;
        _busy = true;
        try
        {
            var result = await Api.RequestOtpAsync(_phone);
            if (!result.Ok)
            {
                _error = result.Message;
                if (result.ResendInSeconds > 0) StartCountdown(result.ResendInSeconds);
                return;
            }
            _code = "";
            _devCode = result.DevCode;
            _info = "A new code is on its way. Please use the newest SMS.";
            _focusCode = true;
            StartCountdown(result.ResendInSeconds);
        }
        finally
        {
            _busy = false;
        }
    }

    private void OnCodeChanged(string code)
    {
        _code = code;
        _error = null;
    }

    // Six digits typed, pasted or filled from the SMS: check straight away.
    private Task OnCodeComplete(string code)
    {
        _code = code;
        return VerifyAsync();
    }

    private async Task VerifyAsync()
    {
        if (_busy) return;
        if (!FarmerOtpRules.IsWellFormedCode(_code))
        {
            _error = "Please enter the 6-digit code from the SMS.";
            return;
        }

        _busy = true;
        _error = null;
        _info = null;
        try
        {
            var result = await Api.VerifyOtpAsync(_phone, _code);
            var session = result.Session;
            if (session is null)
            {
                // Wrong / expired code: empty boxes, cursor back in the first one.
                _error = result.Message;
                _code = "";
                _focusCode = true;
                return;
            }

            await SessionPersistence.StartAsync(Http, SessionStore, LoginState, session.Token, session.Expiration,
                session.RoleAccess, session.DesignationName, session.RefreshToken, _remember);
            Farmer.Reset();

            Nav.NavigateTo(session.ProfileComplete ? LoginState.FarmerLandingPath : "/farmer/onboarding");
        }
        catch (Exception)
        {
            _error = "Something went wrong while signing you in. Please try again.";
        }
        finally
        {
            _busy = false;
        }
    }

    private void ChangeNumber()
    {
        _step = Step.Phone;
        _error = null;
        _info = null;
        _code = "";
        _phoneInput = _phone;
    }

    private void StartCountdown(int seconds)
    {
        _timer?.Dispose();
        _resendLeft = Math.Max(0, seconds);
        _resendTotal = Math.Max(_resendLeft, 1);
        if (_resendLeft == 0) return;
        _timer = new Timer(_ =>
        {
            if (_resendLeft <= 0) return;
            _resendLeft--;
            if (_resendLeft <= 0) _timer?.Dispose();
            _ = InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private static string FormatPhone(string phone) => phone.Length == 10 ? $"{phone[..5]} {phone[5..]}" : phone;

    public void Dispose() => _timer?.Dispose();
}
