@page "/farmer/onboarding"
@using SPIC.Core.DTOs
@using SPIC.Core.Entities
@inject FarmerSession Farmer
@inject LoginState LoginState
@inject NavigationManager Nav
@inject ToastService Toast

@* First-time farmer profile in three steps (docs/farmer-portal.md). Saving goes to the farmer home. *@

<div class="fp fp-page fpo">
    <FpHero Title="Welcome to SPIC ONE" Eyebrow="Set up your account" DocumentTitle="Welcome"
            Subtitle="Three quick steps about you, your farm and your village. It takes a minute." />

    @if (LoginState.UserRole != AppRole.Farmer)
    {
        <FpEmpty Art="FpArtKind.Team" Title="Farmer onboarding"
                 Message="Farmers fill this form the first time they sign in. Support staff have no farmer profile." />
    }
    else if (_loading)
    {
        <FpSkeleton Variant="FpSkeletonVariant.Form" Count="4" LoadingText="Loading..." CssClass="fpo-skel" />
    }
    else if (_error is not null)
    {
        <FpError Title="We could not open the form" Message="@_error" OnRetry="LoadAsync" />
    }
    else
    {
        <FarmerProfileForm Stepped="true" Initial="@Farmer.Profile" Phone="@Farmer.Phone" SubmitLabel="Save and continue" OnSaved="SavedAsync" />
        <p class="fp-caption fpo-note"><i class="bi bi-shield-check" aria-hidden="true"></i> <span>Fields marked <span class="fp-req">*</span> are needed. You can change everything later in My profile.</span></p>
    }
</div>

@code {
    private bool _loading = true;
    private string? _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        if (LoginState.UserRole != AppRole.Farmer)
        {
            _loading = false;
            return;
        }
        _loading = true;
        _error = null;
        var ok = await Farmer.EnsureLoadedAsync();
        _loading = false;
        if (!ok) _error = Farmer.LoadError ?? "Please check your internet connection and try again.";
    }

    private Task SavedAsync(FarmerProfileDto profile)
    {
        Farmer.Update(profile);
        Toast.Success("Your profile is saved.");
        Nav.NavigateTo(LoginState.FarmerLandingPath);
        return Task.CompletedTask;
    }
}
