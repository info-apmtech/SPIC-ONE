@page "/farmer"
@using SPIC.Core.Entities
@inject FarmerSession Farmer
@inject LoginState LoginState
@inject NavigationManager Nav
@inject FarmerConnectApi Api

@*
    Farmer home. Task 1b: greeting hero (IST time of day), highlight card and the tile grid from
    Services/FarmerFeatureTiles (only features that exist; each later task adds its own tile).
    Task 2: the "Your SPIC team" block (up to 3 people from api/Farmer/contacts, loaded after the
    page so the home never waits for it) with Request call back. Sends a farmer whose profile is not
    complete to /farmer/onboarding.
    Admin / SuperAdmin may open it for support (RouteAccess) but have no farmer profile of their own.
*@

<div class="fp fp-page fph">
    @if (LoginState.UserRole != AppRole.Farmer)
    {
        <FpHero Title="Farmer portal" Subtitle="What farmers see after they sign in with their mobile number." />
        <FpEmpty Art="FpArtKind.Team" Title="You are viewing as support staff"
                 Message="Farmers see their own home here. Support staff have no farmer profile, so there is nothing to show." />
    }
    else if (_loading)
    {
        <PageTitle>Home · SPIC ONE</PageTitle>
        <FpSkeleton Variant="FpSkeletonVariant.Home" LoadingText="Loading your home..." />
    }
    else if (_error is not null)
    {
        <PageTitle>Home · SPIC ONE</PageTitle>
        <FpError Title="We could not load your home" Message="@_error" OnRetry="() => LoadAsync(force: true)" />
    }
    else if (Farmer.Profile is { } profile)
    {
        var now = DateTime.UtcNow;
        <FpHero Eyebrow="@FpUi.IstDateLine(now)" Title="@($"{FpUi.Greeting(now)}, {FpUi.ShortName(profile.Name)}")"
                DocumentTitle="Home" Subtitle="Your farm, your soil and your SPIC services in one place.">
            <Aside>
                <a class="fp-avatar fph-avatar" href="/farmer/profile" aria-label="My profile" title="My profile">@FpUi.Initials(profile.Name)</a>
            </Aside>
            <ChildContent>
                <FpChip Icon="bi-geo-alt-fill" Text="@Place(profile)" />
                @if (profile.LandAcres is { } acres)
                {
                    <FpChip Icon="bi-bounding-box" Text="@($"{acres:0.##} acres")" />
                }
                @foreach (var crop in profile.PrimaryCrops.Take(3))
                {
                    <FpChip Emoji="@FpUi.CropEmoji(crop)" Icon="bi-flower1" Text="@crop" />
                }
            </ChildContent>
        </FpHero>

        @if (_soilTests)
        {
            <FpCard Variant="FpCardVariant.Highlight" Title="Your soil tests" Subtitle="Samples your SPIC officer collected and your soil reports"
                    Icon="bi-moisture" Hue="FpHue.Soil" CssClass="fp-fade-up-2 fph-highlight">
                <div class="fp-row">
                    <a class="fp-btn fp-btn--primary fph-cta" href="/Sas/MyReports"><i class="bi bi-file-earmark-text" aria-hidden="true"></i> My soil reports</a>
                    <a class="fp-btn fp-btn--secondary fph-cta" href="/Sas/MySamples"><i class="bi bi-moisture" aria-hidden="true"></i> My samples</a>
                </div>
                <FpArt Kind="FpArtKind.Sprout" CssClass="fph-highlight-art" />
            </FpCard>
        }
        else
        {
            <FpCard Variant="FpCardVariant.Highlight" Title="Know your soil" Icon="bi-moisture" Hue="FpHue.Gold" CssClass="fp-fade-up-2 fph-highlight"
                    Subtitle="A soil test shows what your field needs, so you buy only the fertilizer that helps.">
                <p class="fp-text fp-muted">Ask your SPIC field officer to collect a soil sample. Your report will appear here.</p>
                <FpArt Kind="FpArtKind.Sprout" CssClass="fph-highlight-art" />
            </FpCard>
        }

        <section class="fp-section fp-fade-up-2" aria-labelledby="fph-services">
            <div class="fp-section-head">
                <div>
                    <h2 id="fph-services" class="fp-section-title">Services for your farm</h2>
                </div>
            </div>
            <div class="fp-tile-grid">
                @foreach (var tile in _tiles)
                {
                    <FpTile Title="@tile.Title" Description="@tile.Description" Icon="@tile.Icon" Hue="@tile.Hue"
                            Href="@tile.Route" Badge="@tile.Badge" />
                }
            </div>
        </section>

        <section class="fp-section fp-fade-up-3 fph-team" aria-labelledby="fph-team-title">
            <div class="fp-section-head">
                <div>
                    <h2 id="fph-team-title" class="fp-section-title">Your SPIC team</h2>
                    <p class="fp-section-sub">Officers who look after farmers in @(profile.DistrictName ?? "your area")</p>
                </div>
                @if (_team is { Members.Count: > 0 })
                {
                    <a class="fp-section-link" href="/farmer/team">See all <i class="bi bi-chevron-right" aria-hidden="true"></i></a>
                }
            </div>

            @if (_teamLoading)
            {
                <FpSkeleton Variant="FpSkeletonVariant.Cards" Count="1" LoadingText="Finding your SPIC team..." />
            }
            else if (_teamError is not null)
            {
                <FpError Compact="true" Title="We could not load your SPIC team" Message="@_teamError" OnRetry="LoadTeamAsync" />
            }
            else if (_team is null || _team.Members.Count == 0)
            {
                <FpEmpty Art="FpArtKind.Team" Compact="true" Title="No SPIC officer is listed for your area yet"
                         Message="A SPIC dealer near you can help meanwhile.">
                    <a class="fp-btn fp-btn--secondary fp-btn--sm" href="/farmer/dealers"><i class="bi bi-shop" aria-hidden="true"></i> Dealers near me</a>
                </FpEmpty>
            }
            else
            {
                <div class="fph-team-grid">
                    @foreach (var member in FarmerConnectUi.Preview(_team.Members))
                    {
                        <FarmerTeamMemberCard @key="member.ContactId" Member="@member" MaxOpen="@_team.MaxOpenPerStaff" OnRequest="Ask" />
                    }
                </div>
            }
        </section>

        <FarmerCallBackSheet Contact="@_asking" @bind-IsOpen="_sheetOpen" OnSent="OnSent" />
    }
</div>

@code {
    private bool _loading = true;
    private string? _error;
    private bool _soilTests;
    private IReadOnlyList<FarmerFeatureTile> _tiles = Array.Empty<FarmerFeatureTile>();
    private bool _teamLoading = true;
    private string? _teamError;
    private SPIC.Core.DTOs.FarmerTeamDto? _team;
    private SPIC.Core.DTOs.FarmerContactDto? _asking;
    private bool _sheetOpen;

    protected override Task OnInitializedAsync() => LoadAsync(force: false);

    private async Task LoadAsync(bool force)
    {
        if (LoginState.UserRole != AppRole.Farmer)
        {
            _loading = false;
            return;
        }

        _loading = true;
        _error = null;
        var ok = await Farmer.EnsureLoadedAsync(force);
        _loading = false;

        if (!ok)
        {
            _error = Farmer.LoadError ?? "Please check your internet connection and try again.";
            return;
        }

        if (!Farmer.ProfileComplete)
        {
            Nav.NavigateTo("/farmer/onboarding", replace: true);
            return;
        }

        _soilTests = FarmerFeatureTiles.HasSoilTests(LoginState);
        _tiles = FarmerFeatureTiles.For(LoginState);
        await LoadTeamAsync();
    }

    private async Task LoadTeamAsync()
    {
        _teamLoading = true;
        _teamError = null;
        StateHasChanged();
        var result = await Api.TeamAsync();
        _teamLoading = false;
        if (result.Value is { } team) _team = team;
        else _teamError = result.Message ?? "Please try again.";
    }

    private void Ask(SPIC.Core.DTOs.FarmerContactDto member)
    {
        _asking = member;
        _sheetOpen = true;
    }

    private void OnSent(SPIC.Core.DTOs.FarmerContactRequestDto sent)
    {
        if (_team?.Members.FirstOrDefault(m => m.ContactId == sent.ContactId) is { } m) m.OpenRequests++;
    }

    private static string Place(SPIC.Core.DTOs.FarmerProfileDto p) =>
        string.Join(", ", new[] { p.Village, p.DistrictName }.Where(x => !string.IsNullOrWhiteSpace(x)));
}
