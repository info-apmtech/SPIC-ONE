@page "/farmer/privacy"
@layout SPIC.MauiBlazorApp.Shared.Layout.EmptyLayout
@using SPIC.Core.FarmerPortal
@inject LoginState LoginState

@*
    Privacy notice for farmers (final fix wave, review I4). Public: readable before sign-in (the login page's consent
    line links here) and by anyone signed in. The wording is a DRAFT for SPIC legal review (docs/farmer-portal.md
    "Hardening"); FarmerPrivacyRules.Version names the version a farmer accepts.
*@

<div class="fp fp-page fp-public fppr">
    <div class="fp-public__body">
        <FpHero Title="Privacy notice" Subtitle="What SPIC ONE keeps about you, why, and how to delete it."
                Eyebrow="SPIC ONE for farmers" BackHref="@BackHref" BackLabel="@BackLabel" DocumentTitle="Privacy notice">
            <FpChip Icon="bi-calendar3" Text="@($"Version {FarmerPrivacyRules.Version}")" />
        </FpHero>

        <FpCard Title="What we keep" Icon="bi-folder2-open" Hue="FpHue.Green">
            <ul class="fppr-list">
                <li><strong>Your mobile number</strong>, to sign you in with a code by SMS.</li>
                <li><strong>Your name</strong> and, if you give it, your email.</li>
                <li><strong>Your village</strong>: village, taluk, pincode, district and state, and your <strong>farm location (GPS)</strong> if you tap "Use my location".</li>
                <li><strong>Your farm</strong>: crops, land size and irrigation.</li>
                <li><strong>Soil values</strong> you type in, and your SPIC soil test report when your number is linked to it.</li>
                <li><strong>Leaf photos</strong> you take for a leaf check.</li>
                <li><strong>Your questions</strong> to SPIC AI and its answers, your fertilizer plans and harvest forecasts.</li>
                <li><strong>Call-back requests</strong> you send and <strong>Community</strong> posts and replies you write.</li>
                <li>Which pages you open and app errors, to keep the app working. Your phone number is never written to these logs.</li>
            </ul>
        </FpCard>

        <FpCard Title="Why we keep it" Icon="bi-bullseye" Hue="FpHue.Sky">
            <ul class="fppr-list">
                <li>To sign you in and keep you signed in on your phone.</li>
                <li>To give advice for your soil, crop and village: fertilizer advice, leaf checks, harvest forecasts and weather.</li>
                <li>To show SPIC dealers and your SPIC field team near your village, and to let them call you back.</li>
            </ul>
            <p class="fp-text fppr-note">We do not sell your details and we do not use them for advertising.</p>
        </FpCard>

        <FpCard Title="Who sees it" Icon="bi-people" Hue="FpHue.Gold">
            <ul class="fppr-list">
                <li><strong>SPIC staff in your area</strong> (your field officers) see your name, mobile number and village when you ask them to call you back.</li>
                <li><strong>The SPIC soil lab</strong> keeps your soil samples and reports.</li>
                <li><strong>Community members</strong> see your name, your district and what you post in the Community.</li>
                <li><strong>Service providers</strong> get only what their job needs: the SMS company gets your mobile number to send the code;
                    SPIC AI's provider gets your question, crops, district, soil values and leaf photo, never your name or number;
                    the weather service gets your farm location rounded to about 11 km.</li>
            </ul>
        </FpCard>

        <FpCard Title="How long we keep it" Icon="bi-hourglass-split" Hue="FpHue.Teal">
            <p class="fp-text">Until you delete your account. Sign-in codes are removed after one day.</p>
        </FpCard>

        <FpCard Title="Change or delete your details" Icon="bi-person-gear" Hue="FpHue.Soil">
            <ul class="fppr-list">
                <li>Change your details any time in <strong>My profile</strong>.</li>
                <li>Delete your account in <strong>My profile</strong> &rarr; <strong>Delete my account</strong>. It removes your profile, plans, photos and chats.</li>
            </ul>
            <a class="fp-btn fp-btn--secondary fppr-action" href="@FarmerPrivacyRules.DeleteInfoPath">
                <i class="bi bi-info-circle" aria-hidden="true"></i>
                <span>How account deletion works</span>
            </a>
        </FpCard>

        <FpCard Title="Questions" Icon="bi-chat-dots" Hue="FpHue.Violet">
            <p class="fp-text">Ask your SPIC field officer: open <strong>My SPIC team</strong> in the app and tap <strong>Request call back</strong>.</p>
        </FpCard>

        <FpDisclaimer Text="By signing in you agree to this notice. When it changes, you accept the new version the next time you sign in." />
    </div>
</div>

@code {
    private bool SignedIn => LoginState.IsLoggedIn;
    private string BackHref => SignedIn ? "/farmer/profile" : "/farmer/login";
    private string BackLabel => SignedIn ? "Back to my profile" : "Back to sign in";
}
