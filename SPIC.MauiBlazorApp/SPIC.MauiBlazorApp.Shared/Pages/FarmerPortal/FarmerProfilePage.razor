@page "/farmer/profile"
@using SPIC.Core.DTOs
@using SPIC.Core.Entities
@using SPIC.Core.FarmerPortal
@inject FarmerSession Farmer
@inject LoginState LoginState
@inject ToastService Toast
@inject ShellSession Shell
@inject NavigationManager Nav

@* The farmer's own profile: a summary in the hero, then the same form as onboarding, filled in. *@

<div class="fp fp-page fpp">
    @if (Farmer.Profile is { } p && LoginState.UserRole == AppRole.Farmer && !_loading)
    {
        <FpHero Title="My profile" Subtitle="Your details help SPIC give advice for your village and crops."
                BackHref="@LoginState.FarmerLandingPath" BackLabel="Back to home">
            <ChildContent>
                <div class="fpp-who">
                    <span class="fp-avatar fpp-avatar" aria-hidden="true">@FpUi.Initials(p.Name)</span>
                    <span class="fpp-who__text">
                        <strong>@p.Name</strong>
                        <span class="fp-num">+91 @(Farmer.Phone ?? p.Phone)</span>
                    </span>
                </div>
                <FpChip Icon="bi-geo-alt-fill" Text="@Place(p)" />
                @if (p.SasLinked)
                {
                    <FpChip Icon="bi-patch-check-fill" Text="Soil tests linked" />
                }
            </ChildContent>
        </FpHero>
    }
    else
    {
        <FpHero Title="My profile" Subtitle="Your details help SPIC give advice for your village and crops."
                BackHref="@LoginState.FarmerLandingPath" BackLabel="Back to home" />
    }

    @if (LoginState.UserRole != AppRole.Farmer)
    {
        <FpEmpty Art="FpArtKind.Team" Title="Farmer profile"
                 Message="This is where a farmer edits their own details. Support staff have no farmer profile." />
    }
    else if (_loading)
    {
        <FpSkeleton Variant="FpSkeletonVariant.Form" Count="5" LoadingText="Loading your profile..." CssClass="fpp-skel" />
    }
    else if (_error is not null)
    {
        <FpError Title="We could not load your profile" Message="@_error" OnRetry="LoadAsync" />
    }
    else
    {
        <FarmerProfileForm Initial="@Farmer.Profile" Phone="@Farmer.Phone" SubmitLabel="Save changes" OnSaved="Saved"
                           FocusLocation="@string.Equals(Focus, "location", StringComparison.OrdinalIgnoreCase)" />

        @* Final fix wave (review I4): the privacy notice and in-app account deletion (Google Play). *@
        <FpCard Title="Your data" Subtitle="What SPIC ONE keeps about you, and how to delete it." Icon="bi-shield-lock" Hue="FpHue.Neutral" CssClass="fpp-data">
            <div class="fpp-data__row">
                <a class="fp-section-link" href="@FarmerPrivacyRules.PrivacyPath">
                    <i class="bi bi-file-earmark-text" aria-hidden="true"></i> Privacy notice
                </a>
                <button type="button" class="fp-btn fp-btn--secondary fpp-delete" @onclick="() => _deleteOpen = true">
                    <i class="bi bi-person-x" aria-hidden="true"></i>
                    <span>Delete my account</span>
                </button>
            </div>
        </FpCard>
        <FarmerDeleteAccountSheet @bind-IsOpen="_deleteOpen" OnDeleted="DeletedAsync" />
    }
</div>

@code {
    private bool _loading = true;
    private string? _error;
    private bool _deleteOpen;

    /// <summary>?focus=location scrolls to "Farm location" (from the weather strip's "Use my location").</summary>
    [SupplyParameterFromQuery(Name = "focus")] public string? Focus { get; set; }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        if (LoginState.UserRole != AppRole.Farmer)
        {
            _loading = false;
            return;
        }
        _loading = true;
        _error = null;
        var ok = await Farmer.EnsureLoadedAsync(force: true);
        _loading = false;
        if (!ok) _error = Farmer.LoadError ?? "Please check your internet connection and try again.";
    }

    private void Saved(FarmerProfileDto profile)
    {
        Farmer.Update(profile);
        Toast.Success("Your changes are saved.");
    }

    /// <summary>The account is gone: forget the profile, sign out on this device and go to the farmer sign-in.</summary>
    private async Task DeletedAsync()
    {
        _deleteOpen = false;
        Farmer.Reset();
        Toast.Success("Your account is deleted. Thank you for using SPIC ONE.");
        await Shell.LogoutAsync();
        Nav.NavigateTo("/farmer/login");
    }

    private static string Place(FarmerProfileDto p) =>
        string.Join(", ", new[] { p.Village, p.DistrictName, p.StateName }.Where(x => !string.IsNullOrWhiteSpace(x)));
}
