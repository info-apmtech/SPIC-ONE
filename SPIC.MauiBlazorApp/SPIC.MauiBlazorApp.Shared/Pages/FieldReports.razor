@page "/FieldReports"
@using System.Net.Http.Json
@using SPIC.Core.DTOs
@inject HttpClient Http

<div class="container-fluid py-4 px-0 fr-page">

    <h2 class="fr-title">My Reports</h2>
    <p class="fr-subtitle">Your task closure and field activity performance.</p>

    <div class="fr-stats-grid">
        <div class="fr-stat-card fr-stat-completed">
            <div class="fr-stat-top">
                <span class="fr-stat-label">Completed</span>
                <span class="fr-stat-icon"><i class="bi bi-check-circle"></i></span>
            </div>
            <div class="fr-stat-number">@(_report?.CompletedThisMonth ?? 0)</div>
            <div class="fr-stat-desc">This month</div>
        </div>

        <div class="fr-stat-card fr-stat-closetime">
            <div class="fr-stat-top">
                <span class="fr-stat-label">Avg. Close Time</span>
                <span class="fr-stat-icon"><i class="bi bi-clock"></i></span>
            </div>
            <div class="fr-stat-number">@AvgCloseTimeText</div>
            <div class="fr-stat-desc">Per task</div>
        </div>

        <div class="fr-stat-card fr-stat-soil">
            <div class="fr-stat-top">
                <span class="fr-stat-label">Soil Samples</span>
                <span class="fr-stat-icon"><i class="bi bi-eyedropper"></i></span>
            </div>
            <div class="fr-stat-number">@(_report?.SoilSamplesLoggedThisMonth ?? 0)</div>
            <div class="fr-stat-desc">Logged this month</div>
        </div>

        <div class="fr-stat-card fr-stat-farmers">
            <div class="fr-stat-top">
                <span class="fr-stat-label">Farmers Added</span>
                <span class="fr-stat-icon"><i class="bi bi-person-plus"></i></span>
            </div>
            <div class="fr-stat-number">@(_report?.FarmersAddedThisMonth ?? 0)</div>
            <div class="fr-stat-desc">This month</div>
        </div>
    </div>

    <div class="fr-table-card">
        @if (_isLoading)
        {
            <EmptyState Icon="bi-hourglass-split" Title="Loading your reports..." Compact="true" />
        }
        else if (Rows.Count == 0)
        {
            <EmptyState Icon="bi-clipboard-check" Title="Nothing closed out this month yet" Compact="true" />
        }
        else
        {
            <div class="fr-table-scroll">
                <table class="fr-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Task</th>
                            <th>Type</th>
                            <th>Outcome</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Rows)
                        {
                            <tr>
                                <td class="fr-cell-date" data-label="Date">@row.Date</td>
                                <td class="fr-cell-task fr-cell-header">@row.Task</td>
                                <td data-label="Type"><span class="fr-type-pill @row.TypeClass">@row.Type</span></td>
                                <td data-label="Outcome"><span class="fr-outcome @row.OutcomeClass"><span class="fr-outcome-dot"></span>@row.Outcome</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

</div>

@code {
    private sealed record ReportRow(string Date, string Task, string Type, string TypeClass, string Outcome, string OutcomeClass);

    private JmdoFieldReportsDto? _report;
    private bool _isLoading = true;

    private string AvgCloseTimeText => _report?.AvgCloseTimeHours is { } hrs ? $"{hrs:0.#} hrs" : "—";

    private static string TypeClassFor(string type) => type switch
    {
        "Dealer" => "fr-type-blue",
        "SPCM" => "fr-type-teal",
        "Soil Sample Collection" => "fr-type-orange",
        "MD Programs" => "fr-type-green",
        "PoS Liquidation" => "fr-type-grey",
        _ => "fr-type-blue"
    };

    // "Fully Completed" is the only outcome that reads as fully green - "Partially Completed" and
    // "Not Completed" (TaskDetail's own Outcome dropdown options) both read as the same amber
    // "needs a look" state here, same two-tone convention the page always used.
    private static string OutcomeClassFor(string outcome) =>
        outcome.Equals("Fully Completed", StringComparison.OrdinalIgnoreCase) || outcome.Equals("Completed", StringComparison.OrdinalIgnoreCase)
            ? "fr-outcome-completed"
            : "fr-outcome-partial";

    private List<ReportRow> Rows =>
        (_report?.Rows ?? new()).Select(r => new ReportRow(
            r.Date.ToString("dd MMM yyyy"),
            r.Task,
            r.Type,
            TypeClassFor(r.Type),
            r.Outcome,
            OutcomeClassFor(r.Outcome)
        )).ToList();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _report = await Http.GetFromJsonAsync<JmdoFieldReportsDto>("api/JmdoTaskAllocation/mine/reports");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"FieldReports load failed: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }
}
