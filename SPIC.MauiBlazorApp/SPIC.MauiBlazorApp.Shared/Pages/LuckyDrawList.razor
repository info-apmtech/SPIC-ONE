@page "/LuckyDrawList"


    <div class="container-mobile">
        <header class="d-flex align-items-center gap-2 px-3 py-4  bg-light">
            <button class="btn-back">
                <i data-lucide="arrow-left" style="width: 20px; height: 20px;"></i>
            </button>
            <h1 class="h6 mb-0 fw-bold text-secondary text-dark">Over All Entries</h1>
        </header>

        <main class="px-3 pb-5">
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <h2 class="text-center small fw-bold text-dark text-uppercase mb-1" style="font-size: 12px; letter-spacing: 0.5px;">Total Entries</h2>
                <p class="text-center small text-muted mb-3" style="font-size: 11px;">
                    You Have <span class="text-success fw-bold">45</span> Active Entries In This Cycle
                </p>
                
                <div class="d-flex justify-content-between align-items-end mb-2">
                    <div>
                        <span class="display-6 fw-bolder text-success">45</span>
                        <span class="text-muted fw-medium" style="font-size: 14px;"> / 100</span>
                    </div>
                    <div>
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#b8860b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"></path>
                            <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"></path>
                            <path d="M4 22h16"></path>
                            <path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"></path>
                            <path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"></path>
                            <path d="M18 2H6v7a6 6 0 0 0 12 0V2Z" fill="#b8860b"></path>
                        </svg>
                    </div>
                </div>

                <div class="progress-container mb-1">
                    <div class="progress-bar-custom" style="width: 45%;"></div>
                </div>
                <div class="d-flex justify-content-between text-muted progress-labels">
                    <span>25</span>
                    <span>50</span>
                    <span>75</span>
                    <span class="fw-bold" style="color: #b8860b;">GOLD MILESTONE</span>
                </div>
            </div>

            <section>
                <h2 class="h6 fw-bold text-dark mb-3" style="font-size: 14px; color: #1b5e20 !important;">Your Entries List</h2>
                
                <div class="tabs-container d-flex gap-1 mb-4 shadow-sm">
                    <button class="btn btn-filter active flex-grow-1">All</button>
                    <button class="btn btn-filter flex-grow-1">Active</button>
                    <button class="btn btn-filter flex-grow-1">Used</button>
                    <button class="btn btn-filter flex-grow-1">Expired</button>
                </div>

                <div class="card border border-light shadow-sm rounded-4 overflow-hidden mb-3">
                    <div class="p-3 pb-2">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="d-flex align-items-center gap-2">
                                <span class="fw-medium text-dark" style="font-size: 13px;">Entry #001245</span>
                                <span class="badge rounded-pill badge-active">Active</span>
                            </div>
                            <div class="text-muted d-flex align-items-center gap-1" style="font-size: 11px; font-weight: 500;">
                                <i data-lucide="calendar" style="width: 12px; height: 12px;"></i>
                                <span>05 Apr 2026</span>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mb-3">
                            <div class="flex-grow-1 product-table-container d-flex flex-column">
                                <div class="d-flex w-100 table-header">
                                    <div class="w-50 table-cell">Products</div>
                                    <div class="w-50 table-cell table-cell-right">No.of Products</div>
                                </div>
                                <div class="d-flex w-100 table-row">
                                    <div class="w-50 table-cell">Fertilizer</div>
                                    <div class="w-50 table-cell table-cell-right">2</div>
                                </div>
                                <div class="d-flex w-100 table-row border-0">
                                    <div class="w-50 table-cell border-bottom-0">Urea</div>
                                    <div class="w-50 table-cell table-cell-right border-bottom-0">8</div>
                                </div>
                                <div class="total-row mt-auto">
                                    Total Products: 10
                                </div>
                            </div>

                            <div class="points-card shadow-sm">
                                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <rect x="3" y="8" width="18" height="13" rx="2" fill="#e0e0e0" />
                                    <rect x="2" y="4" width="20" height="4" rx="1" fill="#e0e0e0" />
                                    <rect x="10" y="4" width="4" height="17" fill="#64b5f6" />
                                    <path d="M12 4V2C12 2 10.5 2 9.5 3C8.5 4 10.5 4 12 4Z" fill="#64b5f6" />
                                    <path d="M12 4V2C12 2 13.5 2 14.5 3C15.5 4 13.5 4 12 4Z" fill="#64b5f6" />
                                </svg>
                                <span class="points-label">Earned Points</span>
                                <div class="d-flex align-items-baseline">
                                    <span class="fw-bolder" style="font-size: 24px; line-height: 1;">15</span>
                                    <span style="font-size: 11px; margin-left: 2px;">pts</span>
                                </div>
                            </div>
                        </div>

                        <button class="btn btn-blue-custom w-100">View Details</button>
                    </div>
                </div>

                <div class="card border border-light shadow-sm rounded-4 overflow-hidden mb-3">
                    <div class="p-3 pb-2">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="d-flex align-items-center gap-2">
                                <span class="fw-medium text-dark" style="font-size: 13px;">Entry #001245</span>
                                <span class="badge rounded-pill badge-active">Active</span>
                            </div>
                            <div class="text-muted d-flex align-items-center gap-1" style="font-size: 11px; font-weight: 500;">
                                <i data-lucide="calendar" style="width: 12px; height: 12px;"></i>
                                <span>05 Apr 2026</span>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mb-3">
                            <div class="flex-grow-1 product-table-container d-flex flex-column">
                                <div class="d-flex w-100 table-header">
                                    <div class="w-50 table-cell">Products</div>
                                    <div class="w-50 table-cell table-cell-right">No.of Products</div>
                                </div>
                                <div class="d-flex w-100 table-row">
                                    <div class="w-50 table-cell">Fertilizer</div>
                                    <div class="w-50 table-cell table-cell-right">2</div>
                                </div>
                                <div class="d-flex w-100 table-row border-0">
                                    <div class="w-50 table-cell border-bottom-0">Urea</div>
                                    <div class="w-50 table-cell table-cell-right border-bottom-0">8</div>
                                </div>
                                <div class="total-row mt-auto">
                                    Total Products: 10
                                </div>
                            </div>

                            <div class="points-card shadow-sm">
                                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <rect x="3" y="8" width="18" height="13" rx="2" fill="#e0e0e0" />
                                    <rect x="2" y="4" width="20" height="4" rx="1" fill="#e0e0e0" />
                                    <rect x="10" y="4" width="4" height="17" fill="#64b5f6" />
                                    <path d="M12 4V2C12 2 10.5 2 9.5 3C8.5 4 10.5 4 12 4Z" fill="#64b5f6" />
                                    <path d="M12 4V2C12 2 13.5 2 14.5 3C15.5 4 13.5 4 12 4Z" fill="#64b5f6" />
                                </svg>
                                <span class="points-label">Earned Points</span>
                                <div class="d-flex align-items-baseline">
                                    <span class="fw-bolder" style="font-size: 24px; line-height: 1;">15</span>
                                    <span style="font-size: 11px; margin-left: 2px;">pts</span>
                                </div>
                            </div>
                        </div>

                        <button class="btn btn-blue-custom w-100">View Details</button>
                    </div>
                </div>

            </section>
        </main>
    </div>




