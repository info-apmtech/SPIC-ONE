@page "/LuckyDrawList"

    
    <header class="oe-header">
        <button class="oe-btn-back" aria-label="Go Back">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
        </button>
        <h1>Over All Entries</h1>
    </header>

        
        <div class="oe-dashboard-card">
            <h2 class="oe-dash-title">TOTAL ENTRIES</h2>
            <p class="oe-dash-subtitle">
                You Have <span class="oe-text-green">45</span> Active Entries In This Cycle
            </p>
            
            <div class="oe-progress-top">
                <div class="oe-progress-score">
                    <span class="oe-score-current">45</span>
                    <span class="oe-score-max"> / 100</span>
                </div>
                <div class="oe-progress-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#B48608" stroke="#B48608" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"></path>
                        <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"></path>
                        <path d="M4 22h16"></path>
                        <path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"></path>
                        <path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"></path>
                        <path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"></path>
                    </svg>
                </div>
            </div>

            <div class="oe-progress-track">
                <div class="oe-progress-fill" style="width: 45%;"></div>
            </div>
            
            <div class="oe-progress-labels">
                <span>25</span>
                <span>50</span>
                <span>75</span>
                <span class="oe-gold-text">GOLD MILESTONE</span>
            </div>
        </div>

        <section class="oe-list-section">
            <h2 class="oe-section-title">Your Entries List</h2>
            
            <div class="oe-tabs">
                <button class="oe-tab active">All</button>
                <button class="oe-tab">Active</button>
                <button class="oe-tab">Used</button>
                <button class="oe-tab">Expired</button>
            </div>

            <div class="oe-cards-grid">
                
                @for (int i = 0; i < 6; i++)
                {
                    <div class="oe-entry-card">
                        <div class="oe-card-header">
                            <div class="oe-card-id">
                                <span>Entry #001245</span>
                                <span class="oe-badge-active">Active</span>
                            </div>
                            <div class="oe-card-date">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                                05 Apr 2026
                            </div>
                        </div>

                        <div class="oe-card-body">
                            <div class="oe-product-table">
                                <div class="oe-pt-header">
                                    <div>Products</div>
                                    <div class="oe-border-left">No.of Products</div>
                                </div>
                                <div class="oe-pt-row">
                                    <div>Fertilizer</div>
                                    <div class="oe-border-left">2</div>
                                </div>
                                <div class="oe-pt-row">
                                    <div>Urea</div>
                                    <div class="oe-border-left">8</div>
                                </div>
                                <div class="oe-pt-total">
                                    Total Products: 10
                                </div>
                            </div>

                            <div class="oe-points-box">
                                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <rect x="3" y="8" width="18" height="13" rx="2" fill="#E0E0E0" />
                                    <rect x="2" y="4" width="20" height="4" rx="1" fill="#E0E0E0" />
                                    <rect x="10" y="4" width="4" height="17" fill="#64B5F6" />
                                    <path d="M12 4V2C12 2 10.5 2 9.5 3C8.5 4 10.5 4 12 4Z" fill="#64B5F6" />
                                    <path d="M12 4V2C12 2 13.5 2 14.5 3C15.5 4 13.5 4 12 4Z" fill="#64B5F6" />
                                </svg>
                                <span>Earned Points</span>
                                <div class="oe-points-score">
                                    <strong>15</strong><small>pts</small>
                                </div>
                            </div>
                        </div>

                        <button class="oe-btn-view">View Details</button>
                    </div>
                }

            </div>
        </section>
