@page "/LuckyDrawList"

<style>
    /* Layout Settings */
    .container-mobile {
        width: 100%;
        max-width: 400px;
        margin: 0 auto;
        background-color: #fafafa; /* Lighter background matching image */
        min-height: 100vh;
        font-family: system-ui, -apple-system, sans-serif;
    }

    /* Header Button */
    .btn-back {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: transparent;
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Progress Bar */
    .progress-container {
        height: 8px;
        background-color: #e0e0e0;
        border-radius: 10px;
        overflow: hidden;
        position: relative;
    }

    .progress-bar-custom {
        height: 100%;
        border-radius: 10px;
        /* Green to Orange gradient matching the 45/100 visual */
        background: linear-gradient(90deg, #1b5e20 0%, #4caf50 70%, #f57c00 100%);
        transition: width 0.5s ease;
    }

    .progress-labels {
        font-size: 9px;
        letter-spacing: 0.2px;
        font-weight: 600;
    }

    /* Filter Tabs Segmented Control */
    .tabs-container {
        background-color: white;
        border-radius: 10px;
        padding: 4px;
        border: 1px solid #eaeaea;
    }

    .btn-filter {
        border-radius: 8px;
        padding: 6px 10px;
        font-size: 13px;
        font-weight: 500;
        color: #555;
        border: none;
        background: transparent;
        transition: all 0.2s;
    }

        .btn-filter.active {
            background-color: #4caf50;
            color: white;
            font-weight: 600;
        }

    /* Entry Card Styling */
    .badge-active {
        background-color: #81c784;
        color: white;
        font-size: 10px;
        padding: 4px 8px;
        font-weight: 600;
    }

    /* Product Table */
    .product-table-container {
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid #c8e6c9;
        background-color: white;
    }

    .table-cell {
        padding: 8px;
        font-size: 11px;
        text-align: center;
        border-bottom: 1px solid #c8e6c9;
    }

    .table-cell-right {
        border-left: 1px solid #c8e6c9;
    }

    .table-header .table-cell {
        color: #757575;
        font-weight: 500;
    }

    .table-row .table-cell {
        color: #1b5e20; /* Dark green text */
        font-weight: 700;
    }

    .total-row {
        background-color: #f1f8e9; /* Very light green */
        color: #2e7d32;
        text-align: center;
        padding: 8px;
        font-size: 11px;
        font-weight: 700;
    }

    /* Points Sidebar */
    .points-card {
        background: linear-gradient(135deg, #4caf50 0%, #388e3c 100%);
        border-radius: 8px;
        color: white;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 15px 10px;
        min-width: 100px;
    }

    .points-label {
        font-size: 10px;
        text-align: center;
        margin-top: 8px;
        margin-bottom: 2px;
    }

    /* Custom Blue Button */
    .btn-blue-custom {
        background-color: #3b71ca;
        color: white;
        border: none;
        font-weight: 600;
        font-size: 13px;
        padding: 10px;
        border-radius: 6px;
    }
    
        .btn-blue-custom:hover {
            background-color: #285192;
            color: white;
        }
</style>

    <div class="container-mobile">
        <header class="d-flex align-items-center gap-2 px-3 py-4  bg-light">
            <button class="btn-back">
