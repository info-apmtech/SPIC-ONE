@page "/Relationship"


<div class="container-fluid">

	<h2 class="page-title">Relationship Master</h2>

	<div class="main-card">
		<div class="section-header">
			<h3 class="section-title">Add New Relationship</h3>
			<button class="btn-outline-green" style="
				width: 12%;">
				<i class="bi bi-cloud-arrow-up"></i> Bulk Upload
			</button>
		</div>

		<div class="row g-3 mb-4">
			<div class="col-md-5">
				<label class="form-label-custom">Relationship Name</label>
				<input type="text" class="form-control-custom w-100" placeholder="Enter Relationship Name">
			</div>
            
			<div class="col-md-2">
				<div class="status-toggle-box">
					<span>Active</span>
					<label class="switch">
						<input type="checkbox" checked>
						<span class="slider"></span>
					</label>
				</div>
			</div>
		</div>

		<div class="d-flex justify-content-end pt-2 mt-4">
			<button class="btn-cancel mt-3"><i class="bi bi-x"></i> Cancel</button>
			<button class="btn-save mt-3"><i class="bi bi-save"></i> Save</button>
		</div>
	</div>

	<div class="row g-3 mb-4">
		<div class="col-md-4">
			<div class="metric-card bg-blue-light">
				<div class="metric-header">
					<h4 class="metric-title">Total Count</h4>
					<div class="metric-trend"><i class="bi bi-arrow-up-right"></i> 12% from last quarter</div>
				</div>
				<div class="metric-val">24</div>
			</div>
		</div>
		<div class="col-md-4">
			<div class="metric-card bg-mint-light">
				<div class="metric-header">
					<h4 class="metric-title">Active</h4>
					<div class="metric-info"><i class="bi bi-exclamation-circle"></i> 6 zones pending review</div>
				</div>
				<div class="metric-val">18</div>
			</div>
		</div>
		<div class="col-md-4">
			<div class="metric-card bg-gray-light">
				<div class="metric-header">
					<h4 class="metric-title">Inactive</h4>
					<div class="metric-info"><i class="bi bi-info-circle"></i> 6 zones pending review</div>
				</div>
				<div class="metric-val">18</div>
			</div>
		</div>
	</div>

	<div class="main-card">
		<div class="section-header">
			<h3 class="section-title">Existing RelationShip</h3>
            
			<div class="table-controls">
				<div class="search-box">
					<i class="bi bi-search"></i>
					<input type="text" placeholder="Search zones...">
				</div>
				<select class="filter-select">
					<option>All Status</option>
					@* <option>Active</option>
					<option>Inactive</option> *@
				</select>
				@* <div class="view-toggle">
					<button class="view-btn"><i class="bi bi-grid"></i> Card View</button>
					<button class="view-btn active"><i class="bi bi-list-ul"></i> List View</button>
				</div> *@
			</div>
		</div>

		<div class="table-wrapper">
			<div class="table-responsive">
				<table class="spic-table">
					<thead>
						<tr>
							<th style="width: 80px;">S:No</th>
							<th>Relationship Name</th>
							<th>Status</th>
							<th>Created At</th>
							<th>Action</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td class="text-muted">1</td>
							<td>Sister</td>
							<td><span class="status-pill status-active">Active</span></td>
							<td>2026-03-15</td>
							<td>
								<div class="action-icons">
									<i class="bi bi-trash icon-del"></i>
									<i class="bi bi-pencil-square icon-edit"></i>
								</div>
							</td>
						</tr>
						<tr>
							<td class="text-muted">2</td>
							<td>Brother</td>
							<td><span class="status-pill status-active">Active</span></td>
							<td>2026-03-15</td>
							<td>
								<div class="action-icons">
									<i class="bi bi-trash icon-del"></i>
									<i class="bi bi-pencil-square icon-edit"></i>
								</div>
							</td>
						</tr>
						<tr>
							<td class="text-muted">3</td>
							<td>Mother</td>
							<td><span class="status-pill status-inactive">Inactive</span></td>
							<td>2024-03-15</td>
							<td>
								<div class="action-icons">
									<i class="bi bi-trash icon-del"></i>
									<i class="bi bi-pencil-square icon-edit"></i>
								</div>
							</td>
						</tr>
						<tr>
							<td class="text-muted">4</td>
							<td>Father</td>
							<td><span class="status-pill status-active">Active</span></td>
							<td>2026-03-15</td>
							<td>
								<div class="action-icons">
									<i class="bi bi-trash icon-del"></i>
									<i class="bi bi-pencil-square icon-edit"></i>
								</div>
							</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		<div class="pagination-container">
			<div class="items-per-page">
				Items Per Page
				<select>
					<option>16</option>
					<option>32</option>
					<option>50</option>
				</select>
			</div>
            
			<div class="pagination-controls">
				<div class="page-btn"><i class="bi bi-chevron-left"></i></div>
				<div class="page-btn active">1</div>
				<div class="page-btn">2</div>
				<div class="page-btn">3</div>
				<div class="page-btn ellipsis">...</div>
				<div class="page-btn">8</div>
				<div class="page-btn">9</div>
				<div class="page-btn">10</div>
				<div class="page-btn"><i class="bi bi-chevron-right"></i></div>
			</div>
		</div>

	</div>

</div>

