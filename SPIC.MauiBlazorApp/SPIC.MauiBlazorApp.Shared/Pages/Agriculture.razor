@page "/Agriculture"
@using System.Net.Http.Json
@inject HttpClient Http
@inject IJSRuntime JS

<div class="container-fluid">

	<h2 class="page-title">Agriculture & Product Master</h2>

	@if (!string.IsNullOrEmpty(_message))
	{
		<div class="alert @(_isError ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
			@_message
			<button type="button" class="btn-close" @onclick="() => _message = null"></button>
		</div>
	}

	<div class="tabs-wrapper">
		<div class="tabs-container">
			@foreach (var tab in TabOptions)
			{
				<div class="tab-item @(ActiveTab == tab ? "active" : "")" @onclick="() => SetActiveTab(tab)">
					@tab
				</div>
			}
		</div>
	</div>

	<div class="main-card">
        <div class="section-header">
			<h3 class="section-title">@(_isEditing ? $"Edit {GetSingularName(ActiveTab)}" : $"Add New {GetSingularName(ActiveTab)}")</h3>
			<button class="btn-outline-green" style="width:12%;" @onclick="() => _showUploadModal = true"><i class="bi bi-cloud-arrow-up"></i> Bulk Upload</button>
		</div>

		<div class="row g-3 mb-4">
			@if (ActiveTab == "Categories")
			{
				<div class="col-md-4">
					<label class="form-label-custom">Category Name</label>
					<input type="text" class="form-control-custom w-100" placeholder="Enter Category Name"
						   @bind="_categoryForm.Name" @ref="_firstInputRef" />
				</div>
				<div class="col-md-3">
					<label class="form-label-custom">Unit</label>
					<select class="form-control-custom w-100" @bind="_categoryForm.UnitId">
						<option value="0">Select Unit</option>
						@foreach (var u in _unitsAll)
						{
							<option value="@u.Id">@u.Name</option>
						}
					</select>
				</div>
				<div class="col-md-3" style="margin-top: 28px;">
					<div class="status-toggle-box @(_categoryForm.IsSpecialityProduct ? "" : "status-toggle-inactive")">
						<span>@(_categoryForm.IsSpecialityProduct ? "Speciality" : "Regular")</span>
						<label class="switch">
							<input type="checkbox" @bind="_categoryForm.IsSpecialityProduct">
								<span class="slider"></span>
							</label>
						</div>
					</div>
				}
			else if (ActiveTab == "Products")
				{
					<div class="col-md-4">
						<label class="form-label-custom">Category</label>
						<select class="form-control-custom w-100" @bind="_productForm.CategoryId" @ref="_firstInputRef">
							<option value="0">Select Category</option>
							@foreach (var c in _categoriesAll)
							{
								<option value="@c.Id">@c.Name</option>
							}
						</select>
					</div>
					<div class="col-md-4">
						<label class="form-label-custom">Product Name</label>
						<input type="text" class="form-control-custom w-100" placeholder="Enter Product Name"
							   @bind="_productForm.Name" />
					</div>
				}
				else
				{
					<div class="col-md-5">
						<label class="form-label-custom">@GetSingularName(ActiveTab) Name</label>
						<input type="text" class="form-control-custom w-100" placeholder="Enter @GetSingularName(ActiveTab) Name"
							   @bind="_simpleForm.Name" @ref="_firstInputRef" />
					</div>
				}

				<div class="col-md-2" style="margin-top: 28px;">
					<div class="status-toggle-box @(CurrentFormIsActive ? "" : "status-toggle-inactive")">
						<span>@(CurrentFormIsActive ? "Active" : "Inactive")</span>
						<label class="switch">
							@if (ActiveTab == "Categories")
							{
								<input type="checkbox" @bind="_categoryForm.IsActive">
								}
						else if (ActiveTab == "Products")
								{
									<input type="checkbox" @bind="_productForm.IsActive">
									}
						else
									{
										<input type="checkbox" @bind="_simpleForm.IsActive">
										}
										<span class="slider"></span>
									</label>
								</div>
							</div>
						</div>

						<div class="d-flex justify-content-end pt-2 mt-4">
            @if (_showUploadModal)
			{
				<div class="modal-backdrop fade show"></div>
				<div class="modal fade show d-block" tabindex="-1" role="dialog">
					<div class="modal-dialog modal-dialog-centered" role="document">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title">Bulk Upload - @ActiveTab</h5>
								<button type="button" class="btn-close" @onclick="() => _showUploadModal = false"></button>
							</div>
							<div class="modal-body">
								<InputFile OnChange="OnBulkFileSelected" />
								<div class="upload-result" style="margin-top:10px;">
									@if (_isUploading)
									{
										<p class="text-muted">Uploading...</p>
									}
									else if (!string.IsNullOrEmpty(_uploadResult))
									{
										<p>@_uploadResult</p>
									}
								</div>
							</div>
						</div>
					</div>
				</div>
			}

							<button class="btn-cancel mt-3" @onclick="ResetForm"><i class="bi bi-x"></i> Cancel</button>
							<button class="btn-save mt-3" @onclick="HandleSave" disabled="@_isSaving">
								<i class="bi bi-save"></i> @(_isSaving ? "Saving..." : "Save")
							</button>
						</div>
					</div>

					<div class="row g-3 mb-4">
						<div class="col-md-4">
							<div class="metric-card bg-blue-light">
								<div class="metric-header">
									<h4 class="metric-title">Total @ActiveTab</h4>
								</div>
								<div class="metric-val">@CurrentAllItems.Count</div>
							</div>
						</div>
						<div class="col-md-4">
							<div class="metric-card bg-mint-light">
								<div class="metric-header">
									<h4 class="metric-title">Active</h4>
								</div>
								<div class="metric-val">@CurrentAllItems.Count(x => x.IsActive)</div>
							</div>
						</div>
						<div class="col-md-4">
							<div class="metric-card bg-gray-light">
								<div class="metric-header">
									<h4 class="metric-title">Inactive</h4>
								</div>
								<div class="metric-val">@CurrentAllItems.Count(x => !x.IsActive)</div>
							</div>
						</div>
					</div>

					<div class="main-card">
						<div class="section-header">
							<h3 class="section-title">Existing @ActiveTab</h3>

							<div class="table-controls">
								<div class="search-box">
									<i class="bi bi-search"></i>
									<input type="text" placeholder="Search @ActiveTab.ToLower()..." @bind="_searchText" @bind:event="oninput" @bind:after="ApplyFilter">
									</div>
									<select class="filter-select" @bind="_statusFilter" @bind:after="ApplyFilter">
										<option value="All">All Status</option>
										<option value="Active">Active</option>
										<option value="Inactive">Inactive</option>
									</select>
								</div>
							</div>

							<div class="table-wrapper">
								<div class="table-responsive">
									<table class="spic-table">
										<thead>
											<tr>
												<th style="width: 80px;">S:No</th>
												<th>@GetSingularName(ActiveTab) Name</th>

												@if (ActiveTab == "Categories")
												{
													<th>Unit</th>
													<th>Type</th>
												}
												else if (ActiveTab == "Products")
												{
													<th>Category</th>
												}

												<th>Status</th>
												<th>Created At</th>
												<th>Action</th>
											</tr>
										</thead>
										<tbody>
											@if (_isLoading)
											{
												<tr>
													<td colspan="@TableColSpan" class="text-center text-muted">Loading...</td>
												</tr>
											}
											else if (!PagedItems.Any())
											{
												<tr>
													<td colspan="@TableColSpan" class="text-center text-muted">No @ActiveTab.ToLower() found.</td>
												</tr>
											}
											else
											{
												@foreach (var (item, index) in PagedItems.Select((v, i) => (v, i)))
												{
													<tr>
														<td class="text-muted">@((_currentPage - 1) * _pageSize + index + 1)</td>
														<td>@item.Name</td>

														@if (ActiveTab == "Categories")
														{
															<td>@GetUnitName(item.UnitId)</td>
															<td>
																<span class="status-pill @(item.IsSpecialityProduct ? "status-active" : "")">
																	@(item.IsSpecialityProduct ? "Speciality" : "Regular")
																</span>
															</td>
														}
														else if (ActiveTab == "Products")
														{
															<td>@GetCategoryName(item.CategoryId)</td>
														}

														<td>
															<span class="status-pill @(item.IsActive ? "status-active" : "status-inactive")"
																  style="cursor:pointer"
																  @onclick="() => ToggleStatus(item)">
																@(item.IsActive ? "Active" : "Inactive")
															</span>
														</td>
														<td>@item.CreatedAt.ToString("yyyy-MM-dd")</td>
														<td>
															<div class="action-icons">
																<i class="bi bi-trash icon-del" @onclick="() => DeleteItem(item)"></i>
																<i class="bi bi-pencil-square icon-edit" @onclick="() => EditItem(item)"></i>
															</div>
														</td>
													</tr>
												}
											}
										</tbody>
									</table>
								</div>
							</div>

							<div class="pagination-container">
								<div class="items-per-page">
									Items Per Page
									<select @bind="_pageSize" @bind:after="ApplyFilter">
										<option value="16">16</option>
										<option value="32">32</option>
										<option value="50">50</option>
									</select>
								</div>

								<div class="pagination-controls">
									<div class="page-btn @(_currentPage <= 1 ? "disabled" : "")" @onclick="PreviousPage">
										<i class="bi bi-chevron-left"></i>
									</div>
									@foreach (var thispage in PageNumbers)
									{
										@if (thispage == -1)
										{
											<div class="page-btn ellipsis">...</div>
										}
										else
										{
											<div class="page-btn @(thispage == _currentPage ? "active" : "")" @onclick="() => GoToPage(thispage)">@(thispage)</div>
										}
									}
									<div class="page-btn @(_currentPage >= TotalPages ? "disabled" : "")" @onclick="NextPage">
										<i class="bi bi-chevron-right"></i>
									</div>
								</div>
							</div>

						</div>

					</div>

					@if (_showDeleteConfirm)
					{
						<div class="modal-backdrop fade show"></div>
						<div class="modal fade show d-block" tabindex="-1" role="dialog">
							<div class="modal-dialog modal-dialog-centered" role="document">
								<div class="modal-content">
									<div class="modal-header">
										<h5 class="modal-title">@(_dependencyWarnings.Any() ? "Cannot Delete" : "Confirm Delete")</h5>
										<button type="button" class="btn-close" @onclick="CancelDelete"></button>
									</div>
									<div class="modal-body">
										@if (_dependencyWarnings.Any())
										{
											<div class="alert alert-warning mb-0">
												<p class="mb-2"><strong>@_deleteTarget?.Name</strong> cannot be deleted because it is mapped to the following:</p>
												<ul class="mb-2" style="font-size: 0.9rem;">
													@foreach (var warning in _dependencyWarnings)
													{
														<li>@warning</li>
													}
												</ul>
												<p class="mb-0 text-muted" style="font-size: 0.85rem;">Please remove or reassign these mappings first.</p>
											</div>
										}
										else
										{
											<p>Are you sure you want to delete <strong>@_deleteTarget?.Name</strong>?</p>
											<p class="text-muted mb-0">This action cannot be undone.</p>
										}
									</div>
									<div class="modal-footer">
										<button class="btn btn-secondary" @onclick="CancelDelete">
											@(_dependencyWarnings.Any() ? "Close" : "Cancel")
										</button>
										
										@if (!_dependencyWarnings.Any())
										{
											<button class="btn btn-danger" @onclick="ConfirmDelete" disabled="@_isDeleting">
												@(_isDeleting ? "Deleting..." : "Delete")
											</button>
										}
									</div>
								</div>
							</div>
						</div>
					}
@code {
	private readonly List<string> TabOptions = ["Crops", "Competitors", "Sector", "Units", "Categories", "Products"];

	// ADDED: Element reference for focusing
	private ElementReference _firstInputRef;

	// Tab state
	private string ActiveTab { get; set; } = "Crops";
	private string CurrentApiBase => ActiveTab switch
	{
		"Crops" => "api/Crop",
		"Competitors" => "api/Competitor",
		"Sector" => "api/Sector",
		"Units" => "api/Unit",
		"Categories" => "api/Category",
		"Products" => "api/Product",
		_ => ""
	};
	private int TableColSpan => ActiveTab switch
	{
		"Categories" => 7,
		"Products" => 6,
		_ => 5
	};

	// Data per tab
	private List<AgriItemDto> _cropsAll = new();
	private List<AgriItemDto> _competitorsAll = new();
	private List<AgriItemDto> _sectorsAll = new();
	private List<AgriItemDto> _categoriesAll = new();
	private List<AgriItemDto> _productsAll = new();
	private List<AgriItemDto> _filteredItems = new();

	// Lookup data
	private List<AgriItemDto> _unitsAll = new();

	private List<AgriItemDto> CurrentAllItems => ActiveTab switch
	{
		"Crops" => _cropsAll,
		"Competitors" => _competitorsAll,
		"Sector" => _sectorsAll,
		"Units" => _unitsAll,
		"Categories" => _categoriesAll,
		"Products" => _productsAll,
		_ => new()
	};

	// Forms — simple (Crop, Competitor, Sector) share one form
	private SimpleFormModel _simpleForm = new();
	private CategoryFormModel _categoryForm = new();
	private ProductFormModel _productForm = new();
	private bool _isEditing;
	private int? _editingId;

	private bool CurrentFormIsActive => ActiveTab switch
	{
		"Categories" => _categoryForm.IsActive,
		"Products" => _productForm.IsActive,
		_ => _simpleForm.IsActive
	};

	// UI state
	private bool _isLoading = true;
	private bool _isSaving;
	private string? _message;
	private bool _isError;

	// Delete confirmation
	private bool _showDeleteConfirm;
	private bool _isDeleting;
	private AgriItemDto? _deleteTarget;
	private List<string> _dependencyWarnings = new();

	// Upload modal state
	private bool _showUploadModal = false;
	private bool _isUploading = false;
	private string _uploadResult = string.Empty;

	// Search & filter
	private string _searchText = "";
	private string _statusFilter = "All";

	// Pagination
	private int _currentPage = 1;
	private int _pageSize = 16;

	private int TotalPages => Math.Max(1, (int)Math.Ceiling(_filteredItems.Count / (double)_pageSize));
	private IEnumerable<AgriItemDto> PagedItems => _filteredItems
		.Skip((_currentPage - 1) * _pageSize)
		.Take(_pageSize);

    protected override async Task OnInitializedAsync()
	{
		// read jwt token from sessionStorage to extract current user id for CreatedBy/UpdatedBy
		try
		{
			var token = await JS.InvokeAsync<string>("sessionStorage.getItem", "jwt_token");
			if (!string.IsNullOrEmpty(token))
			{
				_currentUserId = GetUserIdFromToken(token);
			}
		}
		catch { }

		await LoadAllData();
		ApplyFilter();
		_isLoading = false;
	}

	private async Task LoadAllData()
	{
		try
		{
			_isLoading = true;
			_cropsAll = await Http.GetFromJsonAsync<List<AgriItemDto>>("api/Crop/all") ?? new();
			_competitorsAll = await Http.GetFromJsonAsync<List<AgriItemDto>>("api/Competitor/all") ?? new();
			_sectorsAll = await Http.GetFromJsonAsync<List<AgriItemDto>>("api/Sector/all") ?? new();
			_unitsAll = await Http.GetFromJsonAsync<List<AgriItemDto>>("api/Unit/all") ?? new();
			_categoriesAll = await Http.GetFromJsonAsync<List<AgriItemDto>>("api/Category/all") ?? new();
			_productsAll = await Http.GetFromJsonAsync<List<AgriItemDto>>("api/Product/all") ?? new();
		}
		catch (Exception ex)
		{
			ShowMessage($"Failed to load: {ex.Message}", true);
		}
	}

	private async Task LoadTabData()
	{
		try
		{
			_isLoading = true;
			var items = await Http.GetFromJsonAsync<List<AgriItemDto>>($"{CurrentApiBase}/all") ?? new();

			switch (ActiveTab)
			{
				case "Crops": _cropsAll = items; break;
				case "Competitors": _competitorsAll = items; break;
				case "Sector": _sectorsAll = items; break;
				case "Units": _unitsAll = items; break;
				case "Categories": _categoriesAll = items; break;
				case "Products": _productsAll = items; break;
			}

			ApplyFilter();
		}
		catch (Exception ex)
		{
			ShowMessage($"Failed to load: {ex.Message}", true);
		}
		finally
		{
			_isLoading = false;
		}
	}

	private async Task SetActiveTab(string tabName)
	{
		if (ActiveTab == tabName) return;
		ActiveTab = tabName;
		_searchText = "";
		_statusFilter = "All";
		_currentPage = 1;
		ResetForm();
		ApplyFilter();
	}

	private void ApplyFilter()
	{
		_filteredItems = CurrentAllItems
			.Where(x => string.IsNullOrEmpty(_searchText)
				|| x.Name.Contains(_searchText, StringComparison.OrdinalIgnoreCase))
			.Where(x => _statusFilter switch
			{
				"Active" => x.IsActive,
				"Inactive" => !x.IsActive,
				_ => true
			})
			.OrderByDescending(x => x.CreatedAt)
			.ToList();

		if (_currentPage > TotalPages) _currentPage = 1;
	}

	private async Task HandleSave()
	{
		var name = ActiveTab switch
		{
			"Categories" => _categoryForm.Name,
			"Products" => _productForm.Name,
			_ => _simpleForm.Name
		};

		if (string.IsNullOrWhiteSpace(name))
		{
			ShowMessage($"{GetSingularName(ActiveTab)} name is required.", true);
			return;
		}

		try
		{
			_isSaving = true;

			object payload = ActiveTab switch
			{
          "Categories" => _isEditing
				? new { Id = _editingId!.Value, _categoryForm.Name, _categoryForm.UnitId, _categoryForm.IsSpecialityProduct, _categoryForm.IsActive, UpdatedBy = (_currentUserId ?? "current-user") }
				: new { _categoryForm.Name, _categoryForm.UnitId, _categoryForm.IsSpecialityProduct, _categoryForm.IsActive, CreatedAt = DateTime.Now, UpdatedAt = DateTime.Now, CreatedBy = (_currentUserId ?? "current-user"), UpdatedBy = (_currentUserId ?? "current-user") },
            "Products" => _isEditing
				? (object)new { Id = _editingId!.Value, _productForm.Name, _productForm.CategoryId, _productForm.IsActive, UpdatedBy = (_currentUserId ?? "current-user") }
				: new { _productForm.Name, _productForm.CategoryId, _productForm.IsActive, CreatedAt = DateTime.Now, UpdatedAt = DateTime.Now, CreatedBy = (_currentUserId ?? "current-user"), UpdatedBy = (_currentUserId ?? "current-user") },
         _ => _isEditing
				? (object)new { Id = _editingId!.Value, _simpleForm.Name, _simpleForm.IsActive, UpdatedBy = (_currentUserId ?? "current-user") }
				: new { _simpleForm.Name, _simpleForm.IsActive, CreatedAt = DateTime.Now, UpdatedAt = DateTime.Now, CreatedBy = (_currentUserId ?? "current-user"), UpdatedBy = (_currentUserId ?? "current-user") }
			};

			HttpResponseMessage response;
			if (_isEditing && _editingId.HasValue)
			{
				response = await Http.PutAsJsonAsync($"{CurrentApiBase}/{_editingId.Value}", payload);
				if (!response.IsSuccessStatusCode)
				{
					var error = await response.Content.ReadAsStringAsync();
					ShowMessage($"Update failed: {error}", true);
					return;
				}
				ShowMessage($"{GetSingularName(ActiveTab)} updated successfully.", false);
			}
			else
			{
				response = await Http.PostAsJsonAsync(CurrentApiBase, payload);
				if (!response.IsSuccessStatusCode)
				{
					var error = await response.Content.ReadAsStringAsync();
					ShowMessage($"Create failed: {error}", true);
					return;
				}
				ShowMessage($"{GetSingularName(ActiveTab)} created successfully.", false);
			}

			ResetForm();
			await LoadTabData();
		}
		catch (Exception ex)
		{
			ShowMessage($"Error: {ex.Message}", true);
		}
		finally
		{
			_isSaving = false;
		}
	}

	// CHANGED: Made this an async Task to support FocusAsync
	private async Task EditItem(AgriItemDto item)
	{
		_isEditing = true;
		_editingId = item.Id;

		switch (ActiveTab)
		{
			case "Categories":
				_categoryForm = new CategoryFormModel
				{
					Name = item.Name,
					UnitId = item.UnitId,
					IsSpecialityProduct = item.IsSpecialityProduct,
					IsActive = item.IsActive
				};
				break;
			case "Products":
				_productForm = new ProductFormModel
				{
					Name = item.Name,
					CategoryId = item.CategoryId,
					IsActive = item.IsActive
				};
				break;
			default:
				_simpleForm = new SimpleFormModel
				{
					Name = item.Name,
					IsActive = item.IsActive
				};
				break;
		}

		// ADDED: Focus the input automatically
		try
		{
			await _firstInputRef.FocusAsync();
		}
		catch { }
	}

	private void DeleteItem(AgriItemDto item)
	{
		_deleteTarget = item;
		_dependencyWarnings.Clear();

		// Check for dependencies based on the active tab
		switch (ActiveTab)
		{
			case "Units":
				var mappedCategories = _categoriesAll.Where(c => c.UnitId == item.Id).Select(c => c.Name).ToList();
				if (mappedCategories.Any())
					_dependencyWarnings.Add($"Categories: {string.Join(", ", mappedCategories)}");
				break;

			case "Categories":
				var mappedProducts = _productsAll.Where(p => p.CategoryId == item.Id).Select(p => p.Name).ToList();
				if (mappedProducts.Any())
					_dependencyWarnings.Add($"Products: {string.Join(", ", mappedProducts)}");
				break;
		}

		_showDeleteConfirm = true;
	}


	private async Task ConfirmDelete()
	{
		if (_deleteTarget is null) return;

		try
		{
			_isDeleting = true;
			var response = await Http.DeleteAsync($"{CurrentApiBase}/{_deleteTarget.Id}");
			if (response.IsSuccessStatusCode)
			{
				ShowMessage($"'{_deleteTarget.Name}' deleted successfully.", false);
				await LoadTabData();
			}
			else
			{
				var error = await response.Content.ReadAsStringAsync();
				ShowMessage($"Delete failed: {error}", true);
			}
		}
		catch (Exception ex)
		{
			ShowMessage($"Error: {ex.Message}", true);
		}
		finally
		{
			_isDeleting = false;
			CancelDelete();
		}
	}

	private void CancelDelete()
	{
		_showDeleteConfirm = false;
		_deleteTarget = null;
		_dependencyWarnings.Clear(); 
	}

	private async Task ToggleStatus(AgriItemDto item)
	{
		try
		{
			var newStatus = !item.IsActive;
			var response = await Http.PatchAsync($"{CurrentApiBase}/{item.Id}/status?isActive={newStatus}", null);

			if (response.IsSuccessStatusCode)
			{
				item.IsActive = newStatus;
				ApplyFilter();
			}
			else
			{
				var error = await response.Content.ReadAsStringAsync();
				ShowMessage($"Status change failed: {error}", true);
			}
		}
		catch (Exception ex)
		{
			ShowMessage($"Error: {ex.Message}", true);
		}
	}

