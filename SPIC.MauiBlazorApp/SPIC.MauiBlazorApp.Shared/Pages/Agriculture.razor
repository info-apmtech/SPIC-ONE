		_ => pluralName.TrimEnd('s')
	};

	// current user id parsed from JWT token (string because Identity user id may be non-int)
	private string? _currentUserId;

	private string? GetUserIdFromToken(string token)
	{
		try
		{
			if (string.IsNullOrWhiteSpace(token)) return null;
			var raw = token.StartsWith("Bearer ") ? token.Substring("Bearer ".Length) : token;
			var parts = raw.Split('.');
			if (parts.Length < 2) return null;
			var payload = parts[1];
			switch (payload.Length % 4)
			{
				case 2: payload += "=="; break;
				case 3: payload += "="; break;
			}
			payload = payload.Replace('-', '+').Replace('_', '/');
			var json = System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(payload));
			using var doc = System.Text.Json.JsonDocument.Parse(json);
			var root = doc.RootElement;
			if (root.TryGetProperty("sub", out var sub)) return sub.GetString();
			if (root.TryGetProperty("nameid", out var nid)) return nid.GetString();
			if (root.TryGetProperty("http://schemas.xmlsoap.org/ws/2005/05/identity/claims/nameidentifier", out var id2)) return id2.GetString();
			if (root.TryGetProperty("spic:user_id", out var sup)) return sup.GetString();
		}
		catch { }
		return null;
	}

	private void ShowMessage(string message, bool isError)
	{
		_message = message;
		_isError = isError;
	}

	private async Task OnBulkFileSelected(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
	{
		var file = e.File;
		if (file == null) return;

		var typeMap = ActiveTab.ToLowerInvariant();
		if (typeMap == "crops") typeMap = "crop";
		else if (typeMap == "competitors") typeMap = "competitor";
		else if (typeMap == "sector") typeMap = "sector";
		else if (typeMap == "units") typeMap = "unit";
		else if (typeMap == "categories") typeMap = "category";
		else if (typeMap == "products") typeMap = "product";

		_isUploading = true;
		_uploadResult = string.Empty;

		try
		{
			using var ms = new MemoryStream();
			await file.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024).CopyToAsync(ms);
			ms.Position = 0;

			using var content = new MultipartFormDataContent();
			var fileContent = new StreamContent(ms);
			fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType ?? "application/octet-stream");
			content.Add(fileContent, "file", file.Name);

			var resp = await Http.PostAsync($"api/agriculturebulkupload/bulk-upload?type={typeMap}", content);
			var body = await resp.Content.ReadAsStringAsync();
			if (resp.IsSuccessStatusCode)
			{
				_uploadResult = "Upload successful";
				await LoadAllData();
			}
			else
			{
				_uploadResult = "Upload failed: " + body;
			}
		}
		catch (Exception ex)
		{
			_uploadResult = "Upload error: " + ex.Message;
		}
		finally
		{
			_isUploading = false;
		}
	}

	// Pagination helpers
	private void GoToPage(int page) { _currentPage = page; }
	private void PreviousPage() { if (_currentPage > 1) _currentPage--; }
	private void NextPage() { if (_currentPage < TotalPages) _currentPage++; }

	private IEnumerable<int> PageNumbers
	{
		get
		{
			var total = TotalPages;
			if (total <= 7)
				return Enumerable.Range(1, total);

			var pages = new List<int> { 1 };
			var start = Math.Max(2, _currentPage - 1);
			var end = Math.Min(total - 1, _currentPage + 1);

			if (start > 2) pages.Add(-1);
			for (var i = start; i <= end; i++) pages.Add(i);
			if (end < total - 1) pages.Add(-1);
			pages.Add(total);

			return pages;
		}
	}

