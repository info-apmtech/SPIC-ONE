    private MarkupString IconFor(string name) =>
        new(ProductIconSvgs.TryGetValue(name, out var svg) ? svg : "<i class=\"bi bi-box-seam\"></i>");

    private string currentTab = "All";
    private string statusFilter = "All";
    private string searchQuery = "";
    private int currentPage = 1;
    private int itemsPerPage = 16;

    private bool showFormModal;
    private ProductRow? editingRow;
    private ProductRow? viewingRow;

    private string formExistingProductId = "";
    private string formProductName = "";
    private string formProductGroup = "Live Stock";
    private string formUom = "Kg";
    private decimal? formRate;
    private string formReason = "";

    private List<ProductRow> TabRows => currentTab switch
    {
        "Livestock" => rows.Where(r => r.Group == "Live Stock").ToList(),
        "Orchard" => rows.Where(r => r.Group == "Orchard").ToList(),
        _ => rows
    };

    private int PendingCount => TabRows.Count(r => r.Status == "Pending");
    private int ApprovedCount => TabRows.Count(r => r.Status == "Approved");

    private List<ProductRow> FilteredRows
    {
        get
        {
            var filtered = TabRows.AsEnumerable();

            if (statusFilter != "All")
                filtered = filtered.Where(r => r.Status == statusFilter);

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                var q = searchQuery.Trim();
                filtered = filtered.Where(r => r.Name.Contains(q, StringComparison.OrdinalIgnoreCase));
            }

            return filtered.ToList();
        }
    }

    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)FilteredRows.Count / itemsPerPage));

    private List<ProductRow> PageRows
    {
        get
        {
            var filtered = FilteredRows;
            var start = (currentPage - 1) * itemsPerPage;
            return filtered.Skip(start).Take(itemsPerPage).ToList();
        }
    }

    private int SerialNoFor(ProductRow row) => FilteredRows.IndexOf(row) + 1;

    private List<object> PaginationPages
    {
        get
        {
            var pages = new List<object>();
            var total = TotalPages;
            if (total <= 7)
            {
                for (int i = 1; i <= total; i++) pages.Add(i);
            }
            else
            {
                pages.Add(1); pages.Add(2); pages.Add(3);
                if (currentPage > 5) pages.Add("...");
                if (currentPage > 3 && currentPage < total - 2) pages.Add(currentPage);
                if (currentPage < total - 4) pages.Add("...");
                pages.Add(total - 2); pages.Add(total - 1); pages.Add(total);
            }
            return pages.Distinct().ToList();
        }
    }

    private static string StatusPillClass(string status) => status switch
    {
        "Pending" => "prm-status-pending",
        "Approved" => "prm-status-approved",
        _ => "prm-status-none"
    };

    private void GoToDashboard() => Nav.NavigateTo(LoginState.LandingPage);

    private void SwitchTab(string tab)
    {
        currentTab = tab;
        statusFilter = "All";
        currentPage = 1;
    }

    private void SetStatusFilter(string status)
    {
        statusFilter = status;
        currentPage = 1;
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? "";
        currentPage = 1;
    }

    private void SetPage(int page) => currentPage = page;

    private void ChangeItemsPerPage(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var val))
            itemsPerPage = val;
        currentPage = 1;
    }

    private void OpenAddModal()
    {
        editingRow = null;
        formExistingProductId = "";
        formProductName = "";
        formProductGroup = "Live Stock";
        formUom = "Kg";
        formRate = null;
        formReason = "";
        showFormModal = true;
    }

    private void EditRow(ProductRow row)
    {
        editingRow = row;
        formExistingProductId = row.Id.ToString();
        formRate = null;
        formReason = "";
        showFormModal = true;
    }

    private void CloseFormModal() => showFormModal = false;

    private void ViewRow(ProductRow row) => viewingRow = row;

    private async Task DeleteRow(ProductRow row)
    {
        var ok = await Toast.ConfirmAsync("Delete product?", $"Delete \"{row.Name}\" from the catalog? This cannot be undone.", "Delete", danger: true);
        if (!ok) return;

        rows.Remove(row);
        Toast.Success($"\"{row.Name}\" deleted.");
    }

    private void SubmitForm()
    {
        if (formRate is null || formRate < 0)
        {
            Toast.Error("Enter a valid rate.");
            return;
        }

        var today = DateTime.Now.ToString("dd MMM yyyy");

        if (editingRow is not null)
        {
            if (!int.TryParse(formExistingProductId, out var id))
            {
                Toast.Error("Select a product.");
                return;
            }

            var target = rows.FirstOrDefault(r => r.Id == id);
            if (target is null)
            {
                Toast.Error("Select a product.");
                return;
            }

            target.RequestRateText = $"₹ {formRate.Value:N0} / {target.Uom}";
            target.RequestType = "Rate Change";
            target.Status = "Pending";
            target.RequestDate = today;
        }
        else
        {
            if (string.IsNullOrWhiteSpace(formProductName) || string.IsNullOrWhiteSpace(formUom))
            {
                Toast.Error("Enter a product name and UOM.");
                return;
            }

            rows.Add(new ProductRow
            {
                Id = _nextId++,
                Name = formProductName.Trim(),
                Group = formProductGroup,
                Uom = formUom.Trim(),
                CurrentRateText = null,
                RequestRateText = $"₹ {formRate.Value:N0} / {formUom.Trim()}",
                RequestType = "New Product",
                Status = "Pending",
                RequestDate = today
            });
        }

        Toast.Success("Request submitted.");
        showFormModal = false;
    }
}
