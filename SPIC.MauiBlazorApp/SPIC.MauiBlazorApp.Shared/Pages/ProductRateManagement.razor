    /* native: tablet */
    @@media (min-width: 768px) and (max-width: 1199.98px) {
        .prm-toolbar {
            flex-direction: column;
            align-items: stretch;
        }

        .prm-search {
            width: 100%;
        }
    }

    /* native: phone */
    @@media (max-width: 767.98px) {
        .prm-field-row {
            grid-template-columns: 1fr;
            gap: 14px;
        }

        .prm-page .shell-page-actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
        }

        .prm-btn {
            width: 100%;
            justify-content: center;
            /* The base rule's white-space:nowrap made "Request New Product" overflow
               its half-width button instead of wrapping - allow it to wrap here. */
            white-space: normal;
            text-align: center;
            line-height: 1.2;
            font-size: 13px;
            padding: 10px 6px;
            gap: 6px;
        }

        .prm-tab-group {
            width: 100%;
        }

        .prm-tab {
            flex: 1;
            text-align: center;
            padding: 10px 8px;
            font-size: 13px;
        }

        .prm-toolbar {
            flex-direction: column;
            align-items: stretch;
        }

        .prm-pills {
            /* flex:1 pills inside a wrapping flex row split unevenly across lines
               (2 pills on row 1, 1 alone stretched full-width on row 2) - a fixed
               3-column grid keeps all three the same size on one row instead. */
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            width: 100%;
        }

        .prm-pill {
            justify-content: center;
            padding: 8px 6px;
            font-size: 12px;
            white-space: nowrap;
        }

        .prm-search {
            width: 100%;
        }

        /* Table -> one card per row, column labels from data-label */
        .prm-table-scroll {
            overflow-x: hidden;
        }

        .prm-table thead {
            display: none;
        }

        .prm-table, .prm-table tbody, .prm-table tr, .prm-table td {
            display: block;
            width: 100%;
        }

        .prm-table tr {
            padding: 10px 16px;
            border-bottom: 8px solid var(--bg);
        }

