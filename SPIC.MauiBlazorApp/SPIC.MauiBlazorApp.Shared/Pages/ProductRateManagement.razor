            padding: 0;
            border-bottom: none;
        }

        .prm-table td {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 8px 0;
            border-bottom: 1px solid var(--border);
            text-align: right;
            white-space: normal;
        }

            .prm-table td::before {
                content: attr(data-label);
                flex: 0 0 42%;
                text-align: left;
                font-weight: 600;
                font-size: 12px;
                color: var(--text-soft);
            }

            .prm-table tr.prm-state-row td::before {
                content: none;
