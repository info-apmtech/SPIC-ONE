@page "/FinalReportCSRView"

<div class="container-fluid py-4 px-0">
    <div class="frcsr-wrapper">

        <h1 class="frcsr-title">Final Report - CSR Program Tracking</h1>

        <!-- KPI Cards -->
        <div class="frcsr-kpi-grid">

            <div class="frcsr-kpi-card frcsr-kpi-blue">
                <div class="frcsr-kpi-body">
                    <div>
                        <div class="frcsr-kpi-number">12</div>
                        <p class="frcsr-kpi-label">Total Programs</p>
                    </div>
                    <div class="frcsr-kpi-icon frcsr-icon-blue"><i class="bi bi-clipboard-check"></i></div>
                </div>
                <a href="#" class="frcsr-kpi-footer">View all <i class="bi bi-chevron-right"></i></a>
            </div>

            <div class="frcsr-kpi-card frcsr-kpi-green">
                <div class="frcsr-kpi-body">
                    <div>
                        <div class="frcsr-kpi-number">5</div>
                        <p class="frcsr-kpi-label">Approved</p>
                    </div>
                    <div class="frcsr-kpi-icon frcsr-icon-green"><i class="bi bi-check-circle"></i></div>
                </div>
                <a href="#" class="frcsr-kpi-footer">View approved <i class="bi bi-chevron-right"></i></a>
            </div>

            <div class="frcsr-kpi-card frcsr-kpi-orange">
                <div class="frcsr-kpi-body">
                    <div>
                        <div class="frcsr-kpi-number">3</div>
                        <p class="frcsr-kpi-label">Pending</p>
                    </div>
                    <div class="frcsr-kpi-icon frcsr-icon-orange"><i class="bi bi-clock-history"></i></div>
                </div>
                <a href="#" class="frcsr-kpi-footer">View Pending <i class="bi bi-chevron-right"></i></a>
            </div>

            <div class="frcsr-kpi-card frcsr-kpi-red">
                <div class="frcsr-kpi-body">
                    <div>
                        <div class="frcsr-kpi-number">2</div>
                        <p class="frcsr-kpi-label">Rejected</p>
                    </div>
                    <div class="frcsr-kpi-icon frcsr-icon-red"><i class="bi bi-file-earmark-x"></i></div>
                </div>
                <a href="#" class="frcsr-kpi-footer">View Rejected <i class="bi bi-chevron-right"></i></a>
            </div>

            <div class="frcsr-kpi-card frcsr-kpi-gray">
                <div class="frcsr-kpi-body">
                    <div>
                        <div class="frcsr-kpi-number">2</div>
                        <p class="frcsr-kpi-label">Drafts</p>
                    </div>
                    <div class="frcsr-kpi-icon frcsr-icon-gray"><i class="bi bi-journal-text"></i></div>
                </div>
                <a href="#" class="frcsr-kpi-footer">View drafts <i class="bi bi-chevron-right"></i></a>
            </div>

        </div>

        <!-- Filters Card -->
        <div class="frcsr-card">
            <div class="frcsr-filters-header">
                <span><i class="bi bi-filter-left"></i> Filters</span>
                <i class="bi bi-chevron-down frcsr-toggle-icon"></i>
            </div>

            <div class="frcsr-filters-grid">
                <div class="frcsr-form-group">
                    <label>Date Range</label>
                    <div class="frcsr-input-with-icon">
                        <input type="text" class="frcsr-control" placeholder="01 Apr 2025 - 28 Apr 2025" />
                        <i class="bi bi-calendar3 frcsr-input-icon"></i>
                    </div>
                </div>
                <div class="frcsr-form-group">
                    <label>Program Type</label>
                    <select class="frcsr-control frcsr-select">
                        <option value="" disabled selected hidden>All Program Type</option>
                        <option>Training</option>
                        <option>Workshop</option>
                    </select>
                </div>
                <div class="frcsr-form-group">
                    <label>Program Name</label>
                    <select class="frcsr-control frcsr-select">
                        <option value="" disabled selected hidden>All Program Name</option>
                        <option>Crop Protection Workshop</option>
                    </select>
                </div>
                <div class="frcsr-form-group">
                    <label>CSR Type</label>
                    <select class="frcsr-control frcsr-select">
                        <option value="" disabled selected hidden>All District</option>
                    </select>
                </div>
                <div class="frcsr-form-group">
                    <label>Status</label>
                    <select class="frcsr-control frcsr-select">
                        <option value="" disabled selected hidden>All District</option>
                    </select>
                </div>
            </div>

            <div class="frcsr-filter-actions">
                <button class="frcsr-btn frcsr-btn-ghost"><i class="bi bi-x-lg"></i> Clear All</button>
                <button class="frcsr-btn frcsr-btn-primary"><i class="bi bi-funnel"></i> Apply Filters</button>
            </div>
        </div>

        <!-- Table Card -->
        <div class="frcsr-card">
            <div class="frcsr-table-head">
                <div class="frcsr-table-head-left">
                    <h2 class="frcsr-table-title">CSR-2 plan list</h2>
                    <div class="frcsr-search">
                        <i class="bi bi-search"></i>
                        <input type="text" placeholder="Search zones..." />
                    </div>
                </div>
                <div class="frcsr-table-actions">
                    <button class="frcsr-btn frcsr-btn-outline"><i class="bi bi-arrow-clockwise"></i> Refresh Data</button>
                    <button class="frcsr-btn frcsr-btn-outline"><i class="bi bi-file-earmark-spreadsheet" style="color:#16A34A"></i> Excel</button>
                    <button class="frcsr-btn frcsr-btn-outline"><i class="bi bi-file-earmark-pdf" style="color:#DC2626"></i> PDF</button>
                    <button class="frcsr-btn frcsr-btn-primary"><i class="bi bi-envelope"></i> Send Mail</button>
                </div>
            </div>

            <div class="frcsr-table-wrap">
                <table class="frcsr-table">
                    <thead>
                        <tr>
                            <th class="frcsr-th-check"><input type="checkbox" /></th>
                            <th>Program Type</th>
                            <th>Program Name</th>
                            <th>Submitted Date</th>
                            <th>CSR - 1 Status</th>
                            <th>CSR - 2 Status</th>
                            <th>Sanction Number</th>
                            <th>Report Status</th>
                            <th>Total Expenses</th>
                            <th>Approved Budget</th>
                            <th>Remaining Budget</th>
                            <th>Validation Due</th>
                            <th class="frcsr-th-action">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in tableRows)
                        {
                            <tr>
                                <td><input type="checkbox" /></td>
                                <td>@row.Type</td>
                                <td class="frcsr-cell-left">@row.Program</td>
                                <td>@row.SubmittedDate</td>
                                <td><span class="frcsr-pill @GetPill(row.Csr1Status)">@row.Csr1Status</span></td>
                                <td><span class="frcsr-pill @GetPill(row.Csr2Status)">@row.Csr2Status</span></td>
                                <td>@row.Sanction</td>
                                <td>
                                    @if (row.ReportStatus == "Completed")
                                    {
                                        <span class="frcsr-pill frcsr-pill-green"><i class="bi bi-check-circle"></i> Completed</span>
                                    }
                                    else
                                    {
                                        <span class="frcsr-pill frcsr-pill-amber">Pending</span>
                                    }
                                </td>
                                <td>@row.TotalExpenses</td>
                                <td>@row.ApprovedBudget</td>
                                <td>@row.RemainingBudget</td>
                                <td>@row.ValidationDue</td>
                                <td>
                                    <div class="frcsr-row-actions">
                                        <button class="frcsr-icon-btn frcsr-action-view" @onclick="OpenViewPopup"><i class="bi bi-eye"></i></button>
                                        <button class="frcsr-icon-btn frcsr-action-delete"><i class="bi bi-trash"></i></button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <div class="frcsr-pagination">
                <div class="frcsr-page-size">
                    <span>Items Per Page</span>
                    <select class="frcsr-control frcsr-select frcsr-page-select">
                        <option>16</option>
                        <option>25</option>
                    </select>
                </div>
                <div class="frcsr-page-controls">
                    <button class="frcsr-page-btn"><i class="bi bi-chevron-left"></i></button>
                    <button class="frcsr-page-btn frcsr-page-active">1</button>
                    <button class="frcsr-page-btn">2</button>
                    <button class="frcsr-page-btn">3</button>
                    <span class="frcsr-page-ellipsis">..</span>
                    <button class="frcsr-page-btn">8</button>
                    <button class="frcsr-page-btn">9</button>
                    <button class="frcsr-page-btn">10</button>
                    <button class="frcsr-page-btn"><i class="bi bi-chevron-right"></i></button>
                </div>
            </div>
        </div>

        <!-- Rejection Reason Banner -->
        <div class="frcsr-rejection-banner">
            <i class="bi bi-exclamation-circle frcsr-rejection-icon"></i>
            <div>
                <strong>Rejection Reason:</strong>
                <span>Budget exceeds approved limit. Please revise and resubmit with detailed breakdown.</span>
            </div>
        </div>

    </div>
</div>

@if (isViewPopupOpen)
{
    <div class="frcsr-overlay" @onclick="CloseViewPopup"></div>
    <div class="frcsr-drawer">
        <div class="frcsr-drawer-head">
            <div>
                <h2>CSR-1 Program Details</h2>
                <p>Crop Protection Workshop</p>
            </div>
            <button class="frcsr-drawer-close" @onclick="CloseViewPopup">&times;</button>
        </div>
        <div class="frcsr-drawer-body">
            <div class="frcsr-drawer-section">
                <h3 class="frcsr-drawer-section-title">Program Information</h3>
                <div class="frcsr-drawer-row"><span>Program Type:</span><span>Training</span></div>
                <div class="frcsr-drawer-row"><span>Program Name:</span><span>Crop Protection Workshop</span></div>
                <div class="frcsr-drawer-row"><span>Status:</span><span class="frcsr-pill frcsr-pill-green">Approved</span></div>
                <div class="frcsr-drawer-row"><span>Sanction Number:</span><span>CSR1-2026-045</span></div>
            </div>
            <div class="frcsr-drawer-section">
                <h3 class="frcsr-drawer-section-title">Location Details</h3>
                <div class="frcsr-drawer-row"><span>District:</span><span>Pune</span></div>
                <div class="frcsr-drawer-row"><span>HQ:</span><span>Pune, Maharashtra</span></div>
            </div>
            <div class="frcsr-drawer-section">
                <h3 class="frcsr-drawer-section-title">Budget Details</h3>
                <div class="frcsr-drawer-row"><span>Total Budget:</span><span>₹50,000</span></div>
            </div>
            <div class="frcsr-drawer-section">
                <h3 class="frcsr-drawer-section-title">Expense Breakdown</h3>
                @foreach (var item in expenseBreakdown)
                {
                    <div class="frcsr-drawer-row"><span>@item.Key:</span><span>@item.Value</span></div>
                }
                <div class="frcsr-drawer-row frcsr-drawer-total">
                    <strong>Total:</strong><strong>₹50,000</strong>
                </div>
            </div>
            <div class="frcsr-drawer-section">
                <h3 class="frcsr-drawer-section-title">Focus Areas</h3>
                <div class="frcsr-drawer-tags">
                    <span class="frcsr-drawer-taglabel">Focused Crops:</span>
                    <span class="frcsr-pill frcsr-pill-green">Cotton</span>
                    <span class="frcsr-pill frcsr-pill-green">Wheat</span>
                    <span class="frcsr-pill frcsr-pill-green">Sugarcane</span>
                </div>
                <div class="frcsr-drawer-tags">
                    <span class="frcsr-drawer-taglabel">Focused Products:</span>
                    <span class="frcsr-pill frcsr-pill-blue">Insecticide A</span>
                    <span class="frcsr-pill frcsr-pill-blue">Fungicide B</span>
                    <span class="frcsr-pill frcsr-pill-blue">Herbicide C</span>
                </div>
            </div>
            <div class="frcsr-drawer-section">
                <h3 class="frcsr-drawer-section-title">Approval Timeline</h3>
                <div class="frcsr-timeline">
                    @foreach (var step in timeline)
                    {
                        <div class="frcsr-timeline-item">
                            <div class="frcsr-timeline-dot"><i class="bi bi-check"></i></div>
                            <div>
                                <div class="frcsr-timeline-title">@step.Title</div>
                                <div class="frcsr-timeline-desc">@step.Person <span class="frcsr-chip-dark">@step.Date</span></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="frcsr-drawer-foot">
            <button class="frcsr-drawer-btn frcsr-drawer-btn-dark"><i class="bi bi-box-arrow-up-right"></i> Open CSR-2</button>
            <button class="frcsr-drawer-btn frcsr-drawer-btn-green"><i class="bi bi-printer"></i> Print</button>
            <button class="frcsr-drawer-btn frcsr-drawer-btn-blue"><i class="bi bi-file-earmark-pdf"></i> Export PDF</button>
        </div>
    </div>
}

@code {
    private bool isViewPopupOpen = false;

    private void OpenViewPopup() => isViewPopupOpen = true;
    private void CloseViewPopup() => isViewPopupOpen = false;

    private record TableRow(string Type, string Program, string SubmittedDate, string Csr1Status, string Csr2Status, string Sanction, string ReportStatus, string TotalExpenses, string ApprovedBudget, string RemainingBudget, string ValidationDue);

    private readonly List<TableRow> tableRows = new()
    {
        new("Training", "Crop Protection Workshop", "May 1, 2026", "Approved", "Approved",  "CSR1-2026-045", "Completed", "₹2,50,000", "₹2,50,000", "₹2,50,000", "May 10, 2026"),
        new("Training", "Crop Protection Workshop", "May 1, 2026", "Approved", "Validated", "CSR1-2026-045", "Pending",   "₹2,50,000", "₹2,50,000", "₹2,50,000", "May 10, 2026"),
        new("Training", "Crop Protection Workshop", "May 1, 2026", "Approved", "Rejected",  "CSR1-2026-045", "Pending",   "₹2,50,000", "₹2,50,000", "₹2,50,000", "May 10, 2026"),
        new("Training", "Crop Protection Workshop", "May 1, 2026", "Approved", "Submitted", "CSR1-2026-045", "Pending",   "₹2,50,000", "₹2,50,000", "₹2,50,000", "May 10, 2026"),
        new("Training", "Crop Protection Workshop", "May 1, 2026", "Approved", "Draft",     "CSR1-2026-045", "Pending",   "₹2,50,000", "₹2,50,000", "₹2,50,000", "May 10, 2026"),
    };

    private readonly Dictionary<string, string> expenseBreakdown = new()
    {
        { "Printing & Stationary", "₹5,000" },
        { "Publicity Material", "₹8,000" },
        { "Stage Arrangements", "₹12,000" },
        { "Service Charges - LCA", "₹7,000" },
        { "Transport / Rent", "₹6,000" },
        { "Jeep Running Expenses", "₹4,000" },
        { "Refreshments", "₹5,000" },
        { "Inputs", "₹0" },
        { "Photography", "₹2,000" },
        { "Compliments", "₹1,000" },
        { "Others", "₹0" },
    };

    private readonly List<(string Title, string Person, string Date)> timeline = new()
    {
        ("Created",   "John Doe (MO)",  "May 1, 2026"),
        ("Submitted", "John Doe (MO)",  "May 1, 2026"),
        ("Validated", "Regional MD",    "May 1, 2026"),
        ("Approved",  "State MD",       "May 1, 2026"),
    };

    private string GetPill(string status) => status switch
    {
        "Approved" => "frcsr-pill-green",
        "Validated" => "frcsr-pill-amber",
        "Rejected" => "frcsr-pill-red",
        "Submitted" => "frcsr-pill-blue",
        "Draft" => "frcsr-pill-gray",
        _ => "frcsr-pill-gray"
    };
}