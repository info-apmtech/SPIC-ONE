@page "/SalesTracking"
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject HttpClient Http
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using System.Net.Http.Headers
@using System.IO.Compression
@using System.Xml
@using System.Text
@implements IAsyncDisposable

<PageTitle>Sales Tracking · SPIC ONE</PageTitle>

<style>
    .trk-ext-banner {
        border: 1px solid #f0e1c8;
        border-radius: 12px;
        padding: 11px 14px;
        margin: 10px 0 14px;
        background: #fffdf9;
        box-shadow: 0 2px 7px rgba(20,35,30,.035);
    }

    .trk-ext-approved {
        background: #f8fdf9;
        border-color: #c6e5d0;
    }

    .trk-ext-rejected {
        background: #fffafa;
        border-color: #f1c9c9;
    }

    .trk-ext-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 9px;
    }

    .trk-ext-heading {
        display: flex;
        align-items: center;
        gap: 11px;
        min-width: 0;
    }

    .trk-ext-symbol {
        color: #f06423;
        display: flex;
    }

    .trk-ext-approved .trk-ext-symbol {
        color: #16834b;
    }

    .trk-ext-rejected .trk-ext-symbol {
        color: #ca3535;
    }

    .trk-ext-title-line {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 9px;
        color: #e85e28;
        font-size: 13px;
    }

    .trk-ext-approved .trk-ext-title-line {
        color: #137b46;
    }

    .trk-ext-rejected .trk-ext-title-line {
        color: #bb3333;
    }

    .trk-ext-status {
        border: 1px solid #ffe1c9;
        border-radius: 20px;
        background: #fff2e8;
        padding: 3px 9px;
        font-size: 10px;
        font-weight: 600;
    }

    .trk-ext-approved .trk-ext-status {
        border-color: #c9e8d5;
        background: #edf9f0;
    }

    .trk-ext-rejected .trk-ext-status {
        border-color: #f2caca;
        background: #fff0f0;
    }

    .trk-ext-subtitle {
        color: #6d7775;
        font-size: 11px;
    }

    .trk-ext-action {
        background: white;
        border: 1px solid #d9e1de;
        border-radius: 7px;
        padding: 7px 12px;
        display: flex;
        align-items: center;
        gap: 7px;
        color: #68736e;
        font-size: 12px;
        cursor: pointer;
    }

        .trk-ext-action:hover {
            border-color: #7ba58e;
            color: #226d48;
        }

    .trk-ext-grid {
        display: grid;
        grid-template-columns: repeat(4,minmax(0,1fr));
        gap: 0;
    }

    .trk-ext-stat {
        min-width: 0;
        padding: 0 12px;
        border-right: 1px solid #e5ebe7;
    }

        .trk-ext-stat:first-child {
            padding-left: 0;
        }

        .trk-ext-stat:last-child {
            border-right: 0;
        }

    .trk-ext-label {
        display: block;
        font-size: 11px;
        color: #7d8783;
        margin-bottom: 4px;
    }

    .trk-ext-stat-value {
        font-weight: 600;
        font-size: 12px;
        display: flex;
        gap: 6px;
        align-items: center;
        flex-wrap: wrap;
        color: #26332f;
    }

    .trk-ext-duration {
        font-size: 10px;
        color: #268951;
        background: #e9f7ef;
        padding: 3px 7px;
        border-radius: 14px;
    }

    .trk-ext-extra {
        display: grid;
        grid-template-columns: repeat(2,minmax(0,1fr));
        gap: 8px 16px;
        padding-top: 14px;
        margin-top: 14px;
        border-top: 1px solid #e5ebe7;
        font-size: 12px;
        color: #59665f;
    }

    @@media(max-width:850px) {
        .trk-ext-grid {
            grid-template-columns: repeat(2,minmax(0,1fr));
            row-gap: 15px;
        }

        .trk-ext-stat:nth-child(2) {
            border-right: 0;
        }
    }

    @@media(max-width:520px) {
        .trk-ext-head {
            align-items: flex-start;
            flex-direction: column;
        }

        .trk-ext-grid, .trk-ext-extra {
            grid-template-columns: 1fr;
        }

        .trk-ext-stat {
            padding: 0;
            border-right: 0;
        }

            .trk-ext-stat + .trk-ext-stat {
                padding-top: 9px;
                border-top: 1px solid #eef0ee;
            }
    }
</style>


<style>
    /* Monthly progress line chart - self-contained SVG, no extra JS library. */
    .trk-month-chart {
        padding: 9px 10px 6px;
    }

        .trk-month-chart svg {
            width: 100%;
            height: auto;
            display: block;
            overflow: visible;
        }

        .trk-month-chart .trk-actual-area {
            fill: #15915b;
            fill-opacity: .065;
        }

        .trk-month-chart .trk-actual-line {
            stroke: #198c50;
            stroke-width: 2.4;
            fill: none;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .trk-month-chart .trk-target-line {
            stroke: #3475ff;
            stroke-width: 2;
            fill: none;
            stroke-dasharray: 5 5;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .trk-month-chart .trk-chart-gridline {
            stroke: #dfe6e7;
            stroke-width: 1;
            stroke-dasharray: 2 3;
        }

        .trk-month-chart .trk-chart-axis {
            fill: #87918e;
            font-size: 12px;
        }

        .trk-month-chart .trk-actual-point {
            fill: #16894b;
            stroke: white;
            stroke-width: 2;
        }

        .trk-month-chart .trk-target-point {
            fill: #fff;
            stroke: #3475ff;
            stroke-width: 2;
        }

        .trk-month-chart .trk-actual-label {
            fill: #16894b;
            font-size: 12px;
            font-weight: 700;
        }

        .trk-month-chart .trk-target-label {
            fill: #2d60d8;
            font-size: 12px;
            font-weight: 700;
        }

    .trk-month-chart-note {
        font-size: 11px;
        line-height: 1.5;
        color: #69788b;
        margin: 0 14px 12px;
    }

    .trk-single-month-note {
        font-size: 11px;
        color: #69788b;
        text-align: center;
        margin-bottom: 7px;
    }

    @@media(max-width:650px) {
        .trk-month-chart {
            overflow-x: auto;
        }

            .trk-month-chart svg {
                min-width: 460px;
            }
    }
</style>


<div class="container-fluid py-4 px-0">
    <div class="trk-wrapper">

        <!-- Header -->
        <div class="trk-header">
            <div>
                <h1>Sales Tracking Dashboard</h1>
                <p>Track actual sales performance against the planned targets.</p>
            </div>
            <div class="trk-header-actions">
                <button type="button" class="trk-btn-outline-green" @onclick="@(() => Nav.NavigateTo(TrackingView ? "/SalesTrackingList" : $"/PlanReview?csr2Id={CSR2Id}"))">
                    <SalesAuditIcon Name="arrow-left" Size="15" />
                    @(TrackingView ? "Back to Tracking List" : "Back to Plan Review")
                </button>
                <button type="button" class="trk-btn-outline" disabled="@(!IsLoaded || IsExporting)" @onclick="DownloadTrackingReportAsync" title="Download an Excel (.xlsx) copy of the currently loaded tracking data">
                    <SalesAuditIcon Name="download" Size="15" />
                    @(IsExporting ? "Preparing Excel..." : "Download Tracking Report")
                </button>
                @if (HasData && !TrackingView)
                {
                    <button type="button" class="trk-btn-solid" @onclick="GoToPeriodEndReview">
                        View Final Review
                        <SalesAuditIcon Name="arrow-right" Size="15" />
                    </button>
                }
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(ExportError))
        {
            <div class="alert alert-warning" role="alert">@ExportError</div>
        }

        <SalesAuditStepper CurrentStep="4" TrackingPhase="true" CSR2Id="@CSR2Id" />

        @if (IsLoading)
        {
            <div class="alert alert-info">Loading Sales Tracking...</div>
        }
        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <div class="alert alert-danger">@Error</div>
        }
        @if (!IsLoading && IsLoaded)
        {
            <!-- KPI tiles -->
            <div class="trk-kpi-grid">
                <div class="trk-kpi trk-kpi-purple">
                    <span class="trk-kpi-label">Required Turnover (TO)</span>
                    <span class="trk-kpi-value">₹ @Crore3(RequiredTurnover) Cr</span>
                    <span class="trk-kpi-sub">Minimum target to achieve</span>
                </div>
                <div class="trk-kpi trk-kpi-blue">
                    <span class="trk-kpi-label">Actual Turnover</span>
                    <span class="trk-kpi-value">@(HasKpiData ? $"₹ {Crore3(ActualTurnover)} Cr" : "-")</span>
                    <span class="trk-kpi-sub">From saved cumulative invoice achievements</span>
                </div>
                <div class="trk-kpi trk-kpi-peach">
                    <span class="trk-kpi-label">Achievement %</span>
                    <span class="trk-kpi-value trk-orange">@(HasKpiData ? $"{Pct(AchievementPct)}%" : "-")</span>
                    <span class="trk-kpi-sub">Against required TO</span>
                </div>
                <div class="trk-kpi trk-kpi-peach">
                    <span class="trk-kpi-label">Remaining to Achieve</span>
                    <span class="trk-kpi-value trk-red">@(HasKpiData ? $"₹ {RemainingCrore3(Remaining)} Cr" : "-")</span>
                    <span class="trk-kpi-sub">To reach required TO</span>
                </div>
                <div class="trk-kpi trk-kpi-peach">
                    <span class="trk-kpi-label">Tracking Status</span>
                    <span class="trk-kpi-value trk-red">@(HasKpiData ? (IsFinalSubmitted ? "Submitted" : "In Progress") : "Awaiting Data")</span>
                    <span class="trk-kpi-sub">Loaded from the saved database records</span>
                </div>
            </div>

            <!-- Program summary strip -->
            <div class="trk-card trk-summary">
                <div class="trk-summary-item">
                    <div class="trk-summary-icon trk-tone-green"><SalesAuditIcon Name="users" Size="22" StrokeWidth="1.6" /></div>
                    <div class="trk-summary-text">
                        <span class="trk-label">Program Type</span>
                        <span class="trk-summary-value">@Display(Overview?.ProgramType)</span>
                    </div>
                </div>
                <div class="trk-summary-item">
                    <div class="trk-summary-icon trk-tone-purple"><SalesAuditIcon Name="clipboard" Size="22" StrokeWidth="1.6" /></div>
                    <div class="trk-summary-text">
                        <span class="trk-label">Program Name</span>
                        <span class="trk-summary-value">@Display(Overview?.ProgramName)</span>
                    </div>
                </div>
                <div class="trk-summary-item">
                    <div class="trk-summary-icon trk-tone-blue"><SalesAuditIcon Name="stamp" Size="22" StrokeWidth="1.6" /></div>
                    <div class="trk-summary-text">
                        <span class="trk-label">
                            Scheme Period
                            @if (IsExtended)
                            {
                                <span class="trk-extended-pill"><span class="trk-dot"></span>Extended</span>
                            }
                            else
                            {
                                @* The period is locked after confirmation; changing it goes through Request Extension. *@
                                <button type="button" class="trk-inline-edit" disabled title="Scheme extension API not configured" aria-label="Scheme extension unavailable">
                                    <SalesAuditIcon Name="pencil" Size="13" />
                                </button>
                            }
                        </span>
                        <span class="trk-summary-value">@DateText(SchemeFrom) - @DateText(SchemeTo)</span>
                    </div>
                </div>
                <div class="trk-summary-item">
                    <div class="trk-summary-icon trk-tone-green"><SalesAuditIcon Name="badge-check" Size="22" StrokeWidth="1.6" /></div>
                    <div class="trk-summary-text">
                        <span class="trk-label">Scheme Duration</span>
                        <span class="trk-summary-value trk-green">@DurationText</span>
                    </div>
                </div>
            </div>

            @if (LatestExtension is not null)
            {
                <!-- Read-only extension summary: data is loaded from the selected CSR2 request. -->
                <section class="trk-ext-banner trk-ext-@LatestExtension.Status.ToLowerInvariant()" aria-label="Scheme extension request status">
                    <div class="trk-ext-head">
                        <div class="trk-ext-heading">
                            <span class="trk-ext-symbol"><SalesAuditIcon Name="calendar-clock" Size="20" /></span>
                            <div>
                                <div class="trk-ext-title-line">
                                    <strong>Extension Request</strong>
                                    <span class="trk-ext-status">@ExtensionStatusText</span>
                                </div>
                                <span class="trk-ext-subtitle">@ExtensionStatusDescription</span>
                            </div>
                        </div>
                        <button type="button" class="trk-ext-action" @onclick="() => ShowExtensionStatusDetails = !ShowExtensionStatusDetails">
                            <SalesAuditIcon Name="eye" Size="14" />
                            @(ShowExtensionStatusDetails ? "Hide Request Status" : "View Request Status")
                        </button>
                    </div>
                    <div class="trk-ext-grid">
                        <div class="trk-ext-stat">
                            <span class="trk-ext-label">Requested New End Date</span>
                            <div class="trk-ext-stat-value">@LatestExtension.NewEndDate.ToString("dd MMM yyyy") <span class="trk-ext-duration">+@Math.Max(0, (LatestExtension.NewEndDate.Date - LatestExtension.PreviousEndDate.Date).Days) Days</span></div>
                        </div>
                        <div class="trk-ext-stat">
                            <span class="trk-ext-label">Requested On</span>
                            <div class="trk-ext-stat-value"><SalesAuditIcon Name="calendar" Size="14" /> @LatestExtension.RequestedOn.ToString("dd MMM yyyy, HH:mm")</div>
                        </div>
                        <div class="trk-ext-stat">
                            <span class="trk-ext-label">Requested By</span>
                            <div class="trk-ext-stat-value"><SalesAuditIcon Name="user-round" Size="14" /> @LatestExtension.RequestedBy</div>
                        </div>
                        <div class="trk-ext-stat">
                            <span class="trk-ext-label">Remaining to Target</span>
                            <div class="trk-ext-stat-value">@SalesAuditFormat.Rupees(Remaining) (@Pct(Math.Max(0m, 100m - AchievementPct))%)</div>
                        </div>
                    </div>
                    @if (ShowExtensionStatusDetails)
                    {
                        <div class="trk-ext-extra">
                            <span><strong>Request ID:</strong> @LatestExtension.RequestId</span>
                            <span><strong>Previous End Date:</strong> @LatestExtension.PreviousEndDate.ToString("dd MMM yyyy")</span>
                            <span><strong>Reason:</strong> @LatestExtension.Reason</span>
                            <span><strong>Remarks:</strong> @(string.IsNullOrWhiteSpace(LatestExtension.Remarks) ? "Not provided" : LatestExtension.Remarks)</span>
                        </div>
                    }
                </section>
            }
            else if (!string.IsNullOrWhiteSpace(ExtensionStatusError))
            {
                <div class="alert alert-warning" role="status">@ExtensionStatusError</div>
            }

            @if (!HasKpiData)
            {
                <!-- Awaiting sales data -->
                <div class="trk-card trk-awaiting">
                    <svg class="trk-awaiting-art" width="110" height="90" viewBox="0 0 110 90" fill="none" aria-hidden="true">
                        <ellipse cx="55" cy="46" rx="52" ry="34" fill="#eef1f0" />
                        <path d="M26 30a4 4 0 0 1 4-4h16l6 6h24a4 4 0 0 1 4 4v30a4 4 0 0 1-4 4H30a4 4 0 0 1-4-4z" fill="#f8faf9" stroke="#166534" stroke-width="2" stroke-linejoin="round" />
                        <path d="M32 22h14l5 5h21a3 3 0 0 1 3 3" stroke="#166534" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M26 42h54" stroke="#166534" stroke-width="2" />
                        <circle cx="78" cy="64" r="13" fill="#ffffff" stroke="#166534" stroke-width="2" />
                        <path d="M78 57v8" stroke="#166534" stroke-width="2" stroke-linecap="round" />
                        <circle cx="78" cy="70" r="1.4" fill="#166534" />
                    </svg>
                    <h3 class="trk-awaiting-title">Awaiting Sales Data</h3>
                    <span class="trk-submitted-pill"><span class="trk-dot"></span>@(IsPlanConfirmed ? "Plan Confirmed" : "Awaiting Achievement Data")</span>
                    <p class="trk-awaiting-text">
                        Your sales plan is saved. No product-wise achievement records are available for this programme yet.
                        Tracking values will appear when verified sales are saved in SalesAuditAchievementLines.
                    </p>
                </div>
            }
            else
            {
                @if (DaysRemaining is >= 0 and <= 7)
                {
                    <div class="trk-warning">
                        <div class="trk-warning-top">
                            <div class="trk-warning-title">
                                <SalesAuditIcon Name="alert-triangle" Size="20" CssClass="trk-warning-icon" />
                                <div>
                                    <strong>Scheme Period ends in @DaysRemaining @(DaysRemaining == 1 ? "day" : "days")</strong>
                                    <span>Dates are calculated from the saved scheme period and today's date.</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- Charts -->
                <div class="trk-chart-grid">
                    <div class="trk-card">
                        <h3 class="trk-card-title">Turnover Achievement Overview</h3>
                        <div class="trk-gauge-layout">
                            <figure class="trk-gauge">
                                <div class="trk-gauge-canvas">
                                    <canvas id="trkGaugeChart" role="img" aria-label="@($"{Pct(AchievementPct)}% of the required turnover achieved")"></canvas>
                                    <div class="trk-gauge-center">
                                        <span class="trk-gauge-value">@Pct(AchievementPct)%</span>
                                        <span class="trk-gauge-caption">Achieved</span>
                                    </div>
                                </div>
                                <div class="trk-gauge-ends"><span>0%</span><span>100%</span></div>
                            </figure>

                            <ul class="trk-gauge-legend">
                                <li>
                                    <span class="trk-legend-dot trk-bg-green"></span>
                                    <div><span>Actual Turnover</span><strong class="trk-green">₹ @Crore3(ActualTurnover) Cr</strong></div>
                                </li>
                                <li>
                                    <span class="trk-legend-dot trk-bg-blue"></span>
                                    <div><span>Required Turnover</span><strong class="trk-green">₹ @Crore3(RequiredTurnover) Cr</strong></div>
                                </li>
                                <li>
                                    <span class="trk-legend-dot trk-bg-grey"></span>
                                    <div><span>Remaining</span><strong>₹ @RemainingCrore3(Remaining) Cr</strong></div>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <div class="trk-card">
                        <div class="trk-card-top">
                            <h3 class="trk-card-title">Monthly Progress Trend</h3>
                            <div class="trk-trend-legend">
                                <span><i class="trk-key trk-key-actual"></i>Actual Turnover</span>
                                <span><i class="trk-key trk-key-required"></i>Required Turnover</span>
                            </div>
                        </div>

                        @if (MonthlyInvoiceSales.Count > 0)
                        {
                            <div class="trk-month-chart trk-month-chart-line-v2" role="img"
                                 aria-label="@MonthlyChartAccessibleLabel">
                                <svg viewBox="0 0 680 310" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                    @foreach (var tick in MonthlyChartTicks)
                                    {
                                        <line x1="76" x2="654" y1="@ChartN(tick.Y)" y2="@ChartN(tick.Y)" class="trk-chart-gridline" />
                                        @SvgLabel("65", ChartN(tick.Y + 4), "end", "trk-chart-axis", tick.Label)
                                    }
                                    <path d="@MonthlyActualAreaPath" class="trk-actual-area" />
                                    <path d="@MonthlyActualLinePath" class="trk-actual-line" />
                                    <path d="@MonthlyTargetLinePath" class="trk-target-line" />
                                    @foreach (var (point, pointIndex) in MonthlyChartPoints.Select((p, i) => (p, i)))
                                    {
                                        <circle cx="@ChartN(point.X)" cy="@ChartN(point.ActualY)" r="5.5" class="trk-actual-point" />
                                        @if (pointIndex == MonthlyChartPoints.Count - 1 || MonthlyInvoiceSales.Count > 1)
                                        {
                                            @SvgLabel(ChartN(point.X), ChartN(Math.Max(12, point.ActualY - 13)), "middle", "trk-actual-label", $"₹ {Crore3(point.Actual)} Cr")
                                        }
                                        @if (pointIndex == 0 || pointIndex == MonthlyChartPoints.Count - 1 || MonthlyInvoiceSales.Count > 1)
                                        {
                                            @SvgLabel(ChartN(point.X), "292", "middle", "trk-chart-axis", point.MonthLabel)
                                        }
                                    }
                                    @* One month: draw a horizontal required-target benchmark; multiple months: the same scheme target on each month. *@
                                    @foreach (var point in MonthlyChartPoints)
                                    {
                                        <circle cx="@ChartN(point.X)" cy="@ChartN(point.TargetY)" r="3.5" class="trk-target-point" />
                                    }
                                    @SvgLabel("649", ChartN(Math.Max(12, MonthlyTargetY - 12)), "end", "trk-target-label", $"₹ {Crore3(RequiredTurnover)} Cr")
                                </svg>
                                @if (MonthlyInvoiceSales.Count == 1)
                                {
                                    <div class="trk-single-month-note">@SelectedMonthLabel — cumulative turnover on saved invoice dates (starting from zero at month opening)</div>
                                }
                                <div class="trk-month-chart-note">
                                    Green: saved SAP invoice turnover (cumulative within a single month). Blue dashed: required turnover for the entire scheme (benchmark, not a monthly target).
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="trk-trend" role="status">
                                @(string.IsNullOrEmpty(MonthlyTrendError)
                                    ? "No dated, saved SAP invoice records are available to plot a monthly trend. The overall turnover above can still include saved achievements without invoice dates."
                                    : MonthlyTrendError)
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Product-wise Actual Sales -->
            <div class="trk-card">
                <div class="trk-card-top">
                    <h3 class="trk-card-title">Product - wise Actual Sales (Saved Achievements)</h3>
                    <button type="button" class="trk-btn-outline" disabled title="Details API not yet configured"><SalesAuditIcon Name="pencil" Size="15" /> View Details</button>
                </div>
                <div class="trk-table-wrapper">
                    <table class="trk-table">
                        <thead>
                            <tr>
                                <th class="trk-col-no">S:NO</th>
                                <th>Product</th>
                                <th>Unit</th>
                                <th>Planned Value (₹)</th>
                                <th>Actual Value (₹)</th>
                                <th>Achievement (%)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var (row, index) in ProductSales.Select((r, i) => (r, i)))
                            {
                                <tr>
                                    <td class="trk-col-no">@(index + 1)</td>
                                    <td>@row.Name</td>
                                    <td>@row.Detail</td>
                                    <td>@SalesAuditFormat.Rupees(row.Planned)</td>
                                    <td>@(HasData ? SalesAuditFormat.Rupees(row.Actual) : "-")</td>
                                    <td>@AchievementCell(row.Planned, row.Actual)</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3" class="trk-total-label">Total</td>
                                <td class="trk-total-value">@SalesAuditFormat.Rupees(ProductSales.Sum(r => r.Planned))</td>
                                <td class="trk-total-value">@(HasData ? SalesAuditFormat.Rupees(ProductSales.Sum(r => r.Actual)) : "-")</td>
                                <td class="trk-total-value">@(HasData ? $"{Pct(Percent(ProductSales.Sum(r => r.Actual), ProductSales.Sum(r => r.Planned)))}%" : "-")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <!-- Dealer-wise Actual Sales (Top 5) -->
            <div class="trk-card">
                <div class="trk-card-top">
                    <h3 class="trk-card-title">Dealer-wise Matched SAP Sales (Top 5, read-only)</h3>
                    <button type="button" class="trk-btn-outline" disabled title="Details API not yet configured"><SalesAuditIcon Name="pencil" Size="15" /> View Details</button>
                </div>
                @if (!string.IsNullOrWhiteSpace(DealerSalesError))
                {
                    <div class="alert alert-warning">@DealerSalesError</div>
                }
                <p class="text-muted small">Dealer master names and HQ come from mapped registrations; actual gross sales come from Dealer Mapping's SAP invoice matches. Dealer-level planned values and percentages are unavailable because no dealer commitment is stored.</p>
                <div class="trk-table-wrapper">
                    <table class="trk-table">
                        <thead>
                            <tr>
                                <th class="trk-col-no">S:NO</th>
                                <th>Dealer Name</th>
                                <th>Location</th>
                                <th>Planned Value (₹)</th>
                                <th>Actual Value (₹)</th>
                                <th>Achievement (%)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var (row, index) in TopDealers.Select((r, i) => (r, i)))
                            {
                                <tr>
                                    <td class="trk-col-no">@(index + 1)</td>
                                    <td>@row.Name</td>
                                    <td>@row.Location</td>
                                    <td>--</td>
                                    <td>@(DealerSalesLoaded ? SalesAuditFormat.Rupees(row.Actual) : "--")</td>
                                    <td>--</td>
                                </tr>
                            }
                            @if (TopDealers.Count == 0)
                            {
                                <tr><td colspan="6">No dealers are mapped to this programme.</td></tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3" class="trk-total-label">Total (Top 5)</td>
                                <td class="trk-total-value">--</td>
                                <td class="trk-total-value">@(DealerSalesLoaded ? SalesAuditFormat.Rupees(TopDealers.Sum(r => r.Actual)) : "--")</td>
                                <td class="trk-total-value">--</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <!-- Exact read-only comparison from Dealer Mapping SAP invoice matches. -->
            <div class="trk-card">
                <div class="trk-card-top">
                    <h3 class="trk-card-title">Dealer Sales Achievement - SAP Invoice Matches</h3>
                    <button type="button" class="trk-btn-outline" @onclick="() => ShowMatchedInvoiceDetails = !ShowMatchedInvoiceDetails">
                        @(ShowMatchedInvoiceDetails ? "Hide Details" : "View Details")
                    </button>
                </div>
                @if (MatchedDealerSales is not null)
                {
                    <p class="text-muted small">
                        Scheme: @DateText(MatchedDealerSales.SchemeFrom) to @DateText(MatchedDealerSales.SchemeTo)
                        | Mapped dealers: <strong>@MatchedDealerSales.MappedDealers</strong>
                        | Matching invoice lines: <strong>@MatchedDealerSales.MatchedInvoiceLines</strong>
                    </p>
                    <div class="trk-table-wrapper">
                        <table class="trk-table">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Planned Qty (MT)</th>
                                    <th>Actual Qty (MT)</th>
                                    <th>Planned Value (₹)</th>
                                    <th>Actual Gross (₹)</th>
                                    <th>Balance (₹)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in MatchedDealerSales.Products)
                                {
                                    <tr>
                                        <td>@item.ProductName</td>
                                        <td>@item.PlannedQuantityMT.ToString("N3")</td>
                                        <td>@item.ActualQuantityMT.ToString("N3")</td>
                                        <td>@SalesAuditFormat.Rupees(item.PlannedValueRs)</td>
                                        <td>@SalesAuditFormat.Rupees(item.ActualGrossAmountRs)</td>
                                        <td>@SalesAuditFormat.Rupees(item.BalanceValueRs)</td>
                                    </tr>
                                }
                                @if (MatchedDealerSales.Products.Count == 0)
                                {
                                    <tr><td colspan="6">No product plan lines are available.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (ShowMatchedInvoiceDetails)
                    {
                        <h3 class="trk-card-title" style="margin-top:20px">Matched Dealer Invoice Details</h3>
                        <div class="trk-table-wrapper">
                            <table class="trk-table">
                                <thead>
                                    <tr>
                                        <th>S:NO</th>
                                        <th>Dealer Code</th>
                                        <th>Dealer Name</th>
                                        <th>Billing Date</th>
                                        <th>Billing Document</th>
                                        <th>Product Code</th>
                                        <th>Product</th>
                                        <th>Qty (MT)</th>
                                        <th>Gross Amount (₹)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var (item, index) in MatchedDealerSales.Rows.Select((r, i) => (r, i)))
                                    {
                                        <tr>
                                            <td>@(index + 1)</td>
                                            <td>@item.DealerCode</td>
                                            <td>@item.DealerName</td>
                                            <td>@item.BillingDate.ToString("dd MMM yyyy")</td>
                                            <td>@item.BillingDocument</td>
                                            <td>@item.ProductCode</td>
                                            <td>@item.ProductName</td>
                                            <td>@item.QuantityMT.ToString("N3")</td>
                                            <td>@SalesAuditFormat.Rupees(item.GrossAmountRs)</td>
                                        </tr>
                                    }
                                    @if (MatchedDealerSales.Rows.Count == 0)
                                    {
                                        <tr><td colspan="9">No matching SAP invoices were found for this scheme.</td></tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="8" class="trk-total-label">Total matched invoice gross</td>
                                        <td class="trk-total-value">@SalesAuditFormat.Rupees(MatchedDealerSales.Rows.Sum(r => r.GrossAmountRs))</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                    <p class="text-muted small">Read-only SAP invoice matches. These values are not automatically saved as verified Sales Audit achievements.</p>
                }
                else
                {
                    <p class="text-muted small">@(string.IsNullOrWhiteSpace(DealerSalesError) ? "No matched SAP invoice data available." : DealerSalesError)</p>
                }
            </div>

            <!-- Import area kept after sales analysis to match the dashboard layout. -->
            <div class="trk-card" style="padding: 16px; margin: 12px 0;">
                <h3 class="trk-card-title">Import actual sales achievements (SAP invoice report)</h3>
                <p>Upload a full .xlsx/.xls invoice snapshot for this confirmed scheme. Only invoice items with valid billing dates and exact product-master names are accepted. Uploading again replaces the previous product achievement snapshot.</p>
                @if (!TrackingView && IsPlanConfirmed && !IsFinalSubmitted)
                {
                    <InputFile OnChange="UploadAchievementsAsync" accept=".xlsx,.xls"
                               disabled="@IsUploadingAchievements" />
                }
                else
                {
                    <p>@(TrackingView ? "Read-only Sales Tracking view. Import is unavailable." : IsFinalSubmitted ? "Final-submitted Sales Audit is locked." : "Confirm the plan in Tab 4 before importing achievements.")</p>
                }
                @if (IsUploadingAchievements)
                {
                    <p role="status">Validating and importing SAP invoice rows...</p>
                }
                @if (!string.IsNullOrWhiteSpace(ImportResult))
                {
                    <div class="alert alert-success" role="status">@ImportResult</div>
                }
                @if (!string.IsNullOrWhiteSpace(ImportError))
                {
                    <div class="alert alert-danger" role="alert">@ImportError</div>
                }
            </div>

            <!-- Footer actions -->
            <div class="trk-footer">
                <button type="button" class="trk-btn trk-btn-back" @onclick="BackToList">
                    <SalesAuditIcon Name="chevrons-left" Size="16" />
                    Back to List
                </button>

                <div class="trk-footer-right">
                    @if (HasData)
                    {
                        <button type="button" class="trk-btn trk-btn-back" @onclick="BackToList">Close</button>
                    }
                    else
                    {
                        <span class="trk-footer-note"><SalesAuditIcon Name="info" Size="16" /> Sales data is required to review performance.</span>
                    }
                    <button type="button"
                            class="trk-btn trk-btn-primary"
                            disabled="@(CSR2Id is null or <= 0 || !HasData)"
                            @onclick="GoToPeriodEndReview">
                        Go To Final Review
                        <SalesAuditIcon Name="chevrons-right" Size="16" />
                    </button>
                </div>
            </div>
        }

    </div>
</div>



@code {
    [SupplyParameterFromQuery(Name = "csr2Id")]
    public int? CSR2Id { get; set; }

    // UI-only navigation hint. API must authorize each CSR2 record independently.
    [SupplyParameterFromQuery(Name = "trackingView")]
    public bool TrackingView { get; set; }

    // Retained for old URLs; this query parameter no longer fabricates achievement data.
    [SupplyParameterFromQuery(Name = "state")]
    public string? State { get; set; }

    private sealed class OverviewDto
    {
        public string? ProgramName { get; set; }
        public string? ProgramType { get; set; }
        public bool IsPlanConfirmed { get; set; }
        public bool IsFinalSubmitted { get; set; }
        public decimal ActualTurnoverCr { get; set; }
    }
    private sealed class ProductDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
    }
    private sealed class AuditLineDto
    {
        public int ProductId { get; set; }
        public decimal QuantityMT { get; set; }
        public decimal ValueRs { get; set; }
    }
    private sealed class DetailsDto
    {
        public DateTime? SchemeFrom { get; set; }
        public DateTime? SchemeTo { get; set; }
        public decimal RequiredTurnoverRs { get; set; }
        public bool IsFinalSubmitted { get; set; }
        public bool IsPlanConfirmed { get; set; }
        public List<ProductDto> Products { get; set; } = new();
        public List<AuditLineDto> Plan { get; set; } = new();
        public List<AuditLineDto> Achievement { get; set; } = new();
    }
    private sealed class DealerMappingDto
    {
        public List<DealerDto> Rows { get; set; } = new();
    }
    // Current dealer-mapping API contract: identifiers and master details only.
    // Per-dealer planned commitments are not stored in SalesAuditDealerMapping.
    private sealed class DealerDto
    {
        public string DealerCode { get; set; } = "";
        public string DealerName { get; set; } = "";
        public string HeadquartersName { get; set; } = "";
        public string RegionName { get; set; } = "";
        public string StateName { get; set; } = "";
    }

    // Same SAP matched-invoice endpoint used by DealerMapping.razor.
    private sealed class MatchedDealerSalesDto
    {
        public DateTime SchemeFrom { get; set; }
        public DateTime SchemeTo { get; set; }
        public int MappedDealers { get; set; }
        public int MatchedInvoiceLines { get; set; }
        public int ExcludedOutsideDates { get; set; }
        public int ExcludedDifferentUnits { get; set; }
        public List<MatchedProductSalesDto> Products { get; set; } = new();
        public List<MatchedDealerInvoiceDto> Rows { get; set; } = new();
    }
    private sealed class MatchedProductSalesDto
    {
        public int ProductId { get; set; }
        public string ProductName { get; set; } = "";
        public decimal PlannedQuantityMT { get; set; }
        public decimal ActualQuantityMT { get; set; }
        public decimal PlannedValueRs { get; set; }
        public decimal ActualGrossAmountRs { get; set; }
        public decimal BalanceValueRs { get; set; }
    }
    private sealed class MatchedDealerInvoiceDto
    {
        public long SaleId { get; set; }
        public string DealerCode { get; set; } = "";
        public string DealerName { get; set; } = "";
        public DateTime BillingDate { get; set; }
        public string BillingDocument { get; set; } = "";
        public string ProductCode { get; set; } = "";
        public string ProductName { get; set; } = "";
        public decimal QuantityMT { get; set; }
        public decimal GrossAmountRs { get; set; }
    }
    private record DealerSalesRow(string DealerCode, string Name, string Location, decimal Actual);

    // Same read-only endpoint and saved-status semantics used in Plan Review.
    private sealed class MonthlySapResponse
    {
        public List<MonthlySapRow> Rows { get; set; } = new();
    }
    private sealed class MonthlySapRow
    {
        public bool IsSaved { get; set; }
        public DateTime BillingDate { get; set; }
        public decimal GrossAmountRs { get; set; }
    }
    private record MonthSales(DateTime Month, decimal Amount);
    private List<MonthSales> MonthlyInvoiceSales = new();
    private record DailySale(DateTime Date, decimal Amount);
    private List<DailySale> SelectedMonthDailySales = new();
    private string MonthlyTrendError = "";
    private MonthSales? SelectedMonth => MonthlyInvoiceSales.LastOrDefault();
    private string SelectedMonthLabel => SelectedMonth?.Month.ToString("MMMM yyyy", System.Globalization.CultureInfo.InvariantCulture) ?? "--";
    private decimal SelectedMonthActual => SelectedMonth?.Amount ?? 0m;
    // Plot only months present in saved invoice data. Never interpolate missing months.
    private record MonthlyChartPoint(string MonthLabel, decimal Actual, double X, double ActualY, double TargetY);
    private record MonthlyChartTick(double Y, string Label);
    private const double ChartTop = 40d;
    private const double ChartBottom = 270d;
    private double MonthlyChartMax => Math.Max(0.01d,
        Math.Max((double)RequiredTurnover,
                 MonthlyInvoiceSales.Count == 0 ? 0d : (double)MonthlyInvoiceSales.Max(m => m.Amount)) / 10_000_000d) * 1.2d;
    private double ChartY(decimal rupees) => ChartBottom - Math.Clamp((double)(rupees / 10_000_000m) / MonthlyChartMax, 0d, 1d) * (ChartBottom - ChartTop);
    private double MonthlyTargetY => ChartY(RequiredTurnover);
    private static string ChartN(double n) => n.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    // Razor reserves the <text> tag for text templates; emit SVG text through RenderTreeBuilder.
    private static RenderFragment SvgLabel(string x, string y, string anchor, string cssClass, string label) => builder =>
    {
        builder.OpenElement(0, "text");
        builder.AddAttribute(1, "x", x);
        builder.AddAttribute(2, "y", y);
        builder.AddAttribute(3, "text-anchor", anchor);
        builder.AddAttribute(4, "class", cssClass);
        builder.AddContent(5, label);
        builder.CloseElement();
    };

    // A single month is shown as a real within-month cumulative trend, not a horizontal-bar chart.
    // The first point is the beginning-of-month zero baseline (not a fabricated invoice).
    // Subsequent points are derived exclusively from saved, dated SAP invoices.
    // Monthly chart data is immutable between refreshes; avoid recalculating it
    // repeatedly from several Razor bindings during every render.
    private List<MonthlyChartPoint>? _cachedMonthlyChartPoints;
    private List<MonthlyChartPoint> MonthlyChartPoints =>
        _cachedMonthlyChartPoints ??= BuildMonthlyChartPoints();

    private List<MonthlyChartPoint> BuildMonthlyChartPoints()
    {
        if (MonthlyInvoiceSales.Count == 1 && SelectedMonthDailySales.Count > 0)
        {
            var month = MonthlyInvoiceSales[0].Month;
            var daysInMonth = DateTime.DaysInMonth(month.Year, month.Month);
            var points = new List<MonthlyChartPoint>
                {
                    new MonthlyChartPoint($"01 {month:MMM}", 0m, 86d, ChartY(0m), MonthlyTargetY)
                };
            decimal running = 0m;
            foreach (var day in SelectedMonthDailySales)
            {
                running += day.Amount;
                var x = 86d + 558d * Math.Max(1, day.Date.Day - 1) / Math.Max(1, daysInMonth - 1);
                points.Add(new MonthlyChartPoint(day.Date.ToString("dd MMM"), running, x,
                    ChartY(running), MonthlyTargetY));
            }
            return points;
        }
        return MonthlyInvoiceSales.Select((m, i) => new MonthlyChartPoint(
            m.Month.ToString("MMM yyyy", System.Globalization.CultureInfo.InvariantCulture),
            m.Amount, MonthlyInvoiceSales.Count == 1 ? 365d : 86d + 558d * i / (MonthlyInvoiceSales.Count - 1),
            ChartY(m.Amount), MonthlyTargetY)).ToList();
    }
    private IEnumerable<MonthlyChartTick> MonthlyChartTicks => Enumerable.Range(0, 5).Select(i =>
        new MonthlyChartTick(ChartBottom - (ChartBottom - ChartTop) * i / 4d,
            i == 0 ? "₹ 0" : $"₹ {(MonthlyChartMax * i / 4d):0.00} Cr"));
    private string MonthlyActualLinePath => string.Join(" ", MonthlyChartPoints.Select((p, i) =>
        $"{(i == 0 ? "M" : "L")}{ChartN(p.X)} {ChartN(p.ActualY)}"));
    private string MonthlyActualAreaPath => MonthlyChartPoints.Count == 0 ? "" :
        $"M{ChartN(MonthlyChartPoints[0].X)} {ChartN(ChartBottom)} " +
        string.Join(" ", MonthlyChartPoints.Select(p => $"L{ChartN(p.X)} {ChartN(p.ActualY)}")) +
        $" L{ChartN(MonthlyChartPoints[^1].X)} {ChartN(ChartBottom)} Z";
    private string MonthlyTargetLinePath => MonthlyChartPoints.Count == 0 ? "" :
        MonthlyInvoiceSales.Count == 1
            ? $"M76 {ChartN(MonthlyTargetY)} L654 {ChartN(MonthlyTargetY)}"
            : string.Join(" ", MonthlyChartPoints.Select((p, i) =>
                $"{(i == 0 ? "M" : "L")}{ChartN(p.X)} {ChartN(p.TargetY)}"));
    private string MonthlyChartAccessibleLabel =>
        "Monthly saved SAP invoice turnover: " + string.Join(", ", MonthlyInvoiceSales.Select(m =>
            $"{m.Month:MMM yyyy} {SalesAuditFormat.Rupees(m.Amount)}")) +
        $". Full scheme required turnover benchmark: {SalesAuditFormat.Rupees(RequiredTurnover)}.";

    private async Task LoadDealerSalesAsync(int csr2Id, DealerMappingDto mapping)
    {
        TopDealers = new();
        DealerSalesLoaded = false;
        MatchedDealerSales = null;
        DealerSalesError = "";
        try
        {
            // Match the Dealer Mapping page's endpoint and default matching rules.
            using var response = await Http.GetAsync(
                $"api/SalesAudit/dealer-mapping/sap-sales?csr2Id={csr2Id}");
            if (!response.IsSuccessStatusCode)
            {
                DealerSalesError = $"Dealer SAP matches unavailable (HTTP {(int)response.StatusCode}).";
                return;
            }
            var sales = await response.Content.ReadFromJsonAsync<MatchedDealerSalesDto>();
            if (sales is null)
            {
                DealerSalesError = "Dealer SAP matches response was empty.";
                return;
            }
            MatchedDealerSales = sales;
            DealerSalesLoaded = true;
            var totals = (sales.Rows ?? new())
                .Where(x => !string.IsNullOrWhiteSpace(x.DealerCode))
                .GroupBy(x => x.DealerCode.Trim(), StringComparer.OrdinalIgnoreCase)
                .ToDictionary(x => x.Key, x => x.Sum(r => r.GrossAmountRs),
                    StringComparer.OrdinalIgnoreCase);

            // Show mapped dealers even when they have no matching SAP sales.
            // Do not group on absent legacy CustomerNumber; it collapsed all rows.
            TopDealers = (mapping.Rows ?? new())
                .Where(x => !string.IsNullOrWhiteSpace(x.DealerCode))
                .GroupBy(x => x.DealerCode.Trim(), StringComparer.OrdinalIgnoreCase)
                .Select(g =>
                {
                    var dealer = g.First();
                    var code = g.Key;
                    return new DealerSalesRow(code,
                        string.IsNullOrWhiteSpace(dealer.DealerName) ? code : dealer.DealerName,
                        SafeLabel(dealer.HeadquartersName) != "--" ? SafeLabel(dealer.HeadquartersName) :
                        SafeLabel(dealer.RegionName) != "--" ? SafeLabel(dealer.RegionName) :
                        SafeLabel(dealer.StateName),
                        totals.TryGetValue(code, out var amount) ? amount : 0m);
                })
                .OrderByDescending(x => x.Actual)
                .ThenBy(x => x.Name)
                .Take(5)
                .ToList();
        }
        catch (Exception ex)
        {
            DealerSalesError = $"Unable to load dealer SAP matches: {ex.Message}";
        }
    }

    private async Task LoadMonthlyInvoiceSalesAsync(int csr2Id)
    {
        _cachedMonthlyChartPoints = null;
        MonthlyInvoiceSales = new();
        SelectedMonthDailySales = new();
        MonthlyTrendError = "";
        try
        {
            using var response = await Http.GetAsync($"api/SalesAudit/dealer-mapping/sap-sales?csr2Id={csr2Id}&excludeSaved=false");
            if (!response.IsSuccessStatusCode)
            {
                MonthlyTrendError = $"Monthly graph unavailable: saved invoice API returned HTTP {(int)response.StatusCode}.";
                return;
            }
            var result = await response.Content.ReadFromJsonAsync<MonthlySapResponse>();
            var savedInvoices = (result?.Rows ?? new())
                .Where(r => r.IsSaved && r.BillingDate != default)
                .ToList();
            MonthlyInvoiceSales = savedInvoices
                .GroupBy(r => new DateTime(r.BillingDate.Year, r.BillingDate.Month, 1))
                .Select(g => new MonthSales(g.Key, g.Sum(r => r.GrossAmountRs)))
                .OrderBy(x => x.Month)
                .ToList();
            if (MonthlyInvoiceSales.Count == 1)
            {
                var month = MonthlyInvoiceSales[0].Month;
                SelectedMonthDailySales = savedInvoices
                    .Where(r => r.BillingDate.Year == month.Year && r.BillingDate.Month == month.Month)
                    .GroupBy(r => r.BillingDate.Date)
                    .Select(g => new DailySale(g.Key, g.Sum(r => r.GrossAmountRs)))
                    .OrderBy(x => x.Date)
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            MonthlyTrendError = $"Monthly graph unavailable: {ex.Message}";
        }
    }

    private OverviewDto? Overview;
    private bool IsLoading, IsLoaded, IsPlanConfirmed, IsFinalSubmitted;
    private bool IsUploadingAchievements;
    private string ImportError = "", ImportResult = "";
    private const long TrackingMaxFileBytes = 5 * 1024 * 1024;

    private async Task UploadAchievementsAsync(InputFileChangeEventArgs e)
    {
        if (TrackingView || CSR2Id is null or <= 0 || !IsPlanConfirmed || IsFinalSubmitted || IsUploadingAchievements)
            return;
        var file = e.File;
        ImportError = ImportResult = "";
        if (file.Size <= 0 || file.Size > TrackingMaxFileBytes ||
            Path.GetExtension(file.Name).ToLowerInvariant() is not (".xlsx" or ".xls"))
        {
            ImportError = "Upload an XLSX or XLS file up to 5 MB.";
            return;
        }
        IsUploadingAchievements = true;
        try
        {
            using var form = new MultipartFormDataContent();
            using var stream = file.OpenReadStream(TrackingMaxFileBytes);
            using var content = new StreamContent(stream);
            content.Headers.ContentType = new MediaTypeHeaderValue("application/octet-stream");
            form.Add(content, "file", file.Name);
            using var response = await Http.PostAsync(
                $"api/SalesAudit/tracking/import-achievements?csr2Id={CSR2Id.Value}", form);
            if (!response.IsSuccessStatusCode)
            {
                ImportError = $"Import failed (HTTP {(int)response.StatusCode}): " +
                              await response.Content.ReadAsStringAsync();
                return;
            }
            var saved = await response.Content.ReadFromJsonAsync<TrackingImportResult>();
            await OnParametersSetAsync();
            ImportResult = $"Saved {saved?.ProductAchievementLines ?? 0} product achievement lines " +
                           $"from {saved?.ImportedInvoiceLines ?? 0} invoice rows. " +
                           "These amounts are based on the uploaded SAP report, not an independently verified SAP connection.";
        }
        catch (Exception ex) { ImportError = $"Unable to import achievements: {ex.Message}"; }
        finally { IsUploadingAchievements = false; }
    }

    private sealed class TrackingImportResult
    {
        public int ImportedInvoiceLines { get; set; }
        public int ProductAchievementLines { get; set; }
    }

    private string Error = "";
    private DateTime? SchemeFrom, SchemeTo;
    private decimal RequiredTurnover, ActualTurnover;
    private record SalesRow(string Name, string Detail, decimal Planned, decimal Actual);
    private List<SalesRow> ProductSales = new();
    private List<DealerSalesRow> TopDealers = new();
    private string DealerSalesError = "";
    private bool DealerSalesLoaded;
    private MatchedDealerSalesDto? MatchedDealerSales;
    private bool ShowMatchedInvoiceDetails = true;
    private static string SafeLabel(string? value) =>
        string.IsNullOrWhiteSpace(value) || value.Trim() == "0" ? "--" : value.Trim();

    // HasData only indicates actual, persisted product achievement records.
    // A query string or SAP dealer commitment must not fabricate achievements.
    private bool HasData { get; set; }
    private bool HasKpiData => HasData || (Overview?.ActualTurnoverCr ?? 0m) > 0m;
    // True only when an extension was approved and its scheme period was updated.
    private bool IsExtended => HasApprovedExtension;
    private bool HasApprovedExtension;
    private ExtensionTrackingStatusDto? LatestExtension;
    private bool ShowExtensionStatusDetails;
    private string ExtensionStatusError = "";

    private sealed class ExtensionTrackingStatusDto
    {
        public int RequestId { get; set; }
        public int CSRId { get; set; }
        public DateTime PreviousEndDate { get; set; }
        public DateTime NewEndDate { get; set; }
        public DateTime RequestedOn { get; set; }
        public string RequestedBy { get; set; } = "";
        public string Status { get; set; } = "";
        public string Reason { get; set; } = "";
        public string? Remarks { get; set; }
        public bool HasApprovedExtension { get; set; }
    }

    private async Task LoadExtensionStatusAsync(int csr2Id)
    {
        LatestExtension = null;
        HasApprovedExtension = false;
        ExtensionStatusError = "";
        try
        {
            using var response = await Http.GetAsync($"api/SalesAudit/extension/{csr2Id}/latest");
            if (response.StatusCode == System.Net.HttpStatusCode.NotFound) return;
            if (!response.IsSuccessStatusCode)
            {
                ExtensionStatusError = $"Extension status unavailable (HTTP {(int)response.StatusCode}).";
                return;
            }
            LatestExtension = await response.Content.ReadFromJsonAsync<ExtensionTrackingStatusDto>();
            HasApprovedExtension = LatestExtension?.HasApprovedExtension ?? false;
        }
        catch (Exception ex)
        {
            ExtensionStatusError = $"Unable to load extension status: {ex.Message}";
        }
    }

    private string ExtensionStatusText => LatestExtension?.Status switch
    {
        "Submitted" => "Pending Admin Review",
        "Approved" => "Approved",
        "Rejected" => "Rejected",
        _ => "Unknown"
    };

    private string ExtensionStatusDescription => LatestExtension?.Status switch
    {
        "Submitted" => "You have requested additional time to achieve the target",
        "Approved" => "The extension was approved and the scheme end date was updated",
        "Rejected" => "The extension was rejected; the scheme end date was not changed",
        _ => ""
    };

    private decimal Remaining => Math.Max(0m, RequiredTurnover - ActualTurnover);
    private decimal AchievementPct => Percent(ActualTurnover, RequiredTurnover);
    private int? DaysRemaining => SchemeTo.HasValue
        ? (SchemeTo.Value.Date - DateTime.Today).Days : null;

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "--" : value;
    private static string DateText(DateTime? date) => date?.ToString("dd MMM yyyy") ?? "--";
    private static decimal Percent(decimal part, decimal whole) => whole == 0 ? 0 : part / whole * 100;
    private static string Pct(decimal value) => value.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
    private static string Crore3(decimal value) =>
        (value / 10_000_000m).ToString("0.000", System.Globalization.CultureInfo.InvariantCulture);
    // Display requirement: truncate the remaining value at 3 crore decimals.
    // Keep full precision for the underlying arithmetic and percentage.
    private static string RemainingCrore3(decimal value) =>
        (decimal.Truncate(value / 10_000_000m * 1000m) / 1000m)
        .ToString("0.000", System.Globalization.CultureInfo.InvariantCulture);
    private static string F(decimal value) => value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private string DurationText
    {
        get
        {
            if (!SchemeFrom.HasValue || !SchemeTo.HasValue) return "--";
            if (SchemeTo.Value.Date < SchemeFrom.Value.Date) return "Invalid period";
            var days = (SchemeTo.Value.Date - SchemeFrom.Value.Date).Days + 1;
            var months = (SchemeTo.Value.Year - SchemeFrom.Value.Year) * 12
                         + SchemeTo.Value.Month - SchemeFrom.Value.Month + 1;
            return $"{months} {(months == 1 ? "Month" : "Months")} ({days} Days)";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        IsLoaded = false;
        IsLoading = true;
        Error = "";
        HasData = false;
        Overview = null;
        ActualTurnover = 0m;
        ProductSales = new();
        TopDealers = new();
        DealerSalesError = "";
        DealerSalesLoaded = false;
        MatchedDealerSales = null;
        LatestExtension = null;
        ShowExtensionStatusDetails = false;
        ExtensionStatusError = "";
        _cachedMonthlyChartPoints = null;
        MonthlyInvoiceSales = new();
        MonthlyTrendError = "";
        if (CSR2Id is null or <= 0)
        {
            Error = "Missing csr2Id. Open Sales Tracking from Plan Review.";
            IsLoading = false;
            return;
        }

        try
        {
            var id = CSR2Id.Value;
            // Launch independent read requests together; each endpoint enforces
            // its own server-side authorization. Keep the existing error order.
            // ReadAs... below remains sequential, but network latency overlaps.
            using var overviewRequest = new HttpRequestMessage(HttpMethod.Get, $"api/SalesAudit/overview?csr2Id={id}");
            using var detailsRequest = new HttpRequestMessage(HttpMethod.Get, $"api/SalesAudit/details?csr2Id={id}");
            using var dealersRequest = new HttpRequestMessage(HttpMethod.Get, $"api/SalesAudit/dealer-mapping?csr2Id={id}");
            var overviewTask = Http.SendAsync(overviewRequest);
            var detailsTask = Http.SendAsync(detailsRequest);
            var dealersTask = Http.SendAsync(dealersRequest);
            await Task.WhenAll(overviewTask, detailsTask, dealersTask);
            using var overviewResponse = await overviewTask;
            using var detailsResponse = await detailsTask;
            using var dealersResponse = await dealersTask;
            if (!overviewResponse.IsSuccessStatusCode)
            {
                var responseBody = await overviewResponse.Content.ReadAsStringAsync();
                var detail = string.IsNullOrWhiteSpace(responseBody)
                    ? "The API did not include an error reason."
                    : responseBody[..Math.Min(responseBody.Length, 400)];
                Error = $"Unable to load programme (HTTP {(int)overviewResponse.StatusCode}) " +
                    $"from GET api/SalesAudit/overview?csr2Id={id}. " +
                    $"Server response: {detail}";
                return;
            }
            if (!detailsResponse.IsSuccessStatusCode)
            {
                Error = $"Unable to load sales plan / achievement (HTTP {(int)detailsResponse.StatusCode}) from GET api/SalesAudit/details?csr2Id={id}.";
                return;
            }
            if (!dealersResponse.IsSuccessStatusCode)
            {
                Error = $"Unable to load dealer allocation (HTTP {(int)dealersResponse.StatusCode}) from GET api/SalesAudit/dealer-mapping?csr2Id={id}.";
                return;
            }

            var overview = await overviewResponse.Content.ReadFromJsonAsync<OverviewDto>();
            var details = await detailsResponse.Content.ReadFromJsonAsync<DetailsDto>();
            var dealers = await dealersResponse.Content.ReadFromJsonAsync<DealerMappingDto>();
            if (overview is null || details is null || dealers is null)
            {
                Error = "One or more Sales Audit API responses were empty.";
                return;
            }

            Overview = overview;
            SchemeFrom = details.SchemeFrom;
            SchemeTo = details.SchemeTo;
            RequiredTurnover = details.RequiredTurnoverRs;
            IsPlanConfirmed = details.IsPlanConfirmed || overview.IsPlanConfirmed;
            IsFinalSubmitted = details.IsFinalSubmitted || overview.IsFinalSubmitted;
            var plans = details.Plan ?? new();
            var achievements = details.Achievement ?? new();
            HasData = achievements.Count > 0;
            // Same persisted cumulative value used by PlanReview.razor.
            // Product achievement lines remain for the product-wise breakdown only.
            ActualTurnover = overview.ActualTurnoverCr * 10_000_000m;
            var names = (details.Products ?? new())
                .GroupBy(x => x.Id).ToDictionary(g => g.Key, g => g.First().Name);
            var achievementsByProduct = achievements
                .GroupBy(x => x.ProductId).ToDictionary(g => g.Key, g => g.Sum(x => x.ValueRs));
            ProductSales = plans.Select(p => new SalesRow(
                names.TryGetValue(p.ProductId, out var name) ? name : $"Product #{p.ProductId}",
                "MT", p.ValueRs,
                achievementsByProduct.TryGetValue(p.ProductId, out var achieved) ? achieved : 0m)).ToList();
            // Include achieved products not in the original plan instead of hiding sales.
            foreach (var item in achievementsByProduct.Where(x => plans.All(p => p.ProductId != x.Key)))
                ProductSales.Add(new SalesRow(
                    names.TryGetValue(item.Key, out var extra) ? extra : $"Product #{item.Key}",
                    "MT", 0m, item.Value));

            // DealerMapping.razor resolves dealer membership from dealer-mapping and
            // invoice values from sap-sales. Neither per-dealer plans nor actual values
            // exist on dealer-mapping rows. Keep matched SAP figures distinct from the
            // saved, verified SalesAuditAchievementLine KPI above.
            // Separate SAP data semantics must remain intact; load in parallel.
            // Dealer matching uses the endpoint default, while the monthly chart
            // explicitly includes saved invoice rows.
            await Task.WhenAll(
                LoadDealerSalesAsync(id, dealers),
                LoadMonthlyInvoiceSalesAsync(id),
                LoadExtensionStatusAsync(id));
            IsLoaded = true;
        }
        catch (Exception ex)
        {
            Error = $"Unable to load Sales Tracking: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }


    // Excel report: exported numbers are derived only from loaded, authorized dashboard data.
    // No API write calls. Planned dealer amounts are intentionally absent, not zero.
    private bool IsExporting;
    private IJSObjectReference? _excelModule;
    private string ExportError = "";
    private async Task DownloadTrackingReportAsync()
    {
        if (!IsLoaded || CSR2Id is not > 0 || IsExporting) return;
        IsExporting = true;
        ExportError = "";
        try
        {
            static object? N(decimal value) => value;
            static string D(DateTime? value) => value?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture) ?? "";
            var sheets = new List<ExcelSheet>
            {
                new("Summary", new[] { "Metric", "Value" }, new List<object?[]>
                {
                    new object?[] { "CSR2 ID", CSR2Id.Value },
                    new object?[] { "Programme Name", Overview?.ProgramName ?? "" },
                    new object?[] { "Programme Type", Overview?.ProgramType ?? "" },
                    new object?[] { "Scheme From", D(SchemeFrom) },
                    new object?[] { "Scheme To", D(SchemeTo) },
                    new object?[] { "Required Turnover (INR)", N(RequiredTurnover) },
                    new object?[] { "Actual Turnover - saved audit (INR)", N(ActualTurnover) },
                    new object?[] { "Achievement (%)", N(AchievementPct) },
                    new object?[] { "Remaining (INR)", N(Remaining) },
                    new object?[] { "Plan Confirmed", IsPlanConfirmed ? "Yes" : "No" },
                    new object?[] { "Final Submitted", IsFinalSubmitted ? "Yes" : "No" },
                    new object?[] { "Mapped Dealers (SAP match)", MatchedDealerSales?.MappedDealers },
                    new object?[] { "Matched SAP Invoice Lines", MatchedDealerSales?.MatchedInvoiceLines },
                    new object?[] { "Matched SAP Gross (INR, unverified)", MatchedDealerSales is null ? null : N(MatchedDealerSales.Rows.Sum(x => x.GrossAmountRs)) },
                    new object?[] { "Note", "SAP matches are read-only and do not automatically count as verified audit achievements." }
                }),
                new("Product Achievements", new[] { "Product", "Unit", "Planned (INR)", "Saved Achievement (INR)", "Achievement (%)" },
                    ProductSales.Select(p => new object?[]
                    {
                        p.Name, p.Detail, N(p.Planned), HasData ? N(p.Actual) : null,
                        HasData && p.Planned > 0 ? N(p.Actual / p.Planned * 100m) : null
                    }).ToList()),
                new("Dealer Top 5", new[] { "Dealer Code", "Dealer Name", "Location", "Planned (INR)", "Matched SAP Gross (INR)", "Achievement (%)" },
                    TopDealers.Select(p => new object?[] { p.DealerCode, p.Name, p.Location, null, DealerSalesLoaded ? N(p.Actual) : null, null }).ToList()),
                new("SAP Product Matches", new[] { "Product", "Planned Qty (MT)", "Actual Qty (MT)", "Planned (INR)", "Actual SAP Gross (INR)", "Balance (INR)" },
                    (MatchedDealerSales?.Products ?? new()).Select(p => new object?[]
                    { p.ProductName, N(p.PlannedQuantityMT), N(p.ActualQuantityMT), N(p.PlannedValueRs), N(p.ActualGrossAmountRs), N(p.BalanceValueRs) }).ToList()),
                new("Matched SAP Invoices", new[] { "Dealer Code", "Dealer Name", "Billing Date", "Billing Document", "Product Code", "Product", "Qty (MT)", "Gross (INR)" },
                    (MatchedDealerSales?.Rows ?? new()).Select(p => new object?[]
                    { p.DealerCode, p.DealerName, D(p.BillingDate), p.BillingDocument, p.ProductCode, p.ProductName, N(p.QuantityMT), N(p.GrossAmountRs) }).ToList()),
                new("Monthly Saved Sales", new[] { "Month", "Saved SAP Gross (INR)" },
                    MonthlyInvoiceSales.Select(m => new object?[] { m.Month.ToString("yyyy-MM"), N(m.Amount) }).ToList())
            };
            await using var stream = ExcelWriter.CreateWorkbook(sheets);
            using var reference = new DotNetStreamReference(stream);
            _excelModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/salesTrackingExcel.js");
            await _excelModule.InvokeVoidAsync("downloadExcel", $"SalesTracking_CSR2_{CSR2Id.Value}_{DateTime.Today:yyyyMMdd}.xlsx", reference);
        }
        catch (Exception ex)
        {
            ExportError = "Excel export failed: " + ex.Message;
        }
        finally { IsExporting = false; }
    }

    private sealed record ExcelSheet(string Name, string[] Headers, List<object?[]> Rows);

    // Minimal standards-compliant XLSX (Office Open XML) writer using framework APIs.
    // Avoids introducing new NuGet dependencies into the existing MAUI project.
    private static class ExcelWriter
    {
        private const string Ns = "http://schemas.openxmlformats.org/spreadsheetml/2006/main";
        private const string RelNs = "http://schemas.openxmlformats.org/officeDocument/2006/relationships";
        private static readonly XmlWriterSettings Settings = new() { Encoding = new UTF8Encoding(false), Indent = false, CloseOutput = false };

        public static MemoryStream CreateWorkbook(IReadOnlyList<ExcelSheet> sheets)
        {
            var stream = new MemoryStream();
            using (var zip = new ZipArchive(stream, ZipArchiveMode.Create, leaveOpen: true))
            {
                Write(zip, "[Content_Types].xml", w =>
                {
                    w.WriteStartElement("Types", "http://schemas.openxmlformats.org/package/2006/content-types");
                    w.WriteStartElement("Default", "http://schemas.openxmlformats.org/package/2006/content-types"); w.WriteAttributeString("Extension", "rels"); w.WriteAttributeString("ContentType", "application/vnd.openxmlformats-package.relationships+xml"); w.WriteEndElement();
                    w.WriteStartElement("Default", "http://schemas.openxmlformats.org/package/2006/content-types"); w.WriteAttributeString("Extension", "xml"); w.WriteAttributeString("ContentType", "application/xml"); w.WriteEndElement();
                    Override(w, "/xl/workbook.xml", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml");
                    Override(w, "/xl/styles.xml", "application/vnd.openxmlformats-officedocument.spreadsheetml.styles+xml");
                    for (var i = 0; i < sheets.Count; i++) Override(w, $"/xl/worksheets/sheet{i + 1}.xml", "application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml");
                    w.WriteEndElement();
                });
                Write(zip, "_rels/.rels", w =>
                {
                    w.WriteStartElement("Relationships", "http://schemas.openxmlformats.org/package/2006/relationships");
                    Relationship(w, "rId1", "http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument", "xl/workbook.xml");
                    w.WriteEndElement();
                });
                Write(zip, "xl/workbook.xml", w =>
                {
                    w.WriteStartElement("workbook", Ns);
                    w.WriteAttributeString("xmlns", "r", null, RelNs);
                    w.WriteStartElement("sheets", Ns);
                    for (var i = 0; i < sheets.Count; i++)
                    {
                        w.WriteStartElement("sheet", Ns);
                        w.WriteAttributeString("name", sheets[i].Name);
                        w.WriteAttributeString("sheetId", (i + 1).ToString(System.Globalization.CultureInfo.InvariantCulture));
                        w.WriteAttributeString("r", "id", RelNs, $"rId{i + 1}");
                        w.WriteEndElement();
                    }
                    w.WriteEndElement(); w.WriteEndElement();
                });
                Write(zip, "xl/_rels/workbook.xml.rels", w =>
                {
                    w.WriteStartElement("Relationships", "http://schemas.openxmlformats.org/package/2006/relationships");
                    for (var i = 0; i < sheets.Count; i++)
                        Relationship(w, $"rId{i + 1}", "http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet", $"worksheets/sheet{i + 1}.xml");
                    Relationship(w, $"rId{sheets.Count + 1}", "http://schemas.openxmlformats.org/officeDocument/2006/relationships/styles", "styles.xml");
                    w.WriteEndElement();
                });
                Write(zip, "xl/styles.xml", w =>
                {
                    w.WriteStartElement("styleSheet", Ns);
                    w.WriteStartElement("fonts", Ns); w.WriteAttributeString("count", "2");
                    w.WriteStartElement("font", Ns); w.WriteStartElement("sz", Ns); w.WriteAttributeString("val", "11"); w.WriteEndElement(); w.WriteEndElement();
                    w.WriteStartElement("font", Ns); w.WriteStartElement("b", Ns); w.WriteEndElement(); w.WriteStartElement("sz", Ns); w.WriteAttributeString("val", "11"); w.WriteEndElement(); w.WriteEndElement(); w.WriteEndElement();
                    w.WriteStartElement("fills", Ns); w.WriteAttributeString("count", "2");
                    w.WriteStartElement("fill", Ns); w.WriteStartElement("patternFill", Ns); w.WriteAttributeString("patternType", "none"); w.WriteEndElement(); w.WriteEndElement();
                    w.WriteStartElement("fill", Ns); w.WriteStartElement("patternFill", Ns); w.WriteAttributeString("patternType", "gray125"); w.WriteEndElement(); w.WriteEndElement(); w.WriteEndElement();
                    w.WriteStartElement("borders", Ns); w.WriteAttributeString("count", "1"); w.WriteStartElement("border", Ns); w.WriteEndElement(); w.WriteEndElement();
                    w.WriteStartElement("cellStyleXfs", Ns); w.WriteAttributeString("count", "1"); w.WriteStartElement("xf", Ns); w.WriteAttributeString("numFmtId", "0"); w.WriteAttributeString("fontId", "0"); w.WriteAttributeString("fillId", "0"); w.WriteAttributeString("borderId", "0"); w.WriteEndElement(); w.WriteEndElement();
                    w.WriteStartElement("cellXfs", Ns); w.WriteAttributeString("count", "2");
                    for (var i = 0; i < 2; i++) { w.WriteStartElement("xf", Ns); w.WriteAttributeString("numFmtId", "0"); w.WriteAttributeString("fontId", i.ToString()); w.WriteAttributeString("fillId", "0"); w.WriteAttributeString("borderId", "0"); w.WriteAttributeString("xfId", "0"); w.WriteEndElement(); }
                    w.WriteEndElement(); w.WriteEndElement();
                });
                for (var i = 0; i < sheets.Count; i++)
                {
                    var sheet = sheets[i];
                    Write(zip, $"xl/worksheets/sheet{i + 1}.xml", w =>
                    {
                        w.WriteStartElement("worksheet", Ns);
                        w.WriteStartElement("sheetViews", Ns); w.WriteStartElement("sheetView", Ns); w.WriteAttributeString("workbookViewId", "0"); w.WriteStartElement("pane", Ns); w.WriteAttributeString("ySplit", "1"); w.WriteAttributeString("topLeftCell", "A2"); w.WriteAttributeString("state", "frozen"); w.WriteEndElement(); w.WriteEndElement(); w.WriteEndElement();
                        w.WriteStartElement("sheetFormatPr", Ns); w.WriteAttributeString("defaultRowHeight", "16"); w.WriteEndElement();
                        w.WriteStartElement("cols", Ns);
                        for (int c = 0; c < sheet.Headers.Length; c++) { w.WriteStartElement("col", Ns); w.WriteAttributeString("min", (c + 1).ToString()); w.WriteAttributeString("max", (c + 1).ToString()); w.WriteAttributeString("width", "26"); w.WriteAttributeString("customWidth", "1"); w.WriteEndElement(); }
                        w.WriteEndElement();
                        w.WriteStartElement("sheetData", Ns);
                        Row(w, 1, sheet.Headers.Cast<object?>().ToArray(), true);
                        for (var r = 0; r < sheet.Rows.Count; r++) Row(w, r + 2, sheet.Rows[r], false);
                        w.WriteEndElement();
                        if (sheet.Headers.Length > 0) { w.WriteStartElement("autoFilter", Ns); w.WriteAttributeString("ref", $"A1:{Column(sheet.Headers.Length)}{sheet.Rows.Count + 1}"); w.WriteEndElement(); }
                        w.WriteEndElement();
                    });
                }
            }
            stream.Position = 0;
            return stream;
        }

        private static void Row(XmlWriter w, int rowNo, object?[] values, bool header)
        {
            w.WriteStartElement("row", Ns); w.WriteAttributeString("r", rowNo.ToString());
            for (var c = 0; c < values.Length; c++)
            {
                var value = values[c];
                if (value is null) continue;
                w.WriteStartElement("c", Ns);
                w.WriteAttributeString("r", $"{Column(c + 1)}{rowNo}");
                if (header) w.WriteAttributeString("s", "1");
                if (value is decimal or int or long or double or float)
                {
                    w.WriteStartElement("v", Ns); w.WriteString(Convert.ToString(value, System.Globalization.CultureInfo.InvariantCulture) ?? "0"); w.WriteEndElement();
                }
                else
                {
                    w.WriteAttributeString("t", "inlineStr");
                    w.WriteStartElement("is", Ns); w.WriteStartElement("t", Ns);
                    w.WriteString(Convert.ToString(value, System.Globalization.CultureInfo.InvariantCulture) ?? "");
                    w.WriteEndElement(); w.WriteEndElement();
                }
                w.WriteEndElement();
            }
            w.WriteEndElement();
        }
        private static string Column(int index)
        {
            var s = "";
            for (; index > 0; index = (index - 1) / 26) s = (char)('A' + (index - 1) % 26) + s;
            return s;
        }
        private static void Write(ZipArchive zip, string path, Action<XmlWriter> write)
        {
            var entry = zip.CreateEntry(path, CompressionLevel.Optimal);
            using var output = entry.Open();
            using var writer = XmlWriter.Create(output, Settings);
            writer.WriteStartDocument(); write(writer); writer.WriteEndDocument(); writer.Flush();
        }
        private static void Override(XmlWriter w, string part, string contentType)
        {
            w.WriteStartElement("Override", "http://schemas.openxmlformats.org/package/2006/content-types"); w.WriteAttributeString("PartName", part); w.WriteAttributeString("ContentType", contentType); w.WriteEndElement();
        }
        private static void Relationship(XmlWriter w, string id, string type, string target)
        {
            w.WriteStartElement("Relationship", "http://schemas.openxmlformats.org/package/2006/relationships"); w.WriteAttributeString("Id", id); w.WriteAttributeString("Type", type); w.WriteAttributeString("Target", target); w.WriteEndElement();
        }
    }

    private RenderFragment AchievementCell(decimal planned, decimal actual) => builder =>
    {
        if (!HasData)
        {
            builder.AddContent(0, "-");
            return;
        }
        var pct = Percent(actual, planned);
        builder.OpenElement(1, "div");
        builder.AddAttribute(2, "class", "trk-achievement");
        builder.OpenElement(3, "div");
        builder.AddAttribute(4, "class", "trk-progress-track");
        builder.OpenElement(5, "div");
        builder.AddAttribute(6, "class", "trk-progress-fill");
        builder.AddAttribute(7, "style", $"width: {F(Math.Min(100m, pct))}%;");
        builder.CloseElement(); builder.CloseElement();
        builder.OpenElement(8, "span");
        builder.AddContent(9, $"{Pct(pct)}%");
        builder.CloseElement(); builder.CloseElement();
    };

    private bool _chartsDrawn;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (HasKpiData && IsLoaded && !_chartsDrawn)
        {
            _chartsDrawn = true;
            try
            {
                // Only a single achievement aggregate exists; no monthly series is fabricated.
                await JS.InvokeVoidAsync("loadSalesTrackingCharts", new
                {
                    achievementPct = (double)AchievementPct,
                    labels = Array.Empty<string>(),
                    actual = Array.Empty<double>(),
                    required = Array.Empty<double>()
                });
            }
            catch (JSException) { }
        }
        else if ((!HasKpiData || !IsLoaded) && _chartsDrawn)
        {
            _chartsDrawn = false;
            await DestroyChartsAsync();
        }
    }
    public async ValueTask DisposeAsync()
    {
        await DestroyChartsAsync();
        if (_excelModule is not null)
        {
            try { await _excelModule.DisposeAsync(); }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
            _excelModule = null;
        }
    }
    private async Task DestroyChartsAsync()
    {
        try { await JS.InvokeVoidAsync("destroySalesTrackingCharts"); }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
    }
