@page "/SalesTracking"
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject HttpClient Http
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using System.Net.Http.Headers
@implements IAsyncDisposable

<PageTitle>Sales Tracking · SPIC ONE</PageTitle>

<div class="container-fluid py-4 px-0">
    <div class="trk-wrapper">

        <!-- Header -->
        <div class="trk-header">
            <div>
                <h1>Sales Tracking Dashboard</h1>
                <p>Track actual sales performance against the planned targets.</p>
            </div>
            <div class="trk-header-actions">
                <button type="button" class="trk-btn-outline-green" @onclick="@(() => Nav.NavigateTo($"/PlanReview?csr2Id={CSR2Id}"))">
                    <SalesAuditIcon Name="arrow-left" Size="15" />
                    Back to Plan Review
                </button>
                <button type="button" class="trk-btn-outline" disabled title="Tracking report export is not available until a report API is configured.">
                    <SalesAuditIcon Name="download" Size="15" />
                    Download Tracking Report
                </button>
                @if (HasData)
                {
                    <button type="button" class="trk-btn-solid" @onclick="GoToPeriodEndReview">
                        View Final Review
                        <SalesAuditIcon Name="arrow-right" Size="15" />
                    </button>
                }
            </div>
        </div>

        <SalesAuditStepper CurrentStep="4" TrackingPhase="true" CSR2Id="@CSR2Id" />

        <div class="trk-card" style="padding: 16px; margin: 12px 0;">
            <h3 class="trk-card-title">Import actual sales achievements (SAP invoice report)</h3>
            <p>Upload a full .xlsx/.xls invoice snapshot for this confirmed scheme. Only invoice items with valid billing dates and exact product-master names are accepted. Uploading again replaces the previous product achievement snapshot.</p>
            @if (IsPlanConfirmed && !IsFinalSubmitted)
            {
                <InputFile OnChange="UploadAchievementsAsync" accept=".xlsx,.xls"
                           disabled="@IsUploadingAchievements" />
            }
            else
            {
                <p>@(IsFinalSubmitted ? "Final-submitted Sales Audit is locked." : "Confirm the plan in Tab 4 before importing achievements.")</p>
            }
            @if (IsUploadingAchievements)
            {
                <p role="status">Validating and importing SAP invoice rows...</p>
            }
            @if (!string.IsNullOrWhiteSpace(ImportResult))
            {
                <div class="alert alert-success" role="status">@ImportResult</div>
            }
            @if (!string.IsNullOrWhiteSpace(ImportError))
            {
                <div class="alert alert-danger" role="alert">@ImportError</div>
            }
        </div>


        @if (IsLoading)
        {
            <div class="alert alert-info">Loading Sales Tracking...</div>
        }
        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <div class="alert alert-danger">@Error</div>
        }
        @if (!IsLoading && IsLoaded)
        {
            <!-- KPI tiles -->
            <div class="trk-kpi-grid">
                <div class="trk-kpi trk-kpi-purple">
                    <span class="trk-kpi-label">Required Turnover (TO)</span>
                    <span class="trk-kpi-value">₹ @SalesAuditFormat.Crore(RequiredTurnover) Cr</span>
                    <span class="trk-kpi-sub">Minimum target to achieve</span>
                </div>
                <div class="trk-kpi trk-kpi-blue">
                    <span class="trk-kpi-label">Actual Turnover</span>
                    <span class="trk-kpi-value">@(HasData ? $"₹ {SalesAuditFormat.Crore(ActualTurnover)} Cr" : "-")</span>
                    <span class="trk-kpi-sub">From saved product achievement records</span>
                </div>
                <div class="trk-kpi trk-kpi-peach">
                    <span class="trk-kpi-label">Achievement %</span>
                    <span class="trk-kpi-value trk-orange">@(HasData ? $"{Pct(AchievementPct)}%" : "-")</span>
                    <span class="trk-kpi-sub">Against required TO</span>
                </div>
                <div class="trk-kpi trk-kpi-peach">
                    <span class="trk-kpi-label">Remaining to Achieve</span>
                    <span class="trk-kpi-value trk-red">@(HasData ? $"₹ {SalesAuditFormat.Crore(Remaining)}" : "-")</span>
                    <span class="trk-kpi-sub">To reach required TO</span>
                </div>
                <div class="trk-kpi trk-kpi-peach">
                    <span class="trk-kpi-label">Tracking Status</span>
                    <span class="trk-kpi-value trk-red">@(HasData ? (IsFinalSubmitted ? "Submitted" : "In Progress") : "Awaiting Data")</span>
                    <span class="trk-kpi-sub">Loaded from the saved database records</span>
                </div>
            </div>

            <!-- Program summary strip -->
            <div class="trk-card trk-summary">
                <div class="trk-summary-item">
                    <div class="trk-summary-icon trk-tone-green"><SalesAuditIcon Name="users" Size="22" StrokeWidth="1.6" /></div>
                    <div class="trk-summary-text">
                        <span class="trk-label">Program Type</span>
                        <span class="trk-summary-value">@Display(Overview?.ProgramType)</span>
                    </div>
                </div>
                <div class="trk-summary-item">
                    <div class="trk-summary-icon trk-tone-purple"><SalesAuditIcon Name="clipboard" Size="22" StrokeWidth="1.6" /></div>
                    <div class="trk-summary-text">
                        <span class="trk-label">Program Name</span>
                        <span class="trk-summary-value">@Display(Overview?.ProgramName)</span>
                    </div>
                </div>
                <div class="trk-summary-item">
                    <div class="trk-summary-icon trk-tone-blue"><SalesAuditIcon Name="stamp" Size="22" StrokeWidth="1.6" /></div>
                    <div class="trk-summary-text">
                        <span class="trk-label">
                            Scheme Period
                            @if (IsExtended)
                            {
                                <span class="trk-extended-pill"><span class="trk-dot"></span>Extended</span>
                            }
                            else
                            {
                                @* The period is locked after confirmation; changing it goes through Request Extension. *@
                                <button type="button" class="trk-inline-edit" disabled title="Scheme extension API not configured" aria-label="Scheme extension unavailable">
                                    <SalesAuditIcon Name="pencil" Size="13" />
                                </button>
                            }
                        </span>
                        <span class="trk-summary-value">@DateText(SchemeFrom) - @DateText(SchemeTo)</span>
                    </div>
                </div>
                <div class="trk-summary-item">
                    <div class="trk-summary-icon trk-tone-green"><SalesAuditIcon Name="badge-check" Size="22" StrokeWidth="1.6" /></div>
                    <div class="trk-summary-text">
                        <span class="trk-label">Scheme Duration</span>
                        <span class="trk-summary-value trk-green">@DurationText</span>
                    </div>
                </div>
            </div>

            @if (!HasData)
            {
                <!-- Awaiting sales data -->
                <div class="trk-card trk-awaiting">
                    <svg class="trk-awaiting-art" width="110" height="90" viewBox="0 0 110 90" fill="none" aria-hidden="true">
                        <ellipse cx="55" cy="46" rx="52" ry="34" fill="#eef1f0" />
                        <path d="M26 30a4 4 0 0 1 4-4h16l6 6h24a4 4 0 0 1 4 4v30a4 4 0 0 1-4 4H30a4 4 0 0 1-4-4z" fill="#f8faf9" stroke="#166534" stroke-width="2" stroke-linejoin="round" />
                        <path d="M32 22h14l5 5h21a3 3 0 0 1 3 3" stroke="#166534" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M26 42h54" stroke="#166534" stroke-width="2" />
                        <circle cx="78" cy="64" r="13" fill="#ffffff" stroke="#166534" stroke-width="2" />
                        <path d="M78 57v8" stroke="#166534" stroke-width="2.4" stroke-linecap="round" />
                        <circle cx="78" cy="70" r="1.4" fill="#166534" />
                    </svg>
                    <h3 class="trk-awaiting-title">Awaiting Sales Data</h3>
                    <span class="trk-submitted-pill"><span class="trk-dot"></span>@(IsPlanConfirmed ? "Plan Confirmed" : "Awaiting Achievement Data")</span>
                    <p class="trk-awaiting-text">
                        Your sales plan is saved. No product-wise achievement records are available for this programme yet.
                        Tracking values will appear when verified sales are saved in SalesAuditAchievementLines.
                    </p>
                </div>
            }
            else
            {
                @if (DaysRemaining is >= 0 and <= 7)
                {
                    <div class="trk-warning">
                        <div class="trk-warning-top">
                            <div class="trk-warning-title">
                                <SalesAuditIcon Name="alert-triangle" Size="20" CssClass="trk-warning-icon" />
                                <div>
                                    <strong>Scheme Period ends in @DaysRemaining @(DaysRemaining == 1 ? "day" : "days")</strong>
                                    <span>Dates are calculated from the saved scheme period and today's date.</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- Charts -->
                <div class="trk-chart-grid">
                    <div class="trk-card">
                        <h3 class="trk-card-title">Turnover Achievement Overview</h3>
                        <div class="trk-gauge-layout">
                            <figure class="trk-gauge">
                                <div class="trk-gauge-canvas">
                                    <canvas id="trkGaugeChart" role="img" aria-label="@($"{Pct(AchievementPct)}% of the required turnover achieved")"></canvas>
                                    <div class="trk-gauge-center">
                                        <span class="trk-gauge-value">@Pct(AchievementPct)%</span>
                                        <span class="trk-gauge-caption">Achieved</span>
                                    </div>
                                </div>
                                <div class="trk-gauge-ends"><span>0%</span><span>100%</span></div>
                            </figure>

                            <ul class="trk-gauge-legend">
                                <li>
                                    <span class="trk-legend-dot trk-bg-green"></span>
                                    <div><span>Actual Turnover</span><strong class="trk-green">₹ @SalesAuditFormat.Crore(ActualTurnover) Cr</strong></div>
                                </li>
                                <li>
                                    <span class="trk-legend-dot trk-bg-blue"></span>
                                    <div><span>Required Turnover</span><strong class="trk-green">₹ @SalesAuditFormat.Crore(RequiredTurnover) Cr</strong></div>
                                </li>
                                <li>
                                    <span class="trk-legend-dot trk-bg-grey"></span>
                                    <div><span>Remaining</span><strong>₹ @SalesAuditFormat.Crore(Remaining) Cr</strong></div>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <div class="trk-card">
                        <div class="trk-card-top">
                            <h3 class="trk-card-title">Monthly Progress Trend</h3>
                            <div class="trk-trend-legend">
                                <span><i class="trk-key trk-key-actual"></i>Actual Turnover</span>
                                <span><i class="trk-key trk-key-required"></i>Required Turnover</span>
                            </div>
                        </div>

                        <div class="trk-trend" role="status">
                            Monthly invoice-date data is not exposed by the current Sales Audit API.
                            A trend cannot be calculated accurately from product-level totals alone.
                        </div>
                    </div>
                </div>
            }

            <!-- Product-wise Actual Sales -->
            <div class="trk-card">
                <div class="trk-card-top">
                    <h3 class="trk-card-title">Product - wise Actual Sales (Saved Achievements)</h3>
                    <button type="button" class="trk-btn-outline" disabled title="Details API not yet configured"><SalesAuditIcon Name="pencil" Size="15" /> View Details</button>
                </div>
                <div class="trk-table-wrapper">
                    <table class="trk-table">
                        <thead>
                            <tr>
                                <th class="trk-col-no">S:NO</th>
                                <th>Product</th>
                                <th>Unit</th>
                                <th>Planned Value (₹)</th>
                                <th>Actual Value (₹)</th>
                                <th>Achievement (%)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var (row, index) in ProductSales.Select((r, i) => (r, i)))
                            {
                                <tr>
                                    <td class="trk-col-no">@(index + 1)</td>
                                    <td>@row.Name</td>
                                    <td>@row.Detail</td>
                                    <td>@SalesAuditFormat.Rupees(row.Planned)</td>
                                    <td>@(HasData ? SalesAuditFormat.Rupees(row.Actual) : "-")</td>
                                    <td>@AchievementCell(row.Planned, row.Actual)</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3" class="trk-total-label">Total</td>
                                <td class="trk-total-value">@SalesAuditFormat.Rupees(ProductSales.Sum(r => r.Planned))</td>
                                <td class="trk-total-value">@(HasData ? SalesAuditFormat.Rupees(ProductSales.Sum(r => r.Actual)) : "-")</td>
                                <td class="trk-total-value">@(HasData ? $"{Pct(Percent(ProductSales.Sum(r => r.Actual), ProductSales.Sum(r => r.Planned)))}%" : "-")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <!-- Dealer-wise Actual Sales (Top 5) -->
            <div class="trk-card">
                <div class="trk-card-top">
                    <h3 class="trk-card-title">Dealer - wise Uploaded Sales (Top 5, unverified)</h3>
                    <button type="button" class="trk-btn-outline" disabled title="Details API not yet configured"><SalesAuditIcon Name="pencil" Size="15" /> View Details</button>
                </div>
                <div class="trk-table-wrapper">
                    <table class="trk-table">
                        <thead>
                            <tr>
                                <th class="trk-col-no">S:NO</th>
                                <th>Dealer Name</th>
                                <th>Location</th>
                                <th>Planned Value (₹)</th>
                                <th>Actual Value (₹)</th>
                                <th>Achievement (%)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var (row, index) in TopDealers.Select((r, i) => (r, i)))
                            {
                                <tr>
                                    <td class="trk-col-no">@(index + 1)</td>
                                    <td>@row.Name</td>
                                    <td>@row.Detail</td>
                                    <td>@SalesAuditFormat.Rupees(row.Planned)</td>
                                    <td>@SalesAuditFormat.Rupees(row.Actual)</td>
                                    <td>@DealerAchievementCell(row.Planned, row.Actual)</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3" class="trk-total-label">Total (Top 5)</td>
                                <td class="trk-total-value">@SalesAuditFormat.Rupees(TopDealers.Sum(r => r.Planned))</td>
                                <td class="trk-total-value">@SalesAuditFormat.Rupees(TopDealers.Sum(r => r.Actual))</td>
                                <td class="trk-total-value">@($"{Pct(Percent(TopDealers.Sum(r => r.Actual), TopDealers.Sum(r => r.Planned)))}%")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <!-- Footer actions -->
            <div class="trk-footer">
                <button type="button" class="trk-btn trk-btn-back" @onclick="BackToList">
                    <SalesAuditIcon Name="chevrons-left" Size="16" />
                    Back to List
                </button>

                <div class="trk-footer-right">
                    @if (HasData)
                    {
                        <button type="button" class="trk-btn trk-btn-back" @onclick="BackToList">Close</button>
                    }
                    else
                    {
                        <span class="trk-footer-note"><SalesAuditIcon Name="info" Size="16" /> Sales data is required to review performance.</span>
                    }
                    <button type="button" class="trk-btn trk-btn-primary" disabled="@(!HasData)" @onclick="GoToPeriodEndReview">
                        Go To Final Review
                        <SalesAuditIcon Name="chevrons-right" Size="16" />
                    </button>
                </div>
            </div>
        }

    </div>
</div>



@code {
    [SupplyParameterFromQuery(Name = "csr2Id")]
    public int? CSR2Id { get; set; }

    // Retained for old URLs; this query parameter no longer fabricates achievement data.
    [SupplyParameterFromQuery(Name = "state")]
    public string? State { get; set; }

    private sealed class OverviewDto
    {
        public string? ProgramName { get; set; }
        public string? ProgramType { get; set; }
        public bool IsPlanConfirmed { get; set; }
        public bool IsFinalSubmitted { get; set; }
    }
    private sealed class ProductDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
    }
    private sealed class AuditLineDto
    {
        public int ProductId { get; set; }
        public decimal QuantityMT { get; set; }
        public decimal ValueRs { get; set; }
    }
    private sealed class DetailsDto
    {
        public DateTime? SchemeFrom { get; set; }
        public DateTime? SchemeTo { get; set; }
        public decimal RequiredTurnoverRs { get; set; }
        public bool IsFinalSubmitted { get; set; }
        public bool IsPlanConfirmed { get; set; }
        public List<ProductDto> Products { get; set; } = new();
        public List<AuditLineDto> Plan { get; set; } = new();
        public List<AuditLineDto> Achievement { get; set; } = new();
    }
    private sealed class DealerMappingDto
    {
        public List<DealerDto> Rows { get; set; } = new();
    }
    private sealed class DealerDto
    {
        public string CustomerNumber { get; set; } = "";
        public string CustomerName { get; set; } = "";
        public string CustomerDistrict { get; set; } = "";
        public decimal PlannedCommitmentRs { get; set; }
        public decimal ActualSalesRs { get; set; }
    }

    private OverviewDto? Overview;
    private bool IsLoading, IsLoaded, IsPlanConfirmed, IsFinalSubmitted;
    private bool IsUploadingAchievements;
    private string ImportError = "", ImportResult = "";
    private const long TrackingMaxFileBytes = 5 * 1024 * 1024;

    private async Task UploadAchievementsAsync(InputFileChangeEventArgs e)
    {
        if (CSR2Id is null or <= 0 || !IsPlanConfirmed || IsFinalSubmitted || IsUploadingAchievements)
            return;
        var file = e.File;
        ImportError = ImportResult = "";
        if (file.Size <= 0 || file.Size > TrackingMaxFileBytes ||
            Path.GetExtension(file.Name).ToLowerInvariant() is not (".xlsx" or ".xls"))
        {
            ImportError = "Upload an XLSX or XLS file up to 5 MB.";
            return;
        }
        IsUploadingAchievements = true;
        try
        {
            using var form = new MultipartFormDataContent();
            using var stream = file.OpenReadStream(TrackingMaxFileBytes);
            using var content = new StreamContent(stream);
            content.Headers.ContentType = new MediaTypeHeaderValue("application/octet-stream");
            form.Add(content, "file", file.Name);
            using var response = await Http.PostAsync(
                $"api/SalesAudit/tracking/import-achievements?csr2Id={CSR2Id.Value}", form);
            if (!response.IsSuccessStatusCode)
            {
                ImportError = $"Import failed (HTTP {(int)response.StatusCode}): " +
                              await response.Content.ReadAsStringAsync();
                return;
            }
            var saved = await response.Content.ReadFromJsonAsync<TrackingImportResult>();
            await OnParametersSetAsync();
            ImportResult = $"Saved {saved?.ProductAchievementLines ?? 0} product achievement lines " +
                           $"from {saved?.ImportedInvoiceLines ?? 0} invoice rows. " +
                           "These amounts are based on the uploaded SAP report, not an independently verified SAP connection.";
        }
        catch (Exception ex) { ImportError = $"Unable to import achievements: {ex.Message}"; }
        finally { IsUploadingAchievements = false; }
    }

    private sealed class TrackingImportResult
    {
        public int ImportedInvoiceLines { get; set; }
        public int ProductAchievementLines { get; set; }
    }

    private string Error = "";
    private DateTime? SchemeFrom, SchemeTo;
    private decimal RequiredTurnover, ActualTurnover;
    private record SalesRow(string Name, string Detail, decimal Planned, decimal Actual);
    private List<SalesRow> ProductSales = new();
    private List<SalesRow> TopDealers = new();

    // HasData only indicates actual, persisted product achievement records.
    // A query string or SAP dealer commitment must not fabricate achievements.
    private bool HasData { get; set; }
    private bool IsExtended => false; // No extension backend is connected.
    private decimal Remaining => Math.Max(0m, RequiredTurnover - ActualTurnover);
    private decimal AchievementPct => Percent(ActualTurnover, RequiredTurnover);
    private int? DaysRemaining => SchemeTo.HasValue
        ? (SchemeTo.Value.Date - DateTime.Today).Days : null;

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "--" : value;
    private static string DateText(DateTime? date) => date?.ToString("dd MMM yyyy") ?? "--";
    private static decimal Percent(decimal part, decimal whole) => whole == 0 ? 0 : part / whole * 100;
    private static string Pct(decimal value) => value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    private static string F(decimal value) => value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private string DurationText
    {
        get
        {
            if (!SchemeFrom.HasValue || !SchemeTo.HasValue) return "--";
            if (SchemeTo.Value.Date < SchemeFrom.Value.Date) return "Invalid period";
            var days = (SchemeTo.Value.Date - SchemeFrom.Value.Date).Days + 1;
            var months = (SchemeTo.Value.Year - SchemeFrom.Value.Year) * 12
                         + SchemeTo.Value.Month - SchemeFrom.Value.Month + 1;
            return $"{months} {(months == 1 ? "Month" : "Months")} ({days} Days)";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        IsLoaded = false;
        IsLoading = true;
        Error = "";
        HasData = false;
        ProductSales = new();
        TopDealers = new();
        if (CSR2Id is null or <= 0)
        {
            Error = "Missing csr2Id. Open Sales Tracking from Plan Review.";
            IsLoading = false;
            return;
        }

        try
        {
            var id = CSR2Id.Value;
            using var overviewResponse = await Http.GetAsync($"api/SalesAudit/overview?csr2Id={id}");
            if (!overviewResponse.IsSuccessStatusCode)
            {
                Error = $"Unable to load programme (HTTP {(int)overviewResponse.StatusCode}).";
                return;
            }
            using var detailsResponse = await Http.GetAsync($"api/SalesAudit/details?csr2Id={id}");
            if (!detailsResponse.IsSuccessStatusCode)
            {
                Error = $"Unable to load sales plan / achievement (HTTP {(int)detailsResponse.StatusCode}).";
                return;
            }
            using var dealersResponse = await Http.GetAsync($"api/SalesAudit/dealer-mapping?csr2Id={id}");
            if (!dealersResponse.IsSuccessStatusCode)
            {
                Error = $"Unable to load dealer allocation (HTTP {(int)dealersResponse.StatusCode}).";
                return;
            }

            var overview = await overviewResponse.Content.ReadFromJsonAsync<OverviewDto>();
            var details = await detailsResponse.Content.ReadFromJsonAsync<DetailsDto>();
            var dealers = await dealersResponse.Content.ReadFromJsonAsync<DealerMappingDto>();
            if (overview is null || details is null || dealers is null)
            {
                Error = "One or more Sales Audit API responses were empty.";
                return;
            }

            Overview = overview;
            SchemeFrom = details.SchemeFrom;
            SchemeTo = details.SchemeTo;
            RequiredTurnover = details.RequiredTurnoverRs;
            IsPlanConfirmed = details.IsPlanConfirmed || overview.IsPlanConfirmed;
            IsFinalSubmitted = details.IsFinalSubmitted || overview.IsFinalSubmitted;
            var plans = details.Plan ?? new();
            var achievements = details.Achievement ?? new();
            HasData = achievements.Count > 0;
            ActualTurnover = achievements.Sum(x => x.ValueRs);
            var names = (details.Products ?? new())
                .GroupBy(x => x.Id).ToDictionary(g => g.Key, g => g.First().Name);
            var achievementsByProduct = achievements
                .GroupBy(x => x.ProductId).ToDictionary(g => g.Key, g => g.Sum(x => x.ValueRs));
            ProductSales = plans.Select(p => new SalesRow(
                names.TryGetValue(p.ProductId, out var name) ? name : $"Product #{p.ProductId}",
                "MT", p.ValueRs,
                achievementsByProduct.TryGetValue(p.ProductId, out var achieved) ? achieved : 0m)).ToList();
            // Include achieved products not in the original plan instead of hiding sales.
            foreach (var item in achievementsByProduct.Where(x => plans.All(p => p.ProductId != x.Key)))
                ProductSales.Add(new SalesRow(
                    names.TryGetValue(item.Key, out var extra) ? extra : $"Product #{item.Key}",
                    "MT", 0m, item.Value));

            // Dealer actual amounts are imported SAP invoice totals and are not treated
            // as verified SalesAuditAchievementLines / the overall Achievement KPI.
            TopDealers = (dealers.Rows ?? new())
                .GroupBy(x => x.CustomerNumber, StringComparer.OrdinalIgnoreCase)
                .Select(g => new SalesRow(
                    g.Select(x => x.CustomerName).FirstOrDefault(n => !string.IsNullOrWhiteSpace(n)) ?? g.Key,
                    g.Select(x => x.CustomerDistrict).FirstOrDefault(n => !string.IsNullOrWhiteSpace(n)) ?? "--",
                    g.Sum(x => x.PlannedCommitmentRs),
                    g.Sum(x => x.ActualSalesRs)))
                .OrderByDescending(x => x.Actual)
                .Take(5)
                .ToList();
            IsLoaded = true;
        }
        catch (Exception ex)
        {
            Error = $"Unable to load Sales Tracking: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private RenderFragment AchievementCell(decimal planned, decimal actual) => builder =>
    {
        if (!HasData)
        {
            builder.AddContent(0, "-");
            return;
        }
        var pct = Percent(actual, planned);
        builder.OpenElement(1, "div");
        builder.AddAttribute(2, "class", "trk-achievement");
        builder.OpenElement(3, "div");
        builder.AddAttribute(4, "class", "trk-progress-track");
        builder.OpenElement(5, "div");
        builder.AddAttribute(6, "class", "trk-progress-fill");
        builder.AddAttribute(7, "style", $"width: {F(Math.Min(100m, pct))}%;");
        builder.CloseElement(); builder.CloseElement();
        builder.OpenElement(8, "span");
        builder.AddContent(9, $"{Pct(pct)}%");
        builder.CloseElement(); builder.CloseElement();
    };
    private RenderFragment DealerAchievementCell(decimal planned, decimal actual) => builder =>
    {
        var pct = Percent(actual, planned);
        builder.OpenElement(0, "span");
        builder.AddContent(1, planned > 0 ? $"{Pct(pct)}%" : "--");
        builder.CloseElement();
    };

    private bool _chartsDrawn;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (HasData && IsLoaded && !_chartsDrawn)
        {
            _chartsDrawn = true;
            try
            {
                // Only a single achievement aggregate exists; no monthly series is fabricated.
                await JS.InvokeVoidAsync("loadSalesTrackingCharts", new
                {
                    achievementPct = (double)AchievementPct,
                    labels = Array.Empty<string>(),
                    actual = Array.Empty<double>(),
                    required = Array.Empty<double>()
                });
            }
            catch (JSException) { }
        }
        else if ((!HasData || !IsLoaded) && _chartsDrawn)
        {
            _chartsDrawn = false;
            await DestroyChartsAsync();
        }
    }
    public async ValueTask DisposeAsync() => await DestroyChartsAsync();
    private async Task DestroyChartsAsync()
    {
        try { await JS.InvokeVoidAsync("destroySalesTrackingCharts"); }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
    }
    private void BackToList() => Nav.NavigateTo("/SalesAudit");
    private void RequestExtension() { /* No extension API is present; do not fake requests. */ }
    private void GoToPeriodEndReview()
    {
        if (HasData && CSR2Id is > 0)
            Nav.NavigateTo($"/PeriodEndReview?csr2Id={CSR2Id.Value}");
    }
}
