<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
    $(document).ready(function() {
        // Visual toggle logic for ALL selectable cards (special and standard)
        $('.selectable-card').on('click', function() {
            $(this).toggleClass('selected');
        });
    });
</script>
@code{
    	private bool isSpic = true;        // ✅ default checked
	private bool isGreenStar = true;   // ✅ default checked
    void ToggleSpic()
	{
		isSpic = !isSpic;
	}

	void ToggleGreenStar()
	{
		isGreenStar = !isGreenStar;
	}
}