@page "/Companies"

<div class="companies-operating-wrapper">
    <div class="container-fluid">

        <FormLoader />

        <div class="company-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <h3 class="fw-bold m-0 company-title">
                Companies Operating In Your Place <span>(Please Mark)</span>
            </h3>
        </div>

        <div class="companies-operating-grid mb-5">

            @foreach (var company in Companies)
            {
                <div class="@(company.IsLarge ? "span-2-rows" : "")">
                    <div class="@GetCardClass(company)"
                         @onclick="() => ToggleCompany(company)">

                        <div class="card-checkbox">
                            <i class="bi bi-check-lg"></i>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(company.Image))
                        {
                            <img src="@company.Image" />
                        }

                        <span>@company.Name</span>
                    </div>
                </div>
            }

        </div>

        <CommanFooter />
    </div>
</div>

