@page "/Companies"
<div class="companies-operating-wrapper">
    <div class="container-fluid">
        
        <FormLoader />
        <div class="company-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <h3 class="fw-bold m-0 company-title">Companies Operating In Your Place <span>(Please Mark)</span></h3>
        </div>
        <div class="companies-operating-grid mb-5">
            
            <div class="span-2-rows">
               <div class="logo-card spic @(isSpic ? "active" : "")"
									 @onclick="ToggleSpic">
									<div class="card-checkbox">
										<i class="bi bi-check-lg"></i>
									</div>
									<img src="_content/SPIC.MauiBlazorApp.Shared/images/loginimages/logo.png" />
									<span>SPIC</span>
								</div>
            </div>

            <div class="span-2-rows">
               <div class="logo-card green-star @(isGreenStar ? "active" : "")"
									 @onclick="ToggleGreenStar">
									<div class="card-checkbox">
										<i class="bi bi-check-lg"></i>
									</div>
									<img src="_content/SPIC.MauiBlazorApp.Shared/images/loginimages/greensraticon.svg" />
									<span>GREEN STAR</span>
								</div>
            </div>
