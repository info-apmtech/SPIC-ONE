@code {
    private bool isSpic = true;
    private bool isGreenStar = true;

    private HashSet<string> selectedCompanies = new();
    // {
    //     "FACT",
    //     "MFL"
    // };

    void ToggleSpic()
    {
        isSpic = !isSpic;
    }

    void ToggleGreenStar()
    {
        isGreenStar = !isGreenStar;
    }

    void ToggleCompany(string companyName)
    {
        if (selectedCompanies.Contains(companyName))
            selectedCompanies.Remove(companyName);
        else
            selectedCompanies.Add(companyName);
    }
}