    private void ToggleCompany(CompanyItem company)
    {
        company.IsSelected = !company.IsSelected;
    }

    private string GetCardClass(CompanyItem company)
    {
        var baseClass = company.IsLarge ? "logo-card" : "companies-operating-card selectable-card";
        var selectedClass = company.IsSelected ? "active selected" : "";
        var extraClass = company.ExtraClass ?? "";

        return $"{baseClass} {extraClass} {selectedClass}".Trim();
    }

    public class CompanyItem
    {
        public string Name { get; set; } = "";
        public bool IsSelected { get; set; }
        public bool IsLarge { get; set; }
        public string? ExtraClass { get; set; }
        public string? Image { get; set; }
    }
}