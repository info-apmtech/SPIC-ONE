        </div>

        <div class="companies-operating-grid mb-5">

            <div class="span-2-rows">
                <div class="logo-card spic @(isSpic ? "active" : "")"
                     @onclick="ToggleSpic">
                    <div class="card-checkbox">
                        <i class="bi bi-check-lg"></i>
                    </div>
                    <img src="_content/SPIC.MauiBlazorApp.Shared/images/loginimages/logo.png" />
                    <span>SPIC</span>
                </div>
            </div>

            <div class="span-2-rows">
                <div class="logo-card green-star @(isGreenStar ? "active" : "")"
                     @onclick="ToggleGreenStar">
                    <div class="card-checkbox">
                        <i class="bi bi-check-lg"></i>
                    </div>
                    <img src="_content/SPIC.MauiBlazorApp.Shared/images/loginimages/greensraticon.svg" />
                    <span>GREEN STAR</span>
                </div>
            </div>

            <div>
                <div class="companies-operating-card selectable-card @(selectedCompanies.Contains("FACT") ? "selected" : "")"
                     @onclick='() => ToggleCompany("FACT")'>
                    <div class="companies-operating-name">FACT</div>
                    <div class="check-box"><i class="bi bi-check-lg"></i></div>
