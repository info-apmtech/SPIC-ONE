@page "/FarmDashboard"
@page "/FarmOperations"
@inject SPIC.MauiBlazorApp.Shared.Services.ToastService Toast
@inject NavigationManager Nav

<PageTitle>Farm Operations & Financial Dashboard · SPIC ONE</PageTitle>

<div class="container-fluid py-4 px-0 fd-page">
    <div class="fd-wrapper">

        <!-- Top Header -->
        <div class="fd-header">
            <div class="fd-header-text">
                <h1>Good Morning, Rajesh Kumar</h1>
                <p>Here's an overview of your farm operation and financial performance</p>
            </div>
            <div class="fd-header-action">
                <div class="fd-fy-picker">
                    <span class="fd-fy-label">Financial Year:</span>
                    <select class="fd-fy-select" @bind="SelectedFinancialYear">
                        <option value="2026">2026</option>
                        <option value="2025">2025</option>
                        <option value="2024">2024</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Metric KPI Cards (Reference: ExtensionRequestList.razor erl-stat-card pattern) -->
        <div class="fd-stats-grid">
            <!-- 1. Total Budget -->
            <div class="fd-stat-card">
                <div class="fd-stat-text">
                    <p class="fd-stat-title">Total Budget</p>
                    <h2>₹6,82,450</h2>
                    <span class="fd-stat-desc">From 01 Jan 2026 - 15 Sep 2026</span>
                </div>
                <div class="fd-stat-icon fd-tone-green" title="Total Budget">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect width="16" height="20" x="4" y="2" rx="2"></rect>
                        <line x1="8" x2="16" y1="6" y2="6"></line>
                        <line x1="8" x2="16" y1="10" y2="10"></line>
                        <path d="M9 14h6"></path>
                    </svg>
                </div>
            </div>

            <!-- 2. Total Income Till Date -->
            <div class="fd-stat-card">
                <div class="fd-stat-text">
                    <p class="fd-stat-title">Total Income Till Date</p>
                    <h2>₹6,82,450</h2>
                    <span class="fd-stat-desc">From 01 Jan 2026 - 15 Sep 2026</span>
                </div>
                <div class="fd-stat-icon fd-tone-lightgreen" title="Total Income Till Date">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect width="16" height="20" x="4" y="2" rx="2"></rect>
                        <path d="m9 14 3-3 3 3"></path>
                        <path d="M12 11v6"></path>
                    </svg>
                </div>
            </div>

            <!-- 3. Total Expense Till Date -->
            <div class="fd-stat-card">
                <div class="fd-stat-text">
                    <p class="fd-stat-title">Total Expense Till Date</p>
                    <h2>₹ 4,29,212</h2>
                    <span class="fd-stat-desc">From 01 Jan 2026 - 15 Sep 2026</span>
                </div>
                <div class="fd-stat-icon fd-tone-red" title="Total Expense Till Date">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                </div>
            </div>

            <!-- 4. Net Profit Till Date -->
            <div class="fd-stat-card">
                <div class="fd-stat-text">
                    <p class="fd-stat-title">Net Profit Till Date</p>
                    <h2>₹ 2,53,238</h2>
                    <span class="fd-stat-desc">From 01 Jan 2026 - 15 Sep 2026</span>
                </div>
                <div class="fd-stat-icon fd-tone-blue" title="Net Profit Till Date">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="16" y1="13" x2="8" y2="13"></line>
                        <line x1="16" y1="17" x2="8" y2="17"></line>
                        <polyline points="10 9 9 9 8 9"></polyline>
                    </svg>
                </div>
            </div>

            <!-- 5. ROI Till Date -->
            <div class="fd-stat-card">
                <div class="fd-stat-text">
                    <p class="fd-stat-title">ROI Till Date</p>
                    <h2>59.6%</h2>
                    <span class="fd-stat-desc">From 01 Jan 2026 - 15 Sep 2026</span>
                </div>
                <div class="fd-stat-icon fd-tone-orange" title="ROI Till Date">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 14 10"></polyline>
                    </svg>
                </div>
            </div>
        </div>

        <!-- Middle Row: Quick Action & Next 15-day Period -->
        <div class="fd-mid-grid">
            <!-- Quick Action Card -->
            <div class="fd-card fd-quickaction-card">
                <div class="fd-card-header">
                    <div class="fd-card-header-left">
                        <h3>Quick Action</h3>
                        <p class="fd-card-subtitle">View summaries or manage products.</p>
                    </div>
                    <button type="button" class="fd-btn-outline-green" @onclick="ViewAllReport">
                        View All Report
                    </button>
                </div>

                <div class="fd-quickactions-grid">
                    <!-- Top Row -->
                    <div class="fd-action-tile" @onclick='() => HandleAction("Product Management")'>
                        <div class="fd-action-info">
                            <span class="fd-action-title">Product Management</span>
                            <span class="fd-action-desc">Request New product &amp; Rate change</span>
                        </div>
                        <div class="fd-action-icon-circle fd-tone-circle-blue">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <polyline points="12 6 12 12 16 14"></polyline>
                            </svg>
                        </div>
                    </div>

                    <div class="fd-action-tile" @onclick='() => HandleAction("Inventory Summary")'>
                        <div class="fd-action-info">
                            <span class="fd-action-title">Inventory Summary</span>
                            <span class="fd-action-desc">View Reports Inventory</span>
                        </div>
                        <div class="fd-action-icon-circle fd-tone-circle-green">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <polyline points="12 6 12 12 16 14"></polyline>
                            </svg>
                        </div>
                    </div>

                    <!-- Bottom Row: 3 items -->
                    <div class="fd-action-tile" @onclick='() => HandleAction("Income Summary")'>
                        <div class="fd-action-info">
                            <span class="fd-action-title">Income Summary</span>
                            <span class="fd-action-desc">View Reports Income</span>
                        </div>
                        <div class="fd-action-icon-circle fd-tone-circle-blue">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <polyline points="12 6 12 12 16 14"></polyline>
                            </svg>
                        </div>
                    </div>

                    <div class="fd-action-tile" @onclick='() => HandleAction("Inventory Summary")'>
                        <div class="fd-action-info">
                            <span class="fd-action-title">Inventory Summary</span>
                            <span class="fd-action-desc">View Reports Inventory</span>
                        </div>
                        <div class="fd-action-icon-circle fd-tone-circle-green">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <polyline points="12 6 12 12 16 14"></polyline>
                            </svg>
                        </div>
                    </div>

                    <div class="fd-action-tile" @onclick='() => HandleAction("Finance Summary")'>
                        <div class="fd-action-info">
                            <span class="fd-action-title">Finance Summary</span>
                            <span class="fd-action-desc">View Reports Expense</span>
                        </div>
                        <div class="fd-action-icon-circle fd-tone-circle-red">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <polyline points="12 6 12 12 16 14"></polyline>
                            </svg>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Next 15-day Period Card -->
            <div class="fd-card fd-period-card">
                <div class="fd-card-header">
                    <div class="fd-card-header-left">
                        <h3>Next 15-day Period</h3>
                        <p class="fd-card-subtitle">16-30 Sep 2026</p>
                    </div>
                    <div class="fd-period-icon fd-tone-orange">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 14 10"></polyline>
                        </svg>
                    </div>
                </div>

                <div class="fd-period-body">
                    <div class="fd-period-box">
                        <div class="fd-period-cal-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                <line x1="16" y1="2" x2="16" y2="6"></line>
                                <line x1="8" y1="2" x2="8" y2="6"></line>
                                <line x1="3" y1="10" x2="21" y2="10"></line>
                            </svg>
                        </div>
                        <span class="fd-period-notice">Entry will be Available from</span>
                        <strong class="fd-period-date">16 Sep 2026 Onward</strong>
                        <div class="fd-period-countdown">Starts in 4 days</div>

                        <button type="button" class="fd-period-btn" @onclick="Start15DaysEntry">
                            Start 15 Days Enrty
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Income, Expense & Profit Trends Section -->
        <div class="fd-card fd-chart-card">
            <div class="fd-card-header fd-chart-header">
                <h3>Income, Expense &amp; Profit Trens</h3>

                <div class="fd-chart-controls">
                    <!-- Legend -->
                    <div class="fd-chart-legend">
                        <span class="fd-legend-item">
                            <span class="fd-legend-dot fd-dot-income"></span>
                            Income
                        </span>
                        <span class="fd-legend-item">
                            <span class="fd-legend-dot fd-dot-expense"></span>
                            Expense
                        </span>
                        <span class="fd-legend-item">
                            <span class="fd-legend-dot fd-dot-profit"></span>
                            Net Profit
                        </span>
                    </div>

                    <!-- Period Filter -->
                    <select class="fd-chart-select" @bind="SelectedChartRange">
                        <option value="6m">Last 6 Months</option>
                        <option value="3m">Last 3 Months</option>
                        <option value="1y">Last 1 Year</option>
                    </select>
                </div>
            </div>

            <div class="fd-chart-container">
                <!-- SVG Chart matching the visual layout in screenshot -->
                <svg viewBox="0 0 1000 320" class="fd-svg-chart" preserveAspectRatio="none">
                    <!-- Y Axis Grid Lines -->
                    @for (int i = 0; i < YGridLevels.Length; i++)
                    {
                        var y = 20 + i * 36;
                        <line x1="50" y1="@y" x2="980" y2="@y" stroke="#f1f5f9" stroke-width="1" stroke-dasharray="3,3" />
                        @((MarkupString)$"<text x=\"40\" y=\"{y + 4}\" text-anchor=\"end\" class=\"fd-axis-label\">{YGridLevels[i]}</text>")
                    }

                    <!-- Y-Axis Title -->
                    <text x="12" y="160" transform="rotate(-90 12 160)" text-anchor="middle" class="fd-axis-title">Amount (₹)</text>

                    <!-- Bottom Axis Line -->
                    <line x1="50" y1="272" x2="980" y2="272" stroke="#e2e8f0" stroke-width="1.2" />

                    <!-- Clustered Bars for 11 Periods -->
                    @for (int p = 0; p < PeriodData.Count; p++)
                    {
                        var item = PeriodData[p];
                        var groupX = 75 + p * 81;
                        var incomeBarH = (item.Income / 350000.0) * 252;
                        var expenseBarH = (item.Expense / 350000.0) * 252;
                        var incomeY = 272 - incomeBarH;
                        var expenseY = 272 - expenseBarH;
                        var isHighlighted = (p == ActiveTooltipIndex);

                        <!-- Income Bar (Green) -->
                        <rect x="@(groupX - 10)" y="@incomeY" width="16" height="@incomeBarH"
                              rx="3" ry="3" class="fd-bar-income @(isHighlighted ? "fd-bar-active" : "")"
                              @onclick="() => SetActivePeriod(p)" />

                        <!-- Expense Bar (Pink/Coral) -->
                        <rect x="@(groupX + 8)" y="@expenseY" width="16" height="@expenseBarH"
                              rx="3" ry="3" class="fd-bar-expense @(isHighlighted ? "fd-bar-active" : "")"
                              @onclick="() => SetActivePeriod(p)" />

                        <!-- X-Axis Label -->
                        @((MarkupString)$"<text x=\"{groupX + 7}\" y=\"292\" text-anchor=\"middle\" class=\"fd-x-label\">{item.Period}</text>")
                    }

                    <!-- Net Profit Line -->
                    <path d="@NetProfitSvgPath" fill="none" stroke="#3b82f6" stroke-width="2.5" class="fd-line-profit" />

                    <!-- Profit Data Points -->
                    @for (int p = 0; p < PeriodData.Count; p++)
                    {
                        var item = PeriodData[p];
                        var groupX = 75 + p * 81 + 7;
                        var profitY = 272 - (item.NetProfit / 350000.0) * 252;
                        <circle cx="@groupX" cy="@profitY" r="4" fill="#3b82f6" stroke="#ffffff" stroke-width="2"
                                class="fd-profit-point" @onclick="() => SetActivePeriod(p)" />
                    }

                    <!-- Active Tooltip Callout (Period index 2 = "01-15 Sep" as in the reference image) -->
                    @if (ActiveTooltipIndex >= 0 && ActiveTooltipIndex < PeriodData.Count)
                    {
                        var activeItem = PeriodData[ActiveTooltipIndex];
                        var tX = 75 + ActiveTooltipIndex * 81 + 7;
                        var tY = 90;

                        <g class="fd-chart-tooltip-group" transform="translate(@(tX - 52), @tY)">
                            <!-- Tooltip Box -->
                            <rect width="105" height="92" rx="6" ry="6" fill="#ffffff" stroke="#e2e8f0" filter="drop-shadow(0 4px 6px rgba(0,0,0,0.06))" />
                            @((MarkupString)$"<text x=\"12\" y=\"22\" font-size=\"11\" font-weight=\"700\" fill=\"#1e293b\">{activeItem.Period}</text>")
                            @((MarkupString)"<text x=\"12\" y=\"42\" font-size=\"10\" fill=\"#64748b\">Income</text>")
                            @((MarkupString)"<text x=\"92\" y=\"42\" text-anchor=\"end\" font-size=\"10\" font-weight=\"700\" fill=\"#10b981\">24</text>")
                            @((MarkupString)"<text x=\"12\" y=\"60\" font-size=\"10\" fill=\"#64748b\">Expense:</text>")
                            @((MarkupString)"<text x=\"92\" y=\"60\" text-anchor=\"end\" font-size=\"10\" font-weight=\"700\" fill=\"#f43f5e\">24</text>")
                            @((MarkupString)"<text x=\"12\" y=\"78\" font-size=\"10\" fill=\"#64748b\">Net Profit</text>")
                            @((MarkupString)"<text x=\"92\" y=\"78\" text-anchor=\"end\" font-size=\"10\" font-weight=\"700\" fill=\"#3b82f6\">24</text>")
                        </g>
                    }
                </svg>
            </div>
        </div>

        <!-- Latest Stock Position Table Card -->
        <div class="fd-card fd-table-card">
            <div class="fd-card-header">
                <div class="fd-card-header-left">
                    <h3>Latest Stock Possition <span class="fd-as-on">(As on 15 Sep 2026)</span></h3>
                    <p class="fd-card-subtitle">Showing lats updated closing stock for each product</p>
                </div>
                <button type="button" class="fd-btn-outline-green" @onclick="ViewAllStock">
                    View All
                </button>
            </div>

            <div class="fd-table-wrapper">
                <table class="fd-table">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Opening</th>
                            <th>Purchase</th>
                            <th>Production</th>
                            <th>Sales</th>
                            <th>Motaility</th>
                            <th>Closing Stock</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in StockRows)
                        {
                            <tr>
                                <td>
                                    <div class="fd-product-cell">
                                        <div class="fd-product-icon">
                                            @if (row.Product == "Chicken")
                                            {
                                                <!-- Chicken Icon -->
                                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M16 16v1a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h7a2 2 0 0 1 2 2v2"></path>
                                                    <path d="M16 8h4a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-4"></path>
                                                    <circle cx="8" cy="9" r="1"></circle>
                                                </svg>
                                            }
                                            else if (row.Product == "Chicken Eggs")
                                            {
                                                <!-- Eggs Icon -->
                                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <ellipse cx="12" cy="13" rx="7" ry="9"></ellipse>
                                                </svg>
                                            }
                                            else if (row.Product == "Goat")
                                            {
                                                <!-- Goat / Livestock Icon -->
                                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M4 19V9a2 2 0 0 1 2-2h4l2-4 3 2-1 2h3a2 2 0 0 1 2 2v10"></path>
                                                    <path d="M4 15h16"></path>
                                                </svg>
                                            }
                                            else if (row.Product == "Quail")
                                            {
                                                <!-- Bird / Quail Icon -->
                                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M16 7h.01"></path>
                                                    <path d="M3.4 18H12a8 8 0 0 0 8-8V7a4 4 0 0 0-7-2.6A4 4 0 0 0 5 8v1a4 4 0 0 1-2 3.5V18z"></path>
                                                </svg>
                                            }
                                            else
                                            {
                                                <!-- Duck / Bird Icon -->
                                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M12 2a4 4 0 0 0-4 4v1c0 1.5.8 2.8 2 3.5V15a4 4 0 0 0 4 4h4v-3a5 5 0 0 0-5-5h-1"></path>
                                                </svg>
                                            }
                                        </div>
                                        <span class="fd-product-name">@row.Product</span>
                                    </div>
                                </td>
                                <td>@row.Opening</td>
                                <td>@row.Purchase</td>
                                <td>@row.Production</td>
                                <td>@row.Sales</td>
                                <td>@row.Mortality</td>
                                <td><span class="fd-closing-num">@row.ClosingStock</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Bottom Row: Income Overview & Top Expense Categories -->
        <div class="fd-bottom-grid">
            <!-- Left: Income Overview -->
            <div class="fd-card fd-income-overview-card">
                <div class="fd-card-header">
                    <div class="fd-card-header-left">
                        <h3>Income Overview <span class="fd-as-on">(Till 15 Sep 2026)</span></h3>
                    </div>
                    <button type="button" class="fd-btn-outline-green" @onclick="ViewIncomeDetails">
                        View Details
                    </button>
                </div>

                <div class="fd-income-body">
                    <!-- Donut Chart -->
                    <div class="fd-donut-wrap">
                        <svg viewBox="0 0 160 160" class="fd-donut-svg">
                            <!-- Background Circle -->
                            <circle cx="80" cy="80" r="54" fill="transparent" stroke="#f1f5f9" stroke-width="20" />

                            <!-- Blue Segment: Orchard Income (37% -> 339 * 0.37 = 125.4) -->
                            <!-- Perimeter 2 * PI * 54 = 339.29 -->
                            <circle cx="80" cy="80" r="54" fill="transparent" stroke="#3b82f6" stroke-width="20"
                                    stroke-dasharray="125.5 213.8" stroke-dashoffset="85"
                                    stroke-linecap="butt" />

                            <!-- Green Segment: Livestock Income (63% -> 339 * 0.63 = 213.7) -->
                            <circle cx="80" cy="80" r="54" fill="transparent" stroke="#10b981" stroke-width="20"
                                    stroke-dasharray="213.8 125.5" stroke-dashoffset="-40.5"
                                    stroke-linecap="butt" />

                            <!-- Donut Center Text -->
                            <text x="80" y="66" text-anchor="middle" class="fd-donut-center-muted">Total</text>
                            <text x="80" y="88" text-anchor="middle" class="fd-donut-center-val">50</text>
                            <text x="80" y="104" text-anchor="middle" class="fd-donut-center-muted">Program</text>
                        </svg>
                    </div>

                    <!-- Donut Legend & Values -->
                    <div class="fd-income-legend">
                        <div class="fd-income-legend-item">
                            <span class="fd-income-dot fd-dot-green"></span>
                            <div class="fd-income-item-text">
                                <span class="fd-income-item-title">Livestock Income</span>
                                <strong class="fd-income-item-amount">₹4,34,450 (63%)</strong>
                            </div>
                        </div>

                        <div class="fd-income-legend-item">
                            <span class="fd-income-dot fd-dot-blue"></span>
                            <div class="fd-income-item-text">
                                <span class="fd-income-item-title">Orchard Income</span>
                                <strong class="fd-income-item-amount">₹ 2,50,000 (37%)</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right: Top Expense Categories -->
            <div class="fd-card fd-expense-card">
                <div class="fd-card-header">
                    <div class="fd-card-header-left">
                        <h3>Top Expense Categories <span class="fd-as-on">( Till 15 Sep 2026)</span></h3>
                    </div>
                    <button type="button" class="fd-btn-outline-green" @onclick="ViewExpenseDetails">
                        View Details
                    </button>
                </div>

                <div class="fd-expense-body">
                    @foreach (var exp in ExpenseCategories)
                    {
                        <div class="fd-expense-row">
                            <div class="fd-expense-name-col">
                                <span class="fd-expense-dot @exp.DotColorClass"></span>
                                <span class="fd-expense-label">@exp.Name</span>
                            </div>

                            <div class="fd-expense-progress-col">
                                <div class="fd-expense-bar-track">
                                    <div class="fd-expense-bar-fill @exp.FillColorClass" style="width: @(exp.Percentage)%;"></div>
                                </div>
                            </div>

                            <div class="fd-expense-val-col">
                                <span class="fd-expense-val">₹@exp.Amount.ToString("N0", new System.Globalization.CultureInfo("en-IN"))</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>
</div>

