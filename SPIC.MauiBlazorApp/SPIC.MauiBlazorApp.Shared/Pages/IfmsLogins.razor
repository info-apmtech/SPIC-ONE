@page "/IfmsLogins"
@using System.Net.Http.Json
@using SPIC.Core.DTOs
@inject HttpClient Http
@inject IJSRuntime JS
<PageTitle>IFMS Logins</PageTitle>

<style>
    .il-container { font-family: 'Inter', sans-serif; max-width: 900px; }
    .il-container h1 { margin: 0 0 6px; font-size: 26px; font-weight: 700; color: #1e293b; }
    .il-lede { margin: 0 0 26px; font-size: 15px; color: #64748b; max-width: 70ch; }

    .il-card { border: 1px solid #e2e8f0; border-radius: 10px; background: #fff;
               padding: 20px; margin-bottom: 16px; }

    .il-head { display: flex; justify-content: space-between; align-items: flex-start;
               gap: 16px; flex-wrap: wrap; margin-bottom: 14px; }
    .il-name { font-size: 18px; font-weight: 700; color: #1e293b; }
    .il-user { font-size: 13px; color: #64748b; font-family: ui-monospace, monospace; }

    .il-pill { padding: 4px 12px; border-radius: 999px; font-size: 12px; font-weight: 600; }
    .il-ok    { background: #dcfce7; color: #166534; }
    .il-warn  { background: #fef3c7; color: #92400e; }
    .il-bad   { background: #fee2e2; color: #991b1b; }
    .il-off   { background: #f1f5f9; color: #475569; }

    .il-rows { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
               gap: 12px; margin-bottom: 16px; }
    .il-kv { background: #f8fafc; border-radius: 8px; padding: 10px 12px; }
    .il-k { font-size: 11px; text-transform: uppercase; letter-spacing: .04em; color: #64748b; }
    .il-v { font-size: 14px; color: #1e293b; font-weight: 600; margin-top: 2px; }

    .il-form { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
               gap: 12px; align-items: end; }
    .il-field label { display: block; font-size: 12px; font-weight: 600;
                      color: #475569; margin-bottom: 5px; }
    .il-field input { width: 100%; padding: 9px 12px; border: 1px solid #cbd5e1;
                      border-radius: 8px; font-size: 14px; box-sizing: border-box; }

    .il-btn { border: none; border-radius: 8px; padding: 10px 18px; font-size: 14px;
              font-weight: 600; cursor: pointer; background: #1d4ed8; color: #fff; }
    .il-btn:disabled { background: #94a3b8; cursor: not-allowed; }
    .il-btn-ghost { background: #fff; color: #334155; border: 1px solid #cbd5e1; }

    .il-note { border-left: 3px solid #1d4ed8; background: #eff6ff; padding: 12px 16px;
               border-radius: 0 8px 8px 0; font-size: 14px; color: #1e3a5f; margin-bottom: 20px; }
    .il-alarm { border-left-color: #b45309; background: #fffbeb; color: #7c2d12; }

    .il-msg-ok  { color: #166534; font-size: 14px; margin-top: 12px; }
    .il-msg-bad { color: #991b1b; font-size: 14px; margin-top: 12px; }
    .il-empty { text-align: center; padding: 40px; color: #64748b; }
</style>

<div class="il-container">
    <h1>IFMS Logins</h1>
    <p class="il-lede">
        The automation signs in as each company in turn and pulls that company's
        reports. Passwords are encrypted before they are stored and are never shown
        again — not here, and not through the API.
    </p>

    @if (accounts.Any(a => a.PasswordExpired || a.PasswordExpiringSoon))
    {
        <div class="il-note il-alarm">
            <strong>A password needs changing.</strong>
            The portal expires them every 80 days. Change it on
            dbtfert.nic.in first, then paste the new one in below — otherwise the
            4am run fails on a password nobody noticed had lapsed.
        </div>
    }

    @if (loading)
    {
        <div class="il-empty">Loading…</div>
    }
    else
    {
        @foreach (var account in accounts)
        {
            <div class="il-card">
                <div class="il-head">
                    <div>
                        <div class="il-name">@account.CompanyName</div>
                        <div class="il-user">@account.AccountKey &middot; @account.UserName</div>
                    </div>
                    <span class="il-pill @ExpiryClass(account)">@ExpiryLabel(account)</span>
                </div>

                <div class="il-rows">
                    <div class="il-kv">
                        <div class="il-k">Password set</div>
                        <div class="il-v">
                            @(account.HasPassword
                                ? account.PasswordSetAt.ToLocalTime().ToString("dd MMM yyyy")
                                : "never")
                        </div>
                    </div>
                    <div class="il-kv">
                        <div class="il-k">Expires</div>
                        <div class="il-v">@account.PasswordExpiresAt.ToLocalTime().ToString("dd MMM yyyy")</div>
                    </div>
                    <div class="il-kv">
                        <div class="il-k">Last login</div>
                        <div class="il-v">
                            @(account.LastLoginAt.HasValue
                                ? account.LastLoginAt.Value.ToLocalTime().ToString("dd MMM HH:mm")
                                : "never")
                        </div>
                    </div>
                    <div class="il-kv">
                        <div class="il-k">Result</div>
                        <div class="il-v" style="color:@(account.LastLoginSucceeded ? "#166534" : "#991b1b")">
                            @(account.LastLoginAt.HasValue
                                ? (account.LastLoginSucceeded ? "Signed in" : "Failed")
                                : "—")
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(account.LastLoginMessage) && !account.LastLoginSucceeded)
                {
                    <p style="color:#991b1b; font-size:13px; margin:0 0 14px;">
                        @account.LastLoginMessage
                    </p>
                }

                <div class="il-form">
                    <div class="il-field">
                        <label>New password</label>
                        <input type="password"
                               placeholder="paste the new password"
                               @bind="passwords[account.AccountKey]" />
                    </div>
                    <div class="il-field">
                        <label>OTP goes to</label>
                        <input placeholder="mobile number"
                               @bind="mobiles[account.AccountKey]" />
                    </div>
                    <div>
                        <button class="il-btn"
                                @onclick="() => SaveAsync(account)"
                                disabled="@saving">
                            @(saving ? "Saving…" : "Update password")
                        </button>
                    </div>
                    <div>
                        <button class="il-btn il-btn-ghost"
                                @onclick="() => ToggleActiveAsync(account)"
                                disabled="@saving">
                            @(account.IsActive ? "Disable" : "Enable")
                        </button>
                    </div>
                </div>
            </div>
        }

        <div class="il-card">
            <div class="il-name" style="margin-bottom:14px;">Add a login</div>

            <div class="il-form">
                <div class="il-field">
                    <label>Key</label>
                    <input placeholder="spic" @bind="newAccount.AccountKey" />
                </div>
                <div class="il-field">
                    <label>Company</label>
                    <input placeholder="SPIC" @bind="newAccount.CompanyName" />
                </div>
                <div class="il-field">
                    <label>Username</label>
                    <input placeholder="1000249825" @bind="newAccount.UserName" />
                </div>
                <div class="il-field">
                    <label>Password</label>
                    <input type="password" @bind="newAccount.Password" />
                </div>
                <div>
                    <button class="il-btn" @onclick="AddAsync" disabled="@saving">Add</button>
                </div>
            </div>

            <p style="font-size:13px; color:#64748b; margin:14px 0 0;">
                The key is what report jobs use to say which login pulls them —
                <code>spic</code> and <code>greenstar</code>.
            </p>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="@(succeeded ? "il-msg-ok" : "il-msg-bad")">@message</div>
    }
</div>

@code {
    private List<IfmsPortalAccountDto> accounts = new();
    private readonly Dictionary<string, string> passwords = new();
    private readonly Dictionary<string, string> mobiles = new();
    private IfmsSetAccountDto newAccount = new();

    private bool loading = true;
    private bool saving;
    private bool succeeded;
    private string? message;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;

        try
        {
            accounts = await Http.GetFromJsonAsync<List<IfmsPortalAccountDto>>(
                "api/IfmsAutomation/accounts") ?? new();

            foreach (var account in accounts)
            {
                passwords.TryAdd(account.AccountKey, string.Empty);
                mobiles[account.AccountKey] = account.OtpMobileNumber ?? string.Empty;
            }
        }
        catch (Exception ex)
        {
            succeeded = false;
            message = $"Could not load the logins. {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task SaveAsync(IfmsPortalAccountDto account)
    {
        var password = passwords.GetValueOrDefault(account.AccountKey) ?? string.Empty;

        if (string.IsNullOrWhiteSpace(password))
        {
            succeeded = false;
            message = "Enter the new password first.";
            return;
        }

        await PostAsync(new IfmsSetAccountDto
        {
            AccountKey = account.AccountKey,
            CompanyName = account.CompanyName,
            UserName = account.UserName,
            Password = password,
            OtpMobileNumber = mobiles.GetValueOrDefault(account.AccountKey)
        });

        // Never leave a password sitting in the form after it is saved.
        passwords[account.AccountKey] = string.Empty;
    }

    private async Task AddAsync()
    {
        if (string.IsNullOrWhiteSpace(newAccount.AccountKey) ||
            string.IsNullOrWhiteSpace(newAccount.UserName) ||
            string.IsNullOrWhiteSpace(newAccount.Password))
        {
            succeeded = false;
            message = "Key, username and password are all needed.";
            return;
        }

        await PostAsync(newAccount);
        newAccount = new IfmsSetAccountDto();
    }

    private async Task PostAsync(IfmsSetAccountDto dto)
    {
        saving = true;
        message = null;

        try
        {
            var response = await Http.PostAsJsonAsync("api/IfmsAutomation/accounts", dto);
            succeeded = response.IsSuccessStatusCode;

            message = succeeded
                ? $"Saved. The 80-day clock for {dto.CompanyName} starts now."
                : await response.Content.ReadAsStringAsync();

            if (succeeded)
                await LoadAsync();
        }
        catch (Exception ex)
        {
            succeeded = false;
            message = $"Could not save that. {ex.Message}";
        }
        finally
        {
            saving = false;
        }
    }

    private async Task ToggleActiveAsync(IfmsPortalAccountDto account)
    {
        saving = true;

        try
        {
            var response = await Http.PostAsync(
                $"api/IfmsAutomation/accounts/{account.Id}/active?active={(!account.IsActive).ToString().ToLowerInvariant()}",
                null);

            if (response.IsSuccessStatusCode)
                await LoadAsync();
        }
        catch (Exception ex)
        {
            succeeded = false;
            message = $"Could not change that. {ex.Message}";
        }
        finally
        {
            saving = false;
        }
    }

    private static string ExpiryClass(IfmsPortalAccountDto a)
    {
        if (!a.IsActive) return "il-off";
        if (!a.HasPassword || a.PasswordExpired) return "il-bad";
        return a.PasswordExpiringSoon ? "il-warn" : "il-ok";
    }

    private static string ExpiryLabel(IfmsPortalAccountDto a)
    {
        if (!a.IsActive) return "Disabled";
        if (!a.HasPassword) return "No password set";
        if (a.PasswordExpired) return $"Expired {Math.Abs(a.DaysUntilExpiry)} days ago";
        return $"{a.DaysUntilExpiry} days left";
    }
}
