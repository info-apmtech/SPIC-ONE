@namespace SPIC.MauiBlazorApp.Shared.Pages.DealerReview
@using DR = SPIC.Core.Entities
@using SPIC.MauiBlazorApp.Shared.Services
@inherits DealerReviewSectionBase
@inject LoginState LoginState

@*
    "Confirm Proceed" approval modal. The page still owns every decision: it opens and closes
    the popup, loads the Dealer Code preview, validates and posts the approval. This component
    only renders the dialog and pushes the edited values back through the *Changed callbacks,
    so the remarks box and the credit-limit inputs behave exactly as the page's own @bind did.

    Because it lives in its own component, typing in it no longer re-renders the ~4,000 line
    review page behind the overlay.
*@

        <style>
            .cp-wrapper * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
            .cp-modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.4); display: flex; align-items: center; justify-content: center; padding: 1rem; z-index: 1055; }
            .cp-modal-content { background-color: #ffffff; width: 100%; max-width: 720px; border-radius: 12px; box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12); display: flex; flex-direction: column; }
            .cp-modal-header { display: flex; justify-content: space-between; align-items: flex-start; padding: 18px 28px 10px; }
            .cp-modal-title { font-size: 1.2rem; font-weight: 700; color: #1f2937; margin-bottom: 4px; }
            .cp-modal-subtitle { font-size: 0.85rem; color: #6b7280; }
            .cp-btn-close { background: transparent; border: none; color: #9ca3af; cursor: pointer; padding: 2px; display: flex; align-items: center; justify-content: center; transition: color 0.2s; border-radius: 6px; }
            .cp-btn-close:hover { color: #374151; background: #f3f4f6; }
            .cp-modal-body { padding: 0 28px; }
            .cp-section-title { font-size: 0.85rem; font-weight: 600; color: #374151; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.4px; }
            .cp-optional-text { font-weight: 400; color: #9ca3af; font-size: 0.8rem; text-transform: none; letter-spacing: 0; }
            .cp-summary-section { margin-bottom: 16px; }
            .cp-summary-grid { display: grid; grid-template-columns: 1fr 1fr; row-gap: 6px; column-gap: 20px; background: #f9fafb; border-radius: 8px; padding: 12px 16px; }
            .cp-summary-item { display: flex; font-size: 0.82rem; }
            .cp-summary-label { color: #6b7280; flex: 0 0 130px; }
            .cp-summary-value { color: #1f2937; font-weight: 600; }
            .cp-credit-section { display: flex; gap: 12px; margin-bottom: 12px; flex-wrap: wrap; }
            .cp-credit-field { flex: 1; min-width: 180px; display: flex; flex-direction: column; }
            .cp-credit-field label { display: block; font-size: 0.75rem; font-weight: 600; color: #374151; margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.3px; min-height: 28px; line-height: 1.3; }
            .cp-credit-field input, .cp-credit-field .cp-credit-readonly { margin-top: auto; }
            .cp-credit-field input:focus { border-color: #115e59; box-shadow: 0 0 0 2px rgba(17, 94, 89, 0.1); }
            .cp-credit-field .cp-credit-readonly { background: #f3f4f6; color: #4b5563; font-weight: 600; display: flex; align-items: center; }
            .cp-code-section { margin-bottom: 14px; padding: 14px 16px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; }
            .cp-code-row { display: grid; grid-template-columns: 190px minmax(0, 1fr); gap: 12px; align-items: end; }
            .cp-code-field { display: flex; flex-direction: column; gap: 5px; }
            .cp-code-field label { font-size: 0.75rem; font-weight: 600; color: #374151; text-transform: uppercase; letter-spacing: 0.3px; }
            .cp-code-select, .cp-code-input { width: 100%; min-height: 40px; padding: 8px 11px; border: 1px solid #d1d5db; border-radius: 6px; background: #fff; color: #111827; font-size: 0.88rem; outline: none; }
            .cp-code-select:focus, .cp-code-input:focus { border-color: #115e59; box-shadow: 0 0 0 2px rgba(17, 94, 89, 0.08); }
            .cp-code-input[readonly] { background: #ecfdf5; color: #065f46; font-weight: 700; letter-spacing: 0.5px; }
            .cp-code-help { margin-top: 9px; font-size: 0.76rem; color: #64748b; line-height: 1.45; }
            .cp-code-help strong { color: #334155; }
            .cp-code-loading { color: #0369a1; font-size: 0.78rem; margin-top: 8px; }
            .cp-code-error { color: #b91c1c; font-size: 0.78rem; margin-top: 8px; }
            .cp-remarks-section { margin-bottom: 12px; }
            .cp-remarks-input { width: 100%; min-height: 56px; padding: 10px 14px; border: 1px solid #e5e7eb; border-radius: 6px; resize: vertical; font-size: 0.85rem; color: #374151; outline: none; transition: border-color 0.2s; }
            .cp-remarks-input:focus { border-color: #d1d5db; }
            .cp-info-alert { background-color: #f0f9ff; border: 1px solid #e0f2fe; border-radius: 8px; padding: 10px 16px; display: flex; align-items: center; gap: 10px; margin-bottom: 16px; }
            .cp-alert-icon { width: 28px; height: 28px; background-color: #dbeafe; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
            .cp-alert-text { color: #6b7280; font-size: 0.8rem; margin: 0; line-height: 1.4; }
            .cp-error-alert { background-color: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; padding: 10px 16px; color: #b91c1c; font-size: 0.85rem; font-weight: 500; margin-bottom: 12px; }
            .cp-remarks-history { background: #f9fafb; border-radius: 8px; padding: 10px 16px; margin-bottom: 12px; }
            .cp-remarks-history ul { list-style: none; margin: 0; padding: 0; }
            .cp-remarks-history li { font-size: 0.8rem; color: #4b5563; padding: 5px 0; }
            .cp-remarks-history li + li { border-top: 1px solid #e5e7eb; }
            .cp-remarks-history strong { color: #1f2937; }
            .cp-modal-footer { display: flex; justify-content: flex-end; gap: 12px; padding: 12px 28px 18px; }
            .cp-btn { display: inline-flex; align-items: center; gap: 6px; padding: 8px 18px; border-radius: 6px; font-size: 0.85rem; font-weight: 500; cursor: pointer; transition: all 0.2s; }
            .cp-btn-cancel { background-color: #ffffff; border: 1px solid #d1d5db; color: #4b5563; }
            .cp-btn-cancel:hover { background-color: #f9fafb; color: #1f2937; }
            .cp-btn-confirm { background-color: #115e59; border: 1px solid #115e59; color: #ffffff; }
            .cp-btn-confirm:hover { background-color: #0f514e; }
            .cp-btn-confirm:disabled { opacity: 0.6; cursor: not-allowed; }
            @@media (max-width: 768px) { .cp-summary-grid { grid-template-columns: 1fr; row-gap: 4px; padding: 10px 14px; } .cp-summary-label { flex: 0 0 110px; } .cp-modal-header, .cp-modal-body, .cp-modal-footer { padding-left: 16px; padding-right: 16px; } .cp-credit-field { min-width: 100%; } .cp-code-row { grid-template-columns: 1fr; } }
        </style>

        <div class="cp-wrapper">
            <div class="cp-modal-overlay" @onclick="OnClose">
                <div class="cp-modal-content" @onclick:stopPropagation="true">

                    <header class="cp-modal-header">
                        <div class="header-text">
                            <h1 class="cp-modal-title">Confirm Proceed</h1>
                            <p class="cp-modal-subtitle">Are you sure you want to approve and forward this application to @NextStageTarget?</p>
                        </div>
                        <button class="cp-btn-close" aria-label="Close modal" @onclick="OnClose">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="15" y1="9" x2="9" y2="15"></line>
                                <line x1="9" y1="9" x2="15" y2="15"></line>
                            </svg>
                        </button>
                    </header>

                    <div class="cp-modal-body">
                        <section class="cp-summary-section">
                            <h2 class="cp-section-title">Application Summary</h2>
                            <div class="cp-summary-grid">
                                @* <div class="cp-summary-item">
                                    <span class="cp-summary-label">Ref No</span>
                                    <span class="cp-summary-value">@(Dealer?.DealerCode ?? $"DL-{Dealer?.Id}")</span>
                                </div> *@
                                @if (!IsNewDealer)
                                {
                                    <div class="cp-summary-item">
                                        <span class="cp-summary-label">Dealer Code</span>
                                        <span class="cp-summary-value">@(Dealer?.DealerCode ?? "-")</span>
                                    </div>
                                }
                                <div class="cp-summary-item">
                                    <span class="cp-summary-label">Dealer Name</span>
                                    <span class="cp-summary-value">@(Dealer?.FirmName ?? "-")</span>
                                </div>
                                @if (Dealer?.Status != DR.DealerStatus.InActive && ShowBusinessInfo && !IsNewDealer)
                                {
                                    @if (Dealer?.IsCreditLimitConsentGiven != true)
                                    {
                                        @if (ShowSpicCreditLimit)
                                        {
                                            <div class="cp-summary-item">
                                                <span class="cp-summary-label">MO Recommended CreditLimit  (SPIC)</span>
                                                <span class="cp-summary-value">₹ @Figures.GetSpicMoRecommendedLimit().ToString("N2")</span>
                                            </div>
                                        }
                                        @if (ShowGreenstarCreditLimit)
                                        {
                                            <div class="cp-summary-item">
                                                <span class="cp-summary-label">MO Recommended CreditLimit (GFL)</span>
                                                <span class="cp-summary-value">₹ @Figures.GetGflMoRecommendedLimit().ToString("N2")</span>
                                            </div>
                                        }
                                    }
                                }
                                <div class="cp-summary-item">
                                    <span class="cp-summary-label">Current Stage</span>
                                    <span class="cp-summary-value">@CurrentStageTarget</span>
                                </div>
                                <div class="cp-summary-item">
                                    <span class="cp-summary-label">Next Stage</span>
                                    <span class="cp-summary-value">@NextStageTarget</span>
                                </div>
                            </div>
                        </section>

                        @if (IsNewDealerFinalApproval)
                        {
                            <section class="cp-code-section">
                                <h2 class="cp-section-title">Dealer Code Review</h2>
                                <div class="cp-code-row">
                                    <div class="cp-code-field">
                                        <label>Code Prefix</label>
                                        <select class="cp-code-select"
                                                value="@SelectedDealerCodePrefix"
                                                @onchange="OnDealerCodePrefixChanged"
                                                disabled="@(IsApproving || IsDealerCodePreviewLoading)">
                                            <option value="D">D - SPIC</option>
                                            <option value="N">N - GreenStar</option>
                                            <option value="Z">Z - GreenStar</option>
                                            <option value="T">T - GreenStar</option>
                                        </select>
                                    </div>
                                    <div class="cp-code-field">
                                        <label>Proposed Dealer Code</label>
                                        <input class="cp-code-input"
                                               value="@AvpDealerCode"
                                               readonly
                                               placeholder="Select prefix to generate Dealer Code" />
                                    </div>
                                </div>
                                <div class="cp-code-help">
                                    <strong>D</strong> saves the reviewed code to <strong>DealerCode + SPICCode</strong>.
                                    <strong>N / Z / T</strong> save it to <strong>DealerCode + GreenStarCode</strong>.
                                    For compatibility, <strong>N</strong> also mirrors to <strong>NCode</strong> and
                                    <strong>T</strong> also mirrors to <strong>TnCode</strong>.
                                </div>
                                @if (IsDealerCodePreviewLoading)
                                {
                                    <div class="cp-code-loading">Generating Dealer Code preview...</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(DealerCodePreviewError))
                                {
                                    <div class="cp-code-error">@DealerCodePreviewError</div>
                                }
                            </section>
                        }

                        <section class="cp-remarks-section">
                            <h2 class="cp-section-title">Remarks <span class="cp-optional-text">@(IsNewDealer ? "(required)" : "(optional)")</span></h2>
                            <textarea class="cp-remarks-input" @bind="Remarks" placeholder="@(IsNewDealer ? "Remarks are required for this stage" : "Enter Remarks Optional")"></textarea>
                        </section>

                       @if (Dealer?.IsCreditLimitConsentGiven == true)
                       {
                           <section class="cp-remarks-section" style="background:#F0FDF4; border:1px solid #BBF7D0; border-radius:8px; padding:14px 18px; margin-bottom:16px;">
                               <div style="display:flex; align-items:center; gap:8px; color:#166534; font-weight:600; font-size:0.95rem; margin-bottom:4px;">
                                   <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                       <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                                       <polyline points="22 4 12 14.01 9 11.01"></polyline>
                                   </svg>
                                   Credit Limit Consent
                               </div>
<p style="margin:0; color:#374151; font-size:0.875rem; font-weight:500;">Disclaimer: The form has been submitted with consent (i.e.,) without credit limit details. Hence the dealer's credit limit is <strong>0</strong>.</p>
                            </section>
                       }
                       else if (Dealer?.Status != DR.DealerStatus.InActive && ShowBusinessInfo && !IsNewDealer)
                       {
                           @if (LoginState.IsRMGroup)
{
    <section class="cp-credit-section">
        @if (ShowSpicCreditLimit)
        {
            <div class="cp-credit-field">
                <label>RM Credit Limit (SPIC)</label>
                <input type="number" step="0.01" @bind="RmSpic" placeholder="Enter RM Credit Limit (SPIC)" />
            </div>
        }
        @if (ShowGreenstarCreditLimit)
        {
            <div class="cp-credit-field">
                <label>RM Credit Limit (GFL)</label>
                <input type="number" step="0.01" @bind="RmGfl" placeholder="Enter RM Credit Limit (GFL)" />
            </div>
        }
    </section>
}
@if (LoginState.IsSMGroup)
{
    <section class="cp-credit-section">
        @{
            var rmSpicApproval = ApprovalHistory?.FirstOrDefault(h => h.RmCreditLimit.HasValue && h.IsApproved);
            var rmGflApproval = ApprovalHistory?.FirstOrDefault(h => h.RmCreditLimitGfl.HasValue && h.IsApproved);
        }
        @if (ShowSpicCreditLimit && rmSpicApproval?.RmCreditLimit.HasValue == true)
        {
            <div class="cp-credit-field">
                <label>RM Credit Limit (SPIC) (Approved)</label>
                <div class="cp-credit-readonly">₹ @rmSpicApproval.RmCreditLimit.Value.ToString("N2")</div>
            </div>
        }
        @if (ShowGreenstarCreditLimit && rmGflApproval?.RmCreditLimitGfl.HasValue == true)
        {
            <div class="cp-credit-field">
                <label>RM Credit Limit (GFL) (Approved)</label>
                <div class="cp-credit-readonly">₹ @rmGflApproval.RmCreditLimitGfl.Value.ToString("N2")</div>
            </div>
        }
        @if (ShowSpicCreditLimit)
        {
            <div class="cp-credit-field">
                <label>SM Credit Limit (SPIC)</label>
                <input type="number" step="0.01" @bind="SmSpic" placeholder="Enter SM Credit Limit (SPIC)" />
            </div>
        }
        @if (ShowGreenstarCreditLimit)
        {
            <div class="cp-credit-field">
                <label>SM Credit Limit (GFL)</label>
                <input type="number" step="0.01" @bind="SmGfl" placeholder="Enter SM Credit Limit (GFL)" />
            </div>
        }
    </section>
}
@if (LoginState.IsDirectorOrAVP || LoginState.IsAdmin)
{
    <section class="cp-credit-section">
        @{
            var rmSpicApproval = ApprovalHistory?.FirstOrDefault(h => h.RmCreditLimit.HasValue && h.IsApproved);
            var rmGflApproval = ApprovalHistory?.FirstOrDefault(h => h.RmCreditLimitGfl.HasValue && h.IsApproved);
            var smSpicApproval = ApprovalHistory?.FirstOrDefault(h => h.SmCreditLimit.HasValue && h.IsApproved);
            var smGflApproval = ApprovalHistory?.FirstOrDefault(h => h.SmCreditLimitGfl.HasValue && h.IsApproved);
        }
        @if (ShowSpicCreditLimit && rmSpicApproval?.RmCreditLimit.HasValue == true)
        {
            <div class="cp-credit-field">
                <label>RM Credit Limit (SPIC) (Approved)</label>
                <div class="cp-credit-readonly">₹ @rmSpicApproval.RmCreditLimit.Value.ToString("N2")</div>
            </div>
        }
        @if (ShowGreenstarCreditLimit && rmGflApproval?.RmCreditLimitGfl.HasValue == true)
        {
            <div class="cp-credit-field">
                <label>RM Credit Limit (GFL) (Approved)</label>
                <div class="cp-credit-readonly">₹ @rmGflApproval.RmCreditLimitGfl.Value.ToString("N2")</div>
            </div>
        }
        @if (ShowSpicCreditLimit && smSpicApproval?.SmCreditLimit.HasValue == true)
        {
            <div class="cp-credit-field">
                <label>SM Credit Limit (SPIC) (Approved)</label>
                <div class="cp-credit-readonly">₹ @smSpicApproval.SmCreditLimit.Value.ToString("N2")</div>
            </div>
        }
        @if (ShowGreenstarCreditLimit && smGflApproval?.SmCreditLimitGfl.HasValue == true)
        {
            <div class="cp-credit-field">
                <label>SM Credit Limit (GFL) (Approved)</label>
                <div class="cp-credit-readonly">₹ @smGflApproval.SmCreditLimitGfl.Value.ToString("N2")</div>
            </div>
        }
        @if (ShowSpicCreditLimit)
        {
            <div class="cp-credit-field">
                <label>AVP Credit Limit (SPIC)</label>
                <input type="number" step="0.01" @bind="AvpSpic" placeholder="Enter AVP Credit Limit (SPIC)" />
            </div>
        }
        @if (ShowGreenstarCreditLimit)
        {
            <div class="cp-credit-field">
                <label>AVP Credit Limit (GFL)</label>
                <input type="number" step="0.01" @bind="AvpGfl" placeholder="Enter AVP Credit Limit (GFL)" />
            </div>
        }
    </section>
}
}

                       @if (IsNewDealer && ApprovalHistory != null && ApprovalHistory.Any())
                       {
                           <div class="cp-remarks-history">
                               <h2 class="cp-section-title">Previous Approval Remarks</h2>
                               <ul>
                                   @foreach (var h in ApprovalHistory.OrderBy(x => x.ApprovedAt))
                                   {
                                       <li>
                                           <strong>@h.Role</strong> (@h.ApprovedAt.ToString("dd-MMM-yyyy, hh:mm tt")): @(string.IsNullOrWhiteSpace(h.Remarks) ? "No remarks" : h.Remarks)
                                       </li>
                                   }
                               </ul>
                           </div>
                       }

                       @if (!string.IsNullOrEmpty(ApprovalError))
                       {
                           <div class="cp-error-alert">@ApprovalError</div>
                       }

                        <div class="cp-info-alert">
                            <div class="cp-alert-icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <line x1="12" y1="16" x2="12" y2="12"></line>
                                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                                </svg>
                            </div>
                            <p class="cp-alert-text">Once You Proceed the Application will be Forwarded to @NextStageTarget and you will not be able to edit it</p>
                        </div>
                    </div>

                    <footer class="cp-modal-footer">
                        <button class="cp-btn cp-btn-cancel" @onclick="OnClose" disabled="@IsApproving">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                <line x1="6" y1="6" x2="18" y2="18"></line>
                            </svg>
                            Cancel
                        </button>
                        <button class="cp-btn cp-btn-confirm"
                                @onclick="OnConfirm"
                                disabled="@(IsApproving || (IsNewDealerFinalApproval && (IsDealerCodePreviewLoading || string.IsNullOrWhiteSpace(AvpDealerCode))))">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                            @(IsApproving ? "Processing..." : "Confirm & Proceed")
                        </button>
                    </footer>

                </div>
            </div>
        </div>

@code {
    [Parameter] public DR.DealerRegistration? Dealer { get; set; }
    [Parameter] public List<DR.DealerApprovalHistory> ApprovalHistory { get; set; } = new();
    [Parameter] public DealerReviewFigures Figures { get; set; } = default!;

    [Parameter] public bool IsNewDealer { get; set; }
    [Parameter] public bool IsNewDealerFinalApproval { get; set; }
    [Parameter] public bool ShowBusinessInfo { get; set; }
    [Parameter] public bool ShowSpicCreditLimit { get; set; }
    [Parameter] public bool ShowGreenstarCreditLimit { get; set; }

    [Parameter] public string CurrentStageTarget { get; set; } = "";
    [Parameter] public string NextStageTarget { get; set; } = "";

    [Parameter] public bool IsApproving { get; set; }
    [Parameter] public bool IsDealerCodePreviewLoading { get; set; }
    [Parameter] public string? DealerCodePreviewError { get; set; }
    [Parameter] public string? ApprovalError { get; set; }
    [Parameter] public string SelectedDealerCodePrefix { get; set; } = "D";
    [Parameter] public string AvpDealerCode { get; set; } = string.Empty;

    /// <summary>Close (overlay click, X and Cancel all use it), confirm, and prefix change —
    /// all handled by the page so the approval flow is untouched.</summary>
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback<ChangeEventArgs> OnDealerCodePrefixChanged { get; set; }

    // Two-way values. Each proxy writes the page's field through the matching callback,
    // which is exactly what the page's own @bind used to do.
    [Parameter] public string ConfirmRemarks { get; set; } = "";
    [Parameter] public EventCallback<string> ConfirmRemarksChanged { get; set; }

    [Parameter] public decimal? RmCreditLimitSpic { get; set; }
    [Parameter] public EventCallback<decimal?> RmCreditLimitSpicChanged { get; set; }
    [Parameter] public decimal? RmCreditLimitGfl { get; set; }
    [Parameter] public EventCallback<decimal?> RmCreditLimitGflChanged { get; set; }
    [Parameter] public decimal? SmCreditLimitSpic { get; set; }
    [Parameter] public EventCallback<decimal?> SmCreditLimitSpicChanged { get; set; }
    [Parameter] public decimal? SmCreditLimitGfl { get; set; }
    [Parameter] public EventCallback<decimal?> SmCreditLimitGflChanged { get; set; }
    [Parameter] public decimal? AvpCreditLimitSpic { get; set; }
    [Parameter] public EventCallback<decimal?> AvpCreditLimitSpicChanged { get; set; }
    [Parameter] public decimal? AvpCreditLimitGfl { get; set; }
    [Parameter] public EventCallback<decimal?> AvpCreditLimitGflChanged { get; set; }

    [Parameter] public int DataVersion { get; set; }

    private string Remarks
    {
        get => ConfirmRemarks;
        set { ConfirmRemarks = value; ConfirmRemarksChanged.InvokeAsync(value); }
    }

    private decimal? RmSpic
    {
        get => RmCreditLimitSpic;
        set { RmCreditLimitSpic = value; RmCreditLimitSpicChanged.InvokeAsync(value); }
    }

    private decimal? RmGfl
    {
        get => RmCreditLimitGfl;
        set { RmCreditLimitGfl = value; RmCreditLimitGflChanged.InvokeAsync(value); }
    }

    private decimal? SmSpic
    {
        get => SmCreditLimitSpic;
        set { SmCreditLimitSpic = value; SmCreditLimitSpicChanged.InvokeAsync(value); }
    }

    private decimal? SmGfl
    {
        get => SmCreditLimitGfl;
        set { SmCreditLimitGfl = value; SmCreditLimitGflChanged.InvokeAsync(value); }
    }

    private decimal? AvpSpic
    {
        get => AvpCreditLimitSpic;
        set { AvpCreditLimitSpic = value; AvpCreditLimitSpicChanged.InvokeAsync(value); }
    }

