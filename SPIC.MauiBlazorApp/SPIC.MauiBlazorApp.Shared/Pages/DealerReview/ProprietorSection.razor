@namespace SPIC.MauiBlazorApp.Shared.Pages.DealerReview
@using DR = SPIC.Core.Entities
@inherits DealerReviewSectionBase

@*
    "Proprietor Details" accordion: one row per owner with their identity, address,
    other occupations and family members.
*@

    <div class="custom-accordion @(IsOpen ? "active" : "")">
        <div class="accordion-header" @onclick="OnToggle">
            Proprietor Details
            <i class="bi bi-chevron-down"></i>
        </div>
      <div class="accordion-body">
            @if (OwnershipList != null && OwnershipList.Any())
            {
                @foreach (var owner in OwnershipList)
                {
                    var ownerFamily = Partners.Where(f => f.OwnershipPartnerId == owner.Id).ToList();
                    var ownerOcc = Occupations.Where(o => o.OwnershipPartnerId == owner.Id).ToList();

                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <div class="detail-card h-100">
                                <div class="detail-card-header">
                                    <h4 class="detail-card-title"><i class="bi bi-person-badge"></i> @(owner.Name ?? "Proprietor")</h4>
                                    <i class="bi bi-pencil-square edit-icon" @onclick="OnEdit" role="button" title="Edit"></i>
                                </div>
                                <div class="detail-card-body">
                                    <div class="data-row"><div class="data-label">Proprietor Name:</div><div class="data-value">@owner.Name</div></div>
                                    <div class="data-row"><div class="data-label">Father Name:</div><div class="data-value">@owner.FatherName</div></div>
                                    <div class="data-row"><div class="data-label">Gender:</div><div class="data-value">@owner.Gender.ToString()</div></div>
                                    <div class="data-row"><div class="data-label">Marital Status:</div><div class="data-value">@owner.MaritalStatus.ToString()</div></div>
                                    <div class="data-row"><div class="data-label">Date of Birth:</div><div class="data-value">@owner.DOB.ToString("dd/MM/yyyy")</div></div>
                                    <div class="data-row"><div class="data-label">Phone Number:</div><div class="data-value">@owner.PhoneNumber</div></div>
                                    <div class="data-row"><div class="data-label">Email:</div><div class="data-value">@owner.Email</div></div>
                                    <div class="data-row"><div class="data-label">Aadhaar Number:</div><div class="data-value">@owner.AadhaarNumber</div></div>
                                    <div class="data-row"><div class="data-label">Aadhaar Document:</div><div class="data-value">@RenderFileRow(owner.AadhaarFilePath)</div></div>
                                    <div class="data-row"><div class="data-label">PAN Number:</div><div class="data-value">@owner.PANNumber</div></div>
                                    <div class="data-row"><div class="data-label">PAN Document:</div><div class="data-value">@RenderFileRow(owner.PANFilePath)</div></div>
                                    <div class="data-row"><div class="data-label">Proprietor Image:</div><div class="data-value">@RenderFileRow(owner.ProprietorImagePath)</div></div>
                                    <div class="mt-3 mb-2"><strong>Address Details</strong></div>
                                    <div class="data-row"><div class="data-label">Shop No / Room No / Block No:</div><div class="data-value">@(owner.ShopNoORRoomNoOrBlockNo ?? "-")</div></div>
                                    <div class="data-row"><div class="data-label">Street:</div><div class="data-value">@(owner.Street ?? "-")</div></div>
                                    <div class="data-row"><div class="data-label">Sub Village:</div><div class="data-value">@(owner.SubVillage ?? "-")</div></div>
                                    <div class="data-row"><div class="data-label">Village:</div><div class="data-value">@(owner.Village ?? "-")</div></div>
                                    <div class="data-row"><div class="data-label">Pin Code:</div><div class="data-value">@(owner.PinCode ?? "-")</div></div>
                                    <div class="data-row"><div class="data-label">Block:</div><div class="data-value">@(owner.Block ?? "-")</div></div>
                                    <div class="data-row"><div class="data-label">Taluk:</div><div class="data-value">@(owner.Taluk ?? "-")</div></div>
                                  <div class="data-row"><div class="data-label">District:</div><div class="data-value">@DealerReviewFormat.GetPartnerDistrictName(DistrictsAll, owner.DistrictId)</div></div>
                                    <div class="data-row"><div class="data-label">State:</div><div class="data-value">@DealerReviewFormat.GetPartnerStateName(StatesAll, owner.StateId)</div></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex flex-column gap-4 h-100">
                                <div class="detail-card">
                                    <div class="detail-card-header">
                                        <h4 class="detail-card-title"><i class="bi bi-briefcase"></i> Other Occupation / Agencies</h4>
                                        <i class="bi bi-pencil-square edit-icon" @onclick="OnEdit" role="button" title="Edit"></i>
                                    </div>
                                    <div class="detail-card-body">
                                        @if (ownerOcc.Any())
                                        {
                                            foreach (var oc in ownerOcc)
                                            {
                                                <div class="data-row"><div class="data-label">Name of Company</div><div class="data-value">@oc.NameofCompany</div></div>
                                                <div class="data-row"><div class="data-label">Sector:</div><div class="data-value">@oc.SectorId</div></div>
                                                <div class="data-row"><div class="data-label">Annual Turnover:</div><div class="data-value">@oc.AnnualTurnover</div></div>
                                                <div class="mb-2"></div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="data-row"><div class="data-label">Other Occupation</div><div class="data-value">None</div></div>
                                        }
                                    </div>
                                </div>

                                <div class="detail-card">
                                    <div class="detail-card-header">
                                        <h4 class="detail-card-title"><i class="bi bi-people"></i> Family Members</h4>
                                        <i class="bi bi-pencil-square edit-icon" @onclick="OnEdit" role="button" title="Edit"></i>
                                    </div>
                                    <div class="detail-card-body">
                                        @if (ownerFamily.Any())
                                        {
                                            foreach (var p in ownerFamily)
                                            {
                                                <div class="data-row"><div class="data-label">Family Member Name:</div><div class="data-value">@p.FamilyMemberName</div></div>
                                                <div class="data-row"><div class="data-label">D.O.B:</div><div class="data-value">@p.DateOfBirth.ToString("dd/MM/yyyy")</div></div>
                                                <div class="data-row"><div class="data-label">Age:</div><div class="data-value">@p.Age</div></div>
                                                <div class="data-row"><div class="data-label">Relationship:</div><div class="data-value">@p.RelationshipId</div></div>
                                                <div class="data-row"><div class="data-label">Occupation:</div><div class="data-value">@(p.Occupation ?? "-")</div></div>
                                                <div class="mb-2"></div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="data-row"><div class="data-label">Family Members</div><div class="data-value">None</div></div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="detail-card h-100">
                            <div class="detail-card-header">
                                <h4 class="detail-card-title"><i class="bi bi-person-badge"></i> Ownership Information</h4>
                                <i class="bi bi-pencil-square edit-icon" @onclick="OnEdit" role="button" title="Edit"></i>
                            </div>
                            <div class="detail-card-body">
                                <div class="data-row"><div class="data-label">Ownership</div><div class="data-value">No ownership info</div></div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnToggle { get; set; }
    [Parameter] public EventCallback OnEdit { get; set; }

    [Parameter] public List<DR.DealerOwnershipInfo> OwnershipList { get; set; } = new();
    [Parameter] public List<DR.PartnerFamilyDetails> Partners { get; set; } = new();
    [Parameter] public List<DR.PartnerOccupation> Occupations { get; set; } = new();
    [Parameter] public List<DR.State> StatesAll { get; set; } = new();
    [Parameter] public List<DR.District> DistrictsAll { get; set; } = new();

    [Parameter] public string? ApiBaseUrl { get; set; }
    [Parameter] public string? AuthToken { get; set; }
    [Parameter] public int DataVersion { get; set; }

    private RenderFragment RenderFileRow(string? path) =>
        DealerReviewFormat.FileRow(ApiBaseUrl, AuthToken, path);
}
