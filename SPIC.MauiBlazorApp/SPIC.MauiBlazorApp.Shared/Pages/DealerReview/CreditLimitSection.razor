                                            <td rowspan="2" class="align-middle">Urea Sales Turnover with SPIC during last year</td>
                                            <td rowspan="2" class="text-center align-middle">20</td>
                                            <td class="text-center">Rs. Lakhs</td>
                                            <td class="text-center">&gt;30</td><td class="text-center">&gt;20</td><td class="text-center">&gt;15</td><td class="text-center">&gt;10</td><td class="text-center">&lt;10</td>
                                            <td rowspan="2" class="align-middle"><div class="rv-val-box">@Figures.SpicPerfUreaTurnover().ToString("N2")</div></td>
                                            <td rowspan="2" class="text-center align-middle"><div class="rv-mark-box">@CreditProposal.Q4Mark</div></td>
                                        </tr>
                                        <tr><td class="text-center rv-muted">Marks</td><td class="text-center">20</td><td class="text-center">16</td><td class="text-center">12</td><td class="text-center">8</td><td class="text-center">4</td></tr>

                                        <tr>
