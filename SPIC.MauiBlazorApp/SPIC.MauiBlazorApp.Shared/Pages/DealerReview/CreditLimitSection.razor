@namespace SPIC.MauiBlazorApp.Shared.Pages.DealerReview
@using DR = SPIC.Core.Entities
@inherits DealerReviewSectionBase

@*
    "Credit Limit Proposal" accordion — by far the biggest block on the page: the existing SPIC
    and GreenStar limits, the fiscal years, both valuation score tables with their recommended
    limit footers, and the sales performance table.

    Every number comes from the shared DealerReviewFigures instance, so this section renders
    only when the proposal / sales data is (re)loaded.
*@

    <div class="custom-accordion @(IsOpen ? "active" : "")">
        <div class="accordion-header" @onclick="OnToggle">
            Credit Limit Proposal
            <i class="bi bi-chevron-down"></i>
        </div>
        <div class="accordion-body">
            <div class="row g-4">
                @if (CreditProposal != null)
                {
<div class="col-md-6">
                        <div class="detail-card h-100">
                            <div class="detail-card-header">
                                <h4 class="detail-card-title"><i class="bi bi-credit-card"></i> Existing Credit Limit — SPIC</h4>
                                <i class="bi bi-pencil-square edit-icon" @onclick="OnEdit" role="button" title="Edit"></i>
                            </div>
                            <div class="detail-card-body">
                                <div class="data-row"><div class="data-label">Amount:</div><div class="data-value">₹@CreditProposal.SpicExistingCreditLimitAmount.ToString("N2")</div></div>
                                <div class="data-row"><div class="data-label">From:</div><div class="data-value">@(CreditProposal.SpicExistingCreditLimitFrom.Year > 1 ? CreditProposal.SpicExistingCreditLimitFrom.ToString("dd MMM yyyy") : "-")</div></div>
                                <div class="data-row"><div class="data-label">To:</div><div class="data-value">@(CreditProposal.SpicExistingCreditLimitTo.Year > 1 ? CreditProposal.SpicExistingCreditLimitTo.ToString("dd MMM yyyy") : "-")</div></div>
                               @*  <div class="data-row"><div class="data-label">Additional Credit Limit:</div><div class="data-value">₹@CreditProposal.AdditionalCreditLimit.ToString("N2")</div></div> *@
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="detail-card h-100">
                            <div class="detail-card-header">
                                <h4 class="detail-card-title"><i class="bi bi-credit-card"></i> Existing Credit Limit — GreenStar</h4>
                                <i class="bi bi-pencil-square edit-icon" @onclick="OnEdit" role="button" title="Edit"></i>
                            </div>
                            <div class="detail-card-body">
                                <div class="data-row"><div class="data-label">Amount:</div><div class="data-value">₹@CreditProposal.GSExistingCreditLimitAmount.ToString("N2")</div></div>
                                <div class="data-row"><div class="data-label">From:</div><div class="data-value">@(CreditProposal.GSExistingCreditLimitFrom.Year > 1 ? CreditProposal.GSExistingCreditLimitFrom.ToString("dd MMM yyyy") : "-")</div></div>
                                <div class="data-row"><div class="data-label">To:</div><div class="data-value">@(CreditProposal.GSExistingCreditLimitTo.Year > 1 ? CreditProposal.GSExistingCreditLimitTo.ToString("dd MMM yyyy") : "-")</div></div>
                              @*   <div class="data-row"><div class="data-label">Greenstar Additional:</div><div class="data-value">₹@CreditProposal.GreenstarAdditionalCreditLimit.ToString("N2")</div></div> *@
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="detail-card">
                            <div class="detail-card-header">
                                <h4 class="detail-card-title"><i class="bi bi-calendar-week"></i> Fiscal Years </h4>
                                <i class="bi bi-pencil-square edit-icon" @onclick="OnEdit" role="button" title="Edit"></i>
                            </div>
                            <div class="detail-card-body">
                                <div class="row">
                                    <div class="col-md-4"><div class="data-row"><div class="data-label">FY1:</div><div class="data-value">@DealerReviewFormat.FyName(FinancialYearNames, CreditProposal.FY1)</div></div></div>
                                    <div class="col-md-4"><div class="data-row"><div class="data-label">FY2:</div><div class="data-value">@DealerReviewFormat.FyName(FinancialYearNames, CreditProposal.FY2)</div></div></div>
