                                            <td class="text-center">Rs. Lakhs</td>
                                            <td class="text-center">&lt;1</td><td class="text-center">&lt;5</td><td class="text-center">&lt;10</td><td class="text-center">&lt;20</td><td class="text-center">&lt;30</td>
