                                            <td class="text-center">Rs. Lakhs</td>
                                            <td></td><td></td><td></td><td></td><td></td>
                                            <td class="align-middle"><div class="rv-val-box">@Figures.SpicFixedAssets().ToString("N2")</div></td>
                                            <td class="text-center align-middle rv-muted">-</td>
