                                        <tr><td class="text-center rv-muted">Marks</td><td class="text-center">20</td><td class="text-center">16</td><td class="text-center">12</td><td class="text-center">8</td><td class="text-center">4</td></tr>

                                        <tr>
                                            <td class="text-center align-middle">8</td>
                                            <td class="align-middle">Value of dealer's property - Fixed Assets</td>
                                            <td rowspan="3" class="text-center align-middle rv-muted">Financial Soundness</td>
                                            <td rowspan="3" class="text-center align-middle">10</td>
                                            <td class="text-center">Rs. Lakhs</td>
                                            <td></td><td></td><td></td><td></td><td></td>
                                            <td class="align-middle"><div class="rv-val-box">@Figures.SpicFixedAssets().ToString("N2")</div></td>
                                            <td class="text-center align-middle rv-muted">-</td>
                                        </tr>
                                        <tr>
                                            <td rowspan="2" class="text-center align-middle">9</td>
                                            <td rowspan="2" class="align-middle">Property Value as % of Sales Turnover with GFL (8/(4+5) x 100)</td>
                                            <td class="text-center">%</td>
                                            <td class="text-center">&gt;50</td><td class="text-center">&gt;40</td><td class="text-center">&gt;30</td><td class="text-center">&gt;20</td><td class="text-center">&gt;10</td>
                                            <td rowspan="2" class="align-middle"><div class="rv-val-box">@Figures.GsPropertyPercent().ToString("N2")%</div></td>
                                            <td rowspan="2" class="text-center align-middle"><div class="rv-mark-box">@CreditProposal.GQ9Mark</div></td>
                                        </tr>
                                        <tr><td class="text-center rv-muted">Marks</td><td class="text-center">10</td><td class="text-center">8</td><td class="text-center">6</td><td class="text-center">4</td><td class="text-center">2</td></tr>

                                        <tr>
                                            <td class="text-center align-middle">10</td>
                                            <td class="align-middle">Available Security (SD / FD / BG / Collateral)</td>
                                            <td rowspan="3" class="text-center align-middle rv-muted">Credit Security</td>
                                            <td rowspan="3" class="text-center align-middle">10</td>
                                            <td class="text-center">Rs. Lakhs</td>
                                            <td></td><td></td><td></td><td></td><td></td>
                                            <td class="align-middle"><div class="rv-val-box">@Figures.GsSecurityTotalValue().ToString("N2")</div></td>
                                            <td class="text-center align-middle rv-muted">-</td>
                                        </tr>
                                        <tr>
                                            <td rowspan="2" class="text-center align-middle">11</td>
                                            <td rowspan="2" class="align-middle">Available Security as % of Sales Turnover with GFL (10/(4+5) x 100)</td>
                                            <td class="text-center">%</td>
                                            <td class="text-center">&gt;10</td><td class="text-center">&gt;8</td><td class="text-center">&gt;6</td><td class="text-center">&gt;4</td><td class="text-center">&lt;4</td>
                                            <td rowspan="2" class="align-middle"><div class="rv-val-box">@Figures.GsSecurityPercent().ToString("N2")%</div></td>
                                            <td rowspan="2" class="text-center align-middle"><div class="rv-mark-box">@CreditProposal.GQ11Mark</div></td>
                                        </tr>
                                        <tr><td class="text-center rv-muted">Marks</td><td class="text-center">10</td><td class="text-center">8</td><td class="text-center">6</td><td class="text-center">4</td><td class="text-center">2</td></tr>
                                    </tbody>
                                   <tfoot>
                                        <tr>
                                            <td colspan="11"><strong>Grand Total</strong></td>
                                            <td class="text-center"><strong style="color:#059669;">@CreditProposal.GQ12Mark / 100</strong></td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>

                            <div class="credit-footer">
                                <h4 class="mb-1" style="font-size: 14px;">Greenstar — Recommended Credit Limit</h4>
                                <p class="credit-desc mb-3">Score: @CreditProposal.GQ12Mark.ToString("N0")/100.</p>
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <div class="credit-box">
                                            <div class="credit-box-label">Proposed Limit</div>
                                            <div class="credit-box-val">₹ @Figures.GetGflProposedLimit().ToString("N2")</div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="credit-box">
                                            <div class="credit-box-label">Additional Credit Limit</div>
                                            <div class="credit-box-val">₹ @CreditProposal.GreenstarAdditionalCreditLimit.ToString("N2")</div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="credit-box">
                                            <div class="credit-box-label">MO Recommended Credit Limit</div>
                                            <div class="credit-box-val">₹ @Figures.GetGflMoRecommendedLimit().ToString("N2")</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
