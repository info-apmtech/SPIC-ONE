                    @if (Dealer?.Status != DR.DealerStatus.InActive && CreditSales != null && CreditSales.Any())
                    {
                        <div class="col-12">
                            <div class="detail-card">
                                <div class="detail-card-header">
                                    <h4 class="detail-card-title"><i class="bi bi-graph-up"></i> Sales Performance</h4>
                                    <i class="bi bi-pencil-square edit-icon" @onclick="OnEdit" role="button" title="Edit"></i>
                                </div>
                                <div class="table-responsive">
                                    <table class="sales-table">
                                        <thead>
                                            <tr>
                                                <th>Product</th>
                                                <th>Category</th>
                                                <th>FY1 Qty</th>
                                                <th>FY1 Amount</th>
                                                <th>FY2 Qty</th>
                                                <th>FY2 Amount</th>
                                                <th>FY3 Qty</th>
                                                <th>FY3 Amount</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var s in CreditSales)
                                            {
                                                var pName = ProductNames.ContainsKey(s.ProductId) ? ProductNames[s.ProductId] : s.ProductId.ToString();
                                                var catName = Categories.FirstOrDefault(c => c.Id == s.CategoryId)?.Name ?? s.CategoryId.ToString();
                                                <tr>
                                                    <td>@pName</td>
                                                    <td>@catName</td>
                                                    <td>@s.FY1Qty.ToString("N2")</td>
                                                    <td>₹@s.FY1Amount.ToString("N2")</td>
                                                    <td>@s.FY2Qty.ToString("N2")</td>
                                                    <td>₹@s.FY2Amount.ToString("N2")</td>
                                                    <td>@s.FY3Qty.ToString("N2")</td>
                                                    <td>₹@s.FY3Amount.ToString("N2")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12">
                        <div class="detail-card">
                            <div class="detail-card-body">
                                <div class="data-row"><div class="data-label">Credit Limit Proposal</div><div class="data-value">No proposal data available</div></div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnToggle { get; set; }
    [Parameter] public EventCallback OnEdit { get; set; }

    [Parameter] public DR.DealerRegistration? Dealer { get; set; }
    [Parameter] public DR.DealerCreditLimitProposal? CreditProposal { get; set; }
    [Parameter] public List<DR.DealerCreditLimitSalesPerformance> CreditSales { get; set; } = new();
    [Parameter] public List<DR.Category> Categories { get; set; } = new();
    [Parameter] public Dictionary<int, string> ProductNames { get; set; } = new();
    [Parameter] public Dictionary<int, string> FinancialYearNames { get; set; } = new();
    [Parameter] public DealerReviewFigures Figures { get; set; } = default!;
    [Parameter] public int DataVersion { get; set; }
}
