                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td rowspan="2" class="text-center align-middle">1</td>
                                            <td rowspan="2" class="align-middle">Total Urea Sales Volume during last year</td>
                                            <td rowspan="8" class="text-center align-middle rv-muted" style="vertical-align:middle;">Fertilizer Business Involvement</td>
                                            <td rowspan="2" class="text-center align-middle">10</td>
                                            <td class="text-center">MT</td>
                                            <td class="text-center">&gt;3000</td><td class="text-center">&gt;1500</td><td class="text-center">&gt;1000</td><td class="text-center">&gt;500</td><td class="text-center">&lt;500</td>
                                            <td rowspan="2" class="align-middle"><div class="rv-val-box">@Figures.SpicAnnualUreaQty().ToString("N2")</div></td>
                                            <td rowspan="2" class="text-center align-middle"><div class="rv-mark-box">@CreditProposal.Q1Mark</div></td>
                                        </tr>
                                        <tr><td class="text-center rv-muted">Marks</td><td class="text-center">10</td><td class="text-center">8</td><td class="text-center">6</td><td class="text-center">4</td><td class="text-center">2</td></tr>

                                        <tr>
                                            <td rowspan="2" class="text-center align-middle">2</td>
                                            <td rowspan="2" class="align-middle">Urea Sales Volume with SPIC during last year</td>
                                            <td rowspan="2" class="text-center align-middle">10</td>
                                            <td class="text-center">MT</td>
                                            <td class="text-center">&gt;500</td><td class="text-center">&gt;300</td><td class="text-center">&gt;200</td><td class="text-center">&gt;100</td><td class="text-center">&lt;100</td>
                                            <td rowspan="2" class="align-middle"><div class="rv-val-box">@Figures.SpicPerfUreaQty().ToString("N2")</div></td>
                                            <td rowspan="2" class="text-center align-middle"><div class="rv-mark-box">@CreditProposal.Q2Mark</div></td>
                                        </tr>
                                        <tr><td class="text-center rv-muted">Marks</td><td class="text-center">10</td><td class="text-center">8</td><td class="text-center">6</td><td class="text-center">4</td><td class="text-center">2</td></tr>

                                        <tr>
                                            <td rowspan="2" class="text-center align-middle">3</td>
                                            <td rowspan="2" class="align-middle">Total Urea Sales Turnover during last year</td>
                                            <td rowspan="2" class="text-center align-middle">10</td>
                                            <td class="text-center">Rs. Lakhs</td>
                                            <td class="text-center">&gt;200</td><td class="text-center">&gt;100</td><td class="text-center">&gt;60</td><td class="text-center">&gt;30</td><td class="text-center">&lt;30</td>
