                                </div>
                            </div>
                        </div>
                    </div>
<div class="col-12">
                        <div class="detail-card">
                            <div class="detail-card-header">
                                <h4 class="detail-card-title"><i class="bi bi-clipboard-data"></i> SPIC Valuation</h4>
                                <i class="bi bi-pencil-square edit-icon" @onclick="OnEdit" role="button" title="Edit"></i>
                            </div>
