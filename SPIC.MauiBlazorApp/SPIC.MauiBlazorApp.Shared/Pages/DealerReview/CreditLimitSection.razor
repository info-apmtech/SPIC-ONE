                                        <tr>
                                            <td class="text-center align-middle">9</td>
                                            <td class="align-middle">Available Security (SD / FD / BG / Collateral)</td>
                                            <td rowspan="3" class="text-center align-middle rv-muted">Credit Security</td>
                                            <td rowspan="3" class="text-center align-middle">10</td>
                                            <td class="text-center">Rs. Lakhs</td>
                                            <td></td><td></td><td></td><td></td><td></td>
                                            <td class="align-middle"><div class="rv-val-box">@Figures.SpicSecurityTotalValue().ToString("N2")</div></td>
