@namespace SPIC.MauiBlazorApp.Shared.Pages.DealerReview
@using DR = SPIC.Core.Entities
@inherits DealerReviewSectionBase

@* "Companies Operating In Your Place" accordion: the selected-company pills. *@

    <div class="custom-accordion @(IsOpen ? "active" : "")">
        <div class="accordion-header" @onclick="OnToggle">
            Companies Operating In Your Place
            <i class="bi bi-chevron-down"></i>
        </div>
        <div class="accordion-body">
            <div class="detail-card">
                <div class="detail-card-header">
<h4 class="detail-card-title"><i class="bi bi-building"></i> Selected Companies</h4>
                                    <i class="bi bi-pencil-square edit-icon" @onclick="OnEdit" role="button" title="Edit"></i>
                </div>
                <div class="detail-card-body">
                    <div style="display: flex; gap: 12px; flex-wrap: wrap;">
                        @if (Companies != null && Companies.Any())
                        {
                            foreach (var c in Companies)
                            {
                                <div class="company-pill">@(!string.IsNullOrWhiteSpace(c.CompaniesOperating) ? c.CompaniesOperating : "Unknown")</div>
                            }
                        }
                        else
                        {
                            <div class="company-pill">None</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnToggle { get; set; }
    [Parameter] public EventCallback OnEdit { get; set; }

    [Parameter] public List<DR.DealerCompaniesOperatingInArea> Companies { get; set; } = new();
    [Parameter] public int DataVersion { get; set; }
}
