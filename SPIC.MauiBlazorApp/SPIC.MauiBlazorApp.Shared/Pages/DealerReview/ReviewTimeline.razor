@namespace SPIC.MauiBlazorApp.Shared.Pages.DealerReview
@inherits DealerReviewSectionBase

@*
    Horizontal Timeline strip. The page rebuilds the list as a NEW List instance whenever the
    approval history changes, so the reference comparison in DealerReviewSectionBase sees it.
*@

    <!-- Redesigned Horizontal Timeline View -->
    <div class="timeline-box">
        <h5 class="timeline-heading">Timeline</h5>

        <div class="timeline-scroll">
            @foreach (var item in Items)
            {
                <div class="timeline-col">
                    <div class="timeline-dot @item.DotClass">
                        @if (!string.IsNullOrEmpty(item.Icon))
                        {
                            <i class="@item.Icon"></i>
                        }
                    </div>

                    <div class="timeline-small-card @item.CardClass">
                        <div class="timeline-title-row">
                            <div class="timeline-title">@item.Title</div>
                            <i class="bi bi-eye text-primary" style="cursor:pointer;"></i>
                        </div>

                        <span class="timeline-status @item.BadgeClass">@item.Status</span>

                        <div class="timeline-user">@item.UserName</div>

                        <div class="timeline-date">
                            <i class="bi bi-calendar-event me-1"></i>
                            @item.DateText
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

@code {
    /// <summary>Timeline cards, newest last. A new list instance means "rebuilt, please render".</summary>
    [Parameter] public List<TimelineItem> Items { get; set; } = new();
}
