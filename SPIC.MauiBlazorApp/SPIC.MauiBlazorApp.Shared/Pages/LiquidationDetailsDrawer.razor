@using SPIC.Core.DTOs
@inject IJSRuntime JS

@if (IsOpen && Row is not null)
{
    <div class="ldd-overlay" @onclick="CloseDrawer">
        <div class="ldd-drawer" @onclick:stopPropagation="true">
            
            <div class="ldd-header">
                <div class="ldd-header-titles">
                    <h2>Liquidation Details</h2>
                    <div class="ldd-status-badge @BadgeBgClass()">
                        <div class="ldd-dot"></div>
                        @Row.Status
                    </div>
                </div>
                <button class="ldd-close-icon" @onclick="CloseDrawer">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="1.5"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
                </button>
            </div>

            <div class="ldd-body">
                <div class="ldd-section">
                    <h3>Dealer Information</h3>
                    <div class="ldd-row"><span class="ldd-label">Dealer Name</span><span class="ldd-value"><span class="ldd-colon">:</span> @Row.DealerName</span></div>
                    <div class="ldd-row"><span class="ldd-label">Dealer Code</span><span class="ldd-value"><span class="ldd-colon">:</span> @Row.DealerCode</span></div>
                    <div class="ldd-row"><span class="ldd-label">Dealer Type</span><span class="ldd-value"><span class="ldd-colon">:</span> @Row.DealerType</span></div>
                    <div class="ldd-row"><span class="ldd-label">Channel</span><span class="ldd-value"><span class="ldd-colon">:</span> <div class="ldd-outline-badge ldd-outline-blue">@(Row.Source == "Company Sales" ? "Company" : "Wholesaler")</div></span></div>
                    <div class="ldd-row">
                        <span class="ldd-label">Mobile No.</span>
                        <span class="ldd-value ldd-val-flex">
                            <span class="ldd-colon">:</span> @(string.IsNullOrWhiteSpace(Row.MobileNo) ? "-" : Row.MobileNo)
                            @if (!string.IsNullOrWhiteSpace(Row.MobileNo))
                            {
                                <span class="ldd-contact-actions">
                                    <button class="ldd-contact-btn ldd-wa" title="WhatsApp" @onclick="() => OpenWhatsApp(Row.MobileNo)">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
                                    </button>
                                    <button class="ldd-contact-btn ldd-call" title="Call" @onclick="() => Call(Row.MobileNo)">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                                    </button>
                                    <button class="ldd-contact-btn ldd-sms" title="SMS" @onclick="() => SendSms(Row.MobileNo)">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                                    </button>
                                </span>
                            }
                        </span>
                    </div>
                </div>

                <div class="ldd-section">
                    <h3>Location Information</h3>
                    <div class="ldd-row"><span class="ldd-label">State</span><span class="ldd-value"><span class="ldd-colon">:</span> @Row.StateName</span></div>
                    <div class="ldd-row"><span class="ldd-label">District</span><span class="ldd-value"><span class="ldd-colon">:</span> @Row.District</span></div>
                </div>

                <div class="ldd-section">
                    <h3>Stock Information</h3>
                    <div class="ldd-row"><span class="ldd-label">Product</span><span class="ldd-value"><span class="ldd-colon">:</span> @Row.ProductName</span></div>
                    <div class="ldd-row"><span class="ldd-label">Stock (MT)</span><span class="ldd-value"><span class="ldd-colon">:</span> @Row.Stock.ToString("0.###")</span></div>
                    <div class="ldd-row"><span class="ldd-label">Sales (MT)</span><span class="ldd-value"><span class="ldd-colon">:</span> @Row.Sales.ToString("0.###")</span></div>
                </div>

                <div class="ldd-section">
                    <h3>Liquidation Information</h3>
                    <div class="ldd-row"><span class="ldd-label">Ageing (Days)</span><span class="ldd-value"><span class="ldd-colon">:</span> @Row.AgeingDays Days</span></div>
                </div>
            </div>

            <div class="ldd-footer">
                <button class="ldd-btn-solid" @onclick="CloseDrawer">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                    Close
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public LiqCycleRowDto? Row { get; set; }

    private async Task CloseDrawer()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(IsOpen);
    }

    private string BadgeBgClass() => Row?.Status switch
    {
        "Critical" => "ldd-st-red",
        "Monitoring" => "ldd-st-orange",
        "Active" => "ldd-st-green",
        _ => "ldd-st-green"
    };

    // ---- Contact actions (same convention as the other drawers) ----

    // Opens a WhatsApp chat. Indian 10-digit numbers get the 91 prefix; numbers
    // that already carry a country code are used as-is.
    private async Task OpenWhatsApp(string number)
    {
        var digits = new string((number ?? "").Where(char.IsDigit).ToArray());
        if (digits.Length == 0) return;

        var wa = digits.Length == 10 ? "91" + digits : digits;
        var msg = Uri.EscapeDataString(
            $"Liquidation Cycle\nDealer: {Row?.DealerName}\nState/District: {Row?.StateName} / {Row?.District}\n" +
            $"Product: {Row?.ProductName}\nStock: {Row?.Stock} MT  Sales: {Row?.Sales} MT\n" +
            $"Ageing: {Row?.AgeingDays} days  Status: {Row?.Status}");

        await JS.InvokeVoidAsync("open", $"https://wa.me/{wa}?text={msg}", "_blank");
    }

    // Opens the device dialer.
    private async Task Call(string number)
    {
        if (string.IsNullOrWhiteSpace(number)) return;
        await JS.InvokeVoidAsync("open", $"tel:{number}", "_self");
    }

    // Opens the device SMS composer.
    private async Task SendSms(string number)
    {
        if (string.IsNullOrWhiteSpace(number)) return;
        await JS.InvokeVoidAsync("open", $"sms:{number}", "_self");
    }
}
