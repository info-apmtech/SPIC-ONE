@if (IsOpen)
{
    <div class="ldd-overlay" @onclick="CloseDrawer">
        <div class="ldd-drawer" @onclick:stopPropagation="true">
            
            <!-- Drawer Header -->
            <div class="ldd-header">
                <div class="ldd-header-titles">
                    <h2>Liquidation Details</h2>
                    <div class="ldd-status-badge ldd-st-red">
                        <div class="ldd-dot"></div>
                        Critical
                    </div>
                </div>
                <button class="ldd-close-icon" @onclick="CloseDrawer" aria-label="Close">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="15" y1="9" x2="9" y2="15"></line>
                        <line x1="9" y1="9" x2="15" y2="15"></line>
                    </svg>
                </button>
            </div>

            <!-- Drawer Body -->
            <div class="ldd-body">
                
                <!-- Dealer Information -->
                <div class="ldd-section">
                    <h3>Dealer Information</h3>
                    <div class="ldd-row">
                        <span class="ldd-label">Dealer Name</span>
                        <span class="ldd-value"><span class="ldd-colon">:</span> Monsoon Agro Centre</span>
                    </div>
                    <div class="ldd-row">
                        <span class="ldd-label">Dealer ID</span>
                        <span class="ldd-value"><span class="ldd-colon">:</span> 223331</span>
                    </div>
                    <div class="ldd-row">
                        <span class="ldd-label">Mobile No.</span>
                        <span class="ldd-value"><span class="ldd-colon">:</span> 8765432109</span>
                    </div>
                </div>

                <!-- Location Information -->
                <div class="ldd-section">
                    <h3>Location Information</h3>
                    <div class="ldd-row">
                        <span class="ldd-label">State</span>
                        <span class="ldd-value"><span class="ldd-colon">:</span> Tamil Nadu</span>
                    </div>
                    <div class="ldd-row">
                        <span class="ldd-label">Head Quarters</span>
                        <span class="ldd-value"><span class="ldd-colon">:</span> Coimbatore</span>
                    </div>
                    <div class="ldd-row">
                        <span class="ldd-label">District</span>
                        <span class="ldd-value"><span class="ldd-colon">:</span> Coimbatore</span>
                    </div>
                    <div class="ldd-row">
                        <span class="ldd-label">Sub-District</span>
                        <span class="ldd-value"><span class="ldd-colon">:</span> Sulur</span>
                    </div>
                </div>

                <!-- Stock Information -->
                <div class="ldd-section">
                    <h3>Stock Information</h3>
                    <div class="ldd-row">
                        <span class="ldd-label">Stock (MT)</span>
                        <span class="ldd-value"><span class="ldd-colon">:</span> 15.3</span>
                    </div>
                    <div class="ldd-row">
                        <span class="ldd-label">Sales (MT)</span>
                        <span class="ldd-value"><span class="ldd-colon">:</span> 2.1</span>
                    </div>
                </div>

                <!-- Liquidation Information -->
                <div class="ldd-section">
                    <h3>Liquidation Information</h3>
                    <div class="ldd-row align-items-center">
                        <span class="ldd-label">Liquidation Status</span>
                        <span class="ldd-value ldd-val-flex">
                            <span class="ldd-colon">:</span> 
                            <div class="ldd-outline-badge ldd-outline-blue">
                                Under Review
                            </div>
                        </span>
                    </div>
                    <div class="ldd-row">
                        <span class="ldd-label">Pending Ack Age (Days)</span>
                        <span class="ldd-value"><span class="ldd-colon">:</span> 18 Days</span>
                    </div>
                </div>

            </div>

            <!-- Drawer Footer -->
            <div class="ldd-footer">
                <button class="ldd-btn-solid" @onclick="CloseDrawer">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                    Close
                </button>
            </div>

        </div>
    </div>
}


@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    private async Task CloseDrawer()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(IsOpen);
    }
}