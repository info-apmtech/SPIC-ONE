@using SPIC.Core.DTOs

@if (IsOpen && Row is not null)
{
    <div class="ldd-overlay" @onclick="CloseDrawer">
        <div class="ldd-drawer" @onclick:stopPropagation="true">
            
            <div class="ldd-header">
                <div class="ldd-header-titles">
                    <h2>Liquidation Details</h2>
                    <div class="ldd-status-badge @BadgeBgClass()">
                        <div class="ldd-dot"></div>
                        @Row.Status
                    </div>
                </div>
                <button class="ldd-close-icon" @onclick="CloseDrawer">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="1.5"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
                </button>
            </div>

            <div class="ldd-body">
                <div class="ldd-section">
                    <h3>Dealer Information</h3>
                    <div class="ldd-row"><span class="ldd-label">Dealer Name</span><span class="ldd-value"><span class="ldd-colon">:</span> @Row.DealerName</span></div>
                    <div class="ldd-row"><span class="ldd-label">Dealer Code</span><span class="ldd-value"><span class="ldd-colon">:</span> @Row.DealerCode</span></div>
                    <div class="ldd-row"><span class="ldd-label">Dealer Type</span><span class="ldd-value"><span class="ldd-colon">:</span> @Row.DealerType</span></div>
                    <div class="ldd-row"><span class="ldd-label">Channel</span><span class="ldd-value"><span class="ldd-colon">:</span> <div class="ldd-outline-badge ldd-outline-blue">@(Row.Source == "Company Sales" ? "Company" : "Wholesaler")</div></span></div>
                    <div class="ldd-row"><span class="ldd-label">Mobile No.</span><span class="ldd-value"><span class="ldd-colon">:</span> @Row.MobileNo</span></div>
                </div>

                <div class="ldd-section">
                    <h3>Location Information</h3>
                    <div class="ldd-row"><span class="ldd-label">State</span><span class="ldd-value"><span class="ldd-colon">:</span> @Row.StateName</span></div>
                    <div class="ldd-row"><span class="ldd-label">District</span><span class="ldd-value"><span class="ldd-colon">:</span> @Row.District</span></div>
                </div>

                <div class="ldd-section">
                    <h3>Stock Information</h3>
                    <div class="ldd-row"><span class="ldd-label">Product</span><span class="ldd-value"><span class="ldd-colon">:</span> @Row.ProductName</span></div>
                    <div class="ldd-row"><span class="ldd-label">Stock (MT)</span><span class="ldd-value"><span class="ldd-colon">:</span> @Row.Stock.ToString("0.###")</span></div>
                    <div class="ldd-row"><span class="ldd-label">Sales (MT)</span><span class="ldd-value"><span class="ldd-colon">:</span> @Row.Sales.ToString("0.###")</span></div>
                </div>

                <div class="ldd-section">
                    <h3>Liquidation Information</h3>
                    <div class="ldd-row"><span class="ldd-label">Ageing (Days)</span><span class="ldd-value"><span class="ldd-colon">:</span> @Row.AgeingDays Days</span></div>
                </div>
            </div>

            <div class="ldd-footer">
                <button class="ldd-btn-solid" @onclick="CloseDrawer">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                    Close
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public LiqCycleRowDto? Row { get; set; }

    private async Task CloseDrawer()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(IsOpen);
    }

    private string BadgeBgClass() => Row?.Status switch
    {
        "Critical" => "ldd-st-red",
        "Monitoring" => "ldd-st-orange",
        "Active" => "ldd-st-green",
        _ => "ldd-st-green"
    };
}