@if (IsOpen)
{
    <div class="dd-overlay" @onclick="CloseDrawer">
        <div class="dd-drawer" @onclick:stopPropagation="true">
            
            <!-- Drawer Header (Sticky) -->
            <div class="dd-header">
                <button class="dd-back-btn" @onclick="CloseDrawer">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#111827" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="19" y1="12" x2="5" y2="12"></line>
                        <polyline points="12 19 5 12 12 5"></polyline>
                    </svg>
                </button>
                <div class="dd-header-text">
                    <h2>Dealer Details</h2>
                    <p>Complete Information About The Participating dealer</p>
                </div>
            </div>

            <!-- Drawer Body -->
            <div class="dd-body">
                
                <!-- Top Info Grid -->
                <div class="dd-info-grid">
                    <!-- Name Card -->
                    <div class="dd-info-card">
                        <div class="dd-avatar-wrapper">
                            <img src="_content/SPIC.MauiBlazorApp.Shared/Images/Schemes/img_image_93.png" alt="Avatar" class="dd-avatar-img" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
                            <!-- Fallback SVG if image fails -->
                            <svg class="dd-avatar-fallback" style="display:none;" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <rect width="36" height="36" rx="8" fill="#e2e8f0"/>
                                <circle cx="18" cy="13" r="6" fill="#9ca3af"/>
                                <path d="M8 29c0-6 4-10 10-10s10 4 10 10" stroke="#9ca3af" stroke-width="2" stroke-linecap="round"/>
                            </svg>
                        </div>
                        <div class="dd-info-text">
                            <span class="dd-label">Name</span>
                            <span class="dd-value dd-text-green">Rajesh Kumar</span>
                        </div>
                    </div>

                    <!-- User Type Card -->
                    <div class="dd-info-card">
                        <div class="dd-icon-box dd-bg-purple-light">
                            <img src="_content/SPIC.MauiBlazorApp.Shared/Images/Schemes/DealerMark.png" alt="Dealer" class="dd-box-img" />
                        </div>
                        <div class="dd-info-text">
                            <span class="dd-label">User Type</span>
                            <span class="dd-value dd-text-green">Dealer</span>
                        </div>
                    </div>
                </div>

                <!-- Location Card -->
                <div class="dd-info-card dd-full-width">
                    <div class="dd-icon-box dd-bg-green-light">
                        <img src="_content/SPIC.MauiBlazorApp.Shared/Images/Schemes/Location.png" alt="Location" class="dd-box-img" />
                    </div>
                    <div class="dd-info-text">
                        <span class="dd-label">Location</span>
                        <span class="dd-value dd-text-green">1 May 2026</span>
                    </div>
                </div>

                <!-- Section Title -->
                <div class="dd-section-title">
                    <img src="_content/SPIC.MauiBlazorApp.Shared/Images/Schemes/Settings.png" alt="Metrics Settings" class="dd-section-icon" />
                    <h3>Performance Metrics</h3>
                </div>

                <!-- Metric Card: Total Points (Blue) -->
                <div class="dd-metric-card dd-card-blue">
                    <div class="dd-metric-header">
                        <div class="dd-metric-header-left">
                            <div class="dd-icon-box dd-bg-blue">
                                <img src="_content/SPIC.MauiBlazorApp.Shared/Images/Schemes/Handstar.png" alt="Points" class="dd-box-img" />
                            </div>
                            <span class="dd-metric-title dd-title-blue">Total Points</span>
                        </div>
                        <span class="dd-metric-value dd-value-blue">780</span>
                    </div>
                    <p class="dd-metric-desc">Points accumulated through purchase and activities</p>
                </div>

                <!-- Metric Card: Lucky Draw Entries (Purple) -->
                <div class="dd-metric-card dd-card-purple">
                    <div class="dd-metric-header">
                        <div class="dd-metric-header-left">
                            <div class="dd-icon-box dd-bg-purple">
                                <img src="_content/SPIC.MauiBlazorApp.Shared/Images/Schemes/Ticket.png" alt="Ticket" class="dd-box-img" />
                            </div>
                            <span class="dd-metric-title dd-title-purple">Lucky Draw Entries</span>
                        </div>
                        <span class="dd-metric-value dd-value-purple">26</span>
                    </div>
                    <p class="dd-metric-desc">Total number of entries you have</p>
                </div>

                <!-- Metric Card: Participating Status (Green) -->
                <div class="dd-metric-card dd-card-green">
                    <div class="dd-metric-header">
                        <div class="dd-metric-header-left">
                            <div class="dd-icon-box dd-bg-green">
                                <img src="_content/SPIC.MauiBlazorApp.Shared/Images/Schemes/spacelinecircle.png" alt="Status" class="dd-box-img" />
                            </div>
                            <span class="dd-metric-title dd-title-green">Participating Status</span>
                        </div>
                        <span class="dd-badge-eligible">Eligible</span>
                    </div>
                    <p class="dd-metric-desc">Points accumulated through purchase and activities</p>
                </div>

                <!-- Scheme Participation Box -->
                <div class="dd-participation-card">
                    <h4>Scheme Participation</h4>
                    <div class="dd-participation-grid">
                        <div class="dd-part-item">
                            <span class="dd-part-label">Entry Ratio</span>
                            <span class="dd-part-value">26.0:1</span>
                        </div>
                        <div class="dd-part-item">
                            <span class="dd-part-label">Win Probability</span>
                            <span class="dd-part-value">0.29%</span>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
}


@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    private async Task CloseDrawer()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(IsOpen);
    }
}