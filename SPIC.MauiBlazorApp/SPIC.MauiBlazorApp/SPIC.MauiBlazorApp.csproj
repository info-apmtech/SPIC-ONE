<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

    <!-- Allow building with newer Xcode versions than current .NET workload target -->
    <ValidateXcodeVersion>false</ValidateXcodeVersion>

    <!-- Note for MacCatalyst:
      The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
      When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
      The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
      either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
    <!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

    <OutputType>Exe</OutputType>
    <RootNamespace>SPIC.MauiBlazorApp</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
    <Nullable>enable</Nullable>

    <!-- Enable XAML source generation for faster build times and improved performance.
         This generates C# code from XAML at compile time instead of runtime inflation.
         To disable, remove this line.
         For individual files, you can override by setting Inflator metadata:
           <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
           <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
    <MauiXamlInflator Condition="'$(Configuration)' != 'Release'">SourceGen</MauiXamlInflator>

    <!-- Display name -->
    <ApplicationTitle>SPIC ONE</ApplicationTitle>

    <!-- App Identifier -->
    <ApplicationId>com.apmiot.spicone</ApplicationId>
  </PropertyGroup>

  <!-- ===== App Versions ===== -->
  <!-- DEFAULT: Used for macOS/Windows/other platforms -->
  <PropertyGroup>
    <ApplicationDisplayVersion>1.4.0</ApplicationDisplayVersion>
    <ApplicationVersion>7</ApplicationVersion>

    <!-- NuGet/VS project-info evaluation (e.g. Solution Explorer, restore) reads PackageVersion
         without pinning a TargetFramework, and the MAUI SDK otherwise derives it from
         ApplicationDisplayVersion above - which the platform-specific PropertyGroups below
         deliberately override per-TFM (Android/iOS ship on their own store version cadence). An
         unconditioned, TFM-independent value here is what that cross-targeting evaluation needs;
         it has no effect on what's actually embedded in an Android APK or iOS IPA. -->
    <PackageVersion>1.4.0</PackageVersion>
  </PropertyGroup>

  <!-- ANDROID: Version 1.4 (Build 6) - Google Play Store -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <ApplicationDisplayVersion>1.4</ApplicationDisplayVersion>
    <ApplicationVersion>6</ApplicationVersion>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidUseAapt2>true</AndroidUseAapt2>
  </PropertyGroup>

  <!-- iOS: Version 1.4.0 (Build 8) - Apple App Store -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <ApplicationDisplayVersion>1.4.0</ApplicationDisplayVersion>
    <ApplicationVersion>8</ApplicationVersion>
  </PropertyGroup>

  <!-- iOS Release: Ad Hoc Distribution for Device Testing (default) -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' And '$(ForAppStore)' != 'true'">
    <CodesignProvision>SPICONEADHOC</CodesignProvision>
    <CodesignKey>Apple Distribution: APM TECHNOLOGIES SOLUTIONS PRIVATE LIMITED (L9DG68JHYP)</CodesignKey>
    <CodesignRequireProvisioningProfile>true</CodesignRequireProvisioningProfile>
  </PropertyGroup>

  <!-- iOS Release: App Store Distribution -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' And '$(ForAppStore)' == 'true'">
    <CodesignProvision>SPIC ONE App Store</CodesignProvision>
    <CodesignKey>Apple Distribution: APM TECHNOLOGIES SOLUTIONS PRIVATE LIMITED (L9DG68JHYP)</CodesignKey>
    <CodesignRequireProvisioningProfile>true</CodesignRequireProvisioningProfile>
  </PropertyGroup>

  <!-- ===== Platform-Specific Settings ===== -->
  <PropertyGroup>
    <!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
	  <WindowsPackageType>MSIX</WindowsPackageType>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">17.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <ItemGroup>

    <!-- Splash Screen -->
    <MauiSplashScreen Include="Resources\Splash\splash.png" Color="#0b6b3a" BaseSize="160,160" />

    <!-- Images -->
    <MauiImage Include="Resources\Images\*" />

    <!-- Custom Fonts -->
    <MauiFont Include="Resources\Fonts\*" />

    <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SPIC.MauiBlazorApp.Shared\SPIC.MauiBlazorApp.Shared.csproj" />
  </ItemGroup>

  <!-- API address. Override per environment at build time:
         dotnet publish ... -p:SpicApiBaseUrl=https://previewspicapi.apmiot.com/
       MauiProgram reads it back from the AssemblyMetadata attribute below. -->
  <PropertyGroup>
    <SpicApiBaseUrl Condition="'$(SpicApiBaseUrl)' == ''">https://api.spicone.in/</SpicApiBaseUrl>
  </PropertyGroup>
	<!-- Preview / Testing API -->
	<!-- <PropertyGroup>
		<SpicApiBaseUrl Condition="'$(SpicApiBaseUrl)' == ''">https://previewspicapi.apmiot.com/</SpicApiBaseUrl>
	</PropertyGroup> -->
	 <!--Local testing (uncomment when debugging against local SpicAPI):-->
	<!--<PropertyGroup>
		<SpicApiBaseUrl Condition="'$(SpicApiBaseUrl)' == ''">http://localhost:7032/</SpicApiBaseUrl>
	</PropertyGroup>-->
	
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SpicApiBaseUrl</_Parameter1>
      <_Parameter2>$(SpicApiBaseUrl)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>


  <!-- ===== Store publishing =====
       Android: Release builds produce an .aab (what Google Play requires). Signing is
       switched on only when the keystore variables are present in the environment, so a
       plain developer build never needs the keystore. See docs/store-publishing.md. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <AndroidPackageFormats>aab</AndroidPackageFormats>
    <AndroidUseAapt2>true</AndroidUseAapt2>
    <AndroidLinkTool>r8</AndroidLinkTool>
    <AndroidEnableProguard>true</AndroidEnableProguard>
  </PropertyGroup>
  <PropertyGroup Condition="'$(SPICONE_ANDROID_KEYSTORE)' != '' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(SPICONE_ANDROID_KEYSTORE)</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>$(SPICONE_ANDROID_KEY_ALIAS)</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass>$(SPICONE_ANDROID_KEY_PASS)</AndroidSigningKeyPass>
    <AndroidSigningStorePass>$(SPICONE_ANDROID_STORE_PASS)</AndroidSigningStorePass>
  </PropertyGroup>

  <!-- iOS: SecureStorage uses the Keychain, which needs the keychain-access-groups entitlement. -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <CodesignEntitlements>Platforms/iOS/Entitlements.plist</CodesignEntitlements>
    <CodesignKey Condition="'$(RuntimeIdentifier)' == 'ios-arm64'">Apple Development</CodesignKey>
    <!-- For Release builds, allow automatic provisioning profile selection -->
    <CodesignProvision Condition="'$(RuntimeIdentifier)' == 'ios-arm64' And '$(Configuration)' != 'Release'">SPICONE</CodesignProvision>
    <CodesignRequireProvisioningProfile Condition="'$(RuntimeIdentifier)' == 'ios-arm64' And '$(Configuration)' != 'Release'">true</CodesignRequireProvisioningProfile>
    <CodesignRequireProvisioningProfile Condition="'$(RuntimeIdentifier)' == 'ios-arm64' And '$(Configuration)' == 'Release'">false</CodesignRequireProvisioningProfile>
    <CodesignRequireProvisioningProfile Condition="'$(RuntimeIdentifier)' != 'ios-arm64' And '$(Configuration)' != 'Release'">false</CodesignRequireProvisioningProfile>
    <_MlaunchWaitForExit Condition="'$(_MlaunchWaitForExit)' == ''">false</_MlaunchWaitForExit>
  </PropertyGroup>

  <!-- iOS Release configuration:
       - UseInterpreter=true: avoids strict AOT traps on reflection/Blazor/serializers on physical iOS devices
       - MtouchInterpreter=all: instructs the Mono runtime to interpret assemblies without hitting invalid AOT stubs
       - UseLlvm=false: disables LLVM code generation that triggers SIGABRT / stack check failure on .NET iOS startup
       - MtouchLink=SdkOnly: ensures SDK assemblies are linked without stripping application logic
       - _ExportSymbolsExplicitly=true: prevents Apple linker from stripping runtime entry points
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <UseInterpreter>true</UseInterpreter>
    <MtouchInterpreter>all</MtouchInterpreter>
    <UseLlvm>false</UseLlvm>
    <MtouchLink>None</MtouchLink>
    <_ExportSymbolsExplicitly>true</_ExportSymbolsExplicitly>
  </PropertyGroup>

</Project>
