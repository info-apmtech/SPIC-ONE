<?xml version="1.0" encoding="utf-8"?>
<!--
  Production traffic is HTTPS (api.spicone.in) and stays HTTPS: cleartext is permitted ONLY for
  localhost so a Debug build can talk to a developer's API through `adb reverse tcp:PORT tcp:PORT`
  (build with -p:SpicApiBaseUrl=http://localhost:PORT/). No other host is affected.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
