<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" android:versionCode="8" android:versionName="1.6">
	<!-- enableOnBackInvokedCallback=false: forces the legacy Activity.OnBackPressed() dispatch path
	     instead of Android 13+'s predictive-back/OnBackInvokedCallback system. MainActivity's own
	     OnBackPressed() override (see its doc comment) is what routes the hardware/gesture back
	     button through NavHistoryService's app-wide back-stack - predictive back bypasses that
	     override entirely on OS versions/skins that enable it by default, which is the most likely
	     reason the back gesture kept closing the app outright even after that override was in place. -->
	<application android:allowBackup="false" android:icon="@mipmap/appicon" android:supportsRtl="true" android:networkSecurityConfig="@xml/network_security_config" android:enableOnBackInvokedCallback="false" />
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
	<uses-permission android:name="android.permission.INTERNET" />
	<uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
	<uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
	<!-- JMDO Live Tracking (background): ACCESS_BACKGROUND_LOCATION must be requested at runtime
	     SEPARATELY from, and after, ACCESS_FINE_LOCATION on Android 10+ - see
	     JmdoTrackingForegroundService's own doc comment and DeviceInterop.RequestBackgroundLocationPermission. -->
	<uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
	<!-- Android 13+ requires this to show the "Live Tracking active" persistent notification. -->
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
	<!-- Battery optimization exemption prompt (DeviceInterop.StartBackgroundTracking) - mitigates
	     Doze/App Standby throttling background GPS delivery regardless of the configured interval. -->
	<uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
	<!-- Farmer leaf check "Take a photo" (recheck fix U2, Services/MauiCamera.cs): MediaPicker.CapturePhotoAsync. The
	     camera is optional so phones without one still install the app (they use "Choose from gallery"). -->
	<uses-permission android:name="android.permission.CAMERA" />
	<!-- Recheck residual N1: below Android 13 MediaPicker.CapturePhotoAsync also demands StorageWrite (MauiCamera asks
	     for it there); not used from Android 13 on. -->
	<uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
	<uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
	<uses-feature android:name="android.hardware.camera" android:required="false" />
	<queries>
		<intent>
			<action android:name="android.media.action.IMAGE_CAPTURE" />
		</intent>
	</queries>
</manifest>