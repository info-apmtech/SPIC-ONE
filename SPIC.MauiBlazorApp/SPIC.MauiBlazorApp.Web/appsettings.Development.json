{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // Development-only override: appsettings.json's ApiBaseUrl points at the shared staging server
  // (previewspicapi.apmiot.com), which doesn't have brand-new, not-yet-deployed local backend code
  // (e.g. GpsSettingController) - ASP.NET Core layers this file over appsettings.json, so this only
  // takes effect when ASPNETCORE_ENVIRONMENT=Development (the "https"/"http" launch profiles both
  // set this), never in a real deployment.
  "ApiBaseUrl": "https://localhost:7032/"
}
