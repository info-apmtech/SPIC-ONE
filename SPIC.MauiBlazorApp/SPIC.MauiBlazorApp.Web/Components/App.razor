    <script src="@Assets["_framework/blazor.web.js"]" autostart="false"></script>
    <script>
        Blazor.start({
            circuit: {
                // Keep trying to rejoin for 30 minutes (360 x 5 s), matching the server's
                // DisconnectedCircuitRetentionPeriod, instead of giving up after a few tries.
                reconnectionOptions: {
                    maxRetries: 360,
                    retryIntervalMilliseconds: 5000
                },
                configureSignalR: function (builder) {
                    builder
                        .withServerTimeout(100000)
                        .withKeepAliveInterval(15000);
                }
            }
        });
    </script>
