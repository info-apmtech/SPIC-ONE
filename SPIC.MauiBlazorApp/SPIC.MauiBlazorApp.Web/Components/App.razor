<body>
    @* No prerendering: a prerendered <EditForm> can be submitted as a plain HTML POST before the
       circuit is connected, which the server answers with 400. Rendering only once interactive
       makes every form go through the circuit. *@
    <Routes @rendermode="new InteractiveServerRenderMode(prerender: false)" />
    <ReconnectModal />

