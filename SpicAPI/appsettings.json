  // Shared secrets for the IFMS automation. Both must be set before the phone
  // relay or the automation notifications will be accepted; an empty value
  // means "reject everything", which is the safe default.
  //
  // Set them in production with environment variables rather than here:
  //   IfmsAutomation__DeviceKey     the SPIC Android app pairing key
  //   IfmsAutomation__AutomationKey the SPIC.Ifms.Automation service key
  "IfmsAutomation": {
    "DeviceKey": "rMRet2g/LWXibsLLV0CxLv4INMSfM6v/DoBqDjna2fo=",
    "AutomationKey": "TttxLZ5w/8gUQpvqYAPQkhY+g2yyX7w1w1Xxx77yOVE="
  },

  // SPIC AI (Digital Library assistant). Leave AnthropicApiKey empty here: in Azure
  // it is supplied as the environment variable Assistant__AnthropicApiKey from Key
  // Vault. Empty key = the offline keyword provider answers.
  "Sas": {
    "UpiId": "spic.pay@okicici",
    "MerchantName": "SPIC Sample Collection",
    "Lab": {
      "DelayedAfterDays": 5,
      "LabName": "SPIC Soil & Water Testing Laboratory",
      "ReportLanguages": [ "en", "ta", "te", "mr" ],
      "FarmerReportLanguages": [ "en", "ta" ],
      "ReportHeader": {
        "Title": "SPIC AGRICULTURE SERVICES",
        "AddressLine": "SPIC Ltd, Muthaiyahpuram, Tuticorin - 628005.",
        "PhoneLine": "Phone : 235 6222, Cell : 83000 26080",
        "CustomerCare": "Customer Service Centre: 044 230 0010",
        "SoilSignatory": "OFFICER, SPIC AGRICULTURE SERVICES",
        "WaterSignatory": "AUTHORIZED SIGNATORY, SPIC SOIL TESTING LAB"
      },
      // Fertilizer schedule of the soil report (phase 2b, LabFertilizerSchedule): each product's
      // KgPerAcre (LabCropRecommendation, per crop; crop "General" when the crop has no rows) is
      // multiplied by the factor of the sample's status for the product's nutrient, rounded to
      // 2 decimals. A product with several nutrients ("N,P") takes the highest factor.
      "DoseFactors": {
        "Deficient": 1.25,
        "Moderate": 1.10,
        "Normal": 1.00,
        "Excess": 0.75,
        "NotTested": 1.00
      },
      // Nutrient code (LabCropRecommendation.Nutrient) -> LabParameter.Code whose status is used.
      "NutrientParameters": {
        "N": "S-N",
        "P": "S-P",
        "K": "S-K",
        "Zn": "S-ZN",
        "Fe": "S-FE",
        "Mn": "S-MN",
        "Cu": "S-CU",
        "S": "S-S",
        "B": "S-B",
        "Organic": "S-OC",
        "Gypsum": "S-PH"
      },
      // Nutrients with their own factors (missing statuses fall back to DoseFactors). Organic
      // products are raised only for low organic carbon; gypsum is raised for alkaline soil and
      // not required (factor 0) for acidic soil.
      "NutrientDoseFactors": {
        "Organic": { "Deficient": 1.25, "Moderate": 1.00, "Normal": 1.00, "Excess": 1.00, "NotTested": 1.00 },
        "Gypsum": { "Deficient": 0.00, "Moderate": 1.00, "Normal": 1.00, "Excess": 1.25, "NotTested": 1.00 }
      }
    }
  },
  "Assistant": {
    "AnthropicApiKey": "",
    "Model": "claude-sonnet-5",
    "MaxTokens": 800
  },

  // SDWA Guest House online payment (Razorpay). Leave both empty here: in Azure they
  // are supplied as the environment variables Razorpay__KeyId and Razorpay__KeySecret
  // (Key Vault secrets). KeyId is not secret (it is sent to the client to open
  // Checkout) but is kept out of source control the same way. An empty KeySecret
  // means online payment is unavailable and "Pay After Stay" remains the only option.
  "Razorpay": {
    "KeyId": "rzp_live_xoXvRXaawK65z1",
    "KeySecret": "y44AOMXPhJUQFrh8kXBbA3zi"
  },

  // How long a PendingPayment Guest House booking (created the moment the customer
  // reaches the Payment page, before Razorpay Checkout even opens) continues to hold
  // its room slot in the availability calculation. After this many minutes without a
  // verified payment, the room becomes bookable by another customer again. Shared by
  // GuestHouseBookingController and GuestHouseFrontOfficeController - see
  // GuestHouseBookingOptions.
  "GuestHouseBooking": {
    "PendingPaymentHoldMinutes": 15
  },

  // Metrics & error telemetry (docs/metrics-telemetry-plan.md). IngestKey stays empty here: in Azure
  // it is the environment variable Telemetry__IngestKey (Key Vault secret telemetry-ingest-key),
  // shared with the web host so its logger provider can post server-attributed errors.
  "Telemetry": {
    "Enabled": true,
    "IngestKey": "",
    "Retention": {
      "RequestDays": 30,
      "PageViewDays": 30,
      "ErrorDays": 90,
      "DailyDays": 400
    },
    "ExcludePaths": [ "/health", "/swagger", "/" ],
    "MinimumLogLevel": "Error",
    "RollupMinutes": 15,
    "ChannelCapacity": 10000
  },

  "Jwt": {
    "Key": "{r;L>g8eBL6NO%5It&n?V3eG6F@Lvpaz",
    "Issuer": "SPIC_API",
    "Audience": "SPIC_API_USERS",
    "ExpiryMinutes": 60,
    "RefreshExpiryDays": 2
  },

