<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SPIC.RegressionHarness</RootNamespace>
    <!--
      A dependency-free runner rather than xUnit: the offline package cache for this
      machine has no test framework, and these checks only need to assert behaviour of
      pure logic. Exits non-zero on the first failing expectation so it can gate a build.
    -->
    <NoWarn>$(NoWarn);NU1901;NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SPIC.Core\SPIC.Core.csproj" />
    <ProjectReference Include="..\Spic.Infrastructure\Spic.Infrastructure.csproj" />
  </ItemGroup>

</Project>
