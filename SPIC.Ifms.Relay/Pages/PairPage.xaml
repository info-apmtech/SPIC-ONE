<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SPIC.Ifms.Relay.Pages.PairPage"
             Title="Pair">

	<ScrollView>
		<VerticalStackLayout Padding="16,16,16,32" Spacing="0">

			<Label Text="Pair this phone" Style="{StaticResource Title}" />
			<Label Text="Pair the handset holding the IFMS SIM so it forwards the one-time password and alerts you if a CAPTCHA needs typing."
			       Style="{StaticResource Muted}"
			       Margin="0,4,0,16" />

			<Border Style="{StaticResource Card}">
				<VerticalStackLayout Spacing="12">
					<Label x:Name="PairTitle" Text="Pair this phone" Style="{StaticResource CardTitle}" />

					<VerticalStackLayout Spacing="4">
						<Label Text="API address" FontAttributes="Bold" FontSize="13" />
						<Entry x:Name="ApiBaseEntry"
						       Placeholder="https://spicapi.apmiot.com/"
						       Keyboard="Url"
						       IsSpellCheckEnabled="False"
						       IsTextPredictionEnabled="False" />
						<Label Text="The same server SPIC ONE talks to." Style="{StaticResource Hint}" />
					</VerticalStackLayout>

					<VerticalStackLayout Spacing="4">
						<Label Text="Device key" FontAttributes="Bold" FontSize="13" />
						<Entry x:Name="DeviceKeyEntry"
						       Placeholder="pairing key"
						       IsPassword="True" />
						<Label Text="Must match IfmsAutomation:DeviceKey on the server. It is used once to pair and is not kept on the phone."
						       Style="{StaticResource Hint}" />
					</VerticalStackLayout>

					<Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
						<Button x:Name="PairButton" Text="Pair" Clicked="OnPairClicked" />
						<Button x:Name="UnpairButton"
						        Grid.Column="1"
						        Text="Turn off"
						        Style="{StaticResource DangerButton}"
						        IsVisible="False"
						        Clicked="OnUnpairClicked" />
					</Grid>

					<Label x:Name="ResultLabel" IsVisible="False" />
				</VerticalStackLayout>
			</Border>

			<Border Style="{StaticResource Card}">
				<VerticalStackLayout Spacing="12">
					<Label Text="What leaves the phone" Style="{StaticResource CardTitle}" />

					<Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
						<VerticalStackLayout Spacing="2">
							<Label Text="Forward only IFMS messages" FontAttributes="Bold" />
							<Label Text="Only messages that mention IFMS, or come from an accepted sender, are sent to the server. Every other SMS stays on this phone and is never sent anywhere."
							       Style="{StaticResource Hint}" />
						</VerticalStackLayout>
						<Switch x:Name="ForwardOnlyIfmsSwitch"
						        Grid.Column="1"
						        VerticalOptions="Start"
						        Toggled="OnForwardOnlyToggled" />
					</Grid>

					<VerticalStackLayout Spacing="4">
						<Label Text="Accepted senders" FontAttributes="Bold" FontSize="13" />
						<Entry x:Name="AcceptedSendersEntry"
						       Placeholder="7305430555"
						       Keyboard="Telephone"
						       Unfocused="OnAcceptedSendersChanged"
						       Completed="OnAcceptedSendersChanged" />
						<Label Text="Numbers separated by commas. +91 and spaces are ignored when comparing."
						       Style="{StaticResource Hint}" />
					</VerticalStackLayout>

					<Label x:Name="FilterSavedLabel" IsVisible="False" TextColor="{StaticResource Good}" FontSize="12" />
				</VerticalStackLayout>
			</Border>

			<Border Style="{StaticResource Card}" BackgroundColor="{StaticResource NoteBackground}">
				<Label Text="Android asks for SMS and notification permission when you pair. The relay only forwards messages while it is switched on here, and Turn off stops it immediately." />
			</Border>

		</VerticalStackLayout>
	</ScrollView>
</ContentPage>
