<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SPIC.Ifms.Relay.Pages.AlertsPage"
             Title="Alerts">

	<ScrollView>
		<VerticalStackLayout Padding="16,16,16,32" Spacing="0">

			<Label Text="Email alerts" Style="{StaticResource Title}" />
			<Label Text="Who gets told how last night went. Sent by the server, not by this phone."
			       Style="{StaticResource Muted}"
			       Margin="0,4,0,16" />

			<!-- Shown above the form when there is no token to talk to the server with. -->
			<Border x:Name="NotPairedCard"
			        Style="{StaticResource Card}"
			        BackgroundColor="{StaticResource NoteBackground}"
			        IsVisible="False">
				<Label Text="Not paired. Open the Pair tab to set this phone up."
				       TextColor="{StaticResource Warn}" />
			</Border>

			<VerticalStackLayout x:Name="Form" Spacing="0">

				<Border Style="{StaticResource Card}">
					<Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
						<VerticalStackLayout Spacing="2">
							<Label Text="Email alerts on" FontAttributes="Bold" />
							<Label Text="Off means the automation still runs but tells nobody by email."
							       Style="{StaticResource Hint}" />
						</VerticalStackLayout>
						<Switch x:Name="EmailEnabledSwitch"
						        AutomationId="EmailEnabledSwitch"
						        Grid.Column="1"
						        VerticalOptions="Start" />
					</Grid>
				</Border>

				<!-- Mail server -->
				<Border Style="{StaticResource Card}">
					<VerticalStackLayout Spacing="12">
						<Label Text="Mail server" Style="{StaticResource CardTitle}" />

						<VerticalStackLayout Spacing="4">
							<Label Text="SMTP host" FontAttributes="Bold" FontSize="13" />
							<Entry x:Name="SmtpHostEntry"
							       AutomationId="SmtpHostEntry"
							       Placeholder="smtp.office365.com"
							       Keyboard="Url"
							       IsSpellCheckEnabled="False"
							       IsTextPredictionEnabled="False" />
						</VerticalStackLayout>

						<VerticalStackLayout Spacing="4">
							<Label Text="Port" FontAttributes="Bold" FontSize="13" />
							<Entry x:Name="SmtpPortEntry"
							       AutomationId="SmtpPortEntry"
							       Placeholder="587"
							       Keyboard="Numeric"
							       MaxLength="5" />
						</VerticalStackLayout>

						<Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
							<VerticalStackLayout Spacing="2">
								<Label Text="Use STARTTLS" FontAttributes="Bold" />
								<Label Text="On for port 587. Off only for a server that wants plain or implicit TLS."
								       Style="{StaticResource Hint}" />
							</VerticalStackLayout>
							<Switch x:Name="UseStartTlsSwitch"
							        AutomationId="UseStartTlsSwitch"
							        Grid.Column="1"
							        VerticalOptions="Start"
							        IsToggled="True" />
						</Grid>

						<VerticalStackLayout Spacing="4">
							<Label Text="User name" FontAttributes="Bold" FontSize="13" />
							<Entry x:Name="UserNameEntry"
							       AutomationId="UserNameEntry"
							       Placeholder="alerts@example.com"
							       Keyboard="Email"
							       IsSpellCheckEnabled="False"
							       IsTextPredictionEnabled="False" />
						</VerticalStackLayout>

						<VerticalStackLayout Spacing="4">
							<Label Text="Password" FontAttributes="Bold" FontSize="13" />
							<Entry x:Name="PasswordEntry"
							       AutomationId="PasswordEntry"
							       Placeholder="leave blank to keep the saved one"
							       IsPassword="True" />
							<Label x:Name="PasswordStateLabel"
							       AutomationId="PasswordStateLabel"
							       Text="No password saved"
							       Style="{StaticResource Hint}" />
						</VerticalStackLayout>
					</VerticalStackLayout>
				</Border>

				<!-- Sender -->
				<Border Style="{StaticResource Card}">
					<VerticalStackLayout Spacing="12">
						<Label Text="Sender" Style="{StaticResource CardTitle}" />

						<VerticalStackLayout Spacing="4">
							<Label Text="From address" FontAttributes="Bold" FontSize="13" />
							<Entry x:Name="FromAddressEntry"
							       AutomationId="FromAddressEntry"
							       Placeholder="alerts@example.com"
							       Keyboard="Email"
							       IsSpellCheckEnabled="False"
							       IsTextPredictionEnabled="False" />
						</VerticalStackLayout>

						<VerticalStackLayout Spacing="4">
							<Label Text="From name" FontAttributes="Bold" FontSize="13" />
							<Entry x:Name="FromNameEntry"
							       AutomationId="FromNameEntry"
							       Placeholder="SPIC IFMS automation" />
						</VerticalStackLayout>
					</VerticalStackLayout>
				</Border>

				<!-- Recipients -->
				<Border Style="{StaticResource Card}">
					<VerticalStackLayout Spacing="12">
						<Label Text="Recipients" Style="{StaticResource CardTitle}" />

						<VerticalStackLayout Spacing="4">
							<Label Text="To addresses" FontAttributes="Bold" FontSize="13" />
							<Editor x:Name="ToAddressesEditor"
							        AutomationId="ToAddressesEditor"
							        Placeholder="one per line, or separated by ; or ,"
							        Keyboard="Email"
							        AutoSize="TextChanges" />
							<Label Text="One per line, or separated by ; or ," Style="{StaticResource Hint}" />
						</VerticalStackLayout>

						<VerticalStackLayout Spacing="4">
							<Label Text="Cc addresses" FontAttributes="Bold" FontSize="13" />
							<Editor x:Name="CcAddressesEditor"
							        AutomationId="CcAddressesEditor"
							        Placeholder="optional"
							        Keyboard="Email"
							        AutoSize="TextChanges" />
						</VerticalStackLayout>
					</VerticalStackLayout>
				</Border>

				<!-- When -->
				<Border Style="{StaticResource Card}">
					<VerticalStackLayout Spacing="12">
						<Label Text="When" Style="{StaticResource CardTitle}" />

						<Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
							<VerticalStackLayout Spacing="2">
								<Label Text="Failures only" FontAttributes="Bold" />
								<Label Text="Stay quiet when every report downloaded and imported."
								       Style="{StaticResource Hint}" />
							</VerticalStackLayout>
							<Switch x:Name="FailuresOnlySwitch"
							        AutomationId="FailuresOnlySwitch"
							        Grid.Column="1"
							        VerticalOptions="Start" />
						</Grid>

						<Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
							<VerticalStackLayout Spacing="2">
								<Label Text="Attach the downloaded reports" FontAttributes="Bold" />
								<Label Text="Adds the night's files to the email. Larger, but nobody has to sign in to see them."
								       Style="{StaticResource Hint}" />
							</VerticalStackLayout>
							<Switch x:Name="AttachReportsSwitch"
							        AutomationId="AttachReportsSwitch"
							        Grid.Column="1"
							        VerticalOptions="Start" />
						</Grid>
					</VerticalStackLayout>
				</Border>

				<!-- Actions and outcome -->
				<Border Style="{StaticResource Card}">
					<VerticalStackLayout Spacing="10">
						<Grid ColumnDefinitions="*,*" ColumnSpacing="10">
							<Button x:Name="SaveButton"
							        AutomationId="SaveButton"
							        Text="Save"
							        Clicked="OnSaveClicked" />
							<Button x:Name="SendTestButton"
							        AutomationId="SendTestButton"
							        Grid.Column="1"
							        Text="Send test email"
							        Style="{StaticResource Ghost}"
							        IsEnabled="False"
							        Clicked="OnSendTestClicked" />
						</Grid>

						<Label x:Name="ResultLabel" AutomationId="ResultLabel" IsVisible="False" />

						<Label x:Name="LastTestLabel" AutomationId="LastTestLabel" IsVisible="False" Style="{StaticResource Hint}" />
						<Label x:Name="LastAlertLabel" AutomationId="LastAlertLabel" IsVisible="False" Style="{StaticResource Hint}" />
						<Label x:Name="UpdatedLabel" AutomationId="UpdatedLabel" IsVisible="False" Style="{StaticResource Hint}" />
					</VerticalStackLayout>
				</Border>

			</VerticalStackLayout>

		</VerticalStackLayout>
	</ScrollView>
</ContentPage>
