<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:SPIC.Ifms.Relay.Services"
             x:Class="SPIC.Ifms.Relay.Pages.HomePage"
             Title="SPIC IFMS Relay">

	<ScrollView>
		<VerticalStackLayout Padding="16,16,16,32" Spacing="0">

			<Label Text="SPIC IFMS Relay" Style="{StaticResource Title}" />
			<Label x:Name="HeadlineLabel"
			       Style="{StaticResource Muted}"
			       Margin="0,4,0,16"
			       Text="Checking…" />

			<!-- The CAPTCHA prompt. Loud on purpose: it is the one thing that blocks a run. -->
			<Border x:Name="CaptchaCard"
			        IsVisible="False"
			        BackgroundColor="{StaticResource WarnBackground}"
			        Stroke="{StaticResource WarnBorder}"
			        StrokeThickness="2"
			        StrokeShape="RoundRectangle 12"
			        Padding="16"
			        Margin="0,0,0,14">
				<VerticalStackLayout Spacing="10">
					<Label Text="The automation needs this CAPTCHA typed in"
					       FontSize="17"
					       FontAttributes="Bold"
					       TextColor="{StaticResource Warn}" />
					<Label Text="It could not read today's CAPTCHA on its own. Type what you see and the download continues by itself."
					       TextColor="{StaticResource Warn}" />
					<Label x:Name="FailedGuessesLabel"
					       IsVisible="False"
					       TextColor="{StaticResource Warn}" />

					<Border BackgroundColor="White"
					        Stroke="{StaticResource WarnBorder}"
					        StrokeThickness="1"
					        StrokeShape="RoundRectangle 6"
					        Padding="8"
					        HorizontalOptions="Start">
						<Image x:Name="CaptchaImage"
						       HeightRequest="80"
						       WidthRequest="240"
						       Aspect="AspectFit" />
					</Border>

					<Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
						<Entry x:Name="CaptchaEntry"
						       Placeholder="captcha"
						       MaxLength="20"
						       FontSize="20"
						       CharacterSpacing="3"
						       IsTextPredictionEnabled="False"
						       IsSpellCheckEnabled="False"
						       ReturnType="Send"
						       Completed="OnSendClicked" />
						<Button x:Name="SendButton"
						        Grid.Column="1"
						        Text="Send"
						        Clicked="OnSendClicked" />
					</Grid>

					<Label x:Name="CountdownLabel"
					       FontAttributes="Bold"
					       FontSize="13"
					       TextColor="{StaticResource Warn}" />
					<Label x:Name="CaptchaResultLabel" IsVisible="False" />
				</VerticalStackLayout>
			</Border>

			<!-- Status -->
			<Border Style="{StaticResource Card}">
				<VerticalStackLayout Spacing="0">
					<Label Text="Status" Style="{StaticResource CardTitle}" />

					<Grid ColumnDefinitions="Auto,*"
					      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
					      ColumnSpacing="16"
					      RowSpacing="8">
						<Label Grid.Row="0" Text="Relay" Style="{StaticResource Muted}" />
						<Label Grid.Row="0" Grid.Column="1" x:Name="RelayValue" HorizontalTextAlignment="End" FontAttributes="Bold" />

						<Label Grid.Row="1" Text="SMS permission" Style="{StaticResource Muted}" />
						<Label Grid.Row="1" Grid.Column="1" x:Name="SmsValue" HorizontalTextAlignment="End" FontAttributes="Bold" />

						<Label Grid.Row="2" Text="Notifications" Style="{StaticResource Muted}" />
						<Label Grid.Row="2" Grid.Column="1" x:Name="NotifyValue" HorizontalTextAlignment="End" FontAttributes="Bold" />

						<Label Grid.Row="3" Text="Battery optimisation" Style="{StaticResource Muted}" />
						<Label Grid.Row="3" Grid.Column="1" x:Name="BatteryValue" HorizontalTextAlignment="End" FontAttributes="Bold" />

						<Label Grid.Row="4" Text="Watcher" Style="{StaticResource Muted}" />
						<Label Grid.Row="4" Grid.Column="1" x:Name="WatcherValue" HorizontalTextAlignment="End" FontAttributes="Bold" />

						<Label Grid.Row="5" Text="Device id" Style="{StaticResource Muted}" />
						<Label Grid.Row="5" Grid.Column="1" x:Name="DeviceIdValue" HorizontalTextAlignment="End" FontSize="12" LineBreakMode="TailTruncation" />

						<Label Grid.Row="6" Text="Last contact" Style="{StaticResource Muted}" />
						<Label Grid.Row="6" Grid.Column="1" x:Name="LastContactValue" HorizontalTextAlignment="End" />

						<Label Grid.Row="7" Text="Last SMS relayed" Style="{StaticResource Muted}" />
						<Label Grid.Row="7" Grid.Column="1" x:Name="LastSmsValue" HorizontalTextAlignment="End" />
					</Grid>

					<Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,14,0,0">
						<Button Text="Refresh" Style="{StaticResource Ghost}" Clicked="OnRefreshClicked" />
						<Button Grid.Column="1" Text="Test connection" Clicked="OnTestConnectionClicked" />
					</Grid>

					<Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,10,0,0">
						<Button Text="Allow background running" Style="{StaticResource Ghost}" FontSize="12" Clicked="OnAllowBackgroundClicked" />
						<Button Grid.Column="1" Text="Open battery settings" Style="{StaticResource Ghost}" FontSize="12" Clicked="OnOpenBatterySettingsClicked" />
					</Grid>

					<Label x:Name="ActionResultLabel" IsVisible="False" Margin="0,12,0,0" />
				</VerticalStackLayout>
			</Border>

			<!-- HyperOS -->
			<Border Style="{StaticResource Card}" BackgroundColor="{StaticResource NoteBackground}">
				<VerticalStackLayout Spacing="6">
					<Label Text="On Xiaomi / HyperOS" FontAttributes="Bold" />
					<Label Text="Settings → Apps → SPIC IFMS Relay → Battery saver: No restrictions; Autostart: on. Then open Recents, hold this app and lock it. Without these HyperOS will stop the watcher an hour after the screen goes off." />
				</VerticalStackLayout>
			</Border>

			<!-- Recent activity -->
			<Border Style="{StaticResource Card}">
				<VerticalStackLayout Spacing="0">
					<Label Text="Recent activity" Style="{StaticResource CardTitle}" />
					<Label x:Name="NoActivityLabel" Text="Nothing yet." Style="{StaticResource Muted}" />

					<VerticalStackLayout x:Name="ActivityList" Spacing="6">
						<BindableLayout.ItemTemplate>
							<DataTemplate x:DataType="services:RelayLogEntry">
								<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
									<Label Text="{Binding TimeText}" Style="{StaticResource Hint}" VerticalOptions="Start" Margin="0,1,0,0" />
									<Label Grid.Column="1" Text="{Binding Summary}" TextColor="{Binding Colour}" FontSize="13" LineBreakMode="WordWrap" />
								</Grid>
							</DataTemplate>
						</BindableLayout.ItemTemplate>
					</VerticalStackLayout>
				</VerticalStackLayout>
			</Border>

		</VerticalStackLayout>
	</ScrollView>
</ContentPage>
