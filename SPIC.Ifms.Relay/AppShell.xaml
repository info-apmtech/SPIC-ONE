<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:SPIC.Ifms.Relay.Pages"
       x:Class="SPIC.Ifms.Relay.AppShell"
       Title="SPIC IFMS Relay">

	<!--
		Two tabs and nothing else. Home is what the person sees at four in the
		morning; Pair is visited once when the phone is set up.
	-->
	<TabBar>
		<ShellContent Title="Home" Route="home" ContentTemplate="{DataTemplate pages:HomePage}" />
		<ShellContent Title="Pair" Route="pair" ContentTemplate="{DataTemplate pages:PairPage}" />
	</TabBar>

</Shell>
