<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!--
			Android only, on purpose. This app exists so that the phone holding the
			IFMS SIM can read one SMS and answer one CAPTCHA; there is nothing for
			it to do anywhere else, and every extra head is another build to keep
			green.
		-->
		<TargetFrameworks>net10.0-android</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>SPIC.Ifms.Relay</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<ApplicationTitle>SPIC IFMS Relay</ApplicationTitle>
		<ApplicationId>com.apmiot.spic.ifmsrelay</ApplicationId>
		<ApplicationDisplayVersion>1.2</ApplicationDisplayVersion>
		<ApplicationVersion>3</ApplicationVersion>

		<!--
			Android 8 (API 26) is the floor: notification channels and
			startForegroundService both arrive there, and nothing older is in use.
		-->
		<SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#14532D" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#14532D" BaseSize="128,128" />
		<MauiFont Include="Resources\Fonts\*" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

</Project>
