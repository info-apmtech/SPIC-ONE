<Project Sdk="Microsoft.NET.Sdk">

  <!-- Help Desk developer tools: check (coverage / freshness), translate, apply-reviews.
       Run from the repository root (see README.md for the exact command).
       Not part of SpicOne.sln and never deployed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SPIC.HelpTools</RootNamespace>
    <AssemblyName>help-tools</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\SPIC.Core\SPIC.Core.csproj" />
  </ItemGroup>

</Project>
